@page "/flexcore-controls/media-query"
@rendermode InteractiveServer
<PageTitle>MediaQuery bench</PageTitle>
<ControlBenchFrame Name="MediaQuery" Instructions="Resize the browser across 900 pixels. The matching content and status should update." Status="@_status">
<MediaQueryControl Media="(min-width: 900px)" @bind-Matches="_matches"><ChildContent><AlertControl Text="Wide viewport" /></ChildContent><ElseContent><AlertControl Text="Narrow viewport" /></ElseContent></MediaQueryControl><p id="media-value">Matches: @_matches</p>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private bool _matches;
 
}
