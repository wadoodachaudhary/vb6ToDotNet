@page "/flexcore-controls/drop-zone"
@rendermode InteractiveServer
<PageTitle>DropZone bench</PageTitle>
<ControlBenchFrame Name="DropZone" Instructions="Drop text files into the external zone. The linked Upload control receives them through the same validated queue." Status="@_status">
<DropZoneControl UploadId="dropzone-upload" /><UploadControl Id="dropzone-upload" UploadHandler="Receive" AllowedExtensions="@(new[]{".txt"})" Completed="Completed" />
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private Task Receive(UploadChunk chunk,CancellationToken token){_status=$"Chunk received: {chunk.Offset+chunk.Bytes.Length}/{chunk.TotalSize}";return Task.CompletedTask;}
 private void Completed(UploadFile file)=>_status=$"Received {file.Name}";
}
