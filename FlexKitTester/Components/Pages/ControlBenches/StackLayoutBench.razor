@page "/flexcore-controls/stack-layout"
@rendermode InteractiveServer
<PageTitle>StackLayout bench</PageTitle>
<ControlBenchFrame Name="StackLayout" Instructions="Toggle direction and wrapping. Spacing and alignment belong to the FlexCore layout control." Status="@_status">
<CheckBoxControl @bind-Checked="_vertical" Label="Vertical layout" /><Fx.ControlKit.StackLayoutControl Orientation="@(_vertical?FlexOrientation.Vertical:FlexOrientation.Horizontal)" Gap="18px" Wrap="true"><ButtonControl>First</ButtonControl><ButtonControl>Second</ButtonControl><ButtonControl>Third</ButtonControl></Fx.ControlKit.StackLayoutControl>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private bool _vertical;
 
}
