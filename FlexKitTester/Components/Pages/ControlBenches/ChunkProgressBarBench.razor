@page "/flexcore-controls/chunk-progress-bar"
@rendermode InteractiveServer
<PageTitle>ChunkProgressBar bench</PageTitle>
<ControlBenchFrame Name="ChunkProgressBar" Instructions="Change the progress value and toggle indeterminate display." Status="@_status">
<SliderControl @bind-Value="_value" aria-label="Progress value" /><CheckBoxControl @bind-Checked="_indeterminate" Label="Indeterminate" /><ChunkProgressBarControl Value="@_value" ChunkCount="12" Indeterminate="@_indeterminate" />
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private double _value=35;private bool _indeterminate;
 
}
