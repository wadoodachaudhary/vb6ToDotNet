@page "/flexcore-controls/chat"
@rendermode InteractiveServer
<PageTitle>Chat bench</PageTitle>
<ControlBenchFrame Name="Chat" Instructions="Send a message and receive a labeled local echo. Cancel interrupts the pending reply." Status="@_status">
<ChatControl @bind-Messages="_messages" Reply="Reply" Suggestions="@(new[]{"Hello","Show a sample reply"})" />
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private IReadOnlyList<ChatMessage> _messages=Array.Empty<ChatMessage>();private async Task<string> Reply(ChatRequest request,CancellationToken token){await Task.Delay(350,token);return "Local demo echo: "+request.Submission.Text;}
 
}
