@page "/flexcore-controls/loader-container"
@rendermode InteractiveServer
<PageTitle>LoaderContainer bench</PageTitle>
<ControlBenchFrame Name="LoaderContainer" Instructions="Start loading. The underlying action is blocked until loading finishes." Status="@_status">
<ButtonControl OnClick="Load">Load for one second</ButtonControl><LoaderContainerControl Loading="@_loading"><ButtonControl OnClick="Underlying">Underlying action</ButtonControl></LoaderContainerControl>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private bool _loading;private async Task Load(){_loading=true;await Task.Delay(1000);_loading=false;_status="Loading complete";}
 private void Underlying()=>_status="Underlying action clicked";
}
