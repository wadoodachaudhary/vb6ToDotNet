@page "/flexcore-controls/range-slider"
@rendermode InteractiveServer
<PageTitle>RangeSlider bench</PageTitle>
<ControlBenchFrame Name="RangeSlider" Instructions="Move either endpoint. The start must never pass the end." Status="@_status">
<RangeSliderControl @bind-Value="_range" Min="0" Max="100" Step="5" /><p id="range-value">@_range.Start – @_range.End</p>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private NumericRange _range=new(20,80);
 
}
