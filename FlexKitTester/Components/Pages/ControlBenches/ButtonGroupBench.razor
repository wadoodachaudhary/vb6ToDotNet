@page "/flexcore-controls/button-group"
@rendermode InteractiveServer
<PageTitle>ButtonGroup bench</PageTitle>
<ControlBenchFrame Name="ButtonGroup" Instructions="Select formatting buttons. Multiple selections are allowed. Arrow keys move between buttons." Status="@_status">
<ButtonGroupControl Items="@_items" @bind-Values="_values" Selection="Fx.ControlKit.ChoiceSelectionMode.Multiple" AllowEmpty="true" /><p id="selection-value">@string.Join(", ",_values)</p>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private SelectionItem[] _items=[new("bold","Bold"),new("italic","Italic"),new("underline","Underline"),new("disabled","Unavailable",true)];private IReadOnlyList<string> _values=Array.Empty<string>();
 
}
