@page "/flexcore-controls/popover"
@rendermode InteractiveServer
<PageTitle>Popover bench</PageTitle>
<ControlBenchFrame Name="Popover" Instructions="Open the details, edit the value, and apply it. The popup should close on Escape." Status="@_status">
<PopoverControl @bind-IsOpen="_open" Header="Record details"><Anchor Context="popup"><ButtonControl OnClick="()=>popup.ToggleAsync()">Show details</ButtonControl></Anchor><ChildContent><TextBoxControl @bind-Value="_text" aria-label="Record name" /></ChildContent><FooterContent><ButtonControl OnClick="Apply">Apply details</ButtonControl></FooterContent></PopoverControl>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private bool _open;private string? _text="Example";private void Apply(){_status=_text??"";_open=false;}
 
}
