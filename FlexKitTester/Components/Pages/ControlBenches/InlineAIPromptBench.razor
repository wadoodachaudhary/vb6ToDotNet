@page "/flexcore-controls/inline-ai-prompt"
@rendermode InteractiveServer
<PageTitle>InlineAIPrompt bench</PageTitle>
<ControlBenchFrame Name="InlineAIPrompt" Instructions="Open an inline prompt for the selected paragraph. Generate and apply the labeled local response." Status="@_status">
<p id="inline-text">@_text</p><InlineAIPromptControl @bind-IsOpen="_open" SelectedText="@_text" Prompt="Rewrite concisely" Generate="Generate" Apply="Apply"><Anchor Context="popup"><ButtonControl OnClick="()=>popup.ToggleAsync()">Rewrite selection</ButtonControl></Anchor></InlineAIPromptControl>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private bool _open;private string _text="This paragraph is the selected text for this independent bench.";private Task<string> Generate(AIPromptRequest request,CancellationToken token)=>Task.FromResult("Local demo rewrite: concise paragraph.");private void Apply(AIPromptResult result){_text=result.Output;_status="Applied generated text";}
 
}
