@page "/flexcore-controls"
@rendermode InteractiveServer
@inject NavigationManager Navigation
<PageTitle>FlexCore control benches</PageTitle>
<h1>FlexCore control benches</h1>
<p>Each control opens an independent bench with its own sample data and state.</p>
<Fx.ControlKit.StackLayoutControl Wrap="true" Gap="12px">
@foreach(var bench in ControlBenchCatalog.All){<ButtonControl OnClick="()=>Navigation.NavigateTo(bench.Route)">@bench.Name</ButtonControl>}
</Fx.ControlKit.StackLayoutControl>
