@inject NavigationManager Navigation
<section class="fx-control-bench">
<header><ButtonControl OnClick="NavigateBack">All controls</ButtonControl><h1>@Name</h1><p>@Instructions</p></header>
<CardControl><ChildContent>@ChildContent</ChildContent></CardControl>
<output id="bench-status" role="status">@Status</output>
</section>
@code {
 private void NavigateBack()=>Navigation.NavigateTo("/flexcore-controls");
 [Parameter] public string Name {get;set;}="";
 [Parameter] public string Instructions {get;set;}="";
 [Parameter] public string Status {get;set;}="Ready";
 [Parameter] public RenderFragment? ChildContent {get;set;}
}
