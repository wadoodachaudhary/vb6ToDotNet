@page "/flexcore-controls/map"
@rendermode InteractiveServer
<PageTitle>Map bench</PageTitle>
<ControlBenchFrame Name="Map" Instructions="Pan with mouse or arrow keys, zoom, fit markers, and select a city. The demo uses local vector data and makes no map-provider requests." Status="@_status">
<MapControl @bind-Center="_center" @bind-Zoom="_zoom" Markers="@_markers" Shapes="@_shapes" BubbleMarkers="true" ClusterMarkers="true" MarkerClick="m=>_status=m.Title" ViewChanged="ViewChanged" />
</ControlBenchFrame>
@code {
 private GeoPoint _center=new(39,-98);private int _zoom=3;
 private string _status="Ready";
 private MapMarker[] _markers=[new("ny",new(40.71,-74),"New York",9),new("sf",new(37.77,-122.42),"San Francisco",4),new("chi",new(41.88,-87.63),"Chicago",6)];private MapShape[] _shapes=[new("region","Sample region",[new GeoPoint[]{new(48,-124),new(48,-68),new(25,-80),new(32,-117),new(48,-124)}])];
 private void ViewChanged(MapView view)=>_status=$"Zoom {view.Zoom}, center {view.Center.Latitude:0.0}, {view.Center.Longitude:0.0}";
}
