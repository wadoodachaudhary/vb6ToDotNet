@page "/flexcore-controls/prompt-box"
@rendermode InteractiveServer
<PageTitle>PromptBox bench</PageTitle>
<ControlBenchFrame Name="PromptBox" Instructions="Type a message. Enter sends it, Shift+Enter adds a line. Attachments are optional." Status="@_status">
<PromptBoxControl @bind-Value="_text" Submit="Submitted" AllowAttachments="true" />
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private string? _text;
 private void Submitted(PromptSubmission p)=>_status=$"Sent: {p.Text} ({p.Attachments.Count} attachments)";
}
