@page "/flexcore-controls/animation-container"
@rendermode InteractiveServer
<PageTitle>AnimationContainer bench</PageTitle>
<ControlBenchFrame Name="AnimationContainer" Instructions="Show and hide the content. Hidden content must not receive keyboard focus." Status="@_status">
<ToggleButtonControl @bind-Selected="_show">Show content</ToggleButtonControl><AnimationContainerControl Show="@_show" Effect="AnimationEffect.Slide"><TextBoxControl Value="Animated content" aria-label="Animated value" /></AnimationContainerControl>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private bool _show=true;
 
}
