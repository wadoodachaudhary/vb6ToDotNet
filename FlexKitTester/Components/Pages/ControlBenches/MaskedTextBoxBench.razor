@page "/flexcore-controls/masked-text-box"
@rendermode InteractiveServer
<PageTitle>MaskedTextBox bench</PageTitle>
<ControlBenchFrame Name="MaskedTextBox" Instructions="Enter a ten-digit phone number and press Enter. Invalid and incomplete values must remain editable." Status="@_status">
<MaskedTextBoxControl @bind-Value="_phone" Mask="(000) 000-0000" AriaLabel="Phone number" Required="true" /><p id="mask-value">@_phone</p>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private string? _phone;
 
}
