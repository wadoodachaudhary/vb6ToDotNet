@page "/flexcore-controls/loader"
@rendermode InteractiveServer
<PageTitle>Loader bench</PageTitle>
<ControlBenchFrame Name="Loader" Instructions="Inspect all loader types and toggle visibility. Reduced-motion preferences are respected." Status="@_status">
<CheckBoxControl @bind-Checked="_visible" Label="Show loaders" /><Fx.ControlKit.StackLayoutControl><LoaderControl Visible="@_visible" Text="Spinner" /><LoaderControl Visible="@_visible" Type="LoaderType.Pulsing" Text="Pulsing" /><LoaderControl Visible="@_visible" Type="LoaderType.Dots" Text="Dots" /></Fx.ControlKit.StackLayoutControl>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private bool _visible=true;
 
}
