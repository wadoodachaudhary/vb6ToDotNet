@page "/flexcore-controls/flat-color-picker"
@rendermode InteractiveServer
<PageTitle>FlatColorPicker bench</PageTitle>
<ControlBenchFrame Name="FlatColorPicker" Instructions="Switch between palette and gradient. Apply commits the draft; Cancel restores the saved color." Status="@_status">
<FlatColorPickerControl @bind-Value="_color" ShowButtons="true" /><p id="color-value">@_color</p>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private string _color="#3478C5";
 
}
