@page "/flexcore-controls/segmented"
@rendermode InteractiveServer
<PageTitle>Segmented bench</PageTitle>
<ControlBenchFrame Name="Segmented" Instructions="Choose one delivery mode. Use arrow keys to change the selected segment." Status="@_status">
<SegmentedControl Items="@_items" @bind-Value="_value" AriaLabel="Delivery mode" /><p id="selection-value">@_value</p>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private SelectionItem[] _items=[new("standard","Standard"),new("express","Express"),new("pickup","Pickup")];private string _value="standard";
 
}
