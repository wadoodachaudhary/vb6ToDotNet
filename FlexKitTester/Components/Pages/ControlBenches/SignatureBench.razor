@page "/flexcore-controls/signature"
@rendermode InteractiveServer
<PageTitle>Signature bench</PageTitle>
<ControlBenchFrame Name="Signature" Instructions="Draw with mouse or touch. Undo a stroke, clear, and download the signature as SVG." Status="@_status">
<SignatureControl @bind-Value="_signature" /><p id="signature-value">Strokes: @_signature.Strokes.Count</p>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private SignatureValue _signature=SignatureValue.Empty;
 
}
