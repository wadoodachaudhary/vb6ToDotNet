@page "/flexcore-controls/chip"
@rendermode InteractiveServer
<PageTitle>Chip bench</PageTitle>
<ControlBenchFrame Name="Chip" Instructions="Toggle the chip, then remove it. Reset brings it back." Status="@_status">
<ChipControl Text="Important" @bind-Selected="_selected" Removable="true" OnRemove="()=>_visible=false" Visible="@_visible" /><ButtonControl OnClick="()=>_visible=true">Reset chip</ButtonControl><p id="selection-value">@_selected</p>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private bool _selected,_visible=true;
 
}
