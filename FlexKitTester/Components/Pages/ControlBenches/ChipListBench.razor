@page "/flexcore-controls/chip-list"
@rendermode InteractiveServer
<PageTitle>ChipList bench</PageTitle>
<ControlBenchFrame Name="ChipList" Instructions="Select tags and remove one. Selection must remain consistent after removal." Status="@_status">
<ChipListControl @bind-Items="_items" @bind-SelectedIds="_selected" /><p id="selection-value">@string.Join(", ",_selected)</p>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private IReadOnlyList<ChipItem> _items=[new("one","Design"),new("two","Review"),new("three","Approved")];private IReadOnlyList<string> _selected=Array.Empty<string>();
 
}
