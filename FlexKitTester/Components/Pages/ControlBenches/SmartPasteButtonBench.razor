@page "/flexcore-controls/smart-paste-button"
@rendermode InteractiveServer
<PageTitle>SmartPasteButton bench</PageTitle>
<ControlBenchFrame Name="SmartPasteButton" Instructions="Use clipboard text or paste in the dialog. The local demo parser maps Name: and Quantity: lines; review before applying." Status="@_status">
<FormControl Model="@_record" ShowSubmitButton="false"><ChildContent><FormItemControl Field="Name" /><FormItemControl Field="Quantity" /><SmartPasteButtonControl Model="@_record" Fields="@(new[]{"Name","Quantity"})" Map="Map" Applied="Applied" /></ChildContent></FormControl>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private PasteRecord _record=new();private sealed class PasteRecord{public string Name{get;set;}="Original";public int Quantity{get;set;}=1;}private Task<IReadOnlyDictionary<string,string>> Map(SmartPasteRequest request,CancellationToken token){IReadOnlyDictionary<string,string> values=request.Text.Split('\n').Select(s=>s.Split(':',2)).Where(p=>p.Length==2).GroupBy(p=>p[0].Trim(),StringComparer.OrdinalIgnoreCase).ToDictionary(g=>g.Key,g=>g.Last()[1].Trim(),StringComparer.OrdinalIgnoreCase);return Task.FromResult(values);}
 private void Applied(SmartPasteApplied a)=>_status=$"Applied {a.Values.Count} fields";
}
