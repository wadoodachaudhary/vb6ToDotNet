@page "/flexcore-controls/popup"
@rendermode InteractiveServer
<PageTitle>Popup bench</PageTitle>
<ControlBenchFrame Name="Popup" Instructions="Open the popup, type in it, then dismiss with Escape or an outside click." Status="@_status">
<PopupControl @bind-IsOpen="_open" AriaLabel="Popup bench"><Anchor Context="popup"><ButtonControl OnClick="()=>popup.ToggleAsync()" aria-expanded="@(popup.IsOpen ? "true" : "false")">Open popup</ButtonControl></Anchor><ChildContent><TextBoxControl @bind-Value="_text" UpdateOnInput="true" aria-label="Popup value" /><ButtonControl OnClick="PopupApply">Apply popup value</ButtonControl></ChildContent></PopupControl>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private bool _open;private string? _text="Editable popup";
 private void PopupApply()=>_status=_text??"";
}
