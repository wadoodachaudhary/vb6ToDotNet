@page "/flexcore-controls/tooltip"
@rendermode InteractiveServer
<PageTitle>Tooltip bench</PageTitle>
<ControlBenchFrame Name="Tooltip" Instructions="Hover or focus the button to show rich tooltip content. Move away to dismiss." Status="@_status">
<TooltipControl Text="This explanation is rendered by FlexCore." ShowDelay="150"><ChildContent><ButtonControl>Focus for help</ButtonControl></ChildContent><Content><strong>Keyboard help</strong><p>Use Tab to move between controls.</p></Content></TooltipControl>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 
 
}
