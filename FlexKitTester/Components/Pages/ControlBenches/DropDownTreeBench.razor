@page "/flexcore-controls/drop-down-tree"
@rendermode InteractiveServer
<PageTitle>DropDownTree bench</PageTitle>
<ControlBenchFrame Name="DropDownTree" Instructions="Expand a branch, search for a leaf, select it, and clear the value." Status="@_status">
<DropDownTreeControl Nodes="@_nodes" @bind-Value="_value" SelectLeavesOnly="true" /><p id="tree-value">@_value</p>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private string? _value;private TreeNode[] _nodes=[new(){Id="sales",Text="Sales",IsExpanded=true,Children=[new(){Id="east",Text="East region"},new(){Id="west",Text="West region"}]},new(){Id="engineering",Text="Engineering",Children=[new(){Id="platform",Text="Platform"}]}];
 
}
