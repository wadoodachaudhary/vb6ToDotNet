@page "/flexcore-controls/speech-to-text-button"
@rendermode InteractiveServer
<PageTitle>SpeechToTextButton bench</PageTitle>
<ControlBenchFrame Name="SpeechToTextButton" Instructions="Press Speak and grant microphone permission if supported. Final recognized words update the text field; errors remain visible." Status="@_status">
<SpeechToTextButtonControl @bind-Value="_text" Language="en-US" Error="e=>_status=e" /><TextBoxControl @bind-Value="_text" Multiline="true" Rows="4" aria-label="Transcription" />
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private string _text="";
 
}
