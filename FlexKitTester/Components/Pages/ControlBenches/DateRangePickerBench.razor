@page "/flexcore-controls/date-range-picker"
@rendermode InteractiveServer
<PageTitle>DateRangePicker bench</PageTitle>
<ControlBenchFrame Name="DateRangePicker" Instructions="Type dates or choose a range from the calendar. Reversed dates show a validation error." Status="@_status">
<DateRangePickerControl @bind-Value="_range" Min="@(new DateTime(2026,1,1))" Max="@(new DateTime(2026,12,31))" /><p id="range-value">@_range.Start?.ToString("d") – @_range.End?.ToString("d")</p>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private CalendarRange _range=new(new DateTime(2026,9,7),new DateTime(2026,9,11));
 
}
