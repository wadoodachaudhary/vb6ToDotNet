@page "/flexcore-controls/scheduler"
@rendermode InteractiveServer
<PageTitle>Scheduler bench</PageTitle>
<ControlBenchFrame Name="Scheduler" Instructions="Edit appointments, switch views, drag to another slot, resize from the lower edge, and modify a recurring occurrence or its series." Status="@_status">
<SchedulerControl Events="@_events" Resources="@_resources" @bind-Date="_date" @bind-View="_view" TimeZoneId="America/New_York" EventsChanged="Changed" />
</ControlBenchFrame>
@code {
 private DateTime _date=new(2026,9,7);private SchedulerView _view=SchedulerView.Week;
 private string _status="Ready";
 private IReadOnlyList<SchedulerResource> _resources=[new("room-a","Room A"),new("room-b","Room B","#A35C24")];private IReadOnlyList<SchedulerEvent> _events=[new(){Id="daily",Title="Daily standup",Start=new(2026,9,7,9,0,0),End=new(2026,9,7,9,30,0),TimeZoneId="America/New_York",ResourceId="room-a",RecurrenceRule="FREQ=DAILY;COUNT=5"},new(){Id="review",Title="Design review",Start=new(2026,9,8,11,0,0),End=new(2026,9,8,12,0,0),TimeZoneId="America/New_York",ResourceId="room-b"}];private void Changed(IReadOnlyList<SchedulerEvent> events){_events=events;_status=$"Appointments: {events.Count}";}
 
}
