@page "/flexcore-controls/floating-label"
@rendermode InteractiveServer
<PageTitle>FloatingLabel bench</PageTitle>
<ControlBenchFrame Name="FloatingLabel" Instructions="Focus the name field, type, and blur. The label stays above a nonempty value." Status="@_status">
<FloatingLabelControl Text="Full name" For="floating-name" HasValue="@(!string.IsNullOrEmpty(_text))"><TextBoxControl id="floating-name" @bind-Value="_text" UpdateOnInput="true" /></FloatingLabelControl>
</ControlBenchFrame>
@code {
 private string _status="Ready";
 private string? _text;
 
}
