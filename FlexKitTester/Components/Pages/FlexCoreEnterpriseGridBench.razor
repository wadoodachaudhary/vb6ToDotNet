    private RenderFragment<GridPagerContext> PagerContent => pager =>
        @<div class="fcg-pager">
            <ButtonControl BareStyle="true" CssClass="fcg-button" Disabled="@(pager.CurrentPage <= 1)"
                    OnClick="() => pager.GoToPageAsync(pager.CurrentPage - 1)">Previous</ButtonControl>
            <span>custom pager · @pager.RowCountText · page @pager.CurrentPage of @pager.TotalPages</span>
            <label>
                rows
                <DropDownListControl TValue="int" TItem="BenchPageSizeChoice"
                                     DataSource="@(pager.PageSizes.Select(size => new BenchPageSizeChoice(size, size <= 0 ? "All" : size.ToString())))"
