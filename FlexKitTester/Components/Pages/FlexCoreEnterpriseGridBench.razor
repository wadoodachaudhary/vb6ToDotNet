@page "/flexcore-enterprise-grid"
@rendermode InteractiveServer
@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text
@using System.Text.Json
@using ClosedXML.Excel
@using FlexKitTester.Services
@inject BenchDataStore BenchData

<PageTitle>FlexCore Enterprise Grid Bench</PageTitle>

<PageControl ScrollMode="PageScrollMode.None">
    <div class="fcg-page">
    <div class="fcg-shell">
        <header class="fcg-heading">
            <div>
                <h3>FlexCore enterprise-grid bench</h3>
                <p>
                    Select one test from the hierarchy. Only that test screen is mounted.
                    Rows come from <code>@BenchDataStore.EstimatingFileName</code>; no HomeFront screen is changed.
                </p>
            </div>
            <span class="fcg-kit">@ControlKitAssembly</span>
        </header>

        <div class="fcg-workbench">
            <aside class="fcg-navigation" aria-label="Enterprise grid tests">
                <div class="fcg-navigation-title">
                    <b>Grid feature tests</b>
                    <span>@FeatureTests.Count test screens</span>
                </div>
                <div class="fcg-tree-host">
                    <TreeViewControl Nodes="@_navigationNodes"
                                     SelectedNode="@_selectedNavigationNode"
                                     SelectedNodeChanged="HandleNavigationChanged"
                                     ToggleOnNodeClick="true"
                                     ShowIcons="true"
                                     UseVb6TreeStyle="true"
                                     FolderStyle="TreeFolderStyle.Grey"
                                     TreeIndentPixels="15"
                                     CssClass="fcg-navigation-tree"
                                     Height="100%" />
                </div>
                <p class="fcg-navigation-note">Drag the lower-right edge to resize this panel.</p>
            </aside>

            <section class="fcg-screen" aria-labelledby="fcg-screen-title">
                <header class="fcg-screen-heading">
                    <div>
                        <span class="fcg-screen-group">@ActiveScreenGroup</span>
                        <h4 id="fcg-screen-title">@ActiveScreenTitle</h4>
                    </div>
                    @if (_activeScreen != BenchScreen.Overview)
                    {
                        <ButtonControl BareStyle="true" CssClass="fcg-button fcg-reset" OnClick="ResetActiveTest">Reset test</ButtonControl>
                    }
                </header>

                @if (_activeScreen == BenchScreen.Overview)
                {
                    <div class="fcg-overview">
                        <section class="fcg-feature-strip" aria-label="Feature coverage">
                            @foreach (var feature in FeatureCoverage)
                            {
                                <span title="@feature.Detail"><b>✓</b> @feature.Name</span>
                            }
                        </section>

                        <section class="fcg-test-matrix" aria-label="Feature test matrix">
                            <div class="fcg-test-matrix-heading">
                                <b>Choose a focused test</b>
                                <span>Each row opens its own screen.</span>
                            </div>
                            <div class="fcg-test-matrix-grid">
                                @foreach (var test in FeatureTests)
                                {
                                    <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="() => SelectScreen(test.Screen)">
                                        <b>@test.Feature</b>
                                        <span>@test.Surface</span>
                                        <span>@test.Action</span>
                                    </ButtonControl>
                                }
                            </div>
                        </section>
                    </div>
                }
                else
                {
                    <section class="fcg-instructions">
                        <b>How to test</b>
                        <span>@ActiveTest?.Action</span>
                    </section>

                    @if (UsesLocalEnterpriseGrid)
                    {
                        <section class="fcg-controls" aria-label="Controls for the selected test">
                            @if (_activeScreen == BenchScreen.MultiSort)
                            {
                                <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="OpenCustomSort">Custom Sort...</ButtonControl>
                                <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="ApplyMultiSort">Apply Category ↑, Name ↓</ButtonControl>
                                <span class="@MultiSortVerificationCss" title="@_multiSortSample">multi-sort: @_multiSortVerification</span>
                            }
                            @if (IsEditingScreen)
                            {
                                <span><b>Mode:</b> @_editMode</span>
                                <span>@EditingScreenHint</span>
                            }
                            @if (_activeScreen == BenchScreen.BatchEditing)
                            {
                                <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="CommitActiveGridEdit">Commit active edit</ButtonControl>
                            }
                            @if (IsLocalFilteringScreen)
                            {
                                <span><b>Filter mode:</b> @ActiveFilterMode</span>
                                <CheckBoxControl Label="case-sensitive" CssClass="fcg-check"
                                                 @bind-Checked="_caseSensitive" @bind-Checked:after="RebuildMainGrid" />
                                @if (_activeScreen == BenchScreen.FilterRow)
                                {
                                    <CheckBoxControl Label="Show operator dropdowns" CssClass="fcg-check"
                                                     Checked="@_showFilterRowOperators"
                                                     CheckedChanged="SetShowFilterRowOperators" />
                                    @if (!_showFilterRowOperators)
                                    {
                                        <span>Type to filter with Contains.</span>
                                    }
                                }
                                <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="ClearMainFilters">Clear filters</ButtonControl>
                            }
                            @if (_activeScreen == BenchScreen.MasterDetail)
                            {
                                <CheckBoxControl Label="show detail expand column" CssClass="fcg-check"
                                                 @bind-Checked="_showExpandColumn" />
                            }
                            @if (_activeScreen == BenchScreen.Pager)
                            {
                                <label>
                                    <span>Pager position</span>
                                    <DropDownListControl TValue="GridPagerPosition" TItem="GridPagerPosition"
                                                         DataSource="@(Enum.GetValues<GridPagerPosition>())"
                                                         @bind-Value="_pagerPosition" AriaLabel="Pager position"
                                                         PanelFitContentWidth="true" />
                                </label>
                            }
                            @if (_activeScreen == BenchScreen.State)
                            {
                                <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="CaptureState">Capture complete state</ButtonControl>
                                <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="RestoreState" Disabled="@(_savedState == null)">Restore JSON state</ButtonControl>
                                <span>events: @_stateEventCount · serialized: @_stateJsonLength.ToString("N0") bytes</span>
                            }
                            @if (_activeScreen == BenchScreen.GridTemplates)
                            {
                                <span>Open the grid toolbar and the column chooser from the column UI.</span>
                            }
                            @if (_activeScreen == BenchScreen.AdaptiveLayout)
                            {
                                <label>
                                    <span>Layout</span>
                                    <DropDownListControl TValue="GridDataLayoutMode" TItem="GridDataLayoutMode"
                                                         DataSource="@(Enum.GetValues<GridDataLayoutMode>())"
                                                         @bind-Value="_layoutMode" AriaLabel="Layout"
                                                         PanelFitContentWidth="true" />
                                </label>
                                <span>Stacked is immediate. For Auto while Columns is selected, resize the browser viewport below 720px; resizing this hierarchy only tests ordinary grid fit.</span>
                            }
                            @if (_activeScreen == BenchScreen.Accessibility)
                            {
                                <span>Keyboard: Ctrl+Home, Ctrl+End, Ctrl+Shift+A. Start editing a cell, then use Escape to cancel it.</span>
                            }
                            @if (_activeScreen is BenchScreen.LocalCsvExport or BenchScreen.LocalXlsxExport)
                            {
                                @if (_activeScreen == BenchScreen.LocalCsvExport)
                                {
                                    <label>
                                        <span>CSV encoding</span>
                                        <DropDownListControl TValue="GridDelimitedTextEncoding" TItem="GridDelimitedTextEncoding"
                                                         DataSource="@(Enum.GetValues<GridDelimitedTextEncoding>())"
                                                         @bind-Value="_delimitedEncoding" AriaLabel="CSV encoding"
                                                         PanelFitContentWidth="true" />
                                    </label>
                                    <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="() => CreateLocalExport(GridExportFormat.Csv)">Build and verify CSV</ButtonControl>
                                }
                                else
                                {
                                    <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="() => CreateLocalExport(GridExportFormat.Xlsx)">Build and verify XLSX</ButtonControl>
                                }
                            }
                        </section>

                        <div class="fcg-status" role="status" aria-live="polite">
                            <span>@_status</span>
                        </div>

                        <div class="fcg-local-grid-area">
                            <section id="local-enterprise-grid" class="fcg-card fcg-main-card">
                                <div class="fcg-card-title">
                                    <b>@ActiveScreenTitle</b>
                                    <span>@LocalGridCaption</span>
                                </div>
                                <div class="@MainGridHostCss">
                                    <GridControl @key="_mainGridKey"
                                                 @ref="_mainGrid"
                                                 TValue="EnterpriseRow"
                                                 DataSource="@_rows"
                                                 ItemKeySelector="row => row.Id"
                                                 Height="100%"
                                                 AccessibleLabel="@($"{ActiveScreenTitle} test grid")"
                                                 AllowSorting="true"
                                                 ShowMultiColumnSortingIndex="true"
                                                 AllowFiltering="@MainGridAllowsFiltering"
                                                 FilterMode="@ActiveFilterMode"
                                                 FilterSettingsRef="@CurrentFilterSettings"
                                                 EnableAdvancedFilterPopup="@MainGridAllowsFiltering"
                                                 EnableBlankRowFilter="@MainGridAllowsFiltering"
                                                 ShowSearchBar="@MainGridAllowsFiltering"
                                                 ShowColumnMenu="@MainGridShowsColumnMenu"
                                                 ShowGridToolbar="@MainGridShowsToolbar"
                                                 AllowGrouping="@MainGridAllowsGrouping"
                                                 AllowPaging="@MainGridAllowsPaging"
                                                 PageSettingsRef="@_pageSettings"
                                                 PagerPosition="@_pagerPosition"
                                                 AllowSelection="true"
                                                 SelectionSettingsRef="@_selectionSettings"
                                                 AllowResizing="true"
                                                 AllowColumnReorder="@MainGridAllowsColumnLayout"
                                                 ShowRowCountInFooter="true"
                                                 EditSettingsRef="@ActiveEditSettings"
                                                 ValidationSettings="@ActiveValidationSettings"
                                                 ShowExpandColumn="@MainGridShowsDetails"
                                                 ShowExpandAll="@MainGridShowsDetails"
                                                 ColumnHeaderBands="@ActiveHeaderBands"
                                                 DataLayoutMode="@ActiveDataLayoutMode"
                                                 AdaptiveMode="@ActiveAdaptiveMode"
                                                 StackedColumnsCount="2"
                                                 DelimitedExportEncoding="@_delimitedEncoding"
                                                 CustomKeyboardShortcuts="@KeyboardShortcuts"
                                                 GridToolBarTemplate="@ActiveGridToolbarTemplate"
                                                 DetailTemplate="@ActiveDetailTemplate"
                                                 PagerTemplate="@ActivePagerTemplate"
                                                 ColumnChooserTemplate="@ActiveColumnChooserTemplate"
                                                 OnStateChanged="HandleStateChanged">
                                        <ChildContent>
                                            <GridColumnsBase>
                                                <GridColumn Field="@nameof(EnterpriseRow.Id)" HeaderText="ID" Width="65px"
                                                            IsPrimaryKey="true" IsFrozen="@MainGridUsesFrozenColumns" FrozenPosition="FrozenColumnPosition.Left"
                                                            Type="ColumnType.Number" AllowEditing="false" />
                                                <GridColumn Field="@nameof(EnterpriseRow.Code)" HeaderText="Item" Width="90px" />
                                                @if (_activeScreen == BenchScreen.FilterCellTemplate)
                                                {
                                                    <GridColumn Field="@nameof(EnterpriseRow.Name)" HeaderText="Description" Width="250px">
                                                        <FilterCellTemplate Context="filter">
                                                            <div class="fcg-custom-filter">
                                                                <TextBoxControl Value="@filter.Value" Placeholder="custom template"
                                                                                ValueChanged="value => ApplyCustomFilter(filter, value)" />
                                                                <ButtonControl BareStyle="true" CssClass="fcg-button" Title="Clear description filter" OnClick="filter.ClearAsync">×</ButtonControl>
                                                            </div>
                                                        </FilterCellTemplate>
                                                    </GridColumn>
                                                }
                                                else
                                                {
                                                    <GridColumn Field="@nameof(EnterpriseRow.Name)" HeaderText="Description" Width="250px" />
                                                }
                                                <GridColumn Field="@nameof(EnterpriseRow.Category)" HeaderText="Category" Width="150px" />
                                                <GridColumn Field="@nameof(EnterpriseRow.Quantity)" HeaderText="Qty" Width="80px"
                                                            Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                                                <GridColumn Field="@nameof(EnterpriseRow.Price)" HeaderText="Price" Width="100px"
                                                            Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="C2" />
                                                <GridColumn Field="@nameof(EnterpriseRow.Extended)" HeaderText="Extended" Width="115px"
                                                            Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="C2"
                                                            Formula="@($"[{nameof(EnterpriseRow.Quantity)}] * [{nameof(EnterpriseRow.Price)}]")"
                                                            AllowEditing="false" AllowSorting="false" AllowFiltering="false" />
                                                <GridColumn Field="@nameof(EnterpriseRow.EffectiveDate)" HeaderText="Effective" Width="115px"
                                                            Type="ColumnType.Date" Format="d" />
                                                <GridColumn Field="@nameof(EnterpriseRow.Active)" HeaderText="Active" Width="75px"
                                                            Type="ColumnType.CheckBox" />
                                                @if (_activeScreen == BenchScreen.FilterMenuTemplate)
                                                {
                                                    <GridColumn Field="@nameof(EnterpriseRow.Status)" HeaderText="Status" Width="110px"
                                                                IsFrozen="@MainGridUsesFrozenColumns" FrozenPosition="FrozenColumnPosition.Right">
                                                        <FilterMenuTemplate Context="menu">
                                                            <div class="fcg-status-filter">
                                                                <b>Custom status menu</b>
                                                                <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick='() => ApplyStatusFilter(menu, "Active")'>Active</ButtonControl>
                                                                <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick='() => ApplyStatusFilter(menu, "Pending")'>Pending</ButtonControl>
                                                                <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="menu.ClearAsync">All</ButtonControl>
                                                            </div>
                                                        </FilterMenuTemplate>
                                                    </GridColumn>
                                                }
                                                else
                                                {
                                                    <GridColumn Field="@nameof(EnterpriseRow.Status)" HeaderText="Status" Width="110px"
                                                                IsFrozen="@MainGridUsesFrozenColumns" FrozenPosition="FrozenColumnPosition.Right" />
                                                }
                                            </GridColumnsBase>
                                        </ChildContent>
                                    </GridControl>
                                </div>
                            </section>

                        </div>
                    }
                    else if (_activeScreen == BenchScreen.RowNoDataTemplates)
                    {
                        <section class="fcg-controls" aria-label="Row template controls">
                            <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="ToggleTemplateRows">@(_templateRows.Count == 0 ? "Restore template rows" : "Show no-data template")</ButtonControl>
                            <span>The host owns all cells in RowTemplate and the empty body in NoDataTemplate.</span>
                        </section>
                        <section id="template-grid" class="fcg-card fcg-special-card">
                            <div class="fcg-card-title">
                                <b>Full-row and no-data templates</b>
                                <span>Toggle the rows with the control above.</span>
                            </div>
                            <div class="fcg-small-grid">
                                <GridControl @key="_mainGridKey"
                                             TValue="TemplateRow"
                                             DataSource="@_templateRows"
                                             Height="100%"
                                             AllowSelection="true"
                                             ShowRowCountInFooter="true">
                                    <ChildContent>
                                        <GridColumnsBase>
                                            <GridColumn Field="@nameof(TemplateRow.Label)" HeaderText="Template row" Width="45%" />
                                            <GridColumn Field="@nameof(TemplateRow.Value)" HeaderText="Value" Width="25%" />
                                            <GridColumn Field="@nameof(TemplateRow.Note)" HeaderText="Note" Width="30%" />
                                        </GridColumnsBase>
                                    </ChildContent>
                                    <RowTemplate Context="row">
                                        <td class="fx-cell"><b>#@(row.RowIndex + 1) @row.Item.Label</b></td>
                                        <td class="fx-cell">@row.Item.Value</td>
                                        <td class="fx-cell"><span class="fcg-row-pill">@row.Item.Note</span></td>
                                    </RowTemplate>
                                    <NoDataTemplate>
                                        <div class="fcg-empty">The custom empty template is active.</div>
                                    </NoDataTemplate>
                                </GridControl>
                            </div>
                        </section>
                    }
                    else if (_activeScreen == BenchScreen.AutoColumns)
                    {
                        <section id="auto-columns-grid" class="fcg-card fcg-special-card">
                            <div class="fcg-card-title">
                                <b>Annotation auto-generation</b>
                                <span>Display, Key, Editable, formatting, and ScaffoldColumn.</span>
                            </div>
                            <div class="fcg-grid-host">
                                <GridControl @key="_mainGridKey"
                                             TValue="AutoRow"
                                             DataSource="@_autoRows"
                                             AutoGenerateColumns="true"
                                             Height="100%"
                                             AllowSorting="true"
                                             AllowFiltering="true"
                                             FilterMode="GridFilterMode.Simple"
                                             ShowColumnMenu="true"
                                             AllowSelection="true"
                                             EditSettingsRef="@_editSettings"
                                             ShowRowCountInFooter="true" />
                            </div>
                        </section>
                    }
                    else if (_activeScreen == BenchScreen.ColumnVirtualization)
                    {
                        <section class="fcg-controls" aria-label="Column virtualization controls">
                            <label>Overscan columns <NumericTextBoxControl TValue="int" Min="0" Max="10" Width="60px" @bind-Value="_columnOverscan" /></label>
                            <span>First and last columns remain mounted and frozen.</span>
                        </section>
                        <section id="column-virtualization-grid" class="fcg-card fcg-special-card">
                            <div class="fcg-card-title">
                                <b>42-column horizontal window</b>
                                <span>Current overscan: @_columnOverscan</span>
                            </div>
                            <div class="fcg-grid-host">
                                <GridControl @key="_mainGridKey"
                                             TValue="WideRow"
                                             DataSource="@_wideRows"
                                             Height="100%"
                                             EnableColumnVirtualization="true"
                                             ColumnVirtualizationOverscan="@_columnOverscan"
                                             ShowColumnVirtualizationFallback="true"
                                             AllowSorting="true"
                                             AllowSelection="true"
                                             ShowRowCountInFooter="true">
                                    <GridColumnsBase>
                                        @foreach (var column in _wideColumns)
                                        {
                                            <GridColumn @key="column.Field"
                                                        Field="@column.Field"
                                                        HeaderText="@column.Header"
                                                        Width="@column.Width"
                                                        IsFrozen="@column.Frozen"
                                                        FrozenPosition="@column.Position" />
                                        }
                                    </GridColumnsBase>
                                </GridControl>
                            </div>
                        </section>
                    }
                    else if (UsesProviderGrid)
                    {
                        @if (_activeScreen == BenchScreen.ProviderExport)
                        {
                            <section class="fcg-controls" aria-label="Provider export controls">
                                <label>
                                    <span>CSV encoding</span>
                                    <DropDownListControl TValue="GridDelimitedTextEncoding" TItem="GridDelimitedTextEncoding"
                                                         DataSource="@(Enum.GetValues<GridDelimitedTextEncoding>())"
                                                         @bind-Value="_delimitedEncoding" AriaLabel="CSV encoding"
                                                         PanelFitContentWidth="true" />
                                </label>
                                <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="() => CreateProviderExport(GridExportFormat.Csv)" Disabled="@(_providerGrid?.IsProviderExporting == true)">Build complete CSV</ButtonControl>
                                <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="() => CreateProviderExport(GridExportFormat.Xlsx)" Disabled="@(_providerGrid?.IsProviderExporting == true)">Build complete XLSX</ButtonControl>
                                <ButtonControl BareStyle="true" CssClass="fcg-button" OnClick="CancelProviderExport" Disabled="@(_providerGrid?.IsProviderExporting != true)">Cancel export</ButtonControl>
                            </section>
                        }

                        <div class="fcg-provider-status" role="status" aria-live="polite">
                            <span>provider calls: @_providerRequestCount.ToString("N0")</span>
                            <span class="fcg-provider-request"><b>last request:</b> @_providerLastRequest</span>
                            @if (_activeScreen == BenchScreen.ProviderExport)
                            {
                                <span>export: @_providerExportText</span>
                                <span>bytes: @_providerExportBytes.ToString("N0")</span>
                            }
                        </div>
                        <section id="provider-enterprise-grid" class="fcg-card fcg-provider-card">
                            <div class="fcg-card-title">
                                <b>@ActiveScreenTitle</b>
                                <span>@ProviderGridCaption</span>
                            </div>
                            <div class="fcg-provider-grid">
                                <GridControl @key="ProviderGridRenderKey"
                                             @ref="_providerGrid"
                                             TValue="ProviderOrder"
                                             ItemsProvider="@_provider"
                                             ItemKeySelector="row => row.Id"
                                             ItemsProviderContextKey="@ActiveProviderContextKey"
                                             Height="100%"
                                             AccessibleLabel="@($"{ActiveScreenTitle} provider grid")"
                                             AllowGrouping="@IsProviderGroupingScreen"
                                             GroupColumns="@ActiveProviderGroups"
                                             EnableProviderGrouping="@IsProviderGroupingScreen"
                                             ProviderGroupsInitiallyCollapsed="true"
                                             ProviderGroupPageSize="2"
                                             ProviderGroupItemPageSize="80"
                                             ShowGroupCount="true"
                                             AllowSorting="true"
                                             AllowMultiSorting="true"
                                             AllowFiltering="true"
                                             FilterMode="@ActiveProviderFilterMode"
                                             EnableAdvancedFilterPopup="true"
                                             EnableBlankRowFilter="true"
                                             EnableProviderFilterValueRequests="true"
                                             ProviderFilterValueRequestSize="500"
                                             ShowSearchBar="true"
                                             ShowColumnMenu="true"
                                             AllowResizing="true"
                                             ExportAllProviderItems="true"
                                             ProviderExportPageSize="350"
                                             DelimitedExportEncoding="@_delimitedEncoding"
                                             ProviderExportProgressChanged="@ActiveProviderProgressCallback"
                                             ShowRowCountInFooter="true"
                                             AggregateRows="@ActiveProviderAggregates">
                                    <GridColumnsBase>
                                        <GridColumn Field="@nameof(ProviderOrder.Id)" HeaderText="Order" Width="80px" Type="ColumnType.Number" />
                                        <GridColumn Field="@nameof(ProviderOrder.Region)" HeaderText="Region" Width="105px" />
                                        <GridColumn Field="@nameof(ProviderOrder.Category)" HeaderText="Category" Width="130px" />
                                        <GridColumn Field="@nameof(ProviderOrder.Customer)" HeaderText="Customer" Width="210px" />
                                        <GridColumn Field="@nameof(ProviderOrder.OrderDate)" HeaderText="Date" Width="105px" Type="ColumnType.Date" Format="d" />
                                        <GridColumn Field="@nameof(ProviderOrder.Quantity)" HeaderText="Qty" Width="70px" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                                        <GridColumn Field="@nameof(ProviderOrder.Amount)" HeaderText="Amount" Width="115px" Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" />
                                    </GridColumnsBase>
                                </GridControl>
                            </div>
                            <p class="fcg-provider-note">@ProviderScreenNote</p>
                        </section>
                    }
                }
            </section>
        </div>
    </div>
    </div>
</PageControl>

@code {
    private static string ControlKitAssembly =>
        typeof(GridControl<>).Assembly.GetName().Name ?? "Unknown";

    private enum BenchScreen
    {
        Overview,
        MultiSort,
        InlineEditing,
        DialogEditing,
        BatchEditing,
        Validation,
        FilterRow,
        DualFilterMenu,
        ExcelChecklist,
        FilterCellTemplate,
        FilterMenuTemplate,
        HeaderBands,
        ColumnMenu,
        RightLocking,
        AutoColumns,
        MasterDetail,
        LocalCsvExport,
        LocalXlsxExport,
        Pager,
        State,
        GridTemplates,
        RowNoDataTemplates,
        AdaptiveLayout,
        Accessibility,
        ColumnVirtualization,
        ProviderQuery,
        ProviderFilterValues,
        ProviderGrouping,
        ProviderExport
    }

    private GridControl<EnterpriseRow>? _mainGrid;
    private GridControl<ProviderOrder>? _providerGrid;
    private readonly List<EnterpriseRow> _rows = [];
    private readonly List<EnterpriseRow> _rowSeed = [];
    private readonly List<AutoRow> _autoRows = [];
    private readonly List<AutoRow> _autoRowSeed = [];
    private List<TemplateRow> _templateRows = [];
    private readonly List<WideRow> _wideRows = [];
    private readonly List<WideColumn> _wideColumns = [];
    private readonly List<ProviderOrder> _providerRows = BuildProviderRows();
    private readonly List<TreeNode> _navigationNodes = BuildNavigationNodes();
    private GridItemsProvider<ProviderOrder> _provider = default!;
    private TreeNode? _selectedNavigationNode;
    private BenchScreen _activeScreen = BenchScreen.Overview;
    private GridState? _savedState;
    private int _mainGridKey;
    private int _providerGridKey;
    private int _stateEventCount;
    private int _stateJsonLength;
    private int _columnOverscan = 2;
    private string _status = "Ready. Click two headers to verify ordered local multi-sort, or use the sample button.";
    private string _multiSortVerification = "not run";
    private string _multiSortSample = "";
    private bool? _multiSortPassed;
    private EditMode _editMode = EditMode.Batch;
    private GridPagerPosition _pagerPosition = GridPagerPosition.Both;
    private GridDataLayoutMode _layoutMode = GridDataLayoutMode.Columns;
    private GridDelimitedTextEncoding _delimitedEncoding = GridDelimitedTextEncoding.Utf8NoBom;
    private bool _caseSensitive;
    private bool _showFilterRowOperators = true;
    private bool _showExpandColumn = true;
    private long _providerRequestCount;
    private int _providerExportBytes;
    private string _providerLastRequest = "waiting for first request";
    private string _providerExportText = "not started";

    private FeatureTest? ActiveTest =>
        FeatureTests.FirstOrDefault(test => test.Screen == _activeScreen);

    private string ActiveScreenTitle =>
        _activeScreen == BenchScreen.Overview ? "Feature test overview" : ActiveTest?.Feature ?? "Grid test";

    private string ActiveScreenGroup => _activeScreen switch
    {
        BenchScreen.Overview => "Overview",
        BenchScreen.MultiSort => "Sorting",
        BenchScreen.AutoColumns or BenchScreen.ColumnVirtualization => "Generated and virtualized",
        BenchScreen.ProviderQuery or BenchScreen.ProviderFilterValues or BenchScreen.ProviderGrouping or BenchScreen.ProviderExport => "Provider grid",
        BenchScreen.InlineEditing or BenchScreen.DialogEditing or BenchScreen.BatchEditing or BenchScreen.Validation => "Editing",
        BenchScreen.FilterRow or BenchScreen.DualFilterMenu or BenchScreen.ExcelChecklist or BenchScreen.FilterCellTemplate or BenchScreen.FilterMenuTemplate => "Filtering",
        BenchScreen.HeaderBands or BenchScreen.ColumnMenu or BenchScreen.RightLocking => "Columns",
        BenchScreen.MasterDetail or BenchScreen.GridTemplates or BenchScreen.RowNoDataTemplates or BenchScreen.AdaptiveLayout or BenchScreen.Accessibility => "Rows and presentation",
        BenchScreen.LocalCsvExport or BenchScreen.LocalXlsxExport => "Export",
        BenchScreen.Pager or BenchScreen.State => "Data and state",
        _ => "Local grid"
    };

    private string MainGridHostCss => _activeScreen == BenchScreen.RightLocking
        ? "fcg-grid-host fcg-grid-host-locking"
        : "fcg-grid-host";

    private bool UsesLocalEnterpriseGrid => _activeScreen is
