    private void CreateLocalExport(GridExportFormat format)
    {
        if (_mainGrid == null)
            return;

        var result = _mainGrid.CreateExport(
            format,
            $"flexcore-enterprise-local{GridExporter.DefaultExtension(format)}",
            "FlexCore local enterprise bench");

        if (format == GridExportFormat.Xlsx)
        {
            using var stream = new MemoryStream(result.Bytes, writable: false);
            using var workbook = new XLWorkbook(stream);
            var sheet = workbook.Worksheets.First();
            var headers = sheet.Row(1).CellsUsed().ToDictionary(
                cell => cell.GetString(),
                cell => cell.Address.ColumnNumber,
                StringComparer.OrdinalIgnoreCase);
            var idCell = sheet.Cell(2, headers["ID"]);
            var quantityCell = sheet.Cell(2, headers["Qty"]);
            var priceCell = sheet.Cell(2, headers["Price"]);
            var formulaCell = sheet.Cell(2, headers["Extended"]);
            var dateCell = sheet.Cell(2, headers["Effective"]);
            var formula = formulaCell.FormulaA1;
            var quantityAddress = quantityCell.Address.ToStringRelative();
            var priceAddress = priceCell.Address.ToStringRelative();
            var exportedId = idCell.DataType == XLDataType.Number
                ? Convert.ToInt32(idCell.GetDouble(), CultureInfo.InvariantCulture)
                : int.TryParse(idCell.GetString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsedId)
                    ? parsedId
                    : -1;
            var exportedRow = _rows.FirstOrDefault(row => row.Id == exportedId);
            var nativeValuesValid = exportedRow is not null
                && quantityCell.DataType == XLDataType.Number
                && priceCell.DataType == XLDataType.Number
                && dateCell.DataType == XLDataType.DateTime
                && Math.Abs(quantityCell.GetDouble() - exportedRow.Quantity) < 0.000001
                && Math.Abs(priceCell.GetDouble() - (double)exportedRow.Price) < 0.000001
                && dateCell.GetDateTime().Date == exportedRow.EffectiveDate.Date;
            var nativeFormatsValid = !string.Equals(priceCell.Style.NumberFormat.Format, "C2", StringComparison.Ordinal)
                && priceCell.Style.NumberFormat.Format.Contains("#,##0", StringComparison.Ordinal)
                && !string.Equals(dateCell.Style.NumberFormat.Format, "d", StringComparison.Ordinal)
                && dateCell.Style.NumberFormat.Format.Contains("yyyy", StringComparison.OrdinalIgnoreCase);
            var formulaValid = !string.IsNullOrWhiteSpace(formula)
                && formula.Contains(quantityAddress, StringComparison.OrdinalIgnoreCase)
                && formula.Contains(priceAddress, StringComparison.OrdinalIgnoreCase);
            var runtimeWidths = _mainGrid.GetState().ColumnSettings.Widths;
            (string Header, string Field, double DefaultPixels)[] widthExpectations =
            [
                ("ID", nameof(EnterpriseRow.Id), 65),
                ("Item", nameof(EnterpriseRow.Code), 90),
                ("Description", nameof(EnterpriseRow.Name), 250),
                ("Category", nameof(EnterpriseRow.Category), 150),
                ("Qty", nameof(EnterpriseRow.Quantity), 80),
                ("Price", nameof(EnterpriseRow.Price), 100),
                ("Extended", nameof(EnterpriseRow.Extended), 115),
                ("Effective", nameof(EnterpriseRow.EffectiveDate), 115),
                ("Active", nameof(EnterpriseRow.Active), 75),
                ("Status", nameof(EnterpriseRow.Status), 110)
            ];
            var widthsValid = widthExpectations.All(expectation =>
            {
                var pixels = runtimeWidths is not null
                    && runtimeWidths.TryGetValue(expectation.Field, out var runtimeWidth)
                        ? runtimeWidth
                        : expectation.DefaultPixels;
                var expectedWidth = ConvertPixelsToExpectedExcelWidth(pixels);
                var actualWidth = sheet.Column(headers[expectation.Header]).Width;
                return Math.Abs(actualWidth - expectedWidth) <= 0.35;
            });
            _status = nativeValuesValid && nativeFormatsValid && formulaValid && widthsValid
                ? $"Built XLSX ({result.Bytes.Length:N0} bytes); verified native number/date cells, Excel formats, all visible column widths, and formula '{formula}'."
                : $"Built XLSX ({result.Bytes.Length:N0} bytes), but workbook verification failed "
                    + $"(types={quantityCell.DataType}/{priceCell.DataType}/{dateCell.DataType}, formats={nativeFormatsValid}, widths={widthsValid}, formula='{formula}').";
            return;
        }

        VerifyLocalCsv(result);
    }

    private void VerifyLocalCsv(GridExportResult csvResult)
    {
        if (_mainGrid == null)
            return;

        var encoding = ResolveDelimitedEncoding(_delimitedEncoding);
        var expectedPreamble = ResolveDelimitedPreamble(_delimitedEncoding);
        var hasKnownPreamble = csvResult.Bytes.AsSpan().StartsWith(Encoding.UTF8.GetPreamble())
            || csvResult.Bytes.AsSpan().StartsWith(Encoding.Unicode.GetPreamble());
        var preambleValid = expectedPreamble.Length > 0
            ? csvResult.Bytes.AsSpan().StartsWith(expectedPreamble)
            : !hasKnownPreamble;
        var contentOffset = expectedPreamble.Length > 0 && preambleValid
            ? expectedPreamble.Length
            : 0;
        var content = encoding.GetString(
            csvResult.Bytes,
            contentOffset,
            csvResult.Bytes.Length - contentOffset);
        var roundTripValid = csvResult.Bytes.AsSpan(contentOffset)
            .SequenceEqual(encoding.GetBytes(content));
        var records = ParseCsv(content);

        var jsonResult = _mainGrid.CreateExport(
            GridExportFormat.Json,
            "flexcore-csv-verification.json",
            "FlexCore CSV verification");
        using var document = JsonDocument.Parse(jsonResult.Bytes);
        var jsonRows = document.RootElement.EnumerateArray().ToList();
        var jsonHeaders = jsonRows.Count == 0
            ? new List<string>()
            : jsonRows[0].EnumerateObject().Select(property => property.Name).ToList();
        List<string> csvHeaders = records.Count == 0 ? [] : records[0];
        var csvRows = records.Skip(1)
            .Where(row => row.Any(value => value.Length > 0))
            .ToList();
        var schemaValid = jsonHeaders.Count > 0
            && csvHeaders.SequenceEqual(jsonHeaders, StringComparer.Ordinal);
        var rowShapeValid = csvRows.All(row => row.Count == csvHeaders.Count);
        var idColumn = csvHeaders.FindIndex(header =>
            string.Equals(header, "ID", StringComparison.OrdinalIgnoreCase));
        List<string> csvIds = idColumn < 0
            ? []
            : csvRows.Select(row => idColumn < row.Count ? row[idColumn] : "<missing>").ToList();
        var jsonIds = jsonRows
            .Select(row => ReadJsonExportValue(row, "ID"))
            .ToList();
        var queryOrderValid = csvIds.SequenceEqual(jsonIds, StringComparer.Ordinal);
        var passed = preambleValid
            && roundTripValid
            && schemaValid
            && rowShapeValid
            && queryOrderValid;
        var prefixLength = Math.Min(3, csvResult.Bytes.Length);
        var prefix = Convert.ToHexString(csvResult.Bytes.AsSpan(0, prefixLength));
        _status = passed
            ? $"Built and verified CSV with {_delimitedEncoding}: {csvRows.Count:N0} rows, {csvHeaders.Count:N0} visible columns, current query order, exact encoding round trip, prefix {prefix}."
            : $"Built CSV ({csvResult.Bytes.Length:N0} bytes), but verification failed "
                + $"(preamble={preambleValid}, encoding={roundTripValid}, schema={schemaValid}, row-shape={rowShapeValid}, order={queryOrderValid}, prefix={prefix}).";
    }

    private static Encoding ResolveDelimitedEncoding(GridDelimitedTextEncoding encoding) => encoding switch
    {
        GridDelimitedTextEncoding.Utf16LittleEndian =>
            new UnicodeEncoding(bigEndian: false, byteOrderMark: false, throwOnInvalidBytes: true),
        GridDelimitedTextEncoding.Ascii => Encoding.ASCII,
        _ => new UTF8Encoding(encoderShouldEmitUTF8Identifier: false, throwOnInvalidBytes: true)
    };

    private static byte[] ResolveDelimitedPreamble(GridDelimitedTextEncoding encoding) => encoding switch
    {
        GridDelimitedTextEncoding.Utf8WithBom => Encoding.UTF8.GetPreamble(),
        GridDelimitedTextEncoding.Utf16LittleEndian => Encoding.Unicode.GetPreamble(),
        _ => []
    };

    private static double ConvertPixelsToExpectedExcelWidth(double pixels) =>
        Math.Clamp((pixels - 5d) / 7d, 4d, 80d);

    private static List<List<string>> ParseCsv(string content)
    {
        var records = new List<List<string>>();
        var record = new List<string>();
        var field = new StringBuilder();
        var inQuotes = false;

        for (var index = 0; index < content.Length; index++)
        {
            var current = content[index];
            if (inQuotes)
            {
                if (current == '"')
                {
                    if (index + 1 < content.Length && content[index + 1] == '"')
                    {
                        field.Append('"');
                        index++;
                    }
                    else
                    {
                        inQuotes = false;
                    }
                }
                else
                {
                    field.Append(current);
                }
                continue;
            }

            switch (current)
            {
                case '"':
                    inQuotes = true;
                    break;
                case ',':
                    record.Add(field.ToString());
                    field.Clear();
                    break;
                case '\r':
                    if (index + 1 < content.Length && content[index + 1] == '\n')
                        index++;
                    record.Add(field.ToString());
                    field.Clear();
                    records.Add(record);
                    record = [];
                    break;
                case '\n':
                    record.Add(field.ToString());
                    field.Clear();
                    records.Add(record);
                    record = [];
                    break;
                default:
                    field.Append(current);
                    break;
            }
        }

        if (field.Length > 0 || record.Count > 0)
        {
            record.Add(field.ToString());
            records.Add(record);
        }

        return records;
    }

