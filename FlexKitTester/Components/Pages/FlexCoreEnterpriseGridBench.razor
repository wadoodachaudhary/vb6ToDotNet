    private async ValueTask<GridItemsResult<ProviderOrder>> LoadProviderRowsAsync(
        GridItemsRequest request)
    {
        Interlocked.Increment(ref _providerRequestCount);
        await Task.Delay(
            request.Purpose == GridItemsRequestPurpose.Export ? 12 : 65,
            request.CancellationToken);

        var filtered = ApplyProviderQuery(_providerRows, request.Query).ToList();
        request.CancellationToken.ThrowIfCancellationRequested();
        if (Equals(request.ContextKey, ActiveProviderContextKey))
        {
            _providerLastRequest = DescribeProviderRequest(request);
            await InvokeAsync(StateHasChanged);
        }

        if (request.Purpose == GridItemsRequestPurpose.FilterValues)
        {
            var field = request.FilterField
                ?? throw new InvalidOperationException("FilterValues requests require FilterField.");
            var allValues = filtered
                .GroupBy(row => Convert.ToString(
                    GetProviderFieldValue(row, field),
                    CultureInfo.InvariantCulture) ?? string.Empty,
                    StringComparerFrom(request.Query.CaseSensitive
                        ? StringComparison.Ordinal
                        : StringComparison.OrdinalIgnoreCase))
                .Select(group => new GridProviderFilterValue(
                    group.Key,
                    group.Key.Length == 0 ? "(blank)" : group.Key,
                    group.Count()))
                .OrderBy(value => value.DisplayText, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
            var page = allValues.Skip(request.StartIndex).Take(request.Count).ToList();
            return new GridItemsResult<ProviderOrder>([], filtered.Count)
            {
                FilterValues = page,
                ResultSetCount = allValues.Count,
                HasMore = request.StartIndex + page.Count < allValues.Count
            };
        }

        var scoped = ApplyProviderGroupKeys(filtered, request.GroupRequest?.ParentKeys).ToList();

        if (request.Purpose is GridItemsRequestPurpose.Groups or GridItemsRequestPurpose.GroupChildren)
        {
            var level = request.Purpose == GridItemsRequestPurpose.Groups
                ? 0
                : request.GroupRequest!.Level + 1;
            if (level >= request.Query.Groups.Count)
                return new GridItemsResult<ProviderOrder>([], filtered.Count);

            var descriptor = request.Query.Groups[level];
            var grouped = scoped
                .GroupBy(row => GetProviderFieldValue(row, descriptor.Field))
                .Select(group => new ProviderGroupPage(group.Key, group.ToList()));
            grouped = descriptor.Direction == SortDirection.Descending
                ? grouped.OrderByDescending(group => Convert.ToString(group.Key, CultureInfo.CurrentCulture))
                : grouped.OrderBy(group => Convert.ToString(group.Key, CultureInfo.CurrentCulture));
            var allGroups = grouped.ToList();
            var page = allGroups
                .Skip(request.StartIndex)
                .Take(request.Count)
                .Select(group => new GridProviderGroup<ProviderOrder>(
                    descriptor.Field,
                    group.Key,
                    Convert.ToString(group.Key, CultureInfo.CurrentCulture),
                    group.Rows.Count)
                {
                    HasChildren = group.Rows.Count > 0,
                    ChildCount = level + 1 < request.Query.Groups.Count
                        ? group.Rows.Select(row => GetProviderFieldValue(row, request.Query.Groups[level + 1].Field)).Distinct().Count()
                        : group.Rows.Count,
                    Aggregates = BuildProviderAggregates(group.Rows, request.Query.Aggregates)
                })
                .ToList();

            return new GridItemsResult<ProviderOrder>([], filtered.Count)
            {
                Groups = page,
                ResultSetCount = allGroups.Count,
                HasMore = request.StartIndex + page.Count < allGroups.Count,
                Aggregates = BuildProviderAggregates(scoped, request.Query.Aggregates)
            };
        }

        var sorted = ApplyProviderSorts(scoped, request.Query.Sorts).ToList();
        var items = sorted.Skip(request.StartIndex).Take(request.Count).ToList();
        return new GridItemsResult<ProviderOrder>(items, filtered.Count)
        {
            ResultSetCount = sorted.Count,
            HasMore = request.StartIndex + items.Count < sorted.Count,
            Aggregates = BuildProviderAggregates(
                request.Purpose == GridItemsRequestPurpose.Export ? filtered : scoped,
                request.Query.Aggregates)
        };
    }

    private static string DescribeProviderRequest(GridItemsRequest request)
    {
        var query = request.Query;
        var endExclusive = (long)request.StartIndex + request.Count;
        var parts = new List<string>
        {
            request.Purpose.ToString(),
            $"range [{request.StartIndex:N0}..{endExclusive:N0}) / Take {request.Count:N0}",
            $"version {request.QueryVersion:N0}",
            request.IncludeTotalCount ? "total requested" : "total not requested",
            "sort " + (query.Sorts.Count == 0
                ? "none"
                : string.Join(" > ", query.Sorts.Select((sort, index) =>
                    $"{index + 1}:{sort.Field} {sort.Direction}"))),
            "filter " + (query.Filters.Count == 0
                ? "none"
                : string.Join("; ", query.Filters.Select(DescribeProviderFilter)))
        };

        if (!string.IsNullOrWhiteSpace(query.SearchText))
        {
            parts.Add($"search {TelemetryValue(query.SearchText)} in "
                + (query.SearchFields.Count == 0 ? "all fields" : string.Join(",", query.SearchFields)));
        }
        if (!string.IsNullOrWhiteSpace(query.ExpressionFilterText))
            parts.Add($"expression {TelemetryValue(query.ExpressionFilterText)}");
        if (query.Groups.Count > 0)
        {
            parts.Add("groups " + string.Join(" > ", query.Groups.Select(group =>
                $"{group.Field} {group.Direction}")));
        }
        if (query.Aggregates.Count > 0)
        {
            parts.Add("aggregates " + string.Join(", ", query.Aggregates.Select(aggregate =>
                $"{aggregate.Type}({aggregate.Field})")));
        }
        if (request.GroupRequest is not null)
        {
            var keys = string.Join(" > ", request.GroupRequest.ParentKeys.Select(key =>
                $"{key.Field}={TelemetryValue(Convert.ToString(key.Value, CultureInfo.InvariantCulture))}"));
            parts.Add($"group-parent level {request.GroupRequest.Level}, path {TelemetryValue(request.GroupRequest.ParentPath)}, keys {keys}");
        }
        if (!string.IsNullOrWhiteSpace(request.FilterField))
            parts.Add($"filter-values field {request.FilterField}");
        if (query.CaseSensitive)
            parts.Add("case-sensitive");

        return string.Join(" · ", parts);
    }

    private static string DescribeProviderFilter(GridFilterDescriptor filter)
    {
        var primaryOperator = filter.AdvancedOperator?.ToString() ?? filter.Operator.ToString();
        var parts = new List<string>
        {
            $"{filter.Field}[{filter.Source}/{filter.Kind}] {primaryOperator} {TelemetryValue(filter.Value)}"
        };

        if (filter.Values.Count > 0)
            parts.Add("values={" + string.Join(",", filter.Values.Select(TelemetryValue)) + "}");
        if (filter.Minimum.HasValue || filter.Maximum.HasValue)
            parts.Add($"bounds={filter.Minimum?.ToString(CultureInfo.InvariantCulture) ?? "−∞"}..{filter.Maximum?.ToString(CultureInfo.InvariantCulture) ?? "+∞"}");
        if (filter.NumericRanges.Count > 0)
        {
            parts.Add("ranges={" + string.Join(",", filter.NumericRanges.Select(range =>
                $"{range.Key}[{range.Minimum?.ToString(CultureInfo.InvariantCulture) ?? "−∞"}..{range.Maximum?.ToString(CultureInfo.InvariantCulture) ?? "+∞"}{(range.IncludeMaximum ? "]" : ")")}{(range.IsBlank ? "/blank" : "")}")) + "}");
        }
        if (filter.SecondOperator.HasValue || filter.SecondAdvancedOperator.HasValue)
        {
            var secondOperator = filter.SecondAdvancedOperator?.ToString()
                ?? filter.SecondOperator?.ToString()
                ?? "condition";
            parts.Add($"{filter.LogicalOperator} {secondOperator} {TelemetryValue(filter.SecondValue)}");
        }
        if (filter.BlankRowFilter != BlankRowFilterMode.All)
            parts.Add($"blank={filter.BlankRowFilter}");

        return string.Join(" ", parts);
    }

    private static string TelemetryValue(string? value) =>
        value is null ? "<null>" : $"'{value.Replace("'", "''", StringComparison.Ordinal)}'";

    private async Task CreateProviderExport(GridExportFormat format)
    {
        var grid = _providerGrid;
        if (grid == null)
            return;
        var contextKey = ActiveProviderContextKey;
        var generation = _providerGridKey;
        _providerExportBytes = 0;
        _providerExportText = "starting";
        try
        {
            var result = await grid.CreateProviderExportAsync(
                format,
                $"flexcore-provider-bench{GridExporter.DefaultExtension(format)}",
                "FlexCore provider bench");
            if (!ReferenceEquals(grid, _providerGrid)
                || generation != _providerGridKey
                || !string.Equals(contextKey, ActiveProviderContextKey, StringComparison.Ordinal))
            {
                return;
            }
            _providerExportBytes = result.Bytes.Length;
            _providerExportText = $"{format} complete ({grid.ProviderExportProgress?.ExportedRows:N0} rows)";
        }
        catch (OperationCanceledException)
        {
            if (ReferenceEquals(grid, _providerGrid) && generation == _providerGridKey)
                _providerExportText = "canceled";
        }
        catch (Exception exception)
        {
            if (ReferenceEquals(grid, _providerGrid) && generation == _providerGridKey)
                _providerExportText = $"failed: {exception.Message}";
        }
    }

    private void CancelProviderExport() => _providerGrid?.CancelProviderExport();

    private Task HandleProviderExportProgress(
        int generation,
        GridProviderExportProgress progress)
    {
        if (_activeScreen != BenchScreen.ProviderExport || generation != _providerGridKey)
            return Task.CompletedTask;

        _providerExportText = progress.IsCanceled
            ? "canceled"
            : progress.IsCompleted
                ? $"complete ({progress.ExportedRows:N0} rows)"
                : $"{progress.ExportedRows:N0} / {(progress.TotalRows?.ToString("N0") ?? "?")}";
        return Task.CompletedTask;
    }

    private static IEnumerable<ProviderOrder> ApplyProviderQuery(
        IEnumerable<ProviderOrder> source,
        GridQueryDescriptor query)
    {
        var comparison = query.CaseSensitive
            ? StringComparison.Ordinal
            : StringComparison.OrdinalIgnoreCase;

        if (!string.IsNullOrWhiteSpace(query.SearchText))
        {
            var search = query.SearchText;
            source = source.Where(row => query.SearchFields.Any(field =>
                (Convert.ToString(GetProviderFieldValue(row, field), CultureInfo.CurrentCulture) ?? string.Empty)
                    .Contains(search, comparison)));
        }

        foreach (var filter in query.Filters)
        {
            var captured = filter;
            source = source.Where(row => PassesProviderFilter(
                GetProviderFieldValue(row, captured.Field),
                captured,
                comparison));
        }

        return source;
    }

    private static bool PassesProviderFilter(
        object? rawValue,
        GridFilterDescriptor filter,
        StringComparison comparison)
    {
        var text = Convert.ToString(rawValue, CultureInfo.InvariantCulture) ?? string.Empty;
        var isBlank = string.IsNullOrWhiteSpace(text);
        if (filter.BlankRowFilter == BlankRowFilterMode.BlanksOnly && !isBlank)
            return false;
        if (filter.BlankRowFilter == BlankRowFilterMode.NonBlanksOnly && isBlank)
            return false;

        if (filter.Kind == GridProviderFilterKind.CheckedValues)
            return filter.Values.Contains(text, StringComparerFrom(comparison));

        if (filter.Kind == GridProviderFilterKind.NumericBounds)
        {
            if (!decimal.TryParse(text, NumberStyles.Any, CultureInfo.InvariantCulture, out var number))
                return false;
            return (!filter.Minimum.HasValue || number >= filter.Minimum.Value)
                && (!filter.Maximum.HasValue || number <= filter.Maximum.Value);
        }

        if (filter.Kind == GridProviderFilterKind.NumericRanges && filter.NumericRanges.Count > 0)
        {
            if (!decimal.TryParse(text, NumberStyles.Any, CultureInfo.InvariantCulture, out var number))
                return filter.NumericRanges.Any(range => range.IsBlank && isBlank);
            return filter.NumericRanges.Any(range => !range.IsBlank
                && (!range.Minimum.HasValue || number >= range.Minimum.Value)
                && (!range.Maximum.HasValue
                    || (range.IncludeMaximum ? number <= range.Maximum.Value : number < range.Maximum.Value)));
        }

        var first = MatchesProviderOperator(rawValue, text, filter.Value, filter.Operator, comparison);
        if (!filter.SecondOperator.HasValue)
            return first;
        var second = MatchesProviderOperator(rawValue, text, filter.SecondValue, filter.SecondOperator.Value, comparison);
        return filter.LogicalOperator == LogicalFilterOperator.Or ? first || second : first && second;
    }

    private static bool MatchesProviderOperator(
        object? rawValue,
        string actual,
        string? expected,
        TextFilterOperator filterOperator,
        StringComparison comparison)
    {
        expected ??= string.Empty;
        var compare = CompareProviderFilterValues(rawValue, actual, expected, comparison);
        return filterOperator switch
        {
            TextFilterOperator.ChooseOne => true,
            TextFilterOperator.Equals => compare == 0,
            TextFilterOperator.DoesNotEqual => compare != 0,
            TextFilterOperator.BeginsWith => actual.StartsWith(expected, comparison),
            TextFilterOperator.DoesNotBeginWith => !actual.StartsWith(expected, comparison),
            TextFilterOperator.EndsWith => actual.EndsWith(expected, comparison),
            TextFilterOperator.DoesNotEndWith => !actual.EndsWith(expected, comparison),
            TextFilterOperator.Contains => actual.Contains(expected, comparison),
            TextFilterOperator.DoesNotContain => !actual.Contains(expected, comparison),
            TextFilterOperator.GreaterThan => compare > 0,
            TextFilterOperator.GreaterThanOrEqual => compare >= 0,
            TextFilterOperator.LessThan => compare < 0,
            TextFilterOperator.LessThanOrEqual => compare <= 0,
            TextFilterOperator.IsEmpty => string.IsNullOrEmpty(actual),
            TextFilterOperator.IsNotEmpty => !string.IsNullOrEmpty(actual),
            _ => true
        };
    }

    private static int CompareProviderFilterValues(
        object? rawValue,
        string actual,
        string expected,
        StringComparison comparison)
    {
        if (rawValue is DateTime date
            && DateTime.TryParse(expected, CultureInfo.CurrentCulture, DateTimeStyles.AllowWhiteSpaces, out var expectedDate))
        {
            return date.Date.CompareTo(expectedDate.Date);
        }

        if (rawValue is bool boolean && bool.TryParse(expected, out var expectedBoolean))
            return boolean.CompareTo(expectedBoolean);

        return CompareProviderValues(actual, expected, comparison);
    }

    private static int CompareProviderValues(
        string left,
        string right,
        StringComparison comparison)
    {
        if (decimal.TryParse(left, NumberStyles.Any, CultureInfo.InvariantCulture, out var leftNumber)
            && decimal.TryParse(right, NumberStyles.Any, CultureInfo.InvariantCulture, out var rightNumber))
        {
            return leftNumber.CompareTo(rightNumber);
        }
        return string.Compare(left, right, comparison);
    }

    private static StringComparer StringComparerFrom(StringComparison comparison) => comparison switch
    {
        StringComparison.Ordinal => StringComparer.Ordinal,
        _ => StringComparer.OrdinalIgnoreCase
    };

    private static IEnumerable<ProviderOrder> ApplyProviderGroupKeys(
        IEnumerable<ProviderOrder> source,
        IReadOnlyList<GridProviderGroupKey>? keys)
    {
        if (keys == null)
            return source;
        foreach (var key in keys)
        {
            source = source.Where(row => string.Equals(
                Convert.ToString(GetProviderFieldValue(row, key.Field), CultureInfo.InvariantCulture),
                Convert.ToString(key.Value, CultureInfo.InvariantCulture),
                StringComparison.Ordinal));
        }
        return source;
    }

    private static IEnumerable<ProviderOrder> ApplyProviderSorts(
        IEnumerable<ProviderOrder> source,
        IReadOnlyList<GridSortDescriptor> sorts)
    {
        IOrderedEnumerable<ProviderOrder>? ordered = null;
        foreach (var sort in sorts)
        {
            Func<ProviderOrder, object?> selector = row => GetProviderFieldValue(row, sort.Field);
            ordered = ordered == null
                ? sort.Direction == SortDirection.Descending
                    ? source.OrderByDescending(selector, ProviderValueComparer.Instance)
                    : source.OrderBy(selector, ProviderValueComparer.Instance)
                : sort.Direction == SortDirection.Descending
                    ? ordered.ThenByDescending(selector, ProviderValueComparer.Instance)
                    : ordered.ThenBy(selector, ProviderValueComparer.Instance);
        }
        return ordered ?? source.OrderBy(row => row.Id);
    }

    private static object? GetProviderFieldValue(ProviderOrder row, string field) => field switch
    {
        nameof(ProviderOrder.Id) => row.Id,
        nameof(ProviderOrder.Region) => row.Region,
        nameof(ProviderOrder.Category) => row.Category,
        nameof(ProviderOrder.Customer) => row.Customer,
        nameof(ProviderOrder.OrderDate) => row.OrderDate,
        nameof(ProviderOrder.Quantity) => row.Quantity,
        nameof(ProviderOrder.Amount) => row.Amount,
        _ => null
    };

    private static IReadOnlyList<GridAggregateResult> BuildProviderAggregates(
        IReadOnlyCollection<ProviderOrder> rows,
        IReadOnlyList<GridAggregateQueryDescriptor> requested) =>
        requested.Select(aggregate => new GridAggregateResult(
            aggregate.Field,
            aggregate.Type,
            (aggregate.Field, aggregate.Type) switch
            {
                (nameof(ProviderOrder.Amount), AggregateType.Sum) => rows.Sum(row => row.Amount),
                (nameof(ProviderOrder.Amount), AggregateType.Average) when rows.Count > 0 => rows.Average(row => row.Amount),
                (nameof(ProviderOrder.Amount), AggregateType.Min) when rows.Count > 0 => rows.Min(row => row.Amount),
                (nameof(ProviderOrder.Amount), AggregateType.Max) when rows.Count > 0 => rows.Max(row => row.Amount),
                (_, AggregateType.Count) => rows.Count,
                _ => null
            })).ToList();

    private void VerifyLocalMultiSort()
    {
        if (_mainGrid == null)
            return;

        var state = _mainGrid.GetState();
        IOrderedEnumerable<EnterpriseRow>? ordered = null;
        foreach (var sort in state.Sorts)
        {
            Func<EnterpriseRow, object?> selector = row => GetEnterpriseSortValue(row, sort.Field);
            ordered = ordered == null
                ? sort.Direction == SortDirection.Descending
                    ? _rows.OrderByDescending(selector, EnterpriseSortComparer.Instance)
                    : _rows.OrderBy(selector, EnterpriseSortComparer.Instance)
                : sort.Direction == SortDirection.Descending
                    ? ordered.ThenByDescending(selector, EnterpriseSortComparer.Instance)
                    : ordered.ThenBy(selector, EnterpriseSortComparer.Instance);
        }
        var expectedRows = (ordered ?? (IEnumerable<EnterpriseRow>)_rows).ToList();
        var expected = expectedRows
            .Select(row => new ExportSignature(row.Id.ToString(CultureInfo.InvariantCulture), row.Category, row.Name))
            .ToList();

        var result = _mainGrid.CreateExport(
            GridExportFormat.Json,
            "flexcore-multisort-verification.json",
            "FlexCore multi-sort verification");
        using var document = JsonDocument.Parse(result.Bytes);
        var actual = document.RootElement.EnumerateArray()
            .Select(row => new ExportSignature(
                ReadJsonExportValue(row, "ID"),
                ReadJsonExportValue(row, "Category"),
                ReadJsonExportValue(row, "Description")))
            .ToList();

        var secondaryComparisons = 0;
        for (var index = 1; index < expectedRows.Count; index++)
        {
            for (var priority = 0; priority < state.Sorts.Count - 1; priority++)
            {
                var field = state.Sorts[priority].Field;
                if (EnterpriseSortComparer.Instance.Compare(
                        GetEnterpriseSortValue(expectedRows[index - 1], field),
                        GetEnterpriseSortValue(expectedRows[index], field)) != 0)
                    break;
                secondaryComparisons++;
            }
        }

        var mismatchIndex = expected.Count == actual.Count
            ? Enumerable.Range(0, expected.Count).FirstOrDefault(index => expected[index] != actual[index], -1)
            : Math.Min(expected.Count, actual.Count);
        _multiSortPassed = expected.Count == actual.Count && mismatchIndex < 0;
        _multiSortVerification = _multiSortPassed == true
            ? $"PASS — {actual.Count:N0} rows / {state.Sorts.Count} levels / {secondaryComparisons:N0} tie comparisons"
            : $"FAIL — first mismatch at row {mismatchIndex + 1:N0}";
        _multiSortSample = string.Join(" | ", state.Sorts.Select(sort => $"{sort.Field} {sort.Direction}"));
        _status = _multiSortPassed == true
            ? $"Verified all {actual.Count:N0} exported rows against an independent ordering with {state.Sorts.Count} sort levels."
            : $"Multi-sort verification failed. expected={expected.Count:N0}, actual={actual.Count:N0}, mismatch={mismatchIndex + 1:N0}.";
    }

    private static object? GetEnterpriseSortValue(EnterpriseRow row, string field) => field switch
    {
        nameof(EnterpriseRow.Id) => row.Id,
        nameof(EnterpriseRow.Code) => row.Code,
        nameof(EnterpriseRow.Name) => row.Name,
        nameof(EnterpriseRow.Category) => row.Category,
        nameof(EnterpriseRow.Quantity) => row.Quantity,
        nameof(EnterpriseRow.Price) => row.Price,
        nameof(EnterpriseRow.Extended) => row.Extended,
        nameof(EnterpriseRow.EffectiveDate) => row.EffectiveDate,
        nameof(EnterpriseRow.Active) => row.Active,
        nameof(EnterpriseRow.Status) => row.Status,
        _ => throw new InvalidOperationException($"Unknown sort field: {field}.")
    };

    private sealed class EnterpriseSortComparer : IComparer<object?>
    {
        internal static EnterpriseSortComparer Instance { get; } = new();
        public int Compare(object? left, object? right) =>
            left is string leftText && right is string rightText
                ? StringComparer.CurrentCultureIgnoreCase.Compare(leftText, rightText)
                : Comparer<object?>.Default.Compare(left, right);
    }

    private static string ReadJsonExportValue(JsonElement row, string header)
    {
        if (!row.TryGetProperty(header, out var value))
            return "";

        return value.ValueKind switch
        {
            JsonValueKind.String => value.GetString() ?? "",
            JsonValueKind.Number => value.GetRawText(),
            JsonValueKind.True => bool.TrueString,
            JsonValueKind.False => bool.FalseString,
            JsonValueKind.Null => "",
            _ => value.ToString()
        };
    }

    private static List<ProviderOrder> BuildProviderRows()
    {
        string[] regions = ["North", "South", "East", "West"];
        string[] categories = ["Cabinets", "Electrical", "Flooring", "Hardware", "Plumbing", "Windows"];
        var rows = new List<ProviderOrder>(12_000);
        for (var id = 1; id <= 12_000; id++)
        {
            rows.Add(new ProviderOrder
            {
                Id = id,
                Region = regions[id % regions.Length],
                Category = categories[(id * 7) % categories.Length],
                Customer = $"HomeFront customer {(id * 13) % 425:D3}",
                OrderDate = new DateTime(2024, 1, 1).AddDays(id % 730),
                Quantity = 1 + id % 50,
                Amount = 25m + (id % 500) * 3.17m
            });
        }
        return rows;
    }

