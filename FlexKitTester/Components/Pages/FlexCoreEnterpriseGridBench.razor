                                     Value="@pager.PageSize" ValueChanged="size => SetPagerPageSize(pager, size)"
                                     AriaLabel="Rows per page" PanelFitContentWidth="true" />
            </label>
            <ButtonControl BareStyle="true" CssClass="fcg-button" Disabled="@(pager.CurrentPage >= pager.TotalPages)"
                    OnClick="() => pager.GoToPageAsync(pager.CurrentPage + 1)">Next</ButtonControl>
        </div>;

    private RenderFragment<GridColumnChooserContext> ColumnChooserContent => chooser =>
