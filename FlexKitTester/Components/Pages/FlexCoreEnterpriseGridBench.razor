    private static TreeNode CreateNavigationLeaf(
        BenchScreen screen,
        string text,
        bool selected = false) => new()
        {
            Id = $"fcg-screen-{screen}",
            Text = text,
            Tag = screen,
            IsSelected = selected
        };

    protected override void OnInitialized()
    {
        _provider = LoadProviderRowsAsync;
        _selectedNavigationNode = FindNavigationNode(BenchScreen.Overview);
        BenchData.Load();
        var source = BenchData.EstimatingItems.Take(320).ToList();
        for (var index = 0; index < source.Count; index++)
        {
            var item = source[index];
            _rows.Add(new EnterpriseRow
            {
                Id = index + 1,
                Code = item.Item ?? $"ITEM-{index + 1:D4}",
                Name = item.ItemDesc ?? "Unnamed item",
                Category = item.PhaseDesc ?? item.CostCategory ?? "Uncategorized",
                Quantity = Math.Max(1, item.WastePercent ?? (index % 12) + 1),
                Price = item.Price ?? (index % 40) * 3.75m,
                EffectiveDate = new DateTime(2026, 1, 1).AddDays(index % 180),
                Active = item.IsQuote != true,
                Status = item.IsQuote == true ? "Pending" : "Active",
                SourcePhase = item.Phase ?? ""
            });
        }

        if (_rows.Count == 0)
        {
            for (var index = 1; index <= 120; index++)
            {
                _rows.Add(new EnterpriseRow
                {
                    Id = index,
                    Code = $"ITEM-{index:D4}",
                    Name = $"Fallback test item {index % 25:D2}",
                    Category = $"Category {index % 6}",
                    Quantity = (index % 20) + 1,
                    Price = index * 2.5m,
                    EffectiveDate = new DateTime(2026, 1, 1).AddDays(index),
                    Active = index % 5 != 0,
                    Status = index % 5 == 0 ? "Pending" : "Active",
                    SourcePhase = $"{index % 10:D2}000"
                });
            }
        }

        _rowSeed.AddRange(_rows.Select(CloneEnterpriseRow));

        _autoRows.AddRange(_rows.Take(12).Select(row => new AutoRow
        {
            Id = row.Id,
            Sku = row.Code,
            Description = row.Name,
            Price = row.Price,
            Extended = row.Price * row.Quantity,
            InternalNote = "excluded"
        }));
        _autoRowSeed.AddRange(_autoRows.Select(CloneAutoRow));
        RestoreTemplateRows();

        for (var rowIndex = 1; rowIndex <= 80; rowIndex++)
        {
            var wide = new WideRow();
            for (var columnIndex = 0; columnIndex < 42; columnIndex++)
                wide[$"C{columnIndex:D2}"] = $"R{rowIndex:D3} / C{columnIndex:D2}";
            _wideRows.Add(wide);
        }

        for (var index = 0; index < 42; index++)
        {
            _wideColumns.Add(new WideColumn(
                $"C{index:D2}",
                index == 0 ? "Key" : $"Column {index:D2}",
                index == 0 ? "90px" : "145px",
                index is 0 or 41,
                index == 41 ? FrozenColumnPosition.Right : FrozenColumnPosition.Left));
        }
    }

    private Task HandleNavigationChanged(TreeNode node)
    {
        if (node.Tag is BenchScreen screen)
        {
            ActivateScreen(screen, node);
        }
        else
        {
            // Branches remain selectable so ArrowUp/ArrowDown can traverse the
            // complete hierarchy instead of being forced back to the prior leaf.
            // A branch displays the neutral overview, so collapsing it cannot
            // leave a hidden child test mounted on the right.
            if (_providerGrid?.IsProviderExporting == true)
                _providerGrid.CancelProviderExport();
            if (_selectedNavigationNode is not null
                && !ReferenceEquals(_selectedNavigationNode, node))
            {
                _selectedNavigationNode.IsSelected = false;
            }
            node.IsSelected = true;
            _selectedNavigationNode = node;
            _activeScreen = BenchScreen.Overview;
            _mainGrid = null;
            _providerGrid = null;
            ResetActiveTest();
        }

        return Task.CompletedTask;
    }

    private void SelectScreen(BenchScreen screen)
    {
        var node = FindNavigationNode(screen);
        if (node is not null)
        {
            ExpandNavigationPath(node);
            ActivateScreen(screen, node);
        }
    }

    private void ActivateScreen(BenchScreen screen, TreeNode node)
    {
        if (_providerGrid?.IsProviderExporting == true)
            _providerGrid.CancelProviderExport();

        if (_selectedNavigationNode is not null)
            _selectedNavigationNode.IsSelected = false;

        node.IsSelected = true;
        _selectedNavigationNode = node;
        _activeScreen = screen;
        _mainGrid = null;
        _providerGrid = null;
        ResetActiveTest();
    }

    private void ResetActiveTest()
    {
        if (_providerGrid?.IsProviderExporting == true)
            _providerGrid.CancelProviderExport();

        RestoreEnterpriseRows();
        RestoreAutoRows();
        RestoreTemplateRows();
        _editMode = _activeScreen switch
        {
            BenchScreen.InlineEditing or BenchScreen.Validation => EditMode.Inline,
            BenchScreen.DialogEditing => EditMode.Dialog,
            _ => EditMode.Batch
        };
        _editSettings = CreateEditSettings(_editMode);
        _pagerPosition = GridPagerPosition.Both;
        _layoutMode = GridDataLayoutMode.Columns;
        _delimitedEncoding = GridDelimitedTextEncoding.Utf8NoBom;
        _caseSensitive = false;
        _showFilterRowOperators = true;
        _showExpandColumn = true;
        _columnOverscan = 2;
        _savedState = null;
        _stateEventCount = 0;
        _stateJsonLength = 0;
        _multiSortVerification = "not run";
        _multiSortSample = "";
        _multiSortPassed = null;
        _providerRequestCount = 0;
        _providerExportBytes = 0;
        _providerLastRequest = "waiting for first request";
        _providerExportText = "not started";
        _status = GetReadyStatus(_activeScreen);
        _mainGridKey++;
        _providerGridKey++;
    }

