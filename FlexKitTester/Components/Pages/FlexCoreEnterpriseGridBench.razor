    private TreeNode? FindNavigationNode(BenchScreen screen) =>
        FlattenNavigationNodes(_navigationNodes)
            .FirstOrDefault(node => node.Tag is BenchScreen candidate && candidate == screen);

    private static IEnumerable<TreeNode> FlattenNavigationNodes(IEnumerable<TreeNode> nodes)
    {
        foreach (var node in nodes)
        {
            yield return node;
            foreach (var child in FlattenNavigationNodes(node.Children))
                yield return child;
        }
    }

    private void ExpandNavigationPath(TreeNode target)
    {
        foreach (var root in _navigationNodes)
        {
            if (ExpandNavigationPath(root, target))
                return;
        }
    }

    private static bool ExpandNavigationPath(TreeNode current, TreeNode target)
    {
        if (ReferenceEquals(current, target))
            return true;

        foreach (var child in current.Children)
        {
            if (!ExpandNavigationPath(child, target))
                continue;
            current.IsExpanded = true;
            return true;
        }

        return false;
    }

