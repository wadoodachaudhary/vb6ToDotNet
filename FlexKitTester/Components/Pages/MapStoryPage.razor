@page "/map-story"
@rendermode InteractiveServer
@using Fx.ControlKit.Maps

<PageTitle>Unemployment map story</PageTitle>

<h1>Unemployment map story</h1>
<p>
    Click a continent, then a country. Spain, France, Germany, Italy and Finland open Eurostat NUTS-2 regions for 2024.
    The United States opens BLS statewide rates for September 2026. Other countries say regional data is not available.
    Continent rates are labour-force-weighted ILO modelled estimates for 2025. Europe uses the August 2026 reference rates.
    Nothing on this page is sample data. The geography is bundled, so the page does not call a tile server.
</p>

<MapStoryControl Story="_story" Width="960" Height="640" />

@code {
    MapStory _story = null!;

    protected override void OnInitialized() => _story = MapStory.LoadBundledUnemployment();
}
