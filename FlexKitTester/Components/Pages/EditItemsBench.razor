    private async Task RunTypingComparisonAsync()
    {
        if (_typingBenchmarkRunning || Items.Count == 0)
            return;

        _typingBenchmarkRunning = true;
        _serverTypingSample = null;
        _clientTypingSample = null;
        _typingBenchmarkStatus = "Preparing benchmark...";

        var originalValue = Items[0].Description;
        var originalMode = _clientBufferedTextEditing;
        var benchmarkText = BuildTypingBenchmarkText(_typingBenchmarkCharacterCount);

        try
        {
            _typingBenchmarkModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./typing-benchmark.js");

            _typingBenchmarkStatus = "Running server-backed editor...";
            await InvokeAsync(StateHasChanged);
            _serverTypingSample = await RunTypingSampleAsync(false, benchmarkText);

            _typingBenchmarkStatus = "Running client-buffered editor...";
            await InvokeAsync(StateHasChanged);
            _clientTypingSample = await RunTypingSampleAsync(true, benchmarkText);

            _typingBenchmarkStatus = "Comparison complete";
        }
        catch (Exception ex)
        {
            _typingBenchmarkStatus = $"Benchmark failed: {ex.Message}";
        }
        finally
        {
            _typingBenchmarkSampleActive = false;
            _typingBenchmarkCommitReady = null;
            _typingBenchmarkPaintReady = null;
            _typingBenchmarkPaintPending = false;
            Items[0].Description = originalValue;

            try
            {
                await RenderTypingBenchmarkModeAsync(originalMode);
            }
            catch (Exception ex)
            {
                _typingBenchmarkStatus = $"{_typingBenchmarkStatus}; restore failed: {ex.Message}";
            }

            _typingBenchmarkRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<TypingBenchmarkSample> RunTypingSampleAsync(
        bool clientBuffered,
        string benchmarkText)
    {
        const string editorSelector = ".ei-grid-host .fx-batch-input";
        var row = Items[0];
        row.Description = "benchmark seed";
        await RenderTypingBenchmarkModeAsync(clientBuffered);

        var grid = _itemsGrid
            ?? throw new InvalidOperationException("Edit Items grid is not available.");
        await grid.BeginEditCellAsync(row, nameof(ItemRow.Description));

        grid.ResetTextEditingDiagnostics();
        GridRenderDiagnostics.Reset();

        _typingBenchmarkCommitReady = NewCompletionSource<TypingCommitObservation>();
        _typingBenchmarkPaintReady = NewCompletionSource<long>();
        _typingBenchmarkPaintPending = false;
        _typingBenchmarkSampleActive = true;

        var started = Stopwatch.GetTimestamp();
        var dispatch = await _typingBenchmarkModule!.InvokeAsync<TypingDispatchResult>(
            "runGridTypingBenchmark",
            editorSelector,
            benchmarkText,
            clientBuffered,
            _typingBenchmarkKeyDelayMs);

        var commit = await _typingBenchmarkCommitReady.Task.WaitAsync(TimeSpan.FromSeconds(15));
        var paintTimestamp = await _typingBenchmarkPaintReady.Task.WaitAsync(TimeSpan.FromSeconds(15));
        var diagnostics = grid.GetTextEditingDiagnosticsSnapshot();

        _typingBenchmarkSampleActive = false;
        _typingBenchmarkCommitReady = null;
        _typingBenchmarkPaintReady = null;

        return new TypingBenchmarkSample(
            benchmarkText.Length,
            dispatch.KeyDownEvents + dispatch.InputEvents,
            dispatch.BrowserDispatchMs,
            ElapsedMilliseconds(started, commit.Timestamp),
            ElapsedMilliseconds(started, paintTimestamp),
            diagnostics,
            GridRenderDiagnostics.RenderCount,
            string.Equals(commit.Value, benchmarkText, StringComparison.Ordinal)
                && string.Equals(row.Description, benchmarkText, StringComparison.Ordinal),
            dispatch.ClientBufferActive);
    }

    private async Task RenderTypingBenchmarkModeAsync(bool clientBuffered)
    {
        _clientBufferedTextEditing = clientBuffered;
        _gridGeneration++;
        var renderReady = NewCompletionSource<bool>();
        _typingBenchmarkRenderReady = renderReady;
        await InvokeAsync(StateHasChanged);
        await renderReady.Task.WaitAsync(TimeSpan.FromSeconds(8));
    }

    private static TaskCompletionSource<T> NewCompletionSource<T>() =>
        new(TaskCreationOptions.RunContinuationsAsynchronously);

    private static double ElapsedMilliseconds(long started, long completed) =>
        (completed - started) * 1000.0 / Stopwatch.Frequency;

    private static string BuildTypingBenchmarkText(int characterCount)
    {
        const string pattern = "the quick brown fox jumps over 0123456789; ";
        var repeats = (characterCount + pattern.Length - 1) / pattern.Length;
        return string.Concat(Enumerable.Repeat(pattern, repeats))[..characterCount];
    }

