    private void ApplyPickedCostCode()
    {
        // FItems targets pattern: the pick applies to EVERY row selected in
        // the picked column, not just the row whose ... was clicked. Desc
        // columns follow their code (FItems sets them from the pick row).
        if (_picked != null && _pickerTargets.Count > 0)
        {
            foreach (var t in _pickerTargets)
            {
                switch (_pickerField)
                {
                    case nameof(ItemRow.POIndex): t.POIndex = _picked.Code; t.POIndexDesc = _picked.Description; break;
                    case nameof(ItemRow.CostCode): t.CostCode = _picked.Code; t.CostCodeDesc = _picked.Description; break;
                    case nameof(ItemRow.TaxGroup): t.TaxGroup = _picked.Code; break;
                    case nameof(ItemRow.OrderUOM): t.OrderUOM = _picked.Code; break;
                    case nameof(ItemRow.Vendor): t.Vendor = _picked.Code; break;
                    case nameof(ItemRow.Tag): t.Tag = _picked.Code; break;
                }
            }
            _edits += _pickerTargets.Count;
            _lastEdit = $"{_pickerField}={_picked.Code} (picker x{_pickerTargets.Count})";
        }
        _pickerOpen = false;
    }

