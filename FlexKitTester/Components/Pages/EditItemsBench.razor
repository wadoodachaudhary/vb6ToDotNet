@page "/edit-items"
@rendermode InteractiveServer
@using System.Diagnostics
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Dialogs
@inject FlexKitTester.Services.BenchDataStore BenchData
@inject ZoomService Zoom
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Edit Items DB Bench</PageTitle>

<PageControl CssClass="ei-page">
<h4 style="margin:8px 12px;">Edit Items DB harness <span style="color:#1e6fd9;font-size:calc(13px * var(--fx-zoom, 1));">— rev 36 (@Items.Count rows · typing + scroll buffer bench · build @BuildStamp · selection: <b>@BuildColorName</b>)</span></h4>
<div style="margin:0 12px 6px;font-size:calc(11px * var(--fx-zoom, 1));color:#555;">@BenchData.LoadReport</div>
@if (_dataError != null)
{
    <div class="ei-data-error">DATA NOT LOADED — @_dataError</div>
}
<style>
    /* Build marker: the selection color ROTATES with every FlexCore build
       (name shown in the header) — a stale cached tab shows the wrong color. */
    .ei-grid-host .fx-grid.fx-grid-editable-selection {
        --fx-grid-selected-row-bg: @BuildColorHex;
        --fx-grid-cell-selected-row-bg: @BuildColorHex;
        --fx-grid-selected-cell-bg: @BuildColorHex;
    }

    .ei-data-error {
        margin: 0 12px 8px;
        padding: 6px 9px;
        border: 1px solid #a12a2a;
        background: #ffe3e3;
        color: #7a1010;
        font-size: calc(13px * var(--fx-zoom, 1));
        font-weight: 600;
    }

    .ei-typing-bench {
        margin: 0 12px 8px;
        padding: 6px 0 8px;
        border-top: 1px solid #c7c7c7;
        border-bottom: 1px solid #c7c7c7;
        font-size: calc(12px * var(--fx-zoom, 1));
    }

    .ei-typing-controls {
        display: flex;
        align-items: end;
        flex-wrap: wrap;
        gap: 8px 12px;
    }

    .ei-typing-controls label {
        display: grid;
        gap: 2px;
    }

    .ei-typing-status {
        color: #555;
        align-self: center;
    }

    .ei-typing-results {
        width: 100%;
        margin-top: 7px;
        border-collapse: collapse;
    }

    .ei-typing-results th,
    .ei-typing-results td {
        padding: 3px 7px;
        border: 1px solid #c8cdd3;
        text-align: right;
        white-space: nowrap;
    }

    .ei-typing-results th:first-child,
    .ei-typing-results td:first-child {
        text-align: left;
    }

    .ei-typing-note {
        margin-top: 4px;
        color: #666;
    }
</style>
<p style="margin:0 12px 8px; font-size:calc(13px * var(--fx-zoom, 1));">
    Mimics FItems gItems: cell selection + batch edit, PO Index with picker button.
    Watch for any foreign light-blue paint on plain cell clicks (there must be none);
    drag across rows in one column paints the preview, released promptly on mouse-up.
</p>

<div style="display:flex; align-items:center; flex-wrap:wrap; gap:6px; margin:0 12px 6px; font-size:calc(12px * var(--fx-zoom, 1));">
    <span>thumb scroll:</span>
    <button id="ei-scroll-live"
            title="Track the native scrollbar thumb live. The release buffer is not used."
            @onclick="() => SetScrollTrack(true)"
            disabled="@_scrollTrack">LIVE</button>
    <button id="ei-scroll-release"
            title="Keep the grid viewport fixed while the proxy thumb moves, then paint once on release."
            @onclick="() => SetScrollTrack(false)"
            disabled="@(!_scrollTrack)">FIXED / RELEASE ONLY</button>
    <span style="margin-left:12px;">window overscan rows:</span>
    <NumericTextBoxControl TValue="int"
                           Value="@_overscan"
                           ValueChanged="SetOverscan"
                           Min="0"
                           Max="500"
                           Width="76px" />
    <button id="ei-ov60" @onclick="() => SetOverscan(60)" disabled="@(_overscan == 60)">60 (default)</button>
    <button id="ei-ov200" @onclick="() => SetOverscan(200)" disabled="@(_overscan == 200)">200</button>
    <button id="ei-ov260" @onclick="() => SetOverscan(260)" disabled="@(_overscan == 260)">260 (old default)</button>
    <span style="color:#999;">rendered window ≈ viewport + 2×overscan</span>
    <span style="margin-left:12px;">release buffer:</span>
    <button id="ei-release-auto"
            title="Use the smaller deferred buffer, adjusted to at least one-third of the live overscan."
            @onclick="() => SetAutoDeferredReleaseBuffer(true)"
            disabled="@(_scrollTrack || _useAutoDeferredReleaseBuffer)">deferred / auto (@AutoDeferredReleaseRows)</button>
    <button id="ei-release-full"
            title="Use the normal live-window overscan on both sides of the released thumb destination."
            @onclick="() => SetAutoDeferredReleaseBuffer(false)"
            disabled="@(_scrollTrack || !_useAutoDeferredReleaseBuffer)">default / full (@_overscan)</button>
    <span style="color:#666;">
        @(_scrollTrack
            ? "release buffer unused in LIVE mode"
            : $"effective release buffer: {EffectiveDeferredReleaseRows} rows/side")
    </span>
    <button id="ei-boundary-guard-toggle" @onclick="() => _boundaryGuard = !_boundaryGuard">
        blank guard: <b>@(_boundaryGuard ? "ON" : "OFF (baseline)")</b>
    </button>
    <button id="ei-adaptive-wheel-toggle" @onclick="() => _adaptiveWheelPacing = !_adaptiveWheelPacing">
        adaptive wheel pacing: <b>@(_adaptiveWheelPacing ? "ON" : "OFF")</b>
    </button>
    <span style="margin-left:12px;">controlled server wait:</span>
    @foreach (var delay in DiagnosticDelayChoices)
    {
        <button @onclick="() => _diagnosticWindowDelayMs = delay"
                disabled="@(_diagnosticWindowDelayMs == delay)">@delay ms</button>
    }
    <span style="margin-left:12px;">performance:</span>
    <DropDownListControl TValue="GridPerformanceMode"
                         TItem="GridPerformanceModeChoice"
                         DataSource="@GridPerformanceModeCatalog.All"
                         TextFieldName="@nameof(GridPerformanceModeChoice.Label)"
                         ValueFieldName="@nameof(GridPerformanceModeChoice.Value)"
                         Value="@_performanceMode"
                         ValueChanged="SetPerformanceMode"
                         Width="300px" />
    <CheckBoxControl Label="Client-buffered typing"
                     Checked="@_clientBufferedTextEditing"
                     CheckedChanged="SetClientBufferedTextEditing" />
    <span style="margin-left:12px;">zoom:</span>
    <ButtonControl Title="Zoom out (Ctrl+<)" Disabled="@(!Zoom.CanZoomOut)" OnClick="@(_ => Zoom.ZoomOut())">Zoom −</ButtonControl>
    <ButtonControl Title="Reset zoom to 100%" OnClick="@(_ => Zoom.Reset())">@($"{Zoom.ZoomPercent}%")</ButtonControl>
    <ButtonControl Title="Zoom in (Ctrl+>)" Disabled="@(!Zoom.CanZoomIn)" OnClick="@(_ => Zoom.ZoomIn())">Zoom +</ButtonControl>
</div>

<section class="ei-typing-bench" aria-labelledby="ei-typing-title">
    <div class="ei-typing-controls">
        <strong id="ei-typing-title">Typing transport benchmark</strong>
        <label>
            <span>Characters</span>
            <NumericTextBoxControl TValue="int"
                                   Value="@_typingBenchmarkCharacterCount"
                                   ValueChanged="SetTypingBenchmarkCharacterCount"
                                   Min="8"
                                   Max="500"
                                   Width="76px" />
        </label>
        <label>
            <span>Key interval (ms)</span>
            <NumericTextBoxControl TValue="int"
                                   Value="@_typingBenchmarkKeyDelayMs"
                                   ValueChanged="SetTypingBenchmarkKeyDelay"
                                   Min="0"
                                   Max="50"
                                   Width="76px" />
        </label>
        <label>
            <span>RTT model (ms)</span>
            <NumericTextBoxControl TValue="int"
                                   Value="@_typingBenchmarkRttMs"
                                   ValueChanged="SetTypingBenchmarkRtt"
                                   Min="0"
                                   Max="500"
                                   Width="76px" />
        </label>
        <ButtonControl Disabled="@_typingBenchmarkRunning" OnClick="RunTypingComparisonAsync">Run both</ButtonControl>
        <ButtonControl Disabled="@_typingBenchmarkRunning" OnClick="ClearTypingBenchmark">Clear</ButtonControl>
        <span class="ei-typing-status">@_typingBenchmarkStatus</span>
    </div>

    @if (_serverTypingSample != null || _clientTypingSample != null)
    {
        <table class="ei-typing-results">
            <thead>
                <tr>
                    <th>Mode</th>
                    <th>Characters</th>
                    <th>Browser events</th>
                    <th>Browser dispatch</th>
                    <th>Model commit</th>
                    <th>Paint settled</th>
                    <th>.NET callbacks</th>
                    <th>Input callbacks</th>
                    <th>Key callbacks</th>
                    <th>Grid renders</th>
                    <th>RTT exposure (@_typingBenchmarkRttMs ms)</th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in TypingSampleRows)
                {
                    <tr>
                        <td>@result.Label</td>
                        <td>@TypingMetric(result.Sample?.CharacterCount)</td>
                        <td>@TypingMetric(result.Sample?.BrowserEvents)</td>
                        <td>@TypingMilliseconds(result.Sample?.BrowserDispatchMs)</td>
                        <td>@TypingMilliseconds(result.Sample?.ModelCommitMs)</td>
                        <td>@TypingMilliseconds(result.Sample?.PaintSettledMs)</td>
                        <td>@TypingMetric(result.Sample?.TransportCallbacks)</td>
                        <td>@TypingMetric(result.Sample?.Diagnostics.ServerInputCallbacks)</td>
                        <td>@TypingMetric(result.Sample?.Diagnostics.ServerKeyDownCallbacks)</td>
                        <td>@TypingMetric(result.Sample?.GridRenders)</td>
                        <td>@TypingMilliseconds(ProjectedTypingTransportMs(result.Sample))</td>
                        <td>@(result.Sample == null ? "-" : result.Sample.ValueCorrect ? "Correct" : "Mismatch")</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="ei-typing-note">
            Actual times use this local connection. RTT exposure is callback count × the selected RTT and is a transport comparison, not another stopwatch result.
        </div>
    }
</section>

<LatencyProbePanel Context="Edit Items / FItems" />
<ScrollTrackLatencyPanel Context="Edit Items / FItems"
                         GridSelector=".ei-grid-host > .fx-grid" />
<WheelWindowMetricsPanel Context="Edit Items / FItems"
                         GridSelector=".ei-grid-host > .fx-grid" />

<div class="ei-grid-host">
    <GridControl @ref="_itemsGrid"
                 ShowRowCountInFooter="true"
                 AutoPageRowThreshold="0"
                 @key="@ItemsGridRegistrationKey"
                 WindowOverscanRows="@_overscan"
                 DeferredScrollOverscanRows="@EffectiveDeferredReleaseRows"
                 TValue="ItemRow"
                 DataSource="@Items"
                 ScrollTrack="@_scrollTrack"
                 WheelScrollScale="0.75"
                 EnableScrollBoundaryGuard="@_boundaryGuard"
                 EnableScrollBoundarySlowdown="@_boundaryGuard"
                 EnableAdaptiveWheelScrollPacing="@_adaptiveWheelPacing"
                 EnableScrollBoundaryTelemetry="true"
                 DiagnosticWindowScrollDelayMs="@_diagnosticWindowDelayMs"
                 PerformanceMode="@_performanceMode"
                 TextEditorTypingBehavior="@(_clientBufferedTextEditing ? TextBoxTypingBehavior.ClientBuffered : TextBoxTypingBehavior.ServerBacked)"
                 AllowSorting="false"
                 AllowSelection="true"
                 AllowResizing="true"
                 AllowColumnReorder="true"
                 EnableHover="true"
                 Height="100%"
                 RowHeight="22"
                 MinRowHeight="22"
                 EditSettingsRef="@_editSettings"
                 SelectionSettingsRef="@_selectionSettings"
                 EventsRef="@_gridEvents"
                 HostTabIndex="0"
                 SeedActiveCellOnHostFocus="true"
                 TabNavigationMode="GridTabNavigationMode.WrapRows"
                 ShowGridOptionsRail="true"
                 ShowColumnOptionsButton="true"
                 BatchEditBehavior="GridBatchEditBehavior.SingleCell"
                 AllowSingleCellColumnMassEdit="true"
                 TypeAheadTargetField="@TypeAheadTargetField"
                 CssClass="@("fx-grid-compact " + GridControl<ItemRow>.EditableSelectionThemeCssClass)">
        <GridColumnsBase>
            <GridColumn Field="@nameof(ItemRow.Phase)" HeaderText="Phase" Width="60px" AllowEditing="false" />
            <GridColumn Field="@nameof(ItemRow.CostType)" HeaderText="Cost Type" Width="60px" AllowEditing="false" />
            <GridColumn Field="@nameof(ItemRow.Item)" HeaderText="Item" Width="65px" AllowEditing="false" />
            <GridColumn Field="@nameof(ItemRow.PhaseDesc)" HeaderText="Phase Description" Width="130px" AllowEditing="false" />
            <GridColumn Field="@nameof(ItemRow.Description)" HeaderText="Item Description" Width="250px" AllowEditing="true" AllowCellDragSelection="true" ShowEditButton="true" />
            <GridColumn Field="@nameof(ItemRow.Notes)" HeaderText="Notes" Width="110px" AllowEditing="true" AllowCellDragSelection="true" ShowEditButton="true" />
            <GridColumn Field="@nameof(ItemRow.POIndex)" HeaderText="PO Index" Width="75px" AllowEditing="true" AllowCellDragSelection="true" ShowEditButton="true" />
            <GridColumn Field="@nameof(ItemRow.POIndexDesc)" HeaderText="PO Index Description" Width="150px" AllowEditing="false" />
            <GridColumn Field="@nameof(ItemRow.CostCode)" HeaderText="Cost Code" Width="80px" AllowEditing="true" AllowCellDragSelection="true" ShowEditButton="true" />
            <GridColumn Field="@nameof(ItemRow.CostCodeDesc)" HeaderText="Cost Code Desc" Width="140px" AllowEditing="false" />
            <GridColumn Field="@nameof(ItemRow.TaxGroup)" HeaderText="Tax Group" Width="75px" AllowEditing="true" AllowCellDragSelection="true" ShowEditButton="true" />
            <GridColumn Field="@nameof(ItemRow.WastePercent)" HeaderText="Waste %" Width="70px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" AllowCellDragSelection="true" SelectAllOnEdit="true" />
            <GridColumn Field="@nameof(ItemRow.RoundDir)" HeaderText="Rounding" Width="105px" AllowEditing="true" EditOptions="@RoundingOptions" />
            <GridColumn Field="@nameof(ItemRow.RoundTo)" HeaderText="Round To" Width="70px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" AllowCellDragSelection="true" SelectAllOnEdit="true" />
            <GridColumn Field="@nameof(ItemRow.Price)" HeaderText="Price" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" AllowCellDragSelection="true" SelectAllOnEdit="true" />
            <GridColumn Field="@nameof(ItemRow.IsQuote)" HeaderText="Quote" Width="50px" Type="ColumnType.CheckBox" AllowEditing="true" />
            <GridColumn Field="@nameof(ItemRow.Category)" HeaderText="Category" Width="60px" AllowEditing="false" />
            <GridColumn Field="@nameof(ItemRow.CategoryDesc)" HeaderText="Category Description" Width="150px" AllowEditing="false" />
            <GridColumn Field="@nameof(ItemRow.OrderUOM)" HeaderText="Order UOM" Width="70px" AllowEditing="true" AllowCellDragSelection="true" ShowEditButton="true" />
            <GridColumn Field="@nameof(ItemRow.ConversionFactor)" HeaderText="Conversion Factor" Width="110px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" AllowCellDragSelection="true" SelectAllOnEdit="true" />
            <GridColumn Field="@nameof(ItemRow.PartNumber)" HeaderText="Part Number" Width="90px" AllowEditing="true" AllowCellDragSelection="true" />
            <GridColumn Field="@nameof(ItemRow.Formula)" HeaderText="Formula" Width="100px" AllowEditing="true" AllowCellDragSelection="true" ShowEditButton="true" />
            <GridColumn Field="@nameof(ItemRow.InverseItemDesc)" HeaderText="Inverse Item" Width="110px" AllowEditing="false" ShowEditButton="true" />
            <GridColumn Field="@nameof(ItemRow.CostPrice)" HeaderText="Cost Price" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" AllowCellDragSelection="true" SelectAllOnEdit="true" />
            <GridColumn Field="@nameof(ItemRow.BidItem)" HeaderText="Bid Item" Width="60px" Type="ColumnType.CheckBox" AllowEditing="true" />
            @* Host-rendered popup declared with aria-haspopup and NO
               stopPropagation: Enter must open the picker and the synthetic
               click must not bounce focus back to this grid. *@
            <GridColumn Field="@nameof(ItemRow.Vendor)" HeaderText="Vendor" Width="120px" AllowEditing="false">
                <Template Context="ctx">
                    @{ var _vRow = (ItemRow)ctx; }
                    <div class="ei-tpl-cell">
                        <span class="ei-tpl-text">@_vRow.Vendor</span>
                        <button class="ei-tpl-pick" aria-haspopup="dialog" @onclick="() => OpenVendorPicker(_vRow)">…</button>
                    </div>
                </Template>
            </GridColumn>
            @* Marked opener next to a destructive button: the marker is
               authoritative, so Enter must open the picker and never clear. *@
            <GridColumn Field="@nameof(ItemRow.Tag)" HeaderText="Tag" Width="120px" AllowEditing="false">
                <Template Context="ctx">
                    @{ var _tRow = (ItemRow)ctx; }
                    <div class="ei-tpl-cell">
                        <span class="ei-tpl-text">@_tRow.Tag</span>
                        <button class="ei-tpl-pick" data-fx-cell-popup @onclick="() => OpenTagPicker(_tRow)" @onclick:stopPropagation="true">…</button>
                        <button class="ei-tpl-clear" @onclick="() => ClearTag(_tRow)" @onclick:stopPropagation="true">×</button>
                    </div>
                </Template>
            </GridColumn>
            @* Library popup cell: the swatch must not cover the td's active-cell
               cue, Enter must open the palette, and AllowEditing="false" is what
               keeps the in-cell text editor off the column while EditOnEnterKey
               stays on. Seeded from palette colours so the cursor lands on the
               current colour. *@
            <GridColumn Field="@nameof(ItemRow.Color)" HeaderText="Color" Width="64px" AllowEditing="false">
                <Template Context="ctx">
                    @{ var _cRow = (ItemRow)ctx; }
                    <ColorPickerControl Value="@_cRow.Color" ValueChanged="v => ApplyColor(_cRow, v)" />
                </Template>
            </GridColumn>
            @* Vulnerability patterns (port-risk harness): templates the client
               paint systems must not corrupt. Fill = cell-filling inline-bg div
               that visually owns the td; custom-tpl-btn is NOT in the adornment
               allowlist so it must survive nav transitions untouched, and its
               field-bearing cell must do nothing on Enter. *@
            <GridColumn Field="@nameof(ItemRow.Status)" HeaderText="Status" Width="90px" AllowEditing="false">
                <Template Context="ctx">
                    @{ var _sRow = (ItemRow)ctx; }
                    <div class="ei-fill" style="background:@FillColor(_sRow)">
                        <span>@(_sRow.IsQuote ? "Quote" : "Std")</span>
                        <button class="custom-tpl-btn" tabindex="-1" @onclick="() => MarkCustomTemplateButtonFired(_sRow)">i</button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumnsBase>
    </GridControl>
</div>

@* Cost Code picker: popup picklist + the cell stays typeable (VB6 lookup
   cells accept BOTH direct typing and the ... picker). *@
<DialogControl @bind-Visible="_pickerOpen" Header="@_pickerHeader" Width="380px" CloseOnEscape="true">
    <GridControl @ref="_pickerGrid"
                 ShowRowCountInFooter="true"
                 TValue="CostCodeRow"
                 DataSource="@_pickerSource"
                 AllowSorting="false"
                 AllowSelection="true"
                 CommitSelectedRowOnEnter="true"
                 HighlightSelectedRows="true"
                 EnableHover="true"
                 Height="264px"
                 RowHeight="22"
                 MinRowHeight="22"
                 EventsRef="@_pickerEvents"
                 CssClass="fx-grid-compact">
        <GridColumnsBase>
            <GridColumn Field="@nameof(CostCodeRow.Code)" HeaderText="Code" Width="100px" AllowEditing="false" />
            <GridColumn Field="@nameof(CostCodeRow.Description)" HeaderText="Description" Width="230px" AllowEditing="false" />
        </GridColumnsBase>
    </GridControl>
    <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:10px;">
        <button id="cc-ok" @onclick="ApplyPickedCostCode" disabled="@(_picked == null)">OK</button>
        <button id="cc-cancel" @onclick="() => _pickerOpen = false">Cancel</button>
    </div>
</DialogControl>

@* Item Description editor: FItems text-dialog replica — multi-line editor in a
   modal popup; closing (✕) commits, like FItems' OnTextDialogOk. *@
<DialogControl Visible="@_descOpen" Header="Item Description" Width="520px" IsModal="true"
               ShowCloseIcon="true" OnClose="CommitDescription" OnEscape="CancelDescription"
               CloseOnCtrlEnter="true" CssClass="ei-desc-dialog">
    <ChildContent>
        <TextAreaControl Value="@_descText" ValueChanged="_descValueChanged" UpdateOnInput="true" Rows="10" TabSpaces="5" CssClass="ei-desc-textarea" />
    </ChildContent>
</DialogControl>

<div style="margin:0 12px; font-size:calc(12px * var(--fx-zoom, 1)); color:#999;" id="ei-renders">page renders: @_renderCount ·
    grid renders: <span id="ei-grenders">@_gridRenders</span> ·
    last build <span id="ei-glastms">@_gridLastMs</span> ms ·
    total <span id="ei-gtotalms">@_gridTotalMs</span> ms ·
    display-cache rows <span id="ei-dvrows">@_dvCacheRows</span>
    <button id="ei-refresh-stats" @onclick="RefreshGridStats">refresh</button>
    <button id="ei-reset-stats" @onclick="ResetGridStats">reset</button></div>
<div style="margin:8px 12px; font-size:calc(12px * var(--fx-zoom, 1)); color:#555;" id="ei-state">
    edits committed: @_edits · last: @_lastEdit · fan-out commits: @_fanOuts (rows: @_lastFanOutRows)
</div>

<div style="margin:0 12px; font-size:calc(12px * var(--fx-zoom, 1)); color:#777;" id="ei-model">
    @foreach (var r in Items.Take(12))
    {
        <div>@r.Item | @r.Description | @r.POIndex | @r.CostCode | @r.Color</div>
    }
</div>
</PageControl>

@code {
    public class CostCodeRow
    {
        public string Code { get; set; } = "";
        public string Description { get; set; } = "";
    }

    public class ItemRow
    {
        public string Phase { get; set; } = "";
        public string CostType { get; set; } = "";
        public string Item { get; set; } = "";
        public string PhaseDesc { get; set; } = "";
        public string Description { get; set; } = "";
        public string Notes { get; set; } = "";
        public string POIndex { get; set; } = "";
        public string POIndexDesc { get; set; } = "";
        public string CostCode { get; set; } = "";
        public string CostCodeDesc { get; set; } = "";
        public string TaxGroup { get; set; } = "";
        public int WastePercent { get; set; }
        public string RoundDir { get; set; } = "#0";
        public decimal RoundTo { get; set; }
        public decimal Price { get; set; }
        public bool IsQuote { get; set; }
        public string Category { get; set; } = "";
        public string CategoryDesc { get; set; } = "";
        public string OrderUOM { get; set; } = "";
        public decimal ConversionFactor { get; set; }
        public string PartNumber { get; set; } = "";
        public string Formula { get; set; } = "";
        public string InverseItemDesc { get; set; } = "";
        public decimal CostPrice { get; set; }
        public bool BidItem { get; set; }
        public string Vendor { get; set; } = "";
        public string Tag { get; set; } = "";
        public string Status { get; set; } = "";
        public string Color { get; set; } = "";
    }

    private sealed class TypingDispatchResult
    {
        public double BrowserDispatchMs { get; set; }
        public int KeyDownEvents { get; set; }
        public int InputEvents { get; set; }
        public bool ClientBufferActive { get; set; }
    }

    private sealed record TypingCommitObservation(string Value, long Timestamp);

    private sealed record TypingBenchmarkSample(
        int CharacterCount,
        int BrowserEvents,
        double BrowserDispatchMs,
        double ModelCommitMs,
        double PaintSettledMs,
        GridTextEditingDiagnosticsSnapshot Diagnostics,
        long GridRenders,
        bool ValueCorrect,
        bool ClientBufferActive)
    {
        public long TransportCallbacks =>
            Diagnostics.TotalServerCallbacks + Diagnostics.ClientBufferedCommitCallbacks;
    }

    private List<ItemRow> Items = new();
    private int _edits;
    private string _lastEdit = "-";
    private int _fanOuts;
    private int _lastFanOutRows;
    private int _overscan = 60;
    private bool _scrollTrack;
    private bool _useAutoDeferredReleaseBuffer = true;
    private const int DefaultDeferredReleaseRows = 20;
    private int _gridGeneration;
    private bool _boundaryGuard = true;
    private bool _adaptiveWheelPacing = true;
    private int _diagnosticWindowDelayMs;
    private static readonly int[] DiagnosticDelayChoices = [0, 100, 150, 500, 1_000];
    private GridPerformanceMode _performanceMode =
        GridPerformanceMode.ClientPreviewAndServerOptimized;
    private bool _clientBufferedTextEditing = true;
    private int _typingBenchmarkCharacterCount = 120;
    private int _typingBenchmarkKeyDelayMs;
    private int _typingBenchmarkRttMs = 75;
    private bool _typingBenchmarkRunning;
    private string _typingBenchmarkStatus = "Ready";
    private TypingBenchmarkSample? _serverTypingSample;
    private TypingBenchmarkSample? _clientTypingSample;
    private IJSObjectReference? _typingBenchmarkModule;
    private TaskCompletionSource<bool>? _typingBenchmarkRenderReady;
    private TaskCompletionSource<TypingCommitObservation>? _typingBenchmarkCommitReady;
    private TaskCompletionSource<long>? _typingBenchmarkPaintReady;
    private bool _typingBenchmarkSampleActive;
    private bool _typingBenchmarkPaintPending;

    private string ItemsGridRegistrationKey => string.Join(
        ":",
        _gridGeneration,
        _performanceMode,
        _clientBufferedTextEditing,
        _scrollTrack,
        _useAutoDeferredReleaseBuffer,
        _overscan,
        EffectiveDeferredReleaseRows,
        _boundaryGuard,
        _adaptiveWheelPacing,
        _diagnosticWindowDelayMs,
        Zoom.ZoomPercent);

    private void SetOverscan(int v)
    {
        v = Math.Clamp(v, 0, 500);
        if (_overscan == v)
            return;

        _overscan = v;
        _gridGeneration++;
        GridRenderDiagnostics.Reset();
    }

    private int AutoDeferredReleaseRows
    {
        get
        {
            var overscan = Math.Max(0, _overscan);
            return Math.Min(overscan, Math.Max(DefaultDeferredReleaseRows, overscan / 3));
        }
    }

    private int EffectiveDeferredReleaseRows =>
        _useAutoDeferredReleaseBuffer ? AutoDeferredReleaseRows : Math.Max(0, _overscan);

