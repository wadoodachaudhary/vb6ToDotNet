    private async Task OnItemsEditButtonClickAsync(CellEditButtonArgs<ItemRow> args)
    {
        if (args.Data == null) return;
        if (args.ColumnName is nameof(ItemRow.Description) or nameof(ItemRow.Notes))
        {
            _descRow = args.Data;
            _descField = args.ColumnName;
            _descText = args.ColumnName == nameof(ItemRow.Notes) ? args.Data.Notes : args.Data.Description;
            _descOpen = true;
            return;
        }
        (_pickerSource, _pickerHeader) = args.ColumnName switch
        {
            nameof(ItemRow.POIndex) => (POIndexes, "Select PO Index"),
            nameof(ItemRow.CostCode) => (CostCodes, "Select Cost Code"),
            nameof(ItemRow.TaxGroup) => (TaxGroups, "Select Tax Group"),
            nameof(ItemRow.OrderUOM) => (OrderUoms, "Select Order UOM"),
            _ => (new List<CostCodeRow>(), "")
        };
        if (_pickerSource.Count == 0) return;
        _pickerField = args.ColumnName!;
        _pickerRow = args.Data;
        var sel = _itemsGrid != null
            ? await _itemsGrid.GetSelectedRecordsForColumnAsync(_pickerField)
            : new List<ItemRow>();
        _pickerTargets = sel.Count > 1 && sel.Contains(args.Data) ? sel : new List<ItemRow> { args.Data };
        // Open with the CURRENT value selected and scrolled into view
        // (VB6 picklist behavior) — resolved after the dialog renders.
        var current = GetPickerValue(args.Data);
        _picked = _pickerSource.FirstOrDefault(c => c.Code == current);
        _pendingPickerReveal = _picked != null;
        _pickerOpen = true;
    }

