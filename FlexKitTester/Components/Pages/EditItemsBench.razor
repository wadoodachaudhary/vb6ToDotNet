    protected override void OnInitialized()
    {
        Zoom.OnZoomChanged += HandleZoomChanged;
        // Lambda, not method group: with a non-IHandleEvent receiver the
        // callback's receiver is null and dispatch falls back to
        // Delegate.Target — a method group targets the PAGE (IHandleEvent),
        // re-rendering it per keystroke anyway.
        _gridEvents.OnHostKeyDown = EventCallback.Factory.Create<KeyboardEventArgs>(NonRenderingEventReceiver.Instance,
            (Func<KeyboardEventArgs, Task>)(e => OnWrapperKeyDown(e)));
        _descValueChanged = EventCallback.Factory.Create<string?>(NonRenderingEventReceiver.Instance, v => _descText = v);

        _gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<ItemRow>>(this, args =>
        {
            if (args.Data == null) return;
            _edits++;
            _lastEdit = $"{args.ColumnName}={args.Value}";

            if (_typingBenchmarkSampleActive
                && string.Equals(args.ColumnName, nameof(ItemRow.Description), StringComparison.Ordinal))
            {
                var value = args.Value?.ToString() ?? string.Empty;
                _typingBenchmarkCommitReady?.TrySetResult(
                    new TypingCommitObservation(value, Stopwatch.GetTimestamp()));
                _typingBenchmarkPaintPending = true;
            }
        });
        _gridEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<ItemRow>>(this,
            OnItemsEditButtonClickAsync);
        _pickerEvents.OnRecordClick = EventCallback.Factory.Create<CellClickEventArgs<CostCodeRow>>(this,
            args => _picked = args.Data);
        _pickerEvents.OnRecordDoubleClick = EventCallback.Factory.Create<CellClickEventArgs<CostCodeRow>>(this, args =>
        {
            _picked = args.Data;
            ApplyPickedCostCode();
        });
        _gridEvents.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<ItemRow>>(this,
            args => _activeEditColumn = args.ColumnName);

        // FItems.OnItemsTypeAheadCommit pattern: multi-row type-over WRITE is
        // host-delegated (VB6 ValidateEdit) — apply the typed value to every
        // selected row's target field.
        _gridEvents.OnTypeAheadCommit = EventCallback.Factory.Create<TypeAheadCommitArgs<ItemRow>>(this, args =>
        {
            if (string.IsNullOrWhiteSpace(args.ColumnName)) return;
            var n = 0;
            foreach (var item in args.SelectedItems.Where(i => i != null).Distinct())
            {
                var prop = typeof(ItemRow).GetProperty(args.ColumnName,
                    System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance
                    | System.Reflection.BindingFlags.IgnoreCase);
                if (prop == null || !prop.CanWrite) continue;
                try
                {
                    object converted = prop.PropertyType == typeof(string) ? args.Value
                        : prop.PropertyType == typeof(int) ? int.Parse(args.Value)
                        : prop.PropertyType == typeof(decimal) ? decimal.Parse(args.Value)
                        : prop.PropertyType == typeof(bool) ? (args.Value is "1" or "true" or "True")
                        : Convert.ChangeType(args.Value, prop.PropertyType);
                    prop.SetValue(item, converted);
                }
                catch { continue; }
                n++;
            }
            if (n == 0) return;
            _fanOuts++;
            _lastFanOutRows = n;
            StateHasChanged();
        });

        // handled in OnAfterRenderAsync: reveal runs once the picker grid exists

        // Real EstimatingItems rows (all divisions) exported from HomeFrontSQL
        // — the same view FItems selects from. Parsed once per process by
        // BenchDataStore; this only projects.
        var source = BenchData.EstimatingItems;
        _dataError = BenchData.EstimatingError;
        if (_dataError != null) return;

        Items = new List<ItemRow>(source.Count);
        foreach (var r in source)
        {
            Items.Add(new ItemRow
            {
                Phase = r.Phase ?? "",
                CostType = r.CostCategory ?? "",
                Item = r.Item ?? "",
                PhaseDesc = r.PhaseDesc ?? "",
                Description = r.ItemDesc ?? "",
                Notes = r.Notes ?? "",
                POIndex = r.POIndex ?? "",
                POIndexDesc = r.POIndexDescription ?? "",
                CostCode = r.JCCostCode ?? "",
                CostCodeDesc = r.JCCostCodeDesc ?? "",
                TaxGroup = r.TaxGroup ?? "",
                WastePercent = r.WastePercent ?? 0,
                // The view stores RoundDir as an int; the column's option
                // domain is "#0".."#3".
                RoundDir = "#" + (r.RoundDir ?? 0),
                RoundTo = r.RoundTo ?? 0m,
                Price = r.Price ?? 0m,
                IsQuote = r.IsQuote ?? false,
                Category = r.JCCategory ?? "",
                CategoryDesc = r.JCCategoryDesc ?? "",
                OrderUOM = r.OrderUOM ?? "",
                ConversionFactor = r.ConversionFactor ?? 0m,
                PartNumber = r.PartNumber ?? "",
                Formula = r.Formula ?? ""
                // InverseItemDesc, CostPrice, BidItem and Status have no column
                // in the export and stay at their defaults.
            });
        }

        // Pickers offer the values actually present in the data.
        POIndexes = Items.Where(i => i.POIndex != "")
            .GroupBy(i => i.POIndex).OrderBy(g => g.Key)
            .Select(g => new CostCodeRow { Code = g.Key, Description = g.First().POIndexDesc }).ToList();
        CostCodes = Items.Where(i => i.CostCode != "")
            .GroupBy(i => i.CostCode).OrderBy(g => g.Key)
            .Select(g => new CostCodeRow { Code = g.Key, Description = g.First().CostCodeDesc }).ToList();
        TaxGroups = Items.Where(i => i.TaxGroup != "")
            .GroupBy(i => i.TaxGroup).OrderBy(g => g.Key)
            .Select(g => new CostCodeRow { Code = g.Key, Description = g.Key }).ToList();
        OrderUoms = Items.Where(i => i.OrderUOM != "")
            .GroupBy(i => i.OrderUOM).OrderBy(g => g.Key)
            .Select(g => new CostCodeRow { Code = g.Key, Description = g.Key }).ToList();

        // The export carries no Vendor/Tag/Color, so the template-popup columns
        // would only ever be exercised with an empty current value.
        for (var i = 0; i < Items.Count; i++)
        {
            Items[i].Vendor = Vendors[i % Vendors.Count].Code;
            Items[i].Tag = i % 4 == 3 ? "" : Tags[i % Tags.Count].Code;
            Items[i].Color = ChipColor(Items[i]);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingPickerReveal && _pickerGrid != null && _picked != null)
        {
            _pendingPickerReveal = false;
            await _pickerGrid.SelectAndRevealRowAsync(_picked);
        }

        if (_typingBenchmarkRenderReady != null)
        {
            var renderReady = _typingBenchmarkRenderReady;
            _typingBenchmarkRenderReady = null;
            renderReady.TrySetResult(true);
        }

        if (_typingBenchmarkPaintPending && _typingBenchmarkPaintReady != null)
        {
            _typingBenchmarkPaintPending = false;
            _typingBenchmarkPaintReady.TrySetResult(Stopwatch.GetTimestamp());
        }
    }

    private void HandleZoomChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Zoom.OnZoomChanged -= HandleZoomChanged;
        if (_typingBenchmarkModule != null)
        {
            try
            {
                await _typingBenchmarkModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Browser already left the harness.
            }
        }
    }
