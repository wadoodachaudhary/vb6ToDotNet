@using Fx.ControlKit
@using FlexKitTester.Services
@implements IDisposable

<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px">
    <span>Uplink delay</span>
    <SegmentedControl Items="@Choices" Value="@BenchLatency.UplinkMs.ToString()"
                      ValueChanged="SetLatency" AriaLabel="Uplink delay" />
</div>

@code {
    private static readonly SelectionItem[] Choices =
    [
        new("0", "Off"), new("100", "100 ms"), new("250", "250 ms"),
        new("500", "500 ms"), new("1000", "1,000 ms")
    ];

    private void SetLatency(string value) => BenchLatency.UplinkMs = int.Parse(value);

    public void Dispose() => BenchLatency.UplinkMs = 0;
}
