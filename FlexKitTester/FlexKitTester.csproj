<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Keep the established FlexCore default, while allowing this same harness
         to verify the external FlexKit project with -p:UseFlexKit=true. -->
    <UseFlexKit Condition="'$(UseFlexKit)' == ''">false</UseFlexKit>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseFlexKit)' != 'true'">
    <ProjectReference Include="..\..\FlexCore\FlexCore.csproj" />
    <ProjectReference Include="..\..\FlexCore\FlexCore.Documents\FlexCore.Documents.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseFlexKit)' == 'true'">
    <ProjectReference Include="..\..\FlexKit\FlexKit.csproj" />
    <!-- This route intentionally compiles only against FlexCore so it can
         exercise newly-added APIs without forcing an unsynchronized FlexKit
         package change. The rest of the tester remains dual-targeted. -->
    <Content Remove="Components\Pages\ControlBenches\**" />
    <Compile Remove="Components\Pages\ControlBenches\**" />
    <None Remove="Components\Pages\ControlBenches\**" />
    <Content Remove="Components\Pages\FlexCoreEnterpriseGridBench.razor" />
    <Content Remove="Components\Pages\FlexCoreEnterpriseGridBench.razor.css" />
    <None Remove="Components\Pages\FlexCoreEnterpriseGridBench.razor.css" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The two control kits share assembly namespaces but have different
         assembly identities. Keep their generated deps/static-asset manifests
         separate so switching targets cannot reuse the other kit's artifacts. -->
    <OutputPath Condition="'$(UseFlexKit)' == 'true'">bin/$(Configuration)/flexkit/</OutputPath>
    <IntermediateOutputPath Condition="'$(UseFlexKit)' == 'true'">obj/$(Configuration)/flexkit/</IntermediateOutputPath>
    <!-- Optional latency probes read credentials from user-secrets or environment
         variables only. No connection string is committed to this project. -->
    <UserSecretsId>c4eb4c27-c614-45f9-9dbb-01f45e63ec6b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Used only by the explicitly-invoked, read-only SELECT 1 latency probe. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.107.0" />
    <!-- Tester-only local provider store. FlexCore and FlexKit remain provider-neutral. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <!-- Override Sqlite's older native transitive asset, which NuGet currently
         flags for GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Radzen.Blazor" Version="11.2.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK's **\*.json glob already publishes Data\; these are explicit so
         a glob change cannot silently drop the exports the benches need. -->
    <Content Update="Data\estimating-items-full.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Data\assembly-details-full.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Data\interior-finishing-items.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Data\vendors-200.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Data\vendor-contacts.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Data\vendor-paypoints.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Data\vendor-taxgroups.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Data\CrystalSamples.db" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('Data/CrystalSamples.db')" />
    <None Remove="run-bench.ps1" />
    <None Remove="run-bench.cmd" />
    <None Remove="README.txt" />
    <Content Include="run-bench.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="run-bench.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Opt-in with -p:TrimTorchNatives=true. TorchSharp reaches the publish set
       through FlexCore/Llm, which no bench executes; the native payload is
       250 MB+. -->
  <Target Name="TrimTorchNatives" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(TrimTorchNatives)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('torch')) Or $([System.String]::Copy('%(Filename)').StartsWith('libtorch')) Or $([System.String]::Copy('%(Filename)').StartsWith('c10')) Or $([System.String]::Copy('%(Filename)').StartsWith('fbgemm')) Or $([System.String]::Copy('%(Filename)').StartsWith('asmjit')) Or $([System.String]::Copy('%(Filename)').StartsWith('libiomp')) Or $([System.String]::Copy('%(Filename)').StartsWith('nvfuser'))" />
    </ItemGroup>
  </Target>

</Project>
