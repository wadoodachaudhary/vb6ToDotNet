<?xml version="1.0" encoding="UTF-8"?>
<!--
  HomeFront / Precision Builder — Chrome screen-capture allow profile (macOS).

  WHY THIS FILE: macOS Chrome ignores policies set with `defaults write` (user domain).
  Policies must arrive as a managed *configuration profile*. This profile pre-authorizes
  the app's origin so the Feedback capture (F8 / Shift+F8) runs with NO "Allow ... to see
  this tab?" prompt.

  EDIT FIRST: replace every  http://localhost:5065  below with the EXACT origin in your
  Chrome address bar (scheme + host + port, no path, no trailing slash).

  INSTALL:
    1. Double-click this file.
    2. System Settings → General → Device Management (or Privacy & Security → Profiles)
       → select "HomeFront — Chrome Screen Capture" → Install (enter your password;
       an "unsigned" warning is expected for a local profile).
    3. FULLY quit Chrome (Cmd-Q) and reopen.
    4. Verify: chrome://policy → Reload policies → TabCaptureAllowedByOrigins shows the origin.

  REMOVE: System Settings → Device Management → select the profile → Remove.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.google.Chrome</string>
            <key>PayloadIdentifier</key>
            <string>com.homefront.chrome.screencapture.payload</string>
            <key>PayloadUUID</key>
            <string>5CCB3B9C-5A76-4EF2-B130-4570A6EB8BFF</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadEnabled</key>
            <true/>
            <key>PayloadDisplayName</key>
            <string>Chrome — Allow Screen/Tab Capture (HomeFront)</string>

            <!-- Same-origin self-tab capture (what the app does via preferCurrentTab) -->
            <key>SameOriginTabCaptureAllowedByOrigins</key>
            <array>
                <string>http://localhost:5065</string>
            </array>
            <!-- Any-tab capture -->
            <key>TabCaptureAllowedByOrigins</key>
            <array>
                <string>http://localhost:5065</string>
            </array>
            <!-- Broad fallback (tab + window + screen) -->
            <key>ScreenCaptureAllowedByOrigins</key>
            <array>
                <string>http://localhost:5065</string>
            </array>
        </dict>
    </array>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadIdentifier</key>
    <string>com.homefront.chrome.screencapture</string>
    <key>PayloadUUID</key>
    <string>050ED955-E4C2-43C6-B388-192F7FDDFB62</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadDisplayName</key>
    <string>HomeFront — Chrome Screen Capture</string>
    <key>PayloadDescription</key>
    <string>Pre-authorizes the HomeFront app origin to capture its own tab without a prompt.</string>
    <key>PayloadScope</key>
    <string>User</string>
</dict>
</plist>
