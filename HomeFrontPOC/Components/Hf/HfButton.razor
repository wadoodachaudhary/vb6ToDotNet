@namespace HomeFront.Components.Hf

<button class="hf-button @CssClass" type="@ButtonType" disabled="@Disabled" style="@Style" @onclick="OnClick">
    @if (!string.IsNullOrWhiteSpace(IconCss))
    {
        <span class="@IconCss"></span>
    }
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string ButtonType { get; set; } = "button";
    [Parameter] public string? IconCss { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
}
