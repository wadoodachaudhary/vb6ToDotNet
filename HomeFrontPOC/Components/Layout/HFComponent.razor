@inherits LayoutComponentBase
@layout MainLayout
@using System.Net
@using System.Text
@using System.Text.RegularExpressions
@using System.IO
@using System.Linq
@using Microsoft.AspNetCore.Components.Routing
@inject IWebHostEnvironment Env
@inject NavigationManager NavigationManager

@* Pure CSS tabs: hidden radio buttons + labels + :checked sibling selectors *@
<div class="hf-tabs">
    <input type="radio" name="hf-tab" id="hf-tab-1" class="hf-tab-radio" checked />
    <input type="radio" name="hf-tab" id="hf-tab-2" class="hf-tab-radio" />
    <input type="radio" name="hf-tab" id="hf-tab-3" class="hf-tab-radio" />
    <input type="radio" name="hf-tab" id="hf-tab-4" class="hf-tab-radio" />

    <div class="hf-tab-bar">
        <label for="hf-tab-1" class="hf-tab-btn">.NET</label>
        <label for="hf-tab-2" class="hf-tab-btn">VB6</label>
        <label for="hf-tab-3" class="hf-tab-btn">VB6 Source</label>
        <label for="hf-tab-4" class="hf-tab-btn">.NET Source</label>
    </div>

    @* All panels always in the DOM; CSS toggles visibility. @Body stays alive across tab switches. *@
    <div class="hf-tab-panel hf-panel-1">
        @Body
    </div>
    <div class="hf-tab-panel hf-panel-2">
        @if (ImageExists)
        {
            <img class="hf-vb6-image" src="@ImageUrl" alt="@($"{PageName} VB6")" />
        }
        else
        {
            <div class="hf-empty">No VB6 image found for @PageName.</div>
        }
    </div>
    <div class="hf-tab-panel hf-panel-3">
        <pre class="hf-code vb6">@((MarkupString)Vb6Highlighted)</pre>
    </div>
    <div class="hf-tab-panel hf-panel-4">
        <pre class="hf-code dotnet">@((MarkupString)DotNetHighlighted)</pre>
    </div>
</div>

<style>
    .hf-tabs {
        display: block;
    }
    .hf-tab-radio {
        display: none;
    }
    .hf-tab-btn {
        padding: 6px 14px;
        border-bottom: 2px solid transparent;
        background: #f4f4f4;
        font-size: 12px;
        cursor: pointer;
        user-select: none;
        display: inline-block;
        text-decoration: none;
        color: #333;
    }
    /* Active tab label styling via :checked sibling selector */
    #hf-tab-1:checked ~ .hf-tab-bar > label[for="hf-tab-1"],
    #hf-tab-2:checked ~ .hf-tab-bar > label[for="hf-tab-2"],
    #hf-tab-3:checked ~ .hf-tab-bar > label[for="hf-tab-3"],
    #hf-tab-4:checked ~ .hf-tab-bar > label[for="hf-tab-4"] {
        background: #ffffff;
        border-bottom: 2px solid #0d6efd;
        font-weight: 600;
        color: #0d6efd;
    }
    /* Hide all panels by default, show via :checked */
    .hf-tab-panel {
        display: none;
        margin-top: 6px;
        padding: 4px;
        border: 1px solid #e0e0e0;
        background: #ffffff;
    }
    #hf-tab-1:checked ~ .hf-panel-1,
    #hf-tab-2:checked ~ .hf-panel-2,
    #hf-tab-3:checked ~ .hf-panel-3,
    #hf-tab-4:checked ~ .hf-panel-4 {
        display: block;
    }
    .hf-vb6-image {
        max-width: 100%;
        height: auto;
        border: 1px solid #d0d0d0;
        background: #ffffff;
    }
    .hf-empty {
        padding: 12px;
        color: #777;
        font-size: 12px;
    }
    .hf-code {
        margin: 0;
        padding: 10px;
        overflow: auto;
        white-space: pre;
        border: 1px solid #ddd;
        font-family: Menlo, Consolas, "Courier New", monospace;
        font-size: 12px;
        line-height: 1.4;
    }
    .hf-code.vb6 {
        background: #ffffff;
        color: #000000;
    }
    .hf-code.vb6 .tok-kw { color: #0000ff; }
    .hf-code.vb6 .tok-str { color: #800000; }
    .hf-code.vb6 .tok-cmt { color: #008000; }

    .hf-code.dotnet {
        background: #1e1e1e;
        color: #d4d4d4;
    }
    .hf-code.dotnet .tok-kw { color: #569cd6; }
    .hf-code.dotnet .tok-str { color: #ce9178; }
    .hf-code.dotnet .tok-cmt { color: #6a9955; }
    .hf-code.dotnet .tok-num { color: #b5cea8; }
    .hf-code.dotnet .tok-type { color: #4ec9b0; }
    .hf-code.dotnet .tok-func { color: #dcdcaa; }
    .hf-code.dotnet .tok-razor { color: #c586c0; }
    .hf-code.dotnet .tok-htmltag { color: #569cd6; }
    .hf-code.dotnet .tok-attr { color: #d7ba7d; }
</style>

@code {
    [CascadingParameter] public RouteData? RouteData { get; set; }

    private string PageName = "Unknown";
    private string TabIdPrefix = "hfpage";
    private string ImageUrl = "";
    private bool ImageExists;

    private string Vb6Highlighted = "";
    private string DotNetHighlighted = "";
    private bool _vb6Loaded;
    private bool _dotNetLoaded;
    private const int MaxHighlightChars = 500000;

    private static readonly HashSet<string> VbKeywords = new(StringComparer.OrdinalIgnoreCase)
    {
        "if","then","else","elseif","end","sub","function","dim","set","new","for","next","while",
        "wend","do","loop","until","select","case","exit","on","error","resume","goto","call","with",
        "me","private","public","friend","property","get","let","type","enum","const","as","byval",
        "byref","optional","not","and","or","xor","mod","true","false","nothing","is","like","to",
        "each","in","stop","debug","print","input","open","close"
    };

    private static readonly HashSet<string> CsKeywords = new(StringComparer.Ordinal)
    {
        "using","namespace","class","struct","interface","enum","record","public","private","protected",
        "internal","static","void","int","string","bool","var","new","return","if","else","switch",
        "case","break","continue","for","foreach","while","do","try","catch","finally","throw","async",
        "await","Task","partial","get","set","true","false","null","this","base","typeof","default",
        "in","out","ref","is","as","operator","override","virtual","sealed","readonly","const"
    };

    private static readonly Regex VbCommentRegex = new(@"(?m)^\s*(?:'|Rem\b).*");
    private static readonly Regex VbStringRegex = new("\"([^\"\\n]|\"\")*\"");
    private static readonly Regex IdentifierRegex = new(@"\b[A-Za-z_][A-Za-z0-9_]*\b");

    private static readonly Regex RazorCommentRegex = new(@"@\*.*?\*@", RegexOptions.Singleline);
    private static readonly Regex CsLineCommentRegex = new(@"//.*", RegexOptions.Multiline);
    private static readonly Regex CsBlockCommentRegex = new(@"/\*.*?\*/", RegexOptions.Singleline);
    private static readonly Regex CsStringRegex = new("\"([^\"\\n]|\\\\\")*\"");
    private static readonly Regex CsNumberRegex = new(@"\b\d+(?:\.\d+)?\b");
    private static readonly Regex RazorDirectiveRegex = new(@"@\w+");
    private static readonly Regex HtmlTagRegex = new(@"</?\s*([A-Za-z0-9_:\-]+)");
    private static readonly Regex HtmlAttrRegex = new(@"\b([A-Za-z_:][A-Za-z0-9_:\-]*)(?==)");
    private static readonly Regex TypeDeclRegex = new(@"\b(class|struct|interface|enum|record)\s+([A-Za-z_][A-Za-z0-9_]*)");
    private static readonly Regex FuncRegex = new(@"\b([A-Za-z_][A-Za-z0-9_]*)\s*(?=\()");

    private record struct Token(int Start, int End, string Class);

    protected override void OnParametersSet()
    {
        var newPage = ResolvePageName();
        if (!string.Equals(newPage, PageName, StringComparison.Ordinal))
        {
            PageName = newPage;
            TabIdPrefix = $"hf-{SanitizeId(PageName)}";
            LoadAssets();
        }
    }

    private void LoadAssets()
    {
        ImageUrl = $"images/VB6/{PageName}.png";
        ImageExists = false;
        if (!string.IsNullOrWhiteSpace(Env.WebRootPath))
        {
            var imgPath = Path.Combine(Env.WebRootPath, "images", "VB6", $"{PageName}.png");
            ImageExists = File.Exists(imgPath);
        }

        _vb6Loaded = false;
        _dotNetLoaded = false;
        EnsureVb6Loaded();
        EnsureDotNetLoaded();
    }

    private void EnsureVb6Loaded()
    {
        if (_vb6Loaded) return;
        var src = ReadVb6Source(PageName);
        Vb6Highlighted = string.IsNullOrWhiteSpace(src)
            ? "<span class=\"tok-cmt\">No VB6 source found.</span>"
            : HighlightVb6(src);
        _vb6Loaded = true;
    }

    private void EnsureDotNetLoaded()
    {
        if (_dotNetLoaded) return;
        var src = ReadDotNetSource(PageName);
        DotNetHighlighted = string.IsNullOrWhiteSpace(src)
            ? "<span class=\"tok-cmt\">No .NET source found.</span>"
            : HighlightDotNet(src);
        _dotNetLoaded = true;
    }

    private string ReadDotNetSource(string pageName)
    {
        if (string.IsNullOrWhiteSpace(Env.ContentRootPath))
            return "";
        var migrated = Path.Combine(Env.ContentRootPath, "Components", "Pages", "Migrated", $"{pageName}.razor");
        if (File.Exists(migrated))
            return File.ReadAllText(migrated);
        var root = Path.Combine(Env.ContentRootPath, "Components", "Pages", $"{pageName}.razor");
        return File.Exists(root) ? File.ReadAllText(root) : "";
    }

    private static readonly string[] VbExtensions = [".frm", ".bas", ".cls", ".ctl"];
    private static readonly Dictionary<string, string?> VbPathCache = new(StringComparer.OrdinalIgnoreCase);
    private static readonly object RouteMapLock = new();
    private static Dictionary<string, string>? RouteToPageMap;

    private string ReadVb6Source(string pageName)
    {
        if (string.IsNullOrWhiteSpace(pageName))
            return "";

        if (VbPathCache.TryGetValue(pageName, out var cached))
            return cached != null && File.Exists(cached) ? File.ReadAllText(cached) : "";

        foreach (var root in GetVbRoots())
        {
            try
            {
                if (!Directory.Exists(root))
                    continue;
                var match = Directory.EnumerateFiles(root, $"{pageName}.*", SearchOption.AllDirectories)
                    .FirstOrDefault(path => VbExtensions.Contains(Path.GetExtension(path), StringComparer.OrdinalIgnoreCase));
                if (!string.IsNullOrWhiteSpace(match))
                {
                    VbPathCache[pageName] = match;
                    return File.ReadAllText(match);
                }
            }
            catch
            {
                // ignore IO errors
            }
        }

        VbPathCache[pageName] = null;
        return "";
    }

    private IEnumerable<string> GetVbRoots()
    {
        if (string.IsNullOrWhiteSpace(Env.WebRootPath))
            yield break;

        var sources = Path.Combine(Env.WebRootPath, "Sources");
        if (Directory.Exists(sources))
            yield return sources;

        var sourcesLower = Path.Combine(Env.WebRootPath, "sources");
        if (!string.Equals(sourcesLower, sources, StringComparison.OrdinalIgnoreCase) && Directory.Exists(sourcesLower))
            yield return sourcesLower;
    }

    private static string HighlightVb6(string text)
    {
        if (text.Length > MaxHighlightChars)
            return WebUtility.HtmlEncode(text);

        var tokens = new List<Token>();
        AddTokens(tokens, VbCommentRegex, text, "cmt");
        AddTokens(tokens, VbStringRegex, text, "str");
        foreach (Match m in IdentifierRegex.Matches(text))
        {
            var word = m.Value;
            if (VbKeywords.Contains(word))
                AddToken(tokens, m.Index, m.Index + m.Length, "kw");
        }
        return BuildHighlighted(text, tokens);
    }

    private static string HighlightDotNet(string text)
    {
        if (text.Length > MaxHighlightChars)
            return WebUtility.HtmlEncode(text);

        var tokens = new List<Token>();
        AddTokens(tokens, RazorCommentRegex, text, "cmt");
        AddTokens(tokens, CsLineCommentRegex, text, "cmt");
        AddTokens(tokens, CsBlockCommentRegex, text, "cmt");
        AddTokens(tokens, CsStringRegex, text, "str");
        AddTokens(tokens, CsNumberRegex, text, "num");
        AddTokens(tokens, RazorDirectiveRegex, text, "razor");

        foreach (Match m in HtmlTagRegex.Matches(text))
            AddToken(tokens, m.Groups[1].Index, m.Groups[1].Index + m.Groups[1].Length, "htmltag");
        foreach (Match m in HtmlAttrRegex.Matches(text))
            AddToken(tokens, m.Groups[1].Index, m.Groups[1].Index + m.Groups[1].Length, "attr");
        foreach (Match m in TypeDeclRegex.Matches(text))
            AddToken(tokens, m.Groups[2].Index, m.Groups[2].Index + m.Groups[2].Length, "type");
        foreach (Match m in FuncRegex.Matches(text))
            AddToken(tokens, m.Groups[1].Index, m.Groups[1].Index + m.Groups[1].Length, "func");

        foreach (Match m in IdentifierRegex.Matches(text))
        {
            var word = m.Value;
            if (CsKeywords.Contains(word))
                AddToken(tokens, m.Index, m.Index + m.Length, "kw");
        }

        return BuildHighlighted(text, tokens);
    }

    private static void AddTokens(List<Token> tokens, Regex regex, string text, string cls)
    {
        foreach (Match m in regex.Matches(text))
            AddToken(tokens, m.Index, m.Index + m.Length, cls);
    }

    private static void AddToken(List<Token> tokens, int start, int end, string cls)
    {
        if (start < 0 || end <= start)
            return;
        foreach (var tok in tokens)
        {
            if (start < tok.End && end > tok.Start)
                return;
        }
        tokens.Add(new Token(start, end, cls));
    }

    private static string BuildHighlighted(string text, List<Token> tokens)
    {
        tokens.Sort((a, b) => a.Start.CompareTo(b.Start));
        var sb = new StringBuilder(text.Length + tokens.Count * 32);
        var pos = 0;
        foreach (var tok in tokens)
        {
            if (tok.Start < pos)
                continue;
            if (tok.Start > pos)
                sb.Append(WebUtility.HtmlEncode(text.Substring(pos, tok.Start - pos)));
            sb.Append("<span class=\"tok-");
            sb.Append(tok.Class);
            sb.Append("\">");
            sb.Append(WebUtility.HtmlEncode(text.Substring(tok.Start, tok.End - tok.Start)));
            sb.Append("</span>");
            pos = tok.End;
        }
        if (pos < text.Length)
            sb.Append(WebUtility.HtmlEncode(text.Substring(pos)));
        return sb.ToString();
    }

    private string ResolvePageName()
    {
        var route = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        route = route.Split('?', '#')[0].Trim('/');
        var routeKey = "/" + route;

        var map = GetRouteToPageMap();
        if (map.TryGetValue(routeKey, out var page))
            return page;

        if (RouteData?.PageType != null)
            return RouteData.PageType.Name;

        if (Body?.Target != null)
        {
            var targetName = Body.Target.GetType().Name;
            if (!string.IsNullOrWhiteSpace(targetName))
                return targetName;
        }

        return string.IsNullOrEmpty(route) ? "Index" : "Unknown";
    }

    private Dictionary<string, string> GetRouteToPageMap()
    {
        lock (RouteMapLock)
        {
            if (RouteToPageMap != null)
                return RouteToPageMap;

            var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            if (!string.IsNullOrWhiteSpace(Env.ContentRootPath))
            {
                var pagesRoot = Path.Combine(Env.ContentRootPath, "Components", "Pages");
                if (Directory.Exists(pagesRoot))
                {
                    foreach (var file in Directory.EnumerateFiles(pagesRoot, "*.razor", SearchOption.AllDirectories))
                    {
                        var pageName = Path.GetFileNameWithoutExtension(file);
                        try
                        {
                            foreach (var line in File.ReadLines(file))
                            {
                                var match = Regex.Match(line, "@page\\s+\\\"(?<route>[^\\\"]+)\\\"");
                                if (match.Success)
                                {
                                    var route = match.Groups["route"].Value;
                                    if (!map.ContainsKey(route))
                                        map[route] = pageName;
                                }
                            }
                        }
                        catch
                        {
                            // ignore
                        }
                    }
                }
            }

            RouteToPageMap = map;
            return map;
        }
    }

    private static string SanitizeId(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "page";
        var sb = new StringBuilder(value.Length);
        foreach (var ch in value)
        {
            if (char.IsLetterOrDigit(ch) || ch == '-' || ch == '_')
                sb.Append(ch);
            else
                sb.Append('-');
        }
        return sb.ToString();
    }
}
