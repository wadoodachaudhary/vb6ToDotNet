@page "/vendor"

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Dynamic
@using System.Collections.Generic
@using System.Linq
@using System.Reflection
@using HomeFront.Components.Hf
@using HomeFront.Data

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@layout HFComponent
<PageTitle>Vendor</PageTitle>

<style>
    .toolbar-cntr {
        padding: 8px 12px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        margin-bottom: 10px;
        background-color: #f8f9fa;
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        align-items: center;
    }

    .tbar-btn {
        padding: 6px 12px;
        border: 1px solid #c9c9c9;
        background: #f7f7f7;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
    }

    .tbar-btn:hover {
        background: #e8e8e8;
    }

    .tbar-icon {
        width: 24px;
        height: 24px;
        margin-bottom: 4px;
    }

    .tool-label {
        width: 100%;
        display: block;
        text-align: center;
        font-size: 12px;
    }

    /* Label-left layout matching VB6 */
    .form-row {
        display: flex;
        align-items: center;
        margin-bottom: 3px;
    }
    .form-row label {
        min-width: 100px;
        font-size: 13px;
        color: #333;
        text-align: right;
        padding-right: 6px;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .form-row input[type="text"],
    .form-row textarea,
    .form-row select,
    .form-row input[type="number"] {
        flex: 1;
        padding: 2px 4px;
        border: 1px solid #999;
        font-size: 13px;
    }
    .form-row .field-short {
        max-width: 120px;
    }
    .form-row .field-med {
        max-width: 200px;
    }

    .chk-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 4px 0 4px 106px;
    }
    .chk-row label {
        font-size: 13px;
        cursor: pointer;
    }

    .vendor-header {
        font-size: 14px;
        font-weight: bold;
        color: #333;
        margin-bottom: 6px;
    }

    .section-title {
        font-size: 14px;
        font-weight: bold;
        margin-top: 12px;
        margin-bottom: 6px;
        color: #0080c0;
    }

    .nav-buttons {
        margin-top: 12px;
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .nav-buttons button {
        padding: 6px 16px;
        border: 1px solid #c9c9c9;
        background: #f7f7f7;
        border-radius: 4px;
        cursor: pointer;
    }

    .nav-buttons button:hover {
        background: #e8e8e8;
    }

    .contacts-grid input[type="checkbox"] {
        width: 14px;
        height: 14px;
        border: 1px solid #000;
        background: #fff;
        appearance: none;
        -webkit-appearance: none;
        display: inline-block;
        position: relative;
        vertical-align: middle;
        margin: 0;
    }

    .contacts-grid input[type="checkbox"]:checked::after {
        content: "";
        position: absolute;
        left: 4px;
        top: 1px;
        width: 4px;
        height: 8px;
        border: solid #000;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .contacts-grid input[type="checkbox"]:disabled {
        opacity: 0.7;
    }
</style>

<!-- Toolbar -->
<div class="toolbar-cntr">
    <button class="tbar-btn">
        <img src="images/32/open.ico" class="tbar-icon" />
        <span class="tool-label">Open</span>
    </button>
    <button class="tbar-btn" @onclick="OnSaveClick">
        <img src="images/32/save.ico" class="tbar-icon" />
        <span class="tool-label">Save</span>
    </button>
    <button class="tbar-btn">
        <img src="images/32/excelimport.ico" class="tbar-icon" />
        <span class="tool-label">Import Items</span>
    </button>
    <button class="tbar-btn">
        <img src="images/32/excelexport.ico" class="tbar-icon" />
        <span class="tool-label">Export Items</span>
    </button>
</div>

<div class="row m-0">
    <!-- Left Panel: Vendor Details -->
    <div class="col-md-3">
        <div class="form-row">
            <label>Vendor</label>
            <input type="text" @bind="VendorId" disabled="@IsReadOnly" />
        </div>
        <div class="form-row">
            <label>Company Name</label>
            <input type="text" @bind="Description" disabled="@IsReadOnly" />
        </div>

        <div class="chk-row">
            <label><input type="checkbox" @bind="IsTBD" /> TBD - budget planning only</label>
            <label><input type="checkbox" @bind="IsBuildPro" /> BuildPro Vendor</label>
        </div>

        <h4 class="section-title">Address</h4>
        <div class="form-row">
            <label></label>
            <input type="text" @bind="Address" disabled="@IsReadOnly" />
        </div>
        <div class="form-row">
            <label></label>
            <textarea rows="2" @bind="Address2" disabled="@IsReadOnly"></textarea>
        </div>
        <div class="form-row">
            <label>City</label>
            <input type="text" @bind="City" disabled="@IsReadOnly" />
        </div>
        <div class="form-row">
            <label>State/Province</label>
            <input type="text" @bind="Province" disabled="@IsReadOnly" />
        </div>
        <div class="form-row">
            <label>Postal</label>
            <input type="text" class="field-short" @bind="Postal" disabled="@IsReadOnly" />
        </div>
        <div class="form-row">
            <label>Phone</label>
            <input type="text" class="field-short" @bind="Phone" disabled="@IsReadOnly" />
        </div>
        <div class="form-row">
            <label>Fax</label>
            <input type="text" class="field-short" @bind="Fax" disabled="@IsReadOnly" />
        </div>
        <div class="form-row">
            <label>Status</label>
            <select @bind="StatusIndex" class="field-med">
                @foreach (var opt in StatusOptions)
                {
                    <option value="@opt.Value">@opt.Text</option>
                }
            </select>
        </div>
        <div class="form-row">
            <label>Retainage %</label>
            <input type="number" class="field-short" step="0.01" @bind="HoldbackPercent" disabled="@IsReadOnly" />
        </div>
        <div class="form-row">
            <label>Payee ID</label>
            <input type="text" @bind="WalletPayeeID" disabled />
        </div>
        <div class="form-row">
            <label>Tax ID</label>
            <input type="text" @bind="TaxID" disabled="@IsReadOnly" />
        </div>
        <div class="form-row">
            <label>Trade Type</label>
            <select @bind="TradeType" disabled="@IsReadOnly">
                <option value=""></option>
                @foreach (var t in TradeTypes)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div class="form-row">
            <label>PO Format</label>
            <select @bind="POFormat" disabled="@IsReadOnly">
                <option value=""></option>
                @foreach (var f in POFormats)
                {
                    <option value="@f">@f</option>
                }
            </select>
        </div>

        <h4 class="section-title">Web Portal</h4>
        <div class="form-row">
            <label>Login ID</label>
            <input type="text" @bind="WebUID" disabled="@IsReadOnly" />
        </div>
        <div class="form-row">
            <label>Password</label>
            <input type="text" @bind="WebPWD" disabled="@IsReadOnly" />
        </div>
    </div>

    <!-- Right Panel: Grids -->
    <div class="col-md-9">
        <h4 class="section-title">Contacts</h4>
        <div class="contacts-grid">
            <HfGrid @ref="gContacts" TValue="VendorContact" DataSource="@Contacts" AllowSorting="true" Height="200px">
                <HfGridColumnsBase @key="gContactsLayoutVersion" DebugTag="FVendor-gContacts">
                @if (HasContactsLayout)
                {
                    foreach (var col in GetOrderedLayout(gContactsLayout))
                    {
                        var headerText = string.IsNullOrWhiteSpace(col.Caption) ? col.Field : col.Caption;
                        var width = col.Width.HasValue && col.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(col.Width.Value)}px" : "120px";
                        var resolvedField = ResolveContactField(col.Field);
                        var isCheckbox = IsContactCheckboxField(resolvedField);
                        if (isCheckbox)
                        {
                            <HfGridColumn Field="@resolvedField" HeaderText="@headerText" Width="@width"
                                          Type="ColumnType.CheckBox" AllowEditing="@(!IsReadOnly)">
                                <Template>
                                    @{
                                       var row = (VendorContact)context;
                                       var isChecked = GetContactBool(row, resolvedField);
                                   }
                                    <input type="checkbox"
                                           checked="@isChecked"
                                           disabled="@IsReadOnly"
                                           @onchange="(ChangeEventArgs e) => OnContactCheckboxChanged(row, resolvedField, e)"
                                           @onclick:stopPropagation="true" />
                                </Template>
                            </HfGridColumn>
                        }
                        else
                        {
                            <HfGridColumn Field="@resolvedField" HeaderText="@headerText" Width="@width" />
                        }
                    }
                }
                else
                {
                    <HfGridColumn Field="@nameof(VendorContact.ContactID)" HeaderText="Contact ID" Width="100px" />
                    <HfGridColumn Field="@nameof(VendorContact.Role)" HeaderText="Role" Width="100px" />
                    <HfGridColumn Field="@nameof(VendorContact.Name)" HeaderText="Name" Width="140px" />
                    <HfGridColumn Field="@nameof(VendorContact.Phone)" HeaderText="Phone" Width="120px" />
                    <HfGridColumn Field="@nameof(VendorContact.Cell)" HeaderText="Cell" Width="120px" />
                    <HfGridColumn Field="@nameof(VendorContact.Fax)" HeaderText="Fax" Width="120px" />
                    <HfGridColumn Field="@nameof(VendorContact.Email)" HeaderText="Email" Width="180px" />
                    <HfGridColumn Field="@nameof(VendorContact.SendVia)" HeaderText="Send Via" Width="80px" />
                    <HfGridColumn Field="@nameof(VendorContact.SmsAddress)" HeaderText="SMS Address" Width="140px" />
                    <HfGridColumn Field="@nameof(VendorContact.PONotice)" HeaderText="PO Notice" Width="90px" Type="ColumnType.CheckBox" />
                    <HfGridColumn Field="@nameof(VendorContact.FPONotice)" HeaderText="FPO Notice" Width="90px" Type="ColumnType.CheckBox" />
                    <HfGridColumn Field="@nameof(VendorContact.SchedNotice)" HeaderText="Sched Notice" Width="100px" Type="ColumnType.CheckBox" />
                    <HfGridColumn Field="@nameof(VendorContact.ServiceNotice)" HeaderText="Service Notice" Width="100px" Type="ColumnType.CheckBox" />
                }
                </HfGridColumnsBase>
            </HfGrid>
        </div>

        <h4 class="section-title">Contract Payment Points</h4>
        <HfGrid @ref="gPayPoints" TValue="VendorPayPoint" DataSource="@PayPoints" AllowSorting="true" Height="200px">
            <HfGridColumnsBase @key="gPayPointsLayoutVersion" DebugTag="FVendor-gPayPoints">
                @if (HasPayPointsLayout)
                {
                    foreach (var col in GetOrderedLayout(gPayPointsLayout))
                    {
                        var headerText = string.IsNullOrWhiteSpace(col.Caption) ? col.Field : col.Caption;
                        var width = col.Width.HasValue && col.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(col.Width.Value)}px" : "110px";
                        var isNumeric = !col.Field.Equals("POIndex", StringComparison.OrdinalIgnoreCase);
                        <HfGridColumn Field="@col.Field" HeaderText="@headerText" Width="@width"
                                      TextAlign="@(isNumeric ? TextAlign.Right : TextAlign.Left)" />
                    }
                }
                else
                {
                    <HfGridColumn Field="@nameof(VendorPayPoint.POIndex)" HeaderText="PO Index" Width="120px" />
                    <HfGridColumn Field="@nameof(VendorPayPoint.PayPoint1Percent)" HeaderText="PayPoint1 %" Width="110px" TextAlign="TextAlign.Right" />
                    <HfGridColumn Field="@nameof(VendorPayPoint.PayPoint2Percent)" HeaderText="PayPoint2 %" Width="110px" TextAlign="TextAlign.Right" />
                    <HfGridColumn Field="@nameof(VendorPayPoint.PayPoint3Percent)" HeaderText="PayPoint3 %" Width="110px" TextAlign="TextAlign.Right" />
                    <HfGridColumn Field="@nameof(VendorPayPoint.PayPoint4Percent)" HeaderText="PayPoint4 %" Width="110px" TextAlign="TextAlign.Right" />
                    <HfGridColumn Field="@nameof(VendorPayPoint.PayPoint5Percent)" HeaderText="PayPoint5 %" Width="110px" TextAlign="TextAlign.Right" />
                }
            </HfGridColumnsBase>
        </HfGrid>

        <h4 class="section-title">Tax Groups</h4>
        <HfGrid @ref="TaxGroupsGrid" TValue="TaxGroupRow" DataSource="@TaxGroupsData" AllowSorting="true" Height="280px">
            <HfGridColumnsBase>
                <HfGridColumn Field="Community" HeaderText="Community" Width="120px" />
                <HfGridColumn Field="CommunityDescription" HeaderText="Description" Width="220px" />
                <HfGridColumn Field="Labour" HeaderText="Labour" Width="110px" />
                <HfGridColumn Field="Material" HeaderText="Material" Width="110px" />
                <HfGridColumn Field="SubContract" HeaderText="SubContract" Width="110px" />
                <HfGridColumn Field="Equipment" HeaderText="Equipment" Width="110px" />
                <HfGridColumn Field="Overhead" HeaderText="Overhead" Width="110px" />
                <HfGridColumn Field="Other" HeaderText="Other" Width="110px" />
            </HfGridColumnsBase>
        </HfGrid>

        <h4 class="section-title">Insurance</h4>
        <HfGrid @ref="gInsurance" TValue="InsuranceRequirement" DataSource="@InsuranceData" Height="220px">
            <HfGridColumnsBase @key="gInsuranceLayoutVersion" DebugTag="FVendor-gInsurance">
                @if (HasInsuranceLayout)
                {
                    foreach (var col in GetOrderedLayout(gInsuranceLayout))
                    {
                        var headerText = string.IsNullOrWhiteSpace(col.Caption) ? col.Field : col.Caption;
                        var width = col.Width.HasValue && col.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(col.Width.Value)}px" : "140px";
                        var isCheckbox = col.Field.Equals("Req", StringComparison.OrdinalIgnoreCase)
                                        || col.Field.Equals("Required", StringComparison.OrdinalIgnoreCase);
                        var isDate = col.Field.Equals("ExpiryDate", StringComparison.OrdinalIgnoreCase)
                                     || col.Field.Equals("Expiry Date", StringComparison.OrdinalIgnoreCase);
                        <HfGridColumn Field="@col.Field" HeaderText="@headerText" Width="@width"
                                      Type="@(isCheckbox ? ColumnType.CheckBox : ColumnType.Text)"
                                      Format="@(isDate ? "d" : null)" />
                    }
                }
                else
                {
                    <HfGridColumn Field="Name" HeaderText="Name" Width="140px" />
                    <HfGridColumn Field="Req" HeaderText="Req" Width="100px" Type="ColumnType.CheckBox" />
                    <HfGridColumn Field="ExpiryDate" HeaderText="Expiry Date" Format="d" Width="140px" />
                    <HfGridColumn Field="Company" HeaderText="Company" Width="180px" />
                    <HfGridColumn Field="PolicyNumber" HeaderText="Policy #" Width="160px" />
                }
            </HfGridColumnsBase>
        </HfGrid>
    </div>
</div>

<div class="nav-buttons">
    <button @onclick="PreviousClick">&lt;&lt; Previous</button>
    <button @onclick="NextClick">Next &gt;&gt;</button>
</div>

@code {
    [Parameter] public string? VendorIdParam { get; set; }
    private DbWrapperSqlServer db = new();
    private string mVendor = "";
    private bool IsReadOnly = false;

    // === IniGetGrid constants and layout state ===
    private const string FormName = "FVendor";

    private Dictionary<string, MMain.GridLayoutColumn> gContactsLayout = new(StringComparer.OrdinalIgnoreCase);
    private int gContactsLayoutVersion = 0;
    private bool HasContactsLayout => gContactsLayout.Count > 0;

    private Dictionary<string, MMain.GridLayoutColumn> gInsuranceLayout = new(StringComparer.OrdinalIgnoreCase);
    private int gInsuranceLayoutVersion = 0;
    private bool HasInsuranceLayout => gInsuranceLayout.Count > 0;

    private Dictionary<string, MMain.GridLayoutColumn> gPayPointsLayout = new(StringComparer.OrdinalIgnoreCase);
    private int gPayPointsLayoutVersion = 0;
    private bool HasPayPointsLayout => gPayPointsLayout.Count > 0;

    private string VendorId = "";
    private string Description = "";
    private string Address = "";
    private string Address2 = "";
    private string City = "";
    private string Province = "";
    private string Postal = "";
    private string Phone = "";
    private string Fax = "";
    private bool IsTBD;
    private bool BuildProEnabled;
    private string WebUID = "";
    private string WebPWD = "";
    private string WalletPayeeID = "";
    private string TaxID = "";
    private bool IsBuildPro;
    private bool Dirty = false;
    private string VendorDesc = "";

    private List<VendorPayPoint> PayPoints = new();
    private List<VendorContact> Contacts = new();
    private HfGrid<VendorPayPoint>? gPayPoints;
    private HfGrid<VendorContact>? gContacts;
    private HfGrid<TaxGroupRow>? TaxGroupsGrid;
    private HfGrid<InsuranceRequirement>? gInsurance;
    private int DivisionID = 1;

    private int StatusIndex = 0;
    private readonly List<SelectItem> StatusOptions = new()
    {
        new SelectItem { Value = 0, Text = "Active" },
        new SelectItem { Value = 1, Text = "Inactive" }
    };
    private string TradeType = "";
    private string POFormat = "";
    private readonly List<string> TradeTypes = new();
    private readonly List<string> POFormats = new();
    private double HoldbackPercent;

    private List<InsuranceRequirement> InsuranceData = new();
    private List<TaxGroupRow> TaxGroupsData = new();

    private List<string> vendors = new();
    private int VendorIndex = 34;

    protected override async Task OnInitializedAsync()
    {
        await LoadGridLayouts();
        VendorId = "41";
        var vendorData = await db.QueryAsync("SELECT * FROM tblVendors WHERE DivisionID = @DivisionID",
            new { DivisionID });
        if (vendorData.Count > 0)
        {
            foreach (var row in vendorData)
            {
                vendors.Add(row["Vendor_ID"]?.ToString() ?? "");
            }
        }
        if (vendors.Count > VendorIndex)
        {
            VendorId = vendors[VendorIndex];
            mVendor = VendorId;
        }
        await LoadDataAsync();
    }

    // VB6: Call IniGetGrid(Me, gContacts, , , , True)  — staticNames=True
    //      Call IniGetGrid(Me, gInsurance)
    //      Call IniGetGrid(Me, gPayPoints)
    private async Task LoadGridLayouts()
    {
        gContactsLayout = await MMain.IniGetGridAsync(FormName, "gContacts", 0, grouped: true);
        gContactsLayoutVersion++;

        gInsuranceLayout = await MMain.IniGetGridAsync(FormName, "gInsurance", 0);
        gInsuranceLayoutVersion++;

        gPayPointsLayout = await MMain.IniGetGridAsync(FormName, "gPayPoints", 0);
        gPayPointsLayoutVersion++;
    }

    private IEnumerable<MMain.GridLayoutColumn> GetOrderedLayout(Dictionary<string, MMain.GridLayoutColumn> layoutDict)
    {
        return layoutDict.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase);
    }

    private static int ConvertLayoutWidthToPx(double layoutWidth)
    {
        if (layoutWidth <= 0) return 0;
        var px = (int)Math.Round(layoutWidth / 15.0);
        px += 16;
        if (px < 32) px = 32;
        if (px > 2000) px = 2000;
        return px;
    }

    private async Task OnSaveClick()
    {
        try
        {
            await SaveContactsAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Save failed: {ex.Message}");
        }
    }

    private static bool GetContactBool(VendorContact row, string field)
    {
        return field switch
        {
            nameof(VendorContact.PONotice) => row.PONotice,
            nameof(VendorContact.FPONotice) => row.FPONotice,
            nameof(VendorContact.SchedNotice) => row.SchedNotice,
            nameof(VendorContact.ServiceNotice) => row.ServiceNotice,
            _ => false
        };
    }

    private void SetContactBool(VendorContact row, string field, bool value)
    {
        switch (field)
        {
            case nameof(VendorContact.PONotice):
                row.PONotice = value;
                break;
            case nameof(VendorContact.FPONotice):
                row.FPONotice = value;
                break;
            case nameof(VendorContact.SchedNotice):
                row.SchedNotice = value;
                break;
            case nameof(VendorContact.ServiceNotice):
                row.ServiceNotice = value;
                break;
        }
    }

    private void OnContactCheckboxChanged(VendorContact row, string field, ChangeEventArgs e)
    {
        if (IsReadOnly) return;
        var isChecked = ToBool(e.Value);
        SetContactBool(row, field, isChecked);
        Dirty = true;
    }

    private static bool IsContactEmpty(VendorContact contact)
    {
        if (contact == null) return true;
        return string.IsNullOrWhiteSpace(contact.ContactID)
            && string.IsNullOrWhiteSpace(contact.Role)
            && string.IsNullOrWhiteSpace(contact.Name)
            && string.IsNullOrWhiteSpace(contact.Phone)
            && string.IsNullOrWhiteSpace(contact.Cell)
            && string.IsNullOrWhiteSpace(contact.Fax)
            && string.IsNullOrWhiteSpace(contact.Email)
            && string.IsNullOrWhiteSpace(contact.SmsAddress)
            && contact.SendVia == 0
            && !contact.PONotice && !contact.FPONotice && !contact.SchedNotice && !contact.ServiceNotice;
    }

    private async Task SaveContactsAsync()
    {
        if (string.IsNullOrWhiteSpace(mVendor))
            return;

        foreach (var contact in Contacts.ToList())
        {
            if (IsContactEmpty(contact))
                continue;

            var parameters = new
            {
                DivisionID,
                ContactTypeID = 99,
                UserID = Guid.NewGuid().ToString(),
                Vendor = mVendor,
                Role = contact.Role ?? "",
                Name = contact.Name ?? "",
                Phone = contact.Phone ?? "",
                Cell = contact.Cell ?? "",
                Fax = contact.Fax ?? "",
                Email = contact.Email ?? "",
                SendVia = contact.SendVia,
                SmsAddress = contact.SmsAddress ?? "",
                PONotice = contact.PONotice,
                FPONotice = contact.FPONotice,
                SchedNotice = contact.SchedNotice,
                ServiceNotice = contact.ServiceNotice,
                CompanyName = Description ?? "",
                CompanyAddr1 = Address ?? "",
                CompanyAddr2 = Address2 ?? "",
                CompanyCity = City ?? "",
                CompanyProv = Province ?? "",
                CompanyPostal = Postal ?? ""
            };

            if (string.IsNullOrWhiteSpace(contact.ContactID))
            {
                var insertSql = @"
INSERT INTO Contacts(
    DivisionID, ContactTypeID, UserID, VendorCode,
    Role, FirstName, DisplayName, WorkPhone, CellPhone, Fax, Email, CommModeID, SmsAddress,
    PONotice, FPONotice, SchedNotice, ServiceNotice,
    CompanyName, CompanyAddr1, CompanyAddr2, CompanyCity, CompanyProv, CompanyPostal
)
OUTPUT INSERTED.ContactID
VALUES(
    @DivisionID, @ContactTypeID, @UserID, @Vendor,
    @Role, @Name, @Name, @Phone, @Cell, @Fax, @Email, @SendVia, @SmsAddress,
    @PONotice, @FPONotice, @SchedNotice, @ServiceNotice,
    @CompanyName, @CompanyAddr1, @CompanyAddr2, @CompanyCity, @CompanyProv, @CompanyPostal
)";
                var newId = await db.ExecuteScalarAsync<long>(insertSql, parameters);
                if (newId != 0)
                    contact.ContactID = newId.ToString();
            }
            else
            {
                var updateSql = @"
UPDATE Contacts
SET Role = @Role,
    FirstName = @Name,
    DisplayName = @Name,
    WorkPhone = @Phone,
    CellPhone = @Cell,
    Fax = @Fax,
    Email = @Email,
    CommModeID = @SendVia,
    SmsAddress = @SmsAddress,
    PONotice = @PONotice,
    FPONotice = @FPONotice,
    SchedNotice = @SchedNotice,
    ServiceNotice = @ServiceNotice,
    CompanyName = @CompanyName,
    CompanyAddr1 = @CompanyAddr1,
    CompanyAddr2 = @CompanyAddr2,
    CompanyCity = @CompanyCity,
    CompanyProv = @CompanyProv,
    CompanyPostal = @CompanyPostal
WHERE ContactID = @ContactID";
                var contactIdParam = long.TryParse(contact.ContactID, out var idVal)
                    ? (object)idVal
                    : (object)(contact.ContactID ?? "");
                var updateParams = new
                {
                    parameters.Role,
                    parameters.Name,
                    parameters.Phone,
                    parameters.Cell,
                    parameters.Fax,
                    parameters.Email,
                    parameters.SendVia,
                    parameters.SmsAddress,
                    parameters.PONotice,
                    parameters.FPONotice,
                    parameters.SchedNotice,
                    parameters.ServiceNotice,
                    parameters.CompanyName,
                    parameters.CompanyAddr1,
                    parameters.CompanyAddr2,
                    parameters.CompanyCity,
                    parameters.CompanyProv,
                    parameters.CompanyPostal,
                    ContactID = contactIdParam
                };
                await db.ExecuteAsync(updateSql, updateParams);
            }
        }

        var updatePoSql = @"
UPDATE p
SET DeliveryMethod    = v.PurchDelMethod,
    DeliveryRecipient = v.PurchContact,
    DeliveryAddress   = CASE v.PurchDelMethod WHEN 1 THEN v.PurchEmail ELSE '' END
FROM tblvendors v
JOIN pomaster p
  ON v.vendor_id = p.vendor
 AND p.divisionid = v.divisionid
 AND p.deliverydate IS NULL
WHERE v.vendor_id = @VendorId";
        await db.ExecuteAsync(updatePoSql, new { VendorId = mVendor });

        if (Contacts.Count == 0 || !IsContactEmpty(Contacts.Last()))
            Contacts.Add(new VendorContact());
    }

    private static string NormalizeContactKey(string key)
    {
        if (string.IsNullOrWhiteSpace(key))
            return "";
        var chars = key.Where(char.IsLetterOrDigit).ToArray();
        return new string(chars).ToLowerInvariant();
    }

    private static readonly Dictionary<string, PropertyInfo> _contactPropMap =
        typeof(VendorContact)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .GroupBy(p => NormalizeContactKey(p.Name))
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    private static readonly Dictionary<string, string> _contactFieldAliases = new(StringComparer.OrdinalIgnoreCase)
    {
        ["purchasing"] = nameof(VendorContact.PONotice),
        ["fieldpo"] = nameof(VendorContact.FPONotice),
        ["fieldponotice"] = nameof(VendorContact.FPONotice),
        ["scheduling"] = nameof(VendorContact.SchedNotice),
        ["service"] = nameof(VendorContact.ServiceNotice)
    };

    private static string ResolveContactField(string field)
    {
        if (string.IsNullOrWhiteSpace(field))
            return "";

        var trimmed = field.Trim();
        var exact = typeof(VendorContact).GetProperty(trimmed, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
        if (exact != null)
            return exact.Name;

        var normalized = NormalizeContactKey(trimmed);
        if (_contactPropMap.TryGetValue(normalized, out var prop))
            return prop.Name;

        if (_contactFieldAliases.TryGetValue(normalized, out var alias))
            return alias;

        return trimmed;
    }

    private static bool IsContactCheckboxField(string field)
    {
        return field.Equals(nameof(VendorContact.PONotice), StringComparison.OrdinalIgnoreCase)
            || field.Equals(nameof(VendorContact.FPONotice), StringComparison.OrdinalIgnoreCase)
            || field.Equals(nameof(VendorContact.SchedNotice), StringComparison.OrdinalIgnoreCase)
            || field.Equals(nameof(VendorContact.ServiceNotice), StringComparison.OrdinalIgnoreCase);
    }

    private static bool ToBool(object? value)
    {
        if (value == null || value == DBNull.Value)
            return false;
        if (value is bool b)
            return b;
        var s = value.ToString()?.Trim();
        if (string.IsNullOrEmpty(s))
            return false;
        if (s.Equals("true", StringComparison.OrdinalIgnoreCase) ||
            s.Equals("yes", StringComparison.OrdinalIgnoreCase) ||
            s.Equals("y", StringComparison.OrdinalIgnoreCase) ||
            s == "1" || s == "-1")
            return true;
        if (int.TryParse(s, out var i))
            return i != 0;
        return false;
    }

    private async Task LoadDataAsync()
    {
        if (string.IsNullOrEmpty(mVendor))
        {
            ClearForm();
            return;
        }

        var sql = @"
            SELECT wp.walletid AS WalletPayeeID, v.*
            FROM tblVendors v
            JOIN divisions d ON v.divisionid = d.divisionid
            LEFT JOIN datasources ds ON d.bookofaccount = ds.bookofaccount
            LEFT JOIN wallet_payees wp ON wp.datasourceid = ds.datasourceid
                                      AND wp.payeeid = v.vendor_id
            WHERE v.Vendor_ID = @VendorId
              AND v.divisionid = @DivisionId";
        var parameters = new { VendorId = mVendor, DivisionId = DivisionID };
        var results = await db.QueryAsync(sql, parameters);
        if (!results.Any())
        {
            ClearForm();
            return;
        }
        var row = results.First();
        IsReadOnly = false;

        VendorId = row["Vendor_ID"]?.ToString() ?? "";
        Description = row["Vendor_Name"]?.ToString() ?? "";
        VendorDesc = $"{Description} ({VendorId})";
        Address = row["Addr1"]?.ToString() ?? "";
        City = row["city"]?.ToString() ?? "";
        Province = row["state"]?.ToString() ?? "";
        Postal = row["zip"]?.ToString() ?? "";
        Phone = row["phone"]?.ToString() ?? "";
        Fax = row["fax"]?.ToString() ?? "";
        IsTBD = row["isTBD"]?.ToString()?.Equals("true", StringComparison.OrdinalIgnoreCase) == true;
        BuildProEnabled = row["BuildProEnabled"]?.ToString()?.Equals("true", StringComparison.OrdinalIgnoreCase) == true;
        WebUID = row["WebUID"]?.ToString() ?? "";
        WebPWD = row["password"]?.ToString() ?? "";
        WalletPayeeID = row["WalletPayeeID"]?.ToString() ?? "";
        TaxID = row["TaxID"]?.ToString() ?? "";
        StatusIndex = row["Inactive"]?.ToString()?.Equals("True", StringComparison.OrdinalIgnoreCase) == true ? 1 : 0;
        TradeType = row["VendorGroupID"]?.ToString() ?? "";
        POFormat = row["POFormat"]?.ToString() ?? "";
        HoldbackPercent = Convert.ToDouble(row["HoldbackPercentage"] ?? 0);

        InsuranceData = new List<InsuranceRequirement>
        {
            new() { Name = "General Liability", Req = Convert.ToBoolean(row["glinsrequired"] ?? false),
                ExpiryDate = row["glinsexpdate"] as DateTime?,
                Company = row["GLInsCompany"]?.ToString(),
                PolicyNumber = row["GLInsPolicyNumber"]?.ToString() },
            new() { Name = "Workers Comp", Req = Convert.ToBoolean(row["wcinsrequired"] ?? false),
                ExpiryDate = row["wcinsexpdate"] as DateTime?,
                Company = row["WCInsCompany"]?.ToString(),
                PolicyNumber = row["WCInsPolicyNumber"]?.ToString() },
            new() { Name = "Umbrella", Req = Convert.ToBoolean(row["umbinsrequired"] ?? false),
                ExpiryDate = row["umbinsexpdate"] as DateTime?,
                Company = row["UmbInsCompany"]?.ToString(),
                PolicyNumber = row["UmbInsPolicyNumber"]?.ToString() },
            new() { Name = "Automobile", Req = Convert.ToBoolean(row["autoinsrequired"] ?? false),
                ExpiryDate = row["autoinsexpdate"] as DateTime?,
                Company = row["AutoInsCompany"]?.ToString(),
                PolicyNumber = row["AutoInsPolicyNumber"]?.ToString() }
        };

        TaxGroupsData.Clear();
        TaxGroupsData.Add(new TaxGroupRow
        {
            Community = "",
            CommunityDescription = " -- vendor defaults --",
            Labour = row["LabourTaxGroup"]?.ToString(),
            Material = row["MaterialTaxGroup"]?.ToString(),
            SubContract = row["SubContractTaxGroup"]?.ToString(),
            Equipment = row["EquipmentTaxGroup"]?.ToString(),
            Overhead = row["OverheadTaxGroup"]?.ToString(),
            Other = row["OtherTaxGroup"]?.ToString()
        });

        var taxSql = @"
            SELECT t.community, c.description,
                   t.MaterialTaxGroup, t.LabourTaxGroup,
                   t.SubContractTaxGroup, t.EquipmentTaxGroup,
                   t.OverheadTaxGroup, t.OtherTaxGroup
            FROM vendortaxgroups t
            JOIN tbllocality c ON t.Community = c.area
            WHERE t.vendor = @Vendor";
        var taxResults = await db.QueryAsync(taxSql, new { Vendor = mVendor });
        foreach (var taxRow in taxResults)
        {
            TaxGroupsData.Add(new TaxGroupRow
            {
                Community = taxRow["community"]?.ToString(),
                CommunityDescription = taxRow["description"]?.ToString(),
                Material = taxRow["MaterialTaxGroup"]?.ToString(),
                Labour = taxRow["LabourTaxGroup"]?.ToString(),
                SubContract = taxRow["SubContractTaxGroup"]?.ToString(),
                Equipment = taxRow["EquipmentTaxGroup"]?.ToString(),
                Overhead = taxRow["OverheadTaxGroup"]?.ToString(),
                Other = taxRow["OtherTaxGroup"]?.ToString()
            });
        }
        TaxGroupsData.Add(new TaxGroupRow());

        await LoadPayPointsAsync();
        await LoadContactsAsync();
        StateHasChanged();
    }

    private async Task LoadPayPointsAsync()
    {
        var sql = @"SELECT * FROM VendorPaymentPoints
                    WHERE DivisionID = @DivisionID AND Vendor = @Vendor
                    ORDER BY POIndex";
        var results = await db.QueryAsync(sql, new { DivisionID, Vendor = mVendor });
        PayPoints.Clear();
        foreach (var row in results)
        {
            PayPoints.Add(new VendorPayPoint
            {
                POIndex = row["POIndex"]?.ToString() ?? "",
                PayPoint1Percent = Convert.ToDouble(row["PayPoint1Percent"] ?? 0),
                PayPoint2Percent = Convert.ToDouble(row["PayPoint2Percent"] ?? 0),
                PayPoint3Percent = Convert.ToDouble(row["PayPoint3Percent"] ?? 0),
                PayPoint4Percent = Convert.ToDouble(row["PayPoint4Percent"] ?? 0),
                PayPoint5Percent = Convert.ToDouble(row["PayPoint5Percent"] ?? 0)
            });
        }
        PayPoints.Add(new VendorPayPoint());
    }

    private async Task LoadContactsAsync()
    {
        var sql = @"SELECT * FROM contacts
                    WHERE DivisionID = @DivisionID AND contacttypeid=99
                    AND vendorcode = @Vendor
                    ORDER BY firstname";
        var results = await db.QueryAsync(sql, new { DivisionID, Vendor = mVendor });
        Contacts.Clear();
        foreach (var row in results)
        {
            Contacts.Add(new VendorContact
            {
                ContactID = row["ContactID"]?.ToString() ?? "",
                Role = row["Role"]?.ToString() ?? "",
                Name = row["FirstName"]?.ToString() ?? "",
                Phone = row["WorkPhone"]?.ToString() ?? "",
                Cell = row["CellPhone"]?.ToString() ?? "",
                Fax = row["Fax"]?.ToString() ?? "",
                Email = row["Email"]?.ToString() ?? "",
                SendVia = Convert.ToInt32(row["CommModeID"] ?? 0),
                SmsAddress = row["SmsAddress"]?.ToString() ?? "",
                PONotice = ToBool(row["PONotice"]),
                FPONotice = ToBool(row["FPONotice"]),
                SchedNotice = ToBool(row["SchedNotice"]),
                ServiceNotice = ToBool(row["ServiceNotice"])
            });
        }
        Contacts.Add(new VendorContact());
    }

    private void ClearForm()
    {
        IsReadOnly = true;
        VendorId = "";
        Description = "";
        Address = "";
        City = "";
        Province = "";
        Postal = "";
        Phone = "";
        Fax = "";
        IsTBD = false;
        BuildProEnabled = true;
        WebUID = "";
        WebPWD = "";
        WalletPayeeID = "";
        TaxID = "";
        StatusIndex = 0;
        TradeType = "";
        POFormat = "";
        HoldbackPercent = 0;
        InsuranceData.Clear();
        TaxGroupsData.Clear();
        PayPoints.Clear();
        Contacts.Clear();
    }

    private async Task NextClick()
    {
        if (VendorIndex < vendors.Count - 1)
        {
            VendorIndex++;
            VendorId = vendors[VendorIndex];
            mVendor = VendorId;
            await LoadDataAsync();
        }
    }

    private async Task PreviousClick()
    {
        if (VendorIndex > 0)
        {
            VendorIndex--;
            VendorId = vendors[VendorIndex];
            mVendor = VendorId;
            await LoadDataAsync();
        }
    }

