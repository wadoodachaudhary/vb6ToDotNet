    private void OnPickListItemSelected(PhaseItemPickList item)
    {
        var tag = $"{item.Phase}\x01{item.Item}";
        var display = $"{item.Phase}/{item.Item} - {item.Description}";

        switch (PickListTargetIndex)
        {
            case 0: txtPhaseItem0 = display; tagPhaseItem0 = tag; break;
            case 1: txtPhaseItem1 = display; tagPhaseItem1 = tag; break;
            case 2: txtPhaseItem2 = display; tagPhaseItem2 = tag; break;
            case 3: txtPhaseItem3 = display; tagPhaseItem3 = tag; break;
            case 4: txtPhaseItem4 = display; tagPhaseItem4 = tag; break;
        }

        IsPickListVisible = false;
    }

