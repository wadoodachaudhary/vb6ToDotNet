@page "/mass-change-wizard"

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Components.Hf
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@layout HFComponent
<PageTitle>Mass Change Wizard - HomeFront</PageTitle>

<style>
    .wizard-container {
        font-family: 'MS Sans Serif', Arial, sans-serif;
        font-size: 13px;
        max-width: 900px;
        margin: 0 auto;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        display: flex;
        flex-direction: column;
        min-height: 700px;
    }

    .wizard-header {
        background: linear-gradient(to right, #003366, #336699);
        color: white;
        padding: 16px 24px;
        border-radius: 6px 6px 0 0;
    }
    .wizard-header h3 { margin: 0 0 4px 0; font-size: 18px; }
    .wizard-header p { margin: 0; font-size: 12px; opacity: 0.85; }

    .wizard-body {
        flex: 1;
        padding: 20px 24px;
        overflow-y: auto;
    }

    .wizard-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 12px 24px;
        border-top: 1px solid #dee2e6;
        background: #f8f9fa;
        border-radius: 0 0 6px 6px;
    }
    .wizard-footer button {
        padding: 6px 20px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 13px;
        min-width: 90px;
    }
    .wizard-footer button:hover:not(:disabled) { background: #e9ecef; }
    .wizard-footer button:disabled { opacity: 0.5; cursor: not-allowed; }
    .wizard-footer button.btn-primary { background: #0d6efd; color: #fff; border-color: #0d6efd; }
    .wizard-footer button.btn-primary:hover:not(:disabled) { background: #0b5ed7; }

    .step-title {
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .step-title .step-icon { font-size: 20px; }
    .step-description {
        font-size: 12px;
        color: #6c757d;
        margin-bottom: 16px;
        line-height: 1.5;
    }

    .form-row {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        gap: 8px;
    }
    .form-row label {
        min-width: 130px;
        text-align: right;
        font-size: 12px;
        color: #495057;
    }
    .form-row input, .form-row select {
        flex: 1;
        padding: 4px 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 13px;
    }
    .form-row input:focus, .form-row select:focus {
        border-color: #86b7fe;
        outline: 0;
        box-shadow: 0 0 0 2px rgba(13,110,253,0.15);
    }
    .form-row input[readonly] { background: #e9ecef; }

    .task-option {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 6px;
        padding: 6px 8px;
        border-radius: 4px;
        cursor: pointer;
    }
    .task-option:hover { background: #f0f0f0; }
    .task-option input[type="radio"] { margin-top: 3px; }
    .task-option label { font-weight: 700; font-size: 13px; cursor: pointer; }

    .task-fields {
        margin-left: 20px;
        padding: 8px 0;
    }

    .choose-btn {
        padding: 2px 8px;
        border: 1px solid #ced4da;
        border-radius: 3px;
        background: #fff;
        cursor: pointer;
        font-size: 12px;
    }
    .choose-btn:hover { background: #e9ecef; }
    .choose-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        font-size: 13px;
    }
    .checkbox-row input[type="checkbox"] { width: 16px; height: 16px; }

    .step-hint {
        font-size: 12px;
        color: #6c757d;
        margin-top: 8px;
    }

    .grid-container {
        margin-top: 12px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        overflow: hidden;
    }

    .loading-overlay {
        position: absolute;
        height: 100%;
        width: 100%;
        background-color: rgba(1,1,1,0.2);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .loading-spinner {
        padding: 20px 40px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        font-size: 16px;
        font-weight: 500;
        color: #333;
    }
</style>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Processing...</div>
    </div>
}

<div class="wizard-container">
    @* ── HEADER ──────────────────────────────────────────── *@
    <div class="wizard-header">
        <h3>Model/Option Mass Change</h3>
        <p>The mass change wizard will help you update your model/option library</p>
    </div>

    @* ── BODY ────────────────────────────────────────────── *@
    <div class="wizard-body">

        @* ── STEP 0: Choose Models and Options ──────────── *@
        @if (CurrentFrame == 0)
        {
            <div class="step-title">
                <span class="step-icon">✅</span>
                Choose models and options
            </div>
            <div class="step-description">
                Enter filter criteria below to select the models and options you want to change.
                Use the percent sign (%) as a wildcard. Leave a field blank to include all values.
                Click next to review the records you have selected.
            </div>

            <div class="form-row">
                <label>@CommunityLabel</label>
                <input type="text" @bind="txtCommunity" placeholder="%" />
            </div>
            <div class="form-row">
                <label>Model</label>
                <input type="text" @bind="txtModel" placeholder="%" />
            </div>
            <div class="form-row">
                <label>Option</label>
                <input type="text" @bind="txtOption" placeholder="%" />
            </div>
            <div class="form-row">
                <label>Assembly</label>
                <input type="text" @bind="txtAssembly" placeholder="%" />
            </div>
            <div class="form-row">
                <label>Description</label>
                <input type="text" @bind="txtDescription" placeholder="%" />
            </div>
            <div class="form-row">
                <label>Style</label>
                <input type="text" @bind="txtStyle" placeholder="%" />
            </div>
            <div class="form-row">
                <label>Series</label>
                <input type="text" @bind="txtSeries" placeholder="%" />
            </div>
            <div class="form-row">
                <label>Option Category</label>
                <input type="text" @bind="txtCategory" placeholder="%" />
            </div>
            <div class="form-row">
                <label>Assembly Type</label>
                <select @bind="cboAssemblyType">
                    <option value="">(All)</option>
                    <option value="Model">Model</option>
                    <option value="Model Specific Option">Model Specific Option</option>
                    <option value="Global Option">Global Option</option>
                    <option value="Design Center Option">Design Center Option</option>
                </select>
            </div>
            <div class="checkbox-row" style="margin-left: 138px;">
                <input type="checkbox" @bind="chkActiveOnly" id="chkActiveOnly" />
                <label for="chkActiveOnly">Active assemblies only</label>
            </div>

            <div class="step-hint">Click next to review the records you have selected</div>
        }

        @* ── STEP 1: Verify Selection ──────────────────── *@
        else if (CurrentFrame == 1)
        {
            <div class="step-title">
                <span class="step-icon">✅</span>
                Verify your selection
            </div>
            <div class="step-description">
                The following assemblies match your filter criteria. Right-click on a row to remove it from the list.
                Click next if the list is correct.
            </div>

            <div class="grid-container">
                <HfGrid @ref="AssembliesGrid"
                        TValue="AssemblyRow"
                        DataSource="@AssembliesData"
                        AllowSorting="true"
                        AllowResizing="true"
                        AllowSelection="true"
                        AllowFiltering="true"
                        EnableHover="true"
                        Height="400px"
                        FilterSettingsRef="@filterSettings"
                        PageSettingsRef="@pageSettings"
                        SelectionSettingsRef="@selectionSettings">
                    <HfGridColumnsBase>
                        <HfGridColumn Field="@nameof(AssemblyRow.Community)" HeaderText="@CommunityLabel" Width="120px" />
                        <HfGridColumn Field="@nameof(AssemblyRow.Model)" HeaderText="Model" Width="100px" />
                        <HfGridColumn Field="@nameof(AssemblyRow.OptionID)" HeaderText="Option" Width="100px" />
                        <HfGridColumn Field="@nameof(AssemblyRow.Assembly)" HeaderText="Assembly" Width="120px" />
                        <HfGridColumn Field="@nameof(AssemblyRow.AssemblyType)" HeaderText="Assembly Type" Width="150px" />
                        <HfGridColumn Field="@nameof(AssemblyRow.Description)" HeaderText="Assembly Desc" Width="200px" />
                        <HfGridColumn Field="@nameof(AssemblyRow.Style)" HeaderText="Style" Width="100px" />
                        <HfGridColumn Field="@nameof(AssemblyRow.Category)" HeaderText="Category" Width="100px" />
                        <HfGridColumn Field="@nameof(AssemblyRow.Active)" HeaderText="Active" Width="80px" />
                    </HfGridColumnsBase>
                </HfGrid>
            </div>

            <div style="margin-top: 8px; display: flex; gap: 8px;">
                <button class="choose-btn" @onclick="OnRemoveSelectedAssemblies">🗑 Remove Selected</button>
                <span style="font-size: 12px; color: #6c757d; padding-top: 4px;">
                    @AssembliesData.Count assembly(ies) selected
                </span>
            </div>
        }

        @* ── STEP 2: Choose Action ─────────────────────── *@
        else if (CurrentFrame == 2)
        {
            <div class="step-title">
                <span class="step-icon">✅</span>
                How would you like to change these models and options?
            </div>

            @* Add an item *@
            <div class="task-option">
                <input type="radio" id="optAdd" name="taskOption" checked="@(SelectedTask == 0)"
                       @onchange="() => OnTaskChanged(0)" />
                <label for="optAdd">Add an item</label>
            </div>
            @if (SelectedTask == 0)
            {
                <div class="task-fields">
                    <div class="form-row">
                        <label>Phase / Item</label>
                        <input type="text" readonly value="@txtPhaseItem0" style="flex:1;" />
                        <button class="choose-btn" @onclick="() => OnChooseItem(0)">🔍</button>
                    </div>
                    <div class="form-row">
                        <label>Takeoff Qty</label>
                        <input type="number" @bind="txtTakeoffQty" style="max-width: 120px;" />
                    </div>
                    <div class="checkbox-row" style="margin-left: 138px;">
                        <input type="checkbox" @bind="chkDefaultPOIndex" id="chkDefPO" />
                        <label for="chkDefPO">Use Default PO Index</label>
                    </div>
                    @if (!chkDefaultPOIndex)
                    {
                        <div class="form-row">
                            <label>PO Index</label>
                            <input type="text" readonly value="@txtPOIndex" style="flex:1;" />
                            <button class="choose-btn" @onclick="OnChoosePOIndex">🔍</button>
                        </div>
                    }
                </div>
            }

            @* Remove an item *@
            <div class="task-option">
                <input type="radio" id="optRemove" name="taskOption" checked="@(SelectedTask == 1)"
                       @onchange="() => OnTaskChanged(1)" />
                <label for="optRemove">Remove an item</label>
            </div>
            @if (SelectedTask == 1)
            {
                <div class="task-fields">
                    <div class="form-row">
                        <label>Phase / Item</label>
                        <input type="text" readonly value="@txtPhaseItem1" style="flex:1;" />
                        <button class="choose-btn" @onclick="() => OnChooseItem(1)">🔍</button>
                    </div>
                </div>
            }

            @* Substitute one item for another *@
            <div class="task-option">
                <input type="radio" id="optSubstitute" name="taskOption" checked="@(SelectedTask == 2)"
                       @onchange="() => OnTaskChanged(2)" />
                <label for="optSubstitute">Substitute one item for another</label>
            </div>
            @if (SelectedTask == 2)
            {
                <div class="task-fields">
                    <div class="form-row">
                        <label>Remove this</label>
                        <input type="text" readonly value="@txtPhaseItem2" style="flex:1;" />
                        <button class="choose-btn" @onclick="() => OnChooseItem(2)">🔍</button>
                    </div>
                    <div class="form-row">
                        <label>Replace with</label>
                        <input type="text" readonly value="@txtPhaseItem3" style="flex:1;" />
                        <button class="choose-btn" @onclick="() => OnChooseItem(3)">🔍</button>
                    </div>
                </div>
            }

            @* Edit quantities *@
            <div class="task-option">
                <input type="radio" id="optEdit" name="taskOption" checked="@(SelectedTask == 3)"
                       @onchange="() => OnTaskChanged(3)" />
                <label for="optEdit">Edit quantities</label>
            </div>
            @if (SelectedTask == 3)
            {
                <div class="task-fields">
                    <div class="form-row">
                        <label>Phase / Item</label>
                        <input type="text" readonly value="@txtPhaseItem4" style="flex:1;" />
                        <button class="choose-btn" @onclick="() => OnChooseItem(4)">🔍</button>
                    </div>
                    <span class="step-hint">(Optional: filter to a specific item)</span>
                </div>
            }
        }

        @* ── STEP 3: Edit Items (only for Edit Quantities task) ── *@
        else if (CurrentFrame == 3)
        {
            <div class="step-title">
                <span class="step-icon">✅</span>
                Edit item quantities
            </div>

            <div class="grid-container">
                <HfGrid @ref="ItemsGrid"
                        TValue="ItemDetailRow"
                        DataSource="@ItemsData"
                        AllowSorting="true"
                        AllowResizing="true"
                        AllowSelection="true"
                        AllowFiltering="true"
                        EnableHover="true"
                        Height="400px"
                        FilterSettingsRef="@filterSettings"
                        PageSettingsRef="@itemsPageSettings"
                        EditSettingsRef="@itemsEditSettings">
                    <HfGridColumnsBase>
                        <HfGridColumn Field="@nameof(ItemDetailRow.Community)" HeaderText="@CommunityLabel" Width="100px" AllowEditing="false" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.Model)" HeaderText="Model" Width="90px" AllowEditing="false" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.OptionID)" HeaderText="Option" Width="90px" AllowEditing="false" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.Assembly)" HeaderText="Assembly" Width="110px" AllowEditing="false" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.AssemblyType)" HeaderText="Assembly Type" Width="130px" AllowEditing="false" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.AssemblyDesc)" HeaderText="Assembly Desc" Width="150px" AllowEditing="false" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.Style)" HeaderText="Style" Width="80px" AllowEditing="false" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.Category)" HeaderText="Category" Width="80px" AllowEditing="false" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.Active)" HeaderText="Active" Width="70px" AllowEditing="false" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.Phase)" HeaderText="Phase" Width="80px" AllowEditing="false" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.Item)" HeaderText="Item" Width="80px" AllowEditing="false" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.ItemDesc)" HeaderText="Item Desc" Width="180px" AllowEditing="false" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.Quantity)" HeaderText="Quantity" Width="100px"
                                      Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" AllowEditing="true" />
                        <HfGridColumn Field="@nameof(ItemDetailRow.UOM)" HeaderText="UOM" Width="70px" AllowEditing="false" />
                    </HfGridColumnsBase>
                </HfGrid>
            </div>
        }
    </div>

    @* ── FOOTER ──────────────────────────────────────────── *@
    <div class="wizard-footer">
        <button @onclick="OnCancel">Cancel</button>
        <button disabled="@(CurrentFrame <= 0)" @onclick="OnBack">&lt; Back</button>
        <button disabled="@(!CanGoNext)" @onclick="OnNext">Next &gt;</button>
        <button class="btn-primary" disabled="@(!CanCommit)" @onclick="OnCommit">Commit</button>
    </div>
</div>

@* ── Pick List Dialog ────────────────────────────────────────── *@
@if (IsPickListVisible)
{
    <div style="position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,0.3); display:flex; align-items:center; justify-content:center;"
         @onclick="() => IsPickListVisible = false">
        <div style="background:#fff; border-radius:8px; box-shadow:0 12px 40px rgba(0,0,0,0.2); min-width:500px; max-width:700px; max-height:80vh; display:flex; flex-direction:column; overflow:hidden;"
             @onclick:stopPropagation="true">
            <div style="display:flex; align-items:center; justify-content:space-between; padding:14px 20px; font-weight:600; font-size:16px; border-bottom:1px solid #dee2e6;">
                <span>@PickListTitle</span>
                <button style="background:none; border:none; font-size:22px; cursor:pointer; color:#6c757d; padding:0 4px;"
                        @onclick="() => IsPickListVisible = false">×</button>
            </div>
            <div style="padding:12px 20px; overflow-y:auto; flex:1;">
                <input type="text" @bind="PickListFilter" @bind:event="oninput" placeholder="Filter..."
                       style="width:100%; padding:6px 10px; border:1px solid #ced4da; border-radius:4px; margin-bottom:10px;" />
                <div style="max-height:400px; overflow-y:auto;">
                    <table style="width:100%; border-collapse:collapse; font-size:13px;">
                        <thead>
                            <tr style="background:#f8f9fa; border-bottom:2px solid #dee2e6;">
                                <th style="padding:6px 8px; text-align:left;">Phase</th>
                                <th style="padding:6px 8px; text-align:left;">Item</th>
                                <th style="padding:6px 8px; text-align:left;">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pi in FilteredPickListItems)
                            {
                                <tr style="cursor:pointer; border-bottom:1px solid #eee;"
                                    @onclick="() => OnPickListItemSelected(pi)"
                                    @onmouseover="@(e => {})"
                                    class="@(pi == SelectedPickListItem ? "table-active" : "")">
                                    <td style="padding:4px 8px;">@pi.Phase</td>
                                    <td style="padding:4px 8px;">@pi.Item</td>
                                    <td style="padding:4px 8px;">@pi.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div style="display:flex; justify-content:flex-end; gap:8px; padding:12px 20px; border-top:1px solid #dee2e6; background:#f8f9fa;">
                <button style="padding:6px 20px; border:1px solid #ced4da; border-radius:4px; background:#fff; cursor:pointer;"
                        @onclick="() => IsPickListVisible = false">Cancel</button>
            </div>
        </div>
    </div>
}

@* ── PO Index Pick List Dialog ───────────────────────────────── *@
@if (IsPOIndexPickListVisible)
{
    <div style="position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,0.3); display:flex; align-items:center; justify-content:center;"
         @onclick="() => IsPOIndexPickListVisible = false">
        <div style="background:#fff; border-radius:8px; box-shadow:0 12px 40px rgba(0,0,0,0.2); min-width:400px; max-width:600px; max-height:80vh; display:flex; flex-direction:column; overflow:hidden;"
             @onclick:stopPropagation="true">
            <div style="display:flex; align-items:center; justify-content:space-between; padding:14px 20px; font-weight:600; font-size:16px; border-bottom:1px solid #dee2e6;">
                <span>Select PO Index</span>
                <button style="background:none; border:none; font-size:22px; cursor:pointer; color:#6c757d;"
                        @onclick="() => IsPOIndexPickListVisible = false">×</button>
            </div>
            <div style="padding:12px 20px; overflow-y:auto; flex:1; max-height:400px;">
                <table style="width:100%; border-collapse:collapse; font-size:13px;">
                    <thead>
                        <tr style="background:#f8f9fa; border-bottom:2px solid #dee2e6;">
                            <th style="padding:6px 8px; text-align:left;">PO Index</th>
                            <th style="padding:6px 8px; text-align:left;">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var po in POIndexItems)
                        {
                            <tr style="cursor:pointer; border-bottom:1px solid #eee;"
                                @onclick="() => OnPOIndexSelected(po)">
                                <td style="padding:4px 8px;">@po.POIndex</td>
                                <td style="padding:4px 8px;">@po.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    // === Database ===
    private DbWrapperSqlServer db = new();
    private int DivisionID = 1;
    private string LoginID = "admin";

    // === UI State ===
    private bool IsLoading = false;
    private int CurrentFrame = 0;
    private string CommunityLabel = "Community";

    // === Step 0: Filter Fields ===
    private string txtCommunity = "";
    private string txtModel = "";
    private string txtOption = "";
    private string txtAssembly = "";
    private string txtDescription = "";
    private string txtStyle = "";
    private string txtSeries = "";
    private string txtCategory = "";
    private string cboAssemblyType = "";
    private bool chkActiveOnly = true;

    // === Step 1: Assemblies Grid ===
    private HfGrid<AssemblyRow>? AssembliesGrid;
    private List<AssemblyRow> AssembliesData = new();
    private List<AssemblyRow> RemovedAssemblies = new();

    // === Step 2: Task Selection ===
    private int SelectedTask = 0;

    // Phase/Item selections (indexed 0-4)
    private string txtPhaseItem0 = "";
    private string tagPhaseItem0 = "";
    private string txtPhaseItem1 = "";
    private string tagPhaseItem1 = "";
    private string txtPhaseItem2 = "";
    private string tagPhaseItem2 = "";
    private string txtPhaseItem3 = "";
    private string tagPhaseItem3 = "";
    private string txtPhaseItem4 = "";
    private string tagPhaseItem4 = "";

    private double txtTakeoffQty = 0;
    private bool chkDefaultPOIndex = true;
    private string txtPOIndex = "";

    // === Step 3: Items Grid ===
    private HfGrid<ItemDetailRow>? ItemsGrid;
    private List<ItemDetailRow> ItemsData = new();

    // === Pick List State ===
    private bool IsPickListVisible = false;
    private string PickListTitle = "Select Item";
    private string PickListFilter = "";
    private List<PhaseItemPickList> PickListItems = new();
    private PhaseItemPickList? SelectedPickListItem;
    private int PickListTargetIndex = -1;

    private bool IsPOIndexPickListVisible = false;
    private List<POIndexPickListItem> POIndexItems = new();

    // === Grid Settings ===
    private HfFilterSettings filterSettings = new() { Type = FilterType.FilterBar };
    private HfPageSettings pageSettings = new() { PageSize = 50 };
    private HfPageSettings itemsPageSettings = new() { PageSize = 50 };
    private HfSelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Multiple,
        Mode = SelectionMode.Row,
        EnableToggle = true
    };
    private HfEditSettings itemsEditSettings = new()
    {
        AllowEditing = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };

    // === Computed Properties ===
    private bool CanGoNext
    {
        get
        {
            if (CurrentFrame == 2 && SelectedTask == 3) return true; // Edit quantities goes to step 3
            if (CurrentFrame == 2 && SelectedTask != 3) return false; // Other tasks commit from step 2
            if (CurrentFrame >= 3) return false;
            return true;
        }
    }

    private bool CanCommit
    {
        get
        {
            if (CurrentFrame == 2 && SelectedTask != 3) return true;
            if (CurrentFrame == 3 && SelectedTask == 3) return true;
            return false;
        }
    }

    private IEnumerable<PhaseItemPickList> FilteredPickListItems =>
        string.IsNullOrWhiteSpace(PickListFilter)
            ? PickListItems
            : PickListItems.Where(p =>
                (p.Phase?.Contains(PickListFilter, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Item?.Contains(PickListFilter, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Description?.Contains(PickListFilter, StringComparison.OrdinalIgnoreCase) ?? false));

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        await LoadCustomDescriptions();
    }

    private async Task LoadCustomDescriptions()
    {
        try
        {
            var label = await db.ExecuteScalarAsync<string>(
                "SELECT ISNULL(NULLIF(custom_description,''),'Community') FROM customdescriptions WHERE item='Community'");
            if (!string.IsNullOrEmpty(label)) CommunityLabel = label;
        }
        catch { /* use default */ }
    }

    // === Navigation ===
    private async Task OnCancel()
    {
        NavigationManager.NavigateTo("/edit-model-assembly");
    }

    private async Task OnBack()
    {
        if (CurrentFrame > 0)
        {
            CurrentFrame--;
            await OnFrameChanged();
        }
    }

    private async Task OnNext()
    {
        if (CurrentFrame == 2 && SelectedTask != 3) return;
        CurrentFrame++;
        await OnFrameChanged();
    }

    private async Task OnFrameChanged()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            switch (CurrentFrame)
            {
                case 0:
                    // Reset assemblies
                    AssembliesData.Clear();
                    RemovedAssemblies.Clear();
                    break;

                case 1:
                    // Load assemblies matching filter
                    await LoadAssembliesAsync();
                    break;

                case 2:
                    // Choose action - nothing to load
                    break;

                case 3:
                    // Load items for editing
                    await LoadItemsAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Step 1: Load Assemblies ===
    private async Task LoadAssembliesAsync()
    {
        var sql = @"
            SELECT Community, Model, OptionID, Assembly,
                   AssemblyTypeDesc AS [AssemblyType],
                   Description,
                   Style, Category,
                   CASE Inactive WHEN 1 THEN 'Inactive' ELSE 'Active' END AS Active
            FROM tbldbassemblymaster
            WHERE DivisionID = @DivisionID";

        sql += BuildAssemblyWhereClause("");
        sql += "\nORDER BY Community, Model, OptionID, Assembly, AssemblyTypeDesc, Description, Style";

        var dt = db.SqlExec(sql, new { DivisionID });
        AssembliesData = dt.AsEnumerable().Select(r => new AssemblyRow
        {
            Community = r["Community"]?.ToString() ?? "",
            Model = r["Model"]?.ToString() ?? "",
            OptionID = r["OptionID"]?.ToString() ?? "",
            Assembly = r["Assembly"]?.ToString() ?? "",
            AssemblyType = r["AssemblyType"]?.ToString() ?? "",
            Description = r["Description"]?.ToString() ?? "",
            Style = r["Style"]?.ToString() ?? "",
            Category = r["Category"]?.ToString() ?? "",
            Active = r["Active"]?.ToString() ?? "",
            IsHidden = false
        }).ToList();

        RemovedAssemblies.Clear();
    }

    // === Step 3: Load Items ===
    private async Task LoadItemsAsync()
    {
        var sql = @"
            SELECT m.Community, m.Model, m.OptionID, m.Assembly,
                   m.AssemblyTypeDesc AS [AssemblyType],
                   m.Description AS [AssemblyDesc],
                   m.Style, m.Category,
                   CASE Inactive WHEN 1 THEN 'Inactive' ELSE 'Active' END AS Active,
                   d.Phase, d.Item,
                   i.Description AS [ItemDesc],
                   d.TakeoffQty AS Quantity,
                   i.TakeoffUOM AS UOM
            FROM tbldbassemblymaster m
            JOIN tbldbassemblydetails d ON (m.DivisionID = d.DivisionID AND m.community=d.community AND m.assembly=d.assembly AND m.model=d.model AND m.optionid=d.optionid)
            JOIN tblphaseitem i ON (d.DivisionID = i.DivisionID AND d.phase=i.phase AND d.item=i.item)
            WHERE m.DivisionID = @DivisionID";

        if (!string.IsNullOrEmpty(tagPhaseItem4))
        {
            var parts = tagPhaseItem4.Split('\x01');
            if (parts.Length >= 2)
            {
                sql += $"\n   AND d.phase='{EscapeSql(parts[0])}'";
                sql += $"\n   AND d.item='{EscapeSql(parts[1])}'";
            }
        }

        sql += BuildAssemblyWhereClause("m");
        sql += "\nORDER BY m.Community, m.Model, m.OptionID, m.Assembly, m.Style, m.Category";

        var dt = db.SqlExec(sql, new { DivisionID });
        ItemsData = dt.AsEnumerable().Select(r => new ItemDetailRow
        {
            Community = r["Community"]?.ToString() ?? "",
            Model = r["Model"]?.ToString() ?? "",
            OptionID = r["OptionID"]?.ToString() ?? "",
            Assembly = r["Assembly"]?.ToString() ?? "",
            AssemblyType = r["AssemblyType"]?.ToString() ?? "",
            AssemblyDesc = r["AssemblyDesc"]?.ToString() ?? "",
            Style = r["Style"]?.ToString() ?? "",
            Category = r["Category"]?.ToString() ?? "",
            Active = r["Active"]?.ToString() ?? "",
            Phase = r["Phase"]?.ToString() ?? "",
            Item = r["Item"]?.ToString() ?? "",
            ItemDesc = r["ItemDesc"]?.ToString() ?? "",
            Quantity = r["Quantity"] != DBNull.Value ? Convert.ToDouble(r["Quantity"]) : 0,
            UOM = r["UOM"]?.ToString() ?? "",
            IsDirty = false
        }).ToList();
    }

    // === Build WHERE Clause ===
    private string BuildAssemblyWhereClause(string tableAlias)
    {
        var s = "";
        var prefix = string.IsNullOrEmpty(tableAlias) ? "" : tableAlias + ".";

        if (!string.IsNullOrEmpty(txtCommunity)) s += $"\n   AND {prefix}community LIKE '{EscapeSql(txtCommunity)}'";
        if (!string.IsNullOrEmpty(txtModel)) s += $"\n   AND {prefix}Model LIKE '{EscapeSql(txtModel)}'";
        if (!string.IsNullOrEmpty(txtOption)) s += $"\n   AND {prefix}OptionID LIKE '{EscapeSql(txtOption)}'";
        if (!string.IsNullOrEmpty(txtAssembly)) s += $"\n   AND {prefix}Assembly LIKE '{EscapeSql(txtAssembly)}'";
        if (!string.IsNullOrEmpty(txtDescription)) s += $"\n   AND {prefix}Description LIKE '{EscapeSql(txtDescription)}'";
        if (!string.IsNullOrEmpty(txtStyle)) s += $"\n   AND {prefix}Style LIKE '{EscapeSql(txtStyle)}'";
        if (!string.IsNullOrEmpty(txtSeries)) s += $"\n   AND {prefix}Series LIKE '{EscapeSql(txtSeries)}'";
        if (!string.IsNullOrEmpty(txtCategory)) s += $"\n   AND {prefix}Category LIKE '{EscapeSql(txtCategory)}'";
        if (!string.IsNullOrEmpty(cboAssemblyType)) s += $"\n   AND {prefix}AssemblyTypeDesc LIKE '{EscapeSql(cboAssemblyType)}'";
        if (chkActiveOnly) s += $"\n   AND ISNULL({prefix}inactive,0)=0";

        // Exclude removed assemblies
        foreach (var removed in RemovedAssemblies)
        {
            s += $"\n   AND NOT ({prefix}assembly='{EscapeSql(removed.Assembly)}'";
            s += $"\n        AND {prefix}model='{EscapeSql(removed.Model)}'";
            s += $"\n        AND {prefix}optionid='{EscapeSql(removed.OptionID)}'";
            s += $"\n        AND {prefix}community='{EscapeSql(removed.Community)}')";
        }

        return s;
    }

    // === Task Changed ===
    private void OnTaskChanged(int taskIndex)
    {
        SelectedTask = taskIndex;

        // Clear fields for non-selected tasks
        switch (taskIndex)
        {
            case 0:
                txtPhaseItem1 = ""; tagPhaseItem1 = "";
                txtPhaseItem2 = ""; tagPhaseItem2 = "";
                txtPhaseItem3 = ""; tagPhaseItem3 = "";
                txtPhaseItem4 = ""; tagPhaseItem4 = "";
                break;
            case 1:
                txtPhaseItem0 = ""; tagPhaseItem0 = "";
                txtTakeoffQty = 0;
                txtPhaseItem2 = ""; tagPhaseItem2 = "";
                txtPhaseItem3 = ""; tagPhaseItem3 = "";
                txtPhaseItem4 = ""; tagPhaseItem4 = "";
                break;
            case 2:
                txtPhaseItem0 = ""; tagPhaseItem0 = "";
                txtTakeoffQty = 0;
                txtPhaseItem1 = ""; tagPhaseItem1 = "";
                txtPhaseItem4 = ""; tagPhaseItem4 = "";
                break;
            case 3:
                txtPhaseItem0 = ""; tagPhaseItem0 = "";
                txtTakeoffQty = 0;
                txtPhaseItem1 = ""; tagPhaseItem1 = "";
                txtPhaseItem2 = ""; tagPhaseItem2 = "";
                txtPhaseItem3 = ""; tagPhaseItem3 = "";
                break;
        }
    }

