@page "/vendor-pricelist"

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Dynamic
@using System.Collections.Generic
@using System.Linq
@using System.Reflection
@using HomeFront.Components.Hf
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@layout HFComponent
<PageTitle>Vendor Item Prices</PageTitle>

<style>
    .toolbar-cntr {
        padding: 8px 12px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        margin-bottom: 10px;
        background-color: #f8f9fa;
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        align-items: center;
    }

    .tbar-btn {
        padding: 6px 12px;
        border: 1px solid #c9c9c9;
        background: #f7f7f7;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
    }

    .tbar-btn:hover {
        background: #e8e8e8;
    }

    .tbar-icon {
        width: 24px;
        height: 24px;
        margin-bottom: 4px;
    }

    .tool-label {
        width: 100%;
        display: block;
        text-align: center;
        font-size: 12px;
    }

    .toolbar-sep {
        width: 1px;
        height: 28px;
        background: #dee2e6;
        margin: 0 4px;
    }

    .vendor-prices-container {
        height: calc(100vh - 120px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .main-content {
        flex: 1;
        display: flex;
        overflow: hidden;
    }

    .tree-panel {
        width: 500px;
        min-width: 300px;
        border-right: 1px solid #dee2e6;
        overflow-y: auto;
        background: white;
        margin-right: 8px;
        padding: 4px;
    }

    .grid-panel {
        flex: 1;
        overflow: hidden;
    }

    .status-bar {
        height: 24px;
        background: #f0f0f0;
        border-top: 1px solid #ccc;
        padding: 3px 8px;
        font-size: 12px;
        color: #555;
    }

    /* Tree styling */
    .hf-tree ul {
        list-style: none;
        padding-left: 18px;
        margin: 0;
    }

    .hf-tree > ul {
        padding-left: 0;
    }

    .hf-tree li {
        padding: 2px 0;
    }

    .hf-tree .tree-node {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 14px;
        user-select: none;
    }

    .hf-tree .tree-node:hover {
        background-color: #e8f0fe;
    }

    .hf-tree .tree-node.selected {
        background-color: #cce5ff;
        font-weight: 600;
    }

    .hf-tree .tree-toggle {
        width: 16px;
        text-align: center;
        font-size: 10px;
        color: #666;
    }

    .view-select {
        padding: 4px 8px;
        border: 1px solid #c9c9c9;
        border-radius: 4px;
        font-size: 13px;
        background: #fff;
    }
</style>

<div class="vendor-prices-container">

    <!-- Toolbar -->
    <div class="toolbar-cntr">
        <button class="tbar-btn" @onclick="NewPricelist_Click">
            <img src="images/32/PricebookNew.ico" class="tbar-icon" />
            <span class="tool-label">New</span>
        </button>
        <button class="tbar-btn" @onclick="Save_Click">
            <img src="images/32/save.ico" class="tbar-icon" />
            <span class="tool-label">Save</span>
        </button>
        <div class="toolbar-sep"></div>

        <label style="font-size:13px; margin-right:4px;">View:</label>
        <select class="view-select" value="@CurrentViewIndex" @onchange="OnViewChanged">
            @for (var i = 0; i < Views.Count; i++)
            {
                <option value="@i">@Views[i].Name</option>
            }
        </select>

        <div class="toolbar-sep"></div>
        <button class="tbar-btn" @onclick="Preview_Click">
            <img src="images/32/ChangeView.ico" class="tbar-icon" />
            <span class="tool-label">Preview</span>
        </button>
        <button class="tbar-btn" @onclick="Export_Click">
            <img src="images/32/PricebookExport.ico" class="tbar-icon" />
            <span class="tool-label">Export</span>
        </button>
        <button class="tbar-btn" @onclick="Import_Click">
            <img src="images/32/PricebookImport.ico" class="tbar-icon" />
            <span class="tool-label">Import</span>
        </button>
        <button class="tbar-btn" @onclick="Forecasting_Click">
            <img src="images/32/Forecast.ico" class="tbar-icon" />
            <span class="tool-label">Forecasting</span>
        </button>
    </div>

    <!-- Main split layout -->
    <div class="main-content">

        <!-- Left: Tree Panel -->
        <div class="tree-panel">
            <HfTreeGrid @ref="gAssemblies"
                        TValue="PriceTreeNode"
                        DataSource="@TreeNodes"
                        IdMapping="NodeID"
                        ParentIdMapping="ParentID"
                        TreeColumnIndex="0"
                        EnableCollapseAll="true"
                        AllowSelection="true"
                        Height="100%"
                        RowSelected="OnTreeNodeSelected">
                <HfTreeGridColumn Field="NodeID" HeaderText="" Width="20px" Visible="false" />
                <HfTreeGridColumn Field="Node" HeaderText="Task Name" Width="420px" />
            </HfTreeGrid>
        </div>

        <!-- Right: Price Grid -->
        <div class="grid-panel">
            <HfGrid @ref="gItems"
                    TValue="VendorPriceViewModel"
                    DataSource="@PriceData"
                    AllowSorting="true"
                    AllowResizing="true"
                    AllowSelection="true"
                    Height="calc(100vh - 220px)">
                <HfGridColumnsBase @key="ItemsGridLayoutVersion" DebugTag="FPriceList-gItems">
                    @foreach (var entry in GetOrderedItemsGridLayout())
                    {
                        var layout = entry.Layout;
                        var fieldName = entry.Field;
                        var columnType = entry.ColumnType;
                        var textAlign = entry.TextAlign;
                        var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                        var width = layout.Width.HasValue && layout.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                            : null;

                        if (fieldName.Equals("PriceLink", StringComparison.OrdinalIgnoreCase))
                        {
                            <HfGridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="false">
                                <Template>
                                    @{ var data = (VendorPriceViewModel)context; }
                                    <span title="@data.PriceGroupDesc">@(!string.IsNullOrWhiteSpace(data.PriceGroupDesc) ? data.PriceGroupDesc : data.PriceLink.ToString())</span>
                                </Template>
                            </HfGridColumn>
                        }
                        else
                        {
                            <HfGridColumn Field="@fieldName"
                                          HeaderText="@headerText"
                                          Width="@width"
                                          Type="@columnType"
                                          TextAlign="@textAlign"
                                          AllowEditing="false" />
                        }
                    }
                </HfGridColumnsBase>
            </HfGrid>
        </div>
    </div>

    <!-- Status bar -->
    <div class="status-bar">
        @StatusMessage
    </div>
</div>

@code {
    private const string FormName = "FPriceList";
    private const string ItemsGridName = "gItems";
    private DbWrapperSqlServer db = new();
    private HfGrid<VendorPriceViewModel>? gItems;
    private HfTreeGrid<PriceTreeNode>? gAssemblies;
    private List<VendorPriceViewModel> PriceData = new();
    private List<PriceTreeNode> TreeNodes = new();
    private PriceTreeNode? SelectedNode;
    private int CurrentViewIndex = 0;
    private int Decimals = 2;
    private string StatusMessage = "Ready";
    private bool IsDirty;
    private int DivisionID = 1;
    private Dictionary<string, MMain.GridLayoutColumn> ItemsGridLayout = new(StringComparer.OrdinalIgnoreCase);
    private int ItemsGridLayoutVersion = 0;
    private bool HasItemsGridLayout => ItemsGridLayout.Count > 0;
    private string CommunityLabel => "Community";
    private string CommunityPhaseLabel => "Phase";
    private string CD_Community = "Community";
    private string DecimalFormat => $"N{Decimals}";

    private async Task OnTreeNodeSelected(TreeRowSelectEventArgs<PriceTreeNode> args)
    {
        SelectedNode = args.Data;
        if (SelectedNode != null)
            await LoadItemsAsync(SelectedNode);
    }

    private async Task OnViewChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx))
        {
            CurrentViewIndex = idx;
            await LoadItemsGridLayoutAsync();
            await LoadTreeAsync(true);
        }
    }

    // View definitions
    private List<ViewDefinition> Views = new();

    protected override async Task OnInitializedAsync()
    {
        InitializeViewDefinitions();
        await LoadSettings();
        await LoadItemsGridLayoutAsync();
        await LoadTreeAsync(true);
    }

    private void InitializeViewDefinitions()
    {
        Views = new List<ViewDefinition>
        {
            new ViewDefinition
            {
                Name = "Assembly",
                KeyFields = "CommunityDesc,CommunityPhase,Assembly,CostCode",
                DisplayFields = "Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc,CostCode + ' - ' + CostCodeDesc",
                SortFields = "Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc,CostCode + ' - ' + CostCodeDesc",
                FromWhere = "FROM VendorPrices v"
            },
            new ViewDefinition
            {
                Name = "Vendor",
                KeyFields = "Vendor,CommunityDesc,CommunityPhase,Assembly",
                DisplayFields = "VendorName,Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc",
                SortFields = "VendorName,Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc",
                FromWhere = "FROM VendorPrices v"
            },
            new ViewDefinition
            {
                Name = "Purchase Order",
                KeyFields = "POIndex,CommunityDesc,CommunityPhase,Assembly",
                DisplayFields = "POIndex + ' ' + case when poindex=POIndexDescription then '' else POIndexDescription end,Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc",
                SortFields = "POIndex + ' ' + case when poindex=POIndexDescription then '' else POIndexDescription end,Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc",
                FromWhere = "FROM VendorPrices v"
            },
            new ViewDefinition
            {
                Name = "Cost Code",
                KeyFields = "CostCode,CommunityDesc,CommunityPhase,Assembly",
                DisplayFields = "CostCode + ' - ' + CostCodeDesc,Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc",
                SortFields = "CostCode + ' - ' + CostCodeDesc,Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc",
                FromWhere = "FROM VendorPrices v"
            }
        };
    }

    private async Task LoadSettings()
    {
        CurrentViewIndex = 0;
        Decimals = 2;
    }

    private async Task LoadTreeAsync(bool clear = true)
    {
        try
        {
            if (clear)
                SelectedNode = null;

            var view = Views[CurrentViewIndex];
            var keyFields = ParseViewList(view.KeyFields);
            var displayFields = ParseViewList(view.DisplayFields);
            var sortFields = ParseViewList(view.SortFields);
            if (keyFields.Count == 0 || displayFields.Count == 0)
            {
                TreeNodes = new List<PriceTreeNode>();
                return;
            }

            var nodes = new List<PriceTreeNode>();
            var nodeId = 1;

            async Task BuildLevel(int level, int? parentId, string? whereClause)
            {
                if (level >= keyFields.Count)
                    return;

                var keyField = keyFields[level];
                var displayField = displayFields[Math.Min(level, displayFields.Count - 1)];
                var sortField = sortFields.ElementAtOrDefault(level);
                var rows = await QueryTreeLevel(view, keyField, displayField, sortField, whereClause);
                foreach (var row in rows)
                {
                    if (string.IsNullOrWhiteSpace(row.KeyValue))
                        continue;
                    var display = NormalizeDisplayValue(row.DisplayValue);
                    var safeKey = SqlSafe(row.KeyValue);
                    var nextWhere = string.IsNullOrWhiteSpace(whereClause)
                        ? $"{keyField} = '{safeKey}'"
                        : $"{whereClause} AND {keyField} = '{safeKey}'";

                    var node = new PriceTreeNode
                    {
                        NodeID = nodeId++,
                        ParentID = parentId,
                        Node = display,
                        KeyField = keyField,
                        KeyValue = row.KeyValue,
                        WhereClause = nextWhere
                    };
                    nodes.Add(node);

                    await BuildLevel(level + 1, node.NodeID, nextWhere);
                }
            }

            await BuildLevel(0, null, null);
            TreeNodes = nodes;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadTreeAsync error: {ex.Message}");
            TreeNodes = new List<PriceTreeNode>();
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task LoadItemsAsync(PriceTreeNode currentSelectedNode)
    {
        StatusMessage = "Loading vendor prices...";
        StateHasChanged();
        try
        {
            PriceData.Clear();

            var sql = @"
            SELECT v.*, g.PriceGroupDesc
            FROM VendorPrices v
            LEFT OUTER JOIN PriceGroups g
                ON v.PriceLink = g.PriceGroup
               AND g.DivisionID = @DivisionID";

            var whereClause = currentSelectedNode?.WhereClause;

            if (!string.IsNullOrWhiteSpace(whereClause))
            {
                var cleanWhere = whereClause.Trim().StartsWith("AND ")
                    ? whereClause.Trim().Substring(4).Trim()
                    : whereClause.Trim();
                sql += $@"
                WHERE ISNULL(Vendor, '') <> ''
                  AND {cleanWhere}
                  AND v.DivisionID IN (0, @DivisionID)";
            }
            else
            {
                sql += @"
                WHERE v.DivisionID IN (0, @DivisionID)";
            }

            var orderBy = Views.Count > CurrentViewIndex ? Views[CurrentViewIndex].DisplayFields : "";
            if (!string.IsNullOrWhiteSpace(orderBy))
                sql += $@"
                ORDER BY {orderBy}";

            var parameters = new { DivisionID };
            var result = await db.QueryAsync(sql, parameters);

            foreach (var row in result)
            {
                var item = new VendorPriceViewModel
                {
                    PriceLink = Convert.ToInt64(row["PriceLink"] ?? 0),
                    PriceGroupDesc = row["PriceGroupDesc"]?.ToString() ?? "",
                    ItemType = row["ItemType"]?.ToString(),
                    PriceLevel = (row["PriceLevel"]?.ToString() ?? "")
                        .Replace("Community", CommunityLabel),
                    Vendor = row["Vendor"]?.ToString(),
                    VendorName = row["VendorName"]?.ToString(),
                    Community = row["Community"]?.ToString(),
                    CommunityPhase = row["CommunityPhase"]?.ToString(),
                    CommunityDesc = row["CommunityDesc"]?.ToString(),
                    TaxGroup = row["TaxGroup"]?.ToString(),
                    SKU = row["PartNumber"]?.ToString(),
                    Item = row["Item"]?.ToString(),
                    ItemNumber = row["ItemNumber"]?.ToString(),
                    OrderUOM = row["OrderUOM"]?.ToString(),
                    Phase = row["Phase"]?.ToString(),
                    POIndex = row["POIndex"]?.ToString(),
                    POIndexDescription = row["POIndexDescription"]?.ToString(),
                    CostCode = row["CostCode"]?.ToString(),
                    CostCodeDesc = row["CostCodeDesc"]?.ToString(),
                    ItemDesc = row["ItemDesc"]?.ToString(),
                    Assembly = row["Assembly"]?.ToString(),
                    Model = row["Model"]?.ToString(),
                    AssemblyDesc = row["AssemblyDesc"]?.ToString(),
                    Last3 = Convert.ToDecimal(row["Last3"] ?? 0m),
                    Expiry3 = row["Expiry3"] as DateTime?,
                    Last2 = Convert.ToDecimal(row["Last2"] ?? 0m),
                    Expiry2 = row["Expiry2"] as DateTime?,
                    Last1 = Convert.ToDecimal(row["Last1"] ?? 0m),
                    Expiry1 = row["Expiry1"] as DateTime?,
                    Current = Convert.ToDecimal(row["CurrentCost"] ?? 0m),
                    Next1 = Convert.ToDecimal(row["Next1"] ?? 0m),
                    Effective1 = row["Effective1"] as DateTime?,
                    Next2 = Convert.ToDecimal(row["Next2"] ?? 0m),
                    Effective2 = row["Effective2"] as DateTime?,
                    Forecast1 = Convert.ToDecimal(row["Forecast1"] ?? 0m),
                    Forecast2 = Convert.ToDecimal(row["Forecast2"] ?? 0m),
                    Forecast3 = Convert.ToDecimal(row["Forecast3"] ?? 0m),
                    Forecast4 = Convert.ToDecimal(row["Forecast4"] ?? 0m),
                    Forecast5 = Convert.ToDecimal(row["Forecast5"] ?? 0m),
                    Forecast6 = Convert.ToDecimal(row["Forecast6"] ?? 0m),
                    Forecast7 = Convert.ToDecimal(row["Forecast7"] ?? 0m),
                    Forecast8 = Convert.ToDecimal(row["Forecast8"] ?? 0m),
                    Forecast9 = Convert.ToDecimal(row["Forecast9"] ?? 0m),
                    Forecast10 = Convert.ToDecimal(row["Forecast10"] ?? 0m),
                    Forecast11 = Convert.ToDecimal(row["Forecast11"] ?? 0m),
                    Forecast12 = Convert.ToDecimal(row["Forecast12"] ?? 0m),
                    HasLinkedPriceGroup = Convert.ToInt64(row["PriceLink"] ?? 0) != 0
                };
                PriceData.Add(item);
            }

            StatusMessage = $"Loaded {PriceData.Count} price records";
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error loading prices: {ex.Message}";
        }
        finally
        {
            StateHasChanged();
        }
    }

    // Toolbar actions
    private async Task NewPricelist_Click() { }
    private async Task Save_Click() { }
    private async Task Preview_Click() { }
    private async Task Export_Click() { }
    private async Task Import_Click() { }
    private async Task Forecasting_Click() { }

    // Models
    public class ViewDefinition
    {
        public string Name { get; set; } = "";
        public string KeyFields { get; set; } = "";
        public string DisplayFields { get; set; } = "";
        public string SortFields { get; set; } = "";
        public string FromWhere { get; set; } = "";
    }

    public class PriceTreeNode
    {
        public int? NodeID { get; set; }
        public int? ParentID { get; set; }
        public string Node { get; set; } = string.Empty;
        public string KeyField { get; set; } = string.Empty;
        public string KeyValue { get; set; } = string.Empty;
        public string? WhereClause { get; set; }
    }

    public class VendorPriceViewModel
    {
        public bool HasLinkedPriceGroup { get; set; }
        public string? ItemType { get; set; }
        public string? PriceLevel { get; set; }
        public string? TaxGroup { get; set; }
        public string? Item { get; set; }
        public string? ItemNumber { get; set; }
        public string? OrderUOM { get; set; }
        public string? Phase { get; set; }
        public string? POIndex { get; set; }
        public string? POIndexDescription { get; set; }
        public string? CostCode { get; set; }
        public string? CostCodeDesc { get; set; }
        public string? Model { get; set; }
        public string? AssemblyDesc { get; set; }
        public decimal Next2 { get; set; }
        public DateTime? Effective2 { get; set; }
        public long PriceLink { get; set; }
        public string PriceGroupDesc { get; set; } = string.Empty;
        public string? Vendor { get; set; }
        public string? VendorName { get; set; }
        public string? Community { get; set; }
        public string? CommunityPhase { get; set; }
        public string? CommunityDesc { get; set; }
        public string? Assembly { get; set; }
        public string? ItemDesc { get; set; }
        public string? SKU { get; set; }
        public decimal? Last3 { get; set; }
        public DateTime? Expiry3 { get; set; }
        public decimal? Last2 { get; set; }
        public DateTime? Expiry2 { get; set; }
        public decimal? Last1 { get; set; }
        public DateTime? Expiry1 { get; set; }
        public decimal? Current { get; set; }
        public decimal? Next1 { get; set; }
        public DateTime? Effective1 { get; set; }
        public decimal? Forecast1 { get; set; }
        public decimal? Forecast2 { get; set; }
        public decimal? Forecast3 { get; set; }
        public decimal? Forecast4 { get; set; }
        public decimal? Forecast5 { get; set; }
        public decimal? Forecast6 { get; set; }
        public decimal? Forecast7 { get; set; }
        public decimal? Forecast8 { get; set; }
        public decimal? Forecast9 { get; set; }
        public decimal? Forecast10 { get; set; }
        public decimal? Forecast11 { get; set; }
        public decimal? Forecast12 { get; set; }
    }

    private sealed class TreeQueryRow
    {
        public string KeyValue { get; set; } = "";
        public string DisplayValue { get; set; } = "";
    }

    private static string SqlSafe(string? value)
    {
        return (value ?? "").Replace("'", "''");
    }

    private static List<string> ParseViewList(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return new List<string>();
        return raw.Split(',')
            .Select(s => s.Trim())
            .Where(s => s.Length > 0)
            .ToList();
    }

    private string NormalizeDisplayValue(string? value)
    {
        var display = (value ?? "").Trim();
        if (display.Equals("- global -", StringComparison.OrdinalIgnoreCase))
            display = $"Global (any {CD_Community})";
        if (display.Equals("- corporate -", StringComparison.OrdinalIgnoreCase))
            display = "Corporate (any Division)";
        return display;
    }

    private async Task<List<TreeQueryRow>> QueryTreeLevel(ViewDefinition view, string keyField, string displayField, string? sortField, string? whereClause = null)
    {
        var sort = string.IsNullOrWhiteSpace(sortField) ? displayField : sortField;
        var sql = new System.Text.StringBuilder();
        sql.Append("SELECT DISTINCT ").Append(keyField).Append(" AS KeyValue, ").Append(displayField).Append(" AS DisplayValue");
        if (!string.Equals(sort, keyField, StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(sort, displayField, StringComparison.OrdinalIgnoreCase))
        {
            sql.Append(", ").Append(sort).Append(" AS SortValue");
        }
        sql.AppendLine();
        sql.Append(view.FromWhere);
        sql.Append(" WHERE v.DivisionID IN (0, ").Append(DivisionID).Append(")");
        if (!string.IsNullOrWhiteSpace(whereClause))
            sql.Append(" AND ").Append(whereClause);
        sql.Append(" ORDER BY ").Append(sort);

        var rows = await db.QueryAsync(sql.ToString());
        return rows.Select(r => new TreeQueryRow
        {
            KeyValue = r["KeyValue"]?.ToString() ?? "",
            DisplayValue = r["DisplayValue"]?.ToString() ?? r["KeyValue"]?.ToString() ?? ""
        }).ToList();
    }

    private async Task LoadItemsGridLayoutAsync()
    {
        ItemsGridLayout = await MMain.IniGetGridAsync(FormName, $"{ItemsGridName}.{CurrentViewIndex}", 0, grouped: false);
        if (ItemsGridLayout.Count == 0)
            ItemsGridLayout = await MMain.IniGetGridAsync(FormName, ItemsGridName, CurrentViewIndex, grouped: false);
        if (ItemsGridLayout.Count == 0)
            ItemsGridLayout = await MMain.IniGetGridAsync(FormName, ItemsGridName, 0, grouped: false);

        ItemsGridLayoutVersion++;
    }

    private IEnumerable<(MMain.GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedItemsGridLayout()
    {
        if (!HasItemsGridLayout)
            yield break;

        var ordered = ItemsGridLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field))
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = ResolveItemsGridField(layout.Field);
            var columnType = GetColumnTypeForField(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    private static readonly Dictionary<string, PropertyInfo> _priceRowPropMap =
        typeof(VendorPriceViewModel)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .GroupBy(p => NormalizeGridKey(p.Name))
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    private static readonly Dictionary<string, string> _priceFieldAliases = new(StringComparer.OrdinalIgnoreCase)
    {
        ["currentcost"] = nameof(VendorPriceViewModel.Current),
        ["partnumber"] = nameof(VendorPriceViewModel.SKU),
        ["description"] = nameof(VendorPriceViewModel.ItemDesc),
        ["pricegroup"] = nameof(VendorPriceViewModel.PriceLink)
    };

    private static string NormalizeGridKey(string key)
    {
        if (string.IsNullOrWhiteSpace(key))
            return "";
        var chars = key.Where(char.IsLetterOrDigit).ToArray();
        return new string(chars).ToLowerInvariant();
    }

    private static string ResolveItemsGridField(string layoutField)
    {
        if (string.IsNullOrWhiteSpace(layoutField))
            return "";

        var trimmed = layoutField.Trim();
        var exact = typeof(VendorPriceViewModel).GetProperty(trimmed, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
        if (exact != null)
            return exact.Name;

        var normalized = NormalizeGridKey(trimmed);
        if (_priceRowPropMap.TryGetValue(normalized, out var prop))
            return prop.Name;

        if (_priceFieldAliases.TryGetValue(normalized, out var alias))
        {
            var aliasedProp = typeof(VendorPriceViewModel).GetProperty(alias, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            return aliasedProp?.Name ?? alias;
        }

        return trimmed;
    }

    private static ColumnType GetColumnTypeForField(string field)
    {
        if (string.IsNullOrWhiteSpace(field))
            return ColumnType.Text;

        if (_priceRowPropMap.TryGetValue(NormalizeGridKey(field), out var prop))
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool))
                return ColumnType.CheckBox;
            if (type == typeof(DateTime))
                return ColumnType.Date;
            if (type == typeof(byte) || type == typeof(short) || type == typeof(int) || type == typeof(long) ||
                type == typeof(float) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
        }

        return ColumnType.Text;
    }

    private static int ConvertLayoutWidthToPx(double layoutWidth)
    {
        if (layoutWidth <= 0)
            return 0;

        var px = (int)Math.Round(layoutWidth / 15.0);
        px += 16;
        if (px < 32) px = 32;
        if (px > 2000) px = 2000;
        return px;
    }
}
