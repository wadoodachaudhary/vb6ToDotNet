@namespace HomeFront.Components.Pages

@using HomeFront.Components.Hf
@using HomeFront.Data
@using System.Dynamic
@using System.Collections.Generic
@using System.Globalization
@layout HFComponent
@inject IJSRuntime JSRuntime

<style>
    /* ── Modal Overlay ──────────────────────────────────────── */
    .picklist-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(0,0,0,0.35);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .picklist-dialog {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.25);
        width: 750px;
        max-width: 90vw;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        font-family: 'MS Sans Serif', Arial, sans-serif;
        font-size: 13px;
    }

    /* ── Header ─────────────────────────────────────────────── */
    .picklist-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
        font-weight: 600;
        font-size: 15px;
        border-bottom: 1px solid #dee2e6;
        background: #f8f9fa;
    }

    .picklist-header button {
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
        color: #6c757d;
        padding: 0 4px;
    }

    .picklist-header button:hover { color: #212529; }

    /* ── Hints ──────────────────────────────────────────────── */
    .picklist-hints {
        padding: 6px 16px;
        font-size: 11px;
        color: #6c757d;
        border-bottom: 1px solid #eee;
    }

    /* ── Views Bar ─────────────────────────────────────────── */
    .picklist-views-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 16px;
        border-bottom: 1px solid #dee2e6;
        background: #fafbfc;
    }

    .picklist-views-bar label {
        font-weight: 600;
        font-size: 12px;
    }

    .picklist-views-bar select {
        flex: 1;
        padding: 3px 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 12px;
    }

    /* ── Grid Area ─────────────────────────────────────────── */
    .picklist-grid-area {
        flex: 1;
        overflow: auto;
        padding: 8px 16px;
        min-height: 300px;
    }

    /* ── Footer ─────────────────────────────────────────────── */
    .picklist-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 16px;
        border-top: 1px solid #dee2e6;
        background: #f8f9fa;
    }

    .picklist-footer-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .picklist-footer-left label {
        font-size: 11px;
        color: #6c757d;
        cursor: pointer;
    }

    .picklist-footer-right {
        display: flex;
        gap: 8px;
    }

    .picklist-btn {
        padding: 5px 18px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 13px;
    }

    .picklist-btn:hover { background: #e9ecef; }

    .picklist-btn-primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }

    .picklist-btn-primary:hover { background: #0b5ed7; }
    .picklist-btn:disabled { opacity: 0.5; cursor: default; }

    /* ── Debug SQL ─────────────────────────────────────────── */
    .picklist-debug {
        margin: 8px 16px 0;
        border: 1px solid #ddd;
        padding: 8px;
        background: #f8f9fa;
        border-radius: 4px;
    }

    .picklist-debug pre {
        white-space: pre-wrap;
        font-size: 11px;
        margin: 4px 0 0;
        background: #fff;
        padding: 6px;
        border: 1px solid #ccc;
    }
</style>

@if (_isVisible)
{
    <div class="picklist-overlay" @onclick="OnCancelClick">
        <div class="picklist-dialog" style="@($"width:{_dialogWidthPx}px;")" @onclick:stopPropagation="true"
             @onkeydown="HandleKeyDown" tabindex="0">

            @* ── Header ──────────────────────────────────────── *@
            <div class="picklist-header">
                <span>@_dialogCaption</span>
                <button @onclick="OnCancelClick">×</button>
            </div>

            @* ── Hints ───────────────────────────────────────── *@
            <div class="picklist-hints">
                Type directly into the filter row to search. Click a column heading to sort.
            </div>

            @* ── Views Bar (only if multiple views) ──────────── *@
            @if (_viewItems.Count > 1)
            {
                <div class="picklist-views-bar">
                    <label>View:</label>
                    <select @bind="_selectedViewIndex" @bind:after="OnViewChanged">
                        @for (int i = 0; i < _viewItems.Count; i++)
                        {
                            <option value="@i">@_viewItems[i].Name</option>
                        }
                    </select>
                </div>
            }

            @* ── Grid ────────────────────────────────────────── *@
            <div class="picklist-grid-area">
                <HfGrid @ref="_grid"
                        TValue="ExpandoObject"
                        DataSource="@_gridData"
                        AllowSorting="true"
                        AllowResizing="true"
                        AllowFiltering="true"
                        AllowSelection="true"
                        Height="380"
                        Width="100%"
                        SelectionSettingsRef="@_selectionSettings"
                        FilterSettingsRef="@_filterSettings"
                        EventsRef="@_gridEvents">
                    <HfGridColumnsBase>
                        @foreach (var col in _columnsConfig)
                        {
                            <HfGridColumn Field="@col.Field"
                                          HeaderText="@col.Header"
                                          Width="@($"{col.Width}px")"
                                          AllowSorting="true"
                                          AllowFiltering="true"
                                          Visible="@col.Visible" />
                        }
                    </HfGridColumnsBase>
                </HfGrid>
            </div>

            @* ── Debug SQL ───────────────────────────────────── *@
            @if (_showDebugSql)
            {
                <div class="picklist-debug">
                    <strong>SQL:</strong>
                    <pre>@_currentSql</pre>
                </div>
            }

            @* ── Footer ──────────────────────────────────────── *@
            <div class="picklist-footer">
                <div class="picklist-footer-left">
                    <label>
                        <input type="checkbox" @bind="_fastLoading" /> Memory optimization
                    </label>
                    @if (_gridData.Count > 0)
                    {
                        <span style="font-size:11px; color:#999;">@_gridData.Count rows</span>
                    }
                </div>
                <div class="picklist-footer-right">
                    @if (_showNewButton)
                    {
                        <button class="picklist-btn" @onclick="OnNewClick">New</button>
                    }
                    <button class="picklist-btn picklist-btn-primary" @onclick="OnOkClick">Open</button>
                    <button class="picklist-btn" @onclick="OnCancelClick">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ═══════════════════════════════════════════════════════════════════
    // ── Parameters ────────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    /// <summary>Fires when user clicks Open/OK or double-clicks a row. Returns selected rows.</summary>
    [Parameter] public EventCallback<List<IDictionary<string, object>>> OnSelected { get; set; }

    /// <summary>Fires when user clicks Cancel or presses Escape.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    // ═══════════════════════════════════════════════════════════════════
    // ── Internal State ────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    private bool _isVisible = false;
    private string _dialogCaption = "Select List";
    private string _currentSql = "";
    private bool _showDebugSql = false;
    private bool _fastLoading = true;
    private bool _showNewButton = false;
    private bool _multiSelect = false;
    private string _hideColumns = "";
    private string _defaultItem = "";
    private string _filterValues = "";
    private int _selectedViewIndex = 0;
    private bool _sortAsc = true;
    private int _dialogWidthPx = 750;

    // Parsed views from the Queries parameter
    // VB6 format: "ViewName1" & Chr(1) & "SQL1" & Chr(0) & "ViewName2" & Chr(1) & "SQL2"
    // Simplified Blazor format: "ViewName;SQL|ViewName2;SQL2" or just "SQL" (single view)
    private List<ViewItem> _viewItems = new();

    // Grid
    private HfGrid<ExpandoObject>? _grid;
    private List<ExpandoObject> _gridData = new();
    private List<ColumnConfig> _columnsConfig = new();

    private HfSelectionSettings _selectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single,
        EnableToggle = true
    };

    private HfFilterSettings _filterSettings = new()
    {
        Type = FilterType.FilterBar
    };

    private HfGridEvents<ExpandoObject> _gridEvents = new();

    // Database
    private DbWrapperSqlServer _db = new();

    // Models
    private class ViewItem
    {
        public string Name { get; set; } = "";
        public string Sql { get; set; } = "";
    }

    private class ColumnConfig
    {
        public string Field { get; set; } = "";
        public string Header { get; set; } = "";
        public int Width { get; set; } = 130;
        public bool Visible { get; set; } = true;
    }

    public int SelectedViewIndex => _selectedViewIndex;

    // ═══════════════════════════════════════════════════════════════════
    // ── Public API — replaces VB6 FPickList.Choose() ─────────────────
    // ═══════════════════════════════════════════════════════════════════

    /// <summary>
    /// Opens the pick list dialog. Equivalent to VB6 FPickList.Choose().
    ///
    /// VB6 signature: Choose(Connection, ItemTitle, Queries, DefaultItem, SortAsc,
    ///   ShowNew, ItemIcon, HideColumns, MultiSelect, DefaultView, FilterValues, StoredProc)
    ///
    /// Queries format:
    ///   Single view: "SELECT name, formula FROM itemcharts"
    ///   Multi-view:  "All Items;SELECT * FROM items|Active;SELECT * FROM items WHERE active=1"
    /// </summary>
    public async Task Open(
        string title,
        string queries,
        string? hideColumns = null,
        bool multiSelect = false,
        string? defaultItem = null,
        bool sortAsc = true,
        bool showNew = false,
        string? filterValues = null,
        int defaultView = 0,
        string? dialogCaption = null)
    {
        // Set caption (VB6: Me.Caption = App.ProductName & " - " & ItemTitle & " List")
        var article = "aeiou".Contains(char.ToLower(title.FirstOrDefault())) ? "an" : "a";
        _dialogCaption = dialogCaption ?? $"Choose {article} {title}";

        _hideColumns = hideColumns ?? "";
        _multiSelect = multiSelect;
        _defaultItem = defaultItem ?? "";
        _showNewButton = showNew;
        _filterValues = filterValues ?? "";
        _sortAsc = sortAsc;

        // Parse views
        // VB6 uses Chr(0) to separate views and Chr(1) to separate name from SQL
        // Blazor simplified: "|" separates views, ";" separates name from SQL
        // If no delimiter, treat as single unnamed view
        _viewItems.Clear();
        if (queries.Contains('|'))
        {
            var parts = queries.Split('|', StringSplitOptions.RemoveEmptyEntries);
            foreach (var part in parts)
            {
                var semi = part.IndexOf(';');
                if (semi > 0)
                {
                    _viewItems.Add(new ViewItem
                    {
                        Name = part[..semi].Trim(),
                        Sql = part[(semi + 1)..].Trim()
                    });
                }
                else
                {
                    _viewItems.Add(new ViewItem { Name = $"View {_viewItems.Count + 1}", Sql = part.Trim() });
                }
            }
        }
        else
        {
            _viewItems.Add(new ViewItem { Name = title, Sql = queries.Trim() });
        }

        _selectedViewIndex = Math.Max(0, Math.Min(_viewItems.Count - 1, defaultView));
        _showDebugSql = false;

        // Load data BEFORE showing the dialog so the grid renders with data
        _gridData = new List<ExpandoObject>();
        _columnsConfig = new List<ColumnConfig>();
        await LoadDataForCurrentView();

        // Selection mode — set after data load so the grid initializes with correct settings
        _selectionSettings = new HfSelectionSettings
        {
            Mode = SelectionMode.Row,
            Type = multiSelect ? SelectionType.Multiple : SelectionType.Single,
            EnableToggle = true
        };

        // Wire double-click = OK
        _gridEvents = new HfGridEvents<ExpandoObject>();
        _gridEvents.OnRecordDoubleClick = EventCallback.Factory.Create<CellClickEventArgs<ExpandoObject>>(
            this, OnRecordDoubleClick);

        _isVisible = true;
        StateHasChanged();
    }

    /// <summary>Closes the dialog without selection.</summary>
    public void Close()
    {
        _isVisible = false;
        StateHasChanged();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ── Data Loading ──────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    private async Task LoadDataForCurrentView()
    {
        if (_selectedViewIndex < 0 || _selectedViewIndex >= _viewItems.Count) return;

        var sql = _viewItems[_selectedViewIndex].Sql;
        if (string.IsNullOrWhiteSpace(sql)) return;

        // VB6: appends "ORDER BY 1 ASC/DESC" if no ORDER BY present
        if (!sql.Contains("order by", StringComparison.OrdinalIgnoreCase))
        {
            sql += _sortAsc ? " ORDER BY 1 ASC" : " ORDER BY 1 DESC";
        }

        _currentSql = sql;

        try
        {
            _gridData = await _db.QueryDynamicAsync(sql);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FPickList] Query error: {ex.Message}");
            _gridData = new List<ExpandoObject>();
        }

        BuildColumnsFromData();
    }

    private void BuildColumnsFromData()
    {
        _columnsConfig.Clear();

        if (_gridData.Count == 0) return;

        var first = (IDictionary<string, object>)_gridData[0];
        var fields = first.Keys.ToList();

        var hiddenSet = new HashSet<string>(
            _hideColumns.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Trim()),
            StringComparer.OrdinalIgnoreCase);

        foreach (var field in fields)
        {
            var width = EstimateColumnWidth(field);
            _columnsConfig.Add(new ColumnConfig
            {
                Field = field,
                Header = field,
                Width = width,
                Visible = !hiddenSet.Contains(field)
            });
        }

        UpdateDialogWidth();
    }

    private int EstimateColumnWidth(string field)
    {
        var maxLen = field.Length;
        foreach (var row in _gridData.Take(50))
        {
            var dict = row as IDictionary<string, object>;
            if (dict == null) continue;
            if (!TryGetDictionaryValue(dict, field, out var value)) continue;
            var text = Convert.ToString(value, CultureInfo.CurrentCulture) ?? "";
            if (text.Length > maxLen)
                maxLen = text.Length;
        }

        var px = (maxLen * 7.6) + 36;
        return (int)Math.Clamp(px, 80, 520);
    }

    private void UpdateDialogWidth()
    {
        var visible = _columnsConfig.Where(c => c.Visible).ToList();
        if (visible.Count == 0)
        {
            _dialogWidthPx = 750;
            return;
        }

        var total = visible.Sum(c => c.Width);
        total += 120; // padding, borders, scrollbar
        _dialogWidthPx = (int)Math.Clamp(total, 520, 1400);
    }

    private static bool TryGetDictionaryValue(IDictionary<string, object> dict, string field, out object? value)
    {
        if (dict.TryGetValue(field, out value))
            return true;

        foreach (var kvp in dict)
        {
            if (string.Equals(kvp.Key, field, StringComparison.OrdinalIgnoreCase))
            {
                value = kvp.Value;
                return true;
            }
        }

        value = null;
        return false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // ── Event Handlers ────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    private async Task OnViewChanged()
    {
        await LoadDataForCurrentView();
        StateHasChanged();
    }

    private async Task OnOkClick()
    {
        var selected = GetSelectedRows();
        if (selected.Count == 0) return;

        _isVisible = false;
        await OnSelected.InvokeAsync(selected);
        StateHasChanged();
    }

    private async Task OnCancelClick()
    {
        _isVisible = false;
        StateHasChanged();
        await OnCancel.InvokeAsync();
    }

    private async Task OnNewClick()
    {
        // VB6: returns empty data array signalling "New" was clicked
        _isVisible = false;
        await OnSelected.InvokeAsync(new List<IDictionary<string, object>>());
        StateHasChanged();
    }

    private async Task OnRecordDoubleClick(CellClickEventArgs<ExpandoObject> args)
    {
        if (args.Data == null) return;

        // In single-select mode, double-click = select and close
        if (!_multiSelect)
        {
            var row = (IDictionary<string, object>)args.Data;
            _isVisible = false;
            await OnSelected.InvokeAsync(new List<IDictionary<string, object>> { row });
            StateHasChanged();
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _ = OnCancelClick();
        }
        // Ctrl+F9 = toggle debug SQL (VB6: Form_KeyDown)
        if (e.CtrlKey && e.Key == "F9")
        {
            _showDebugSql = !_showDebugSql;
            StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════════
    // ── Helpers ───────────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    private List<IDictionary<string, object>> GetSelectedRows()
    {
        if (_grid == null) return new();

        var selected = _grid.GetSelectedRecords()
            .Cast<IDictionary<string, object>>()
            .ToList();

        // If nothing explicitly selected in multi-select, return empty
        // In single-select, the highlighted row counts as selected
        return selected;
    }
}
