        OkVisible = true;
        CloseButtonCaption = "Cancel";

        var whereClause = node.WhereClause?.Replace(" AND ", " AND m.") ?? "";
        // Build the key from the node's where clause
        var sql = $@"
            SELECT m.assembly, m.description AS assemblydescription, m.assemblytype, m.model, m.optionid,
                   i.phase, i.item, d.itemchart, i.description, d.formula, d.TakeoffQty,
                   i.takeoffuom, i.conversionfactor, i.orderuom,
                   isnull(nullif(i.JCCostCode,''),isnull(p.JCCostCode,'')) jccostcode,
                   i.jccategory, i.altjccostcode, i.altjccategory, i.price,
                   i.roundto, i.rounddir, isnull(nullif(d.POIndex,''),isnull(i.POIndex,'')) poindex,
                   i.wastepercent,
                   isnull(nullif(d.notes,''),i.notes) Notes,
                   isnull(nullif(d.location,''),i.location) Location
            FROM tbldbassemblymaster m
            LEFT OUTER JOIN tbldbassemblydetails d ON(m.DivisionID = d.DivisionID AND m.community=d.community AND m.model=d.model AND m.optionid=d.optionid AND m.assembly=d.assembly)
            LEFT OUTER JOIN tblphaseitem i ON(i.DivisionID = d.DivisionID AND i.phase=d.phase AND i.item=d.item)
            LEFT OUTER JOIN tblPOIndex p ON(p.DivisionID = d.DivisionID AND isnull(nullif(d.POIndex,''),isnull(i.POIndex,''))=p.POIndex)
            WHERE m.DivisionID = {DivisionID} {whereClause}";

        var rows = await db.QueryAsync(sql);
        ItemsData = new List<TakeoffItemRow>();

        foreach (var row in rows)
