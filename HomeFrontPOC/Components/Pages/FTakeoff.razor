    // ── GetItemTotal (formula lookup support) ─────────────────
    public double GetItemTotal(string totalType, string poIndex, string costCode, string phase, string item)
    {
        double v = 0;
        string col = totalType switch
        {
            "OrderQty" or "Cost" => "PassOrderQty",
            "TakeoffQty" => "PassTakeoffQty",
            _ => "PassOrderQty"
        };

        foreach (var row in ItemsData)
        {
            if ((string.IsNullOrEmpty(poIndex) || poIndex == row.POIndex) &&
                (string.IsNullOrEmpty(costCode) || costCode == row.JCCostCode) &&
                (string.IsNullOrEmpty(phase) || phase == row.Phase) &&
                (string.IsNullOrEmpty(item) || item == row.Item))
            {
                double val = col == "PassOrderQty" ? row.PassOrderQty : row.PassTakeoffQty;
                v += val;
            }
        }

        return v;
    }

    // ── Helpers ───────────────────────────────────────────────
    private double ToDouble(object? val)
    {
        if (val == null || val is DBNull) return 0;
        if (val is string s) return double.TryParse(s, out var d) ? d : 0;
        try { return Convert.ToDouble(val); }
        catch { return 0; }
    }

