    // ── Add Pass ──────────────────────────────────────────────
    private async Task OnAddPass()
    {
        if (!ShowHFVariables || HFVariablesData.Count == 0) return;

        try
        {
            var qtyVar = HFVariablesData.FirstOrDefault(v => v.Name == "Quantity");
            double qty = qtyVar != null ? ToDouble(qtyVar.Value) : 1;

            foreach (var item in ItemsData)
            {
                // Shift pass history
                item.P5 = item.P4;
                item.P4 = item.P3;
                item.P3 = item.P2;
                item.P2 = item.P1;
                item.P1 = item.TakeoffQty;

                // Evaluate formula (simplified - just use resolved formula as number)
                double formulaResult = 0;
                if (double.TryParse(item.ResolvedFormula, out var parsed))
                    formulaResult = parsed;
                else
                    formulaResult = 1;

                item.PassTakeoffQty = qty * formulaResult;
                item.TakeoffQty += item.PassTakeoffQty;

                // Calculate order qty
                RecalculateOrderQty(item);
            }

            SaleQty += qty;

            if (ItemsGrid != null)
                await ItemsGrid.Refresh();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error adding pass: {ex.Message}");
        }
    }

    // ── Undo Pass ─────────────────────────────────────────────
    private async Task OnUndoPass()
    {
        foreach (var item in ItemsData)
        {
            item.TakeoffQty = item.P1;
            item.P1 = item.P2;
            item.P2 = item.P3;
            item.P3 = item.P4;
            item.P4 = item.P5;
            item.P5 = 0;

            RecalculateOrderQty(item);
        }

        if (ItemsGrid != null)
            await ItemsGrid.Refresh();

        StateHasChanged();
    }

    // ── Recalculate Order Qty ─────────────────────────────────
    private void RecalculateOrderQty(TakeoffItemRow item)
    {
        double conversion = item.ConversionFactor;
        if (conversion == 0) conversion = 1;
        double waste = item.WastePercent;
        double orderQty = item.TakeoffQty * (100 + waste) / 100 * conversion;

        // Apply rounding
        if (item.RoundTo > 0)
        {
            if (item.RoundDir > 0)
                orderQty = Math.Ceiling(orderQty / item.RoundTo) * item.RoundTo;
            else if (item.RoundDir < 0)
                orderQty = Math.Floor(orderQty / item.RoundTo) * item.RoundTo;
            else
                orderQty = Math.Round(orderQty / item.RoundTo) * item.RoundTo;
        }

        item.OrderQty = orderQty;
    }

    // ── Save Data ─────────────────────────────────────────────
    private async Task<bool> SaveData()
    {
        try
        {
            // Check for zero qty items
            bool hasZeroQty = ItemsData.Any(i => i.OrderQty == 0);
            if (hasZeroQty)
            {
                var include = await JSRuntime.InvokeAsync<bool>("confirm",
                    "You have items with an order quantity of zero.\nDo you want to add these items anyway?");
                if (!include)
                {
                    // Filter out zero qty items
                    ItemsData = ItemsData.Where(i => i.OrderQty != 0).ToList();
                }
            }

            // In a real implementation, this would call the parent form's AddItem method
            // For now, just signal success
            await JSRuntime.InvokeVoidAsync("alert", $"Takeoff saved with {ItemsData.Count} items. Sale Qty: {SaleQty}");
            return true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving: {ex.Message}");
            return false;
        }
    }

