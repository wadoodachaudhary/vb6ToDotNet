                mAssemblyType = Convert.ToInt32(row["assemblytype"] ?? 0);
                mAssembly = row["assembly"]?.ToString() ?? "";
                mAssemblyDescription = row["assemblydescription"]?.ToString() ?? "";
                mModel = row["model"]?.ToString() ?? "";
                mOptionID = row["optionid"]?.ToString() ?? "";
            }

            var item = new TakeoffItemRow
            {
                Assembly = row["assembly"]?.ToString() ?? "",
                AssemblyDescription = row["assemblydescription"]?.ToString() ?? "",
                Model = row["model"]?.ToString() ?? "",
                Phase = row["phase"]?.ToString() ?? "",
                Item = row["item"]?.ToString() ?? "",
                Description = row["description"]?.ToString() ?? "",
                Job = mJob,
                WastePercent = ToDouble(row["wastepercent"]),
                RawFormula = row["formula"]?.ToString() ?? "",
                TakeoffUOM = row["takeoffuom"]?.ToString() ?? "",
                TakeoffQty = 0,
                OrderQty = 0,
                OrderUOM = row["orderuom"]?.ToString() ?? "",
                ConversionFactor = ToDouble(row["conversionfactor"]),
                JCCostCode = row["jccostcode"]?.ToString() ?? "",
                JCCategory = row["jccategory"]?.ToString() ?? "",
                Price = ToDouble(row["price"]),
                RoundTo = ToDouble(row["roundto"]),
                RoundDir = ToDouble(row["rounddir"]),
                POIndex = row["poindex"]?.ToString() ?? "",
                Notes = row["Notes"]?.ToString() ?? "",
                Location = row["Location"]?.ToString() ?? "",
                P1 = 0, P2 = 0, P3 = 0, P4 = 0, P5 = 0
            };

            item.ResolvedFormula = item.RawFormula; // Simplified - would call ResolveFormula
            if (string.IsNullOrEmpty(item.ResolvedFormula))
                item.ResolvedFormula = (row["TakeoffQty"] ?? "0").ToString() ?? "0";

            ItemsData.Add(item);
