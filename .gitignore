# Dev certificates — private keys must never reach the remote.
# See memory/dev_certificates.md for how to regenerate locally with mkcert.
dev-certs/

# macOS noise
.DS_Store

# AI/session tooling (worktrees live under MobileSource/.claude)
.claude/
.codex-artifacts/
.codex-backups/

# Nested git repositories with their own history — never double-track here
MobileSource/HomeFront/
HomeFrontPB/

# Large local piles / scratch — not source
ClientRepro/
MobileSource/BookVisualizer/
MobileSource/HFControlKit/
MobileSource/HFControlKit copy/
MobileSource/razor_ide/
MobileSource/_template_sweep_backup/
MobileSource/_presenter_rollout_backup/
MobileSource/*.zip
*.bak

# vb6_migrator: runtime/output junk stays out; tool sources and the
# HomeFront project (prompt + recipes) are tracked
__pycache__/
MobileSource/vb6_migrator/cache/
MobileSource/vb6_migrator/.logs/
MobileSource/vb6_migrator/logs/
MobileSource/vb6_migrator/output/
MobileSource/vb6_migrator/.idea/
MobileSource/vb6_migrator/projects/*
!MobileSource/vb6_migrator/projects/HomeFront/
MobileSource/vb6_migrator/projects/HomeFront/cache/
MobileSource/vb6_migrator/projects/HomeFront/graphs/
MobileSource/vb6_migrator/projects/HomeFront/source/
MobileSource/vb6_migrator/projects/HomeFront/target/
