@page "/GridTest"
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using System.Collections.Generic
<SfGrid DataSource="@GridData" AllowGrouping="true" Height="315">
   
    <GridColumns>
        <GridColumn Field=@nameof(OrderData.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
        <GridColumn Field=@nameof(OrderData.CustomerName) HeaderText="Customer Name" Width="150"></GridColumn>
        
        <GridColumn Field=@nameof(OrderData.Freight) HeaderText="Freight" TextAlign="TextAlign.Right" Format="C2" Width="120">
            <GridAggregates>
                <GridAggregate>
                    <GridAggregateColumns>
                        <GridAggregateColumn Field=@nameof(OrderData.Freight) Type="AggregateType.Sum">
                            <GroupFooterTemplate>
                                @{
                                    // The context is a dictionary containing the aggregate results for the group
                                    var data = (context as AggregateTemplateContext);
                                    <div>Sum: @data.Count</div>
                                }
                            </GroupFooterTemplate>
                        </GridAggregateColumn>
                    </GridAggregateColumns>
                </GridAggregate>
            </GridAggregates>
        </GridColumn>
        
        <GridColumn Field=@nameof(OrderData.ShipCity) HeaderText="Ship City" Width="150"></GridColumn>
    </GridColumns>
    <GridAggregates>
        <GridAggregate>
            <GridAggregateColumns>
                <GridAggregateColumn Field=@nameof(OrderData.Freight) Type="AggregateType.Sum">
                    <FooterTemplate>
                        @{
                            // The context is a dictionary containing the aggregate results for the whole grid
                            var data = (context as AggregateTemplateContext);
                            <div class="total-footer">Grid Total: @data.Count</div>
                        }
                    </FooterTemplate>
                </GridAggregateColumn>
            </GridAggregateColumns>
        </GridAggregate>
    </GridAggregates>
</SfGrid>

@code {
    public List<OrderData> GridData { get; set; }
    protected override void OnInitialized()
    {
        // Populate the data source (replace with actual data fetching logic)
        GridData = GetOrderData();
    }
    private List<OrderData> GetOrderData()
    {
        // Mock data initialization
        return new List<OrderData>()
        {
            new OrderData { OrderID = 10248, CustomerName = "VINET", Freight = 32.38, ShipCity = "Reims" },
            new OrderData { OrderID = 10249, CustomerName = "VINET", Freight = 11.61, ShipCity = "Hanover" },
            new OrderData { OrderID = 10250, CustomerName = "TOMSP", Freight = 65.83, ShipCity = "Lyon" },
            new OrderData { OrderID = 10251, CustomerName = "VICTE", Freight = 41.34, ShipCity = "Bern" },
            new OrderData { OrderID = 10252, CustomerName = "TOMSP", Freight = 24.12, ShipCity = "Marseille" },
            new OrderData { OrderID = 10253, CustomerName = "TOMSP", Freight = 45.67, ShipCity = "London" },
            new OrderData { OrderID = 10254, CustomerName = "VINET", Freight = 78.90, ShipCity = "Berlin" },
            new OrderData { OrderID = 10255, CustomerName = "VICTE", Freight = 15.00, ShipCity = "Paris" },
        };
    }
    public class OrderData
    {
        public int OrderID { get; set; }
        public string CustomerName { get; set; }
        public double Freight { get; set; }
        public string ShipCity { get; set; }
   }
}

