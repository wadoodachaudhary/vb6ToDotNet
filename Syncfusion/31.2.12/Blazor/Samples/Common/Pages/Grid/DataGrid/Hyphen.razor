@page "/datagrid/hyphen-overview"
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Spinner
@using Syncfusion.Blazor.DropDowns
@using System;
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Navigations
@using System.IO
@using System.Collections.Generic
@using System.Data
@using System.Data.SQLite
@*@using Microsoft.Data.SQLite;*@
@using System.Dynamic
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager NavigationManager
@inject NavigationManager UriHelper
@inject IJSRuntime JSRuntime
@*Hidden:Lines*@
@using hyphen_data
@using Microsoft.Data.SqlClient
@using Syncfusion.Blazor.Inputs
@using ChangeEventArgs = Syncfusion.Blazor.Navigations.ChangeEventArgs
@inherits SampleBaseComponent;


@*End:Hidden*@

@*Hidden:Lines*@
<style>
    .visible {
        display: inline-block;
        font-size: 18px;
        color: rgba(0, 0, 0, 1);
    }

    .loading {
        position: absolute;
        height: 92%;
        width: 100%;
        background-color: rgba(1, 1, 1, 0.2);
        z-index: 10000;
        display: flex;
        align-items: center;
        padding-left: 44%;
    }

    .material .e-grid .empimg,
    .material3 .e-grid .empimg, .material3-dark .e-grid .empimg,
    .fluent2 .e-grid .empimg, .fluent2-dark .e-grid .empimg, .fluent2-highcontrast .e-grid .empimg {
        background-color: #e3165b;
    }


    .highcontrast .e-grid .empimg {
        background-color: #ffd939;
    }

    _:-ms-fullscreen, :root .highcontrast .e-userimg.sf-icon-Male::before,
    _:-ms-fullscreen, :root .highcontrast .e-userimg.sf-icon-FeMale::before,
    .highcontrast .e-userimg.sf-icon-Male::before,
    .highcontrast .e-userimg.sf-icon-FeMale::before {
        color: black;
    }

    .bootstrap .e-grid .empimg,
    .bootstrap4 .e-grid .empimg,
    .bootstrap5 .e-grid .empimg,
    .bootstrap5\.3 .e-grid .empimg,
    .fluent .e-grid .empimg,
    .fabric .e-grid .empimg {
        background-color: #0078d6;
    }

    .tailwind .e-grid .empimg,
    .tailwind3 .e-grid .empimg {
        background-color: #4f46e5;
    }

    /* Remove manual positioning */
    .empimg + #Emptext {
        position: static !important;
    }

    /* Style the icon container (make it a perfect circle) */
    .empimg {
        display: inline-flex; /* Flexbox for centering content */
        justify-content: center;
        align-items: center;
        vertical-align: middle;
        border-radius: 50%;
    }

    /* Ensure text and icon align vertically */
    .empimg, #Emptext {
        vertical-align: middle;
        display: inline-block;
    }

    /* Spacing between icon and text (LTR) */
    .e-grid:not(.e-rtl) .empimg {
        margin-right: 6px;
        margin-left: 0;
    }

    /* Spacing between icon and text (RTL) */
    .e-grid.e-rtl .empimg {
        margin-left: 6px;
        margin-right: 0;
    }

    .e-userimg.sf-icon-Male::before,
    .e-userimg.sf-icon-FeMale::before {
        font-size: 13px;
    }

    .e-userimg.sf-icon-Male, .e-userimg.sf-icon-FeMale {
        margin: 0px 8px;
        line-height: 26px;
        color: white;
        font-size: 13px;
    }

    .e-userimg.sf-icon-Male::before {
        content: '\e700';
    }

    .e-userimg.sf-icon-FeMale::before {
        content: '\e701';
    }

    .highcontrast .e-grid td.e-rowcell.e-selectionbackground.e-active,
    .fluent2-highcontrast .e-grid td.e-rowcell.e-selectionbackground.e-active {
        background-color: transparent;
        color: white;
    }

    .e-bigger .e-grid .statustxt {
        position: relative;
        top: -2px;
    }

    .rating .star {
        font-size: 132%;
        color: lightgrey;
    }

    .rating .star.checked {
        color: #ffa600;
    }

    .rating .star:before {
        content: '★';
    }

    td.e-rowcell.e-selectionbackground.e-active {
        background-color: transparent;
    }

    .e-image {
        height: 13px;
        width: 14px;
    }

    .statustemp {
        display: flex;
        align-items: center; /* Center vertically */
        justify-content: center; /* Center horizontally */
        height: 100%; /* Make sure the parent has a specific height */
        text-align: center;
        box-sizing: border-box;
    }

    .statustxt {
        position: static !important; /* Ensure no conflicting positioning */
        vertical-align: middle; /* Generally unnecessary with flexbox */
        display: inline-block; /* Ensure it's treated as a block element */
    }

    td.e-rowcell .statustxt.e-activecolor {
        color: #007d00;
    }

    td.e-rowcell .statustxt.e-inactivecolor {
        color: #c40000;
    }

    .statustemp.e-inactivecolor {
        background-color: #ffd7cc;
        width: 64px;
    }

    .statustemp.e-activecolor {
        background-color: #ccffcc;
        width: 57px;
    }

    .statustxt.e-activecolor {
        color: #00cc00;
    }

    .statustxt.e-inactivecolor {
        color: #e60000;
    }

    .statustemp {
        position: relative;
        height: 19px;
        border-radius: 5px;
        text-align: center
    }

    .highcontrast #msg {
        color: #FFFFFF
    }

    #msg {
        font-family: "Segoe UI", "GeezaPro", "DejaVu Serif", sans-serif;
        font-size: 14px;
        font-weight: 400;
        opacity: 0.95;
        color: #333;
        float: right;
        margin-top: 3px;
    }

    @@media only screen and (max-width: 370px) {
        #msg {
            float: left;
            margin-top: 3px;
        }

        #Grid {
            margin-top: 36px;
        }
    }

    #samplecontainer {
        padding-top: 5px;
    }

    #myProgress {
        position: relative;
        height: 18px;
        width: 10em;
        text-align: left;
        background-color: white;
    }

    .highcontrast .e-grid #myProgress {
        background-color: black;
    }

    .e-dddata {
        padding-bottom: 10px;
    }

    #myBar {
        position: absolute;
        width: 10%;
        height: 100%;
        background-color: #00b300;
    }

    #myBar.progressdisable {
        background-color: #df2222;
    }

    #label {
        position: relative;
        left: 10px;
        line-height: 18px;
        font-size: 10px;
        color: white;
    }

    @@font-face {
        font-family: 'grid-control-font';
        src: url(data:application/x-font-ttf;charset=utf-8;base64,) format('truetype');
        font-weight: normal;
        font-style: normal;
    }

    [class^="sf-icon-"], [class*=" sf-icon-"] {
        font-family: 'grid-control-font' !important;
        speak: none;
        font-size: 55px;
        font-style: normal;
        font-weight: normal;
        font-variant: normal;
        text-transform: none;
        line-height: 1;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

</style>
<SfToolbar>
    <ToolbarItems>
        <ToolbarItem Text="New" IconCss="e-icons e-new" OnClick="OnNewClick"></ToolbarItem>
        <ToolbarItem Text="Open" IconCss="e-icons e-open" OnClick="OnOpenClick"></ToolbarItem>
        <ToolbarItem Text="Save" IconCss="e-icons e-save" OnClick="OnSaveClick" Disabled="@(!mDirty)"></ToolbarItem>
        <ToolbarItem Separator="true"></ToolbarItem>
        <ToolbarItem Text="One Time" Disabled="true"></ToolbarItem>
        <ToolbarItem Text="Item" Disabled="true"></ToolbarItem>
        <ToolbarItem Text="Assembly" Disabled="true"></ToolbarItem>
        <ToolbarItem Text="PlanSwift" Visible="@ShowPlanSwift" Disabled="true"></ToolbarItem>
        <ToolbarItem Text="Custom" Disabled="true"></ToolbarItem>
        <ToolbarItem Text="Item Chart" Disabled="true"></ToolbarItem>
        <ToolbarItem Separator="true"></ToolbarItem>
        <ToolbarItem Text="Change"></ToolbarItem>
        <ToolbarItem Separator="true"></ToolbarItem>
        <ToolbarItem Text="Pricelist" OnClick="OnExportPricelist"></ToolbarItem>
        <ToolbarItem Text="Import" Visible="@ShowImportButton">
            <ToolbarItemTemplate>
                <SfDropDownButton Content="Import">
                    <DropDownButtonItems>
                        <DropDownButtonItem Text="Models and Options" OnClick="OnImportModels"></DropDownButtonItem>
                        <DropDownButtonItem Text="Global Options" OnClick="OnImportGlobals"></DropDownButtonItem>
                    </DropDownButtonItems>
                </SfDropDownButton>
            </ToolbarItemTemplate>
        </ToolbarItem>
    </ToolbarItems>
</SfToolbar>
<div class="container-fluid">
    <h3 class="mb-4">@(string.IsNullOrEmpty(AssemblyCode) ? "New Assembly" : AssemblyCode + " - " + Description)</h3>

    <!-- Two Side-by-Side Panels -->
    <div class="row">
        <!-- LEFT PANEL -->
        <div class="col-md-6">
            <div class="card border-primary h-100">
                <div class="card-header bg-primary text-white">
                    <strong>Assembly Information</strong>
                </div>
                <div class="card-body">

                    <!-- Community -->
                    <div class="row mb-3">
                        <div class="col-4 text-end"><strong>Community</strong></div>
                        <div class="col-8">
                            <SfComboBox TValue="string" TItem="ComboBoxItem"
                                        DataSource="@CommunityItems"
                                        @bind-Value="@CommunityValue"
                                        Placeholder="Select Community">
                                >
                                <ComboBoxFieldSettings Text="Text" Value="Value"></ComboBoxFieldSettings>
                            </SfComboBox>
                        </div>
                    </div>


                    <!-- Model -->
                    <div class="row mb-3">
                        <div class="col-4 text-end"><strong>Model</strong></div>
                        <div class="col-8">
                            <SfComboBox TValue="string" TItem="ComboBoxItem"
                                        DataSource="@ModelItems"
                                        @bind-Value="@ModelValue"
                                        Placeholder="Select Model">
                                <ComboBoxFieldSettings Text="Text" Value="Value"></ComboBoxFieldSettings>
                            </SfComboBox>
                        </div>
                    </div>

                    <!-- Assembly -->
                    <div class="row mb-3">
                        <div class="col-4 text-end"><strong>Assembly</strong></div>
                        <div class="col-8">
                            <SfTextBox @bind-Value="@AssemblyCode" Placeholder="Assembly Code"></SfTextBox>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="row mb-3">
                        <div class="col-4 text-end"><strong>Description</strong></div>
                        <div class="col-8">
                            <SfTextBox @bind-Value="@Description" Placeholder="Description"></SfTextBox>
                        </div>
                    </div>

                    <!-- Comments -->
                    <div class="row mb-3">
                        <div class="col-4 text-end"><strong>Comments</strong></div>
                        <div class="col-8">
                            <SfTextBox Multiline="true" Rows="4"
                                       @bind-Value="@Comments"
                                       Placeholder="Enter comments..."></SfTextBox>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="col-md-6">
            <div class="card border-success h-100">
                <div class="card-header bg-success text-white">
                    <strong>Model Details</strong>
                </div>
                <div class="card-body">

                    <!-- Series -->
                    <div class="row mb-3">
                        <div class="col-4 text-end"><strong>Series</strong></div>
                        <div class="col-8">
                            <SfComboBox TValue="string" TItem="ComboBoxItem"
                                        DataSource="@SeriesItems"
                                        @bind-Value="@SeriesValue"
                                        Placeholder="Select Series">
                                <ComboBoxFieldSettings Text="Text" Value="Value"></ComboBoxFieldSettings>
                            </SfComboBox>
                        </div>
                    </div>

                    <!-- Elevation -->
                    <div class="row mb-3">
                        <div class="col-4 text-end"><strong>Elevation</strong></div>
                        <div class="col-8">
                            <SfTextBox @bind-Value="@Elevation" Placeholder="Elevation"></SfTextBox>
                        </div>
                    </div>

                    <!-- Style -->
                    <div class="row mb-3">
                        <div class="col-4 text-end"><strong>Style</strong></div>
                        <div class="col-8">
                            @if (ShowStyleCombo){
                                <SfComboBox TValue="string" TItem="ComboBoxItem"
                                            DataSource="@StyleItems"
                                            @bind-Value="@StyleValue">
                                    <ComboBoxFieldSettings Text="Text" Value="Value"></ComboBoxFieldSettings>
                                </SfComboBox>
                            }
                            else{
                                <SfTextBox @bind-Value="@StyleText" Placeholder="Style"></SfTextBox>
                            }
                        </div>
                    </div>

                    <!-- Schedule Template -->
                    <div class="row mb-3">
                        <div class="col-4 text-end"><strong>Sched Tmpl</strong></div>
                        <div class="col-8">
                            <SfComboBox TValue="string" TItem="string"
                                        DataSource="@ScheduleTemplateItems"
                                        @bind-Value="@ScheduleTemplateValue"
                                        Placeholder="Schedule Template">
                            </SfComboBox>
                        </div>
                    </div>

                    <!-- Bedrooms / Bathrooms / SqFt -->
                    <div class="row mb-3">
                        <div class="col-4 text-end"><strong>Bds/Bths/SqFt</strong></div>
                        <div class="col-8">
                            <div class="input-group">
                                <SfNumericTextBox TValue="int?" @bind-Value="@Bedrooms" Min="0" Max="20" Format="N0"
                                                  Width="100px"></SfNumericTextBox>
                                <span class="input-group-text">/</span>
                                <SfNumericTextBox TValue="int?" @bind-Value="@Bathrooms" Min="0" Max="10" Format="N0"
                                                  Width="100px"></SfNumericTextBox>
                                <span class="input-group-text">/</span>
                                <SfNumericTextBox TValue="int?" @bind-Value="@FloorArea" Min="0" Max="10000" Format="N0"
                                                  Width="160px"></SfNumericTextBox>
                            </div>
                        </div>
                    </div>

                    <!-- Width / Length -->
                    <div class="row mb-3">
                        <div class="col-4 text-end"><strong>Width/Length</strong></div>
                        <div class="col-8">
                            <div class="input-group">
                                <SfNumericTextBox TValue="double?" @bind-Value="@MaxWidth" Min="0" Max="200" Format="N1"
                                                  Width="100px"></SfNumericTextBox>
                                <span class="input-group-text">×</span>
                                <SfNumericTextBox TValue="double?" @bind-Value="@MaxLength" Min="0" Max="200"
                                                  Format="N1" Width="100px"></SfNumericTextBox>
                            </div>
                        </div>
                    </div>

                    <!-- Spec Document -->
                    <div class="row mb-3">
                        <div class="col-4 text-end"><strong>Spec Doc</strong></div>
                        <div class="col-8">
                            <div class="input-group">
                                <SfTextBox @bind-Value="@SpecDocument" Readonly="true"
                                           Placeholder="No document selected"></SfTextBox>
                                <button class="btn btn-outline-secondary" type="button" @onclick="() => BrowseFile(1)">
                                    <i class="bi bi-folder-open"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="row mb-3">
                <div class="col-4 text-end"><strong>Price Communities</strong></div>
                <div class="col-8">
                    <div class="input-group">
                        <SfComboBox @bind-Value="@SelectedPriceCommunity"
                                    DataSource="@PricingCommunities"
                                    TValue="string"
                                    TItem="CommunityItem"
                                    Placeholder="Select Pricing Community"
                                    Width="200px">
                            <ComboBoxFieldSettings Text="DisplayText" Value="Value"/>
                        </SfComboBox>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CHECKBOXES AT BOTTOM -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card border-dark">
            <div class="card-header bg-dark text-white">
                <strong>Options</strong>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <SfCheckBox @bind-Checked="@IsActive" Label="Active"></SfCheckBox>
                    </div>
                    <div class="col-md-4">
                        <SfCheckBox @bind-Checked="@IsTakeoffRequired"
                                    Label="Takeoff is required on every sale"></SfCheckBox>
                    </div>
                    <div class="col-md-4">
                        <SfCheckBox @bind-Checked="@UseNormalSalesQtyFactors"
                                    Label="Use normal sales quantity factors"></SfCheckBox>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-4">
                        <SfCheckBox @bind-Checked="@IsBaseAssembly"
                                    Label="Base assembly. Will not be published to sales."></SfCheckBox>
                    </div>
                    <div class="col-md-4">
                        <SfCheckBox @bind-Checked="@IsIncludedOption" Label="Included Option"></SfCheckBox>
                    </div>
                    <div class="col-md-4">
                        <SfCheckBox @bind-Checked="@IsDCSalesOnly" Label="DC Sales Only"></SfCheckBox>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card mt-3">
            <!-- Items Grid -->
            <h5>Items</h5>
            <SfGrid @ref="ItemsGrid" DataSource="@ItemsData" AllowSelection="true" AllowSorting="true" AllowFiltering="true" AllowGrouping="true" AllowResizing="true" AllowReordering="true"
                    EnableVirtualization="true" EnableVirtualMaskRow="true" EnableHover="false" Height="600"
                    RowHeight="38">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                <GridPageSettings PageSize="40"></GridPageSettings>
                <GridSelectionSettings CheckboxOnly="true" PersistSelection="true"
                                       Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings>
                <GridColumns>
                    <GridColumn Field="POIndex" HeaderText="PO Index" Width="80"></GridColumn>
                    <GridColumn Field="Vendor" HeaderText="Vendor Name" Width="100"></GridColumn>
                    <GridColumn Field="Phase" HeaderText="Phase" Width="80"></GridColumn>
                    <GridColumn Field="Item" HeaderText="Item" Width="100"></GridColumn>
                    <GridColumn Field="Description" HeaderText="Description" Width="250"></GridColumn>
                    <GridColumn Field="TakeoffQty" HeaderText="Takeoff Qty" Format="N2" Width="100"></GridColumn>
                    <GridColumn Field="OrderQty" HeaderText="Order Qty" Format="N2" Width="100"></GridColumn>
                    <GridColumn Field="Notes" HeaderText="Notes" Width="80"></GridColumn>
                    <GridColumn Field="OrderUOM" HeaderText="UOM" Width="80"></GridColumn>
                    <GridColumn Field="Price" HeaderText="Price" Format="C2" Visible="@ShowPricing"
                                Width="100"></GridColumn>
                    <GridColumn Field="ExtendedAmount" HeaderText="Extended" Format="C2" Visible="@ShowPricing"
                                Width="120"></GridColumn>
                    <GridColumn Field="ItemType" HeaderText="Item Type" Width="120"></GridColumn>
                    <GridColumn Field="PriceLevel" HeaderText="Price Level" Width="120"></GridColumn>

                </GridColumns>
            </SfGrid>

            <!-- Cost Summary -->
            @if (ShowPricing){
                <div class="row mt-3">
                    <div class="col text-end">
                        <strong>Assembly Cost: @AssemblyCostLabel</strong><br/>
                        <strong>Component Cost: @ComponentCostLabel</strong><br/>
                        <strong>Total Cost: @TotalCostLabel</strong>
                    </div>
                </div>
            }

            <!-- Components Grid (if enabled) -->
            @if (ShowComponentsGrid){
                <h5 class="mt-4">Components</h5>
                <SfGrid DataSource="@ComponentsData" Height="300">
                    <GridColumns>
                        <GridColumn Field="Assembly" HeaderText="Assembly"></GridColumn>
                        <GridColumn Field="Description" HeaderText="Description"></GridColumn>
                        <GridColumn Field="Qty" HeaderText="Qty" Format="N0"></GridColumn>
                        <GridColumn Field="Cost" HeaderText="Cost" Format="C2" Visible="@ShowPricing"></GridColumn>
                    </GridColumns>
                </SfGrid>
            }
        </div>
    </div>
</div>

@*End:Hidden*@

@*
<div class="col-lg-12 control-section">
    <div class="content-wrapper">
        <div class="row">
            <div class="e-dddata">
                <SfDropDownList TItem="DDData" TValue="string" PopupHeight="230px" Width="240px" @bind-Index="@index"
                                DataSource="@DLData">
                    <DropDownListEvents TItem="DDData" TValue="string" ValueChange="Changedata"
                                        Closed="DropdownClose"></DropDownListEvents>
                    <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                </SfDropDownList>
            </div>
            <div id="container">
                <SfGrid DataSource="@GridData" AllowSelection="true" AllowSorting="true" AllowFiltering="true"
                        EnableVirtualization="true" EnableVirtualMaskRow="true" EnableHover="false" Height="600"
                        RowHeight="38">
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                    <GridPageSettings PageSize="40"></GridPageSettings>
                    <GridSelectionSettings CheckboxOnly="true" PersistSelection="true"
                                           Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings>
                    <GridColumns>
                        <GridColumn Type="ColumnType.CheckBox" AllowFiltering="false" AllowSorting="false"
                                    Width="60"></GridColumn>
                        <GridColumn Field="@nameof(HyphenData.EmployeeID)" HeaderText="Employee ID" Visible="false"
                                    IsPrimaryKey="true" Width="130"></GridColumn>
                        <GridColumn Field="@nameof(HyphenData.Employees)" HeaderText="Employee Name" Width="200"
                                    ClipMode="ClipMode.EllipsisWithTooltip">
                            <Template>
                                @{
                                    var employee1 = context as HyphenData;
                                    <div>
                                        <div class="empimg">
                                            @if (employee1?.EmployeeImg == "usermale"){
                                                <span class="e-userimg sf-icon-Male"></span>
                                            }
                                            @if (employee1?.EmployeeImg == "userfemale"){
                                                <span class="e-userimg sf-icon-FeMale"></span>
                                            }
                                        </div>
                                        <span id="Emptext">@employee1?.Employees</span>
                                    </div>}
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(HyphenData.Designation)" Width="170"
                                    FilterSettings="@(new FilterSettings { Type = Syncfusion.Blazor.Grids.FilterType.CheckBox })"
                                    ClipMode="ClipMode.EllipsisWithTooltip"></GridColumn>
                        <GridColumn Field="@nameof(HyphenData.Mail)" Width="230"
                                    FilterSettings="@(new FilterSettings { Type = Syncfusion.Blazor.Grids.FilterType.Menu })"></GridColumn>
                        <GridColumn Field="@nameof(HyphenData.Location)"
                                    FilterSettings="@(new FilterSettings { Type = Syncfusion.Blazor.Grids.FilterType.CheckBox })"
                                    Width="140">
                            <Template>
                                @{
                                    var location = context as HyphenData;
                                    <div class="loc">
                                        <img
                                            src="@UriHelper.ToAbsoluteUri($"{SampleService?.WebAssetsPath}images/data-grid/map.png")"
                                            class="e-image" alt=@location?.Location/>
                                        <span id="locationtext">@location?.Location</span>
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(HyphenData.Status)"
                                    FilterSettings="@(new FilterSettings { Type = Syncfusion.Blazor.Grids.FilterType.CheckBox })"
                                    Width="150">
                            <Template>
                                @{
                                    var employee = context as HyphenData;
                                    if (employee?.Status == "Active"){
                                        <div class="statustemp e-activecolor">
                                            <span class="statustxt e-activecolor">@employee.Status</span>
                                        </div>
                                    }
                                    else{
                                        <div class="statustemp e-inactivecolor">
                                            <span class="statustxt e-inactivecolor">@employee?.Status</span>
                                        </div>
                                    }
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(HyphenData.Trustworthiness)"
                                    FilterSettings="@(new FilterSettings { Type = Syncfusion.Blazor.Grids.FilterType.CheckBox })"
                                    Width="160">
                            <Template>
                                @{
                                    var trust = context as HyphenData;
                                    <div class="trust">
                                        <img style="width: 31px; height: 24px"
                                             src="@UriHelper.ToAbsoluteUri($"{SampleService?.WebAssetsPath}images/data-grid/{trust?.Trustworthiness?.ToLowerInvariant()}.png")"
                                             alt=@trust?.Trustworthiness/>
                                        <span id="Trusttext">@trust?.Trustworthiness</span>
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(HyphenData.Rating)"
