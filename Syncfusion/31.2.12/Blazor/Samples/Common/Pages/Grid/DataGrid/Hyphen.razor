    private async Task LoadDataAsync(){
        try{
            StateHasChanged();

            // === VB6: ReadOnly = False / Screen.MousePointer = vbHourglass

            // Clear cost labels
            AssemblyCostLabel = "";
            ComponentCostLabel = "";
            TotalCostLabel = "";

            // === Model ComboBox style & data source logic
            if (mAssemblyType == AssemblyTypes.atoption){
                await LoadModelComboForOptionsOnly();
            }
            else{
                await LoadModelComboForAll();
            }

            // === Build master record query
            var masterQuery = $@"
            SELECT AssemblyId, BillingFactor, BillingCode, BillingCategory, GraphicPath, SpecDocument, ScheduleTemplate,
                   MaxWidth, MaxLength, ConstCutoff, Community, AssemblyType, Model, Elevation, OptionID, Assembly,
                   Inactive, Description, Comments, Notes, Series, Style, AssemblyUOM, Bedrooms, Bathrooms, FloorArea,
                   Category, JCExtra, Qty, Location, IncludedOption, ColorListID, StyleListID, FinishListID, OtherListID,
                   Color, StyleValue, FinishValue, OtherValue, TakeoffRequired, UseNormalSalesQtyFactors,
                   IsBaseAssembly, DesignCenterSalesOnly, SelectByRoom, DisplayTotalOnly
            FROM {(mDataSource == 0 ? "tblDBAssemblyMaster" : "SalesAssemblyList")} m
            WHERE m.DivisionID = @DivisionID
              AND ISNULL(m.Community,'') = @Community
              AND ISNULL(m.Model,'') = @Model
              AND ISNULL(m.OptionID,'') = @OptionID
              AND ISNULL(m.Assembly,'') = @Assembly";
            var masterParams = new {
                DivisionID = 1,
                Community = mCommunity ?? "",
                Model = mModel ?? "",
                OptionID = mOptionID ?? "",
                Assembly = mAssembly ?? ""
            };
            var masterDt = db.SqlExec(masterQuery, masterParams);
            if (masterDt.Rows.Count == 0){
                // === New record - set defaults ===
                mAssemblyID = 0;
                CommunityValue = mCommunity;
                ModelValue = mModel;
                OptionID = mOptionID;
                AssemblyCode = mAssembly;
                Description = mAssemblyDesc;

                // Default field values
                Elevation = "";
                GraphicPath = "";
                var SpecDocument = "";
                MaxWidth = 0.0;
                MaxLength = 0.0;
                ConstCutoff = 0.0;
                Comments = Notes = "";
                IsActive = true;
                string SeriesValue = null;
                UOM = "";
                StyleText = "";
                string StyleValue = null;
                string CategoryValue = null;
                var JCExtra = "";
                IsBaseAssembly = false;
                BillingFactor = 1.0;
                string BillingCodeValue = null;
                string BillingCategoryValue = null;
                Qty = 1;
                string LocationValue = null;
                IsIncludedOption = IsDCSalesOnly = IsSelectByRoom = IsDisplayTotalOnly = false;
                IsTakeoffRequired = false;
                UseNormalSalesQtyFactors = true;

                // List IDs
                string LColor = "", LStyle = "", LFinish = "", LOther = "";
                string AColor = "", AStyle = "", AFinish = "", AOther = "";

                // Enable controls
                var CommunityEnabled = true;
                var ModelEnabled = mAssemblyType == AssemblyTypes.atModel || mAssemblyType == AssemblyTypes.atoption;
                var OptionEnabled = mAssemblyType != AssemblyTypes.atModel;
                var AssemblyEnabled = true;
            }
            else{
                var row = masterDt.Rows[0];
                mAssemblyID = Convert.ToInt64(row["AssemblyId"]);
                mCommunity = row["Community"]?.ToString() ?? "";
                mAssemblyType = (AssemblyTypes)Convert.ToInt32(row["AssemblyType"]);

                // Visibility
                var ShowConstCutoff = mAssemblyType != AssemblyTypes.atDesignCenter;

                // Bind values
                ModelValue = row["Model"]?.ToString();
                ScheduleTemplateValue = row["ScheduleTemplate"]?.ToString() ?? "";
                OptionID = mOptionID;
                Elevation = row["Elevation"]?.ToString() ?? "";
                AssemblyCode = row["Assembly"]?.ToString() ?? "";
                IsActive = (row["Inactive"]?.ToString() ?? "False") != "True";
                Description = row["Description"]?.ToString() ?? "";
                GraphicPath = row["GraphicPath"]?.ToString() ?? "";
                var SpecDocument = row["SpecDocument"]?.ToString() ?? "";
                MaxWidth = ToDouble(row["MaxWidth"]);
                MaxLength = ToDouble(row["MaxLength"]);
                ConstCutoff = ToDouble(row["ConstCutoff"]);
                Comments = row["Comments"]?.ToString() ?? "";
                Notes = row["Notes"]?.ToString() ?? "";
                var SeriesValue = row["Series"]?.ToString();
                StyleText = row["Style"]?.ToString() ?? "";
                CommunityValue = mCommunity;
                var StyleValue = row["Style"]?.ToString();
                UOM = row["AssemblyUOM"]?.ToString() ?? "";
                Bedrooms = ToInt(row["Bedrooms"]?.ToString(), 2);
                Bathrooms = ToInt(row["Bathrooms"]?.ToString(), 2); // default 1
                FloorArea = ToInt(row["FloorArea"]?.ToString(), 1000);
                //Console.WriteLine($"Bedrooms={Bedrooms} Bathrooms={Bathrooms}  FloorArea={FloorArea}");
                var CategoryValue = row["Category"]?.ToString();
                var JCExtra = row["JCExtra"]?.ToString() ?? "";
                Qty = ToDouble(row["Qty"]);
                var LocationValue = row["Location"]?.ToString();
                IsIncludedOption = row["IncludedOption"]?.ToString() == "True";
                IsDCSalesOnly = row["DesignCenterSalesOnly"]?.ToString() == "True";
                IsSelectByRoom = row["SelectByRoom"]?.ToString() == "True";
                IsDisplayTotalOnly = row["DisplayTotalOnly"]?.ToString() == "True";
                BillingFactor = ToDouble(row["BillingFactor"]);
                var BillingCodeValue = row["BillingCode"]?.ToString();
                var BillingCategoryValue = row["BillingCategory"]?.ToString();

                // List IDs
                var LColor = ZeroToEmpty(row["ColorListID"]);
                var LStyle = ZeroToEmpty(row["StyleListID"]);
                var LFinish = ZeroToEmpty(row["FinishListID"]);
                var LOther = ZeroToEmpty(row["OtherListID"]);
                var AColor = row["Color"]?.ToString() ?? "";
