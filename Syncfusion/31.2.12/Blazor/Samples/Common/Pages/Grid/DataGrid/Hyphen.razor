    private void LoadScheduleTemplates(string scheduleTemplates, string SelectedTemplate){
        // Step 1: Split by | and clean up
        var items = scheduleTemplates
            .Split('|', StringSplitOptions.RemoveEmptyEntries) // Remove empty entries
            .Select(x => x.Trim()) // Trim spaces
            .Where(x => !string.IsNullOrEmpty(x)) // Final safety
            .ToList();

        // Step 2: Add to ComboBox list
        ScheduleTemplateItems = items;

        // Step 3: Set default selected value (like VB6 ListIndex)
        // If the default exists in the list → it will be selected
        // If not → first item is selected automatically
        if (!items.Contains(SelectedTemplate)){
            SelectedTemplate = items.FirstOrDefault() ?? "";
        }
    }

    private void LoadSeries(string series, string SelectedSeries){
        // Step 1: Split by | and clean up
        var items = series
            .Split('|', StringSplitOptions.RemoveEmptyEntries) // Remove empty entries
            .Select(x => x.Trim()) // Trim spaces
            .Where(x => !string.IsNullOrEmpty(x)) // Final safety
            .ToList();

        // Step 2: Add to ComboBox list
        foreach (var item in items){
            SeriesItems.Add(new ComboBoxItem { Text = item, Value = item });
        }
        // Step 3: Set default selected value (like VB6 ListIndex)
        // If the default exists in the list → it will be selected
        // If not → first item is selected automatically
        if (!items.Contains(SelectedSeries)){
            SelectedSeries = items.FirstOrDefault() ?? "";
        }
    }

