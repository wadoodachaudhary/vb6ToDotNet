    public static string Purch_GetCommunityVendor(string community, string poIndex, int divisionId){
        // Handle null/empty inputs
        community = community?.Trim() ?? "";
        poIndex = poIndex?.Trim() ?? "";
        if (conn.State == ConnectionState.Closed ||
            conn.State == ConnectionState.Broken){
            conn.Open();
        }
        var sql = @"
            SELECT Vendor
            FROM POAreaVendor
            WHERE POIndex = @POIndex
              AND DivisionID = @DivisionID
              AND (Area = @Community OR Area = '' OR Area IS NULL)
            ORDER BY 
                CASE 
                    WHEN Area = @Community THEN 3
                    WHEN Area = '' OR Area IS NULL THEN 2
                    ELSE 1 
                END DESC,
                CASE WHEN Area IS NULL THEN 1 ELSE 0 END DESC
            LIMIT 1";
        using var command = conn.CreateCommand();
        command.CommandText = sql;
        command.Parameters.AddWithValue("@Community", community);
        command.Parameters.AddWithValue("@POIndex", poIndex);
        command.Parameters.AddWithValue("@DivisionID", divisionId);
        var result = command.ExecuteScalar();
        return result?.ToString() ?? "";
    }

    private async Task OnExportPricelist(){
        if (string.IsNullOrWhiteSpace(PricingCommunity)){
            await JSRuntime.InvokeVoidAsync("alert", "Select a pricing community first");
            return;
        }
        var query = @"
        SELECT v.vendor_name AS Vendor, i.Description, d.OrderQty, v.Current_Cost AS Price
        FROM tblDBAssemblyDetails d
        JOIN tblPhaseItem i ON d.Phase = i.Phase AND d.Item = i.Item
        JOIN tblVendorCost v ON i.POIndex = v.POIndex
        WHERE d.AssemblyID = @AssemblyID
        ORDER BY v.vendor_name, i.Description";
        var data = await db.QueryDynamicAsync(query, new { AssemblyID = mAssemblyID });

        // Generate CSV
        var csv = "Vendor,Description,Qty,Price\n";
        foreach (var row in data){
            csv += "{row.Vendor},{row.Description},{row.OrderQty},{row.Price}\n"; // commented out build string
        }
        await JSRuntime.InvokeVoidAsync("downloadFile", "Pricelist.csv", "text/csv", csv);
    }

