            Console.WriteLine($"[FAssembly.LoadData] Error: {ex.Message}\n{ex.StackTrace}");
            //await JSRuntime.InvokeVoidAsync("alert", "Error loading assembly data: " + ex.Message);
        }
        finally{
            StateHasChanged();
        }
    }

    public static int ToInt(string str, int defaultValue = 0){
        return string.IsNullOrWhiteSpace(str)
            ? defaultValue
            : int.TryParse(str.Trim(), out var result)
                ? result
                : defaultValue;
    }

