                var AOther = row["OtherValue"]?.ToString() ?? "";
                IsTakeoffRequired = row["TakeoffRequired"]?.ToString() == "True";
                UseNormalSalesQtyFactors = row["UseNormalSalesQtyFactors"]?.ToString() == "True";
                IsBaseAssembly = row["IsBaseAssembly"]?.ToString() == "True";

                // Enable based on data source
                var fromSales = mDataSource == 1;
                var CommunityEnabled = fromSales;
                var ModelEnabled = fromSales;
                var OptionEnabled = fromSales;
                var AssemblyEnabled = fromSales;
            }

            // === UI Visibility based on AssemblyType ===
            switch (mAssemblyType){
                case AssemblyTypes.atModel:
                    ShowOptionField = false;
