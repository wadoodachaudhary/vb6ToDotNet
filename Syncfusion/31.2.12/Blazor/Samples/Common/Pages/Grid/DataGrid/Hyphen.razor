        if (string.IsNullOrWhiteSpace(result)) return;
        mAssemblyType = result.Trim() switch {
            "1" => AssemblyTypes.atModel,
            "2" => AssemblyTypes.atoption,
            "3" => AssemblyTypes.atGlobal,
            "4" => AssemblyTypes.atDesignCenter,
