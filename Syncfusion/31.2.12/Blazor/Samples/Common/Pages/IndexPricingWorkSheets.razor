@page "/pricing-worksheet"


@namespace BlazorDemos.Pages

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Spinner
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Calendars
@using System
@using System.Data
@using System.Dynamic
@using System.Collections.Generic
@using System.Linq
@using BlazorDemos.Pages.Grid

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@*Hidden:Lines*@
@inherits SampleBaseComponent;
@*End:Hidden*@

<style>
    .tabs-container {
        margin: 20px auto;
        font-family: sans-serif;
    }


    .task-icon-vb6 {
        width: 2000px;
        height: auto;
        display: block;

    }

    .tab-buttons {
        display: flex;
        border-bottom: 2px solid #ddd;
    }

    .tab-buttons button {
        padding: 12px 24px;
        border: none;
        background: #f0f0f0;
        cursor: pointer;
        font-size: 16px;
        transition: background 0.2s;
    }

    .tab-buttons button:hover {
        background: #e0e0e0;
    }

    .tab-buttons button.active {
        background: #fff;
        border-bottom: 2px solid #007bff;
        margin-bottom: -2px;
        color: #007bff;
        font-weight: bold;
    }

    .tab-content {
        padding: 20px;
        border: 1px solid #ddd;
        border-top: none;
        background: #fff;
    }

    .panel {
        text-align: center;
    }

    .panel img {
        max-width: 100%;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .toolbar-cntr {
        padding-top: 12px;
        padding-bottom: 12px;
        border-top: 1px solid #c9c9c9;
        border-bottom: 1px solid #c9c9c9;
        margin-bottom: 10px;
    }

    .tool-label {
        width: 100%;
        display: block;
    }


    .loading {
        position: absolute;
        height: 92%;
        width: 100%;
        background-color: rgba(1, 1, 1, 0.2);
        z-index: 10000;
        display: flex;
        align-items: center;
        padding-left: 44%;
    }

    .toolbar-cntr {
        padding: 8px 12px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        margin-bottom: 10px;
        background-color: #f8f9fa;
    }

    .e-btn {
        margin-right: 5px;
    }

    .tool-label {
        font-size: 11px;
        display: block;
    }

    /* Header Panel */
    .header-panel {
        background: linear-gradient(to bottom, #f8f9fa, #e9ecef);
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 15px;
    }

    .header-section {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 12px;
        height: 100%;
    }

    .header-section-title {
        font-weight: 600;
        font-size: 12px;
        color: #6c757d;
        margin-bottom: 10px;
        text-transform: uppercase;
        border-bottom: 1px solid #eee;
        padding-bottom: 5px;
    }

    .field-row {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
    }

    .field-row label {
        min-width: 120px;
        font-size: 12px;
        color: #495057;
        text-align: right;
        padding-right: 10px;
    }

    .field-row input, .field-row .e-control {
        flex: 1;
    }

    .readonly-field {
        background-color: #e9ecef !important;
        border: none !important;
    }

    /* Legend Grid */
    .legend-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 3px;
    }

    .legend-item {
        padding: 5px 8px;
        text-align: center;
        font-size: 10px;
        border-radius: 3px;
        font-weight: 500;
    }

    /* Column Color Classes */
    .col-new {
        background-color: #DDF8FF !important;
    }

    .col-published {
        background-color: #D5E8BC !important;
    }

    .col-spec2 {
        background-color: #D6D3E3 !important;
    }

    .col-spec3 {
        background-color: #AEE8EA !important;
    }

    .col-spec4 {
        background-color: #ECE898 !important;
    }

    .col-spec5 {
        background-color: #D1C8C1 !important;
    }

    .col-spec6 {
        background-color: #D6C7FF !important;
    }

    .col-spec7 {
        background-color: #D6D3E3 !important;
    }

    .col-spec8 {
        background-color: #AEE8EA !important;
    }

    .col-spec9 {
        background-color: #ECE898 !important;
    }

    .col-spec10 {
        background-color: #D1C8C1 !important;
    }

    /* Filter row styling */
    .e-grid .e-filterbarcell input {
        background-color: #FFFFCC !important;
    }

    /* Dirty row */
    .dirty-row {
        background-color: #fff3cd !important;
    }

    .page-title {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin-bottom: 10px;
    }


    /* Grid container */
    .grid-container {
        border: 1px solid #dee2e6;
        border-radius: 4px;
        overflow: hidden;
    }

    /* Numeric input small */
    .small-numeric {
        max-width: 100px;
    }

    .e-grid .e-headercell {
        color: black;
        background-color: silver;
    }

    body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 16px; /* or use rem, e.g., 1rem */
    }

    /* Example for Syncfusion controls */
    .e-control, [class^="e-"] *:not([class*="e-icon"]) {
        font-size: 1.4rem !important;
        font-family: Arial, Helvetica, sans-serif;
    }

    .e-grid .e-rowcell .e-checkbox-wrapper .e-frame.e-icons {
        width: 20px;
        height: 20px;
    }

    .e-grid .e-rowcell .e-checkbox-wrapper .e-frame.e-icons.e-check {
        background-color: transparent;
        border-color: black;
        border-radius: 40px; /* Rounded corners */
        color: red;

    }
</style>

@if (IsLoading){
    <div class="loading">
        <SfSpinner @ref="SpinnerObj" Type="SpinnerType.Bootstrap4" Label="Loading Worksheet..."></SfSpinner>
    </div>
}

<div class="tabs-container">
    <div class="tab-buttons">
        <button class="@(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">
            .NET
        </button>
        <button class="@(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">
            VB6
        </button>
    </div>

    <div class="tab-content">
        @if (activeTab == 1){
            <!-- Toolbar -->
            <div class="toolbar-cntr">
                <SfToolbar>
                    <ToolbarItems>
                        @if (WorksheetView == "Estimating"){
                            <ToolbarItem>
                                <ToolbarItemTemplate>
                                    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" Content="Add"
                                              OnClick="OnAddClick"></SfButton>
                                </ToolbarItemTemplate>
                            </ToolbarItem>
                            <ToolbarItem>
                                <ToolbarItemTemplate>
                                    <SfButton CssClass="e-danger" IconCss="e-icons e-delete" Content="Remove"
                                              Disabled="@(SelectedRow == null)" OnClick="OnRemoveClick"></SfButton>
                                </ToolbarItemTemplate>
                            </ToolbarItem>
                            <ToolbarItem Type="ItemType.Separator"/>
                        }

                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <SfButton IconCss="e-icons e-print" Content="Preview"
                                          OnClick="OnPreviewClick"></SfButton>
                            </ToolbarItemTemplate>
                        </ToolbarItem>

                        @if (ShowCostsButton){
                            <ToolbarItem>
                                <ToolbarItemTemplate>
                                    <SfButton IconCss="e-icons e-list-unordered" Content="Costs"
                                              OnClick="OnCostsClick"></SfButton>
                                </ToolbarItemTemplate>
                            </ToolbarItem>
                        }

                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <SfButton CssClass="e-success" IconCss="e-icons e-save" Content="Save"
                                          Disabled="@(!mDirty)" OnClick="OnSaveClick"></SfButton>
                            </ToolbarItemTemplate>
                        </ToolbarItem>

                        @if (WorksheetView == "Estimating"){
                            <ToolbarItem>
                                <ToolbarItemTemplate>
                                    <SfButton IconCss="e-icons e-save" Content="Save As"
                                              OnClick="OnSaveAsClick"></SfButton>
                                </ToolbarItemTemplate>
                            </ToolbarItem>
                        }

                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <SfButton CssClass="e-info" IconCss="e-icons e-upload" Content="Publish"
                                          OnClick="OnPublishClick"></SfButton>
                            </ToolbarItemTemplate>
                        </ToolbarItem>

                        <ToolbarItem Type="ItemType.Separator"/>

                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <SfButton IconCss="e-icons e-refresh" Content="Rfrsh Costs"
                                          OnClick="OnRefreshCostsClick"></SfButton>
                            </ToolbarItemTemplate>
                        </ToolbarItem>

                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <SfButton IconCss="e-icons e-refresh" Content="Rfrsh Published"
                                          OnClick="OnRefreshPublishedClick"></SfButton>
                            </ToolbarItemTemplate>
                        </ToolbarItem>

                        <ToolbarItem Type="ItemType.Separator"/>

                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <SfButton IconCss="e-icons e-export-excel" Content="Export"
                                          OnClick="OnExcelExport"></SfButton>
                            </ToolbarItemTemplate>
                        </ToolbarItem>
                    </ToolbarItems>
                </SfToolbar>
            </div>
            <h4 class="page-title">@WorksheetView Worksheet @(WorksheetId > 0 ? $"(number {WorksheetId})" : "(New)")</h4>
            <!-- Header Panel -->
            <div class="header-panel">
                <div class="row">
                    <!-- Left: Worksheet Info -->
                    <div class="col-md-3">
                        <div class="header-section">
                            <div class="header-section-title">Worksheet Info</div>
                            <div class="field-row">
                                <label>Description</label>
                                <SfTextBox @bind-Value="@WorksheetDescription" Placeholder="Description"
                                           MaxLength="50"></SfTextBox>
                            </div>
                            <div class="field-row">
                                <label>Cost Basis</label>
                                <SfDropDownList TValue="int" TItem="CostBasisItem" @bind-Value="@CostBasisType"
                                                DataSource="@CostBasisList" Width="150px">
                                    <DropDownListFieldSettings Text="Name" Value="Id"></DropDownListFieldSettings>
                                </SfDropDownList>
                            </div>
                            <div class="field-row">
                                <label>Costs Effective</label>
                                <SfTextBox Value="@CostsEffectiveDate.ToString("MMM d, yyyy")" Readonly="true"
                                           CssClass="readonly-field"></SfTextBox>
                            </div>
                            @if (WorksheetView == "Estimating"){
                                <div class="field-row">
                                    <label>Published to Sales</label>
                                    <SfTextBox Value="@(SalesEffectiveDate?.ToString("MMM d, yyyy") ?? "")"
                                               Readonly="true" CssClass="readonly-field"></SfTextBox>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Center: Pricing Options -->
                    <div class="col-md-3">
                        <div class="header-section">
                            <div class="header-section-title">Pricing Options</div>
                            <div class="field-row">
                                <label>Round prices to</label>
                                <SfNumericTextBox TValue="decimal" @bind-Value="@RoundTo" Format="N0" Min="0"
                                                  Width="80px"></SfNumericTextBox>
                            </div>
                            @if (WorksheetView == "Estimating"){
                                <div class="field-row">
                                    <label>Incentive Cost %</label>
                                    <SfNumericTextBox TValue="decimal" @bind-Value="@IncentiveCostPercent" Format="N2"
                                                      Min="0" Max="100" Width="80px"
                                                      Enabled="@IncentiveCostEnabled"></SfNumericTextBox>
                                </div>
                            }
                            <div class="field-row">
                                <label>Layout</label>
                                <SfDropDownList TValue="string" TItem="string" @bind-Value="@SelectedLayout"
                                                DataSource="@LayoutList" Width="120px">
                                    <DropDownListEvents TValue="string" TItem="string"
                                                        ValueChange="OnLayoutChanged"></DropDownListEvents>
                                </SfDropDownList>
                            </div>
                            <div class="field-row">
                                <label></label>
                                <SfCheckBox @bind-Checked="@IsArchived" Label="Archive this sheet"></SfCheckBox>
                            </div>
                        </div>
                    </div>

                    <!-- Right-Center: Price Change -->
                    <div class="col-md-3">
                        <div class="header-section">
                            <div class="header-section-title">Price Change</div>
                            <div class="field-row">
                                <label>By Dollar Value</label>
                                <SfNumericTextBox TValue="decimal" @bind-Value="@DollarChange" Format="C2" Width="100px"
                                                  ValueChange="OnPriceChangeApply"></SfNumericTextBox>
                            </div>
                            <div class="field-row">
                                <label>Percent Increase</label>
                                <SfNumericTextBox TValue="decimal" @bind-Value="@PercentIncrease" Format="N2"
                                                  Width="100px"
                                                  ValueChange="OnPriceChangeApply"></SfNumericTextBox>
                            </div>
                            <div class="field-row">
                                <label>Percent Decrease</label>
                                <SfNumericTextBox TValue="decimal" @bind-Value="@PercentDecrease" Format="N2"
                                                  Width="100px"
                                                  ValueChange="OnPriceChangeApply"></SfNumericTextBox>
                            </div>
                        </div>
                    </div>

                    <!-- Far Right: Legend -->
                    <div class="col-md-3">
                        <div class="header-section">
                            <div class="header-section-title">Legend</div>
                            @if (WorksheetType == WorksheetTypes.DesignCenter){
                                <div class="legend-grid">
                                    @foreach (var item in LegendItems){
                                        <div class="legend-item @item.CssClass">@item.Name</div>
                                    }
                                </div>
                            }
                            else{
                                <div class="legend-grid">
                                    <div class="legend-item col-new">New</div>
                                    <div class="legend-item col-published">Published</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <!-- Main Data Grid -->
            <div class="grid-container">
                <SfGrid @ref="WorksheetGrid" DataSource="@WorksheetData" TValue="WorksheetRow"
                        AllowPaging="true" AllowSorting="true" AllowFiltering="true" AllowResizing="true"
                        AllowExcelExport="true" AllowSelection="true" EnableHover="true"
                        Height="1450" FrozenRows="1" FrozenColumns="4">

                    <GridEditSettings AllowAdding="true" AllowEditing="@(!IsReadOnly)" AllowDeleting="true"
                                      Mode="EditMode.Batch" ShowConfirmDialog="true"/>

                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar"
                                        Mode="FilterBarMode.Immediate"/>
                    <GridPageSettings PageSize="50" PageSizes="true"/>
                    <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Single"
                                           Mode="Syncfusion.Blazor.Grids.SelectionMode.Row"/>

                    <GridEvents TValue="WorksheetRow" OnBatchSave="OnBatchSave" RowSelected="OnRowSelected"
                                RowDeselected="OnRowDeselected" OnCellSave="OnCellSaved"
                                QueryCellInfo="OnQueryCellInfo"/>

                    <GridColumns>
                        <!-- Identity Columns -->
                        <GridColumn Field="@nameof(WorksheetRow.Community)" HeaderText="@CommunityLabel" Width="100"
                                    IsPrimaryKey="true" AllowEditing="false" Visible="false"/>
                        <GridColumn Field="@nameof(WorksheetRow.CommunityPhase)"
                                    HeaderText="@(CommunityLabel + " Phase")" Width="90" AllowEditing="false"
                                    Visible="false"/>
                        <GridColumn Field="@nameof(WorksheetRow.Model)" HeaderText="Model" Width="100"
                                    AllowEditing="false"/>
                        <GridColumn Field="@nameof(WorksheetRow.Assembly)" HeaderText="Assembly" Width="120"
                                    AllowEditing="false"/>

                        @if (WorksheetView == "Estimating"){
                            <GridColumn Field="@nameof(WorksheetRow.ModelDescription)" HeaderText="Model Desc"
                                        Width="150" AllowEditing="false"/>
                            <GridColumn Field="@nameof(WorksheetRow.Elevation)" HeaderText="Elevation" Width="90"
                                        AllowEditing="false" Visible="false"/>
                            <GridColumn Field="@nameof(WorksheetRow.OptionID)" HeaderText="Option" Width="100"
                                        AllowEditing="false" Visible="false"/>
                        }

                        <GridColumn Field="@nameof(WorksheetRow.Description)" HeaderText="Description" Width="200"/>
                        <GridColumn Field="@nameof(WorksheetRow.Category)" HeaderText="Category" Width="90"/>
                        <GridColumn Field="@nameof(WorksheetRow.CategoryDesc)" HeaderText="Category Desc" Width="120"
                                    AllowEditing="false"/>
                        <GridColumn Field="@nameof(WorksheetRow.IncludedOption)" HeaderText="Included" Width="80"
                                    DisplayAsCheckBox="true" AllowEditing="true"/>
                        <GridColumn Field="@nameof(WorksheetRow.Inactive)" HeaderText="Inactive" Width="75"
                                    DisplayAsCheckBox="true" EditType="EditType.BooleanEdit" AllowEditing="true"/>
                        <GridColumn Field="@nameof(WorksheetRow.ReadyToPublish)" HeaderText="Ready" Width="70"
                                    DisplayAsCheckBox="true" EditType="EditType.BooleanEdit" Visible="false"/>

                        <GridColumn Field="@nameof(WorksheetRow.Series)" HeaderText="Series" Width="90"
                                    Visible="false"/>

                        <!-- Dimensions -->
                        <GridColumn Field="@nameof(WorksheetRow.FloorArea)" HeaderText="Floor Area" Width="90"
                                    Format="N0" TextAlign="TextAlign.Right" Visible="false"/>
                        @if (WorksheetView == "Estimating"){
                            <GridColumn Field="@nameof(WorksheetRow.Bedrooms)" HeaderText="Beds" Width="60" Format="N0"
                                        TextAlign="TextAlign.Right" Visible="false"/>
                            <GridColumn Field="@nameof(WorksheetRow.Bathrooms)" HeaderText="Baths" Width="60"
                                        Format="N1" TextAlign="TextAlign.Right" Visible="false"/>
                            <GridColumn Field="@nameof(WorksheetRow.Style)" HeaderText="Style" Width="80"
                                        Visible="false"/>
                            <GridColumn Field="@nameof(WorksheetRow.ConstCutOff)" HeaderText="Const Cutoff" Width="100"
                                        Format="C0" TextAlign="TextAlign.Right" Visible="false"/>
                        }

                        <!-- Costs -->
                        <GridColumn Field="@nameof(WorksheetRow.LandCost)" HeaderText="Land Cost" Width="100"
                                    Format="C2" TextAlign="TextAlign.Right" Visible="false"/>
                        @if (WorksheetView == "Estimating"){
                            <GridColumn Field="@nameof(WorksheetRow.ConstructionCost)" HeaderText="Const Cost"
                                        Width="100" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false"
                                        Visible="false"/>
                            <GridColumn Field="@nameof(WorksheetRow.IncentiveCost)" HeaderText="Incent Cost" Width="100"
                                        Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Visible="false"/>
                        }
                        <GridColumn Field="@nameof(WorksheetRow.Cost)" HeaderText="Total Cost" Width="100" Format="C2"
                                    TextAlign="TextAlign.Right" AllowEditing="false"/>
                        <GridColumn Field="@nameof(WorksheetRow.CostPerFt)" HeaderText="Cost/SqFt" Width="90"
                                    Format="C2" TextAlign="TextAlign.Right" AllowEditing="false"/>

                        <!-- New Pricing (Primary Spec) -->
                        <GridColumn Field="@nameof(WorksheetRow.Pretax)" HeaderText="Pretax" Width="100" Format="C2"
                                    TextAlign="TextAlign.Right" Visible="false"
                                    CustomAttributes="@NewColAttrs"/>
                        <GridColumn Field="@nameof(WorksheetRow.Tax)" HeaderText="Tax" Width="80" Format="C2"
                                    TextAlign="TextAlign.Right" AllowEditing="false" Visible="false"
                                    CustomAttributes="@NewColAttrs"/>
                        <GridColumn Field="@nameof(WorksheetRow.Total)" HeaderText="Total" Width="100" Format="C2"
                                    TextAlign="TextAlign.Right" AllowEditing="false" Visible="false"
                                    CustomAttributes="@NewColAttrs"/>
                        <GridColumn Field="@nameof(WorksheetRow.Profit)" HeaderText="Profit" Width="90" Format="C2"
                                    TextAlign="TextAlign.Right" AllowEditing="false"
                                    CustomAttributes="@NewColAttrs"/>
                        <GridColumn Field="@nameof(WorksheetRow.Markup)" HeaderText="Markup %" Width="85" Format="N2"
                                    TextAlign="TextAlign.Right"
                                    CustomAttributes="@NewColAttrs"/>
                        <GridColumn Field="@nameof(WorksheetRow.Margin)" HeaderText="Margin %" Width="85" Format="N2"
                                    TextAlign="TextAlign.Right"
                                    CustomAttributes="@NewColAttrs"/>
                        @if (WorksheetView == "Estimating"){
                            <GridColumn Field="@nameof(WorksheetRow.InSpec)" HeaderText="In Spec" Width="70"
                                        DisplayAsCheckBox="true" EditType="EditType.BooleanEdit" Visible="false"
                                        CustomAttributes="@NewColAttrs"/>
                        }

                        <GridColumn Field="@nameof(WorksheetRow.IncentiveRetail)" HeaderText="Incent Retail" Width="100"
                                    Format="C2" TextAlign="TextAlign.Right" Visible="false"/>

                        <!-- Change Order Pricing -->
                        <GridColumn Field="@nameof(WorksheetRow.COPretax)" HeaderText="CO Pretax" Width="100"
                                    Format="C2" TextAlign="TextAlign.Right" Visible="false"/>
                        <GridColumn Field="@nameof(WorksheetRow.COTax)" HeaderText="CO Tax" Width="80" Format="C2"
                                    TextAlign="TextAlign.Right" AllowEditing="false" Visible="false"/>
                        <GridColumn Field="@nameof(WorksheetRow.COTotal)" HeaderText="CO Total" Width="100" Format="C2"
                                    TextAlign="TextAlign.Right" AllowEditing="false" Visible="false"/>
                        <GridColumn Field="@nameof(WorksheetRow.COMarkup)" HeaderText="CO Markup %" Width="95"
                                    Format="N2" TextAlign="TextAlign.Right" Visible="false"/>

                        <!-- Published Pricing -->
                        <GridColumn Field="@nameof(WorksheetRow.PublishedPretax)" HeaderText="Pub Pretax" Width="100"
                                    Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Visible="false"
                                    CustomAttributes="@PubColAttrs"/>
                        <GridColumn Field="@nameof(WorksheetRow.PublishedTax)" HeaderText="Pub Tax" Width="80"
                                    Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Visible="false"
                                    CustomAttributes="@PubColAttrs"/>
                        <GridColumn Field="@nameof(WorksheetRow.PublishedPrice)" HeaderText="Pub Price" Width="100"
                                    Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Visible="false"
                                    CustomAttributes="@PubColAttrs"/>
                        <GridColumn Field="@nameof(WorksheetRow.PublishedProfit)" HeaderText="Pub Profit" Width="95"
                                    Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Visible="false"
                                    CustomAttributes="@PubColAttrs"/>
                        <GridColumn Field="@nameof(WorksheetRow.PublishedMarkup)" HeaderText="Pub Markup %" Width="100"
                                    Format="N2" TextAlign="TextAlign.Right" AllowEditing="false" Visible="false"
                                    CustomAttributes="@PubColAttrs"/>
                        <GridColumn Field="@nameof(WorksheetRow.PublishedMargin)" HeaderText="Pub Margin %" Width="100"
                                    Format="N2" TextAlign="TextAlign.Right" AllowEditing="false" Visible="false"
                                    CustomAttributes="@PubColAttrs"/>
                        <GridColumn Field="@nameof(WorksheetRow.PublishedCOPrice)" HeaderText="Pub CO Price" Width="100"
                                    Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Visible="false"
                                    CustomAttributes="@PubColAttrs"/>
                        <GridColumn Field="@nameof(WorksheetRow.PublishedIncentive)" HeaderText="Pub Incentive"
                                    Width="100" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false"
                                    Visible="false"
                                    CustomAttributes="@PubColAttrs"/>

                        <GridColumn Field="@nameof(WorksheetRow.PricePerFt)" HeaderText="Price/SqFt" Width="90"
                                    Format="C2" TextAlign="TextAlign.Right" AllowEditing="false"/>
                        <GridColumn Field="@nameof(WorksheetRow.RoundTo)" HeaderText="Round To" Width="80" Format="N0"
                                    TextAlign="TextAlign.Right"/>

                        <!-- Additional Fields -->
                        <GridColumn Field="@nameof(WorksheetRow.AssemblyUOM)" HeaderText="UOM" Width="70"
                                    Visible="false"/>
                        <GridColumn Field="@nameof(WorksheetRow.Color)" HeaderText="Color" Width="90" Visible="false"/>
                        <GridColumn Field="@nameof(WorksheetRow.Location)" HeaderText="Location" Width="90"
                                    Visible="false"/>
                        <GridColumn Field="@nameof(WorksheetRow.Qty)" HeaderText="Qty" Width="60" Format="N0"
                                    TextAlign="TextAlign.Right" Visible="false"/>

                        @if (WorksheetView == "Estimating"){
                            <GridColumn Field="@nameof(WorksheetRow.Notes)" HeaderText="Notes" Width="150">
                                <Template>
                                    @{ var data = context as WorksheetRow; }
                                    <span title="@data?.Notes">@TruncateText(data?.Notes, 20)</span>
                                    <SfButton CssClass="e-small e-flat" IconCss="e-icons e-edit"
                                              OnClick="@(() => OnEditText(data, "Notes"))"></SfButton>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorksheetRow.Comments)" HeaderText="Comments" Width="150">
                                <Template>
                                    @{ var data = context as WorksheetRow; }
                                    <span title="@data?.Comments">@TruncateText(data?.Comments, 20)</span>
                                    <SfButton CssClass="e-small e-flat" IconCss="e-icons e-edit"
                                              OnClick="@(() => OnEditText(data, "Comments"))"></SfButton>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorksheetRow.JCExtra)" HeaderText="JC Extra" Width="90"
                                        Visible="false"/>
                        }


                        @if (ShowIncludeTax){
                            <GridColumn Field="@nameof(WorksheetRow.IncludeTax)" HeaderText="Tax Incl" Width="75"
                                        DisplayAsCheckBox="true" EditType="EditType.BooleanEdit"/>
                        }

                        <GridColumn Field="@nameof(WorksheetRow.RowState)" Visible="false"/>
                    </GridColumns>
                </SfGrid>
            </div>
        }
        else if (activeTab == 2){
            <div class="panel">
                <img src="images/VB6/Screen_IndexPricingWorkSheet.png" class="task-icon-vb6"/>
            </div>
        }
    </div>
</div>

