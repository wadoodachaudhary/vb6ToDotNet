        if (EditingTextRow != null){
            if (EditingTextField == "Notes") EditingTextRow.Notes = EditingText;
            else EditingTextRow.Comments = EditingText;
            EditingTextRow.RowState = "DIRTY";
            mDirty = true;
        }
        IsTextDialogVisible = false;
        StateHasChanged();
    }

    // === Add Assembly ===
    private async Task OnAddModelChanged(ChangeEventArgs<string, ModelItem> args){
        if (string.IsNullOrEmpty(args.Value)){
            AssemblyList.Clear();
            return;
        }
        var assemblies = await db.QueryAsync($"SELECT Assembly, Description FROM tblDBAssemblyMaster WHERE DivisionID={DivisionID} AND Model='{args.Value}' ORDER BY Assembly");
        AssemblyList = assemblies.Select(r => new AssemblyItem { Assembly = r["Assembly"]?.ToString() ?? "", Description = $"{r["Assembly"]} - {r["Description"]}" }).ToList();
    }

