    private void CalculateDerivedFields(WorksheetRow row){
        row.Total = row.Pretax + row.Tax;
        row.COTotal = row.COPretax + row.COTax;
        row.Profit = row.Pretax - row.Cost;
        if (row.FloorArea > 0){
            row.CostPerFt = row.ConstructionCost / row.FloorArea;
            row.PricePerFt = row.Pretax / row.FloorArea;
        }
    }

    private async Task<bool> SaveDataAsync(){
        if (!mDirty) return true;
        IsLoading = true;
        StateHasChanged();
        try{
            // Update master
            await db.ExecuteAsync($@"
                UPDATE tblSalesSheetMaster SET
                    Description=@Description, CostBasisType=@CostBasisType, 
                    IncentiveCostPercent=@IncentiveCostPercent, Inactive=@Inactive
                WHERE Worksheet={WorksheetId}",
                new { WorksheetDescription, CostBasisType, IncentiveCostPercent, Inactive = IsArchived });

            // Update dirty details
            foreach (var row in WorksheetData.Where(r => r.RowState == "DIRTY")){
                await db.ExecuteAsync($@"
                    UPDATE tblSalesSheetDetails SET
                        Description=@Description, Notes=@Notes, Comments=@Comments, Category=@Category,
                        Series=@Series, Style=@Style, FloorArea=@FloorArea, Bedrooms=@Bedrooms, Bathrooms=@Bathrooms,
                        LandCost=@LandCost, Pretax=@Pretax, Tax=@Tax, Markup=@Markup, Margin=@Margin, Roundto=@RoundTo,
                        COPretax=@COPretax, COTax=@COTax, COMarkup=@COMarkup, Qty=@Qty, Color=@Color, Location=@Location,
                        IncludedOption=@IncludedOption, Inactive=@Inactive, ReadyToPublish=@ReadyToPublish,
                        IncludeTax=@IncludeTax, IncludedInSpec=@InSpec
                    WHERE Worksheet={WorksheetId} AND Community=@Community AND Assembly=@Assembly AND ISNULL(OptionID,'')=@OptionID",
                    new {
                        row.Description, row.Notes, row.Comments, row.Category, row.Series, row.Style,
                        row.FloorArea, row.Bedrooms, row.Bathrooms, row.LandCost, row.Pretax, row.Tax,
                        row.Markup, row.Margin, row.RoundTo, row.COPretax, row.COTax, row.COMarkup,
                        row.Qty, row.Color, row.Location, row.IncludedOption, row.Inactive, row.ReadyToPublish,
                        row.IncludeTax, row.InSpec, row.Community, row.Assembly, OptionID = row.OptionID ?? ""
                    });
                row.RowState = "CLEAN";
            }
            mDirty = false;
            await JSRuntime.InvokeVoidAsync("alert", "Worksheet saved successfully.");
            return true;
        }
        catch (Exception ex){
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving: {ex.Message}");
            return false;
        }
        finally{
            IsLoading = false;
            StateHasChanged();
        }
    }

