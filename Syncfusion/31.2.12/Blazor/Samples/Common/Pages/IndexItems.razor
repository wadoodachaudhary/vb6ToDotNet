                    ISNULL(inv.Phase, '') + CASE WHEN inv.Phase IS NOT NULL THEN '/' + inv.Item + ' - ' + ISNULL(inv.Description, '') ELSE '' END AS InverseItemDesc
                FROM tblPhaseItem i
