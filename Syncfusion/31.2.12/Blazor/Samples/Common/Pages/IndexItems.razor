    private async Task OnCreateNewItem(){
        if (string.IsNullOrWhiteSpace(NewItemPhase) || string.IsNullOrWhiteSpace(NewItemCode)){
            await JSRuntime.InvokeVoidAsync("alert", "Phase and Item Code are required.");
            return;
        }
        try{
            // Check if item exists
            var exists = await db.ExecuteScalarAsync<int>($@"
                SELECT COUNT(*) FROM tblPhaseItem 
                WHERE DivisionID = {DivisionID} AND Phase = @Phase AND Item = @Item",
                new { Phase = NewItemPhase, Item = NewItemCode });
            if (exists > 0){
                await JSRuntime.InvokeVoidAsync("alert", "This item already exists.");
                return;
            }

            // Insert new item
            await db.ExecuteAsync($@"
                INSERT INTO tblPhaseItem (DivisionID, Phase, Item, CostCategory, Description, ConversionFactor)
                VALUES ({DivisionID}, @Phase, @Item, @CostCategory, @Description, 1)",
                new {
                    Phase = NewItemPhase,
                    Item = NewItemCode,
                    CostCategory = NewItemCostCategory,
                    Description = NewItemDescription
                });
            IsNewItemDialogVisible = false;
            await LoadItemsAsync();
        }
        catch (Exception ex){
            await JSRuntime.InvokeVoidAsync("alert", $"Error creating item: {ex.Message}");
        }
    }

