@page "/items"

@namespace BlazorDemos.Pages

@using Syncfusion.Blazor.TreeGrid
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Spinner
@using Syncfusion.Blazor.DropDowns
@using System;
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Navigations
@using System.IO
@using System.Collections.Generic
@using System.Data
@using System.Dynamic
@using BlazorDemos.Pages.Grid
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager UriHelper
@using hyphen_data
@using Microsoft.Data.SqlClient
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Data;
@using Syncfusion.Blazor.SplitButtons
@using ChangeEventArgs = Syncfusion.Blazor.Navigations.ChangeEventArgs

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@*Hidden:Lines*@
@inherits SampleBaseComponent;
@*End:Hidden*@

<style>
    .tabs-container {
        margin: 20px auto;
        font-family: sans-serif;
    }


    .task-icon-vb6 {
        width: 2000px;
        height: auto;
        display: block;

    }

    .tab-buttons {
        display: flex;
        border-bottom: 2px solid #ddd;
    }

    .tab-buttons button {
        padding: 12px 24px;
        border: none;
        background: #f0f0f0;
        cursor: pointer;
        font-size: 16px;
        transition: background 0.2s;
    }

    .tab-buttons button:hover {
        background: #e0e0e0;
    }

    .tab-buttons button.active {
        background: #fff;
        border-bottom: 2px solid #007bff;
        margin-bottom: -2px;
        color: #007bff;
        font-weight: bold;
    }

    .tab-content {
        padding: 20px;
        border: 1px solid #ddd;
        border-top: none;
        background: #fff;
    }

    .panel {
        text-align: center;
    }

    .panel img {
        max-width: 100%;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .toolbar-cntr {
        padding-top: 12px;
        padding-bottom: 12px;
        border-top: 1px solid #c9c9c9;
        border-bottom: 1px solid #c9c9c9;
        margin-bottom: 10px;
    }

    .tool-label {
        width: 100%;
        display: block;
    }

    .e-btn {
        margin-right: 5px;
    }

    .tbar-icon {
        width: 24px;
        height: 24px;
        margin-bottom: 4px;
    }

    .loading {
        position: absolute;
        height: 92%;
        width: 100%;
        background-color: rgba(1, 1, 1, 0.2);
        z-index: 10000;
        display: flex;
        align-items: center;
        padding-left: 44%;
    }

    /* Toolbar styling */
    .toolbar-cntr {
        padding-top: 12px;
        padding-bottom: 12px;
        border-top: 1px solid #c9c9c9;
        border-bottom: 1px solid #c9c9c9;
        margin-bottom: 10px;
    }

    .tool-label {
        width: 100%;
        display: block;
    }

    .e-btn {
        margin-right: 5px;
    }

    /* Split panel layout */
    .split-container {
        display: flex;
        height: calc(100vh - 200px);
        min-height: 500px;
    }

    .phases-panel {
        width: 380px;
        min-width: 200px;
        max-width: 600px;
        border-right: 3px solid #c9c9c9;
        overflow: auto;
        resize: horizontal;
    }

    .items-panel {
        flex: 1;
        overflow: auto;
        padding-left: 10px;
    }

    /* Tree grid styling */
    .e-treegrid .e-rowcell.e-active {
        background-color: #e3f2fd !important;
    }

    /* Filter row styling */
    .e-grid .e-filterbarcell input {
        background-color: #FFFFCC !important;
        font-weight: bold;
    }

    /* Selected row styling */
    .e-grid .e-row.e-selected .e-rowcell {
        background-color: #e3f2fd !important;
    }

    /* Dirty row indicator */
    .dirty-row {
        background-color: #fff3cd !important;
    }

    /* Delete row indicator */
    .delete-row {
        background-color: #f8d7da !important;
        text-decoration: line-through;
    }

    .page-title {
        font-size: 24px;
        font-weight: 600;
        margin-bottom: 15px;
        color: #333;
    }

    /* Phase tree node selected */
    .phase-selected {
        background-color: #1976d2 !important;
        color: white !important;
        font-weight: bold;
    }

    .phase-item {
        padding: 8px 12px;
        cursor: pointer;
        border-bottom: 1px solid #eee;
    }

    .phase-item:hover {
        background-color: #f5f5f5;
    }

    .phase-group {
        font-weight: bold;
        background-color: #f0f0f0;
    }

    .expand-icon {
        cursor: pointer;
        margin-right: 8px;
    }


    /* Custom expand/collapse icons */
    .e-treegrid .e-treegridexpand::before {
        content: '\e823'; /* Syncfusion folder-open icon */
        font-family: 'e-icons';
        color: #1976d2;
    }

    .e-treegrid .e-treegridcollapse::before {
        content: '\e7da'; /* Syncfusion folder icon */
        font-family: 'e-icons';
        color: #ff9800;
    }

    /* Alternative: Use plus/minus icons */
    .e-treegrid.plus-minus .e-treegridexpand::before {
        content: '\e738'; /* minus icon */
        font-family: 'e-icons';
    }

    .e-treegrid.plus-minus .e-treegridcollapse::before {
        content: '\e759'; /* plus icon */
        font-family: 'e-icons';
    }

    /* Alternative: Use chevron icons */
    .e-treegrid.chevron .e-treegridexpand::before {
        content: '\e729'; /* chevron-down */
        font-family: 'e-icons';
    }

    .e-treegrid.chevron .e-treegridcollapse::before {
        content: '\e728'; /* chevron-right */
        font-family: 'e-icons';
    }

    /* Row icon based on level */
    .e-treegrid .e-rowcell .e-icons.e-treegridexpand,
    .e-treegrid .e-rowcell .e-icons.e-treegridcollapse {
        font-size: 16px;
        margin-right: 5px;
    }

    /* Add node type icons */
    .phase-group-icon::before {
        content: '\e702'; /* folder icon */
        font-family: 'e-icons';
        color: #ff9800;
        margin-right: 8px;
    }

    .phase-item-icon::before {
        content: '\e7c2'; /* document icon */
        font-family: 'e-icons';
        color: #4caf50;
        margin-right: 8px;
    }
    /* Phase tree node selected */
    .e-columnheader, .e-headercell, .e-grid th.e-headercell, .e-grid .e-headertext {
        background-color:#d5dadc; /* Normal state */
        color: #333; /* Text color */
        font-size: 16px;
    }
</style>




@if (IsLoading){
    <div class="loading">
        <SfSpinner @ref="SpinnerObj" Type="SpinnerType.Bootstrap4" Label="Loading Items..."></SfSpinner>
    </div>
}
<div class="tabs-container">
    <div class="tab-buttons">
        <button class="@(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">
            .NET
        </button>
        <button class="@(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">
            VB6
        </button>
    </div>

    <div class="tab-content">
        @if (activeTab == 1){
            <div class="toolbar-cntr">
                <SfToolbar>
                    <ToolbarItems>
                        <!-- Save -->
                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <button class="e-btn e-tbar-btn"
                                        disabled="@(!mDirty)"
                                        @onclick="OnSaveClick">
                                    <span class="e-icons e-save"></span>
                                    <span class="tool-label">Save</span>
                                </button>
                            </ToolbarItemTemplate>
                        </ToolbarItem>

                        <!-- View Dropdown -->
                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <SfDropDownButton Content="View">
                                    <DropDownButtonEvents ItemSelected="OnViewSelected"></DropDownButtonEvents>
                                    <DropDownButtonItems>
                                        <DropDownButtonItem Text="Group and Phase"></DropDownButtonItem>
                                        <DropDownButtonItem Text="Purchase Order"></DropDownButtonItem>
                                        <DropDownButtonItem Text="Cost Code"></DropDownButtonItem>
                                    </DropDownButtonItems>
                                </SfDropDownButton>
                            </ToolbarItemTemplate>
                        </ToolbarItem>

                        <ToolbarItem Separator="true"/>

                        <!-- New Item -->
                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <button class="e-btn e-tbar-btn" @onclick="OnNewItemClick">
                                    <span class="e-icons e-plus"></span>
                                    <span class="tool-label">New Item</span>
                                </button>
                            </ToolbarItemTemplate>
                        </ToolbarItem>

                        <!-- Duplicate -->
                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <button class="e-btn e-tbar-btn"
                                        disabled="@(SelectedItem == null)"
                                        @onclick="OnDuplicateClick">
                                    <span class="e-icons e-copy"></span>
                                    <span class="tool-label">Duplicate</span>
                                </button>
                            </ToolbarItemTemplate>
                        </ToolbarItem>

                        <!-- Delete -->
                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <button class="e-btn e-tbar-btn e-danger"
                                        disabled="@(SelectedItem == null)"
                                        @onclick="OnDeleteClick">
                                    <span class="e-icons e-delete"></span>
                                    <span class="tool-label">Delete</span>
                                </button>
                            </ToolbarItemTemplate>
                        </ToolbarItem>

                        <ToolbarItem Separator="true"/>

                        <!-- Excel Export -->
                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <button class="e-btn e-tbar-btn" @onclick="OnExcelExport">
                                    <span class="e-icons e-export-excel"></span>
                                    <span class="tool-label">Export</span>
                                </button>
                            </ToolbarItemTemplate>
                        </ToolbarItem>

                        <!-- Excel Import -->
                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <button class="e-btn e-tbar-btn" @onclick="OnExcelImport">
                                    <span class="e-icons e-import"></span>
                                    <span class="tool-label">Import</span>
                                </button>
                            </ToolbarItemTemplate>
                        </ToolbarItem>

                        <!-- Refresh -->
                        <ToolbarItem>
                            <ToolbarItemTemplate>
                                <button class="e-btn e-tbar-btn" @onclick="OnRefreshClick">
                                    <span class="e-icons e-refresh"></span>
                                    <span class="tool-label">Refresh</span>
                                </button>
                            </ToolbarItemTemplate>
                        </ToolbarItem>
                    </ToolbarItems>
                </SfToolbar>
            </div>
            <h3 class="page-title">Item Database - @CurrentViewName</h3>
            <div class="split-container">
                <!-- Left Panel: Phases Tree -->
                <div class="phases-panel">
                    <div
                        style="padding: 10px; background-color: #f5f5f5; border-bottom: 1px solid #ddd; font-weight: bold;">
                        @CurrentViewName
                        <SfButton CssClass="e-small e-flat" IconCss="e-icons e-expand"
                                  OnClick="OnExpandAll" title="Expand All"></SfButton>
                    </div>

                    <SfTreeGrid @ref="PhasesTreeGrid" DataSource="@TreePhaseData"
                                IdMapping="NodeID"
                                EnableCollapseAll="true"
                                ParentIdMapping="ParentID" TreeColumnIndex="1"
                                TValue="PhaseTreeData"
                                AllowSelection="true"
                                Height="100%">
                        <TreeGridSelectionSettings
                            Mode="Syncfusion.Blazor.Grids.SelectionMode.Row"></TreeGridSelectionSettings>
                        <TreeGridEvents TValue="PhaseTreeData" RowSelected="OnPhaseSelected"
                                        Collapsed="OnNodeCollapsed"
                                        Expanded="OnNodeExpanded">

                        </TreeGridEvents>
                        <TreeGridColumns>
                            <TreeGridColumn Field="NodeID" HeaderText="" Width="20" Visible="false"></TreeGridColumn>
                            <TreeGridColumn Field="Node" HeaderText="Task Name" Width="300"></TreeGridColumn>

                        </TreeGridColumns>
                    </SfTreeGrid>
                </div>

                <!-- Right Panel: Items Grid -->
                <div class="items-panel">
                    <SfGrid @ref="ItemsGrid"
                            DataSource="@ItemsData"
                            TValue="ItemRow"
                            AllowPaging="true"
                            AllowSorting="true"
                            AllowFiltering="true"
                            AllowResizing="true"
                            AllowExcelExport="true"
                            AllowSelection="true"
                            AllowMultiSorting="true"
                            EnableHover="true"
                            Height="100%"
                            FrozenRows="1">

                        <GridEditSettings AllowAdding="true"
                                          AllowEditing="true"
                                          AllowDeleting="true"
                                          Mode="Syncfusion.Blazor.Grids.EditMode.Batch"
                                          ShowConfirmDialog="true">
                        </GridEditSettings>

                        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar"
                                            Mode="FilterBarMode.Immediate">
                        </GridFilterSettings>

                        <GridPageSettings PageSize="50" PageSizes="true"></GridPageSettings>

                        <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"
                                               Mode="Syncfusion.Blazor.Grids.SelectionMode.Row">
                        </GridSelectionSettings>

                        <GridEvents TValue="ItemRow"
                                    OnBatchSave="OnBatchSave"
                                    RowSelected="OnItemSelected"
                                    RowDeselected="OnItemDeselected"
                                    OnCellSave="OnCellSaved"
                                    OnActionBegin="OnActionBegin"
                                    QueryCellInfo="OnQueryCellInfo">
                        </GridEvents>

                        <GridColumns>
                            <GridColumn Field="@nameof(ItemRow.Phase)" HeaderText="Phase" Width="100"
                                        AllowEditing="false"
                                        IsPrimaryKey="true"></GridColumn>
                            <GridColumn Field="@nameof(ItemRow.Item)" HeaderText="Item" Width="100"
                                        AllowEditing="false"></GridColumn>
                            <GridColumn Field="@nameof(ItemRow.CostCategory)" HeaderText="Type" Width="60"
                                        AllowEditing="false"></GridColumn>
                            <GridColumn Field="@nameof(ItemRow.ItemDesc)" HeaderText="Description" Width="250">
                                <EditTemplate>
                                    @{
                                        var data = context as ItemRow;
                                        <div style="display: flex; align-items: center;">
                                            <SfTextBox @bind-Value="data.ItemDesc"
                                                       Placeholder="Description"></SfTextBox>
                                            <SfButton CssClass="e-small e-flat" IconCss="e-icons e-edit"
                                                      OnClick="@(() => OnEditDescription(data))"></SfButton>
                                        </div>
                                    }
                                </EditTemplate>
                            </GridColumn>

                            <GridColumn Field="@nameof(ItemRow.POIndex)" HeaderText="PO Index" Width="100">
                                <EditTemplate>
                                    @{
                                        var data = context as ItemRow;
                                        <SfDropDownList TValue="string" TItem="POIndexItem"
                                                        @bind-Value="data.POIndex"
                                                        DataSource="@POIndexList"
                                                        AllowFiltering="true"
                                                        Placeholder="Select PO Index">
                                            <DropDownListFieldSettings Text="Description"
                                                                       Value="POIndex"></DropDownListFieldSettings>
                                            <DropDownListEvents TValue="string" TItem="POIndexItem"
                                                                ValueChange="@((e) => OnPOIndexChanged(e, data))"></DropDownListEvents>
                                        </SfDropDownList>
                                    }
                                </EditTemplate>
                            </GridColumn>

                            <GridColumn Field="@nameof(ItemRow.POIndexDescription)" HeaderText="PO Description"
                                        Width="150"
                                        AllowEditing="false"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.JCCostCode)" HeaderText="Cost Code" Width="100">
                                <EditTemplate>
                                    @{
                                        var data = context as ItemRow;
                                        <SfDropDownList TValue="string" TItem="CostCodeItem"
                                                        @bind-Value="data.JCCostCode"
                                                        DataSource="@CostCodeList"
                                                        AllowFiltering="true"
                                                        Placeholder="Select Code">
                                            <DropDownListFieldSettings Text="Description"
                                                                       Value="CostCode"></DropDownListFieldSettings>
                                            <DropDownListEvents TValue="string" TItem="CostCodeItem"
                                                                ValueChange="@((e) => OnCostCodeChanged(e, data))"></DropDownListEvents>
                                        </SfDropDownList>
                                    }
                                </EditTemplate>
                            </GridColumn>

                            <GridColumn Field="@nameof(ItemRow.JCCostCodeDesc)" HeaderText="Cost Code Desc" Width="150"
                                        AllowEditing="false"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.JCCategory)" HeaderText="Category" Width="100">
                                <EditTemplate>
                                    @{
                                        var data = context as ItemRow;
                                        <SfDropDownList TValue="string" TItem="CategoryItem"
                                                        @bind-Value="data.JCCategory"
                                                        DataSource="@CategoryList"
                                                        AllowFiltering="true"
                                                        Placeholder="Select Category">
                                            <DropDownListFieldSettings Text="Description"
                                                                       Value="Category"></DropDownListFieldSettings>
                                            <DropDownListEvents TValue="string" TItem="CategoryItem"
                                                                ValueChange="@((e) => OnCategoryChanged(e, data))"></DropDownListEvents>
                                        </SfDropDownList>
                                    }
                                </EditTemplate>
                            </GridColumn>

                            <GridColumn Field="@nameof(ItemRow.JCCategoryDesc)" HeaderText="Category Desc" Width="150"
                                        AllowEditing="false"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.TaxGroup)" HeaderText="Tax Group" Width="100">
                                <EditTemplate>
                                    @{
                                        var data = context as ItemRow;
                                        <SfDropDownList TValue="string" TItem="TaxGroupItem"
                                                        @bind-Value="data.TaxGroup"
                                                        DataSource="@TaxGroupList"
                                                        AllowFiltering="true"
                                                        Placeholder="Select Tax Group">
                                            <DropDownListFieldSettings Text="Description"
                                                                       Value="TaxGroup"></DropDownListFieldSettings>
                                        </SfDropDownList>
                                    }
                                </EditTemplate>
                            </GridColumn>

                            <GridColumn Field="@nameof(ItemRow.TakeoffUOM)" HeaderText="Takeoff UOM"
                                        Width="100"></GridColumn>
                            <GridColumn Field="@nameof(ItemRow.OrderUOM)" HeaderText="Order UOM"
                                        Width="100"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.ConversionFactor)" HeaderText="Conversion" Width="100"
                                        Format="N4" TextAlign="TextAlign.Right"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.Price)" HeaderText="Price" Width="100"
                                        Format="C2" TextAlign="TextAlign.Right"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.WastePercent)" HeaderText="Waste %" Width="80"
                                        Format="N0" TextAlign="TextAlign.Right"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.RoundDir)" HeaderText="Round Dir" Width="80"
                                        TextAlign="TextAlign.Right"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.RoundTo)" HeaderText="Round To" Width="80"
                                        Format="N2" TextAlign="TextAlign.Right"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.PartNumber)" HeaderText="Part Number"
                                        Width="120"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.Formula)" HeaderText="Formula" Width="150">
                                <Template>
                                    @{
                                        var data = context as ItemRow;
                                        <span title="@data?.Formula">@TruncateText(data?.Formula, 20)</span>
                                        <SfButton CssClass="e-small e-flat" IconCss="e-icons e-edit"
                                                  OnClick="@(() => OnEditFormula(data))"></SfButton>
                                    }
                                </Template>
                            </GridColumn>

                            <GridColumn Field="@nameof(ItemRow.Notes)" HeaderText="Notes" Width="150">
                                <Template>
                                    @{
                                        var data = context as ItemRow;
                                        <span title="@data?.Notes">@TruncateText(data?.Notes, 20)</span>
                                        <SfButton CssClass="e-small e-flat" IconCss="e-icons e-edit"
                                                  OnClick="@(() => OnEditNotes(data))"></SfButton>
                                    }
                                </Template>
                            </GridColumn>

                            <GridColumn Field="@nameof(ItemRow.OptionID)" HeaderText="Option ID"
                                        Width="100"></GridColumn>
                            <GridColumn Field="@nameof(ItemRow.OptionCategory)" HeaderText="Option Category"
                                        Width="120"></GridColumn>
                            <GridColumn Field="@nameof(ItemRow.Color)" HeaderText="Color" Width="100"></GridColumn>
                            <GridColumn Field="@nameof(ItemRow.Location)" HeaderText="Location"
                                        Width="100"></GridColumn>
                            <GridColumn Field="@nameof(ItemRow.RetailPretax)" HeaderText="Retail Pretax" Width="100"
                                        Format="C2" TextAlign="TextAlign.Right"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.IsQuote)" HeaderText="Quote" Width="70"
                                        DisplayAsCheckBox="true" EditType="EditType.BooleanEdit"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.UseInFieldPO)" HeaderText="Field PO" Width="80"
                                        DisplayAsCheckBox="true" EditType="EditType.BooleanEdit"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.AltJCCostCode)" HeaderText="Alt Cost Code" Width="100"
                                        Visible="false"></GridColumn>
                            <GridColumn Field="@nameof(ItemRow.AltJCCostCodeDesc)" HeaderText="Alt Cost Code Desc"
                                        Width="150"
                                        Visible="false"></GridColumn>
                            <GridColumn Field="@nameof(ItemRow.AltJCCategory)" HeaderText="Alt Category" Width="100"
                                        Visible="false"></GridColumn>
                            <GridColumn Field="@nameof(ItemRow.AltJCCategoryDesc)" HeaderText="Alt Category Desc"
                                        Width="150"
                                        Visible="false"></GridColumn>

                            <GridColumn Field="@nameof(ItemRow.InverseItemDesc)" HeaderText="Inverse Item" Width="150"
                                        AllowEditing="false">
                                <Template>
                                    @{
                                        var data = context as ItemRow;
                                        <span>@data?.InverseItemDesc</span>
                                        <SfButton CssClass="e-small e-flat" IconCss="e-icons e-search"
                                                  OnClick="@(() => OnSelectInverseItem(data))"></SfButton>
                                    }
                                </Template>
                            </GridColumn>

                            <GridColumn Field="@nameof(ItemRow.PriceLink)" HeaderText="Price Link" Width="100"
                                        Visible="false"></GridColumn>

                            <!-- Hidden RowState column -->
                            <GridColumn Field="@nameof(ItemRow.RowState)" HeaderText="" Width="1"
                                        Visible="false"></GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>
            </div>
        }
        else if (activeTab == 2){
            <div class="panel">
                <img src="images/VB6/Screen_IndexItems.png" class="task-icon-vb6"/>
            </div>
        }
    </div>
</div>
<!-- Notes/Description Dialog -->
<SfDialog bind-Visible="@IsTextDialogVisible"
          Width="600px"
          Header="@TextDialogTitle"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <SfTextBox bind-Value="@EditingText"
                       Multiline="true"
                       Placeholder="Enter text..."
                       CssClass="e-multi-line-input"
                       HtmlAttributes="@(new Dictionary<string, object> { { "rows", "10" } })">
            </SfTextBox>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="OK" IsPrimary="true" OnClick="OnTextDialogOk"></DialogButton>
        <DialogButton Content="Cancel" OnClick="OnTextDialogCancel"></DialogButton>
    </DialogButtons>
</SfDialog>

<!-- Formula Editor Dialog -->
<SfDialog bind-Visible="@IsFormulaDialogVisible"
          Width="700px"
          Header="Formula Editor"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="mb-3">
                <label>Formula:</label>
                <SfTextBox @bind-Value="@EditingFormula"
                           Multiline="true"
                           Placeholder="Enter formula..."
                           HtmlAttributes="@(new Dictionary<string, object> { { "rows", "5" } })">
                </SfTextBox>
            </div>
            <div class="text-muted">
                <small>Available functions: AREA, LENGTH, WIDTH, QTY, PITCH, etc.</small>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="OK" IsPrimary="true" OnClick="OnFormulaDialogOk"></DialogButton>
        <DialogButton Content="Cancel" OnClick="OnFormulaDialogCancel"></DialogButton>
    </DialogButtons>
</SfDialog>

<!-- New Item Dialog -->
<SfDialog bind-Visible="@IsNewItemDialogVisible"
          Width="500px"
          Header="New Item"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="mb-3">
                <label>Phase:</label>
                <SfDropDownList TValue="string" TItem="PhaseDropdownItem"
                                @bind-Value="NewItemPhase"
                                DataSource="@PhaseDropdownList"
                                AllowFiltering="true"
                                Placeholder="Select Phase">
                    <DropDownListFieldSettings Text="DisplayText" Value="Phase"></DropDownListFieldSettings>
                </SfDropDownList>
            </div>
            <div class="mb-3">
                <label>Item Code:</label>
                <SfTextBox @bind-Value="@NewItemCode" Placeholder="Enter item code"></SfTextBox>
            </div>
            <div class="mb-3">
                <label>Description:</label>
                <SfTextBox @bind-Value="@NewItemDescription" Placeholder="Enter description"></SfTextBox>
            </div>
            <div class="mb-3">
                <label>Cost Type:</label>
