@* Save Confirmation Dialog *@
<SfDialog @bind-Visible="@_showSavePrompt"
          Width="400px"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Header>Save Changes</Header>
        <Content>
            <p>This data has changed.</p>
            <p>Do you want to save the changes?</p>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Yes" IsPrimary="true" OnClick="@OnSaveYes"/>
        <DialogButton Content="No" OnClick="@OnSaveNo"/>
        <DialogButton Content="Cancel" OnClick="@OnSaveCancel"/>
    </DialogButtons>
</SfDialog>

@* Error Dialog *@
<SfDialog @bind-Visible="@_showErrorDialog"
          Width="300px"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Header>Error</Header>
        <Content>
            <p>@_errorMessage</p>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="OK" IsPrimary="true" OnClick="@(() => _showErrorDialog = false)"/>
    </DialogButtons>
</SfDialog>

@* Find Dialog *@
<SfDialog @bind-Visible="@_showFindDialog"
          Width="350px"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Header>Find</Header>
        <Content>
            <div class="form-group">
                <label for="searchText">Search for:</label>
                <input type="text" id="searchText" @bind="_findText" @bind:event="oninput" class="form-control"/>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Find Next" IsPrimary="true" OnClick="@FindNext"/>
        <DialogButton Content="Close" OnClick="@(() => _showFindDialog = false)"/>
    </DialogButtons>
</SfDialog>

@code {
    private int activeTab = 1;
    private DbWrapperSqlServer DbHelper = new();
    private SfGrid<ExpandoObject>? _grid;
    private List<ExpandoObject> _gridData = new();
    private List<AreaInfo> _areas = new();
    private List<POIndexInfo> _poIndexes = new();
    private bool _isDirty = false;
    private bool _isLoading = true;
    private bool _showSavePrompt = false;
    private bool _showErrorDialog = false;
    private bool _showFindDialog = false;
    private string _errorMessage = string.Empty;
    private string _findText = string.Empty;
    private int _findIndex = 0;
    private int _divisionId;
    private TaskCompletionSource<SaveResult>? _savePromptResult;

    // Clipboard support
    private (int Row1, int Col1, int Row2, int Col2)? _clipboardSelection;
    private List<List<VendorCell>>? _clipboardData;

    protected override async Task OnInitializedAsync(){
        _divisionId = await GetCurrentDivisionId();
        await CleanupOrphanRecords();
        await LoadData();
        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender){
    }

    public void Dispose(){
        // Cleanup JS interop if needed
    }

    private async Task<int> GetCurrentDivisionId(){
        // Replace with actual implementation to get current division
        return 1;
    }

    private async Task CleanupOrphanRecords(){
        try{
            // Delete orphan POAreaVendor records where POIndex doesn't exist
            DbHelper.SqlExec(@"
                DELETE FROM POAreaVendor 
                WHERE DivisionID = @DivisionId 
                AND POIndex IN (
                    SELECT a.POIndex FROM POAreaVendor a 
                    LEFT OUTER JOIN tblPOIndex b ON a.POIndex = b.POIndex AND a.DivisionID = b.DivisionID 
                    WHERE b.POIndex IS NULL AND a.DivisionID = @DivisionId
                )", new { DivisionId = _divisionId });

            // Delete orphan records where Area doesn't exist
            DbHelper.SqlExec(@"
                DELETE FROM POAreaVendor 
                WHERE DivisionID = @DivisionId 
                AND ISNULL(Area, '') <> '' 
                AND Area IN (
                    SELECT a.Area FROM POAreaVendor a 
                    LEFT OUTER JOIN tblLocality b ON a.Area = b.Area 
                    WHERE b.Area IS NULL AND a.DivisionID = @DivisionId
                )", new { DivisionId = _divisionId });

            // Delete orphan records where Vendor doesn't exist
            DbHelper.SqlExec(@"
                DELETE FROM POAreaVendor 
                WHERE DivisionID = @DivisionId 
                AND Vendor IN (
                    SELECT a.Vendor FROM POAreaVendor a 
                    LEFT OUTER JOIN tblVendors b ON a.Vendor = b.Vendor_ID AND a.DivisionID = b.DivisionID 
                    WHERE b.Vendor_ID IS NULL AND a.DivisionID = @DivisionId
                )", new { DivisionId = _divisionId });
        }
        catch{
            // Silently ignore cleanup errors (matches original VB behavior)
        }
    }

    private async Task LoadData(){
        // Load PO Indexes
        var _poIndexes = (await DbHelper.QueryAsync(@"
            SELECT POIndex, Description 
            FROM tblPOIndex 
            WHERE DivisionID = @DivisionId 
            ORDER BY POIndex", new { DivisionId = _divisionId })).ToList();

        // Load Areas/Communities
        var _areas = (await DbHelper.QueryAsync(@"
            SELECT l.Area AS AreaCode, l.Description 
            FROM tblLocality l
            JOIN DivisionCommunities d ON d.Community = l.Area
            WHERE l.Area <> 'N/A' 
            AND l.Inactive = 0 
            AND ISNULL(l.Area, '') <> '' 
            AND d.DivisionID = @DivisionId
            ORDER BY l.Description", new { DivisionId = _divisionId })).ToList();

        // Load existing vendor assignments
        var vendorAssignments = await DbHelper.QueryAsync(@"
            SELECT l.Area AS AreaCode, pav.POIndex, pav.Vendor AS VendorId, v.Vendor_Name AS VendorName
            FROM POAreaVendor pav
            JOIN tblVendors v ON pav.Vendor = v.Vendor_ID AND v.DivisionID = pav.DivisionID
            LEFT OUTER JOIN tblLocality l ON pav.Area = l.Area
            WHERE pav.DivisionID = @DivisionId 
            AND (l.Inactive = 0 OR l.Area IS NULL)
            ORDER BY pav.POIndex", new { DivisionId = _divisionId });

        // Build grid data using ExpandoObject for dynamic columns
        _gridData = new List<ExpandoObject>();
        foreach (var poi in _poIndexes){
            dynamic row = new ExpandoObject();
            var dict = (IDictionary<string, object>)row;
            dict["POIndex"] = poi["POIndex"]?.ToString() ?? "";
            dict["POIndexDisplay"] = (poi["POIndex"]?.ToString() ?? "") == (poi["Description"]?.ToString() ?? "")
                ? poi["POIndex"]?.ToString() ?? ""
                : poi["POIndex"]?.ToString() ?? "" + " " + poi["Description"]?.ToString() ?? "";

            // Initialize all area columns
            dict["Area_GBL"] = new VendorCell();
            foreach (var area in _areas){
                dict["Area_" + area["AreaCode"]?.ToString()] = new VendorCell();
            }
            _gridData.Add(row);
        }

        // Populate with existing vendor data
        foreach (var assignment in vendorAssignments){
            var row = _gridData.FirstOrDefault(r => {
                var dict = (IDictionary<string, object>)r;
                return (dict["POIndex"]?.ToString() ?? "") == (assignment["POIndex"]?.ToString() ?? "");
            });
            if (row != null){
                if (!string.IsNullOrEmpty(assignment["AreaCode"]?.ToString())){
                    var dict = (IDictionary<string, object>)row;
                    var key = "Area_" + assignment["AreaCode"]?.ToString() ?? "";
                    if (dict.ContainsKey(key)){
                        dict[key] = new VendorCell {
                            VendorId = assignment["VendorId"]?.ToString() ?? "",
                            VendorName = assignment["VendorName"]?.ToString() ?? "",
                            IsDirty = false
                        };
                    }
                }
                else{
                    var dict = (IDictionary<string, object>)row;
                    var key = "Area_GBL";
                    if (dict.ContainsKey(key)){
                        dict[key] = new VendorCell {
                            VendorId = assignment["VendorId"]?.ToString() ?? "",
                            VendorName = assignment["VendorName"]?.ToString() ?? "",
                            IsDirty = false
                        };
                    }
                }
            }
        }
    }

    private void OnVendorChangedInline(IDictionary<string, object>? data, string areaCode, VendorCell? newValue){
        if (data != null){
            var key = $"Area_{areaCode}";
            var cell = newValue ?? new VendorCell();
            cell.IsDirty = true;
            data[key] = cell;
            _isDirty = true;
            StateHasChanged();
        }
    }

    private void OnCellSelected(CellSelectEventArgs<ExpandoObject> args){
        // Handle cell selection for copy/paste
    }

    private void OnQueryCellInfo(QueryCellInfoEventArgs<ExpandoObject> args){
        // Apply dirty cell styling
        if (args.Column.Field?.StartsWith("Area_") == true){
            var dict = args.Data as IDictionary<string, object>;
            if (dict?.TryGetValue(args.Column.Field, out var value) == true && value is VendorCell cell && cell.IsDirty){
                args.Cell.AddClass(new[] { "dirty-cell" });
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e){
        if (e.CtrlKey){
            switch (e.Key.ToLower()){
                case "s":
                    await SaveData(false);
                    break;
                case "f":
                    ShowFindDialog();
                    break;
                case "c":
                    CopySelection();
                    break;
                case "v":
                    await PasteSelection();
                    break;
            }
        }
        else if (e.Key == "Delete"){
            await DeleteSelection();
        }
        else if (e.Key == "F4"){
            await OpenVendorPicker();
        }
    }

    [JSInvokable]
    public async Task HandleShortcut(string key){
        switch (key){
            case "save":
                await SaveData(false);
                break;
            case "find":
                ShowFindDialog();
                break;
        }
    }

    private void CopySelection(){
        // Implementation for copy - would need JS interop for full clipboard support
    }

    private async Task PasteSelection(){
        // Implementation for paste
        _isDirty = true;
        StateHasChanged();
    }

    private async Task DeleteSelection(){
        // Clear selected cells
        _isDirty = true;
        StateHasChanged();
    }

    private async Task OpenVendorPicker(){
        // Open vendor picker for current cell
    }

    public async Task<bool> SaveData(bool prompt = true){
        if (!_isDirty)
            return true;
        if (prompt){
            _savePromptResult = new TaskCompletionSource<SaveResult>();
            _showSavePrompt = true;
            StateHasChanged();
            var result = await _savePromptResult.Task;
            _showSavePrompt = false;
            switch (result){
                case SaveResult.No:
                    return true;
                case SaveResult.Cancel:
                    return false;
            }
        }
        try{
            foreach (var row in _gridData){
                var dict = (IDictionary<string, object>)row;
                var poIndex = dict["POIndex"]?.ToString();
                foreach (var area in _areas){
                    var key = $"Area_{area.AreaCode}";
                    if (dict.TryGetValue(key, out var value) && value is VendorCell cell && cell.IsDirty){
                        // Delete existing record
                        DbHelper.SqlExec(@"
                            DELETE FROM POAreaVendor 
                            WHERE DivisionID = @DivisionId 
                            AND Area = @Area 
                            AND POIndex = @POIndex",
                            new { DivisionId = _divisionId, Area = area.AreaCode, POIndex = poIndex });

                        // Insert new record if vendor is specified
                        if (!string.IsNullOrWhiteSpace(cell.VendorId)){
                            // Validate vendor exists
                            var vendorExists = await DbHelper.QueryAsync(@"
                                SELECT Vendor_ID FROM tblVendors 
                                WHERE Vendor_ID = @VendorId AND DivisionID = @DivisionId",
                                new { VendorId = cell.VendorId, DivisionId = _divisionId });
                            if (!vendorExists.Any()){
                                _errorMessage = "Unknown vendor";
                                _showErrorDialog = true;
                                return false;
                            }
                            DbHelper.SqlExec(@"
                                INSERT INTO POAreaVendor (DivisionID, Area, POIndex, Vendor)
                                VALUES (@DivisionId, @Area, @POIndex, @VendorId)",
                                new {
                                    DivisionId = _divisionId,
                                    Area = area.AreaCode,
                                    POIndex = poIndex,
                                    VendorId = cell.VendorId
                                });
                        }
                        cell.IsDirty = false;
                    }
                }
            }
            _isDirty = false;
            StateHasChanged();
            return true;
        }
        catch (Exception ex) when (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase)){
            return true;
        }
    }

    private void ShowFindDialog(){
        _showFindDialog = true;
        _findIndex = 0;
    }

    private void FindNext(){
        if (string.IsNullOrWhiteSpace(_findText))
            return;
        var searchLower = _findText.ToLower();
        for (int i = _findIndex; i < _gridData.Count; i++){
            var dict = (IDictionary<string, object>)_gridData[i];

            // Search in PO Index
            if (dict["POIndexDisplay"]?.ToString()?.ToLower().Contains(searchLower) == true){
                _grid?.SelectRowAsync(i);
                _findIndex = i + 1;
                return;
            }

            // Search in vendor cells
            foreach (var area in _areas){
                var key = $"Area_{area.AreaCode}";
                if (dict.TryGetValue(key, out var value) && value is VendorCell cell){
                    if (cell.VendorName?.ToLower().Contains(searchLower) == true ||
                        cell.VendorId?.ToLower().Contains(searchLower) == true){
                        _grid?.SelectRowAsync(i);
                        _findIndex = i + 1;
                        return;
                    }
                }
            }
        }

        // Wrap around
        _findIndex = 0;
    }

    private void OnSaveYes() => _savePromptResult?.SetResult(SaveResult.Yes);
    private void OnSaveNo() => _savePromptResult?.SetResult(SaveResult.No);
    private void OnSaveCancel() => _savePromptResult?.SetResult(SaveResult.Cancel);
    private enum SaveResult {
        Yes,
        No,
        Cancel
    }
    public class DefaultVendorRow {
        public string POIndex{ get; set; } = string.Empty;
        public string POIndexDisplay{ get; set; } = string.Empty;
        public Dictionary<string, VendorCell> VendorCells{ get; set; } = new();

        /// <summary>
        /// Gets or creates a vendor cell for the specified area
        /// </summary>
        public VendorCell GetVendorCell(string areaCode){
            if (!VendorCells.TryGetValue(areaCode, out var cell)){
                cell = new VendorCell();
                VendorCells[areaCode] = cell;
            }
            return cell;
        }

        /// <summary>
        /// Indexer to support dynamic column access by Syncfusion grid
        /// </summary>
        public object? this[string columnName]{
            get {
                if (columnName == nameof(POIndex)) return POIndex;
                if (columnName == nameof(POIndexDisplay)) return POIndexDisplay;
                if (VendorCells.TryGetValue(columnName, out var cell))
                    return cell.VendorName;
                return null;
            }
            set {
                if (VendorCells.TryGetValue(columnName, out var cell)){
                    cell.VendorName = value?.ToString() ?? string.Empty;
                    cell.IsDirty = true;
                }
            }
        }
    }
    /// <summary>
    /// Represents a vendor assignment in a grid cell
    /// </summary>
    public class VendorCell {
        public string VendorId{ get; set; } = string.Empty;
        public string VendorName{ get; set; } = string.Empty;
        public bool IsDirty{ get; set; } = false;
    }
    /// <summary>
    /// Area/Community information
    /// </summary>
    public class AreaInfo {
        public string AreaCode{ get; set; } = string.Empty;
        public string Description{ get; set; } = string.Empty;
    }
    /// <summary>
    /// PO Index information
    /// </summary>
    public class POIndexInfo {
        public string POIndex{ get; set; } = string.Empty;
        public string Description{ get; set; } = string.Empty;
    }
    /// <summary>
    /// Vendor assignment from database
    /// </summary>
    public class VendorAssignment {
        public string AreaCode{ get; set; } = string.Empty;
        public string POIndex{ get; set; } = string.Empty;
        public string VendorId{ get; set; } = string.Empty;
        public string VendorName{ get; set; } = string.Empty;
    }
    /// <summary>
    /// Vendor information for picker
    /// </summary>
    public class VendorInfo {
        public string VendorId{ get; set; } = string.Empty;
        public string VendorName{ get; set; } = string.Empty;
        public string? Trade{ get; set; }
        public string? City{ get; set; }
        public string? Phone{ get; set; }
    }
