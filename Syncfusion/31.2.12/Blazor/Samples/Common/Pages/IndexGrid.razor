@page "/Grid"
@namespace BlazorDemos.Pages

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using System.Collections.Generic
@using Syncfusion.Blazor.Inputs

<style>
    /* FIXED: Correct CSS for selected cells in SfGrid */
    .e-grid .e-rowcell.e-selectionbackground.e-cellselectionbackground,
    .e-grid .e-rowcell.e-cellselectionbackground {
        background-color: #d32f2f !important; /* Bright red */
        color: white !important; /* White text */
        font-weight: bold !important; /* Bold */
        border: 1px solid #b71c1c !important; /* Red border */
    }

    /* Light red for selected rows */
    .e-grid .e-row.e-selected .e-rowcell,
    .e-grid .e-rowcell.e-selectionbackground {
        background-color: #ffebee !important; /* Light red */
    }

    /* Darker red for cell in selected row */
    .e-grid .e-row.e-selected .e-cellselectionbackground {
        background-color: #b71c1c !important;


    }

    /* Green color for edited Qty cell */
    .edited-qty-cell {
        background-color: #4caf50 !important; /* Green */
        color: white !important;
        font-weight: bold !important;
    }

    .keystroke-log {
        margin-top: 20px;
        padding: 15px;
        background-color: #f5f5f5;
        border-radius: 8px;
        font-family: Consolas, monospace;
        max-height: 450px;
        overflow-y: auto;
        border: 1px solid #ddd;
    }
</style>
<SfGrid @ref="Grid" TValue="OrderData" DataSource="@GridData" AllowGrouping="true" Height="715">
    <GridSelectionSettings CellSelectionMode="CellSelectionMode.Box"
                           Type="SelectionType.Multiple" Mode="SelectionMode.Cell"></GridSelectionSettings>
    <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true"
                      Mode="EditMode.Batch"></GridEditSettings>
    @*<GridEvents CellSelected = "OnCellSelected" TValue="OrderData"></GridEvents>
    <GridEvents OnCellEdit="CellEdit" TValue="OrderData"></GridEvents>
    <GridEvents CellSelected = "OnCellSelected" TValue="OrderData"></GridEvents>
    <GridEvents OnCellSave="CellSaved" TValue="OrderData"></GridEvents>
    <GridEvents CellSaved="CellSavedHandler" TValue="OrderData"></GridEvents>*@
    <!-- MULTIPLE EVENTS – ALL IN ONE TAG --->
    <GridEvents CellSelected="OnCellSelected"
                CellSaved="AfterCellSaved"
                OnCellEdit="CellEdit"
                OnCellSave="CellSaved"
                OnBeginEdit="OnBeginEdit"
                RowSelected="OnRowSelected"
                OnActionBegin="OnActionBegin"
                OnActionComplete="OnActionComplete"
                QueryCellInfo="OnQueryCellInfo"
                TValue="OrderData">
    </GridEvents>
    <GridColumns>
        <GridColumn Field="@nameof(OrderData.OrderID)" HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"
                    AllowEditing="false" IsPrimaryKey="true"></GridColumn>
        <GridColumn Field="@nameof(OrderData.CustomerName)" HeaderText="Customer Name" Width="50"
                    AllowEditing="false"></GridColumn>

        <GridColumn Field="@nameof(OrderData.Freight)" HeaderText="Freight" TextAlign="TextAlign.Right" Format="C2"
                    Width="120" AllowEditing="false">
            <GridAggregates>
                <GridAggregate>
                    <GridAggregateColumns>
                        <GridAggregateColumn Field="@nameof(OrderData.Freight)" Type="AggregateType.Sum">
                            <GroupFooterTemplate>
                                @{
                                    // The context is a dictionary containing the aggregate results for the group
                                    var data = context as AggregateTemplateContext;
                                    <div>Group Sum: @data.Sum</div>
                                }
                            </GroupFooterTemplate>
                        </GridAggregateColumn>
                    </GridAggregateColumns>
                </GridAggregate>
            </GridAggregates>
        </GridColumn>
        <!-- ONLY THIS COLUMN IS EDITABLE 
        <GridColumn Field="Qty" HeaderText="Qty" Format="N2" TextAlign="TextAlign.Right" Width="100" AllowEditing="true">
            <EditTemplate>
                @{
                    var order = (context as OrderData);
                    <SfNumericTextBox @bind-Value="EditedQty"
                                      Min="0"
                                      Decimals="2"
                                      Format="N2"
                                      @onkeydown="((e) => OnQtyKeyDown(e, order))"
                                      @oninput="((e) => OnQtyInput(e, order))"
                                      Placeholder="Enter Qty">
                    </SfNumericTextBox>
                }
            </EditTemplate>
        </GridColumn>  -->
        <GridColumn Field="@nameof(OrderData.Qty)" HeaderText="Qty" Format="N2" TextAlign="TextAlign.Right" Width="100"
                    AllowEditing="true">

        </GridColumn>
        <GridColumn Field="@nameof(OrderData.ShipCity)" HeaderText="Ship City" Width="150"
                    AllowEditing="false"></GridColumn>
    </GridColumns>

</SfGrid>
<!-- Live Keystroke Log Display 
<div class="keystroke-log">
    <h5>Live Keystrokes (as you type in Qty):</h5>
    <div>@((MarkupString)KeystrokeLog.Replace("\n", "<br/>"))</div>
    <small style="color: #666;">Current Edited Row: @CurrentEditingRow | Keys Typed: @(KeystrokeLog.Split('\n').Length - 1)</small>
</div>
-->

