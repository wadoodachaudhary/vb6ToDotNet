    private string KeystrokeLog{ get; set; } = "No typing yet...\n";
    private int CurrentEditingRow{ get; set; } = -1;
    private string CurrentTypingBuffer{ get; set; } = "";
    private List<int> rows = new();

    // Captures every key press
    private void OnQtyKeyDown(KeyboardEventArgs e, OrderData order){
        var rowIndex = GridData.IndexOf(order);
        CurrentEditingRow = rowIndex;
        var keyInfo = $"[KeyDown] Row {rowIndex} | Key: {e.Key} | Code: {e.Code} | Ctrl: {e.CtrlKey} | Shift: {e.ShiftKey}";
        AppendLog(keyInfo);
    }

    // Captures actual text input (best for seeing what user is typing)
    private void OnQtyInput(ChangeEventArgs e, OrderData order){
        var rowIndex = GridData.IndexOf(order);
        var typedValue = e.Value?.ToString() ?? "";

        // Build live typing preview
        CurrentTypingBuffer = typedValue;
        AppendLog($"[Typing] Row {rowIndex} → Current value: {typedValue}");
    }

    private void AppendLog(string message){
        var timestamp = DateTime.Now.ToString("HH:mm:ss.fff");
        KeystrokeLog += $"[{timestamp}] {message}\n";

        // Keep only last 50 lines
        var lines = KeystrokeLog.Split('\n').TakeLast(500).ToArray();
        KeystrokeLog = string.Join("\n", lines);
        StateHasChanged();
    }

