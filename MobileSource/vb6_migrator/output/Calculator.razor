@page "/calculator"

<div class="calculator">
    <div class="display">
        <input type="text" @bind="displayText" readonly />
    </div>
    
    <div class="button-grid">
        <button @onclick="ClearAll" class="btn btn-function">C</button>
        <button @onclick="ClearEntry" class="btn btn-function">CE</button>
        <button @onclick="Backspace" class="btn btn-function">←</button>
        <button @onclick="ToggleSign" class="btn btn-function">+/-</button>
        
        <button @onclick="() => NumberClick(7)" class="btn btn-number">7</button>
        <button @onclick="() => NumberClick(8)" class="btn btn-number">8</button>
        <button @onclick="() => NumberClick(9)" class="btn btn-number">9</button>
        <button @onclick="() => OperatorClick('/')" class="btn btn-operator">÷</button>
        
        <button @onclick="() => NumberClick(4)" class="btn btn-number">4</button>
        <button @onclick="() => NumberClick(5)" class="btn btn-number">5</button>
        <button @onclick="() => NumberClick(6)" class="btn btn-number">6</button>
        <button @onclick="() => OperatorClick('*')" class="btn btn-operator">×</button>
        
        <button @onclick="() => NumberClick(1)" class="btn btn-number">1</button>
        <button @onclick="() => NumberClick(2)" class="btn btn-number">2</button>
        <button @onclick="() => NumberClick(3)" class="btn btn-number">3</button>
        <button @onclick="() => OperatorClick('-')" class="btn btn-operator">-</button>
        
        <button @onclick="() => NumberClick(0)" class="btn btn-number">0</button>
        <button @onclick="DecimalClick" class="btn btn-number">.</button>
        <button @onclick="EqualsClick" class="btn btn-equals">=</button>
        <button @onclick="() => OperatorClick('+')" class="btn btn-operator">+</button>
    </div>
</div>

<style>
    .calculator {
        width: 300px;
        margin: 20px auto;
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 10px;
        background-color: #f9f9f9;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .display {
        margin-bottom: 10px;
    }

    .display input {
        width: 100%;
        height: 50px;
        font-size: 18px;
        text-align: right;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 0 10px;
        background-color: white;
    }

    .button-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 5px;
    }

    .btn {
        height: 50px;
        font-size: 16px;
        border: 1px solid #ccc;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn:hover {
        background-color: #e0e0e0;
    }

    .btn-number {
        background-color: white;
    }

    .btn-operator {
        background-color: #f0f0f0;
    }

    .btn-function {
        background-color: #e8e8e8;
    }

    .btn-equals {
        background-color: #007acc;
        color: white;
    }

    .btn-equals:hover {
        background-color: #005a99;
    }
</style>

@code {
    private double accumulator = 0;
    private double currentValue = 0;
    private string currentOp = "";
    private bool newEntry = true;
    private bool decimalUsed = false;
    private bool hasError = false;
    private string displayText = "0";

    protected override void OnInitialized()
    {
        ClearAll();
    }

    private void ClearAll()
    {
        accumulator = 0;
        currentValue = 0;
        currentOp = "";
        newEntry = true;
        decimalUsed = false;
        hasError = false;
        displayText = "0";
    }

    private void ClearEntry()
    {
        currentValue = 0;
        newEntry = true;
        decimalUsed = false;
        displayText = "0";
    }

    private void Backspace()
    {
        if (hasError || newEntry) return;

        string text = displayText;

        if (text.Length > 1)
        {
            if (text.EndsWith("."))
            {
                decimalUsed = false;
            }
            displayText = text[..^1];
        }
        else
        {
            displayText = "0";
            newEntry = true;
        }

        if (double.TryParse(displayText, out double value))
        {
            currentValue = value;
        }
    }

    private void ToggleSign()
    {
        if (hasError) return;

        currentValue = -currentValue;
        displayText = currentValue.ToString();
    }

    private void NumberClick(int number)
    {
        if (hasError) ClearAll();

        if (newEntry)
        {
            displayText = "";
            newEntry = false;
            decimalUsed = false;
        }

        displayText += number.ToString();
        if (double.TryParse(displayText, out double value))
        {
            currentValue = value;
        }
    }

    private void DecimalClick()
    {
        if (hasError) ClearAll();
        if (decimalUsed) return;

        if (newEntry)
        {
            displayText = "0";
            newEntry = false;
        }

        displayText += ".";
        decimalUsed = true;
    }

    private void OperatorClick(char op)
    {
        if (hasError) return;

        if (!string.IsNullOrEmpty(currentOp) && !newEntry)
        {
            PerformCalculation();
            if (hasError) return;
        }

        accumulator = currentValue;
        newEntry = true;
        currentOp = op.ToString();
    }

    private void EqualsClick()
    {
        if (hasError || string.IsNullOrEmpty(currentOp)) return;

        PerformCalculation();
        currentOp = "";
    }

    private void PerformCalculation()
    {
        try
        {
            double result = currentOp switch
            {
                "+" => accumulator + currentValue,
                "-" => accumulator - currentValue,
                "*" => accumulator * currentValue,
                "/" => currentValue == 0 ? throw new DivideByZeroException() : accumulator / currentValue,
                _ => currentValue
            };

            currentValue = result;
            accumulator = result;
            displayText = FormatResult(result);
            newEntry = true;
            decimalUsed = displayText.Contains('.');
        }
        catch (DivideByZeroException)
        {
            displayText = "Error: Div/0";
            hasError = true;
        }
        catch
        {
            displayText = "Error";
            hasError = true;
        }
    }

    private string FormatResult(double value)
    {
        if (Math.Abs(value) >= 1E+15 || (Math.Abs(value) < 0.000001 && value != 0))
        {
            return value.ToString("0.########E+0");
        }
        else if (value == Math.Truncate(value))
        {
            return ((long)value).ToString();
        }
        else
        {
            return value.ToString();
        }
    }
}