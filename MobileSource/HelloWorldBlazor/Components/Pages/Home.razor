@page "/"

<h1>Hello, World!</h1>

<p>Welcome to your .NET MAUI Blazor Hybrid App.</p>

<p>Current time: @currentTime</p>

<button class="btn" @onclick="UpdateTime">Refresh Time</button>

@code {
    private string currentTime = DateTime.Now.ToString("F");

    private void UpdateTime()
    {
        currentTime = DateTime.Now.ToString("F");
    }
}
