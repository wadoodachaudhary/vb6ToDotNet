@page "/model-assembly"
@rendermode InteractiveServer
@using HomeFront.Data
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using System.Data

<PageTitle>HomeFront - IndexHF</PageTitle>

<div class="tabs-container">
    <div class="tab-buttons">
        <button class="@(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">
            .NET
        </button>
        <button class="@(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">
            VB6
        </button>
    </div>

    <div class="tab-content">
        @if (activeTab == 1)
        {
            <div class="panel">
                <div class="toolbar-row">
                    <button class="toolbar-button" @onclick="OnNewClick">
                        <img src="images/32/new.ico" class="tbar-icon" alt="New" />
                        <span>New</span>
                    </button>
                    <button class="toolbar-button" @onclick="OnOpenClick">
                        <img src="images/32/open.ico" class="tbar-icon" alt="Open" />
                        <span>Open</span>
                    </button>
                    <button class="toolbar-button" @onclick="OnSaveClick">
                        <img src="images/32/save.ico" class="tbar-icon" alt="Save" />
                        <span>Save</span>
                    </button>
                    <button class="toolbar-button" disabled="@(!ShowPlanSwift)">
                        <img src="images/32/planswift.ico" class="tbar-icon" alt="Planswift" />
                        <span>PlanSwift</span>
                    </button>
                    <button class="toolbar-button" disabled="@(!ShowImportButton)">
                        <img src="images/32/import.ico" class="tbar-icon" alt="Import" />
                        <span>Import</span>
                    </button>
                </div>

                <div class="form-grid">
                    <div class="form-field">
                        <label>Community</label>
                        <select @bind="CommunityValue">
                            @foreach (var item in CommunityItems)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>@ModelOptionLabel</label>
                        <select @bind="ModelValue">
                            @foreach (var item in ModelItems)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Option ID</label>
                        <input type="text" @bind="OptionID" />
                    </div>
                    <div class="form-field">
                        <label>Assembly</label>
                        <input type="text" @bind="AssemblyCode" />
                    </div>
                    <div class="form-field form-field-wide">
                        <label>Description</label>
                        <input type="text" @bind="Description" />
                    </div>
                    <div class="form-field">
                        <label>Pricing Community</label>
                        <select @bind="SelectedPricingCommunity" @bind:after="OnPricingCommunityChanged">
                            @foreach (var item in PricingCommunities)
                            {
                                <option value="@item.PricingCommunity">@item.PricingCommunityPhase</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Billing Factor</label>
                        <input type="number" step="0.01" @bind="BillingFactor" />
                    </div>
                </div>

                <div class="checkbox-grid">
                    <label><input type="checkbox" @bind="IsActive" /> Active</label>
                    <label><input type="checkbox" @bind="IsTakeoffRequired" /> Takeoff required</label>
                    <label><input type="checkbox" @bind="UseNormalSalesQtyFactors" /> Use normal sales qty factors</label>
                    <label><input type="checkbox" @bind="IsBaseAssembly" /> Base assembly</label>
                    <label><input type="checkbox" @bind="IsIncludedOption" /> Included option</label>
                    <label><input type="checkbox" @bind="IsDCSalesOnly" /> DC sales only</label>
                </div>

                <div class="grid-section">
                    <HfGrid @ref="ItemsGrid"
                            TValue="AssemblyItemRow"
                            DataSource="@ItemsData"
                            AllowSelection="true"
                            AllowSorting="true"
                            AllowFiltering="true"
                            AllowGrouping="true"
                            AllowPaging="true"
                            Height="900px"
                            RowHeight="38"
                            FilterSettingsRef="@filterSettings"
                            PageSettingsRef="@pageSettings"
                            EditSettingsRef="@editSettings"
                            SelectionSettingsRef="@selectionSettings"
                            GroupColumns="@GroupedColumns"
                            EventsRef="@itemsEvents">
                        <HfGridColumnsBase>
                            <HfGridColumn Field="@nameof(AssemblyItemRow.Sequence)" HeaderText="" Width="1px" AllowEditing="false" IsPrimaryKey="true" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.POIndex)" HeaderText="PO Index" Width="80px" AllowEditing="false" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.VendorDesc)" HeaderText="Vendor Name" Width="250px" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.Phase)" HeaderText="Phase" Width="80px" AllowEditing="false" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.Item)" HeaderText="Item" Width="100px" AllowEditing="false" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.Description)" HeaderText="Description" Width="250px" AllowEditing="false" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.TakeoffQty)" HeaderText="Takeoff Qty" Format="N2" Width="100px" AllowEditing="false" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.OrderQty)" HeaderText="Order Qty" Format="N2" Width="80px" AllowEditing="true" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.Notes)" HeaderText="Notes" Width="80px" AllowEditing="false" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.OrderUOM)" HeaderText="UOM" Width="80px" AllowEditing="false" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.Price)" HeaderText="Price" Format="C2" Visible="@ShowPricing" Width="100px" AllowEditing="false" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.ExtendedAmount)" HeaderText="Extended" Format="C2" Visible="@ShowPricing" Width="120px" AllowEditing="false" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.ItemType)" HeaderText="Item Type" Width="120px" AllowEditing="false" />
                            <HfGridColumn Field="@nameof(AssemblyItemRow.PriceLevel)" HeaderText="Price Level" Width="120px" AllowEditing="false" />
                        </HfGridColumnsBase>
                    </HfGrid>

                    @if (ShowPricing)
                    {
                        <div class="cost-summary">
                            <strong>Assembly Cost: @AssemblyCostLabel</strong><br />
                            <strong>Component Cost: @ComponentCostLabel</strong><br />
                            <strong>Total Cost: @TotalCostLabel</strong>
                        </div>
                    }

                    <div class="selection-bar">
                        Selected Rows: <strong>@SelectedRowCount</strong>
                        <SfButton CssClass="e-small e-round ml-2" OnClick="MassEditSelectedQty" Disabled="@(SelectedRowCount == 0)">
                            Mass Edit Selected Qty
                        </SfButton>
                    </div>

                    @if (ShowComponentsGrid)
                    {
                        <h5 class="mt-4">Components</h5>
                        <HfGrid TValue="AssemblyComponentRow" DataSource="@ComponentsData" Height="300px">
                            <HfGridColumnsBase>
                                <HfGridColumn Field="@nameof(AssemblyComponentRow.Assembly)" HeaderText="Assembly" />
                                <HfGridColumn Field="@nameof(AssemblyComponentRow.Description)" HeaderText="Description" />
                                <HfGridColumn Field="@nameof(AssemblyComponentRow.Qty)" HeaderText="Qty" Format="N0" />
                                <HfGridColumn Field="@nameof(AssemblyComponentRow.Cost)" HeaderText="Cost" Format="C2" Visible="@ShowPricing" />
                            </HfGridColumnsBase>
                        </HfGrid>
                    }
                </div>
            </div>
        }
        else if (activeTab == 2)
        {
            <div class="panel">
                <img src="images/VB6/Screen_IndexHF.png" class="task-icon-vb6" />
            </div>
        }
    </div>
</div>

<style>
    .tabs-container {
        margin: 20px auto;
        font-family: Arial, Helvetica, sans-serif;
    }

    .tab-buttons {
        display: flex;
        border-bottom: 2px solid #ddd;
    }

    .tab-buttons button {
        padding: 12px 24px;
        border: none;
        background: #f0f0f0;
        cursor: pointer;
        font-size: 16px;
        transition: background 0.2s;
    }

    .tab-buttons button.active {
        background: #fff;
        border-bottom: 2px solid #007bff;
        margin-bottom: -2px;
        color: #007bff;
        font-weight: bold;
    }

    .tab-content {
        padding: 20px;
        border: 1px solid #ddd;
        border-top: none;
        background: #fff;
    }

    .panel {
        text-align: left;
    }

    .panel img {
        max-width: 100%;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .toolbar-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
    }

    .toolbar-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border: 1px solid #d0d5da;
        border-radius: 6px;
        background: #f8f9fa;
        cursor: pointer;
    }

    .toolbar-button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .tbar-icon {
        width: 20px;
        height: 20px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 12px 18px;
        margin-bottom: 16px;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 14px;
    }

    .form-field-wide {
        grid-column: span 2;
    }

    .form-field input,
    .form-field select {
        padding: 6px 10px;
        border: 1px solid #ccd2d8;
        border-radius: 4px;
    }

    .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 8px 16px;
        margin-bottom: 18px;
        font-size: 14px;
    }

    .grid-section {
        margin-top: 12px;
    }

    .cost-summary {
        margin-top: 12px;
        text-align: right;
    }

    .selection-bar {
        margin-top: 12px;
        padding: 10px;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        text-align: center;
    }
</style>

@code {
    [Inject] public IJSRuntime JSRuntime { get; set; } = default!;

    private readonly DbWrapperSqlServer db = new();

    private int activeTab = 1;
    private HfGrid<AssemblyItemRow>? ItemsGrid;

    private List<AssemblyItemRow> ItemsData = new();
    private List<AssemblyComponentRow> ComponentsData = new();

    private readonly HfFilterSettings filterSettings = new() { Type = FilterType.Menu };
    private readonly HfPageSettings pageSettings = new() { PageSize = 40 };
    private readonly HfEditSettings editSettings = new()
    {
        AllowAdding = true,
        AllowEditing = true,
        AllowDeleting = true,
        Mode = EditMode.Inline,
        ShowConfirmDialog = false
    };
    private readonly HfSelectionSettings selectionSettings = new()
    {
        Mode = SelectionMode.Cell,
        Type = SelectionType.Multiple,
        EnableToggle = true,
        CheckboxOnly = true
    };

    private readonly HfGridEvents<AssemblyItemRow> itemsEvents = new();

    public List<string> GroupedColumns { get; set; } = ["Phase"];

    private string ModelOptionLabel = "Model";
    private bool ShowPricing = false;
    private bool ShowPlanSwift = false;
    private bool ShowImportButton = false;
    private bool ShowComponentsGrid = false;

    private string PricingCommunityPhase = "";
    private string PricingCommunity = "";
    private string CommunityTerm = "Community";

    private string CommunityValue = "";
    private string ModelValue = "";
    private string OptionID = "";
    private string AssemblyCode = "";
    private string Description = "";
    private double BillingFactor = 1.0;

    private bool IsActive = true;
    private bool IsTakeoffRequired;
    private bool UseNormalSalesQtyFactors = true;
    private bool IsBaseAssembly;
    private bool IsIncludedOption;
    private bool IsDCSalesOnly;

    private string AssemblyCostLabel = "";
    private string ComponentCostLabel = "";
    private string TotalCostLabel = "";
    private double AssemblyCost;
    private double ComponentCost;

    private int SelectedRowCount;

    public List<ComboBoxItem> CommunityItems { get; set; } = new();
    public List<ComboBoxItem> ModelItems { get; set; } = new();
    public List<CommunityItem> PricingCommunities { get; set; } = new();
    public string? SelectedPricingCommunity { get; set; }

    private string mCommunity = "";
    private string mModel = "";
    private string mOptionID = "";
    private string mAssembly = "";
    private long mAssemblyID;

    protected override void OnInitialized()
    {
        itemsEvents.OnRecordClick = EventCallback.Factory.Create<CellClickEventArgs<AssemblyItemRow>>(this, OnRowClick);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadComboBoxes();
        await LoadPricingCommunitiesAsync();

        await ShowForm();
    }

    private async Task ShowForm()
    {
        mCommunity = "";
        mModel = "ANDAV01C";
        mOptionID = "";
        mAssembly = "ANDAV01CNEWSPEC";

        CommunityValue = mCommunity;
        ModelValue = mModel;
        OptionID = mOptionID;
        AssemblyCode = mAssembly;
        Description = "";

        await LoadItemsGridAsync();
        await LoadComponentsGridAsync();
    }

    private async Task OnRowClick(CellClickEventArgs<AssemblyItemRow> args)
    {
        await UpdateUIAsync();
    }

    private async Task UpdateUIAsync()
    {
        if (ItemsGrid == null)
        {
            return;
        }

        var selectedRecords = await ItemsGrid.GetSelectedRecordsAsync();
        SelectedRowCount = selectedRecords.Count;
        StateHasChanged();
    }

    private async Task MassEditSelectedQty()
    {
        if (ItemsGrid == null)
        {
            return;
        }

        var selectedCells = await ItemsGrid.GetSelectedRowCellIndexesAsync();
        var selectedRecords = await ItemsGrid.GetSelectedRecordsAsync();
        var targetCount = selectedCells.Count > 0 ? selectedCells.Count : selectedRecords.Count;
        if (targetCount == 0)
        {
            return;
        }

        var result = await JSRuntime.InvokeAsync<string>("prompt", $"Set {targetCount} selected Qty values to:", "100");
        if (string.IsNullOrWhiteSpace(result) || !double.TryParse(result, out var newValue))
        {
            return;
        }

        if (selectedCells.Count > 0)
        {
            foreach (var (rowIndex, cellIndex) in selectedCells)
            {
                if (rowIndex < 0 || rowIndex >= ItemsData.Count)
                {
                    continue;
                }

                if (cellIndex < 0 || cellIndex >= ItemsGrid.Columns.Count)
                {
                    continue;
                }

                var field = ItemsGrid.Columns[cellIndex].Field;
                if (!string.Equals(field, nameof(AssemblyItemRow.OrderQty), StringComparison.Ordinal))
                {
                    continue;
                }

                var record = ItemsData[rowIndex];
                record.OrderQty = newValue;
                record.ExtendedAmount = record.OrderQty * record.Price;
                await ItemsGrid.UpdateCellAsync(rowIndex, field, newValue);
                await ItemsGrid.UpdateCellAsync(rowIndex, nameof(AssemblyItemRow.ExtendedAmount), record.ExtendedAmount);
            }
        }
        else
        {
            foreach (var record in selectedRecords)
            {
                record.OrderQty = newValue;
                record.ExtendedAmount = record.OrderQty * record.Price;
            }
        }

        await ItemsGrid.RefreshAsync();
        await UpdateUIAsync();
    }

    private async Task OnPricingCommunityChanged()
    {
        PricingCommunity = SelectedPricingCommunity ?? "";
        PricingCommunityPhase = PricingCommunities.FirstOrDefault(c => c.PricingCommunity == PricingCommunity)?.PricingCommunityPhase ?? "";

        ShowPricing = !string.IsNullOrWhiteSpace(PricingCommunity);
        await LoadItemsGridAsync();
        await LoadComponentsGridAsync();
    }

    private async Task LoadComboBoxes()
    {
        var dt = db.SqlExec("SELECT Description, Area FROM tblLocality ORDER BY Description");
        CommunityItems = dt.AsEnumerable().Select(row => new ComboBoxItem
        {
            Text = row["Description"]?.ToString() ?? "",
            Value = row["Area"]?.ToString() ?? ""
        }).ToList();

        var modelDt = db.SqlExec("SELECT DISTINCT model FROM tblDBAssemblyMaster WHERE AssemblyType=0 AND DivisionID=1 ORDER BY model");
        ModelItems = modelDt.AsEnumerable().Select(row => new ComboBoxItem
        {
            Text = row[0]?.ToString() ?? "",
            Value = row[0]?.ToString() ?? ""
        }).ToList();

        await Task.CompletedTask;
    }

    public async Task LoadPricingCommunitiesAsync()
    {
        var sql = @"
            SELECT 
                c.Description,
                c.area + CHAR(2) AS Value,
                0 AS SortOrder
            FROM tbllocality c
            LEFT OUTER JOIN DivisionCommunities d ON d.Community = c.Area AND d.DivisionID = @DivisionID
            WHERE ISNULL(c.inactive, 0) = 0
              AND (@DivisionID IS NULL OR d.DivisionID = @DivisionID)
            UNION
            SELECT 
                c.Description + ISNULL(' ' + p.description, ''),
                c.area + CHAR(2) + ISNULL(p.communityphase, '') AS Value,
                0 AS SortOrder
            FROM tbllocality c
            LEFT OUTER JOIN communityphase p ON c.area = p.community
            LEFT OUTER JOIN DivisionCommunities d ON d.Community = c.Area AND d.DivisionID = @DivisionID
            WHERE ISNULL(c.inactive, 0) = 0
              AND (@DivisionID IS NULL OR d.DivisionID = @DivisionID)
            ORDER BY Description";

        var rows = await db.QueryAsync(sql, new { DivisionID = 1 });
        PricingCommunities = rows.Select(row => new CommunityItem
            {
                PricingCommunityPhase = row["Description"]?.ToString() ?? "",
                PricingCommunity = row["Value"]?.ToString() ?? "",
                SortOrder = Convert.ToInt32(row["SortOrder"])
            })
            .OrderBy(x => x.PricingCommunityPhase)
            .ToList();

        PricingCommunities.Insert(0, new CommunityItem { PricingCommunityPhase = "", PricingCommunity = "", SortOrder = 0 });
    }

    private async Task LoadItemsGridAsync()
    {
        var itemsQuery = string.IsNullOrEmpty(PricingCommunity)
            ? BuildItemsQuery_NoPricing()
            : BuildItemsQuery_WithPricing();

        var dt = db.SqlExec(itemsQuery, new
        {
            DivisionID = 1,
            Community = mCommunity.Trim() ?? "",
            Model = mModel.Trim() ?? "",
            OptionID = mOptionID.Trim() ?? "",
            Assembly = mAssembly.Trim() ?? "",
            PricingCommunity = PricingCommunity.Trim() ?? "",
            PricingCommunityPhase = PricingCommunityPhase.Trim() ?? ""
        });

        var items = new List<AssemblyItemRow>();
        AssemblyCost = 0;
        foreach (DataRow row in dt.Rows)
        {
            var item = new AssemblyItemRow
            {
                Sequence = row["sequence"] is DBNull ? 0 : Convert.ToInt32(row["sequence"]),
                Phase = row["Phase"]?.ToString() ?? "",
                Item = row["Item"]?.ToString() ?? "",
                ItemNumber = row["itemnumber"]?.ToString() ?? "",
                ItemChart = row["itemchart"]?.ToString() ?? "",
                Description = row["Description"]?.ToString() ?? "",
                TakeoffUOM = row["TakeoffUOM"]?.ToString() ?? "",
                OrderUOM = row["OrderUOM"]?.ToString() ?? "",
                Formula = row["Formula"]?.ToString() ?? "",
                TakeoffQty = ToDouble(row["TakeoffQty"]),
                OrderQty = ToDouble(row["OrderQty"]),
                WastePercent = ToDouble(row["WastePercent"]),
                Notes = row["notes"]?.ToString() ?? "",
                Location = row["Location"]?.ToString() ?? "",
                IsQuote = row["IsQuote"]?.ToString() == "True",
                Invertable = row["Invertable"]?.ToString() == "True",
                UseModelCost = row["UseModelCost"]?.ToString() == "True",
                POIndex = row["POIndex"]?.ToString() ?? "",
                POIndexDescription = row["POIndexDescription"]?.ToString() ?? "",
                JCCostCode = row["JCCostCode"]?.ToString() ?? "",
                JCCategory = row["JCCategory"]?.ToString() ?? ""
            };

            if (!string.IsNullOrEmpty(PricingCommunity))
            {
                var quality = row["RateQuality"] is DBNull ? 0 : Convert.ToInt32(row["RateQuality"]);
                item.PriceLevel = quality switch
                {
                    4 or 5 or 6 => "Quote",
                    9 => "Phase Specific",
                    10 => $"{CommunityTerm} Specific",
                    11 => $"Global (any {CommunityTerm})",
                    12 => "Corporate (any Division)",
                    13 => "Item DB",
                    _ => "Unit Price"
                };
                item.Price = ToDouble(row["Rate"]);
                item.TaxRate = ToDouble(row["JCTaxRate"]) / 100;
                item.PretaxAmount = item.Price * item.OrderQty;
                item.TaxAmount = item.PretaxAmount * item.TaxRate;
                item.ExtendedAmount = item.PretaxAmount + item.TaxAmount;
                AssemblyCost += item.ExtendedAmount;
                item.Vendor = row["Vendor"]?.ToString() ?? "";
                item.VendorDesc = row["VendorDesc"]?.ToString() ?? "";
                item.OldPriceLevel = item.PriceLevel;
            }
            else
            {
                item.ItemType = item.IsQuote ? "Quote" : "Unit Price";
            }

            items.Add(item);
        }

        ItemsData = items;
        AssemblyCostLabel = AssemblyCost.ToString("$#,##0.00");

        if (ItemsGrid != null)
        {
            await ItemsGrid.RefreshAsync();
        }
    }

    private async Task LoadComponentsGridAsync()
    {
        var checkQuery = "SELECT parentassemblyid FROM tblDBAssemblyComponents WHERE ComponentAssemblyID = @Id";
        var checkDt = db.SqlExec(checkQuery, new { Id = mAssemblyID });
        var isChildComponent = checkDt.Rows.Count > 0;
        var mComponentsEnabled = !isChildComponent;
        ShowComponentsGrid = mComponentsEnabled;
        if (!mComponentsEnabled)
        {
            ComponentsData = new List<AssemblyComponentRow>();
            return;
        }

        var compQuery = BuildComponentsQuery();
        var compDt = db.SqlExec(compQuery, new
        {
            ParentAssemblyId = mAssemblyID,
            DivisionID = 1,
            PricingCommunity,
            PricingCommunityPhase
        });

        var components = new List<AssemblyComponentRow>();
        ComponentCost = 0;
        foreach (DataRow row in compDt.Rows)
        {
            var comp = new AssemblyComponentRow
            {
                AssemblyId = row["assemblyid"] is DBNull ? 0 : Convert.ToInt64(row["assemblyid"]),
                Community = row["community"]?.ToString() ?? "",
                Model = row["model"]?.ToString() ?? "",
                Option = row["optionid"]?.ToString() ?? "",
                Assembly = row["assembly"]?.ToString() ?? "",
                Description = row["description"]?.ToString() ?? "",
                Qty = ToDouble(row["qty"]),
                Cost = !string.IsNullOrEmpty(PricingCommunity) ? ToDouble(row["Cost"]) : 0
            };
            ComponentCost += comp.Cost * comp.Qty;
            components.Add(comp);
        }

        ComponentsData = components;
        ComponentCostLabel = ComponentCost.ToString("$#,##0.00");
        TotalCostLabel = (AssemblyCost + ComponentCost).ToString("$#,##0.00");
    }

    private string BuildComponentsQuery()
    {
        return @"
        SELECT 
            m.assemblyid,
            m.community,
            m.assembly,
            m.model,
            m.optionid,
            m.description,
            c.qty,
            ROUND(SUM(ISNULL(0, 0) * (100 + ISNULL(t.JCRate, 0)) / 100 * ISNULL(d.OrderQty, 0)), 2) AS Cost
        FROM tblDBAssemblyComponents c
        JOIN tblDBAssemblyMaster m 
            ON c.componentassemblyid = m.assemblyid
        LEFT OUTER JOIN tblDBAssemblyDetails d 
            ON m.assemblyid = d.assemblyid
        LEFT OUTER JOIN tblPhaseItem i 
            ON d.DivisionID = i.DivisionID 
            AND d.Phase = i.Phase 
            AND d.Item = i.Item
        LEFT OUTER JOIN tblPOIndex p 
            ON p.DivisionID = @DivisionID 
            AND ISNULL(ISNULL(d.POIndex,''), ISNULL(i.POIndex,'')) = p.POIndex
        LEFT OUTER JOIN StandardCostCodes cc 
            ON cc.DivisionID = @DivisionID 
            AND ISNULL(ISNULL(i.JCCostCode,''), ISNULL(p.JCCostCode,'')) = cc.CostCode
        LEFT OUTER JOIN StandardCategories ct 
            ON i.DivisionID = ct.DivisionID 
            AND i.JCCategory = ct.Category
        LEFT OUTER JOIN tblvendors v 
            ON v.DivisionID = d.DivisionID 
            AND v.vendor_id = dbo.Purch_GetCommunityVendor(@PricingCommunity, p.POIndex, @DivisionID)
        LEFT OUTER JOIN taxGroups t 
            ON t.DivisionID = @DivisionID 
            AND t.TaxGroup = dbo.Purch_GetDefaultTaxGroup(
                '', @PricingCommunity, '', d.Model, d.Assembly, 
                i.phase, i.item, v.Vendor_ID, i.JCCategory, @DivisionID
            )
        WHERE c.ParentAssemblyid = @ParentAssemblyId
        GROUP BY 
            m.assemblyid, m.community, m.assembly, m.model, m.optionid, 
            m.description, c.qty
        ORDER BY m.assembly";
    }

    private string BuildItemsQuery_NoPricing()
    {
        return @"
        SELECT 
            d.sequence,
            d.Invertable,
            CASE WHEN v.phase IS NULL THEN 0 ELSE 1 END AS hasInverseItem,
            d.UseModelCost,
            i.Description,
            i.OrderUOM,
            ISNULL(ISNULL(d.POIndex,''), ISNULL(i.POIndex,'')) AS POIndex,
            p.FullDescription AS POIndexDescription,
            cc.CostCode AS JCCostCode,
            cc.Description AS JCCostCodeDesc,
            ct.Category AS JCCategory,
            ct.Description AS JCCategoryDesc,
            i.TakeoffUOM,
            i.rounddir,
            i.roundto,
            d.Phase,
            d.Item,
            d.itemchart,
            i.itemnumber,
            d.Formula,
            d.TakeoffQty,
            d.OrderQty,
            d.notes,
            i.IsQuote,
            i.WastePercent,
            d.Location,
            d.WBS01, d.WBS02, d.WBS03, d.WBS04, d.WBS05, d.WBS06, d.WBS07, d.WBS08, d.WBS09, d.WBS10,
            d.WBS11, d.WBS12, d.WBS13, d.WBS14, d.WBS15, d.WBS16, d.WBS17, d.WBS18, d.WBS19, d.WBS20,
            d.WBS21, d.WBS22, d.WBS23, d.WBS24, d.WBS25, d.WBS26, d.WBS27, d.WBS28, d.WBS29, d.WBS30,
            d.WBS31, d.WBS32, d.WBS33, d.WBS34, d.WBS35, d.WBS36, d.WBS37, d.WBS38, d.WBS39, d.WBS40,
            d.ConversionFactor AS AssemblyConversionFactor,
            i.ConversionFactor AS ItemConversionFactor
        FROM tblDBAssemblyDetails d
        LEFT OUTER JOIN tblPhaseItem i 
            ON d.DivisionID = i.DivisionID 
            AND d.Phase = i.Phase 
            AND d.Item = i.Item
        LEFT OUTER JOIN tblPhaseItem v 
            ON i.DivisionID = v.DivisionID 
            AND i.inversePhase = v.Phase 
            AND i.inverseItem = v.Item
        LEFT OUTER JOIN tblPOIndex p 
            ON p.DivisionID = d.DivisionID 
            AND ISNULL(ISNULL(d.POIndex,''), ISNULL(i.POIndex,'')) = p.POIndex
        LEFT OUTER JOIN appoptions o 
            ON o.optionname = 'UseAltCostCodesForCO' 
            AND o.DivisionID = d.DivisionID
        LEFT OUTER JOIN StandardCostCodes cc 
            ON cc.DivisionID = i.DivisionID 
            AND cc.costcode = ISNULL(
                CASE 
                    WHEN ISNULL(d.optionid,'') = '' OR o.optionvalue = 'true' 
                    THEN i.jccostcode 
                    ELSE ISNULL(ISNULL(i.altjccostcode,''), i.jccostcode) 
                END, 
                p.jccostcode
            )
        LEFT OUTER JOIN StandardCategories ct 
            ON ct.DivisionID = i.DivisionID 
            AND ct.category = ISNULL(
                CASE 
                    WHEN ISNULL(d.optionid,'') = '' OR o.optionvalue = 'true' 
                    THEN i.jccategory 
                    ELSE ISNULL(ISNULL(i.altjccategory,''), i.jccategory) 
                END, 
                p.jccategory
            )
        WHERE d.DivisionID = @DivisionID 
          AND ISNULL(d.Community,'') = @Community
          AND ISNULL(d.Assembly,'') = @Assembly
          AND ISNULL(d.Model,'') = @Model
          AND ISNULL(d.Optionid,'') = @OptionID
        ORDER BY d.Phase, d.Item, d.itemchart, d.Sequence";
    }

    private string BuildItemsQuery_WithPricing()
    {
        return @"
        SELECT 
            d.sequence,
            d.Invertable,
            CASE WHEN iv.phase IS NULL THEN 0 ELSE 1 END AS hasInverseItem,
            d.UseModelCost,
            i.Description,
            i.OrderUOM,
            ISNULL(ISNULL(d.POIndex,''), ISNULL(i.POIndex,'')) AS POIndex,
            p.FullDescription AS POIndexDescription,
            cc.CostCode AS JCCostCode,
            cc.Description AS JCCostCodeDesc,
            ct.Category AS JCCategory,
            ct.Description AS JCCategoryDesc,
            i.TakeoffUOM,
            i.rounddir,
            i.roundto,
            d.Phase,
            d.Item,
            d.itemchart,
            i.itemnumber,
            d.Formula,
            d.TakeoffQty,
            d.OrderQty,
            d.notes,
            i.IsQuote,
            i.WastePercent,
            v.vendor_id AS Vendor,
            v.vendor_name AS VendorDesc,
            dbo.Purch_GetItemRate(0, 0,@PricingCommunity,@PricingCommunityPhase,d.Assembly,d.Model,d.OptionID,d.Phase,d.Item,d.Sequence,v.Vendor_id,GETDATE(),@DivisionID) AS Rate,
            dbo.Purch_GetItemRateQuality(0, 0,@PricingCommunity,@PricingCommunityPhase,d.Assembly,d.Model,d.OptionID,d.Phase,d.Item,d.Sequence,v.Vendor_id,GETDATE(),@DivisionID) AS RateQuality,
            t.JCRate AS JCTaxRate,
            d.Location,
            d.WBS01, d.WBS02, d.WBS03, d.WBS04, d.WBS05, d.WBS06, d.WBS07, d.WBS08, d.WBS09, d.WBS10,
            d.WBS11, d.WBS12, d.WBS13, d.WBS14, d.WBS15, d.WBS16, d.WBS17, d.WBS18, d.WBS19, d.WBS20,
            d.WBS21, d.WBS22, d.WBS23, d.WBS24, d.WBS25, d.WBS26, d.WBS27, d.WBS28, d.WBS29, d.WBS30,
            d.WBS31, d.WBS32, d.WBS33, d.WBS34, d.WBS35, d.WBS36, d.WBS37, d.WBS38, d.WBS39, d.WBS40,
            d.ConversionFactor AS AssemblyConversionFactor,
            i.ConversionFactor AS ItemConversionFactor
        FROM tblDBAssemblyDetails d
        LEFT OUTER JOIN tblPhaseItem i 
            ON d.DivisionID = i.DivisionID AND d.Phase = i.Phase AND d.Item = i.Item
        LEFT OUTER JOIN tblPhaseItem iv 
            ON i.DivisionID = iv.DivisionID AND i.inversePhase = iv.Phase AND i.inverseItem = iv.Item
        LEFT OUTER JOIN tblPOIndex p 
            ON p.DivisionID = @DivisionID 
            AND ISNULL(ISNULL(d.POindex,''), ISNULL(i.POIndex,'')) = p.POIndex
        LEFT OUTER JOIN appoptions o 
            ON o.optionname = 'UseAltCostCodesForCO' AND o.DivisionID = d.DivisionID
        LEFT OUTER JOIN StandardCostCodes cc 
            ON cc.DivisionID = i.DivisionID 
            AND cc.costcode = ISNULL(
                CASE WHEN ISNULL(d.optionid,'') = '' OR o.optionvalue = 'true' 
                     THEN i.jccostcode 
                     ELSE ISNULL(ISNULL(i.altjccostcode,''), i.jccostcode) 
                END, p.jccostcode)
        LEFT OUTER JOIN StandardCategories ct 
            ON ct.DivisionID = i.DivisionID 
            AND ct.category = ISNULL(
                CASE WHEN ISNULL(d.optionid,'') = '' OR o.optionvalue = 'true' 
                     THEN i.jccategory 
                     ELSE ISNULL(ISNULL(i.altjccategory,''), i.jccategory) 
                END, p.jccategory)
        LEFT OUTER JOIN tblvendors v 
            ON v.DivisionID = d.DivisionID 
            AND v.vendor_id = dbo.Purch_GetCommunityVendor(@PricingCommunity, p.POIndex, @DivisionID)
        LEFT OUTER JOIN taxGroups t 
            ON t.DivisionID = @DivisionID 
            AND t.TaxGroup = dbo.Purch_GetDefaultTaxGroup('', @PricingCommunity, '', d.Model, d.Assembly, i.phase, i.item, v.Vendor_ID, i.JCCategory, @DivisionID)
        WHERE d.DivisionID = @DivisionID 
          AND ISNULL(d.Community,'') = @Community
          AND ISNULL(d.Assembly,'') = @Assembly
          AND ISNULL(d.Model,'') = @Model
          AND ISNULL(d.Optionid,'') = @OptionID
        ORDER BY d.Phase, d.Item, d.itemchart, d.Sequence";
    }

