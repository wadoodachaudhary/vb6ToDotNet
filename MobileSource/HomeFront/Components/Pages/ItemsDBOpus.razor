    // === Load Items for Selected Phase ===
    private async Task LoadItemsAsync()
    {
        if (SelectedPhase == null) return;
        IsLoading = true;
        StateHasChanged();
        try
        {
            var whereClause = $"i.Phase = '{SelectedPhase.Phase}'";
            var sql = $@"
                SELECT
                    i.Phase, i.Item, i.CostCategory,
                    i.Description AS ItemDesc, i.Notes, i.Formula,
                    i.POIndex, p.Description AS POIndexDescription,
                    i.JCCostCode, cc.Description AS JCCostCodeDesc,
                    i.JCCategory, cat.Description AS JCCategoryDesc,
                    i.AltJCCostCode, acc.Description AS AltJCCostCodeDesc,
                    i.AltJCCategory, acat.Description AS AltJCCategoryDesc,
                    i.TaxGroup, i.TakeoffUOM, i.OrderUOM,
                    i.ConversionFactor, i.Price, i.WastePercent,
                    i.RoundDir, i.RoundTo, i.PartNumber,
                    i.OptionID, i.OptionCategory, i.Color, i.Location,
                    i.RetailPretax, i.IsQuote, i.UseInFieldPO,
                    i.PriceLink,
                    ISNULL(inv.Phase, '') + CASE WHEN inv.Phase IS NOT NULL THEN '/' + inv.Item + ' - ' + ISNULL(inv.Description, '') ELSE '' END AS InverseItemDesc
                FROM tblPhaseItem i
                LEFT JOIN tblPOIndex p ON i.POIndex = p.POIndex AND i.DivisionID = p.DivisionID
                LEFT JOIN StandardCostCodes cc ON i.JCCostCode = cc.CostCode AND i.DivisionID = cc.DivisionID
                LEFT JOIN StandardCategories cat ON i.JCCategory = cat.Category AND i.DivisionID = cat.DivisionID
                LEFT JOIN StandardCostCodes acc ON i.AltJCCostCode = acc.CostCode AND i.DivisionID = acc.DivisionID
                LEFT JOIN StandardCategories acat ON i.AltJCCategory = acat.Category AND i.DivisionID = acat.DivisionID
                LEFT JOIN tblPhaseItem inv ON i.InversePhase = inv.Phase AND i.InverseItem = inv.Item AND i.DivisionID = inv.DivisionID
                WHERE i.DivisionID = {DivisionID} AND {whereClause}
                ORDER BY i.Phase, i.Item";

            var rows = await db.QueryAsync(sql);
            ItemsData = rows.Select(r => new ItemRow
            {
                Phase = r["Phase"]?.ToString() ?? "",
                Item = r["Item"]?.ToString() ?? "",
                CostCategory = r["CostCategory"]?.ToString() ?? "",
                ItemDesc = r["ItemDesc"]?.ToString() ?? "",
                Notes = r["Notes"]?.ToString() ?? "",
                Formula = r["Formula"]?.ToString() ?? "",
                POIndex = r["POIndex"]?.ToString() ?? "",
                POIndexDescription = r["POIndexDescription"]?.ToString() ?? "",
                JCCostCode = r["JCCostCode"]?.ToString() ?? "",
                JCCostCodeDesc = r["JCCostCodeDesc"]?.ToString() ?? "",
                JCCategory = r["JCCategory"]?.ToString() ?? "",
                JCCategoryDesc = r["JCCategoryDesc"]?.ToString() ?? "",
                AltJCCostCode = r["AltJCCostCode"]?.ToString() ?? "",
                AltJCCostCodeDesc = r["AltJCCostCodeDesc"]?.ToString() ?? "",
                AltJCCategory = r["AltJCCategory"]?.ToString() ?? "",
                AltJCCategoryDesc = r["AltJCCategoryDesc"]?.ToString() ?? "",
                TaxGroup = r["TaxGroup"]?.ToString() ?? "",
                TakeoffUOM = r["TakeoffUOM"]?.ToString() ?? "",
                OrderUOM = r["OrderUOM"]?.ToString() ?? "",
                ConversionFactor = r["ConversionFactor"] != null && r["ConversionFactor"] != DBNull.Value
                    ? Convert.ToDecimal(r["ConversionFactor"]) : 1,
                Price = r["Price"] != null && r["Price"] != DBNull.Value
                    ? Convert.ToDecimal(r["Price"]) : 0,
                WastePercent = r["WastePercent"] != null && r["WastePercent"] != DBNull.Value
                    ? Convert.ToInt32(r["WastePercent"]) : 0,
                RoundDir = r["RoundDir"] != null && r["RoundDir"] != DBNull.Value
                    ? Convert.ToInt32(r["RoundDir"]) : 0,
                RoundTo = r["RoundTo"] != null && r["RoundTo"] != DBNull.Value
                    ? Convert.ToDecimal(r["RoundTo"]) : 0,
                PartNumber = r["PartNumber"]?.ToString() ?? "",
                OptionID = r["OptionID"]?.ToString() ?? "",
                OptionCategory = r["OptionCategory"]?.ToString() ?? "",
                Color = r["Color"]?.ToString() ?? "",
                Location = r["Location"]?.ToString() ?? "",
                RetailPretax = r["RetailPretax"] != null && r["RetailPretax"] != DBNull.Value
                    ? Convert.ToDecimal(r["RetailPretax"]) : 0,
                IsQuote = r["IsQuote"]?.ToString() == "True" || r["IsQuote"]?.ToString() == "1",
                UseInFieldPO = r["UseInFieldPO"]?.ToString() == "True" || r["UseInFieldPO"]?.ToString() == "1",
                PriceLink = r["PriceLink"] != null && r["PriceLink"] != DBNull.Value
                    ? Convert.ToInt32(r["PriceLink"]) : 0,
                InverseItemDesc = r["InverseItemDesc"]?.ToString() ?? "",
                RowState = "CLEAN"
            }).ToList();
            mDirty = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadItemsAsync error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading items: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Save Data ===
    private async Task<bool> SaveDataAsync(bool prompt = false)
    {
        if (!mDirty) return true;
        if (prompt)
        {
            var result = await JSRuntime.InvokeAsync<bool>("confirm",
                "Item Database has changed. Do you want to save these changes?");
            if (!result) return true;
        }
        IsLoading = true;
        StateHasChanged();
        try
        {
            foreach (var item in ItemsData.Where(i => i.RowState == "Deleted"))
            {
                await db.ExecuteAsync($@"
                    DELETE FROM tblPhaseItem WHERE DivisionID = {DivisionID}
                    AND Phase = @Phase AND Item = @Item",
                    new { item.Phase, item.Item });
                await db.ExecuteAsync($@"
                    DELETE FROM tblDBAssemblyDetails WHERE DivisionID = {DivisionID}
                    AND Phase = @Phase AND Item = @Item",
                    new { item.Phase, item.Item });
            }

            foreach (var item in ItemsData.Where(i => i.RowState == "DIRTY" || i.RowState == "DDIRTY"))
            {
                var sql = $@"
                    UPDATE tblPhaseItem SET
                        Description = @ItemDesc, Formula = @Formula, Notes = @Notes,
                        PartNumber = @PartNumber, POIndex = @POIndex,
                        JCCostCode = @JCCostCode, JCCategory = @JCCategory,
                        AltJCCostCode = @AltJCCostCode, AltJCCategory = @AltJCCategory,
                        OrderUOM = @OrderUOM, TakeoffUOM = @TakeoffUOM,
                        OptionID = @OptionID, OptionCategory = @OptionCategory,
                        Color = @Color, Location = @Location,
                        RetailPretax = @RetailPretax, ConversionFactor = @ConversionFactor,
                        WastePercent = @WastePercent, RoundDir = @RoundDir, RoundTo = @RoundTo,
                        Price = @Price, TaxGroup = @TaxGroup,
                        IsQuote = @IsQuote, UseInFieldPO = @UseInFieldPO,
                        TStmp = GETDATE()
                    WHERE DivisionID = {DivisionID} AND Phase = @Phase AND Item = @Item";
                await db.ExecuteAsync(sql, new
                {
                    item.Phase, item.Item, item.ItemDesc, item.Formula, item.Notes,
                    item.PartNumber, item.POIndex, item.JCCostCode, item.JCCategory,
                    item.AltJCCostCode, item.AltJCCategory, item.OrderUOM, item.TakeoffUOM,
                    item.OptionID, item.OptionCategory, item.Color, item.Location,
                    item.RetailPretax, item.ConversionFactor, item.WastePercent,
                    item.RoundDir, item.RoundTo, item.Price, item.TaxGroup,
                    item.IsQuote, item.UseInFieldPO
                });
                item.RowState = "CLEAN";
            }

            ItemsData.RemoveAll(i => i.RowState == "Deleted");
            mDirty = false;
            await JSRuntime.InvokeVoidAsync("alert", "Data saved successfully.");
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SaveDataAsync error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving data: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

