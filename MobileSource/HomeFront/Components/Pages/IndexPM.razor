@page "/PMTest"
@rendermode InteractiveServer
@using HomeFront.Data
@using Microsoft.AspNetCore.Components
<DiagramControl Nodes="nodes" Connectors="connectors" Width="800" Height="400">
</DiagramControl>

@code {
    List<DiagramNode> nodes = new()
    {
        new() { Id = "start", Label = "Start", OffsetX = 100, OffsetY = 100, 
            Shape = DiagramControlShape.Stadium, FillColor = "#27AE60" },
        new() { Id = "review", Label = "Review", OffsetX = 300, OffsetY = 100,
            NavigateUrl = "/review-page" },
        new() { Id = "approve", Label = "Approve?", OffsetX = 500, OffsetY = 100,
            Shape = DiagramControlShape.Diamond, Width = 120, Height = 80 }
    };
    List<DiagramConnector> connectors = new()
    {
        new() { Id = "c1", SourceId = "start", TargetId = "review", Label = "Submit" },
        new() { Id = "c2", SourceId = "review", TargetId = "approve" }
    };
}
