@page "/items-codex"
@page "/items-db-codex"
@rendermode InteractiveServer
@using HomeFront.Data
@using System.Data
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop

<PageTitle>Item Database</PageTitle>

<div class="tabs-container">
    <div class="tab-buttons">
        <button class="@(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">.NET</button>
        <button class="@(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">VB6</button>
    </div>

    <div class="tab-content">
        @if (activeTab == 1)
        {
            <div class="panel">
                <div class="toolbar-cntr">
                    <button class="e-btn" @onclick="OnNewItemClick">
                        <img src="images/32/new.ico" class="tbar-icon" alt="New" />
                        <span class="tool-label">New</span>
                    </button>
                    <button class="e-btn" @onclick="OnDuplicateClick">
                        <img src="images/32/copy.ico" class="tbar-icon" alt="Duplicate" />
                        <span class="tool-label">Duplicate</span>
                    </button>
                    <button class="e-btn" @onclick="OnDeleteClick">
                        <img src="images/32/delete.ico" class="tbar-icon" alt="Delete" />
                        <span class="tool-label">Delete</span>
                    </button>
                    <button class="e-btn" @onclick="OnSaveClick">
                        <img src="images/32/save.ico" class="tbar-icon" alt="Save" />
                        <span class="tool-label">Save</span>
                    </button>
                    <button class="e-btn" @onclick="OnExcelExport">
                        <img src="images/32/excelexport.ico" class="tbar-icon" alt="Export" />
                        <span class="tool-label">Export</span>
                    </button>
                    <button class="e-btn" @onclick="OnExcelImport">
                        <img src="images/32/excelimport.ico" class="tbar-icon" alt="Import" />
                        <span class="tool-label">Import</span>
                    </button>
                    <button class="e-btn" @onclick="OnRefreshClick">
                        <img src="images/32/refresh.ico" class="tbar-icon" alt="Refresh" />
                        <span class="tool-label">Refresh</span>
                    </button>

                    <select class="view-selector" @bind="CurrentViewIndex" @bind:after="OnViewChanged">
                        @for (var i = 0; i < ViewDefinitions.Count; i++)
                        {
                            <option value="@i">@ViewDefinitions[i].Name</option>
                        }
                    </select>
                </div>

                <h3 class="page-title">Item Database - @CurrentViewName</h3>

                <div class="split-container">
                    <div class="phases-panel">
                        <div class="phase-header">
                            @CurrentViewName
                            <button class="e-btn" @onclick="OnExpandAll">Expand</button>
                            <button class="e-btn" @onclick="OnCollapseAll">Collapse</button>
                        </div>
                        <HfTreeGrid @ref="PhasesTreeGrid"
                                    TValue="PhaseNode"
                                    DataSource="@PhasesData"
                                    IdMapping="Id"
                                    ParentIdMapping="ParentId"
                                    TreeColumnIndex="0"
                                    EnableCollapseAll="false"
                                    AllowSelection="true"
                                    Height="100%"
                                    RowSelected="OnPhaseSelected">
                            <HfTreeGridColumns>
                                <HfTreeGridColumn Field="@nameof(PhaseNode.DisplayText)" HeaderText="Task Name" Width="300px" />
                            </HfTreeGridColumns>
                        </HfTreeGrid>
                    </div>

                    <div class="items-panel">
                        <HfGrid @ref="ItemsGrid"
                                DataSource="@ItemsData"
                                TValue="ItemRow"
                                AllowPaging="true"
                                AllowSorting="true"
                                AllowFiltering="true"
                                AllowSelection="true"
                                AllowMultiSorting="true"
                                EnableHover="true"
                                Height="100%"
                                FilterSettingsRef="@filterSettings"
                                PageSettingsRef="@pageSettings"
                                SelectionSettingsRef="@selectionSettings"
                                EventsRef="@itemsEvents">
                            <HfGridColumnsBase>
                                <HfGridColumn Field="@nameof(ItemRow.Phase)" HeaderText="Phase" Width="100px" AllowEditing="false" />
                                <HfGridColumn Field="@nameof(ItemRow.Item)" HeaderText="Item" Width="100px" AllowEditing="false" />
                                <HfGridColumn Field="@nameof(ItemRow.CostCategory)" HeaderText="Type" Width="60px" AllowEditing="false" />
                                <HfGridColumn Field="@nameof(ItemRow.ItemDesc)" HeaderText="Description" Width="250px">
                                    <Template>
                                        @{
                                            var data = (ItemRow)context;
                                            <div class="inline-edit">
                                                <span>@data.ItemDesc</span>
                                                <button class="mini-btn" @onclick="() => OnEditDescription(data)">Edit</button>
                                            </div>
                                        }
                                    </Template>
                                </HfGridColumn>
                                <HfGridColumn Field="@nameof(ItemRow.POIndex)" HeaderText="PO Index" Width="120px">
                                    <Template>
                                        @{
                                            var data = (ItemRow)context;
                                            <select class="inline-select" value="@data.POIndex" @onchange="e => OnPOIndexChanged(e, data)">
                                                <option value="">--</option>
                                                @foreach (var po in POIndexList)
                                                {
                                                    <option value="@po.POIndex">@po.Description</option>
                                                }
                                            </select>
                                        }
                                    </Template>
                                </HfGridColumn>
                                <HfGridColumn Field="@nameof(ItemRow.POIndexDescription)" HeaderText="PO Description" Width="150px" AllowEditing="false" />
                                <HfGridColumn Field="@nameof(ItemRow.JCCostCode)" HeaderText="Cost Code" Width="120px">
                                    <Template>
                                        @{
                                            var data = (ItemRow)context;
                                            <select class="inline-select" value="@data.JCCostCode" @onchange="e => OnCostCodeChanged(e, data)">
                                                <option value="">--</option>
                                                @foreach (var costCode in CostCodeList)
                                                {
                                                    <option value="@costCode.CostCode">@costCode.Description</option>
                                                }
                                            </select>
                                        }
                                    </Template>
                                </HfGridColumn>
                                <HfGridColumn Field="@nameof(ItemRow.JCCostCodeDesc)" HeaderText="Cost Code Desc" Width="150px" AllowEditing="false" />
                                <HfGridColumn Field="@nameof(ItemRow.JCCategory)" HeaderText="Category" Width="120px">
                                    <Template>
                                        @{
                                            var data = (ItemRow)context;
                                            <select class="inline-select" value="@data.JCCategory" @onchange="e => OnCategoryChanged(e, data)">
                                                <option value="">--</option>
                                                @foreach (var cat in CategoryList)
                                                {
                                                    <option value="@cat.Category">@cat.Description</option>
                                                }
                                            </select>
                                        }
                                    </Template>
                                </HfGridColumn>
                                <HfGridColumn Field="@nameof(ItemRow.JCCategoryDesc)" HeaderText="Category Desc" Width="150px" AllowEditing="false" />
                                <HfGridColumn Field="@nameof(ItemRow.TaxGroup)" HeaderText="Tax Group" Width="120px">
                                    <Template>
                                        @{
                                            var data = (ItemRow)context;
                                            <select class="inline-select" value="@data.TaxGroup" @onchange="e => OnTaxGroupChanged(e, data)">
                                                <option value="">--</option>
                                                @foreach (var tax in TaxGroupList)
                                                {
                                                    <option value="@tax.TaxGroup">@tax.Description</option>
                                                }
                                            </select>
                                        }
                                    </Template>
                                </HfGridColumn>
                                <HfGridColumn Field="@nameof(ItemRow.Formula)" HeaderText="Formula" Width="140px">
                                    <Template>
                                        @{
                                            var data = (ItemRow)context;
                                            <div class="inline-edit">
                                                <span>@TruncateText(data.Formula, 12)</span>
                                                <button class="mini-btn" @onclick="() => OnEditFormula(data)">Edit</button>
                                            </div>
                                        }
                                    </Template>
                                </HfGridColumn>
                                <HfGridColumn Field="@nameof(ItemRow.Notes)" HeaderText="Notes" Width="140px">
                                    <Template>
                                        @{
                                            var data = (ItemRow)context;
                                            <div class="inline-edit">
                                                <span>@TruncateText(data.Notes, 12)</span>
                                                <button class="mini-btn" @onclick="() => OnEditNotes(data)">Edit</button>
                                            </div>
                                        }
                                    </Template>
                                </HfGridColumn>
                                <HfGridColumn Field="@nameof(ItemRow.InverseItemDesc)" HeaderText="Inverse Item" Width="200px">
                                    <Template>
                                        @{
                                            var data = (ItemRow)context;
                                            <div class="inline-edit">
                                                <span>@TruncateText(data.InverseItemDesc, 16)</span>
                                                <button class="mini-btn" @onclick="() => OnSelectInverseItem(data)">Select</button>
                                            </div>
                                        }
                                    </Template>
                                </HfGridColumn>
                            </HfGridColumnsBase>
                        </HfGrid>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="panel">
                <img src="images/VB6/Screen_IndexItems.png" class="task-icon-vb6" />
            </div>
        }
    </div>
</div>

<style>
    .tabs-container {
        margin: 20px auto;
        font-family: sans-serif;
    }

    .task-icon-vb6 {
        width: 2000px;
        height: auto;
        display: block;
    }

    .tab-buttons {
        display: flex;
        border-bottom: 2px solid #ddd;
    }

    .tab-buttons button {
        padding: 12px 24px;
        border: none;
        background: #f0f0f0;
        cursor: pointer;
        font-size: 16px;
        transition: background 0.2s;
    }

    .tab-buttons button.active {
        background: #fff;
        border-bottom: 2px solid #007bff;
        margin-bottom: -2px;
        color: #007bff;
        font-weight: bold;
    }

    .tab-content {
        padding: 20px;
        border: 1px solid #ddd;
        border-top: none;
        background: #fff;
    }

    .panel {
        text-align: center;
    }

    .panel img {
        max-width: 100%;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .toolbar-cntr {
        padding-top: 12px;
        padding-bottom: 12px;
        border-top: 1px solid #c9c9c9;
        border-bottom: 1px solid #c9c9c9;
        margin-bottom: 10px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .tool-label {
        width: 100%;
        display: block;
    }

    .e-btn {
        margin-right: 5px;
        padding: 6px 10px;
        border: 1px solid #c9c9c9;
        background: #f8f9fa;
        border-radius: 4px;
        cursor: pointer;
    }

    .tbar-icon {
        width: 24px;
        height: 24px;
        margin-bottom: 4px;
    }

    .split-container {
        display: flex;
        height: calc(100vh - 200px);
        min-height: 500px;
    }

    .phases-panel {
        width: 380px;
        min-width: 200px;
        max-width: 600px;
        border-right: 3px solid #c9c9c9;
        overflow: auto;
        resize: horizontal;
    }

    .items-panel {
        flex: 1;
        overflow: auto;
        padding-left: 10px;
    }

    .page-title {
        font-size: 24px;
        font-weight: 600;
        margin-bottom: 15px;
        color: #333;
    }

    .phase-header {
        padding: 10px;
        background-color: #f5f5f5;
        border-bottom: 1px solid #ddd;
        font-weight: bold;
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: space-between;
    }

    .view-selector {
        padding: 6px 10px;
        border: 1px solid #c9c9c9;
        border-radius: 4px;
    }

    .inline-edit {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .inline-select {
        width: 100%;
    }

    .mini-btn {
        padding: 2px 6px;
        font-size: 12px;
        border: 1px solid #c9c9c9;
        background: #fff;
        border-radius: 4px;
        cursor: pointer;
    }
</style>

@code {
    [Inject] public IJSRuntime JSRuntime { get; set; } = default!;

    private readonly DbWrapperSqlServer db = new();
    private int activeTab = 1;
    private bool IsLoading;
    private bool mDirty;

    private HfGrid<ItemRow>? ItemsGrid;
    private HfTreeGrid<PhaseNode>? PhasesTreeGrid;
    private readonly HfGridEvents<ItemRow> itemsEvents = new();
    private List<ViewDefinition> ViewDefinitions = new();
    private int CurrentViewIndex = 0;
    private string CurrentViewName => ViewDefinitions[CurrentViewIndex].Name;

    private List<PhaseNode> PhasesData = new();
    private List<ItemRow> ItemsData = new();
    private List<POIndexItem> POIndexList = new();
    private List<CostCodeItem> CostCodeList = new();
    private List<CategoryItem> CategoryList = new();
    private List<TaxGroupItem> TaxGroupList = new();

    private ItemRow? SelectedItem;
    private PhaseNode? SelectedPhase;

    private int DivisionID = 1;

    private readonly HfFilterSettings filterSettings = new() { Type = FilterType.FilterBar };
    private readonly HfPageSettings pageSettings = new() { PageSize = 50 };
    private readonly HfSelectionSettings selectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Multiple,
        EnableToggle = true
    };

    protected override async Task OnInitializedAsync()
    {
        InitializeViewDefinitions();
        await LoadLookupData();
        await LoadPhasesAsync();
        itemsEvents.OnRecordClick = EventCallback.Factory.Create<CellClickEventArgs<ItemRow>>(this, OnItemSelected);
    }

    private void InitializeViewDefinitions()
    {
        ViewDefinitions = new List<ViewDefinition>
        {
            new ViewDefinition
            {
                Name = "Group and Phase",
                KeyFields = "GrpPhase, Phase",
                DisplayFields = "GrpPhase + ' - ' + GrpDesc, Phase + ' - ' + PhaseDesc",
                SortFields = "GrpSortOrder, PhaseSortOrder, ItemSortOrder"
            },
            new ViewDefinition
            {
                Name = "Purchase Order",
                KeyFields = "POIndex",
                DisplayFields = "POIndex + ' ' + POIndexDescription",
                SortFields = "POIndex"
            },
            new ViewDefinition
            {
                Name = "Cost Code",
                KeyFields = "JCCostCode",
                DisplayFields = "LTRIM(JCCostCode) + ' - ' + JCCostCodeDesc",
                SortFields = "LTRIM(JCCostCode)"
            }
        };
    }

    private async Task LoadLookupData()
    {
        try
        {
            var poIndexes = await db.QueryAsync(
                $"SELECT POIndex, Description FROM tblPOIndex WHERE DivisionID = {DivisionID} ORDER BY POIndex");
            POIndexList = poIndexes.Select(r => new POIndexItem
            {
                POIndex = r["POIndex"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? ""
            }).ToList();

            var costCodes = await db.QueryAsync(
                $"SELECT CostCode, Description FROM StandardCostCodes WHERE DivisionID = {DivisionID} ORDER BY CostCode");
            CostCodeList = costCodes.Select(r => new CostCodeItem
            {
                CostCode = r["CostCode"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? ""
            }).ToList();

            var categories = await db.QueryAsync(
                $"SELECT Category, Description FROM StandardCategories WHERE DivisionID = {DivisionID} ORDER BY Category");
            CategoryList = categories.Select(r => new CategoryItem
            {
                Category = r["Category"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? ""
            }).ToList();

            var taxGroups = await db.QueryAsync(
                $"SELECT TaxGroup, Description FROM TaxGroups WHERE DivisionID = {DivisionID} ORDER BY TaxGroup");
            TaxGroupList = taxGroups.Select(r => new TaxGroupItem
            {
                TaxGroup = r["TaxGroup"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? ""
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadLookupData error: {ex.Message}");
        }
    }

    private async Task LoadPhasesAsync()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            PhasesData.Clear();
            var nodeId = 1;
            if (CurrentViewIndex == 0)
            {
                var groups = await db.QueryAsync($@"
                    SELECT DISTINCT 
                        p.GroupPhaseValue AS GrpPhase,
                        g.Description AS GrpDesc,
                        g.SortOrder AS GrpSortOrder
                    FROM tblEstPhases p
                    LEFT JOIN tblEstPhases g ON p.GroupPhaseValue = g.Phase AND g.DivisionID = p.DivisionID
                    WHERE p.DivisionID = {DivisionID} AND p.GroupPhase = 0 AND p.GroupPhaseValue <> p.Phase
                    ORDER BY g.SortOrder, p.GroupPhaseValue");
                foreach (var group in groups)
                {
                    var grpPhase = group["GrpPhase"]?.ToString() ?? "";
                    var grpDesc = group["GrpDesc"]?.ToString() ?? "";
                    var groupNode = new PhaseNode
                    {
                        Id = nodeId++,
                        ParentId = null,
                        DisplayText = $"{grpPhase} - {grpDesc}",
                        KeyValue = grpPhase,
                        WhereClause = $"GrpPhase = '{grpPhase}'"
                    };
                    PhasesData.Add(groupNode);

                    var phases = await db.QueryAsync($@"
                        SELECT Phase, Description, SortOrder
                        FROM tblEstPhases 
                        WHERE DivisionID = {DivisionID} 
                          AND GroupPhase = 0 
                          AND GroupPhaseValue = '{grpPhase}'
                        ORDER BY SortOrder, Phase");
                    foreach (var phase in phases)
                    {
                        var phaseCode = phase["Phase"]?.ToString() ?? "";
                        var phaseDesc = phase["Description"]?.ToString() ?? "";
                        PhasesData.Add(new PhaseNode
                        {
                            Id = nodeId++,
                            ParentId = groupNode.Id,
                            DisplayText = $"{phaseCode} - {phaseDesc}",
                            KeyValue = phaseCode,
                            WhereClause = $"Phase = '{phaseCode}'"
                        });
                    }
                }
            }
            else if (CurrentViewIndex == 1)
            {
                var poIndexes = await db.QueryAsync($@"
                    SELECT DISTINCT POIndex, 
                           (SELECT TOP 1 Description FROM tblPOIndex WHERE POIndex = i.POIndex AND DivisionID = {DivisionID}) AS Description
                    FROM tblPhaseItem i
                    WHERE DivisionID = {DivisionID} AND POIndex IS NOT NULL AND POIndex <> ''
                    ORDER BY POIndex");
                foreach (var poi in poIndexes)
                {
                    var poIndex = poi["POIndex"]?.ToString() ?? "";
                    var desc = poi["Description"]?.ToString() ?? "";
                    PhasesData.Add(new PhaseNode
                    {
                        Id = nodeId++,
                        ParentId = null,
                        DisplayText = $"{poIndex} - {desc}",
                        KeyValue = poIndex,
                        WhereClause = $"POIndex = '{poIndex}'"
                    });
                }
            }
            else if (CurrentViewIndex == 2)
            {
                var costCodes = await db.QueryAsync($@"
                    SELECT DISTINCT i.JCCostCode,
                           (SELECT TOP 1 Description FROM StandardCostCodes WHERE CostCode = i.JCCostCode AND DivisionID = {DivisionID}) AS Description
                    FROM tblPhaseItem i
                    WHERE i.DivisionID = {DivisionID} AND i.JCCostCode IS NOT NULL AND i.JCCostCode <> ''
                    ORDER BY i.JCCostCode");
                foreach (var cc in costCodes)
                {
                    var costCode = cc["JCCostCode"]?.ToString() ?? "";
                    var desc = cc["Description"]?.ToString() ?? "";
                    PhasesData.Add(new PhaseNode
                    {
                        Id = nodeId++,
                        ParentId = null,
                        DisplayText = $"{costCode} - {desc}",
                        KeyValue = costCode,
                        WhereClause = $"JCCostCode = '{costCode}'"
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadPhasesAsync error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadItemsAsync()
    {
        if (SelectedPhase == null) return;
        IsLoading = true;
        StateHasChanged();
        try
        {
            var whereClause = SelectedPhase.WhereClause;
            var sql = $@"
                SELECT 
                    i.Phase, i.Item, i.CostCategory,
                    i.Description AS ItemDesc, i.Notes, i.Formula,
                    i.POIndex, p.Description AS POIndexDescription,
                    i.JCCostCode, cc.Description AS JCCostCodeDesc,
                    i.JCCategory, cat.Description AS JCCategoryDesc,
                    i.AltJCCostCode, acc.Description AS AltJCCostCodeDesc,
                    i.AltJCCategory, acat.Description AS AltJCCategoryDesc,
                    i.TaxGroup, i.TakeoffUOM, i.OrderUOM,
                    i.ConversionFactor, i.Price, i.WastePercent,
                    i.RoundDir, i.RoundTo, i.PartNumber,
                    i.OptionID, i.OptionCategory, i.Color, i.Location,
                    i.RetailPretax, i.IsQuote, i.UseInFieldPO,
                    i.PriceLink,
                    ISNULL(inv.Phase, '') + CASE WHEN inv.Phase IS NOT NULL THEN '/' + inv.Item + ' - ' + ISNULL(inv.Description, '') ELSE '' END AS InverseItemDesc
                FROM tblPhaseItem i
                LEFT JOIN tblPOIndex p ON i.POIndex = p.POIndex AND i.DivisionID = p.DivisionID
                LEFT JOIN StandardCostCodes cc ON i.JCCostCode = cc.CostCode AND i.DivisionID = cc.DivisionID
                LEFT JOIN StandardCategories cat ON i.JCCategory = cat.Category AND i.DivisionID = cat.DivisionID
                LEFT JOIN StandardCostCodes acc ON i.AltJCCostCode = acc.CostCode AND i.DivisionID = acc.DivisionID
                LEFT JOIN StandardCategories acat ON i.AltJCCategory = acat.Category AND i.DivisionID = acat.DivisionID
                LEFT JOIN tblPhaseItem inv ON i.InversePhase = inv.Phase AND i.InverseItem = inv.Item AND i.DivisionID = inv.DivisionID
                WHERE i.DivisionID = {DivisionID} AND {whereClause}
                ORDER BY i.Phase, i.Item";
            var rows = await db.QueryAsync(sql);
            ItemsData = rows.Select(r => new ItemRow
            {
                Phase = r["Phase"]?.ToString() ?? "",
                Item = r["Item"]?.ToString() ?? "",
                CostCategory = r["CostCategory"]?.ToString() ?? "",
                ItemDesc = r["ItemDesc"]?.ToString() ?? "",
                Notes = r["Notes"]?.ToString() ?? "",
                Formula = r["Formula"]?.ToString() ?? "",
                POIndex = r["POIndex"]?.ToString() ?? "",
                POIndexDescription = r["POIndexDescription"]?.ToString() ?? "",
                JCCostCode = r["JCCostCode"]?.ToString() ?? "",
                JCCostCodeDesc = r["JCCostCodeDesc"]?.ToString() ?? "",
                JCCategory = r["JCCategory"]?.ToString() ?? "",
                JCCategoryDesc = r["JCCategoryDesc"]?.ToString() ?? "",
                AltJCCostCode = r["AltJCCostCode"]?.ToString() ?? "",
                AltJCCostCodeDesc = r["AltJCCostCodeDesc"]?.ToString() ?? "",
                AltJCCategory = r["AltJCCategory"]?.ToString() ?? "",
                AltJCCategoryDesc = r["AltJCCategoryDesc"]?.ToString() ?? "",
                TaxGroup = r["TaxGroup"]?.ToString() ?? "",
                TakeoffUOM = r["TakeoffUOM"]?.ToString() ?? "",
                OrderUOM = r["OrderUOM"]?.ToString() ?? "",
                ConversionFactor = r["ConversionFactor"] != null && r["ConversionFactor"] != DBNull.Value
                    ? Convert.ToDecimal(r["ConversionFactor"])
                    : 1,
                Price = r["Price"] != null && r["Price"] != DBNull.Value
                    ? Convert.ToDecimal(r["Price"])
                    : 0,
                WastePercent = r["WastePercent"] != null && r["WastePercent"] != DBNull.Value
                    ? Convert.ToInt32(r["WastePercent"])
                    : 0,
                RoundDir = r["RoundDir"] != null && r["RoundDir"] != DBNull.Value
                    ? Convert.ToInt32(r["RoundDir"])
                    : 0,
                RoundTo = r["RoundTo"] != null && r["RoundTo"] != DBNull.Value
                    ? Convert.ToDecimal(r["RoundTo"])
                    : 0,
                PartNumber = r["PartNumber"]?.ToString() ?? "",
                OptionID = r["OptionID"]?.ToString() ?? "",
                OptionCategory = r["OptionCategory"]?.ToString() ?? "",
                Color = r["Color"]?.ToString() ?? "",
                Location = r["Location"]?.ToString() ?? "",
                RetailPretax = r["RetailPretax"] != null && r["RetailPretax"] != DBNull.Value
                    ? Convert.ToDecimal(r["RetailPretax"])
                    : 0,
                IsQuote = r["IsQuote"]?.ToString() == "True" || r["IsQuote"]?.ToString() == "1",
                UseInFieldPO = r["UseInFieldPO"]?.ToString() == "True" || r["UseInFieldPO"]?.ToString() == "1",
                PriceLink = r["PriceLink"] != null && r["PriceLink"] != DBNull.Value
                    ? Convert.ToInt32(r["PriceLink"])
                    : 0,
                InverseItemDesc = r["InverseItemDesc"]?.ToString() ?? "",
                RowState = "CLEAN"
            }).ToList();
            mDirty = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadItemsAsync error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading items: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task<bool> SaveDataAsync(bool prompt = false)
    {
        if (!mDirty) return true;
        if (prompt)
        {
            var result = await JSRuntime.InvokeAsync<bool>("confirm",
                "Item Database has changed. Do you want to save these changes?");
            if (!result) return true;
        }
        IsLoading = true;
        StateHasChanged();
        try
        {
            foreach (var item in ItemsData.Where(i => i.RowState == "Deleted"))
            {
                await db.ExecuteAsync($@"
                    DELETE FROM tblPhaseItem WHERE DivisionID = {DivisionID} 
                    AND Phase = @Phase AND Item = @Item",
                    new { item.Phase, item.Item });
                await db.ExecuteAsync($@"
                    DELETE FROM tblDBAssemblyDetails WHERE DivisionID = {DivisionID} 
                    AND Phase = @Phase AND Item = @Item",
                    new { item.Phase, item.Item });
            }
            foreach (var item in ItemsData.Where(i => i.RowState == "DIRTY" || i.RowState == "DDIRTY"))
            {
                var sql = $@"
                    UPDATE tblPhaseItem SET
                        Description = @ItemDesc,
                        Formula = @Formula,
                        Notes = @Notes,
                        PartNumber = @PartNumber,
                        POIndex = @POIndex,
                        JCCostCode = @JCCostCode,
                        JCCategory = @JCCategory,
                        AltJCCostCode = @AltJCCostCode,
                        AltJCCategory = @AltJCCategory,
                        OrderUOM = @OrderUOM,
                        TakeoffUOM = @TakeoffUOM,
                        OptionID = @OptionID,
                        OptionCategory = @OptionCategory,
                        Color = @Color,
                        Location = @Location,
                        RetailPretax = @RetailPretax,
                        ConversionFactor = @ConversionFactor,
                        WastePercent = @WastePercent,
                        RoundDir = @RoundDir,
                        RoundTo = @RoundTo,
                        Price = @Price,
                        TaxGroup = @TaxGroup,
                        IsQuote = @IsQuote,
                        UseInFieldPO = @UseInFieldPO,
                        TStmp = GETDATE()
                    WHERE DivisionID = {DivisionID} AND Phase = @Phase AND Item = @Item";
                await db.ExecuteAsync(sql, new
                {
                    item.Phase,
                    item.Item,
                    item.ItemDesc,
                    item.Formula,
                    item.Notes,
                    item.PartNumber,
                    item.POIndex,
                    item.JCCostCode,
                    item.JCCategory,
                    item.AltJCCostCode,
                    item.AltJCCategory,
                    item.OrderUOM,
                    item.TakeoffUOM,
                    item.OptionID,
                    item.OptionCategory,
                    item.Color,
                    item.Location,
                    item.RetailPretax,
                    item.ConversionFactor,
                    item.WastePercent,
                    item.RoundDir,
                    item.RoundTo,
                    item.Price,
                    item.TaxGroup,
                    item.IsQuote,
                    item.UseInFieldPO
                });
                item.RowState = "CLEAN";
            }

            ItemsData.RemoveAll(i => i.RowState == "Deleted");
            mDirty = false;
            await JSRuntime.InvokeVoidAsync("alert", "Data saved successfully.");
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SaveDataAsync error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving data: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

