    private async Task ShowPicklistDialog(string title, string sql, object parameters, string valueColumn, int fieldIndex)
    {
        try
        {
            var data = await db.QueryAsync(sql, parameters);
            if (!data.Any())
            {
                await JSRuntime.InvokeVoidAsync("alert", "No items found.");
                return;
            }
            PicklistTitle = title;
            PicklistData = data.ToList();
            PicklistColumns = data.First().Keys.ToList();
            var idCol = PicklistColumns[0];
            var idName = PicklistColumns[1];
            PickerItems = data.Select(r => new PickerItem
            {
                Id = r[idCol]?.ToString() ?? "",
                Name = r[idName]?.ToString() ?? ""
            }).ToList();

            PicklistValueColumn = valueColumn;
            CurrentPicklistFieldIndex = fieldIndex;
            SelectedPicklistItem = null;

            AccountingPickListDialogVisible = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading picklist: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading list: {ex.Message}");
        }
    }

