    private void OnPicklistSelect()
    {
        if (SelectedPicklistItem == null) return;

        var value = SelectedPicklistItem.Id;
        SetFieldValue(CurrentPicklistFieldIndex, value);
        AccountingPickListDialogVisible = false;
        StateHasChanged();
    }

    private void SetFieldValue(int index, string value)
    {
        switch (index)
        {
            case 1: IncomePrefix = value; break;
            case 2: BalanceSheetPrefix = value; break;
            case 5: LabourTaxGroup = value; break;
            case 6: MaterialTaxGroup = value; break;
            case 7: SubContractTaxGroup = value; break;
            case 8: EquipmentTaxGroup = value; break;
            case 9: OverheadTaxGroup = value; break;
            case 10: OtherTaxGroup = value; break;
            case 11: IntacctEntity = value; break;
            case 12: IntacctLocation = value; break;
            case 13: IntacctParentJob = value; break;
            case 14: IntacctDepartment = value; break;
            case 15: MortgageCredit = value; break;
            case 16: BankAccount = value; break;
        }
    }

