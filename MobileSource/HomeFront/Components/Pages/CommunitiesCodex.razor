    private async Task LoadCommunityDivisions()
    {
        var sql = @"
            SELECT l.area, d.divisioncode
            FROM tbllocality l
            LEFT OUTER JOIN divisioncommunities dc ON l.area = dc.community
            LEFT OUTER JOIN divisions d ON d.divisionid = dc.divisionid
            ORDER BY 1, 2";
        var results = await db.QueryAsync(sql);
        var divisionsByArea = results
            .GroupBy(r => r["area"]?.ToString() ?? "")
            .ToDictionary(
                g => g.Key,
                g => string.Join(", ", g.Where(r => r["divisioncode"] != null)
                    .Select(r => r["divisioncode"].ToString()))
            );
        foreach (var community in CommunitiesData)
        {
            if (divisionsByArea.TryGetValue(community.Area, out var divisions))
            {
                community.Divisions = divisions;
            }
        }
    }

    private async Task LoadDivisions()
    {
        var sql = "SELECT DivisionCode, DivisionName FROM Divisions ORDER BY DivisionCode";
        var results = await db.QueryAsync(sql);
        AvailableDivisions = results.Select(r => new DivisionItem
        {
            DivisionCode = r["DivisionCode"]?.ToString() ?? "",
            DivisionName = r["DivisionName"]?.ToString() ?? ""
        }).ToList();
    }

    private async Task<bool> SaveData(bool prompt)
    {
        if (!mDirty)
            return true;
        if (prompt)
        {
            var result = await ShowConfirmDialog("This data has changed.\n\nDo you want to save the changes?", true);
            if (result == null) return false;
            if (result == false) return true;
        }
        IsLoading = true;
        StateHasChanged();
        try
        {
            var deletedRows = CommunitiesData.Where(r => r.IsDeleted).ToList();
            foreach (var row in deletedRows)
            {
                if (!string.IsNullOrEmpty(row.OriginalArea))
                {
                    var deleteSql = $"EXEC sp_DeleteCommunity @Area";
                    await db.ExecuteAsync(deleteSql, new { Area = row.OriginalArea });
                }
                CommunitiesData.Remove(row);
            }

            var dirtyRows = CommunitiesData.Where(r => r.IsDirty && !r.IsDeleted).ToList();
            foreach (var row in dirtyRows)
            {
                if (string.IsNullOrWhiteSpace(row.Area))
                {
                    await JSRuntime.InvokeVoidAsync("alert", "The community field cannot be blank");
                    return false;
                }

                if (string.IsNullOrEmpty(row.OriginalArea))
                {
                    var insertSql = "INSERT INTO tblLocality(Area) VALUES(@Area)";
                    await db.ExecuteAsync(insertSql, new { row.Area });
                    var insertDivSql = @"
                        INSERT INTO DivisionCommunities(DivisionID, Community) 
                        SELECT @DivisionID, area 
                        FROM tbllocality a 
                        LEFT OUTER JOIN DivisionCommunities dc ON dc.Community = a.Area AND dc.DivisionID = @DivisionID  
                        WHERE a.area = @Area AND dc.community IS NULL";
                    await db.ExecuteAsync(insertDivSql, new { DivisionID, row.Area });
                    row.OriginalArea = row.Area;
                }

                var updateSql = @"
                    UPDATE tblLocality SET
                        Description = @Description,
                        Comments = @Comments,
                        CompanyName = @Company,
                        Address1 = @Address1,
                        Address2 = @Address2,
                        Email = @Email,
                        City = @City,
                        Province = @Province,
                        Zip = @Postal,
                        Country = @Country,
                        County = @County,
                        Phone = @Phone,
                        Fax = @Fax,
                        GSTNumber = @TaxNumber,
                        Prefix1 = @BalanceSheet,
                        Prefix2 = @IncomePrefix,
                        Mortgage_Credit = @Mortgage_Credit,
                        BankAccount = @BankAccount,
                        TarionBuilderNumber = @TarionBuilderNumber,
                        Lot_Inv_Debit = @LotInventoryDebit,
                        Lot_Inv_Credit = @LotInventoryCredit,
                        Project_Manager = @Project_Manager,
                        CustServiceID = @CustServiceID,
                        DC_Sales_Person = @DC_Sales_Person,
                        Contract_Document = @Contract_Document,
                        WarrantyJob = @WarrantyJob,
                        Purchaser = @Purchaser,
                        WrapInsuranceExempt = @WrapInsuranceExempt,
                        Inactive = @Inactive,
                        LabourTaxGroup = @LabourTaxGroup,
                        MaterialTaxGroup = @MaterialTaxGroup,
                        SubContractTaxGroup = @SubContractTaxGroup,
                        EquipmentTaxGroup = @EquipmentTaxGroup,
                        OverheadTaxGroup = @OverheadTaxGroup,
                        OtherTaxGroup = @OtherTaxGroup,
                        GSTRate = @GSTRate,
                        PSTRate = @PSTRate,
                        Abr = @Abr,
                        SalesManagerEmail = @SalesManagerEmail,
                        IntacctEntity = @IntacctEntity,
                        IntacctParentJob = @IntacctParentJob,
                        IntacctDepartment = @IntacctDepartment
                    WHERE Area = @Area";
                await db.ExecuteAsync(updateSql, new
                {
                    row.Description,
                    row.Comments,
                    row.Company,
                    row.Address1,
                    row.Address2,
                    row.Email,
                    row.City,
                    row.Province,
                    row.Postal,
                    row.Country,
                    row.County,
                    row.Phone,
                    row.Fax,
                    row.TaxNumber,
                    row.BalanceSheet,
                    row.IncomePrefix,
                    row.Mortgage_Credit,
                    row.BankAccount,
                    row.TarionBuilderNumber,
                    row.LotInventoryDebit,
                    row.LotInventoryCredit,
                    row.Project_Manager,
                    row.CustServiceID,
                    row.DC_Sales_Person,
                    row.Contract_Document,
                    row.WarrantyJob,
                    row.Purchaser,
                    WrapInsuranceExempt = row.WrapInsuranceExempt ? 1 : 0,
                    Inactive = row.Inactive ? 1 : 0,
                    row.LabourTaxGroup,
                    row.MaterialTaxGroup,
                    row.SubContractTaxGroup,
                    row.EquipmentTaxGroup,
                    row.OverheadTaxGroup,
                    row.OtherTaxGroup,
                    row.GSTRate,
                    row.PSTRate,
                    row.Abr,
                    row.SalesManagerEmail,
                    row.IntacctEntity,
                    row.IntacctParentJob,
                    row.IntacctDepartment,
                    row.Area
                });

                var deleteDivSql = "DELETE DivisionCommunities WHERE Community = @Area";
                await db.ExecuteAsync(deleteDivSql, new { row.Area });
                if (!string.IsNullOrEmpty(row.Divisions))
                {
                    var divisionCodes = row.Divisions.Split(',').Select(d => d.Trim()).Where(d => !string.IsNullOrEmpty(d));
                    foreach (var divCode in divisionCodes)
                    {
                        var insertDivComSql = @"
                            INSERT INTO DivisionCommunities(DivisionID, Community, BuildProEnabled)
                            SELECT d.DivisionID, @Area, @BuildPro
                            FROM Divisions d WHERE d.DivisionCode = @DivisionCode";
                        await db.ExecuteAsync(insertDivComSql, new { row.Area, BuildPro = row.BuildPro ? 1 : 0, DivisionCode = divCode });
                    }
                }
                row.IsDirty = false;
            }
            mDirty = false;
            StateHasChanged();
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[{SRCFILE}SaveData] Error: {ex.Message}");
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
            {
                await JSRuntime.InvokeVoidAsync("alert", "This ID is taken. Please choose something else.");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error saving data: {ex.Message}");
            }
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnSaveClick()
