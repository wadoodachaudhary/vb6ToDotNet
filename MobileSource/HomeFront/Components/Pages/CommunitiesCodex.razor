    private CommunityAccountingData GetCurrentData()
    {
        var data = new CommunityAccountingData
        {
            WarrantyJob = WarrantyJob,
            LotInventoryDebit = LotInventoryDebit,
            LotInventoryCredit = LotInventoryCredit,
            LabourTaxGroup = LabourTaxGroup,
            MaterialTaxGroup = MaterialTaxGroup,
            SubContractTaxGroup = SubContractTaxGroup,
            EquipmentTaxGroup = EquipmentTaxGroup,
            OverheadTaxGroup = OverheadTaxGroup,
            OtherTaxGroup = OtherTaxGroup,
            MortgageCredit = MortgageCredit,
            BankAccount = BankAccount,
            TarionBuilderNumber = TarionBuilderNumber
        };

        if (IsIntacctSystem)
        {
            data.IntacctEntity = IntacctEntity;
            data.IntacctLocation = IntacctLocation;
            data.IncomePrefix = IntacctLocation;
            data.BalanceSheet = IntacctLocation;
            data.IntacctParentJob = IntacctParentJob;
            data.IntacctDepartment = IntacctDepartment;
        }
        else
        {
            data.IncomePrefix = IncomePrefix;
            data.BalanceSheet = BalanceSheetPrefix;
        }

        return data;
    }

