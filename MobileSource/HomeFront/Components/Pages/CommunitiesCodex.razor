    private decimal ToDecimal(object? value)
    {
        if (value == null || value == DBNull.Value) return 0;
        return Convert.ToDecimal(value);
    }

    private bool ToBool(object? value)
    {
        if (value == null || value == DBNull.Value) return false;
        if (value is bool b) return b;
        if (value is int i) return i != 0;
        if (value is string s) return s.Equals("True", StringComparison.OrdinalIgnoreCase) || s == "1";
        return Convert.ToBoolean(value);
    }

    private async Task<bool> ValidateTaxGroups()
    {
        var taxGroups = new[]
        {
            (LabourTaxGroup, "Labour"),
            (MaterialTaxGroup, "Material"),
            (SubContractTaxGroup, "Sub Contract"),
            (EquipmentTaxGroup, "Equipment"),
            (OverheadTaxGroup, "Overhead"),
            (OtherTaxGroup, "Other")
        };

        foreach (var (value, name) in taxGroups)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                var isValid = await ValidateTaxGroup(value);
                if (!isValid)
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"Invalid Tax Group for {name}: {value}");
                    return false;
                }
            }
        }
        return true;
    }

    private async Task<bool> ValidateTaxGroup(string taxGroup)
    {
        var sql = "SELECT TaxGroup FROM TaxGroups WHERE DivisionID = @DivisionID AND TaxGroup = @TaxGroup";
        var result = await db.QueryAsync(sql, new { DivisionID, TaxGroup = taxGroup });
        return result.Any();
    }

