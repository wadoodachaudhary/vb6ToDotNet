@page "/communities-codex"
@rendermode InteractiveServer
@using HomeFront.Data
@using HomeFront.Components.Hf
@using Microsoft.JSInterop
@using System.Data

<PageTitle>Communities</PageTitle>

<div class="tabs-container">
    <div class="tab-buttons">
        <button class="@(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">.NET</button>
        <button class="@(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">VB6</button>
    </div>

    <div class="tab-content">
        @if (activeTab == 1)
        {
            <div class="panel">
                <div class="toolbar-cntr">
                    <button class="e-btn" @onclick="OnNewClick">
                        <img src="images/32/new.ico" class="tbar-icon" alt="New" />
                        <span class="tool-label">New</span>
                    </button>
                    <button class="e-btn" disabled="@(!mDirty)" @onclick="OnSaveClick">
                        <img src="images/32/save.ico" class="tbar-icon" alt="Save" />
                        <span class="tool-label">Save</span>
                    </button>
                    <button class="e-btn" disabled="@(SelectedCommunity == null)" @onclick="OnDeleteClick">
                        <img src="images/32/delete.ico" class="tbar-icon" alt="Delete" />
                        <span class="tool-label">Delete</span>
                    </button>
                </div>

                <div class="content-wrapper">
                    @if (IsLoading)
                    {
                        <div class="loading-overlay">
                            <div class="loading-card">Loading...</div>
                        </div>
                    }
                    <HfGrid @ref="CommunitiesGrid"
                            TValue="CommunityRow"
                            DataSource="@CommunitiesData"
                            AllowSelection="true"
                            AllowSorting="true"
                            AllowFiltering="true"
                            AllowResizing="true"
                            EnableHover="true"
                            Height="600px"
                            RowHeight="32"
                            ShowSearchBar="true"
                            FilterSettingsRef="@filterSettings"
                            SelectionSettingsRef="@selectionSettings"
                            EventsRef="@communitiesEvents">
                        <HfGridColumnsBase>
                            <HfGridColumn Field="@nameof(CommunityRow.OriginalArea)" HeaderText="OriginalArea" Visible="false" AllowEditing="false" IsPrimaryKey="true" />

                            <HfGridColumn Field="@nameof(CommunityRow.Area)" HeaderText="@CommunityTerm" Width="120px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <HfTextBox CssClass="grid-input" @bind-Value="row.Area" @bind-Value:after="() => MarkDirty(row)" Enabled="@(string.IsNullOrEmpty(row.OriginalArea))" />
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.Description)" HeaderText="Description" Width="200px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <HfTextBox CssClass="grid-input" @bind-Value="row.Description" @bind-Value:after="() => MarkDirty(row)" />
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.Comments)" HeaderText="Comments" Width="160px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <div class="inline-edit">
                                        <span>@TruncateText(row.Comments, 30)</span>
                                        <button class="mini-btn" @onclick="() => EditComments(row)">...</button>
                                    </div>
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.Company)" HeaderText="Company" Width="150px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <div class="inline-edit">
                                        <span>@row.Company</span>
                                        <button class="mini-btn" @onclick="() => EditCompany(row)">...</button>
                                    </div>
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.LotInventoryDebit)" HeaderText="Accounting" Width="140px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <div class="inline-edit">
                                        <span>@row.LotInventoryDebit</span>
                                        <button class="mini-btn" @onclick="() => EditAccounting(row)">...</button>
                                    </div>
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.Divisions)" HeaderText="Divisions" Width="140px" AllowEditing="false">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <div class="inline-edit">
                                        <span>@row.Divisions</span>
                                        <button class="mini-btn" @onclick="() => EditDivisions(row)">...</button>
                                    </div>
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.Project_Manager)" HeaderText="Project Manager" Width="160px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <div class="inline-edit">
                                        <span>@row.Project_Manager</span>
                                        <button class="mini-btn" @onclick="() => SelectProjectManager(row)">...</button>
                                    </div>
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.CustServiceID)" HeaderText="Service Rep" Width="140px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <div class="inline-edit">
                                        <span>@row.CustServiceID</span>
                                        <button class="mini-btn" @onclick="() => SelectCustService(row)">...</button>
                                    </div>
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.WarrantyJob)" HeaderText="Warranty Job" Width="140px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <div class="inline-edit">
                                        <span>@row.WarrantyJob</span>
                                        <button class="mini-btn" @onclick="() => SelectWarrantyJob(row)">...</button>
                                    </div>
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.DC_Sales_Person)" HeaderText="DC Sales Person" Width="160px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <div class="inline-edit">
                                        <span>@row.DC_Sales_Person</span>
                                        <button class="mini-btn" @onclick="() => SelectDCSalesPerson(row)">...</button>
                                    </div>
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.Inactive)" HeaderText="Inactive" Width="90px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <input type="checkbox" @bind="row.Inactive" @bind:after="() => MarkDirty(row)" />
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.BuildPro)" HeaderText="BuildPro" Width="90px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <input type="checkbox" @bind="row.BuildPro" @bind:after="() => MarkDirty(row)" />
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.WrapInsuranceExempt)" HeaderText="Wrap Ins Exempt" Width="140px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <input type="checkbox" @bind="row.WrapInsuranceExempt" @bind:after="() => MarkDirty(row)" />
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.GSTRate)" HeaderText="GST Rate" Width="100px" Visible="@ShowGSTRate">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <input class="grid-input" type="number" step="0.01" @bind="row.GSTRate" @bind:after="() => MarkDirty(row)" />
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.Contract_Document)" HeaderText="Contract Doc" Width="160px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <div class="inline-edit">
                                        <span>@TruncateTextRight(row.Contract_Document, 20)</span>
                                        <button class="mini-btn" @onclick="() => BrowseContractDocument(row)">...</button>
                                    </div>
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.Abr)" HeaderText="Abr" Width="80px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <HfTextBox CssClass="grid-input" @bind-Value="row.Abr" @bind-Value:after="() => MarkDirty(row)" />
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.Purchaser)" HeaderText="Purchaser" Width="140px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <div class="inline-edit">
                                        <span>@row.Purchaser</span>
                                        <button class="mini-btn" @onclick="() => SelectPurchaser(row)">...</button>
                                    </div>
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.SalesManagerEmail)" HeaderText="Sales Mgr Email" Width="200px">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <HfTextBox CssClass="grid-input" @bind-Value="row.SalesManagerEmail" @bind-Value:after="() => MarkDirty(row)" />
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.Email)" HeaderText="Email" Visible="false" Width="180px" />
                            <HfGridColumn Field="@nameof(CommunityRow.Address1)" HeaderText="Address 1" Visible="false" Width="150px" />
                            <HfGridColumn Field="@nameof(CommunityRow.Address2)" HeaderText="Address 2" Visible="false" Width="150px" />
                            <HfGridColumn Field="@nameof(CommunityRow.City)" HeaderText="City" Visible="false" Width="120px" />
                            <HfGridColumn Field="@nameof(CommunityRow.Province)" HeaderText="Province" Visible="false" Width="100px" />
                            <HfGridColumn Field="@nameof(CommunityRow.Postal)" HeaderText="Postal" Visible="false" Width="100px" />
                            <HfGridColumn Field="@nameof(CommunityRow.Country)" HeaderText="Country" Visible="false" Width="100px" />
                            <HfGridColumn Field="@nameof(CommunityRow.County)" HeaderText="County" Visible="false" Width="100px" />
                            <HfGridColumn Field="@nameof(CommunityRow.Phone)" HeaderText="Phone" Visible="false" Width="120px" />
                            <HfGridColumn Field="@nameof(CommunityRow.Fax)" HeaderText="Fax" Visible="false" Width="120px" />
                            <HfGridColumn Field="@nameof(CommunityRow.TaxNumber)" HeaderText="Tax Number" Visible="false" Width="120px" />
                            <HfGridColumn Field="@nameof(CommunityRow.IncomePrefix)" HeaderText="Income Prefix" Visible="false" Width="100px" />
                            <HfGridColumn Field="@nameof(CommunityRow.BalanceSheet)" HeaderText="Balance Sheet" Visible="false" Width="120px" />
                            <HfGridColumn Field="@nameof(CommunityRow.Mortgage_Credit)" HeaderText="Mortgage Credit" Visible="false" Width="140px" />
                            <HfGridColumn Field="@nameof(CommunityRow.BankAccount)" HeaderText="Bank Account" Visible="false" Width="120px" />
                            <HfGridColumn Field="@nameof(CommunityRow.TarionBuilderNumber)" HeaderText="Tarion Builder #" Visible="false" Width="140px" />
                            <HfGridColumn Field="@nameof(CommunityRow.LotInventoryCredit)" HeaderText="Lot Inv Credit" Visible="false" Width="140px" />
                            <HfGridColumn Field="@nameof(CommunityRow.LabourTaxGroup)" HeaderText="Labour Tax Grp" Visible="false" Width="140px" />
                            <HfGridColumn Field="@nameof(CommunityRow.MaterialTaxGroup)" HeaderText="Material Tax Grp" Visible="false" Width="140px" />
                            <HfGridColumn Field="@nameof(CommunityRow.SubContractTaxGroup)" HeaderText="SubContract Tax Grp" Visible="false" Width="160px" />
                            <HfGridColumn Field="@nameof(CommunityRow.EquipmentTaxGroup)" HeaderText="Equipment Tax Grp" Visible="false" Width="160px" />
                            <HfGridColumn Field="@nameof(CommunityRow.OverheadTaxGroup)" HeaderText="Overhead Tax Grp" Visible="false" Width="150px" />
                            <HfGridColumn Field="@nameof(CommunityRow.OtherTaxGroup)" HeaderText="Other Tax Grp" Visible="false" Width="140px" />

                            <HfGridColumn Field="@nameof(CommunityRow.PSTRate)" HeaderText="PST Rate" Width="100px" Visible="@ShowPSTRate">
                                <Template>
                                    @{ var row = (CommunityRow)context; }
                                    <input class="grid-input" type="number" step="0.01" @bind="row.PSTRate" @bind:after="() => MarkDirty(row)" />
                                </Template>
                            </HfGridColumn>

                            <HfGridColumn Field="@nameof(CommunityRow.IntacctEntity)" HeaderText="Intacct Entity" Visible="false" Width="140px" />
                            <HfGridColumn Field="@nameof(CommunityRow.IntacctParentJob)" HeaderText="Intacct Parent Job" Visible="false" Width="160px" />
                            <HfGridColumn Field="@nameof(CommunityRow.IntacctDepartment)" HeaderText="Intacct Dept" Visible="false" Width="140px" />
                        </HfGridColumnsBase>
                    </HfGrid>
                </div>
            </div>
        }
        else if (activeTab == 2)
        {
            <div class="panel">
                <img src="images/VB6/Screen_IndexCommunities.png" class="task-icon-vb6" />
            </div>
        }
    </div>
</div>

<HfDialog Visible="@CommentsDialogVisible"
          Header="Edit Comments"
          Width="500px"
          Height="400px"
          IsModal="true"
          ShowCloseIcon="true"
          OnClose="CloseCommentsDialog">
    <ChildContent>
        <HfTextBox @bind-Value="EditingComments"
                   Multiline="true"
                   CssClass="comments-textarea"
                   Placeholder="Enter comments..."
                   Rows="10" />
    </ChildContent>
    <FooterContent>
        <HfButton CssClass="hf-dialog-btn" OnClick="SaveComments">OK</HfButton>
        <HfButton CssClass="hf-dialog-btn" OnClick="CloseCommentsDialog">Cancel</HfButton>
    </FooterContent>
</HfDialog>

<HfDialog Visible="@DivisionsDialogVisible"
          Header="Select Divisions"
          Width="400px"
          Height="500px"
          IsModal="true"
          ShowCloseIcon="true"
          OnClose="CloseDivisionsDialog">
    <ChildContent>
        <HfListBox TItem="DivisionItem"
                   DataSource="@AvailableDivisions"
                   TextField="DivisionName"
                   ValueField="DivisionCode"
                   SelectionMode="HfListBoxSelectionMode.Multiple"
                   ShowCheckbox="true"
                   @bind-Value="SelectedDivisionCodes" />
    </ChildContent>
    <FooterContent>
        <HfButton CssClass="hf-dialog-btn" OnClick="SaveDivisions">OK</HfButton>
        <HfButton CssClass="hf-dialog-btn" OnClick="CloseDivisionsDialog">Cancel</HfButton>
    </FooterContent>
</HfDialog>

<HfDialog Visible="@PickerDialogVisible"
          Header="@PickerTitle"
          Width="500px"
          Height="400px"
          IsModal="true"
          ShowCloseIcon="true"
          OnClose="ClosePickerDialog">
    <ChildContent>
        <HfGrid TValue="PickerItem" DataSource="@PickerItems" AllowSelection="true" Height="250px" SelectionSettingsRef="@pickerSelectionSettings" EventsRef="@pickerEvents">
            <HfGridColumnsBase>
                <HfGridColumn Field="@nameof(PickerItem.Id)" HeaderText="ID" Width="100px" />
                <HfGridColumn Field="@nameof(PickerItem.Name)" HeaderText="Name" Width="200px" />
            </HfGridColumnsBase>
        </HfGrid>
    </ChildContent>
    <FooterContent>
        <HfButton CssClass="hf-dialog-btn" OnClick="ConfirmPicker">OK</HfButton>
        <HfButton CssClass="hf-dialog-btn" OnClick="ClosePickerDialog">Cancel</HfButton>
    </FooterContent>
</HfDialog>

<HfDialog Visible="@ConfirmDialogVisible"
          Header="Confirm"
          Width="400px"
          IsModal="true"
          ShowCloseIcon="true"
          OnClose="ConfirmCancel">
    <ChildContent>
        <p>@ConfirmMessage</p>
    </ChildContent>
    <FooterContent>
        <HfButton CssClass="hf-dialog-btn" OnClick="ConfirmYes">Yes</HfButton>
        <HfButton CssClass="hf-dialog-btn" OnClick="ConfirmNo">No</HfButton>
        @if (ShowCancelButton)
        {
            <HfButton CssClass="hf-dialog-btn" OnClick="ConfirmCancel">Cancel</HfButton>
        }
    </FooterContent>
</HfDialog>

<HfDialog Visible="@AccountingDialogVisible"
          Header="Accounting"
          Width="650px"
          IsModal="true"
          ShowCloseIcon="true"
          CssClass="accounting-dialog"
          CloseOnEscape="true"
          OnClose="OnAcctCancelClick">
    <ChildContent>
        @if (!IsIntacctSystem)
        {
            <div class="form-section">
                <div class="form-section-title">GL Accounts</div>
                <div class="field-row">
                    <label class="field-label">Income Stmt Prefix</label>
                    <div class="field-input">
                        <HfTextBox @bind-Value="IncomePrefix" />
                    </div>
                    <HfButton CssClass="mini-btn" OnClick="() => BrowsePrefix(1)">...</HfButton>
                </div>
                <div class="field-row">
                    <label class="field-label">Balance Sheet Prefix</label>
                    <div class="field-input">
                        <HfTextBox @bind-Value="BalanceSheetPrefix" />
                    </div>
                    <HfButton CssClass="mini-btn" OnClick="() => BrowsePrefix(2)">...</HfButton>
                </div>
                <div class="field-row">
                    <label class="field-label">Lot Inventory Debit</label>
                    <div class="field-input">
                        <HfTextBox @bind-Value="LotInventoryDebit" />
                    </div>
                </div>
                <div class="field-row">
                    <label class="field-label">Lot Inventory Credit</label>
                    <div class="field-input">
                        <HfTextBox @bind-Value="LotInventoryCredit" />
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="form-section">
                <div class="form-section-title">Organization</div>
                <div class="field-row">
                    <label class="field-label">Entity</label>
                    <div class="field-input">
                        <HfTextBox @bind-Value="IntacctEntity" />
                    </div>
                    <HfButton CssClass="mini-btn" OnClick="BrowseIntacctEntity">...</HfButton>
                </div>
                <div class="field-row">
                    <label class="field-label">Location</label>
                    <div class="field-input">
                        <HfTextBox @bind-Value="IntacctLocation" />
                    </div>
                    <HfButton CssClass="mini-btn" OnClick="BrowseIntacctLocation">...</HfButton>
                </div>
                <div class="field-row">
                    <label class="field-label">Parent Job</label>
                    <div class="field-input">
                        <HfTextBox @bind-Value="IntacctParentJob" />
                    </div>
                    <HfButton CssClass="mini-btn" OnClick="BrowseIntacctParentJob">...</HfButton>
                </div>
                <div class="field-row">
                    <label class="field-label">Department</label>
                    <div class="field-input">
                        <HfTextBox @bind-Value="IntacctDepartment" />
                    </div>
                    <HfButton CssClass="mini-btn" OnClick="BrowseIntacctDepartment">...</HfButton>
                </div>
            </div>
        }

        <div class="form-section">
            <div class="form-section-title">Tax Groups</div>
            <div class="tax-group-row">
                <div class="tax-group-col">
                    <div class="tax-field-row">
                        <label class="tax-field-label">Labour</label>
                        <HfTextBox CssClass="tax-field-input" @bind-Value="LabourTaxGroup" />
                        <HfButton CssClass="mini-btn" OnClick="() => BrowseTaxGroup(5)">...</HfButton>
                    </div>
                    <div class="tax-field-row">
                        <label class="tax-field-label">Material</label>
                        <HfTextBox CssClass="tax-field-input" @bind-Value="MaterialTaxGroup" />
                        <HfButton CssClass="mini-btn" OnClick="() => BrowseTaxGroup(6)">...</HfButton>
                    </div>
                    <div class="tax-field-row">
                        <label class="tax-field-label">Sub Contracts</label>
                        <HfTextBox CssClass="tax-field-input" @bind-Value="SubContractTaxGroup" />
                        <HfButton CssClass="mini-btn" OnClick="() => BrowseTaxGroup(7)">...</HfButton>
                    </div>
                </div>
                <div class="tax-group-col">
                    <div class="tax-field-row">
                        <label class="tax-field-label">Equipment</label>
                        <HfTextBox CssClass="tax-field-input" @bind-Value="EquipmentTaxGroup" />
                        <HfButton CssClass="mini-btn" OnClick="() => BrowseTaxGroup(8)">...</HfButton>
                    </div>
                    <div class="tax-field-row">
                        <label class="tax-field-label">Overhead</label>
                        <HfTextBox CssClass="tax-field-input" @bind-Value="OverheadTaxGroup" />
                        <HfButton CssClass="mini-btn" OnClick="() => BrowseTaxGroup(9)">...</HfButton>
                    </div>
                    <div class="tax-field-row">
                        <label class="tax-field-label">Other</label>
                        <HfTextBox CssClass="tax-field-input" @bind-Value="OtherTaxGroup" />
                        <HfButton CssClass="mini-btn" OnClick="() => BrowseTaxGroup(10)">...</HfButton>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="field-row">
                <label class="field-label">Loan Draw Liability Acct</label>
                <div class="field-input">
                    <HfTextBox @bind-Value="MortgageCredit" />
                </div>
                <HfButton CssClass="mini-btn" OnClick="BrowseGLAccount">...</HfButton>
            </div>

            <div class="field-row">
                <label class="field-label">Bank Account</label>
                <div class="field-input">
                    <HfTextBox @bind-Value="BankAccount" />
                </div>
                <HfButton CssClass="mini-btn" OnClick="BrowseBankAccount">...</HfButton>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Warranty</div>
            <div class="field-row">
                <label class="field-label">Warranty Job</label>
                <div class="field-input">
                    <HfTextBox @bind-Value="WarrantyJob" />
                </div>
            </div>

            @if (ShowTarionFields)
            {
                <div class="field-row">
                    <label class="field-label">Tarion Builder No</label>
                    <div class="field-input">
                        <HfTextBox @bind-Value="TarionBuilderNumber" />
                    </div>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <HfButton CssClass="hf-dialog-btn" OnClick="OnAcctOkClick">OK</HfButton>
        <HfButton CssClass="hf-dialog-btn" OnClick="OnAcctCancelClick">Cancel</HfButton>
    </FooterContent>
</HfDialog>

<HfDialog Visible="@AccountingPickListDialogVisible"
          Header="@PicklistTitle"
          Width="500px"
          IsModal="true"
          ShowCloseIcon="true"
          OnClose="() => AccountingPickListDialogVisible = false">
    <ChildContent>
        <HfGrid TValue="PickerItem" DataSource="@PickerItems" AllowSelection="true" Height="300px" SelectionSettingsRef="@pickerSelectionSettings" EventsRef="@picklistEvents">
            <HfGridColumnsBase>
                <HfGridColumn Field="@nameof(PickerItem.Id)" HeaderText="ID" Width="100px" />
                <HfGridColumn Field="@nameof(PickerItem.Name)" HeaderText="Name" Width="200px" />
            </HfGridColumnsBase>
        </HfGrid>
    </ChildContent>
    <FooterContent>
        <HfButton CssClass="hf-dialog-btn" OnClick="OnPicklistSelect">Select</HfButton>
        <HfButton CssClass="hf-dialog-btn" OnClick="() => AccountingPickListDialogVisible = false">Cancel</HfButton>
    </FooterContent>
</HfDialog>

<style>
    .tabs-container {
        margin: 20px auto;
        font-family: Arial, Helvetica, sans-serif;
    }

    .tab-buttons {
        display: flex;
        border-bottom: 2px solid #ddd;
    }

    .tab-buttons button {
        padding: 12px 24px;
        border: none;
        background: #f0f0f0;
        cursor: pointer;
        font-size: 16px;
        transition: background 0.2s;
    }

    .tab-buttons button:hover {
        background: #e0e0e0;
    }

    .tab-buttons button.active {
        background: #fff;
        border-bottom: 2px solid #007bff;
        margin-bottom: -2px;
        color: #007bff;
        font-weight: bold;
    }

    .tab-content {
        padding: 20px;
        border: 1px solid #ddd;
        border-top: none;
        background: #fff;
    }

    .panel {
        text-align: center;
    }

    .panel img {
        max-width: 100%;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .toolbar-cntr {
        padding-top: 12px;
        padding-bottom: 12px;
        border-top: 1px solid #c9c9c9;
        border-bottom: 1px solid #c9c9c9;
        margin-bottom: 10px;
        display: flex;
        gap: 6px;
        justify-content: flex-start;
        flex-wrap: wrap;
    }

    .tool-label {
        width: 100%;
        display: block;
    }

    .e-btn {
        margin-right: 5px;
        padding: 6px 10px;
        border: 1px solid #ccc;
        background: #f7f7f7;
        border-radius: 4px;
        cursor: pointer;
    }

    .tbar-icon {
