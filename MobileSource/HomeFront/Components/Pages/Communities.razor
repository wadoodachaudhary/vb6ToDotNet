@*
@page "/Communities"

@namespace BlazorDemos.Pages

@using System.Data
@using System.Dynamic
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using HomeFront.Data
@using HomeFront.Components.Grid
@using Microsoft.JSInterop

<style>
    .accounting-dialog .e-dlg-content {
        padding: 20px;
    }
    .form-section {
        margin-bottom: 20px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
    }
    .form-section-title {
        font-weight: bold;
        color: #0066cc;
        margin-bottom: 15px;
        padding-bottom: 8px;
        border-bottom: 1px solid #dee2e6;
    }
    .field-row {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }
    .field-label {
        width: 160px;
        text-align: right;
        padding-right: 10px;
        font-weight: 500;
    }
    .field-input {
        flex: 1;
        max-width: 300px;
    }
    .field-browse {
        margin-left: 5px;
    }
    .tax-group-row {
        display: flex;
        gap: 20px;
    }
    .tax-group-col {
        flex: 1;
    }
    .tax-field-row {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
    }
    .tax-field-label {
        width: 100px;
        text-align: right;
        padding-right: 10px;
    }
    .tax-field-input {
        width: 100px;
    }
    .tabs-container {
        margin: 20px auto;
        font-family: sans-serif;
    }


    .task-icon-vb6 {
        width: 2000px;
        height: auto;
        display: block;

    }

    .tab-buttons {
        display: flex;
        border-bottom: 2px solid #ddd;
    }

    .tab-buttons button {
        padding: 12px 24px;
        border: none;
        background: #f0f0f0;
        cursor: pointer;
        font-size: 16px;
        transition: background 0.2s;
    }

    .tab-buttons button:hover {
        background: #e0e0e0;
    }

    .tab-buttons button.active {
        background: #fff;
        border-bottom: 2px solid #007bff;
        margin-bottom: -2px;
        color: #007bff;
        font-weight: bold;
    }

    .tab-content {
        padding: 20px;
        border: 1px solid #ddd;
        border-top: none;
        background: #fff;
    }

    .panel {
        text-align: center;
    }

    .panel img {
        max-width: 100%;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .toolbar-cntr {
        padding-top: 12px;
        padding-bottom: 12px;
        border-top: 1px solid #c9c9c9;
        border-bottom: 1px solid #c9c9c9;
        margin-bottom: 10px;
    }

    .tool-label {
        width: 100%;
        display: block;
    }

    .e-btn {
        margin-right: 5px;
    }

    .tbar-icon {
        width: 24px;
        height: 24px;
        margin-bottom: 4px;
    }

    /* Grid styling */
    .e-grid .e-rowcell.e-selectionbackground.e-cellselectionbackground,
    .e-grid .e-rowcell.e-cellselectionbackground {
        background-color: #1976d2 !important;
        color: white !important;
        font-weight: bold !important;
    }

    .e-grid .e-row.e-selected .e-rowcell,
    .e-grid .e-rowcell.e-selectionbackground {
        background-color: #e3f2fd !important;
    }

    .e-grid .e-gridheader, .e-grid .e-headercell {
        border-color: black;
        border-style: solid;
        border-width: 2px;
    }

    /* Filter row styling */
    .filter-row {
        background-color: #FFFFCC !important;
    }

    .filter-row input {
        background-color: #FFFFCC !important;
        border: 1px solid #999;
    }

    /* Inactive row styling */
    .inactive-row {
        background-color: #f5f5f5 !important;
        color: #999 !important;
    }

    .deleted-row {
        display: none !important;
    }

    .dirty-row {
        background-color: #fff3e0 !important;
    }

    /* Dialog styling */
    .dialog-content {
        padding: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
    }
    
    body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 16px; /* or use rem, e.g., 1rem */
    }

    /* Example for Syncfusion controls */
    .e-control, [class^="e-"] *:not([class*="e-icon"]) {
        font-size: 1.8rem !important;
        font-family: Arial, Helvetica, sans-serif;
    }

    /* Phase tree node selected */
    .e-columnheader, .e-headercell, .e-grid th.e-headercell, .e-grid .e-headertext {
        background-color:#d5dadc; /* Normal state */
        color: #333; /* Text color */
        font-size: 16px;
    }

</style>

<div class="tabs-container">
    <div class="tab-buttons">
        <button class="@(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">
            .NET
        </button>
        <button class="@(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">
            VB6
        </button>
    </div>

    <div class="tab-content">
        @if (activeTab == 1){
            <div class="toolbar-cntr">

    <SfToolbar>
        <ToolbarItems>

            <!-- Save -->
            <ToolbarItem>
                <ToolbarItemTemplate>
                    <button class="e-btn e-tbar-btn" @onclick="OnNewClick">
                        <img src="images/32/new.ico" class="tbar-icon" />
                        <span class="tool-label">New</span>
                    </button>
                </ToolbarItemTemplate>
            </ToolbarItem>

            <!-- Save -->
            <ToolbarItem>
                <ToolbarItemTemplate>
                    <button class="e-btn e-tbar-btn" disabled="@(!mDirty)">
                        <img src="images/32/save.ico" class="tbar-icon" />
                        <span class="tool-label">Save</span>
                    </button>
                </ToolbarItemTemplate>
            </ToolbarItem>

            <!-- View -->
            <ToolbarItem>
                <ToolbarItemTemplate>
                    <button class="e-btn e-tbar-btn" disabled="@(SelectedCommunity == null)"
                            @onclick="OnDeleteClick">
                            <img src="images/32/delete.ico" class="tbar-icon" />
                        <span class="tool-label">Delete</span>
                    </button>
                </ToolbarItemTemplate>
            </ToolbarItem>            

        </ToolbarItems>
    </SfToolbar>

</div>

<div class="col-lg-12 control-section">
    <div class="content-wrapper">
        <HfGrid @ref="CommunitiesGrid"
                TValue="CommunityRow"
                DataSource="@CommunitiesData"
                AllowSelection="true"
                AllowSorting="true"
                AllowFiltering="true"
                AllowResizing="true"
                EnableHover="true"
                Height="600"
                FilterSettingsRef="@communityFilterSettings"
                SelectionSettingsRef="@communitySelectionSettings"
                EditSettingsRef="@communityEditSettings"
                EventsRef="@communityEvents">

            <HfGridColumnsBase>
                <!-- Hidden Primary Key -->
                <HfGridColumn Field="@nameof(CommunityRow.OriginalArea)"
                            HeaderText="OriginalArea"
                            IsPrimaryKey="true"
                            Visible="false"
                            AllowEditing="false" />
                <!-- Main data columns -->
                <HfGridColumn Field="@nameof(CommunityRow.Area)"
                            HeaderText="@CommunityTerm"
                            Width="100px">
                    <EditTemplate>
                        @{ var areaRow = (CommunityRow)context;
                            <input type="text" @bind="areaRow.Area"
                                   disabled="@(!string.IsNullOrEmpty(areaRow.OriginalArea))"
                                   placeholder="Enter @CommunityTerm"
                                   style="width:100%; padding:4px;" />
                        }
                    </EditTemplate>
                </HfGridColumn>

                <HfGridColumn Field="@nameof(CommunityRow.Description)"
                            HeaderText="Description"
                            Width="200px" />
                <HfGridColumn Field="@nameof(CommunityRow.Comments)"
                            HeaderText="Comments"
                            Width="150px">
                    <Template>
                        @{ var commentsRow = (CommunityRow)context;
                            <span>@(commentsRow.Comments?.Length > 30 ? commentsRow.Comments.Substring(0, 30) + "..." : commentsRow.Comments)</span>
                            <button class="e-btn e-small" @onclick="() => EditComments(commentsRow)">...</button>
                        }
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(CommunityRow.Company)"
                            HeaderText="Company"
                            Width="150px">
                    <Template>
                        @{ var companyRow = (CommunityRow)context;
                            <span>@companyRow.Company</span>
                            <button class="e-btn e-small" @onclick="() => EditCompany(companyRow)">...</button>
                        }
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(CommunityRow.LotInventoryDebit)"
                            HeaderText="Accounting"
                            Width="120px">
                    <Template>
                        @{ var acctRow = (CommunityRow)context;
                            <span>@acctRow.LotInventoryDebit</span>
                            <button class="e-btn e-small" @onclick="() => EditAccounting(acctRow)">...</button>
                        }
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(CommunityRow.Divisions)"
                            HeaderText="Divisions"
                            Width="120px"
                            AllowEditing="false">
                    <Template>
                        @{ var divRow = (CommunityRow)context;
                            <span>@divRow.Divisions</span>
                            <button class="e-btn e-small" @onclick="() => EditDivisions(divRow)">...</button>
                        }
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(CommunityRow.Project_Manager)"
                            HeaderText="Project Manager"
                            Width="130px">
                    <Template>
                        @{ var pmRow = (CommunityRow)context;
                            <span>@pmRow.Project_Manager</span>
                            <button class="e-btn e-small" @onclick="() => SelectProjectManager(pmRow)">...</button>
                        }
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(CommunityRow.CustServiceID)"
                            HeaderText="Service Rep"
                            Width="120px">
                    <Template>
                        @{ var csRow = (CommunityRow)context;
                            <span>@csRow.CustServiceID</span>
                            <button class="e-btn e-small" @onclick="() => SelectCustService(csRow)">...</button>
                        }
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(CommunityRow.WarrantyJob)"
                            HeaderText="Warranty Job"
                            Width="120px">
                    <Template>
                        @{ var warRow = (CommunityRow)context;
                            <span>@warRow.WarrantyJob</span>
                            <button class="e-btn e-small" @onclick="() => SelectWarrantyJob(warRow)">...</button>
                        }
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(CommunityRow.DC_Sales_Person)"
                            HeaderText="DC Sales Person"
                            Width="130px">
                    <Template>
                        @{ var dcRow = (CommunityRow)context;
                            <span>@dcRow.DC_Sales_Person</span>
                            <button class="e-btn e-small" @onclick="() => SelectDCSalesPerson(dcRow)">...</button>
                        }
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(CommunityRow.Inactive)"
                            HeaderText="Inactive"
                            Width="80px"
                            Type="ColumnType.CheckBox" />
                <HfGridColumn Field="@nameof(CommunityRow.BuildPro)"
                            HeaderText="BuildPro"
                            Width="80px"
                            Type="ColumnType.CheckBox" />
                <HfGridColumn Field="@nameof(CommunityRow.WrapInsuranceExempt)"
                            HeaderText="Wrap Ins Exempt"
                            Width="100px"
                            Type="ColumnType.CheckBox" />
                <HfGridColumn Field="@nameof(CommunityRow.GSTRate)"
                            HeaderText="GST Rate"
                            Width="100px"
                            Format="N2"
                            Type="ColumnType.Number"
                            Visible="@ShowGSTRate" />
                <HfGridColumn Field="@nameof(CommunityRow.Contract_Document)"
                            HeaderText="Contract Doc"
                            Width="150px">
                    <Template>
                        @{ var docRow = (CommunityRow)context;
                            <span>@(docRow.Contract_Document?.Length > 20 ? "..." + docRow.Contract_Document.Substring(docRow.Contract_Document.Length - 20) : docRow.Contract_Document)</span>
                            <button class="e-btn e-small" @onclick="() => BrowseContractDocument(docRow)">...</button>
                        }
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(CommunityRow.Abr)"
                            HeaderText="Abr"
                            Width="80px" />
                <HfGridColumn Field="@nameof(CommunityRow.Purchaser)"
                            HeaderText="Purchaser"
                            Width="120px">
                    <Template>
                        @{ var purRow = (CommunityRow)context;
                            <span>@purRow.Purchaser</span>
                            <button class="e-btn e-small" @onclick="() => SelectPurchaser(purRow)">...</button>
                        }
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(CommunityRow.SalesManagerEmail)"
                            HeaderText="Sales Mgr Email"
                            Width="180px" />
                <HfGridColumn Field="@nameof(CommunityRow.Email)" HeaderText="Email" Visible="false" Width="180px" />
                <HfGridColumn Field="@nameof(CommunityRow.Address1)" HeaderText="Address 1" Visible="false" Width="150px" />
                <HfGridColumn Field="@nameof(CommunityRow.Address2)" HeaderText="Address 2" Visible="false" Width="150px" />
                <HfGridColumn Field="@nameof(CommunityRow.City)" HeaderText="City" Visible="false" Width="120px" />
                <HfGridColumn Field="@nameof(CommunityRow.Province)" HeaderText="Province" Visible="false" Width="100px" />
                <HfGridColumn Field="@nameof(CommunityRow.Postal)" HeaderText="Postal" Visible="false" Width="100px" />
                <HfGridColumn Field="@nameof(CommunityRow.Country)" HeaderText="Country" Visible="false" Width="100px" />
                <HfGridColumn Field="@nameof(CommunityRow.County)" HeaderText="County" Visible="false" Width="100px" />
                <HfGridColumn Field="@nameof(CommunityRow.Phone)" HeaderText="Phone" Visible="false" Width="120px" />
                <HfGridColumn Field="@nameof(CommunityRow.Fax)" HeaderText="Fax" Visible="false" Width="120px" />
                <HfGridColumn Field="@nameof(CommunityRow.TaxNumber)" HeaderText="Tax Number" Visible="false" Width="120px" />
                <HfGridColumn Field="@nameof(CommunityRow.IncomePrefix)" HeaderText="Income Prefix" Visible="false" Width="100px" />
                <HfGridColumn Field="@nameof(CommunityRow.BalanceSheet)" HeaderText="Balance Sheet" Visible="false" Width="100px" />
                <HfGridColumn Field="@nameof(CommunityRow.Mortgage_Credit)" HeaderText="Mortgage Credit" Visible="false" Width="120px" />
                <HfGridColumn Field="@nameof(CommunityRow.BankAccount)" HeaderText="Bank Account" Visible="false" Width="120px" />
                <HfGridColumn Field="@nameof(CommunityRow.TarionBuilderNumber)" HeaderText="Tarion Builder #" Visible="false" Width="120px" />
                <HfGridColumn Field="@nameof(CommunityRow.LotInventoryCredit)" HeaderText="Lot Inv Credit" Visible="false" Width="120px" />
                <!-- Tax Groups -->
                <HfGridColumn Field="@nameof(CommunityRow.LabourTaxGroup)" HeaderText="Labour Tax Grp" Visible="false" Width="120px" />
                <HfGridColumn Field="@nameof(CommunityRow.MaterialTaxGroup)" HeaderText="Material Tax Grp" Visible="false" Width="130px" />
                <HfGridColumn Field="@nameof(CommunityRow.SubContractTaxGroup)" HeaderText="SubContract Tax Grp" Visible="false" Width="140px" />
                <HfGridColumn Field="@nameof(CommunityRow.EquipmentTaxGroup)" HeaderText="Equipment Tax Grp" Visible="false" Width="140px" />
                <HfGridColumn Field="@nameof(CommunityRow.OverheadTaxGroup)" HeaderText="Overhead Tax Grp" Visible="false" Width="130px" />
                <HfGridColumn Field="@nameof(CommunityRow.OtherTaxGroup)" HeaderText="Other Tax Grp" Visible="false" Width="120px" />
                <HfGridColumn Field="@nameof(CommunityRow.PSTRate)" HeaderText="PST Rate" Width="100px" Format="N2" Type="ColumnType.Number" Visible="@ShowPSTRate" />
                <!-- Intacct Fields -->
                <HfGridColumn Field="@nameof(CommunityRow.IntacctEntity)" HeaderText="Intacct Entity" Visible="false" Width="120px" />
                <HfGridColumn Field="@nameof(CommunityRow.IntacctParentJob)" HeaderText="Intacct Parent Job" Visible="false" Width="140px" />
                <HfGridColumn Field="@nameof(CommunityRow.IntacctDepartment)" HeaderText="Intacct Dept" Visible="false" Width="120px" />
            </HfGridColumnsBase>
        </HfGrid>
    </div>
</div>

        }
        else if (activeTab == 2){
            <div class="panel">
                <img src="images/VB6/Screen_IndexCommunities.png" class="task-icon-vb6"/>
            </div>
        }
    </div>
</div>
<!-- Comments Dialog -->
<SfDialog @ref="CommentsDialog"
          Width="500px"
          Height="400px"
          IsModal="true"
          ShowCloseIcon="true"
          Visible="@CommentsDialogVisible"
          Header="Edit Comments">
    <DialogTemplates>
        <Content>
            <div class="dialog-content">
                <SfTextBox @bind-Value="EditingComments"
                           Multiline="true"
                           CssClass="e-outline"
                           Placeholder="Enter comments..."
                           HtmlAttributes="@(new Dictionary<string, object> { { "rows", "10" } })">
                </SfTextBox>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="OK" IsPrimary="true" OnClick="SaveComments"></DialogButton>
        <DialogButton Content="Cancel" OnClick="CloseCommentsDialog"></DialogButton>
    </DialogButtons>
</SfDialog>

<!-- Divisions Picker Dialog -->
<SfDialog @ref="DivisionsDialog"
          Width="400px"
          Height="500px"
          IsModal="true"
          ShowCloseIcon="true"
          Visible="@DivisionsDialogVisible"
          Header="Select Divisions">
    <DialogTemplates>
        <Content>
            <div class="dialog-content">
                <SfListBox TValue="string[]" TItem="DivisionItem" DataSource="@AvailableDivisions"
                           @bind-Value="@SelectedDivisionCodes">
                    <ListBoxFieldSettings Text="DivisionName" Value="DivisionCode"></ListBoxFieldSettings>
                    <ListBoxSelectionSettings ShowCheckbox="true"
                                              Mode="Syncfusion.Blazor.DropDowns.SelectionMode.Multiple">
                    </ListBoxSelectionSettings>
                </SfListBox>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="OK" IsPrimary="true" OnClick="SaveDivisions"></DialogButton>
        <DialogButton Content="Cancel" OnClick="CloseDivisionsDialog"></DialogButton>
    </DialogButtons>
</SfDialog>

<!-- Generic Picker Dialog -->
<SfDialog @ref="PickerDialog"
          Width="500px"
          Height="400px"
          IsModal="true"
          ShowCloseIcon="true"
          Visible="@PickerDialogVisible"
          Header="@PickerTitle">
    <DialogTemplates>
        <Content>
            <div class="dialog-content">
                <HfGrid TValue="PickerItem" DataSource="@PickerItems" AllowSelection="true" Height="250"
                        SelectionSettingsRef="@pickerSelectionSettings"
                        EventsRef="@pickerEvents">
                    <HfGridColumnsBase>
                        <HfGridColumn Field="@nameof(PickerItem.Id)" HeaderText="ID" Width="100px" />
                        <HfGridColumn Field="@nameof(PickerItem.Name)" HeaderText="Name" Width="200px" />
                    </HfGridColumnsBase>
                </HfGrid>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="OK" IsPrimary="true" OnClick="ConfirmPicker"></DialogButton>
        <DialogButton Content="Cancel" OnClick="ClosePickerDialog"></DialogButton>
    </DialogButtons>
</SfDialog>

<!-- Confirmation Dialog -->
<SfDialog @ref="ConfirmDialog"
          Width="400px"
          IsModal="true"
          ShowCloseIcon="true"
          Visible="@ConfirmDialogVisible"
          Header="Confirm">
    <DialogTemplates>
        <Content>
            <div class="dialog-content">
                <p>@ConfirmMessage</p>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Yes" IsPrimary="true" OnClick="ConfirmYes"></DialogButton>
        <DialogButton Content="No" OnClick="ConfirmNo"></DialogButton>
        <DialogButton Content="Cancel" OnClick="ConfirmCancel" Visible="@ShowCancelButton"></DialogButton>
    </DialogButtons>
</SfDialog>

<SfDialog @ref="AccountingDialog" Visible="@AccountingDialogVisible" 
              Width="650px" 
              IsModal="true" 
              ShowCloseIcon="true"
              Header="Accounting"
              CssClass="accounting-dialog"
              CloseOnEscape="true">
        <DialogEvents Closed="OnDialogClosed" />
        <DialogTemplates>
            <Content>
                <!-- GL Accounts / Organization Section (switches based on accounting system) -->
                @if (!IsIntacctSystem)
                {
                    <!-- Standard Accounting System -->
                    <div class="form-section">
                        <div class="form-section-title">GL Accounts</div>
                        
                        <div class="field-row">
                            <label class="field-label">Income Stmt Prefix</label>
                            <div class="field-input">
                                <SfTextBox @bind-Value="IncomePrefix" MaxLength="50" />
                            </div>
                            <SfButton CssClass="e-small field-browse" IconCss="e-icons e-search" 
                                      OnClick="() => BrowsePrefix(1)" />
                        </div>

                        <div class="field-row">
                            <label class="field-label">Balance Sheet Prefix</label>
                            <div class="field-input">
                                <SfTextBox @bind-Value="BalanceSheetPrefix" MaxLength="50" />
                            </div>
                            <SfButton CssClass="e-small field-browse" IconCss="e-icons e-search" 
                                      OnClick="() => BrowsePrefix(2)" />
                        </div>

                        <div class="field-row">
                            <label class="field-label">Lot Inventory Debit</label>
                            <div class="field-input">
                                <SfTextBox @bind-Value="LotInventoryDebit" MaxLength="50" />
                            </div>
                        </div>

                        <div class="field-row">
                            <label class="field-label">Lot Inventory Credit</label>
                            <div class="field-input">
                                <SfTextBox @bind-Value="LotInventoryCredit" MaxLength="50" />
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Intacct Accounting System -->
                    <div class="form-section">
                        <div class="form-section-title">Organization</div>
                        
                        <div class="field-row">
                            <label class="field-label">Entity</label>
                            <div class="field-input">
                                <SfTextBox @bind-Value="IntacctEntity" MaxLength="50" />
                            </div>
                            <SfButton CssClass="e-small field-browse" IconCss="e-icons e-search" 
                                      OnClick="BrowseIntacctEntity" />
                        </div>

                        <div class="field-row">
                            <label class="field-label">Location</label>
                            <div class="field-input">
                                <SfTextBox @bind-Value="IntacctLocation" MaxLength="50" />
                            </div>
                            <SfButton CssClass="e-small field-browse" IconCss="e-icons e-search" 
                                      OnClick="BrowseIntacctLocation" />
                        </div>

                        <div class="field-row">
                            <label class="field-label">Parent Job</label>
                            <div class="field-input">
                                <SfTextBox @bind-Value="IntacctParentJob" MaxLength="50" />
                            </div>
                            <SfButton CssClass="e-small field-browse" IconCss="e-icons e-search" 
                                      OnClick="BrowseIntacctParentJob" />
                        </div>

                        <div class="field-row">
                            <label class="field-label">Department</label>
                            <div class="field-input">
                                <SfTextBox @bind-Value="IntacctDepartment" MaxLength="50" />
                            </div>
                            <SfButton CssClass="e-small field-browse" IconCss="e-icons e-search" 
                                      OnClick="BrowseIntacctDepartment" />
                        </div>
                    </div>
                }

                <!-- Tax Groups Section -->
                <div class="form-section">
                    <div class="form-section-title">Tax Groups</div>
                    
                    <div class="tax-group-row">
                        <div class="tax-group-col">
                            <div class="tax-field-row">
                                <label class="tax-field-label">Labour</label>
                                <SfTextBox @bind-Value="LabourTaxGroup" CssClass="tax-field-input" MaxLength="50" />
                                <SfButton CssClass="e-small field-browse" IconCss="e-icons e-search" 
                                          OnClick="() => BrowseTaxGroup(5)" />
                            </div>
                            <div class="tax-field-row">
                                <label class="tax-field-label">Material</label>
                                <SfTextBox @bind-Value="MaterialTaxGroup" CssClass="tax-field-input" MaxLength="50" />
                                <SfButton CssClass="e-small field-browse" IconCss="e-icons e-search" 
                                          OnClick="() => BrowseTaxGroup(6)" />
                            </div>
                            <div class="tax-field-row">
                                <label class="tax-field-label">Sub Contracts</label>
                                <SfTextBox @bind-Value="SubContractTaxGroup" CssClass="tax-field-input" MaxLength="50" />
