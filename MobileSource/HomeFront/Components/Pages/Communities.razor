                            <div class="field-input">
                                <SfTextBox @bind-Value="TarionBuilderNumber" MaxLength="50" />
                            </div>
                        </div>
                    }
                </div>
            </Content>
        </DialogTemplates>
        <DialogButtons>
            <DialogButton Content="OK" IsPrimary="true" OnClick="OnAcctOkClick" />
            <DialogButton Content="Cancel" OnClick="OnAcctCancelClick" />
        </DialogButtons>
