            if (!string.IsNullOrEmpty(result)){
                CommunityTerm = result;
            }
        }
        catch (Exception ex){
            Console.WriteLine($"[{SRCFILE}LoadCustomDescriptions] Error: {ex.Message}");
        }
    }

    private async Task LoadData(){
        IsLoading = true;
        StateHasChanged();
        try{
            var sql = @"
                SELECT l.BankAccount, l.Area, l.Description, l.Abr, l.Last_Customer, l.Contract_Document, 
                       l.Lot_Inv_Debit, l.Lot_Inv_Credit, l.Project_Manager, l.CustServiceID, l.DC_Sales_Person, 
                       l.last_job_no, l.developer, l.Prefix1, l.Prefix2, l.CompanyName, l.CompanyLogo, 
                       l.Address1, l.Address2, l.City, l.Province, l.Zip, l.GSTNumber, l.Phone, l.FAX, l.Email, 
                       l.Est_DB_Path, l.WMS_DB_path, l.Sales_SystemID, l.EST_Phase_code, l.seq,
                       l.Comments, l.Inactive, l.ProjectCost, l.DepositGL, l.UsesPhases, l.Country, l.County, 
                       l.LabourTaxGroup, l.MaterialTaxGroup, l.SubContractTaxGroup, l.EquipmentTaxGroup, 
                       l.OverheadTaxGroup, l.TarionBuilderNumber, l.OtherTaxGroup, l.WarrantyJob, l.GSTRate, 
                       l.PSTRate, l.SalesManagerEmail, l.LastPOSeq, l.purchaser, dc.BuildProEnabled BuildPro, 
                       l.WrapInsuranceExempt, l.IntacctEntity, l.IntacctParentJob, l.IntacctDepartment, l.Mortgage_Credit
                FROM tbllocality l
                LEFT OUTER JOIN DivisionCommunities dc ON dc.Community = l.Area AND dc.DivisionID = @DivisionID";
            var results = await db.QueryAsync(sql, new { DivisionID });
            CommunitiesData = results.Select(row => new CommunityRow {
                OriginalArea = row["Area"]?.ToString() ?? "",
                Area = row["Area"]?.ToString() ?? "",
                Description = row["Description"]?.ToString() ?? "",
                Abr = row["Abr"]?.ToString() ?? "",
                Comments = row["Comments"]?.ToString() ?? "",
                Company = row["CompanyName"]?.ToString() ?? "",
                Address1 = row["Address1"]?.ToString() ?? "",
                Address2 = row["Address2"]?.ToString() ?? "",
                City = row["City"]?.ToString() ?? "",
                Province = row["Province"]?.ToString() ?? "",
                Postal = row["Zip"]?.ToString() ?? "",
                Country = row["Country"]?.ToString() ?? "",
                County = row["County"]?.ToString() ?? "",
                Phone = row["Phone"]?.ToString() ?? "",
                Fax = row["FAX"]?.ToString() ?? "",
                Email = row["Email"]?.ToString() ?? "",
                TaxNumber = row["GSTNumber"]?.ToString() ?? "",
                WarrantyJob = row["WarrantyJob"]?.ToString() ?? "",
                IncomePrefix = row["Prefix2"]?.ToString() ?? "",
                BalanceSheet = row["Prefix1"]?.ToString() ?? "",
                Mortgage_Credit = row["Mortgage_Credit"]?.ToString() ?? "",
                BankAccount = row["BankAccount"]?.ToString() ?? "",
                TarionBuilderNumber = row["TarionBuilderNumber"]?.ToString() ?? "",
                LotInventoryDebit = row["Lot_Inv_Debit"]?.ToString() ?? "",
                LotInventoryCredit = row["Lot_Inv_Credit"]?.ToString() ?? "",
                Project_Manager = row["Project_Manager"]?.ToString() ?? "",
                CustServiceID = row["CustServiceID"]?.ToString() ?? "",
                DC_Sales_Person = row["DC_Sales_Person"]?.ToString() ?? "",
                Contract_Document = row["Contract_Document"]?.ToString() ?? "",
                Purchaser = row["purchaser"]?.ToString() ?? "",
                LabourTaxGroup = row["LabourTaxGroup"]?.ToString() ?? "",
                MaterialTaxGroup = row["MaterialTaxGroup"]?.ToString() ?? "",
                SubContractTaxGroup = row["SubContractTaxGroup"]?.ToString() ?? "",
                EquipmentTaxGroup = row["EquipmentTaxGroup"]?.ToString() ?? "",
                OverheadTaxGroup = row["OverheadTaxGroup"]?.ToString() ?? "",
                OtherTaxGroup = row["OtherTaxGroup"]?.ToString() ?? "",
                GSTRate = ToDecimal(row["GSTRate"]),
                PSTRate = ToDecimal(row["PSTRate"]),
                SalesManagerEmail = row["SalesManagerEmail"]?.ToString() ?? "",
                IntacctEntity = row["IntacctEntity"]?.ToString() ?? "",
                IntacctParentJob = row["IntacctParentJob"]?.ToString() ?? "",
                IntacctDepartment = row["IntacctDepartment"]?.ToString() ?? "",
                Inactive = ToBool(row["Inactive"]),
                BuildPro = ToBool(row["BuildPro"]),
                WrapInsuranceExempt = ToBool(row["WrapInsuranceExempt"]),
                IsDirty = false,
                IsDeleted = false
            }).ToList();

            // Load divisions for each community
            await LoadCommunityDivisions();
            mDirty = false;
        }
        catch (Exception ex){
            Console.WriteLine($"[{SRCFILE}LoadData] Error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading data: {ex.Message}");
        }
        finally{
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCommunityDivisions(){
        var sql = @"
            SELECT l.area, d.divisioncode
            FROM tbllocality l
            LEFT OUTER JOIN divisioncommunities dc ON l.area = dc.community
            LEFT OUTER JOIN divisions d ON d.divisionid = dc.divisionid
            ORDER BY 1, 2";
        var results = await db.QueryAsync(sql);
        var divisionsByArea = results
            .GroupBy(r => r["area"]?.ToString() ?? "")
            .ToDictionary(
                g => g.Key,
                g => string.Join(", ", g.Where(r => r["divisioncode"] != null).Select(r => r["divisioncode"].ToString()))
            );
        foreach (var community in CommunitiesData){
            if (divisionsByArea.TryGetValue(community.Area, out var divisions)){
                community.Divisions = divisions;
            }
        }
    }

    private async Task LoadDivisions(){
        var sql = "SELECT DivisionCode, DivisionName FROM Divisions ORDER BY DivisionCode";
        var results = await db.QueryAsync(sql);
        AvailableDivisions = results.Select(r => new DivisionItem {
            DivisionCode = r["DivisionCode"]?.ToString() ?? "",
            DivisionName = r["DivisionName"]?.ToString() ?? ""
        }).ToList();
    }

    // ========== Save Operations ==========
    private async Task<bool> SaveData(bool prompt){
        if (!mDirty)
            return true;
        if (prompt){
            var result = await ShowConfirmDialog("This data has changed.\n\nDo you want to save the changes?", true);
            if (result == null) return false; // Cancel
            if (result == false) return true; // No - don't save but continue
        }
        IsLoading = true;
        StateHasChanged();
        try{
            // Process deletions first
            var deletedRows = CommunitiesData.Where(r => r.IsDeleted).ToList();
            foreach (var row in deletedRows){
                if (!string.IsNullOrEmpty(row.OriginalArea)){
                    var deleteSql = $"EXEC sp_DeleteCommunity @Area";
                    await db.ExecuteAsync(deleteSql, new { Area = row.OriginalArea });
                }
                CommunitiesData.Remove(row);
            }

            // Process dirty rows
            var dirtyRows = CommunitiesData.Where(r => r.IsDirty && !r.IsDeleted).ToList();
            foreach (var row in dirtyRows){
                if (string.IsNullOrWhiteSpace(row.Area)){
                    await JSRuntime.InvokeVoidAsync("alert", "The community field cannot be blank");
                    return false;
                }

                // Insert new row if OriginalArea is empty
                if (string.IsNullOrEmpty(row.OriginalArea)){
                    var insertSql = "INSERT INTO tblLocality(Area) VALUES(@Area)";
                    await db.ExecuteAsync(insertSql, new { row.Area });
                    var insertDivSql = @"
                        INSERT INTO DivisionCommunities(DivisionID, Community) 
                        SELECT @DivisionID, area 
                        FROM tbllocality a 
                        LEFT OUTER JOIN DivisionCommunities dc ON dc.Community = a.Area AND dc.DivisionID = @DivisionID  
                        WHERE a.area = @Area AND dc.community IS NULL";
                    await db.ExecuteAsync(insertDivSql, new { DivisionID, row.Area });
                    row.OriginalArea = row.Area;
                }

                // Update the row
                var updateSql = @"
                    UPDATE tblLocality SET
                        Description = @Description,
                        Comments = @Comments,
                        CompanyName = @Company,
                        Address1 = @Address1,
                        Address2 = @Address2,
                        Email = @Email,
                        City = @City,
                        Province = @Province,
                        Zip = @Postal,
                        Country = @Country,
                        County = @County,
                        Phone = @Phone,
                        Fax = @Fax,
                        GSTNumber = @TaxNumber,
                        Prefix1 = @BalanceSheet,
                        Prefix2 = @IncomePrefix,
                        Mortgage_Credit = @Mortgage_Credit,
                        BankAccount = @BankAccount,
                        TarionBuilderNumber = @TarionBuilderNumber,
                        Lot_Inv_Debit = @LotInventoryDebit,
                        Lot_Inv_Credit = @LotInventoryCredit,
                        Project_Manager = @Project_Manager,
                        CustServiceID = @CustServiceID,
                        DC_Sales_Person = @DC_Sales_Person,
                        Contract_Document = @Contract_Document,
                        WarrantyJob = @WarrantyJob,
                        Purchaser = @Purchaser,
                        WrapInsuranceExempt = @WrapInsuranceExempt,
                        Inactive = @Inactive,
                        LabourTaxGroup = @LabourTaxGroup,
                        MaterialTaxGroup = @MaterialTaxGroup,
                        SubContractTaxGroup = @SubContractTaxGroup,
                        EquipmentTaxGroup = @EquipmentTaxGroup,
                        OverheadTaxGroup = @OverheadTaxGroup,
                        OtherTaxGroup = @OtherTaxGroup,
                        GSTRate = @GSTRate,
                        PSTRate = @PSTRate,
                        Abr = @Abr,
                        SalesManagerEmail = @SalesManagerEmail,
                        IntacctEntity = @IntacctEntity,
                        IntacctParentJob = @IntacctParentJob,
                        IntacctDepartment = @IntacctDepartment
                    WHERE Area = @Area";
                await db.ExecuteAsync(updateSql, new {
                    row.Description,
                    row.Comments,
                    row.Company,
                    row.Address1,
                    row.Address2,
                    row.Email,
                    row.City,
                    row.Province,
                    row.Postal,
                    row.Country,
                    row.County,
                    row.Phone,
                    row.Fax,
                    row.TaxNumber,
                    row.BalanceSheet,
                    row.IncomePrefix,
                    row.Mortgage_Credit,
                    row.BankAccount,
                    row.TarionBuilderNumber,
                    row.LotInventoryDebit,
                    row.LotInventoryCredit,
                    row.Project_Manager,
                    row.CustServiceID,
                    row.DC_Sales_Person,
                    row.Contract_Document,
                    row.WarrantyJob,
                    row.Purchaser,
                    WrapInsuranceExempt = row.WrapInsuranceExempt ? 1 : 0,
                    Inactive = row.Inactive ? 1 : 0,
                    row.LabourTaxGroup,
                    row.MaterialTaxGroup,
                    row.SubContractTaxGroup,
                    row.EquipmentTaxGroup,
                    row.OverheadTaxGroup,
                    row.OtherTaxGroup,
                    row.GSTRate,
                    row.PSTRate,
                    row.Abr,
                    row.SalesManagerEmail,
                    row.IntacctEntity,
                    row.IntacctParentJob,
                    row.IntacctDepartment,
                    row.Area
                });

                // Update divisions
                var deleteDivSql = "DELETE DivisionCommunities WHERE Community = @Area";
                await db.ExecuteAsync(deleteDivSql, new { row.Area });
                if (!string.IsNullOrEmpty(row.Divisions)){
                    var divisionCodes = row.Divisions.Split(',').Select(d => d.Trim()).Where(d => !string.IsNullOrEmpty(d));
                    foreach (var divCode in divisionCodes){
                        var insertDivComSql = @"
                            INSERT INTO DivisionCommunities(DivisionID, Community, BuildProEnabled)
                            SELECT d.DivisionID, @Area, @BuildPro
                            FROM Divisions d WHERE d.DivisionCode = @DivisionCode";
                        await db.ExecuteAsync(insertDivComSql, new { row.Area, BuildPro = row.BuildPro ? 1 : 0, DivisionCode = divCode });
                    }
                }
                row.IsDirty = false;
            }
            mDirty = false;
            StateHasChanged();
            return true;
        }
        catch (Exception ex){
            Console.WriteLine($"[{SRCFILE}SaveData] Error: {ex.Message}");
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase)){
                await JSRuntime.InvokeVoidAsync("alert", "This ID is taken. Please choose something else.");
            }
            else{
                await JSRuntime.InvokeVoidAsync("alert", $"Error saving data: {ex.Message}");
            }
            return false;
        }
        finally{
            IsLoading = false;
            StateHasChanged();
        }
    }

