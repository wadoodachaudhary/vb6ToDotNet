                    </HfGridColumnsBase>
                </HfGrid>
            </Content>
        </DialogTemplates>
        <DialogButtons>
            <DialogButton Content="Select" IsPrimary="true" OnClick="OnPicklistSelect" />
            <DialogButton Content="Cancel" OnClick="() => AccountingPickListDialogVisible = false" />
        </DialogButtons>
    </SfDialog>
}


