    private void OnNewClick(){
        var newRow = new CommunityRow {
            OriginalArea = "",
            Area = "",
            IsDirty = true,
            IsDeleted = false
        };

        // Set default division
        var defaultDivision = db.ExecuteScalar<string>(
            "SELECT DivisionCode FROM Divisions WHERE DivisionID = @DivisionID",
            new { DivisionID });
        if (!string.IsNullOrEmpty(defaultDivision)){
            newRow.Divisions = defaultDivision;
        }
        CommunitiesData.Add(newRow);
        mDirty = true;
        StateHasChanged();

        // Scroll to new row
        CommunitiesGrid?.GoToPageAsync(CommunitiesGrid.PageSettings.PageCount);
    }

    private async Task OnDeleteClick(){
        if (SelectedCommunity == null) return;

        // Check if can delete
        var canDelete = db.ExecuteScalar<string>(
            "SELECT dbo.sp_CanDeleteCommunity(@Area)",
            new { Area = SelectedCommunity.Area });
        if (canDelete == "False"){
            await JSRuntime.InvokeVoidAsync("alert",
                "You cannot delete a community that has customers, jobs or assemblies associated with it.");
            return;
        }
        SelectedCommunity.IsDeleted = true;
        SelectedCommunity.IsDirty = true;
        mDirty = true;
        StateHasChanged();
    }

