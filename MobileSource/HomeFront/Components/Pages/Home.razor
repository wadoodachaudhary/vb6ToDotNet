@page "/home"

<PageTitle>HomeFront</PageTitle>

<h1>Hello, World!</h1>

<p>Welcome to <strong>HomeFront</strong> — your Blazor web application.</p>

<p>Current time: @currentTime</p>

<button class="btn btn-primary" @onclick="UpdateTime">Refresh Time</button>

@code {
    private string currentTime = DateTime.Now.ToString("F");

    private void UpdateTime()
    {
        currentTime = DateTime.Now.ToString("F");
    }
}
