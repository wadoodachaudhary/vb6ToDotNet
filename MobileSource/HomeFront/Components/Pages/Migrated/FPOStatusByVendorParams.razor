@page "/po-status-by-vendor-params"
@rendermode InteractiveServer
@namespace HomeFront.Components.Pages
@layout HFComponent

@using System.Data
@using Fx.ControlKit
@using Fx.ControlKit.Notifications
@using HomeFront.Data
@using HomeFront.Services

@inject NavigationManager NavigationManager
@inject ILogger<FPOStatusByVendorParams> Logger
@inject NotificationService Notifications
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db
@inject POStatusByVendorReportRequestService ReportRequest

<PageTitle>PO Status by Vendor - Report Parameters</PageTitle>

@*
   PO Status by Vendor Report — parameter screen.

   Mirrors the VB6 "Enter Parameter Values" dialog for PO Status by Vendor
   v1.rpt: one multi-value Vendor picker (the only InUse user-entered
   parameter) plus the auto-injected DivisionID. Built on FxControlKit's
   MultiSelectDualListControl so the UX matches FPOStatusByJobParams.

   The report's Crystal selection formula matches `?Vendor` against
   `POMaster.Vendor`, which stores Vendor_ID — so the picker's KEY is
   Vendor_ID and the LABEL is "Vendor_ID — vendor_name".
*@

<div class="mcp-container">
    <div class="mcp-header">
        <h3>PO Status by Vendor — Parameters</h3>
        <span class="mcp-sub">Pick one or more Vendors to include in the report.</span>
    </div>

    @if (_loadError != null)
    {
        <div class="mcp-error">@_loadError</div>
    }

    <div class="mcp-section">
        <div class="mcp-section-title">Vendors</div>
        <MultiSelectDualListControl TItem="ListItem"
                                    Items="@_allVendors"
                                    @bind-SelectedItems="_selectedVendors"
                                    LeftHeader="Available Vendors"
                                    RightHeader="Selected Vendors"
                                    KeySelector="@(i => i.Key)"
                                    LabelSelector="@(i => i.Label)"
                                    VisibleRows="14"
                                    Height="380px" />
    </div>

    <div class="mcp-actions">
        <div class="mcp-summary">
            <span><strong>@_selectedVendors.Count</strong> vendor(s)</span>
        </div>
        <button class="btn btn-secondary" type="button" @onclick="OnCancel">Cancel</button>
        <button class="btn btn-primary" type="button"
                disabled="@(!CanRun)"
                @onclick="OnRun">
            View Report
        </button>
    </div>
</div>

@code {
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private List<ListItem> _allVendors = new();
    private IList<ListItem> _selectedVendors = new List<ListItem>();
    private string? _loadError;

    private void Navigate(string route)
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke(route);
        else
            NavigationManager.NavigateTo(route);
    }

    private bool CanRun => _selectedVendors.Count > 0;

    protected override void OnInitialized()
    {
        try
        {
            LoadVendors();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FPOStatusByVendorParams: failed to load vendors");
            _loadError = "Could not load vendors: " + ex.Message;
        }
    }

    private void LoadVendors()
    {
        var divId = SessionState.DivisionID;
        var sql = @"SELECT Vendor_ID, Vendor_Name
                    FROM tblVendors
                    WHERE DivisionID = @DivisionID
                      AND ISNULL(Inactive, 0) = 0
                      AND ISNULL(Vendor_ID, '') <> ''
                    ORDER BY Vendor_Name, Vendor_ID";
        var dt = db.SqlExec(sql, new { DivisionID = divId });
        _allVendors = new List<ListItem>(dt.Rows.Count);
        foreach (DataRow r in dt.Rows)
        {
            var id = r["Vendor_ID"]?.ToString() ?? "";
            if (string.IsNullOrEmpty(id)) continue;
            var name = r["Vendor_Name"]?.ToString();
            var label = string.IsNullOrWhiteSpace(name) ? id : $"{id} — {name}";
            _allVendors.Add(new ListItem(id, label));
        }
    }

    private void OnRun()
    {
        if (!CanRun)
        {
            Notifications.Warning("PO Status by Vendor", "Please select at least one Vendor.");
            return;
        }

        ReportRequest.SetSelection(_selectedVendors.Select(v => v.Key));

        var vendorKeys = string.Join(",", _selectedVendors.Select(v => Uri.EscapeDataString(v.Key)));
        Navigate($"/po-status-by-vendor-report?vendors={vendorKeys}");
    }

    private void OnCancel() => Navigate("/");

    /// <summary>Generic key/label record used by the dual-list panes.</summary>
    public sealed record ListItem(string Key, string Label);
}
