@namespace HomeFront.Components.Pages

@using Fx.ControlKit.Notifications

@if (IsVisible)
{
    <div class="infotip-overlay" style="left: @(Left)px; top: @(Top)px;">
        <div class="infotip-panel">
            @DisplayText
        </div>
    </div>
}

@code {
    /// <summary>
    /// The tooltip text to display.
    /// </summary>
    [Parameter]
    public string TipText { get; set; } = "";

    /// <summary>
    /// Controls visibility of the info tip.
    /// </summary>
    [Parameter]
    public bool IsVisible { get; set; } = false;

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>
    /// Horizontal position (pixels from left of viewport).
    /// </summary>
    [Parameter]
    public double Left { get; set; } = 0;

    /// <summary>
    /// Vertical position (pixels from top of viewport).
    /// </summary>
    [Parameter]
    public double Top { get; set; } = 0;

    private string DisplayText => $" {TipText?.Trim()} ";

    /// <summary>
    /// Shows the info tip with the specified text.
    /// Mirrors the VB6 FInfoTip.Showform method.
    /// </summary>
    public async Task ShowForm(string tipText)
    {
        TipText = tipText;
        IsVisible = true;

        if (IsVisibleChanged.HasDelegate)
            await IsVisibleChanged.InvokeAsync(true);
    }

    /// <summary>
    /// Hides the info tip.
    /// </summary>
    public async Task Hide()
    {
        IsVisible = false;

        if (IsVisibleChanged.HasDelegate)
            await IsVisibleChanged.InvokeAsync(false);
    }
}
