@namespace HomeFront.Components.Pages
@using Fx.ControlKit

@if (IsModal)
{
    <DialogControl Visible="true"
                   Header="@Header"
                   Width="@Width"
                   Height="@Height"
                   CssClass="@CssClass"
                   ShowCloseIcon="true"
                   ShowWindowIcon="true"
                   CloseOnEscape="true"
                   OnClose="@OnClose">
        <ChildContent>
            @ChildContent
        </ChildContent>
    </DialogControl>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool IsModal { get; set; }
    [Parameter] public string Header { get; set; } = "Project Managers";
    [Parameter] public string Width { get; set; } = "min(1720px, 96vw)";
    [Parameter] public string Height { get; set; } = "620px";
    [Parameter] public string CssClass { get; set; } = "project-managers-dialog";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
