    private async Task SendEstimatesToIntacct(long batch)
    {
        try
        {
            var rows = await db.QueryAsync($@"
                SELECT Job_No, ChangeOrder, JCExtra, ExternalCostCode,
                       BudgetPretax+ISNULL(BudgetJCTax,0) AS Amount,
                       BudgetQty, ItemDesc AS Description
                FROM EstimatedItems
                WHERE BudgetPostingBatch = {batch}
                ORDER BY Job_No, ChangeOrder, JCExtra, ExternalCostCode");

            await db.ExecuteAsync($@"
                UPDATE EstimateItems SET BudgetPostingDate = GETDATE()
                WHERE BudgetPostingBatch = {batch}");

            await JSRuntime.InvokeVoidAsync("alert",
                $"Intacct posting: {rows.Count} budget line(s) processed for batch {batch}.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SendEstimatesToIntacct] Error: {ex.Message}");
            throw;
        }
    }

