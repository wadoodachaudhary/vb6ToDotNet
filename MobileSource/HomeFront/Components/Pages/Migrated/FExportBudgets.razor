@page "/export-budgets"
@layout HFComponent
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FExportBudgets> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>Budget Posting Wizard - HomeFront</PageTitle>

<div class="wizard-container" style="position: relative;">
    @if (IsLoading)
    {
        <div class="loading-overlay">⏳ Processing...</div>
    }

    @* ── HEADER ─────────────────────────────────────────── *@
    <div class="wiz-header">
        <img src="images/32/budget.ico" alt="Budget" onerror="this.style.display='none'" />
        <div class="wiz-header-text">
            <h3>Post Budgets to Accounting</h3>
            <p>The posting wizard will send budgets to accounting</p>
        </div>
    </div>

    @* ── BODY ───────────────────────────────────────────── *@
    <div class="wiz-body">
        <img class="wiz-body-icon" src="images/32/budget.ico" alt="" onerror="this.style.display='none'" />
        <div class="wiz-body-content">

            @* ── FRAME 0: Task Selection ─────────────────── *@
            @if (CurrentFrame == 0)
            {
                <div class="wiz-message">Choose the task you would like to perform</div>
                <div class="wiz-radio-group">
                    <RadioControl TValue="bool" Name="taskChoice" Value="true"
                                  @bind-SelectedValue="IsPostNew" @bind-SelectedValue:after="OnTaskChoiceChanged"
                                  Label="Post new budgets" />
                    <RadioControl TValue="bool" Name="taskChoice" Value="false"
                                  @bind-SelectedValue="IsPostNew" @bind-SelectedValue:after="OnTaskChoiceChanged"
                                  Label="Review a previous posting" />
                </div>
            }

            @* ── FRAME 1: Data Selection Grid ────────────── *@
            @if (CurrentFrame == 1)
            {
                <div class="wiz-message">@ListDescription</div>
                <div class="grid-container">
                    <table>
                        <thead>
                            <tr>
                                @foreach (var col in GridColumns)
                                {
                                    <th>@col</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (GridData.Count == 0)
                            {
                                <tr><td colspan="@GridColumns.Count" style="text-align:center; color:#999;">No records found.</td></tr>
                            }
                            else
                            {
                                @for (int i = 0; i < GridData.Count; i++)
                                {
                                    var rowIndex = i;
                                    var row = GridData[rowIndex];
                                    <tr class="@(SelectedRows.Contains(rowIndex) ? "selected" : "")"
                                        @onclick="() => OnGridRowClick(rowIndex)"
                                        @onclick:stopPropagation="true">
                                        @foreach (var col in GridColumns)
                                        {
                                            <td>@(row.ContainsKey(col) ? row[col]?.ToString() ?? "" : "")</td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }

            @* ── FRAME 2: Post / Review ──────────────────── *@
            @if (CurrentFrame == 2)
            {
                <div class="wiz-message">@StatusMessage</div>

                @if (!IsPostNew)
                {
                    @* Review mode: show task links *@
                    <a class="wiz-link" @onclick="OnOpenPostingSummary" @onclick:preventDefault>
                        Open the posting summary report
                    </a>
                    @if (ShowTimberlineOptions)
                    {
                        <a class="wiz-link" @onclick="OnReviewPostingFile" @onclick:preventDefault>
                            Review the posting file
                        </a>
                        <a class="wiz-link" @onclick="OnReviewRejectedRecords" @onclick:preventDefault>
                            Review the rejected records
                        </a>
                        <a class="wiz-link" @onclick="OnOpenProcessingJournal" @onclick:preventDefault>
                            Open the processing journal
                        </a>
                    }
                }
                else
                {
                    @* Post mode: show options *@
                    @if (PostFrameVisible)
                    {
                        <div class="wiz-checkbox-group">
                            <CheckBoxControl @bind-Checked="ShowBatchReport"
                                             Label="Show posting summary report when finished." />
                            @if (ShowTimberlineOptions)
                            {
                                <CheckBoxControl @bind-Checked="ShowProcessingJournal"
                                                 Label="Show processing journal when finished." />
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="error-message">@ErrorMessage</div>
                    }
                }
            }
        </div>
    </div>

    @* ── FOOTER ─────────────────────────────────────────── *@
    <div class="wiz-footer">
        <ButtonControl OnClick="OnCancelClick">Cancel</ButtonControl>
        <ButtonControl Disabled="@(!CanGoBack)" OnClick="OnBackClick">&lt; Back</ButtonControl>
        <ButtonControl Disabled="@(!CanGoNext)" OnClick="OnNextClick">Next &gt;</ButtonControl>
        <ButtonControl CssClass="btn-primary" Disabled="@(!CanFinish)" OnClick="OnFinishClick">Finish</ButtonControl>
    </div>
</div>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    // ── Database ──────────────────────────────────────────────────────────
// ── App State (would come from a shared service in production) ────────
    private string LoginID = "admin";
    private int AccountingSystem = 2; // 1=Timberline, 2=MasterBuilder, 3=QuickBooks, 4=Sage50, etc.
    private bool PostSummarizedBudgets = false;

    // ── Constants ─────────────────────────────────────────────────────────
    private const int asTimberline = 1;
    private const int asMasterBuilder = 2;
    private const int asQuickBooks = 3;
    private const int asIntacct = 8;
    private const int asQuickbooksOnline = 9;

    // ── Wizard State ──────────────────────────────────────────────────────
    private int CurrentFrame = 0;
    private const int MaxFrame = 2;
    private bool IsLoading = false;

    // Frame 0: Task choice
    private bool IsPostNew = true;

    // Frame 1: Grid data
    private string ListDescription = "";
    private List<string> GridColumns = new();
    private List<Dictionary<string, object>> GridData = new();
    private HashSet<int> SelectedRows = new();
    private bool AllowMultiSelect = true;

    // Frame 2: Post/Review
    private string StatusMessage = "";
    private string ErrorMessage = "";
    private bool PostFrameVisible = false;
    private bool ShowBatchReport = true;
    private bool ShowProcessingJournal = false;
    private bool ShowTimberlineOptions = false;

    // Batch tracking
    private long mBatch = 0;
    private string WhereClause = "";

    // ── Navigation Properties ─────────────────────────────────────────────
    private bool CanGoBack => CurrentFrame > 0;
    private bool CanGoNext => CurrentFrame < MaxFrame && (CurrentFrame != 1 || SelectedRows.Count > 0);
    private bool CanFinish => CurrentFrame == MaxFrame && (PostFrameVisible || !IsPostNew);

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        ShowTimberlineOptions = AccountingSystem == asTimberline;
        ShowBatchReport = true;
        ShowProcessingJournal = ShowTimberlineOptions;
    }

    // ── Task Choice ───────────────────────────────────────────────────────
    private void SetTaskChoice(bool postNew)
    {
        IsPostNew = postNew;
        StateHasChanged();
    }

    // RadioControl @bind-SelectedValue:after — IsPostNew is already set by the bind,
    // so just run the side-effect SetTaskChoice did (refresh the wizard view).
    private void OnTaskChoiceChanged() => SetTaskChoice(IsPostNew);

    // ── Grid Row Click ────────────────────────────────────────────────────
    private void OnGridRowClick(int rowIndex)
    {
        if (AllowMultiSelect)
        {
            if (SelectedRows.Contains(rowIndex))
                SelectedRows.Remove(rowIndex);
            else
                SelectedRows.Add(rowIndex);
        }
        else
        {
            SelectedRows.Clear();
            SelectedRows.Add(rowIndex);
        }
        StateHasChanged();
    }

    // ── Navigation ────────────────────────────────────────────────────────
    private async Task OnCancelClick()
    {
        await SaveOptions();
        ClosePage();
    }

    private async Task OnBackClick()
    {
        if (CurrentFrame > 0)
        {
            CurrentFrame--;
            StateHasChanged();
        }
    }

    private async Task OnNextClick()
    {
        if (CurrentFrame < MaxFrame)
        {
            CurrentFrame++;
            await OnFrameChanged();
        }
    }

    private async Task OnFinishClick()
    {
        if (!IsPostNew)
        {
            await SaveOptions();
            ClosePage();
        }
        else
        {
            await CreateBatch();
            await SaveOptions();
            ClosePage();
        }
    }

    private async Task OnFrameChanged()
    {
        switch (CurrentFrame)
        {
            case 1:
                await LoadData();
                break;
            case 2:
                await LoadTasks();
                break;
        }
        StateHasChanged();
    }

    // ── LoadData ──────────────────────────────────────────────────────────
    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            SelectedRows.Clear();
            GridData.Clear();
            GridColumns.Clear();

            string sql;

            if (!IsPostNew)
            {
                // Review mode: show previous batches
                sql = $@"
                    SELECT Batch, TStmp AS Posted, UStmp AS PostedBy
                    FROM Batches
                    WHERE (DivisionID = {SessionState.DivisionID} OR ISNULL(SessionState.DivisionID,0)=0)
                      AND BatchType='Budget Posting'
                    ORDER BY Batch DESC";

                ListDescription = "Select the batch you would like to review.";
                AllowMultiSelect = false;
                GridColumns.AddRange(new[] { "Batch", "Posted", "PostedBy" });
            }
            else
            {
                // Post mode: show jobs with unposted budgets
                sql = $@"
                    SELECT i.Job, j.Description AS [Job Description]
                    FROM EstimateItems i
                    JOIN tbljobs j ON i.Job = j.Job_No AND i.DivisionID = j.DivisionID
                    WHERE BudgetGenerated = 1
                      AND BudgetPostingBatch = 0
                      {(SessionState.DivisionID > 0 ? $"AND i.DivisionID = {SessionState.DivisionID}" : "")}
                    UNION
                    SELECT cb.Job, j.Description AS [Job Description]
                    FROM CancelledBudgets cb
                    JOIN tbljobs j ON cb.Job = j.Job_No AND cb.DivisionID = j.DivisionID
                    WHERE ISNULL(cb.PostBatch,0) = 0
                      {(SessionState.DivisionID > 0 ? $"AND cb.DivisionID = {SessionState.DivisionID}" : "")}";

                ListDescription = "Select the budgets you would like to post.";
                AllowMultiSelect = true;
                GridColumns.AddRange(new[] { "Job", "Job Description" });
            }

            var rows = await db.QueryAsync(sql);
            GridData = rows;

            // Auto-select first row if any
            if (GridData.Count > 0 && !AllowMultiSelect)
            {
                SelectedRows.Add(0);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            ErrorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ── LoadTasks ─────────────────────────────────────────────────────────
    private async Task LoadTasks()
    {
        ErrorMessage = "";
        PostFrameVisible = false;

        if (!IsPostNew)
        {
            // Review mode
            if (SelectedRows.Count > 0)
            {
                var selectedIndex = SelectedRows.First();
                if (selectedIndex < GridData.Count && GridData[selectedIndex].ContainsKey("Batch"))
                {
                    mBatch = Convert.ToInt64(GridData[selectedIndex]["Batch"]);
                }
            }
            StatusMessage = $"Review batch {mBatch}. Select a task below:";
        }
        else
        {
            // Post mode
            StatusMessage = "The posting wizard is ready to proceed.";
            PostFrameVisible = true;

            if (AccountingSystem == asMasterBuilder)
            {
                // In production, check if MB API is running
                bool mbApiRunning = await CheckMbApiRunning();
                if (mbApiRunning)
                {
                    StatusMessage = "The posting wizard is ready to proceed.";
                    PostFrameVisible = true;
                }
                else
                {
                    StatusMessage = "The posting wizard is not able to process these budgets.\n\nThe Master Builder API is not accepting requests.";
                    PostFrameVisible = false;
                }
            }
        }

        StateHasChanged();
    }

    private Task<bool> CheckMbApiRunning()
    {
        // Placeholder: in production, check actual API status
        return Task.FromResult(true);
    }

    // ── CreateBatch ───────────────────────────────────────────────────────
    private async Task CreateBatch()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            // Create new batch
            var insertSql = $@"
                INSERT INTO Batches(BatchType, UStmp, TStmp, DivisionID)
                VALUES('Budget Posting', '{LoginID}', GETDATE(), {SessionState.DivisionID})";
            await db.ExecuteAsync(insertSql);

            mBatch = await db.ExecuteScalarAsync<long>("SELECT IDENT_CURRENT('Batches')");

            if (mBatch == 0)
            {
                ErrorMessage = "Failed to create batch.";
                return;
            }

            // Build WHERE clause from selected rows
            var jobConditions = new List<string>();
            var jobConditionsWithAlias = new List<string>();

            foreach (var idx in SelectedRows)
            {
                if (idx < GridData.Count && GridData[idx].ContainsKey("Job"))
                {
                    var job = GridData[idx]["Job"]?.ToString() ?? "";
                    jobConditions.Add($"(Job_No='{EscapeSql(job)}')");
                    jobConditionsWithAlias.Add($"(e.Job_No='{EscapeSql(job)}')");
                }
            }

            if (jobConditions.Count == 0)
            {
                ErrorMessage = "No jobs selected.";
                return;
            }

            var whereJobs = string.Join(" OR ", jobConditions);
            WhereClause = string.Join(" OR ", jobConditionsWithAlias);

            // Update EstimateItems and CancelledBudgets with batch number
            switch (AccountingSystem)
            {
                case asTimberline:
                case asMasterBuilder:
                case asIntacct:
                    await db.ExecuteAsync($@"
                        UPDATE EstimateItems
                        SET BudgetPostingBatch = {mBatch}
                        WHERE BudgetGenerated = 1
                          AND ISNULL(BudgetPostingBatch,0) = 0
                          AND EstItemID IN (SELECT EstItemID FROM EstimatedItems WHERE {whereJobs})");

                    var cancelWhereJobs = whereJobs.Replace("Job_No=", "Job=");
                    await db.ExecuteAsync($@"
                        UPDATE CancelledBudgets
                        SET PostBatch = {mBatch}
                        WHERE ISNULL(PostBatch,0) = 0
                          AND EstItemID IN (SELECT EstItemID FROM CancelledBudgets WHERE {cancelWhereJobs})");

                    await SendBatch();
                    break;

                case asQuickBooks:
                case asQuickbooksOnline:
                    await SendBatch();
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            ErrorMessage = $"Error creating batch: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ── SendBatch ─────────────────────────────────────────────────────────
    private async Task SendBatch()
    {
        try
        {
            switch (AccountingSystem)
            {
                case asMasterBuilder:
                case asIntacct:
                    // Ensure jobs exist in accounting
                    var jobRs = await db.QueryAsync($@"
                        SELECT DISTINCT Job FROM EstimateItems
                        WHERE BudgetPostingBatch = {mBatch}");
                    foreach (var row in jobRs)
                    {
                        var job = row["Job"]?.ToString() ?? "";
                        await WriteJobToAccounting(job);
                    }
                    break;
            }

            // Dispatch to accounting system
            switch (AccountingSystem)
            {
                case asIntacct:
                    await SendEstimatesToIntacct(mBatch);
                    break;
                case asTimberline:
                    await SendBatchToSage300();
                    break;
                case asMasterBuilder:
                    await SendBatchToSage100();
                    break;
                case asQuickBooks:
                    await SendBatchToQB();
                    break;
                case asQuickbooksOnline:
                    await SendBatchToQBOnline();
                    break;
            }

            // Show summary report (VB6 opened Crystal Report: ExportBudgetBatch.rpt with Batch/SessionState.DivisionID/PostSummaries params)
            if (ShowBatchReport)
            {
                Console.WriteLine($"Budget posting batch {mBatch} completed. Report: ExportBudgetBatch.rpt, DivisionID ={SessionState.DivisionID}, PostSummarized={PostSummarizedBudgets}");

                // TODO: Integrate report viewer for ExportBudgetBatch.rpt
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            ErrorMessage = $"Error sending batch: {ex.Message}";
        }
    }

    // ── Accounting System Stubs ───────────────────────────────────────────
    private async Task SendBatchToSage100()
    {
        try
        {
            await db.ExecuteAsync($@"
                UPDATE EstimateItems SET BudgetPostingDate = NULL
                WHERE BudgetPostingBatch = {mBatch}");

            string sql;
            if (PostSummarizedBudgets)
            {
                sql = $@"
                    SELECT c.Job, c.ChangeOrder, c.JCExtra, sc.ExternalID AS CostCode,
                           SUM(CASE WHEN c.JCCategory=1 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END) AS ct1,
                           SUM(CASE WHEN c.JCCategory=2 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END) AS ct2,
                           SUM(CASE WHEN c.JCCategory=3 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END) AS ct3,
                           SUM(CASE WHEN c.JCCategory=4 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END) AS ct4,
                           SUM(CASE WHEN c.JCCategory=5 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END) AS ct5,
                           SUM(CASE WHEN c.JCCategory=6 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END) AS ct6,
                           SUM(CASE WHEN c.JCCategory=7 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END) AS ct7,
                           SUM(CASE WHEN c.JCCategory=8 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END) AS ct8,
                           SUM(CASE WHEN c.JCCategory=9 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END) AS ct9,
                           SUM(c.Qty) AS Qty, 'Summarized' AS Description
                    FROM CancelledBudgets c
                         JOIN StandardCostCodes sc ON c.DivisionID=sc.DivisionID AND c.JCCostCode=sc.CostCode
                    WHERE PostBatch = {mBatch}
                    GROUP BY c.ChangeOrder, c.Job, c.JCExtra, sc.ExternalID
                    UNION ALL
                    SELECT Job_No, ChangeOrder, JCExtra, ExternalCostCode AS CostCode,
                           SUM(CASE WHEN JCCategory=1 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END) AS ct1,
                           SUM(CASE WHEN JCCategory=2 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END) AS ct2,
                           SUM(CASE WHEN JCCategory=3 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END) AS ct3,
                           SUM(CASE WHEN JCCategory=4 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END) AS ct4,
                           SUM(CASE WHEN JCCategory=5 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END) AS ct5,
                           SUM(CASE WHEN JCCategory=6 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END) AS ct6,
                           SUM(CASE WHEN JCCategory=7 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END) AS ct7,
                           SUM(CASE WHEN JCCategory=8 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END) AS ct8,
                           SUM(CASE WHEN JCCategory=9 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END) AS ct9,
                           SUM(BudgetQty) AS Qty, 'Summarized' AS Description
                    FROM EstimatedItems
                    WHERE BudgetPostingBatch = {mBatch}
                    GROUP BY ChangeOrder, Job_No, JCExtra, ExternalCostCode
                    ORDER BY 1,2,3,4";
            }
            else
            {
                sql = $@"
                    SELECT c.Job AS Job_No, c.ChangeOrder, c.JCExtra, sc.ExternalID AS CostCode,
                           CASE WHEN cc.ExternalID=1 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END AS ct1,
                           CASE WHEN cc.ExternalID=2 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END AS ct2,
                           CASE WHEN cc.ExternalID=3 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END AS ct3,
                           CASE WHEN cc.ExternalID=4 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END AS ct4,
                           CASE WHEN cc.ExternalID=5 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END AS ct5,
                           CASE WHEN cc.ExternalID=6 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END AS ct6,
                           CASE WHEN cc.ExternalID=7 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END AS ct7,
                           CASE WHEN cc.ExternalID=8 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END AS ct8,
                           CASE WHEN cc.ExternalID=9 THEN c.Pretax+ISNULL(c.Tax,0) ELSE 0 END AS ct9,
                           c.Qty, ISNULL(NULLIF(i.Description,''),'?') AS Description
                    FROM CancelledBudgets c
                         LEFT OUTER JOIN EstimateItems i ON c.EstItemID=i.EstItemID
                         JOIN StandardCostCodes sc ON c.DivisionID=sc.DivisionID AND c.JCCostCode=sc.CostCode
                         JOIN StandardCategories cc ON c.DivisionID=cc.DivisionID AND c.JCCategory=cc.Category
                    WHERE PostBatch = {mBatch}
                    UNION ALL
                    SELECT Job_No, ChangeOrder, JCExtra, ExternalCostCode AS CostCode,
                           CASE WHEN ExternalCategory=1 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END AS ct1,
                           CASE WHEN ExternalCategory=2 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END AS ct2,
                           CASE WHEN ExternalCategory=3 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END AS ct3,
                           CASE WHEN ExternalCategory=4 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END AS ct4,
                           CASE WHEN ExternalCategory=5 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END AS ct5,
                           CASE WHEN ExternalCategory=6 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END AS ct6,
                           CASE WHEN ExternalCategory=7 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END AS ct7,
                           CASE WHEN ExternalCategory=8 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END AS ct8,
                           CASE WHEN ExternalCategory=9 THEN BudgetPretax+ISNULL(BudgetJCTax,0) ELSE 0 END AS ct9,
                           BudgetQty AS Qty, ISNULL(NULLIF(ItemDesc,''),'?') AS Description
                    FROM EstimatedItems
                    WHERE BudgetPostingBatch = {mBatch}
                    ORDER BY 1,2,3,4";
            }

            var rows = await db.QueryAsync(sql);

            // Mark items as posted
            await db.ExecuteAsync($@"
                UPDATE EstimateItems SET BudgetPostingDate = GETDATE()
                WHERE BudgetPostingBatch = {mBatch}");

            Console.WriteLine($"Sage 100 posting: {rows.Count} budget line(s); processed for batch {mBatch}.");

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            // Rollback unposted items
            await db.ExecuteAsync($@"
                UPDATE EstimateItems SET BudgetPostingBatch = 0
                WHERE BudgetPostingDate IS NULL AND BudgetPostingBatch = {mBatch}");
            throw;
        }
    }

    private async Task SendBatchToSage300()
    {
        try
        {
            string sql;
            if (PostSummarizedBudgets)
            {
                sql = $@"
                    SELECT Job AS Job_No, '' AS JobDesc, JCExtra, NULL AS JCExtraDesc,
                           JCCostCode, JCCategory, 0 AS Qty, '' AS UOM,
                           SUM(Pretax+Tax) AS Amount
                    FROM CancelledBudgets
                    WHERE PostBatch = {mBatch}
                    GROUP BY Job, JCExtra, JCCostCode, JCCategory
                    UNION ALL
                    SELECT Job_No, JobDesc, JCExtra, LEFT(AssemblyDescription,30) AS JCExtraDesc,
                           JCCostCode, JCCategory, 0 AS Qty, '' AS UOM,
                           SUM(BudgetPretax+BudgetJCTax) AS Amount
                    FROM EstimatedItems
                    WHERE BudgetPostingBatch = {mBatch}
                    GROUP BY Job_No, JobDesc, JCExtra, LEFT(AssemblyDescription,30), JCCostCode, JCCategory
                    ORDER BY Job_No, JCExtra, JCCostCode, JCCategory";
            }
            else
            {
                sql = $@"
                    SELECT Job AS Job_No, '' AS JobDesc, JCExtra, NULL AS JCExtraDesc,
                           JCCostCode, JCCategory, Qty, UOM, Pretax+Tax AS Amount
                    FROM CancelledBudgets
                    WHERE PostBatch = {mBatch}
                    UNION ALL
                    SELECT Job_No, JobDesc, JCExtra, LEFT(AssemblyDescription,30) AS JCExtraDesc,
                           JCCostCode, JCCategory, BudgetQty AS Qty, OrderUOM AS UOM,
                           BudgetPretax+BudgetJCTax AS Amount
                    FROM EstimatedItems
                    WHERE BudgetPostingBatch = {mBatch}
                    ORDER BY Job_No, JCExtra, JCCostCode, JCCategory";
            }

            var rows = await db.QueryAsync(sql);

            Console.WriteLine($"Sage 300 posting: {rows.Count} budget line(s); processed for batch {mBatch}. JCE file generation and Timberline macro execution needed.");

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            // Rollback
            await db.ExecuteAsync($@"UPDATE EstimateItems SET BudgetPostingBatch=0 WHERE BudgetPostingBatch={mBatch}");
            await db.ExecuteAsync($@"UPDATE CancelledBudgets SET PostBatch=0 WHERE PostBatch={mBatch}");
            await db.ExecuteAsync($@"DELETE Batches WHERE Batch={mBatch}");
            throw;
        }
    }

    private async Task SendBatchToQB()
    {
        try
        {
            // Ensure jobs exist in accounting
            var missingJobsSql = $@"
                SELECT e.ExternalJobID, e.Job_No FROM tbljobs e
                WHERE e.DivisionID = {SessionState.DivisionID} AND ISNULL(e.ExternalJobID,'')='' AND ({WhereClause})";
            var missingJobs = await db.QueryAsync(missingJobsSql);
            foreach (var mj in missingJobs)
            {
                var jobNo = mj["Job_No"]?.ToString() ?? "";
                if (!string.IsNullOrEmpty(jobNo))
                    await WriteJobToAccounting(jobNo);
            }

            var sql = $@"
                SELECT cc.ExternalID AS JCCostCode, cat.ExternalID AS JCCategory,
                       SUM(c.Pretax)+SUM(c.Tax) AS Amount, c.TaxGroup AS BudgetTaxGroup,
                       cc.Description AS ItemDesc, e.ExternalJobID, e.Job_No
                FROM CancelledBudgets c
                JOIN tbljobs e ON c.Job=e.Job_No
                JOIN StandardCostCodes cc ON c.JCCostCode=cc.CostCode
                JOIN StandardCategories cat ON c.JCCategory=cat.Category
                WHERE ({WhereClause}) AND e.DivisionID = {SessionState.DivisionID}
                  AND c.PostBatch=0 AND c.JCCostCode<>''
                GROUP BY cc.ExternalID, cat.ExternalID, c.TaxGroup, cc.Description, e.ExternalJobID, e.Job_No
                UNION ALL
                SELECT e.ExternalCostCode, e.ExternalCategory,
                       SUM(e.BudgetPretax)+SUM(e.BudgetJCTax) AS Amount, e.BudgetTaxGroup,
                       e.JCCostCodeDesc AS ItemDesc, j.ExternalJobID, e.Job_No
                FROM EstimatedItems e
                JOIN tbljobs j ON e.Job_No = j.Job_No
                WHERE ({WhereClause}) AND e.DivisionID = {SessionState.DivisionID}
                  AND e.BudgetPostingBatch = 0 AND e.BudgetGenerated = 1 AND e.JCCostCode <> ''
                GROUP BY e.ExternalCostCode, e.ExternalCategory, e.BudgetTaxGroup, e.JCCostCodeDesc, j.ExternalJobID, e.Job_No
                ORDER BY 6, 5";

            var rows = await db.QueryAsync(sql);

            // Process per-job and mark as posted (VB6 sends XML per job to QuickBooks)
            string lastJob = "";
            foreach (var row in rows)
            {
                var thisJob = row["ExternalJobID"]?.ToString() ?? "";
                var jobNo = row["Job_No"]?.ToString() ?? "";

                if (thisJob != lastJob && !string.IsNullOrEmpty(lastJob) && !string.IsNullOrEmpty(jobNo))
                {
                    await db.ExecuteAsync($@"
                        UPDATE EstimateItems SET BudgetPostingBatch = {mBatch}
                        WHERE BudgetGenerated = 1 AND ISNULL(BudgetPostingBatch,0) = 0
                          AND EstItemID IN (SELECT EstItemID FROM EstimatedItems WHERE Job_No = '{EscapeSql(jobNo)}')");
                    await db.ExecuteAsync($@"
                        UPDATE CancelledBudgets SET PostBatch = {mBatch}
                        WHERE ISNULL(PostBatch,0) = 0
                          AND EstItemID IN (SELECT EstItemID FROM EstimatedItems WHERE Job_No = '{EscapeSql(jobNo)}')");
                }
                lastJob = thisJob;
            }

            // Mark final job
            if (!string.IsNullOrEmpty(lastJob) && rows.Count > 0)
            {
                var lastJobNo = rows.Last()["Job_No"]?.ToString() ?? "";
                if (!string.IsNullOrEmpty(lastJobNo))
                {
                    await db.ExecuteAsync($@"
                        UPDATE EstimateItems SET BudgetPostingBatch = {mBatch}
                        WHERE BudgetGenerated = 1 AND ISNULL(BudgetPostingBatch,0) = 0
                          AND EstItemID IN (SELECT EstItemID FROM EstimatedItems WHERE Job_No = '{EscapeSql(lastJobNo)}')");
                    await db.ExecuteAsync($@"
                        UPDATE CancelledBudgets SET PostBatch = {mBatch}
                        WHERE ISNULL(PostBatch,0) = 0
                          AND EstItemID IN (SELECT EstItemID FROM EstimatedItems WHERE Job_No = '{EscapeSql(lastJobNo)}')");
                }
            }

            Console.WriteLine($"QuickBooks posting: {rows.Count} budget line(s); processed for batch {mBatch}.");

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            throw;
        }
    }

