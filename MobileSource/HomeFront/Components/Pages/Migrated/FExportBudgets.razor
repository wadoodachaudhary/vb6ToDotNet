                ORDER BY 6, 5";

            var rows = await db.QueryAsync(sql);

            // Process per-job: VB6 sends XML per job to QBO API, marks posted on success
            string lastJob = "";
            string lastHFJobNo = "";
            foreach (var row in rows)
            {
                var thisJob = row["ExternalJobID"]?.ToString() ?? "";
                var jobNo = row["Job_No"]?.ToString() ?? "";

                if (thisJob != lastJob && !string.IsNullOrEmpty(lastJob) && !string.IsNullOrEmpty(lastHFJobNo))
