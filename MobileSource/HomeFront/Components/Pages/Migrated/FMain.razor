    // === Inbox / Custom Request Counts ===
    private async Task<int> GetInboxCount()
    {
        try
        {
            var sql1 = "SELECT COUNT(*) FROM unestimatedoptions o";
            var sql2 = "SELECT COUNT(*) FROM unestimatedcustomers o";
            if (!string.IsNullOrEmpty(DivisionID))
            {
                sql1 += $" LEFT OUTER JOIN divisioncommunities d ON d.Community=o.Community WHERE (d.DivisionID IS NULL OR d.DivisionID={DivisionID})";
                sql2 += $" LEFT OUTER JOIN divisioncommunities d ON d.Community=o.Community WHERE (d.DivisionID IS NULL OR d.DivisionID={DivisionID})";
            }
            var dt1 = db.SqlExec(sql1);
            var dt2 = db.SqlExec(sql2);
            var c1 = dt1.Rows.Count > 0 ? Convert.ToInt32(dt1.Rows[0][0]) : 0;
            var c2 = dt2.Rows.Count > 0 ? Convert.ToInt32(dt2.Rows[0][0]) : 0;
            return c1 + c2;
        }
        catch { return 0; }
    }

    private async Task<int> GetCustomRequestCount()
    {
        try
        {
            var sql = "SELECT COUNT(*) FROM unquotedoptions o";
            if (!string.IsNullOrEmpty(DivisionID))
                sql += $" LEFT OUTER JOIN divisioncommunities d ON d.Community=o.Community WHERE (d.DivisionID IS NULL OR d.DivisionID={DivisionID})";
            var dt = db.SqlExec(sql);
            return dt.Rows.Count > 0 ? Convert.ToInt32(dt.Rows[0][0]) : 0;
        }
        catch { return 0; }
    }

    // === Timer for Auto-Refresh ===
    private void StartRefreshTimer()
    {
        _refreshTimer = new System.Timers.Timer(30000);
        _refreshTimer.Elapsed += async (s, e) => await OnTimerElapsed();
        _refreshTimer.AutoReset = true;
        _refreshTimer.Start();
    }

    private async Task OnTimerElapsed()
    {
        try
        {
            // Update inbox/custom request counts
            var inboxCount = await GetInboxCount();
            var customCount = await GetCustomRequestCount();

            await InvokeAsync(() =>
            {
                // Update explorer items
                if (ExplorerSections.Count > 0)
                {
                    var purchasingSection = ExplorerSections[0];
                    foreach (var item in purchasingSection.Items)
                    {
                        if (item.TaskName == "Inbox")
                        {
                            item.Text = inboxCount == 0 ? "Inbox (empty)" : $"Inbox ({inboxCount})";
                            item.IsBold = inboxCount > 0;
                            item.IsRed = inboxCount > 0;
                        }
                        else if (item.TaskName == "Custom Requests")
                        {
                            item.Text = customCount == 0 ? "Custom Requests" : $"Custom Requests ({customCount})";
                            item.IsBold = customCount > 0;
                            item.IsRed = customCount > 0;
                        }
                    }
                }

                // Handle timer task
                if (!string.IsNullOrEmpty(mTimerTask) && mTimerTask.StartsWith("EditAttachments"))
                {
                    // Would call HFApp.RunTask(mTimerTask)
                    mTimerTask = "";
                }

                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Timer error: {ex.Message}");
        }
    }

    // === Run Task ===
    public async Task RunTaskAsync(string taskName)
    {
        openMenu = "";
        StatusMessage = $"Running: {taskName}...";
        StateHasChanged();

        try
        {
            switch (taskName)
            {
                case "Inbox":
                    await JSRuntime.InvokeVoidAsync("alert", "Inbox - would show FInboxJobs dialog");
                    break;

                case "Custom Requests":
                    await JSRuntime.InvokeVoidAsync("alert", "Custom Requests - would show FInboxCustomQuote dialog");
                    break;

                case "Issue budgets":
                    NavigationManager.NavigateTo("/estimate-items?mode=Budget");
                    break;

                case "Issue POs":
                    NavigationManager.NavigateTo("/estimate-items?mode=PO");
                    break;

                case "Create Manual POs":
                    NavigationManager.NavigateTo("/purchase-order");
                    break;

                case "Prepare Job Quote":
                    NavigationManager.NavigateTo("/estimate-items?mode=Quote");
                    break;

                case "Project Managers":
                    await JSRuntime.InvokeVoidAsync("alert", "Project Managers - would open EditProjectManagerList");
                    break;

                case var s when s == $"{CD_Community} Setup" || s == "Community Setup" || s == "Work Region Setup":
                    await JSRuntime.InvokeVoidAsync("alert", "Community Setup - would open EditCommunities");
                    break;

                case "Job setup":
                    await JSRuntime.InvokeVoidAsync("alert", $"Job Setup - would open EditJob for job: {mCurrentJob}");
                    break;

                case "Vendor setup":
                    await JSRuntime.InvokeVoidAsync("alert", "Vendor Setup - would open EditVendor");
                    break;

                case "Customer setup":
                    await JSRuntime.InvokeVoidAsync("alert", $"Customer Setup - would open EditCustomer for: {CurrentCustomer}");
                    break;

                case "Purchase Orders":
                    await JSRuntime.InvokeVoidAsync("alert", "Purchase Orders - would open EditPOIndexes");
                    break;

                case "Default Vendors":
                    await JSRuntime.InvokeVoidAsync("alert", "Default Vendors - would open EditDefaultVendors");
                    break;

                case "Edit item database":
                    NavigationManager.NavigateTo("/items-db-opus");
                    break;

                case "Edit models and options":
                case "Edit Assemblies":
                    NavigationManager.NavigateTo("/edit-model-assembly");
                    break;

                case var s2 when s2 == $"{CD_Community} Standards":
                    await JSRuntime.InvokeVoidAsync("alert", "Community Standards - would open FCommunityStandards");
                    break;

                case "Edit item prices":
                    NavigationManager.NavigateTo("/vendor-pricelist-opus");
                    break;

                case "Cost Forecasting":
                    await JSRuntime.InvokeVoidAsync("alert", "Cost Forecasting - would open FCostForecast");
                    break;

                case "Export pricelists":
                    await JSRuntime.InvokeVoidAsync("alert", "Export Pricelists - would open FExportPricelists");
                    break;

                case "Import pricelists":
                    await JSRuntime.InvokeVoidAsync("alert", "Import Pricelists - would open FImportPricelists");
                    break;

                case "Import items":
                    await JSRuntime.InvokeVoidAsync("alert", "Import Items - would open FImportAssemblies (Item mode)");
                    break;

                case "Import models and options":
                case "Import Assemblies":
                    await JSRuntime.InvokeVoidAsync("alert", "Import Assemblies - would open FImportAssemblies (Assembly mode)");
                    break;

                case "Send Purchase Orders":
                    await JSRuntime.InvokeVoidAsync("alert", "Send POs - would open FSendingWizard (PO mode)");
                    break;

                case "Post budgets":
                    await JSRuntime.InvokeVoidAsync("alert", "Post Budgets - would open FExportBudgets");
                    break;

                case "Post purchase orders":
                    await JSRuntime.InvokeVoidAsync("alert", "Post POs - would open FExportPOs");
                    break;

                case "Open a marketing worksheet":
                    NavigationManager.NavigateTo("/pricing-worksheet-opus?view=Marketing");
                    break;

                case "Open an estimating worksheet":
                    NavigationManager.NavigateTo("/pricing-worksheet-opus");
                    break;

                case "Open a design center worksheet":
                    NavigationManager.NavigateTo("/pricing-worksheet-opus?view=DesignCenter");
                    break;

                case "Review a published worksheet":
                    await JSRuntime.InvokeVoidAsync("alert", "Review Published Worksheet - would open report viewer");
                    break;

                case "Job Cost Codes":
                    await JSRuntime.InvokeVoidAsync("alert", "Job Cost Codes - would open EditJCCostCodes");
                    break;

                case "Job Cost Categories":
                    await JSRuntime.InvokeVoidAsync("alert", "Job Cost Categories - would open EditJCCategories");
                    break;

                default:
                    await JSRuntime.InvokeVoidAsync("alert", $"Task '{taskName}' is not yet implemented.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error running task: {ex.Message}");
        }
        finally
        {
            StatusMessage = "Ready";
            StateHasChanged();
        }
    }

