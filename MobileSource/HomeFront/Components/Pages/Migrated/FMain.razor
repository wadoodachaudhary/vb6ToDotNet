    // === Inbox / Custom Request Counts ===
    private async Task<int> GetInboxCount()
    {
        try
        {
            var sql1 = "SELECT COUNT(*) FROM unestimatedoptions o";
            var sql2 = "SELECT COUNT(*) FROM unestimatedcustomers o";
            if (!string.IsNullOrEmpty(DivisionID))
            {
                sql1 += $" LEFT OUTER JOIN divisioncommunities d ON d.Community=o.Community WHERE (d.DivisionID IS NULL OR d.DivisionID={DivisionID})";
                sql2 += $" LEFT OUTER JOIN divisioncommunities d ON d.Community=o.Community WHERE (d.DivisionID IS NULL OR d.DivisionID={DivisionID})";
            }
            var dt1 = db.SqlExec(sql1);
            var dt2 = db.SqlExec(sql2);
            var c1 = dt1.Rows.Count > 0 ? Convert.ToInt32(dt1.Rows[0][0]) : 0;
            var c2 = dt2.Rows.Count > 0 ? Convert.ToInt32(dt2.Rows[0][0]) : 0;
            return c1 + c2;
        }
        catch { return 0; }
    }

    private async Task<int> GetCustomRequestCount()
    {
        try
        {
            var sql = "SELECT COUNT(*) FROM unquotedoptions o";
            if (!string.IsNullOrEmpty(DivisionID))
                sql += $" LEFT OUTER JOIN divisioncommunities d ON d.Community=o.Community WHERE (d.DivisionID IS NULL OR d.DivisionID={DivisionID})";
            var dt = db.SqlExec(sql);
            return dt.Rows.Count > 0 ? Convert.ToInt32(dt.Rows[0][0]) : 0;
        }
        catch { return 0; }
    }

    private string GetOptionValue(string optionName)
    {
        try
        {
            var dt = db.SqlExec("SELECT TOP 1 OptionValue FROM AppOptions WHERE OptionName=@OptionName AND DivisionID IN (0,@DivisionID) ORDER BY DivisionID DESC", new { OptionName = optionName, DivisionID });
            if (dt != null && dt.Rows.Count > 0)
            {
                return dt.Rows[0]["OptionValue"]?.ToString() ?? "";
            }
        }
        catch { }
        return "";
    }

    private async Task<int> GetTBDCount()
    {
        try
        {
            var sql = "SELECT COUNT(*) FROM pomaster WHERE ISNULL(BuildPro_AssignedVendor,'')<>'';";
            var dt = db.SqlExec(sql);
            return dt.Rows.Count > 0 ? Convert.ToInt32(dt.Rows[0][0]) : 0;
        }
        catch { return 0; }
    }

