    private async Task DuplicateModelOptionsAsync()
    {
        // VB6: DuplicateModelOptions - copies options from one model to another
        // Prompt for source and target models
        string sourceModel = await JSRuntime.InvokeAsync<string>("prompt", "Enter source Model name to copy options from:");
        if (string.IsNullOrWhiteSpace(sourceModel)) return;

        string targetModel = await JSRuntime.InvokeAsync<string>("prompt", "Enter target Model name to copy options to:");
        if (string.IsNullOrWhiteSpace(targetModel)) return;

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Copy all options from model '{sourceModel}' to model '{targetModel}'?");
        if (!confirmed) return;

        try
        {
            // Check source model exists
            var dtSource = await db.QueryAsync(
                "SELECT ModelID FROM Models WHERE ModelName = @Name", new { Name = sourceModel });
            if (dtSource.Count == 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Source model '{sourceModel}' not found.");
                return;
            }

            // Check target model exists
            var dtTarget = await db.QueryAsync(
                "SELECT ModelID FROM Models WHERE ModelName = @Name", new { Name = targetModel });
            if (dtTarget.Count == 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Target model '{targetModel}' not found.");
                return;
            }

            int sourceId = Convert.ToInt32(dtSource[0]["ModelID"]);
            int targetId = Convert.ToInt32(dtTarget[0]["ModelID"]);

            // Delete existing options in target model, then copy from source
            await db.ExecuteAsync(
                "DELETE FROM ModelOptions WHERE ModelID = @Id", new { Id = targetId });
            await db.ExecuteAsync(
                "INSERT INTO ModelOptions (ModelID, OptionID, OptionGroupID, OptionCategoryID, SortOrder, IsDefault) " +
                "SELECT @TargetId, OptionID, OptionGroupID, OptionCategoryID, SortOrder, IsDefault " +
                "FROM ModelOptions WHERE ModelID = @SourceId",
                new { TargetId = targetId, SourceId = sourceId });

            await JSRuntime.InvokeVoidAsync("alert", $"Options successfully copied from '{sourceModel}' to '{targetModel}'.");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error duplicating model options: {ex.Message}");
        }
    }

