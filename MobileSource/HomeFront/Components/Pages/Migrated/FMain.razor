@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - MDI shell with FlexKit MdiHost; tabbed page hosting via DynamicComponent
     - Home tab returns to Workflow without closing other tabs
     - Auth gate at top of OnInitializedAsync (redirects to /login when not authenticated)
     - Removed top .NET / VB6 tabs
     - Fixed duplicate-tab on intra-tab state publish (FAssembly picklist twice)
   ───────────────────────────────────────────────────────────────── *@
@page "/main"
@page "/main/{CurrentJobParam}"
@rendermode InteractiveServer
@implements IAsyncDisposable

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.IO
@using System.Linq
@using System.Reflection
@using System.Timers
@using Microsoft.AspNetCore.Components.Routing
@using HomeFront.Data
@using Fx.ControlKit.Notifications
@using Fx.ControlKit.Mdi
@using HomeFront.Components.Pages.Migrated

@using HomeFront.Services
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject NotificationService Notifications
@inject IUserPreferencesService UserPrefs
@inject ILogger<FMain> Logger
@inject DbWrapperSqlServer db
@* Per-circuit security toggles + session state — gate access to the
   MDI shell when EnforceAuth is ON and the user hasn't completed
   login. See memory/homefrontpoc_security_hardening.md (review opt 5). *@
@inject ISecurityOptionsService Sec
@inject ISessionStateService Session
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHost
@* Cookie-backed auth state — cascaded by AddCascadingAuthenticationState
   in Program.cs. AuthStateTask is null only in pre-authentication render
   passes; we treat that as "not authenticated yet" for the gate below. *@
@inject CustomReportRouter Router
@inject IGridLayoutService GridLayoutSvc

<PageTitle>Precision Builder - HomeFront</PageTitle>
<NavigationLock ConfirmExternalNavigation="true"
                OnBeforeInternalNavigation="OnLocationChanging" />

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Precision Builder...</div>
    </div>
}

@* FMain uses bespoke class names (fmain-shell, fmain-shell-content) for
   its outer wrappers because the generic .tabs-container / .tab-content
   names collide with FAssembly's own wrapper classes. *@
<div class="fmain-shell">
    @* The original FMain showed a top .NET / VB6 tab pair so the dev demo
       could switch between the live Blazor port and the legacy VB6
       screenshot. Now that the port is the only relevant view, those
       tabs are gone — the shell always renders the .NET content
       directly. (Related CSS for .tab-buttons in FMain.razor.css is now
       dead but harmless.) *@
    <div class="fmain-shell-content">
            <!-- Menu Bar -->
            <div class="menu-bar">
                <!-- File Menu -->
                <div class="menu-item" @onmouseenter='() => openMenu = "File"' @onmouseleave="CloseMenuDelayed">
                    <span>File</span>
                    @if (openMenu == "File")
                    {
                        <div class="menu-dropdown">
                            <div class="menu-dropdown-item" @onclick="OnMenuSave">💾 Save</div>
                            <div class="menu-separator"></div>
                            <div class="menu-dropdown-item" @onclick="OnMenuChangeDivision">🔄 Change Division</div>
                            <div class="menu-dropdown-item" @onclick="OnMenuClose">❌ Close</div>
                        </div>
                    }
                </div>

                <!-- Tasks Menu -->
                <div class="menu-item" @onmouseenter='() => openMenu = "Tasks"' @onmouseleave="CloseMenuDelayed">
                    <span>Tasks</span>
                    @if (openMenu == "Tasks")
                    {
                        <div class="menu-dropdown">
                            @if (SalesSystemEnabled)
                            {
                                <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Inbox")'>📥 Inbox</div>
                                <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Custom Requests")'>📋 Custom Requests</div>
                            }
                            <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Issue budgets")'>📊 Issue budgets</div>
                            <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Issue POs")'>📝 Issue POs</div>
                            <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Create Manual POs")'>📝 Create Manual POs</div>
                            @if (AccountingConnected)
                            {
                                <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Post budgets")'>📤 Post budgets</div>
                                <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Post purchase orders")'>📤 Post purchase orders</div>
                            }
                            <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Send Purchase Orders")'>✉️ Send Purchase Orders</div>
                            <div class="menu-separator"></div>
                            <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Edit item prices")'>💲 Edit item prices</div>
                            <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Cost Forecasting")'>📈 Cost Forecasting</div>
                        </div>
                    }
                </div>

                <!-- Sales Pricing Menu -->
                <div class="menu-item" @onmouseenter='() => openMenu = "SalesPricing"' @onmouseleave="CloseMenuDelayed">
                    <span>Sales Pricing</span>
                    @if (openMenu == "SalesPricing")
                    {
                        <div class="menu-dropdown">
                            @if (!UseEstimatingWorksheetsOnly && BuilderType != "Commercial")
                            {
                                <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Open a marketing worksheet")'>📄 Open a marketing worksheet</div>
                            }
                            <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Open an estimating worksheet")'>📄 Open an estimating worksheet</div>
                            @if (BuilderType != "Commercial")
                            {
                                <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Open a design center worksheet")'>📄 Open a design center worksheet</div>
                            }
                            <div class="menu-dropdown-item" @onclick='() => RunTaskAsync("Review a published worksheet")'>👁️ Review a published worksheet</div>
                        </div>
                    }
                </div>

                <!-- Setup Menu -->
                <div class="menu-item" @onmouseenter='() => openMenu = "Setup"' @onmouseleave="CloseMenuDelayed">
                    <span>Setup</span>
                    @* VB6 FMain.frm mnuSetup build (~lines 2778-2810): exact item set +
                       order + builder-type / UseCommunityStandards gates. Items that
                       are NOT in VB6's Setup menu (Import/Export Assemblies, Assembly
                       Takeoffs, Option Intersections) were removed for fidelity — they
                       live under other VB6 menus, not Setup. *@
                    @if (openMenu == "Setup")
                    {
                        <div class="menu-dropdown">
                            @* 1. Job Cost Codes → EditJCCostCodes → FDBGrid "Cost Codes" *@
                            <div class="menu-dropdown-item" @onclick='() => RunTaskIfAllowedAsync("Job Cost Codes", "")'><img src="images/16/costcode.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Job Cost Codes</div>
                            @* 2. Job Cost Categories → EditJCCategories → FDBGrid "Categories" *@
                            <div class="menu-dropdown-item" @onclick='() => RunTaskIfAllowedAsync("Job Cost Categories", "")'><img src="images/16/jc.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Job Cost Categories</div>
                            @* 3-5. Rooms / Dimension Categories / Model Dimensions — VB6 gates
                               on BuilderType <> "Commercial" (mnuSetup lines 2781-2785). *@
                            @if (BuilderType != "Commercial")
                            {
                                <div class="menu-dropdown-item @(HasPermission("EditAssemblies") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("Rooms", "EditAssemblies")'><img src="images/16/costcode.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Rooms</div>
                                <div class="menu-dropdown-item @(HasPermission("EditAssemblies") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("Dimension Categories", "EditAssemblies")'><img src="images/16/costcode.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Dimension Categories</div>
                                <div class="menu-dropdown-item @(HasPermission("EditAssemblies") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("Model Dimensions", "EditAssemblies")'><img src="images/16/costcode.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Model Dimensions</div>
                            }
                            @* 6. Option Attributes → EditAttributeLists → FAttributeLists *@
                            <div class="menu-dropdown-item" @onclick='() => RunTaskIfAllowedAsync("Option Attributes", "")'><img src="images/16/costcode.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Option Attributes</div>
                            @* 7. {Community} Setup / Work Region Setup (Commercial) *@
                            @if (BuilderType == "Commercial")
                            {
                                <div class="menu-dropdown-item @(HasPermission("SetupCommunity") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("Work Region Setup", "SetupCommunity")'><img src="images/16/Areas.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Work Region Setup</div>
                            }
                            else
                            {
                                <div class="menu-dropdown-item @(HasPermission("SetupCommunity") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync(CD_Community + " Setup", "SetupCommunity")'><img src="images/16/Areas.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />@CD_Community Setup</div>
                            }
                            @* 8. {Community} Phases Setup → FDBGrid "Community Phases" *@
                            <div class="menu-dropdown-item @(HasPermission("SetupCommunity") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync(CD_Community + " Phases Setup", "SetupCommunity")'><img src="images/16/Areas.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />@CD_Community Phases Setup</div>
                            @* 9. Project Managers *@
                            <div class="menu-dropdown-item @(HasPermission("SetupProjectManager") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("Project Managers", "SetupProjectManager")'><img src="images/16/newworksheet.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Project Managers</div>
                            @* 10. Vendor setup *@
                            <div class="menu-dropdown-item @(HasPermission("SetupVendors") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("Vendor setup", "SetupVendors")'><img src="images/32/vendor.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Vendor setup</div>
                            @* 11. Customer setup *@
                            <div class="menu-dropdown-item @(HasPermission("SetupCustomer") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("Customer setup", "SetupCustomer")'><img src="images/16/customer.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Customer setup</div>
                            @* 12. Job setup (VB6 mnuSetup line 2799) *@
                            <div class="menu-dropdown-item @(HasPermission("SetupJobs") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("Job setup", "SetupJobs")'><img src="images/16/Job.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Job setup</div>
                            @* 13. PO Indexes *@
                            <div class="menu-dropdown-item @(HasPermission("SetupPOIndex") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("PO Indexes", "SetupPOIndex")'><img src="images/16/poindex.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />PO Indexes</div>
                            @* 14. Default Vendors *@
                            <div class="menu-dropdown-item @(HasPermission("SetupDefaultVendor") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("Default Vendors", "SetupDefaultVendor")'><img src="images/32/Vendor1.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Default Vendors</div>
                            @* 15. Edit item database *@
                            <div class="menu-dropdown-item @(HasPermission("EditItemDb") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("Edit item database", "EditItemDb")'><img src="images/16/ItemDb.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Edit item database</div>
                            @* 16. {Community} Standards — VB6 gates on UseCommunityStandards *@
                            @if (UseCommunityStandards)
                            {
                                <div class="menu-dropdown-item" @onclick='() => RunTaskIfAllowedAsync(CD_Community + " Standards", "")'><img src="images/16/standards.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />@CD_Community Standards</div>
                            }
                            @* 17. Edit Assemblies (Commercial) / Edit Models and Options *@
                            @if (BuilderType == "Commercial")
                            {
                                <div class="menu-dropdown-item @(HasPermission("EditAssemblies") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("Edit Assemblies", "EditAssemblies")'><img src="images/16/EditAssembly.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Edit Assemblies</div>
                            }
                            else
                            {
                                <div class="menu-dropdown-item @(HasPermission("EditAssemblies") ? "" : "disabled")" @onclick='() => RunTaskIfAllowedAsync("Edit Models and Options", "EditAssemblies")'><img src="images/16/EditAssembly.ico" style="width:16px;height:16px;margin-right:8px;vertical-align:middle;" />Edit Models and Options</div>
                            }
                        </div>
                    }
                </div>

                <!-- Inquiries Menu -->
                <div class="menu-item" @onmouseenter='() => { openMenu = "Inquiries"; _inquirySubmenu = null; }' @onmouseleave="CloseMenuDelayed">
                    <span>Inquiries</span>
                    @if (openMenu == "Inquiries")
                    {
                        <div class="menu-dropdown">
                            <!-- Built-in inquiry items -->
                            <div class="menu-dropdown-item" @onclick='() => OnBuiltInInquiry("PO Details")'>📄 PO Details</div>
                            <div class="menu-dropdown-item" @onclick='() => OnBuiltInInquiry("PO List")'>📄 PO List</div>
                            @if (InquiryItems.Count > 0)
                            {
                                <div class="menu-separator"></div>
                                @foreach (var item in InquiryItems)
                                {
                                    @if (item.IsFolder)
                                    {
                                        <div class="menu-dropdown-item has-submenu" @onmouseenter="() => _inquirySubmenu = item.FullPath">
                                            📁 @item.DisplayName ▸
                                            @if (_inquirySubmenu == item.FullPath)
                                            {
                                                <div class="menu-submenu">
                                                    @foreach (var child in item.Children)
                                                    {
                                                        <div class="menu-dropdown-item" @onclick="() => OnInquiryClick(child.FullPath)">📄 @child.DisplayName</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="menu-dropdown-item" @onclick="() => OnInquiryClick(item.FullPath)">📄 @item.DisplayName</div>
                                    }
                                }
                            }
                            <div class="menu-separator"></div>
                            <div class="menu-dropdown-item" @onclick='() => OnManageFolder(InquiriesFolder)'>📂 Manage</div>
                        </div>
                    }
                </div>

                <!-- Reports Menu -->
                <div class="menu-item" @onmouseenter='() => { openMenu = "Reports"; _reportSubmenu = null; }' @onmouseleave="CloseMenuDelayed">
                    <span>Reports</span>
                    @if (openMenu == "Reports")
                    {
                        <div class="menu-dropdown">
                            <!-- Built-in report items -->
                            @foreach (var rpt in BuiltInReports)
                            {
                                <div class="menu-dropdown-item" @onclick="() => OnBuiltInReport(rpt)">📊 @rpt</div>
                            }
                            @if (ReportItems.Count > 0)
                            {
                                <div class="menu-separator"></div>
                                @foreach (var item in ReportItems)
                                {
                                    @if (item.IsFolder)
                                    {
                                        <div class="menu-dropdown-item has-submenu" @onmouseenter="() => _reportSubmenu = item.FullPath">
                                            📁 @item.DisplayName ▸
                                            @if (_reportSubmenu == item.FullPath)
                                            {
                                                <div class="menu-submenu">
                                                    @foreach (var child in item.Children)
                                                    {
                                                        <div class="menu-dropdown-item" @onclick="() => OnReportClick(child.FullPath)">
                                                            @(Path.GetExtension(child.FullPath).Equals(".rpt", StringComparison.OrdinalIgnoreCase) ? "📊" : "📄") @child.DisplayName
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="menu-dropdown-item" @onclick="() => OnReportClick(item.FullPath)">
                                            @(Path.GetExtension(item.FullPath).Equals(".rpt", StringComparison.OrdinalIgnoreCase) ? "📊" : "📄") @item.DisplayName
                                        </div>
                                    }
                                }
                            }
                            <div class="menu-separator"></div>
                            <div class="menu-dropdown-item" @onclick='() => OnManageFolder(ReportsFolder)'>📂 Manage</div>
                        </div>
                    }
                </div>

                <!-- Tools Menu -->
                <div class="menu-item" @onmouseenter='() => openMenu = "Tools"' @onmouseleave="CloseMenuDelayed">
                    <span>Tools</span>
                    @if (openMenu == "Tools")
                    {
                        <div class="menu-dropdown">
                            <div class="menu-dropdown-item" @onclick="OnCancelPOWizard">Cancel Purchase Order Wizard</div>
                            <div class="menu-dropdown-item" @onclick="OnMassChangeWizard">Mass Change Wizard</div>
                            <div class="menu-dropdown-item" @onclick="OnDuplicateModelOptions">Duplicate Model Options</div>
                            <div class="menu-dropdown-item" @onclick="OnTBDAssignmentWizard">Assign TBD Purchase Orders</div>
                            <div class="menu-dropdown-item" @onclick="OnWorkReassignment">Work Reassignment Wizard</div>
                            <div class="menu-dropdown-item" @onclick="OnResetDefaultVendors">Reset Default Vendors...</div>
                            <div class="menu-dropdown-item" @onclick="OnDivisionReplicationWizard">Division Replication Wizard</div>
                            <div class="menu-separator"></div>
                            <div class="menu-dropdown-item" @onclick="OnResetGridLayouts">Reset grid layouts to default...</div>
                            <div class="menu-separator"></div>
                            <div class="menu-dropdown-item @(HasPermission("ToolsUsrAdmin") ? "" : "disabled")" @onclick='() => { if (HasPermission("ToolsUsrAdmin")) OnUserPermissions(); }'>User Permissions...</div>
                            <div class="menu-dropdown-item" @onclick="OnAppOptions">System Settings...</div>
                            <div class="menu-separator"></div>
                            <label class="menu-dropdown-item" for="additional-tools-file-picker" @onclick='() => openMenu = ""' style="font-weight: normal; margin: 0;">Additional Tools...</label>
                            <input id="additional-tools-file-picker" type="file" style="display: none;" />
                        </div>
                    }
                </div>

                <!-- Window Menu -->
                <div class="menu-item" @onmouseenter='() => openMenu = "Window"' @onmouseleave="CloseMenuDelayed">
                    <span>Window</span>
                    @* VB6 MDI parity: every open child window appears as a
                       menu item below the Task Panel / Workflow toggles. Each
                       row shows the window's current Title (the child can
                       mutate this via the SetPageTitle cascading delegate —
                       e.g. FAssembly publishes "Assembly – ModelName"), and a
                       ✓ marker calls out the active window. Clicking the row
                       activates that tab. *@
                    @if (openMenu == "Window")
                    {
                        <div class="menu-dropdown">
                            <div class="menu-dropdown-item" @onclick="ToggleTaskPanel">@(CommandPanelVisible ? "Hide" : "Show") Task Panel (F2)</div>
                            <div class="menu-dropdown-item" @onclick="ToggleWorkflow">@(WorkflowVisible && _activePageType == null ? "Hide" : "Show") Workflow (F6)</div>
                            @if (_windows.Count > 0)
                            {
                                <div class="menu-separator"></div>
                                @foreach (var win in _windows)
                                {
                                    var w = win;
                                    var isActive = string.Equals(w.Id, _activeWindowId, StringComparison.Ordinal);
                                    <div class="menu-dropdown-item @(isActive ? "active" : "")"
                                         @onclick="() => OnWindowMenuActivate(w.Id)">
                                        <span style="display:inline-block;width:14px;">@(isActive ? "✓" : "")</span>
                                        @w.Title
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

                <!-- Help Menu -->
                <div class="menu-item" @onmouseenter='() => openMenu = "Help"' @onmouseleave="CloseMenuDelayed">
                    <span>Help</span>
                    @if (openMenu == "Help")
                    {
                        <div class="menu-dropdown">
                            <div class="menu-dropdown-item" @onclick="OnHelpContents">📖 Precision Builder Help</div>
                            <div class="menu-dropdown-item" @onclick="OnHelpSupport">🌐 HomeFront Support</div>
                            <div class="menu-separator"></div>
                            <div class="menu-dropdown-item" @onclick="OnHelpAbout">ℹ️ About HomeFront...</div>
                        </div>
                    }
                </div>

                <!-- Right-aligned Title Bar Information -->
                <div class="menu-title-info">
                    <img src="images/32/precision.ico" style="width:14px;height:14px;margin-right:6px;vertical-align:middle;" />
                    <span>@CaptionText</span>
                </div>
            </div>

            <!-- Main Layout -->
            <div class="main-container">
                <!-- Command Panel (Left Sidebar) -->
                <div class="command-panel @(CommandPanelVisible ? "" : "hidden") @(CommandPanelMinimized ? "collapsed" : "")">
                    <!-- Panel Toolbar -->
                    <div class="panel-toolbar">
                        <button @onclick="CloseCommandPanel" title="Close panel">
                            <img src="_content/FlexKit/images/16/close.ico" alt="Close" />
                        </button>
                        @if (!CommandPanelMinimized)
                        {
                            <button @onclick="ShrinkCommandPanel" title="Minimize">
                                <img src="_content/FlexKit/images/16/Shrink.ico" alt="Minimize" />
                            </button>
                        }
                        else
                        {
                            <button @onclick="ExpandCommandPanel" title="Expand">
                                <img src="_content/FlexKit/images/16/expand.ico" alt="Expand" />
                            </button>
                        }
                    </div>

                    @if (!CommandPanelMinimized)
                    {
                        <!-- Explorer Bar Sections -->
                        <div class="explorer-bar">
                            @foreach (var section in ExplorerSections)
                            {
                                <div class="explorer-section @(section == activeSection ? "active" : "") @(section.IsCollapsed ? "collapsed" : "")">
                                    <div class="explorer-section-header" @onclick="() => ToggleSection(section)">
                                        <span>@(section.Title)</span>
                                    </div>
                                    @if (!section.IsCollapsed)
                                    {
                                        <div class="explorer-section-body">
                                            @foreach (var item in section.Items)
                                            {
                                                <div class="explorer-item @(item.IsBold ? "bold-item" : "") @(item.IsRed ? "red-item" : "") @(item.Disabled ? "disabled" : "")"
                                                     style="@(item.Disabled ? "opacity:0.5;pointer-events:none;cursor:default;" : null)"
                                                     @onclick="() => OnExplorerItemClick(item)">
                                                    <span class="item-icon">@((MarkupString)item.Icon)</span>
                                                    <span>@item.Text</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- MDI Content Area (Phase 1 — tabbed multi-window shell)
                     The single-DynamicComponent slot was replaced by
                     FlexKit's <MdiHost/>: a left-to-right tab strip plus a
                     pane area where every open window stays mounted (only
                     the active one is visible via display:none on inactive
                     panes). This preserves form/grid state across tab
                     switches — closing a tab is the only path that
                     unmounts a child. ParentNavigate still flows through
                     NavigateToPage → OpenOrFocus, which decides whether
                     to focus an existing tab or push a new MdiWindow.
                     Per-window SetPageTitle is handled by MdiHost itself
                     (it provides a per-pane CascadingValue) — the global
                     _setPageTitleAction wrapper is retained for legacy
                     consumers but is no longer needed by child pages. -->
                <CascadingValue Value="@_navigateAction" Name="ParentNavigate">
                <div class="mdi-content">
                    <MdiHost Windows="@_windows"
                             ActiveWindowId="@_activeWindowId"
                             OnActivate="ActivateWindowAsync"
                             OnCloseRequested="HandleCloseRequestAsync"
                             OnHomeRequested="ShowHomeAsync">
                        <HomeTab>
                            @* Home-tab content is rendered by MdiHost into
                               its own .fx-mdi-tab-home wrapper. Inline
                               styles instead of class hooks: Blazor's
                               scoped CSS attaches based on which .razor the
                               markup lives in, but the resulting elements
                               render INSIDE MdiHost — easier to ship the
                               icon look here without round-tripping through
                               FlexKit's stylesheet. *@
                            <span style="font-family: 'Segoe UI Symbol', sans-serif; font-size: 14px; line-height: 1;" aria-hidden="true">⌂</span>
                            <span style="margin-left: 4px;">Home</span>
                        </HomeTab>
                        <EmptyState>
                            @if (WorkflowVisible)
                            {
                                <div class="workflow-host">
                                    <Workflow Embedded="true"
                                              SelectedTabName="@_workflowTab"
                                              OnTabChanged="OnWorkflowTabChanged" />
                                </div>
                            }
