            </div>
        }
        else if (activeTab == 2)
        {
            <div style="text-align: center; padding: 40px; color: #6c757d;">
                <p>VB6 screenshot not available in this build.</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? CurrentJobParam { get; set; }

    // === Database ===
    private DbWrapperSqlServer db = new();

    // === Constants ===
    private const int TASKPANELWIDTH = 280;

    // === UI State ===
    private int activeTab = 1;
    private bool IsLoading = false;
    private string openMenu = "";
    private string StatusMessage = "Ready";
    private string CaptionText = "Precision Builder";

    // === Command Panel State ===
    private bool CommandPanelVisible = true;
    private bool CommandPanelMinimized = false;
    private bool WorkflowVisible = true;

    // === Current Job ===
    private string mCurrentJob = "";
    private string mTimerTask = "";

    // === Custom Descriptions ===
    public string CD_Community { get; set; } = "Community";
    public string CD_Communities { get; set; } = "Communities";
    public string CD_Series { get; set; } = "Series";
    public string CD_SqrFootage { get; set; } = "Square Footage";
    public string CD_Color { get; set; } = "Color";

    // === App Options (simulated) ===
    private string DivisionID = "1";
    private string LoginDSN = "HomeFrontDB";
    private string LoginID = "admin";
    private string BuilderType = "Residential";
    private bool SalesSystemEnabled = true;
    private bool AccountingConnected = false;
    private bool UseEstimatingWorksheetsOnly = false;
    private bool UseCommunityStandards = false;
    private string AppVersion = "1.0.0.1";

    // === Explorer Bar Data ===
    private List<ExplorerSection> ExplorerSections = new();

    // === Timer ===
    private System.Timers.Timer? _refreshTimer;

    // === Properties ===
    public string CurrentJob
    {
        get => mCurrentJob;
        set
        {
            mCurrentJob = value;
            // Would trigger workflow reload
        }
    }

    public string CurrentCustomer
    {
        get
        {
            if (string.IsNullOrEmpty(mCurrentJob)) return "";
            try
            {
                var dt = db.SqlExec("SELECT ar_customer_deposit FROM tblcustomers WHERE job_no=@Job",
                    new { Job = mCurrentJob });
                return dt.Rows.Count > 0 ? dt.Rows[0][0]?.ToString() ?? "" : "";
            }
            catch { return ""; }
        }
    }

    public string CurrentCustomerDesc
    {
        get
        {
            if (string.IsNullOrEmpty(mCurrentJob)) return "";
            try
            {
                var sql = @"SELECT a.description
                            FROM tblcustomers c
                            JOIN arcustomers a ON c.ar_customer_deposit=a.arcustomer
                            WHERE c.job_no=@Job";
                var dt = db.SqlExec(sql, new { Job = mCurrentJob });
                return dt.Rows.Count > 0 ? dt.Rows[0][0]?.ToString() ?? "" : "";
            }
            catch { return ""; }
        }
    }

    public string CurrentJobDesc
    {
        get
        {
            if (string.IsNullOrEmpty(mCurrentJob)) return "";
            try
            {
                var dt = db.SqlExec("SELECT description FROM tbljobs WHERE DivisionID=@DivisionID AND job_no=@Job",
                    new { DivisionID, Job = mCurrentJob });
                return dt.Rows.Count > 0 ? dt.Rows[0][0]?.ToString() ?? "" : "";
            }
            catch { return ""; }
        }
    }

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            if (!string.IsNullOrEmpty(CurrentJobParam))
                mCurrentJob = CurrentJobParam;

            await LoadCustomDescriptions();
            UpdateCaption();
            await LoadInterface();
            StartRefreshTimer();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FMain.OnInitializedAsync] Error: {ex.Message}");
            StatusMessage = $"Error during initialization: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void UpdateCaption()
    {
        var caption = $"Precision Builder ({LoginDSN.Trim()}, Login User: {LoginID.Trim()}) - version {AppVersion}";
        if (!string.IsNullOrEmpty(DivisionID))
        {
            try
            {
                var dt = db.SqlExec("SELECT DivisionCode FROM Divisions WHERE DivisionID=@DivisionID",
                    new { DivisionID });
                if (dt.Rows.Count > 0)
                    caption += $" Division: {dt.Rows[0][0]}";
            }
            catch { }
        }
        CaptionText = caption;
    }

    // === Load Custom Descriptions ===
    private async Task LoadCustomDescriptions()
    {
        CD_Community = await GetCustomDesc("Community");
        CD_Communities = await GetCustomDesc("Community", true);
        CD_SqrFootage = await GetCustomDesc("Square Footage");
        CD_Series = await GetCustomDesc("Series");
        CD_Color = await GetCustomDesc("Color");
    }

    private async Task<string> GetCustomDesc(string item, bool plural = false)
    {
        try
        {
            var col = plural ? "custom_description_plural" : "custom_description";
            var dt = db.SqlExec(
                $"SELECT ISNULL(NULLIF({col},''),@DefaultVal) FROM customdescriptions WHERE item=@Item",
                new { DefaultVal = item, Item = item });
            return dt.Rows.Count > 0 ? dt.Rows[0][0]?.ToString() ?? item : item;
        }
        catch
        {
            return item;
        }
    }

    // === Load Interface (Explorer Bar) ===
    private async Task LoadInterface()
    {
        ExplorerSections.Clear();

        // Purchasing Tasks
        var purchasingSection = new ExplorerSection { Title = "Purchasing Tasks", IsCollapsed = false };

        if (SalesSystemEnabled)
        {
            var inboxCount = await GetInboxCount();
            if (inboxCount == 0)
                purchasingSection.Items.Add(new ExplorerItem { Text = "Inbox (empty)", Icon = "📁", TaskName = "Inbox" });
            else
