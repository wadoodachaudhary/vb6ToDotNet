    private async Task OnMenuChangeDivision()
    {
        openMenu = "";

        if (_windows.Count > 0)
        {
            if (_mdiCloseMessageBox != null)
            {
                var result = await _mdiCloseMessageBox.ShowAsync(
                    "There are open windows.\n\nAll open windows must be closed before changing divisions. Would you like to close all opened windows and proceed?",
                    title: "Change Division",
                    buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNo,
                    icon: "warning");

                if (result != Fx.ControlKit.Dialogs.MessageBoxResult.Yes)
                {
                    return;
                }
            }

            // Close all windows directly to ensure they are fully closed
            _windows.Clear();
            _activeWindowId = null;
            _lastRoute = "";
            SaveUIState();
            await InvokeAsync(StateHasChanged);
        }

        // VB6: FPickList.Choose(dbHomefront, "Select Division", sql, HFApp.DivisionID, True, False, , "DivisionID")
        var sql = "SELECT d.DivisionID, d.DivisionCode, d.DivisionName FROM Divisions d " +
                  "LEFT OUTER JOIN DivisionUsers u ON u.DivisionID = d.DivisionID " +
                  $"WHERE u.UserID = '{LoginID.Replace("'", "''")}' OR u.UserID IS NULL " +
                  "ORDER BY d.DivisionCode";
        if (_divisionPickList != null)
        {
            await _divisionPickList.Open(
                title: "Division",
                queries: sql,
                hideColumns: "DivisionID",
                defaultItem: DivisionID,
                sortAsc: true,
                dialogCaption: "Select Division");
        }
    }

