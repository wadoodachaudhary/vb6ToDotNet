    private void ToggleWorkflow()
    {
        openMenu = "";
        if (_activeWindowId != null)
        {
            // A tab is active — switch to home so Workflow becomes visible
            // again. Keep the other tabs open in the background; clicking
            // any of them resumes that tab. (Pre-MDI this nulled the single
            // slot; the previous draft cleared _windows which destroyed all
            // child state — clearly wrong for MDI.)
            _activeWindowId = null;
            _lastRoute = "";
            WorkflowVisible = true;
        }
        else
        {
            // Already on home — toggle Workflow visibility (workflow panel
            // vs. welcome message).
            WorkflowVisible = !WorkflowVisible;
        }
        SaveUIState();
    }

    // === Cleanup ===
    public async ValueTask DisposeAsync()
    {
        await FlushPendingGridLayoutsAsync(notify: false);
        _refreshTimer?.Stop();
        _refreshTimer?.Dispose();
        try
        {
            if (_navigationGuardModule != null)
            {
                await _navigationGuardModule.InvokeVoidAsync("disableNativeLeaveWarning");
                await _navigationGuardModule.DisposeAsync();
            }
        }
        catch
        {
            // Ignore if JS interop is no longer available during disposal
        }
    }

