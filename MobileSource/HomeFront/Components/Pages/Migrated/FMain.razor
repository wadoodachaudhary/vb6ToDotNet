    /// <summary>
    /// Opens a child page inline within FMain's content area instead of navigating away.
    /// Parses route parameters from the URL path segments.
    /// Pass "" or "/" to close the active page and return to the home screen.
    /// </summary>
    private void NavigateToPage(string route)
    {
        if (route == "/main") return;

        // Empty route or "/" = close active window, return to workflow/welcome
        if (string.IsNullOrEmpty(route) || route == "/")
        {
            CloseActivePage();
            return;
        }

        OpenOrFocus(route);
    }

    // ──────────────────────────────────────────────────────────────────────
    // MDI Phase 1 — open/focus/close
    // ──────────────────────────────────────────────────────────────────────

    /// <summary>Open a child window for <paramref name="route"/>, or focus
    /// an existing window matching it. Replaces the old single-slot
    /// NavigateToPage semantics: instead of swapping <c>_activePageType</c>
    /// in place, we maintain a list of <see cref="MdiWindow"/>s and toggle
    /// which one is visible.
    ///
    /// Dedup rules:
    ///   - Singleton routes (per <see cref="_singletonRoutes"/>) re-focus an
    ///     existing tab regardless of parameters. There's only ever one
    ///     "About" or "Pricelist" tab.
    ///   - Multi-instance editor routes (FAssembly, FJob, …) dedup on the
    ///     FULL route string. Opening "/assembly/12/3" twice focuses the
    ///     existing tab; opening "/assembly/14/9" pushes a new one.
    ///     (Going by VB6 evidence — <c>Set f = New FAssembly</c> always
    ///     spawned a fresh form — but URL-based dedup is gentler than
    ///     spawning duplicate windows showing the same data drifting out
    ///     of sync.)
    /// </summary>
    private void OpenOrFocus(string route)
    {
        var path = route.Split('?', 2)[0];

        // Try exact match in the route registry first.
        if (_routeMap.TryGetValue(path, out var pageType))
        {
            OpenOrFocusInternal(route, path, pageType, new Dictionary<string, object>());
            return;
        }

        // Progressive prefix match for parameterized routes — same algorithm
        // as the pre-MDI code, only the "what to do with the resolved type"
        // is different (push a window instead of mutating a single slot).
        var segments = path.TrimStart('/').Split('/');
        if (segments.Length >= 2)
        {
            for (int i = segments.Length - 1; i >= 1; i--)
            {
                var basePath = "/" + string.Join("/", segments.Take(i));
                if (_routeMap.TryGetValue(basePath, out var paramPageType))
                {
                    var parameters = new Dictionary<string, object>();
                    var remainingSegments = segments.Skip(i).ToArray();
                    if (remainingSegments.Length >= 1)
                        parameters[InferParameterName(basePath, 0)] = remainingSegments[0];
                    if (remainingSegments.Length >= 2)
                        parameters[InferParameterName(basePath, 1)] = remainingSegments[1];
                    OpenOrFocusInternal(route, basePath, paramPageType, parameters);
                    return;
                }
            }
        }

        // Fallback: route not in registry → external full navigation.
        NavigationManager.NavigateTo(route);
    }

    private void OpenOrFocusInternal(string route, string basePath, Type pageType, Dictionary<string, object> parameters)
    {
        var isSingleton = _singletonRoutes.Contains(basePath);
        var isAlwaysFresh = _alwaysFreshRoutes.Contains(basePath);

        // ── In-place update of the active tab ──────────────────────────
        // If the active window is already showing this PageType, the call
        // is a "publish state" from inside that tab (e.g. FAssembly's
        // SyncAssemblyRouteState pushes /assembly?community=X&model=Y after
        // the user picks a model from the picklist). Pre-MDI this hit the
        // `if (_activePageType == pageType) { _lastRoute = route; return; }`
        // early-out and stayed in the single slot. We preserve that by
        // updating only the active window's Route/Parameters in place — no
        // new tab, no @key churn, no child re-mount, so the child keeps the
        // grid/form state it just established. WITHOUT this branch every
        // state publish spawned a second tab and the picklist re-prompted.
        //
        // EXCEPT for routes in _alwaysFreshRoutes (Crystal report viewer,
        // DB-grid lookup, inquiry runner): each pick is conceptually a new
        // window — VB6 did `Set f = New FRptViewer`. Skipping the in-place
        // branch routes them through the dedup-or-spawn path so existing
        // tabs are re-focused and brand-new routes get a fresh tab.
        var active = ActiveWindow;
        if (active != null && active.PageType == pageType && !isAlwaysFresh)
        {
            active.Route = route;
            if (parameters.Count > 0)
            {
                active.Parameters.Clear();
                foreach (var kvp in parameters) active.Parameters[kvp.Key] = kvp.Value;
            }
            _lastRoute = route;
            SaveUIState();
            StateHasChanged();
            return;
        }

        // ── Otherwise dedup against existing tabs ──────────────────────
        // Singletons: one tab per PageType, period. Multi-instance: dedup
        // on the full route string (so "/assembly/12/3" and "/assembly/12/4"
        // are distinct tabs but re-opening "/assembly/12/3" focuses the
        // existing tab rather than spawning a duplicate).
        var existing = isSingleton
            ? _windows.FirstOrDefault(w => w.PageType == pageType)
            : _windows.FirstOrDefault(w => string.Equals(w.Route, route, StringComparison.OrdinalIgnoreCase));

        if (existing != null)
        {
            _activeWindowId = existing.Id;
            _lastRoute = route;
            SaveUIState();
            StateHasChanged();
            return;
        }

        var window = new MdiWindow(
            id: Guid.NewGuid().ToString("N"),
            route: route,
            pageType: pageType,
            parameters: parameters,
            title: PrettyTitleForRoute(basePath, pageType),
            isSingleton: isSingleton);
        _windows.Add(window);
        _activeWindowId = window.Id;
        _lastRoute = route;
        SaveUIState();
        StateHasChanged();
    }

    /// <summary>Best-effort initial tab caption — child pages typically
    /// override this via the SetPageTitle cascading delegate once they
    /// load their data. Falls back to the .NET class name (e.g. "FAssembly")
    /// when no friendlier label is wired here.</summary>
    private static string PrettyTitleForRoute(string basePath, Type pageType)
    {
        return basePath switch
        {
            "/assembly"           => "Assembly",
            "/job"                => "Job",
            "/pricing-worksheet"  => "Pricing Worksheet",
            "/estimate-items"     => "Estimate Items",
            "/purchase-order"     => "Purchase Order",
            "/pricelist"          => "Pricelist",
            "/vendor-pricelist"   => "Vendor Pricelist",
            "/communities"        => "Communities",
            "/about"              => "About",
            "/options"            => "Options",
            "/cost-forecast"      => "Cost Forecast",
            "/report-viewer"      => "Report Viewer",
            _ => pageType.Name,
        };
    }

    private Task ActivateWindowAsync(string id)
    {
        if (string.Equals(_activeWindowId, id, StringComparison.Ordinal))
            return Task.CompletedTask;
        _activeWindowId = id;
        _lastRoute = _windows.FirstOrDefault(w => w.Id == id)?.Route ?? "";
        SaveUIState();
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Activate a window from the Window menu listing. Closes the menu first
    /// so the dropdown doesn't linger after the user picks a target window,
    /// then defers to ActivateWindowAsync for the actual focus change.
    /// </summary>
    private async Task OnWindowMenuActivate(string id)
    {
        openMenu = "";
        await ActivateWindowAsync(id);
    }

    /// <summary>Switch to the home (workflow/welcome) view WITHOUT closing
    /// any open tabs. Bound to MdiHost's leftmost ⌂ Home tab via
    /// <c>OnHomeRequested</c>. Setting <c>_activeWindowId</c> to null makes
    /// MdiHost render its EmptyState (our Workflow / welcome content); the
    /// background tabs are untouched and the user can click any of them to
    /// resume.</summary>
    private Task ShowHomeAsync()
    {
        if (_activeWindowId == null) return Task.CompletedTask;
        _activeWindowId = null;
        _lastRoute = "";
        // Re-show the workflow content by default — if the user previously
        // toggled it off, leave that choice alone so they don't have to
        // re-hide it after every visit to home.
        SaveUIState();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleCloseRequestAsync(string id)
    {
        var idx = _windows.FindIndex(w => w.Id == id);
        if (idx < 0) return;

        var window = _windows[idx];
        if (!await CanCloseWindowAsync(window))
            return;

        await FlushPendingGridLayoutsAsync(notify: false);

        _windows.RemoveAt(idx);

        // HHM-621: VB6 re-reads user_manager on every UserPermission call, so
        // an admin's edits apply immediately. The web caches the bits per
        // circuit — refresh them when the User Permissions window closes so
        // menu gating picks up changes without a re-login.
        if (window.Route.StartsWith("/user-permissions", StringComparison.OrdinalIgnoreCase))
            await LoadUserPermissions();

        if (string.Equals(_activeWindowId, id, StringComparison.Ordinal))
        {
            if (_windows.Count == 0)
            {
                _activeWindowId = null;
                _lastRoute = "";
            }
            else
            {
                var nextIdx = Math.Min(idx, _windows.Count - 1);
                _activeWindowId = _windows[nextIdx].Id;
                _lastRoute = _windows[nextIdx].Route;
            }
        }
        SaveUIState();
        StateHasChanged();
    }

    private async Task<bool> CanCloseWindowAsync(MdiWindow window, bool isApplicationClosing = false)
    {
        var component = window.ComponentInstance;
        if (component == null)
            return true;

        var componentType = component.GetType();
        var promptAwareSaveMethod = FindPromptAwareSaveMethod(componentType);
        var parameterlessSaveMethod = FindParameterlessSaveMethod(componentType);
        var dirtyKnown = TryReadDirtyFlag(component, out var isDirty);
        var hasExplicitGuard = component is IMdiCloseGuard;
        var hasConventionalGuard = promptAwareSaveMethod != null
            || (dirtyKnown && isDirty);

        if (!hasExplicitGuard && !hasConventionalGuard)
            return true;

        // If the user closes an inactive tab, activate it first. Child pages
        // render their MessageBoxControl inside their own pane; hidden panes
        // cannot show an understandable save/cancel prompt.
        if (!string.Equals(_activeWindowId, window.Id, StringComparison.Ordinal))
        {
            _activeWindowId = window.Id;
            _lastRoute = window.Route;
            SaveUIState();
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
        }

        try
        {
            if (component is IMdiCloseGuard guard)
            {
                return await guard.CanCloseMdiWindowAsync(new MdiCloseContext
                {
                    WindowId = window.Id,
                    Route = window.Route,
                    Title = window.Title,
                    IsApplicationClosing = isApplicationClosing
                });
            }

            return await CanCloseByConventionAsync(component, promptAwareSaveMethod, parameterlessSaveMethod, dirtyKnown, isDirty);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "MDI close guard failed for {WindowTitle} ({Route})", window.Title, window.Route);
            Notifications.Error("Unable to close window", ex.Message);
            return false;
        }
    }

    private bool WindowHasUnsavedChanges(MdiWindow window)
    {
        var component = window.ComponentInstance;
        if (component == null)
            return false;

        if (TryReadDirtyFlag(component, out var dirty))
            return dirty;

        return component is IMdiCloseGuard;
    }

    private async Task<bool> CanLeaveMdiShellAsync()
    {
        foreach (var window in _windows.ToList())
        {
            if (!WindowHasUnsavedChanges(window))
                continue;

            if (!await CanCloseWindowAsync(window, isApplicationClosing: true))
                return false;
        }

        await FlushPendingGridLayoutsAsync(notify: false);
        return true;
    }

    private async Task<bool> ConfirmLeavingApplicationAsync()
    {
        const string message = "Leaving this page will close the application.\n\nDo you want to continue?";

        if (_mdiCloseMessageBox != null)
        {
            var result = await _mdiCloseMessageBox.ShowAsync(
                message,
                title: "Close Application",
                buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNo,
                icon: "warning");
            return result == Fx.ControlKit.Dialogs.MessageBoxResult.Yes;
        }

        return await JSRuntime.InvokeAsync<bool>("confirm", message);
    }

    private async Task<bool> CanCloseByConventionAsync(
        object component,
        MethodInfo? promptAwareSaveMethod,
        MethodInfo? parameterlessSaveMethod,
        bool dirtyKnown,
        bool isDirty)
    {
        if (dirtyKnown)
        {
            if (!isDirty)
                return true;

            return await ConfirmDirtyCloseAndSaveAsync(component, promptAwareSaveMethod, parameterlessSaveMethod);
        }

        if (promptAwareSaveMethod != null)
            return await InvokeSaveMethodAsync(component, promptAwareSaveMethod, BuildPromptArguments(promptAwareSaveMethod, prompt: true));

        return true;
    }

    private async Task<bool> ConfirmDirtyCloseAndSaveAsync(
        object component,
        MethodInfo? promptAwareSaveMethod,
        MethodInfo? parameterlessSaveMethod)
    {
        var result = _mdiCloseMessageBox != null
            ? await _mdiCloseMessageBox.ShowAsync(
                "This data has changed.\n\nDo you want to save these changes?",
                title: "Save changes?",
                buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel)
            : (await JSRuntime.InvokeAsync<bool>("confirm",
                    "This data has changed.\n\nDo you want to save these changes?")
                ? Fx.ControlKit.Dialogs.MessageBoxResult.Yes
                : Fx.ControlKit.Dialogs.MessageBoxResult.No);

        if (result == Fx.ControlKit.Dialogs.MessageBoxResult.Cancel)
            return false;

        if (result == Fx.ControlKit.Dialogs.MessageBoxResult.No)
            return true;

        if (promptAwareSaveMethod != null)
            return await InvokeSaveMethodAsync(component, promptAwareSaveMethod, BuildPromptArguments(promptAwareSaveMethod, prompt: false));

        if (parameterlessSaveMethod != null)
            return await InvokeSaveMethodAsync(component, parameterlessSaveMethod, Array.Empty<object?>());

        Notifications.Error("Unable to save changes before close", "This form does not expose a SaveData method.");
        return false;
    }

    private static MethodInfo? FindPromptAwareSaveMethod(Type componentType)
    {
        return componentType
            .GetMethods(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)
            .Where(m => string.Equals(m.Name, "SaveData", StringComparison.Ordinal)
                || string.Equals(m.Name, "SaveDataAsync", StringComparison.Ordinal))
            .Where(IsPromptAwareSaveMethod)
            .OrderBy(m => string.Equals(m.Name, "SaveData", StringComparison.Ordinal) ? 0 : 1)
            .ThenBy(m => m.GetParameters().Length)
            .FirstOrDefault();
    }

    private static bool IsPromptAwareSaveMethod(MethodInfo method)
    {
        if (!HasBooleanSaveReturn(method.ReturnType))
            return false;

        var parameters = method.GetParameters();
        return parameters.Length > 0
            && parameters[0].ParameterType == typeof(bool)
            && parameters.Skip(1).All(p => p.IsOptional || p.HasDefaultValue);
    }

    private static MethodInfo? FindParameterlessSaveMethod(Type componentType)
    {
        return componentType
            .GetMethods(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)
            .Where(m => string.Equals(m.Name, "SaveData", StringComparison.Ordinal)
                || string.Equals(m.Name, "SaveDataAsync", StringComparison.Ordinal))
            .Where(m => m.GetParameters().Length == 0 && HasSaveReturn(m.ReturnType))
            .OrderBy(m => string.Equals(m.Name, "SaveData", StringComparison.Ordinal) ? 0 : 1)
            .FirstOrDefault();
    }

    private static bool HasBooleanSaveReturn(Type returnType)
        => returnType == typeof(bool)
            || returnType == typeof(Task<bool>)
            || returnType == typeof(ValueTask<bool>);

    private static bool HasSaveReturn(Type returnType)
        => returnType == typeof(void)
            || returnType == typeof(Task)
            || returnType == typeof(ValueTask)
            || HasBooleanSaveReturn(returnType);

    private static object?[] BuildPromptArguments(MethodInfo method, bool prompt)
    {
        var parameters = method.GetParameters();
        var args = new object?[parameters.Length];
        for (var i = 0; i < parameters.Length; i++)
        {
            args[i] = i == 0
                ? prompt
                : (parameters[i].HasDefaultValue ? parameters[i].DefaultValue : Type.Missing);
        }
        return args;
    }

    private static async Task<bool> InvokeSaveMethodAsync(object component, MethodInfo method, object?[] args)
    {
        object? result;
        try
        {
            result = method.Invoke(component, args);
        }
        catch (TargetInvocationException ex) when (ex.InnerException != null)
        {
            throw ex.InnerException;
        }

        return result switch
        {
            null => true,
            bool b => b,
            Task<bool> taskBool => await taskBool,
            ValueTask<bool> valueTaskBool => await valueTaskBool,
            Task task => await AwaitTaskAndReturnTrue(task),
            ValueTask valueTask => await AwaitValueTaskAndReturnTrue(valueTask),
            _ => true
        };
    }

    private static async Task<bool> AwaitTaskAndReturnTrue(Task task)
    {
        await task;
        return true;
    }

    private static async Task<bool> AwaitValueTaskAndReturnTrue(ValueTask task)
    {
        await task;
        return true;
    }

    private static bool TryReadDirtyFlag(object component, out bool dirty)
    {
        var type = component.GetType();
        var flags = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.IgnoreCase;

        foreach (var name in CloseDirtyMemberNames)
        {
            var property = type.GetProperty(name, flags);
            if (property != null && property.GetIndexParameters().Length == 0)
            {
                try
                {
                    if (TryCoerceDirtyValue(property.GetValue(component), out dirty))
                        return true;
                }
                catch
                {
                    // Ignore computed properties that are not safe to read during close.
                }
            }

            var field = type.GetField(name, flags);
            if (field != null && TryCoerceDirtyValue(field.GetValue(component), out dirty))
                return true;
        }

        dirty = false;
        return false;
    }

    private static bool TryCoerceDirtyValue(object? value, out bool dirty)
    {
        switch (value)
        {
            case null:
                dirty = false;
                return true;
            case bool b:
                dirty = b;
                return true;
            case Enum e:
                var name = e.ToString();
                dirty = Convert.ToInt64(e) != 0
                    && !string.Equals(name, "None", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(name, "Clean", StringComparison.OrdinalIgnoreCase);
                return true;
            case byte or short or int or long or sbyte or ushort or uint or ulong:
                dirty = Convert.ToInt64(value) != 0;
                return true;
            default:
                dirty = false;
                return false;
        }
    }

    /// <summary>
    /// Infers parameter names for parameterized routes based on known conventions.
    /// </summary>
    private static string InferParameterName(string basePath, int paramIndex)
    {
        return basePath switch
        {
            "/estimate-items" => paramIndex == 0 ? "Mode" : "Job",
            "/job-setup" => "JobNumber",
            "/customer" => "CustomerId",
            "/edit-model-assembly" => "Id",
            "/contacts" => "Job",
            "/rfis" => "Job",
            "/wbs-codes" => "Job",
            "/job-correspondence" => "Job",
            "/variable" => "Name",
            "/quote" => "QuoteNumber",
            "/report-viewer" => "ReportFile",
            "/po-inquiry" => "PONumber",
            "/item-chart" => "ChartName",
            "/db-grid" => "FormCaption",
            "/data-import" => paramIndex == 0 ? "TableName" : "Title",
            "/assembly-import-export" => "Mode",
            "/documents" => paramIndex == 0 ? "ObjectId" : "ObjectDescription",
            "/takeoff-settings" => "Job",
            "/create-hb-invoice" => "Job",
            "/create-invoice" => paramIndex == 0 ? "Job" : "Invoice",
            "/inquiry" => "FileName",
            "/po-price-change-wizard" => "PONumber",
            "/option-list-multi-select" => "Job",
            // MDI path-param arms — each route's {token} must map to the target form's
            // [Parameter] name, else the default below passes "Id" and the circuit crashes at
            // render ("no property matching the name 'Id'"). FSendingWizard→DocType,
            // FReportDesigner→ReportFile, FPricingWorkSheet→WorksheetIdParam (the latter
            // self-publishes /pricing-worksheet/{WorksheetIdParam} as a deep-link).
            // (/pricing-worksheet-opus needs no arm — it has no path-param route, only ?ViewMode=.)
            "/po-sending-wizard" => "DocType",
            "/report-designer" => "ReportFile",
            "/pricing-worksheet" => "WorksheetIdParam",
            _ => paramIndex == 0 ? "Id" : $"Param{paramIndex + 1}"
        };
    }

    /// <summary>
    /// Closes the active child window and returns to the workflow/welcome
    /// view. Under MDI this is "close the active tab" — sibling tabs remain
    /// open. The empty state (no tabs left) is what triggers Workflow /
    /// welcome to render again via MdiHost's <c>EmptyState</c> render
    /// fragment.
    /// </summary>
    private void CloseActivePage()
    {
        var id = _activeWindowId;
        if (id == null) return;
        // Reuse the standard close-request path so dirty-check and
        // grid-layout flushing stay in one place.
        _ = InvokeAsync(() => HandleCloseRequestAsync(id));
    }

    private async Task CloseActivePageAsync()
    {
        if (_activeWindowId == null)
        {
            await FlushPendingGridLayoutsAsync(notify: false);
            return;
        }
        await HandleCloseRequestAsync(_activeWindowId);
    }

    private async Task FlushPendingGridLayoutsAsync(bool notify)
    {
        if (!GridLayoutSvc.HasPendingGridLayoutChanges)
        {
            if (notify)
                Notifications.Info("No pending grid layout changes.");
            return;
        }

        try
        {
            await GridLayoutSvc.FlushPendingGridLayoutsAsync();
            if (notify)
                Notifications.Info("Grid layout changes saved.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save pending grid layout changes");
            if (notify)
                Notifications.Error("Unable to save grid layout changes", ex.Message);
        }
    }

    // === UI State Persistence ===
    // Saves/restores the FMain shell state (task panel, workflow tab, last page)
    // so the user returns to the same view after login.

    private const string INI_SECTION = "FMain";

    private bool _hasSavedUIState;

    private void LoadUIState()
    {
        try
        {
            // Check if any UI state was previously saved (empty means first-ever run)
            _hasSavedUIState = UserPrefs.Get(INI_SECTION, "WorkflowVisible") != "";

            CommandPanelVisible = UserPrefs.GetBool(INI_SECTION, "TaskPanelVisible");
            CommandPanelMinimized = UserPrefs.GetBool(INI_SECTION, "TaskPanelMinimized");
            WorkflowVisible = UserPrefs.GetBool(INI_SECTION, "WorkflowVisible");
            _workflowTab = UserPrefs.Get(INI_SECTION, "WorkflowTab", "Estimating");
            _lastRoute = UserPrefs.Get(INI_SECTION, "LastRoute");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load UI state");
        }
    }

    private void SaveUIState()
    {
        try
        {
            UserPrefs.PutBool(INI_SECTION, "TaskPanelVisible", CommandPanelVisible);
            UserPrefs.PutBool(INI_SECTION, "TaskPanelMinimized", CommandPanelMinimized);
            UserPrefs.PutBool(INI_SECTION, "WorkflowVisible", WorkflowVisible);
            UserPrefs.Put(INI_SECTION, "WorkflowTab", _workflowTab);
            UserPrefs.Put(INI_SECTION, "LastRoute", _lastRoute);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save UI state");
        }
    }

    /// <summary>
    /// Restores the last active page from saved state (called once after init).
    /// If the saved route no longer maps to a live page (e.g. the page was
    /// renamed, removed, or moved out of the routing table) the value is
    /// cleared so the user sees the home screen on next login instead of a
    /// blank pane stuck on the dead URL.
    /// </summary>
    private void RestoreLastPage()
    {
        if (!string.IsNullOrEmpty(_lastRoute))
        {
            if (IsKnownRoute(_lastRoute))
            {
                NavigateToPage(_lastRoute);
                return;
            }

            // Stale saved route — wipe it so we don't keep nagging on every
            // login. (Diagnostic logged so we can spot retired URLs in the field.)
            Logger.LogInformation(
                "FMain: clearing stale LastRoute '{Route}' — no matching page in routing table.",
                _lastRoute);
            _lastRoute = "";
            SaveUIState();
        }

        if (!_hasSavedUIState && !WorkflowVisible && !CommandPanelVisible)
        {
            // First-ever run with no saved state: default to showing workflow
            WorkflowVisible = true;
        }
        // Otherwise respect the saved state — home screen can be empty
    }

    /// <summary>
    /// Mirrors the lookup logic in <see cref="NavigateToPage"/> just enough
    /// to decide whether a saved route is still resolvable: exact match in
    /// _routeMap, or a known base-path prefix (e.g. /vendor/123 → /vendor).
    /// Any unknown root segment (the deleted /vendor-pricelist-opus is an
    /// example) returns false and triggers cleanup.
    /// </summary>
    private bool IsKnownRoute(string route)
    {
        if (string.IsNullOrEmpty(route) || route == "/" || route == "/main")
            return true;   // home / default — handled gracefully by NavigateToPage

        var path = route.Split('?', 2)[0];

        if (_routeMap.ContainsKey(path)) return true;

        // Try the same progressive prefix match NavigateToPage uses for
        // parameterized routes (/vendor/123 → /vendor base path).
        var segments = path.TrimStart('/').Split('/');
        for (int i = segments.Length - 1; i >= 1; i--)
        {
            var basePath = "/" + string.Join("/", segments.Take(i));
            if (_routeMap.ContainsKey(basePath)) return true;
        }
        return false;
    }

    private void OnWorkflowTabChanged(string tabName)
    {
        _workflowTab = tabName;
        SaveUIState();
    }

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        // Review opt 5 — gate access to the MDI shell. When EnforceAuth
        // is ON, require an authenticated cookie principal (issued by
        // /auth/signin after FLogin validates credentials). The cookie
        // survives across tabs / refresh / browser-close, so anyone
        // typing /main directly into a fresh browser without a valid
        // cookie is bounced to /login. When EnforceAuth is OFF (today's
        // default), the check is a no-op and anyone with a /main URL
        // can render the shell, preserving dev convenience.
        // Done before any DB / DI work so the redirect happens early
        // and we don't waste a round trip on someone who'll just be
        // sent back to login anyway. forceLoad: true on the redirect
        // ensures the next request reads the missing-cookie state
        // properly rather than re-entering this same circuit.
        if (Sec.EnforceAuth)
        {
            bool isAuthed = false;
            if (AuthStateTask is not null)
            {
                var authState = await AuthStateTask;
                isAuthed = authState.User?.Identity?.IsAuthenticated == true;
            }
            if (!isAuthed)
            {
                NavigationManager.NavigateTo("/login", forceLoad: true, replace: true);
                return;
            }
        }

        // The /auth/signin redirect (forceLoad) starts a BRAND-NEW circuit,
        // so the scoped ISessionStateService here is fresh — FLogin's
        // Session.DivisionID / LoginID writes died with the login circuit.
        // The auth cookie is the only thing that crosses that boundary, so
        // seed the session from its claims exactly once per circuit
        // (LoginID empty = never seeded; a mid-circuit division switch via
        // the File menu keeps LoginID set, so it is never clobbered).
        // Without this every login landed on the session default
        // DivisionID=1 regardless of the division picked at login.
        if (string.IsNullOrEmpty(Session.LoginID) && AuthStateTask is not null)
        {
            var principal = (await AuthStateTask).User;
            if (principal?.Identity?.IsAuthenticated == true)
            {
                Session.LoginID = principal.Identity.Name ?? "";
                if (int.TryParse(principal.FindFirst("DivisionId")?.Value, out var claimDiv) && claimDiv > 0)
                    Session.DivisionID = claimDiv;
                var dbName = principal.FindFirst("DatabaseName")?.Value;
                if (!string.IsNullOrEmpty(dbName))
                    Session.DatabaseName = dbName;
                Session.IsAuthenticated = true;
            }
        }

        _navigateAction = (route) => NavigateToPage(route);
        // Under MDI, SetPageTitle is provided per-pane by FlexKit's MdiHost
        // (a separate CascadingValue per window, capturing the right
        // MdiWindow instance so each child mutates ITS own tab's title).
        // This legacy global action is kept as a safety net for any code
        // path that still resolves the FMain-scoped cascade — it forwards
        // to the active window so the visible tab updates as expected.
        _setPageTitleAction = (title) =>
        {
            var active = ActiveWindow;
            if (active == null) return;
            if (string.Equals(active.Title, title ?? "", StringComparison.Ordinal)) return;
            active.Title = title ?? "";
            InvokeAsync(StateHasChanged);
        };

        IsLoading = true;
        StateHasChanged();

        try
        {
            // Seed the caption's user id from the session — the local default
            // ("admin") only shows when the session was never seeded
            // (EnforceAuth off + no cookie).
            if (!string.IsNullOrEmpty(Session.LoginID))
                LoginID = Session.LoginID;

            await LoadUserPermissions();

            if (!string.IsNullOrEmpty(CurrentJobParam))
                mCurrentJob = CurrentJobParam;

            // Restore saved UI state (task panel, workflow tab, last page)
            LoadUIState();

            await LoadCustomDescriptions();
            UpdateCaption();
            LoadDynamicMenus();
            await LoadInterface();
            StartRefreshTimer();

            // Re-open the last active page or show workflow/welcome
            RestoreLastPage();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FMain initialization failed");
            StatusMessage = $"Error during initialization: {ex.Message}";
            Notifications.Error("Initialization failed", ex.Message);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _navigationGuardModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/fmain-navigation-guard.js");
            await _navigationGuardModule.InvokeVoidAsync("enableNativeLeaveWarning");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to register FMain browser navigation guard.");
        }
    }

    private async Task OnLocationChanging(LocationChangingContext context)
    {
        if (_navigationExitPromptSuppressed)
        {
            _navigationExitPromptSuppressed = false;
            return;
        }

        // Convert absolute target URI to a relative path
        var targetUri = context.TargetLocation;
        var baseUri = NavigationManager.BaseUri;

        string relativePath;
        if (targetUri.StartsWith(baseUri, StringComparison.OrdinalIgnoreCase))
        {
            relativePath = "/" + targetUri.Substring(baseUri.Length).TrimStart('/');
        }
        else
        {
            // External URL — let it through
            return;
        }

        // Extract path without query string for route matching
        var parts = relativePath.Split('?', 2);
        var path = parts[0];

        if (CanRenderInline(path))
        {
            context.PreventNavigation();
            await FlushPendingGridLayoutsAsync(notify: false);
            NavigateToPage(relativePath);
            return;
        }

        context.PreventNavigation();
        if (!await ConfirmLeavingApplicationAsync())
            return;

        if (HasUnsavedMdiChanges && !await CanLeaveMdiShellAsync())
            return;

        _navigationExitPromptSuppressed = true;
        NavigationManager.NavigateTo(context.TargetLocation);
    }

    /// <summary>
    /// Returns true if the given path matches a route in _routeMap
    /// (either exact or as a prefix for parameterized routes).
    /// </summary>
    private bool CanRenderInline(string path)
    {
        // Exact match
        if (_routeMap.ContainsKey(path)) return true;

        // Prefix match for parameterized routes (e.g. /vendor/123 → /vendor)
        var segments = path.TrimStart('/').Split('/');
        for (int i = segments.Length - 1; i >= 1; i--)
        {
            var basePath = "/" + string.Join("/", segments.Take(i));
            if (_routeMap.ContainsKey(basePath)) return true;
        }

        return false;
    }

    private void UpdateCaption()
    {
        var caption = $"Precision Builder ({LoginDSN.Trim()}, Login User: {LoginID.Trim()}) - version {AppVersion}";
        if (!string.IsNullOrEmpty(DivisionID))
        {
            try
            {
                var dt = db.SqlExec("SELECT DivisionCode FROM Divisions WHERE DivisionID=@DivisionID",
                    new { DivisionID });
                if (dt.Rows.Count > 0)
                    caption += $" Division: {dt.Rows[0][0]}";
            }
            catch { }
        }
        CaptionText = caption;
    }

    // === Load Custom Descriptions ===
    private async Task LoadCustomDescriptions()
    {
        CD_Community = await GetCustomDesc("Community");
        CD_Communities = await GetCustomDesc("Community", true);
        CD_SqrFootage = await GetCustomDesc("Square Footage");
        CD_Series = await GetCustomDesc("Series");
        CD_Color = await GetCustomDesc("Color");
    }

    // VB6 parity: FJob.frm GetCustomDesc(ItemName, Optional Plural=False).
    // The customdescriptions table has ONE relevant column — `custom_description`.
    // There is no `custom_description_plural`; the migration that named one was
    // a fiction (it threw on every SQL Server that hadn't been hand-patched).
    // Pluralization is a string transform on the singular result, not a
    // separate column lookup:
    //   ends-in "s" → leave alone     ("Series"      → "Series")
    //   ends-in "y" → strip y + "ies" ("Community"   → "Communities")
    //   else        → append "s"      ("Color"       → "Colors")
    private async Task<string> GetCustomDesc(string item, bool plural = false)
    {
        try
        {
            var dt = db.SqlExec(
                "SELECT ISNULL(NULLIF(custom_description,''),@DefaultVal) FROM customdescriptions WHERE item=@Item",
                new { DefaultVal = item, Item = item });
            var singular = dt.Rows.Count > 0 ? dt.Rows[0][0]?.ToString() ?? item : item;
            if (!plural || string.IsNullOrEmpty(singular)) return singular;
            return singular[^1] switch
            {
                's' or 'S' => singular,
                'y' or 'Y' => singular[..^1] + "ies",
                _          => singular + "s",
            };
        }
        catch
        {
            return item;
        }
    }

    // === Resource Folder Paths ===
    /// <summary>
    /// Root for deployed resources (SQL inquiries, Crystal Reports, templates, PO formats).
    /// Previously came from the Windows registry / {SystemFolder}; now served from wwwroot/resources.
    /// Reports are split into two sibling folders:
    ///   - <c>Reports/rpt/*.rpt</c>  — original Crystal Reports binary definitions (legacy)
    ///   - <c>Reports/xml/*.xml</c>  — Crystal Reports XML exports (used by ReportWriterControl)
    /// </summary>
    private string ResourcesRoot => Path.Combine(WebHost.WebRootPath ?? "wwwroot", "resources");
    private string InquiriesFolder => Path.Combine(ResourcesRoot, "Estimating", "Inquiries");
    private string ReportsFolder => Path.Combine(ResourcesRoot, "Estimating", "Reports", "rpt");
    private string ReportsXmlFolder => Path.Combine(ResourcesRoot, "Estimating", "Reports", "xml");

    // === User Permissions & Gating ===
    private HashSet<string> _userPermissions = new(StringComparer.OrdinalIgnoreCase);
    private long _userAccessType = 6;

    private bool HasPermission(string? permission)
    {
        if (string.IsNullOrEmpty(permission))
            return true;

        // HHM-621: VB6 Application.cls UserPermission ALWAYS enforces the
        // user_manager permission bits — security-group restrictions apply to
        // every logged-in user no matter how the app was deployed. An
        // unseeded LoginID may only grant everything while the auth gate is
        // OFF (dev convenience: /main opened directly with no login this
        // circuit); with EnforceAuth on, an empty LoginID means the cookie
        // principal failed to seed and permissions must FAIL CLOSED, or a
        // restricted user could see every menu enabled.
        if (string.IsNullOrEmpty(Session.LoginID))
            return !Sec.EnforceAuth;

        return permission switch
        {
            "AdminUser" => _userAccessType == 1,
            "SalesManagerUser" => _userAccessType == 2,
            "AccountingUser" => _userAccessType == 3,
            "SalesPersonUser" => _userAccessType == 4,
            "DCSalesPersonUser" => _userAccessType == 5,
            "ReadOnlyUser" => _userAccessType == 6,
            "EstimatingUser" => _userAccessType == 7,
            _ => _userPermissions.Contains(permission.ToUpperInvariant())
        };
    }

    private async Task LoadUserPermissions()
    {
        _userPermissions.Clear();
        _userAccessType = 6;
        if (string.IsNullOrEmpty(Session.LoginID))
            return;

        try
        {
            var dt = db.SqlExec(
                "SELECT * FROM user_manager WHERE user_id=@LoginID",
                new { LoginID = Session.LoginID });

            if (dt.Rows.Count > 0)
            {
                var row = dt.Rows[0];
                foreach (DataColumn col in dt.Columns)
                {
                    if (col.DataType == typeof(bool) && row[col] is bool b && b)
                    {
                        _userPermissions.Add(col.ColumnName.ToUpperInvariant());
                    }
                    else if (col.DataType == typeof(int) && row[col] is int i && i == 1)
                    {
                        _userPermissions.Add(col.ColumnName.ToUpperInvariant());
                    }
                    else if (col.DataType == typeof(short) && row[col] is short s && s == 1)
                    {
                        _userPermissions.Add(col.ColumnName.ToUpperInvariant());
                    }
                    else if (col.DataType == typeof(long) && row[col] is long l && l == 1)
                    {
                        _userPermissions.Add(col.ColumnName.ToUpperInvariant());
                    }
                }

                var secGroupIdVal = row["SecGroupID"];
                if (secGroupIdVal is not DBNull && secGroupIdVal != null)
                {
                    var secGroupId = Convert.ToInt64(secGroupIdVal);
                    var dtGroup = db.SqlExec(
                        "SELECT User_Access FROM securitygroups WHERE SecGroupID=@SecGroupID",
                        new { SecGroupID = secGroupId });
                    if (dtGroup.Rows.Count > 0)
                    {
                        var groupRow = dtGroup.Rows[0];
                        if (groupRow["User_Access"] is not DBNull && groupRow["User_Access"] != null)
                        {
                            _userAccessType = Convert.ToInt64(groupRow["User_Access"]);
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load user permissions for menu gating");
        }
    }

    private async Task RunTaskIfAllowedAsync(string taskName, string permissionName)
    {
        if (HasPermission(permissionName))
        {
            await RunTaskAsync(taskName);
        }
    }

    // === Load Dynamic Menus (Inquiries & Reports) ===
    /// <summary>
    /// Scans wwwroot/resources/Estimating/Inquiries and wwwroot/resources/Estimating/Reports
    /// for SQL inquiry files and Crystal Report (.rpt) files, replicating the VB6 dynamic
    /// menu population from FMain.PopMenu_Click.
    /// </summary>
    private void LoadDynamicMenus()
    {
        try
        {
            InquiryItems = ScanMenuFolder(InquiriesFolder);
            ReportItems = ScanMenuFolder(ReportsFolder);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load dynamic inquiry/report menus");
        }
    }

    /// <summary>Recursively scans a folder for files and subfolders, building menu items.</summary>
    private List<MenuFileItem> ScanMenuFolder(string folder)
    {
        var items = new List<MenuFileItem>();
        if (!Directory.Exists(folder)) return items;

        // The Reports menu rolls up `BuiltInReports` (curated names) FIRST and then
        // appends file-scanned items. Filter out anything already in BuiltInReports
        // so the same report doesn't appear twice. Comparison is on the file's
        // base name (no extension), case-insensitive.
        var isReportsScan = string.Equals(folder, ReportsFolder, StringComparison.OrdinalIgnoreCase);
        var builtInSet = isReportsScan
            ? new HashSet<string>(BuiltInReports, StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        // Subfolders first (become submenus)
        foreach (var dir in Directory.GetDirectories(folder).OrderBy(d => d))
        {
            var dirName = Path.GetFileName(dir);
            if (dirName is "." or ".." or "msdir") continue;
            var children = ScanMenuFolder(dir);
            if (children.Count > 0)
            {
                items.Add(new MenuFileItem
                {
                    DisplayName = dirName,
                    FullPath = dir,
                    IsFolder = true,
                    Children = children
                });
            }
        }

        // Then files. For the Reports folder, only include `.rpt` files — xml
        // exports and other companion files live alongside but shouldn't show
        // in the menu. Inquiry folders accept anything (SQL files etc.).
        foreach (var file in Directory.GetFiles(folder).OrderBy(f => f))
        {
            var ext = Path.GetExtension(file);
            if (isReportsScan && !string.Equals(ext, ".rpt", StringComparison.OrdinalIgnoreCase))
                continue;

            var displayName = Path.GetFileNameWithoutExtension(file);
            if (builtInSet.Contains(displayName)) continue;

            items.Add(new MenuFileItem
            {
                DisplayName = displayName,
                FullPath = file,
                IsFolder = false
            });
        }

        return items;
    }

    private void OnInquiryClick(string filePath)
    {
        NavigateToPage($"/inquiry/{Uri.EscapeDataString(filePath)}");
    }

    /// <summary>Handles built-in inquiry items (PO Details, PO List) that may exist as SQL files in the Inquiries folder.</summary>
    private void OnBuiltInInquiry(string inquiryName)
    {
        // Try common file extensions for inquiry SQL files
        string[] extensions = { ".sql", ".txt", "" };
        foreach (var ext in extensions)
        {
            var path = Path.Combine(InquiriesFolder, inquiryName + ext);
            if (File.Exists(path))
            {
                NavigateToPage($"/inquiry/{Uri.EscapeDataString(path)}");
                return;
            }
        }
        // If no file found, navigate with the name and let FInquiry handle the error
        var fallbackPath = Path.Combine(InquiriesFolder, inquiryName + ".sql");
        NavigateToPage($"/inquiry/{Uri.EscapeDataString(fallbackPath)}");
    }

    private void OnReportClick(string filePath)
    {
        // Reports that have a custom parameter / drill-down implementation
        // (XML-driven picklist screens, or legacy hand-coded screens like
        // Global Option Costs) get intercepted before falling back to the
        // generic Crystal Reports viewer. We feed the router both the
        // report name AND the corresponding XML path so its XML-driven
        // dispatch can peek at <PickListSql> annotations.
        var fileName = Path.GetFileNameWithoutExtension(filePath);
        var xmlPath = Path.Combine(ReportsXmlFolder, fileName + ".xml");
        if (Router.TryGetCustomReportRoute(fileName, xmlPath, out var customRoute))
        {
            NavigateToPage(customRoute);
            return;
        }

        if (Path.GetExtension(filePath).Equals(".rpt", StringComparison.OrdinalIgnoreCase))
        {
            NavigateToPage($"/report-viewer/{Uri.EscapeDataString(filePath)}");
        }
        else
        {
            // Non-.rpt files: open as inquiry (SQL file) or let the system handle it
            NavigateToPage($"/inquiry/{Uri.EscapeDataString(filePath)}");
        }
    }

    /// <summary>Handles built-in report items. Resolves the report name to a .rpt file in wwwroot/resources/Estimating/Reports.</summary>
    private void OnBuiltInReport(string reportName)
    {
        // Allow specific built-in reports to take over with their own
        // Blazor-native parameter screen + drill-down view, instead of
        // dropping into the generic Crystal Reports viewer. Pass the
        // computed XML path so XML-annotated reports (PickListSql) get
        // dispatched to the generic dual-list-box screen automatically.
        var xmlPath = Path.Combine(ReportsXmlFolder, reportName + ".xml");
        if (Router.TryGetCustomReportRoute(reportName, xmlPath, out var customRoute))
        {
            NavigateToPage(customRoute);
            return;
        }

        var primaryPath = Path.Combine(ReportsFolder, reportName + ".rpt");
        if (File.Exists(primaryPath))
        {
            NavigateToPage($"/report-viewer/{Uri.EscapeDataString(primaryPath)}");
            return;
        }
        // Fallback: navigate with the primary path and let FRptViewer surface the error
        NavigateToPage($"/report-viewer/{Uri.EscapeDataString(primaryPath)}");
    }

