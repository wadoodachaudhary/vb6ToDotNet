    // === Timer for Auto-Refresh ===
    private void StartRefreshTimer()
    {
        _refreshTimer = new System.Timers.Timer(30000);
        _refreshTimer.Elapsed += async (s, e) => await OnTimerElapsed();
        _refreshTimer.AutoReset = true;
        _refreshTimer.Start();
    }

    private async Task OnTimerElapsed()
    {
        try
        {
            // Update inbox/custom request counts
            var inboxCount = await GetInboxCount();
            var customCount = await GetCustomRequestCount();
            var tbdCount = await GetTBDCount();

            await InvokeAsync(() =>
            {
                // Update explorer items
                if (ExplorerSections.Count > 0)
                {
                    var purchasingSection = ExplorerSections[0];
                    foreach (var item in purchasingSection.Items)
                    {
                        if (item.TaskName == "Inbox")
                        {
                            item.Text = inboxCount == 0 ? "Inbox (empty)" : $"Inbox ({inboxCount})";
                            item.IsBold = true;
                            item.IsRed = false;
                        }
                        else if (item.TaskName == "Custom Requests")
                        {
                            item.Text = customCount == 0 ? "Custom Requests" : $"Custom Requests ({customCount})";
                            item.IsBold = true;
                            item.IsRed = false;
                        }
                        else if (item.TaskName == "TBD Assignments")
                        {
                            item.Text = tbdCount == 0 ? "TBD Assignments (none)" : $"TBD Assignments ({tbdCount})";
                            item.IsBold = tbdCount > 0;
                            item.IsRed = tbdCount > 0;
                        }
                    }
                }

                // Handle timer task
                if (!string.IsNullOrEmpty(mTimerTask) && mTimerTask.StartsWith("EditAttachments"))
                {
                    // Would call HFApp.RunTask(mTimerTask)
                    mTimerTask = "";
                }

                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Timer refresh error");
        }
    }

    // === Run Task ===
    public async Task RunTaskAsync(string taskName)
    {
        openMenu = "";
        StatusMessage = $"Running: {taskName}...";
        StateHasChanged();

        try
        {
            switch (taskName)
            {
                // ── Purchasing / Inbox ──────────────────────────────────────
                // VB6: FInboxJobs.Show vbModal, Me
                case "Inbox":
                case "ReadFromWeb":
                case "Retrieve Jobs from Sales Center":
                    NavigateToPage("/inbox-jobs");
                    break;

                // VB6: FInboxCustomQuote.Show vbModal, Me
                case "Custom Requests":
                    NavigateToPage("/inbox-custom-quote");
                    break;

                // VB6: FInboxTBDAssignments.Show vbModal, Me
                case "TBD Assignments":
                    NavigateToPage("/inbox-tbd-assignments");
                    break;

                // ── Estimating ──────────────────────────────────────────────
                // VB6: FEstimateItems.ShowForm fceBudget, FMain.CurrentJob
                case "Issue budgets":
                    NavigateToPage($"/estimate-items/Budget/{mCurrentJob}");
                    break;

                // VB6: FEstimateItems.ShowForm fcePO, FMain.CurrentJob
                case "Issue POs":
                    NavigateToPage($"/estimate-items/PO/{mCurrentJob}");
                    break;

                // VB6: FPurchaseOrder.ShowForm fcePO, FMain.CurrentJob
                case "Create Manual POs":
                case "Create Manual PO's":
                    NavigateToPage("/purchase-order");
                    break;

                // VB6: FEstimateItems.ShowForm fceQuote, ""
                case "Prepare Job Quote":
                    NavigateToPage("/estimate-items/Quote");
                    break;

                // VB6: FEstimateItems.ShowForm fceBids, FMain.CurrentJob
                case "Bids":
                    NavigateToPage($"/estimate-items/Bids/{mCurrentJob}");
                    break;

                // VB6: FEstimateItems.ShowForm fceContract, FMain.CurrentJob
                case "Contracts":
                    NavigateToPage($"/estimate-items/Contract/{mCurrentJob}");
                    break;

                // VB6: FEstimateItems.ShowForm fceBilling, FMain.CurrentJob
                case "Billing":
                    NavigateToPage($"/estimate-items/Billing/{mCurrentJob}");
                    break;

                // ── Setup ───────────────────────────────────────────────────
                // VB6: HFApp.RunTask("EditProjectManagerList")
                case "Project Managers":
                    NavigateToPage("/project-managers");
                    break;

                // VB6: HFApp.RunTask("EditCommunities")
                case var s when s == $"{CD_Community} Setup" || s == "Community Setup" || s == "Work Region Setup":
                    NavigateToPage("/communities");
                    break;

                // VB6: HFApp.RunTask("EditJob|" & FMain.CurrentJob)
                case "Job setup":
                    NavigateToPage($"/job-setup/{mCurrentJob}");
                    break;

                // VB6: HFApp.RunTask("EditVendor")
                case "Vendor setup":
                    NavigateToPage("/vendor");
                    break;

                // "Vendor Price List" handled later alongside the Tasks-menu
                // "Edit item prices" alias — see the consolidated block below.

                // VB6: HFApp.RunTask("EditCustomer|" & FMain.CurrentCustomer)
                case "Customer setup":
                    NavigateToPage("/customer");
                    break;

                // VB6: HFApp.RunTask("EditPOIndexes")
                case "Purchase Orders":
                case "PO Indexes":
                    NavigateToPage("/po-formats");
                    break;

                // VB6: HFApp.RunTask("EditDefaultVendors")
                case "Default Vendors":
                    NavigateToPage("/default-vendor");
                    break;

                // ── Item / Assembly Editing ──────────────────────────────────
                // VB6: fItems.Show vbModal → FItems (the canonical /items-db route;
                // the legacy "/items-db-opus" token is dead — FItemsOpus was removed).
                case "Edit item database":
                    NavigateToPage("/items-db");
                    break;

                // VB6: FAssembly.ShowForm False
                case "Edit Models and Options":
                case "Edit models and options":
                case "Edit Assemblies":
                    NavigateToPage("/edit-model-assembly");
                    break;

                // VB6: FIntersection.Show
                case "Option Intersections":
                    NavigateToPage("/option-intersections");
                    break;

                // VB6: FCommunityStandards.Show vbModal
                case var s2 when s2 == $"{CD_Community} Standards":
                    NavigateToPage("/community-standards");
                    break;

                // VB6: FMassChange.ShowForm
                case "Library Mass Change":
                    NavigateToPage("/mass-change-wizard");
                    break;

                // ── Pricing ─────────────────────────────────────────────────
                // VB6: FPriceList.Show. Routes to the canonical /vendor-pricelist
                // page (the Opus variant was retired — see FMain.razor:659).
                // Aliases cover Tasks-menu "Edit item prices" / "Edit Item"
                // and Setup-menu "Vendor Price List" / "Vendor Pricelist" /
                // legacy "VendorPriceList" task names.
                case "Edit item prices":
                case "Edit Item":
