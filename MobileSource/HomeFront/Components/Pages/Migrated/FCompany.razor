@namespace HomeFront.Components.Pages
@rendermode InteractiveServer

@using HomeFront.Data
@using Fx.ControlKit.Notifications
@inject IJSRuntime JSRuntime
@inject ILogger<FCompany> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer db

<DialogControl Visible="IsVisible"
               Header="Company"
               Width="540px"
               IsModal="false"
               CloseOnEscape="true"
               CssClass="company-dialog"
               VisibleChanged="OnDialogVisibleChanged">
    <ChildContent>
        <div class="company-field-row">
            <label>Company Name</label>
            <TextBoxControl @bind-Value="CompanyName" @onfocus="@(() => SelectAll("CompanyName"))" />
        </div>
        <div class="company-field-row">
            <label>Address</label>
            <TextBoxControl Multiline="true" Rows="2" MaxLength="102" @bind-Value="Address" @onfocus="@(() => SelectAll("Address"))" />
        </div>
        <div class="company-field-row">
            <label>City/Prov</label>
            <div class="company-cityprov">
                <TextBoxControl MaxLength="50" @bind-Value="City" @onfocus="@(() => SelectAll("City"))" CssClass="company-city" />
                <DropDownListControl TValue="string" TItem="string"
                                     DataSource="ProvinceListWithBlank"
                                     @bind-Value="Province"
                                     Width="110px"
                                     CssClass="company-prov" />
            </div>
        </div>
        <div class="company-field-row">
            <label>Postal Code</label>
            <TextBoxControl MaxLength="7" @bind-Value="PostalCode" @onfocus="@(() => SelectAll("PostalCode"))" style="max-width: 140px;" />
        </div>
        <div class="company-field-row">
            <label>Country</label>
            <DropDownListControl TValue="string" TItem="string"
                                 DataSource="CountryListWithBlank"
                                 Value="Country"
                                 ValueChanged="OnCountrySelected"
                                 Width="120px"
                                 CssClass="company-country" />
        </div>
        <div class="company-field-row">
            <label>County</label>
            <TextBoxControl MaxLength="50" @bind-Value="County" @onfocus="@(() => SelectAll("County"))" />
        </div>
        <div class="company-field-row">
            <label>Email</label>
            <TextBoxControl MaxLength="50" @bind-Value="Email" @onfocus="@(() => SelectAll("Email"))" />
        </div>
        <div class="company-field-row">
            <label>Phone</label>
            <TextBoxControl MaxLength="30" @bind-Value="Phone" @onfocus="@(() => SelectAll("Phone"))"
                            @onblur="@(() => Phone = FormatPhone(Phone))" style="max-width: 180px;" />
        </div>
        <div class="company-field-row">
            <label>Fax</label>
            <TextBoxControl MaxLength="30" @bind-Value="Fax" @onfocus="@(() => SelectAll("Fax"))"
                            @onblur="@(() => Fax = FormatPhone(Fax))" style="max-width: 180px;" />
        </div>
        <div class="company-field-row">
            <label>Tax Number</label>
            <TextBoxControl MaxLength="20" @bind-Value="TaxNumber" @onfocus="@(() => SelectAll("TaxNumber"))" style="max-width: 160px;" />
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="btn-primary" OnClick="OnOk">OK</ButtonControl>
        <ButtonControl OnClick="OnCancel">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    // === Parameters ===
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<CompanyData> OnSave { get; set; }

    // === Database ===
// === Form Fields ===
    private string CompanyName { get; set; } = "";
    private string Address { get; set; } = "";
    private string City { get; set; } = "";
    private string Province { get; set; } = "";
    private string PostalCode { get; set; } = "";
    private string Country { get; set; } = "";
    private string County { get; set; } = "";
    private string Email { get; set; } = "";
    private string Phone { get; set; } = "";
    private string Fax { get; set; } = "";
    private string TaxNumber { get; set; } = "";

    // === Lookup Lists ===
    private List<string> CountryList { get; set; } = new();
    private List<string> ProvinceList { get; set; } = new();

    // DropDownListControl data sources include a leading blank entry so the user
    // can re-select the empty "--" choice (mirrors the old <option value="">--</option>).
    private List<string> CountryListWithBlank => PrependBlank(CountryList);
    private List<string> ProvinceListWithBlank => PrependBlank(ProvinceList);

    private static List<string> PrependBlank(List<string> source)
    {
        var list = new List<string>(source.Count + 1) { "" };
        list.AddRange(source);
        return list;
    }

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        await LoadCountries();
    }

    // === Public Methods ===

    /// <summary>
    /// Shows the form and populates fields from the provided CompanyData.
    /// After the dialog is closed via OK, the OnSave callback fires with updated data.
    /// </summary>
    public async Task ShowForm(CompanyData data)
    {
        CompanyName = data.Company ?? "";
        Address = CombineAddress(data.Address1, data.Address2);
        City = data.City ?? "";
        PostalCode = data.Postal ?? "";
        County = data.County ?? "";
        Phone = data.Phone ?? "";
        Fax = data.Fax ?? "";
        TaxNumber = data.TaxNumber ?? "";
        Email = data.Email ?? "";

        await LoadCountries();

        Country = data.Country ?? "";
        await LoadProvinces(Country);
        Province = data.Province ?? "";

        IsVisible = true;
        await IsVisibleChanged.InvokeAsync(true);
        StateHasChanged();
    }

    // === Data Loading ===
    private async Task LoadCountries()
    {
        try
        {
            var rows = await db.QueryAsync(
                "SELECT DISTINCT country FROM countrycodes ORDER BY 1");
            CountryList = rows
                .Select(r => r["country"]?.ToString() ?? "")
                .Where(c => !string.IsNullOrEmpty(c))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadCountries error");

        }
    }

    private async Task LoadProvinces(string country)
    {
        ProvinceList.Clear();
        if (string.IsNullOrWhiteSpace(country)) return;
        try
        {
            var rows = await db.QueryAsync(
                "SELECT DISTINCT state FROM countrycodes WHERE country = @Country ORDER BY 1",
                new { Country = country });
            ProvinceList = rows
                .Select(r => r["state"]?.ToString() ?? "")
                .Where(s => !string.IsNullOrEmpty(s))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadProvinces error");

        }
    }

    // === Event Handlers ===
    // DropDownListControl has no @bind:after; this adapter sets Country then runs
    // the original after-binding logic (OnCountryChanged).
    private async Task OnCountrySelected(string? value)
    {
        Country = value ?? "";
        await OnCountryChanged();
    }

    private async Task OnCountryChanged()
    {
        Province = "";
        await LoadProvinces(Country);
    }

    private async Task OnOk()
    {
        var addressLines = ParseAddress(Address);
        var result = new CompanyData
        {
            Company = CompanyName,
            Address1 = addressLines.Line1,
            Address2 = addressLines.Line2,
            City = City,
            Province = Province,
            Postal = PostalCode,
            Country = Country,
            County = County,
            Phone = Phone,
            Fax = Fax,
            TaxNumber = TaxNumber,
            Email = Email
        };

        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnSave.InvokeAsync(result);
    }

    private async Task OnCancel()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    // DialogControl raises VisibleChanged(false) on Escape (CloseOnEscape) or the ×
    // close icon — both map to the original Cancel behavior.
    private async Task OnDialogVisibleChanged(bool visible)
    {
        if (!visible)
        {
            await OnCancel();
        }
    }

    private async Task SelectAll(string fieldName)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.activeElement?.select?.()");
        }
        catch
        {
            // ignore if element doesn't support select
        }
    }

    // === Helpers ===
    private string CombineAddress(string? line1, string? line2)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(line1)) parts.Add(line1.Trim());
        if (!string.IsNullOrWhiteSpace(line2)) parts.Add(line2.Trim());
        return string.Join("\n", parts);
    }

    private (string Line1, string Line2) ParseAddress(string? address)
    {
        if (string.IsNullOrWhiteSpace(address))
            return ("", "");

        var lines = address.Split(new[] { "\r\n", "\n", "\r" }, 2, StringSplitOptions.None);
        var line1 = lines.Length > 0 ? lines[0].Trim() : "";
        var line2 = lines.Length > 1 ? lines[1].Trim() : "";
        return (line1, line2);
    }

    private string FormatPhone(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return "";

        // Strip non-digit characters
        var digits = new string(phone.Where(char.IsDigit).ToArray());

        if (digits.Length == 10)
            return $"({digits[..3]}) {digits[3..6]}-{digits[6..]}";
        if (digits.Length == 11 && digits[0] == '1')
            return $"1 ({digits[1..4]}) {digits[4..7]}-{digits[7..]}";
        if (digits.Length == 7)
            return $"{digits[..3]}-{digits[3..]}";

        return phone.Trim();
    }

    // === Data Model ===
    public class CompanyData
    {
        public string Company { get; set; } = "";
        public string Address1 { get; set; } = "";
        public string Address2 { get; set; } = "";
        public string City { get; set; } = "";
        public string Province { get; set; } = "";
        public string Postal { get; set; } = "";
        public string Country { get; set; } = "";
        public string County { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Fax { get; set; } = "";
        public string TaxNumber { get; set; } = "";
        public string Email { get; set; } = "";
    }
}
