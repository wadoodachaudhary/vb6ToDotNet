```razor
@namespace HomeFront.Components.Pages
@rendermode InteractiveServer

@using HomeFront.Data
@inject IJSRuntime JSRuntime

<style>
    .company-dialog-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .company-dialog {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
        width: 540px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .company-dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        font-weight: 600;
        font-size: 16px;
        border-bottom: 1px solid #dee2e6;
        background: #f8f9fa;
    }

    .company-dialog-header button {
        background: none;
        border: none;
        font-size: 22px;
        cursor: pointer;
        color: #6c757d;
        padding: 0 4px;
    }

    .company-dialog-header button:hover {
        color: #212529;
    }

    .company-dialog-body {
        padding: 20px;
        overflow-y: auto;
        flex: 1;
    }

    .company-field-row {
        display: flex;
        align-items: flex-start;
        margin-bottom: 10px;
    }

    .company-field-row label {
        min-width: 120px;
        text-align: right;
        padding-right: 12px;
        padding-top: 6px;
        font-size: 13px;
        font-weight: 500;
        color: #495057;
    }

    .company-field-row input,
    .company-field-row textarea,
    .company-field-row select {
        flex: 1;
        padding: 5px 10px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 13px;
    }

    .company-field-row input:focus,
    .company-field-row textarea:focus,
    .company-field-row select:focus {
        border-color: #86b7fe;
        outline: 0;
        box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.15);
    }

    .company-dialog-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 12px 20px;
        border-top: 1px solid #dee2e6;
        background: #f8f9fa;
    }

    .company-dialog-footer .btn {
        padding: 6px 20px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 14px;
    }

    .company-dialog-footer .btn:hover {
        background: #e9ecef;
    }

    .company-dialog-footer .btn-primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }

    .company-dialog-footer .btn-primary:hover {
        background: #0b5ed7;
    }
</style>

@if (IsVisible)
{
    <div class="company-dialog-overlay" @onkeydown="OnKeyDown" tabindex="0">
        <div class="company-dialog" @onclick:stopPropagation="true">
            <div class="company-dialog-header">
                <span>Company</span>
                <button @onclick="OnCancel">×</button>
            </div>
            <div class="company-dialog-body">
                <div class="company-field-row">
                    <label>Company Name</label>
                    <input type="text" @bind="CompanyName" @onfocus="@(() => SelectAll("CompanyName"))" />
                </div>
                <div class="company-field-row">
                    <label>Address</label>
                    <textarea rows="2" maxlength="102" @bind="Address" @onfocus="@(() => SelectAll("Address"))"></textarea>
                </div>
                <div class="company-field-row">
                    <label>City/Prov</label>
                    <div style="display: flex; gap: 6px; flex: 1;">
                        <input type="text" maxlength="50" @bind="City" @onfocus="@(() => SelectAll("City"))" style="flex: 3;" />
                        <select @bind="Province" style="flex: 1;">
                            <option value="">--</option>
                            @foreach (var prov in ProvinceList)
                            {
                                <option value="@prov">@prov</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="company-field-row">
                    <label>Postal Code</label>
                    <input type="text" maxlength="7" @bind="PostalCode" @onfocus="@(() => SelectAll("PostalCode"))" style="max-width: 140px;" />
                </div>
                <div class="company-field-row">
                    <label>Country</label>
                    <select @bind="Country" @bind:after="OnCountryChanged" style="max-width: 120px;">
                        <option value="">--</option>
                        @foreach (var c in CountryList)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="company-field-row">
                    <label>County</label>
                    <input type="text" maxlength="50" @bind="County" @onfocus="@(() => SelectAll("County"))" />
                </div>
                <div class="company-field-row">
                    <label>Email</label>
                    <input type="text" maxlength="50" @bind="Email" @onfocus="@(() => SelectAll("Email"))" />
                </div>
                <div class="company-field-row">
                    <label>Phone</label>
                    <input type="text" maxlength="30" @bind="Phone" @onfocus="@(() => SelectAll("Phone"))"
                           @onblur="@(() => Phone = FormatPhone(Phone))" style="max-width: 180px;" />
                </div>
                <div class="company-field-row">
                    <label>Fax</label>
                    <input type="text" maxlength="30" @bind="Fax" @onfocus="@(() => SelectAll("Fax"))"
                           @onblur="@(() => Fax = FormatPhone(Fax))" style="max-width: 180px;" />
                </div>
                <div class="company-field-row">
                    <label>Tax Number</label>
                    <input type="text" maxlength="20" @bind="TaxNumber" @onfocus="@(() => SelectAll("TaxNumber"))" style="max-width: 160px;" />
                </div>
            </div>
            <div class="company-dialog-footer">
                <button class="btn btn-primary" @onclick="OnOk">OK</button>
                <button class="btn" @onclick="OnCancel">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    // === Parameters ===
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<CompanyData> OnSave { get; set; }

    // === Database ===
    private DbWrapperSqlServer db = new();

    // === Form Fields ===
    private string CompanyName { get; set; } = "";
    private string Address { get; set; } = "";
    private string City { get; set; } = "";
    private string Province { get; set; } = "";
    private string PostalCode { get; set; } = "";
    private string Country { get; set; } = "";
    private string County { get; set; } = "";
    private string Email { get; set; } = "";
    private string Phone { get; set; } = "";
    private string Fax { get; set; } = "";
    private string TaxNumber { get; set; } = "";

    // === Lookup Lists ===
    private List<string> CountryList { get; set; } = new();
    private List<string> ProvinceList { get; set; } = new();

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        await LoadCountries();
    }

    // === Public Methods ===

    /// <summary>
    /// Shows the form and populates fields from the provided CompanyData.
    /// After the dialog is closed via OK, the OnSave callback fires with updated data.
    /// </summary>
    public async Task ShowForm(CompanyData data)
    {
        CompanyName = data.Company ?? "";
        Address = CombineAddress(data.Address1, data.Address2);
        City = data.City ?? "";
        PostalCode = data.Postal ?? "";
        County = data.County ?? "";
        Phone = data.Phone ?? "";
        Fax = data.Fax ?? "";
        TaxNumber = data.TaxNumber ?? "";
        Email = data.Email ?? "";

        await LoadCountries();

        Country = data.Country ?? "";
        await LoadProvinces(Country);
        Province = data.Province ?? "";

        IsVisible = true;
        await IsVisibleChanged.InvokeAsync(true);
        StateHasChanged();
    }

    // === Data Loading ===
    private async Task LoadCountries()
    {
        try
        {
            var rows = await db.QueryAsync(
                "SELECT DISTINCT country FROM countrycodes ORDER BY 1");
            CountryList = rows
                .Select(r => r["country"]?.ToString() ?? "")
                .Where(c => !string.IsNullOrEmpty(c))
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadCountries error: {ex.Message}");
        }
    }

    private async Task LoadProvinces(string country)
    {
        ProvinceList.Clear();
        if (string.IsNullOrWhiteSpace(country)) return;
        try
        {
            var rows = await db.QueryAsync(
                "SELECT DISTINCT state FROM countrycodes WHERE country = @Country ORDER BY 1",
                new { Country = country });
            ProvinceList = rows
                .Select(r => r["state"]?.ToString() ?? "")
                .Where(s => !string.IsNullOrEmpty(s))
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadProvinces error: {ex.Message}");
        }
    }

    // === Event Handlers ===
    private async Task OnCountryChanged()
    {
        Province = "";
        await LoadProvinces(Country);
    }

    private async Task OnOk()
    {
        var addressLines = ParseAddress(Address);
        var result = new CompanyData
        {
            Company = CompanyName,
            Address1 = addressLines.Line1,
            Address2 = addressLines.Line2,
            City = City,
            Province = Province,
            Postal = PostalCode,
            Country = Country,
            County = County,
            Phone = Phone,
            Fax = Fax,
            TaxNumber = TaxNumber,
            Email = Email
        };

        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnSave.InvokeAsync(result);
    }

    private async Task OnCancel()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnCancel();
        }
    }

    private void SelectAll(string fieldName)
    {
        // In Blazor, text selection on focus is typically handled via JS interop.
        // This is a placeholder; implement via JSRuntime if needed.
    }

    // === Helpers ===
    private string CombineAddress(string? line1, string? line2)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(line1)) parts.Add(line1.Trim());
        if (!string.IsNullOrWhiteSpace(line2)) parts.Add(line2.Trim());
        return string.Join("\n", parts);
    }

    private (string Line1, string Line2) ParseAddress(string? address)
    {
        if (string.IsNullOrWhiteSpace(address))
            return ("", "");

        var lines = address.Split(new[] { "\r\n", "\n", "\r" }, 2, StringSplitOptions.None);
        var line1 = lines.Length > 0 ? lines[0].Trim() : "";
        var line2 = lines.Length > 1 ? lines[1].Trim() : "";
        return (line1, line2);
    }

    private string FormatPhone(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return "";

        // Strip non-digit characters
        var digits = new string(phone.Where(char.IsDigit).ToArray());

        if (digits.Length == 10)
            return $"({digits[..3]}) {digits[3..6]}-{digits[6..]}";
        if (digits.Length == 11 && digits[0] == '1')
            return $"1 ({digits[1..4]}) {digits[4..7]}-{digits[7..]}";
        if (digits.Length == 7)
            return $"{digits[..3]}-{digits[3..]}";

        return phone.Trim();
    }

    // === Data Model ===
    public class CompanyData
    {
        public string Company { get; set; } = "";
        public string Address1 { get; set; } = "";
        public string Address2 { get; set; } = "";
        public string City { get; set; } = "";
        public string Province { get; set; } = "";
        public string Postal { get; set; } = "";
        public string Country { get; set; } = "";
        public string County { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Fax { get; set; } = "";
        public string TaxNumber { get; set; } = "";
        public string Email { get; set; } = "";
    }
}
