@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject ILogger<FPhase> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer db

<PageTitle>Estimating Phase</PageTitle>

<DialogControl Visible="IsVisible"
               Header="Estimating Phase"
               Width="540px"
               IsModal="true"
               ShowCloseIcon="true"
               OnClose="OnCancelClick">
    <ChildContent>
        <div class="instruction">
            Enter a number and description for the new phase.
        </div>
        <div class="form-group">
            <label>Number</label>
            <TextBoxControl @bind-Value="PhaseNumber"
                            MaxLength="PhaseMaxLength"
                            Placeholder="Phase number"
                            CssClass="phase-input"
                            @onfocus="() => SelectAllPhase = true" />
        </div>
        <div class="form-group">
            <label>Description</label>
            <TextBoxControl @bind-Value="PhaseDescription"
                            MaxLength="DescriptionMaxLength"
                            Placeholder="Phase description"
                            CssClass="phase-input"
                            @onfocus="() => SelectAllDescription = true" />
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="OnOkClick">OK</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnCancelClick">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    private const string SRCFILE = "FPhase::";

    // === Parameters ===
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public bool GrpPhase { get; set; }
    [Parameter] public EventCallback<bool> OnResult { get; set; }
    [Parameter] public int DivisionID { get; set; } = 1;

    // === Database ===
// === Form State ===
    private string PhaseNumber { get; set; } = "";
    private string PhaseDescription { get; set; } = "";
    private int PhaseMaxLength { get; set; } = 100;
    private int DescriptionMaxLength { get; set; } = 100;
    private bool SelectAllPhase { get; set; }
    private bool SelectAllDescription { get; set; }

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        await LoadFieldSizes();
    }

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            PhaseNumber = "";
            PhaseDescription = "";
        }
    }

    // === Load field sizes from DB (mirrors HFApp.EstFieldSize) ===
    private async Task LoadFieldSizes()
    {
        try
        {
            var phaseSize = await db.ExecuteScalarAsync<int?>(
                "SELECT CHARACTER_MAXIMUM_LENGTH FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'tblEstPhases' AND COLUMN_NAME = 'Phase'");
            if (phaseSize.HasValue && phaseSize.Value > 0)
                PhaseMaxLength = phaseSize.Value;

            var descSize = await db.ExecuteScalarAsync<int?>(
                "SELECT CHARACTER_MAXIMUM_LENGTH FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'tblEstPhases' AND COLUMN_NAME = 'Description'");
            if (descSize.HasValue && descSize.Value > 0)
                DescriptionMaxLength = descSize.Value;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

        }
    }

    // === Show the dialog programmatically ===
    public async Task<bool> ShowForm(bool grpPhase)
    {
        GrpPhase = grpPhase;
        PhaseNumber = "";
        PhaseDescription = "";
        IsVisible = true;
        await IsVisibleChanged.InvokeAsync(true);
        StateHasChanged();
        // Note: In Blazor, modal behavior is handled via the IsVisible flag and OnResult callback.
        // The caller should await the OnResult event.
        return true;
    }

    // === OK Button ===
    private async Task OnOkClick()
    {
        if (await SaveData())
        {
            IsVisible = false;
            await IsVisibleChanged.InvokeAsync(false);
            await OnResult.InvokeAsync(true);
        }
    }

    // === Cancel Button ===
    private async Task OnCancelClick()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnResult.InvokeAsync(false);
    }

    // === SaveData ===
    private async Task<bool> SaveData()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(PhaseNumber) || string.IsNullOrWhiteSpace(PhaseDescription))
            {
                Notifications.Success("Number and description are both required.");
                return false;
            }

            var sql = @"
                INSERT INTO tblEstPhases (DivisionID, Phase, Description, GroupPhase, UpdateEstimating)
                VALUES (@DivisionID, @Phase, @Description, @GroupPhase, 0)";

            await db.ExecuteAsync(sql, new
            {
                DivisionID = DivisionID,
                Phase = PhaseNumber.Trim(),
                Description = PhaseDescription.Trim(),
                GroupPhase = GrpPhase ? 1 : 0
            });

            await FixGroupPhaseValue();

            return true;
        }
        catch (Exception ex)
        {
            if (ex.Message.IndexOf("duplicate", StringComparison.OrdinalIgnoreCase) >= 0 ||
                ex.Message.IndexOf("unique", StringComparison.OrdinalIgnoreCase) >= 0 ||
                ex.Message.IndexOf("violation of primary key", StringComparison.OrdinalIgnoreCase) >= 0)
            {
                Notifications.Info($"Phase \"{PhaseNumber.Trim()}\" has already been entered. Please specify a different value.");

            }
            else
            {
                Logger.LogError(ex, "[{SRCFILE}SaveData]");

                Notifications.Error($"Error saving phase: {ex.Message}");
            }
            return false;
        }
    }

    // === FixGroupPhaseValue — full VB6 MMain.bas implementation ===
    private async Task FixGroupPhaseValue()
    {
        try
        {
            // Step 1: Assign GroupPhaseValue for non-group phases based on nearest preceding group phase
            var sql1 = @"
                UPDATE pp
                SET GroupPhaseValue = gg.phase
                FROM
                (
                  SELECT p.divisionid, MAX(g.sortorder) groupsort, p.phase
                  FROM tblestphases p
                  JOIN estgroups g ON g.divisionid = p.divisionid AND g.sortorder < p.sortorder
                  WHERE p.groupphase = 0
                  GROUP BY p.divisionid, p.sortorder, p.phase
                ) x
                JOIN tblestphases pp ON pp.divisionid = x.divisionid AND pp.phase = x.phase
                JOIN estgroups gg ON gg.divisionid = x.divisionid AND gg.sortorder = x.groupsort
                WHERE x.DivisionID = @DivisionID";
            await db.ExecuteAsync(sql1, new { DivisionID });

            // Step 2: Group phases point to themselves
            var sql2 = @"
                UPDATE tblestphases
                SET GroupPhaseValue = Phase
                WHERE DivisionID = @DivisionID AND GroupPhase = 1";
            await db.ExecuteAsync(sql2, new { DivisionID });

            // Step 3: Any remaining nulls get the first group phase
            var sql3 = @"
                UPDATE tblestphases
                SET groupphasevalue = (SELECT MIN(phase) FROM tblestphases WHERE divisionid = @DivisionID AND groupphase = 1)
                WHERE DivisionID = @DivisionID AND groupphasevalue IS NULL";
            await db.ExecuteAsync(sql3, new { DivisionID });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}FixGroupPhaseValue]");

        }
    }
}
