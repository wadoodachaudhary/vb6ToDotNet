@namespace HomeFront.Components.Pages

@using HomeFront.Data
@using Fx.ControlKit.Notifications
@inject IJSRuntime JSRuntime
@inject ILogger<FEditItem> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer db

<DialogControl @bind-Visible="Visible" Header="Item" Width="500px" IsModal="true" OnClose="OnCancelClick">
    <ChildContent>
        <div class="edit-item-body">
            <div class="field-row">
                <label>Phase</label>
                <TextBoxControl @bind-Value="Phase" MaxLength="20" CssClass="ei-field" />
            </div>

            <div class="field-row">
                <label>Item</label>
                <TextBoxControl @bind-Value="POIndex" MaxLength="20" CssClass="ei-field" />
            </div>

            <div class="field-row">
                <label>Description</label>
                <TextBoxControl @bind-Value="Description" MaxLength="20" CssClass="ei-field" />
            </div>

            <div class="field-row">
                <label>Notes</label>
                <TextAreaControl @bind-Value="Notes" Rows="5" MaxLength="2000" CssClass="ei-field" />
            </div>

            <div class="field-row">
                <label>JC Cost Code</label>
                <DropDownListControl TValue="string" TItem="ComboItem" DataSource="@JCCostCodeItems" TextFieldName="Text" ValueFieldName="Value" @bind-Value="JCCostCode" Placeholder="-- Select --" Width="100%" />
            </div>

            <div class="field-row">
                <label>JC Category</label>
                <DropDownListControl TValue="string" TItem="ComboItem" DataSource="@JCCategoryItems" TextFieldName="Text" ValueFieldName="Value" @bind-Value="JCCategory" Placeholder="-- Select --" Width="100%" />
            </div>

            <div class="field-row">
                <label>Order unit</label>
                <DropDownListControl TValue="string" TItem="ComboItem" DataSource="@UnitItems" TextFieldName="Text" ValueFieldName="Value" @bind-Value="OrderUnit" Placeholder="-- Select --" Width="140px" />
            </div>

            <div class="field-row">
                <label>Takeoff unit</label>
                <DropDownListControl TValue="string" TItem="ComboItem" DataSource="@UnitItems" TextFieldName="Text" ValueFieldName="Value" @bind-Value="TakeoffUnit" Placeholder="-- Select --" Width="140px" />
            </div>

            <div class="field-row">
                <label>Conversion</label>
                <TextBoxControl @bind-Value="Conversion" MaxLength="20" CssClass="ei-field-sm" />
            </div>

            <div class="field-row">
                <label>Rounding</label>
                <TextBoxControl @bind-Value="Rounding" MaxLength="20" CssClass="ei-field-xs" />
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="btn btn-primary" OnClick="OnOkClick">OK</ButtonControl>
        <ButtonControl CssClass="btn" OnClick="OnCancelClick">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    // === Parameters ===
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<EditItemResult> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    // === Bound Fields ===
    [Parameter] public string Phase { get; set; } = "";
    [Parameter] public string POIndex { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Notes { get; set; } = "";
    [Parameter] public string JCCostCode { get; set; } = "";
    [Parameter] public string JCCategory { get; set; } = "";
    [Parameter] public string OrderUnit { get; set; } = "";
    [Parameter] public string TakeoffUnit { get; set; } = "";
    [Parameter] public string Conversion { get; set; } = "";
    [Parameter] public string Rounding { get; set; } = "";

    // === Combo Data Sources ===
    [Parameter] public List<ComboItem> JCCostCodeItems { get; set; } = new();
    [Parameter] public List<ComboItem> JCCategoryItems { get; set; } = new();
    [Parameter] public List<ComboItem> UnitItems { get; set; } = new();

    // === Database ===
    [Parameter] public int DivisionID { get; set; } = 1;
// === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        if (JCCostCodeItems.Count == 0)
            await LoadLookupData();
    }

    private async Task LoadLookupData()
    {
        try
        {
            // Load JC Cost Codes
            var costCodes = await db.QueryAsync(
                $"SELECT CostCode, Description FROM StandardCostCodes WHERE DivisionID = {DivisionID} ORDER BY CostCode");
            JCCostCodeItems = costCodes.Select(r => new ComboItem
            {
                Value = r["CostCode"]?.ToString() ?? "",
                Text = $"{r["CostCode"]} - {r["Description"]}"
            }).ToList();

            // Load JC Categories
            var categories = await db.QueryAsync(
                $"SELECT Category, Description FROM StandardCategories WHERE DivisionID = {DivisionID} ORDER BY Category");
            JCCategoryItems = categories.Select(r => new ComboItem
            {
                Value = r["Category"]?.ToString() ?? "",
                Text = $"{r["Category"]} - {r["Description"]}"
            }).ToList();

            // Load Units (Order and Takeoff units)
            if (UnitItems.Count == 0)
            {
                UnitItems = new List<ComboItem>
                {
                    new() { Value = "EA", Text = "EA" },
                    new() { Value = "LF", Text = "LF" },
                    new() { Value = "SF", Text = "SF" },
                    new() { Value = "SY", Text = "SY" },
                    new() { Value = "CY", Text = "CY" },
                    new() { Value = "BF", Text = "BF" },
                    new() { Value = "MBF", Text = "MBF" },
                    new() { Value = "TON", Text = "TON" },
                    new() { Value = "GAL", Text = "GAL" },
                    new() { Value = "BAG", Text = "BAG" },
                    new() { Value = "BOX", Text = "BOX" },
                    new() { Value = "BDL", Text = "BDL" },
                    new() { Value = "SQ", Text = "SQ" },
                    new() { Value = "LS", Text = "LS" },
                    new() { Value = "HR", Text = "HR" },
                    new() { Value = "DAY", Text = "DAY" },
                    new() { Value = "LOT", Text = "LOT" },
                    new() { Value = "SET", Text = "SET" },
                    new() { Value = "PR", Text = "PR" },
                    new() { Value = "RL", Text = "RL" }
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FEditItem.LoadLookupData error");

        }
    }

    // === Event Handlers ===
    private async Task OnOkClick()
    {
        // Validate required fields
        if (string.IsNullOrWhiteSpace(Phase))
        {
            Notifications.Error("Phase is required.");
            return;
        }

        if (string.IsNullOrWhiteSpace(POIndex))
        {
            Notifications.Warning("Item is required.");
            return;
        }

        var result = new EditItemResult
        {
            Phase = Phase,
            POIndex = POIndex,
            Description = Description,
            Notes = Notes,
            JCCostCode = JCCostCode,
            JCCategory = JCCategory,
            OrderUnit = OrderUnit,
            TakeoffUnit = TakeoffUnit,
            Conversion = Conversion,
            Rounding = Rounding
        };

        await OnSave.InvokeAsync(result);
        await SetVisible(false);
    }

    private async Task OnCancelClick()
    {
        await OnCancel.InvokeAsync();
        await SetVisible(false);
    }

    private async Task SetVisible(bool value)
    {
        Visible = value;
        await VisibleChanged.InvokeAsync(value);
    }

    // === Public Methods ===
    public void Show(string phase = "", string poIndex = "", string description = "",
        string notes = "", string jcCostCode = "", string jcCategory = "",
        string orderUnit = "", string takeoffUnit = "", string conversion = "", string rounding = "")
    {
        Phase = phase;
        POIndex = poIndex;
        Description = description;
        Notes = notes;
        JCCostCode = jcCostCode;
        JCCategory = jcCategory;
        OrderUnit = orderUnit;
        TakeoffUnit = takeoffUnit;
        Conversion = conversion;
        Rounding = rounding;
        Visible = true;
        StateHasChanged();
    }

    // === Models ===
    public class ComboItem
    {
        public string Value { get; set; } = "";
        public string Text { get; set; } = "";
    }

    public class EditItemResult
    {
        public string Phase { get; set; } = "";
        public string POIndex { get; set; } = "";
        public string Description { get; set; } = "";
        public string Notes { get; set; } = "";
        public string JCCostCode { get; set; } = "";
        public string JCCategory { get; set; } = "";
        public string OrderUnit { get; set; } = "";
        public string TakeoffUnit { get; set; } = "";
        public string Conversion { get; set; } = "";
        public string Rounding { get; set; } = "";
    }
}
