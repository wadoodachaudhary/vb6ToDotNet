@page "/wbs-codes"
@page "/wbs-codes/{Job}"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using System.Data
@using HomeFront.Data
@using Fx.ControlKit
@using Fx.ControlKit.Notifications
@using Microsoft.AspNetCore.Components.Web
@using HomeFront.Services

@inject NavigationManager NavigationManager
@inject ILogger<FWBSCodes> Logger
@inject NotificationService Notifications
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db
@layout HFComponent

@* VB6: FWBSCodes.frm — "WBS Codes" fixed dialog (vbModal). gData is a fixed 2-col
   VSFlexGrid (40 data rows, col0 = WBS number, col1 = editable Description, EditMaxLength
   = 50). NOT an AppGridLayout/IniGetGrid grid, so the column layout is faithfully static. *@

<PageTitle>WBS Codes - HomeFront</PageTitle>

<DialogControl Visible="true"
               Header="WBS Codes"
               Width="500px"
               IsModal="true"
               ShowCloseIcon="true"
               CloseOnEscape="true"
               OnClose="OnCancelClick">
    <ChildContent>
        <div class="wbs-grid" tabindex="0">
            <div class="wbs-row wbs-head">
                <div class="wbs-cell-num">WBS</div>
                <div class="wbs-cell-desc">Description</div>
            </div>
            @for (int i = 1; i <= 40; i++)
            {
                var index = i;
                <div class="wbs-row">
                    <div class="wbs-cell-num">@index.ToString("00")</div>
                    <div class="wbs-cell-desc">
                        <TextBoxControl Value="@WbsDescriptions[index]"
                                        ValueChanged="@(v => OnDescriptionChanged(index, v))"
                                        MaxLength="50"
                                        CssClass="wbs-input"
                                        HtmlAttributes="@GetCellAttributes(index)" />
                    </div>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn wbs-ok" OnClick="OnOkClick">OK</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnCancelClick">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    // VB6: Private mJob As String — passed via ShowForm(Optional Job As String).
    [Parameter] public string? Job { get; set; }

    // Navigate without reloading the FMain shell; falls back to NavigationManager standalone.
    [CascadingParameter(Name = "ParentNavigate")] private Action<string>? ParentNavigate { get; set; }

    /// <summary>WBS index (1..40) → description text. Mirrors VB6 gData.TextMatrix(i, 1).</summary>
    private Dictionary<int, string> WbsDescriptions = new();

    protected override async Task OnInitializedAsync()
    {
        // Initialise all 40 slots (VB6 grid has 40 fixed data rows).
        for (int i = 1; i <= 40; i++)
            WbsDescriptions[i] = "";

        await LoadDataAsync();
    }

    // VB6: ShowForm — builds the load query depending on whether a Job was supplied.
    private async Task LoadDataAsync()
    {
        try
        {
            string sql;
            object? parameters;

            if (string.IsNullOrEmpty(Job))
            {
                // VB6: get standards — "select Item,custom_description Description from
                // customDescriptions where item like 'WBS__' order by item"
                sql = @"SELECT Item, custom_description AS Description
                        FROM customDescriptions
                        WHERE item LIKE 'WBS__'
                        ORDER BY item";
                parameters = null;
            }
            else
            {
                // VB6: get job list — UNION of all 40 WBSDescNN columns from tblJobs,
                // filtered by DivisionID + job_no.
                var unions = new List<string>();
                for (int i = 1; i <= 40; i++)
                {
                    var wbsNum = i.ToString("00");
                    unions.Add($"SELECT 'WBS{wbsNum}' AS Item, WBSDesc{wbsNum} AS Description FROM tblJobs WHERE DivisionID = @DivisionID AND job_no = @Job");
                }
                sql = string.Join("\nUNION\n", unions);
                parameters = new { DivisionID = SessionState.DivisionID, Job };
            }

            var dt = parameters != null
                ? db.SqlExec(sql, parameters)
                : db.SqlExec(sql);

            foreach (DataRow row in dt.Rows)
            {
                // VB6: .TextMatrix(Val(Mid("" & rs("item"), 4)), 1) = "" & rs("Description")
                // i.e. parse the numeric suffix of "WBSnn" → row index.
                var item = row["Item"]?.ToString() ?? "";
                if (item.Length >= 5 && int.TryParse(item.Substring(3), out int idx) && idx >= 1 && idx <= 40)
                {
                    WbsDescriptions[idx] = row["Description"]?.ToString() ?? "";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FWBSCodes: load failed");
            Notifications.Error($"Error loading WBS codes: {ex.Message}");
        }
    }

    // VB6: SaveData — 40 UPDATE statements (one per WBS row).
    private async Task<bool> SaveDataAsync()
    {
        try
        {
            for (int i = 1; i <= 40; i++)
            {
                var wbsNum = i.ToString("00");
                var desc = WbsDescriptions[i] ?? "";

                if (string.IsNullOrEmpty(Job))
                {
                    // VB6: update customdescriptions set custom_description=... where item='WBSnn'
                    var sql = @"UPDATE customdescriptions
                                SET custom_description = @Description
                                WHERE item = @Item";
                    await db.ExecuteAsync(sql, new { Description = desc, Item = $"WBS{wbsNum}" });
                }
                else
                {
                    // VB6: update tbljobs set wbsdescNN=... where DivisionID=... and job_no=...
                    var sql = $@"UPDATE tblJobs
                                 SET WBSDesc{wbsNum} = @Description
                                 WHERE DivisionID = @DivisionID AND job_no = @Job";
                    await db.ExecuteAsync(sql, new { Description = desc, DivisionID = SessionState.DivisionID, Job });
                }
            }
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FWBSCodes: save failed");
            Notifications.Error($"Error saving WBS codes: {ex.Message}");
            return false;
        }
    }

    private void OnDescriptionChanged(int index, string? value)
    {
        var text = value ?? "";
        // VB6: gData.EditMaxLength = 50
        if (text.Length > 50)
            text = text.Substring(0, 50);
        WbsDescriptions[index] = text;
    }

    // VB6: gData_KeyDown — If KeyCode = vbKeyDelete Then gData.Clip = "" (clear the cell).
    private Dictionary<string, object> GetCellAttributes(int index)
    {
        return new Dictionary<string, object>
        {
            ["onkeydown"] = EventCallback.Factory.Create<KeyboardEventArgs>(this, e => OnKeyDown(e, index))
        };
    }

    private void OnKeyDown(KeyboardEventArgs e, int index)
    {
        if (e.Key == "Delete")
            WbsDescriptions[index] = "";
    }

    // VB6: cmdNav_Click(0) — If Index = 0 Then Call SaveData : Unload Me
    private async Task OnOkClick()
    {
        await SaveDataAsync();
        CloseForm();
    }

    // VB6: cmdNav_Click(1) — Cancel button: Unload Me (no save).
    private void OnCancelClick()
    {
        CloseForm();
    }

    private void CloseForm()
    {
        // VB6 unloads the modal; under the FMain MDI shell, passing "" closes the active
        // page and returns to the shell default (same as the sibling FDimensionCategories).
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            NavigationManager.NavigateTo("/main");
    }
}
