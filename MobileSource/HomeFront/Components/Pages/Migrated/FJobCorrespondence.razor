    private void OnAddNewRow()
    {
        var newRow = new MessageRow
        {
            ID = "",
            Priority = 1,
            MessageType = "Other",
            ReceivedDate = DateTime.Today,
            RowState = "DIRTY",
            IsDeleted = false
        };
        MessagesData.Add(newRow);
        mDirty = true;
        StateHasChanged();
    }

