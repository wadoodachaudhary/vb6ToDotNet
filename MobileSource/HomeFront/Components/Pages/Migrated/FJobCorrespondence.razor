@page "/job-correspondence"
@page "/job-correspondence/{Job}"
@rendermode InteractiveServer
@namespace HomeFront.Components.Pages
@layout HFComponent

@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data
@using HomeFront.Models
@using System.Data
@using System.Reflection
@using System.Text

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FJobCorrespondence> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db

<PageTitle>Correspondence Log - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Correspondence...</div>
    </div>
}

<div class="job-correspondence-page">
    @* ── TOOLBAR ─────────────────────────────────────────── *@
    <div class="toolbar-cntr">
        <button class="tbar-btn" @onclick="OnOpenClick">
            <img src="images/32/open.ico" alt="Open" onerror="this.style.display='none'" />
            <span class="tool-label">Open</span>
        </button>
        @* Save is enabled ONLY when the form is dirty (standing rule: Save is never
           auto-enabled). Per-cell edits raise OnCellSave → mDirty → Save enables. *@
        <button class="tbar-btn" @onclick="OnSaveClick" disabled="@(!mDirty)">
            <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
            <span class="tool-label">Save</span>
        </button>
    </div>

    @* HHM-454: in-content heading removed; the MDI tab caption ("Correspondence Log")
       is the sole title, matching the reference forms (FVendor has no in-content heading). *@

    @* ── MESSAGES GRID ─────────────────────────────────────── *@
    <GridControl @ref="MessagesGrid"
            TValue="MessageRow"
            DataSource="@MessagesData"
            AllowSorting="true"
            AllowResizing="true"
            AllowSelection="true"
            HighlightSelectedRows="false"
            AllowFiltering="true"
            EnableHover="true"
            Height="100%"
            FilterSettingsRef="@filterSettings"
            PageSettingsRef="@pageSettings"
            SelectionSettingsRef="@selectionSettings"
            EditSettingsRef="@editSettings"
            BatchEditBehavior="GridBatchEditBehavior.SingleCell"
            EditOnSingleClick="true"
            NewItemFactory="CreatePlaceholderRow"
            EnsureTrailingNewRow="true"
            IsTrailingNewRow="IsInlineNewRow"
            AddNewRowOnLastCellExit="true"
            CanAddNewRowOnLastCellExit="CanAppendInlineNewRowAfter"
            EventsRef="@gridEvents"
            OnLayoutChanged="@OnMessagesLayoutChangedAsync">
        <GridColumnsBase @key="gMessagesLayoutVersion">
            <GridColumn Field="@nameof(MessageRow.ID)" HeaderText="ID" Width="1px" Visible="false"
                          IsPrimaryKey="true" AllowEditing="false" />
            @* HHM-458: VB6 shows the Qlt / Original / Attachments icon columns regardless
               of the saved AppGridLayout, so render them once here — ahead of BOTH the
               layout-driven foreach and the fallback branch. The dynamic loop renders
               ONLY colkeys resolving to the LayoutRenderableFields whitelist (VB6
               IniGetGrid's ColIndex <> -1 guard), so these can never duplicate. *@
            <GridColumn Field="@nameof(MessageRow.Priority)" HeaderText="!" Width="50px"
                          TextAlign="TextAlign.Center" AllowEditing="false">
                <Template>
                    @{
                        var row = (MessageRow)context;
                        var (priorityClass, symbol) = row.Priority switch
                        {
                            1 => ("priority-high", "!"),
                            2 => ("priority-low", "⬇"),
                            _ => ("priority-none", "")
                        };
                    }
                    <span class="priority-cell @priorityClass"
                          @onclick="() => OnPriorityClick(row)"
                          @onclick:stopPropagation="true"
                          title="Click to change priority">@symbol</span>
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(MessageRow.Original)" HeaderText="📧" Width="50px"
                          TextAlign="TextAlign.Center" AllowEditing="false">
                <Template>
                    @{
                        var row = (MessageRow)context;
                        if (row.MessageType == "Email")
                        {
                            <span class="email-icon" @ondblclick="() => OnOpenOriginal(row)"
                                  title="Double-click to open original">✉️</span>
                        }
                    }
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(MessageRow.Attachments)" HeaderText="📎" Width="50px"
                          TextAlign="TextAlign.Center" AllowEditing="false">
                <Template>
                    @{
                        var row = (MessageRow)context;
                        if (row.HasAttachments)
                        {
                            <span class="attachment-icon" title="Has attachments">📎</span>
                        }
                    }
                </Template>
            </GridColumn>

            @if (HasGridLayout)
            {
                foreach (var entry in GetOrderedGridLayout())
                {
                    var layout = entry.Layout;
                    var fieldName = entry.Field;
                    var columnType = entry.ColumnType;
                    var textAlign = entry.TextAlign;
                    var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                    var width = layout.Width.HasValue && layout.Width.Value > 0
                        ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;
                    var allowEdit = IsFieldEditable(fieldName);

                    if (fieldName == nameof(MessageRow.MessageType))
                    {
                        @* HHM-460: Sent Via edits through the STANDARD batch dropdown editor.
                           An EditTemplate is dead in batch mode (only the row-level inline path
                           reads it), which is why the cell opened as free text. The provider
                           mirrors VB6 gMessages_BeforeEdit: ComboList "Mail|Fax|Phone|Other".
                           Email rows remain read-only through OnCellBeginEdit. *@
                        <GridColumn Field="@fieldName"
                                      HeaderText="Sent Via"
                                      Width="@width"
                                      Type="@columnType"
                                      TextAlign="@textAlign"
                                      AllowEditing="@allowEdit"
                                      EditOptionsProvider="GetMessageTypeEditOptions"
                                      ClipMode="ClipMode.Ellipsis" />
                    }
                    else if (fieldName == nameof(MessageRow.Sender)
                             || fieldName == nameof(MessageRow.Recipients)
                             || fieldName == nameof(MessageRow.RecipientsCC)
                             || fieldName == nameof(MessageRow.RecipientsBCC))
                    {
                        <GridColumn Field="@fieldName"
                                      HeaderText="@headerText"
                                      Width="@width"
                                      Type="@columnType"
                                      TextAlign="@textAlign"
                                      AllowEditing="false"
                                      ShowEditButton="true"
                                      ShowEditButtonPredicate="CanShowMessagePickerButton"
                                      ClipMode="ClipMode.Ellipsis">
                        </GridColumn>
                    }
                    else if (fieldName == nameof(MessageRow.SentDate)
                             || fieldName == nameof(MessageRow.ReceivedDate))
                    {
                        @* VB6 gMessages arms a ComboList on these cells and answers the cell
                           button with DCalendar.Popup (FJobCorrespondence.frm:515, 526): the date
                           is typeable AND has a calendar. OpenDateCalendarOnDoubleClick is what
                           gives the in-cell DateTextControls its calendar. *@
                        <GridColumn Field="@fieldName"
                                      HeaderText="@headerText"
                                      Width="@width"
                                      Type="@columnType"
                                      Format="MM/dd/yyyy"
                                      TextAlign="@textAlign"
                                      AllowEditing="@allowEdit"
                                      OpenDateCalendarOnDoubleClick="true"
                                      ClipMode="ClipMode.Ellipsis" />
                    }
                    else
                    {
                        <GridColumn Field="@fieldName"
                                      HeaderText="@headerText"
                                      Width="@width"
                                      Type="@columnType"
                                      TextAlign="@textAlign"
                                      AllowEditing="@allowEdit"
                                      ClipMode="ClipMode.Ellipsis" />
                    }
                }
            }
            else
            {
            @* HHM-458: Priority / Original / Attachments icon columns are now rendered
               unconditionally above, so they are intentionally omitted from this fallback. *@
            @* HHM-460: same standard batch dropdown as the layout-driven branch above. *@
            <GridColumn Field="@nameof(MessageRow.MessageType)" HeaderText="Sent Via" Width="100px"
                        EditOptionsProvider="GetMessageTypeEditOptions"
                        ClipMode="ClipMode.Ellipsis" />

            <GridColumn Field="@nameof(MessageRow.Sender)" HeaderText="Sender" Width="180px"
                        AllowEditing="false"
                        ShowEditButton="true" ShowEditButtonPredicate="CanShowMessagePickerButton"
                        ClipMode="ClipMode.Ellipsis" />

            <GridColumn Field="@nameof(MessageRow.Recipients)" HeaderText="Recipients" Width="200px"
                        AllowEditing="false"
                        ShowEditButton="true" ShowEditButtonPredicate="CanShowMessagePickerButton"
                        ClipMode="ClipMode.Ellipsis" />

            <GridColumn Field="@nameof(MessageRow.RecipientsCC)" HeaderText="CC" Width="180px"
                        AllowEditing="false"
                        ShowEditButton="true" ShowEditButtonPredicate="CanShowMessagePickerButton"
                        ClipMode="ClipMode.Ellipsis" />

            <GridColumn Field="@nameof(MessageRow.RecipientsBCC)" HeaderText="BCC" Width="180px"
                        AllowEditing="false"
                        ShowEditButton="true" ShowEditButtonPredicate="CanShowMessagePickerButton"
                        ClipMode="ClipMode.Ellipsis" />

            <GridColumn Field="@nameof(MessageRow.Subject)" HeaderText="Subject" Width="250px" />

            <GridColumn Field="@nameof(MessageRow.Body)" HeaderText="Body" Width="300px"
                        ClipMode="ClipMode.Ellipsis" />

            <GridColumn Field="@nameof(MessageRow.Size)" HeaderText="Size" Width="80px"
                          AllowEditing="false" TextAlign="TextAlign.Right" />

            <GridColumn Field="@nameof(MessageRow.SentDate)" HeaderText="Sent Date" Width="120px"
                        Type="ColumnType.Date" Format="MM/dd/yyyy"
                        AllowEditing="true" OpenDateCalendarOnDoubleClick="true"
                        ClipMode="ClipMode.Ellipsis" />

            <GridColumn Field="@nameof(MessageRow.ReceivedDate)" HeaderText="Received Date" Width="120px"
                        Type="ColumnType.Date" Format="MM/dd/yyyy"
                        AllowEditing="true" OpenDateCalendarOnDoubleClick="true"
                        ClipMode="ClipMode.Ellipsis" />

            <GridColumn Field="@nameof(MessageRow.RowState)" Visible="false" />
            }
        </GridColumnsBase>
    </GridControl>
    @* HHM-465: the manual "Add New Message" button is replaced by the VB6-style
       trailing blank row (NewItemFactory / EnsureTrailingNewRow on the grid above). *@
</div>

@* Shared FlexKit picklist (search + type-to-search + sortable) — VB6 FPickList. *@
<FPickList @ref="_pickList" OnSelected="OnPickListSelected" OnCancel="OnPickListCancelled" />

<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />

@code {
    [Parameter] public string? Job { get; set; }

    // === Database ===
// === UI State ===
    private bool IsLoading = false;
    private bool mDirty = false;
    private string mJob = "";
    private GridControl<MessageRow>? MessagesGrid;

    // === Grid Settings ===
    private FilterSettings filterSettings = new() { Type = FilterType.FilterBar };
    private PageSettings pageSettings = new() { PageSize = 50 };
    private SelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Cell
    };
    private EditSettings editSettings = new()
    {
        // HHM-467: Batch mode so per-cell edits raise OnCellSave → mDirty → Save enables.
        Mode = EditMode.Batch,
        AllowAdding = true,
        AllowEditing = true,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false,
        // HHM-465: VB6 keeps the blank "new" row at the bottom of the grid.
        NewRowPosition = NewRowPosition.Bottom
    };
    private GridControlEvents<MessageRow> gridEvents = new();

    // ── Grid layout via the shared GridLayoutPresenter ──────────
    // The load/resolve/width boilerplate lives in GridLayoutPresenter<TRow>; only the
    // VB6 form/grid name strings + the layout-field aliases stay here (fidelity).
    // gMessagesLayout / HasGridLayout / gMessagesLayoutVersion below are thin
    // delegations, so the markup is unchanged. The keyed("(0)")-then-unkeyed two-call
    // fallback that LoadGridLayoutAsync used is now expressed via the ctor's
    // instanceKey, and the ResolveGridField switch is the ctor's alias map (keyed by
    // the normalized layout field).
    //
    // DRIFT (preserved, NOT delegated): GetColumnTypeForField maps bool →
    // ColumnType.CheckBox where the canonical presenter uses ColumnType.Boolean
    // (MessageRow has the bool columns HasAttachments / IsDeleted), so GetOrdered must
    // keep using the local type map. ConvertLayoutWidthToPx matches WidthPx's +16, so
    // it IS delegated; Layout / Has / Version and ResolveGridField are delegated too.
    private readonly GridLayoutPresenter<MessageRow> _messagesGrid =
        new("FJobCorrespondence", "gMessages", instanceKey: "(0)",
            aliases: new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["from"] = nameof(MessageRow.Sender),
                ["sendername"] = nameof(MessageRow.Sender),
                ["to"] = nameof(MessageRow.Recipients),
                ["recipientname"] = nameof(MessageRow.Recipients),
                ["cc"] = nameof(MessageRow.RecipientsCC),
                ["bcc"] = nameof(MessageRow.RecipientsBCC),
                ["type"] = nameof(MessageRow.MessageType)
            });

    private Dictionary<string, GridLayoutColumn> gMessagesLayout => _messagesGrid.Layout;
    private bool HasGridLayout => _messagesGrid.Has;
    private int gMessagesLayoutVersion => _messagesGrid.Version;

    // Used by the local GetColumnTypeForField (kept due to the bool→CheckBox drift).
    private static readonly Dictionary<string, PropertyInfo> _messageRowPropMap =
        typeof(MessageRow)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .GroupBy(p => NormalizeGridKey(p.Name))
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    // === Data ===
    private List<MessageRow> MessagesData = new();

    // HHM-460: VB6 gMessages_BeforeEdit arms .ComboList = "Mail|Fax|Phone|Other" for the
    // Sent Via column and cancels the edit entirely on Email rows — the provider below
    // reproduces both (an empty option list keeps the dropdown cue off Email cells).
    private static readonly string[] MessageTypeEditOptions = { "Mail", "Fax", "Phone", "Other" };

    private static IEnumerable<string> GetMessageTypeEditOptions(object row)
        => row is MessageRow { MessageType: "Email" } ? Array.Empty<string>() : MessageTypeEditOptions;

    // === Pickers ===
    private FPickList? _pickList;
    private string _pickListContext = "";
    private MessageRow? ContactPickerTargetRow;
    private string ContactPickerTargetField = "";

    private Fx.ControlKit.Dialogs.MessageBoxControl? _messageBox;

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        gridEvents.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<MessageRow>>(this, OnCellBeginEdit);
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<MessageRow>>(this, OnCellSaved);
        gridEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<MessageRow>>(this, OnMessagesEditButtonClick);
        await LoadGridLayoutAsync();

        mJob = Job ?? "";
        await LoadJob(mJob);
    }

    // === ShowForm (entry point, mirrors VB6) ===
    public async Task ShowForm(string job)
    {
        mJob = job;
        await LoadJob(mJob);
    }

    // === LoadJob ===
    private async Task OpenJobPicker()
    {
        _pickListContext = "Jobs";
        var sql = @"
            SELECT DISTINCT j.Job_No AS Job, j.Description, j.Municipal_Address AS Address,
                   j.PM, j.Purchaser, j.Estimator
            FROM tblJobs j
            WHERE divisionid = @DivisionID
              AND ISNULL(j.Inactive, 0) = 0
            ORDER BY j.Job_No";
        var parameters = new Dictionary<string, object>
        {
            { "DivisionID", SessionState.DivisionID }
        };
        if (_pickList != null)
        {
            await _pickList.Open(
                title: "Jobs",
                queries: sql,
                parameters: parameters
            );
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (string.IsNullOrEmpty(mJob))
            {
                await OpenJobPicker();
            }
        }
    }

    private async Task LoadJob(string job)
    {
        if (string.IsNullOrEmpty(job))
        {
            await OpenJobPicker();
            return;
        }

        IsLoading = true;
        StateHasChanged();

        try
        {

            mJob = job;

            // Load messages
            var msgSql = @"
                SELECT *
                FROM messages
                WHERE job = @Job
                  AND ISNULL(rfiid, 0) = 0";
            var msgRows = await db.QueryAsync(msgSql, new { Job = mJob });

            MessagesData = msgRows.Select(r => new MessageRow
            {
                ID = r["ID"]?.ToString() ?? "",
                MessageType = r["MessageType"]?.ToString() ?? "",
                Priority = SafeInt(r["Priority"]),
                HasAttachments = SafeInt(r["Attachments"]) > 0,
                Sender = r["Sender"]?.ToString() ?? "",
                Recipients = r["Recipients"]?.ToString() ?? "",
                RecipientsCC = r["RecipientsCC"]?.ToString() ?? "",
                RecipientsBCC = r["RecipientsBCC"]?.ToString() ?? "",
                Subject = r["Subject"]?.ToString() ?? "",
                Body = r["Body"]?.ToString() ?? "",
                Size = SafeInt(r["Size"]) > 0 ? $"{SafeInt(r["Size"])} KB" : "",
                SentDate = SafeDate(r["SentDate"]),
                ReceivedDate = SafeDate(r["ReceivedDate"]),
                RowState = "CLEAN",
                IsDeleted = false
            }).ToList();

            mDirty = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadJob error");

            Notifications.Error($"Error loading job: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === SaveData ===
    private async Task<bool> SaveData(bool prompt)
    {
        if (!mDirty) return true;

        if (prompt)
        {
            // HHM-454: VB6 MsgBox vbYesNoCancel — Yes=save, No=discard, Cancel=abort.
            // Was a JS confirm() with only two buttons, so Cancel (abort the Open)
            // was impossible; now the standard FlexKit Yes/No/Cancel dialog.
            var resp = await ShowSavePromptDialog();
            if (resp == null) return false;   // Cancel → abort the caller's action
            if (resp == false) return true;   // No → discard changes, allow proceed
            // Yes → fall through to save
        }

        IsLoading = true;
        StateHasChanged();

        try
        {
            // Process deleted rows
            var deletedRows = MessagesData.Where(r => r.IsDeleted && !string.IsNullOrEmpty(r.ID)).ToList();
            foreach (var row in deletedRows)
            {
                await db.ExecuteAsync("DELETE FROM messages WHERE id = @Id", new { Id = row.ID });
            }
            MessagesData.RemoveAll(r => r.IsDeleted);

            // Process dirty rows (HHM-465: never persist an untouched trailing placeholder)
            foreach (var row in MessagesData.Where(r => r.RowState == "DIRTY" && !r.IsInlineNewRow))
            {
                if (string.IsNullOrEmpty(row.ID))
                {
                    // Insert
                    row.ID = Guid.NewGuid().ToString();
                    var insertSql = @"
                        INSERT INTO messages (job, rfiid, id, priority, messagetype, sender, recipients,
                                              recipientscc, recipientsbcc, subject, body, sentdate, receiveddate)
                        VALUES (@Job, 0, @Id, @Priority, @MessageType, @Sender, @Recipients,
                                @RecipientsCC, @RecipientsBCC, @Subject, @Body, @SentDate, @ReceivedDate)";
                    await db.ExecuteAsync(insertSql, new
                    {
                        Job = mJob,
                        Id = row.ID,
                        row.Priority,
                        row.MessageType,
                        row.Sender,
                        row.Recipients,
                        row.RecipientsCC,
                        row.RecipientsBCC,
                        row.Subject,
                        row.Body,
                        row.SentDate,
                        row.ReceivedDate
                    });
                }
                else
                {
                    // Update
                    var updateSql = @"
                        UPDATE messages SET
                            priority = @Priority,
                            messagetype = @MessageType,
                            sender = @Sender,
                            recipients = @Recipients,
                            recipientscc = @RecipientsCC,
                            recipientsbcc = @RecipientsBCC,
                            subject = @Subject,
                            body = @Body,
                            sentdate = @SentDate,
                            receiveddate = @ReceivedDate
                        WHERE id = @Id";
                    await db.ExecuteAsync(updateSql, new
                    {
                        Id = row.ID,
                        row.Priority,
                        row.MessageType,
                        row.Sender,
                        row.Recipients,
                        row.RecipientsCC,
                        row.RecipientsBCC,
                        row.Subject,
                        row.Body,
                        row.SentDate,
                        row.ReceivedDate
                    });
                }
                row.RowState = "CLEAN";
            }

            mDirty = false;
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SaveData error");

            Notifications.Error($"Error saving data: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Toolbar Handlers ===
    private async Task OnOpenClick()
    {
        if (!await SaveData(true)) return;
        await LoadJob("");
    }

    private async Task OnSaveClick()
    {
        await SaveData(false);
    }

    // === Priority Click (cycles 0 → 1 → 2 → 0) ===
    private void OnPriorityClick(MessageRow row)
    {
        if (row.MessageType == "Email") return;

        row.Priority = row.Priority switch
        {
            0 => 1,
            1 => 2,
            2 => 0,
            _ => 0
        };
        MarkDirty(row);
        StateHasChanged();
    }



    // === Open Original Email ===
    // VB6: ShellFile(Me.hwnd, "c:\demo\files\" & ID & ".msg")
    private async Task OnOpenOriginal(MessageRow row)
    {
        if (row.MessageType != "Email" || string.IsNullOrEmpty(row.ID)) return;

        try
        {
            // Retrieve the original email file path from the database
            var sql = "SELECT Original FROM messages WHERE id = @Id";
            var rows = await db.QueryAsync(sql, new { Id = row.ID });
            var firstRow = rows.FirstOrDefault();
            var filePath = firstRow?["Original"]?.ToString() ?? "";

            if (string.IsNullOrEmpty(filePath))
            {
                // Fallback: construct path from ID as VB6 did
                filePath = $"{row.ID}.msg";
            }

            // In a web context, open the file via a download/viewer endpoint
            await JSRuntime.InvokeVoidAsync("open", $"/api/files/email/{row.ID}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnOpenOriginal error");

        }
    }

    // === Contact Picker ===
    private static bool CanShowMessagePickerButton(object row)
        => row is MessageRow { MessageType: not "Email" };

    private async Task OnMessagesEditButtonClick(CellEditButtonArgs<MessageRow> args)
    {
        if (args.Data == null || args.Data.MessageType == "Email")
            return;

        switch (args.ColumnName)
        {
            case nameof(MessageRow.Sender):
            case nameof(MessageRow.Recipients):
            case nameof(MessageRow.RecipientsCC):
            case nameof(MessageRow.RecipientsBCC):
                await OnPickContact(args.Data, args.ColumnName);
                break;
        }
    }

    private async Task OnPickContact(MessageRow row, string field)
    {
        ContactPickerTargetRow = row;
        ContactPickerTargetField = field;
        _pickListContext = "Contact";

        if (_pickList != null)
        {
            await _pickList.Open(
                title: "Contact",
                // VB6 PickContacts (FJobCorrespondence.frm:467) hides no columns.
                queries: "SELECT * FROM addressbook ORDER BY Name",
                multiSelect: true
            );
        }
    }

    private async Task OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        var ctx = _pickListContext;
        _pickListContext = "";

        try
        {
            if (ctx == "Jobs")
            {
                if (selectedRows.Count == 0) return;
                var pick = selectedRows[0];
                var selectedJob = pick.TryGetValue("Job", out var val) ? val?.ToString() ?? "" : "";
                if (string.IsNullOrEmpty(selectedJob))
                {
                    selectedJob = pick.TryGetValue("job", out val) ? val?.ToString() ?? "" : "";
                }
                if (!string.IsNullOrEmpty(selectedJob))
                {
                    await LoadJob(selectedJob);
                }
            }
            else if (ctx == "Contact")
            {
                if (ContactPickerTargetRow == null || selectedRows.Count == 0) return;

                // Picklist rows are ExpandoObjects, so the keys carry the DB column casing.
                var names = selectedRows
                    .Select(r => r.FirstOrDefault(kv => string.Equals(kv.Key, "Name", StringComparison.OrdinalIgnoreCase))
                                  .Value?.ToString() ?? "")
                    .Where(n => !string.IsNullOrEmpty(n))
                    .ToList();

                if (names.Count == 0) return;

                var contactString = string.Join("; ", names);

                switch (ContactPickerTargetField)
                {
                    case nameof(MessageRow.Sender):
                        ContactPickerTargetRow.Sender = contactString;
                        break;
                    case nameof(MessageRow.Recipients):
                        ContactPickerTargetRow.Recipients = contactString;
                        break;
                    case nameof(MessageRow.RecipientsCC):
                        ContactPickerTargetRow.RecipientsCC = contactString;
                        break;
                    case nameof(MessageRow.RecipientsBCC):
                        ContactPickerTargetRow.RecipientsBCC = contactString;
                        break;
                }

                MarkDirty(ContactPickerTargetRow);
                StateHasChanged();
            }
        }
        finally
        {
            if (MessagesGrid != null)
            {
                await MessagesGrid.ResumeKeyboardNavigationAsync();
            }
        }
    }

    private async Task OnPickListCancelled()
    {
        _pickListContext = "";
        if (MessagesGrid != null)
        {
            await MessagesGrid.ResumeKeyboardNavigationAsync();
        }
    }

    // === Trailing New Row (HHM-465, mirrors VB6's blank .Rows-1 row) ===
    // A fresh blank placeholder is left CLEAN so SaveData skips it until the user
    // actually types into it (which promotes it via MarkDirty).
    private MessageRow CreatePlaceholderRow() => new()
    {
        ID = "",
        IsInlineNewRow = true,
        RowState = "CLEAN",
        IsDeleted = false,
        MessageType = "Other",
        Priority = 1,
        ReceivedDate = DateTime.Today
    };

    private bool IsInlineNewRow(MessageRow row) => row.IsInlineNewRow;

    // Only spawn a new blank once the current placeholder holds real content.
    private bool CanAppendInlineNewRowAfter(MessageRow row)
        => !row.IsInlineNewRow || RowHasMeaningfulValue(row);

    private static bool RowHasMeaningfulValue(MessageRow row)
        => !string.IsNullOrWhiteSpace(row.Sender)
           || !string.IsNullOrWhiteSpace(row.Recipients)
           || !string.IsNullOrWhiteSpace(row.RecipientsCC)
           || !string.IsNullOrWhiteSpace(row.RecipientsBCC)
           || !string.IsNullOrWhiteSpace(row.Subject)
           || !string.IsNullOrWhiteSpace(row.Body)
           || row.Priority != 0
           || !string.IsNullOrEmpty(row.MessageType)
           || row.SentDate.HasValue
           || row.ReceivedDate.HasValue;

    // === Save-prompt dialog (HHM-454, mirrors VB6 MsgBox vbYesNoCancel) ===
    private async Task<bool?> ShowSavePromptDialog()
    {
        if (_messageBox == null)
            return null;

        var result = await _messageBox.ShowAsync(
            "This data has changed.\n\nDo you want to save these changes?",
            title: "HomeFront",
            buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel);

        return result switch
        {
            Fx.ControlKit.Dialogs.MessageBoxResult.Yes => true,
            Fx.ControlKit.Dialogs.MessageBoxResult.No => false,
            _ => null
        };
    }

    // === Before-edit veto (mirrors VB6 gMessages_BeforeEdit) ===
    // HHM-454: VB6 cancels the edit outright for Email rows — every column of an
    // Email row is read-only. Previously the in-cell editor still opened and the
    // change was only discarded on save, which read as a functionality mismatch.
    private void OnCellBeginEdit(CellEditArgs<MessageRow> args)
    {
        if (args.Data != null)
        {
            if (args.Data.MessageType == "Email")
            {
                args.Cancel = true;
                return;
            }

        }
    }

    // === Cell Save Event (mirrors VB6 gMessages_ValidateEdit) ===
    private void OnCellSaved(CellSaveArgs<MessageRow> args)
    {
        if (args.Data != null)
        {
            var column = args.ColumnName;

            // VB6: validate date fields - if not a valid date, cancel the edit
            if (column == nameof(MessageRow.SentDate) || column == nameof(MessageRow.ReceivedDate))
            {
                if (args.Value is string dateStr && !string.IsNullOrEmpty(dateStr))
                {
                    if (!DateTime.TryParse(dateStr, out _))
                    {
                        // Invalid date — ignore the edit
                        return;
                    }
                }
            }

            // VB6: email rows are read-only — ignore edits
            if (args.Data.MessageType == "Email")
            {
                return;
            }

            MarkDirty(args.Data);
        }
    }

    // === Helpers ===
    private void MarkDirty(MessageRow row)
    {
        // HHM-465: first edit of the trailing placeholder promotes it to a real row,
        // seeding the VB6 gMessages_StartEdit defaults (Priority=1 / MessageType="Other"
        // / ReceivedDate=Today) without clobbering the value the user just entered.
        if (row.IsInlineNewRow)
        {
            row.IsInlineNewRow = false;
            if (row.Priority == 0) row.Priority = 1;
            if (string.IsNullOrEmpty(row.MessageType)) row.MessageType = "Other";
            row.ReceivedDate ??= DateTime.Today;
        }

        row.RowState = "DIRTY";
        mDirty = true;
        StateHasChanged();
    }

    private int SafeInt(object? val, int def = 0)
    {
        if (val == null || val == DBNull.Value) return def;
        var s = val.ToString() ?? "";
        return int.TryParse(s, out var result) ? result : def;
    }

    private DateTime? SafeDate(object? val)
    {
        if (val == null || val == DBNull.Value) return null;
        var s = val.ToString() ?? "";
        return DateTime.TryParse(s, out var result) ? result : null;
    }

    // ── Load Grid Layout ──────────────────────────────────────
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            // The keyed/unkeyed fallback + Version bump live in the presenter
            // (its ctor was given the "FJobCorrespondence"/"gMessages" names + instanceKey "(0)").
            await _messagesGrid.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");

        }
    }

    // ── Persist Grid Layout (VB6: IniPutGrid) ─────────────────
    // GridControl raises OnLayoutChanged when a resize/reorder/hide/rename finishes.
    // The new widths live on the snapshot, not in the presenter's layout dict, so
    // they have to be merged in before the save.
    private async Task OnMessagesLayoutChangedAsync(GridSettings snapshot)
    {
        if (snapshot == null || gMessagesLayout.Count == 0) return;

        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FJobCorrespondence", "gMessages", instanceKey: "(0)",
                gMessagesLayout, snapshot, ResolveGridField);

            _messagesGrid.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FJobCorrespondence gMessages layout");
        }
    }

    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedGridLayout()
    {
        if (!HasGridLayout) yield break;

        // HHM-454/458: VB6 IniGetGrid (MMisc.bas) applies a saved AppGridLayout entry
        // ONLY when its colkey matches an existing grid column (rows with
        // ColIndex(colkey) = -1 are skipped) — a layout can reorder/resize/hide the
        // FormatString's columns but can never ADD one. Mirror that guard: only
        // colkeys resolving to a legacy text column (LayoutRenderableFields) render.
        // This both keeps the fixed Priority / Original / Attachments icon columns
        // from duplicating as plain-text columns (raw priority integer / "Original"
        // caption — the stray "1" / "Original" columns QA reported) AND drops any
        // unknown/stale colkey a seeded layout might carry.
        var ordered = gMessagesLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden
                        && LayoutRenderableFields.Contains(ResolveGridField(c.Field)))
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = ResolveGridField(layout.Field);
            var columnType = GetColumnTypeForField(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    // Delegated: the alias switch moved verbatim to the presenter ctor's alias map.
    private string ResolveGridField(string layoutField)
        => _messagesGrid.ResolveField(layoutField);

    // DRIFT (preserved): maps bool → ColumnType.CheckBox (canonical presenter uses
    // ColumnType.Boolean). MessageRow has bool columns (HasAttachments / IsDeleted), so
    // this stays local — see the note on the presenter field above.
    private static ColumnType GetColumnTypeForField(string field)
    {
        if (string.IsNullOrWhiteSpace(field)) return ColumnType.Text;
        if (_messageRowPropMap.TryGetValue(NormalizeGridKey(field), out var prop))
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool)) return ColumnType.CheckBox;
            if (type == typeof(int) || type == typeof(long) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
            if (type == typeof(DateTime)) return ColumnType.Date;
        }
        return ColumnType.Text;
    }

    private static bool IsFieldEditable(string field)
    {
        return field switch
        {
            "ID" or "RowState" or "IsDeleted" or "HasAttachments" or "Original" or "Attachments" or "Size"
                or "Priority" => false,
            _ => true
        };
    }

    // HHM-454/458: the ONLY fields the AppGridLayout-driven loop may render — the
    // VB6 gMessages text columns (FJobCorrespondence.frm colkeys, minus the fixed
    // icon columns Priority / Original / Attachments and the hidden ID key, which
    // are rendered once as fixed GridColumns in the markup). Mirrors VB6
    // IniGetGrid's "existing column only" rule — see GetOrderedGridLayout.
    private static readonly HashSet<string> LayoutRenderableFields = new(StringComparer.OrdinalIgnoreCase)
    {
        nameof(MessageRow.MessageType),
        nameof(MessageRow.Sender),
        nameof(MessageRow.Recipients),
        nameof(MessageRow.RecipientsCC),
        nameof(MessageRow.RecipientsBCC),
        nameof(MessageRow.Subject),
        nameof(MessageRow.Body),
        nameof(MessageRow.Size),
        nameof(MessageRow.SentDate),
        nameof(MessageRow.ReceivedDate)
    };

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // Still used by _messageRowPropMap + the local GetColumnTypeForField.
    private static string NormalizeGridKey(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var sb = new StringBuilder(value.Length);
        foreach (var ch in value)
        {
            if (char.IsLetterOrDigit(ch))
                sb.Append(char.ToLowerInvariant(ch));
        }
        return sb.ToString();
    }

