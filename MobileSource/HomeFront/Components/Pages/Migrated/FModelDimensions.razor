    private void CloseContextMenus()
    {
        showModelsContextMenu = false;
        showCategoriesContextMenu = false;
    }

    // ── Button Handlers (VB6: cmdNav_Click) ──────────────────
    // Index 0 = Save → SaveData(False).
    private async Task OnSaveClick()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            await SaveData(false);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    // Index 1 = Close → If SaveData(True) Then Unload. Also the dialog X /
    // Form_Unload path (VB6 Form_Unload cancels close if SaveData fails).
    private async Task OnCloseClick()
    {
        if (await SaveData(true))
        {
            SetDirty(false);
            Close();
        }
    }

    // ── Save Data (VB6: SaveData) ────────────────────────────
    private async Task<bool> SaveData(bool prompt)
    {
        // VB6: If Not mDirty Then SaveData = True : Exit Function
        if (!mDirty) return true;

        if (prompt)
        {
            // VB6: MsgBox("This data has changed... save?", YesNoCancel)
            //   No     → SaveData = True (discard, proceed)
            //   Cancel → SaveData = False (abort caller)
            //   Yes    → fall through and save
            var result = _messageBox != null
                ? await _messageBox.ShowAsync(
                    "This data has changed.\n\nDo you want to save these changes?",
                    title: "Save changes?",
                    buttons: MessageBoxButtons.YesNoCancel)
                : (await Dialogs.ConfirmAsync(
                        "This data has changed.\n\nDo you want to save these changes?")
                    ? MessageBoxResult.Yes
                    : MessageBoxResult.No);

            if (result == MessageBoxResult.Cancel) return false;
            if (result == MessageBoxResult.No) return true;
            // Yes → save below
        }

        try
        {
            // VB6: For r = 1 To .Rows-1 : If .RowData(r)="dirty" Then UPDATE.
            foreach (var row in CategoriesData.Where(r => r.RowState == "dirty"))
            {
                var sql = @"UPDATE RoomQtyByModel SET qty = @Qty
                            WHERE model = @Model
                              AND roomid = @RoomId
                              AND subcategory = @SubCategory
                              AND uom = @UOM";
                await db.ExecuteAsync(sql, new
                {
                    Qty = row.Qty,
                    Model = mModel,
                    RoomId = row.RoomId,
                    SubCategory = row.SubCategory,
                    UOM = row.UOM
                });
                row.RowState = "CLEAN";
            }

            SetDirty(false);
            return true;
        }
        catch (Exception ex)
        {
            // VB6 error handler: ignore "duplicate" errors (Resume Next).
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
            Logger.LogError(ex, "SaveData error");
            Notifications.Error($"Error saving data: {ex.Message}");
            return false;
        }
    }

    // ── Delete Model (VB6: DeleteModel) ──────────────────────
    // VB6 gModels_KeyDown (FModelDimensions.frm:367-373): Delete + any modifier
    // (Shift <> 0 covers Shift/Ctrl/Alt) deletes the current model's dimensions,
    // with the same confirmation prompt (HHM-630).
    private async Task OnModelsKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key != "Delete" || !(e.CtrlKey || e.ShiftKey || e.AltKey)) return;
        if (SelectedModel == null) return;
        await OnDeleteModelClick();
    }

    private async Task OnDeleteModelClick()
    {
        CloseContextMenus();
        if (SelectedModel == null) return;

        // VB6: MsgBox("Are you sure you want to delete the dimensions for this model?", YesNo)
        var confirm = _messageBox != null
            ? await _messageBox.ShowAsync(
                "Are you sure you want to delete the dimensions for this model?",
                title: "Precision Builder",
                buttons: MessageBoxButtons.YesNo)
            : (await Dialogs.ConfirmAsync(
                    "Are you sure you want to delete the dimensions for this model?")
                ? MessageBoxResult.Yes
                : MessageBoxResult.No);
        if (confirm != MessageBoxResult.Yes) return;

        try
        {
            // VB6: update RoomQtyByModel set inactive=1 where model=...
            var sql = "UPDATE RoomQtyByModel SET inactive = 1 WHERE model = @Model";
            await db.ExecuteAsync(sql, new { Model = SelectedModel.Model });

            // VB6: RemoveItem + Select next visible row + LoadModel that row.
            ModelsData.Remove(SelectedModel);

            if (ModelsData.Count > 0)
            {
                SelectedModel = ModelsData[0];
                mModel = SelectedModel.Model;
                await LoadModel(mModel);
                if (gModels != null) gModels.SelectRow(0);
            }
            else
            {
                SelectedModel = null;
                mModel = "";
                CategoriesData = new();
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "DeleteModel error");
            Notifications.Error($"Error deleting model: {ex.Message}");
        }
    }

    // ── Remove Room (VB6: DeleteRoom) ────────────────────────
    private async Task OnRemoveRoomClick()
    {
        CloseContextMenus();
        var target = HasSelectedCategoryForRemove ? SelectedCategory : null;
        if (target == null) return;

        // VB6 mnuCATEGORIES_REMOVEROOM: SaveData(False), DeleteRoom, LoadModel.
        await SaveData(false);

        try
        {
            // VB6: update RoomQtyByModel set inactive=1 where model=.. and roomid=..
            var sql = @"UPDATE RoomQtyByModel SET inactive = 1
                        WHERE model = @Model AND roomid = @RoomId";
            await db.ExecuteAsync(sql, new { Model = mModel, RoomId = target.RoomId });
            await LoadModel(mModel);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "RemoveRoom error");
            Notifications.Error($"Error removing room: {ex.Message}");
        }
    }

    // ── Add Model (VB6: mnuMODEL_ADDMODEL → FPickList.Choose "Model") ──
    private async Task OnAddModelClick()
    {
        CloseContextMenus();
        try
        {
            // VB6 query for the Model picker.
            var sql = @"SELECT model, MIN(description) AS description
                        FROM tbldbassemblymaster
                        WHERE divisionid = @DivisionID
                          AND assemblytype = 0 AND isbaseassembly = 0 AND inactive = 0
                        GROUP BY model";
            _pickListContext = "AddModel";
            if (pickList != null)
            {
                await pickList.Open(
                    title: "Model",
                    queries: sql,
                    multiSelect: false,
                    parameters: new Dictionary<string, object> { ["DivisionID"] = SessionState.DivisionID });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AddModel picker error");
            Notifications.Error($"Error loading models: {ex.Message}");
        }
    }

    // ── Add Room (VB6: mnuMODEL_ADDROOM → FPickList.Choose "Room") ──
    private async Task OnAddRoomFromModelsClick()
    {
        CloseContextMenus();
        if (SelectedModel == null) return;
        await ShowAddRoomDialog();
    }

    private async Task OnAddRoomFromCategoriesClick()
    {
        // VB6 mnuCATEGORIES_ADDROOM just calls mnuMODEL_ADDROOM.
        CloseContextMenus();
        if (string.IsNullOrEmpty(mModel)) return;
        await ShowAddRoomDialog();
    }

    private async Task ShowAddRoomDialog()
    {
        try
        {
            // VB6 query for the Room picker (DISTINCT, multi-select, key=RoomID).
            var sql = @"SELECT DISTINCT r.RoomID, r.Room
                        FROM RoomMasterSubCategory c
                        JOIN RoomMaster r ON r.roomid = c.roomid
                        WHERE ISNULL(r.inactive, 0) = 0 AND divisionid = @DivisionID
                        ORDER BY 1 ASC";
            _pickListContext = "AddRoom";
            if (pickList != null)
            {
                // VB6: FPickList.Choose(..., "Room", s, , , , , "RoomID", True) — RoomID is a
                // HIDDEN key column, so the legacy picker shows the single Room column (HHM-181).
                await pickList.Open(
                    title: "Room",
                    queries: sql,
                    hideColumns: "RoomID",
                    multiSelect: true,
                    parameters: new Dictionary<string, object> { ["DivisionID"] = SessionState.DivisionID });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AddRoom picker error");
            Notifications.Error($"Error loading rooms: {ex.Message}");
        }
    }

    // ── FPickList callback (VB6: FPickList.SelectedItem / SelectedItems) ──
    private async Task OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        var context = _pickListContext;
        _pickListContext = "";

        if (selectedRows == null || selectedRows.Count == 0) return;

        if (context == "AddModel")
        {
            await HandleAddModelPicked(selectedRows[0]);
            return;
        }

        if (context == "AddRoom")
        {
            await HandleAddRoomPicked(selectedRows);
            return;
        }
    }

    // VB6 mnuMODEL_ADDMODEL: SaveData(False), AddItem the picked model row to
    // gModels, Select it, then chain into mnuMODEL_ADDROOM.
    private async Task HandleAddModelPicked(IDictionary<string, object> picked)
    {
        var model = GetRowString(picked, "model");
        var description = GetRowString(picked, "description");
        if (string.IsNullOrEmpty(model)) return;

        await SaveData(false);

        if (!ModelsData.Any(m => string.Equals(m.Model, model, StringComparison.OrdinalIgnoreCase)))
        {
            ModelsData.Add(new ModelRow { Model = model, Description = description });
            ModelsData = ModelsData.ToList(); // rebind for grid re-render
        }

        SelectedModel = ModelsData.First(m => string.Equals(m.Model, model, StringComparison.OrdinalIgnoreCase));
        mModel = SelectedModel.Model;
        StateHasChanged();

        // VB6: immediately chains to Add Room for the new model.
        await ShowAddRoomDialog();
    }

    // VB6 mnuMODEL_ADDROOM: SaveData(False), build comma id list, INSERT
    // missing RoomMasterSubCategory rows + reactivate (inactive=0) existing
    // ones, then LoadModel.
    private async Task HandleAddRoomPicked(List<IDictionary<string, object>> selectedRows)
    {
        if (SelectedModel == null) return;

        await SaveData(false);

        try
        {
            // Build a parameterized IN-list of RoomIDs (ints) so no value is
            // interpolated raw. VB6 built "in(1,2,3)" by string concat.
            var roomIds = selectedRows
                .Select(r => GetRowString(r, "RoomID"))
                .Where(id => !string.IsNullOrWhiteSpace(id) && int.TryParse(id, out _))
                .Select(int.Parse)
                .Distinct()
                .ToList();
            if (roomIds.Count == 0) return;

            var modelValue = SelectedModel.Model;
            var prms = new Dictionary<string, object> { ["Model"] = modelValue };
            var inParams = new List<string>();
            for (int i = 0; i < roomIds.Count; i++)
            {
                var p = $"@Room{i}";
                inParams.Add(p);
                prms[$"Room{i}"] = roomIds[i];
            }
            var inClause = string.Join(",", inParams);

            // VB6: INSERT the room/subcategory/uom rows that don't yet exist.
            var insertSql = $@"INSERT INTO RoomQtyByModel(RoomID, Model, SubCategory, UOM, Qty)
                               SELECT q.RoomID, @Model, q.subcategory, q.uom, 0
                               FROM RoomMasterSubCategory q
                               LEFT OUTER JOIN roomQtyByModel m
                                   ON m.model = @Model AND m.roomid = q.roomid
                                   AND m.subcategory = q.subcategory AND m.uom = q.uom
                               WHERE m.roomid IS NULL
                                 AND q.roomID IN ({inClause})";
            await db.ExecuteAsync(insertSql, prms);

            // VB6: reactivate any previously inactivated rows for those rooms.
            var updateSql = $@"UPDATE m SET inactive = 0
                               FROM RoomMasterSubCategory q
                               JOIN roomQtyByModel m
                                   ON m.model = @Model AND m.roomid = q.roomid
                                   AND m.subcategory = q.subcategory AND m.uom = q.uom
                               WHERE q.roomID IN ({inClause})";
            await db.ExecuteAsync(updateSql, prms);

            await LoadModel(modelValue);
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
            {
                await LoadModel(mModel);
            }
            else
            {
                Logger.LogError(ex, "AddRoom error");
                Notifications.Error($"Error adding rooms: {ex.Message}");
            }
        }
    }

    private static string GetRowString(IDictionary<string, object> row, string key)
    {
        // Case-insensitive lookup — FPickList returns columns named exactly
        // as the SQL aliases (model, description, RoomID), but be defensive.
        if (row.TryGetValue(key, out var v) && v != null && v != DBNull.Value)
            return v.ToString() ?? "";
        var match = row.Keys.FirstOrDefault(k => string.Equals(k, key, StringComparison.OrdinalIgnoreCase));
        if (match != null && row[match] != null && row[match] != DBNull.Value)
            return row[match]!.ToString() ?? "";
        return "";
    }
}
