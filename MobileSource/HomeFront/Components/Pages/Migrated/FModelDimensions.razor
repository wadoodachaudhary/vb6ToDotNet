@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - Initial port from VB6
     - 2026-06-12: Full FlexKit conversion — DialogControl shell,
       FPickList for Model/Room pickers, MessageBoxControl for the
       MsgBox confirms (no JS confirm), ButtonControl footer.
     - 2026-06-12: Fix blank-screen when reached via the Setup menu
       route (/model-dimensions). The form is dual-hosted: FAssembly
       embeds it as an @ref modal (opened on demand via Open()), and
       FMain mounts it as a standalone route page. The route path never
       called Open(), so _isVisible stayed false and the DialogControl
       rendered nothing. Added an [Parameter] Embedded flag + an
       OnInitializedAsync that auto-opens (VB6 Form_Load → LoadModels)
       when NOT embedded — mirrors the FAttributeLists dual-host pattern.
   VB6 source  : HFEst/Source/FModelDimensions.frm
   ───────────────────────────────────────────────────────────────── *@
@page "/model-dimensions"
@namespace HomeFront.Components.Pages
@using HomeFront.Data
@using HomeFront.Services
@using HomeFront.Models
@using System.Data
@using Fx.ControlKit
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject ILogger<FModelDimensions> Logger
@inject NotificationService Notifications
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject IUserPreferencesService Prefs
@inject DbWrapperSqlServer db
@layout HFComponent

@* ── Main form (VB6: FModelDimensions form, vbModal) ───────────────── *@
@* ── Shell (user directive 2026-07-13): forms launched from the MENU/taskbar are
   NON-MODAL and get their own MDI surface — only the FAssembly-embedded use keeps
   the VB6 vbModal dialog (FModelDimensions.frm:302 Me.Show vbModal via
   lblModelDimensions_Click). The routed page renders the same body flat in its
   own pane, closing through ParentNavigate like every other MDI form. *@
@{
    RenderFragment modelDimBody = @<text>
        @if (IsLoading)
        {
            <div class="modeldim-loading-overlay">
                <div class="modeldim-loading-spinner">Loading...</div>
            </div>
        }

        <div class="model-dimensions-container">
            <div class="grids-container" @onmousemove="OnSplitterDrag" @onmouseup="EndSplitterDrag" @onmouseleave="EndSplitterDrag">
                @* ── Left Panel: Models Grid (VB6: gModels) ────────────── *@
                <div class="models-panel" style="width:@(ModelsPanelWidthPx)px;"
                     @oncontextmenu="OnModelsContextMenu" @oncontextmenu:preventDefault="true"
                     @onkeydown="OnModelsKeyDown">
                    <GridControl @ref="gModels"
                                 TValue="ModelRow"
                                 DataSource="@ModelsData"
                                 AllowSelection="true"
                                 AllowSorting="true"
                                 AllowResizing="true"
                                 EnableHover="true"
                                 Height="100%"
                                 WidthMode="GridWidthMode.FitColumns"
                                 SelectionSettingsRef="@modelsSelectionSettings"
                                 EventsRef="@modelsGridEvents"
                                 OnLayoutChanged="@OnModelsLayoutChangedAsync">
                        <GridColumnsBase @key="ModelsGridLayoutVersion" DebugTag="FModelDimensions-gModels">
                            @if (ModelsGridLayout.Count > 0)
                            {
                                @foreach (var col in GetOrderedGridLayout(ModelsGridLayout))
                                {
                                    var headerText = ModelDimensionHeaderText(col.Field, col.Caption);
                                    var width = col.Width.HasValue && col.Width.Value > 0
                                        ? $"{ConvertLayoutWidthToPx(col.Width.Value)}px" : null;
                                    var isPK = col.Field.Equals("Model", StringComparison.OrdinalIgnoreCase);
                                    <GridColumn Field="@col.Field" HeaderText="@headerText" Width="@width"
                                                IsPrimaryKey="@isPK" AllowEditing="false" Visible="@(!col.Hidden)" />
                                }
                            }
                            else
                            {
                                @* Fallback hardcoded columns if no layout in DB *@
                                <GridColumn Field="Model" HeaderText="Model" Width="120px"
                                            IsPrimaryKey="true" AllowEditing="false" />
                                <GridColumn Field="Description" HeaderText="Description" Width="250px"
                                            AllowEditing="false" />
                            }
                        </GridColumnsBase>
                    </GridControl>
                </div>

                @* VB6 Slider between gModels and gCategories. Dragging it scales the
                   Models columns, so the panel is always exactly as wide as its
                   columns and no gap opens up between them. *@
                <div class="models-splitter @(_splitterDragging ? "dragging" : "")"
                     @onmousedown="StartSplitterDrag" @onmousedown:preventDefault="true"></div>

                @* ── Right Panel: Categories Grid (VB6: gCategories) ────── *@
                <div class="categories-panel" @oncontextmenu="OnCategoriesContextMenu" @oncontextmenu:preventDefault="true">
                    <GridControl @ref="gCategories"
                                 TValue="CategoryRow"
                                 DataSource="@CategoriesData"
                                 AllowSelection="true"
                                 AllowSorting="true"
                                 AllowResizing="true"
                                 AllowFiltering="false"
                                 EnableHover="true"
                                 Height="100%"
                                 SelectionSettingsRef="@categoriesSelectionSettings"
                                 EditSettingsRef="@categoriesEditSettings"
                                 EventsRef="@categoriesGridEvents"
                                 TypeAheadTargetField="Qty"
                                 OnLayoutChanged="@OnCategoriesLayoutChangedAsync">
                        <GridColumnsBase @key="CategoriesGridLayoutVersion" DebugTag="FModelDimensions-gCategories">
                            @if (CategoriesGridLayout.Count > 0)
                            {
                                @foreach (var col in GetOrderedGridLayout(CategoriesGridLayout))
                                {
                                    var headerText = ModelDimensionHeaderText(col.Field, col.Caption);
                                    var width = col.Width.HasValue && col.Width.Value > 0
                                        ? $"{ConvertLayoutWidthToPx(col.Width.Value)}px" : null;
                                    var isQty = col.Field.Equals("Qty", StringComparison.OrdinalIgnoreCase);
                                    @* HHM-115 (2026-07-24 reopen): the Qty HEADER is right-
                                       aligned in legacy too, not just the cells. *@
                                    <GridColumn Field="@col.Field" HeaderText="@headerText" Width="@width"
                                                Type="@(isQty ? ColumnType.Number : ColumnType.Text)"
                                                Format="@(isQty ? "0.##" : null)"
                                                TextAlign="@(isQty ? TextAlign.Right : TextAlign.Left)"
                                                HeaderTextAlign="@(isQty ? TextAlign.Right : TextAlign.Left)"
                                                AllowEditing="@isQty" Visible="@(!col.Hidden)" />
                                }
                            }
                            else
                            {
                                @* Fallback hardcoded columns *@
                                <GridColumn Field="RoomId" HeaderText="RoomID" Width="80px"
                                            Visible="false" AllowEditing="false" />
                                <GridColumn Field="Room" HeaderText="Room" Width="120px"
                                            AllowEditing="false" />
                                <GridColumn Field="CatDesc" HeaderText="Category" Width="180px"
                                            AllowEditing="false" />
                                <GridColumn Field="SubCategory" HeaderText="SubCategory" Width="120px"
                                            Visible="false" AllowEditing="false" />
                                <GridColumn Field="UOM" HeaderText="UOM" Width="80px"
                                            AllowEditing="false" />
                                <GridColumn Field="Qty" HeaderText="Qty" Width="80px"
                                            Type="ColumnType.Number" Format="0.##" TextAlign="TextAlign.Right"
                                            HeaderTextAlign="TextAlign.Right"
                                            AllowEditing="true" />
                            }
                        </GridColumnsBase>
                    </GridControl>
                </div>
            </div>
        </div>
    </text>;
    RenderFragment modelDimFooter = @<text>
        @* VB6: cmdNav(0)=Save (enabled only when dirty), cmdNav(1)=Close —
           both are plain VB6 command buttons (no accent colour). *@
        <ButtonControl CssClass="fx-button-classic"
                       Disabled="@(!mDirty || _isSaving)"
                       OnClick="OnSaveClick">Save</ButtonControl>
        <ButtonControl CssClass="fx-button-classic" OnClick="OnCloseClick">Close</ButtonControl>
    </text>;
}

@if (Embedded)
{
    @* HHM-115: VB6 design size (15210x5385 twips ≈ 1015x420 client+chrome) and the
       window icon; resizable + IniGetForm-restored like legacy.
       The .modeldim-dialog-host wrapper exists ONLY so this page's scoped-CSS
       ::deep rules gain a page-scoped ANCESTOR element (same pattern as
       FPickList's .picklist-dialog-host) — without it the DialogControl is the
       branch root and every ::deep .modeldim-dialog rule (body padding, black
       header text, legacy window icon) silently never matches. *@
    <div class="modeldim-dialog-host">
        <DialogControl Visible="_isVisible"
                       Header="Model Dimensions"
                       Width="1015px"
                       Height="420px"
                       IsModal="true"
                       ShowCloseIcon="true"
                       ShowWindowIcon="true"
                       Resizable="true"
                       CssClass="fx-dialog-classic modeldim-dialog"
                       OnClose="OnCloseClick">
            <ChildContent>@modelDimBody</ChildContent>
            <FooterContent>@modelDimFooter</FooterContent>
        </DialogControl>
    </div>
}
else if (_isVisible)
{
    <div class="modeldim-page">
        <div class="modeldim-page-body">@modelDimBody</div>
        <div class="modeldim-page-footer">@modelDimFooter</div>
    </div>
}

@if (_isVisible)
{
    <ContextMenuControl Visible="@showModelsContextMenu"
                        X="@contextMenuX"
                        Y="@contextMenuY"
                        MinWidth="180"
                        OnClose="CloseContextMenus">
        @if (string.IsNullOrEmpty(mOrigModel))
        {
            <ContextMenuItemControl Text="Add Model..." OnClick="OnAddModelClick" />
        }
        <ContextMenuItemControl Text="Add Room..." Disabled="@(SelectedModel == null)" OnClick="OnAddRoomFromModelsClick" />
        @if (string.IsNullOrEmpty(mOrigModel))
        {
            <ContextMenuSeparatorControl />
            <ContextMenuItemControl Text="Delete" Disabled="@(SelectedModel == null)" OnClick="OnDeleteModelClick" />
        }
    </ContextMenuControl>

    <ContextMenuControl Visible="@showCategoriesContextMenu"
                        X="@contextMenuX"
                        Y="@contextMenuY"
                        MinWidth="180"
                        OnClose="CloseContextMenus">
        <ContextMenuItemControl Text="Add Room..." Disabled="@(string.IsNullOrEmpty(mModel))" OnClick="OnAddRoomFromCategoriesClick" />
        <ContextMenuItemControl Text="Remove Room" Disabled="@(!HasSelectedCategoryForRemove)" OnClick="OnRemoveRoomClick" />
    </ContextMenuControl>
}

@* ── FlexKit pickers (VB6: FPickList.Choose) ──────────────────────── *@
<FPickList @ref="pickList" OnSelected="OnPickListSelected" />

@* ── FlexKit message box (VB6: MsgBox) ────────────────────────────── *@
<MessageBoxControl @ref="_messageBox" />

@code {
    // Standalone route close path: FMain cascades a ParentNavigate delegate;
    // calling it with "" closes the active MDI window (VB6 cmdNav(1) → Unload
    // Me). Null when the form runs embedded inside FAssembly — that path just
    // hides the dialog. (Mirrors FAttributeLists' close handling.)
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    // ── Host mode ────────────────────────────────────────────
    // The form is dual-hosted (mirrors FAttributeLists):
    //   • FAssembly embeds it as <FModelDimensions @ref="..." Embedded="true" />
    //     and opens it on demand via Open(model); the dialog stays hidden
    //     (_isVisible=false) until that click.
    //   • FMain mounts it as the standalone Setup-menu route
    //     (/model-dimensions) via DynamicComponent, passing NO parameters,
    //     so Embedded stays false → OnInitializedAsync auto-opens it
    //     (VB6 Form_Load → LoadModels). Without this the route path never
    //     called Open(), _isVisible stayed false, and DialogControl rendered
    //     an empty screen (the reported "no screen" bug).
    // NOTE: FAssembly MUST pass Embedded="true" on its @ref instance, else
    // that instance auto-pops the modal on every Assembly page load.
    [Parameter] public bool Embedded { get; set; } = false;

    // ── Visibility / state ───────────────────────────────────
    private bool _isVisible = false;
    private bool IsLoading = false;
    private bool mDirty = false;
    private bool _isSaving = false;
    private string mOrigModel = "";
    private string mModel = "";

    // ── Grid refs (VB6 names: gModels, gCategories) ──────────
    private GridControl<ModelRow>? gModels;
    private GridControl<CategoryRow>? gCategories;

    // ── Grid layout via the shared GridLayoutPresenter (VB6: IniGetGrid) ─
    // One presenter per grid; only the VB6 form/grid name strings stay here
    // (fidelity). ModelsGridLayout / CategoriesGridLayout / …Version below are
    // thin delegations so the markup is unchanged. Both grids load with
    // staticNames:true (VB6 IniGetGrid with the explicit column list).
    //
    // NOTE: GetOrderedGridLayout(layout) below is intentionally NOT delegated to
    // _g.GetOrdered(). This form's helper has a different SHAPE from FAssembly's
    // canonical one: it takes the layout dict as a PARAMETER (one helper shared by
    // both grids) and returns the raw GridLayoutColumn rows (including Hidden ones —
    // the markup applies Visible="@(!col.Hidden)" itself) with NO field-name
    // resolution (the markup binds col.Field directly and does its own per-grid
    // Type/PK/Format logic inline). The presenter's GetOrdered() returns a resolved
    // (Field, ColumnType, TextAlign) tuple per single grid, which doesn't match this
    // markup, so the helper stays local. Load/width are still delegated.
    private readonly GridLayoutPresenter<ModelRow> _modelsGrid =
        new("FModelDimensions", "gModels", staticNames: true);
    private readonly GridLayoutPresenter<CategoryRow> _categoriesGrid =
        new("FModelDimensions", "gCategories", staticNames: true);

    private Dictionary<string, GridLayoutColumn> ModelsGridLayout => _modelsGrid.Layout;
    private Dictionary<string, GridLayoutColumn> CategoriesGridLayout => _categoriesGrid.Layout;
    private int ModelsGridLayoutVersion => _modelsGrid.Version;
    private int CategoriesGridLayoutVersion => _categoriesGrid.Version;

    private static string ModelDimensionHeaderText(string field, string? caption)
    {
        var label = string.IsNullOrWhiteSpace(caption) ? field : caption.Trim();
        if (string.Equals(field, "Description", StringComparison.OrdinalIgnoreCase)
            || string.Equals(label, "description", StringComparison.OrdinalIgnoreCase))
            return "Description";
        if (string.Equals(field, "CatDesc", StringComparison.OrdinalIgnoreCase)
            || string.Equals(label, "CatDesc", StringComparison.OrdinalIgnoreCase))
            return "Category";
        return label;
    }

    // ── Data ─────────────────────────────────────────────────
    private List<ModelRow> ModelsData = new();
    private List<CategoryRow> CategoriesData = new();

    // ── Selection ────────────────────────────────────────────
    private ModelRow? SelectedModel;
    private CategoryRow? SelectedCategory;
    private bool HasSelectedCategoryForRemove =>
        SelectedCategory is not null && CategoriesData.Contains(SelectedCategory);

    // ── Context menu state ───────────────────────────────────
    private bool showModelsContextMenu = false;
    private bool showCategoriesContextMenu = false;
    private double contextMenuX = 0;
    private double contextMenuY = 0;

    // ── FlexKit picker + message box ─────────────────────────
    private FPickList? pickList;
    private MessageBoxControl? _messageBox;
    private string _pickListContext = "";

    // ── Grid settings ────────────────────────────────────────
    private SelectionSettings modelsSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    // VB6 gCategories: SelectionMode=0 (free cell) but AllowBigSelection
    // lets the user drag a range; gCategories_AfterEdit then marks every
    // row in [Row..RowSel] dirty. Multiple-row toggle reproduces that.
    private SelectionSettings categoriesSelectionSettings = new()
    {
        Type = SelectionType.Multiple,
        Mode = SelectionMode.Row,
        EnableToggle = true
    };

    // VB6 gCategories: Editable=2 (edit on demand), only the Qty column
    // is editable (gCategories_BeforeEdit cancels every other ColKey).
    private EditSettings categoriesEditSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch
    };

    private GridControlEvents<ModelRow> modelsGridEvents = new();
    private GridControlEvents<CategoryRow> categoriesGridEvents = new();

    // ── Data classes ─────────────────────────────────────────
    public class ModelRow
    {
        public string Model { get; set; } = "";
        public string Description { get; set; } = "";
    }

    public class CategoryRow
    {
        public string RoomId { get; set; } = "";
        public string Room { get; set; } = "";
        public string SubCategory { get; set; } = "";
        public string CatDesc { get; set; } = "";
        public double Qty { get; set; }
        public string UOM { get; set; } = "";
        public string RowState { get; set; } = "CLEAN";
    }

    // ── Lifecycle ────────────────────────────────────────────
    protected override void OnInitialized()
    {
        modelsGridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<ModelRow>>(this, OnModelRowSelected);
        categoriesGridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<CategoryRow>>(this, OnCategoryRowSelected);
        categoriesGridEvents.RowDeselected = EventCallback.Factory.Create<RowSelectEventArgs<CategoryRow>>(this, OnCategoryRowDeselected);
        categoriesGridEvents.SelectionChanged = EventCallback.Factory.Create<int>(this, OnCategorySelectionChanged);
        categoriesGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<CategoryRow>>(this, OnCategoryCellSaved);
        // Typing over a multi-row selection commits through OnTypeAheadCommit, not
        // OnCellSave — unsubscribed, the grid previewed the value and discarded it.
        categoriesGridEvents.OnTypeAheadCommit = EventCallback.Factory.Create<TypeAheadCommitArgs<CategoryRow>>(this, OnCategoryTypeAheadCommit);
    }

    // Standalone Setup-menu route (/model-dimensions): no host calls Open(),
    // so auto-open here. VB6 Form_Load → IniGetGrid + LoadModels with no
    // pre-set model (ShowForm() with the optional Model omitted → mModel="").
    // The embedded FAssembly instance passes Embedded="true" and drives
    // visibility itself via Open(model), so it must NOT auto-open.
    protected override async Task OnInitializedAsync()
    {
        if (!Embedded && !_isVisible)
        {
            await Open();
        }
    }

    // ── Public Open / Close (VB6: ShowForm; called from FAssembly) ──
    public async Task Open(string model = "")
    {
        _isVisible = true;
        mOrigModel = model;
        mModel = model;
        mDirty = false;
        _isSaving = false;
        SelectedModel = null;
        SelectedCategory = null;
        ModelsData = new();
        CategoriesData = new();
        CloseContextMenus();
        StateHasChanged();

        await LoadGridLayouts();
        InitModelsPanelWidth();
        await LoadModels();
        StateHasChanged();
    }

    private void Close()
    {
        _isVisible = false;
        CloseContextMenus();
        StateHasChanged();

        // VB6 cmdNav(1)/Form_Unload → Unload Me. When this form is the
        // standalone Setup-menu route, "unload" = close the MDI tab via the
        // FMain ParentNavigate cascade (otherwise the pane would just go
        // blank after hiding the dialog). When embedded in FAssembly, the
        // ParentNavigate cascade still reaches this child (it propagates to
        // every descendant of the active pane), so guard on Embedded — not
        // on ParentNavigate being null — to avoid closing FAssembly's tab.
        if (!Embedded)
        {
            ParentNavigate?.Invoke("");
        }
    }

    // ── Grid Layout Loading (VB6: IniGetGrid) ───────────────
    private async Task LoadGridLayouts()
    {
        await _modelsGrid.LoadAsync(GridLayoutSvc);
        await _categoriesGrid.LoadAsync(GridLayoutSvc);
    }

    // ── Grid layout persistence (VB6: IniPutGrid) ───────────
    // GridControl raises OnLayoutChanged when a resize/reorder/hide finishes.
    // The new widths live on the snapshot, not in the presenter's layout dict,
    // so they have to be merged in before the save — persisting the presenter
    // alone would write the widths it was loaded with.
    private Task OnModelsLayoutChangedAsync(GridSettings snapshot) =>
        PersistGridLayoutAsync("gModels", ModelsGridLayout, snapshot, _modelsGrid);

    private Task OnCategoriesLayoutChangedAsync(GridSettings snapshot) =>
        PersistGridLayoutAsync("gCategories", CategoriesGridLayout, snapshot, _categoriesGrid);

    private async Task PersistGridLayoutAsync<T>(string gridName,
        IDictionary<string, GridLayoutColumn> layout, GridSettings snapshot,
        GridLayoutPresenter<T> presenter)
    {
        if (snapshot == null || layout.Count == 0) return;
        try
        {
            // staticNames:true on both presenters — see the helper for why that
            // matters to the stored captions.
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FModelDimensions", gridName, instanceKey: null,
                layout, snapshot, layoutFieldResolver: null, staticNames: true);

            presenter.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FModelDimensions {Grid} layout", gridName);
        }
    }

    // Form-specific shape (see the NOTE on _modelsGrid): one helper shared by both
    // grids, takes the layout dict as a parameter and returns the raw ordered
    // columns (incl. Hidden) with no field resolution. NOT delegated to the
    // presenter, whose GetOrdered() returns a resolved tuple per single grid.
    private IEnumerable<GridLayoutColumn> GetOrderedGridLayout(Dictionary<string, GridLayoutColumn> layout)
    {
        return layout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field))
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase);
    }

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // ── Models panel / splitter ─────────────────────────────────────────
    // The columns are the single source of truth: the panel is exactly as wide as
    // them (plus the scrollbar gutter), so widening Description widens the panel
    // and no white space can open up between the last column and the splitter.
    // Dragging the splitter works the other way, scaling the columns to the width
    // the user asked for.
    private const int ModelsPanelChromePx = 2;    // panel border only — no slack
    private const int ModelsPanelMinPx = 160;     // floor the splitter cannot cross
    private const int ModelsColumnMinPx = 44;

    private const string PrefsSection = "FModelDimensions";

    private bool _splitterDragging;
    private double _splitterStartX;
    private int _splitterStartWidth;
    private int _modelsPanelPx;

    private int ModelsColumnsWidthPx => ModelsGridLayout.Count == 0
        ? 0
        : GetOrderedGridLayout(ModelsGridLayout)
            .Where(c => !c.Hidden && c.Width.HasValue && c.Width.Value > 0)
            .Sum(c => ConvertLayoutWidthToPx(c.Width!.Value));

    // Only the splitter sets the panel width. Deriving it from the columns meant a
    // column resize — and now a best fit — dragged the splitter across the form.
    private int ModelsPanelWidthPx => _modelsPanelPx > 0
        ? Math.Max(_modelsPanelPx, ModelsPanelMinPx)
        : 320;

    /// <summary>Seeds the panel from the stored column widths the first time this user
    /// opens the form, so nothing shifts until they actually move the splitter.</summary>
    private void InitModelsPanelWidth()
    {
        if (int.TryParse(Prefs.Get(PrefsSection, "ModelsPanelPx"), out var saved) && saved >= ModelsPanelMinPx)
        {
            _modelsPanelPx = saved;
            return;
        }

        var columns = ModelsColumnsWidthPx;
        if (columns > 0)
            _modelsPanelPx = Math.Max(columns + ModelsPanelChromePx, ModelsPanelMinPx);
    }

    private void StartSplitterDrag(MouseEventArgs e)
    {
        if (ModelsColumnsWidthPx <= 0) return;
        _splitterDragging = true;
        _splitterStartX = e.ClientX;
        _splitterStartWidth = ModelsPanelWidthPx;
    }

    private void OnSplitterDrag(MouseEventArgs e)
    {
        if (!_splitterDragging) return;
        // Button released outside the container — the mouseup never reached us.
        if ((e.Buttons & 1) == 0) { EndSplitterDrag(); return; }

        var target = _splitterStartWidth + (int)(e.ClientX - _splitterStartX);
        if (target < ModelsPanelMinPx) target = ModelsPanelMinPx;
        _modelsPanelPx = target;
        ScaleModelsColumnsTo(target - ModelsPanelChromePx);
    }

    private void ScaleModelsColumnsTo(int contentWidthPx)
    {
        var visible = GetOrderedGridLayout(ModelsGridLayout)
            .Where(c => !c.Hidden && c.Width.HasValue && c.Width.Value > 0).ToList();
        if (visible.Count == 0) return;

        var current = visible.Sum(c => ConvertLayoutWidthToPx(c.Width!.Value));
        if (current <= 0) return;
        var floor = visible.Count * ModelsColumnMinPx;
        if (contentWidthPx < floor) contentWidthPx = floor;
        var factor = (double)contentWidthPx / current;
        if (Math.Abs(factor - 1d) < 0.005) return;

        foreach (var col in visible)
        {
            var px = Math.Max(ModelsColumnMinPx, (int)Math.Round(ConvertLayoutWidthToPx(col.Width!.Value) * factor));
            col.Width = GridLayoutPersister.PixelsToLayoutWidth(px);
        }
        _modelsGrid.BumpVersion();
    }

    private void EndSplitterDrag()
    {
        if (!_splitterDragging) return;
        _splitterDragging = false;
        Prefs.Put(PrefsSection, "ModelsPanelPx", _modelsPanelPx.ToString());
        // Persist the widths the drag produced, same path a column resize uses.
        _ = PersistGridLayoutAsync("gModels", ModelsGridLayout, BuildModelsWidthSnapshot(), _modelsGrid);
    }

    private GridSettings BuildModelsWidthSnapshot() => new()
    {
        Widths = GetOrderedGridLayout(ModelsGridLayout)
            .Where(c => !c.Hidden && c.Width.HasValue && c.Width.Value > 0)
            .ToDictionary(c => c.Field, c => (double)ConvertLayoutWidthToPx(c.Width!.Value))
    };

    // ── Dirty (VB6: Property Let Dirty — toggles cmdNav(0).Enabled) ──
    private void SetDirty(bool value)
    {
        mDirty = value;
        StateHasChanged();
    }

    // ── Load Models (VB6: LoadModels) ────────────────────────
    private async Task LoadModels()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            string sql;
            object? parameters;

            if (!string.IsNullOrEmpty(mModel))
            {
                sql = @"SELECT model, MIN(description) AS description
                        FROM tbldbassemblymaster
                        WHERE assemblytype = 0 AND isbaseassembly = 0 AND inactive = 0
                          AND divisionid = @DivisionID AND model = @Model
                        GROUP BY model";
                parameters = new { SessionState.DivisionID, Model = mModel };
            }
            else
            {
                sql = @"SELECT q.model, MIN(m.description) AS description
                        FROM RoomQtyByModel q
                        JOIN roommaster r ON q.roomid = r.roomid
                        JOIN tbldbassemblymaster m ON m.assemblytype = 0 AND m.model = q.model
                             AND r.divisionid = m.divisionid AND m.isbaseassembly = 0 AND m.inactive = 0
                        WHERE ISNULL(r.inactive, 0) = 0 AND ISNULL(q.inactive, 0) = 0
                          AND r.divisionid = @DivisionID
                        GROUP BY q.model
                        ORDER BY 1, 2";
                parameters = new { SessionState.DivisionID };
            }

            var rows = await db.QueryAsync(sql, parameters);
            ModelsData = rows.Select(r => new ModelRow
            {
                Model = r["model"]?.ToString() ?? "",
                Description = r["description"]?.ToString() ?? ""
            }).ToList();

            // VB6: If .Rows > 1 Then .Row = 1  → select first model + load it.
            if (ModelsData.Count > 0)
            {
                SelectedModel = ModelsData[0];
                mModel = SelectedModel.Model;
                await LoadModel(mModel);
            }
            else
            {
                CategoriesData = new();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadModels error");
            Notifications.Error($"Error loading models: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();

            // Visually highlight the first row (the implicit selection set
            // above is page-level state — the GridControl needs to be told
            // explicitly so it draws the row in the selected style).
            if (gModels != null && ModelsData.Count > 0)
            {
                gModels.SelectRow(0);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    // ── Load Model Categories (VB6: LoadModel) ───────────────
    private async Task LoadModel(string model)
    {
        mModel = model;
        SelectedCategory = null;
        try
        {
            var sql = @"SELECT q.*, m.Room, c.Description AS CatDesc
                        FROM RoomQtyByModel q
                        JOIN RoomMaster m ON q.roomid = m.roomid
                        JOIN tblcategories c ON q.subcategory = c.category
                        WHERE ISNULL(q.inactive, 0) = 0 AND ISNULL(m.inactive, 0) = 0
                          AND q.model = @Model
                        ORDER BY m.room, q.subcategory, q.uom";
            var rows = await db.QueryAsync(sql, new { Model = mModel });
            CategoriesData = rows.Select(r => new CategoryRow
            {
                RoomId = r["roomid"]?.ToString() ?? "",
                Room = r["room"]?.ToString() ?? "",
                SubCategory = r["subcategory"]?.ToString() ?? "",
                CatDesc = r["CatDesc"]?.ToString() ?? "",
                Qty = r["qty"] != null && r["qty"] != DBNull.Value ? Convert.ToDouble(r["qty"]) : 0,
                UOM = r["uom"]?.ToString() ?? "",
                RowState = "CLEAN"
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadModel error");
            Notifications.Error($"Error loading model: {ex.Message}");
            CategoriesData = new();
        }

        // VB6: Dirty = False at the end of LoadModel.
        SetDirty(false);
        StateHasChanged();
    }

    // ── Grid Events ──────────────────────────────────────────
    // VB6: gModels_BeforeSelChange — if dirty, SaveData(True) first (cancel
    // the switch if the user cancels), then Select + LoadModel the new row.
    private async Task OnModelRowSelected(RowSelectEventArgs<ModelRow> args)
    {
        if (args.Data == null) return;

        if (mDirty)
        {
            if (!await SaveData(true))
                return;
        }

        SelectedModel = args.Data;
        mModel = SelectedModel.Model;
        await LoadModel(mModel);
    }

    private void OnCategoryRowSelected(RowSelectEventArgs<CategoryRow> args)
    {
        SelectedCategory = args.Data;
    }

    private void OnCategoryRowDeselected(RowSelectEventArgs<CategoryRow> args)
    {
        if (ReferenceEquals(SelectedCategory, args.Data))
            SelectedCategory = null;
    }

    private void OnCategorySelectionChanged(int selectedCount)
    {
        SelectedCategory = selectedCount > 0
            ? gCategories?.GetSelectedRecords()?.FirstOrDefault()
            : null;
    }

    // VB6: gCategories_ValidateEdit forces Val(.EditText) then RowData="dirty";
    // gCategories_AfterEdit marks the whole [Row..RowSel] range dirty + Dirty=True.
    private void OnCategoryCellSaved(CellSaveArgs<CategoryRow> args)
    {
        if (args.Data != null && string.Equals(args.ColumnName, nameof(CategoryRow.Qty), StringComparison.OrdinalIgnoreCase))
        {
            args.Data.RowState = "dirty";
            SetDirty(true);
        }
    }

    // VB6 gCategories FillStyle=flexFillRepeat + gCategories_AfterEdit: a Qty typed
    // over a multi-row selection lands on every row in [Row..RowSel] and marks each
    // one dirty. The grid only previews the text — the value is written here.
    private async Task OnCategoryTypeAheadCommit(TypeAheadCommitArgs<CategoryRow> args)
    {
        if (args?.SelectedItems == null || args.SelectedItems.Count == 0) return;
        if (!string.IsNullOrEmpty(args.ColumnName)
            && !string.Equals(args.ColumnName, nameof(CategoryRow.Qty), StringComparison.OrdinalIgnoreCase))
            return;
        if (!double.TryParse(args.Value, out var qty)) return;

        foreach (var row in args.SelectedItems)
        {
            row.Qty = qty;
            row.RowState = "dirty";
        }
        SetDirty(true);
        if (gCategories != null) await gCategories.Refresh();
    }

