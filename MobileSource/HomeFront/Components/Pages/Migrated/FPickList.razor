   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - VB6 multi-view picklist (pipe-separated view;sql form)
     - Initial port from VB6
   ───────────────────────────────────────────────────────────────── *@
@namespace HomeFront.Components.Pages

@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using HomeFront.Data
@using System.Dynamic
@using System.Collections.Generic
@using System.Data
@using System.Globalization
@layout HFComponent
@inject IJSRuntime JSRuntime
@inject ILogger<FPickList> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer _db

@if (RenderMode == FPickListRenderMode.Dialog)
{
    <div class="picklist-dialog-host">
        <DialogControl @bind-Visible="_isVisible"
                       Header="@_windowTitle"
                       Width="@_dialogWidth"
                       WidthChanged="OnWidthChanged"
                       Height="@_dialogHeight"
                       HeightChanged="OnHeightChanged"
                       Resizable="true"
                       CloseOnEscape="true"
                       ShowWindowIcon="true"
                       OnClose="OnCancelClick"
                       CssClass="picklist-dialog-control">
            <ChildContent>
                @PickListContent
            </ChildContent>
            <FooterContent>
                @PickListFooter
            </FooterContent>
        </DialogControl>
    </div>
}
else if (_isVisible || ShowPanelWhenClosed)
{
    <div class="@PanelHostCssClass" style="@PanelHostStyle">
        @if (_isVisible)
        {
            @PickListContent
            <div class="picklist-panel-footer">
                @PickListFooter
            </div>
        }
    </div>
}

@code {
    // ExpandoObject row casts to IDictionary<string, object> are intentional
    // throughout this file — the underlying ExpandoObject keys map to non-null
    // column values (DBNull is filtered upstream in DbWrapperSqlServer).
#pragma warning disable CS8619

    // ═══════════════════════════════════════════════════════════════════
    // ── Parameters ────────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    /// <summary>Fires when user clicks Open/OK or double-clicks a row. Returns selected rows.</summary>
    [Parameter] public EventCallback<List<IDictionary<string, object>>> OnSelected { get; set; }

    /// <summary>Fires when user clicks Cancel or presses Escape.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Controls whether FPickList hosts itself in a dialog or renders inline as a panel.</summary>
    [Parameter] public FPickListRenderMode RenderMode { get; set; } = FPickListRenderMode.Dialog;

    /// <summary>Optional CSS class appended to the inline panel host.</summary>
    [Parameter] public string? PanelCssClass { get; set; }

    /// <summary>Optional full style override for the inline panel host.</summary>
    [Parameter] public string? PanelStyle { get; set; }

    /// <summary>Optional width used by the inline panel when PanelStyle is not supplied.</summary>
    [Parameter] public string? PanelWidth { get; set; }

    /// <summary>Optional height used by the inline panel when PanelStyle is not supplied.</summary>
    [Parameter] public string? PanelHeight { get; set; }

    /// <summary>Keeps the inline panel's outer container rendered when the picker is closed.</summary>
    [Parameter] public bool ShowPanelWhenClosed { get; set; }

    /// <summary>Optional caption for the OK/commit button. Null keeps the default
    /// "Open" (VB6 FPickList cmdNav(1)); wizard-style hosts pass "Next".</summary>
    [Parameter] public string? OkButtonText { get; set; }

    // ═══════════════════════════════════════════════════════════════════
    // ── Internal State ────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    private bool _isVisible = false;
    private string _windowTitle = "Precision Builder - Select List";
    private string _dialogCaption = "Select List";
    private string _currentSql = "";
    private bool _showDebugSql = false;
    private bool _fastLoading = true;    // HHM-183: VB6 default is vbChecked (FPickList.frm:573 IniGet fallback); cosmetic in the web (no load impact). Supersedes the HHM-41 unchecked note.
    private bool _showNewButton = false;
    private bool _multiSelect = false;
    private string _hideColumns = "";
    private string _defaultItem = "";
    private string _filterValues = "";
    private bool _focusGridAfterOpen;
    private bool _useLegacyBlankFirstRowSelection;
    private bool _autoSelectFirstRowWhenNoDefault;
    private bool _hasLegacyBlankTopRow;
    private int _selectedViewIndex = 0;
    private bool _sortAsc = true;
    private const int DefaultDialogWidthPx = 390;
    private const string LegacyBlankRowMarkerField = "__FPickListBlankRow";
    private int _dialogWidthPx = DefaultDialogWidthPx;
    private string _dialogWidth = $"{DefaultDialogWidthPx}px";
    private string PanelHostCssClass => string.IsNullOrWhiteSpace(PanelCssClass)
        ? "picklist-panel-host"
        : $"picklist-panel-host {PanelCssClass}";

    private string PanelHostStyle => !string.IsNullOrWhiteSpace(PanelStyle)
        ? PanelStyle
        : $"width: {PanelWidth ?? _dialogWidth}; height: {PanelHeight ?? _dialogHeight};";

    private RenderFragment PickListContent => @<div class="picklist-dialog-inner" @onkeydown="HandleKeyDown" tabindex="0">
        @* -- Header -------------------------------------------------- *@
        <div class="picklist-header">
            <span>@_dialogCaption</span>
        </div>

        @* HHM-42: match legacy hint text + order (VB6 FPickList.frm:207 then :199). *@
        <div class="picklist-hints">
            <div>Type directly into the list to search for an item.</div>
            <div>Click on a column heading to sort the list on that column.</div>
        </div>

        @if (_viewItems.Count > 1)
        {
            <div class="picklist-views-bar">
                <label>View:</label>
                <DropDownListControl TValue="int" TItem="ViewChoice"
                                     DataSource="@ViewChoices"
                                     Value="@_selectedViewIndex"
                                     ValueChanged="OnViewChanged"
                                     TextFieldName="@nameof(ViewChoice.Text)"
                                     ValueFieldName="@nameof(ViewChoice.Value)"
                                     CssClass="picklist-view-dropdown" />
            </div>
        }

        @* HHM-184: VB6 FPickList.frm has no MouseDown/PopupMenu handler, so right-click
           on the picker grid shows nothing -- suppress both the browser context menu and
           FlexKit's header/column menu for legacy parity. *@
        <div class="picklist-grid-area">
            <GridControl @ref="_grid"
                         TValue="ExpandoObject"
                         DataSource="@_gridData"
                         AllowSorting="true"
                         AllowResizing="true"
                         AllowFiltering="true"
                         AllowSelection="true"
                         PreventDefaultContextMenu="true"
                         OnContextMenu="HandleGridRightClick"
                         EnableHeaderContextMenu="false"
                         EnableTypeSearch="true"
                         TypeSearchDelaySeconds="3"
                         ShowSelectionInfoBar="false"
                         CommitSelectedRowOnEnter="true"
                         ExtendVerticalScrollbarIntoHeader="true"
                         Height="100%"
                         Width="100%"
                         SelectionSettingsRef="@_selectionSettings"
                         FilterSettingsRef="@_filterSettings"
                         EventsRef="@_gridEvents">
                <GridColumnsBase @key="_columnsVersion">
                    @foreach (var col in _columnsConfig)
                    {
                        var isLastVisible = col == _columnsConfig.LastOrDefault(c => c.Visible);
                        <GridColumn Field="@col.Field"
                                    HeaderText="@col.Header"
                                    Type="@col.Type"
                                    Width="@(isLastVisible ? null : $"{col.Width}px")"
                                    MinWidth="@(isLastVisible ? $"{col.Width}px" : null)"
                                    AllowSorting="true"
                                    AllowFiltering="true"
                                    Visible="@col.Visible" />
                    }
                </GridColumnsBase>
            </GridControl>
        </div>

        @if (_showDebugSql)
        {
            <div class="picklist-debug">
                <strong>SQL:</strong>
                <pre>@_currentSql</pre>
            </div>
        }
    </div>;

    private RenderFragment PickListFooter => @<div class="picklist-footer-content">
        <div class="picklist-footer-left">
            @* HHM-398: the VB6 "Memory optimization" checkbox (FPickList.frm:190) is
               deprecated by product decision -- a deliberate deviation from legacy;
               _fastLoading stays at its default so load behavior is unchanged. *@
        </div>
        <div class="picklist-footer-right">
            @if (_showNewButton)
            {
                <ButtonControl CssClass="picklist-btn" OnClick="@(_ => OnNewClick())">New</ButtonControl>
            }
            @* VB6 FPickList.frm:489 `cmdNav(1).Enabled = gList.Row > 0` -- Open
               greys out when the list is empty (e.g. a view with no rows, HHM-234). *@
            @* Panel mode additionally requires a selected record before OK/Next
               enables (wizard hosts); dialog mode keeps the legacy rule. *@
            @* No AutoFocus here: it ran AFTER the grid was focused and stole the focus,
   so the picker ignored arrows/typing until a click (owner directive
   2026-08-01). Enter still accepts and Escape still cancels — the dialog-wide
   HandleKeyDown catches them wherever focus sits. *@
                <ButtonControl CssClass="picklist-btn picklist-default-btn"
                           Disabled="@(_gridData.Count == 0 || (RenderMode == FPickListRenderMode.Panel && !_hasSelection))"
                           OnClick="@(_ => OnOkClick())">@(OkButtonText ?? "Open")</ButtonControl>
            @if (RenderMode != FPickListRenderMode.Panel)
            {
                @* Panel mode hosts (e.g. the Import/Export wizard) supply their own
                   Cancel in the surrounding chrome — no Close/Cancel inside the panel. *@
                <ButtonControl CssClass="picklist-btn" OnClick="@(_ => OnCancelClick())">Cancel</ButtonControl>
            }
        </div>
    </div>;

    // Optional SQL parameters applied to every view's query. Callers that
    // build queries from user/row data pass a parameter bag instead of
    // interpolating values (e.g. FDBGrid's D365 / WalletBankAccount pickers).
    private IDictionary<string, object>? _parameters;

    // Parsed views from the Queries parameter
    // VB6 format: "ViewName1" & Chr(1) & "SQL1" & Chr(0) & "ViewName2" & Chr(1) & "SQL2"
    // Simplified Blazor format: "ViewName;SQL|ViewName2;SQL2" or just "SQL" (single view)
    private List<ViewItem> _viewItems = new();
    private IEnumerable<ViewChoice> ViewChoices =>
        _viewItems.Select((item, index) => new ViewChoice(index, item.Name));

    // Grid
    private GridControl<ExpandoObject>? _grid;
    private List<ExpandoObject> _gridData = new();
    private List<ColumnConfig> _columnsConfig = new();
    private int _columnsVersion; // HHM-179: bump to remount GridColumnsBase on view switch (drops stale registered columns)
    private List<string> _currentFields = new();

    private SelectionSettings _selectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single,
        EnableToggle = true
    };

    private FilterSettings _filterSettings = new()
    {
        Type = FilterType.FilterBar
    };

    private GridControlEvents<ExpandoObject> _gridEvents = new();

    // Models
    private class ViewItem
    {
        public string Name { get; set; } = "";
        public string Sql { get; set; } = "";
        public bool IsSeparator => IsSeparatorName(Name);
        public bool IsDisabled => Name.EndsWith("(Descoped)", StringComparison.OrdinalIgnoreCase);
        public bool IsUnavailable => IsSeparator || IsDisabled;
    }

    private sealed record ViewChoice(int Value, string Text);

    private class ColumnConfig
    {
        public string Field { get; set; } = "";
        public string Header { get; set; } = "";
        public int Width { get; set; } = 130;
        public bool Visible { get; set; } = true;
        // HHM-314: inferred display type — bit/bool columns render as checkboxes.
        public ColumnType Type { get; set; } = ColumnType.Text;
    }

    public int SelectedViewIndex => _selectedViewIndex;

    // ═══════════════════════════════════════════════════════════════════
    // ── Public API — replaces VB6 FPickList.Choose() ─────────────────
    // ═══════════════════════════════════════════════════════════════════

    /// <summary>
    /// Opens the pick list dialog. Equivalent to VB6 FPickList.Choose().
    ///
    /// VB6 signature: Choose(Connection, ItemTitle, Queries, DefaultItem, SortAsc,
    ///   ShowNew, ItemIcon, HideColumns, MultiSelect, DefaultView, FilterValues, StoredProc)
    ///
    /// Queries format:
    ///   Single view: "SELECT name, formula FROM itemcharts"
    ///   Multi-view:  "All Items;SELECT * FROM items|Active;SELECT * FROM items WHERE active=1"
    /// </summary>
    public async Task Open(
        string title,
        string queries,
        string? hideColumns = null,
        bool multiSelect = false,
        string? defaultItem = null,
        bool sortAsc = true,
        bool showNew = false,
        string? filterValues = null,
        int defaultView = 0,
        string? dialogCaption = null,
        string? windowTitle = null,
        IDictionary<string, object>? parameters = null,
        bool useLegacyBlankFirstRowSelection = false,
        bool autoSelectFirstRowWhenNoDefault = false)
    {
        // VB6: mTitle = App.ProductName & " - " & ItemTitle & " List". The deployed legacy
        // App.ProductName is "Precision Builder" (owner brand decision 2026-07-29, HHM-423 —
        // supersedes the earlier "HomeFront - ..." captions requested on HHM-476/288).
        _windowTitle = windowTitle ?? dialogCaption ?? $"Precision Builder - {title} List";
        _dialogCaption = dialogCaption ?? BuildChooseCaption(title);

        _parameters = parameters;
        _hideColumns = hideColumns ?? "";
        _multiSelect = multiSelect;
        _defaultItem = defaultItem ?? "";
        _showNewButton = showNew;
        _filterValues = filterValues ?? "";
        _useLegacyBlankFirstRowSelection = useLegacyBlankFirstRowSelection;
        _autoSelectFirstRowWhenNoDefault = autoSelectFirstRowWhenNoDefault;
        _sortAsc = sortAsc;
        _dialogWidthPx = DefaultDialogWidthPx;
        _dialogWidth = $"{DefaultDialogWidthPx}px";
        _dialogHeightPx = DefaultDialogHeightPx;
        _dialogHeight = $"{DefaultDialogHeightPx}px";

        // Restore saved sizes for the user
        MMain.IniGetForm(this, null, _windowTitle);

        // Parse views
        // VB6 uses Chr(0) to separate views and Chr(1) to separate name from SQL
        // Blazor simplified: "|" separates views, ";" separates name from SQL
        // If no delimiter, treat as single unnamed view
        _viewItems.Clear();
        if (queries.Contains('|'))
        {
            var parts = queries.Split('|', StringSplitOptions.RemoveEmptyEntries);
            foreach (var part in parts)
            {
                var semi = part.IndexOf(';');
                if (semi > 0)
                {
                    _viewItems.Add(new ViewItem
                    {
                        Name = part[..semi].Trim(),
                        Sql = part[(semi + 1)..].Trim()
                    });
                }
                else
                {
                    _viewItems.Add(new ViewItem { Name = $"View {_viewItems.Count + 1}", Sql = part.Trim() });
                }
            }
        }
        else
        {
            _viewItems.Add(new ViewItem { Name = title, Sql = queries.Trim() });
        }

        _selectedViewIndex = NormalizeViewIndex(defaultView);
        _showDebugSql = false;

        // Load data BEFORE showing the dialog so the grid renders with data
        _gridData = new List<ExpandoObject>();
        _columnsConfig = new List<ColumnConfig>();
        await LoadDataForCurrentView();

        // Selection mode — set after data load so the grid initializes with correct settings
        _selectionSettings = new SelectionSettings
        {
            Mode = SelectionMode.Row,
            Type = multiSelect ? SelectionType.Multiple : SelectionType.Single,
            EnableToggle = true
        };

        // Wire double-click = OK
        _gridEvents = new GridControlEvents<ExpandoObject>();
        _gridEvents.OnRecordDoubleClick = EventCallback.Factory.Create<CellClickEventArgs<ExpandoObject>>(
            this, OnRecordDoubleClick);
        // Panel-mode OK gate: track whether ANY row is selected. Dialog mode keeps
        // the legacy list-not-empty rule (VB6 cmdNav(1).Enabled = gList.Row > 0).
        _hasSelection = false;
        _gridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<ExpandoObject>>(
            this, _ => { _hasSelection = true; StateHasChanged(); });
        _gridEvents.RowDeselected = EventCallback.Factory.Create<RowSelectEventArgs<ExpandoObject>>(
            this, _ => { _hasSelection = _grid?.GetSelectedRecords().Any() ?? false; StateHasChanged(); });

        _isVisible = true;
        _focusGridAfterOpen = true;
        _selectionRetries = 0;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusGridAfterOpen && _isVisible && _grid != null)
        {
            _focusGridAfterOpen = false;
            // VB6 FilterValues ("Col=Value|Col2=Value2") pre-fills the filter row so the list
            // OPENS pre-filtered (FPickList.frm:468-475 writes gList row 1 + applies; hidden
            // columns are skipped). The first migration pass stored _filterValues but never
            // applied it — e.g. the Inverse Item picker no longer opened scoped to the row's
            // Phase, showing the whole item database instead (HHM-222/223).
            if (!string.IsNullOrEmpty(_filterValues))
            {
                foreach (var pair in _filterValues.Split('|', StringSplitOptions.RemoveEmptyEntries))
                {
                    var eq = pair.IndexOf('=');
                    if (eq <= 0) continue;
                    var field = pair[..eq].Trim();
                    var value = pair[(eq + 1)..].Trim();
                    if (string.IsNullOrEmpty(value)) continue;
                    var col = _columnsConfig.FirstOrDefault(c =>
                        string.Equals(c.Field, field, StringComparison.OrdinalIgnoreCase) && c.Visible);
                    if (col == null) continue;
                    try { await _grid.FilterByColumnAsync(col.Field, value); } catch { }
                }
            }
            // Select a matching DefaultItem everywhere, but make the "else first row"
            // fallback opt-in. Most pickers should open focused but unselected when
            // they have no current value; legacy blank-row pickers and specific
            // callers such as FItems Tax Group can request first-row selection.
            await _grid.ClearSelectionAsync();
            var initialRowIndex = FindInitialSelectionIndex();
            var attemptedInitialSelection = initialRowIndex >= 0;
            if (initialRowIndex >= 0)
            {
                _grid.SelectRow(initialRowIndex);
            }
            await _grid.FocusGridAsync();
            // On a REOPEN the grid re-renders once more after receiving its fresh
            // DataSource, and that second pass could drop the just-applied highlight
            // (the FIRST open mounts the grid with data already in place, so it kept
            // it — reopened pickers came up with no current row, an HHM-186/206
            // regression seen live 2026-07-04). Re-arm and re-apply on the next
            // render until the selection sticks, capped so an empty list can't loop.
            if (attemptedInitialSelection && !_grid.GetSelectedRecords().Any() && _selectionRetries < 3)
            {
                _selectionRetries++;
                _focusGridAfterOpen = true;
                StateHasChanged();
            }
        }
    }

    private int _selectionRetries;

    // True while at least one grid row is selected (panel-mode Next/OK gate).
    private bool _hasSelection;

    /// <summary>Closes the dialog without selection.</summary>
    public void Close()
    {
        _isVisible = false;
        _focusGridAfterOpen = false;
        StateHasChanged();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ── Data Loading ──────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    private async Task LoadDataForCurrentView()
    {
        if (_selectedViewIndex < 0 || _selectedViewIndex >= _viewItems.Count) return;

        var view = _viewItems[_selectedViewIndex];
        if (view.IsUnavailable)
        {
            _selectedViewIndex = NormalizeViewIndex(_selectedViewIndex);
            view = _viewItems[_selectedViewIndex];
        }

        var sql = view.Sql;
        if (string.IsNullOrWhiteSpace(sql)) return;

        // VB6: appends "ORDER BY 1 ASC/DESC" if no ORDER BY present
        if (!sql.Contains("order by", StringComparison.OrdinalIgnoreCase))
        {
            sql += _sortAsc ? " ORDER BY 1 ASC" : " ORDER BY 1 DESC";
        }

        _currentSql = sql;

        try
        {
            _gridData = _parameters != null
                ? await _db.QueryDynamicAsync(sql, _parameters)
                : await _db.QueryDynamicAsync(sql);
            _currentFields = ExtractFields(_gridData);
            if (_currentFields.Count == 0)
                _currentFields = LoadFieldsFromSchema(sql);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"[FPickList] Query error: ");
            _gridData = new List<ExpandoObject>();
            _currentFields = new List<string>();
        }

        BuildColumnsFromData();
        if (_useLegacyBlankFirstRowSelection)
            InsertLegacyBlankTopRow();
        else
            _hasLegacyBlankTopRow = false;
    }

    private void BuildColumnsFromData()
    {
        _columnsConfig.Clear();

        var fields = _currentFields.Count > 0
            ? _currentFields
            : _gridData.Count > 0
                ? ((IDictionary<string, object>)_gridData[0]).Keys.ToList()
                : new List<string>();
        if (fields.Count == 0) return;

        var hiddenSet = new HashSet<string>(
            _hideColumns.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Trim()),
            StringComparer.OrdinalIgnoreCase);

        foreach (var field in fields)
        {
            var width = EstimateColumnWidth(field);
            _columnsConfig.Add(new ColumnConfig
            {
                Field = field,
                Header = field,
                Width = width,
                Visible = !hiddenSet.Contains(field),
                // HHM-314: VB6 gList is a data-BOUND VSFlexGrid, so adBoolean (bit)
                // columns render as checkboxes automatically (FPickList.frm:430-457
                // only overrides double/date formatting). Mirror that here — e.g. the
                // Find-User picker's CRMUser column showed "True/False" text. This
                // grid sets no EditSettingsRef, so GridControl renders the checkbox
                // read-only (toggling requires EditSettingsRef.AllowEditing).
                Type = InferColumnType(field)
            });
        }

        UpdateDialogWidth();
        _columnsVersion++; // HHM-179
    }

    // HHM-314: scan the loaded rows for the field's first non-null value; a bool
    // (SQL bit via DbWrapper) means a checkbox column, anything else stays text.
    private ColumnType InferColumnType(string field)
    {
        foreach (var row in _gridData.Take(50))
        {
            if (row is not IDictionary<string, object> dict) continue;
            if (!TryGetDictionaryValue(dict, field, out var value)) continue;
            if (value == null || value is DBNull) continue;
            return value is bool ? ColumnType.CheckBox : ColumnType.Text;
        }
        return ColumnType.Text;
    }

    private int EstimateColumnWidth(string field)
    {
        var maxLen = field.Length;
        foreach (var row in _gridData.Take(50))
        {
            var dict = row as IDictionary<string, object>;
            if (dict == null) continue;
            if (!TryGetDictionaryValue(dict, field, out var value)) continue;
            var text = Convert.ToString(value, CultureInfo.CurrentCulture) ?? "";
            if (text.Length > maxLen)
                maxLen = text.Length;
        }

        var px = (maxLen * 7.6) + 36;
        return (int)Math.Clamp(px, 80, 520);
    }

    private void UpdateDialogWidth()
    {
        // VB6 FPickList starts at ClientWidth 5670 twips (~378px) and
        // leaves wide result sets to the grid's horizontal scrollbar.
        if (_dialogWidthPx <= 0)
        {
            _dialogWidthPx = DefaultDialogWidthPx;
        }
        _dialogWidth = $"{_dialogWidthPx}px";
        _dialogHeight = $"{_dialogHeightPx}px";
    }

    private static bool TryGetDictionaryValue(IDictionary<string, object> dict, string field, out object? value)
    {
        if (dict.TryGetValue(field, out value))
            return true;

        foreach (var kvp in dict)
        {
            if (string.Equals(kvp.Key, field, StringComparison.OrdinalIgnoreCase))
            {
                value = kvp.Value;
                return true;
            }
        }

        value = null;
        return false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // ── Event Handlers ────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    private async Task OnViewChanged(int viewIndex)
    {
        if (viewIndex < 0 || viewIndex >= _viewItems.Count || _viewItems[viewIndex].IsUnavailable)
        {
            StateHasChanged();
            return;
        }

        _selectedViewIndex = NormalizeViewIndex(viewIndex);
        _hasSelection = false;   // new view = new list; panel OK re-gates on selection
        await LoadDataForCurrentView();
        _focusGridAfterOpen = true;
        StateHasChanged();
    }

    private Task OnFastLoadingChanged(bool value)
    {
        _fastLoading = value;
        return Task.CompletedTask;
    }

    // HHM-96: VB6 gList is a VSFlexGrid whose stock DblClick fires for ANY mouse
    // button, so a right double-click ran gList_DblClick → cmdNav_Click(1) (Open,
    // FPickList.frm:657). Browsers never raise dblclick for the right button, so
    // detect two contextmenu events landing within the OS double-click window at
    // (nearly) the same spot and route them through the same Open path.
    private DateTime _lastRightClickUtc = DateTime.MinValue;
    private double _lastRightClickX, _lastRightClickY;

    private async Task HandleGridRightClick(MouseEventArgs e)
    {
        var isDouble = (DateTime.UtcNow - _lastRightClickUtc).TotalMilliseconds <= 500
            && Math.Abs(e.ClientX - _lastRightClickX) <= 4
            && Math.Abs(e.ClientY - _lastRightClickY) <= 4;
        if (isDouble)
        {
            _lastRightClickUtc = DateTime.MinValue;
            await OnOkClick();
            return;
        }
        _lastRightClickUtc = DateTime.UtcNow;
        _lastRightClickX = e.ClientX;
        _lastRightClickY = e.ClientY;
    }

    private async Task OnOkClick()
    {
        var selected = GetSelectedRows();
        if (selected.Count == 0) return;

        _isVisible = false;
        _focusGridAfterOpen = false;
        await OnSelected.InvokeAsync(selected);
        StateHasChanged();
    }

    private async Task OnCancelClick()
    {
        _isVisible = false;
        _focusGridAfterOpen = false;
        StateHasChanged();
        await OnCancel.InvokeAsync();
    }

    private async Task OnNewClick()
    {
        // VB6: returns empty data array signalling "New" was clicked
        _isVisible = false;
        _focusGridAfterOpen = false;
        await OnSelected.InvokeAsync(new List<IDictionary<string, object>>());
        StateHasChanged();
    }

    private async Task OnRecordDoubleClick(CellClickEventArgs<ExpandoObject> args)
    {
        if (args.Data == null) return;

        var row = (IDictionary<string, object>)args.Data;
        if (_useLegacyBlankFirstRowSelection && IsLegacyBlankTopRow(row)) return;

        if (!_multiSelect)
        {
            // Single-select: double-click = pick this one row and close.
            _isVisible = false;
            _focusGridAfterOpen = false;
            await OnSelected.InvokeAsync(new List<IDictionary<string, object>> { row });
            StateHasChanged();
            return;
        }

        // Multi-select: double-click = accept the union of (current
        // selection ∪ double-clicked row) and close. Mirrors the VB6
        // "double-click a row in a multi-pick list" behavior — if the
        // user has already ticked some rows, those come along; if they
        // just double-clicked one row without ticking anything, that
        // one row is the result. Without this branch double-click was
        // a no-op for the Add Component picker (multi-select), forcing
        // the user to manually click OK every time.
        var selected = GetSelectedRows();
        if (!selected.Any(r => ReferenceEquals(r, row)))
            selected.Add(row);
        _isVisible = false;
        _focusGridAfterOpen = false;
        await OnSelected.InvokeAsync(selected);
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.AltKey && e.Key == "F4")
        {
            await OnCancelClick();
            return;
        }

        if (e.Key == "Escape")
        {
            await OnCancelClick();
            return;
        }
        // Ctrl+F9 = toggle debug SQL (VB6: Form_KeyDown)
        if (e.CtrlKey && e.Key == "F9")
        {
            _showDebugSql = !_showDebugSql;
            StateHasChanged();
            return;
        }
        // Enter = same as clicking OK. GridControl's built-in
        // CommitSelectedRowOnEnter only fires when exactly ONE row is
        // selected AND routes through OnRecordDoubleClick, which used
        // to bail out for multi-select. This handler covers the rest:
        // single-row in multi-select picker, or multi-row Enter where
        // the user wants to accept everything they've ticked.
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            if (e.AltKey || e.CtrlKey || e.MetaKey || e.ShiftKey) return;
            await OnOkClick();
        }
    }

