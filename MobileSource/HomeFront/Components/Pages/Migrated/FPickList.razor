    private List<IDictionary<string, object>> GetSelectedRows()
    {
        if (_grid == null) return new();

        var selected = _grid.GetSelectedRecords()
            .Cast<IDictionary<string, object>>()
            .Where(row => !_useLegacyBlankFirstRowSelection || !IsLegacyBlankTopRow(row))
            .ToList();

        // If nothing explicitly selected in multi-select, return empty
        // In single-select, the highlighted row counts as selected
        return selected;
    }

    private static List<string> ExtractFields(IEnumerable<ExpandoObject> rows)
    {
        var first = rows.FirstOrDefault();
        return first == null
            ? new List<string>()
            : ((IDictionary<string, object>)first).Keys.ToList();
    }

    private List<string> LoadFieldsFromSchema(string sql)
    {
        try
        {
            var table = _parameters != null
                ? _db.SqlExec(sql, _parameters)
                : _db.SqlExec(sql);
            return table.Columns.Cast<DataColumn>()
                .Select(column => column.ColumnName)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[FPickList] Unable to read empty-result schema.");
            return new List<string>();
        }
    }

    private void InsertLegacyBlankTopRow()
    {
        _hasLegacyBlankTopRow = false;
        if (_gridData.Count == 0 || _columnsConfig.Count == 0)
            return;

        var blankRow = new ExpandoObject();
        var dict = (IDictionary<string, object>)blankRow;
        foreach (var col in _columnsConfig)
        {
            dict[col.Field] = "";
        }

        dict[LegacyBlankRowMarkerField] = true;
        _gridData.Insert(0, blankRow);
        _hasLegacyBlankTopRow = true;
    }

    private int FindInitialSelectionIndex()
    {
        if (_gridData.Count == 0)
            return -1;

        if (!string.IsNullOrWhiteSpace(_defaultItem))
        {
            for (var i = 0; i < _gridData.Count; i++)
            {
                if (IsLegacyBlankTopRow(_gridData[i]))
                    continue;

                if (RowMatchesDefaultItem(_gridData[i]))
                    return i;
            }
        }

        // Owner directive 2026-08-01: every picker opens with a CURRENT row so the
        // arrow keys and type-to-search respond immediately — VB6's gList always
        // has .Row = 1 the moment the form shows. DefaultItem still wins above;
        // this is only the no-match fallback (previously opt-in per caller).
        return _hasLegacyBlankTopRow && _gridData.Count > 1 ? 1 : 0;
    }

    private bool RowMatchesDefaultItem(ExpandoObject row)
    {
        var dict = (IDictionary<string, object>)row;
        // HHM-415: scan ALL columns, hidden ones included — VB6 FindRow searches
        // column 0 (the key) even when ColHidden (FPickList.frm:337); the PM picker
        // hides its key column, so a Visible-only scan never matched defaultItem.
        foreach (var col in _columnsConfig)
        {
            if (!TryGetDictionaryValue(dict, col.Field, out var value))
                continue;

            var text = Convert.ToString(value, CultureInfo.CurrentCulture) ?? "";
            if (string.Equals(text, _defaultItem, StringComparison.CurrentCultureIgnoreCase))
                return true;
        }

        return false;
    }

    private static bool IsLegacyBlankTopRow(ExpandoObject row) =>
        IsLegacyBlankTopRow((IDictionary<string, object>)row);

    private static bool IsLegacyBlankTopRow(IDictionary<string, object> row) =>
        row.TryGetValue(LegacyBlankRowMarkerField, out var marker) &&
        marker is bool isBlank &&
        isBlank;

    private int NormalizeViewIndex(int requestedIndex)
    {
        if (_viewItems.Count == 0)
            return 0;

        var index = Math.Max(0, Math.Min(_viewItems.Count - 1, requestedIndex));
        if (!_viewItems[index].IsUnavailable)
            return index;

        for (var next = index + 1; next < _viewItems.Count; next++)
        {
            if (!_viewItems[next].IsUnavailable)
                return next;
        }

        for (var previous = index - 1; previous >= 0; previous--)
        {
            if (!_viewItems[previous].IsUnavailable)
                return previous;
        }

        return 0;
    }

    private static bool IsSeparatorName(string name)
    {
        var trimmed = name.Trim();
        return trimmed.Length >= 3 && trimmed.All(ch => ch == '-');
    }

    private static string BuildChooseCaption(string title)
    {
        var article = "aeiou".Contains(char.ToLower(title.FirstOrDefault())) ? "an" : "a";
        return $"Choose {article} {title}.";
    }

