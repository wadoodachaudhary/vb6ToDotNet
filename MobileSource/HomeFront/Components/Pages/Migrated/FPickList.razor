    private const int DefaultDialogHeightPx = 438;
    private int _dialogHeightPx = DefaultDialogHeightPx;
    private string _dialogHeight = $"{DefaultDialogHeightPx}px";

    public int Width
    {
        get => _dialogWidthPx;
        set
        {
            _dialogWidthPx = value;
            _dialogWidth = $"{value}px";
        }
    }

    public int Height
    {
        get => _dialogHeightPx;
        set
        {
            _dialogHeightPx = value;
            _dialogHeight = $"{value}px";
        }
    }

    private void OnWidthChanged(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        _dialogWidth = value;
        if (value.EndsWith("px", StringComparison.OrdinalIgnoreCase) &&
            double.TryParse(value[..^2], out var px))
        {
            _dialogWidthPx = (int)px;
            MMain.IniPutForm(this, null, _windowTitle);
        }
    }

    private void OnHeightChanged(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        _dialogHeight = value;
        if (value.EndsWith("px", StringComparison.OrdinalIgnoreCase) &&
            double.TryParse(value[..^2], out var px))
        {
            _dialogHeightPx = (int)px;
            MMain.IniPutForm(this, null, _windowTitle);
        }
    }
}
