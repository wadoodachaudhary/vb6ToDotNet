    // ── Comments (Jira-style thread) ──
    private string _newComment = "";
    private async Task AddCommentAsync()
    {
        if (selectedFeedback == null || string.IsNullOrWhiteSpace(_newComment)) return;
        var text = _newComment.Trim();
        var comment = new TicketComment
        {
            Id = Guid.NewGuid().ToString(),
            Author = CurrentUserName,   // comment author = the selected "Current user"
            Text = text,
            Date = DateTime.Now
        };
        selectedFeedback.Comments ??= new();
        selectedFeedback.Comments.Add(comment);
        _newComment = "";
        // Save locally FIRST so the comment survives even if Jira is unreachable.
        try { await FeedbackService.UpdateFeedbackAsync(selectedFeedback); }
        catch (Exception ex) { Notifications.Error($"Failed to add comment: {ex.Message}"); }
        StateHasChanged();

        await PushCommentToJiraAsync(selectedFeedback, comment);
    }

    /// <summary>
    /// Push one freshly added comment to the board and tag it with Jira's comment id. Best-effort:
    /// a failure leaves the comment saved locally and only warns, and the id tag is what stops the
    /// next pull importing our own comment back as a duplicate.
    /// </summary>
    private async Task PushCommentToJiraAsync(FeedbackItem item, TicketComment comment)
    {
        if (item == null || comment == null) return;
        if (string.IsNullOrWhiteSpace(item.ExternalKey)) return;      // local-only ticket, nothing to sync to
        if (!string.IsNullOrWhiteSpace(comment.ExternalId)) return;   // already on the board
        if (!Jira.LoadSettings().IsConfigured) return;

        try
        {
            // Stamp the author: the API token is one account, so without this every comment the app
            // pushes would read as the token owner on the board. Skipped when we have no real name
            // (no "Current user" picked) — "Application User: …" is noise, not attribution.
            var body = IsPlaceholderReporter(comment.Author)
                ? comment.Text
                : $"{comment.Author}: {comment.Text}";
            var (ok, id, msg) = await Jira.AddCommentAsync(item.ExternalKey, body);
            if (ok)
            {
                comment.ExternalId = id;
                try { await FeedbackService.UpdateFeedbackAsync(item); } catch { }
            }
            else
            {
                Notifications.Warning($"Comment saved locally, but not sent to {item.ExternalKey}: {msg}");
            }
        }
        catch (Exception ex)
        {
            Notifications.Warning($"Comment saved locally, but not sent to Jira: {ex.Message}");
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Pull the board's comments for this ticket and merge in anything we do not have yet (matched on
    /// Jira's comment id). Runs when a ticket is opened and from the Activity Refresh button, rather
    /// than during the board-wide sync — one request per ticket the user actually looks at, instead of
    /// one per issue on every sync.
    /// </summary>
    private async Task PullCommentsFromJiraAsync(FeedbackItem? item)
    {
        if (item == null || string.IsNullOrWhiteSpace(item.ExternalKey)) return;
        if (!Jira.LoadSettings().IsConfigured) return;

        try
        {
            var (fetchOk, remote) = await Jira.FetchCommentsAsync(item.ExternalKey);

            item.Comments ??= new();

            // A local comment that carries a Jira id the board no longer has was deleted on the
            // board — mirror the delete here, or purged comments linger in the app forever. Only
            // when the fetch verifiably returned the complete list, so an outage (which comes back
            // as Ok=false) can never wipe synced comments.
            var removed = 0;
            if (fetchOk)
            {
                var remoteIds = new HashSet<string>(remote.Select(r => r.Id), StringComparer.Ordinal);
                removed = item.Comments.RemoveAll(c =>
                    !string.IsNullOrWhiteSpace(c.ExternalId) && !remoteIds.Contains(c.ExternalId!));
            }
            if (remote.Count == 0 && removed == 0) return;
            var known = new HashSet<string>(
                item.Comments.Where(c => !string.IsNullOrWhiteSpace(c.ExternalId)).Select(c => c.ExternalId!),
                StringComparer.Ordinal);

            var added = 0;
            foreach (var rc in remote)
            {
                if (known.Contains(rc.Id)) continue;

                // A comment this app pushed before the id tag existed (or pushed by an older build)
                // comes back with our "Author: text" shape — adopt the id instead of duplicating it.
                var twin = item.Comments.FirstOrDefault(c =>
                    string.IsNullOrWhiteSpace(c.ExternalId)
                    && (string.Equals(c.Text?.Trim(), rc.Body?.Trim(), StringComparison.Ordinal)
                        || string.Equals($"{c.Author}: {c.Text}".Trim(), rc.Body?.Trim(), StringComparison.Ordinal)));
                if (twin != null) { twin.ExternalId = rc.Id; continue; }

                var (author, text) = SplitJiraCommentBody(rc);
                item.Comments.Add(new TicketComment
                {
                    Id = Guid.NewGuid().ToString(),
                    ExternalId = rc.Id,
                    Author = author,
                    Text = text,
                    Date = rc.Created == default ? DateTime.Now : rc.Created.ToLocalTime(),
                    EditedDate = rc.Updated?.ToLocalTime(),
                });
                added++;
            }

            if (added > 0 || removed > 0 || remote.Count > 0)
            {
                item.Comments = item.Comments.OrderBy(c => c.Date).ToList();
                try { await FeedbackService.UpdateFeedbackAsync(item); } catch { }
                if (added > 0 || removed > 0) await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Pulling Jira comments failed");
        }
    }

    /// <summary>
    /// Undo the "Author: text" shape this app pushes, so a comment we sent shows its real author on
    /// the way back instead of the API token's account. The prefix is only stripped when it matches
    /// a name we actually know — a plain Jira comment that merely happens to contain a colon (e.g.
    /// "PULL-TEST 2026-07-30: …") keeps its full text and Jira's own author.
    /// </summary>
    private (string Author, string Text) SplitJiraCommentBody(JiraComment rc)
    {
        var body = rc.Body ?? "";
        var idx = body.IndexOf(':');
        if (idx > 0 && idx <= 60)
        {
            var maybeAuthor = body.Substring(0, idx).Trim();
            if (maybeAuthor.Length > 0 && IsKnownPersonName(maybeAuthor))
                return (maybeAuthor, body.Substring(idx + 1).TrimStart());
        }
        return (rc.Author, body);
    }

    /// <summary>True when the text is one of the people this board knows (reporter list / current user).</summary>
    private bool IsKnownPersonName(string name) =>
        (_reporters?.Any(r => string.Equals(r, name, StringComparison.OrdinalIgnoreCase)) ?? false)
        || string.Equals(_currentUser, name, StringComparison.OrdinalIgnoreCase);

    // ── Comment edit / delete (HHM-148) ──
    private string? _editingCommentId;
    private string _editCommentText = "";

    private void StartEditComment(TicketComment c)
    {
        if (string.IsNullOrEmpty(c.Id)) c.Id = Guid.NewGuid().ToString();   // backfill legacy comments
        _editingCommentId = c.Id;
        _editCommentText = c.Text;
    }

    private void CancelCommentEdit()
    {
        _editingCommentId = null;
        _editCommentText = "";
    }

    private async Task SaveCommentEditAsync(TicketComment c)
    {
        if (selectedFeedback == null) return;
        c.Text = (_editCommentText ?? "").Trim();
        c.EditedDate = DateTime.Now;
        CancelCommentEdit();
        try { await FeedbackService.UpdateFeedbackAsync(selectedFeedback); }
        catch (Exception ex) { Notifications.Error($"Failed to save comment: {ex.Message}"); }
        StateHasChanged();
    }

    private async Task DeleteCommentAsync(TicketComment c)
    {
        if (selectedFeedback == null) return;
        if (!await Dialogs.ConfirmAsync("Delete this comment?", "Delete comment")) return;
        selectedFeedback.Comments?.Remove(c);
        if (_editingCommentId == c.Id) CancelCommentEdit();
        try { await FeedbackService.UpdateFeedbackAsync(selectedFeedback); }
        catch (Exception ex) { Notifications.Error($"Failed to delete comment: {ex.Message}"); }
        // Delete on the Jira board too (the comment id we stored when it was pushed/pulled).
        // Without this the next pull-sync re-imports the comment and it "comes back".
        if (!string.IsNullOrWhiteSpace(c.ExternalId) && !string.IsNullOrWhiteSpace(selectedFeedback.ExternalKey))
        {
            var (ok, msg) = await Jira.DeleteCommentAsync(selectedFeedback.ExternalKey, c.ExternalId);
            if (!ok)
                Notifications.Warning($"Comment removed here, but not from the Jira board: {msg}");
        }
        StateHasChanged();
    }

    // ── Activity / history (HHM-147): the Jira changelog for the open ticket, loaded on demand ──
    private List<TicketActivity> _activity = new();
    private bool _activityLoading;
    private int _activityForTicket = -1;

    private async Task LoadActivityAsync(FeedbackItem m)
    {
        if (m == null || string.IsNullOrWhiteSpace(m.ExternalKey) || _activityLoading) return;
        _activityLoading = true; StateHasChanged();
        try
        {
            _activity = await Jira.FetchChangelogAsync(m.ExternalKey); _activityForTicket = m.TicketNumber;
            await PullCommentsFromJiraAsync(m);   // same button = "bring this ticket up to date with the board"
        }
        catch (Exception ex) { Notifications.Warning($"Couldn't load activity: {ex.Message}"); }
        finally { _activityLoading = false; StateHasChanged(); }
    }

    // ── Unsaved-changes guard ──
    // Snapshot of the ticket as it was when editing began; a difference ⇒ unsaved edits.
    private string? _editSnapshot;
    private bool _unsavedPromptOpen;
    private bool IsEditingNow => newFeedback != null || _editMode;
    private void SnapshotEdit()
    {
        var m = newFeedback ?? selectedFeedback;
        try { _editSnapshot = m == null ? null : System.Text.Json.JsonSerializer.Serialize(m); }
        catch { _editSnapshot = null; }
    }
    private bool IsEditDirty()
    {
        if (!IsEditingNow) return false;
        var m = newFeedback ?? selectedFeedback;
        if (m == null || _editSnapshot == null) return false;
        try { return System.Text.Json.JsonSerializer.Serialize(m) != _editSnapshot; }
        catch { return false; }
    }

    // "Back to board": if there are unsaved edits, ask Save / Don't save / Cancel first.
    private void GoHome()
    {
        if (IsEditingNow && IsEditDirty()) { _unsavedPromptOpen = true; StateHasChanged(); return; }
        DoGoHome();
    }

    private void DoGoHome()
    {
        _unsavedPromptOpen = false;

        // From a dedicated ticket TAB there is no board underneath to return to — switch to the
        // board's own tab and leave this ticket tab open (the tab strip's ✕ closes it). This also
        // serves the unsaved-changes prompt, whose Save and Don't-save both land here.
        if (IsTicketTabMode && ParentNavigate != null)
        {
            // The unsaved-changes prompt's Save / Don't-save land here: finish by closing this
            // ticket tab and returning to the board, exactly as the old in-page view did.
            _editMode = false;
            _editSnapshot = null;
            ParentNavigate("/");
            ParentNavigate("/feedback-testing");
            return;
        }

        newFeedback = null;
        selectedFeedback = null;
        _annotatedDataUrl = string.Empty;
        _editMode = false;
        _editSnapshot = null;
        _view = FbView.Home;
        _restoreBoardScroll = true;   // put the board back where it was when the ticket was opened
        StateHasChanged();
    }

    // Unsaved-prompt buttons.
    private async Task UnsavedPromptSaveAsync()   // Yes — save (local + Jira), then return to the board
    {
        _unsavedPromptOpen = false;
        var ok = await TrySaveCurrentAsync();
        if (ok) DoGoHome();          // saved → leave; if blocked (e.g. empty title) stay in edit
        else StateHasChanged();
    }
    private void UnsavedPromptDiscard() => DoGoHome();          // No — discard the edits and leave
    private void UnsavedPromptCancel() { _unsavedPromptOpen = false; StateHasChanged(); }   // Cancel — stay

    // ── Board scroll preservation ── opening a ticket tears the board's DOM down, so going back
    // used to land at the top. Save the board's scroll offsets on the way out; OnAfterRenderAsync
    // re-applies them right after the board re-renders on the way back (_restoreBoardScroll).
    private System.Text.Json.JsonElement? _boardScroll;
    private bool _restoreBoardScroll;

    private async Task CaptureBoardScrollAsync()
    {
        try { _boardScroll = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>("feedbackHelper.captureScroll", ".feedback-screen-container"); }
        catch { _boardScroll = null; }
    }

    private async Task OpenTicket(FeedbackItem fb)
    {
        if (_view == FbView.Home) await CaptureBoardScrollAsync();   // remember where the board was

        // Open the ticket in its OWN tab and leave the board in its tab. FMain lists
        // /feedback-ticket as an "always fresh" route, so every ticket the user opens spawns a
        // new tab instead of replacing the board or the previously opened ticket — several
        // tickets stay open side by side, switchable from the tab strip.
        if (ParentNavigate != null)
        {
            ParentNavigate($"/feedback-ticket/{fb.TicketNumber}");
            return;
        }

        // Standalone (no MDI shell — the page opened on its own URL): fall back to the
        // in-page swap, which is the only thing that can work without a tab strip.
        selectedFeedback = fb;
        newFeedback = null;
        _editMode = false;   // existing tickets open in read mode (click Edit to edit)
        _view = FbView.Ticket;
        StateHasChanged();
        await PullCommentsFromJiraAsync(fb);
    }

    /// <summary>
    /// A dedicated ticket tab loads exactly the ticket named on its route. Runs whenever the
    /// route parameter lands (or changes), never for the board tab.
    /// </summary>
    private async Task SyncTicketTabAsync()
    {
        if (!IsTicketTabMode) return;
        if (!int.TryParse(TicketNumber, out var num)) return;

        // Re-run whenever the pane is not actually showing this ticket — a plain "already loaded
        // this number" latch would make the tab unrecoverable if anything reset the view (or if
        // the first load found nothing).
        var showingThisTicket = _view == FbView.Ticket
            && selectedFeedback?.TicketNumber == num
            && num == _loadedTicketTabNumber;
        if (showingThisTicket) return;

        _loadedTicketTabNumber = num;
        if (allFeedbacks.Count == 0)
            await LoadFeedbackHistoryAsync();

        var fb = allFeedbacks.FirstOrDefault(f => f.TicketNumber == num);
        if (fb == null)
        {
            // Deleted, or the tab was restored against a different data set.
            Notifications.Warning($"Ticket #{num} could not be found.");
            return;
        }

        selectedFeedback = fb;
        newFeedback = null;
        _editMode = false;
        _view = FbView.Ticket;
        // Name the MDI tab after the ticket so a row of open tickets is readable.
        SetPageTitle?.Invoke(TicketLabel(fb));
        StateHasChanged();

        // Bring the board's comments down for the ticket the user just opened.
        await PullCommentsFromJiraAsync(fb);
    }

    /// <summary>Breadcrumb / "Back to board": from a ticket tab this SWITCHES to the board's
    /// tab (leaving this ticket open); from the board's own tab it is the old go-home.</summary>
    /// <summary>
    /// The "Feedback" hyperlink at the top of a ticket. Pre-tabs this dismissed the ticket view
    /// and returned to the board, so a ticket tab does the same: CLOSE this tab, then go to the
    /// board. Both steps are ordinary ParentNavigate calls — "/" is the shell's documented
    /// "close the active page" route — so nothing ticket-specific leaks into the shell, and the
    /// tab strip's own ✕ keeps its plain close-only behaviour.
    /// </summary>
    private void GoToBoard(bool isTicketTab)
    {
        if (isTicketTab && ParentNavigate != null)
        {
            ParentNavigate("/");                  // close this ticket tab
            ParentNavigate("/feedback-testing");  // then focus the board tab
            return;
        }
        GoHome();
    }

    // ── Linked work items (HHM-216) ─────────────────────────────────────────
    private string _newLinkType = "relates to";
    private string _newLinkTarget = "";
    private sealed class LinkOption { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    // A ticket's display key: the Jira key when it lives on the board, else the local PM-number.
    private static string TicketKeyLabel(FeedbackItem t) =>
        string.IsNullOrWhiteSpace(t.ExternalKey) ? $"PM-{t.TicketNumber}" : t.ExternalKey;

    private FeedbackItem? FindTicketByKey(string key) =>
        allFeedbacks.FirstOrDefault(f => string.Equals(TicketKeyLabel(f), key, StringComparison.OrdinalIgnoreCase));

    // Dropdown source: every board ticket except this one and ones already linked, newest first.
    private List<LinkOption> LinkTargetOptions(FeedbackItem m)
    {
        var already = new HashSet<string>((m.Links ?? new()).Select(l => l.TargetKey), StringComparer.OrdinalIgnoreCase);
        return allFeedbacks
            .Where(f => f.TicketNumber != m.TicketNumber && !already.Contains(TicketKeyLabel(f)))
            .OrderByDescending(f => f.TicketNumber)
            .Select(f => new LinkOption { Text = $"{TicketKeyLabel(f)} — {f.Topic}", Value = TicketKeyLabel(f) })
            .ToList();
    }

    private static string CapFirst(string s) =>
        string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s.Substring(1);

    private void AddLink(FeedbackItem m)
    {
        if (string.IsNullOrWhiteSpace(_newLinkTarget) || string.IsNullOrWhiteSpace(_newLinkType)) return;
        m.Links ??= new();
        if (m.Links.Any(l => string.Equals(l.TargetKey, _newLinkTarget, StringComparison.OrdinalIgnoreCase)
                          && string.Equals(l.Type, _newLinkType, StringComparison.OrdinalIgnoreCase))) return;
        var target = FindTicketByKey(_newLinkTarget);
        m.Links.Add(new TicketLink { Type = _newLinkType, TargetKey = _newLinkTarget, TargetSummary = target?.Topic ?? "" });
        _newLinkTarget = "";
        StateHasChanged();
        // The link persists + pushes to Jira with the ticket's Save (create-first / AutoExport).
    }

    private async Task RemoveLinkAsync(FeedbackItem m, TicketLink l)
    {
        m.Links?.Remove(l);
        StateHasChanged();
        // Best-effort: also remove it on the board when both ends live there. The token may lack
        // link-delete permission (same class as issue delete) — warn, never block the local edit.
        var targetKey = ResolveExternalKey(l.TargetKey);
        if (!string.IsNullOrWhiteSpace(m.ExternalKey) && !string.IsNullOrWhiteSpace(targetKey) && Jira.LoadSettings().IsConfigured)
        {
            try
            {
                var (ok, msg) = await Jira.DeleteIssueLinkAsync(m.ExternalKey, l.Type, targetKey);
                if (!ok) Notifications.Warning($"Removed locally; Jira link removal failed: {msg}");
            }
            catch { }
        }
    }

    // PM-N (local-only) keys resolve to that ticket's Jira key when it has one; "" when it doesn't.
    private string ResolveExternalKey(string key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "";
        if (!key.StartsWith("PM-", StringComparison.OrdinalIgnoreCase)) return key;
        return FindTicketByKey(key)?.ExternalKey ?? "";
    }

    private async Task OpenLinkedTicket(TicketLink l)
    {
        // Don't silently discard unsaved edits by jumping to another ticket.
        if (IsEditingNow && IsEditDirty()) { Notifications.Info("Save or cancel your edits first, then open the linked item."); return; }
        var t = FindTicketByKey(l.TargetKey);
        if (t is null) { Notifications.Info($"{l.TargetKey} isn't on the local board (try ↻ Sync)."); return; }
        await OpenTicket(t);
    }

    // Push this ticket's links onto the Jira board (dedup against the issue's current links) —
    // called after every create/update export once the ExternalKey is known. Best-effort.
    private async Task PushLinksToJiraAsync(FeedbackItem m)
    {
        if (string.IsNullOrWhiteSpace(m.ExternalKey) || (m.Links?.Count ?? 0) == 0) return;
        try
        {
            var existing = await Jira.GetIssueLinksAsync(m.ExternalKey);
            var have = new HashSet<string>(existing.Select(l => $"{l.Phrase}|{l.TargetKey}"), StringComparer.OrdinalIgnoreCase);
            foreach (var l in m.Links!)
            {
                var targetKey = ResolveExternalKey(l.TargetKey);
                if (string.IsNullOrWhiteSpace(targetKey)) continue;          // local-only target — nothing to link on Jira
                if (have.Contains($"{l.Type}|{targetKey}")) continue;        // already linked on the board
                var (ok, msg) = await Jira.CreateIssueLinkAsync(m.ExternalKey, l.Type, targetKey);
                if (!ok) Notifications.Warning($"Jira link \"{l.Type} {targetKey}\" failed: {msg}");
            }
        }
        catch { /* best-effort */ }
    }

    // Refresh a ticket's links from the board's issuelinks: Jira is the source of truth for
    // externally-keyed links; links to local-only PM- tickets (which Jira can't know) survive.
    private static void ApplyJiraLinks(FeedbackItem item, IReadOnlyList<JiraIssueLink> jiraLinks)
    {
        var next = (item.Links ?? new())
            .Where(l => l.TargetKey.StartsWith("PM-", StringComparison.OrdinalIgnoreCase))
            .ToList();
        next.AddRange(jiraLinks.Select(j => new TicketLink { Type = j.Phrase, TargetKey = j.TargetKey, TargetSummary = j.TargetSummary }));
        item.Links = next;
    }

    // Jira-style "Edit": turn the viewed ticket into the editable form (same fields as a new ticket).
    private void EditTicket()
    {
        // Promote a legacy plain-text description to HTML so it opens formatted in the rich editor
        // (instead of collapsing its line breaks). Saved back as HTML.
        if (selectedFeedback != null && !IsLikelyHtml(selectedFeedback.Description))
            selectedFeedback.Description = TextToHtml(selectedFeedback.Description);
        _editMode = true;
        SnapshotEdit();   // baseline for the unsaved-changes guard
        StateHasChanged();
    }

    // Footer primary button: create a new draft, or update the existing ticket being edited.
    private async Task SaveTicketAsync() { await TrySaveCurrentAsync(); }

    // Save the current draft (create) or the edited ticket (update). Returns true on a successful save.
    private async Task<bool> TrySaveCurrentAsync()
    {
        if (newFeedback != null) return await SubmitFeedbackAsync();
        if (_editMode && selectedFeedback != null) return await SaveEditedTicketAsync();
        return false;
    }

    private async Task<bool> SaveEditedTicketAsync()
    {
        if (selectedFeedback == null) return false;
        if (string.IsNullOrWhiteSpace(selectedFeedback.Topic))
        {
            Notifications.Warning("Please enter a title before saving.");
            return false;
        }
        if (_saveInProgress) return false;
        _saveInProgress = true;
        try
        {
            isSaving = true;
            StateHasChanged();
            await PersistFeedbackOptionsAsync(selectedFeedback);
            await FeedbackService.UpdateFeedbackAsync(selectedFeedback);
            Notifications.Success($"Ticket #{selectedFeedback.TicketNumber} updated.");
            await AutoExportToJiraAsync(selectedFeedback);   // always push to the Jira board when configured
            await PushStatusToJiraAsync(selectedFeedback);   // and keep the board status in step
            await LoadFeedbackHistoryAsync();
            selectedFeedback = allFeedbacks.FirstOrDefault(f => f.TicketNumber == selectedFeedback.TicketNumber) ?? selectedFeedback;
            FeedbackService.NotifyTicketChanged(selectedFeedback.TicketNumber);   // board re-groups lanes (Status may have changed)
            _editMode = false;   // back to read mode
            _editSnapshot = null;
            return true;
        }
        catch (Exception ex) { Notifications.Error($"Failed to update ticket: {ex.Message}"); return false; }
        finally { _saveInProgress = false; isSaving = false; StateHasChanged(); }
    }

    // Cancel: a new draft is discarded to the board; an edited existing ticket reverts (reloads) to read.
    private async Task CancelTicketEditAsync()
    {
        if (newFeedback != null) { GoHome(); return; }
        var num = selectedFeedback?.TicketNumber ?? 0;
        await LoadFeedbackHistoryAsync();   // drop in-memory edits by reloading from disk
        selectedFeedback = allFeedbacks.FirstOrDefault(f => f.TicketNumber == num);
        _editMode = false;
        if (selectedFeedback == null) { _view = FbView.Home; _restoreBoardScroll = true; }
        StateHasChanged();
    }

    // Home "Create" → a manual ticket with no screen capture.
    // New-ticket Description scaffold (HTML for EditorLiteControl): bold section headers the user
    // fills in. Steps is a plain paragraph — no forced numbering (HHM-158); Navigation is
    // prefilled from the captured menu path.
    private static string DescriptionScaffold(string? navPath) =>
        "<p><strong>Navigation:</strong></p>" +
        (string.IsNullOrWhiteSpace(navPath) ? "<p><br></p>" : $"<p>{System.Net.WebUtility.HtmlEncode(navPath)}</p>") +
        "<p><strong>Steps to Reproduce:</strong></p><p><br></p>" +
        "<p><strong>Actual Result:</strong></p><p><br></p>" +
        "<p><strong>Expected Result:</strong></p><p><br></p>";

    // Lead with an optional captured overview (plain text → paragraphs), then the section scaffold.
    private static string NewDescription(string? overview, string? navPath)
    {
        overview = (overview ?? "").Trim();
        var scaffold = DescriptionScaffold(navPath);
        if (overview.Length == 0) return scaffold;
        var paras = string.Concat(overview.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n')
            .Select(l => string.IsNullOrWhiteSpace(l) ? "<p><br></p>" : $"<p>{System.Net.WebUtility.HtmlEncode(l)}</p>"));
        return paras + scaffold;
    }

    // The menu path FMain captured at F8 (RunTaskAsync → diagnostics "NavigationPath"), e.g.
    // "Login → Setup → Edit item database" — used to prefill the Navigation section.
    private string ExtractNavPath()
    {
        var dj = FeedbackState.CurrentDiagnosticsJson;
        if (string.IsNullOrWhiteSpace(dj)) return "";
        try
        {
            using var doc = JsonDocument.Parse(dj);
            if (doc.RootElement.TryGetProperty("NavigationPath", out var np))
                return np.GetString() ?? "";
        }
        catch { }
        return "";
    }

    private async Task CreateManualTicket()
    {
        await CaptureBoardScrollAsync();   // +Create leaves the board too — remember its position
        newFeedback = new FeedbackItem
        {
            UserName = CurrentUserName,   // default Reporter = the selected "Current user"
            Url = "",
            ScreenName = "",
            FocusedControl = "",
            Description = DescriptionScaffold(null),   // prefill: bold-section scaffold (no captured nav path)
            EnvironmentInfo = _environment,            // prefill: browser + OS
            DueDate = DateTime.Today.AddDays(7),       // prefill: a week out
            StartDate = DateTime.Today,                // prefill: today
            Category = "Setup",                        // prefill: default area
            StoryPoints = "0.5",                       // prefill: default estimate
            FixVersion = "Release 1",                  // prefill: default fix version
            Sprint = _defaultSprint                    // prefill: the active sprint (e.g. "HYP Sprint 1")
        };
        screenshotDataUrl = string.Empty;
        _annotatedDataUrl = string.Empty;
        selectedFeedback = null;
        SnapshotEdit();   // baseline for the unsaved-changes guard
        _view = FbView.Ticket;   // straight to the ticket form (no attachment)
        StateHasChanged();
    }

    private async Task DeleteTicketAsync(FeedbackItem fb)
    {
        // Jira-style: always confirm a destructive delete first (this can't be undone).
        var label = fb.TicketNumber > 0 ? $"PM-{fb.TicketNumber}" : "this ticket";
        var topic = string.IsNullOrWhiteSpace(fb.Topic) ? "" : $" ({fb.Topic})";
        var key = fb.ExternalKey;
        bool onJira = !string.IsNullOrWhiteSpace(key) && Jira.LoadSettings().IsConfigured;
        var jiraNote = onJira ? $" It will also be deleted from the Jira board ({key})." : "";
        if (!await Dialogs.ConfirmAsync($"Delete {label}{topic}? This permanently removes the ticket and its attachments, and can't be undone.{jiraNote}", "Delete ticket"))
            return;

        try
        {
            await FeedbackService.DeleteFeedbackAsync(fb.TicketNumber);
            // Also remove it from the Jira board (best-effort — the local delete already happened).
            if (onJira)
            {
                var (ok, msg) = await Jira.DeleteIssueAsync(key);
                if (ok) Notifications.Success($"Ticket #{fb.TicketNumber} deleted (and {key} from Jira).");
                else Notifications.Warning($"Ticket #{fb.TicketNumber} deleted locally; Jira delete failed: {msg}");
            }
            else Notifications.Success($"Ticket #{fb.TicketNumber} deleted.");
            await LoadFeedbackHistoryAsync();
            if (selectedFeedback?.TicketNumber == fb.TicketNumber)
            {
                selectedFeedback = null;
                _editMode = false;
                // Deleting from a ticket tab leaves nothing to show — go back to the board's tab.
                if (IsTicketTabMode && ParentNavigate != null)
                {
                    // The ticket this tab exists for is gone — close the tab and show the board.
                    ParentNavigate("/");
                    ParentNavigate("/feedback-testing");
                    return;
                }
                _view = FbView.Home;
                _restoreBoardScroll = true;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Notifications.Error($"Failed to delete ticket: {ex.Message}");
        }
    }

    private async Task CaptureNewFeedbackAsync()
    {
        if (isSaving) return;
        ParentNavigate?.Invoke("/");
        await Task.Delay(300);
        await JSRuntime.InvokeVoidAsync("feedbackHelper.startCapture");
    }

    // Capture editor "Create" → flatten the annotation and open the ticket form with it attached.
    private async Task GoToTicketFormAsync()
    {
        if (newFeedback == null) return;
        if (_drawing is not null)
        {
            try { _annotatedDataUrl = await _drawing.GetImageAsync(); } catch { }
            // Persist the FULL editor state (cell images + captions + shapes) so re-editing restores
            // every pasted cell — GetShapesJsonAsync alone would drop them (HHM: lost-paste-on-reedit).
            try { newFeedback.AnnotationsJson = await _drawing.GetStateJsonAsync(); } catch { }
            // Prefill Description from whatever the user wrote on the image (one per line).
            try
            {
                if (string.IsNullOrWhiteSpace(newFeedback.Description))
                {
                    // The auto-stamped column titles ("HF .Net" / "Legacy VB6") are part of
                    // the IMAGE, not the user's notes — don't let them leak into the
                    // Description prefill (HHM-229). User-edited titles no longer match
                    // the defaults and are kept.
                    var defaultTitlesToFilter = new[] { "HomeFront", "HF .Net", "HF.Net", "HF.NET", "Legacy VB6" };
                    var texts = _drawing.GetShapeTexts()
                        .Where(t => !defaultTitlesToFilter.Any(d =>
                            string.Equals(d, (t ?? "").Trim(), StringComparison.OrdinalIgnoreCase)))
                        .ToList();
                    newFeedback.Description = NewDescription(texts.Count > 0 ? string.Join("\n", texts) : null, ExtractNavPath());
                }
            }
            catch { }
        }
        if (string.IsNullOrEmpty(_annotatedDataUrl)) _annotatedDataUrl = screenshotDataUrl;
        _view = FbView.Ticket;
        StateHasChanged();
    }

    private string? _editingAttachmentPath;   // which attachment file the modal editor is editing (null = primary/draft)
    private int _attachVersion;               // bumped after an in-place overwrite to bust the <img> cache

    // The attachments shown on the ticket screen: the model's Attachments list when populated (e.g. a Jira
    // import with several images), otherwise a single synthesized entry from the primary image.
    private static List<TicketAttachment> TicketAttachmentsFor(FeedbackItem m, string? primaryImg)
    {
        var result = new List<TicketAttachment>();
        var seen = new HashSet<string>(StringComparer.Ordinal);
        // Primary screenshot first — synthesise an entry only when it isn't already in the list
        // (imports already carry it; a captured/edited ticket holds it separately as ScreenshotPath).
        bool primaryInList = !string.IsNullOrEmpty(primaryImg)
            && m.Attachments.Any(a => string.Equals(a.Path, primaryImg, StringComparison.Ordinal));
        if (!string.IsNullOrEmpty(primaryImg) && !primaryInList)
        {
            result.Add(new() { Path = primaryImg!, FileName = "screenshot.png", ContentType = "image/png" });
            seen.Add(primaryImg!);
        }
        foreach (var a in m.Attachments)
        {
            if (string.IsNullOrEmpty(a.Path) || !seen.Add(a.Path)) continue;
            result.Add(a);
        }
        return result;
    }

    private static bool IsImageAttachment(TicketAttachment a)
    {
        if (!string.IsNullOrEmpty(a.ContentType)) return a.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
        var p = (a.Path ?? "").ToLowerInvariant();
        return p.StartsWith("data:image") || p.EndsWith(".png") || p.EndsWith(".jpg") || p.EndsWith(".jpeg")
            || p.EndsWith(".gif") || p.EndsWith(".webp") || p.EndsWith(".bmp");
    }

    // Cache-busted src for file-backed thumbnails so an in-place overwrite is visible without a reload.
    // Data-URL attachments (added but not yet persisted) are returned as-is.
    private string AttachSrc(TicketAttachment a) =>
        (!string.IsNullOrEmpty(a.Path) && a.Path.StartsWith("/")) ? $"{a.Path}?t={_attachVersion}" : (a.Path ?? "");

    // ── add attachments (file browser + clipboard) ──
    private async Task OnAttachFileSelected(InputFileChangeEventArgs e)
    {
        var m = newFeedback ?? selectedFeedback;
        if (m is null || e.File is null) return;
        try
        {
            await using var stream = e.File.OpenReadStream(25 * 1024 * 1024);   // up to ~25 MB
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var ct = string.IsNullOrWhiteSpace(e.File.ContentType) ? "application/octet-stream" : e.File.ContentType;
            await AddAttachmentAsync(m, e.File.Name, ct, $"data:{ct};base64,{Convert.ToBase64String(ms.ToArray())}");
        }
        catch (Exception ex) { Notifications.Error($"Couldn't attach file: {ex.Message}"); }
    }

    private async Task PasteAttachmentAsync()
    {
        var m = newFeedback ?? selectedFeedback;
        if (m is null) return;
        string url;
        try { url = await JSRuntime.InvokeAsync<string>("feedbackHelper.readClipboardImage"); }
        catch { url = ""; }
        if (string.IsNullOrEmpty(url)) { Notifications.Warning("No image found on the clipboard."); return; }
        await AddAttachmentAsync(m, $"pasted-{DateTime.Now:yyyyMMdd-HHmmss}.png", "image/png", url);
    }

    // Append an attachment (held as a data URL) to the ticket. For a SAVED ticket it's persisted
    // immediately (the service flattens data URLs → files); a NEW draft holds it until first save.
    private async Task AddAttachmentAsync(FeedbackItem m, string fileName, string contentType, string dataUrl)
    {
        m.Attachments.Add(new TicketAttachment { Path = dataUrl, FileName = fileName, ContentType = contentType });
        // HHM-146: in EDIT mode the attachment must NOT persist until the user clicks Save — it stays in
        // the in-memory Attachments list and is saved by SaveEditedTicketAsync. Only auto-save/upload when
        // NOT editing (this branch is now effectively for the read-mode add path).
        if (newFeedback == null && selectedFeedback != null && !_editMode)
        {
            try
            {
                await FeedbackService.UpdateFeedbackAsync(selectedFeedback);
                _attachVersion++;
                // New attachment on a ticket that's already on the board → upload it to Jira.
                if (!string.IsNullOrWhiteSpace(selectedFeedback.ExternalKey))
                {
                    try
                    {
                        var bytes = Convert.FromBase64String(dataUrl.Contains(',') ? dataUrl.Split(',')[1] : dataUrl);
                        await Jira.AttachFilesAsync(selectedFeedback.ExternalKey,
                            new List<TicketDownload> { new(bytes, contentType, fileName) });
                    }
                    catch (Exception jex) { Notifications.Warning($"Added locally; Jira upload failed: {jex.Message}"); }
                }
                await LoadFeedbackHistoryAsync();
                selectedFeedback = allFeedbacks.FirstOrDefault(f => f.TicketNumber == selectedFeedback.TicketNumber) ?? selectedFeedback;
                Notifications.Success("Attachment added.");
            }
            catch (Exception ex) { Notifications.Error($"Couldn't save attachment: {ex.Message}"); }
        }
        StateHasChanged();
    }

    // Delete an attachment/image from a ticket (HHM-144/157): remove from the model + clear the primary if
    // it was it, delete the file, persist, and remove it from Jira (best-effort).
    private async Task DeleteAttachmentAsync(FeedbackItem m, TicketAttachment a)
    {
        if (!await Dialogs.ConfirmAsync($"Delete attachment \"{a.FileName}\"?", "Delete attachment")) return;
        m.Attachments?.RemoveAll(x => string.Equals(x.Path, a.Path, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(a.Path))
        {
            if (string.Equals(m.ScreenshotPath, a.Path, StringComparison.OrdinalIgnoreCase)) m.ScreenshotPath = "";
            if (string.Equals(screenshotDataUrl, a.Path, StringComparison.Ordinal)) screenshotDataUrl = string.Empty;
            if (string.Equals(_annotatedDataUrl, a.Path, StringComparison.Ordinal)) _annotatedDataUrl = string.Empty;
        }
        FeedbackService.DeleteAttachmentFile(a.Path);
        if (newFeedback == null && selectedFeedback != null)
        {
            try { await FeedbackService.UpdateFeedbackAsync(m); }
            catch (Exception ex) { Notifications.Error($"Delete failed: {ex.Message}"); return; }
            if (!string.IsNullOrWhiteSpace(m.ExternalKey))
            {
                try { await Jira.DeleteAttachmentByNameAsync(m.ExternalKey, System.IO.Path.GetFileName((a.Path ?? "").Split('?')[0])); }
                catch (Exception jex) { Notifications.Warning($"Removed locally; Jira delete failed: {jex.Message}"); }
            }
            await LoadFeedbackHistoryAsync();
            selectedFeedback = allFeedbacks.FirstOrDefault(f => f.TicketNumber == m.TicketNumber) ?? selectedFeedback;
        }
        _attachVersion++;
        Notifications.Success("Attachment deleted.");
        StateHasChanged();
    }

    // ── Modal image editor (click a ticket attachment) ──
    private void OpenImageEditor(string? path = null)
    {
        if (newFeedback != null)
        {
            // Draft: re-edit the clean capture + its saved shapes (lossless).
            _modalImageUrl = string.IsNullOrEmpty(screenshotDataUrl) ? _annotatedDataUrl : screenshotDataUrl;
            _loadModalShapes = true;
            _editingAttachmentPath = null;
        }
        else if (selectedFeedback != null)
        {
            // Saved ticket: annotate further on top of the chosen attachment image (default = primary).
            var target = string.IsNullOrEmpty(path) ? selectedFeedback.ScreenshotPath : path;
            _editingAttachmentPath = target;
            _modalImageUrl = (!string.IsNullOrEmpty(target) && target.StartsWith("/")) ? $"{target}?t={_attachVersion}" : target;
            _loadModalShapes = false;
        }
        else { return; }
        _imageEditorOpen = true;
        StateHasChanged();
    }

    private void CloseImageEditor()
    {
        _imageEditorOpen = false;
        _modalDrawing = null;
        StateHasChanged();
    }

    private async Task ApplyImageEditor()
    {
        if (_modalDrawing is null) { CloseImageEditor(); return; }
        // Smart edit detection: opened-but-not-edited → nothing to persist or re-sync, just close.
        if (!_modalDrawing.IsModified) { CloseImageEditor(); return; }
        string newImg;
        string shapes;
        try { newImg = await _modalDrawing.GetImageAsync(); } catch { newImg = ""; }
        // Full editor state (cells + captions + shapes), so a further re-edit keeps every cell.
        try { shapes = await _modalDrawing.GetStateJsonAsync(); } catch { shapes = ""; }

        if (newFeedback != null)
        {
            if (!string.IsNullOrEmpty(newImg)) _annotatedDataUrl = newImg;
            newFeedback.AnnotationsJson = shapes;
        }
        else if (selectedFeedback != null && !string.IsNullOrEmpty(newImg))
        {
            try
            {
                // Overwrite ONLY the edited attachment file in place, so a multi-attachment ticket keeps its
                // other images. (The old delete-then-resave wiped every ticket_{N}_* file, losing siblings.)
                var target = string.IsNullOrEmpty(_editingAttachmentPath) ? selectedFeedback.ScreenshotPath : _editingAttachmentPath;
                if (!string.IsNullOrEmpty(target) && target.StartsWith("/"))
                {
                    await FeedbackService.OverwriteImageAsync(target, newImg);
                    // Persist the annotation vectors on the JSON record only when the PRIMARY image was edited.
                    if (string.Equals(target, selectedFeedback.ScreenshotPath, StringComparison.Ordinal))
                    {
                        selectedFeedback.AnnotationsJson = shapes;
                        await FeedbackService.UpdateFeedbackAsync(selectedFeedback);
                    }
                    _attachVersion++;   // bust the <img> cache so the edit shows immediately

                    // Re-sync ONLY this edited attachment to Jira (replace its old version), when on the board.
                    if (!string.IsNullOrWhiteSpace(selectedFeedback.ExternalKey))
                    {
                        try
                        {
                            var fileName = System.IO.Path.GetFileName(target.Split('?')[0]);
                            var bytes = Convert.FromBase64String(newImg.Contains(',') ? newImg.Split(',')[1] : newImg);
                            await Jira.ReplaceAttachmentsAsync(selectedFeedback.ExternalKey,
                                new List<TicketDownload> { new(bytes, "image/png", fileName) });
                        }
                        catch (Exception jex) { Notifications.Warning($"Updated locally; Jira attachment sync failed: {jex.Message}"); }
                    }

                    await LoadFeedbackHistoryAsync();
                    selectedFeedback = allFeedbacks.FirstOrDefault(f => f.TicketNumber == selectedFeedback.TicketNumber) ?? selectedFeedback;
                    Notifications.Success($"Ticket #{selectedFeedback.TicketNumber} updated.");
                    StateHasChanged();   // HHM-143: re-render so the bumped _attachVersion re-fetches the edited image
                }
            }
            catch (Exception ex) { Notifications.Error($"Failed to update screenshot: {ex.Message}"); }
        }
        else if (newFeedback == null && selectedFeedback != null && string.IsNullOrEmpty(newImg))
        {
            Notifications.Warning("Couldn't read the edited image — nothing was saved.");   // HHM-143: surface the silent failure
        }
        CloseImageEditor();
    }

    private async Task<bool> SubmitFeedbackAsync()
    {
        if (newFeedback == null) return false;
        if (string.IsNullOrWhiteSpace(newFeedback.Topic))
        {
            _view = FbView.Ticket;
            Notifications.Warning("Please enter a title before saving.");
            return false;
        }

        if (_saveInProgress) return false;   // a concurrent save is already running — don't create a duplicate
        _saveInProgress = true;
        try
        {
            isSaving = true;
            StateHasChanged();

            var img = string.IsNullOrEmpty(_annotatedDataUrl) ? screenshotDataUrl : _annotatedDataUrl;
            await PersistFeedbackOptionsAsync(newFeedback);

            // New→Save: the ticket number comes from the Jira board. Create the issue FIRST (no
            // attachment yet — the local files don't exist) so the local TicketNumber matches the
            // assigned Jira key; then save under that number and attach. Falls back to the local
            // sequence when Jira isn't configured or the create fails.
            var js = Jira.LoadSettings();
            JiraImportResult? created = null;
            if (js.IsConfigured)
            {
                created = await Jira.CreateIssueAsync(new JiraExportOptions
                {
                    ProjectKey = js.ProjectKey,
                    IssueType = MapIssueType(string.IsNullOrWhiteSpace(newFeedback.IssueType) ? js.IssueType : newFeedback.IssueType),
                    Summary = newFeedback.Topic.Trim(),
                    Description = BuildJiraDescription(newFeedback),
                    Attach = false,
                    Assignee = newFeedback.Assignee,
                    Reporter = newFeedback.UserName,
                    Labels = newFeedback.Labels,
                    Sprint = newFeedback.Sprint,
                    Priority = newFeedback.Priority
                });
                if (created.Success)
                {
                    newFeedback.ExternalKey = created.IssueKey;
                    if (TryParseIssueNumber(created.IssueKey, out var n)) newFeedback.TicketNumber = n;
                }
                else { Notifications.Warning($"Jira export failed; saving locally: {created.Error}"); }
            }

            await FeedbackService.SaveFeedbackAsync(newFeedback, img ?? "");
            Notifications.Success(created?.Success == true
                ? $"Saved as {newFeedback.ExternalKey} on Jira."
                : $"Ticket #{newFeedback.TicketNumber} saved.");

            // Attach all of the ticket's files (annotated screenshot + any extra attachments) now they exist.
            if (created?.Success == true)
            {
                try { await Jira.AttachFilesAsync(newFeedback.ExternalKey, await FeedbackService.GatherAttachmentsAsync(newFeedback)); } catch { }
                try { await PushLinksToJiraAsync(newFeedback); } catch { }   // HHM-216: links added while creating
            }

            await LoadFeedbackHistoryAsync();
            newFeedback = null;
            _annotatedDataUrl = string.Empty;
            _editSnapshot = null;
            _view = FbView.Home;   // save → return to the board
            _restoreBoardScroll = true;
            return true;
        }
        catch (Exception ex)
        {
            Notifications.Error($"Failed to save feedback: {ex.Message}");
            return false;
        }
        finally
        {
            _saveInProgress = false;
            isSaving = false;
            StateHasChanged();
        }
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpperInvariant();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpperInvariant();
    }

    // Per-person avatar colour (deterministic from the name) so each person gets a distinct initials chip.
    private static readonly string[] _avatarColors =
        { "#1c5fc4", "#0a8a6a", "#b3541e", "#7b3fa0", "#c2185b", "#00838f", "#5d6d7e", "#d97706", "#2e7d32", "#5e35b1" };
    private static string AvatarColorStyle(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "background:#9aa5b1";
        int h = 0; foreach (var ch in name.Trim().ToLowerInvariant()) h = (h * 31 + ch) & 0x7fffffff;
        return "background:" + _avatarColors[h % _avatarColors.Length];
    }

    // Avatar chip: coloured initials circle (one colour per person). Display-only; never stored or sent to Jira.
    private RenderFragment RenderAvatar(string? name, string cls = "") =>
        @<span class="jt-avatar @cls" style="@AvatarColorStyle(name)" title="@(name ?? "")">@Initials(name)</span>;

    // Well-known Description section headers that render bold (Jira parity). Matched case-insensitively,
    // with or without a trailing colon, on an otherwise-bare line. The Description body now carries
    // Navigation / Steps to Reproduce / Actual Result / Expected Result as bold sections in-line.
    private static readonly string[] _descHeaders =
    {
        "Description", "Overview", "Navigation", "Prerequisites", "Steps to Reproduce",
        "Actual Result", "Expected Result", "Environment", "Notes", "Workaround", "Root Cause"
    };

    // EditorLiteControl stores HTML; legacy/imported descriptions are plain text. Detect which so the
    // read view renders HTML directly (else falls back to the plain-text header-bolding renderer).
    private static bool IsLikelyHtml(string? s) =>
        !string.IsNullOrEmpty(s) && Regex.IsMatch(s, "<(p|br|div|h[1-6]|ul|ol|li|strong|em|u|a|blockquote|span)\\b", RegexOptions.IgnoreCase);

    // Plain text → HTML (paragraphs; known section headers bolded) so a legacy ticket opens cleanly in
    // the rich editor instead of collapsing its line breaks.
    private static string TextToHtml(string? text)
    {
        if (string.IsNullOrEmpty(text)) return "";
        if (IsLikelyHtml(text)) return text;
        var sb = new StringBuilder();
        foreach (var line in text.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n'))
        {
            if (string.IsNullOrWhiteSpace(line)) { sb.Append("<p><br></p>"); continue; }
            var trimmed = line.Trim();
            bool isHeader = _descHeaders.Any(h =>
                trimmed.Equals(h, StringComparison.OrdinalIgnoreCase) || trimmed.Equals(h + ":", StringComparison.OrdinalIgnoreCase));
            sb.Append(isHeader
                ? $"<p><strong>{System.Net.WebUtility.HtmlEncode(trimmed)}</strong></p>"
                : $"<p>{System.Net.WebUtility.HtmlEncode(line)}</p>");
        }
        return sb.ToString();
    }

    // HTML → plain text for the Jira export payload (Jira REST v2 description is text, not HTML).
    private static string HtmlToText(string? html)
    {
        if (string.IsNullOrEmpty(html)) return "";
        if (!IsLikelyHtml(html)) return html;
        var s = Regex.Replace(html, "<li[^>]*>", "\n- ", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, "</(p|div|h[1-6]|li|ul|ol|blockquote|tr)>", "\n", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, "<br\\s*/?>", "\n", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, "<[^>]+>", string.Empty);
        s = System.Net.WebUtility.HtmlDecode(s);
        return Regex.Replace(s, "\n{3,}", "\n\n").Trim();
    }

    // Read-mode description: render EditorLiteControl HTML directly, else the plain-text header-bolding
    // renderer (legacy / imported tickets). One method so the markup stays a single @-expression.
    private RenderFragment RenderDescription(string? text) => builder =>
    {
        if (IsLikelyHtml(text))
            builder.AddMarkupContent(0, text);
        else
            RenderRichDescription(text)(builder);
    };

    private RenderFragment RenderRichDescription(string? text) => builder =>
    {
        int seq = 0;
        if (string.IsNullOrWhiteSpace(text))
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "jt-muted");
            builder.AddContent(seq++, "No description provided.");
            builder.CloseElement();
            return;
        }
        foreach (var line in text.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n'))
        {
            var trimmed = line.Trim();
            var isHeader = _descHeaders.Any(h =>
                trimmed.Equals(h, StringComparison.OrdinalIgnoreCase) ||
                trimmed.Equals(h + ":", StringComparison.OrdinalIgnoreCase));
            if (isHeader)
            {
                builder.OpenElement(seq++, "strong");
                builder.AddAttribute(seq++, "class", "jt-desc-head");
                builder.AddContent(seq++, trimmed);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(seq++, line);
            }
            builder.OpenElement(seq++, "br");
            builder.CloseElement();
        }
    };

    // Map the captured screen (MDI tab title, e.g. "FAssembly – Alyssa 2022") to the VB6 form's
    // friendly menu title for the VB6-form field. Extend as more forms are mapped; falls back to the
    // leading form token so the user can refine an unknown.
    private static readonly Dictionary<string, string> _vb6MenuTitles = new(StringComparer.OrdinalIgnoreCase)
    {
        ["FAssembly"]        = "Edit Models and Options",
        ["FTakeoff"]         = "Takeoff",
        ["FJob"]             = "Job Setup",
        ["FVendor"]          = "Vendor Setup",
        ["FPriceList"]       = "Vendor Price List",
        ["FItems"]           = "Item Database",
        ["FOptions"]         = "System Settings",
        ["FCustomer"]        = "Customer Setup",
        ["FPurchaseOrder"]   = "Purchase Orders",
        ["FCommunities"]     = "Communities",
        ["FProjectManagers"] = "Project Managers",
    };
    private static string InferVB6Form(string? screenName)
    {
        if (string.IsNullOrWhiteSpace(screenName)) return "";
        var token = screenName.Split('–', '—', '-', ':', '|')[0].Trim();
        return _vb6MenuTitles.TryGetValue(token, out var title) ? title : token;
    }

    // Board grouping key: the VB6 menu option that owns the form a ticket came from, so every record
    // and sub-control of one form lands in a single box (e.g. anything in FAssembly — gItems, Items,
    // Assembly — rolls up to "Edit Models and Options"). Honours an explicit VB6Form override; falls
    // back to the captured screen, then Category, then "General".
    private static string MenuOptionFor(FeedbackItem f)
    {
        if (!string.IsNullOrWhiteSpace(f.VB6Form)) return f.VB6Form.Trim();
        var byScreen = InferVB6Form(f.ScreenName);
        if (!string.IsNullOrWhiteSpace(byScreen)) return byScreen;
        if (!string.IsNullOrWhiteSpace(f.Category)) return f.Category.Trim();
        return "General";
    }

    // Default ticket title: "Menu option — Window title" (e.g. "Edit Models and Options — FAssembly –
    // Alyssa 2022"). Collapses to one when they overlap or either is missing.
    private static string ComposeTitle(string? menuOption, string? windowTitle)
    {
        menuOption = (menuOption ?? "").Trim();
        windowTitle = (windowTitle ?? "").Trim();
        if (string.IsNullOrEmpty(windowTitle)) return menuOption;
        if (string.IsNullOrEmpty(menuOption)) return windowTitle;
        if (windowTitle.StartsWith(menuOption, StringComparison.OrdinalIgnoreCase)) return windowTitle;
        return $"{menuOption} — {windowTitle}";
    }

    private async Task EmailTicketAsync()
    {
        var m = selectedFeedback;
        if (m == null) return;

        var defaultEmail = "";
        var sendTo = await Dialogs.PromptAsync("Send Ticket via Email - Enter recipient email address:", defaultEmail, "Email Ticket");
        if (string.IsNullOrWhiteSpace(sendTo)) return;

        var subject = $"[Feedback] PM-{m.TicketNumber}: {m.Topic}";
        var bodySb = new System.Text.StringBuilder();
        bodySb.AppendLine($"Ticket Number: PM-{m.TicketNumber}");
        bodySb.AppendLine($"Topic: {m.Topic}");
        bodySb.AppendLine($"Issue Type: {m.IssueType}");
        bodySb.AppendLine($"Priority: {m.Priority}");
        bodySb.AppendLine($"Status: {m.Status}");
        bodySb.AppendLine($"Severity: {m.Severity}");
        bodySb.AppendLine($"Reporter: {m.UserName}");
        bodySb.AppendLine($"Assignee: {m.Assignee}");
        bodySb.AppendLine($"Created Date: {m.CreatedDate}");
        if (!string.IsNullOrWhiteSpace(m.Category)) bodySb.AppendLine($"Category: {m.Category}");
        if (!string.IsNullOrWhiteSpace(m.EnvironmentInfo)) bodySb.AppendLine($"Environment: {m.EnvironmentInfo}");
        bodySb.AppendLine();
        bodySb.AppendLine("Description:");
        bodySb.AppendLine(m.Description);
        bodySb.AppendLine();
        if (!string.IsNullOrWhiteSpace(m.StepsToReproduce))
        {
            bodySb.AppendLine("Steps to Reproduce:");
            bodySb.AppendLine(m.StepsToReproduce);
            bodySb.AppendLine();
        }
        if (!string.IsNullOrWhiteSpace(m.ActualResult))
        {
            bodySb.AppendLine("Actual Result:");
            bodySb.AppendLine(m.ActualResult);
            bodySb.AppendLine();
        }
        if (!string.IsNullOrWhiteSpace(m.ExpectedResult))
        {
            bodySb.AppendLine("Expected Result:");
            bodySb.AppendLine(m.ExpectedResult);
            bodySb.AppendLine();
        }
        if (!string.IsNullOrWhiteSpace(m.Url))
        {
            bodySb.AppendLine($"Page URL: {m.Url}");
        }

        var body = bodySb.ToString();
        var attachments = m.ScreenshotPath ?? "";

        bool success = false;
        try
        {
            // Open the user's mail client with the ticket prefilled. (The legacy server-side
            // Application.HFApp.SendMail path was removed — that static doesn't exist in HomeFront, and a
            // per-circuit static mailer is exactly the multi-user-leak pattern we eliminated. For true
            // server-side send, wire a proper injected mail service into both apps.)
            _ = attachments; // (mailto can't attach; the screenshot stays on the ticket)
            var mailtoUrl = $"mailto:{Uri.EscapeDataString(sendTo)}?subject={Uri.EscapeDataString(subject)}&body={Uri.EscapeDataString(body)}";
            await JSRuntime.InvokeVoidAsync("open", mailtoUrl, "_blank");
            success = true;
        }
        catch (Exception ex)
        {
            Notifications.Error($"Failed to send email: {ex.Message}");
            return;
        }

        if (success)
        {
            Notifications.Success($"Email request sent successfully.");
        }
    }

    // Board/ticket label: the external tracker key (e.g. "HHM-12") for imported tickets, else "PM-{number}".
    private static string TicketLabel(FeedbackItem f) =>
        !string.IsNullOrWhiteSpace(f.ExternalKey) ? f.ExternalKey : $"PM-{f.TicketNumber}";
}
