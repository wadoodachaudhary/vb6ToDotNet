@page "/feedback-testing"
@layout HFComponent
@rendermode InteractiveServer
@implements IDisposable
@implements Fx.ControlKit.Mdi.IMdiCloseGuard
@namespace HomeFront.Components.Pages
@using System
@using System.Collections.Generic
@using System.IO
@using System.Linq
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Text.RegularExpressions
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Forms
@using HomeFront.Models
@using HomeFront.Services
@using Fx.ControlKit.Notifications
@using Fx.ControlKit.Dialogs
@using Fx.ControlKit.Mdi
@using Fx.ControlKit.Drawing
@* NB: do NOT `@using Fx.ControlKit.Editor` — it has its own TextAreaControl that collides with
   Fx.ControlKit.TextAreaControl used here. EditorLiteControl is referenced fully-qualified instead. *@
@inject IFeedbackService FeedbackService
@inject FeedbackStateService FeedbackState
@inject ISessionStateService SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NotificationService Notifications
@inject IJiraService Jira
@inject ILogger<FFeedback> Logger

@* ── Ticket view template ─────────────────────────────────────────────────────────────
   ONE definition of the Jira-style ticket screen, rendered in two places:
     • the board's own tab — while composing a NEW capture/draft (the board is not useful then);
     • a DEDICATED TICKET TAB — an existing ticket opened from the board via
       /feedback-ticket/{n}. FMain treats that route as "always fresh", so each ticket the user
       opens becomes its own MDI tab while the board keeps its tab. Every tab is a separate
       component instance, so per-ticket state is independent for free.
   The body is identical in both; `isTicketTab` only relabels the back/close affordances. *@
@{
    RenderFragment<TicketViewCtx> ticketView = __ctx =>
    @<text>
        @{
            var m = __ctx.Item;
            var editing = __ctx.Editing;
            var isNew = __ctx.IsNew;
            var img = __ctx.Img;
            var isTicketTab = __ctx.IsTicketTab;
        }
        <div class="jira-ticket">
            <div class="jt-header">
                <div class="jt-breadcrumb">
                    @* From a dedicated ticket tab the crumb SWITCHES to the board's tab instead of
                       tearing this ticket down — the board is its own tab and stays open. *@
                    <button class="jt-crumb-btn" @onclick="@(() => GoToBoard(isTicketTab))"><i class="bi bi-clipboard-check"></i> Feedback</button>
                    <span class="jt-sep">/</span>
                    <span class="jt-key">@(isNew ? "New ticket" : TicketLabel(m))</span>
                </div>
                <div class="jt-header-actions">
                    @if (editing)
                    {
                        <DropDownListControl TValue="string" TItem="string"
                                             DataSource="@_statuses"
                                             Value="@m.Status"
                                             ValueChanged='@(async value => { m.Status = value ?? string.Empty; await OnOptionEnteredAsync("Status", value); })'
                                             Editable="true"
                                             OpenOnArrowClickOnly="true"
                                             CssClass="jt-editable-dd jt-status-dd"
                                             Width="132px" />
                    }
                    else
                    {
                        <button class="btn btn-primary btn-sm jt-edit-btn" @onclick="EditTicket"><i class="bi bi-pencil-fill"></i> Edit</button>
                        <span class="jt-status-badge">@m.Status</span>
                    }
                    @* Only the board's own tab needs an in-body ✕ (it "closes" the ticket view
                       back to the board). A dedicated ticket TAB is closed by the tab strip's
                       own ✕ — a second close glyph here would be ambiguous. *@
                    @if (!isTicketTab)
                    {
                        <button class="jt-iconbtn" title="Back to board" @onclick="GoHome"><i class="bi bi-x-lg"></i></button>
                    }
                </div>
            </div>

            <div class="jt-body">
                <div class="jt-main">
                    @if (editing)
                    {
                        <input class="jt-title-input" placeholder="Add a title…" @bind-value="m.Topic" />
                    }
                    else
                    {
                        <h1 class="jt-title">@m.Topic</h1>
                    }

                    @* Description is one body whose well-known headers (Navigation / Steps to Reproduce /
                       Actual Result / Expected Result …) render bold — matching Jira. The separate
                       Prerequisites / Steps / Actual / Expected fields were folded in here. *@
                    <div class="jt-section">
                        <div class="jt-section-h">Description</div>
                        @if (editing)
                        {
                            <Fx.ControlKit.Editor.EditorLiteControl @bind-Value="m.Description"
                                               Changed="@(v => m.DescriptionJira = v.JiraText)"
                                               Placeholder="Describe the issue — use the toolbar to format (headings, bold, lists, links)…"
                                               MinHeight="240px" CssClass="jt-desc-editor" />
                        }
                        else
                        {
                            <div class="jt-desc jt-desc-rich">@RenderDescription(m.Description)</div>
                        }
                    </div>

                    @{ var atts = TicketAttachmentsFor(m, img); }
                    @{ var pairView = atts.Count == 2 && atts.All(IsImageAttachment); }
                    <div class="jt-section">
                        <div class="jt-section-h">Attachments @(atts.Count > 0 ? atts.Count.ToString() : "")</div>
                        @if (atts.Count > 0)
                        {
                            <div class="jt-attachments @(pairView ? "jt-attachments-pair" : "")">
                                @foreach (var a in atts)
                                {
                                    <div class="jt-attach-wrap @(pairView ? "jt-attach-wrap-pair" : "")">
                                        @if (IsImageAttachment(a))
                                        {
                                            <div class="jt-attach-card @(pairView ? "jt-attach-card-pair" : "")" @onclick="@(() => OpenImageEditor(a.Path))" title="Click to view / annotate">
                                                <div class="jt-attach-thumbwrap"><img class="jt-attach-thumb" src="@AttachSrc(a)" alt="@a.FileName" /></div>
                                                <div class="jt-attach-meta">
                                                    <div class="jt-attach-name"><i class="bi bi-pencil-square"></i> @a.FileName</div>
                                                    @if (!pairView) { <div class="jt-attach-sub">Click to open the image editor</div> }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <a class="jt-attach-card" href="@a.Path" target="_blank" download title="Download @a.FileName">
                                                <div class="jt-attach-thumbwrap jt-attach-file"><i class="bi bi-file-earmark-text"></i></div>
                                                <div class="jt-attach-meta">
                                                    <div class="jt-attach-name">@a.FileName</div>
                                                    <div class="jt-attach-sub">Download</div>
                                                </div>
                                            </a>
                                        }
                                        @* HHM-157: the delete × is always shown (not just in edit mode) so any attachment
                                           can be removed straight from the board's ticket view; the handler confirms first. *@
                                        <button type="button" class="jt-attach-del" title="Delete attachment"
                                                @onclick="@(() => DeleteAttachmentAsync(m, a))" @onclick:stopPropagation="true"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                }
                            </div>
                        }
                        else if (!editing)
                        {
                            <div class="jt-muted">No attachment.</div>
                        }

                        @if (editing)
                        {
                            <div class="jt-attach-actions">
                                <button type="button" class="jt-attach-add" @onclick="CaptureNewFeedbackAsync"><i class="bi bi-camera"></i> Capture screen</button>
                                <label class="jt-attach-add" title="Attach an image or file from disk">
                                    <i class="bi bi-paperclip"></i> Attach file
                                    <InputFile OnChange="OnAttachFileSelected" class="jt-attach-fileinput" />
                                </label>
                                <button type="button" class="jt-attach-add" @onclick="PasteAttachmentAsync"><i class="bi bi-clipboard"></i> Paste image</button>
                            </div>
                        }
                    </div>

                    @* ── Linked work items (HHM-216) — Jira-style issue links: a relationship
                       dropdown + a ticket dropdown; chips open the linked ticket. Links push
                       to the Jira board on save and refresh from Jira's issuelinks on sync. ── *@
                    @{ var links = m.Links ?? new(); }
                    <div class="jt-section jt-links">
                        <div class="jt-section-h">Linked work items @(links.Count > 0 ? links.Count.ToString() : "")</div>
                        @foreach (var grp in links.GroupBy(l => l.Type))
                        {
                            <div class="jt-link-group">@CapFirst(grp.Key)</div>
                            @foreach (var l in grp)
                            {
                                var target = FindTicketByKey(l.TargetKey);
                                <div class="jt-link-row">
                                    <button type="button" class="jt-link-card" title="Open @l.TargetKey" @onclick="@(() => OpenLinkedTicket(l))">
                                        <span class="jt-link-key">@l.TargetKey</span>
                                        <span class="jt-link-sum">@(target?.Topic ?? l.TargetSummary)</span>
                                        @if (target != null)
                                        {
                                            <span class="jt-link-status">@target.Status</span>
                                        }
                                    </button>
                                    @if (editing)
                                    {
                                        <button type="button" class="jt-link-del" title="Remove link" @onclick="@(() => RemoveLinkAsync(m, l))">✕</button>
                                    }
                                </div>
                            }
                        }
                        @if (links.Count == 0 && !editing)
                        {
                            <div class="jt-muted">No linked work items.</div>
                        }
                        @if (editing)
                        {
                            <div class="jt-link-add">
                                <DropDownListControl TValue="string" TItem="string"
                                                     Value="@_newLinkType"
                                                     ValueChanged="@((string v) => _newLinkType = v)"
                                                     DataSource="@JiraService.LinkPhrases.ToList()"
                                                     Width="150px" />
                                <DropDownListControl TValue="string" TItem="LinkOption"
                                                     Value="@_newLinkTarget"
                                                     ValueChanged="@((string v) => _newLinkTarget = v)"
                                                     DataSource="@LinkTargetOptions(m)"
                                                     TextFieldName="Text" ValueFieldName="Value"
                                                     Placeholder="Select a work item…"
                                                     Width="420px" />
                                <button type="button" class="jt-attach-add" @onclick="@(() => AddLink(m))" disabled="@string.IsNullOrWhiteSpace(_newLinkTarget)">＋ Link</button>
                            </div>
                        }
                    </div>

                    @* Jira-style comment thread — only for saved tickets. FlexKit controls only. *@
                    @if (!isNew)
                    {
                        <div class="jt-section jt-comments">
                            <div class="jt-section-h">Comments @((m.Comments?.Count ?? 0) > 0 ? m.Comments!.Count.ToString() : "")</div>
                            @foreach (var c in m.Comments ?? new())
                            {
                                var author = string.IsNullOrWhiteSpace(c.Author) ? "Application User" : c.Author;
                                <div class="jt-comment">
                                    @RenderAvatar(author)
                                    <div class="jt-comment-body">
                                        <div class="jt-comment-head">
                                            <span class="jt-comment-author">@author</span>
                                            <span class="jt-comment-date">@c.Date.ToString("MMM d, yyyy · h:mm tt")@(c.EditedDate.HasValue ? " · edited" : "")</span>
                                            <span class="jt-comment-actions">
                                                <button type="button" class="jt-comment-act" title="Edit comment" @onclick="@(() => StartEditComment(c))"><i class="bi bi-pencil"></i></button>
                                                <button type="button" class="jt-comment-act" title="Delete comment" @onclick="@(() => DeleteCommentAsync(c))"><i class="bi bi-trash"></i></button>
                                            </span>
                                        </div>
                                        @if (_editingCommentId == c.Id && !string.IsNullOrEmpty(c.Id))
                                        {
                                            <div class="jt-comment-edit">
                                                <TextAreaControl @bind-Value="_editCommentText" UpdateOnInput="true" Rows="2" CssClass="jt-comment-input" />
                                                <div class="jt-comment-edit-actions">
                                                    <ButtonControl CssClass="jt-comment-btn" OnClick="@(() => SaveCommentEditAsync(c))">Save</ButtonControl>
                                                    <ButtonControl CssClass="jt-comment-btn jt-comment-btn-sec" OnClick="CancelCommentEdit">Cancel</ButtonControl>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="jt-comment-text">@c.Text</div>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="jt-comment-add">
                                <TextAreaControl @bind-Value="_newComment" UpdateOnInput="true" Placeholder="Add a comment…" Rows="2" CssClass="jt-comment-input" />
                                <ButtonControl CssClass="jt-comment-btn" OnClick="AddCommentAsync">Comment</ButtonControl>
                            </div>
                        </div>

                        @* Activity / history — the Jira changelog for synced tickets (HHM-147). *@
                        <div class="jt-section jt-activity">
                            <div class="jt-section-h">
                                Activity
                                @if (!string.IsNullOrWhiteSpace(m.ExternalKey))
                                {
                                    <button type="button" class="jt-activity-refresh" @onclick="@(() => LoadActivityAsync(m))" disabled="@_activityLoading" title="Load the activity history from Jira">
                                        <i class="bi @(_activityLoading ? "bi-arrow-repeat" : "bi-clock-history")"></i> @(_activityLoading ? "Loading…" : "Refresh")
                                    </button>
                                }
                            </div>
                            @if (string.IsNullOrWhiteSpace(m.ExternalKey))
                            {
                                <div class="jt-muted">Activity history is available for tickets synced to Jira.</div>
                            }
                            else if (_activityForTicket == m.TicketNumber && _activity.Count > 0)
                            {
                                <div class="jt-activity-list">
                                    @foreach (var ev in _activity)
                                    {
                                        <div class="jt-activity-row">
                                            <span class="jt-activity-author">@ev.Author</span>
                                            <span class="jt-activity-txt">changed <b>@ev.Field</b>@(string.IsNullOrEmpty(ev.OldValue) ? "" : $" from “{ev.OldValue}”")@(string.IsNullOrEmpty(ev.NewValue) ? "" : $" to “{ev.NewValue}”")</span>
                                            <span class="jt-activity-date">@ev.Date.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</span>
                                        </div>
                                    }
                                </div>
                            }
                            else if (_activityForTicket == m.TicketNumber)
                            {
                                <div class="jt-muted">No recorded activity.</div>
                            }
                            else if (!_activityLoading)
                            {
                                <div class="jt-muted">Click Refresh to load the Jira activity history.</div>
                            }
                        </div>
                    }

                </div>

                <div class="jt-side">
                    <div class="jt-side-box">
                    <div class="jt-side-h">Details</div>
                    <div class="jt-field">
                        <div class="jt-flabel">Issue type</div>
                        <div class="jt-fval">
                            @if (editing)
                            {
                                <DropDownListControl TValue="string" TItem="string"
                                                     DataSource="@_issueTypes"
                                                     Value="@m.IssueType"
                                                     ValueChanged='@(async value => { m.IssueType = value ?? string.Empty; await OnOptionEnteredAsync("IssueType", value); })'
                                                     Editable="true"
                                                     OpenOnArrowClickOnly="true"
                                                     CssClass="jt-editable-dd"
                                                     Width="100%" />
                            }
                            else { <span class="jt-issuetype jt-it-@IssueTypeSlug(m.IssueType)">@m.IssueType</span> }
                        </div>
                    </div>
                    <div class="jt-field"><div class="jt-flabel">Status</div><div class="jt-fval">@m.Status</div></div>
                    <div class="jt-field">
                        <div class="jt-flabel">Assignee</div>
                        <div class="jt-fval">
                            @if (editing)
                            {
                                <DropDownListControl TValue="string" TItem="string"
                                                     DataSource="@_assignees"
                                                     Value="@m.Assignee"
                                                     ValueChanged='@(async value => { m.Assignee = value ?? string.Empty; await OnOptionEnteredAsync("Assignee", value); })'
                                                     Editable="true" OpenOnArrowClickOnly="true"
                                                     Placeholder="Unassigned" CssClass="jt-editable-dd" Width="100%" />
                            }
                            else if (string.IsNullOrWhiteSpace(m.Assignee) || m.Assignee == "Unassigned")
                            {
                                <span>@RenderAvatar(null) Unassigned</span>
                            }
                            else { <span>@RenderAvatar(m.Assignee) @m.Assignee</span> }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Reporter</div>
                        <div class="jt-fval">
                            @if (editing)
                            {
                                <DropDownListControl TValue="string" TItem="string"
                                                     DataSource="@_reporters"
                                                     Value="@m.UserName"
                                                     ValueChanged='@(async value => { m.UserName = value ?? string.Empty; await OnOptionEnteredAsync("Reporter", value); })'
                                                     Editable="true" OpenOnArrowClickOnly="true"
                                                     Placeholder="Your name" CssClass="jt-editable-dd" Width="100%" />
                            }
                            else { <span>@RenderAvatar(m.UserName, "jt-avatar-amber") @m.UserName</span> }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Priority</div>
                        <div class="jt-fval">
                            @if (editing)
                            {
                                <DropDownListControl TValue="string" TItem="string"
                                                     DataSource="@_priorities"
                                                     Value="@m.Priority"
                                                     ValueChanged='@(async value => { m.Priority = value ?? string.Empty; await OnOptionEnteredAsync("Priority", value); })'
                                                     Editable="true"
                                                     OpenOnArrowClickOnly="true"
                                                     CssClass="jt-editable-dd"
                                                     Width="100%" />
                            }
                            else { <span class="jt-priority jt-priority-@m.Priority.ToLowerInvariant()"><i class="bi bi-flag-fill"></i> @m.Priority</span> }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Severity</div>
                        <div class="jt-fval">
                            @if (editing)
                            {
                                <DropDownListControl TValue="string" TItem="string"
                                                     DataSource="@_severities"
                                                     Value="@m.Severity"
                                                     ValueChanged='@(async value => { m.Severity = value ?? string.Empty; await OnOptionEnteredAsync("Severity", value); })'
                                                     Editable="true"
                                                     OpenOnArrowClickOnly="true"
                                                     CssClass="jt-editable-dd"
                                                     Width="100%" />
                            }
                            else { <span>@m.Severity</span> }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Labels</div>
                        <div class="jt-fval">
                            @if (editing)
                            {
                                @* HHM-364: multi-select so several labels can be applied at once
                                   (single-select replaced the whole string). m.Labels stays the
                                   comma-separated store; OnLabelsEnteredAsync persists each token. *@
                                <MultiSelectComboControl DataSource="@_labels"
                                                         SelectedValues="@SplitLabels(m.Labels).ToList()"
                                                         SelectedValuesChanged='@(async vals => { m.Labels = string.Join(", ", vals ?? new()); await OnLabelsEnteredAsync(m.Labels); })'
                                                         Placeholder="frontend, critical, …"
                                                         CssClass="jt-editable-dd"
                                                         Width="100%" />
                            }
                            else if (string.IsNullOrWhiteSpace(m.Labels)) { <span class="jt-muted">None</span> }
                            else { @foreach (var lb in SplitLabels(m.Labels)) { <span class="jt-label-chip">@lb</span> } }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Category</div>
                        <div class="jt-fval">
                            @if (editing)
                            {
                                <DropDownListControl TValue="string" TItem="string"
                                                     DataSource="@_categories"
                                                     Value="@m.Category"
                                                     ValueChanged='@(async value => { m.Category = value ?? string.Empty; await OnOptionEnteredAsync("Category", value); })'
                                                     Editable="true"
                                                     OpenOnArrowClickOnly="true"
                                                     Placeholder="Project / area"
                                                     CssClass="jt-editable-dd"
                                                     Width="100%" />
                            }
                            else { <span>@(string.IsNullOrWhiteSpace(m.Category) ? "—" : m.Category)</span> }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Due date</div>
                        <div class="jt-fval">
                            @if (editing) { <input type="date" class="jt-finput" @bind="m.DueDate" /> }
                            else { <span>@(m.DueDate.HasValue ? m.DueDate.Value.ToString("yyyy-MM-dd") : "None")</span> }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Parent</div>
                        <div class="jt-fval">
                            @if (editing) { <input class="jt-finput" @bind-value="m.Parent" placeholder="Parent epic / issue" /> }
                            else { <span>@(string.IsNullOrWhiteSpace(m.Parent) ? "None" : m.Parent)</span> }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Team</div>
                        <div class="jt-fval">
                            @if (editing) { <input class="jt-finput" @bind-value="m.Team" placeholder="Team" /> }
                            else { <span>@(string.IsNullOrWhiteSpace(m.Team) ? "None" : m.Team)</span> }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Start date</div>
                        <div class="jt-fval">
                            @if (editing) { <input type="date" class="jt-finput" @bind="m.StartDate" /> }
                            else { <span>@(m.StartDate.HasValue ? m.StartDate.Value.ToString("yyyy-MM-dd") : "None")</span> }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Sprint</div>
                        <div class="jt-fval">
                            @if (editing) {
                                <DropDownListControl TValue="string" TItem="string"
                                                     DataSource="@_sprints"
                                                     Value="@m.Sprint"
                                                     ValueChanged='@(async value => { m.Sprint = value ?? string.Empty; await OnSprintEnteredAsync(value); })'
                                                     Editable="true"
                                                     OpenOnArrowClickOnly="true"
                                                     Placeholder="e.g. HYP Sprint 1"
                                                     CssClass="jt-editable-dd"
                                                     Width="100%" />
                            }
                            else { <span>@(string.IsNullOrWhiteSpace(m.Sprint) ? "None" : m.Sprint)</span> }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Story point estimate</div>
                        <div class="jt-fval">
                            @if (editing) { <input class="jt-finput" @bind-value="m.StoryPoints" placeholder="e.g. 3" /> }
                            else { <span>@(string.IsNullOrWhiteSpace(m.StoryPoints) ? "None" : m.StoryPoints)</span> }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Fix version</div>
                        <div class="jt-fval">
                            @if (editing) { <input class="jt-finput" @bind-value="m.FixVersion" placeholder="e.g. June Migration" /> }
                            else { <span>@(string.IsNullOrWhiteSpace(m.FixVersion) ? "None" : m.FixVersion)</span> }
                        </div>
                    </div>
                    <div class="jt-field"><div class="jt-flabel">Created</div><div class="jt-fval">@(editing ? "Just now" : m.CreatedDate.ToString("yyyy-MM-dd hh:mm tt"))</div></div>

                    <div class="jt-side-sub">Migration context</div>
                    <div class="jt-field">
                        <div class="jt-flabel">VB6 form</div>
                        <div class="jt-fval">
                            @if (editing) { <input class="jt-finput" @bind-value="m.VB6Form" placeholder="e.g. FJob.frm" /> }
                            else { <span class="jt-mono">@(string.IsNullOrWhiteSpace(m.VB6Form) ? "—" : m.VB6Form)</span> }
                        </div>
                    </div>
                    <div class="jt-field">
                        <div class="jt-flabel">Module</div>
                        <div class="jt-fval">
                            @if (editing) { <input class="jt-finput" @bind-value="m.Module" placeholder="Estimating, Reports, Vendors, …" /> }
                            else { <span>@(string.IsNullOrWhiteSpace(m.Module) ? "—" : m.Module)</span> }
                        </div>
                    </div>
                    <div class="jt-field"><div class="jt-flabel">Migrated page</div><div class="jt-fval">@(string.IsNullOrEmpty(m.ScreenName) ? "—" : m.ScreenName)</div></div>
                    <div class="jt-field"><div class="jt-flabel">Focused control</div><div class="jt-fval jt-mono jt-trunc" title="@m.FocusedControl">@(string.IsNullOrEmpty(m.FocusedControl) ? "—" : m.FocusedControl)</div></div>
                    <div class="jt-field"><div class="jt-flabel">Page URL</div><div class="jt-fval jt-mono jt-trunc" title="@m.Url">@m.Url</div></div>
                    </div>@* /jt-side-box (Details) *@

                    @* Development panel — the developer log captured at F8 time, rendered as
                       label/value rows in the same Details style. Mirrors Jira's Development box. *@
                    @if (!string.IsNullOrEmpty(m.DiagnosticsJson))
                    {
                        <div class="jt-side-box jt-dev-box">
                            <div class="jt-side-h"><i class="bi bi-terminal"></i> Development</div>
                            <details class="jt-diag">
                                <summary><i class="bi bi-bug-fill"></i> View log context &amp; session state</summary>
                                <div class="jt-diag-body">@m.DiagnosticsJson</div>
                            </details>
                        </div>
                    }
                </div>
            </div>

            <div class="jt-footer">
                @if (editing)
                {
                    <button class="btn btn-light btn-sm" @onclick="CancelTicketEditAsync">Cancel</button>
                    <span class="jt-spring"></span>
                    <button class="btn btn-jira-save btn-sm" @onclick="SaveTicketAsync" disabled="@isSaving" title="Save locally and to the Jira board (when connected)">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span><span>Saving…</span> }
                        else { <span class="jt-jira-ico">@((MarkupString)IcJiraLogo)</span> <span>@(isNew ? "Create" : "Save")</span> }
                    </button>
                }
                else
                {
                    <button class="btn btn-secondary btn-sm" @onclick="@(() => GoToBoard(isTicketTab))"><i class="bi bi-arrow-left"></i> Back to board</button>
                    <span class="jt-spring"></span>
                    <span class="download-label">@((MarkupString)IcDownload) Save as:</span>
                    <a class="btn btn-outline-secondary btn-sm fb-dl-btn" href="/tickets/@m.TicketNumber/download/png" download data-tip="PNG image" aria-label="Download annotated image (PNG)">@((MarkupString)IcPng)</a>
                    <a class="btn btn-outline-secondary btn-sm fb-dl-btn" href="/tickets/@m.TicketNumber/download/pdf" download data-tip="PDF document" aria-label="Download PDF document">@((MarkupString)IcPdf)</a>
                    <a class="btn btn-outline-secondary btn-sm fb-dl-btn" href="/tickets/@m.TicketNumber/download/doc" download data-tip="Word document (.doc)" aria-label="Download Word document">@((MarkupString)IcDoc)</a>
                    <a class="btn btn-outline-secondary btn-sm fb-dl-btn" href="/tickets/@m.TicketNumber/download/eml" download data-tip="Outlook message (.eml)" aria-label="Download Outlook message">@((MarkupString)IcEml)</a>
                    <a class="btn btn-outline-secondary btn-sm fb-dl-btn" href="/tickets/@m.TicketNumber/download/jira" download data-tip="Jira issue (.json)" aria-label="Download Jira issue JSON">@((MarkupString)IcJira)</a>
                    <button type="button" class="btn btn-outline-secondary btn-sm fb-dl-btn" @onclick="EmailTicketAsync" data-tip="Email ticket" aria-label="Email ticket">@((MarkupString)IcEmail)</button>
                    @if (!string.IsNullOrWhiteSpace(m.ExternalKey))
                    {
                        <a class="jt-jira-link" href="@JiraBrowseUrl(m.ExternalKey)" target="_blank" title="View @m.ExternalKey in Jira"><i class="bi bi-box-arrow-up-right"></i> @m.ExternalKey</a>
                    }
                    <button type="button" class="btn btn-jira-save btn-sm" @onclick="@(() => SaveToJiraAsync(m))" disabled="@_savingToJira" title="Save this ticket locally and to the Jira board"><span class="jt-jira-ico">@((MarkupString)IcJiraLogo)</span> <span>@(_savingToJira ? "Saving…" : "Save to Jira")</span></button>
                    <button class="btn btn-danger btn-sm" @onclick="@(() => DeleteTicketAsync(m))"><i class="bi bi-trash-fill"></i> Delete</button>
                }
            </div>
        </div>
    </text>;
}


<div class="feedback-screen-container">
    <div class="feedback-main">
        <div class="main-content">

            @* ───────────────────────── HOME BOARD (the Feedback landing screen) ───────────────── *@
            @* A dedicated /feedback-ticket/{n} tab shows ONLY its ticket — the board lives in
               its own tab and must not be duplicated behind every open ticket. *@
            @if (_view == FbView.Home && !IsTicketTabMode)
            {
                <div class="fb-home">
                    @* Owner directive 2026-07-29: two-row header. Row 1 = title + ALL the
                       filters (the space right of "Feedback & Testing" was unused); Row 2 =
                       user/actions. Labels filter added alongside Reporter/Assignee/Type. *@
                    <div class="fb-home-bar fb-home-bar-top">
                        <h2 class="fb-home-title"><i class="bi bi-clipboard-check"></i> Feedback &amp; Testing</h2>
                        <div class="fb-home-filters">
                            <ButtonControl BareStyle="true"
                                           CssClass="@FilterTriggerCss"
                                           IconCss="bi bi-funnel"
                                           Title="Filter the board"
                                           DropDownCssClass="fb-filter-panel">
                                <ChildContent>
                                    <span class="fb-filter-lbl">Filter</span>
                                    @if (ActiveFilterCount > 0)
                                    {
                                        <span class="fb-filter-count">@ActiveFilterCount</span>
                                    }
                                </ChildContent>
                                <DropDownContent>
                                    <div class="fb-fp">
                                        <div class="fb-fp-head">
                                            <TabStripControl Items="@_filterTabs"
                                                             SelectedIndex="@_filterTab"
                                                             SelectedIndexChanged="@(i => { _filterTab = i; })"
                                                             CssClass="fb-fp-tabs" />
                                            <div class="fb-fp-views">
                                                <DropDownListControl TValue="string" TItem="string"
                                                                     DataSource="@_viewNames"
                                                                     Value="@_selectedSavedFilter"
                                                                     ValueChanged="OnSavedFilterChanged"
                                                                     Placeholder="Saved filters"
                                                                     Width="180px" CssClass="fb-fp-viewdd" />
                                                <ButtonControl BareStyle="true" CssClass="fb-fp-btn"
                                                               Title="Save the current filters as a view"
                                                               OnClick="SaveViewAsync">Save</ButtonControl>
                                                @if (IsLocalViewSelected)
                                                {
                                                    <ButtonControl BareStyle="true" CssClass="fb-fp-btn"
                                                                   Title="Delete this saved view"
                                                                   OnClick="DeleteViewAsync">Delete</ButtonControl>
                                                }
                                            </div>
                                        </div>

                                        @if (_filterTab == 0)
                                        {
                                            <div class="fb-fp-basic">
                                                <MultiSelectComboControl DataSource="@FilterReporterOptions"
                                                                         SelectedValues="@_filterReporters"
                                                                         SelectedValuesChanged="@(async v => { _filterReporters = v; await SaveFilterPrefsAsync(); })"
                                                                         Placeholder="Reporter" Width="150px" CssClass="fb-filter" />
                                                <MultiSelectComboControl DataSource="@FilterAssigneeOptions"
                                                                         SelectedValues="@_filterAssignees"
                                                                         SelectedValuesChanged="@(async v => { _filterAssignees = v; await SaveFilterPrefsAsync(); })"
                                                                         Placeholder="Assignee" Width="150px" CssClass="fb-filter" />
                                                <MultiSelectComboControl DataSource="@FilterIssueTypeOptions"
                                                                         SelectedValues="@_filterIssueTypes"
                                                                         SelectedValuesChanged="@(async v => { _filterIssueTypes = v; await SaveFilterPrefsAsync(); })"
                                                                         Placeholder="Issue Type" Width="150px" CssClass="fb-filter" />
                                                <MultiSelectComboControl DataSource="@FilterLabelOptions"
                                                                         SelectedValues="@_filterLabels"
                                                                         SelectedValuesChanged="@(async v => { _filterLabels = v; await SaveFilterPrefsAsync(); })"
                                                                         Placeholder="Labels" Width="170px" CssClass="fb-filter" />
                                                <MultiSelectComboControl DataSource="@FilterStatusOptions"
                                                                         SelectedValues="@_filterStatuses"
                                                                         SelectedValuesChanged="@(async v => { _filterStatuses = v; await SaveFilterPrefsAsync(); })"
                                                                         Placeholder="Status" Width="160px" CssClass="fb-filter" />
                                                <MultiSelectComboControl DataSource="@FilterResolutionOptions"
                                                                         SelectedValues="@_filterResolutions"
                                                                         SelectedValuesChanged="@(async v => { _filterResolutions = v; await SaveFilterPrefsAsync(); })"
                                                                         Placeholder="Resolution" Width="160px" CssClass="fb-filter" />
                                            </div>
                                        }
                                        else if (_filterTab == 1)
                                        {
                                            <div class="fb-fp-rules">
                                                @if (_rules.Count == 0)
                                                {
                                                    <div class="fb-fp-empty">No advanced filters yet — use &ldquo;Add filters&rdquo; below.</div>
                                                }
                                                @foreach (var rule in _rules)
                                                {
                                                    var r = rule;
                                                    var def = FieldDef(r.Field);
                                                    <div class="fb-fp-row" @key="r">
                                                        <DropDownListControl TValue="string" TItem="FilterFieldDef"
                                                                             DataSource="@FilterFields"
                                                                             TextFieldName="@nameof(FilterFieldDef.Label)"
                                                                             ValueFieldName="@nameof(FilterFieldDef.Key)"
                                                                             Value="@r.Field"
                                                                             ValueChanged="@(v => OnRuleFieldChanged(r, v))"
                                                                             Width="150px" CssClass="fb-fp-dd" />
                                                        <DropDownListControl TValue="string" TItem="FilterOpOption"
                                                                             DataSource="@OpsFor(def?.Kind ?? FilterKind.Option)"
                                                                             TextFieldName="@nameof(FilterOpOption.Text)"
                                                                             ValueFieldName="@nameof(FilterOpOption.Value)"
                                                                             Value="@r.Op.ToString()"
                                                                             ValueChanged="@(v => OnRuleOpChanged(r, v))"
                                                                             Width="150px" CssClass="fb-fp-dd" />
                                                        @if (def is null || !RuleNeedsValues(r.Op))
                                                        {
                                                            <span class="fb-fp-noval"></span>
                                                        }
                                                        else if (def.Kind == FilterKind.Text)
                                                        {
                                                            <TextBoxControl Value="@(r.Values.FirstOrDefault() ?? "")"
                                                                            ValueChanged="@(t => OnRuleTextChanged(r, t))"
                                                                            Placeholder="Text…" CssClass="fb-fp-txt" />
                                                        }
                                                        else
                                                        {
                                                            <MultiSelectComboControl DataSource="@def.Options()"
                                                                                     SelectedValues="@r.Values"
                                                                                     SelectedValuesChanged="@(v => OnRuleValuesChanged(r, v))"
                                                                                     Placeholder="Value" Width="230px" CssClass="fb-fp-val" />
                                                        }
                                                        <ButtonControl BareStyle="true" CssClass="fb-fp-x"
                                                                       IconCss="bi bi-x-lg"
                                                                       Title="Remove this filter"
                                                                       OnClick="@(() => RemoveRuleAsync(r))" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fb-fp-jql">
                                                <input class="fb-search fb-fp-jqlbox" type="text" placeholder="JQL…"
                                                       value="@_jqlText" @oninput="@(e => _jqlText = e.Value?.ToString() ?? "")"
                                                       @onkeydown="@(async e => { if (e.Key == "Enter") await RunJqlAsync(); })" />
                                                <ButtonControl BareStyle="true" CssClass="fb-fp-btn" OnClick="RunJqlAsync">Run</ButtonControl>
                                                @if (_jqlActive)
                                                {
                                                    <ButtonControl BareStyle="true" CssClass="fb-fp-btn" OnClick="ClearJqlAsync">Clear</ButtonControl>
                                                    <span class="fb-fp-jqlnote">@_jqlKeys.Count issue(s) matched on the Jira board — tickets that were never pushed to Jira are hidden while JQL is active.</span>
                                                }
                                            </div>
                                        }

                                        <div class="fb-fp-foot">
                                            <ButtonControl BareStyle="true" CssClass="fb-fp-add" IconCss="bi bi-plus-lg"
                                                           Disabled="@(_rules.Count >= MaxFilterRules)"
                                                           OnClick="AddRuleAsync">Add filters</ButtonControl>
                                            <ButtonControl BareStyle="true" CssClass="fb-fp-clear"
                                                           OnClick="ClearAllFiltersAsync">Clear all</ButtonControl>
                                        </div>
                                    </div>
                                </DropDownContent>
                            </ButtonControl>

                            <div class="fb-search-container">
                                <i class="bi bi-search fb-search-icon"></i>
                                <input class="fb-search" type="text" placeholder="Search tickets…" value="@searchQuery" @oninput="OnSearchInput" />
                            </div>
                        </div>
                    </div>
                    <div class="fb-home-bar fb-home-bar-actions">
                        <div class="fb-home-actions">
                            <div class="fb-currentuser" title="Who is using the board — used as the comment author and default Reporter">
                                <span class="fb-currentuser-lbl"><i class="bi bi-person-circle"></i> Current user</span>
                                <DropDownListControl TValue="string" TItem="string"
                                                     DataSource="@_reporters"
                                                     Value="@_currentUser"
                                                     ValueChanged="OnCurrentUserChanged"
                                                     Editable="true" OpenOnArrowClickOnly="true"
                                                     Placeholder="Select your name" CssClass="fb-currentuser-dd" Width="170px" />
                            </div>
                            <span class="fb-groupby-lbl"><i class="bi bi-filter"></i> Group by</span>
                            <DropDownListControl TValue="string" TItem="GroupByOption"
                                                 DataSource="@_groupByOptions"
                                                 TextFieldName="@nameof(GroupByOption.Text)"
                                                 ValueFieldName="@nameof(GroupByOption.Value)"
                                                 Value="@_groupBy"
                                                 ValueChanged='@(async value => { _groupBy = value ?? "Status"; await SaveFilterPrefsAsync(); })'
                                                 CssClass="fb-groupby"
                                                 Width="150px" />
                            <button class="btn btn-jira-create" @onclick="CreateManualTicket"><i class="bi bi-plus-lg"></i> Create</button>
                            <button class="btn btn-jira-secondary" @onclick="CaptureNewFeedbackAsync"><i class="bi bi-camera-fill"></i> Capture</button>
                            @if (_jiraSyncing)
                            {
                                <span class="fb-sync-status" title="Pulling the latest ticket state from the Jira board">Syncing tickets@(string.IsNullOrEmpty(_syncProgress) ? "" : $" {_syncProgress}")&hellip;</span>
                            }
                            <button class="btn btn-jira-secondary fb-jira-gear" @onclick="ManualSyncFromJiraAsync" disabled="@_jiraSyncing" title="Pull the latest from the Jira board"><span class="@(_jiraSyncing ? "fb-spin" : "")">@((MarkupString)IcSyncSvg)</span></button>
                            <button class="btn btn-jira-secondary fb-jira-gear" @onclick="OpenJiraSettings" title="Jira connection settings">@((MarkupString)IcGearSvg)</button>
                        </div>
                    </div>

                    @if (!GetFilteredFeedbacks().Any())
                    {
                        <div class="fb-board-empty">
                            <i class="bi bi-clipboard-plus"></i>
                            <p>No tickets yet. Press <strong>F8</strong> / <strong>Shift+F8</strong> to capture, or <strong>Create</strong> one manually.</p>
                        </div>
                    }
                    else
                    {
                        @* Jira-style board: lanes by the Group-by field; drag a card to another lane to
                           change that field (e.g. move between Status lanes). Uses the FlexKit KanbanBoardControl. *@
                        <div class="fb-kanban-wrap">
                        <KanbanBoardControl TItem="FeedbackItem"
                                            CssClass="fb-kanban"
                                            Columns="@KanbanColumns()"
                                            Items="@GetFilteredFeedbacks()"
                                            ColumnKeySelector="@GroupKeyOf"
                                            OnItemMoved="OnCardMoved"
                                            OnCardClick="OpenTicket"
                                            EmptyText="—">
                            <CardTemplate Context="t">
                                <div class="fb-card-topic">@(string.IsNullOrWhiteSpace(t.Topic) ? "(no title)" : t.Topic)</div>
                                @if (!string.IsNullOrEmpty(t.ScreenshotPath))
                                {
                                    <div class="fb-card-thumbwrap"><img class="fb-card-thumb" src="@t.ScreenshotPath" alt="" /></div>
                                }
                                <div class="fb-card-bottom">
                                    <div class="fb-card-bottom-left">
                                        <span class="fb-card-type-icon" title="Type: @t.IssueType"><i class="bi @GetIssueTypeIcon(t.IssueType)"></i></span>
                                        <span class="fb-card-key-link">@TicketLabel(t)</span>
                                        <span class="fb-card-priority" title="Priority: @t.Priority"><i class="bi @GetPriorityIcon(t.Priority)"></i></span>
                                    </div>
                                    <div class="fb-card-bottom-right">
                                        <span class="fb-card-date" title="Created date"><i class="bi bi-calendar3"></i> @t.CreatedDate.ToString("MMM d")</span>
                                        @RenderAvatar(t.UserName)
                                        <button class="fb-card-del" title="Delete ticket" @onclick="@(() => DeleteTicketAsync(t))" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                            </CardTemplate>
                        </KanbanBoardControl>
                        </div>
                    }
                </div>
            }

            @* ───────────────────────── IMAGE EDITOR (hotkey capture → annotate) ───────────────── *@
            else if (_view == FbView.Editor && newFeedback != null)
            {
                @* DefaultColumnTitles: a fresh capture (column 1) is stamped "HF .Net" and an image
                   pasted/attached into column 2 gets "Legacy VB6" — editable Text shapes that
                   flatten into the saved PNG. Only here (fresh captures); the re-annotate modal
                   reloads already-titled images so it deliberately doesn't pass titles. *@
                <DrawingControl @ref="_drawing" ImageDataUrl="@screenshotDataUrl"
                                Height="calc(100vh - 120px)" ToolbarExtra="@AppToolbar" InitialTool="DrawingTool.RectangleText"
                                DefaultColumnTitles="@_captureColumnTitles"
                                ShowTitle="true" Title="@newFeedback?.Topic" TitleChanged="OnCaptureTitleChanged" />
            }

            @* ───────────────────────── TICKET SCREEN (Jira detail — edit or read) ─────────────── *@
            else if (_view == FbView.Ticket)
            {
                @* Full-page ticket screen — only the NEW-draft composer path reaches here now;
                   existing tickets open as windows (see the window host below). *@
                var m = newFeedback ?? selectedFeedback!;
                @ticketView(new TicketViewCtx
                {
                    Item = m,
                    Editing = newFeedback != null || _editMode,
                    IsNew = newFeedback != null,
                    Img = newFeedback != null ? _annotatedDataUrl : m.ScreenshotPath,
                    IsTicketTab = IsTicketTabMode,
                })
            }
        </div>
    </div>
</div>

@* ── Modal image editor — opened by clicking a ticket's attachment ────────────────────────── *@
@if (_imageEditorOpen)
{
    @* OnClose wires the header ✕ — it rendered but did nothing because Visible
       was a hard-coded literal with no close callback (HHM-170). *@
    <DialogControl Visible="true" Header="Edit screenshot" Width="92vw" Height="90vh" IsModal="true"
                   ShowCloseIcon="true" OnClose="CloseImageEditor">
        <ChildContent>
            <DrawingControl @ref="_modalDrawing" ImageDataUrl="@_modalImageUrl" Height="calc(90vh - 95px)" InitialTool="DrawingTool.RectangleText"
                            DefaultColumnTitles="@_captureColumnTitles" />
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary me-2" @onclick="CloseImageEditor">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="ApplyImageEditor"><i class="bi bi-check-lg"></i> Apply</button>
        </FooterContent>
    </DialogControl>
}

@* ── "Close issue" dialog — Jira-style, shown when a ticket is dragged to the Done lane ───────── *@
@if (_showCloseDialog && _closingItem != null)
{
    <DialogControl Visible="true" Header="@($"Close {TicketLabel(_closingItem)}")" Width="460px" Height="auto" IsModal="true">
        <ChildContent>
            <div class="jt-close-dialog">
                <div class="jt-close-field">
                    <label class="jt-close-label">Resolution</label>
                    <DropDownListControl TValue="string" TItem="string"
                                         DataSource="@_resolutions"
                                         Value="@_closeResolution"
                                         ValueChanged="@(v => _closeResolution = v ?? "Implemented")"
                                         Editable="true" OpenOnArrowClickOnly="true"
                                         CssClass="jt-close-dd" Width="100%" />
                </div>
                <div class="jt-close-field">
                    <label class="jt-close-label">Comment</label>
                    <TextAreaControl @bind-Value="_closeComment" UpdateOnInput="true" Placeholder="Add a closing comment…" Rows="4" CssClass="jt-close-comment" />
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <ButtonControl CssClass="jt-dlg-btn" OnClick="CancelCloseTicket">Cancel</ButtonControl>
            <ButtonControl CssClass="jt-dlg-btn jt-dlg-btn-primary" OnClick="ConfirmCloseTicketAsync">Close</ButtonControl>
        </FooterContent>
    </DialogControl>
}

@* ── Unsaved-changes prompt — shown when leaving an edited ticket with pending changes ────────── *@
@if (_unsavedPromptOpen)
{
    <DialogControl Visible="true" Header="Unsaved changes" Width="420px" Height="auto" IsModal="true">
        <ChildContent>
            <div class="jt-unsaved-dialog">
                This ticket has unsaved changes. Save them before returning to the board?
            </div>
        </ChildContent>
        <FooterContent>
            <ButtonControl CssClass="jt-dlg-btn" OnClick="UnsavedPromptCancel">Cancel</ButtonControl>
            <ButtonControl CssClass="jt-dlg-btn" OnClick="UnsavedPromptDiscard">Don't save</ButtonControl>
            <ButtonControl CssClass="jt-dlg-btn jt-dlg-btn-primary" OnClick="UnsavedPromptSaveAsync">Save</ButtonControl>
        </FooterContent>
    </DialogControl>
}

@* ── Export to Jira — create a new issue on the board ─────────────────────────────────────── *@
@if (_jiraExportOpen && _jiraItem != null)
{
    <DialogControl Visible="true" Header="Export to Jira" Width="580px" Height="auto" IsModal="true">
        <ChildContent>
            <div class="jira-export">
                <div class="je-row">
                    <label class="je-label">Board</label>
                    <div class="je-board">
                        <span class="je-board-url"><i class="bi bi-kanban"></i> @_jiraBaseUrl</span>
                        <TextBoxControl @bind-Value="_jiraProject" Placeholder="Project key (e.g. HHM)" CssClass="je-proj" />
                    </div>
                </div>
                <div class="je-row">
                    <label class="je-label">Issue number</label>
                    <div class="je-num">
                        <span class="je-projkey">@(_jiraNextNum > 0 ? $"{_jiraProject}-{_jiraNextNum}" : "…")</span>
                        <span class="je-hint">projected next number — Jira assigns the final key on create</span>
                    </div>
                </div>
                <div class="je-row">
                    <label class="je-label">Issue type</label>
                    <DropDownListControl TValue="string" TItem="string" DataSource="@_jiraIssueTypes"
                                         Value="@_jiraIssueType" ValueChanged="@(v => _jiraIssueType = v ?? "Bug")"
                                         Editable="true" OpenOnArrowClickOnly="true" CssClass="je-dd" Width="220px" />
                </div>
                <div class="je-row">
                    <label class="je-label">Summary</label>
                    <TextBoxControl @bind-Value="_jiraSummary" Placeholder="Issue summary" CssClass="je-sum" />
                </div>
                <div class="je-row je-row-top">
                    <label class="je-label">Description</label>
                    <TextAreaControl @bind-Value="_jiraDescription" Rows="7" CssClass="je-desc" />
                </div>
                <div class="je-row">
                    <label class="je-label"> </label>
                    <CheckBoxControl @bind-Checked="_jiraAttach" Label="Attach screenshot + any other ticket attachments" />
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <ButtonControl CssClass="jt-dlg-btn" OnClick="CancelJiraExport" Disabled="@_jiraExporting">Cancel</ButtonControl>
            <ButtonControl CssClass="jt-dlg-btn jt-dlg-btn-primary" OnClick="ConfirmJiraExportAsync" Disabled="@_jiraExporting">@(_jiraExporting ? "Exporting…" : "Export")</ButtonControl>
        </FooterContent>
    </DialogControl>
}

@* ── Jira connection settings — board URL, account, token (saved server-side, NOT in wwwroot) ── *@
@if (_jiraSettingsOpen)
{
    <DialogControl Visible="true" Header="Jira connection" Width="520px" Height="auto" IsModal="true">
        <ChildContent>
            <div class="jira-export">
                <div class="je-row">
                    <label class="je-label">Base URL</label>
                    <TextBoxControl @bind-Value="_jiraSettings.BaseUrl" Placeholder="https://your-org.atlassian.net" CssClass="je-sum" />
                </div>
                <div class="je-row">
                    <label class="je-label">Email</label>
                    <TextBoxControl @bind-Value="_jiraSettings.Email" Placeholder="you@org.com (blank ⇒ Bearer/PAT)" CssClass="je-sum" />
                </div>
                <div class="je-row">
                    <label class="je-label">API token</label>
                    <input type="password" class="jt-finput je-sum" @bind="_jiraSettings.ApiToken" placeholder="API token / PAT (kept server-side)" autocomplete="off" />
                </div>
                <div class="je-row">
                    <label class="je-label">Project key</label>
                    <TextBoxControl @bind-Value="_jiraSettings.ProjectKey" Placeholder="HHM" CssClass="je-proj" />
                </div>
                <div class="je-row">
                    <label class="je-label">Default type</label>
                    <DropDownListControl TValue="string" TItem="string" DataSource="@_jiraIssueTypes"
                                         Value="@_jiraSettings.IssueType" ValueChanged="@(v => _jiraSettings.IssueType = v ?? "Bug")"
                                         Editable="true" OpenOnArrowClickOnly="true" CssClass="je-dd" Width="220px" />
                </div>
                @if (_jiraSettings.LastSyncTime.HasValue)
                {
                    <div class="je-row">
                        <label class="je-label">Last sync</label>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 13px; color: #555;">@_jiraSettings.LastSyncTime.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                            <button type="button" class="btn btn-link btn-sm text-danger p-0" @onclick="ClearLastSyncTime" style="font-size: 12px; text-decoration: none;">(Force Full Sync)</button>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_jiraTestMsg))
                {
