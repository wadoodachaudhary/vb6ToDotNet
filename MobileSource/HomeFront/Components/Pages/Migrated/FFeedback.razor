    // Load the editable-dropdown lists (server defaults + user-added) for Status/Priority/Severity/IssueType.
    private async Task LoadOptionListsAsync()
    {
        try
        {
            var opts = await FeedbackService.GetOptionListsAsync();
            if (opts.TryGetValue("Status", out var st)) _statuses = st;
            if (opts.TryGetValue("Priority", out var pr)) _priorities = pr;
            if (opts.TryGetValue("Severity", out var sv)) _severities = sv;
            if (opts.TryGetValue("IssueType", out var it)) _issueTypes = it;
            if (opts.TryGetValue("Reporter", out var rp)) _reporters = rp;
            if (opts.TryGetValue("Assignee", out var asg)) _assignees = asg;
            if (opts.TryGetValue("Labels", out var lb)) _labels = lb;
            if (opts.TryGetValue("Category", out var ct)) _categories = ct;
            // Sprint is primarily board-sourced (LoadSprintsAsync); merge any persisted custom values
            // in without dropping the "HYP Sprint 1" seed.
            if (opts.TryGetValue("Sprint", out var spo))
                foreach (var sp in spo)
                    if (!_sprints.Contains(sp, StringComparer.OrdinalIgnoreCase)) _sprints.Add(sp);
        }
        catch { /* fall back to the in-code defaults */ }
    }

    // Load the Sprint dropdown from the Jira board's active + future sprints, and resolve the default
    // sprint for new tickets (the active sprint, else "HYP Sprint 1"). Best-effort — keeps the in-code
    // default when no board is configured or Jira is unreachable.
    private async Task LoadSprintsAsync()
    {
        try
        {
            var sprints = await Jira.FetchSprintsAsync();
            if (sprints.Count == 0) return;
            // Board sprints first; keep any persisted/typed custom sprints not on the board.
            var names = sprints.Select(sp => sp.Name).ToList();
            foreach (var existing in _sprints)
                if (!names.Contains(existing, StringComparer.OrdinalIgnoreCase)) names.Add(existing);
            _sprints = names.Distinct().ToList();
            _defaultSprint =
                sprints.FirstOrDefault(sp => string.Equals(sp.State, "active", StringComparison.OrdinalIgnoreCase))?.Name
                ?? sprints.FirstOrDefault(sp => string.Equals(sp.Name, "HYP Sprint 1", StringComparison.OrdinalIgnoreCase))?.Name
                ?? sprints.FirstOrDefault()?.Name
                ?? "HYP Sprint 1";
            if (!_sprints.Contains(_defaultSprint)) _sprints.Insert(0, _defaultSprint);
            await InvokeAsync(StateHasChanged);
        }
        catch { /* keep the literal "HYP Sprint 1" default */ }
    }

    // HHM-142: populate the Labels dropdown with ALL labels defined in Jira (merged with local defaults +
    // any persisted custom labels). Best-effort, fire-and-forget.
    private async Task LoadLabelsFromJiraAsync()
    {
        try
        {
            var jira = await Jira.FetchLabelsAsync();
            if (jira.Count == 0) return;
            var merged = new List<string>(jira);
            foreach (var existing in _labels)
                if (!merged.Contains(existing, StringComparer.OrdinalIgnoreCase)) merged.Add(existing);
            _labels = merged.Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch { /* keep the in-code + persisted labels */ }
    }

    // Editable dropdown commit: persist a newly-typed value to the server option list immediately
