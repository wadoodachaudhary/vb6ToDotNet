    // Editable dropdowns publish each keystroke to the model; add custom typed values
    // to the saved option lists only when the ticket is saved.
    private async Task PersistFeedbackOptionsAsync(FeedbackItem feedback)
    {
        var changed = false;

        async Task AddAsync(string listName, string? value)
        {
            if (string.IsNullOrWhiteSpace(value))
                return;

            if (await FeedbackService.AddOptionAsync(listName, value.Trim()))
                changed = true;
        }

        await AddAsync("Status", feedback.Status);
        await AddAsync("Priority", feedback.Priority);
        await AddAsync("Severity", feedback.Severity);
        await AddAsync("IssueType", feedback.IssueType);
        await AddAsync("Reporter", feedback.UserName);
        await AddAsync("Assignee", feedback.Assignee);
        await AddAsync("Category", feedback.Category);
        await AddAsync("Sprint", feedback.Sprint);
        foreach (var label in SplitLabels(feedback.Labels))
            await AddAsync("Labels", label);

        if (changed)
            await LoadOptionListsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Restore the "Current user" from the browser once JS is available, so the selection survives a
        // page reload (the per-circuit FeedbackState.CurrentUser only survives within the same circuit).
        if (firstRender)
        {
            if (string.IsNullOrWhiteSpace(_currentUser))
            {
                string stored = "";
                try { stored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "hf.feedback.currentUser") ?? ""; }
                catch { }
                if (!string.IsNullOrWhiteSpace(stored))
                {
                    _currentUser = stored.Trim();
                    FeedbackState.CurrentUser = _currentUser;
                    if (!_reporters.Contains(_currentUser, StringComparer.OrdinalIgnoreCase)) _reporters.Add(_currentUser);
                }
            }
            // Restore this user's remembered board filters + Group by (needs JS, so it
            // can't happen in OnInitializedAsync).
            await LoadFilterPrefsAsync();
            StateHasChanged();
        }

        // Back on the board → re-apply the scroll offsets saved when the ticket was opened
        // (the board's DOM was rebuilt, which resets every scroller to the top).
        if (_restoreBoardScroll && _view == FbView.Home)
        {
            _restoreBoardScroll = false;
            if (_boardScroll is { } savedScroll)
            {
                try { await JSRuntime.InvokeVoidAsync("feedbackHelper.restoreScroll", ".feedback-screen-container", savedScroll); }
                catch { }
            }
        }

        // Load the existing annotations into the modal editor once it has rendered.
        if (_loadModalShapes && _imageEditorOpen && _modalDrawing is not null)
        {
            _loadModalShapes = false;
            var json = newFeedback?.AnnotationsJson ?? "";   // saved tickets re-annotate on a fresh layer
            if (!string.IsNullOrEmpty(json))
            {
                // LoadState restores the full editor state — cell images + captions AND shapes —
                // so a re-edit shows every pasted cell, not just the original capture. It also
                // accepts the legacy bare-shapes-array format for tickets saved before this change.
                try { _modalDrawing.LoadState(json); }
                catch { }
            }
        }
    }

    private void CheckForScreenshot()
    {
        if (!string.IsNullOrEmpty(FeedbackState.CurrentScreenshotDataUrl))
        {
            screenshotDataUrl = FeedbackState.CurrentScreenshotDataUrl;
            var screen = FeedbackState.CurrentScreenName ?? "";
            var menuOption = InferVB6Form(screen);              // VB6 menu option that owns this form
            newFeedback = new FeedbackItem
            {
                UserName = CurrentUserName,   // default Reporter = the selected "Current user"
                Url = FeedbackState.CurrentPageUrl ?? Navigation.Uri,
                ScreenName = screen,
                FocusedControl = FeedbackState.CurrentFocusedControl ?? "",
                DiagnosticsJson = FeedbackState.CurrentDiagnosticsJson ?? "",
                Topic = ComposeTitle(menuOption, screen),       // prefill: "Menu option — Window title"
                EnvironmentInfo = _environment,                 // prefill: browser + OS
                DueDate = DateTime.Today.AddDays(7),            // prefill: a week out
                StartDate = DateTime.Today,                     // prefill: today
                Category = "Setup",                             // prefill: default area
                StoryPoints = "0.5",                            // prefill: default estimate
                FixVersion = "Release 1",                       // prefill: default fix version
                VB6Form = menuOption,                           // prefill: VB6 form / menu title from the screen
                Sprint = _defaultSprint                         // prefill: the active sprint (e.g. "HYP Sprint 1")
            };
            _annotatedDataUrl = string.Empty;
            selectedFeedback = null;
            SnapshotEdit();   // baseline for the unsaved-changes guard
            _view = FbView.Editor;   // hotkey → image editor

            FeedbackState.CurrentScreenshotDataUrl = null;
            FeedbackState.CurrentPageUrl = null;
        }
        else if (!IsTicketTabMode)
        {
            _view = FbView.Home;   // entered from the menu → the board
        }
        // A dedicated /feedback-ticket/{n} tab must NOT be forced to the board here: this runs
        // from OnInitializedAsync (and again on later re-checks), and stomping the view is what
        // left a freshly opened ticket tab blank.
    }

    private void HandleNewScreenshot()
    {
        // F8 / Shift+F8 while this tab is already open → pick up the new capture.
        InvokeAsync(() =>
        {
            CheckForScreenshot();
            _drawing?.LoadShapes(null);
            StateHasChanged();
        });
    }

