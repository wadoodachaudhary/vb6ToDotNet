    // ── Advanced filter rules ──────────────────────────────────────────────
    // Basic = the six lists above. Advanced = this rule list. Both AND together in
    // GetFilteredFeedbacks, as does the JQL narrowing.
    private const int MaxFilterRules = 8;

    [JsonConverter(typeof(JsonStringEnumConverter))]
    private enum FilterOp { In, NotIn, Contains, NotContains, IsEmpty, IsNotEmpty }

    private enum FilterKind { Option, Tags, Text }

    private sealed class FilterRule
    {
        public string Field { get; set; } = "";
        public FilterOp Op { get; set; } = FilterOp.In;
        public List<string> Values { get; set; } = new();
    }

    // Raw = the untouched field (is-empty tests it); Norm = the value the pickers show.
    private sealed record FilterFieldDef(string Key, string Label, FilterKind Kind,
                                         Func<FeedbackItem, string> Raw,
                                         Func<string, string> Norm,
                                         Func<List<string>> Options);

    private sealed record FilterOpOption(string Value, string Text);

    private List<FilterRule> _rules = new();
    private int _filterTab;
    private readonly List<TabStripItem> _filterTabs = new()
    {
        new TabStripItem("Basic"), new TabStripItem("Advanced"), new TabStripItem("JQL")
    };

    private List<FilterFieldDef>? _filterFields;
    private List<FilterFieldDef> FilterFields => _filterFields ??= BuildFilterFields();

    // Blank-value fallbacks are copied from GetFilteredFeedbacks/GroupKeyOf — if they drift,
    // Basic and Advanced read the same ticket differently.
    private List<FilterFieldDef> BuildFilterFields()
    {
        Func<string, string> asIs = s => s ?? "";

        List<string> Distinct(Func<FeedbackItem, string> get, Func<string, string> norm) => allFeedbacks
            .Select(f => norm(get(f) ?? ""))
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
            .ToList();

        FilterFieldDef Opt(string key, string label, Func<FeedbackItem, string> get, string blank)
        {
            Func<string, string> norm = s => string.IsNullOrWhiteSpace(s) ? blank : s;
            return new FilterFieldDef(key, label, FilterKind.Option, get, norm, () => Distinct(get, norm));
        }

        FilterFieldDef Txt(string key, string label, Func<FeedbackItem, string> get) =>
            new(key, label, FilterKind.Text, get, asIs, () => new List<string>());

        return new List<FilterFieldDef>
        {
            Opt("Status",     "Status",      f => f.Status,     "To Do"),
            Opt("Assignee",   "Assignee",    f => f.Assignee,   "Unassigned"),
            Opt("Reporter",   "Reporter",    f => f.UserName,   "—"),
            Opt("IssueType",  "Issue type",  f => f.IssueType,  "Bug"),
            Opt("Resolution", "Resolution",  f => f.Resolution, "(unresolved)"),
            Opt("Priority",   "Priority",    f => f.Priority,   "Medium"),
            Opt("Severity",   "Severity",    f => f.Severity,   "Major"),
            Opt("Category",   "Category",    f => f.Category,   "Uncategorized"),
            Opt("Module",     "Module",      f => f.Module,     "(none)"),
            Opt("ScreenName", "Screen",      f => f.ScreenName, "General"),
            Opt("VB6Form",    "VB6 form",    f => f.VB6Form,    "(none)"),
            Opt("Sprint",     "Sprint",      f => f.Sprint,     "(none)"),
            Opt("FixVersion", "Fix version", f => f.FixVersion, "(none)"),
            Opt("Team",       "Team",        f => f.Team,       "(none)"),
            new("Labels", "Labels", FilterKind.Tags, f => f.Labels ?? "", asIs, () => FilterLabelOptions),
            Txt("Topic",       "Summary",     f => f.Topic),
            Txt("Description", "Description", f => f.Description),
            Txt("ExternalKey", "Key",         f => TicketLabel(f)),
        };
    }

    private static readonly Dictionary<FilterKind, List<FilterOpOption>> _opsByKind = new()
    {
        [FilterKind.Option] = new() { new("In", "is any of"), new("NotIn", "is none of"),
                                      new("IsEmpty", "is empty"), new("IsNotEmpty", "is not empty") },
        [FilterKind.Tags]   = new() { new("In", "is any of"), new("NotIn", "is none of"), new("Contains", "contains"),
                                      new("IsEmpty", "is empty"), new("IsNotEmpty", "is not empty") },
        [FilterKind.Text]   = new() { new("Contains", "contains"), new("NotContains", "does not contain"),
                                      new("IsEmpty", "is empty"), new("IsNotEmpty", "is not empty") },
    };

    private static List<FilterOpOption> OpsFor(FilterKind k) => _opsByKind[k];

    private FilterFieldDef? FieldDef(string key) =>
        FilterFields.FirstOrDefault(d => string.Equals(d.Key, key, StringComparison.OrdinalIgnoreCase));

    private static bool RuleNeedsValues(FilterOp op) => op != FilterOp.IsEmpty && op != FilterOp.IsNotEmpty;

    private static FilterOp DefaultOpFor(FilterKind k) => k == FilterKind.Text ? FilterOp.Contains : FilterOp.In;

    // A rule that still needs values matches everything and is not counted, so adding a
    // row never blanks the board before anything has been picked.
    private bool RuleIsActive(FilterRule r) =>
        FieldDef(r.Field) is not null && (!RuleNeedsValues(r.Op) || r.Values.Count > 0);

    private bool MatchesRule(FeedbackItem f, FilterRule r)
    {
        var def = FieldDef(r.Field);
        if (def is null) return true;
        var raw = def.Raw(f) ?? "";

        if (r.Op == FilterOp.IsEmpty)
            return def.Kind == FilterKind.Tags ? !SplitLabels(raw).Any() : string.IsNullOrWhiteSpace(raw);
        if (r.Op == FilterOp.IsNotEmpty)
            return def.Kind == FilterKind.Tags ? SplitLabels(raw).Any() : !string.IsNullOrWhiteSpace(raw);
        if (r.Values.Count == 0) return true;

        if (def.Kind == FilterKind.Tags)
        {
            var ls = SplitLabels(raw).ToList();
            bool hit;
            if (r.Op == FilterOp.Contains)
                hit = ls.Any(l => r.Values.Any(t => l.Contains(t, StringComparison.OrdinalIgnoreCase)));
            else if (ls.Count == 0)
                hit = r.Values.Contains("(none)", StringComparer.OrdinalIgnoreCase);
            else
                hit = ls.Any(l => r.Values.Contains(l, StringComparer.OrdinalIgnoreCase));
            return r.Op == FilterOp.NotIn ? !hit : hit;
        }

        var v = def.Norm(raw);
        return r.Op switch
        {
            FilterOp.In => r.Values.Contains(v, StringComparer.OrdinalIgnoreCase),
            FilterOp.NotIn => !r.Values.Contains(v, StringComparer.OrdinalIgnoreCase),
            FilterOp.Contains => r.Values.Any(t => v.Contains(t, StringComparison.OrdinalIgnoreCase)),
            FilterOp.NotContains => !r.Values.Any(t => v.Contains(t, StringComparison.OrdinalIgnoreCase)),
            _ => true,
        };
    }

    private string FilterTriggerCss =>
        ActiveFilterCount > 0 ? "fb-filter-trigger fb-filter-trigger-on" : "fb-filter-trigger";

    // The badge on the trigger. The search box is excluded — it lives outside the popover.
    private int ActiveFilterCount =>
        (_filterReporters.Count > 0 ? 1 : 0) +
        (_filterAssignees.Count > 0 ? 1 : 0) +
        (_filterIssueTypes.Count > 0 ? 1 : 0) +
        (_filterLabels.Count > 0 ? 1 : 0) +
        (_filterStatuses.Count > 0 ? 1 : 0) +
        (_filterResolutions.Count > 0 ? 1 : 0) +
        _rules.Count(RuleIsActive) +
        (_jqlActive ? 1 : 0);

    private async Task AddRuleAsync()
    {
        if (_rules.Count >= MaxFilterRules) return;
        var used = _rules.Select(r => r.Field).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var def = FilterFields.FirstOrDefault(d => !used.Contains(d.Key)) ?? FilterFields[0];
        _rules.Add(new FilterRule { Field = def.Key, Op = DefaultOpFor(def.Kind) });
        await SaveFilterPrefsAsync();
    }

    private async Task RemoveRuleAsync(FilterRule r)
    {
        _rules.Remove(r);
        await SaveFilterPrefsAsync();
    }

    private async Task OnRuleFieldChanged(FilterRule r, string? key)
    {
        if (string.IsNullOrWhiteSpace(key) || string.Equals(key, r.Field, StringComparison.OrdinalIgnoreCase)) return;
        r.Field = key;
        r.Op = DefaultOpFor(FieldDef(key)?.Kind ?? FilterKind.Option);
        r.Values = new List<string>();
        await SaveFilterPrefsAsync();
    }

    private async Task OnRuleOpChanged(FilterRule r, string? op)
    {
        if (!Enum.TryParse<FilterOp>(op, out var parsed) || parsed == r.Op) return;
        r.Op = parsed;
        if (!RuleNeedsValues(parsed)) r.Values = new List<string>();
        await SaveFilterPrefsAsync();
    }

    private async Task OnRuleValuesChanged(FilterRule r, List<string> v)
    {
        r.Values = v ?? new List<string>();
        await SaveFilterPrefsAsync();
    }

    private async Task OnRuleTextChanged(FilterRule r, string? t)
    {
        r.Values = string.IsNullOrWhiteSpace(t) ? new List<string>() : new List<string> { t.Trim() };
        await SaveFilterPrefsAsync();
    }

    private async Task ClearAllFiltersAsync()
    {
        _filterReporters = new List<string>();
        _filterAssignees = new List<string>();
        _filterIssueTypes = new List<string>();
        _filterLabels = new List<string>();
        _filterStatuses = new List<string>();
        _filterResolutions = new List<string>();
        _rules.Clear();
        await ClearJqlAsync();
        await SaveFilterPrefsAsync();
    }

    // ── Saved views (local) + the Jira saved filters, in one picker ────────
    private const string JiraViewPrefix = "Jira: ";
    private List<SavedView> _views = new();
    private List<string> _viewNames = new();

    private sealed class SavedView
    {
        public string Name { get; set; } = "";
        public List<string> Reporters { get; set; } = new();
        public List<string> Assignees { get; set; } = new();
        public List<string> IssueTypes { get; set; } = new();
        public List<string> Labels { get; set; } = new();
        public List<string> Statuses { get; set; } = new();
        public List<string> Resolutions { get; set; } = new();
        public List<FilterRule> Rules { get; set; } = new();
        public string GroupBy { get; set; } = "Status";
        public string Jql { get; set; } = "";
    }

    private bool IsLocalViewSelected =>
        _views.Any(v => string.Equals(v.Name, _selectedSavedFilter, StringComparison.OrdinalIgnoreCase));

    // Two owners may each have a filter of the same name, so the Jira half is de-duped.
    private void RebuildViewNames() =>
        _viewNames = _views.Select(v => v.Name)
            .Concat(_savedFilters.Select(f => JiraViewPrefix + f.Name).Distinct(StringComparer.OrdinalIgnoreCase))
            .ToList();

    private async Task SaveViewAsync()
    {
        var suggested = IsLocalViewSelected ? _selectedSavedFilter : "";
        var name = await Dialogs.PromptAsync("Name this filter view:", "Save filter", suggested);
        if (string.IsNullOrWhiteSpace(name)) return;
        name = name.Trim();
        if (name.StartsWith(JiraViewPrefix, StringComparison.OrdinalIgnoreCase))
        {
            Notifications.Error($"\"{JiraViewPrefix.Trim()}\" is reserved for filters that live on the Jira board.");
            return;
        }
        _views.RemoveAll(v => string.Equals(v.Name, name, StringComparison.OrdinalIgnoreCase));
        _views.Add(new SavedView
        {
            Name = name,
            Reporters = new List<string>(_filterReporters),
            Assignees = new List<string>(_filterAssignees),
            IssueTypes = new List<string>(_filterIssueTypes),
            Labels = new List<string>(_filterLabels),
            Statuses = new List<string>(_filterStatuses),
            Resolutions = new List<string>(_filterResolutions),
            Rules = _rules.Select(CloneRule).ToList(),
            GroupBy = _groupBy,
            Jql = _jqlActive ? _jqlText : "",
        });
        _selectedSavedFilter = name;
        RebuildViewNames();
        await SaveFilterPrefsAsync();

        // Push the same view to Jira so it shows up in Jira's own filter list.
        var jql = BuildJqlFromCurrentFilters();
        if (string.IsNullOrWhiteSpace(jql))
        {
            Notifications.Info($"Filter view \"{name}\" saved locally — nothing in it maps to a Jira field.");
        }
        else
        {
            var (ok, msg) = await Jira.SaveFilterToJiraAsync(name, jql);
            if (ok)
            {
                await LoadSavedFiltersAsync();
                Notifications.Info($"Filter view \"{name}\" saved. {msg}");
            }
            else
            {
                Notifications.Warning($"Filter view \"{name}\" saved locally, but {msg}");
            }
        }
    }

    // Fields the board and Jira share. Local-only fields (Screen, VB6 form, module,
    // category, ticket number) have no Jira column and are left out of the JQL.
    private static readonly Dictionary<string, string> _jiraFieldFor = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Reporter"] = "reporter", ["Assignee"] = "assignee", ["IssueType"] = "type",
        ["Labels"] = "labels", ["Status"] = "status", ["Resolution"] = "resolution",
    };

    private static string JqlQuote(string v) => "\"" + v.Replace("\"", "\\\"") + "\"";

    private static string? JqlClause(string jiraField, string op, IReadOnlyList<string> values)
    {
        var vs = values.Where(v => !string.IsNullOrWhiteSpace(v)).ToList();
        switch (op)
        {
            case "is empty":     return $"{jiraField} IS EMPTY";
            case "is not empty": return $"{jiraField} IS NOT EMPTY";
        }
        if (vs.Count == 0) return null;
        var list = string.Join(", ", vs.Select(JqlQuote));
        return op switch
        {
            "is none of"       => $"{jiraField} NOT IN ({list})",
            "contains"         => string.Join(" OR ", vs.Select(v => $"{jiraField} ~ {JqlQuote(v)}")) is var c && vs.Count > 1 ? $"({c})" : $"{jiraField} ~ {JqlQuote(vs[0])}",
            "does not contain" => string.Join(" AND ", vs.Select(v => $"{jiraField} !~ {JqlQuote(v)}")),
            _                  => $"{jiraField} IN ({list})",
        };
    }

    /// <summary>The current Basic + Advanced filters rendered as JQL. The JQL tab, when
    /// in use, wins outright — it is already Jira's own language.</summary>
    private string BuildJqlFromCurrentFilters()
    {
        if (_jqlActive && !string.IsNullOrWhiteSpace(_jqlText))
        {
            // Untouched since it was loaded from Jira: hand Jira back its own text rather
            // than the readable rewrite, so the filter keeps its accountIds and formatting.
            if (_jqlAsStoredInJira.Length > 0 && string.Equals(_jqlText, _jqlAsLoaded, StringComparison.Ordinal))
                return _jqlAsStoredInJira;
            return _jqlText.Trim();
        }

        var parts = new List<string>();
        void Basic(string field, List<string> vals)
        {
            if (vals.Count == 0) return;
            var c = JqlClause(_jiraFieldFor[field], "is any of", vals);
            if (c != null) parts.Add(c);
        }
        Basic("Reporter", _filterReporters);
        Basic("Assignee", _filterAssignees);
        Basic("IssueType", _filterIssueTypes);
        Basic("Labels", _filterLabels);
        Basic("Status", _filterStatuses);
        Basic("Resolution", _filterResolutions);

        foreach (var r in _rules)
        {
            if (!_jiraFieldFor.TryGetValue(r.Field, out var jf)) continue;
            var opText = r.Op switch
            {
                FilterOp.NotIn => "is none of",
                FilterOp.Contains => "contains",
                FilterOp.NotContains => "does not contain",
                FilterOp.IsEmpty => "is empty",
                FilterOp.IsNotEmpty => "is not empty",
                _ => "is any of",
            };
            var c = JqlClause(jf, opText, r.Values);
            if (c != null) parts.Add(c);
        }

        var jql = string.Join(" AND ", parts);
        var key = Jira.LoadSettings().ProjectKey;
        if (!string.IsNullOrWhiteSpace(key))
            jql = string.IsNullOrWhiteSpace(jql) ? $"project = \"{key}\"" : $"project = \"{key}\" AND {jql}";
        return jql;
    }

    private async Task DeleteViewAsync()
    {
        var name = _selectedSavedFilter;
        if (string.IsNullOrWhiteSpace(name)) return;
        if (!await Dialogs.ConfirmAsync($"Delete the saved filter view \"{name}\"?", "Delete view")) return;
        _views.RemoveAll(v => string.Equals(v.Name, name, StringComparison.OrdinalIgnoreCase));
        _selectedSavedFilter = "";
        RebuildViewNames();
        await SaveFilterPrefsAsync();
    }

    private static FilterRule CloneRule(FilterRule r) =>
        new() { Field = r.Field, Op = r.Op, Values = new List<string>(r.Values) };

    private async Task ApplyViewAsync(SavedView v)
    {
        // Fresh List instances — MultiSelectComboControl compares by reference and will not
        // re-render if the same list is handed back mutated.
        _filterReporters = new List<string>(v.Reporters);
        _filterAssignees = new List<string>(v.Assignees);
        _filterIssueTypes = new List<string>(v.IssueTypes);
        _filterLabels = new List<string>(v.Labels);
        _filterStatuses = new List<string>(v.Statuses);
        _filterResolutions = new List<string>(v.Resolutions);
        _rules = v.Rules.Select(CloneRule).ToList();
        _rules.RemoveAll(r => FieldDef(r.Field) is null);
        _groupBy = string.IsNullOrWhiteSpace(v.GroupBy) ? "Status" : v.GroupBy;
        if (string.IsNullOrWhiteSpace(v.Jql))
        {
            await ClearJqlAsync();
        }
        else
        {
            _jqlText = v.Jql;
            _jqlAsLoaded = "";           // a local view, not a filter Jira holds
            _jqlAsStoredInJira = "";
            await RunJqlAsync();
        }
        await SaveFilterPrefsAsync();
    }

    // ── Per-user filter memory ─────────────────────────────────────────────
    // The board filters (Reporter/Assignee/Issue Type) + Group by are remembered PER
    // "Current user" in browser localStorage, so each person gets their own view back
    // when they select their name. The search box is deliberately ephemeral.
    private sealed class FeedbackFilterPrefs
    {
        public List<string> Reporters { get; set; } = new();
        public List<string> Assignees { get; set; } = new();
        public List<string> IssueTypes { get; set; } = new();
        public List<string> Labels { get; set; } = new();
        public List<string> Statuses { get; set; } = new();
        public List<string> Resolutions { get; set; } = new();
        public string GroupBy { get; set; } = "Status";
        public List<FilterRule> Rules { get; set; } = new();
        public List<SavedView> Views { get; set; } = new();
    }

    private string FilterPrefsStorageKey => $"hf.feedback.filters.{CurrentUserName.Trim().ToLowerInvariant()}";

    private async Task SaveFilterPrefsAsync()
    {
        var prefs = new FeedbackFilterPrefs
        {
            Reporters = _filterReporters,
            Assignees = _filterAssignees,
            IssueTypes = _filterIssueTypes,
            Labels = _filterLabels,
            Statuses = _filterStatuses,
            Resolutions = _filterResolutions,
            GroupBy = _groupBy,
            Rules = _rules,
            Views = _views,
        };
        try { await JSRuntime.InvokeVoidAsync("localStorage.setItem", FilterPrefsStorageKey, JsonSerializer.Serialize(prefs)); }
        catch { /* storage unavailable (prerender/private mode) — filters just won't persist */ }
    }

    // Restore the saved filters for the CURRENT user; a user with nothing saved gets the
    // default view (no filters, Status lanes) so views stay isolated per person.
    private async Task LoadFilterPrefsAsync()
    {
        FeedbackFilterPrefs? prefs = null;
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", FilterPrefsStorageKey);
            if (!string.IsNullOrWhiteSpace(json)) prefs = JsonSerializer.Deserialize<FeedbackFilterPrefs>(json);
        }
        catch { }
        _filterReporters = prefs?.Reporters ?? new List<string>();
        _filterAssignees = prefs?.Assignees ?? new List<string>();
        _filterIssueTypes = prefs?.IssueTypes ?? new List<string>();
        _filterLabels = prefs?.Labels ?? new List<string>();
        _filterStatuses = prefs?.Statuses ?? new List<string>();
        _filterResolutions = prefs?.Resolutions ?? new List<string>();
        _rules = prefs?.Rules ?? new List<FilterRule>();
        _rules.RemoveAll(r => FieldDef(r.Field) is null);
        _views = prefs?.Views ?? new List<SavedView>();
        _groupBy = string.IsNullOrWhiteSpace(prefs?.GroupBy) ? "Status" : prefs!.GroupBy;
        RebuildViewNames();
    }

    // Filter choices = the distinct values actually present on the board (so the lists only offer what's filterable).
    private List<string> FilterReporterOptions => allFeedbacks
        .Select(f => string.IsNullOrWhiteSpace(f.UserName) ? "—" : f.UserName)
        .Distinct().OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
    private List<string> FilterAssigneeOptions => allFeedbacks
        .Select(f => string.IsNullOrWhiteSpace(f.Assignee) ? "Unassigned" : f.Assignee)
        .Distinct().OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
    private List<string> FilterStatusOptions => allFeedbacks
        .Select(f => string.IsNullOrWhiteSpace(f.Status) ? "To Do" : f.Status)
        .Distinct().OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
    private List<string> FilterResolutionOptions => allFeedbacks
        .Select(f => string.IsNullOrWhiteSpace(f.Resolution) ? "(unresolved)" : f.Resolution)
        .Distinct().OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();

    // ── Jira-side filtering (saved filters + JQL) ─────────────────────
    private async Task LoadSavedFiltersAsync()
    {
        try
        {
            _savedFilters = await Jira.FetchSavedFiltersAsync();
            _savedFilterNames = _savedFilters.Select(f => f.Name).ToList();
            RebuildViewNames();
            // Loaded off the render path, so the picker has to be told.
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Logger.LogWarning(ex, "LoadSavedFilters"); }
    }

    // One picker, two sources: local views by name, Jira's own filters behind a "Jira: " prefix.
    private async Task OnSavedFilterChanged(string? name)
    {
        var picked = name ?? "";
        if (string.IsNullOrWhiteSpace(picked))
        {
            _selectedSavedFilter = "";
            return;
        }

        if (picked.StartsWith(JiraViewPrefix, StringComparison.Ordinal))
        {
            var wanted = picked.Substring(JiraViewPrefix.Length);
            var matches = _savedFilters.Where(x => string.Equals(x.Name, wanted, StringComparison.OrdinalIgnoreCase));
            var jf = matches.FirstOrDefault(x => x.IsMine) ?? matches.FirstOrDefault();
            if (jf == null) return;
            _jqlText = jf.Jql;
            _jqlAsLoaded = jf.Jql;
            _jqlAsStoredInJira = jf.SourceJql;
            _filterTab = 2;
            await RunJqlAsync();
            _selectedSavedFilter = picked;
            return;
        }

        var view = _views.FirstOrDefault(v => string.Equals(v.Name, picked, StringComparison.OrdinalIgnoreCase));
        if (view == null) return;
        await ApplyViewAsync(view);
        _selectedSavedFilter = picked;
        StateHasChanged();
    }

    private async Task RunJqlAsync()
    {
        if (string.IsNullOrWhiteSpace(_jqlText))
        {
            await ClearJqlAsync();
            return;
        }
        try
        {
            var issues = await Jira.FetchIssuesByJqlAsync(_jqlText);
            _jqlKeys = new HashSet<string>(issues.Select(i => i.Key), StringComparer.OrdinalIgnoreCase);
            _jqlActive = true;
            Notifications.Info($"JQL matched {_jqlKeys.Count} issue(s).");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "RunJql");
            Notifications.Error("That JQL could not be run — check the syntax.");
        }
        StateHasChanged();
    }

    private Task ClearJqlAsync()
    {
        _jqlActive = false;
        _jqlKeys.Clear();
        _jqlText = "";
        _jqlAsLoaded = "";
        _jqlAsStoredInJira = "";
        _selectedSavedFilter = "";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private List<string> FilterIssueTypeOptions => allFeedbacks
        .Select(f => string.IsNullOrWhiteSpace(f.IssueType) ? "Bug" : f.IssueType)
        .Distinct().OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
    // Every distinct label on the board (tickets carry comma-separated Labels synced
    // from Jira) + "(none)" so label-less tickets stay reachable through the filter.
    private List<string> FilterLabelOptions
    {
        get
        {
            var labels = allFeedbacks
                .SelectMany(f => SplitLabels(f.Labels))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (allFeedbacks.Any(f => !SplitLabels(f.Labels).Any()))
                labels.Insert(0, "(none)");
            return labels;
        }
    }

    private List<FeedbackItem> GetFilteredFeedbacks()
    {
        IEnumerable<FeedbackItem> q = allFeedbacks;
        if (_filterReporters.Count > 0)
            q = q.Where(f => _filterReporters.Contains(string.IsNullOrWhiteSpace(f.UserName) ? "—" : f.UserName));
        if (_filterAssignees.Count > 0)
            q = q.Where(f => _filterAssignees.Contains(string.IsNullOrWhiteSpace(f.Assignee) ? "Unassigned" : f.Assignee));
        if (_filterIssueTypes.Count > 0)
            q = q.Where(f => _filterIssueTypes.Contains(string.IsNullOrWhiteSpace(f.IssueType) ? "Bug" : f.IssueType));
        if (_filterLabels.Count > 0)
            q = q.Where(f =>
            {
                var ls = SplitLabels(f.Labels).ToList();
                return ls.Count == 0
                    ? _filterLabels.Contains("(none)")
                    : ls.Any(l => _filterLabels.Contains(l, StringComparer.OrdinalIgnoreCase));
            });
        if (_filterStatuses.Count > 0)
            q = q.Where(f => _filterStatuses.Contains(string.IsNullOrWhiteSpace(f.Status) ? "To Do" : f.Status));
        if (_filterResolutions.Count > 0)
            q = q.Where(f => _filterResolutions.Contains(string.IsNullOrWhiteSpace(f.Resolution) ? "(unresolved)" : f.Resolution));
        foreach (var rule in _rules)
        {
            if (!RuleIsActive(rule)) continue;
            var r = rule;
            q = q.Where(f => MatchesRule(f, r));
        }
        if (_jqlActive)
            q = q.Where(f => !string.IsNullOrWhiteSpace(f.ExternalKey) && _jqlKeys.Contains(f.ExternalKey));
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var term = searchQuery.Trim();
            q = q.Where(f =>
                // Ticket key first: matches the label shown on the card — the Jira key
                // ("HHM-332") for board tickets, else "PM-{number}" — and the bare
                // number ("332"), so pasting any form of the id narrows to that ticket.
                TicketLabel(f).Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.TicketNumber.ToString().Contains(term, StringComparison.Ordinal) ||
                f.Topic.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Description.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.UserName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (f.Assignee ?? "").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (f.Labels ?? "").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (f.Category ?? "").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (f.ScreenName ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return q.ToList();
    }

    // Board grouping key for a ticket under the chosen Group-by field (also the Kanban lane key).
    private string GroupKeyOf(FeedbackItem f) => _groupBy switch
    {
        "MenuOption" => MenuOptionFor(f),
        "Category" => string.IsNullOrWhiteSpace(f.Category) ? "Uncategorized" : f.Category,
        "IssueType" => string.IsNullOrWhiteSpace(f.IssueType) ? "Bug" : f.IssueType,
        "Severity" => string.IsNullOrWhiteSpace(f.Severity) ? "Major" : f.Severity,
        "Status" => string.IsNullOrWhiteSpace(f.Status) ? "To Do" : f.Status,
        "Priority" => string.IsNullOrWhiteSpace(f.Priority) ? "Medium" : f.Priority,
        "Reporter" => string.IsNullOrWhiteSpace(f.UserName) ? "—" : f.UserName,
        _ => string.IsNullOrWhiteSpace(f.ScreenName) ? "General" : f.ScreenName,
    };

    // Kanban lanes for the current Group-by. Status uses the fixed Jira lane order + accent colours;
    // other option-backed fields use their option list (so empty lanes still show); free-form fields
    // (Menu option / Screen) use the distinct values present.
    private List<KanbanColumn> KanbanColumns()
    {
        if (_groupBy == "Status")
            return new()
            {
                new() { Key = "To Do",              Title = "To Do",              AccentColor = "#8993a4" },
                new() { Key = "In Progress",        Title = "In Progress",        AccentColor = "#4c7bf3" },
                new() { Key = "Development Review", Title = "Development Review", AccentColor = "#e2803c" },
                new() { Key = "Ready for Test",     Title = "Ready for Test",     AccentColor = "#9c6ade" },
                new() { Key = "Done",               Title = "Done",               AccentColor = "#22a06b" },
                new() { Key = "UI Adjustment",      Title = "UI Adjustment",      AccentColor = "#00b8d9" },
            };
        List<string>? opts = _groupBy switch
        {
            "Priority" => _priorities, "Severity" => _severities, "IssueType" => _issueTypes, "Category" => _categories, _ => null
        };
        var keys = opts ?? GetFilteredFeedbacks().Select(GroupKeyOf)
                              .Distinct(StringComparer.OrdinalIgnoreCase)
                              .OrderBy(k => k, StringComparer.OrdinalIgnoreCase).ToList();
        return keys.Select(k => new KanbanColumn { Key = k, Title = k }).ToList();
    }

    // Card dragged to another lane → apply the move to the field the board is grouped by, then persist.
    private async Task OnCardMoved(KanbanMoveArgs<FeedbackItem> e)
    {
        var item = e.Item;

        // Jira-style: moving a ticket to the Done lane opens the "Close issue" dialog (resolution + comment)
        // FIRST. The card stays in its current lane until the dialog is confirmed (Status is set on Close).
        if (_groupBy == "Status" && string.Equals(e.ToColumn, "Done", StringComparison.OrdinalIgnoreCase))
        {
            _closingItem = item;
            _closeResolution = string.IsNullOrWhiteSpace(item.Resolution) ? "Implemented" : item.Resolution;
            _closeComment = "";
            _showCloseDialog = true;
            StateHasChanged();
            return;
        }

        switch (_groupBy)
        {
            case "Status":    item.Status    = e.ToColumn; break;
            case "Priority":  item.Priority  = e.ToColumn; break;
            case "Severity":  item.Severity  = e.ToColumn; break;
            case "IssueType": item.IssueType = e.ToColumn; break;
            case "Category":  item.Category  = e.ToColumn; break;
            case "Reporter":  item.UserName  = e.ToColumn; break;
            default: return;   // Menu option / Screen lanes aren't editable by drag
        }
        try
        {
            await FeedbackService.UpdateFeedbackAsync(item);
            await LoadFeedbackHistoryAsync();
            Notifications.Info($"{TicketLabel(item)} → {e.ToColumn}");
            if (_groupBy == "Status") await PushStatusToJiraAsync(item);   // mirror the drag onto the Jira board
        }
        catch (Exception ex) { Notifications.Error($"Move failed: {ex.Message}"); }
    }

    // ── "Close issue" dialog (Jira-style) — shown when a ticket is moved to the Done lane ──
    private bool _showCloseDialog;
    private FeedbackItem? _closingItem;
    private string _closeResolution = "Implemented";
    private string _closeComment = "";
    private static readonly List<string> _resolutions = new()
        { "Implemented", "Works as Intended", "Cannot Reproduce", "Duplicate", "Abandoned", "Won't Do" };

    private async Task ConfirmCloseTicketAsync()
    {
        if (_closingItem == null) { _showCloseDialog = false; return; }
        var item = _closingItem;
        item.Status = "Done";
        item.Resolution = string.IsNullOrWhiteSpace(_closeResolution) ? "Implemented" : _closeResolution.Trim();
        if (!string.IsNullOrWhiteSpace(_closeComment))
        {
            item.Comments ??= new();
            item.Comments.Add(new TicketComment
            {
                Author = CurrentUserName,   // comment author = the selected "Current user"
                Text = $"Closed as {item.Resolution} — {_closeComment.Trim()}",
                Date = DateTime.Now
            });
        }
        _showCloseDialog = false;
        _closingItem = null;
        try
        {
            await FeedbackService.UpdateFeedbackAsync(item);
            await LoadFeedbackHistoryAsync();
            Notifications.Info($"{TicketLabel(item)} closed — {item.Resolution}");
            await PushStatusToJiraAsync(item);   // move the issue to Done on the Jira board
        }
        catch (Exception ex) { Notifications.Error($"Failed to close ticket: {ex.Message}"); }
    }

    private void CancelCloseTicket()
    {
        // Status was never changed, so the card stays where it was; just dismiss the dialog.
        _showCloseDialog = false;
        _closingItem = null;
        StateHasChanged();
    }

    // ── Export to Jira (create a new issue on the board) ──
    private static readonly string[] _jiraIssueTypes = { "Bug", "Task", "Story", "Improvement", "New Feature", "Sub-task" };
    private bool _jiraExportOpen, _jiraExporting;
    private FeedbackItem? _jiraItem;
    private string _jiraBaseUrl = "", _jiraProject = "", _jiraIssueType = "Bug", _jiraSummary = "", _jiraDescription = "";
    private int _jiraNextNum;
    private bool _jiraAttach = true;

    private async Task OpenJiraExportAsync(FeedbackItem m)
    {
        var s = Jira.LoadSettings();
        if (!s.IsConfigured)
        {
            Notifications.Warning("Jira isn't configured yet — enter the connection details first.");
            OpenJiraSettings();
            return;
        }
        _jiraItem = m;
        _jiraBaseUrl = s.BaseUrl.TrimEnd('/');
        _jiraProject = s.ProjectKey ?? "";
        _jiraIssueType = MapIssueType(string.IsNullOrWhiteSpace(m.IssueType) ? s.IssueType : m.IssueType);
        _jiraSummary = string.IsNullOrWhiteSpace(m.Topic) ? $"HomeFront ticket #{m.TicketNumber}" : m.Topic;
        _jiraDescription = BuildJiraDescription(m);
        _jiraAttach = true;
        _jiraNextNum = 0;
        _jiraExportOpen = true;
        StateHasChanged();
        // Fetch the projected next number after the dialog is up (non-blocking).
        try { _jiraNextNum = await Jira.GetNextIssueNumberAsync(_jiraProject); } catch { _jiraNextNum = 0; }
        StateHasChanged();
    }

    private void CancelJiraExport() { _jiraExportOpen = false; _jiraItem = null; StateHasChanged(); }

    private async Task ConfirmJiraExportAsync()
    {
        if (_jiraItem is null || _jiraExporting) return;
        if (string.IsNullOrWhiteSpace(_jiraProject)) { Notifications.Warning("Enter the Jira project / board key."); return; }
        if (string.IsNullOrWhiteSpace(_jiraSummary)) { Notifications.Warning("Enter a summary."); return; }
        _jiraExporting = true; StateHasChanged();
        try
        {
            var opts = new JiraExportOptions
            {
                TicketNumber = _jiraItem.TicketNumber,
                ProjectKey = _jiraProject.Trim(),
                IssueType = _jiraIssueType,
                Summary = _jiraSummary.Trim(),
                Description = _jiraDescription,
                Attach = _jiraAttach,
                Assignee = _jiraItem.Assignee,
                Reporter = _jiraItem.UserName,
                Labels = _jiraItem.Labels,
                Sprint = _jiraItem.Sprint,
                Priority = _jiraItem.Priority
            };
            // Update the existing issue when this ticket is already on the board; otherwise create.
            var updating = !string.IsNullOrWhiteSpace(_jiraItem.ExternalKey);
            var res = updating
                ? await Jira.UpdateIssueAsync(_jiraItem.ExternalKey, opts)
                : await Jira.CreateIssueAsync(opts, _jiraAttach ? await FeedbackService.GatherAttachmentsAsync(_jiraItem) : null);

            if (res.Success)
            {
                _jiraItem.ExternalKey = res.IssueKey;
                try { await FeedbackService.UpdateFeedbackAsync(_jiraItem); } catch { }
                await LoadFeedbackHistoryAsync();
                selectedFeedback = allFeedbacks.FirstOrDefault(f => f.TicketNumber == _jiraItem.TicketNumber) ?? selectedFeedback;
                Notifications.Success(updating ? $"Updated {res.IssueKey} on Jira." : $"Created {res.IssueKey} on Jira.");
                _jiraExportOpen = false; _jiraItem = null;
            }
            else { Notifications.Error($"Jira export failed: {res.Error}"); }
        }
        catch (Exception ex) { Notifications.Error($"Jira export failed: {ex.Message}"); }
        finally { _jiraExporting = false; StateHasChanged(); }
    }

    private string JiraBrowseUrl(string key)
    {
        var b = (Jira.LoadSettings().BaseUrl ?? "").TrimEnd('/');
        return string.IsNullOrEmpty(b) ? "#" : $"{b}/browse/{key}";
    }

    // Map a local issue-type label to a common Jira issue type (the dialog dropdown stays editable so
    // the user can override for a board with custom types). Defaults to Bug.
    private static string MapIssueType(string? t) => (t ?? "").Trim().ToLowerInvariant() switch
    {
        "feature request" or "new feature" => "New Feature",
        "enhancement" or "improvement" => "Improvement",
        "migration gap" or "task" => "Task",
        "story" => "Story",
        "sub-task" or "subtask" => "Sub-task",
        _ => "Bug"
    };

    // The Jira description payload: the editor's wiki-markup (or an HTML→text fallback) plus a footer
    // with the HomeFront ticket context. Shared by the export dialog and the auto-export on save.
    private string BuildJiraDescription(FeedbackItem m)
    {
        var descBody = !string.IsNullOrWhiteSpace(m.DescriptionJira) ? m.DescriptionJira : HtmlToText(m.Description);
        var footer = "";
        if (!string.IsNullOrWhiteSpace(m.ScreenName)) footer += $"\nScreen: {m.ScreenName}";
        if (!string.IsNullOrWhiteSpace(m.UserName)) footer += $"\nReported by: {m.UserName}";
        return descBody.TrimEnd() + (footer.Length > 0 ? "\n\n----" + footer : "");
    }

    // Parse the numeric suffix from a Jira key ("HHM-63" → 63).
    private static bool TryParseIssueNumber(string? key, out int number)
    {
        number = 0;
        if (string.IsNullOrWhiteSpace(key)) return false;
        var dash = key.LastIndexOf('-');
        return dash >= 0 && int.TryParse(key.AsSpan(dash + 1), out number);
    }

    // On Save (new + edit): push the ticket to the Jira board when it's configured — create it if it
    // has no key yet, otherwise update the existing issue. Best-effort: a Jira failure never fails the
    // local save (which has already happened); the outcome is surfaced as a notification.
    private async Task AutoExportToJiraAsync(FeedbackItem m)
    {
        var s = Jira.LoadSettings();
        if (!s.IsConfigured) return;   // no board / token configured → nothing to sync
        try
        {
            var opts = new JiraExportOptions
            {
                TicketNumber = m.TicketNumber,
                ProjectKey = s.ProjectKey,
                IssueType = MapIssueType(string.IsNullOrWhiteSpace(m.IssueType) ? s.IssueType : m.IssueType),
                Summary = string.IsNullOrWhiteSpace(m.Topic) ? $"HomeFront ticket #{m.TicketNumber}" : m.Topic,
                Description = BuildJiraDescription(m),
                Attach = true,
                Assignee = m.Assignee,
                Reporter = m.UserName,
                Labels = m.Labels,
                Sprint = m.Sprint,
                Priority = m.Priority
            };

            if (!string.IsNullOrWhiteSpace(m.ExternalKey))
            {
                var res = await Jira.UpdateIssueAsync(m.ExternalKey, opts);
                if (res.Success) Notifications.Success($"Synced to Jira ({m.ExternalKey}).");
                else Notifications.Warning($"Saved locally; Jira update failed: {res.Error}");
            }
            else
            {
                var res = await Jira.CreateIssueAsync(opts, await FeedbackService.GatherAttachmentsAsync(m));
                if (res.Success)
                {
                    m.ExternalKey = res.IssueKey;
                    try { await FeedbackService.UpdateFeedbackAsync(m); } catch { }
                    Notifications.Success($"Created {res.IssueKey} on Jira.");
                }
                else Notifications.Warning($"Saved locally; Jira export failed: {res.Error}");
            }
            await PushLinksToJiraAsync(m);   // HHM-216: linked work items ride every export
        }
        catch (Exception ex) { Notifications.Warning($"Saved locally; Jira sync failed: {ex.Message}"); }
    }

    private bool _savingToJira;
    // ── Single atomic guard shared by EVERY Jira-push path (create-first submit,
    //    edit-save, read-mode "Save to Jira"). Checked-and-set BEFORE any await so
    //    two overlapping saves (fast double-click, or manual Save + auto-save) can
    //    never both run a CREATE while ExternalKey is still empty → the root cause
    //    of duplicate Jira issues (HHM-61≡HHM-62 etc.).
    private bool _saveInProgress;
    // Read-mode "Save to Jira": persist the ticket locally, then create-or-update it on the board (summary,
    // description, attachments) and move it to the matching status. The local save always happens; the Jira
    // half is best-effort and only when a connection is configured (AutoExport/PushStatus no-op otherwise).
    private async Task SaveToJiraAsync(FeedbackItem m)
    {
        if (m == null || _savingToJira || _saveInProgress) return;
        _savingToJira = true; _saveInProgress = true; StateHasChanged();
        try
        {
            await FeedbackService.UpdateFeedbackAsync(m);
            await AutoExportToJiraAsync(m);
            await PushStatusToJiraAsync(m);
            await LoadFeedbackHistoryAsync();
            selectedFeedback = allFeedbacks.FirstOrDefault(f => f.TicketNumber == m.TicketNumber) ?? selectedFeedback;
        }
        catch (Exception ex) { Notifications.Error($"Save to Jira failed: {ex.Message}"); }
        finally { _savingToJira = false; _saveInProgress = false; StateHasChanged(); }
    }

    // First-open resync FROM the Jira board: update matched local tickets' status/summary, and import
    // any board issues not present locally. Best-effort + fully guarded (runs fire-and-forget).
    private bool _syncRunning;
    // App-wide gate: the sync writes to the SHARED feedback store, so two circuits
    // (the app open in two windows/tabs) running it concurrently just do the same
    // work twice — every ticket saved once per circuit. One sync at a time is enough;
    // late arrivals skip and pick up the result on their next open/manual sync.
    private static int _syncGate;
    private string _syncProgress = "";
    private async Task<(int updated, int imported)> SyncFromJiraAsync()
    {
        if (_syncRunning) return (0, 0);   // guard against concurrent runs (auto + manual) → no duplicate imports
        if (Interlocked.CompareExchange(ref _syncGate, 1, 0) != 0) return (0, 0);   // another window is already syncing
        _syncRunning = true;
        _jiraSyncing = true; _syncProgress = "";
        await InvokeAsync(StateHasChanged);
        int updated = 0, imported = 0;
        var syncStartTime = DateTime.UtcNow;
        try
        {
            var settings = Jira.LoadSettings();
            if (!settings.IsConfigured) return (0, 0);
            var since = settings.LastSyncTime;
            if (since.HasValue)
            {
                since = since.Value.AddMinutes(-5); // 5-minute overlap buffer to protect against race conditions/timezone skews
            }
            var issues = await Jira.FetchAllIssuesAsync(since: since);
            if (issues.Count == 0)
            {
                // Even if no issues returned, we still update the LastSyncTime to syncStartTime to keep moving the window forward.
                try
                {
                    var newSettings = Jira.LoadSettings();
                    newSettings.LastSyncTime = syncStartTime;
                    Jira.SaveSettings(newSettings);
                }
                catch { }
                return (0, 0);
            }
            var local = await FeedbackService.GetAllFeedbackAsync();
            var importedKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            // The API token's own display name: every issue the app creates carries it as the Jira
            // reporter (reporter can't be set via the API), so it is NOT a meaningful person there.
            var tokenAccount = await Jira.GetMyDisplayNameAsync();
            // Reporter pulls are only safe when we KNOW the token's own account name —
            // Jira shows it as the reporter of every app-created issue, so without it
            // we cannot tell a real reporter from the token echo. When the lookup
            // failed, skip reporter syncing entirely this round instead of stamping
            // the token owner onto every ticket (the recurring reporter-reset bug).
            var reporterPullSafe = !string.IsNullOrWhiteSpace(tokenAccount);
            var syncedCount = 0;
            foreach (var iss in issues)
            {
                syncedCount++;
                _syncProgress = $"{syncedCount}/{issues.Count}";
                if (syncedCount % 3 == 0 || syncedCount == issues.Count)
                    await InvokeAsync(StateHasChanged);
                if (string.IsNullOrWhiteSpace(iss.Key)) continue;
                var match = local.FirstOrDefault(f => string.Equals(f.ExternalKey, iss.Key, StringComparison.OrdinalIgnoreCase));
                if (match != null)
                {
                    // FRESHNESS GUARD. The pull reads Jira's SEARCH INDEX, which lags real changes
                    // by minutes (observed: an hour). Overwriting unconditionally meant a just-saved
                    // local edit (e.g. a new Assignee) was reverted by a stale snapshot of the very
                    // ticket that was edited. Only let the board overwrite when its snapshot is at
                    // least as new as the last local save; once the index catches up (the push bumped
                    // the issue's updated time), the overwrites become no-ops anyway.
                    var boardIsFresh = match.LastLocalEditDate == null
                        || iss.Updated == null
                        || iss.Updated >= match.LastLocalEditDate;
                    if (boardIsFresh)
                    {
                    var status = MapJiraStatus(iss.Status);
                    if (!string.IsNullOrEmpty(status) && !string.Equals(match.Status, status, StringComparison.Ordinal)) match.Status = status;
                    if (!string.IsNullOrWhiteSpace(iss.Summary) && !string.Equals(match.Topic, iss.Summary, StringComparison.Ordinal)) match.Topic = iss.Summary;
                    // Pull the board's Sprint / Labels / Assignee back into the local ticket.
                    if (!string.IsNullOrWhiteSpace(iss.Sprint) && !string.Equals(match.Sprint, iss.Sprint, StringComparison.Ordinal)) match.Sprint = iss.Sprint;
                    if (!string.Equals(match.Labels ?? "", iss.Labels ?? "", StringComparison.Ordinal)) match.Labels = iss.Labels ?? "";
                    if (!string.IsNullOrWhiteSpace(iss.Assignee) && !string.Equals(match.Assignee, iss.Assignee, StringComparison.Ordinal)) match.Assignee = iss.Assignee;
                    }
                    ApplyJiraLinks(match, iss.Links);   // HHM-216: linked work items follow the board
                    // Reporter: the BOARD wins — except when Jira's reporter is the API token's own
                    // account (that's what every app-created issue shows, regardless of who really
                    // filed it — the local name is the truth there). This also repairs tickets whose
                    // reporter was wrongly converted locally: syncing restores the Jira reporter.
                    // The current user is NEVER written onto an existing ticket here.
                    if (reporterPullSafe
                        && !string.IsNullOrWhiteSpace(iss.Reporter)
                        && !string.Equals(iss.Reporter, tokenAccount, StringComparison.OrdinalIgnoreCase)
                        && !string.Equals(match.UserName, iss.Reporter, StringComparison.Ordinal))
                        match.UserName = iss.Reporter;
                    else if (reporterPullSafe
                        && IsPlaceholderReporter(match.UserName)
                        && !string.IsNullOrWhiteSpace(iss.Reporter)
                        // Never heal a placeholder with the token's own account — that is
                        // just the app's push identity, not who filed the ticket.
                        && !string.Equals(iss.Reporter, tokenAccount, StringComparison.OrdinalIgnoreCase))
                        match.UserName = iss.Reporter;   // heal blank/"Unassigned"/"Application User" placeholders
                    // Heal: a matched ticket with NO local images but Jira has attachments → download + relink.
                    bool hasLocal = (match.Attachments?.Count ?? 0) > 0 || !string.IsNullOrEmpty(match.ScreenshotPath);
                    if (!hasLocal)
                    {
                        var detail = await Jira.FetchIssueDetailAsync(iss.Key);
                        if (detail.Attachments.Count > 0)
                        {
                            try { await AttachJiraImagesAsync(match, detail.Attachments, detail.DescriptionHtml, isNew: false); updated++; } catch { }
                            continue;   // AttachJiraImagesAsync already persisted (incl. the status/topic above)
                        }
                    }
                    try { await FeedbackService.UpdateFeedbackAsync(match); updated++; } catch { }
                }
                else if (TryParseIssueNumber(iss.Key, out var num) && importedKeys.Add(iss.Key))
                {
                    var detail = await Jira.FetchIssueDetailAsync(iss.Key);   // search/jql omits desc + attachments
                    var item = new FeedbackItem
                    {
                        TicketNumber = num,
                        ExternalKey = iss.Key,
                        Topic = iss.Summary,
                        Description = detail.DescriptionHtml,
                        Status = MapJiraStatus(iss.Status),
                        IssueType = string.IsNullOrWhiteSpace(iss.IssueType) ? "Bug" : iss.IssueType,
                        Priority = string.IsNullOrWhiteSpace(iss.Priority) ? "Medium" : MapJiraPriority(iss.Priority),
                        Assignee = iss.Assignee ?? "",
                        UserName = ResolveImportReporter(iss.Reporter, tokenAccount, detail.DescriptionHtml),
                        Sprint = iss.Sprint ?? "",
                        Labels = iss.Labels ?? "",
                        Links = iss.Links.Select(j => new TicketLink { Type = j.Phrase, TargetKey = j.TargetKey, TargetSummary = j.TargetSummary }).ToList(),
                    };
                    try { await AttachJiraImagesAsync(item, detail.Attachments, detail.DescriptionHtml, isNew: true); imported++; } catch { }
                }
            }

            // Save the successful sync start time so the next run only pulls the delta since this time.
            try
            {
                var newSettings = Jira.LoadSettings();
                newSettings.LastSyncTime = syncStartTime;
                Jira.SaveSettings(newSettings);
            }
            catch { }

            if (updated > 0 || imported > 0)
            {
                await LoadFeedbackHistoryAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* best-effort */ }
        finally
        {
            _syncRunning = false;
            Interlocked.Exchange(ref _syncGate, 0);
            _jiraSyncing = false; _syncProgress = "";
            await InvokeAsync(StateHasChanged);
        }
        return (updated, imported);
    }

    // Download a Jira issue's attachments, save them locally (the data-URL flatten in Save/Update writes
    // files + assigns web paths), set the card thumbnail, and rewrite the description's inline <img> from
    // the Jira content URLs to the local copies. Used for both a fresh import and healing an old one.
    private async Task AttachJiraImagesAsync(FeedbackItem item, IReadOnlyList<JiraAttachmentMeta> metas, string descriptionHtml, bool isNew)
    {
        if (!string.IsNullOrWhiteSpace(descriptionHtml)) item.Description = descriptionHtml;
        var downloaded = new List<(JiraAttachmentMeta Meta, byte[] Bytes)>();
        foreach (var m in metas)
        {
            var b = await Jira.DownloadAttachmentAsync(m.ContentUrl);
            if (b is { Length: > 0 }) downloaded.Add((m, b));
        }
        if (downloaded.Count > 0)
            item.Attachments = downloaded.Select(d => new TicketAttachment
            {
                Path = $"data:{d.Meta.MimeType};base64,{Convert.ToBase64String(d.Bytes)}",
                FileName = d.Meta.FileName,
                ContentType = d.Meta.MimeType
            }).ToList();

        if (isNew) await FeedbackService.SaveFeedbackAsync(item, "");
        else await FeedbackService.UpdateFeedbackAsync(item);   // both flatten the data-URL attachments to files
        if (downloaded.Count == 0) return;

        // After flatten, Attachments[i].Path is the local web path (order preserved) — map the Jira content
        // URLs to them, set the thumbnail to the first image, and relink the description.
        var map = new Dictionary<string, string>();
        for (int i = 0; i < downloaded.Count && i < item.Attachments.Count; i++)
            map[downloaded[i].Meta.ContentUrl] = item.Attachments[i].Path;
        var firstImg = item.Attachments.FirstOrDefault(a => (a.ContentType ?? "").StartsWith("image/", StringComparison.OrdinalIgnoreCase));
        if (firstImg != null) item.ScreenshotPath = firstImg.Path;
        var desc = item.Description ?? "";
        foreach (var kv in map) desc = desc.Replace(kv.Key, kv.Value);
        item.Description = desc;
        await FeedbackService.UpdateFeedbackAsync(item);
    }

    // First-open auto-sync (fire-and-forget): notify only when something changed, to avoid noise.
    private async Task AutoSyncFromJiraAsync()
    {
        var (u, i) = await SyncFromJiraAsync();
        if (u > 0 || i > 0) Notifications.Info($"Jira sync: {u} updated, {i} imported.");
    }

    // Toolbar "Sync" button: pull the latest from the board on demand (e.g. to grab newly-created issues),
    // independent of the once-per-session auto-sync. Always reports the outcome.
    private bool _jiraSyncing;   // set/reset by SyncFromJiraAsync — drives the gear spinner AND the toolbar "Syncing tickets n/m…" chip for auto and manual sync alike
    private async Task ManualSyncFromJiraAsync()
    {
        if (_jiraSyncing) return;
        if (!Jira.LoadSettings().IsConfigured) { Notifications.Warning("Jira isn't configured — enter the connection first."); OpenJiraSettings(); return; }
        try
        {
            var (u, i) = await SyncFromJiraAsync();
            Notifications.Success(u == 0 && i == 0 ? "Already in sync with the Jira board." : $"Jira sync: {u} updated, {i} imported.");
        }
        catch (Exception ex) { Notifications.Error($"Jira sync failed: {ex.Message}"); }
    }

    // Map a Jira status name onto the local lane set (To Do / In Progress / Development Review /
    // Ready for Test / Done). Unknown statuses are kept verbatim.
    private static string MapJiraStatus(string? jira)
    {
        var s = (jira ?? "").Trim().ToLowerInvariant();
        if (s.Length == 0) return "To Do";
        if (s.Contains("adjust")) return "UI Adjustment";
        // Check "Development Review" BEFORE the "development"→In Progress and "review"→Ready for Test
        // folds below, because its name matches both.
        if (s.Contains("development review") || s.Contains("dev review")) return "Development Review";
        if (s.Contains("progress") || s.Contains("development") || s.Contains("doing")) return "In Progress";
        // The HHM board's stage is "Ready for Test" — the local lane now matches it verbatim (also fold RFR/RTF
        // and any legacy "Ready for Review").
        if (s.Contains("ready") || s.Contains("review") || s.Contains("test") || s is "rfr" or "rtf") return "Ready for Test";
        if (s.Contains("done") || s.Contains("closed") || s.Contains("resolved") || s.Contains("complete")) return "Done";
        if (s.Contains("to do") || s.Contains("todo") || s.Contains("open") || s.Contains("backlog") || s.Contains("new") || s.Contains("request") || s.Contains("select")) return "To Do";
        return jira!.Trim();
    }

    // Jira priority name → the local Low/Medium/High vocabulary. This Jira's scheme uses "Normal"
    // where the app says "Medium" (the write path maps Medium→Normal); fold it back on read.
    private static string MapJiraPriority(string? jira)
    {
        var s = (jira ?? "").Trim();
        return string.Equals(s, "Normal", StringComparison.OrdinalIgnoreCase) ? "Medium" : s;
    }

    // Reverse of MapJiraStatus for pushing a drag back to the board. The lanes now match the HHM board
    // verbatim ("Ready for Test"); kept only to fold any legacy "Ready for Review" value.
    private static string MapLocalStatusToJira(string? local)
    {
        var s = (local ?? "").Trim();
        if (string.Equals(s, "Ready for Review", StringComparison.OrdinalIgnoreCase)) return "Ready for Test";
        return s;
    }

    // Push a ticket's current Status to the main Jira board as a workflow transition (best-effort). Only
    // for tickets that exist on Jira (ExternalKey set) and only when a connection is configured.
    private async Task PushStatusToJiraAsync(FeedbackItem item)
    {
        if (string.IsNullOrWhiteSpace(item.ExternalKey)) return;   // native PM ticket — not on the board
        if (!Jira.LoadSettings().IsConfigured) return;
        try
        {
            var jiraStatus = MapLocalStatusToJira(item.Status);
            var (ok, msg) = await Jira.TransitionIssueAsync(item.ExternalKey, jiraStatus);
            if (ok) Notifications.Info($"{item.ExternalKey} → {jiraStatus} on Jira.");
            else Notifications.Warning($"{item.ExternalKey}: Jira status not updated — {msg}");
        }
        catch (Exception ex) { Notifications.Warning($"{item.ExternalKey}: Jira status not updated — {ex.Message}"); }
    }

    // ── Jira connection settings ──
    private bool _jiraSettingsOpen, _jiraTesting;
    private JiraSettings _jiraSettings = new();
    private string _jiraTestMsg = "";

    private void OpenJiraSettings()
    {
        _jiraSettings = Jira.LoadSettings();
        _jiraTestMsg = "";
