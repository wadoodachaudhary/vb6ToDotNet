    {
        _jiraTesting = true; _jiraTestMsg = ""; StateHasChanged();
        try { var (ok, msg) = await Jira.TestConnectionAsync(_jiraSettings); _jiraTestMsg = (ok ? "✓ " : "✗ ") + msg; }
        catch (Exception ex) { _jiraTestMsg = "✗ " + ex.Message; }
