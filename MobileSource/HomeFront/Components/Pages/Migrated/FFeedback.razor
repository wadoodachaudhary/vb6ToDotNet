    private async Task LoadFeedbackHistoryAsync()
    {
        allFeedbacks = await FeedbackService.GetAllFeedbackAsync();
        // Lane changes (to stay in sync with the Jira board): "Ready for Review" was renamed → "Ready for Test",
        // and the local-only "In Review" lane was removed. Fold any legacy stored value into "Ready for Test" so
        // those tickets still land in a valid lane (self-heals on next save/drag).
        foreach (var f in allFeedbacks)
            if (string.Equals(f.Status, "Ready for Review", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(f.Status, "In Review", StringComparison.OrdinalIgnoreCase))
                f.Status = "Ready for Test";
    }

