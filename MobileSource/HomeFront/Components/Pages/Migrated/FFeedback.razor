    /// <summary>
    /// A ticket was saved in ANOTHER pane (each MDI ticket tab is its own FFeedback
    /// instance). Refresh the BOARD instance's list so the lanes re-group — a Status
    /// change made in a ticket tab moves the card to its new lane the moment it is
    /// saved, instead of waiting for the next manual refresh or Jira sync.
    /// </summary>
    private void OnTicketChangedElsewhere(int ticketNumber)
    {
        if (IsTicketTabMode) return;   // only the board re-groups; the saving tab already reloaded
        _ = InvokeAsync(async () =>
        {
            await LoadFeedbackHistoryAsync();
            StateHasChanged();
        });
    }

    // ── MDI close-guard: prompt to save when closing the tab with an unsaved draft ──
    public async Task<bool> CanCloseMdiWindowAsync(MdiCloseContext context)
    {
        if (newFeedback == null) return true;

        var choice = await Dialogs.ConfirmCancelAsync(
            "You have an unsaved feedback ticket. Save your changes before closing?", "Feedback");

        if (choice == MessageBoxResult.Yes)
        {
            if (_view != FbView.Ticket) { await GoToTicketFormAsync(); }
            await SubmitFeedbackAsync();
            return newFeedback == null;
        }
        if (choice == MessageBoxResult.No) return true;
        return false;
    }

