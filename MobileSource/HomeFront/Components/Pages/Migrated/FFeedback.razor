    // Reporter rule: the CURRENT USER becomes the Reporter only when CREATING a ticket (and only in
    // place of a placeholder). An existing / imported ticket's reporter is never converted — the
    // sync's reporter logic (see SyncFromJiraAsync) follows the Jira board, not the local session.
    // Importing an issue whose Jira reporter is the API token's own account tells us
    // nothing about who filed it — the app pushed it. The push writes the truth into
    // the description footer ("Reported by: X"), so recover it from there; only fall
    // back to the token account when no footer exists.
    private static string ResolveImportReporter(string? jiraReporter, string tokenAccount, string? descriptionHtml)
    {
        var reporter = (jiraReporter ?? "").Trim();
        if (reporter.Length == 0) return "Jira";
        if (!string.Equals(reporter, tokenAccount, StringComparison.OrdinalIgnoreCase)) return reporter;
        var m = System.Text.RegularExpressions.Regex.Match(descriptionHtml ?? "",
            @"Reported by:\s*([^<\r\n]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var fromFooter = m.Success ? m.Groups[1].Value.Trim() : "";
        return fromFooter.Length > 0 ? fromFooter : reporter;
    }

