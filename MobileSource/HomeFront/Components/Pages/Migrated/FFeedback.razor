    private async Task OnOptionEnteredAsync(string listName, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        if (await FeedbackService.AddOptionAsync(listName, value.Trim()))
        {
            await LoadOptionListsAsync();
            StateHasChanged();
        }
    }

    // Labels is comma-separated, so persist each typed token to the "Labels" list (not the whole string).
    private async Task OnLabelsEnteredAsync(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        var changed = false;
        foreach (var token in SplitLabels(value))
            if (await FeedbackService.AddOptionAsync("Labels", token)) changed = true;
        if (changed)
        {
            await LoadOptionListsAsync();
            StateHasChanged();
        }
    }

