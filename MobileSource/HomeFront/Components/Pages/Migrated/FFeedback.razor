    // value to the option store and add it to the live list (without clobbering the board-sourced
    // names) so it survives — parity with the other editable dropdowns.
    private async Task OnSprintEnteredAsync(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        var v = value.Trim();
        await FeedbackService.AddOptionAsync("Sprint", v);
        if (!_sprints.Contains(v, StringComparer.OrdinalIgnoreCase))
        {
            _sprints = _sprints.Append(v).ToList();   // fresh ref so the dropdown re-renders
            StateHasChanged();
        }
