@namespace HomeFront.Components.Pages

@using Fx.ControlKit.Notifications

<DialogControl Visible="@IsVisible"
               Header="@FormCaption"
               Width="530px"
               IsModal="true"
               ShowCloseIcon="true"
               OnClose="OnCancelClick">
    <ChildContent>
        <div class="flist-body">
            <div class="flist-title">@Title</div>
            <TextAreaControl @bind-Value="ListText" CssClass="flist-textarea" />
        </div>
    </ChildContent>
    <FooterContent>
        <div class="flist-footer">
            <ButtonControl CssClass="fx-button-primary" OnClick="OnOkClick">OK</ButtonControl>
            <ButtonControl OnClick="OnCancelClick">Cancel</ButtonControl>
        </div>
    </FooterContent>
</DialogControl>

@code {
    /// <summary>
    /// Whether the dialog is currently visible.
    /// </summary>
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>
    /// Fired when the user clicks OK. The string payload is the edited list
    /// re-joined with the original delimiter.
    /// </summary>
    [Parameter] public EventCallback<string> OnChoose { get; set; }

    /// <summary>
    /// Fired when the user cancels.
    /// </summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    // ── Private state ────────────────────────────────────────────────
    private string FormCaption = "";
    private string Title = "";
    private string ListText = "";
    private string Delimiter = ",";
    private TaskCompletionSource<bool>? _tcs;

    /// <summary>
    /// Opens the dialog modally and returns true if the user clicked OK.
    /// The edited list is returned via the out-style <paramref name="list"/> reference
    /// through the <see cref="OnChoose"/> callback.
    /// </summary>
    /// <param name="formCaption">Caption shown in the dialog title bar.</param>
    /// <param name="title">Bold label above the text area.</param>
    /// <param name="list">Delimited list string to edit.</param>
    /// <param name="delimiter">Delimiter character(s). Defaults to comma.</param>
    /// <returns>True if the user confirmed; false if cancelled.</returns>
    public async Task<(bool Confirmed, string ResultList)> Choose(
        string formCaption,
        string title,
        string list,
        string delimiter = ",")
    {
        FormCaption = formCaption;
        Title = title;
        Delimiter = delimiter;

        // Convert delimited list to lines for editing
        ListText = (list ?? "").Replace(delimiter, "\n");

        IsVisible = true;
        await IsVisibleChanged.InvokeAsync(true);
        StateHasChanged();

        // Wait for user action
        _tcs = new TaskCompletionSource<bool>();
        var confirmed = await _tcs.Task;

        if (confirmed)
        {
            // Clean up duplicate blank lines
            var cleaned = ListText;
            for (var i = 0; i < 4; i++)
                cleaned = cleaned.Replace("\n\n", "\n");

            // Trim leading/trailing newlines
            cleaned = cleaned.Trim('\n', '\r');

            // Convert back to delimited string
            var result = cleaned
                .Replace("\r\n", delimiter)
                .Replace("\n", delimiter)
                .Replace("\r", delimiter);

            return (true, result);
        }

        return (false, list ?? "");
    }

    private async Task OnOkClick()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);

        // Clean up duplicate blank lines
        var cleaned = ListText;
        for (var i = 0; i < 4; i++)
            cleaned = cleaned.Replace("\n\n", "\n");
        cleaned = cleaned.Trim('\n', '\r');

        var result = cleaned
            .Replace("\r\n", Delimiter)
            .Replace("\n", Delimiter)
            .Replace("\r", Delimiter);

        await OnChoose.InvokeAsync(result);

        _tcs?.TrySetResult(true);
    }

    private async Task OnCancelClick()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();

        _tcs?.TrySetResult(false);
    }
}
