@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject ILogger<FEstimateItemsRefreshCosts> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer db

<DialogControl Visible="IsVisible" Header="Refresh Costs" Width="540px" IsModal="false" OnClose="OnCancel">
    <ChildContent>
        <div class="form-icon-row">
            <img src="images/32/refresh.ico" alt="Refresh" onerror="this.style.display='none'" />
            <div class="form-options">
                <div class="checkbox-row">
                    <CheckBoxControl @bind-Checked="RefreshOverridden" Label="Refresh costs on manually updated items." />
                </div>
                <div class="checkbox-row">
                    <CheckBoxControl @bind-Checked="ApplyVarianceCat" Label="Set the variance category on all changed items." />
                </div>
            </div>
        </div>

        @if (ApplyVarianceCat)
        {
            <div class="field-row">
                <label>Category:</label>
                <DropDownListControl TValue="string" TItem="ComboItem"
                                     @bind-Value="VarianceCat"
                                     DataSource="VarianceCategoryList"
                                     TextFieldName="Text"
                                     ValueFieldName="Value"
                                     Placeholder="-- Select --"
                                     Width="100%" />
            </div>
        }

        <div class="radio-row">
            <RadioControl TValue="bool" Name="costBasis" Value="true"
                          SelectedValue="UseCurrent"
                          SelectedValueChanged="@(v => SetCostBasis(true))"
                          Label="Refresh costs using current prices" />
        </div>

        @if (UseCurrent)
        {
            <div class="field-row field-row-indent">
                <label>Effective:</label>
                <div class="date-input-group">
                    <DatePickerControl Value="@EffectiveDate" ValueChanged="OnEffectiveDateChanged" />
                </div>
            </div>
        }

        <div class="radio-row">
            <RadioControl TValue="bool" Name="costBasis" Value="false"
                          SelectedValue="UseCurrent"
                          SelectedValueChanged="@(v => SetCostBasis(false))"
                          Label="Refresh costs using a forecast" />
        </div>

        <div class="forecast-list @(UseCurrent ? "disabled" : "")">
            @for (int i = 0; i < ForecastItems.Count; i++)
            {
                var idx = i;
                <div class="forecast-item @(SelectedForecastIndex == idx ? "selected" : "")"
                     @onclick="() => SelectForecast(idx)">
                    @ForecastItems[idx]
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="btn btn-primary" OnClick="OnOk">OK</ButtonControl>
        <ButtonControl CssClass="btn" OnClick="OnCancel">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    // === Parameters ===
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public string DivisionID { get; set; } = "1";
    [Parameter] public string InitialVarianceCat { get; set; } = "";
    [Parameter] public EventCallback<RefreshCostsResult> OnConfirmed { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    // === Database ===
// === State ===
    private bool RefreshOverridden = false;
    private bool ApplyVarianceCat = false;
    private string VarianceCat = "";
    private bool UseCurrent = true;
    private DateTime EffectiveDate = DateTime.Today;
    private int SelectedForecastIndex = -1;
    private List<string> ForecastItems = new();
    private List<ComboItem> VarianceCategoryList = new();

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        await LoadFormData();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            VarianceCat = InitialVarianceCat;
            await LoadFormData();
        }
    }

    private async Task LoadFormData()
    {
        try
        {
            EffectiveDate = DateTime.Today;

            // Load forecast descriptions
            ForecastItems.Clear();
            for (int i = 1; i <= 12; i++)
                ForecastItems.Add($"Forecast {i}");

            var forecastSql = @"
                SELECT MAX(Custom_Description) AS Desc, 0 AS Idx FROM CustomDescriptions WHERE Item='Forecast1' UNION ALL
                SELECT MAX(Custom_Description), 1 FROM CustomDescriptions WHERE Item='Forecast2' UNION ALL
                SELECT MAX(Custom_Description), 2 FROM CustomDescriptions WHERE Item='Forecast3' UNION ALL
                SELECT MAX(Custom_Description), 3 FROM CustomDescriptions WHERE Item='Forecast4' UNION ALL
                SELECT MAX(Custom_Description), 4 FROM CustomDescriptions WHERE Item='Forecast5' UNION ALL
                SELECT MAX(Custom_Description), 5 FROM CustomDescriptions WHERE Item='Forecast6' UNION ALL
                SELECT MAX(Custom_Description), 6 FROM CustomDescriptions WHERE Item='Forecast7' UNION ALL
                SELECT MAX(Custom_Description), 7 FROM CustomDescriptions WHERE Item='Forecast8' UNION ALL
                SELECT MAX(Custom_Description), 8 FROM CustomDescriptions WHERE Item='Forecast9' UNION ALL
                SELECT MAX(Custom_Description), 9 FROM CustomDescriptions WHERE Item='Forecast10' UNION ALL
                SELECT MAX(Custom_Description), 10 FROM CustomDescriptions WHERE Item='Forecast11' UNION ALL
                SELECT MAX(Custom_Description), 11 FROM CustomDescriptions WHERE Item='Forecast12'";

            var forecastRows = await db.QueryAsync(forecastSql);
            foreach (var row in forecastRows)
            {
                var idx = Convert.ToInt32(row["Idx"]);
                var desc = row["Desc"]?.ToString() ?? "";
                if (!string.IsNullOrWhiteSpace(desc) && idx >= 0 && idx < ForecastItems.Count)
                {
                    ForecastItems[idx] = desc;
                }
            }

            // Load variance categories
            var catSql = @"
                SELECT category + ' - ' + description AS DisplayText, category AS Value
                FROM standardcategories
                WHERE isvariance = 1 AND divisionid = @DivisionID
                ORDER BY description";
            var catRows = await db.QueryAsync(catSql, new { DivisionID });
            VarianceCategoryList = catRows.Select(r => new ComboItem
            {
                Text = r["DisplayText"]?.ToString() ?? "",
                Value = r["Value"]?.ToString() ?? ""
            }).ToList();

            // Load saved preferences
            // VB6 FEstimateItemsRefreshCosts.Form_Load: chk.value = IIf(HFApp.Options.ValueByName("X") = "True", checked, unchecked)
            // ValueByName falls back to AppOptions (division override wins): IN(0,@Div) ORDER BY divisionid DESC.
            try
            {
                var refreshOverriddenVal = await db.ExecuteScalarAsync<string>(
                    @"SELECT TOP 1 OptionValue FROM AppOptions
                      WHERE OptionName=@OptionName AND ISNULL(divisionid,0) IN (0, @DivisionID)
                      ORDER BY divisionid DESC",
                    new { OptionName = "RefreshOverridden", DivisionID });
                RefreshOverridden = string.Equals(refreshOverriddenVal, "True", StringComparison.OrdinalIgnoreCase);
            }
            catch { RefreshOverridden = false; }

            try
            {
                var applyVarCatVal = await db.ExecuteScalarAsync<string>(
                    @"SELECT TOP 1 OptionValue FROM AppOptions
                      WHERE OptionName=@OptionName AND ISNULL(divisionid,0) IN (0, @DivisionID)
                      ORDER BY divisionid DESC",
                    new { OptionName = "ApplyVarianceCategory", DivisionID });
                ApplyVarianceCat = string.Equals(applyVarCatVal, "True", StringComparison.OrdinalIgnoreCase);
            }
            catch { ApplyVarianceCat = false; }

            // Set initial variance cat selection
            if (!string.IsNullOrEmpty(InitialVarianceCat))
                VarianceCat = InitialVarianceCat;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

        }
    }

    // === UI Handlers ===
    // VB6 date field → FlexKit DatePickerControl (binds DateTime?). EffectiveDate is a
    // non-null DateTime; keep the prior value when the picker is cleared (value == null),
    // mirroring @bind which leaves the bound DateTime unchanged.
    private void OnEffectiveDateChanged(DateTime? value)
    {
        if (value.HasValue)
            EffectiveDate = value.Value;
    }

    private void SetCostBasis(bool useCurrent)
    {
        UseCurrent = useCurrent;
        if (!UseCurrent && SelectedForecastIndex < 0 && ForecastItems.Count > 0)
            SelectedForecastIndex = 0;
    }

    private void SelectForecast(int index)
    {
        if (!UseCurrent)
            SelectedForecastIndex = index;
    }

    private async Task OnOk()
    {
        // Validation
        if (UseCurrent && EffectiveDate == default)
        {
            Notifications.Info("You must specify an effective date");
            return;
        }

        if (!UseCurrent && SelectedForecastIndex < 0)
        {
            Notifications.Warning("You must select a forecast");
            return;
        }

        // VB6 Form_Unload saves preferences
        await SavePreferences();

        var result = new RefreshCostsResult
        {
            CostBasis = UseCurrent ? CostBasisTypes.Current : (CostBasisTypes)((int)CostBasisTypes.Forecast1 + SelectedForecastIndex),
            EffectiveDate = UseCurrent ? EffectiveDate : default,
            ApplyVarianceCat = ApplyVarianceCat,
            VarianceCat = VarianceCat,
            RefreshOverridden = RefreshOverridden
        };

        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnConfirmed.InvokeAsync(result);
    }

    private async Task OnCancel()
    {
        // VB6 Form_Unload saves preferences on close
        await SavePreferences();

        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnCancelled.InvokeAsync();
    }

    // === Save Preferences (VB6 Form_Unload) ===
    private async Task SavePreferences()
    {
        // VB6 FEstimateItemsRefreshCosts.Form_Unload:
        //   HFApp.Options.ValueByName("ApplyVarianceCategory") = chkSetVarianceCat.value = vbChecked
        //   HFApp.Options.ValueByName("RefreshOverridden")      = chkRefreshOverridden.value = vbChecked
        // Neither is in OptionsEnum, so SetValueByName writes the DIVISION-SPECIFIC AppOptions row
        // (UID='', DivisionID=@Div). VB6 stores the VB boolean as "True"/"False" — bool.ToString() matches.
        await SaveOptionAsync("ApplyVarianceCategory", ApplyVarianceCat.ToString());
        await SaveOptionAsync("RefreshOverridden", RefreshOverridden.ToString());
    }

    private async Task SaveOptionAsync(string name, string value)
    {
        try
        {
            await db.ExecuteAsync(@"
                UPDATE AppOptions
                   SET OptionValue=@Value, UStmp=@UID, TStmp=GETDATE()
                 WHERE OptionName=@Name AND ISNULL(UID,'')='' AND ISNULL(divisionid,0)=@DivisionID;
                IF @@ROWCOUNT=0
                    INSERT INTO AppOptions(UID, OptionName, OptionValue, DivisionID, UStmp, TStmp)
                    VALUES('', @Name, @Value, @DivisionID, @UID, GETDATE());",
                new { Name = name, Value = value, DivisionID, UID = "" });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

        }
    }

    // === Enums & Models ===
    public enum CostBasisTypes
    {
        Current = 0,
        Forecast1 = 1,
        Forecast2 = 2,
        Forecast3 = 3,
        Forecast4 = 4,
        Forecast5 = 5,
        Forecast6 = 6,
        Forecast7 = 7,
        Forecast8 = 8,
        Forecast9 = 9,
        Forecast10 = 10,
        Forecast11 = 11,
        Forecast12 = 12
    }

    public class RefreshCostsResult
    {
        public CostBasisTypes CostBasis { get; set; }
        public DateTime EffectiveDate { get; set; }
        public bool ApplyVarianceCat { get; set; }
        public string VarianceCat { get; set; } = "";
        public bool RefreshOverridden { get; set; }
    }

    public class ComboItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }
}
