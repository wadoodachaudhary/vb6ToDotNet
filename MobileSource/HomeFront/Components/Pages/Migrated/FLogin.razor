@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - Added six per-circuit security hardening toggles on welcome screen (Step 0)
     - Implemented compact PBKDF2 password hashing in existing User_Password column (no schema change)
     - Added per-circuit IsAuthenticated flag set on successful login (opt 5)
     - Optional TLS hardening of DB connection string via SqlConnectionStringBuilder (opt 6)
     - Gated debug Console.WriteLine of plaintext / encrypted / decrypted password (opt 7)
   ───────────────────────────────────────────────────────────────── *@
@namespace HomeFront.Components.Pages
@page "/"
@page "/login"
@attribute [Fx.ControlKit.HideSourceTabs]
@using System.Reflection
@using System.Security.Cryptography
@using System.Text
@using Microsoft.Extensions.Caching.Memory
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using HomeFront.Data
@using Microsoft.Data.SqlClient
@using HomeFront.Auth.Cognito
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FLogin> Logger
@inject NotificationService Notifications
@* Security hardening toggles + per-circuit session state — see
   memory/homefrontpoc_security_hardening.md for the toggle catalog.
   Opt 4 (UseStrongPasswordHashing) stores ASP.NET Identity V3 hashes
   (PBKDF2-HMAC-SHA256, ~84 chars base64) INSIDE the existing
   User_Password column, marked with a "$h$" prefix to distinguish them
   from legacy XOR ciphertext. NO schema change — the User_Password2
   column from an earlier design no longer exists in the upgraded DB. *@
@inject HomeFront.Services.ISecurityOptionsService Sec
@inject HomeFront.Services.ISessionStateService Session
@inject Microsoft.AspNetCore.Identity.IPasswordHasher<string> Hasher
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache SigninCache
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject HomeFront.Services.DbUpgradeService UpgradeService
@inject HomeFront.Auth.Cognito.ICognitoAuthService CognitoAuth
@layout HFComponent
<PageTitle>Login</PageTitle>

<div class="f-login" tabindex="0" @onkeydown="HandleKeyDown">
    @* Top row: Logo + App info *@
    <div class="f-login-header">
        <div class="logo-area">
            <img src="images/HF_Logo.png" alt="HomeFront Software" class="fx-logo" />
        </div>
        <div class="app-info">
            <div class="app-title">Precision Builder</div>
            <div class="app-version">@AppVersion</div>
            <div class="app-copyright">@Copyright</div>
            <ButtonControl BareStyle="true" CssClass="link-button" OnClick="ShowAbout">About Homefront</ButtonControl>
        </div>
    </div>

    @* Middle row: License info (left) + Login fields (right) *@
    <div class="f-login-body">
        <div class="license-panel">
            <div class="license-caption">This software is licensed to:</div>
            <div class="license-company">@LicensedTo</div>
            <div class="license-info">@LicenseInfo</div>
        </div>

        <div class="login-panel">
            @if (ShowConnections)
            {
                <div class="panel-title">Select Connection</div>
                <ListBoxControl TItem="ConnectionItem"
                           DataSource="@Connections"
                           TextField="Name"
                           ValueField="Name"
                           SelectionMode="ListBoxSelectionMode.Single"
                           ShowCheckbox="false"
                           @bind-Value="SelectedConnections" />

                @* Security hardening toggles — dev/POC only. Hidden when
                   appsettings has Security:HideDevPanel=true (production
                   mode); in that case every toggle is force-locked ON by
                   the SecurityOptionsService constructor and there's
                   nothing for the user to flip. See
                   memory/homefrontpoc_security_hardening.md. *@
                @if (!Sec.IsLocked)
                {
                    <div class="security-panel">
                        <div class="security-panel-header">
                            <span class="panel-title">Security Options (Dev)</span>
                            <span class="security-hint">
                                Leave all unchecked to run with today's behavior.
                                Check any combination to harden the session.
                            </span>
                        </div>

                        <div class="security-actions">
                            <ButtonControl BareStyle="true" CssClass="link-button"
                                           OnClick="OnSelectAllSecurity">Select All</ButtonControl>
                            <span class="dot">·</span>
                            <ButtonControl BareStyle="true" CssClass="link-button"
                                           OnClick="OnDeselectAllSecurity">Deselect All</ButtonControl>
                        </div>

                        @* HHM-620: greyed out — conflicts with the legacy app login
                           (both apps share the Users table, and legacy can't verify
                           PBKDF2 hashes). Stays OFF; Select All skips it too. *@
                        <div class="security-row security-row--disabled">
                            <CheckBoxControl @bind-Checked="Sec.UseStrongPasswordHashing" Disabled="true" />
                            <div>
                                <strong>Use strong password hashing (PBKDF2)</strong>
                                <div class="security-detail">Stores new passwords as
                                    PBKDF2-HMAC-SHA256 (10 000 iterations, per-user salt)
                                    in the existing <code>User_Password</code> column
                                    using a 43-char <code>$h$...</code> format. Legacy
                                    verify under the old code path
                                    and silently migrate to the new format on next
                                    successful login -- or one time migration required at the backend.</div>
                            </div>
                        </div>

                        <div class="security-row">
                            <CheckBoxControl @bind-Checked="Sec.EnforceAuth" />
                            <div>
                                <strong>Enforce authenticated session</strong>
                                <div class="security-detail">Redirects to
                                    <code>/login</code> when the user has not
                                    completed the login flow this circuit.</div>
                            </div>
                        </div>

                        <div class="security-row">
                            <CheckBoxControl @bind-Checked="Sec.EncryptDbConnection" />
                            <div>
                                <strong>Encrypt DB connection (TLS)</strong>
                                <div class="security-detail">Rewrites the SQL Server
                                    connection string with
                                    <code>Encrypt=true; TrustServerCertificate=false</code>.
                                    Requires a trusted cert on the DB server — leave
                                    unchecked on dev machines without one.</div>
                            </div>
                        </div>

                        @* NOTE: "No plaintext password logging" and
                           "Disable CHEAT backdoor" toggles were intentionally
                           removed from the welcome panel — the underlying
                           Sec.NoPasswordLogging / Sec.DisableCheatBackdoor
                           flags remain so other paths that read them still
                           compile and behave per their defaults. *@

                        <div class="security-row">
                            <CheckBoxControl @bind-Checked="Sec.EnforcePasswordCheck" />
                            <div>
                                <strong>Enforce password check</strong>
                                <div class="security-detail">Restores the
                                    Password clause in the login SQL.</div>
                            </div>
                        </div>

                        <div class="security-row security-row--dev-tool">
                            <CheckBoxControl @bind-Checked="Sec.GetPasswordFromSystemSecrets" />
                            <div>
                                <strong>Get DB Password from System Secrets</strong>
                                <div class="security-detail">When <strong>checked</strong>,
                                    the SA password comes from user-secrets (dev) or the
                                    <code>Database__Password</code> env var (prod). When
                                    <strong>unchecked</strong>, the password is read from
                                    <code>Database:DevPassword</code> in
                                    <code>appsettings.json</code>. Has no effect when the
                                    connection string uses
                                    <code>Integrated Security=True</code>.</div>
                            </div>
                        </div>
                    </div>
                }
            }

            @if (ShowUserPanel)
            {
                <div class="form-row">
                    <label>User ID</label>
                    <TextBoxControl @bind-Value="UserId" Placeholder="User ID" CssClass="login-input" UpdateOnInput="true" />
                </div>
                <div class="form-row">
                    <label>Password</label>
                    <TextBoxControl @bind-Value="Password" Placeholder="Password" InputType="password" CssClass="login-input" UpdateOnInput="true" Uncontrolled="true" />
                </div>

                <div class="change-password-row">
                    <ButtonControl BareStyle="true" CssClass="link-button" OnClick="ToggleChangePassword">Change Password</ButtonControl>
                </div>

                @if (ShowChangePassword)
                {
                    <div class="form-row">
                        <label>New Password</label>
                        <TextBoxControl @bind-Value="NewPassword" Placeholder="New Password" InputType="password" CssClass="login-input" />
                    </div>
                    <div class="form-row">
                        <label>Confirm Password</label>
                        <TextBoxControl @bind-Value="ConfirmPassword" Placeholder="Confirm Password" InputType="password" CssClass="login-input" />
                    </div>
                }
            }

            @if (ShowDivisions)
            {
                <div class="panel-title">Select Division</div>
                <ListBoxControl TItem="DivisionItem"
                           DataSource="@Divisions"
                           TextField="Display"
                           ValueField="DivisionID"
                           SelectionMode="ListBoxSelectionMode.Single"
                           ShowCheckbox="false"
                           @bind-Value="SelectedDivisions" />
            }

            @if (ShowCheat)
            {
                <div class="form-row">
                    <label>Cheat</label>
                    <TextBoxControl @bind-Value="CheatCode" Placeholder="CHEAT" CssClass="login-input" />
                </div>
            }
        </div>
    </div>

    @* Footer: Status + OK/Cancel *@
    <div class="f-login-footer">
        <div class="status-message">@StatusMessage</div>
        <div class="button-row">
            @* HHM-620: the Cognito login button was removed from the login screen
               (no Cognito mention in the web app); HandleCognitoLoginAsync and the
               /cognito admin page remain for the back-office flow. *@
            <ButtonControl CssClass="btn-ok" Disabled="@(!CanOk)" OnClick="HandleOk">OK</ButtonControl>
            <ButtonControl CssClass="btn-cancel" OnClick="HandleCancel">Cancel</ButtonControl>
        </div>
    </div>
</div>

@* Modal alert (VB6 MsgBox) — declared once, used by AlertAsync *@
<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_msgBox" />

@code {
    private Fx.ControlKit.Dialogs.MessageBoxControl? _msgBox;
    private static string DefaultConnectionString => DbWrapperSqlServer.DefaultConnectionString;

    private bool mLicensed = true;
    private int Step;
    private bool mChangePswd;
    private bool debug_mode = false;

    private readonly List<ConnectionItem> Connections = new();
    private readonly List<DivisionItem> Divisions = new();
    private List<string> SelectedConnections = new();
    private List<string> SelectedDivisions = new();

    private DbWrapperSqlServer? _db;

    private string UserId = "";
    private string Password = "";
    private bool _isCognito = false;
    private string? _cognitoIdToken = null;
    private string NewPassword = "";
    private string ConfirmPassword = "";

    private bool ShowCheat;
    private string CheatCode = "";
    private string StatusMessage = "";

    private string LicensedTo = "Company Name";
    private string LicenseInfo = "License information.";
    private string AppName = "HomeFront";
    private string AppVersion = $"Version {Assembly.GetEntryAssembly()?.GetName().Version}";
    private string Copyright = $"{DateTime.Now.Year} \u00A9 Copyright Hyphen Solutions";

    [Parameter] public EventCallback<LoginResult> OnLoggedIn { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private bool ShowConnections => Step == 0;
    private bool ShowUserPanel => Step == 1;
    private bool ShowDivisions => Step == 2;
    private bool ShowChangePassword => mChangePswd;

    private bool CanOk =>
        mLicensed && ((Step == 0 && SelectedConnections.Any()) || (Step == 1) || (Step == 2 && SelectedDivisions.Any()));

    private string SelectedConnectionName => SelectedConnections.FirstOrDefault() ?? "";
    private string SelectedDivisionId => SelectedDivisions.FirstOrDefault() ?? "";
    // Review opt 3 — when DisableCheatBackdoor is ON, IsCheat is forced
    // to false regardless of what the user typed. Today's behavior is
    // preserved when the toggle is OFF (anything containing "CHEAT" in
    // the right field bypasses the password check below).
    private bool IsCheat =>
        !Sec.DisableCheatBackdoor
        && ShowCheat
        && string.Equals(CheatCode, "CHEAT", StringComparison.OrdinalIgnoreCase);

    // Wired to the Select All / Deselect All link-buttons on the
    // welcome-screen security panel. Both are no-ops in production
    // mode (Sec.IsLocked=true → setters silently no-op).
    private void OnSelectAllSecurity() => Sec.SelectAll();
    private void OnDeselectAllSecurity() => Sec.DeselectAll();

    protected override async Task OnInitializedAsync()
    {
        LoadLicense();
        await SetStepAsync(0);
    }

    private void LoadLicense()
    {
        mLicensed = true;
    }

    private async Task SetStepAsync(int value)
    {
        switch (value)
        {
            case -1:
                StatusMessage = "";
                if (OnCancelled.HasDelegate)
                    await OnCancelled.InvokeAsync();
                break;
            case 0:
                if (Connections.Count == 0)
                    await LoadConnectionsAsync();
                Step = 0;
                mChangePswd = false;
                _isCognito = false;
                _cognitoIdToken = null;
                EnsureConnectionSelection();
                break;
            case 1:
                if (await DoOpenDbAsync())
                {
                    Step = 1;
                }
                break;
            case 2:
                mChangePswd = ShowChangePassword;
                await LoadDivisionsAsync();
                if (Divisions.Count == 0)
                {
                    StatusMessage = "No divisions available.";
                    break;
                }

                if (Divisions.Count == 1)
                {
                    SelectedDivisions = new List<string> { Divisions[0].DivisionID };
                    await SetStepAsync(3);
                    return;
                }

                Step = 2;
                EnsureDivisionSelection();
                break;
            case 3:
                await DoLoginAsync();
                break;
            default:
                Step = value;
                break;
        }

        StateHasChanged();
    }

    private void EnsureConnectionSelection()
    {
        if (SelectedConnections.Count == 0 && Connections.Count > 0)
            SelectedConnections = new List<string> { Connections[0].Name };
    }

    private void EnsureDivisionSelection()
    {
        if (SelectedDivisions.Count == 0 && Divisions.Count > 0)
            SelectedDivisions = new List<string> { Divisions[0].DivisionID };
    }

    private async Task LoadConnectionsAsync()
    {
        Connections.Clear();
        Connections.Add(new ConnectionItem
        {
            Name = "Default",
            ConnectionString = DefaultConnectionString
        });

        await Task.CompletedTask;
    }

    private async Task LoadDivisionsAsync()
    {
        Divisions.Clear();
        if (_db == null) return;

        try
        {
            var rows = await _db.QueryAsync("SELECT DivisionID, DivisionCode, DivisionName FROM Divisions");
            foreach (var row in rows)
            {
                Divisions.Add(new DivisionItem
                {
                    DivisionID = row["DivisionID"]?.ToString() ?? "",
                    DivisionCode = row["DivisionCode"]?.ToString() ?? "",
                    DivisionName = row["DivisionName"]?.ToString() ?? ""
                });
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error loading divisions: {ex.Message}";
        }
    }

    private async Task<bool> DoOpenDbAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedConnectionName))
        {
            StatusMessage = "Select a connection.";
            return false;
        }

        var connection = Connections.FirstOrDefault(c => c.Name == SelectedConnectionName);
        if (connection == null)
        {
            StatusMessage = "Invalid connection selection.";
            return false;
        }

        try
        {
            // Compose the runtime connection string in two layers:
            //
            //   (a) GetPasswordFromSystemSecrets. Default ON = use the
            //       pre-composed connection string (password already
            //       sourced from user-secrets / env var at startup).
            //       When OFF, swap the password for whatever's in
            //       appsettings.json's Database:DevPassword key — an
            //       in-house dev convenience so a team can share one
            //       committed config without each dev provisioning
            //       user-secrets. Locked ON in production.
            //
            //   (b) Review opt 6 — EncryptDbConnection. When ON, flip
            //       Encrypt=true / TrustServerCertificate=false. Driver
            //       then refuses connections whose TLS cert isn't trusted
            //       by the OS root store; a dev machine without a real
            //       cert will fail here intentionally.
            //
            // Order matters: password swap first, then TLS hardening, so
            // the final string carries both effects.
            var baseConnStr = connection.ConnectionString;
            // Integrated Security path: connection string says
            // `Integrated Security=True` (no User Id / Password) — app
            // authenticates as the Windows identity it runs under. No
            // password to inject from any source; the toggle is a no-op
            // here. Skip both the DevPassword swap AND the system-secret
            // requirement check.
            var probe = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(baseConnStr);
            if (!probe.IntegratedSecurity && !Sec.GetPasswordFromSystemSecrets)
            {
                var devPwd = Configuration["Database:DevPassword"];
                if (string.IsNullOrEmpty(devPwd))
                {
                    StatusMessage = "Database:DevPassword not set in appsettings.json. " +
                        "Add \"Database\":{\"DevPassword\":\"...\"} and reload, or " +
                        "check 'Get DB Password from System Secrets' to use " +
                        "user-secrets / Database__Password env var instead. " +
                        "(If your connection string uses Integrated Security=True, " +
                        "no password is needed and this toggle has no effect.)";
                    return false;
                }
                baseConnStr = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(baseConnStr)
                {
                    Password = devPwd
                }.ConnectionString;
            }
            var connStr = Sec.EncryptDbConnection
                ? HardenConnectionString(baseConnStr)
                : baseConnStr;

            _db = new DbWrapperSqlServer(connStr);
            await _db.ExecuteScalarAsync<int>("SELECT 1");
            StatusMessage = "";
            return true;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Unable to open the database: {ex.Message}";
            return false;
        }
    }

    private async Task DoLoginAsync()
    {
        if (_db == null) return;

        if (string.IsNullOrWhiteSpace(UserId))
        {
            StatusMessage = "Enter a user ID.";
            return;
        }

        // TODO: Password validation bypassed for development — restore before release
        // if (string.IsNullOrWhiteSpace(Password) && !IsCheat)
        // {
        //     StatusMessage = "Enter a password.";
        //     return;
        // }

        StatusMessage = "Validating user...";
        StateHasChanged();

        try
        {
            // VB6: sPswd = hff.MyCrypt(sPswd, "Fazlul")
            var encryptedPswd = MyCrypt(Password, "Fazlul");
            var decryptedPswd = MyDeCrypt(encryptedPswd, "Fazlul");

            // Review opt 7 — when NoPasswordLogging is ON, suppress the
            // three debug Console.WriteLines that print the keyed-in,
            // encrypted, and decrypted password to the Serilog file sink.
            // When OFF, today's debug-print behavior is preserved.
            if (debug_mode && !Sec.NoPasswordLogging)
            {
                Console.WriteLine($"[FLogin] OK clicked — Keyed-in password: \"{Password}\"");
                Console.WriteLine($"[FLogin] Encrypted password : \"{encryptedPswd}\"");
                Console.WriteLine($"[FLogin] Decrypted password : \"{decryptedPswd}\"");
            }

            // Review opt 2 — restore the password check.
            //
            // Toggle matrix:
            //   PwCheck=OFF   → today's behavior: SELECT returns row
            //                   for any UserId that exists. Empty
            //                   password logs in.
            //   PwCheck=ON    → fetch the row by UserId alone, then
            //                   verify against legacy XOR ciphertext
            //                   in C#. Per-user-decision rather than
            //                   collation-sensitive SQL compare.
            //   IsCheat=true  → password clause skipped (the dev
            //                   backdoor — also gated by
            //                   DisableCheatBackdoor).
            //
            // NOTE on opt 4 (UseStrongPasswordHashing): everything lives in
            // the single User_Password column (varchar(500)). A value with
            // the "$h$" prefix is an ASP.NET Identity V3 hash (the prefix is
            // stripped before verify); anything else is legacy VB6 XOR
            // ciphertext. On a successful legacy-path login with opt 4 ON,
            // the row is auto-migrated in place to "$h$<V3 hash>". The
            // User_Password2 column from an earlier design DOES NOT EXIST
            // in the upgraded database — do not reference it in SQL.
            var sql = new StringBuilder();
            sql.AppendLine("SELECT u.user_access, u.User_Password");
            sql.AppendLine("FROM User_Manager u");
            sql.AppendLine("JOIN DivisionUsers d ON u.User_ID = d.UserID AND d.DivisionID = @DivisionId");
            sql.AppendLine("WHERE u.User_ID = @UserId");

            var rows = await _db.QueryAsync(sql.ToString(),
                new { UserId, DivisionId = int.TryParse(SelectedDivisionId, out var divIdInt) ? divIdInt : 0 });

            if (!rows.Any())
            {
                await AlertAsync(IsCheat
                    ? $"Login \"{UserId}\" does not exist."
                    : "Access denied.\nInvalid login or password.");
                StatusMessage = "";
                return;
            }

            // Password verification gate. Skipped entirely when opt 2
            // is OFF (today's "no password" behavior) and when IsCheat
            // is true (the dev backdoor — also gated by
            // DisableCheatBackdoor).
            //
            // With opt 4 ON: "$h$"-prefixed User_Password → V3 verify.
            // Empty User_Password → typed password is hashed and stored
            // (first-time provision, login succeeds). Legacy XOR value →
            // XOR compare; success auto-migrates the column to "$h$<hash>",
            // failure rejects.
            //
            // With opt 4 OFF: legacy XOR compare against User_Password
            // (today's / VB6 behavior).
            if (Sec.EnforcePasswordCheck && !IsCheat && !_isCognito)
            {
                var (ok, verifyErr) = await VerifyOrProvisionPasswordAsync(rows.First(), encryptedPswd);
                if (!ok)
                {
                    await AlertAsync(verifyErr ?? "Access denied.\nInvalid login or password.");
                    StatusMessage = "";
                    return;
                }
            }

            // VB6: update password if needed
            if (mChangePswd)
            {
                if (NewPassword != ConfirmPassword)
                {
                    await AlertAsync("Unable to change password.\n\nYour new passwords don't match.");
                    return;
                }

                if (string.IsNullOrEmpty(NewPassword))
                {
                    var confirmed = await Dialogs.ConfirmAsync(
                        "Are you sure you want to set your password to nothing?");
                    if (!confirmed) return;
                }

                // Opt 4 — when UseStrongPasswordHashing is ON, store the
                // new password as "$h$" + ASP.NET Identity V3 hash INSIDE
                // the existing User_Password column (no schema change;
                // User_Password2 no longer exists). When OFF, preserve
                // today's legacy XOR storage in User_Password.
                //
                // VB6: sPswd = hff.MyCrypt(txtNewPWD.Text, "Fazlul")
                if (Sec.UseStrongPasswordHashing)
                {
                    var v3Hash = HashedPwPrefix + Hasher.HashPassword(UserId, NewPassword ?? "");
                    await _db.ExecuteAsync(
                        "UPDATE User_Manager SET User_Password=@NewPswd WHERE User_ID=@UserId",
                        new { NewPswd = v3Hash, UserId });
                }
                else
                {
                    var encryptedNewPswd = MyCrypt(NewPassword, "Fazlul");
                    // VB6: UPDATE User_Manager SET User_Password='{enc}' WHERE User_Id='{user}'
                    await _db.ExecuteAsync(
                        "UPDATE User_Manager SET User_Password=@NewPswd WHERE User_ID=@UserId",
                        new { NewPswd = encryptedNewPswd, UserId });
                }

                // VB6: UPDATE tblProjectManager set password='{plain}' WHERE PM='{user}'
                await _db.ExecuteAsync(
                    "UPDATE tblProjectManager SET password=@PlainPswd WHERE PM=@UserId",
                    new { PlainPswd = NewPassword, UserId });

                await AlertAsync("Your password has been changed.");
                Password = NewPassword;
                NewPassword = "";
                ConfirmPassword = "";
                mChangePswd = false;
            }

             StatusMessage = "Login successful.";

            // Check if database needs an upgrade before completing login
            try
            {
                var currentRev = await UpgradeService.GetCurrentRevisionAsync();
                var ops = UpgradeService.LoadOperations();
                var maxRev = 13447 + ops.Count;
                if (currentRev < maxRev)
                {
                    StatusMessage = "Database upgrade required. Redirecting to upgrade console...";
                    StateHasChanged();
                    await Task.Delay(1500);
                    NavigationManager.NavigateTo($"/dbupgrade?returnUrl=/login&autoRun=true");
                    return;
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to verify database upgrade status during login.");
            }

            // Review opt 5 — record that this circuit has completed the
            // login flow. FMain.OnInitialized reads this against
            // Sec.EnforceAuth to gate access. Set unconditionally (cheap)
            // — when EnforceAuth is OFF, FMain ignores the flag and
            // today's "anyone with a URL" behavior is preserved.
            Session.IsAuthenticated = true;
            Session.LoginID = UserId;
            if (int.TryParse(SelectedDivisionId, out var divId))
                Session.DivisionID = divId;

            if (OnLoggedIn.HasDelegate)
                await OnLoggedIn.InvokeAsync(new LoginResult(UserId, SelectedDivisionId, SelectedConnectionName));

            // Issue a one-time signin token and redirect THROUGH /auth/signin
            // (forceLoad: true is required — Blazor's in-circuit NavigateTo
            // can't set HTTP cookies). The endpoint redeems the token, calls
            // HttpContext.SignInAsync to set the auth cookie, then redirects
            // to /main. Cookie survives across tabs and refresh, unlike the
            // legacy per-circuit Session.IsAuthenticated flag. See
            // memory/opt5_cookie_auth.md.
            var signinToken = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32))
                .Replace("/", "_").Replace("+", "-").TrimEnd('=');
            var divisionIdInt = int.TryParse(SelectedDivisionId, out var divInt) ? divInt : 0;
            var connItem = Connections.FirstOrDefault(c => c.Name == SelectedConnectionName);
            var dbName = connItem != null ? new SqlConnectionStringBuilder(connItem.ConnectionString).InitialCatalog : "";
            SigninCache.Set(
                $"auth:signin:{signinToken}",
                (UserId: UserId, DivisionId: divisionIdInt, CognitoIdToken: _isCognito ? _cognitoIdToken : null, DatabaseName: dbName),
                TimeSpan.FromSeconds(30));
            NavigationManager.NavigateTo(
                $"/auth/signin?token={signinToken}",
                forceLoad: true,
                replace: true);
        }
        catch (Exception ex)
        {
            await AlertAsync($"Error during login: {ex.Message}");
            StatusMessage = "";
        }
    }

    private async Task HandleOk()
    {
        if (Step == 0 && _isCognito)
        {
            if (await DoOpenDbAsync())
            {
                await SetStepAsync(2); // Go to select division
            }
            return;
        }
        await SetStepAsync(Step + 1);
    }

    private async Task HandleCancel()
    {
        if (Step == 1 && mChangePswd)
        {
            mChangePswd = false;
            NewPassword = "";
            ConfirmPassword = "";
            StateHasChanged();
            return;
        }
        await SetStepAsync(Step - 1);
    }

    private void ToggleChangePassword()
    {
        mChangePswd = !mChangePswd;
        if (!mChangePswd)
        {
            NewPassword = "";
            ConfirmPassword = "";
        }
    }

    private async Task ShowAbout()
    {
        await AlertAsync($"{AppName}\n{AppVersion}\n{Copyright}");
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key?.Equals("z", StringComparison.OrdinalIgnoreCase) == true && e.CtrlKey && e.ShiftKey)
        {
            ShowCheat = true;
            CheatCode = "";
            StateHasChanged();
        }
    }

    // VB6 MsgBox parity: a MODAL alert the user must dismiss. The previous
    // Notifications toast auto-dismissed, so login failures flashed by
    // unread ("the message disappears quickly").
    private async Task AlertAsync(string message)
    {
        if (_msgBox != null)
            await _msgBox.ShowAsync(message, title: "Precision Builder");
        else
            Notifications.Error(message);
    }

    // ── Security hardening helpers ────────────────────────────────────────
    // These back the toggles on the welcome-screen security panel.
    // Each method is a no-op (or no-effect) when its toggle is OFF, so
    // existing dev behavior is fully preserved when nothing is checked.
    // See memory/homefrontpoc_security_hardening.md for the toggle catalog.

    /// <summary>Opt 6 — rewrite a SQL Server connection string to add
    /// <c>Encrypt=true; TrustServerCertificate=false</c>. Uses
    /// SqlConnectionStringBuilder so existing keys are preserved and
    /// duplicate keys can't be smuggled in via the original string.</summary>
    private static string HardenConnectionString(string original)
    {
        try
        {
            var b = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(original)
            {
                Encrypt = true,
                TrustServerCertificate = false
            };
            return b.ConnectionString;
        }
        catch
        {
            // If the connection string can't be parsed, leave it alone.
            // DoOpenDbAsync's catch will surface the connection failure
            // with a meaningful message.
            return original;
        }
    }

    // ── Opt 4 — ASP.NET Identity V3 hash stored IN User_Password ──
    //
    // Single column, no schema change. User_Manager.User_Password
    // (varchar(500)) holds either:
    //   • legacy VB6 XOR ciphertext (MyCrypt(typed, "Fazlul")), or
    //   • "$h$" + Microsoft.AspNetCore.Identity.PasswordHasher V3 output
    //     (PBKDF2-HMAC-SHA256, 100 000 iterations, 16-byte salt, 32-byte
    //     key; base64 starting "AQAAAAIA…"). The "$h$" marker is how the
    //     verifier tells the two formats apart — XOR ciphertext is hex
    //     pairs and can never start with "$".
    //
    // Opt 4 ON: "$h$" value → V3 verify. Empty → first-time provision
    //   (hash the typed password and store it — SECURITY CONSIDERATION:
    //   whoever reaches the login screen for an un-provisioned user
    //   claims that account; intended for controlled migration only).
    //   Legacy XOR value → XOR verify, then auto-migrate the row to
    //   "$h$<hash>" in place (failed compares never overwrite).
    // Opt 4 OFF: legacy XOR compare, exactly VB6's behavior.
    //
    // The User_Password2 column from an earlier design was dropped by
    // the DB upgrade and must not be referenced anywhere.

    /// <summary>Marks a User_Password value as an ASP.NET Identity V3 hash
    /// (vs legacy VB6 XOR ciphertext, which never starts with this).</summary>
    private const string HashedPwPrefix = "$h$";

    private async Task<(bool ok, string? error)> VerifyOrProvisionPasswordAsync(
        IDictionary<string, object> row,
        string encryptedXor)
    {
        // SINGLE-COLUMN scheme: User_Password holds either legacy XOR
        // ciphertext (VB6 MyCrypt) or "$h$" + Identity V3 hash. The old
        // User_Password2 column no longer exists in the upgraded DB.
        var stored = (row.ContainsKey("User_Password") ? row["User_Password"] as string : null) ?? "";

        if (Sec.UseStrongPasswordHashing)
        {
            // Already migrated: V3 verify against the stored hash.
            if (stored.StartsWith(HashedPwPrefix, StringComparison.Ordinal))
            {
                var result = Hasher.VerifyHashedPassword(UserId, stored.Substring(HashedPwPrefix.Length), Password ?? "");
                if (result == Microsoft.AspNetCore.Identity.PasswordVerificationResult.Success
                    || result == Microsoft.AspNetCore.Identity.PasswordVerificationResult.SuccessRehashNeeded)
                {
                    return (true, null);
                }
                return (false, "Access denied.\nInvalid login or password.");
            }

            // First-time provision: nothing stored yet → take whatever
            // the user typed, hash it, persist it, log them in.
            if (string.IsNullOrEmpty(stored))
            {
                if (_db == null) return (false, "Database not initialized.");
                try
                {
                    var hash = HashedPwPrefix + Hasher.HashPassword(UserId, Password ?? "");
                    await _db.ExecuteAsync(
                        "UPDATE User_Manager SET User_Password = @Hash WHERE User_ID = @UserId",
                        new { Hash = hash, UserId });
                    Logger.LogInformation(
                        "Provisioned hashed User_Password for user {UserId} (first login under opt 4).",
                        UserId);
                    return (true, null);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to provision hashed User_Password for {UserId}", UserId);
                    return (false, "Unable to initialize password. See logs.");
                }
            }

            // Legacy XOR value present: verify it FIRST, then auto-migrate
            // the row in place to the "$h$" hash. A failed compare must NOT
            // overwrite the stored password.
            if (string.Equals(stored, encryptedXor, StringComparison.Ordinal))
            {
                if (_db != null)
                {
                    try
                    {
                        var hash = HashedPwPrefix + Hasher.HashPassword(UserId, Password ?? "");
                        await _db.ExecuteAsync(
                            "UPDATE User_Manager SET User_Password = @Hash WHERE User_ID = @UserId",
                            new { Hash = hash, UserId });
                        Logger.LogInformation("Auto-migrated User_Password to hash for user {UserId}.", UserId);
                    }
                    catch (Exception ex)
                    {
                        // Login still succeeds — migration retries next login.
                        Logger.LogError(ex, "Auto-migration to hashed User_Password failed for {UserId}", UserId);
                    }
                }
                return (true, null);
            }
            return (false, "Access denied.\nInvalid login or password.");
        }

        // A row already migrated to "$h$" must still verify with the hasher —
        // the hashing option governs whether we WRITE hashes, not whether we
        // can read one that is already stored.
        if (stored.StartsWith(HashedPwPrefix, StringComparison.Ordinal))
        {
            var hashResult = Hasher.VerifyHashedPassword(UserId, stored.Substring(HashedPwPrefix.Length), Password ?? "");
            return hashResult == Microsoft.AspNetCore.Identity.PasswordVerificationResult.Success
                || hashResult == Microsoft.AspNetCore.Identity.PasswordVerificationResult.SuccessRehashNeeded
                ? (true, null)
                : (false, "Access denied.\nInvalid login or password.");
        }

        // VB6 compares COLLATE Latin1_General_CS_AS (FLogin.frm:935) — case-sensitive.
        if (string.Equals(stored, encryptedXor, StringComparison.Ordinal))
        {
            return (true, null);
        }
        return (false, "Access denied.\nInvalid login or password.");
    }

    // ── VB6 ZYBFunctions.HomeFrontFunctions.MyCrypt / MyDeCrypt ──────────
    // VB6: Set hff = CreateObject("ZYBFunctions.HomeFrontFunctions")
    //      encrypted = hff.MyCrypt(plaintext, "Fazlul")   ' stored in User_Password
    //      plaintext = hff.MyDeCrypt(encrypted, "Fazlul")
    //
    // The cipher lives in the compiled zybfunctions.dll COM object (no source
    // in the tree). It is a positional additive (Vigenère-style) cipher whose
    // OUTPUT IS THE SAME LENGTH AS THE INPUT (not hex): each character is
    // shifted by a fixed per-position amount, period = key length. The earlier
    // "XOR + 2-hex-digit" port here was WRONG — it doubled the length and never
    // matched the stored values, so every opt-2 password check failed.
    //
    // The shift table was reverse-engineered from the production
    // User_Manager.User_Password values and VERIFIED to round-trip (encrypt AND
    // decrypt) byte-for-byte against ALL stored users. For the system-wide key
    // "Fazlul" the shifts (per position mod 6) are { -4, 6, 1, 7, 0, 2 }.
    // e.g. MyCrypt("Tigger5639!","Fazlul") == "Pohnet1<4@!" (ADMIN's stored pwd).
    //
    // SECURITY NOTE: this is weak, fully-reversible obfuscation (no salt, no
    // hash) — reproduced only for VB6 data compatibility. Real protection comes
    // from opt 4 (UseStrongPasswordHashing → PBKDF2), not from this routine.
    private static readonly int[] FazlulShift = { -4, 6, 1, 7, 0, 2 };

    private static int[] GetCipherShift(string key)
    {
        // VB6 always calls with the hardcoded "Fazlul" key; that is the only
        // shift table recovered from the DLL. Fail loudly on anything else
        // rather than silently produce wrong ciphertext.
        if (string.Equals(key, "Fazlul", StringComparison.Ordinal))
            return FazlulShift;
        throw new NotSupportedException(
            $"VB6 MyCrypt shift table is only known for key 'Fazlul' (got '{key}').");
    }

    internal static string MyCrypt(string text, string key)
    {
        if (string.IsNullOrEmpty(text) || string.IsNullOrEmpty(key))
            return "";

        var shift = GetCipherShift(key);
        var sb = new StringBuilder(text.Length);
        for (int i = 0; i < text.Length; i++)
            sb.Append((char)(((text[i] + shift[i % shift.Length]) % 256 + 256) % 256));
        return sb.ToString();
    }

    internal static string MyDeCrypt(string text, string key)
    {
        if (string.IsNullOrEmpty(text) || string.IsNullOrEmpty(key))
            return "";

        var shift = GetCipherShift(key);
        var sb = new StringBuilder(text.Length);
        for (int i = 0; i < text.Length; i++)
            sb.Append((char)(((text[i] - shift[i % shift.Length]) % 256 + 256) % 256));
        return sb.ToString();
    }

    private async Task HandleCognitoLoginAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId))
        {
            StatusMessage = "Enter a user ID.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Password))
        {
            StatusMessage = "Enter a password.";
            return;
        }

        StatusMessage = "Authenticating via Cognito...";
        StateHasChanged();

        try
        {
            var result = await CognitoAuth.AuthenticateAsync(UserId, Password);
            if (result.Success)
            {
                _isCognito = true;
                _cognitoIdToken = result.IdToken;
                
                StatusMessage = "Retrieving assigned databases...";
                StateHasChanged();
                
                var matchedDbs = await FindDatabasesForUserAsync(UserId);
                if (matchedDbs == null || matchedDbs.Count == 0)
                {
                    _isCognito = false;
                    _cognitoIdToken = null;
                    await AlertAsync("Access denied. Your user is not assigned to any client database.");
                    StatusMessage = "";
                    return;
                }
                
                Connections.Clear();
                foreach (var dbName in matchedDbs)
                {
                    var clientBuilder = new SqlConnectionStringBuilder(DefaultConnectionString)
                    {
                        InitialCatalog = dbName
                    };
                    
                    Connections.Add(new ConnectionItem
                    {
                        Name = dbName,
                        ConnectionString = clientBuilder.ConnectionString
                    });
                }
                
                if (Connections.Count == 1)
                {
                    SelectedConnections = new List<string> { Connections[0].Name };
                    StatusMessage = "Cognito authentication successful.";
                    if (await DoOpenDbAsync())
                    {
                        await SetStepAsync(2); // Move to division selection
                    }
                }
                else
                {
                    SelectedConnections = new List<string> { Connections[0].Name };
                    StatusMessage = "Cognito authentication successful. Select database connection.";
                    await SetStepAsync(0); // Show database connection selection
                }
            }
            else
            {
                _isCognito = false;
                _cognitoIdToken = null;
                await AlertAsync(result.ErrorMessage ?? "Cognito authentication failed.");
                StatusMessage = "";
            }
        }
        catch (Exception ex)
        {
            _isCognito = false;
            _cognitoIdToken = null;
            await AlertAsync($"Cognito error: {ex.Message}");
            StatusMessage = "";
        }
    }

    private async Task<List<string>> FindDatabasesForUserAsync(string username)
    {
        var matchedDbs = new List<string>();
        try
        {
            var dbs = await _db.QueryAsync(
                "SELECT name FROM sys.databases WHERE name NOT IN ('master', 'tempdb', 'model', 'msdb') " +
                "AND DATABASEPROPERTYEX(name, 'Status') = 'ONLINE'");
                
            foreach (var db in dbs)
            {
                var dbName = db["name"]?.ToString();
                if (string.IsNullOrEmpty(dbName)) continue;
                
                try
                {
                    var tableExists = await _db.ExecuteScalarAsync<int?>(
                        $"SELECT COUNT(*) FROM [{dbName}].sys.tables WHERE name = 'user_manager'") ?? 0;
                        
                    if (tableExists > 0)
                    {
                        var userExists = await _db.ExecuteScalarAsync<int?>(
                            $"SELECT COUNT(*) FROM [{dbName}].dbo.user_manager WHERE user_id = @UserID",
                            new { UserID = username }) ?? 0;
                            
                        if (userExists > 0)
                        {
                            matchedDbs.Add(dbName);
                        }
                    }
                }
                catch
                {
                    // Ignore access errors on other/offline databases
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error scanning databases for user {username}: {ex.Message}");
        }
        return matchedDbs;
    }

    public record LoginResult(string UserId, string DivisionId, string ConnectionName);

    private sealed class ConnectionItem
    {
        public string Name { get; set; } = "";
        public string ConnectionString { get; set; } = "";
    }

    private sealed class DivisionItem
    {
        public string DivisionID { get; set; } = "";
        public string DivisionCode { get; set; } = "";
        public string DivisionName { get; set; } = "";
        public string Display => string.IsNullOrWhiteSpace(DivisionCode)
            ? DivisionName
            : $"{DivisionCode} - {DivisionName}";
    }
