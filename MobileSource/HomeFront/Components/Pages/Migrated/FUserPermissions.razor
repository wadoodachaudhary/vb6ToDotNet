    // ── VB6 ZYBFunctions.HomeFrontFunctions.MyCrypt ──────────────────────
    // VB6: user_Password = hff.MyCrypt(txtUserPswd.Text, "Fazlul"). The cipher lives in the
    // compiled zybfunctions.dll COM object (no source). It is a positional additive
    // (Vigenère-style) cipher whose OUTPUT IS THE SAME LENGTH as the input: each char is
    // shifted by a fixed per-position amount, period = key length. For the system-wide key
    // "Fazlul" the shifts (per position mod 6) are { -4, 6, 1, 7, 0, 2 }, reverse-engineered
    // from production User_Manager.User_Password values and verified byte-for-byte against
    // every stored user (e.g. MyCrypt("Tigger5639!","Fazlul") == "Pohnet1<4@!"). This is the
    // same routine FLogin uses; duplicated here (different namespace) to keep this file
    // self-contained. SECURITY: weak, fully-reversible obfuscation — kept only for VB6 data
    // compatibility; real protection is FLogin opt-4 PBKDF2 hashing.
    private static readonly int[] FazlulShift = { -4, 6, 1, 7, 0, 2 };

    private static string MyCrypt(string text, string key)
    {
        if (string.IsNullOrEmpty(text) || string.IsNullOrEmpty(key)) return "";
        if (!string.Equals(key, "Fazlul", StringComparison.Ordinal))
            throw new NotSupportedException(
                $"VB6 MyCrypt shift table is only known for key 'Fazlul' (got '{key}').");
        var sb = new System.Text.StringBuilder(text.Length);
        for (int i = 0; i < text.Length; i++)
            sb.Append((char)(((text[i] + FazlulShift[i % FazlulShift.Length]) % 256 + 256) % 256));
        return sb.ToString();
    }

    // VB6: HFApp.Options(AreaSpecSalesPerson) = "True". Stored as a bit in System_Setup,
    // keyed by the division id (System_Setup.id = DivisionID).
    private async Task<bool> GetAreaSpecSalesPerson()
    {
        try
        {
            var result = await db.ExecuteScalarAsync<int?>(
                "SELECT CAST(ISNULL(AreaSpecSalesPerson,0) AS int) FROM System_Setup WHERE id=@DivisionID",
                new { DivisionID = SessionState.DivisionID });
            return (result ?? 0) != 0;
        }
        catch { return false; }
    }

    private string FormatDecimal(object? val)
    {
        if (val == null || val == DBNull.Value) return "0.00";
        return Convert.ToDecimal(val).ToString("0.00");
    }

    private decimal ParseDecimal(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return 0;
        return decimal.TryParse(val, out var result) ? result : 0;
    }

