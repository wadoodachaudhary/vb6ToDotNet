    // FlexKit control change handlers (replace the raw @bind:after / @onclick wiring;
    // each mirrors the original behavior: set the bound value, then mark dirty / switch tab).
    private ElementReference _tabStripElement;

    private async Task SelectTab(string key)
    {
        if (VisibleTabs.FirstOrDefault(tab => tab.Key == key)?.Descoped == true)
            return;

        ActiveTab = key;
        _selectedPermColumn = null; // HHM-271: switching tabs resets the grid cursor (new VB6 grid)
        try { await _tabStripElement.FocusAsync(preventScroll: true); } catch { }
    }

    private async Task OnTabStripKeyDown(KeyboardEventArgs e)
    {
        var delta = e.Key == "ArrowRight" ? 1 : e.Key == "ArrowLeft" ? -1 : 0;
        if (delta == 0 || VisibleTabs.Count == 0) return;

        var index = VisibleTabs.FindIndex(t => t.Key == ActiveTab);
        if (index < 0) index = 0;

        var next = index + delta;
        while (next >= 0 && next < VisibleTabs.Count && VisibleTabs[next].Descoped)
            next += delta;
        if (next < 0 || next >= VisibleTabs.Count) return;

        await SelectTab(VisibleTabs[next].Key);
    }

