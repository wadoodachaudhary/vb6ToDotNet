    private async Task InitPermissionDefinitions()
    {
        try
        {
            var sql = @"
                SELECT c.name, CAST(p.value AS varchar(500)) Description
                FROM sys.tables t
                JOIN sys.columns c ON t.object_id=c.object_id
                JOIN sys.extended_properties p ON p.major_id=t.object_id AND p.minor_id=c.column_id AND p.name='MS_Description'
                WHERE t.name='SecurityGroups'
                ORDER BY 2";
            var rows = await db.QueryAsync(sql);

            AllPermissions.Clear();
            foreach (var row in rows)
            {
                var desc = row["Description"]?.ToString() ?? "";
                var columnName = row["name"]?.ToString() ?? "";

                var parts = desc.Split(':');
                if (parts.Length >= 4)
                {
                    var page = parts[0].Trim();
                    var section = parts[1].Trim();
                    var description = parts[3].Trim();

                    AllPermissions.Add(new PermissionItem
                    {
                        Page = page,
                        Section = section,
                        ColumnName = columnName,
                        Description = description,
                        Value = false,
                        Descoped = IsDescopedPermission(page, description)
                    });
                }
            }

            // VB6 InitPermissionGrids: a tab whose permission grid has 0 rows is removed
            // (TabStrip.Tabs.Remove) — this applies to EVERY tab, including Sales /
            // Purchasing / Payables. So a page with no MS_Description-tagged columns shows
            // no tab at all (e.g. CRM and Data Portal in this DB). Match that exactly — do
            // not force-keep any tab.
            var pagesWithPerms = AllPermissions.Select(p => p.Page).Distinct().ToHashSet();
            VisibleTabs = AllTabs.Where(t => t.Descoped || pagesWithPerms.Contains(t.Key)).ToList();

            if (VisibleTabs.Any() && !VisibleTabs.Any(t => t.Key == ActiveTab))
                ActiveTab = VisibleTabs.First().Key;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "InitPermissionDefinitions error");

        }
    }

    private async Task LoadPermissions(long secGroupID)
    {
        _selectedPermColumn = null; // HHM-271: group reload resets the grid cursor like VB6
        try
        {
            var rows = await db.QueryAsync(
                "SELECT * FROM SecurityGroups WHERE SecGroupID=@SecGroupID",
                new { SecGroupID = secGroupID });

            if (!rows.Any()) return;
            var row = rows.First();

            // Sales fields
            HomePage = row.ContainsKey("HomePage") ? row["HomePage"]?.ToString() ?? "" : "";
            var ua = row.ContainsKey("User_Access") ? Convert.ToInt32(row["User_Access"] ?? 6) : 6;
            if (ua < 1 || ua > 7) ua = 6;
            UserAccessType = ua;

            // Purchasing
            MaxPOAmount = row.ContainsKey("MaxPOAmount") ? FormatDecimal(row["MaxPOAmount"]) : "0.00";

            // Payables
            MaxInvoiceAmount = row.ContainsKey("MaxInvoiceAmount") ? FormatDecimal(row["MaxInvoiceAmount"]) : "0.00";
            MaxInvoiceOverrideAmount = row.ContainsKey("MaxInvoiceOverrideAmount") ? FormatDecimal(row["MaxInvoiceOverrideAmount"]) : "0.00";
            MaxInvoiceOverridePercent = row.ContainsKey("MaxInvoiceOverRidePercent") ? (Convert.ToDecimal(row["MaxInvoiceOverRidePercent"] ?? 0)).ToString() : "0";
            MaxInvoicePOOverageAmount = row.ContainsKey("MaxInvoicePOOverageAmount") ? FormatDecimal(row["MaxInvoicePOOverageAmount"]) : "0.00";
            MaxInvoicePOOveragePercent = row.ContainsKey("MaxInvoicePOOveragePercent") ? (Convert.ToDecimal(row["MaxInvoicePOOveragePercent"] ?? 0)).ToString() : "0";

            // Checkboxes
            foreach (var perm in AllPermissions)
            {
                if (row.ContainsKey(perm.ColumnName))
                {
                    perm.Value = row[perm.ColumnName]?.ToString() == "True" || row[perm.ColumnName]?.ToString() == "1";
                }
                else
                {
                    perm.Value = false;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadPermissions error");

        }
        Dirty = DirtyState.None;
    }

    private async Task LoadUser(string userId)
    {
        try
        {
            var rows = await db.QueryAsync(@"
                SELECT u.user_id, u.firstname, u.lastname, u.designation, u.office, u.email,
                       u.CRMAccess, u.SecGroupID, u.PMUser, g.user_access
                FROM user_manager u
                LEFT OUTER JOIN securitygroups g ON u.secgroupid=g.secgroupid
                WHERE u.user_id=@UserID", new { UserID = userId });

            if (!rows.Any())
            {
                ClearUserForm();
                // HHM-292: VB6 runs the CRM seats count/label update AFTER the End If —
                // i.e. on BOTH branches, empty/new users included (frm:2536-2539) — so the
                // "N of M seats have been assigned." description always shows a real count.
                CRMSeatsUsed = await GetCRMSeatsUsed();
                return;
            }

            var row = rows.First();
            UserID = row["user_id"]?.ToString() ?? "";
            OriginalUserID = UserID;
            UserFirstName = row["firstname"]?.ToString() ?? "";
            UserLastName = row["lastname"]?.ToString() ?? "";
            // VB6: txtUserPswd.Text = String(Rnd * (20 - 6) + 6, Chr(1))
            // Fill with a random-length run of the Chr(1) sentinel. If the user types over
            // it (first keystroke clears it) we treat the password as changed and save it;
            // otherwise we leave User_Password untouched. The sentinel is masked by the
            // password input so it never displays as readable text.
            UserPassword = new string(PASSWORD_SENTINEL, new Random().Next(6, 20));
            PasswordChanged = false;
            UserDesignation = row["designation"]?.ToString() ?? "";
            UserOffice = row["office"]?.ToString() ?? "";
            UserEmail = row["email"]?.ToString() ?? "";
            UserSecGroupID = Convert.ToInt64(row["SecGroupID"] ?? 0);
            UserCRMAccess = row["CRMAccess"]?.ToString() == "True" || row["CRMAccess"]?.ToString() == "1";
            UserIsPMUser = row["PMUser"]?.ToString() == "True" || row["PMUser"]?.ToString() == "1";

            // VB6: gSalesCommunities visible only when the user is a salesperson (User_Access=4)
            // AND the division has the AreaSpecSalesPerson option turned on.
            var userAccess = Convert.ToInt32(row["user_access"] ?? 0);
            ShowSalesCommunities = userAccess == 4 && await GetAreaSpecSalesPerson();

            // Load user divisions
            foreach (var div in Divisions) div.Selected = false;
            var divRows = await db.QueryAsync(
                "SELECT divisionid FROM divisionusers WHERE userid=@UserID",
                new { UserID = userId });
            foreach (var dr in divRows)
            {
                var divId = Convert.ToInt64(dr["divisionid"]);
                var div = Divisions.FirstOrDefault(d => d.DivisionID == divId);
                if (div != null) div.Selected = true;
            }

            // Load sales areas
            foreach (var sc in SalesCommunities) sc.Selected = false;
            var areaRows = await db.QueryAsync(
                "SELECT area FROM tblsalespersonarea WHERE sales_person_id=@UserID",
                new { UserID = userId });
            foreach (var ar in areaRows)
            {
                var area = ar["area"]?.ToString() ?? "";
                var sc = SalesCommunities.FirstOrDefault(s => s.Area == area);
                if (sc != null) sc.Selected = true;
            }

            // CRM seats
            CRMSeatsUsed = await GetCRMSeatsUsed();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadUser error");

        }
        Dirty = DirtyState.None;
    }

