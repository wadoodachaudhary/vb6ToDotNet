    private async Task OnGroupListKeyDown(KeyboardEventArgs e)
    {
        if (EditingGroupId.HasValue || Groups.Count == 0)
            return;

        var currentIndex = SelectedGroup == null
            ? 0
            : Groups.FindIndex(group => group.SecGroupID == SelectedGroup.SecGroupID);
        if (currentIndex < 0)
            currentIndex = 0;

        var targetIndex = e.Key switch
        {
            "ArrowUp" => Math.Max(0, currentIndex - 1),
            "ArrowDown" => Math.Min(Groups.Count - 1, currentIndex + 1),
            "Home" => 0,
            "End" => Groups.Count - 1,
            _ => -1
        };

        if (targetIndex >= 0)
        {
            await OnGroupSelected(Groups[targetIndex]);
            return;
        }

        if (e.Key is "Enter" or "NumpadEnter" or "F2")
        {
            var group = SelectedGroup ?? Groups[currentIndex];
            if (SelectedGroup?.SecGroupID != group.SecGroupID)
                await OnGroupSelected(group);

            if (SelectedGroup?.SecGroupID == group.SecGroupID)
                StartEditGroup(group);
        }
    }

    private async Task CreateGroup()
