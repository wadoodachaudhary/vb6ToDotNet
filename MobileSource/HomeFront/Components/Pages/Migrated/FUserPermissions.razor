    private async Task<bool> SaveUser()
    {
        try
        {
            var oldId = OriginalUserID;
            var newId = UserID;

            if (newId.Length > 10)
            {
                Notifications.Info("User ID is too long. It must be 10 characters or less.");
                return false;
            }

            // VB6: pswdChanged = Left(txtUserPswd.Text,1) <> Chr(1). The field is loaded
            // with a sentinel run; if it still starts with the sentinel the password was
            // never edited and we must NOT overwrite User_Password.
            var pswdChanged = string.IsNullOrEmpty(UserPassword) || UserPassword[0] != PASSWORD_SENTINEL;

            // VB6: when the password changed, enforce ZYB_IsPswdComplex and confirm a
            // blank one. HHM-621: validated BEFORE the new-user INSERT — bailing out
            // after it used to leave an orphan user_manager row with NULL permission
            // bits (a member the group sync had never touched).
            if (pswdChanged)
            {
                var complexErr = await db.ExecuteScalarAsync<string>(
                    "SELECT dbo.ZYB_IsPswdComplex(@DivisionID, @UserID, @Password)",
                    new { DivisionID = SessionState.DivisionID, UserID = string.IsNullOrEmpty(oldId) ? newId : oldId, Password = UserPassword ?? "" }) ?? "";
                if (!string.IsNullOrEmpty(complexErr))
                {
                    Notifications.Error($"Unable to change password. It does not meet complexity rules.\n\n{complexErr}");
                    return false;
                }

                if (string.IsNullOrEmpty(UserPassword))
                {
                    var res = await _messageBox!.ShowAsync(
                        "Are you sure you want to leave the password blank?",
                        "User Permissions",
                        Fx.ControlKit.Dialogs.MessageBoxButtons.OkCancel);
                    if (res != Fx.ControlKit.Dialogs.MessageBoxResult.Ok)
                        return false;
                }
            }

            if (string.IsNullOrEmpty(oldId))
            {
                // Insert new user
                oldId = newId;
                await db.ExecuteAsync(
                    "INSERT INTO user_manager(user_id, SecGroupID) VALUES(@UserID, @SecGroupID)",
                    new { UserID = newId, SecGroupID = UserSecGroupID });
            }

            // Build update SQL
            var setClauses = new List<string>
            {
                "user_id=@NewUserID",
                "firstname=@FirstName",
                "lastname=@LastName",
                "designation=@Designation",
                "office=@Office",
                "email=@Email",
                "crmaccess=@CRMAccess",
                "pmuser=@PMUser",
                "SecGroupID=@SecGroupID"
            };

            if (pswdChanged)
            {
                setClauses.Add("user_Password=@Password");
            }

            // VB6: user_Password = hff.MyCrypt(txtUserPswd.Text, "Fazlul") — same weak,
            // reversible Fazlul cipher used by FLogin, reproduced for VB6 data compatibility.
            var encryptedPassword = MyCrypt(UserPassword ?? "", "Fazlul");

            var sql = $"UPDATE user_manager SET {string.Join(", ", setClauses)} WHERE user_id=@OldUserID";
            await db.ExecuteAsync(sql, new
            {
                NewUserID = newId,
                FirstName = UserFirstName,
                LastName = UserLastName,
                Password = encryptedPassword,
                Designation = UserDesignation,
                Office = UserOffice,
                Email = UserEmail,
                CRMAccess = UserCRMAccess,
                PMUser = UserIsPMUser,
                SecGroupID = UserSecGroupID,
                OldUserID = oldId
            });

            // Update contacts
            await db.ExecuteAsync(@"
                UPDATE contacts SET
                    userid=@NewUserID, email=@Email, firstname=@FirstName,
                    lastname=@LastName, displayname=@DisplayName
                WHERE userid=@OldUserID AND contacttypeid IN(1,4)",
                new
                {
                    NewUserID = newId, Email = UserEmail, FirstName = UserFirstName,
                    LastName = UserLastName, DisplayName = $"{UserFirstName} {UserLastName}",
                    OldUserID = oldId
                });

            // Update sales persons
            await db.ExecuteAsync(@"
                UPDATE tblsales_persons SET
                    sales_person_id=@NewUserID,
                    sales_person_name=@DisplayName,
                    email=@Email
                WHERE sales_person_id=@OldUserID",
                new
                {
                    NewUserID = newId,
                    DisplayName = $"{UserFirstName} {UserLastName}",
                    Email = UserEmail,
                    OldUserID = oldId
                });

            // Update project managers
            var pmSetClauses = new List<string>
            {
                "pm=@NewUserID",
                "pmname=@DisplayName",
                "email=@Email",
                "inactive=@Inactive"
            };
            // VB6 stores the PM password in PLAINTEXT here (DbQuote(Str, ...), not MyCrypt).
            if (pswdChanged)
                pmSetClauses.Add("password=@Password");

            await db.ExecuteAsync(
                $"UPDATE tblprojectmanager SET {string.Join(", ", pmSetClauses)} WHERE pm=@OldUserID",
                new
                {
                    NewUserID = newId,
                    DisplayName = $"{UserFirstName} {UserLastName}",
                    Email = UserEmail,
                    Inactive = !UserIsPMUser,
                    Password = UserPassword ?? "",
                    OldUserID = oldId
                });

            // Save divisions
            await db.ExecuteAsync("DELETE FROM divisionusers WHERE userid=@UserID", new { UserID = oldId });
            foreach (var div in Divisions.Where(d => d.Selected))
            {
                await db.ExecuteAsync(
                    "INSERT INTO divisionusers(divisionid, userid) VALUES(@DivisionID, @UserID)",
                    new { DivisionID = div.DivisionID, UserID = newId });
            }

            // Save sales areas
            await db.ExecuteAsync("DELETE FROM tblsalespersonarea WHERE sales_person_id=@UserID",
                new { UserID = oldId });
            foreach (var sc in SalesCommunities.Where(s => s.Selected))
            {
                await db.ExecuteAsync(
                    "INSERT INTO tblsalespersonarea(area, sales_person_id) VALUES(@Area, @UserID)",
                    new { Area = sc.Area, UserID = newId });
            }

            // Insert PM/SP records if needed
            await InsertPMSP();

            // Update user permissions from group (VB6: ZYB_UpdateUserPerms).
            // HHM-621: surface a failure instead of swallowing it — a silent
            // miss here leaves the member without the group's permission bits.
            try { await db.ExecuteAsync("ZYB_UpdateUserPerms @SecGroupID", new { SecGroupID = UserSecGroupID }); }
            catch (Exception syncEx)
            {
                Logger.LogError(syncEx, "ZYB_UpdateUserPerms failed for group {GroupId}", UserSecGroupID);
                Notifications.Error("The user was saved, but copying the group's permissions to its members failed. Open the group and Save again to retry.");
            }

            // Save group permissions as well (VB6 calls SaveGroup after SaveUser)
            await SaveGroup();

            Dirty = DirtyState.None;
            ShowUserPage = false;

            // Reload
            await LoadUsers(mSecGroupID);
            await LoadPermissions(mSecGroupID);

            return true;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Duplicate", StringComparison.OrdinalIgnoreCase))
            {
                Notifications.Error("Duplicate found. Make sure user IDs are unique.");
            }
            else
            {
                Notifications.Info($"Error saving user: {ex.Message}");
            }
            return false;
        }
    }

    private async Task SaveGroup()
    {
        try
        {
            var setClauses = new List<string>
            {
                "HomePage=@HomePage",
                "User_Access=@UserAccess",
                "MaxPOAmount=@MaxPOAmount",
                "MaxInvoiceAmount=@MaxInvoiceAmount",
                "MaxInvoiceOverrideAmount=@MaxInvoiceOverrideAmount",
                "MaxInvoiceOverRidePercent=@MaxInvoiceOverridePercent",
                "MaxInvoicePOOverageAmount=@MaxInvoicePOOverageAmount",
                "MaxInvoicePOOveragePercent=@MaxInvoicePOOveragePercent"
            };

            // Add all permission checkboxes
            foreach (var perm in AllPermissions)
            {
                setClauses.Add($"[{perm.ColumnName}]=@p_{perm.ColumnName.Replace(" ", "_")}");
            }

            var setClause = string.Join(", ", setClauses);

            // Build parameters
            var parameters = new Dictionary<string, object?>
            {
                ["HomePage"] = HomePage,
                ["UserAccess"] = UserAccessType,
                ["MaxPOAmount"] = ParseDecimal(MaxPOAmount),
                ["MaxInvoiceAmount"] = ParseDecimal(MaxInvoiceAmount),
                ["MaxInvoiceOverrideAmount"] = ParseDecimal(MaxInvoiceOverrideAmount),
                ["MaxInvoiceOverridePercent"] = ParseDecimal(MaxInvoiceOverridePercent),
                ["MaxInvoicePOOverageAmount"] = ParseDecimal(MaxInvoicePOOverageAmount),
                ["MaxInvoicePOOveragePercent"] = ParseDecimal(MaxInvoicePOOveragePercent),
                ["SecGroupID"] = mSecGroupID
            };

            foreach (var perm in AllPermissions)
            {
                parameters[$"p_{perm.ColumnName.Replace(" ", "_")}"] = perm.Value;
            }

            // Update securitygroups
            var sql = $"UPDATE SecurityGroups SET {setClause} WHERE SecGroupID=@SecGroupID";
            await db.ExecuteAsync(sql, parameters);

            // Also update user_manager with same permissions
            sql = $"UPDATE user_manager SET {setClause} WHERE SecGroupID=@SecGroupID";
            await db.ExecuteAsync(sql, parameters);

            await InsertPMSP();

            Dirty = DirtyState.None;
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error saving group: {ex.Message}");
        }
    }

    private async Task InsertPMSP()
    {
        try
        {
            // Create warranty user contacts
            await db.ExecuteAsync(@"
                INSERT INTO contacts(userid, firstname, lastname, displayname, email, contacttypeid)
                SELECT u.user_id, u.firstname, u.lastname, u.user_name, u.email, 1
                FROM user_manager u
                JOIN securitygroups g ON u.secgroupid=g.secgroupid AND g.launchwarranty=1
                LEFT OUTER JOIN contacts s ON u.user_id=s.userid AND s.contacttypeid=1
                WHERE s.userid IS NULL");

            // Create salespersons
            await db.ExecuteAsync(@"
                INSERT INTO tblsales_persons(sales_person_id, sales_person_name, email)
                SELECT u.user_id, u.user_name, u.email
                FROM user_manager u
                JOIN securitygroups g ON u.secgroupid=g.secgroupid AND g.user_access IN(4,5)
                LEFT OUTER JOIN tblsales_persons s ON u.user_id=s.sales_person_id
                WHERE s.sales_person_id IS NULL");

            await db.ExecuteAsync(@"
                INSERT INTO contacts(userid, firstname, lastname, displayname, email, contacttypeid)
                SELECT u.user_id, u.firstname, u.lastname, u.user_name, u.email, 4
                FROM user_manager u
                JOIN securitygroups g ON u.secgroupid=g.secgroupid AND g.user_access IN(4,5)
                LEFT OUTER JOIN contacts s ON u.user_id=s.userid AND s.contacttypeid=4
                WHERE s.userid IS NULL");

            // Create project managers
            await db.ExecuteAsync(@"
                INSERT INTO tblprojectmanager(pm, pmname, email)
                SELECT u.user_id, u.user_name, u.email
                FROM user_manager u
                LEFT OUTER JOIN tblprojectmanager p ON u.user_id=p.pm
                WHERE u.PMUser=1 AND p.pm IS NULL");

            await db.ExecuteAsync(@"
                INSERT INTO contacts(userid, firstname, lastname, displayname, email, contacttypeid)
                SELECT u.user_id, u.firstname, u.lastname, u.user_name, u.email, 5
                FROM user_manager u
                LEFT OUTER JOIN contacts s ON u.user_id=s.userid AND s.contacttypeid=5
                WHERE u.pmuser=1 AND s.userid IS NULL");

            // Create default grid layouts for users that have none (VB6: ZYB_ResetUserGridLayout)
            var usersWithoutLayouts = await db.QueryAsync(@"
                SELECT u.user_id
                FROM user_manager u
                LEFT OUTER JOIN appgridlayout l ON u.user_id=l.uid
                WHERE l.uid IS NULL");
            foreach (var row in usersWithoutLayouts)
            {
                var uid = row["user_id"]?.ToString() ?? "";
                if (!string.IsNullOrEmpty(uid))
                {
                    try { await db.ExecuteAsync("ZYB_ResetUserGridLayout @UserID", new { UserID = uid }); }
                    catch { /* non-critical */ }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "InsertPMSP error");

        }
    }

    // ── Dirty Check ──────────────────────────────────────────────
    // HHM-273: VB6 IsDirty (FUserPermissions.frm:2999-3009) — MsgBox vbYesNoCancel + vbQuestion
    // titled "HomeFront" (the VB6 literal). Yes = save, No = discard, Cancel = keep Dirty set so
    // the caller aborts (VB6: IsDirty = Dirty <> e_none). Replaces the untitled native confirm()
    // that collapsed the 3-way choice into OK/Cancel and always returned false, losing both the
    // Cancel-aborts path and the save-failure-keeps-form-open path.
    private async Task<bool> CheckDirty()
    {
        if (Dirty == DirtyState.None) return false;

        var result = await _messageBox!.ShowAsync(
            "Do you want to save your changes?",
            title: "HomeFront",
            buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel);

        switch (result)
        {
            case Fx.ControlKit.Dialogs.MessageBoxResult.Yes:
                // SaveGroup/SaveUser clear Dirty only on success — a failed save keeps Dirty
                // set, so the pending group/user switch is aborted below.
                if (Dirty == DirtyState.Perms) await SaveGroup();
                if (Dirty == DirtyState.User) await SaveUser();
                break;
            case Fx.ControlKit.Dialogs.MessageBoxResult.No:
                Dirty = DirtyState.None;
                break;
            // Cancel: leave Dirty set — the caller aborts the switch.
        }

        return Dirty != DirtyState.None;
    }

