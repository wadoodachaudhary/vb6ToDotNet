@page "/user-permissions"
@namespace HomeFront.Components.Pages
@layout HFComponent
@rendermode InteractiveServer

@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Microsoft.AspNetCore.Authorization

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FUserPermissions> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer db
@inject HomeFront.Services.ISessionStateService SessionState
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@* HHM-270: server web root — locates the Crystal reports folder for the Home-page-report browse. *@
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@attribute [Authorize]

<PageTitle>User Permissions - HomeFront</PageTitle>

@if (_accessDenied)
{
    @* HHM-621: VB6 gates entry through Application.EditSecurity (ToolsUsrAdmin);
       the greyed menu alone doesn't stop a direct /user-permissions URL. *@
    <div class="perm-denied">You do not have permission to administer users and groups.</div>
    return;
}

@if (IsLoading)
{
    <div class="loading-overlay">⏳ Loading...</div>
}

<div class="permissions-container @(IsModal ? "perm-modal" : "")">
    @* ── LEFT PANEL: Groups + Users ──────────────────────── *@
    <div class="left-panel">
        @* Groups Section *@
        <div class="panel-header">
            <span class="panel-header-label">Groups</span>
            <div class="panel-toolbar">
                <ButtonControl CssClass="tool-btn" OnClick="DeleteGroup"><img src="images/16/Delete.ico" alt="Delete" /></ButtonControl>
                <ButtonControl CssClass="tool-btn" Title="Create New" OnClick="CreateGroup"><img src="images/16/NewItem2.ico" alt="New" /></ButtonControl>
                <ButtonControl CssClass="tool-btn" Title="Save As" OnClick="CopyGroup"><img src="images/16/saveas.ico" alt="Save As" /></ButtonControl>
            </div>
        </div>
        @* Deferred: migrate Groups and Members to FlexKit GridControl in a dedicated pass. *@
        <div class="groups-section"
             role="listbox"
             aria-label="Security groups"
             aria-activedescendant="@(SelectedGroup == null ? null : $"group-item-{SelectedGroup.SecGroupID}")"
             tabindex="0"
             @ref="_groupsSectionElement"
             @onkeydown="OnGroupListKeyDown">
            @foreach (var group in Groups)
            {
                <div id="@($"group-item-{group.SecGroupID}")"
                     class="list-item @(SelectedGroup?.SecGroupID == group.SecGroupID ? "selected" : "")"
                     role="option"
                     aria-selected="@(SelectedGroup?.SecGroupID == group.SecGroupID)"
                     @onclick="() => OnGroupClicked(group)">
                    @if (EditingGroupId == group.SecGroupID)
                    {
                        <TextBoxControl CssClass="inline-edit-input" @bind-Value="EditingGroupDescription"
                                        @onblur="SaveGroupDescription"
                                        @onkeydown="OnGroupEditKeyDown" AutoFocus="true" />
                    }
                    else
                    {
                        <span @ondblclick="() => StartEditGroup(group)">@group.Description</span>
                    }
                </div>
            }
        </div>

        @* Users Section *@
        <div class="panel-header">
            <span class="panel-header-label">Members</span>
            <div class="panel-toolbar">
                <ButtonControl CssClass="tool-btn" OnClick="DeleteUser"><img src="images/16/Delete.ico" alt="Delete" /></ButtonControl>
                <ButtonControl CssClass="tool-btn" Title="Create New" OnClick="CreateUser"><img src="images/16/NewItem2.ico" alt="New" /></ButtonControl>
                <ButtonControl CssClass="tool-btn" Title="Find" OnClick="FindUser"><img src="images/16/HelpSearch.ico" alt="Find" /></ButtonControl>
            </div>
        </div>
        @* VB6 gUsers is a two-column grid, not a plain name list. *@
        <div class="users-section">
            <div class="users-grid-header">
                <span class="users-grid-cell">Login ID</span>
                <span class="users-grid-cell">Name</span>
            </div>
            @foreach (var user in Users)
            {
                <div class="list-item user-row @(SelectedUser?.UserID == user.UserID ? "selected" : "")"
                     @onclick="() => OnUserSelected(user)">
                    <span class="users-grid-cell">@user.UserID</span>
                    <span class="users-grid-cell">@user.UserName</span>
                </div>
            }
        </div>
    </div>

    @* ── RIGHT PANEL: Tabs or User Page ──────────────────── *@
    <div class="right-panel">
        @if (ShowUserPage)
        {
            @* HHM-583: VB6's user page (the FUserPermissions.frm User frame) is the plain
               field stack + Save — it has NO sub-tabs. The migration-era "General Info /
               Cognito Info" raw-button strip is removed; the Cognito password console and
               token-claims viewer moved to Setup → Cognito (FCognito), completing the
               2026-07-14 relocation directive. *@
            <div class="tab-content">
                <div class="user-page">
                    
                    <div class="user-profile-header" style="display: flex; align-items: flex-start; gap: 20px; margin-bottom: 20px;">
                        @* Grey human silhouette avatar *@
                        <div class="user-avatar-box" style="width: 125px; height: 135px; border: 1px solid #ced4da; background: #fff; box-shadow: inset 0 0 2px rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 5px;">
                            <svg width="105" height="115" viewBox="0 0 105 115" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect width="105" height="115" fill="#f3f3f3"/>
                                <circle cx="52.5" cy="45" r="18" fill="#bcbcbc"/>
                                <path d="M52.5 70C34 70 24 82 24 95H81C81 82 71 70 52.5 70Z" fill="#bcbcbc"/>
                            </svg>
                        </div>

                        @* User details fields stack *@
                        <div class="user-fields-stack" style="flex: 1; max-width: 480px; display: flex; flex-direction: column; gap: 5px;">
                            <div class="user-form-row">
                                <label>User ID</label>
                                <TextBoxControl CssClass="up-field" @bind-Value="UserID" @bind-Value:after="OnUserFieldChanged" MaxLength="10" />
                            </div>
                            <div class="user-form-row">
                                <label>First Name</label>
                                <TextBoxControl CssClass="up-field" @bind-Value="UserFirstName" @bind-Value:after="OnUserFieldChanged" />
                            </div>
                            <div class="user-form-row">
                                <label>Last Name</label>
                                <TextBoxControl CssClass="up-field" @bind-Value="UserLastName" @bind-Value:after="OnUserFieldChanged" />
                            </div>
                            <div class="user-form-row">
                                <label>Password</label>
                                <TextBoxControl CssClass="up-field" InputType="password" @bind-Value="UserPassword" @bind-Value:after="OnUserFieldChanged"
                                                @onfocus="OnPasswordFocus" />
                            </div>
                            <div class="user-form-row">
                                <label>Designation</label>
                                <TextBoxControl CssClass="up-field" @bind-Value="UserDesignation" @bind-Value:after="OnUserFieldChanged" />
                            </div>
                            <div class="user-form-row">
                                <label>Office</label>
                                <TextBoxControl CssClass="up-field" @bind-Value="UserOffice" @bind-Value:after="OnUserFieldChanged" />
                            </div>
                            <div class="user-form-row">
                                <label>Email Address</label>
                                <TextBoxControl CssClass="up-field" @bind-Value="UserEmail" @bind-Value:after="OnUserFieldChanged" style="max-width:350px;" />
                            </div>
                            <div class="user-form-row">
                                <label>Security Group</label>
                                <DropDownListControl TValue="long" TItem="SecurityGroup" DataSource="@SecGroupOptions"
                                                     ValueFieldName="SecGroupID" TextFieldName="Description"
                                                     Value="UserSecGroupID" ValueChanged="OnUserSecGroupChanged"
                                                     CssClass="up-dropdown" Width="300px" />
                            </div>

                            <div class="checkbox-row">
                                <CheckBoxControl Checked="UserIsPMUser" CheckedChanged="OnUserIsPMUserChanged" Label="Project Manager" />
                            </div>

                            @if (CRMSeats > 0)
                            {
                                <div class="checkbox-row" style="display: flex; align-items: center;">
                                    <CheckBoxControl Checked="UserCRMAccess" CheckedChanged="OnUserCRMAccessChanged"
                                                     Disabled="@(!UserCRMAccess && CRMSeatsUsed >= CRMSeats)"
                                                     Label="Sales User" />
                                    <span class="crm-seats-label" style="color: #0d6efd; font-size: 11px; margin-left: 8px;">@CRMSeatsUsed of @CRMSeats seats have been assigned.</span>
                                </div>
                            }
                        </div>
                    </div>

                    @* Divisions and Sales Communities grids side-by-side *@
                    <div class="user-grids-row" style="display: flex; gap: 16px; margin-top: 15px;">
                        
                        @* Divisions grid *@
                        <div class="user-grid-section">
                            <h6 style="color: #004080; font-size: 11px; font-weight: bold; margin-bottom: 4px;">Divisions</h6>
                            <GridControl TValue="DivisionItem"
                                         DataSource="@Divisions"
                                         AllowSorting="false"
                                         AllowSelection="true"
                                         EnableHover="true"
                                         Height="221px"
                                         EditSettingsRef="@_divEditSettings"
                                         SelectionSettingsRef="@_divSelectionSettings"
                                         EventsRef="@_divGridEvents"
                                         CssClass="fx-grid-compact border-grid">
                                <GridColumnsBase>
                                    <GridColumn Field="@nameof(DivisionItem.Selected)" HeaderText="" Width="34px" Type="ColumnType.CheckBox" AllowEditing="true" />
                                    <GridColumn Field="@nameof(DivisionItem.DivisionCode)" HeaderText="Division" Width="80px" AllowEditing="false" />
                                    <GridColumn Field="@nameof(DivisionItem.DivisionName)" HeaderText="Description" Width="120px" AllowEditing="false" />
                                </GridColumnsBase>
                            </GridControl>
                        </div>

                        @* Sales Communities grid *@
                        @if (ShowSalesCommunities)
                        {
                            <div class="user-grid-section">
                                <h6 style="color: #004080; font-size: 11px; font-weight: bold; margin-bottom: 4px;">Sales Communities</h6>
                                <GridControl TValue="SalesCommunityItem"
                                             DataSource="@SalesCommunities"
                                             AllowSorting="false"
                                             AllowSelection="true"
                                             EnableHover="true"
                                             Height="221px"
                                             EditSettingsRef="@_scEditSettings"
                                             SelectionSettingsRef="@_scSelectionSettings"
                                             EventsRef="@_scGridEvents">
                                    <GridColumnsBase>
                                        <GridColumn Field="@nameof(SalesCommunityItem.Selected)" HeaderText="" Width="34px" Type="ColumnType.CheckBox" AllowEditing="true" />
                                        <GridColumn Field="@nameof(SalesCommunityItem.Area)" HeaderText="Community" Width="80px" AllowEditing="false" />
                                        <GridColumn Field="@nameof(SalesCommunityItem.Description)" HeaderText="Description" Width="142px" AllowEditing="false" />
                                    </GridColumnsBase>
                                </GridControl>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            @* Tab Strip for Permissions *@
            <div class="tab-strip" tabindex="0" @ref="_tabStripElement" @onkeydown="OnTabStripKeyDown">
                @foreach (var tab in VisibleTabs)
                {
                    var tabItem = tab;
                    <ButtonControl CssClass="@(ActiveTab == tabItem.Key ? "active" : "")"
                                   TabIndex="-1"
                                   Disabled="@tabItem.Descoped"
                                   OnClick="@(() => SelectTab(tabItem.Key))">
                        @tabItem.Caption
                    </ButtonControl>
                }
            </div>

            <div class="tab-content">
                @* Sales Tab Extra Fields *@
                @if (ActiveTab == TAB_SALES)
                {
                    <div class="sales-fields">
                        <div class="sales-field-row">
                            <label>Home page report</label>
                            <TextBoxControl CssClass="sf-field" @bind-Value="HomePage" @bind-Value:after="OnPermFieldChanged" />
                            @* HHM-270: VB6 cmdBrowse — an ellipsis image button attached flush to
                               txtHomePage's right edge (FUserPermissions.frm:1475 Left=6420 vs field
                               right edge 6405); its Click (frm:2032-2038) opens a file-open dialog
                               filtered to "Crystal Report Files (*.rpt)" and writes the pick back
                               into txtHomePage. *@
                            <ButtonControl CssClass="mini-btn" Title="Browse for report" OnClick="OnBrowseHomePage">...</ButtonControl>
                        </div>
                        <div class="sales-field-row">
                            <label>User Type</label>
                            <DropDownListControl TValue="int" TItem="IntOption" DataSource="@UserTypeOptions"
                                                 ValueFieldName="Value" TextFieldName="Text"
                                                 Value="UserAccessType" ValueChanged="OnUserAccessTypeChanged"
                                                 Width="220px" />
                        </div>
                    </div>
                }

                @* Purchasing Tab Extra Fields *@
                @if (ActiveTab == TAB_PURCHASING)
                {
                    <div class="purchasing-fields">
                        <label>Maximum PO Amount</label>
                        <TextBoxControl CssClass="pf-field" @bind-Value="MaxPOAmount" @bind-Value:after="OnPermFieldChanged" />
                    </div>
                }

                @* Payables Tab Extra Fields *@
                @if (ActiveTab == TAB_PAYABLES)
                {
                    <div class="payables-fields">
                        <label>Invoice approval limit</label>
                        <TextBoxControl CssClass="pf-field" @bind-Value="MaxInvoiceAmount" @bind-Value:after="OnPermFieldChanged" />
                        <label></label>
                        <span></span>

                        <label>Invoice variance %</label>
                        <TextBoxControl CssClass="pf-field" @bind-Value="MaxInvoiceOverridePercent" @bind-Value:after="OnPermFieldChanged" />
                        <label></label>
                        <span></span>

                        <label>to a maximum of</label>
                        <TextBoxControl CssClass="pf-field" @bind-Value="MaxInvoiceOverrideAmount" @bind-Value:after="OnPermFieldChanged" />
                        <label></label>
                        <span></span>
                    </div>
                }

                @* Permission Checkboxes *@
                @if (ActiveTabPermissions.Any())
                {
                    <div class="perm-grid-container">
                        @foreach (var section in ActiveTabPermissions.GroupBy(p => p.Section))
                        {
                            var sectionKey = $"{ActiveTab}:{section.Key}";
                            var collapsed = _collapsedSections.Contains(sectionKey);
                            <div class="perm-section">
                                @* HHM-272/HHM-308: VB6 gPermissions is a VSFlexGrid in outline mode
                                   (OutlineBar=5 = flexOutlineBarSymbols, OutlineCol=0 —
                                   FUserPermissions.frm:89-91; .Subtotal grouping frm:2624). With symbol
                                   outline bars ONLY a click on the +/− outline symbol collapses/expands;
                                   clicking the header TEXT merely moves the grid cursor. So the toggle
                                   @onclick lives on the .perm-toggle span alone — header-text clicks do
                                   nothing (HHM-308 re-fail: the HHM-272 rework had re-attached the
                                   toggle to the whole header div). Collapse state is kept per tab like
                                   the per-grid VB6 outline state. *@
                                <div class="perm-section-header">
                                    @* @(section.Key) — parenthesized because bare '@section' hits the
                                       reserved Razor 'section' directive (RZ2005). *@
                                    <span class="perm-toggle" @onclick="() => ToggleSection(sectionKey)">@(collapsed ? "+" : "-")</span> @(section.Key)
                                </div>
                                @if (!collapsed)
                                {
                                    @foreach (var perm in section)
                                    {
                                        var permItem = perm;
                                        @* HHM-271: VB6 gPermissions_BeforeEdit (FUserPermissions.frm:2752-2763)
                                           cancels edit on every column except "Value" — clicking a sub-item
                                           description only moves the grid cursor (dotted focus rectangle);
                                           only the checkbox cell toggles. So the description is a sibling
                                           span, NOT the CheckBoxControl Label (a label click would toggle);
                                           clicking the row only selects it. *@
                                        <div class="perm-item @(permItem.Descoped ? "descoped" : "") @(_selectedPermColumn == permItem.ColumnName ? "selected" : "")"
                                             @onclick="() => SelectPermissionRow(permItem)">
                                            <CheckBoxControl Checked="permItem.Value"
                                                             CheckedChanged="@(v => OnPermissionToggled(permItem, v))"
                                                             Disabled="@permItem.Descoped"
                                                             StopClickPropagation="true" />
                                            <span class="perm-item-label">@permItem.Description@(permItem.Descoped ? " (Descoped)" : "")</span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p style="color:#999; padding:20px;">No permissions configured for this tab.</p>
                }
            </div>
        }

        @* Save Bar *@
        <div class="save-bar">
            <ButtonControl CssClass="btn-save" Disabled="@(Dirty == DirtyState.None)" OnClick="OnSaveClick">
                <u>S</u>ave
            </ButtonControl>
        </div>
    </div>
</div>

@* ── Find User — shared FPickList (HHM-297 / HHM-298 / HHM-302). VB6 FUserPermissions.frm:2229
   routes FindUser through FPickList.Choose(..., "User", s, , , , , "SecGroupID"): the shared
   picker supplies the "Precision Builder - User List" window title, window icon and "Choose a User."
   heading (HHM-297), all 7 VB6 lookup columns with SecGroupID hidden (HHM-298), and the
   Open / Cancel footer buttons with double-click select and Esc-to-cancel (HHM-302) —
   replacing the hand-rolled search DialogControl that had none of these. *@
<FPickList @ref="_findUserPickList" OnSelected="OnFindUserPicked" />

@* HHM-273: FlexKit MessageBoxControl replaces the untitled native confirm() for the dirty-check
   prompt — VB6 MsgBox vbYesNoCancel + vbQuestion titled "HomeFront" (FUserPermissions.frm:2999). *@
<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />

@* ── HHM-270: Home-page-report browse dialog. VB6 cmdBrowse_Click (FUserPermissions.frm:2032-2038)
   opens VBGetOpenFileName filtered to "Crystal Report Files (*.rpt)" and writes the chosen path
   back into txtHomePage with Dirty = e_perms. Server-side equivalent: FlexKit FileBrowserControl
   over the app's Crystal reports folder, .rpt only. *@
<DialogControl @bind-Visible="ShowHomePageBrowser" Header="Select Home Page Report" Width="640px">
    <FileBrowserControl ShowFiles="true"
                        SelectionMode="FileBrowserSelectionMode.Files"
                        Accept=".rpt"
                        RootPath="@HomePageReportRoot"
                        InitialPath="@HomePageReportRoot"
                        SelectedItemChanged="OnHomePageReportPicked" />
    <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:10px;">
        <ButtonControl OnClick="OnHomePageBrowseOk" Disabled="@(string.IsNullOrEmpty(_homePagePick))">OK</ButtonControl>
        <ButtonControl OnClick="OnHomePageBrowseCancel">Cancel</ButtonControl>
    </div>
</DialogControl>

@code {
    // Hosted as a modal (DialogControl) from FOptions "Setup User Permissions" — applies a
    // modal-fit height (.perm-modal) instead of the full-page calc when true.
    [Parameter] public bool IsModal { get; set; }

    // ── Constants ────────────────────────────────────────────────
    // VB6 password sentinel (Chr(1)). LoadUser fills the password box with a random-length
    // run of this char; if it survives to save time the password was not changed.
    private const char PASSWORD_SENTINEL = '\u0001';

    private const string TAB_ADMIN = "Admin";
    private const string TAB_SALES = "Sales";
    private const string TAB_PURCHASING = "Purchasing";
    private const string TAB_PAYABLES = "Payables";
    private const string TAB_SCHEDULING = "Scheduling";
    private const string TAB_WARRANTY = "Warranty";
    private const string TAB_WORKTICKET = "Workticket";
    private const string TAB_CRM = "CRM";
    private const string TAB_DATAPORTAL = "Data Portal";

    // ── Enums ────────────────────────────────────────────────────
    private enum DirtyState { None, User, Perms }

    // ── Database ─────────────────────────────────────────────────
// ── UI State ─────────────────────────────────────────────────
    private bool IsLoading = false;
    private DirtyState Dirty = DirtyState.None;
    private bool ShowUserPage = false;
    private string ActiveTab = TAB_ADMIN;
    private ElementReference _groupsSectionElement;
    private long? EditingGroupId = null;
    private string EditingGroupDescription = "";
    private bool PasswordChanged = false;

    // HHM-297/298/302: shared FPickList replaces the hand-rolled Find User dialog
    // (ShowFindUserDialog / FindUserSearch / AllUsersForFind / FindUserItem removed).
    private FPickList? _findUserPickList;

    // HHM-273: FlexKit message box for the VB6 IsDirty Yes/No/Cancel prompt.
    private Fx.ControlKit.Dialogs.MessageBoxControl? _messageBox;

    // HHM-271: the permission row the VB6 grid cursor sits on (dotted focus rectangle);
    // ColumnName is unique per permission. Reset on tab switch / group reload.
    private string? _selectedPermColumn;

    // HHM-272: collapsed outline sections, keyed "$Tab:$Section" so state is per tab
    // (VB6 keeps outline state per gPermissions grid).
    private readonly HashSet<string> _collapsedSections = new();

    // HHM-307: Sales Communities grid (VB6 gSalesCommunities, FUserPermissions.frm:331) —
    // batch checkbox edit on the Selected column, same settings as FAddPricelist gPOIndexes.
    private readonly EditSettings _scEditSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch
    };
    private readonly SelectionSettings _scSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Cell
    };
    private readonly GridControlEvents<SalesCommunityItem> _scGridEvents = new();

    private readonly EditSettings _divEditSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch
    };
    private readonly SelectionSettings _divSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Cell
    };
    private readonly GridControlEvents<DivisionItem> _divGridEvents = new();



    // HHM-270: Home-page-report browse dialog state.
    private bool ShowHomePageBrowser = false;
    private string? _homePagePick;

    // ── Group/User State ─────────────────────────────────────────
    private long mSecGroupID = 0;
    private int mUserIndex = 0;
    private long CRMSeats = 0;
    private long CRMSeatsUsed = 0;

    // ── Data Collections ─────────────────────────────────────────
    private List<SecurityGroup> Groups = new();
    private List<UserListItem> Users = new();
    private List<DivisionItem> Divisions = new();
    private List<SalesCommunityItem> SalesCommunities = new();
    private List<PermissionItem> AllPermissions = new();

    // ── Selected Items ───────────────────────────────────────────
    private SecurityGroup? SelectedGroup;
    private UserListItem? SelectedUser;

    // ── Tab Definitions ──────────────────────────────────────────
    private List<TabDefinition> AllTabs = new();
    private List<TabDefinition> VisibleTabs = new();

    // ── User Form Fields ─────────────────────────────────────────
    private string UserID = "";
    private string OriginalUserID = "";
    private string UserFirstName = "";
    private string UserLastName = "";
    private string UserPassword = "";
    private string UserDesignation = "";
    private string UserOffice = "";
    private string UserEmail = "";
    private long UserSecGroupID = 0;
    private bool UserIsPMUser = false;
    private bool UserCRMAccess = false;
    private bool ShowSalesCommunities = false;

    // ── Permission Form Fields ───────────────────────────────────
    private string HomePage = "";
    private int UserAccessType = 6;
    private string MaxPOAmount = "0.00";
    private string MaxInvoiceAmount = "0.00";
    private string MaxInvoiceOverrideAmount = "0.00";
    private string MaxInvoiceOverridePercent = "0";
    private string MaxInvoicePOOverageAmount = "0.00";
    private string MaxInvoicePOOveragePercent = "0";

    // ── Computed ─────────────────────────────────────────────────
    private List<PermissionItem> ActiveTabPermissions =>
        AllPermissions.Where(p => p.Page == ActiveTab).ToList();

    // Security-group dropdown options — preserves the original "-- Select --" (value 0)
    // entry that the raw <select> rendered as its first <option>.
    private List<SecurityGroup> SecGroupOptions
    {
        get
        {
            var list = new List<SecurityGroup> { new() { SecGroupID = 0, Description = "-- Select --" } };
            list.AddRange(Groups);
            return list;
        }
    }

    // User Type dropdown — the seven fixed entries the raw <select> hardcoded.
    private static readonly List<IntOption> UserTypeOptions = new()
    {
        new() { Value = 1, Text = "1 - Administrators" },
        new() { Value = 2, Text = "2 - Sales Managers" },
        new() { Value = 3, Text = "3 - Accounting" },
        new() { Value = 4, Text = "4 - Sales People" },
        new() { Value = 5, Text = "5 - Design Center Sales" },
        new() { Value = 6, Text = "6 - Read Only" },
        new() { Value = 7, Text = "7 - Estimating" }
    };

    public class IntOption
    {
        public int Value { get; set; }
        public string Text { get; set; } = "";
    }

    // ── Models ───────────────────────────────────────────────────
    public class SecurityGroup
    {
        public long SecGroupID { get; set; }
        public string Description { get; set; } = "";
    }

    public class UserListItem
    {
        public string UserID { get; set; } = "";
        public string UserName { get; set; } = "";
    }

    public class DivisionItem
    {
        public long DivisionID { get; set; }
        public string DivisionCode { get; set; } = "";
        public string DivisionName { get; set; } = "";
        public bool Selected { get; set; }
    }

    public class SalesCommunityItem
    {
        public string Area { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Selected { get; set; }
    }

    public class PermissionItem
    {
        public string Page { get; set; } = "";
        public string Section { get; set; } = "";
