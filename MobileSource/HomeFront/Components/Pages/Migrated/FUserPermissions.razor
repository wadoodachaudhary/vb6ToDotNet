    // ── Lifecycle ────────────────────────────────────────────────
    // HHM-583: the Cognito token-claims decode that lived here moved to FCognito
    // (Setup → Cognito) along with the "Cognito Info" sub-tab content.
    // HHM-621: set when the logged-in user lacks ToolsUsrAdmin — the page
    // renders a denial message instead of the group/user editors.
    private bool _accessDenied;

    protected override async Task OnInitializedAsync()
    {
        // HHM-621: VB6 Application.EditSecurity requires ToolsUsrAdmin before
        // the form opens; enforce the same here so a hand-typed
        // /user-permissions URL can't bypass the greyed menu.
        if (!string.IsNullOrEmpty(SessionState.LoginID))
        {
            var canAdmin = await db.ExecuteScalarAsync<object>(
                "SELECT ISNULL(ToolsUsrAdmin, 0) FROM user_manager WHERE user_id = @UserID",
                new { UserID = SessionState.LoginID });
            if (!ToBoolPermission(canAdmin))
            {
                _accessDenied = true;
                IsLoading = false;
                return;
            }
        }

        // HHM-307: a checkbox toggle in the Sales Communities grid commits via
        // OnCellSave (FlexKit batch checkbox column, FAddPricelist gPOIndexes
        // pattern — the bound Selected is already flipped by the grid); route it
        // to the existing toggle handler (Dirty=e_user, VB6
        // gSalesCommunities_AfterEdit FUserPermissions.frm:2794-2796).
        _scGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<SalesCommunityItem>>(
            this, args =>
            {
                if (args.Data != null)
                    OnSalesCommunityToggled(args.Data, args.Data.Selected);
            });

        _divGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<DivisionItem>>(
            this, args =>
            {
                if (args.Data != null)
                    OnDivisionToggled(args.Data, args.Data.Selected);
            });

        InitializeTabs();
        await LoadDivisions();
        await LoadSalesCommunities();
        await InitPermissionDefinitions();
        await LoadGroups();
        CRMSeats = await GetCRMSeats();
        Dirty = DirtyState.None;
    }

    // user_manager permission bits come back as bit/int/null depending on the
    // driver path — normalize like VB6's CBool.
    private static bool ToBoolPermission(object? v) => v switch
    {
        null or DBNull => false,
        bool b => b,
        _ => Convert.ToInt32(v) != 0
    };

