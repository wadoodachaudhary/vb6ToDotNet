    private async Task CopyGroup()
    {
        if (SelectedGroup == null) return;
        try
        {
            var sql = @"
                DECLARE @column varchar(100)
                DECLARE @sql nvarchar(max)
                SET @sql=''
                DECLARE c CURSOR FOR
                SELECT column_name
                FROM information_schema.columns
                WHERE table_name='SecurityGroups'
                AND column_name NOT IN('SecGroupID','Description')
                OPEN c
                FETCH NEXT FROM c INTO @column
                WHILE @@fetch_status = 0
                BEGIN
                    SET @sql = @sql + ',[' + @column + ']'
                    FETCH NEXT FROM c INTO @column
                END
                CLOSE c
                DEALLOCATE c
                SET @sql = 'INSERT INTO SecurityGroups(Description' + @sql + ') SELECT ''Copy of ''+ISNULL(Description,'''') ' + @sql + ' FROM SecurityGroups WHERE SecGroupID=' + CAST(@SecGroupID AS VARCHAR)
                EXEC sp_executesql @sql";
            await db.ExecuteAsync(sql, new { SecGroupID = SelectedGroup.SecGroupID });

            var idRows = await db.QueryAsync("SELECT IDENT_CURRENT('SecurityGroups') AS ID");
            var newId = Convert.ToInt64(idRows.First()["ID"]);
            await LoadGroups();

            var newGroup = Groups.FirstOrDefault(g => g.SecGroupID == newId);
            if (newGroup != null)
            {
                SelectedGroup = newGroup;
                mSecGroupID = newId;
                StartEditGroup(newGroup);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error copying group: {ex.Message}");
        }
    }

