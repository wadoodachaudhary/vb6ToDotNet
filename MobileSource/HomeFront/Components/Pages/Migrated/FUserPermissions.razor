    private async Task SaveGroupDescription()
    {
        if (EditingGroupId == null) return;
        try
        {
            await db.ExecuteAsync(
                "UPDATE SecurityGroups SET Description=@Description WHERE SecGroupID=@SecGroupID",
                new { Description = EditingGroupDescription, SecGroupID = EditingGroupId });

            var group = Groups.FirstOrDefault(g => g.SecGroupID == EditingGroupId);
            if (group != null) group.Description = EditingGroupDescription;

            // HHM-275: VB6 refreshes the list with LoadGroups (ORDER BY Description) after
            // every group op, so a renamed group re-files alphabetically instead of staying
            // at its old "Copy of …" position. Re-sort in place — SelectedGroup keeps
            // pointing at the renamed instance.
            Groups = Groups.OrderBy(g => g.Description, StringComparer.OrdinalIgnoreCase).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SaveGroupDescription error");

        }
        EditingGroupId = null;
    }

