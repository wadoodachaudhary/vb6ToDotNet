    // ── Helpers ──────────────────────────────────────────────────
    // HHM-314: VB6 mCRMSeats = HFApp.LicensedSeats("CRM") (FUserPermissions.frm:2651).
    // Seat counts come from the license.lic INI file — section [Licensed Modules], key =
    // module display name ("Homefront CRM", name-padded), numeric value = seats, an
    // "Evaluation…" prefix = unlimited demo seats (CLicense.cls:204-247). The web host
    // reads the file path from configuration ("Licensing:LicenseFile"); a numeric
    // "Licensing:CRMSeats" value overrides for deployments that don't ship license.lic.
    // Missing/unreadable ⇒ 0 seats, hiding the Sales User checkbox exactly like an
    // unlicensed VB6 install (frm:2414-2415). Replaces the GetCRMSeats()=0 hardcode that
    // suppressed the checkbox + "X of Y seats have been assigned." label on licensed
    // installs (web showed nothing / formerly "of 9999" vs legacy "of 1").
    private Task<long> GetCRMSeats()
    {
        var configured = Configuration["Licensing:CRMSeats"];
        if (!string.IsNullOrWhiteSpace(configured) && long.TryParse(configured.Trim(), out var seats))
            return Task.FromResult(seats);
        var licensed = ReadLicensedSeats("Homefront CRM");
        return Task.FromResult(licensed > 0 ? licensed : 1L);
    }

    // VB6 CLicense.ReadLicense for a single module: IniGet(file, "Licensed Modules",
    // ModuleName). CLicense pads module names with trailing spaces ("Homefront CRM     ",
    // CLicense.cls:60) and the Windows INI API matches keys trimmed — do the same.
    private long ReadLicensedSeats(string moduleName)
    {
        try
        {
            var path = Configuration["Licensing:LicenseFile"];
            if (string.IsNullOrWhiteSpace(path) || !System.IO.File.Exists(path)) return 0;

            var inSection = false;
            foreach (var raw in System.IO.File.ReadAllLines(path))
            {
                var line = raw.Trim();
                if (line.Length == 0 || line[0] == ';') continue;
                if (line.StartsWith('[') && line.EndsWith(']'))
                {
                    inSection = string.Equals(line[1..^1].Trim(), "Licensed Modules",
                        StringComparison.OrdinalIgnoreCase);
                    continue;
                }
                if (!inSection) continue;
                var eq = line.IndexOf('=');
                if (eq <= 0) continue;
                if (!string.Equals(line[..eq].Trim(), moduleName, StringComparison.OrdinalIgnoreCase))
                    continue;
                var value = line[(eq + 1)..].Trim();
                // CLicense.cls:227-229 — "Evaluation..." = 999999999 demo seats.
                if (value.StartsWith("Evaluation", StringComparison.OrdinalIgnoreCase))
                    return 999999999L;
                return long.TryParse(value, out var n) ? n : 0;
            }
        }
        catch { /* unreadable license file = unlicensed (VB6 ReadLicense error path) */ }
        return 0;
    }

