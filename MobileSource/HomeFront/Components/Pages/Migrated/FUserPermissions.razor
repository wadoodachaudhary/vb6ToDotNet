    private static bool IsDescopedPermission(string page, string description)
    {
        if (page.Equals(TAB_SALES, StringComparison.OrdinalIgnoreCase))
        {
            return !description.Equals("Edit retail sales prices?", StringComparison.OrdinalIgnoreCase)
                && !description.Equals("Edit approved custom options?", StringComparison.OrdinalIgnoreCase);
        }

        if (!page.Equals(TAB_ADMIN, StringComparison.OrdinalIgnoreCase))
            return false;

        return description.Equals("Quality Builder", StringComparison.OrdinalIgnoreCase)
            || description.Equals("Workticket", StringComparison.OrdinalIgnoreCase)
            || description.Equals("Project Builder", StringComparison.OrdinalIgnoreCase);
    }

