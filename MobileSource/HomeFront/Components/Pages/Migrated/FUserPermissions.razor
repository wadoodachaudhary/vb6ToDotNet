    // HHM-297/298/302: FPickList OnSelected — mirrors VB6 FUserPermissions.frm:2231-2249:
    // read SecGroupID/LoginID off the picked row, jump to the group ("Group not loaded." if
    // absent, frm:2236-2239), then select the user ("User not loaded." if absent, frm:2244-2247).
    private async Task OnFindUserPicked(List<IDictionary<string, object>> rows)
    {
        if (rows == null || rows.Count == 0) return;
        var row = rows[0];

        // Column keys come back as SQL aliases — read case-insensitively.
        static object? Get(IDictionary<string, object> r, string key) =>
            r.FirstOrDefault(kv => string.Equals(kv.Key, key, StringComparison.OrdinalIgnoreCase)).Value;

        var secObj = Get(row, "SecGroupID");
        var secGroupId = secObj == null || secObj is DBNull ? 0L : Convert.ToInt64(secObj);
        var loginId = Get(row, "LoginID")?.ToString() ?? "";

        var group = Groups.FirstOrDefault(g => g.SecGroupID == secGroupId);
        if (group == null)
        {
            Notifications.Info("Group not loaded.");
            return;
        }

        await OnGroupSelected(group);

        var userItem = Users.FirstOrDefault(u => u.UserID.Equals(loginId, StringComparison.OrdinalIgnoreCase));
        if (userItem == null)
        {
            Notifications.Info("User not loaded.");
            return;
        }

        await OnUserSelected(userItem);
    }

