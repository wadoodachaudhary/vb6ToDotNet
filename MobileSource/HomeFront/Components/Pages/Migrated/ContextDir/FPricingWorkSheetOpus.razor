@page "/pricing-worksheet-opus"

@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Dynamic
@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject ILogger<FPricingWorkSheetOpus> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer Db

@if (IsLoading)
{
    <div class="loading">
        <div class="loading-spinner"></div>
        <span>Loading Worksheet...</span>
    </div>
}

<div class="tabs-container">
    <div class="tab-buttons">
        <button class="@(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">
            .NET
        </button>
        <button class="@(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">
            VB6
        </button>
    </div>

    <div class="tab-content">
        @if (activeTab == 1)
        {
            <!-- Toolbar -->
            <div class="toolbar-cntr">
                @if (WorksheetView == "Estimating")
                {
                    <button class="tbar-btn btn-primary" @onclick="OnAddClick">
                        <span>➕</span> Add
                    </button>
                    <button class="tbar-btn btn-danger" disabled="@(SelectedRow == null)" @onclick="OnRemoveClick">
                        <span>🗑</span> Remove
                    </button>
                    <div class="toolbar-sep"></div>
                }

                <button class="tbar-btn" @onclick="OnPreviewClick">
                    <span>🖨</span> Preview
                </button>

                @if (ShowCostsButton)
                {
                    <button class="tbar-btn" @onclick="OnCostsClick">
                        <span>📋</span> Costs
                    </button>
                }

                <button class="tbar-btn btn-success" disabled="@(!mDirty)" @onclick="OnSaveClick">
                    <span>💾</span> Save
                </button>

                @if (WorksheetView == "Estimating")
                {
                    <button class="tbar-btn" @onclick="OnSaveAsClick">
                        <span>💾</span> Save As
                    </button>
                }

                <button class="tbar-btn btn-info" @onclick="OnPublishClick">
                    <span>📤</span> Publish
                </button>

                <div class="toolbar-sep"></div>

                <button class="tbar-btn" @onclick="OnRefreshCostsClick">
                    <span>🔄</span> Rfrsh Costs
                </button>

                <button class="tbar-btn" @onclick="OnRefreshPublishedClick">
                    <span>🔄</span> Rfrsh Published
                </button>

                <div class="toolbar-sep"></div>

                <button class="tbar-btn" @onclick="OnExcelExport">
                    <span>📊</span> Export
                </button>
            </div>

            <h4 class="page-title">@WorksheetView Worksheet @(WorksheetId > 0 ? $"(number {WorksheetId})" : "(New)")</h4>

            <!-- Header Panel -->
            <div class="header-panel">
                <div class="row">
                    <!-- Left: Worksheet Info -->
                    <div class="col-md-3">
                        <div class="header-section">
                            <div class="header-section-title">Worksheet Info</div>
                            <div class="field-row">
                                <label>Description</label>
                                <input type="text" @bind="WorksheetDescription" placeholder="Description" maxlength="50"
                                       style="flex:1; padding:4px 8px; border:1px solid #c9c9c9; border-radius:4px;" />
                            </div>
                            <div class="field-row">
                                <label>Cost Basis</label>
                                <DropDownListControl TValue="int" TItem="CostBasisItem"
                                                @bind-Value="CostBasisType"
                                                DataSource="@CostBasisList"
                                                TextFieldName="Name" ValueFieldName="Id"
                                                Width="150px" />
                            </div>
                            <div class="field-row">
                                <label>Costs Effective</label>
                                <input type="text" readonly value="@CostsEffectiveDate.ToString("MMM d, yyyy")"
                                       class="readonly-field" style="flex:1; padding:4px 8px; border-radius:4px;" />
                            </div>
                            @if (WorksheetView == "Estimating")
                            {
                                <div class="field-row">
                                    <label>Published to Sales</label>
                                    <input type="text" readonly value="@(SalesEffectiveDate?.ToString("MMM d, yyyy") ?? "")"
                                           class="readonly-field" style="flex:1; padding:4px 8px; border-radius:4px;" />
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Center: Pricing Options -->
                    <div class="col-md-3">
                        <div class="header-section">
                            <div class="header-section-title">Pricing Options</div>
                            <div class="field-row">
                                <label>Round prices to</label>
                                <NumericTextBoxControl TValue="decimal" @bind-Value="RoundTo" Format="N0" Min="0"
                                                  Width="80px" />
                            </div>
                            @if (WorksheetView == "Estimating")
                            {
                                <div class="field-row">
                                    <label>Incentive Cost %</label>
                                    <NumericTextBoxControl TValue="decimal" @bind-Value="IncentiveCostPercent" Format="N2"
                                                      Min="0" Max="100" Width="80px"
                                                      Enabled="@IncentiveCostEnabled" />
                                </div>
                            }
                            <div class="field-row">
                                <label>Layout</label>
                                <DropDownListControl TValue="string" TItem="string"
                                                @bind-Value="SelectedLayout"
                                                DataSource="@LayoutList"
                                                Width="120px"
                                                ValueChange="OnLayoutChanged" />
                            </div>
                            <div class="field-row">
                                <label></label>
                                <CheckBoxControl @bind-Checked="IsArchived" Label="Archive this sheet" />
                            </div>
                        </div>
                    </div>

                    <!-- Right-Center: Price Change -->
                    <div class="col-md-3">
                        <div class="header-section">
                            <div class="header-section-title">Price Change</div>
                            <div class="field-row">
                                <label>By Dollar Value</label>
                                <NumericTextBoxControl TValue="decimal" @bind-Value="DollarChange" Format="C2" Width="100px"
                                                  ValueChange="OnDollarPriceChange" />
                            </div>
                            <div class="field-row">
                                <label>Percent Increase</label>
                                <NumericTextBoxControl TValue="decimal" @bind-Value="PercentIncrease" Format="N2"
                                                  Width="100px"
                                                  ValueChange="OnPercentPriceChange" />
                            </div>
                            <div class="field-row">
                                <label>Percent Decrease</label>
                                <NumericTextBoxControl TValue="decimal" @bind-Value="PercentDecrease" Format="N2"
                                                  Width="100px"
                                                  ValueChange="OnPercentPriceChange" />
                            </div>
                        </div>
                    </div>

                    <!-- Far Right: Legend -->
                    <div class="col-md-3">
                        <div class="header-section">
                            <div class="header-section-title">Legend</div>
                            @if (WorksheetType == WorksheetTypes.DesignCenter)
                            {
                                <div class="legend-grid">
                                    @foreach (var item in LegendItems)
                                    {
                                        <div class="legend-item @item.CssClass">@item.Name</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="legend-grid">
                                    <div class="legend-item col-new">New</div>
                                    <div class="legend-item col-published">Published</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Data Grid -->
            <div class="grid-container">
                <GridControl @ref="WorksheetGrid" TValue="WorksheetRow" DataSource="@WorksheetData"
                        AllowPaging="true" AllowSorting="true" AllowFiltering="true" AllowResizing="true"
                        AllowSelection="true" EnableHover="true"
                        Height="1450"
                        FilterSettingsRef="@worksheetFilterSettings"
                        PageSettingsRef="@worksheetPageSettings"
                        SelectionSettingsRef="@worksheetSelectionSettings"
                        EditSettingsRef="@worksheetEditSettings"
                        EventsRef="@worksheetEvents">

                    <GridColumnsBase>
                        <!-- Identity Columns -->
                        <GridColumn Field="@nameof(WorksheetRow.Community)" HeaderText="@CommunityLabel" Width="100px"
                                      IsPrimaryKey="true" AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.CommunityPhase)"
                                      HeaderText="@(CommunityLabel + " Phase")" Width="90px" AllowEditing="false"
                                      Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.Model)" HeaderText="Model" Width="100px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(WorksheetRow.Assembly)" HeaderText="Assembly" Width="120px"
                                      AllowEditing="false" />

                        @if (WorksheetView == "Estimating")
                        {
                            <GridColumn Field="@nameof(WorksheetRow.ModelDescription)" HeaderText="Model Desc"
                                          Width="150px" AllowEditing="false" />
                            <GridColumn Field="@nameof(WorksheetRow.Elevation)" HeaderText="Elevation" Width="90px"
                                          AllowEditing="false" Visible="false" />
                            <GridColumn Field="@nameof(WorksheetRow.OptionID)" HeaderText="Option" Width="100px"
                                          AllowEditing="false" Visible="false" />
                        }

                        <GridColumn Field="@nameof(WorksheetRow.Description)" HeaderText="Description" Width="200px" />
                        <GridColumn Field="@nameof(WorksheetRow.Category)" HeaderText="Category" Width="90px" />
                        <GridColumn Field="@nameof(WorksheetRow.CategoryDesc)" HeaderText="Category Desc" Width="120px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(WorksheetRow.IncludedOption)" HeaderText="Included" Width="80px"
                                      Type="ColumnType.CheckBox" AllowEditing="true" />
                        <GridColumn Field="@nameof(WorksheetRow.Inactive)" HeaderText="Inactive" Width="75px"
                                      Type="ColumnType.CheckBox" AllowEditing="true" />
                        <GridColumn Field="@nameof(WorksheetRow.ReadyToPublish)" HeaderText="Ready" Width="70px"
                                      Type="ColumnType.CheckBox" Visible="false" />

                        <GridColumn Field="@nameof(WorksheetRow.Series)" HeaderText="Series" Width="90px"
                                      Visible="false" />

                        <!-- Dimensions -->
                        <GridColumn Field="@nameof(WorksheetRow.FloorArea)" HeaderText="Floor Area" Width="90px"
                                      Format="N0" TextAlign="TextAlign.Right" Visible="false" />
                        @if (WorksheetView == "Estimating")
                        {
                            <GridColumn Field="@nameof(WorksheetRow.Bedrooms)" HeaderText="Beds" Width="60px"
                                          Format="N0" TextAlign="TextAlign.Right" Visible="false" />
                            <GridColumn Field="@nameof(WorksheetRow.Bathrooms)" HeaderText="Baths" Width="60px"
                                          Format="N1" TextAlign="TextAlign.Right" Visible="false" />
                            <GridColumn Field="@nameof(WorksheetRow.Style)" HeaderText="Style" Width="80px"
                                          Visible="false" />
                            <GridColumn Field="@nameof(WorksheetRow.ConstCutOff)" HeaderText="Const Cutoff" Width="100px"
                                          Format="C0" TextAlign="TextAlign.Right" Visible="false" />
                        }

                        <!-- Costs -->
                        <GridColumn Field="@nameof(WorksheetRow.LandCost)" HeaderText="Land Cost" Width="100px"
                                      Format="C2" TextAlign="TextAlign.Right" Visible="false" />
                        @if (WorksheetView == "Estimating")
                        {
                            <GridColumn Field="@nameof(WorksheetRow.ConstructionCost)" HeaderText="Const Cost"
                                          Width="100px" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false"
                                          Visible="false" />
                            <GridColumn Field="@nameof(WorksheetRow.IncentiveCost)" HeaderText="Incent Cost"
                                          Width="100px" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false"
                                          Visible="false" />
                        }
                        <GridColumn Field="@nameof(WorksheetRow.Cost)" HeaderText="Total Cost" Width="100px"
                                      Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                        <GridColumn Field="@nameof(WorksheetRow.CostPerFt)" HeaderText="Cost/SqFt" Width="90px"
                                      Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />

                        <!-- New Pricing (Primary Spec) -->
                        <GridColumn Field="@nameof(WorksheetRow.Pretax)" HeaderText="Pretax" Width="100px"
                                      Format="C2" TextAlign="TextAlign.Right" Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.Tax)" HeaderText="Tax" Width="80px" Format="C2"
                                      TextAlign="TextAlign.Right" AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.Total)" HeaderText="Total" Width="100px"
                                      Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.Profit)" HeaderText="Profit" Width="90px"
                                      Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                        <GridColumn Field="@nameof(WorksheetRow.Markup)" HeaderText="Markup %" Width="85px"
                                      Format="N2" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(WorksheetRow.Margin)" HeaderText="Margin %" Width="85px"
                                      Format="N2" TextAlign="TextAlign.Right" />

                        @if (WorksheetView == "Estimating")
                        {
                            <GridColumn Field="@nameof(WorksheetRow.InSpec)" HeaderText="In Spec" Width="70px"
                                          Type="ColumnType.CheckBox" Visible="false" />
                        }

                        <GridColumn Field="@nameof(WorksheetRow.IncentiveRetail)" HeaderText="Incent Retail"
                                      Width="100px" Format="C2" TextAlign="TextAlign.Right" Visible="false" />

                        <!-- Change Order Pricing -->
                        <GridColumn Field="@nameof(WorksheetRow.COPretax)" HeaderText="CO Pretax" Width="100px"
                                      Format="C2" TextAlign="TextAlign.Right" Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.COTax)" HeaderText="CO Tax" Width="80px" Format="C2"
                                      TextAlign="TextAlign.Right" AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.COTotal)" HeaderText="CO Total" Width="100px"
                                      Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.COMarkup)" HeaderText="CO Markup %" Width="95px"
                                      Format="N2" TextAlign="TextAlign.Right" Visible="false" />

                        <!-- Published Pricing -->
                        <GridColumn Field="@nameof(WorksheetRow.PublishedPretax)" HeaderText="Pub Pretax"
                                      Width="100px" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false"
                                      Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.PublishedTax)" HeaderText="Pub Tax" Width="80px"
                                      Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.PublishedPrice)" HeaderText="Pub Price"
                                      Width="100px" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false"
                                      Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.PublishedProfit)" HeaderText="Pub Profit"
                                      Width="95px" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false"
                                      Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.PublishedMarkup)" HeaderText="Pub Markup %"
                                      Width="100px" Format="N2" TextAlign="TextAlign.Right" AllowEditing="false"
                                      Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.PublishedMargin)" HeaderText="Pub Margin %"
                                      Width="100px" Format="N2" TextAlign="TextAlign.Right" AllowEditing="false"
                                      Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.PublishedCOPrice)" HeaderText="Pub CO Price"
                                      Width="100px" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false"
                                      Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.PublishedIncentive)" HeaderText="Pub Incentive"
                                      Width="100px" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false"
                                      Visible="false" />

                        <GridColumn Field="@nameof(WorksheetRow.PricePerFt)" HeaderText="Price/SqFt" Width="90px"
                                      Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                        <GridColumn Field="@nameof(WorksheetRow.RoundTo)" HeaderText="Round To" Width="80px"
                                      Format="N0" TextAlign="TextAlign.Right" />

                        <!-- Additional Fields -->
                        <GridColumn Field="@nameof(WorksheetRow.AssemblyUOM)" HeaderText="UOM" Width="70px"
                                      Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.Color)" HeaderText="Color" Width="90px"
                                      Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.Location)" HeaderText="Location" Width="90px"
                                      Visible="false" />
                        <GridColumn Field="@nameof(WorksheetRow.Qty)" HeaderText="Qty" Width="60px" Format="N0"
                                      TextAlign="TextAlign.Right" Visible="false" />

                        @if (WorksheetView == "Estimating")
                        {
                            <GridColumn Field="@nameof(WorksheetRow.Notes)" HeaderText="Notes" Width="150px">
                                <Template>
                                    @{
                                        var notesRow = (WorksheetRow)context;
                                    }
                                    <span title="@notesRow.Notes">@TruncateText(notesRow.Notes, 20)</span>
                                    <button class="tbar-btn" style="padding:2px 6px; font-size:11px;"
                                            @onclick="@(() => OnEditText(notesRow, "Notes"))">✏️</button>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorksheetRow.Comments)" HeaderText="Comments" Width="150px">
                                <Template>
                                    @{
                                        var commentsRow = (WorksheetRow)context;
                                    }
                                    <span title="@commentsRow.Comments">@TruncateText(commentsRow.Comments, 20)</span>
                                    <button class="tbar-btn" style="padding:2px 6px; font-size:11px;"
                                            @onclick="@(() => OnEditText(commentsRow, "Comments"))">✏️</button>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorksheetRow.JCExtra)" HeaderText="JC Extra" Width="90px"
                                          Visible="false" />
                        }

                        @if (ShowIncludeTax)
                        {
                            <GridColumn Field="@nameof(WorksheetRow.IncludeTax)" HeaderText="Tax Incl" Width="75px"
                                          Type="ColumnType.CheckBox" />
                        }

                        <GridColumn Field="@nameof(WorksheetRow.RowState)" Visible="false" />
                    </GridColumnsBase>
                </GridControl>
            </div>
        }
        else if (activeTab == 2)
        {
            <div class="panel">
                <img src="images/VB6/Screen_IndexPricingWorkSheet.png" class="task-icon-vb6" />
            </div>
        }
    </div>
</div>

<!-- Text Edit Dialog -->
<DialogControl @bind-Visible="IsTextDialogVisible" Width="550px" Header="@TextDialogTitle"
          IsModal="true" ShowCloseIcon="true" CloseOnEscape="true">
    <ChildContent>
        <textarea @bind="EditingText" rows="6" placeholder="Enter text..."
                  style="width:100%; padding:8px; border:1px solid #c9c9c9; border-radius:4px; resize:vertical;"></textarea>
    </ChildContent>
    <FooterContent>
        <button class="tbar-btn btn-primary" @onclick="OnTextDialogOk">OK</button>
        <button class="tbar-btn" @onclick="@(() => IsTextDialogVisible = false)">Cancel</button>
    </FooterContent>
</DialogControl>

<!-- Add Assembly Dialog -->
<DialogControl @bind-Visible="IsAddDialogVisible" Width="600px" Header="Add Assembly to Worksheet"
          IsModal="true" ShowCloseIcon="true" CloseOnEscape="true">
    <ChildContent>
        <div class="mb-3">
            <label class="form-label">@CommunityLabel:</label>
            <DropDownListControl TValue="string" TItem="CommunityItem"
                            @bind-Value="AddCommunity"
                            DataSource="@CommunityList"
                            TextFieldName="Description" ValueFieldName="Area"
                            Placeholder="Select" />
        </div>
        <div class="mb-3">
            <label class="form-label">Model:</label>
            <DropDownListControl TValue="string" TItem="ModelItem"
                            @bind-Value="AddModel"
                            DataSource="@ModelList"
                            TextFieldName="Description" ValueFieldName="Model"
                            Placeholder="Select"
                            ValueChange="OnAddModelChanged" />
        </div>
        <div class="mb-3">
            <label class="form-label">Assembly:</label>
            <DropDownListControl TValue="string" TItem="AssemblyItem"
                            @bind-Value="AddAssembly"
                            DataSource="@AssemblyList"
                            TextFieldName="Description" ValueFieldName="Assembly"
                            Placeholder="Select" />
        </div>
    </ChildContent>
    <FooterContent>
        <button class="tbar-btn btn-primary" @onclick="OnAddAssemblyConfirm">Add</button>
        <button class="tbar-btn" @onclick="@(() => IsAddDialogVisible = false)">Cancel</button>
    </FooterContent>
</DialogControl>

@code {
    // === Route Parameters ===
    [Parameter] public int WorksheetId { get; set; } = 80;
    [Parameter] public string ViewMode { get; set; } = "Estimating";

    // === Database ===
    private int activeTab = 1;

    // === UI State ===
    private bool IsLoading = false;
    private bool mDirty = false;
    private bool IsReadOnly = false;
    private GridControl<WorksheetRow>? WorksheetGrid;

    // === Worksheet Properties ===
    private string WorksheetView = "Estimating";
    private WorksheetTypes WorksheetType = WorksheetTypes.General;
    private string WorksheetDescription = "New Worksheet";
    private int CostBasisType = 0;
    private DateTime CostsEffectiveDate = DateTime.Now;
    private DateTime? SalesEffectiveDate = null;
    private decimal RoundTo = 0;
    private decimal IncentiveCostPercent = 0;
    private decimal DollarChange = 0;
    private decimal PercentIncrease = 0;
    private decimal PercentDecrease = 0;
    private bool IsArchived = false;
    private string SelectedLayout = "General";
    private string CommunityLabel = "Community";
    private bool ShowIncludeTax = false;
    private bool ShowCostsButton = true;
    private bool IncentiveCostEnabled = true;

    // === Data Sources ===
    private List<WorksheetRow> WorksheetData = new();
    private List<CostBasisItem> CostBasisList = new();
    private List<string> LayoutList = new() { "General", "Detailed", "Summary" };
    private List<LegendItem> LegendItems = new();
    private List<CommunityItem> CommunityList = new();
    private List<ModelItem> ModelList = new();
    private List<AssemblyItem> AssemblyList = new();

    // === Selection ===
    private WorksheetRow? SelectedRow;

    // === Dialog State ===
    private bool IsTextDialogVisible = false;
    private string TextDialogTitle = "";
    private string EditingText = "";
    private WorksheetRow? EditingTextRow;
    private string EditingTextField = "";
    private bool IsAddDialogVisible = false;
    private string AddCommunity = "";
    private string AddModel = "";
    private string AddAssembly = "";

    // === Grid Settings ===
    private readonly FilterSettings worksheetFilterSettings = new() { Type = FilterType.FilterBar };
    private readonly PageSettings worksheetPageSettings = new() { PageSize = 50 };
    private readonly SelectionSettings worksheetSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };
    private readonly EditSettings worksheetEditSettings = new()
    {
        AllowAdding = true,
        AllowEditing = true,
        AllowDeleting = true,
        ShowConfirmDialog = true
    };
    private readonly GridControlEvents<WorksheetRow> worksheetEvents = new();

    // === Enums ===
    public enum WorksheetTypes
    {
        General = 0,
        DesignCenter = 1
    }

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        // Wire events
        worksheetEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<WorksheetRow>>(this, OnRowSelected);
        worksheetEvents.RowDeselected = EventCallback.Factory.Create<RowSelectEventArgs<WorksheetRow>>(this, OnRowDeselected);
        worksheetEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<WorksheetRow>>(this, OnCellSaved);
        worksheetEvents.QueryCellInfo = EventCallback.Factory.Create<QueryCellInfoEventArgs<WorksheetRow>>(this, OnQueryCellInfo);

        WorksheetId = 80;
        WorksheetView = ViewMode ?? "Estimating";
        InitializeCostBasis();
        InitializeLegend();
        await LoadLookupDataAsync();
        await LoadDataAsync();
    }

    private void InitializeCostBasis()
    {
        CostBasisList = new List<CostBasisItem>
        {
            new() { Id = 0, Name = "Estimated Cost" },
            new() { Id = 1, Name = "Actual Cost" },
            new() { Id = 2, Name = "Budget Cost" }
        };
    }

    private void InitializeLegend()
    {
        LegendItems = new List<LegendItem>
        {
            new() { Name = "Spec 1", CssClass = "col-new" },
            new() { Name = "Spec 2", CssClass = "col-spec2" },
            new() { Name = "Spec 3", CssClass = "col-spec3" },
            new() { Name = "Spec 4", CssClass = "col-spec4" },
            new() { Name = "Spec 5", CssClass = "col-spec5" },
            new() { Name = "Spec 6", CssClass = "col-spec6" },
            new() { Name = "Published", CssClass = "col-published" }
        };
    }

    private async Task LoadLookupDataAsync()
    {
        try
        {
            // Communities
            var comms = await Db.QueryAsync("SELECT Area, Description FROM tblLocality WHERE ISNULL(Inactive,0)=0 ORDER BY Description");
            CommunityList = comms.Select(r => new CommunityItem
            {
                Area = r["Area"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? ""
            }).ToList();

            // Models
            var models = await Db.QueryAsync(
                "SELECT DISTINCT Model, Description FROM tblDBAssemblyMaster WHERE DivisionID = @DivisionID ORDER BY Model",
                new { DivisionID = SessionState.DivisionID });
            ModelList = models.Select(r => new ModelItem
            {
                Model = r["Model"]?.ToString() ?? "",
                Description = $"{r["Model"]} - {r["Description"]}"
            }).ToList();

            // Custom labels
            var label = await Db.ExecuteScalarAsync<string>("SELECT ISNULL(NULLIF(custom_description,''),'Community') FROM customdescriptions WHERE item='Community'");
            if (!string.IsNullOrEmpty(label)) CommunityLabel = label;

            // Include tax setting
            var taxSetting = await Db.ExecuteScalarAsync<string>($"SELECT ISNULL(IncludeTax,0) FROM system_setup WHERE id={SessionState.DivisionID}");
            ShowIncludeTax = taxSetting == "True" || taxSetting == "1";

            IncentiveCostEnabled = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadLookupDataAsync error");

        }
    }

    private async Task LoadDataAsync()
    {
        if (WorksheetId == 0) return;
        IsLoading = true;
        StateHasChanged();
        try
        {
            // Load master
            var masterRows = await Db.QueryAsync(
                "SELECT * FROM tblSalesSheetMaster WHERE Worksheet=@WorksheetId",
                new { WorksheetId });
            if (masterRows.Any())
            {
                var m = masterRows.First();
                IsArchived = m["Inactive"]?.ToString() == "True";
                WorksheetDescription = m["Description"]?.ToString() ?? "New Worksheet";
                CostBasisType = m["CostBasisType"] != null && m["CostBasisType"] != DBNull.Value
                    ? Convert.ToInt32(m["CostBasisType"]) : 0;
                IncentiveCostPercent = m["IncentiveCostPercent"] != null && m["IncentiveCostPercent"] != DBNull.Value
                    ? Convert.ToDecimal(m["IncentiveCostPercent"]) : 0;
                if (m["CostsEffectiveDate"] != null && m["CostsEffectiveDate"] != DBNull.Value)
                    CostsEffectiveDate = Convert.ToDateTime(m["CostsEffectiveDate"]);
                if (m["SalesEffectiveDate"] != null && m["SalesEffectiveDate"] != DBNull.Value)
                    SalesEffectiveDate = Convert.ToDateTime(m["SalesEffectiveDate"]);
            }

            // Check read-only
            IsReadOnly = SalesEffectiveDate.HasValue;

            // Load details
            var sql = $@"
                SELECT l.Description AS CommunityDesc, c.Description AS CategoryDesc,
                       dm.Description AS ModelDescription, d.*
                FROM tblSalesSheetDetails d
                JOIN tblSalesSheetMaster m ON m.Worksheet = d.Worksheet
                LEFT JOIN tblLocality l ON d.Community = l.Area
                LEFT JOIN tblCategories c ON d.Category = c.Category
                LEFT JOIN distinctmodelsByDivision dm ON dm.DivisionID = m.DivisionID AND d.Model = dm.Model
                WHERE d.Worksheet = {WorksheetId}
                ORDER BY d.Model, d.Assembly";
            var rows = await Db.QueryAsync(sql);
            Console.WriteLine("LoadDataAsync Before Worksheet data read");

            WorksheetData = rows.Select(r => MapRowFromDb(r)).ToList();
            Console.WriteLine("LoadDataAsync Worksheet data read");


            mDirty = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadDataAsync error");

            Notifications.Error($"Error loading worksheet: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private WorksheetRow MapRowFromDb(Dictionary<string, object> r)
    {
        return new WorksheetRow
        {
            Community = r["Community"]?.ToString() ?? "",
            CommunityPhase = r["CommunityPhase"]?.ToString() ?? "",
            CommunityDesc = r["CommunityDesc"]?.ToString() ?? "",
            SourceCommunity = r["SourceCommunity"]?.ToString() ?? "",
            Assembly = r["Assembly"]?.ToString() ?? "",
            AssemblyUOM = r["AssemblyUOM"]?.ToString() ?? "",
            Model = r["Model"]?.ToString() ?? "",
            ModelDescription = r["ModelDescription"]?.ToString() ?? "",
            Elevation = r["Elevation"]?.ToString() ?? "",
            OptionID = r["OptionID"]?.ToString() ?? "",
            AssemblyType = SafeInt(r["AssemblyType"]),
            Description = r["Description"]?.ToString() ?? "",
            Notes = r["Notes"]?.ToString() ?? "",
            Comments = r["Comments"]?.ToString() ?? "",
            Category = r["Category"]?.ToString() ?? "",
            CategoryDesc = r["CategoryDesc"]?.ToString() ?? "",
            Series = r["Series"]?.ToString() ?? "",
            Style = r["Style"]?.ToString() ?? "",
            FloorArea = SafeInt(r["FloorArea"]),
            Bedrooms = SafeInt(r["Bedrooms"]),
            Bathrooms = SafeDecimal(r["Bathrooms"]),
            ConstCutOff = SafeDecimal(r["ConstCutOff"]),
            JCExtra = r["JCExtra"]?.ToString() ?? "",
            LandCost = SafeDecimal(r["LandCost"]),
            ConstructionCost = SafeDecimal(r["ConstructionCost"]),
            IncentiveCost = SafeDecimal(r["IncentiveCost"]),
            IncentiveRetail = SafeDecimal(r["IncentiveRetail"]),
            Cost = SafeDecimal(r["Cost"]),
            Pretax = SafeDecimal(r["Pretax"]),
            Tax = SafeDecimal(r["Tax"]),
            Markup = SafeDecimal(r["Markup"]),
            Margin = SafeDecimal(r["Margin"]),
            RoundTo = SafeDecimal(r["Roundto"]),
            COPretax = SafeDecimal(r["COPretax"]),
            COTax = SafeDecimal(r["COTax"]),
            COMarkup = SafeDecimal(r["COMarkup"]),
            Qty = SafeDecimal(r["Qty"], 1),
            Color = r["Color"]?.ToString() ?? "",
            Location = r["Location"]?.ToString() ?? "",
            IncludedOption = (r["IncludedOption"]?.ToString() ?? "") != "1",
            Inactive = (r["Inactive"]?.ToString() ?? "") != "1",
            ReadyToPublish = r["ReadyToPublish"]?.ToString() == "True",
            IncludeTax = r["IncludeTax"]?.ToString() == "True",
            InSpec = r["IncludedInSpec"]?.ToString() == "True",
            PublishedPretax = SafeDecimal(r.ContainsKey("PublishedPretax") ? r["PublishedPretax"] : null),
            PublishedTax = SafeDecimal(r.ContainsKey("PublishedTax") ? r["PublishedTax"] : null),
            PublishedPrice = SafeDecimal(r.ContainsKey("PublishedPrice") ? r["PublishedPrice"] : null),
            RowState = "CLEAN"
        };
    }

    private void CalculateDerivedFields(WorksheetRow row)
    {
        row.Total = row.Pretax + row.Tax;
        row.COTotal = row.COPretax + row.COTax;
        row.Profit = row.Pretax - row.Cost;
        if (row.FloorArea > 0)
        {
            row.CostPerFt = row.ConstructionCost / row.FloorArea;
            row.PricePerFt = row.Pretax / row.FloorArea;
        }
    }

    private async Task<bool> SaveDataAsync()
    {
        if (!mDirty) return true;
        IsLoading = true;
        StateHasChanged();
        try
        {
            // Update master
            await Db.ExecuteAsync($@"
                UPDATE tblSalesSheetMaster SET
                    Description=@Description, CostBasisType=@CostBasisType,
                    IncentiveCostPercent=@IncentiveCostPercent, Inactive=@Inactive
                WHERE Worksheet={WorksheetId}",
                new { WorksheetDescription, CostBasisType, IncentiveCostPercent, Inactive = IsArchived });

            // Update dirty details
            foreach (var row in WorksheetData.Where(r => r.RowState == "DIRTY"))
            {
                await Db.ExecuteAsync($@"
                    UPDATE tblSalesSheetDetails SET
                        Description=@Description, Notes=@Notes, Comments=@Comments, Category=@Category,
                        Series=@Series, Style=@Style, FloorArea=@FloorArea, Bedrooms=@Bedrooms, Bathrooms=@Bathrooms,
                        LandCost=@LandCost, Pretax=@Pretax, Tax=@Tax, Markup=@Markup, Margin=@Margin, Roundto=@RoundTo,
                        COPretax=@COPretax, COTax=@COTax, COMarkup=@COMarkup, Qty=@Qty, Color=@Color, Location=@Location,
                        IncludedOption=@IncludedOption, Inactive=@Inactive, ReadyToPublish=@ReadyToPublish,
                        IncludeTax=@IncludeTax, IncludedInSpec=@InSpec
                    WHERE Worksheet={WorksheetId} AND Community=@Community AND Assembly=@Assembly AND ISNULL(OptionID,'')=@OptionID",
                    new
                    {
                        row.Description, row.Notes, row.Comments, row.Category, row.Series, row.Style,
                        row.FloorArea, row.Bedrooms, row.Bathrooms, row.LandCost, row.Pretax, row.Tax,
                        row.Markup, row.Margin, row.RoundTo, row.COPretax, row.COTax, row.COMarkup,
                        row.Qty, row.Color, row.Location, row.IncludedOption, row.Inactive, row.ReadyToPublish,
                        row.IncludeTax, row.InSpec, row.Community, row.Assembly, OptionID = row.OptionID ?? ""
                    });
                row.RowState = "CLEAN";
            }
            mDirty = false;
            Notifications.Info("Worksheet saved successfully.");
            return true;
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error saving: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

