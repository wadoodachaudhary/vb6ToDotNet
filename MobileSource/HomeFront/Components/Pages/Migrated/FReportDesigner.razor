@* ─────────────────────────────────────────────────────────────────
   FlexKit Crystal XML report designer host.
   Opens the selected report XML inside ReportDesignerControl and saves
   design changes back to the XML file only when the designer applies XML.
   ───────────────────────────────────────────────────────────────── *@
@page "/report-designer"
@page "/report-designer/{ReportFile}"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using HomeFront.Data
@using Fx.ControlKit.Mdi
@using Fx.ControlKit.Notifications
@using Fx.ControlKit.Reports
@using Microsoft.AspNetCore.Components.Routing
@using System.Xml.Linq

@implements IMdiCloseGuard

@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Env
@inject ILogger<FReportDesigner> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer Db

<PageTitle>@_title - Report Designer</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges"
                OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<div class="hf-report-designer-page">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="hf-report-designer-error">
            <strong>Unable to open report designer</strong>
            <span>@_error</span>
        </div>
    }
    else
    {
        <ReportDesignerControl @ref="_designerControl"
                               XmlPath="@_xmlPath"
                               AvailableDataSources="@_availableDataSources"
                               DocumentChanged="OnDesignerDocumentChanged"
                               XmlChanged="SaveDesignedXmlAsync"
                               PreviewRequested="PreviewDesignedReportAsync" />
    }
</div>

<MessageBoxControl @ref="_closeMessageBox" />

@code {
    [Parameter] public string? ReportFile { get; set; }

    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    [CascadingParameter(Name = "SetPageTitle")]
    private Action<string?>? SetPageTitle { get; set; }

    private string? _lastReportFile;
    private string _xmlPath = "";
    private string _title = "Report Designer";
    private string? _error;
    private List<ReportDesignerDataTable> _availableDataSources = new();
    private ReportDesignerControl? _designerControl;
    private ReportDesignerDocument? _designerDocument;
    private MessageBoxControl? _closeMessageBox;
    private bool _navigationPromptSuppressed;

    public bool IsDirty => _designerDocument?.IsDirty == true;
    public bool HasUnsavedChanges => IsDirty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableDataSourcesAsync();
    }

    protected override void OnParametersSet()
    {
        var decoded = string.IsNullOrWhiteSpace(ReportFile) ? null : Uri.UnescapeDataString(ReportFile);
        if (string.Equals(decoded, _lastReportFile, StringComparison.OrdinalIgnoreCase))
            return;

        _lastReportFile = decoded;
        _error = null;
        _xmlPath = "";

        if (string.IsNullOrWhiteSpace(decoded))
        {
            _title = "Report Designer";
            _xmlPath = "";
            _designerDocument = null;
            SetPageTitle?.Invoke("Report Designer");
            Logger.LogInformation("Opening blank report designer");
            return;
        }

        _xmlPath = ResolveXmlPath(decoded);
        if (string.IsNullOrWhiteSpace(_xmlPath) || !File.Exists(_xmlPath))
        {
            _error = $"Could not resolve XML report file for: {decoded}";
            SetPageTitle?.Invoke("Report Designer");
            return;
        }

        _title = $"Design: {Path.GetFileNameWithoutExtension(_xmlPath)}";
        _designerDocument = null;
        SetPageTitle?.Invoke(_title);
        Logger.LogInformation("Opening report designer for {XmlPath}", _xmlPath);
    }

    private async Task SaveDesignedXmlAsync(string xml)
    {
        await SaveDesignedXmlCoreAsync(xml);
    }

    public async Task<bool> SaveDataAsync(bool prompt = false)
    {
        if (prompt && HasUnsavedChanges)
            return await ConfirmSaveDiscardCancelAsync();

        if (_designerControl is null)
        {
            Notifications.Error("Unable to save report design", "The designer is not ready.");
            return false;
        }

        var xml = _designerControl.ExportXml();
        return await SaveDesignedXmlCoreAsync(xml);
    }

    public async Task<bool> CanCloseMdiWindowAsync(MdiCloseContext context)
    {
        return await ConfirmSaveDiscardCancelAsync();
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (_navigationPromptSuppressed || !HasUnsavedChanges)
            return;

        context.PreventNavigation();
        if (await ConfirmSaveDiscardCancelAsync())
        {
            _navigationPromptSuppressed = true;
            NavigationManager.NavigateTo(context.TargetLocation);
        }
    }

    private async Task<bool> ConfirmSaveDiscardCancelAsync()
    {
        if (!HasUnsavedChanges)
            return true;

        if (_closeMessageBox is null)
            return false;

        var reportName = string.IsNullOrWhiteSpace(_xmlPath)
            ? "Untitled Report"
            : Path.GetFileNameWithoutExtension(_xmlPath);

        var result = await _closeMessageBox.ShowAsync(
            $"The report design \"{reportName}\" has unsaved changes.\n\nDo you want to save before closing?",
            title: "Save report design?",
            buttons: MessageBoxButtons.YesNoCancel);

        return result switch
        {
            MessageBoxResult.Cancel => false,
            MessageBoxResult.No => true,
            MessageBoxResult.Yes => await SaveDataAsync(prompt: false),
            _ => false
        };
    }

    private Task OnDesignerDocumentChanged(ReportDesignerDocument document)
    {
        _designerDocument = document;
        return Task.CompletedTask;
    }

    private async Task<bool> SaveDesignedXmlCoreAsync(string xml)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_xmlPath))
                _xmlPath = ResolveNewReportPath(xml);

            var backupDir = Path.Combine(Path.GetDirectoryName(_xmlPath) ?? Env.ContentRootPath, ".designer-backups");
            Directory.CreateDirectory(backupDir);

            if (File.Exists(_xmlPath))
            {
                var stamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
                var backupPath = Path.Combine(backupDir, $"{Path.GetFileNameWithoutExtension(_xmlPath)}.{stamp}.xml");
                File.Copy(_xmlPath, backupPath, overwrite: false);
            }

            await File.WriteAllTextAsync(_xmlPath, xml);
            _title = $"Design: {Path.GetFileNameWithoutExtension(_xmlPath)}";
            SetPageTitle?.Invoke(_title);
            Notifications.Info("Report design saved", Path.GetFileName(_xmlPath));
            Logger.LogInformation("Saved designed report XML {XmlPath}", _xmlPath);
            if (_designerDocument is not null)
                _designerDocument.IsDirty = false;
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save designed report XML {XmlPath}", _xmlPath);
            Notifications.Error("Unable to save report design", ex.Message);
            return false;
        }
    }

    private Task PreviewDesignedReportAsync(ReportDesignerDocument document)
    {
        if (string.IsNullOrWhiteSpace(_xmlPath))
            return Task.CompletedTask;

        var url = $"/report-viewer/{Uri.EscapeDataString(_xmlPath)}";
        if (ParentNavigate != null)
            ParentNavigate.Invoke(url);
        else
            NavigationManager.NavigateTo(url);

        return Task.CompletedTask;
    }

    private string ResolveXmlPath(string reportFile)
    {
        var candidate = reportFile;
        if (!Path.IsPathRooted(candidate))
            candidate = Path.Combine(Env.WebRootPath, candidate.Replace('/', Path.DirectorySeparatorChar));

        if (File.Exists(candidate) && string.Equals(Path.GetExtension(candidate), ".xml", StringComparison.OrdinalIgnoreCase))
            return candidate;

        var baseName = Path.GetFileNameWithoutExtension(candidate);
        if (string.IsNullOrWhiteSpace(baseName))
            return candidate;

        if (File.Exists(candidate) && string.Equals(Path.GetExtension(candidate), ".rpt", StringComparison.OrdinalIgnoreCase))
        {
            var folder = Path.GetDirectoryName(candidate) ?? "";
            var parent = Directory.GetParent(folder)?.FullName ?? folder;
            var siblingXml = Path.Combine(parent, "xml", baseName + ".xml");
            if (File.Exists(siblingXml))
                return siblingXml;
        }

        var canonical = Path.Combine(Env.WebRootPath, "resources", "Estimating", "Reports", "xml", baseName + ".xml");
        return canonical;
    }

    private async Task LoadAvailableDataSourcesAsync()
    {
        try
        {
            var rows = await Db.QueryAsync("""
                SELECT
                    s.name AS SchemaName,
                    t.name AS TableName,
                    c.name AS ColumnName,
                    ty.name AS DataType,
                    c.column_id AS ColumnId
                FROM sys.tables t
                INNER JOIN sys.schemas s ON s.schema_id = t.schema_id
                INNER JOIN sys.columns c ON c.object_id = t.object_id
                INNER JOIN sys.types ty ON ty.user_type_id = c.user_type_id
                WHERE t.is_ms_shipped = 0
                ORDER BY t.name, c.column_id
                """);

            _availableDataSources = rows
                .GroupBy(row => new
                {
                    Schema = Value(row, "SchemaName"),
                    Table = Value(row, "TableName")
                })
                .OrderBy(group => group.Key.Table, StringComparer.OrdinalIgnoreCase)
                .Select(group => new ReportDesignerDataTable
                {
                    Schema = group.Key.Schema,
                    Name = group.Key.Table,
                    Fields = group
                        .OrderBy(row => Convert.ToInt32(row["ColumnId"]))
                        .Select(row => new ReportDesignerField
                        {
                            Name = Value(row, "ColumnName"),
                            Table = group.Key.Table,
                            LongName = $"{group.Key.Schema}.{group.Key.Table}.{Value(row, "ColumnName")}",
                            Type = MapSqlType(Value(row, "DataType"))
                        })
                        .ToList()
                })
                .Where(table => !string.IsNullOrWhiteSpace(table.Name) && table.Fields.Count > 0)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to load report designer data source schema");
            _availableDataSources = new();
        }
    }

    private string ResolveNewReportPath(string xml)
    {
        var title = ExtractReportTitle(xml);
        var fileName = MakeSafeFileName(title) + ".xml";
        var xmlDir = Path.Combine(Env.WebRootPath, "resources", "Estimating", "Reports", "xml");
        Directory.CreateDirectory(xmlDir);

        var path = Path.Combine(xmlDir, fileName);
        var counter = 2;
        while (File.Exists(path))
        {
            path = Path.Combine(xmlDir, $"{Path.GetFileNameWithoutExtension(fileName)} {counter}.xml");
            counter++;
        }

        return path;
    }

    private static string ExtractReportTitle(string xml)
    {
        try
        {
            var root = XDocument.Parse(xml).Root;
            var title = root?.Element("Summaryinfo")?.Attribute("ReportTitle")?.Value
                ?? root?.Attribute("Name")?.Value;
            return string.IsNullOrWhiteSpace(title) ? "Untitled Report" : title;
        }
        catch
        {
            return "Untitled Report";
        }
    }

    private static string MakeSafeFileName(string value)
    {
        var invalid = Path.GetInvalidFileNameChars().ToHashSet();
        var safe = new string((value ?? "Untitled Report")
            .Select(ch => invalid.Contains(ch) ? '_' : ch)
            .ToArray()).Trim();
        return string.IsNullOrWhiteSpace(safe) ? "Untitled Report" : safe;
    }

    private static string Value(Dictionary<string, object> row, string key)
    {
        return row.TryGetValue(key, out var value) ? value?.ToString() ?? "" : "";
    }

    private static string MapSqlType(string sqlType)
    {
        return sqlType.ToLowerInvariant() switch
        {
            "bigint" or "int" or "smallint" or "tinyint" or "decimal" or "numeric" or "money" or "smallmoney" or "float" or "real" => "Number",
            "bit" => "Boolean",
            "date" => "Date",
            "datetime" or "datetime2" or "smalldatetime" or "datetimeoffset" or "time" => "DateTime",
            _ => "String"
        };
    }
}
