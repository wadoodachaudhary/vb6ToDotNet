@namespace HomeFront.Components.Pages

@using System
@using System.IO
@using System.Diagnostics
@using System.Timers
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject ILogger<FTSObject> Logger
@inject NotificationService Notifications

@implements IDisposable

<div class="fts-container">
    <div class="fts-header">
        <img src="images/32/processing.ico" class="fts-icon" alt="Processing"
             onerror="this.style.display='none'" />
        <span class="fts-title">@(string.IsNullOrEmpty(mTitle) ? "Processing..." : mTitle)</span>
    </div>

    <div class="fts-status">
        @if (string.IsNullOrEmpty(StatusText))
        {
            <span>Initializing...</span>
        }
        else
        {
            @StatusText
        }
    </div>

    @if (!mFinished)
    {
        <div class="fts-processing">
            <div class="fts-spinner"></div>
            <span>Processing, please wait...</span>
        </div>
    }
    else
    {
        <div class="fts-processing" style="color: #28a745;">
            <span>✔ Processing complete.</span>
        </div>
    }
</div>

@code {
    // === Parameters ===
    [Parameter] public string DataFolder { get; set; } = "";
    [Parameter] public string UserID { get; set; } = "";
    [Parameter] public string Pswd { get; set; } = "";
    [Parameter] public string LaunchFile { get; set; } = "";
    [Parameter] public string WaitForFile { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public EventCallback OnCompleted { get; set; }

    // === Internal State ===
    private string mDataFolder = "";
    private string mUserID = "";
    private string mPswd = "";
    private string mLaunchFile = "";
    private string mStatusLog = "";
    private string mWaitForFile = "";
    private string mTitle = "Processing...";

    private bool mStarted = false;
    private bool mFoundIT = false;
    private bool mFinished = false;
    private int mDelayTime = 0;

    private string StatusText = "Initializing...";
    private System.Timers.Timer? _timer;

    // === Lifecycle ===
    protected override void OnInitialized()
    {
        mDataFolder = DataFolder;
        mUserID = UserID;
        mPswd = Pswd;
        mLaunchFile = LaunchFile;
        mWaitForFile = WaitForFile;
        mTitle = string.IsNullOrEmpty(Title) ? "Processing..." : Title;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!string.IsNullOrEmpty(mLaunchFile))
            {
                await RunAsync(mDataFolder, mUserID, mPswd, mLaunchFile, mWaitForFile, mTitle);
            }
        }
    }

    public void Dispose()
    {
        StopTimer();
    }

    // === Public Run Method ===
    public async Task RunAsync(string dataFolder, string userId, string pswd, string launchFile, string waitForFile = "", string title = "")
    {
        mDataFolder = dataFolder;
        mUserID = userId;
        mPswd = pswd;
        mLaunchFile = launchFile;
        mWaitForFile = waitForFile ?? "";
        mTitle = string.IsNullOrEmpty(title) ? "Processing..." : title;
        mDelayTime = 0;

        if (!File.Exists(mLaunchFile))
        {
            StatusText = $"File not found: {mLaunchFile}";
            await InvokeAsync(StateHasChanged);
            return;
        }

        var ext = Path.GetExtension(mLaunchFile)?.TrimStart('.').ToLowerInvariant() ?? "";

        if (ext == "mac")
        {
            mStatusLog = Path.ChangeExtension(launchFile, ".log");
            mStarted = false;
            mFoundIT = false;
            mFinished = false;
            StartTimer();
        }
        else
        {
            RunTsObject();
            mFinished = true;
            StatusText = "Process launched.";
            await InvokeAsync(StateHasChanged);
        }
    }

    // === Timer Logic ===
    private void StartTimer()
    {
        _timer = new System.Timers.Timer(100); // ~100ms interval (VB6 was 1ms but that's too aggressive)
        _timer.Elapsed += OnTimerElapsed;
        _timer.AutoReset = true;
        _timer.Start();
    }

    private void StopTimer()
    {
        if (_timer != null)
        {
            _timer.Stop();
            _timer.Elapsed -= OnTimerElapsed;
            _timer.Dispose();
            _timer = null;
        }
    }

    private async void OnTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        try
        {
            // Launch macro if not started
            if (!mStarted)
            {
                TryDeleteFile(mStatusLog);
                TryDeleteFile(mWaitForFile);
                TryDeleteFile(ForceExt(mWaitForFile, "pdf"));
                RunTsObject();
                mStarted = true;
                mFoundIT = false;
            }

            ReadStatusFile();

            if (mFinished)
            {
                // Wait a delay so user can see the last step completed
                mDelayTime++;
                if (mDelayTime > 10) // ~1 second at 100ms interval
                {
                    StopTimer();
                    StatusText += "\nDone.";
                    await InvokeAsync(async () =>
                    {
                        StateHasChanged();
                        if (OnCompleted.HasDelegate)
                            await OnCompleted.InvokeAsync();
                    });
                }
            }
            else
            {
                if (!mFoundIT)
                {
                    // Wait for prn or pdf file to be created (and locked by another process)
                    mFoundIT = IsFileLocked(mWaitForFile) || IsFileLocked(ForceExt(mWaitForFile, "pdf"));
                }
                else
                {
                    // Wait for prn or pdf file to become writable (process finished writing)
                    if (IsFileAccessible(mWaitForFile) || IsFileAccessible(ForceExt(mWaitForFile, "pdf")))
                    {
                        mFinished = true;
                    }
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Swallow errors like VB6's On Error Resume Next
        }
    }

    // === RunTsObject — creates and runs a batch file ===
    private void RunTsObject()
    {
        try
        {
            var tsObjPath = GetTsObjectPath();
            var batchFileName = Path.Combine(
                Path.GetTempPath(),
                "HomeFront_FTSObject.bat");

            // Ensure directory exists
            var batchDir = Path.GetDirectoryName(batchFileName);
            if (!string.IsNullOrEmpty(batchDir) && !Directory.Exists(batchDir))
                Directory.CreateDirectory(batchDir);

            // Write batch file
            var driveLetter = string.IsNullOrEmpty(mDataFolder) ? "" : Path.GetPathRoot(mDataFolder)?.TrimEnd('\\') ?? "";
            using (var sw = new StreamWriter(batchFileName))
            {
                if (!string.IsNullOrEmpty(driveLetter))
                    sw.WriteLine(driveLetter);
                sw.WriteLine($"cd \"{mDataFolder}\"");
                sw.WriteLine($"\"{tsObjPath}\" \"{mLaunchFile}\" {mUserID} {mPswd}");
                sw.WriteLine("cd \\");
                sw.WriteLine("c:");
            }

            // Execute batch file hidden
            var psi = new ProcessStartInfo
            {
                FileName = batchFileName,
                WindowStyle = ProcessWindowStyle.Hidden,
                CreateNoWindow = true,
                UseShellExecute = true
            };
            Process.Start(psi);
        }
        catch (Exception ex)
        {
            StatusText = $"Error: {ex.Message}";
        }
    }

    // === ReadStatusFile — parses the .log file ===
    private void ReadStatusFile()
    {
        try
        {
            if (string.IsNullOrEmpty(mStatusLog) || !File.Exists(mStatusLog))
                return;

            var lines = File.ReadAllLines(mStatusLog);
            if (lines.Length < 3)
                return;

            var output = "";
            // Skip first 2 heading lines
            for (int i = 2; i < lines.Length; i++)
            {
                var s = lines[i];
                if (string.IsNullOrWhiteSpace(s))
                    continue;

                var sTime = SafeSubstring(s, 0, 19).Trim();
                var sTask = SafeSubstring(s, 78, 36).Trim();
                var sMsg = SafeSubstring(s, 114, s.Length - 114).Trim();

                if (DateTime.TryParse(sTime, out var dt))
                {
                    sTime = dt.ToString("h:mm:ss tt");
                }
                else
                {
                    sTime = "";
                }

                output += $"{sTime} {sMsg} {sTask}...\n";
            }

            StatusText = output;
        }
        catch
        {
            // Silently ignore read errors (file may be locked)
        }
    }

    // === Helper Methods ===
    private string GetTsObjectPath()
    {
        // In VB6 this read from registry; in .NET we use a default or config
        var defaultPath = @"C:\Program Files\Timberline Office\Accounting\";
        return Path.Combine(defaultPath, "tsobject.exe");
    }

    private static string ForceExt(string filePath, string newExt)
    {
        if (string.IsNullOrEmpty(filePath))
            return "";
        try
        {
            if (!newExt.StartsWith("."))
                newExt = "." + newExt;
            return Path.ChangeExtension(filePath, newExt);
        }
        catch
        {
            return filePath;
        }
    }

    private static void TryDeleteFile(string path)
    {
        try
        {
            if (!string.IsNullOrEmpty(path) && File.Exists(path))
                File.Delete(path);
        }
        catch
        {
            // Ignore delete errors
        }
    }

    private static bool IsFileLocked(string path)
    {
        if (string.IsNullOrEmpty(path) || !File.Exists(path))
            return false;
        try
        {
            using var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.None);
            return false; // File is accessible, not locked
        }
        catch (IOException)
        {
            return true; // File is locked
        }
        catch
        {
            return false;
        }
    }

    private static bool IsFileAccessible(string path)
    {
        if (string.IsNullOrEmpty(path) || !File.Exists(path))
            return false;
        try
        {
            using var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.None);
            return true; // File is accessible
        }
        catch
        {
            return false;
        }
    }

    private static string SafeSubstring(string s, int start, int length)
    {
        if (string.IsNullOrEmpty(s) || start >= s.Length)
            return "";
        if (start + length > s.Length)
            length = s.Length - start;
        return s.Substring(start, length);
    }
}
