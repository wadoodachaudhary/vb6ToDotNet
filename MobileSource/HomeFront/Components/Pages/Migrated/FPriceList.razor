    private async Task SetDecimalPlaces(int newValue)
    {
        if (newValue < 0) newValue = 0;
        if (newValue > 6) newValue = 6;
        if (newValue == Decimals) return;
        Decimals = newValue;
        try
        {
            await db.ExecuteAsync(@"
                IF EXISTS (SELECT 1 FROM appoptions WHERE DivisionID=@DivisionID AND optionname='PriceListDecimals')
                    UPDATE appoptions SET optionvalue=@Value WHERE DivisionID=@DivisionID AND optionname='PriceListDecimals'
                ELSE
                    INSERT INTO appoptions(DivisionID, optionname, optionvalue) VALUES(@DivisionID,'PriceListDecimals',@Value)",
                new { SessionState.DivisionID, Value = newValue.ToString() });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SetDecimalPlaces persist failed");
        }
        StatusMessage = $"Decimal places: {Decimals}";
        StateHasChanged();
    }

    private async Task<bool> SaveDataAsync(bool prompt)
    {
        if (!IsDirty)
        {
            StatusMessage = "Nothing to save";
            return true;
        }

        if (prompt)
        {
            var result = _messageBox != null
                ? await _messageBox.ShowAsync(
                    "Vendor Price List has changed.\n\nDo you want to save these changes?",
                    title: "Save changes?",
                    buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel)
                : (await Dialogs.ConfirmAsync(
                        "Vendor Price List has changed.\n\nDo you want to save these changes?")
                    ? Fx.ControlKit.Dialogs.MessageBoxResult.Yes
                    : Fx.ControlKit.Dialogs.MessageBoxResult.No);

            if (result == Fx.ControlKit.Dialogs.MessageBoxResult.Cancel) return false;
            if (result == Fx.ControlKit.Dialogs.MessageBoxResult.No) return true;
        }

        try
        {
            var div = SessionState.DivisionID;
            foreach (var row in PriceData.Where(r => r.RowState == "Deleted").ToList())
            {
                var delDiv = row.PriceLevel == "Corporate (any Division)" ? 0 : div;
                await db.ExecuteAsync($@"DELETE FROM tblVendorCost
                    WHERE ISNULL(Community,'') = @Community AND ISNULL(CommunityPhase,'') = @CommunityPhase
                    AND ISNULL(Assembly,'') = @Assembly AND ISNULL(Model,'') = @Model
                    AND Phase = @Phase AND Item = @Item AND Vendor = @Vendor AND DivisionID = {delDiv}",
                    new { Community = row.Community ?? "", CommunityPhase = row.CommunityPhase ?? "",
                          Assembly = row.Assembly ?? "", Model = row.Model ?? "",
                          row.Phase, row.Item, row.Vendor });
                PriceData.Remove(row);
            }

            foreach (var row in PriceData.Where(r => r.RowState == "DIRTY"))
            {
                var updDiv = row.PriceLevel == "Corporate (any Division)" ? 0 : div;
                await db.ExecuteAsync($@"UPDATE tblVendorCost SET
                    Current_Cost = @Current, Next_Cost1 = @Next1, Next_Effective1 = @Effective1,
                    Next_Cost2 = @Next2, Next_Effective2 = @Effective2,
                    Last_Cost1 = @Last1, Last1_Expiry = @Expiry1,
                    Last_Cost2 = @Last2, Last2_Expiry = @Expiry2,
                    Last_Cost3 = @Last3, Last3_Expiry = @Expiry3,
                    Forecast1=@Forecast1, Forecast2=@Forecast2, Forecast3=@Forecast3,
                    Forecast4=@Forecast4, Forecast5=@Forecast5, Forecast6=@Forecast6,
                    Forecast7=@Forecast7, Forecast8=@Forecast8, Forecast9=@Forecast9,
                    Forecast10=@Forecast10, Forecast11=@Forecast11, Forecast12=@Forecast12,
                    PartNumber = @SKU, TaxGroup = @TaxGroup
                    WHERE ISNULL(Community,'') = @Community AND ISNULL(CommunityPhase,'') = @CommunityPhase
                    AND ISNULL(Assembly,'') = @Assembly AND ISNULL(Model,'') = @Model
                    AND Phase = @Phase AND Item = @Item AND Vendor = @Vendor AND DivisionID = {updDiv}",
                    new { row.Current, row.Next1, row.Effective1, row.Next2, row.Effective2,
                          row.Last1, row.Expiry1, row.Last2, row.Expiry2, row.Last3, row.Expiry3,
                          row.Forecast1, row.Forecast2, row.Forecast3, row.Forecast4,
                          row.Forecast5, row.Forecast6, row.Forecast7, row.Forecast8,
                          row.Forecast9, row.Forecast10, row.Forecast11, row.Forecast12,
                          row.SKU, row.TaxGroup,
                          Community = row.Community ?? "", CommunityPhase = row.CommunityPhase ?? "",
                          Assembly = row.Assembly ?? "", Model = row.Model ?? "",
                          row.Phase, row.Item, row.Vendor });
                row.RowState = "CLEAN";
            }

            IsDirty = false;
            StatusMessage = "Saved";
            Notifications.Info("Pricelist saved.");
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FPriceList: SaveData failed");
            Notifications.Error($"Save failed: {ex.Message}");
            return false;
        }
    }

    // === Grid Cell Save + Fan-out (VB6 gItems_AfterEdit + ValidateEdit) ===
    private Task OnGridCellSave(CellSaveArgs<VendorPriceViewModel> args)
    {
        var row = args.Data;
        if (row == null) return Task.CompletedTask;
        var field = args.ColumnName ?? "";

        if (field.Equals("Current", StringComparison.OrdinalIgnoreCase) && row._currentChanged != true)
        {
            row._currentChanged = true;
            row.Last3 = row.Last2;
            row.Expiry3 = row.Expiry2;
            row.Last2 = row.Last1;
            row.Expiry2 = row.Expiry1;
            row.Last1 = row.Current;
            row.Expiry1 = DateTime.Today;
        }

        row.RowState = "DIRTY";
        IsDirty = true;

        if (row.PriceLink != 0 && _fanOutFields.Contains(field))
        {
            var key = $"{row.PriceLink}|{row.Vendor}|{row.Assembly}|{row.Model}|{row.Community}|{row.CommunityPhase}";
            foreach (var other in PriceData)
            {
                if (ReferenceEquals(other, row)) continue;
                var otherKey = $"{other.PriceLink}|{other.Vendor}|{other.Assembly}|{other.Model}|{other.Community}|{other.CommunityPhase}";
                if (otherKey != key) continue;
                CopyFanOutFields(row, other);
                other.RowState = "DIRTY";
            }
        }

        return Task.CompletedTask;
    }

    private static void CopyFanOutFields(VendorPriceViewModel src, VendorPriceViewModel dst)
    {
        dst.Current = src.Current; dst.Next1 = src.Next1; dst.Next2 = src.Next2;
        dst.Effective1 = src.Effective1; dst.Effective2 = src.Effective2;
        dst.Last1 = src.Last1; dst.Last2 = src.Last2; dst.Last3 = src.Last3;
        dst.Expiry1 = src.Expiry1; dst.Expiry2 = src.Expiry2; dst.Expiry3 = src.Expiry3;
        dst.Forecast1 = src.Forecast1; dst.Forecast2 = src.Forecast2; dst.Forecast3 = src.Forecast3;
        dst.Forecast4 = src.Forecast4; dst.Forecast5 = src.Forecast5; dst.Forecast6 = src.Forecast6;
        dst.Forecast7 = src.Forecast7; dst.Forecast8 = src.Forecast8; dst.Forecast9 = src.Forecast9;
        dst.Forecast10 = src.Forecast10; dst.Forecast11 = src.Forecast11; dst.Forecast12 = src.Forecast12;
    }

