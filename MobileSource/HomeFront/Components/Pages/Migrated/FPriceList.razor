    // Extract the value from a `Field = 'value'` term in an accumulated tree WHERE
    // clause (e.g. "CommunityDesc = 'AM' AND Assembly = 'ASTER1214'"). Matches the
    // exact "<Field> = '" token so "Assembly" can't catch "AssemblyDesc", nor
    // "Community" catch "CommunityPhase"/"CommunityDesc".
    private static string ParseWhereValue(string? whereClause, string field)
    {
        if (string.IsNullOrEmpty(whereClause)) return "";
        var token = field + " = '";
        var i = whereClause.IndexOf(token, StringComparison.OrdinalIgnoreCase);
        if (i < 0) return "";
        i += token.Length;
        var j = whereClause.IndexOf('\'', i);
        return j < 0 ? "" : whereClause.Substring(i, j - i);
    }

