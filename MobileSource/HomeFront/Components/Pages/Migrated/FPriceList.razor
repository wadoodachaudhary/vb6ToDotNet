   ───────────────────────────────────────────────────────────────── *@
@* Canonical migration of VB6 FPriceList.frm (renamed from FPriceList 2026-06-11).
   Keeps the /vendor-pricelist route (all existing nav links target it) and adds the
   /price-list route. The old pre-FlexKit FPriceList is retired as FPriceListLegacy. *@
@page "/vendor-pricelist"
@page "/price-list"

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Dynamic
@using System.Collections.Generic
@using System.Linq
@using System.Reflection
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data
@using Microsoft.AspNetCore.Components.Web

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FPriceList> Logger
@inject NotificationService Notifications
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHost
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@using HomeFront.Models
@inject DbWrapperSqlServer db
@layout HFComponent
<PageTitle>Vendor Item Prices</PageTitle>



<div class="vendor-prices-container">

    @* Toolbar — VB6 order (FPriceList.frm:644+):
       New | Save | View ▾ | More | Less | Preview | Export | Import | Forecasting *@
    <div class="vpl-toolbar" @onclick:stopPropagation="true">
        <button class="vpl-tbar-btn" @onclick="NewPricelist_Click" title="New pricelist">
            <img src="images/32/PricebookNew.ico" alt="New" onerror="this.style.display='none'" />
            <span>New</span>
        </button>

        <button class="vpl-tbar-btn" disabled="@(!IsDirty)" @onclick="Save_Click" title="Save">
            <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
            <span>Save</span>
        </button>

        <div class="vpl-tbar-sep"></div>

        @* View split-button — drops a popup menu listing the four views with
           ✓ on the active one. Mirrors VB6 Toolbar_ButtonDropDown. *@
        <div class="vpl-view-popup">
            <button class="vpl-tbar-btn" @onclick="ToggleViewMenu" title="Pick view">
                <img src="images/32/ChangeView.ico" alt="View" onerror="this.style.display='none'" />
                <span>View ▾</span>
            </button>
            @if (_viewMenuOpen)
            {
                <div class="vpl-view-menu">
                    @for (var i = 0; i < Views.Count; i++)
                    {
                        var idx = i;
                        <div class="vpl-view-menu-item @(idx == CurrentViewIndex ? "active" : "")"
                             @onclick="() => SelectView(idx)">
                            <span class="vpl-view-menu-check">@(idx == CurrentViewIndex ? "✓" : "")</span>
                            <span class="vpl-view-menu-name">@Views[idx].Name</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="vpl-tbar-sep"></div>

        <button class="vpl-tbar-btn" @onclick="More_Click" title="Increase decimal places">
            <img src="images/32/more.ico" alt="More" onerror="this.style.display='none'" />
            <span>More</span>
        </button>
        <button class="vpl-tbar-btn" @onclick="Less_Click" title="Decrease decimal places">
            <img src="images/32/less.ico" alt="Less" onerror="this.style.display='none'" />
            <span>Less</span>
        </button>

        <div class="vpl-tbar-sep"></div>

        <button class="vpl-tbar-btn" @onclick="Preview_Click" title="Preview">
            <img src="images/32/Preview.ico" alt="Preview" onerror="this.style.display='none'" />
            <span>Preview</span>
        </button>
        <button class="vpl-tbar-btn" @onclick="Export_Click" title="Export">
            <img src="images/32/PricebookExport.ico" alt="Export" onerror="this.style.display='none'" />
            <span>Export</span>
        </button>
        <button class="vpl-tbar-btn" @onclick="Import_Click" title="Import">
            <img src="images/32/PricebookImport.ico" alt="Import" onerror="this.style.display='none'" />
            <span>Import</span>
        </button>
        <button class="vpl-tbar-btn" @onclick="Forecasting_Click" title="Forecasting">
            <img src="images/32/Forecast.ico" alt="Forecasting" onerror="this.style.display='none'" />
            <span>Forecasting</span>
        </button>
    </div>

    @* Click-outside catcher for the View popup *@
    @if (_viewMenuOpen)
    {
        <div class="vpl-view-menu-backdrop" @onclick="CloseViewMenu"></div>
    }

    <!-- Main split layout -->
    <div class="main-content">

        <!-- Left: Tree Panel -->
        <div class="tree-panel">
            <TreeGridControl @ref="gAssemblies"
                        TValue="PriceTreeNode"
                        DataSource="@TreeNodes"
                        IdMapping="NodeID"
                        ParentIdMapping="ParentID"
                        TreeColumnIndex="0"
                        EnableCollapseAll="true"
                        AllowSelection="true"
                        Height="100%"
                        CssClass="fx-treegrid-compact fx-treegrid-dotted-lines"
                        NodeExpandIconStyle="GroupExpandIconStyle.PlusMinus"
                        RowSelected="OnTreeNodeSelected"
                        Expanded="OnTreeNodeExpand">
                <TreeGridColumn Field="NodeID" HeaderText="" Width="20px" Visible="false" />
                <TreeGridColumn Field="Node" HeaderText="Assembly" Width="420px" />
            </TreeGridControl>
        </div>

        <!-- Right: Price Grid -->
        <div class="grid-panel">
          <div @oncontextmenu="OnGridContextMenu" @oncontextmenu:preventDefault="true">
            <GridControl @ref="gItems"
                    TValue="VendorPriceViewModel"
                    DataSource="@PriceData"
                    AllowSorting="true"
                    AllowFiltering="true"
                    AllowResizing="true"
                    AllowSelection="true"
                    AllowGrouping="false"
                    AllowColumnReorder="true"
                    EnableHover="true"
                    Height="100%"
                    CssClass="vpl-items-grid"
                    FilterSettingsRef="@_filterSettings"
                    SelectionSettingsRef="@_selectionSettings"
                    EditSettingsRef="@_editSettings"
                    BatchEditBehavior="GridBatchEditBehavior.SingleCell"
                    EventsRef="@_gridEvents"
                    OnLayoutChanged="@OnItemsLayoutChangedAsync">
                <GridColumnsBase @key="ItemsGridLayoutVersion" DebugTag="FPriceList-gItems">
                    @if (HasItemsGridLayout)
                    {
                        @foreach (var entry in GetOrderedItemsGridLayout())
                        {
                            var layout = entry.Layout;
                            var fieldName = entry.Field;
                            var columnType = entry.ColumnType;
                            var textAlign = entry.TextAlign;
                            var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                            var width = layout.Width.HasValue && layout.Width.Value > 0
                                ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                                : null;
                            var initialVisible = !layout.Hidden;
                            var allowEdit = _editableNumericFields.Contains(fieldName)
                                         || _editableDateFields.Contains(fieldName)
                                         || fieldName.Equals("SKU", StringComparison.OrdinalIgnoreCase);

                            if (fieldName.Equals("TaxGroup", StringComparison.OrdinalIgnoreCase))
                            {
                                @* VB6 gItems_CellButtonClick "TaxGroup": the STANDARD FlexKit
                                   edit button (AlwaysShowEditButton) opens the Tax Group picklist
                                   via OnEditButtonClick → OnPickTaxGroup. Replaces the hand-rolled
                                   div/span/button template; the cell still shows the raw TaxGroup
                                   value (Ellipsis-clipped), the picker button always shows. *@
                                <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width"
                                              AllowEditing="false"
                                              ShowEditButton="true" AlwaysShowEditButton="true"
                                              Visible="@initialVisible"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                            else if (fieldName.Equals("PriceLink", StringComparison.OrdinalIgnoreCase))
                            {
                                <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="false" Visible="@initialVisible">
                                    <Template>
                                        @{ var data = (VendorPriceViewModel)context; }
                                        <span title="@data.PriceGroupDesc">@(!string.IsNullOrWhiteSpace(data.PriceGroupDesc) ? data.PriceGroupDesc : (data.PriceLink != 0 ? data.PriceLink.ToString() : ""))</span>
                                    </Template>
                                </GridColumn>
                            }
                            else if (_editableNumericFields.Contains(fieldName))
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="ColumnType.Number"
                                              Format="@DecimalFormat"
                                              TextAlign="TextAlign.Right"
                                              AllowEditing="true"
                                              Visible="@initialVisible" />
                            }
                            else
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              AllowEditing="@allowEdit"
                                              Visible="@initialVisible" />
                            }
                        }
                    }
                    else
                    {
                        <GridColumn Field="@nameof(VendorPriceViewModel.CommunityDesc)" HeaderText="Community Description" Width="180px" AllowEditing="false" />
                        <GridColumn Field="@nameof(VendorPriceViewModel.Phase)"         HeaderText="Phase"        Width="80px"  AllowEditing="false" />
                        <GridColumn Field="@nameof(VendorPriceViewModel.Item)"          HeaderText="Item"         Width="80px"  AllowEditing="false" />
                        <GridColumn Field="@nameof(VendorPriceViewModel.VendorName)"    HeaderText="Vendor Name"  Width="180px" AllowEditing="false" />
                        <GridColumn Field="@nameof(VendorPriceViewModel.AssemblyDesc)"  HeaderText="Assembly Description" Width="180px" AllowEditing="false" />
                        <GridColumn Field="@nameof(VendorPriceViewModel.ItemDesc)"      HeaderText="Item Description" Width="220px" AllowEditing="false" />
                        <GridColumn Field="@nameof(VendorPriceViewModel.SKU)"           HeaderText="Part Number"  Width="100px" AllowEditing="true" />
                        <GridColumn Field="@nameof(VendorPriceViewModel.Current)"       HeaderText="Current"      Width="90px"  Type="ColumnType.Number" Format="@DecimalFormat" TextAlign="TextAlign.Right" AllowEditing="true" />
                    }
                </GridColumnsBase>
            </GridControl>
          </div>
        </div>
    </div>

    <!-- Status bar -->
    <div class="status-bar">
        @StatusMessage
    </div>
</div>

@* ── Context Menu ──────────────────────────────────────────────── *@
@if (_showContextMenu)
{
    <div style="position:fixed;inset:0;z-index:999;background:transparent;"
         @onclick="CloseContextMenu"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"></div>
    <div class="context-menu" style="left:@(_contextMenuX)px;top:@(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <button @onclick="OnCtxNewItem">New Item...</button>
        <hr />
        <button @onclick="OnCtxAttachments" disabled="@(_ctxRow == null)">Attachments...</button>
        <hr />
        <button @onclick="OnCtxDelete" disabled="@(_ctxRow == null)">Delete</button>
    </div>
}

<FPickList @ref="_pickList" OnSelected="OnPickListSelected" />
<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />

@* VB6 Toolbar "NewPricelist" → FAddPricelist.Show vbModal. We render the migrated
   FAddPricelist page as a child component with IsModal=true (exactly like FAssembly
   hosts FTakeoff/FDBGrid), so the Vendor Item Prices list stays behind it. The @if
   re-instantiates it fresh each open. OnClose hides it + reloads the current node so
   newly-saved prices appear. *@
@if (_showAddPricelistModal)
{
    <FAddPricelist IsModal="true"
                   DefaultVendor="@_newVendor"
                   DefaultCommunity="@_newCommunity"
                   DefaultCommunityPhase="@_newCommunityPhase"
                   OnClose="OnAddPricelistModalClosed" />
}

@code {
    private const string FormName = "FPriceList";
    private const string ItemsGridName = "gItems";
    private GridControl<VendorPriceViewModel>? gItems;
    private TreeGridControl<PriceTreeNode>? gAssemblies;
    private FPickList? _pickList;
    private Fx.ControlKit.Dialogs.MessageBoxControl? _messageBox;
    private string _pickListContext = "";
    private VendorPriceViewModel? _pickListRow;

    private List<VendorPriceViewModel> PriceData = new();
    private List<PriceTreeNode> TreeNodes = new();
    private PriceTreeNode? SelectedNode;
    private VendorPriceViewModel? _selectedRow;
    private int CurrentViewIndex = 0;
    private int Decimals = 2;
    private string StatusMessage = "Ready";
    private bool IsDirty;
    // ── Grid layout via the shared GridLayoutPresenter ───────────────────────
    // The load/resolve/order/width boilerplate lives in GridLayoutPresenter<TRow>;
    // only the VB6 form/grid name strings stay here (fidelity), plus the alias map
    // (currentcost→Current, partnumber→SKU, description→ItemDesc, pricegroup→PriceLink),
    // which is keyed by normalized layout field and handed to the presenter ctor.
    // The members named ItemsGridLayout / HasItemsGridLayout / …Version below are
    // thin delegations, so the markup is unchanged. FPriceList's runtime-dynamic
    // gridname (per-view "gItems.{view}" with a 3-call fallback) and its
    // Forecast-header overwrite (ApplyCustomForecastHeadersAsync) remain
    // form-specific and operate on the presenter's Layout. NOTE: GetOrderedItems-
    // GridLayout below deliberately does NOT filter Hidden (differs from the
    // presenter's GetOrdered) — see the flag on that method.
    private readonly GridLayoutPresenter<VendorPriceViewModel> _priceGrid =
        new(FormName, ItemsGridName, aliases: _priceFieldAliases);

    private Dictionary<string, GridLayoutColumn> ItemsGridLayout => _priceGrid.Layout;
    private int ItemsGridLayoutVersion => _priceGrid.Version;
    private bool HasItemsGridLayout => _priceGrid.Has;
    private string CommunityLabel => "Community";
    private string CommunityPhaseLabel => "Phase";
    private string CD_Community = "Community";
    private string DecimalFormat => $"N{Decimals}";

    // === Grid Settings ===
    // VB6 gItems had a frozen filter row (FrozenRows=1): typing a substring in
    // Row 1 hid every row that didn't contain it on each column (gItems_AfterEdit
    // Row=1 branch). FilterType.FilterBar is the faithful equivalent — a per-column
    // type-to-filter bar — matching the reference template FAssembly's grid filtering.
    private readonly FilterSettings _filterSettings = new() { Type = FilterType.FilterBar };
    private readonly SelectionSettings _selectionSettings = new()
    {
        Type = SelectionType.Multiple,
        Mode = SelectionMode.Cell,
        EnableToggle = true
    };
    private readonly EditSettings _editSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch
    };
    private GridControlEvents<VendorPriceViewModel>? _gridEvents;

    // === Field classification (VB6 gItems_BeforeEdit) ===
    private static readonly HashSet<string> _editableNumericFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "Current", "Next1", "Next2",
        "Forecast1", "Forecast2", "Forecast3", "Forecast4", "Forecast5", "Forecast6",
        "Forecast7", "Forecast8", "Forecast9", "Forecast10", "Forecast11", "Forecast12"
    };
    private static readonly HashSet<string> _editableDateFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "Effective1", "Effective2"
    };
    private static readonly HashSet<string> _fanOutFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "Current", "Next1", "Next2", "Effective1", "Effective2",
        "Last1", "Last2", "Last3", "Expiry1", "Expiry2", "Expiry3",
        "Forecast1", "Forecast2", "Forecast3", "Forecast4", "Forecast5", "Forecast6",
        "Forecast7", "Forecast8", "Forecast9", "Forecast10", "Forecast11", "Forecast12"
    };

    // === Context Menu ===
    private bool _showContextMenu;
    private double _contextMenuX, _contextMenuY;
    private VendorPriceViewModel? _ctxRow;


    private async Task OnTreeNodeSelected(TreeRowSelectEventArgs<PriceTreeNode> args)
    {
        // Dummy placeholder rows (the [+] stand-ins) aren't real data — ignore clicks.
        if (args.Data?.IsPlaceholder == true) return;
        if (IsDirty)
        {
            if (!await SaveDataAsync(true)) return;
        }
        SelectedNode = args.Data;
        if (SelectedNode != null)
            await LoadItemsAsync(SelectedNode);
    }

    private async Task OnViewChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx))
        {
            CurrentViewIndex = idx;
            await LoadItemsGridLayoutAsync();
            await LoadTreeAsync(true);
        }
    }

    // View definitions
    private List<ViewDefinition> Views = new();

    protected override async Task OnInitializedAsync()
    {
        _gridEvents = new GridControlEvents<VendorPriceViewModel>
        {
            RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<VendorPriceViewModel>>(this, args => { _selectedRow = args.Data; }),
            OnCellSave = EventCallback.Factory.Create<CellSaveArgs<VendorPriceViewModel>>(this, OnGridCellSave),
            OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<VendorPriceViewModel>>(this, OnGridEditButtonClick)
        };
        InitializeViewDefinitions();
        await LoadSettings();
        await LoadItemsGridLayoutAsync();
        await LoadTreeAsync(true);
    }

    private void InitializeViewDefinitions()
    {
        Views = new List<ViewDefinition>
        {
            new ViewDefinition
            {
                Name = "Assembly",
                KeyFields = "CommunityDesc,CommunityPhase,Assembly,CostCode",
                DisplayFields = "Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc,CostCode + ' - ' + CostCodeDesc",
                SortFields = "Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc,CostCode + ' - ' + CostCodeDesc",
                FromWhere = "FROM VendorPrices v"
            },
            new ViewDefinition
            {
                Name = "Vendor",
                KeyFields = "Vendor,CommunityDesc,CommunityPhase,Assembly",
                DisplayFields = "VendorName,Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc",
                SortFields = "VendorName,Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc",
                FromWhere = "FROM VendorPrices v"
            },
            new ViewDefinition
            {
                Name = "Purchase Order",
                KeyFields = "POIndex,CommunityDesc,CommunityPhase,Assembly",
                DisplayFields = "POIndex + ' ' + case when poindex=POIndexDescription then '' else POIndexDescription end,Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc",
                SortFields = "POIndex + ' ' + case when poindex=POIndexDescription then '' else POIndexDescription end,Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc",
                FromWhere = "FROM VendorPrices v"
            },
            new ViewDefinition
            {
                Name = "Cost Code",
                KeyFields = "CostCode,CommunityDesc,CommunityPhase,Assembly",
                DisplayFields = "CostCode + ' - ' + CostCodeDesc,Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc",
                SortFields = "CostCode + ' - ' + CostCodeDesc,Community + ' - ' + CommunityDesc,CommunityPhase + ' - ' + CommunityPhaseDesc,Assembly + ' - ' + AssemblyDesc",
                FromWhere = "FROM VendorPrices v"
            }
        };
    }

    private async Task LoadSettings()
    {
        CurrentViewIndex = 0;
        Decimals = 2;
    }

    // Running node-id allocator. VB6 used grid row indices; we allocate ints so the
    // TreeGridControl's IdMapping/ParentIdMapping can wire parent→child as we lazily
    // append children on expand.
    private int _treeNodeId = 1;

    // VB6 LoadAssemblies(ClearTree:=True): build ONLY the top level, give each node a
    // dummy placeholder child so it shows a [+], and leave everything collapsed.
    // Deeper levels load on expand (OnTreeNodeExpand). This matches VB6 exactly — the
    // old migration eager-built the whole tree (slow, and pre-expanded branches).
    private async Task LoadTreeAsync(bool clear = true)
    {
        try
        {
            if (clear)
                SelectedNode = null;

            var view = Views[CurrentViewIndex];
            var keyFields = ParseViewList(view.KeyFields);
            var displayFields = ParseViewList(view.DisplayFields);
            var sortFields = ParseViewList(view.SortFields);
            if (keyFields.Count == 0 || displayFields.Count == 0)
            {
                TreeNodes = new List<PriceTreeNode>();
                return;
            }

            _treeNodeId = 1;
            var nodes = new List<PriceTreeNode>();

            var keyField = keyFields[0];
            var displayField = displayFields[0];
            var sortField = sortFields.ElementAtOrDefault(0);
            var rows = await QueryTreeLevel(view, keyField, displayField, sortField, null);
            foreach (var row in rows)
            {
                // VB6 LoadAssemblies keeps EVERY DISTINCT row — including rows whose
                // key is empty. An empty CommunityPhase / Assembly is the "- any phase -"
                // / "- any assembly -" ROLLUP node, and it carries the FULL child set
                // (e.g. Global's "- any phase -" has 121 assemblies). The old
                // `IsNullOrWhiteSpace(KeyValue) continue` dropped these rollups, which is
                // why most communities showed no children and Global showed only the
                // stray "1 - any phase -" (5 asms) instead of "- any phase -" (121). The
                // empty key is valid: WhereClause becomes `… AND CommunityPhase = ''`.
                var display = NormalizeDisplayValue(row.DisplayValue);
                var safeKey = SqlSafe(row.KeyValue);
                var node = new PriceTreeNode
                {
                    NodeID = _treeNodeId++,
                    ParentID = null,
                    Node = display,
                    KeyField = keyField,
                    KeyValue = row.KeyValue,
                    WhereClause = $"{keyField} = '{safeKey}'",
                    Level = 0
                };
                nodes.Add(node);
                // Dummy child so the [+] appears (VB6 .GetNode(r).AddNode(…, "dummy")),
                // but only when there IS a deeper level to open.
                if (1 < keyFields.Count)
                    nodes.Add(MakePlaceholder(node));
            }

            TreeNodes = nodes;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadTreeAsync error");

            TreeNodes = new List<PriceTreeNode>();
        }
        finally
        {
            StateHasChanged();
        }
    }

    // VB6 dummy child: a non-selectable placeholder that gives its parent a [+].
    private PriceTreeNode MakePlaceholder(PriceTreeNode parent) => new PriceTreeNode
    {
        NodeID = _treeNodeId++,
        ParentID = parent.NodeID,
        Node = "",
        Level = parent.Level + 1,
        IsPlaceholder = true
    };

    // VB6 LoadAssemblies(ClearTree:=False): on first expand of a node, replace its
    // dummy placeholder with the real next-level rows (each with its own dummy if a
    // deeper level exists). Re-expanding a loaded node does nothing (ChildrenLoaded).
    private async Task OnTreeNodeExpand(TreeNodeEventArgs<PriceTreeNode> args)
    {
        var node = args.Data;
        if (node == null || node.IsPlaceholder || node.ChildrenLoaded) return;

        var view = Views[CurrentViewIndex];
        var keyFields = ParseViewList(view.KeyFields);
        var displayFields = ParseViewList(view.DisplayFields);
        var sortFields = ParseViewList(view.SortFields);

        var childLevel = node.Level + 1;
        if (childLevel >= keyFields.Count) return;   // already at the lowest level

        var keyField = keyFields[childLevel];
        var displayField = displayFields[Math.Min(childLevel, displayFields.Count - 1)];
        var sortField = sortFields.ElementAtOrDefault(childLevel);

        try
        {
            var rows = await QueryTreeLevel(view, keyField, displayField, sortField, node.WhereClause);

            // Drop this node's placeholder child (VB6 RemoveItem of the "dummy" row).
            TreeNodes.RemoveAll(n => n.IsPlaceholder && n.ParentID == node.NodeID);

            // Insert the real children right after their parent so the flat list keeps
            // parent→child contiguity (cosmetic; TreeGridControl groups by ParentID).
            var insertAt = TreeNodes.FindIndex(n => n.NodeID == node.NodeID) + 1;
            var newKids = new List<PriceTreeNode>();
            foreach (var row in rows)
            {
                // VB6 LoadAssemblies keeps EVERY DISTINCT row — including rows whose
                // key is empty. An empty CommunityPhase / Assembly is the "- any phase -"
                // / "- any assembly -" ROLLUP node, and it carries the FULL child set
                // (e.g. Global's "- any phase -" has 121 assemblies). The old
                // `IsNullOrWhiteSpace(KeyValue) continue` dropped these rollups, which is
                // why most communities showed no children and Global showed only the
                // stray "1 - any phase -" (5 asms) instead of "- any phase -" (121). The
                // empty key is valid: WhereClause becomes `… AND CommunityPhase = ''`.
                var display = NormalizeDisplayValue(row.DisplayValue);
                var safeKey = SqlSafe(row.KeyValue);
                var child = new PriceTreeNode
                {
                    NodeID = _treeNodeId++,
                    ParentID = node.NodeID,
                    Node = display,
                    KeyField = keyField,
                    KeyValue = row.KeyValue,
                    WhereClause = $"{node.WhereClause} AND {keyField} = '{safeKey}'",
                    Level = childLevel
                };
                newKids.Add(child);
                if (childLevel + 1 < keyFields.Count)
                    newKids.Add(MakePlaceholder(child));
            }
            TreeNodes.InsertRange(insertAt, newKids);
            node.ChildrenLoaded = true;
            // New list instance so TreeGridControl re-derives the hierarchy.
            TreeNodes = new List<PriceTreeNode>(TreeNodes);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnTreeNodeExpand error");
        }
    }

    private async Task LoadItemsAsync(PriceTreeNode currentSelectedNode)
    {
        StatusMessage = "Loading vendor prices...";
        StateHasChanged();
        try
        {
            PriceData.Clear();

            var sql = @"
            SELECT v.*, g.PriceGroupDesc
            FROM VendorPrices v
            LEFT OUTER JOIN PriceGroups g
                ON v.PriceLink = g.PriceGroup
               AND g.DivisionID = @DivisionID";

            var whereClause = currentSelectedNode?.WhereClause;

            if (!string.IsNullOrWhiteSpace(whereClause))
            {
                var cleanWhere = whereClause.Trim().StartsWith("AND ")
                    ? whereClause.Trim().Substring(4).Trim()
                    : whereClause.Trim();
                sql += $@"
                WHERE ISNULL(Vendor, '') <> ''
                  AND {cleanWhere}
                  AND v.DivisionID IN (0, @DivisionID)";
            }
            else
            {
                sql += @"
                WHERE v.DivisionID IN (0, @DivisionID)";
            }

            var orderBy = Views.Count > CurrentViewIndex ? Views[CurrentViewIndex].DisplayFields : "";
            if (!string.IsNullOrWhiteSpace(orderBy))
                sql += $@"
                ORDER BY {orderBy}";

            var parameters = new { SessionState.DivisionID };
            var result = await db.QueryAsync(sql, parameters);

            foreach (var row in result)
            {
                var item = new VendorPriceViewModel
                {
                    PriceLink = Convert.ToInt64(row["PriceLink"] ?? 0),
                    PriceGroupDesc = row["PriceGroupDesc"]?.ToString() ?? "",
                    ItemType = row["ItemType"]?.ToString(),
                    PriceLevel = (row["PriceLevel"]?.ToString() ?? "")
                        .Replace("Community", CommunityLabel),
                    Vendor = row["Vendor"]?.ToString(),
                    VendorName = row["VendorName"]?.ToString(),
                    Community = row["Community"]?.ToString(),
                    CommunityPhase = row["CommunityPhase"]?.ToString(),
                    CommunityDesc = row["CommunityDesc"]?.ToString(),
                    TaxGroup = row["TaxGroup"]?.ToString(),
                    SKU = row["PartNumber"]?.ToString(),
                    Item = row["Item"]?.ToString(),
                    ItemNumber = row["ItemNumber"]?.ToString(),
                    OrderUOM = row["OrderUOM"]?.ToString(),
                    Phase = row["Phase"]?.ToString(),
                    POIndex = row["POIndex"]?.ToString(),
                    POIndexDescription = row["POIndexDescription"]?.ToString(),
                    CostCode = row["CostCode"]?.ToString(),
                    CostCodeDesc = row["CostCodeDesc"]?.ToString(),
                    ItemDesc = row["ItemDesc"]?.ToString(),
                    Assembly = row["Assembly"]?.ToString(),
                    Model = row["Model"]?.ToString(),
                    AssemblyDesc = row["AssemblyDesc"]?.ToString(),
                    Last3 = Convert.ToDecimal(row["Last3"] ?? 0m),
                    Expiry3 = row["Expiry3"] as DateTime?,
                    Last2 = Convert.ToDecimal(row["Last2"] ?? 0m),
                    Expiry2 = row["Expiry2"] as DateTime?,
                    Last1 = Convert.ToDecimal(row["Last1"] ?? 0m),
                    Expiry1 = row["Expiry1"] as DateTime?,
                    Current = Convert.ToDecimal(row["CurrentCost"] ?? 0m),
                    Next1 = Convert.ToDecimal(row["Next1"] ?? 0m),
                    Effective1 = row["Effective1"] as DateTime?,
                    Next2 = Convert.ToDecimal(row["Next2"] ?? 0m),
                    Effective2 = row["Effective2"] as DateTime?,
                    Forecast1 = Convert.ToDecimal(row["Forecast1"] ?? 0m),
                    Forecast2 = Convert.ToDecimal(row["Forecast2"] ?? 0m),
                    Forecast3 = Convert.ToDecimal(row["Forecast3"] ?? 0m),
                    Forecast4 = Convert.ToDecimal(row["Forecast4"] ?? 0m),
                    Forecast5 = Convert.ToDecimal(row["Forecast5"] ?? 0m),
                    Forecast6 = Convert.ToDecimal(row["Forecast6"] ?? 0m),
                    Forecast7 = Convert.ToDecimal(row["Forecast7"] ?? 0m),
                    Forecast8 = Convert.ToDecimal(row["Forecast8"] ?? 0m),
                    Forecast9 = Convert.ToDecimal(row["Forecast9"] ?? 0m),
                    Forecast10 = Convert.ToDecimal(row["Forecast10"] ?? 0m),
                    Forecast11 = Convert.ToDecimal(row["Forecast11"] ?? 0m),
                    Forecast12 = Convert.ToDecimal(row["Forecast12"] ?? 0m),
                    HasLinkedPriceGroup = Convert.ToInt64(row["PriceLink"] ?? 0) != 0
                };
                PriceData.Add(item);
            }

            StatusMessage = $"Loaded {PriceData.Count} price records";
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error loading prices: {ex.Message}";
        }
        finally
        {
            StateHasChanged();
        }
    }

