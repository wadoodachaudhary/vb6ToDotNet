    private sealed class TreeQueryRow
    {
        public string KeyValue { get; set; } = "";
        public string DisplayValue { get; set; } = "";
    }

    private static string SqlSafe(string? value)
    {
        return (value ?? "").Replace("'", "''");
    }

    private static List<string> ParseViewList(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return new List<string>();
        return raw.Split(',')
            .Select(s => s.Trim())
            .Where(s => s.Length > 0)
            .ToList();
    }

    private string NormalizeDisplayValue(string? value)
    {
        var display = (value ?? "").Trim();
        if (display.Equals("- global -", StringComparison.OrdinalIgnoreCase))
            display = $"Global (any {CD_Community})";
        if (display.Equals("- corporate -", StringComparison.OrdinalIgnoreCase))
            display = "Corporate (any Division)";
        return display;
    }

    private async Task<List<TreeQueryRow>> QueryTreeLevel(ViewDefinition view, string keyField, string displayField, string? sortField, string? whereClause = null)
    {
        var sort = string.IsNullOrWhiteSpace(sortField) ? displayField : sortField;
        var sql = new System.Text.StringBuilder();
        sql.Append("SELECT DISTINCT ").Append(keyField).Append(" AS KeyValue, ").Append(displayField).Append(" AS DisplayValue");
        if (!string.Equals(sort, keyField, StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(sort, displayField, StringComparison.OrdinalIgnoreCase))
        {
            sql.Append(", ").Append(sort).Append(" AS SortValue");
        }
        sql.AppendLine();
        sql.Append(view.FromWhere);
        sql.Append(" WHERE v.DivisionID IN (0, ").Append(SessionState.DivisionID).Append(")");
        if (!string.IsNullOrWhiteSpace(whereClause))
            sql.Append(" AND ").Append(whereClause);
        sql.Append(" ORDER BY ").Append(sort);

        var rows = await db.QueryAsync(sql.ToString());
        return rows.Select(r => new TreeQueryRow
        {
            KeyValue = r["KeyValue"]?.ToString() ?? "",
            DisplayValue = r["DisplayValue"]?.ToString() ?? r["KeyValue"]?.ToString() ?? ""
        }).ToList();
    }

    private async Task LoadItemsGridLayoutAsync()
    {
        // Runtime-dynamic gridname with the VB6 3-call fallback, now via the
        // presenter's candidate-list overload (tries each in order until one
        // returns rows). The (grid, gridIndex, instanceKey) tuples below reproduce
        // the EXACT three gridTags the prior three GetGridLayoutAsync calls produced:
        //   1. ("gItems.{view}", 0,    null) → tag "FPriceList.gItems.{view}"
        //   2. ("gItems", CurrentViewIndex, null) → tag "FPriceList.gItems.({view})" (.(view) subscript only when view≠0)
        //   3. ("gItems", 0,    null) → tag "FPriceList.gItems"
        // Candidate 2 keeps gridIndex=CurrentViewIndex verbatim (a fixed-gridIndex
        // overload couldn't express it) — same final tag, byte-for-byte.
        await _priceGrid.LoadAsync(GridLayoutSvc,
            ($"{ItemsGridName}.{CurrentViewIndex}", 0, (string?)null),
            (ItemsGridName, CurrentViewIndex, (string?)null),
            (ItemsGridName, 0, (string?)null));

        await ApplyCustomForecastHeadersAsync();

        // LoadAsync already bumped Version; bump again so the <GridColumnsBase @key>
        // also reflects the Forecast-header captions applied just above.
        _priceGrid.BumpVersion();
    }

    // GridControl raises OnLayoutChanged once a resize / reorder / hide / group /
    // rename finishes; the new state lives on the snapshot, not in the presenter's
    // layout dict, so it has to be merged in before the write.
    // Saved under the per-view tag "gItems.{view}" — the FIRST candidate
    // LoadItemsGridLayoutAsync probes, so the next load reads back what was written
    // whichever of the three tags supplied the layout originally.
    private async Task OnItemsLayoutChangedAsync(GridSettings snapshot)
    {
        if (snapshot == null || !HasItemsGridLayout) return;
        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, FormName, $"{ItemsGridName}.{CurrentViewIndex}", instanceKey: null,
                ItemsGridLayout, snapshot, _priceGrid.ResolveField, staticNames: false);

            _priceGrid.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FPriceList gItems layout");
        }
    }

    // VB6 Form_Load → LoadCostTypes(, gItems): after the grid layout is loaded, the
    // Forecast1..Forecast12 column HEADERS are overwritten from CustomDescriptions so a
    // customer who renamed a period (e.g. "Oct 2025" instead of "Period 1") sees their
    // label. VB6:  Grid.TextMatrix(0, ColIndex("ForecastN")) = IIf(custom="", "Forecast N", custom).
    // A CustomDescriptions row with a blank Custom_Description falls back to "Forecast N";
    // no row at all leaves the stored layout caption ("Period N") untouched.
    private async Task ApplyCustomForecastHeadersAsync()
    {
        if (ItemsGridLayout.Count == 0) return;
        try
        {
            var sql = new System.Text.StringBuilder();
            for (var i = 1; i <= 12; i++)
            {
                if (i > 1) sql.AppendLine("UNION ALL");
                sql.AppendLine($"SELECT Item, MAX(Custom_Description) AS CustomDesc, 'Forecast {i}' AS DefaultDesc FROM CustomDescriptions WHERE Item='Forecast{i}' GROUP BY Item");
            }

            var rows = await db.QueryAsync(sql.ToString());
            foreach (var row in rows)
            {
                var item = row["Item"]?.ToString() ?? "";
                if (string.IsNullOrEmpty(item)) continue;
                var custom = row["CustomDesc"]?.ToString() ?? "";
                var fallback = row["DefaultDesc"]?.ToString() ?? "";
                var caption = string.IsNullOrEmpty(custom) ? fallback : custom;
                if (ItemsGridLayout.TryGetValue(item, out var col))
                    col.Caption = caption;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "FPriceList: custom Forecast header load failed");
        }
    }

    // KEPT form-specific (NOT delegated to the presenter's GetOrdered): FPriceList
    // renders Hidden columns too — the .Where below filters ONLY blank-field rows,
    // unlike GridLayoutPresenter.GetOrdered which also drops c.Hidden. The grid then
    // honors each column's own Visible="@initialVisible" (= !layout.Hidden) in the
    // markup. Field resolution + column-type inference DO delegate to the presenter
    // (ResolveField / ColumnTypeFor); the presenter's ColumnTypeFor is byte-equivalent
    // to the old pure GetColumnTypeForField (bool→CheckBox, DateTime→Date, numeric→Number).
    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedItemsGridLayout()
    {
        if (!HasItemsGridLayout)
            yield break;

        var ordered = ItemsGridLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field))
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = _priceGrid.ResolveField(layout.Field);
            var columnType = _priceGrid.ColumnTypeFor(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    // Alias map (normalized layout field → property name) handed to the presenter
    // ctor. Field resolution (exact → normalized → alias → literal) and column-type
    // inference are the presenter's job now — the per-form reflection propmap,
    // NormalizeGridKey, ResolveItemsGridField, and the pure GetColumnTypeForField
    // were duplicates of GridLayoutPresenter.NormalizeKey / ResolveField / ColumnTypeFor
    // and have been removed.
    private static readonly Dictionary<string, string> _priceFieldAliases = new(StringComparer.OrdinalIgnoreCase)
    {
        ["currentcost"] = nameof(VendorPriceViewModel.Current),
        ["partnumber"] = nameof(VendorPriceViewModel.SKU),
        ["description"] = nameof(VendorPriceViewModel.ItemDesc),
        ["pricegroup"] = nameof(VendorPriceViewModel.PriceLink)
    };

    // twips → px is the single canonical GridLayoutPresenter.WidthPx now. WIDTH
    // POLICY CHANGE (deliberate): the old hand-copied "/15 * 0.85" (no +16,
    // clamp [24..2000]) is replaced by the canonical "/15 + 16" (clamp [32..2000]).
    // VB6 does no width tuning; one canonical +16 everywhere is the confirmed policy,
    // so columns here are now slightly wider than the prior 15%-trimmed values.
    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);
}
