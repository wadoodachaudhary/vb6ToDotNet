@namespace HomeFront.Components.Pages

@using System
@using System.Collections.Generic
@using System.Data
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject ILogger<FProperties> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer db

@if (IsVisible)
{
    <div class="properties-dialog-overlay" @onclick="OnClose">
        <div class="properties-dialog @(mMode == "tip" ? "tip-mode" : "")" @onclick:stopPropagation="true">
            @if (mMode == "form")
            {
                <div class="properties-header">
                    <span>@DialogCaption</span>
                    <button @onclick="OnClose">×</button>
                </div>
            }

            <div class="properties-body @(mMode == "form" ? "with-image" : "")">
                @if (mMode == "form")
                {
                    <div class="properties-image">
                        <img src="images/properties-icon.png" alt="" onerror="this.style.display='none'" />
                    </div>
                }

                <div class="properties-grid-container @(mMode == "tip" ? "tip-mode" : "form-mode")">
                    <table class="properties-table">
                        @foreach (var row in GridRows)
                        {
                            @if (row.RowType == PropertyRowType.Spacer)
                            {
                                <tr class="spacer-row">
                                    <td colspan="2"></td>
                                </tr>
                            }
                            else if (row.RowType == PropertyRowType.Section)
                            {
                                <tr class="section-row">
                                    <td colspan="2">@row.Label</td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    @if (mMode == "form")
                                    {
                                        <td class="fixed-col">@row.Label</td>
                                        <td>@row.Value</td>
                                    }
                                    else
                                    {
                                        <td>@row.Label</td>
                                        <td>@row.Value</td>
                                    }
                                </tr>
                            }
                        }
                    </table>
                </div>
            </div>

            @if (mMode == "form")
            {
                <div class="properties-footer">
                    <button class="btn-ok" @onclick="OnClose">&amp;OK</button>
                </div>
            }
        </div>
    </div>
}

@code {
    // === State ===
    private bool IsVisible = false;
    private string mMode = "form";
    private string DialogCaption = "Properties";
    private List<PropertyRow> GridRows = new();

    // === Database ===
// === Models ===
    public enum PropertyRowType
    {
        Data,
        Section,
        Spacer
    }

    public class PropertyRow
    {
        public PropertyRowType RowType { get; set; } = PropertyRowType.Data;
        public string Label { get; set; } = "";
        public string Value { get; set; } = "";
    }

    // === Public Methods ===

    /// <summary>
    /// Shows a tooltip-style properties dialog from a param array of key/value pairs.
    /// Use "PropertyGroup" as a key to create section headers.
    /// </summary>
    public void ShowArray(params string[] parameters)
    {
        mMode = "tip";
        GridRows.Clear();

        for (int i = 0; i < parameters.Length - 1; i += 2)
        {
            var key = parameters[i] ?? "";
            var value = parameters[i + 1] ?? "";

            if (key == "PropertyGroup")
            {
                if (GridRows.Count > 0)
                {
                    GridRows.Add(new PropertyRow { RowType = PropertyRowType.Spacer });
                }
                GridRows.Add(new PropertyRow
                {
                    RowType = PropertyRowType.Section,
                    Label = value
                });
            }
            else
            {
                GridRows.Add(new PropertyRow
                {
                    RowType = PropertyRowType.Data,
                    Label = key,
                    Value = value
                });
            }
        }

        IsVisible = true;
        StateHasChanged();
    }

    /// <summary>
    /// Shows properties from a SQL query result. Column names starting with "SECTION" create section headers.
    /// </summary>
    public async Task ShowSQL(string caption, string sql, object? parameters = null)
    {
        mMode = "form";
        DialogCaption = caption;
        GridRows.Clear();

        try
        {
            var dt = db.SqlExec(sql, parameters);
            if (dt.Rows.Count == 0) return;

            var row = dt.Rows[0];
            for (int i = 0; i < dt.Columns.Count; i++)
            {
                var columnName = dt.Columns[i].ColumnName;
                var value = row[i]?.ToString() ?? "";

                if (columnName.StartsWith("SECTION", StringComparison.OrdinalIgnoreCase))
                {
                    if (GridRows.Count > 0)
                    {
                        GridRows.Add(new PropertyRow { RowType = PropertyRowType.Spacer });
                    }
                    GridRows.Add(new PropertyRow
                    {
                        RowType = PropertyRowType.Section,
                        Label = value
                    });
                }
                else
                {
                    GridRows.Add(new PropertyRow
                    {
                        RowType = PropertyRowType.Data,
                        Label = SpaceCase(columnName),
                        Value = value
                    });
                }
            }

            IsVisible = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

        }
    }

    /// <summary>
    /// Shows a modal form with key/value pairs.
    /// </summary>
    public void ShowForm(string caption, params string[] parameters)
    {
        mMode = "form";
        DialogCaption = caption;
        GridRows.Clear();

        for (int i = 0; i < parameters.Length - 1; i += 2)
        {
            GridRows.Add(new PropertyRow
            {
                RowType = PropertyRowType.Data,
                Label = (parameters[i] ?? "") + " ",
                Value = parameters[i + 1] ?? ""
            });
        }

        IsVisible = true;
        StateHasChanged();
    }

    /// <summary>
    /// Closes the properties dialog.
    /// </summary>
    public void Close()
    {
        OnClose();
    }

    // === Event Handlers ===

    private void OnClose()
    {
        IsVisible = false;
        StateHasChanged();
    }

    // === Helpers ===

    /// <summary>
    /// Converts a PascalCase or camelCase string to space-separated words.
    /// e.g., "FirstName" -> "First Name"
    /// </summary>
    private static string SpaceCase(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;

        var result = new System.Text.StringBuilder();
        for (int i = 0; i < input.Length; i++)
        {
            var c = input[i];
            if (c == '_')
            {
                result.Append(' ');
            }
            else if (i > 0 && char.IsUpper(c) && !char.IsUpper(input[i - 1]))
            {
                result.Append(' ');
                result.Append(c);
            }
            else
            {
                result.Append(c);
            }
        }
        return result.ToString();
    }
}
