@page "/export-ar-estimates"
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FExportAREstimates> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>AR Estimate Posting Wizard</PageTitle>

<div class="wizard-container" style="position: relative;">
    @if (IsLoading)
    {
        <div class="loading-overlay">
            <span>⏳ Loading...</span>
        </div>
    }

    @* ── Wizard Header ─────────────────────────────────────── *@
    <div class="wizard-header">
        <img src="images/32/accounting.ico" class="wizard-header-icon" alt="Wizard"
             onerror="this.style.display='none'" />
        <div class="wizard-header-text">
            <h3>Post AR Estimates to Accounting</h3>
            <p>The posting wizard will send AR estimates to accounting</p>
        </div>
    </div>

    @* ── Wizard Body ───────────────────────────────────────── *@
    <div class="wizard-body">
        @switch (CurrentFrame)
        {
            case 0:
                @* Frame 0: Choose Task *@
                <div class="frame-content">
                    <img src="images/32/accounting.ico" class="frame-icon" alt=""
                         onerror="this.style.display='none'" />
                    <div class="frame-body">
                        <label>Choose the task you would like to perform</label>
                        <div class="radio-option">
                            <RadioControl TValue="bool" Name="taskChoice" Value="true"
                                          SelectedValue="@IsPostNew"
                                          SelectedValueChanged="@(_ => OnTaskChanged(true))"
                                          Label="Post new estimates" />
                        </div>
                        <div class="radio-option">
                            <RadioControl TValue="bool" Name="taskChoice" Value="false"
                                          SelectedValue="@IsPostNew"
                                          SelectedValueChanged="@(_ => OnTaskChanged(false))"
                                          Label="Review a previous posting" />
                        </div>
                    </div>
                </div>
                break;

            case 1:
                @* Frame 1: Data Grid *@
                <div class="frame-content">
                    <img src="images/32/accounting.ico" class="frame-icon" alt=""
                         onerror="this.style.display='none'" />
                    <div class="frame-body">
                        <label>@ListDescription</label>
                        <div class="data-grid-container">
                            <table>
                                <thead>
                                    <tr>
                                        @if (IsPostNew)
                                        {
                                            <th style="width:30px;">
                                                <CheckBoxControl @bind-Checked="SelectAll"
                                                                 @bind-Checked:after="OnSelectAllChanged" />
                                            </th>
                                            <th>Community</th>
                                            <th>Phase</th>
                                            <th>Description</th>
                                            <th>Job</th>
                                            <th>Job Description</th>
                                            <th>Item</th>
                                            <th>Qty</th>
                                            <th>Rate</th>
                                            <th>Amount</th>
                                            <th>Billing Code</th>
                                            <th>Billing Category</th>
                                            <th>Errors</th>
                                        }
                                        else
                                        {
                                            <th>Batch</th>
                                            <th>Posted</th>
                                            <th>Posted By</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (GridData.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="@(IsPostNew ? 13 : 3)" style="text-align:center; color:#999; padding:20px;">
                                                No records found.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in GridData)
                                        {
                                            var rowClass = row.IsSelected ? "selected" : "";
                                            var errorClass = !string.IsNullOrEmpty(row.ValidationErrors) ? "has-errors" : "";

                                            <tr class="@rowClass @errorClass" @onclick="() => OnRowClicked(row)">
                                                @if (IsPostNew)
                                                {
                                                    <td>
                                                        <CheckBoxControl @bind-Checked="row.IsSelected"
                                                                         @bind-Checked:after="OnSelectionChanged"
                                                                         StopClickPropagation="true" />
                                                    </td>
                                                    <td>@row.Community</td>
                                                    <td>@row.Phase</td>
                                                    <td>@row.Description</td>
                                                    <td>@row.Job</td>
                                                    <td>@row.JobDescription</td>
                                                    <td>@row.Item</td>
                                                    <td style="text-align:right;">@row.Qty.ToString("N2")</td>
                                                    <td style="text-align:right;">@row.Rate.ToString("N2")</td>
                                                    <td style="text-align:right;">@row.Amount.ToString("N2")</td>
                                                    <td>@row.BillingCode</td>
                                                    <td>@row.BillingCategory</td>
                                                    <td style="color:red;">@row.ValidationErrors</td>
                                                }
                                                else
                                                {
                                                    <td>@row.Batch</td>
                                                    <td>@row.Posted</td>
                                                    <td>@row.PostedBy</td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                break;

            case 2:
                @* Frame 2: Ready / Review *@
                <div class="frame-content">
                    <img src="images/32/accounting.ico" class="frame-icon" alt=""
                         onerror="this.style.display='none'" />
                    <div class="frame-body">
                        @if (!IsPostNew)
                        {
                            <p class="message-label">The posting wizard is ready to proceed.</p>
                            <div style="margin-left: 24px;">
                                <span class="review-link" @onclick="OnOpenPostingSummaryReport">
                                    Open the posting summary report
                                </span>
                            </div>
                        }
                        else
                        {
                            <p class="message-label">The posting wizard is ready to proceed.</p>
                            <p style="font-size:13px; color:#495057;">
                                Click <strong>Finish</strong> to post the selected AR estimates to accounting.
                            </p>
                        }
                    </div>
                </div>
                break;
        }
    </div>

    @* ── Wizard Footer ─────────────────────────────────────── *@
    <div class="wizard-footer">
        <ButtonControl OnClick="OnCancelClick">
            &amp;Cancel
        </ButtonControl>
        <ButtonControl Disabled="@(CurrentFrame <= 0)" OnClick="OnBackClick">
            &lt; &amp;Back
        </ButtonControl>
        <ButtonControl Disabled="@(!CanGoNext)" OnClick="OnNextClick">
            &amp;Next &gt;
        </ButtonControl>
        <ButtonControl CssClass="btn-primary" Disabled="@(!CanFinish)" OnClick="OnFinishClick">
            &amp;Finish
        </ButtonControl>
    </div>
</div>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    // === Database ===
// === App State (would come from a shared service in production) ===
    private string LoginID = "admin";

    // === Wizard State ===
    private int CurrentFrame = 0;
    private const int MaxFrame = 2;
    private bool IsPostNew = true;
    private bool IsLoading = false;
    private long mBatch = 0;
    private string WhereClause = "";

    // === Grid Data ===
    private List<GridRow> GridData = new();
    private string ListDescription = "";
    private bool SelectAll = false;

    // === Navigation State ===
    private bool CanGoNext => CurrentFrame < MaxFrame && IsNextAllowed();
    private bool CanFinish => CurrentFrame == MaxFrame;

    // === Models ===
    public class GridRow
    {
        // Common
        public long EstAssemblyID { get; set; }
        public bool IsSelected { get; set; }

        // Post New columns
        public string Community { get; set; } = "";
        public string Phase { get; set; } = "";
        public string Description { get; set; } = "";
        public string Job { get; set; } = "";
        public string JobDescription { get; set; } = "";
        public string Item { get; set; } = "";
        public decimal Qty { get; set; }
        public decimal Rate { get; set; }
        public decimal Amount { get; set; }
        public string BillingCode { get; set; } = "";
        public string BillingCategory { get; set; } = "";
        public string ValidationErrors { get; set; } = "";

        // Review columns
        public long Batch { get; set; }
        public string Posted { get; set; } = "";
        public string PostedBy { get; set; } = "";
    }

    // === Lifecycle ===
    protected override void OnInitialized()
    {
        CurrentFrame = 0;
    }

    // === Navigation ===
    private bool IsNextAllowed()
    {
        switch (CurrentFrame)
        {
            case 0:
                return true;
            case 1:
                return SelectionValid();
            default:
                return false;
        }
    }

    private bool SelectionValid()
    {
        if (!IsPostNew)
        {
            // For review mode, just need a row selected
            return GridData.Any(r => r.IsSelected);
        }

        // For post new, check that selected rows have no validation errors
        var selectedRows = GridData.Where(r => r.IsSelected).ToList();
        if (selectedRows.Count == 0) return false;
        return selectedRows.All(r => string.IsNullOrEmpty(r.ValidationErrors));
    }

    private async Task OnCancelClick()
    {
        ClosePage();
    }

    private async Task OnBackClick()
    {
        if (CurrentFrame > 0)
        {
            CurrentFrame--;
        }
    }

    private async Task OnNextClick()
    {
        if (CurrentFrame < MaxFrame)
        {
            CurrentFrame++;
            await OnFrameChanged();
        }
    }

    private async Task OnFinishClick()
    {
        if (IsPostNew)
        {
            await CreateBatch();
        }
        ClosePage();
    }

    private async Task OnFrameChanged()
    {
        switch (CurrentFrame)
        {
            case 1:
                await LoadData();
                break;
            case 2:
                LoadTasks();
                break;
        }
    }

    // === Task Selection ===
    private void OnTaskChanged(bool postNew)
    {
        IsPostNew = postNew;
        StateHasChanged();
    }

    // === Load Tasks (Frame 2) — VB6 LoadTasks ===
    private void LoadTasks()
    {
        if (!IsPostNew)
        {
            // Review mode - get selected batch (VB6: mBatch = gData.ValueMatrix(gData.Row, 0))
            var selectedRow = GridData.FirstOrDefault(r => r.IsSelected);
            if (selectedRow != null)
            {
                mBatch = selectedRow.Batch;
            }
        }
        // VB6: in post-new mode, cmdNav(3).Enabled = True (Finish enabled)
        // This is handled via CanFinish property (CurrentFrame == MaxFrame)
    }

    // === Load Data (Frame 1) ===
    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            bool isUSVersion = await GetIsUSVersion();
            GridData.Clear();

            if (!IsPostNew)
            {
                // Review mode - load batches
                ListDescription = "Select the batch you would like to review.";
                var sql = @"
                    SELECT Batch, TStmp AS Posted, UStmp AS PostedBy
                    FROM Batches
                    WHERE DivisionID = @DivisionID AND BatchType = 'AR Estimate Posting'
                    ORDER BY Batch DESC";

                var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });
                foreach (var row in rows)
                {
                    GridData.Add(new GridRow
                    {
                        Batch = Convert.ToInt64(row["Batch"]),
                        Posted = row["Posted"]?.ToString() ?? "",
                        PostedBy = row["PostedBy"]?.ToString() ?? ""
                    });
                }
            }
            else
            {
                // Post new mode - load estimates
                ListDescription = "Select the estimates you would like to post.";

                var sql = @"
                    SELECT
                        a.EstAssemblyID,
                        c.area AS Community,
                        j.CommunityPhase AS Phase,
                        c.Description,
                        j.job_no AS Job,
                        j.Description AS [Job Description],
                        a.HFDescription AS Item,
                        a.SalesQty AS Qty,
                        a.SalesRate * m.BillingFactor AS Rate,
                        a.SalesQty * a.SalesRate * m.BillingFactor AS Amount,
                        cc.description AS BillingCode,
                        cat.description AS BillingCategory,
                        CASE WHEN cc.costcode IS NULL THEN 'invalid billing code, ' ELSE '' END
                        + CASE WHEN cat.category IS NULL THEN 'invalid billing category, ' ELSE '' END"
                    + (isUSVersion ? "" : @"
                        + CASE WHEN ISNULL(t.taxgroup,'') = '' THEN 'invalid AR taxgroup, ' ELSE '' END")
                    + @" AS ValidationErrors
                    FROM estimateassemblies a
                    JOIN tbljobs j ON a.job = j.job_no AND a.divisionid = j.divisionid
                    JOIN tbllocality c ON c.area = j.community
                    JOIN tblDBAssemblyMaster m ON
                        m.DivisionID = a.DivisionID AND
                        m.Community = dbo.Purch_GetAssemblyCommunity(a.Assembly,
                            CASE WHEN (a.AssemblyType = 3 OR a.AssemblyType = 4) THEN '' ELSE a.Model END,
                            a.OptionID, j.Community, a.DivisionID) AND
                        m.Assembly = a.Assembly AND
                        m.OptionID = a.OptionID AND
                        m.Model = CASE WHEN a.AssemblyType = 0 OR a.AssemblyType = 2 THEN a.Model ELSE '' END
                    LEFT OUTER JOIN standardCostcodes cc ON m.divisionid = cc.divisionid AND m.BillingCode = cc.costcode
                    LEFT OUTER JOIN standardcategories cat ON m.divisionid = cat.divisionid AND m.BillingCategory = cat.category
                    LEFT OUTER JOIN taxgroups t ON m.divisionid = t.divisionid AND j.artaxgroup = t.taxgroup
                    WHERE ISNULL(a.AREstimatePostingBatch, 0) = 0
                        AND a.Divisionid = @DivisionID
                    ORDER BY c.area, j.communityphase, j.job_no";

                var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });
                foreach (var row in rows)
                {
                    GridData.Add(new GridRow
                    {
                        EstAssemblyID = Convert.ToInt64(row["EstAssemblyID"]),
                        Community = row["Community"]?.ToString() ?? "",
                        Phase = row["Phase"]?.ToString() ?? "",
                        Description = row["Description"]?.ToString() ?? "",
                        Job = row["Job"]?.ToString() ?? "",
                        JobDescription = row["Job Description"]?.ToString() ?? "",
                        Item = row["Item"]?.ToString() ?? "",
                        Qty = SafeDecimal(row["Qty"]),
                        Rate = SafeDecimal(row["Rate"]),
                        Amount = SafeDecimal(row["Amount"]),
                        BillingCode = row["BillingCode"]?.ToString() ?? "",
                        BillingCategory = row["BillingCategory"]?.ToString() ?? "",
                        ValidationErrors = row["ValidationErrors"]?.ToString()?.TrimEnd(',', ' ') ?? ""
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            Notifications.Error($"Error loading data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Create Batch ===
    private async Task CreateBatch()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            // Create new batch
            var insertSql = @"
                INSERT INTO Batches(BatchType, UStmp, TStmp, DivisionID)
                VALUES('AR Estimate Posting', @LoginID, GETDATE(), @DivisionID)";
            await db.ExecuteAsync(insertSql, new { LoginID, SessionState.DivisionID });

            // Get the new batch identity
            mBatch = await db.ExecuteScalarAsync<long>("SELECT IDENT_CURRENT('Batches')");

            // Build where clause from selected items
            var selectedIds = GridData
                .Where(r => r.IsSelected)
                .Select(r => r.EstAssemblyID.ToString())
                .ToList();

            if (selectedIds.Count == 0) return;

            WhereClause = $"estassemblyid IN ({string.Join(",", selectedIds)})";

            // Update selected items with batch number
            var updateSql = $@"
                UPDATE EstimateAssemblies
                SET AREstimatePostingBatch = @Batch
                WHERE ISNULL(AREstimatePostingBatch, 0) = 0 AND {WhereClause}";
            await db.ExecuteAsync(updateSql, new { Batch = mBatch });

            // Send batch to accounting
            await SendBatch();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            Notifications.Error($"Error creating batch: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Send Batch — VB6 dispatches by AccountingSystem option ===
    private async Task SendBatch()
    {
        // VB6: Select Case HFApp.Options(AccountingSystem)
        //   Case asQuickBooks: Call SendBatchToQB
        // Currently only QuickBooks path is implemented
        try
        {
            var accountingSystem = await db.ExecuteScalarAsync<string>(
                "SELECT Value FROM Options WHERE Name = 'AccountingSystem'") ?? "";

            // VB6 enum: 1=Timberline, 2=MasterBuilder, 3=Quickbooks, 4=Sage50, 5=MYOB, 6=Peachtree, 7=Xero, 8=Spectrum
            switch (accountingSystem.ToLower())
            {
                case "3":
                case "quickbooks":
                    await SendBatchToQB();
                    break;
                default:
                    Console.WriteLine($"Accounting system '{accountingSystem}' not yet implemented");

                    await SendBatchToQB(); // Fallback to QB path
                    break;
            }
        }
        catch
        {
            // Fallback if Options table lookup fails
            await SendBatchToQB();
        }
    }

    private async Task SendBatchToQB()
    {
        try
        {
            bool isUSVersion = await GetIsUSVersion();

            // VB6: ensure external job IDs exist — write any missing jobs to accounting
            var jobCheckSql = $@"
                SELECT j.ExternalJobID, j.Job_no
                FROM estimateassemblies a
                JOIN tbljobs j ON a.job = j.job_no
                WHERE ISNULL(j.ExternalJobID, '') = '' AND {WhereClause}";
            var jobRows = await db.QueryAsync(jobCheckSql);
            foreach (var jobRow in jobRows)
            {
                var jobNo = jobRow["Job_no"]?.ToString() ?? "";
                // VB6: Call HFApp.WriteJobToAccounting("" & rs("job_no"))
                // TODO: Implement WriteJobToAccounting service call
                Console.WriteLine($"WriteJobToAccounting needed for job {jobNo}");

            }

            // VB6: Load batch detail data for QB XML construction
            var sql = $@"
                SELECT
                    cc.ExternalID AS JCCostCode,
                    cat.ExternalID AS JCCategory,
                    a.SalesQty * m.BillingFactor AS Qty,
                    a.SalesRate AS Rate,
                    j.ARTaxGroup AS TaxGroup,
                    a.HFDescription AS ItemDesc,
                    j.ExternalJobID,
                    j.job_no,
                    j.notes
                FROM estimateassemblies a
                JOIN tbljobs j ON a.job = j.job_no AND a.divisionid = j.divisionid
                JOIN tbllocality c ON c.area = j.community
                JOIN tblDBAssemblyMaster m ON
                    m.DivisionID = a.DivisionID AND
                    m.Community = dbo.Purch_GetAssemblyCommunity(a.Assembly,
                        CASE WHEN (a.AssemblyType = 3 OR a.AssemblyType = 4) THEN '' ELSE a.Model END,
                        a.OptionID, j.Community, a.DivisionID) AND
                    m.Assembly = a.Assembly AND
                    m.OptionID = a.OptionID AND
                    m.Model = CASE WHEN a.AssemblyType = 0 OR a.AssemblyType = 2 THEN a.Model ELSE '' END
                LEFT OUTER JOIN standardCostcodes cc ON m.divisionid = cc.divisionid AND m.BillingCode = cc.costcode
                LEFT OUTER JOIN standardcategories cat ON m.divisionid = cat.divisionid AND m.BillingCategory = cat.category
                WHERE ISNULL(a.AREstimatePostingBatch, 0) = @Batch
                ORDER BY j.ExternalJobID, a.HFDescription";

            var rows = await db.QueryAsync(sql, new { Batch = mBatch });

            // VB6: Build QuickBooks XML — EstimateAdd requests grouped by ExternalJobID
            // Each unique ExternalJobID gets its own EstimateAddRq with line items
            string lastJob = "";
            int estimateCount = 0;
            var xmlLines = new System.Text.StringBuilder();

            foreach (var row in rows)
            {
                var thisJob = row["ExternalJobID"]?.ToString() ?? "";
                var jobNo = row["job_no"]?.ToString() ?? "";

                if (thisJob != lastJob)
                {
                    // VB6: close previous EstimateAdd if any, submit, start new
                    if (!string.IsNullOrEmpty(lastJob))
                    {
                        xmlLines.AppendLine("</EstimateAdd></EstimateAddRq>");
                        // VB6: s = HFApp.XmlQBSubmit(s) — submit previous estimate
                        Console.WriteLine($"Submitting estimate for job {lastJob}");

                    }
                    estimateCount++;
                    lastJob = thisJob;

                    // VB6: Build EstimateAddRq header with CustomerRef
                    xmlLines.AppendLine($"<EstimateAddRq requestID=\"1\">");
                    xmlLines.AppendLine($"<EstimateAdd>");
                    xmlLines.AppendLine($"<CustomerRef><ListID>{thisJob}</ListID></CustomerRef>");
                    xmlLines.AppendLine($"<TxnDate>{DateTime.Now:yyyy-MM-dd}</TxnDate>");
                    var notes = row["notes"]?.ToString() ?? "";
                    if (!string.IsNullOrEmpty(notes))
                        xmlLines.AppendLine($"<Memo>{System.Security.SecurityElement.Escape(notes)}</Memo>");
                }

                // VB6: Build EstimateLineAdd for each row
                xmlLines.AppendLine("<EstimateLineAdd>");
                xmlLines.AppendLine($"<ItemRef><ListID>{row["JCCostCode"]}</ListID></ItemRef>");
                xmlLines.AppendLine($"<Desc>{System.Security.SecurityElement.Escape(row["ItemDesc"]?.ToString() ?? "")}</Desc>");
                xmlLines.AppendLine($"<Quantity>{SafeDecimal(row["Qty"]):F5}</Quantity>");
                xmlLines.AppendLine($"<Rate>{SafeDecimal(row["Rate"]):F2}</Rate>");
                xmlLines.AppendLine($"<ClassRef><ListID>{row["JCCategory"]}</ListID></ClassRef>");

                // VB6: Canadian version includes SalesTaxCodeRef
                if (!isUSVersion)
                {
                    var taxGroup = row["TaxGroup"]?.ToString() ?? "";
                    if (!string.IsNullOrEmpty(taxGroup))
                        xmlLines.AppendLine($"<SalesTaxCodeRef><FullName>{System.Security.SecurityElement.Escape(taxGroup)}</FullName></SalesTaxCodeRef>");
                }
                xmlLines.AppendLine("</EstimateLineAdd>");
            }

            // VB6: close and submit last estimate
            if (!string.IsNullOrEmpty(lastJob))
            {
                xmlLines.AppendLine("</EstimateAdd></EstimateAddRq>");
                // VB6: s = HFApp.XmlQBSubmit(s) — final submission
                Console.WriteLine($"Submitting final estimate for job {lastJob}");

            }

            // TODO: Replace Console.WriteLine with actual QB SDK submission via HFApp.XmlQBSubmit
            Console.WriteLine($"Batch {mBatch}: {rows.Count} line items across {estimateCount} estimate(s)");

            Console.WriteLine($"Generated XML:\n{xmlLines}");


            Notifications.Warning($"Batch {mBatch} created successfully with {rows.Count} line item(s); across {estimateCount} estimate(s).");

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            Notifications.Error($"Error sending batch: {ex.Message}");
        }
    }

    // === Row Selection ===
    private void OnRowClicked(GridRow row)
    {
        if (!IsPostNew)
        {
            // Single selection for review mode
            foreach (var r in GridData)
                r.IsSelected = false;
            row.IsSelected = true;
        }
        else
        {
            row.IsSelected = !row.IsSelected;
        }
        OnSelectionChanged();
    }

    private void OnSelectionChanged()
    {
        SelectAll = GridData.Count > 0 && GridData.All(r => r.IsSelected);
        StateHasChanged();
    }

    private void OnSelectAllChanged()
    {
        foreach (var row in GridData)
        {
            row.IsSelected = SelectAll;
        }
        StateHasChanged();
    }

    // === Review Report — VB6 lblBatchTask_Click(0) ===
    private async Task OnOpenPostingSummaryReport()
    {
        // VB6: Opens Crystal Report "System\Reports\Estimating\ExportAREstimateBatch.rpt"
        //   with parameters SessionState.DivisionID and Batch
        // TODO: Integrate with report viewer service when available
        try
        {
            var reportPath = "System/Reports/Estimating/ExportAREstimateBatch.rpt";
            var reportUrl = $"/report-viewer?report={Uri.EscapeDataString(reportPath)}&DivisionID ={SessionState.DivisionID}&Batch={mBatch}";
            await JSRuntime.InvokeVoidAsync("open", reportUrl, "_blank");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            Notifications.Error($"Unable to open the posting summary report for Batch {mBatch}. Report viewer not yet configured.");
        }
    }

    // === Helpers ===
    private async Task<bool> GetIsUSVersion()
    {
        try
        {
            var version = await db.ExecuteScalarAsync<string>(
                "SELECT Value FROM Options WHERE Name = 'AccountingVersion'");
            return !string.Equals(version, "CA", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return true;
        }
    }

    private decimal SafeDecimal(object? val, decimal def = 0) =>
        val != null && val != DBNull.Value && !string.IsNullOrEmpty(val.ToString())
            ? Convert.ToDecimal(val)
            : def;
}
