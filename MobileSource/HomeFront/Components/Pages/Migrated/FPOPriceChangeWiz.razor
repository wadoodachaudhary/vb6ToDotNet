    // ── Preferences ──────────────────────────────────────────────────────
    private async Task SaveCategoryPreference()
    {
        try
        {
            var catText = CategoryList.FirstOrDefault(c => c.Value == SelectedCategory)?.Text ?? "";
            // VB6 FPOPriceChangeWiz.Form_Unload: HFApp.Options.ValueByName("ChangeWizCategory") = cboCategory.Text
            // ChangeWizCategory is not in OptionsEnum, so SetValueByName writes the DIVISION-SPECIFIC
            // AppOptions row (UID='', DivisionID=@Div). Stores the combo's display TEXT, not the key.
            await db.ExecuteAsync(@"
                UPDATE AppOptions
                   SET OptionValue=@Value, UStmp=@UID, TStmp=GETDATE()
                 WHERE OptionName=@Name AND ISNULL(UID,'')='' AND ISNULL(divisionid,0)=@DivisionID;
                IF @@ROWCOUNT=0
                    INSERT INTO AppOptions(UID, OptionName, OptionValue, DivisionID, UStmp, TStmp)
                    VALUES('', @Name, @Value, @DivisionID, @UID, GETDATE());",
                new { Name = "ChangeWizCategory", Value = catText, DivisionID = SessionState.DivisionID, UID = "" });
        }
        catch { /* non-critical */ }
    }

    // ── Helpers ──────────────────────────────────────────────────────────
    private string EscapeSql(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        return value.Replace("'", "''");
    }

    private decimal SafeDecimal(object? val, decimal def = 0)
    {
        if (val == null || val == DBNull.Value) return def;
        var s = val.ToString();
        if (string.IsNullOrWhiteSpace(s)) return def;
        return decimal.TryParse(s, out var result) ? result : def;
    }

