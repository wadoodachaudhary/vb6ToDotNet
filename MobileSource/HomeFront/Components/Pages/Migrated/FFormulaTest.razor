```razor
@page "/formula-test"
@rendermode InteractiveServer

@using HomeFront.Data
@using System.Data

@inject IJSRuntime JSRuntime

<PageTitle>Formula Test - HomeFront</PageTitle>

<style>
    .formula-test-container {
        max-width: 600px;
        margin: 20px auto;
        font-family: sans-serif;
    }

    .grid-container {
        border: 1px solid #dee2e6;
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .button-bar {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 8px 0;
    }

    .btn-nav {
        padding: 6px 20px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 13px;
        min-width: 90px;
    }

    .btn-nav:hover {
        background: #e9ecef;
    }

    .btn-nav.primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }

    .btn-nav.primary:hover {
        background: #0b5ed7;
    }

    .dialog-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dialog-panel {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
        min-width: 500px;
        max-width: 700px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px;
        font-weight: 600;
        font-size: 16px;
        border-bottom: 1px solid #dee2e6;
    }

    .dialog-header button {
        background: none;
        border: none;
        font-size: 22px;
        cursor: pointer;
        color: #6c757d;
        padding: 0 4px;
    }

    .dialog-header button:hover {
        color: #212529;
    }

    .dialog-body {
        padding: 20px;
        overflow-y: auto;
        flex: 1;
    }

    .dialog-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 12px 20px;
        border-top: 1px solid #dee2e6;
        background: #f8f9fa;
    }

    .tooltip-text {
        font-size: 12px;
        color: #6c757d;
        margin-top: 4px;
        min-height: 18px;
    }
</style>

@if (IsVisible)
{
    <div class="dialog-overlay" @onclick="OnClose">
        <div class="dialog-panel" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <span>Formula Test</span>
                <button @onclick="OnClose">×</button>
            </div>
            <div class="dialog-body">
                <div class="grid-container">
                    <HfGrid @ref="VariablesGrid"
                            TValue="FormulaVariable"
                            DataSource="@Variables"
                            AllowSelection="true"
                            AllowResizing="true"
                            EnableHover="true"
                            Height="300px"
                            RowHeight="32"
                            EditSettingsRef="@editSettings"
                            SelectionSettingsRef="@selectionSettings"
                            EventsRef="@gridEvents">
                        <HfGridColumnsBase>
                            <HfGridColumn Field="@nameof(FormulaVariable.Name)" HeaderText="Variable" Width="200px" AllowEditing="false" />
                            <HfGridColumn Field="@nameof(FormulaVariable.Value)" HeaderText="Value" Width="120px" AllowEditing="true" Type="ColumnType.Number" Format="N4" TextAlign="TextAlign.Right">
                                <EditTemplate>
                                    @{
                                        var data = (FormulaVariable)context;
                                        if (!string.IsNullOrEmpty(data.ListOfValues))
                                        {
                                            <select @bind="data.Value" style="width:100%; padding:4px;">
                                                @foreach (var opt in data.ListOfValues.Split('|'))
                                                {
                                                    var parts = opt.Split('=');
                                                    var val = parts.Length > 1 ? parts[0].Trim() : opt.Trim();
                                                    var display = parts.Length > 1 ? parts[1].Trim() : opt.Trim();
                                                    <option value="@double.Parse(val)">@display</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input type="number" step="any" @bind="data.Value"
                                                   min="@data.MinValue" max="@(data.MaxValue > 0 ? data.MaxValue : double.MaxValue)"
                                                   style="width:100%; padding:4px; border:1px solid #ced4da; border-radius:4px;" />
                                        }
                                    }
                                </EditTemplate>
                            </HfGridColumn>
                            <HfGridColumn Field="@nameof(FormulaVariable.Description)" HeaderText="Description" Width="200px" AllowEditing="false" />
                            <HfGridColumn Field="@nameof(FormulaVariable.SortOrder)" HeaderText="" Width="1px" Visible="false" />
                            <HfGridColumn Field="@nameof(FormulaVariable.MinValue)" HeaderText="" Width="1px" Visible="false" />
                            <HfGridColumn Field="@nameof(FormulaVariable.MaxValue)" HeaderText="" Width="1px" Visible="false" />
                            <HfGridColumn Field="@nameof(FormulaVariable.ListOfValues)" HeaderText="" Width="1px" Visible="false" />
                        </HfGridColumnsBase>
                    </HfGrid>
                </div>

                <div class="tooltip-text">@HoverTooltip</div>
            </div>
            <div class="dialog-footer">
                <button class="btn-nav primary" @onclick="OnTestClick">
                    &amp;Test
                </button>
                <button class="btn-nav" @onclick="OnClose">
                    &amp;Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    // === Parameters ===
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public string Formula { get; set; } = "";

    // === State ===
    private string mRawFormula = "";
    private string mResolvedFormula = "";
    private string mVariableList = "";
    private string HoverTooltip = "";

    private List<FormulaVariable> Variables = new();
    private HfGrid<FormulaVariable>? VariablesGrid;

    // === Grid Settings ===
    private HfSelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    private HfEditSettings editSettings = new()
    {
        AllowEditing = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };

    private HfGridEvents<FormulaVariable> gridEvents = new();

    // === Lifecycle ===
    protected override void OnInitialized()
    {
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<FormulaVariable>>(this, OnCellSaved);
    }

    protected override void OnParametersSet()
    {
        if (IsVisible && !string.IsNullOrEmpty(Formula))
        {
            TestFormula(Formula);
        }
    }

    // === Public API ===
    public void TestFormula(string formula)
    {
        mRawFormula = formula;
        mResolvedFormula = ResolveFormula(mRawFormula);
        mVariableList = ParseVariables(mResolvedFormula);
        Variables.Clear();
        LoadVariables(mVariableList);

        if (Variables.Count == 0)
        {
            // No variables needed — run formula directly
            OnTestClick();
            CloseDialog();
        }
    }

    // === Formula Resolution ===
    private string ResolveFormula(string rawFormula)
    {
        // Placeholder: In the real app, this would resolve nested formula references
        // For now, return the formula as-is
        return rawFormula ?? "";
    }

    private string ParseVariables(string resolvedFormula)
    {
        // Extract variable names from the formula
        // Variables are typically identifiers that are not numeric literals or operators
        var variables = new List<string>();
        var knownFunctions = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "ABS", "ROUND", "MIN", "MAX", "IF", "INT", "SQRT", "SIN", "COS", "TAN",
            "AREA", "LENGTH", "WIDTH", "QTY", "PITCH", "GETITEMTOTAL"
        };

        if (string.IsNullOrWhiteSpace(resolvedFormula))
            return "";

        // Simple tokenizer: find word tokens that aren't numbers or known functions
        var token = "";
        foreach (var ch in resolvedFormula + " ")
        {
            if (char.IsLetterOrDigit(ch) || ch == '_')
            {
                token += ch;
            }
            else
            {
                if (!string.IsNullOrEmpty(token))
                {
                    if (!double.TryParse(token, out _) &&
                        !knownFunctions.Contains(token) &&
                        !variables.Contains(token, StringComparer.OrdinalIgnoreCase))
                    {
                        variables.Add(token);
                    }
                    token = "";
                }
            }
        }

        return string.Join("|", variables);
    }

    private void LoadVariables(string variableList)
    {
        if (string.IsNullOrWhiteSpace(variableList))
            return;

        var vars = variableList.Split('|', StringSplitOptions.RemoveEmptyEntries);
        int sortOrder = 0;
        foreach (var v in vars)
        {
            Variables.Add(new FormulaVariable
            {
                Name = v.Trim(),
                Value = 0,
                Description = "",
                SortOrder = sortOrder++,
                MinValue = 0,
                MaxValue = 0,
                ListOfValues = ""
            });
        }

        // Sort by SortOrder then by Name
        Variables = Variables.OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToList();
    }

    // === Formula Calculation ===
    private double CalcFormula(List<FormulaVariable> variables, string resolvedFormula)
    {
        // Simple formula evaluator
        // Replace variable names with their values, then evaluate
        var expression = resolvedFormula;

        foreach (var variable in variables.OrderByDescending(v => v.Name.Length))
        {
            expression = expression.Replace(variable.Name, variable.Value.ToString("G"));
        }

        try
        {
            return EvaluateExpression(expression);
        }
        catch
        {
            throw new Exception($"Could not evaluate expression: {expression}");
        }
    }

    private double EvaluateExpression(string expression)
    {
        // Basic expression evaluator using DataTable.Compute
        try
        {
            var dt = new DataTable();
            var result = dt.Compute(expression, "");
            return Convert.ToDouble(result);
        }
        catch
        {
            // Fallback: try parsing as a simple number
            if (double.TryParse(expression, out var val))
                return val;
            throw;
        }
    }

    public double GetItemTotal(string totalType, string poIndex, string costCode, string phase, string item)
    {
        return 0;
    }

    // === Event Handlers ===
    private async Task OnTestClick()
    {
        try
        {
            var result = CalcFormula(Variables, mResolvedFormula);
            await JSRuntime.InvokeVoidAsync("alert",
                $"Formula is valid.\nReturn value: {Math.Round(result, 3)}");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert",
                $"Formula error: {ex.Message}");
        }
    }

    private async Task OnClose()
    {
        await CloseDialog();
    }

    private async Task CloseDialog()
    {
        IsVisible = false;
        if (IsVisibleChanged.HasDelegate)
            await IsVisibleChanged.InvokeAsync(false);
    }

    private void OnCellSaved(CellSaveArgs<FormulaVariable> args)
    {
        if (args.Data == null) return;

        var variable = args.Data;

        // Validate numeric input when no list of values
        if (string.IsNullOrEmpty(variable.ListOfValues))
        {
            if (variable.MaxValue > 0 && variable.Value > variable.MaxValue)
            {
                _ = JSRuntime.InvokeVoidAsync("alert",
                    $"The maximum value for {variable.Name} is '{variable.MaxValue:0}'. The number you have entered is too large.");
                variable.Value = variable.MaxValue;
            }

            if (variable.Value < variable.MinValue)
            {
                _ = JSRuntime.InvokeVoidAsync("alert",
                    $"The minimum value for {variable.Name} is '{variable.MinValue:0}'. The number you have entered is too small.");
                variable.Value = variable.MinValue;
            }
        }
    }

    // === Model ===
    public class FormulaVariable
    {
        public string Name { get; set; } = "";
        public double Value { get; set; }
        public string Description { get; set; } = "";
        public int SortOrder { get; set; }
        public double MinValue { get; set; }
        public double MaxValue { get; set; }
        public string ListOfValues { get; set; } = "";
    }
}
