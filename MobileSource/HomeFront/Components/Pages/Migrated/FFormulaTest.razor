@namespace HomeFront.Components.Pages

@using HomeFront.Models
@using HomeFront.Data
@using System.Data
@using System.Reflection
@using System.Text
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject DbWrapperSqlServer db
@inject ILogger<FFormulaTest> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject IGridLayoutService GridLayoutSvc

<PageTitle>Formula Test - HomeFront</PageTitle>

@* Formula Test dialog — FlexKit DialogControl (was a hand-rolled overlay+panel). Overlay-click
   and the × icon both route through OnClose, preserving the original close path. *@
<DialogControl Visible="IsVisible" Header="Formula Test" Width="700px" CssClass="formula-test-dialog" OnClose="OnClose">
    <ChildContent>
                <div class="grid-container">
                    <GridControl @ref="VariablesGrid"
                            TValue="FormulaVariable"
                            DataSource="@Variables"
                            AllowSelection="true"
                            AllowResizing="true"
                            EnableHover="true"
                            Height="300px"
                            RowHeight="32"
                            EditSettingsRef="@editSettings"
                            SelectionSettingsRef="@selectionSettings"
                            EventsRef="@gridEvents">
                        <GridColumnsBase @key="gVariablesGridLayoutVersion">
                            @if (HasGridLayout)
                            {
                                foreach (var entry in GetOrderedGridLayout())
                                {
                                    var layout = entry.Layout;
                                    var fieldName = entry.Field;
                                    var columnType = entry.ColumnType;
                                    var textAlign = entry.TextAlign;
                                    var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                                    var width = layout.Width.HasValue && layout.Width.Value > 0
                                        ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;

                                    if (fieldName == "Value")
                                    {
                                        <GridColumn Field="Value" HeaderText="@headerText" Width="@(width ?? "120px")" AllowEditing="true" Type="ColumnType.Number" Format="N4" TextAlign="TextAlign.Right">
                                            <EditTemplate>
                                                @{
                                                    var data = (FormulaVariable)context;
                                                    if (!string.IsNullOrEmpty(data.ListOfValues))
                                                    {
                                                        <DropDownListControl TValue="double" TItem="ListValueItem"
                                                                             DataSource="@ParseListOfValues(data.ListOfValues)"
                                                                             Value="@data.Value"
                                                                             ValueChanged="@(v => data.Value = v)"
                                                                             TextFieldName="@nameof(ListValueItem.Display)"
                                                                             ValueFieldName="@nameof(ListValueItem.Value)"
                                                                             Width="100%"
                                                                             CssClass="formula-value-editor" />
                                                    }
                                                    else
                                                    {
                                                        <NumericTextBoxControl TValue="double" @bind-Value="data.Value"
                                                                               Step="1" Width="100%"
                                                                               CssClass="formula-value-editor" />
                                                    }
                                                }
                                            </EditTemplate>
                                        </GridColumn>
                                    }
                                    else
                                    {
                                        <GridColumn Field="@fieldName"
                                                      HeaderText="@headerText"
                                                      Width="@width"
                                                      Type="@columnType"
                                                      TextAlign="@textAlign"
                                                      AllowEditing="false"
                                                      ClipMode="ClipMode.Ellipsis" />
                                    }
                                }
                                <GridColumn Field="@nameof(FormulaVariable.SortOrder)" HeaderText="" Width="1px" Visible="false" />
                                <GridColumn Field="@nameof(FormulaVariable.MinValue)" HeaderText="" Width="1px" Visible="false" />
                                <GridColumn Field="@nameof(FormulaVariable.MaxValue)" HeaderText="" Width="1px" Visible="false" />
                                <GridColumn Field="@nameof(FormulaVariable.ListOfValues)" HeaderText="" Width="1px" Visible="false" />
                            }
                            else
                            {
                                @* Fallback: hardcoded columns matching VB6 VariablesGrid *@
                                <GridColumn Field="@nameof(FormulaVariable.Name)" HeaderText="Variable" Width="200px" AllowEditing="false" />
                                <GridColumn Field="@nameof(FormulaVariable.Value)" HeaderText="Value" Width="120px" AllowEditing="true" Type="ColumnType.Number" Format="N4" TextAlign="TextAlign.Right">
                                    <EditTemplate>
                                        @{
                                            var data = (FormulaVariable)context;
                                            if (!string.IsNullOrEmpty(data.ListOfValues))
                                            {
                                                <DropDownListControl TValue="double" TItem="ListValueItem"
                                                                     DataSource="@ParseListOfValues(data.ListOfValues)"
                                                                     Value="@data.Value"
                                                                     ValueChanged="@(v => data.Value = v)"
                                                                     TextFieldName="@nameof(ListValueItem.Display)"
                                                                     ValueFieldName="@nameof(ListValueItem.Value)"
                                                                     Width="100%"
                                                                     CssClass="formula-value-editor" />
                                            }
                                            else
                                            {
                                                <NumericTextBoxControl TValue="double" @bind-Value="data.Value"
                                                                       Step="1" Width="100%"
                                                                       CssClass="formula-value-editor" />
                                            }
                                        }
                                    </EditTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(FormulaVariable.Description)" HeaderText="Description" Width="200px" AllowEditing="false" />
                                <GridColumn Field="@nameof(FormulaVariable.SortOrder)" HeaderText="" Width="1px" Visible="false" />
                                <GridColumn Field="@nameof(FormulaVariable.MinValue)" HeaderText="" Width="1px" Visible="false" />
                                <GridColumn Field="@nameof(FormulaVariable.MaxValue)" HeaderText="" Width="1px" Visible="false" />
                                <GridColumn Field="@nameof(FormulaVariable.ListOfValues)" HeaderText="" Width="1px" Visible="false" />
                            }
                        </GridColumnsBase>
                    </GridControl>
                </div>

                <div class="tooltip-text">@HoverTooltip</div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="btn-nav primary" OnClick="OnTestClick">&amp;Test</ButtonControl>
        <ButtonControl CssClass="btn-nav" OnClick="OnClose">&amp;Close</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    // === Parameters ===
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public string Formula { get; set; } = "";

    // === State ===
    private string mRawFormula = "";
    private string mResolvedFormula = "";
    private string mVariableList = "";
    private string HoverTooltip = "";

    private List<FormulaVariable> Variables = new();
    private GridControl<FormulaVariable>? VariablesGrid;

    // === Grid Settings ===
    private SelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    private EditSettings editSettings = new()
    {
        AllowEditing = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };

    private GridControlEvents<FormulaVariable> gridEvents = new();

    // ── Grid layout via the shared GridLayoutPresenter ─────────
    // The load/resolve/order/width boilerplate lives in GridLayoutPresenter<TRow>;
    // only the VB6 form/grid name strings stay here (fidelity). The members below
    // (gVariablesGridLayout / HasGridLayout / …Version) are thin delegations, so the
    // markup is unchanged. The keyed("(0)")-then-unkeyed two-call fallback that
    // LoadGridLayoutAsync used is now expressed via the ctor's instanceKey.
    private readonly GridLayoutPresenter<FormulaVariable> _variablesGrid =
        new("FFormulaTest", "VariablesGrid", instanceKey: "(0)");

    private Dictionary<string, GridLayoutColumn> gVariablesGridLayout => _variablesGrid.Layout;
    private bool HasGridLayout => _variablesGrid.Has;
    private int gVariablesGridLayoutVersion => _variablesGrid.Version;

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<FormulaVariable>>(this, async (CellSaveArgs<FormulaVariable> e) => await OnCellSaved(e));
        await LoadGridLayoutAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !string.IsNullOrEmpty(Formula))
        {
            await TestFormula(Formula);
        }
    }

    // === Public API ===
    public async Task TestFormula(string formula)
    {
        mRawFormula = formula;
        mResolvedFormula = await ResolveFormulaAsync(mRawFormula);
        mVariableList = ParseVariables(mResolvedFormula);
        Variables.Clear();
        await LoadVariablesAsync(mVariableList);

        if (Variables.Count == 0)
        {
            // No variables needed — run formula directly
            await OnTestClick();
            await CloseDialog();
        }
        else
        {
            IsVisible = true;
            if (IsVisibleChanged.HasDelegate)
                await IsVisibleChanged.InvokeAsync(true);
            StateHasChanged();
        }
    }

    // === Formula Resolution ===
    // Resolves nested {formulaname} references by querying the formulas table.
    // Mirrors VB6 MFormulas.ResolveFormula
    private async Task<string> ResolveFormulaAsync(string rawFormula)
    {
        if (string.IsNullOrWhiteSpace(rawFormula))
            return "";

        var originalFormula = rawFormula;
        rawFormula = rawFormula.Replace("\r", " ").Replace("\n", " ").Trim();

        int iterations = 0;
        var callStack = new StringBuilder();

        while (rawFormula.Contains("{"))
        {
            iterations++;
            if (iterations > 30)
            {
                Notifications.Info($"Formula cannot be resolved.\n\n{originalFormula}\n\nCall Stack:\n{callStack}");
                return "";
            }

            var startIdx = rawFormula.IndexOf('{');
            var endIdx = rawFormula.IndexOf('}', startIdx);
            if (endIdx < 0) break;

            var name = rawFormula.Substring(startIdx + 1, endIdx - startIdx - 1);
            callStack.AppendLine(name);

            var rows = await db.QueryAsync(
                "SELECT text FROM formulas WHERE name=@Name",
                new { Name = name });
            var row = rows.FirstOrDefault();
            if (row == null)
            {
                Notifications.Info($"Unknown formula {name}");
                return "";
            }

            var formulaText = row["text"]?.ToString() ?? "";
            rawFormula = rawFormula.Replace("{" + name + "}", "(" + formulaText + ")");
        }

        return rawFormula;
    }

    // Extracts [variablename] references from a resolved formula.
    // Mirrors VB6 MFormulas.ParseVariables
    private string ParseVariables(string resolvedFormula)
    {
        if (string.IsNullOrWhiteSpace(resolvedFormula))
            return "";

        var list = new List<string>();
        var s = resolvedFormula;

        while (s.Contains("["))
        {
            var startIdx = s.IndexOf('[');
            var endIdx = s.IndexOf(']', startIdx);
            if (endIdx < 0) break;

            var name = s.Substring(startIdx + 1, endIdx - startIdx - 1);
            if (!list.Contains(name, StringComparer.OrdinalIgnoreCase))
                list.Add(name);

            // Remove this occurrence and continue scanning
            var old = s;
            s = s.Replace("[" + name + "]", "", StringComparison.OrdinalIgnoreCase);
            if (s == old) break; // safety
        }

        return string.Join("\x01", list);
    }

    // Loads variable metadata from the variables table.
    // Mirrors VB6 MFormulas.LoadVariables
    private async Task LoadVariablesAsync(string variableList)
    {
        if (string.IsNullOrWhiteSpace(variableList))
            return;

        var names = variableList.Split('\x01', StringSplitOptions.RemoveEmptyEntries);
        int sortOrder = 0;

        foreach (var rawName in names)
        {
            var name = rawName.Trim();
            if (string.IsNullOrEmpty(name)) continue;
            if (Variables.Any(v => v.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
                continue;

            var rows = await db.QueryAsync(
                "SELECT * FROM variables WHERE name=@Name",
                new { Name = name });
            var rs = rows.FirstOrDefault();

            var variable = new FormulaVariable { Name = name, SortOrder = sortOrder++ };

            if (rs == null)
            {
                // Variable not defined in DB — use wide min/max defaults
                variable.MinValue = -1E+18;
                variable.MaxValue = 1E+18;
            }
            else
            {
                var listOfValues = (rs["listofvalues"]?.ToString() ?? "").Trim();
                if (string.IsNullOrEmpty(listOfValues))
                {
                    variable.Value = double.TryParse(rs["defaultvalue"]?.ToString(), out var dv) ? dv : 0;
                    variable.UOM = rs["uom"]?.ToString() ?? "";
                    variable.MinValue = double.TryParse(rs["minimumvalue"]?.ToString(), out var mn) ? mn : 0;
                    variable.MaxValue = double.TryParse(rs["maximumvalue"]?.ToString(), out var mx) ? mx : 0;
                }
                else
                {
                    // listofvalues format: "val1=label1|val2=label2|..."
                    variable.ListOfValues = " |" + listOfValues;
                    // Default to second item's value (first is blank spacer)
                    var parts = variable.ListOfValues.Split('|');
                    if (parts.Length > 1)
                    {
                        var valPart = parts[1].Split('=');
                        variable.Value = double.TryParse(valPart[0].Trim(), out var lv) ? lv : 0;
                    }
                }
                variable.Description = rs["help"]?.ToString() ?? "";
            }

            Variables.Add(variable);
        }

        Variables = Variables.OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToList();
    }

    // === Formula Calculation ===
    // Mirrors VB6 MFormulas.CalcFormula — substitutes [VariableName] with values
    private double CalcFormula(List<FormulaVariable> variables, string resolvedFormula)
    {
        var expression = resolvedFormula;

        foreach (var variable in variables)
        {
            var placeholder = "[" + variable.Name + "]";
            if (!string.IsNullOrEmpty(variable.ListOfValues))
            {
                // List-of-values variables are substituted as quoted strings
                expression = Replace(expression, placeholder,
                    "\"" + variable.Value.ToString("G") + "\"");
            }
            else
            {
                expression = Replace(expression, placeholder,
                    variable.Value.ToString("G"));
            }
        }

        if (string.IsNullOrWhiteSpace(expression))
            return 0;

        try
        {
            return EvaluateExpression(expression);
        }
        catch (Exception ex) when (ex.Message.Contains("Divide by zero", StringComparison.OrdinalIgnoreCase))
        {
            throw new Exception("Divide by zero error encountered.");
        }
        catch
        {
            throw new Exception($"Could not evaluate expression: {expression}");
        }
    }

    // Case-insensitive replace helper
    private static string Replace(string source, string oldValue, string newValue)
    {
        return source.Replace(oldValue, newValue, StringComparison.OrdinalIgnoreCase);
    }

    private double EvaluateExpression(string expression)
    {
        // Basic expression evaluator using DataTable.Compute
        try
        {
            var dt = new DataTable();
            var result = dt.Compute(expression, "");
            return Convert.ToDouble(result);
        }
        catch
        {
            // Fallback: try parsing as a simple number
            if (double.TryParse(expression, out var val))
                return val;
            throw;
        }
    }

    public double GetItemTotal(string totalType, string poIndex, string costCode, string phase, string item)
    {
        return 0;
    }

    // === Event Handlers ===
    private async Task OnTestClick()
    {
        try
        {
            var result = CalcFormula(Variables, mResolvedFormula);
            Notifications.Info($"Formula is valid.\nReturn value: {Math.Round(result, 3)}");

        }
        catch (Exception ex)
        {
            Notifications.Error($"Formula error: {ex.Message}");
        }
    }

    private async Task OnClose()
    {
        await CloseDialog();
    }

    private async Task CloseDialog()
    {
        IsVisible = false;
        if (IsVisibleChanged.HasDelegate)
            await IsVisibleChanged.InvokeAsync(false);
    }

    // Mirrors VB6 gVariables_ValidateEdit — validates value range and rejects invalid input
    private async Task OnCellSaved(CellSaveArgs<FormulaVariable> args)
    {
        if (args.Data == null) return;

        var variable = args.Data;

        // When using a list-of-values, the dropdown handles validation
        if (!string.IsNullOrEmpty(variable.ListOfValues))
            return;

        // Check max value (only enforce when MaxValue > 0, matching VB6)
        if (variable.MaxValue > 0 && variable.Value > variable.MaxValue)
        {
            Notifications.Info($"The maximum value for {variable.Name} is '{variable.MaxValue:0}'. The number you have entered is too large.");
            variable.Value = variable.MaxValue;
        }

        // Check min value
        if (variable.Value < variable.MinValue)
        {
            Notifications.Info($"The minimum value for {variable.Name} is '{variable.MinValue:0}'. The number you have entered is too small.");
            variable.Value = variable.MinValue;
        }
    }

    // ── Load Grid Layout ──────────────────────────────────────
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            // The keyed/unkeyed fallback + Version bump live in the presenter
            // (its ctor was given the "FFormulaTest"/"VariablesGrid" names + instanceKey "(0)").
            await _variablesGrid.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");

        }
    }

    // ── Grid Layout Helpers ──────────────────────────────────
    // resolve/order/type/width all delegate to the presenter. FormulaVariable has
    // no bool/DateTime properties, so the presenter's ColumnTypeFor (Boolean/Date/
    // Number) and the old hand-copied GetColumnTypeForField (CheckBox/Number) yield
    // identical results for every column on this grid.
    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedGridLayout()
        => _variablesGrid.GetOrdered();

    private string ResolveGridField(string layoutField)
        => _variablesGrid.ResolveField(layoutField);

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // ── List-of-values dropdown support (in-grid EditTemplate) ───────────
    // Parses a variable's ListOfValues ("val1=label1|val2=label2|...") into a
    // DataSource for DropDownListControl. The value field is the parsed double
    // so its ToString() matches the bound data.Value for selection highlighting
    // (DropDownListControl matches on Value?.ToString()); the option's display
    // is the label. Mirrors the prior raw <option value="@double.Parse(val)">.
    private static List<ListValueItem> ParseListOfValues(string listOfValues)
    {
        var items = new List<ListValueItem>();
        if (string.IsNullOrEmpty(listOfValues)) return items;
        foreach (var opt in listOfValues.Split('|'))
        {
            var parts = opt.Split('=');
            var rawVal = parts.Length > 1 ? parts[0].Trim() : opt.Trim();
            var display = parts.Length > 1 ? parts[1].Trim() : opt.Trim();
            var val = double.TryParse(rawVal, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0;
            items.Add(new ListValueItem { Value = val, Display = display });
        }
        return items;
    }

    public class ListValueItem
    {
        public double Value { get; set; }
        public string Display { get; set; } = "";
    }

    // === Model ===
    public class FormulaVariable
    {
        public string Name { get; set; } = "";
        public double Value { get; set; }
        public string Description { get; set; } = "";
        public int SortOrder { get; set; }
        public double MinValue { get; set; }
        public double MaxValue { get; set; }
        public string ListOfValues { get; set; } = "";
        public string UOM { get; set; } = "";
    }
}
