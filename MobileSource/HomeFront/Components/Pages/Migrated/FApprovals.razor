@page "/approvals"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FApprovals> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>Approvals - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Approvals...</div>
    </div>
}

<div class="approvals-container">

    @* ── TOOLBAR ─────────────────────────────────────────── *@
    <div class="toolbar-cntr">
        <button class="tbar-btn" @onclick="OnPreviewClick">
            <img src="images/32/ChangeView.ico" class="tbar-icon" onerror="this.style.display='none'" />
            <span class="tool-label">Preview</span>
        </button>
        <button class="tbar-btn" disabled="@(!SendPOsEnabled)" @onclick="OnSendPOsClick">
            <img src="images/32/save.ico" class="tbar-icon" onerror="this.style.display='none'" />
            <span class="tool-label">Send POs</span>
        </button>
        <div class="toolbar-sep"></div>
        <button class="tbar-btn" @onclick="OnRefreshClick">
            <img src="images/32/refresh.ico" class="tbar-icon" onerror="this.style.display='none'" />
            <span class="tool-label">Refresh</span>
        </button>
    </div>

    <h4 class="page-title">Approvals</h4>

    @* ── HEADERS GRID ────────────────────────────────────── *@
    <div class="headers-panel" style="height: @(HeadersPanelHeight)px;">
        <GridControl @ref="HeadersGrid"
                TValue="ApprovalHeaderRow"
                DataSource="@HeadersData"
                AllowSorting="true"
                AllowResizing="true"
                AllowSelection="true"
                AllowGrouping="true"
                AllowFiltering="false"
                EnableHover="true"
                Height="@($"{HeadersPanelHeight}px")"
                RowHeight="32"
                GroupColumns="@GroupedColumnsList"
                ShowGroupExpandCollapse="true"
                AggregateRows="@headerAggregateRows"
                SelectionSettingsRef="@headersSelectionSettings"
                EventsRef="@headersGridEvents">
            <GridColumnsBase>
                <GridColumn Field="@nameof(ApprovalHeaderRow.Job)" HeaderText="Job" Width="100px" AllowEditing="false" />
                <GridColumn Field="@nameof(ApprovalHeaderRow.JobDesc)" HeaderText="Job Desc" Width="200px" AllowEditing="false" />
                <GridColumn Field="@nameof(ApprovalHeaderRow.Vendor)" HeaderText="Vendor" Width="100px" AllowEditing="false"
                              Visible="@ShowVendorColumn" />
                <GridColumn Field="@nameof(ApprovalHeaderRow.VendorDesc)" HeaderText="Vendor Desc" Width="200px" AllowEditing="false" />
                <GridColumn Field="@nameof(ApprovalHeaderRow.PONumber)" HeaderText="PO Number" Width="120px" AllowEditing="false" />
                <GridColumn Field="@nameof(ApprovalHeaderRow.POIndex)" HeaderText="PO Index" Width="100px" AllowEditing="false" />
                <GridColumn Field="@nameof(ApprovalHeaderRow.PODesc)" HeaderText="PO Desc" Width="200px" AllowEditing="false" />
                <GridColumn Field="@nameof(ApprovalHeaderRow.Pretax)" HeaderText="Pretax" Width="110px"
                              Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Type="ColumnType.Number" />
                <GridColumn Field="@nameof(ApprovalHeaderRow.Tax)" HeaderText="Tax" Width="100px"
                              Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Type="ColumnType.Number" />
                <GridColumn Field="@nameof(ApprovalHeaderRow.Total)" HeaderText="Total" Width="110px"
                              Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Type="ColumnType.Number" />
            </GridColumnsBase>
        </GridControl>
    </div>

    @* ── SLIDER ──────────────────────────────────────────── *@
    <div class="slider-bar" @onmousedown="OnSliderMouseDown"></div>

    @* ── DETAILS GRID ────────────────────────────────────── *@
    <div class="details-panel">
        <GridControl @ref="DetailsGrid"
                TValue="ApprovalDetailRow"
                DataSource="@DetailsData"
                AllowSorting="true"
                AllowResizing="true"
                AllowSelection="true"
                AllowFiltering="false"
                EnableHover="true"
                Height="100%"
                RowHeight="32"
                SelectionSettingsRef="@detailsSelectionSettings">
            <GridColumnsBase>
                <GridColumn Field="@nameof(ApprovalDetailRow.PONumber)" HeaderText="PO Number" Width="120px" AllowEditing="false" />
                <GridColumn Field="@nameof(ApprovalDetailRow.Phase)" HeaderText="Phase" Width="100px" AllowEditing="false" />
                <GridColumn Field="@nameof(ApprovalDetailRow.Item)" HeaderText="Item" Width="100px" AllowEditing="false" />
                <GridColumn Field="@nameof(ApprovalDetailRow.Description)" HeaderText="Description" Width="250px" AllowEditing="false" />
                <GridColumn Field="@nameof(ApprovalDetailRow.OrderQty)" HeaderText="Order Qty" Width="100px"
                              Format="N2" TextAlign="TextAlign.Right" AllowEditing="false" Type="ColumnType.Number" />
                <GridColumn Field="@nameof(ApprovalDetailRow.OrderUOM)" HeaderText="UOM" Width="80px" AllowEditing="false" />
                <GridColumn Field="@nameof(ApprovalDetailRow.UnitPrice)" HeaderText="Unit Price" Width="110px"
                              Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Type="ColumnType.Number" />
                <GridColumn Field="@nameof(ApprovalDetailRow.Pretax)" HeaderText="Pretax" Width="110px"
                              Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Type="ColumnType.Number" />
                <GridColumn Field="@nameof(ApprovalDetailRow.JCTax)" HeaderText="JC Tax" Width="100px"
                              Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Type="ColumnType.Number" />
                <GridColumn Field="@nameof(ApprovalDetailRow.NJCTax)" HeaderText="NJC Tax" Width="100px"
                              Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Type="ColumnType.Number" />
                <GridColumn Field="@nameof(ApprovalDetailRow.Total)" HeaderText="Total" Width="110px"
                              Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" Type="ColumnType.Number" />
            </GridColumnsBase>
        </GridControl>
    </div>

    @* ── STATUS BAR ──────────────────────────────────────── *@
    <div class="status-bar">
        @StatusMessage
    </div>
</div>

@code {
    private const string SRCFILE = "FApprovals";

    // === Database ===
// === UI State ===
    private bool IsLoading = false;
    private bool SendPOsEnabled = false;
    private bool ShowVendorColumn = true;
    private string StatusMessage = "Ready";
    private int HeadersPanelHeight = 300;

    // === Grid Refs ===
    private GridControl<ApprovalHeaderRow>? HeadersGrid;
    private GridControl<ApprovalDetailRow>? DetailsGrid;

    // === Data Sources ===
    private List<ApprovalHeaderRow> HeadersData = new();
    private List<ApprovalDetailRow> DetailsData = new();

    // === Grouping ===
    private List<string> GroupedColumnsList = new();

    // === App State (would come from shared service in real app) ===
    private string AccountingSystem = "HomeFront"; // or "QuickBooks"

    // === Grid Settings ===
    private SelectionSettings headersSelectionSettings = new()
    {
        Type = SelectionType.Multiple,
        Mode = SelectionMode.Row,
        EnableToggle = true
    };

    private SelectionSettings detailsSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    private GridControlEvents<ApprovalHeaderRow> headersGridEvents = new();

    // === Aggregate Rows for Headers Grid ===
    private List<AggregateRow> headerAggregateRows = new()
    {
        new AggregateRow
        {
            ShowInGroupFooter = true,
            ShowInGroupCaption = true,
            ShowInFooter = true,
            Columns = new List<AggregateColumn>
            {
                new() { Field = "Total", Type = AggregateType.Sum, Format = "C2",
                         FooterTemplate = "Grand Total: {value}",
                         GroupFooterTemplate = "Sub Total: {value}",
                         GroupCaptionTemplate = "{value}" },
                new() { Field = "Pretax", Type = AggregateType.Sum, Format = "C2",
                         FooterTemplate = "Total: {value}",
                         GroupFooterTemplate = "Sub Total: {value}" },
                new() { Field = "Tax", Type = AggregateType.Sum, Format = "C2",
                         FooterTemplate = "Total: {value}",
                         GroupFooterTemplate = "Sub Total: {value}" }
            }
        }
    };

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        headersGridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<ApprovalHeaderRow>>(this, OnHeaderRowSelected);

        // Simulate permission check
        SendPOsEnabled = true; // HFApp.UserPermission("SendPO")

        // Handle QuickBooks accounting system — hide Vendor column
        if (AccountingSystem == "QuickBooks")
        {
            ShowVendorColumn = false;
        }

        await LoadData();
    }

    // === LoadData — mirrors VB6 LoadData ===
    private async Task LoadData()
    {
        IsLoading = true;
        StatusMessage = "Loading approvals...";
        StateHasChanged();

        try
        {
            var sql = @"
                SELECT m.Job
                      ,m.JobDesc
                      ,m.Vendor
                      ,m.VendorDesc
                      ,m.PONumber
                      ,m.POIndex
                      ,m.PODesc
                      ,m.POFormat
                      ,SUM(i.pretax) AS Pretax
                      ,SUM(i.jctax + i.njctax) AS Tax
                      ,SUM(i.pretax + i.jctax + i.njctax) AS Total
                  FROM purchaseorders m
                       JOIN poitems i ON (m.ponumber = i.ponumber AND m.DivisionID = i.DivisionID)
                 WHERE isfieldpo = 1
                   AND deliverydate IS NULL
                   AND m.DivisionID = @DivisionID
                 GROUP BY m.Job
                      ,m.JobDesc
                      ,m.Vendor
                      ,m.VendorDesc
                      ,m.PONumber
                      ,m.POIndex
                      ,m.PODesc
                      ,m.POFormat
                 ORDER BY m.jobdesc, m.vendordesc, m.ponumber";

            var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });

            HeadersData = rows.Select(r => new ApprovalHeaderRow
            {
                Job = r["Job"]?.ToString() ?? "",
                JobDesc = r["JobDesc"]?.ToString() ?? "",
                Vendor = r["Vendor"]?.ToString() ?? "",
                VendorDesc = r["VendorDesc"]?.ToString() ?? "",
                PONumber = r["PONumber"]?.ToString() ?? "",
                POIndex = r["POIndex"]?.ToString() ?? "",
                PODesc = r["PODesc"]?.ToString() ?? "",
                POFormat = r["POFormat"]?.ToString() ?? "",
                Pretax = SafeDecimal(r["Pretax"]),
                Tax = SafeDecimal(r["Tax"]),
                Total = SafeDecimal(r["Total"])
            }).ToList();

            DetailsData = new();
            StatusMessage = $"Loaded {HeadersData.Count} purchase order(s)";
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error loading data: {ex.Message}";
            Logger.LogError(ex, "[{SRCFILE}.LoadData]");

            Notifications.Error($"Error loading approvals: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Header Row Selected — Load Details ===
    private async Task OnHeaderRowSelected(RowSelectEventArgs<ApprovalHeaderRow> args)
    {
        if (args.Data == null) return;

        try
        {
            var poNumber = args.Data.PONumber;
            var sql = @"
                SELECT i.PONumber, i.Phase, i.Item, i.Description,
                       i.OrderQty, i.OrderUOM, i.UnitPrice,
                       i.Pretax, i.JCTax, i.NJCTax,
                       (i.Pretax + i.JCTax + i.NJCTax) AS Total
                  FROM poitems i
                 WHERE i.PONumber = @PONumber
                   AND i.DivisionID = @DivisionID
                 ORDER BY i.Phase, i.Item";

            var rows = await db.QueryAsync(sql, new { PONumber = poNumber, SessionState.DivisionID });

            DetailsData = rows.Select(r => new ApprovalDetailRow
            {
                PONumber = r["PONumber"]?.ToString() ?? "",
                Phase = r["Phase"]?.ToString() ?? "",
                Item = r["Item"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? "",
                OrderQty = SafeDecimal(r["OrderQty"]),
                OrderUOM = r["OrderUOM"]?.ToString() ?? "",
                UnitPrice = SafeDecimal(r["UnitPrice"]),
                Pretax = SafeDecimal(r["Pretax"]),
                JCTax = SafeDecimal(r["JCTax"]),
                NJCTax = SafeDecimal(r["NJCTax"]),
                Total = SafeDecimal(r["Total"])
            }).ToList();

            StatusMessage = $"PO {poNumber}: {DetailsData.Count} line item(s)";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error loading details: {ex.Message}";
            Logger.LogError(ex, "[{SRCFILE}.OnHeaderRowSelected]");

        }
    }

    // === Toolbar: Preview — mirrors ShowSelectedPOs ===
    private async Task OnPreviewClick()
    {
        if (HeadersGrid == null) return;

        try
        {
            var selectedRecords = HeadersGrid.GetSelectedRecords()?.ToList();
            if (selectedRecords == null || selectedRecords.Count == 0)
            {
                Notifications.Info("Please select one or more purchase orders to preview.");
                return;
            }

            // Build the query to get PO formats and numbers for selected rows
            var whereClauses = new List<string>();
            foreach (var row in selectedRecords)
            {
                var conditions = new List<string>();
                if (!string.IsNullOrEmpty(row.Job))
                    conditions.Add($"job = '{EscapeSql(row.Job)}'");
                if (!string.IsNullOrEmpty(row.Vendor))
                    conditions.Add($"vendor = '{EscapeSql(row.Vendor)}'");
                if (!string.IsNullOrEmpty(row.PONumber))
                    conditions.Add($"ponumber = '{EscapeSql(row.PONumber)}'");

                if (conditions.Count > 0)
                    whereClauses.Add($"({string.Join(" AND ", conditions)})");
            }

            if (whereClauses.Count == 0)
            {
                Notifications.Info("No valid selection for preview.");
                return;
            }

            var sql = $@"
                SELECT poformat, ponumber
                  FROM purchaseorders
                 WHERE ({string.Join(" OR ", whereClauses)})
                 ORDER BY 1, 2";

            var rows = await db.QueryAsync(sql);

            // Group by PO format and build CSV lists of PO numbers per format
            // VB6 opened a separate Crystal viewer per format; in Blazor we navigate
            // to report-viewer with the first format (most common case is single format).
            // If multiple formats exist, we open the first and alert about the rest.
            var formatGroups = new Dictionary<string, List<string>>();

            foreach (var row in rows)
            {
                var format = row["poformat"]?.ToString() ?? "";
                var poNumber = row["ponumber"]?.ToString() ?? "";

                if (string.IsNullOrEmpty(format) || string.IsNullOrEmpty(poNumber))
                    continue;

                if (!formatGroups.ContainsKey(format))
                    formatGroups[format] = new List<string>();
                formatGroups[format].Add(poNumber);
            }

            if (formatGroups.Count == 0)
            {
                Notifications.Info("No PO data found for the selected records.");
                return;
            }

            // Navigate to the first format group
            var firstGroup = formatGroups.First();
            await PreviewPOReport(firstGroup.Key, firstGroup.Value);

            // If there are additional formats, open them in new tabs via JS
            foreach (var group in formatGroups.Skip(1))
            {
                var poList = string.Join(",", group.Value);
                var url = $"/report-viewer/{Uri.EscapeDataString(group.Key)}?poNumbers={Uri.EscapeDataString(poList)}&divisionId={SessionState.DivisionID}";
                await JSRuntime.InvokeVoidAsync("open", url, "_blank");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}.OnPreviewClick]");

            Notifications.Error($"Error previewing POs: {ex.Message}");
        }
    }

    private async Task PreviewPOReport(string poFormat, List<string> poNumbers)
    {
        // VB6: loaded Crystal Report from "Estimating\PO Formats\{poFormat}.rpt"
        // Blazor: navigate to report-viewer with format and PO numbers as query params
        var poList = string.Join(",", poNumbers);
        var encodedFormat = Uri.EscapeDataString(poFormat);
        var encodedPOs = Uri.EscapeDataString(poList);
        NavigationManager.NavigateTo(
            $"/report-viewer/{encodedFormat}?poNumbers={encodedPOs}&divisionId={SessionState.DivisionID}");
        await Task.CompletedTask;
    }

    // === Toolbar: Send POs — mirrors VB6 FSendingWizard.ShowForm("PO") ===
    private async Task OnSendPOsClick()
    {
        NavigationManager.NavigateTo("/po-sending-wizard?mode=PO");
        await Task.CompletedTask;
    }

    // === Refresh — mirrors VB6 Form_KeyDown F5 => LoadData ===
    private async Task OnRefreshClick()
    {
        await LoadData();
    }

    // === Slider drag — uses JS interop to resize header/detail panels ===
    private async Task OnSliderMouseDown()
    {
        // JS handles the drag and directly updates the DOM; on mouseup we read back the final height
        var newHeight = await JSRuntime.InvokeAsync<int>("eval", @"
            (function() {
                return new Promise(function(resolve) {
                    var panel = document.querySelector('.headers-panel');
                    var startY = event.clientY;
                    var startH = panel.offsetHeight;
                    var minH = 100;
                    var maxH = window.innerHeight - 250;
                    function onMove(e) {
                        e.preventDefault();
                        var newH = Math.min(maxH, Math.max(minH, startH + (e.clientY - startY)));
                        panel.style.height = newH + 'px';
                    }
                    function onUp(e) {
                        document.removeEventListener('mousemove', onMove);
                        document.removeEventListener('mouseup', onUp);
                        resolve(panel.offsetHeight);
                    }
                    document.addEventListener('mousemove', onMove);
                    document.addEventListener('mouseup', onUp);
                });
            })()
        ");

        if (newHeight >= 100)
        {
            HeadersPanelHeight = newHeight;
            StateHasChanged();
        }
    }

    // === Helpers ===
    private decimal SafeDecimal(object? val, decimal def = 0) =>
        val != null && val != DBNull.Value && !string.IsNullOrEmpty(val.ToString())
            ? Convert.ToDecimal(val) : def;

    private string EscapeSql(string value) =>
        value?.Replace("'", "''") ?? "";

    // === Model Classes ===
    public class ApprovalHeaderRow
    {
        public string Job { get; set; } = "";
        public string JobDesc { get; set; } = "";
        public string Vendor { get; set; } = "";
        public string VendorDesc { get; set; } = "";
        public string PONumber { get; set; } = "";
        public string POIndex { get; set; } = "";
        public string PODesc { get; set; } = "";
        public string POFormat { get; set; } = "";
        public decimal Pretax { get; set; }
        public decimal Tax { get; set; }
        public decimal Total { get; set; }
    }

    public class ApprovalDetailRow
    {
        public string PONumber { get; set; } = "";
        public string Phase { get; set; } = "";
        public string Item { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal OrderQty { get; set; }
        public string OrderUOM { get; set; } = "";
        public decimal UnitPrice { get; set; }
        public decimal Pretax { get; set; }
        public decimal JCTax { get; set; }
        public decimal NJCTax { get; set; }
        public decimal Total { get; set; }
    }
}
