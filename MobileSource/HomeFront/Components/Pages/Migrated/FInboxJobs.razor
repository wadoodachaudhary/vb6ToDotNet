@page "/inbox-jobs"
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<FInboxJobs> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>Prepare Estimates - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Inbox Jobs...</div>
    </div>
}

<div class="inbox-container">
    @* ── Wizard Header ─────────────────────────────────────── *@
    <div class="wizard-header">
        <h4>Prepare Estimates for sold items</h4>
        <p>Select jobs and contract items to be budgeted and purchased.</p>
    </div>

    @* ── Main Grid ─────────────────────────────────────────── *@
    <div class="grid-area">
        <TreeGridControl @ref="InboxTreeGrid"
                     TValue="InboxJobRow"
                     DataSource="@TreeData"
                     IdMapping="NodeId"
                     ParentIdMapping="ParentNodeId"
                     TreeColumnIndex="0"
                     AllowSelection="true"
                     AllowSorting="true"
                     AllowFiltering="true"
                     AllowResizing="true"
                     ShowColumnOptionsButton="true"
                     ShowGridOptionsRail="true"
                     EnableCollapseAll="false"
                     Height="100%"
                     NodeExpandIconStyle="GroupExpandIconStyle.PlusMinus"
                     CssClass="fx-treegrid-compact fx-treegrid-dotted-lines">
            <TreeGridColumn Field="@nameof(InboxJobRow.Description)"
                            HeaderText="Community / Job"
                            Width="420px"
                            MinWidth="240px"
                            HeaderToolbarItems="@InboxHeaderToolbarItems">
                <HeaderTemplate>
                    <span class="inbox-tree-header">
                        <CheckBoxControl Checked="@HeaderChecked"
                                         Indeterminate="@HeaderIndeterminate"
                                         CheckedChanged="@OnHeaderCheckChanged"
                                         CssClass="inbox-grid-check"
                                         StopClickPropagation="true"
                                         StopMouseDownPropagation="true"
                                         StopKeyDownPropagation="true" />
                        <span>Community / Job</span>
                    </span>
                </HeaderTemplate>
                <Template Context="ctx">
                    @{ var row = (InboxJobRow)ctx; }
                    <span class="inbox-tree-cell">
                        <CheckBoxControl Checked="@row.IsChecked"
                                         Indeterminate="@row.IsCheckIndeterminate"
                                         CheckedChanged="@(value => OnCheckChanged(row, value))"
                                         CssClass="inbox-grid-check"
                                         StopClickPropagation="true"
                                         StopMouseDownPropagation="true"
                                         StopKeyDownPropagation="true" />
                        @if (!string.IsNullOrWhiteSpace(GetNodeIcon(row)))
                        {
                            <img class="inbox-node-icon" src="@GetNodeIcon(row)" alt="" />
                        }
                        <span class="inbox-node-text">@row.Description</span>
                    </span>
                </Template>
            </TreeGridColumn>
            <TreeGridColumn Field="@nameof(InboxJobRow.Inverted)" HeaderText="Invert Floor Plan" Width="110px">
                <Template Context="ctx">
                    @{ var row = (InboxJobRow)ctx; }
                    @if (row.OutlineLevel == 2)
                    {
                        <DropDownListControl TValue="string" TItem="string"
                                             DataSource="@YesNoOptions"
                                             Value="@row.Inverted"
                                             ValueChanged="@(value => OnInvertedChanged(row, value ?? "No"))"
                                             Width="100%"
                                             CssClass="inbox-grid-dropdown" />
                    }
                    else
                    {
                        @row.Inverted
                    }
                </Template>
            </TreeGridColumn>
            <TreeGridColumn Field="@nameof(InboxJobRow.ChangeOrderNo)" HeaderText="Change Order" Width="90px" />
            <TreeGridColumn Field="@nameof(InboxJobRow.JCCat)" HeaderText="JC Category" Width="110px">
                <Template Context="ctx">
                    @{ var row = (InboxJobRow)ctx; }
                    @if (row.OutlineLevel == 3)
                    {
                        <DropDownListControl TValue="string" TItem="JCCategoryItem"
                                             DataSource="@JCCategories"
                                             Value="@row.JCCat"
                                             ValueChanged="@(value => OnJCCatChanged(row, value ?? ""))"
                                             TextFieldName="@nameof(JCCategoryItem.Display)"
                                             ValueFieldName="@nameof(JCCategoryItem.Category)"
                                             Width="100%"
                                             CssClass="inbox-grid-dropdown" />
                    }
                </Template>
            </TreeGridColumn>
            <TreeGridColumn Field="@nameof(InboxJobRow.Warnings)" HeaderText="Warnings" Width="360px">
                <Template Context="ctx">
                    @{ var row = (InboxJobRow)ctx; }
                    <span class="inbox-warning-cell">
                        @if (!string.IsNullOrWhiteSpace(GetWarningIcon(row)))
                        {
                            <img class="inbox-warning-icon" src="@GetWarningIcon(row)" alt="" />
                        }
                        <span>@row.Warnings</span>
                    </span>
                </Template>
            </TreeGridColumn>
            <TreeGridColumn Field="@nameof(InboxJobRow.CustomerNo)" HeaderText="Customer No" Width="100px" Visible="false" />
            <TreeGridColumn Field="@nameof(InboxJobRow.Location)" HeaderText="Location" Width="80px" Visible="false" />
            <TreeGridColumn Field="@nameof(InboxJobRow.Seq)" HeaderText="Seq" Width="60px" Visible="false" />
            <TreeGridColumn Field="@nameof(InboxJobRow.Job)" HeaderText="Job" Width="100px" Visible="false" />
            <TreeGridColumn Field="@nameof(InboxJobRow.Model)" HeaderText="Model" Width="100px" Visible="false" />
            <TreeGridColumn Field="@nameof(InboxJobRow.Community)" HeaderText="Community" Width="100px" Visible="false" />
            <TreeGridColumn Field="@nameof(InboxJobRow.Quantity)" HeaderText="Qty" Width="60px" Visible="false" />
            <TreeGridColumn Field="@nameof(InboxJobRow.OptionID)" HeaderText="Option ID" Width="100px" Visible="false" />
            <TreeGridColumn Field="@nameof(InboxJobRow.Notes)" HeaderText="Notes" Width="150px" Visible="false" />
        </TreeGridControl>
    </div>

    @* ── Button Bar ────────────────────────────────────────── *@
    <div class="button-bar">
        <div>
            @if (ShowSendToPipeline)
            {
                <ButtonControl CssClass="inbox-nav-btn" OnClick="@(_ => OnSendToPipeline())">Send to &amp;Pipeline</ButtonControl>
            }
        </div>
        <div class="btn-group-right">
            <ButtonControl CssClass="inbox-nav-btn" OnClick="@(_ => OnOkClick())">OK</ButtonControl>
            <ButtonControl CssClass="inbox-nav-btn" OnClick="@(_ => OnCancelClick())">Cancel</ButtonControl>
        </div>
    </div>
</div>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            NavigationManager.NavigateTo("/");
    }

    // === Constants (column mapping from VB6) ===
    private const int c_Description = 0;
    private const int c_Inverted = 1;
    private const int c_Change_Order_No = 2;
    private const int c_JCCat = 3;
    private const int c_Warnings = 4;
    private const int c_Customer_No = 5;
    private const int c_Location = 6;
    private const int c_seq = 7;
    private const int c_Job = 8;
    private const int c_Model = 9;
    private const int c_community = 10;
    private const int c_Quantity = 11;
    private const int c_OptionID = 12;
    private const int c_Notes = 13;

    // === Database ===
private string LoginID = "admin";

    // === UI State ===
    private bool IsLoading = false;
    private bool ShowSendToPipeline = false;
    private TreeGridControl<InboxJobRow>? InboxTreeGrid;
    private bool HeaderChecked =>
        TreeData.Count > 0 && TreeData.All(r => r.IsChecked && !r.IsCheckIndeterminate);

    private bool HeaderIndeterminate =>
        TreeData.Any(r => r.IsChecked || r.IsCheckIndeterminate) && !HeaderChecked;

    private static readonly IReadOnlyList<GridToolbarItem> InboxHeaderToolbarItems =
        new List<GridToolbarItem>
        {
            new() { Key = "ToggleExpandCollapse", Action = GridToolbarAction.ToggleExpandCollapse }
        };

    // === Data ===
    private List<InboxJobRow> TreeData = new();
    private int _nextNodeId = 1;
    private static readonly string[] YesNoOptions = ["Yes", "No"];

    // === JCCat categories (loaded from StandardCategories) ===
    private List<JCCategoryItem> JCCategories = new();

    // === App Options ===
    private Dictionary<string, string> AppOptions = new(StringComparer.OrdinalIgnoreCase)
    {
        { "EstimatingSystem", "0" },
        { "BIMCommunitySpecificPlansAndOptions", "True" },
        { "CGVisionsRootURI", "" },
        { "CGVisionsUID", "" },
        { "CGVisionsPWD", "" }
    };

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        await LoadAppOptionsAsync();
        // esPipeline = 1 in VB6
        ShowSendToPipeline = GetOption("EstimatingSystem") == "1";
        await LoadJCCategories();
        await LoadData();
    }

    private async Task LoadAppOptionsAsync()
    {
        try
        {
            var rows = await db.QueryAsync(@"
                SELECT OptionName, OptionValue
                FROM AppOptions
                WHERE DivisionID IN (0, @DivisionID)
                  AND OptionName IN ('EstimatingSystem',
                                     'BIMCommunitySpecificPlansAndOptions',
                                     'CGVisionsRootURI',
                                     'CGVisionsUID',
                                     'CGVisionsPWD')
                ORDER BY DivisionID", new { SessionState.DivisionID });

            foreach (var row in rows)
            {
                var name = row["OptionName"]?.ToString() ?? "";
                if (string.IsNullOrWhiteSpace(name))
                    continue;

                AppOptions[name] = row["OptionValue"]?.ToString() ?? "";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Couldn't read FInboxJobs app options; defaults will be used");
        }
    }

    // === Load JC Categories (from VB6 gData_BeforeEdit c_JCCat) ===
    private async Task LoadJCCategories()
    {
        try
        {
            var sql = $"SELECT Category, Description FROM StandardCategories WHERE DivisionID = {SessionState.DivisionID}";
            var rows = await db.QueryAsync(sql);
            JCCategories.Clear();
            JCCategories.Add(new JCCategoryItem { Category = "", Description = "" }); // blank option
            foreach (var r in rows)
            {
                JCCategories.Add(new JCCategoryItem
                {
                    Category = r["Category"]?.ToString() ?? "",
                    Description = r["Description"]?.ToString() ?? ""
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

        }
    }

    // === LoadData (from VB6 LoadData) ===
    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();

        var sql = BuildLoadDataQuery();
        try
        {
            TreeData.Clear();
            _nextNodeId = 1;

            var rows = await db.QueryAsync(sql);

            string lastCommunity = "\x01";
            string lastJob = "\x01";
            string lastCustomer = "\x01";

            int? communityNodeId = null;
            int? jobNodeId = null;
            int? customerNodeId = null;

            foreach (var rs in rows)
            {
                var currentCommunity = rs["Community"]?.ToString() ?? "";
                var currentJob = rs["JobNo"]?.ToString() ?? "";
                var currentCustomer = rs["Customer_No"]?.ToString() ?? "";

                // Community level (outline level 0)
                if (lastCommunity != currentCommunity)
                {
                    lastCommunity = currentCommunity;
                    var communityRow = new InboxJobRow
                    {
                        NodeId = _nextNodeId++,
                        ParentNodeId = null,
                        OutlineLevel = 0,
                        IsSubtotal = true,
                        Description = rs["FullCommunityDesc"]?.ToString() ?? "",
                        NodeType = "Community"
                    };
                    TreeData.Add(communityRow);
                    communityNodeId = communityRow.NodeId;
                    lastJob = "\x01";
                    lastCustomer = "\x01";
                }

                // Job level (outline level 1)
                if (lastJob != currentJob)
                {
                    lastJob = currentJob;
                    var jobRow = new InboxJobRow
                    {
                        NodeId = _nextNodeId++,
                        ParentNodeId = communityNodeId,
                        OutlineLevel = 1,
                        IsSubtotal = true,
                        Description = FormatJob(lastJob),
                        NodeType = "Job"
                    };
                    TreeData.Add(jobRow);
                    jobNodeId = jobRow.NodeId;
                    lastCustomer = "\x01";
                }

                // Customer level (outline level 2)
                if (lastCustomer != currentCustomer)
                {
                    lastCustomer = currentCustomer;
                    var invertedFloorPlan = (rs["InvertedFloorPlan"]?.ToString() ?? "") == "True" ? "Yes" : "No";
                    var customerRow = new InboxJobRow
                    {
                        NodeId = _nextNodeId++,
                        ParentNodeId = jobNodeId,
                        OutlineLevel = 2,
                        IsSubtotal = true,
                        Description = rs["Customer"]?.ToString() ?? "",
                        Inverted = invertedFloorPlan,
                        CustomerNo = (currentCustomer ?? "").Trim(),
                        NodeType = "Customer"
                    };
                    TreeData.Add(customerRow);
                    customerNodeId = customerRow.NodeId;
                }

                // Detail level (outline level 3)
                var quality = ToInt(rs["Quality"]?.ToString());
                string warnings = "";
                switch (quality)
                {
                    case 3:
                        warnings = "custom option";
                        break;
                    case 2:
                        var assemblyName = rs["assembly"]?.ToString() ?? "";
                        warnings = $"assembly \"{assemblyName}\" could not be found";
                        break;
                    case 1:
                        warnings = "assembly not specified";
                        break;
                }

                var detailRow = new InboxJobRow
                {
                    NodeId = _nextNodeId++,
                    ParentNodeId = customerNodeId,
                    OutlineLevel = 3,
                    IsSubtotal = true,
                    Description = (rs["AssemblyDesc"]?.ToString() ?? "").Trim(),
                    ChangeOrderNo = (rs["Change_Order_No"]?.ToString() ?? "").Trim(),
                    CustomerNo = (currentCustomer ?? "").Trim(),
                    Location = (rs["Location"]?.ToString() ?? "").Trim(),
                    Seq = (rs["Seq"]?.ToString() ?? "").Trim(),
                    Job = (rs["JobNo"]?.ToString() ?? "").Trim(),
                    Warnings = warnings,
                    WarningQuality = quality,
                    // Pipeline fields
                    Model = rs["Model"]?.ToString() ?? "",
                    Community = rs["community"]?.ToString() ?? "",
                    Quantity = rs["quantity"]?.ToString() ?? "",
                    OptionID = rs["optionid"]?.ToString() ?? "",
                    Notes = rs["notes"]?.ToString() ?? "",
                    NodeType = "Detail",
                    IsChecked = false
                };
                TreeData.Add(detailRow);
            }

            // Rebind to a FRESH list reference. TreeGridControl.OnParametersSet only rebuilds
            // its tree when ReferenceEquals(DataSource, previous) is false; the in-place
            // Clear()+Add() above keeps the same reference, so the grid would keep showing the
            // first (empty) build done before this async load finished — the "No records to
            // display" bug. (Same reference-equality trap as MultiSelectDualList.)
            TreeData = new List<InboxJobRow>(TreeData);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FInboxJobs LoadData failed. SQL:\n{Sql}", sql);
            Notifications.Error($"Error loading inbox jobs: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === SaveData (from VB6 SaveData) ===
    private async Task<string> SaveData(bool sendToPipeline)
    {
        try
        {
            string firstJob = "";
            string lastCustomer = "\x01";
            long estimateIndex = 0;
            string inboxBatchID = Guid.NewGuid().ToString();

            bool pipelineCommunitySpecific = false;
            if (sendToPipeline)
            {
                pipelineCommunitySpecific = GetOption("BIMCommunitySpecificPlansAndOptions") != "False";
                // Pipeline connection would be initialized here
                // X.Connect(...)
            }

            foreach (var row in TreeData.Where(r => r.OutlineLevel == 3 && r.IsChecked))
            {
                if (lastCustomer != row.CustomerNo)
                {
                    if (sendToPipeline && lastCustomer != "\x01")
                    {
                        // X.SaveJob(estimateIndex + 1)
                    }

                    if (sendToPipeline)
                    {
                        var pipelineCommunity = pipelineCommunitySpecific ? row.Community : "0000";
                        // X.AddJob(row.Job, row.Model, pipelineCommunity)
                    }

                    lastCustomer = row.CustomerNo;

                    // Create customer estimate (VB6 FInboxJobs.frm line 276:
                    //   EstimateIndex = HFApp.SqlExec("exec Purch_CreateCustomerEstimate " & ...)(0))
                    // Proc SELECTs @EstIndex, so the new index is the scalar in row 0, col 0.
                    var estResult = db.SqlExec(
                        "exec Purch_CreateCustomerEstimate @Customer_No, @UStmp",
                        new { Customer_No = lastCustomer, UStmp = LoginID });
                    if (estResult.Rows.Count > 0)
                    {
                        estimateIndex = Convert.ToInt64(estResult.Rows[0][0]);
                    }
                }

                if (string.IsNullOrEmpty(firstJob))
                    firstJob = row.Job;

                var optLocation = ToInt(row.Location);

                if (sendToPipeline && optLocation != 0)
                {
                    // X.AddJobOption(...)
                }

                // VB6 FInboxJobs.frm lines 290-299: positional args in proc order
                //   Customer_No, EstIndex, Location, ChangeOrderNo, Seq, JCCategory,
                //   UStmp(=LoginID), DivisionID, AddItems(=Not SendToPipeline), InboxBatchID.
                // Proc ends "select @EstAssemblyID EstAssemblyID" -> returned as a column.
                var rs = db.SqlExec(
                    @"exec dbo.Purch_PutEstimateAssembly @Customer_No, @EstIndex, @Location,
                          @ChangeOrderNo, @Seq, @JCCategory, @UStmp, @DivisionID, @AddItems, @InboxBatchID",
                    new
                    {
                        Customer_No = row.CustomerNo,
                        EstIndex = estimateIndex,
                        Location = optLocation,
                        ChangeOrderNo = row.ChangeOrderNo,
                        Seq = ToInt(row.Seq),
                        JCCategory = row.JCCat ?? "",
                        UStmp = LoginID,
                        DivisionID = SessionState.DivisionID,
                        AddItems = !sendToPipeline,
                        InboxBatchID = inboxBatchID
                    });

                if (sendToPipeline && optLocation != 0 && rs.Rows.Count > 0)
                {
                    var estAssemblyId = Convert.ToInt64(rs.Rows[0]["EstAssemblyID"]);
                    // X.AddJobOption(estAssemblyId, row.OptionID, row.Description, row.Quantity, row.Notes)
                }
            }

            if (sendToPipeline && lastCustomer != "\x01")
            {
                // X.SaveJob(estimateIndex + 1)
            }

            // VB6 SaveData ends here (returns firstJob). The CRM hook
            // MCrmDataService.Sales_SetEstimateIndex is an empty no-op stub in VB6
            // and is never called from SaveData, so there is no DB call to make.
            return firstJob;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            Notifications.Error($"Error saving data: {ex.Message}");
            return "";
        }
    }

    // === Button Handlers ===
    private async Task OnOkClick()
    {
        var checkedCount = TreeData.Count(r => r.OutlineLevel == 3 && r.IsChecked);
        if (checkedCount == 0)
        {
            Notifications.Info("Please select at least one item to estimate.");
            return;
        }

        var jobNo = await SaveData(false);
        if (!string.IsNullOrEmpty(jobNo))
        {
            NavigationManager.NavigateTo($"/estimate-items?mode=budget&job={jobNo}");
        }
    }

    private async Task OnSendToPipeline()
    {
        var checkedCount = TreeData.Count(r => r.OutlineLevel == 3 && r.IsChecked);
        if (checkedCount == 0)
        {
            Notifications.Info("Please select at least one item to send to pipeline.");
            return;
        }

        var jobNo = await SaveData(true);
        if (!string.IsNullOrEmpty(jobNo))
        {
            NavigationManager.NavigateTo($"/estimate-items?mode=budget&job={jobNo}");
        }
    }

    private void OnCancelClick()
    {
        ClosePage();
    }

    // === Checkbox cascade (from VB6 ResetChildrenChecked / ResetParentChecked) ===
    private void OnHeaderCheckChanged(bool isChecked)
    {
        foreach (var row in TreeData)
        {
            row.IsChecked = isChecked;
            row.IsCheckIndeterminate = false;
        }

        StateHasChanged();
    }

    private void OnCheckChanged(InboxJobRow row, bool isChecked)
    {
        row.IsChecked = isChecked;
        row.IsCheckIndeterminate = false;

        // Cascade to children
        ResetChildrenChecked(row, row.IsChecked);

        // Cascade to parents
        ResetParentChecked(row);

        StateHasChanged();
    }

    private void ResetChildrenChecked(InboxJobRow parent, bool isChecked)
    {
        var children = TreeData.Where(r => r.ParentNodeId == parent.NodeId).ToList();
        foreach (var child in children)
        {
            child.IsChecked = isChecked;
            child.IsCheckIndeterminate = false;
            ResetChildrenChecked(child, isChecked);
        }
    }

    private void ResetParentChecked(InboxJobRow child)
    {
        if (child.ParentNodeId == null) return;
        var parent = TreeData.FirstOrDefault(r => r.NodeId == child.ParentNodeId);
        if (parent == null) return;

        var siblings = TreeData.Where(r => r.ParentNodeId == parent.NodeId).ToList();
        if (siblings.All(s => s.IsChecked && !s.IsCheckIndeterminate))
        {
            parent.IsChecked = true;
            parent.IsCheckIndeterminate = false;
        }
        else if (siblings.Any(s => s.IsChecked || s.IsCheckIndeterminate))
        {
            parent.IsChecked = false;
            parent.IsCheckIndeterminate = true;
        }
        else
        {
            parent.IsChecked = false;
            parent.IsCheckIndeterminate = false;
        }

        ResetParentChecked(parent);
    }

    // === Inline editing: Inverted column (from VB6 gData_BeforeEdit/ValidateEdit c_Inverted) ===
    private async Task OnInvertedChanged(InboxJobRow row, string newValue)
    {
        if (row.OutlineLevel != 2) return; // Only editable on Customer rows
        row.Inverted = newValue;

        try
        {
            // VB6 gData_ValidateEdit (FInboxJobs.frm line 640):
            //   update tblcustomers set InvertedFloorPlan=DbQuote(Bit,.EditText)
            //     where divisionid=... and customer_no=...
            await db.ExecuteAsync(
                "UPDATE tblcustomers SET InvertedFloorPlan = @Inverted WHERE DivisionID = @DivisionID AND Customer_No = @Customer_No",
                new
                {
                    Inverted = newValue == "Yes",
                    DivisionID = SessionState.DivisionID,
                    Customer_No = row.CustomerNo
                });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

        }
    }

    // === Inline editing: JCCat column (from VB6 gData_BeforeEdit c_JCCat) ===
    private void OnJCCatChanged(InboxJobRow row, string value)
    {
        if (row.OutlineLevel != 3) return; // Only editable on Detail rows
        row.JCCat = value;
    }

    // === Build SQL Query (from VB6 LoadData) ===
    private string BuildLoadDataQuery()
    {
        var s = "";
        s += "SELECT o.FullCommunityDesc\n";
        s += "      ,o.Job JobNo\n";
        s += "      ,ISNULL(o.Job,'') + ISNULL(' - ' + o.JobDesc,'') Job\n";
        s += "      ,ISNULL(o.CustomerDesc,Customer_No) + '   (' + ISNULL(o.Model,'') + ' ' + ISNULL(o.Elevation,'') + ' ' + ISNULL(o.Series,'') + ')' Customer\n";
        s += "      ,ISNULL(o.Municipal_Address,'address not entered') Address\n";
        s += "      ,'Base Model' AssemblyDesc\n";
        s += "      ,o.Customer_No\n";
        s += "      ,0 Location\n";
        s += "      ,'' Change_order_No\n";
        s += "      ,0 Seq\n";
        s += "      ,o.modelassembly assembly\n";
        s += "      ,case when isnull(o.modelassembly,'')='' then 1\n";
        s += "            when isnull(a.assembly,'')='' then 2\n";
        s += "            else 0 end Quality\n";
        s += ",o.Model,o.community,null optionid,null quantity,null notes\n";
        s += ",o.InvertedFloorPlan\n";
        s += "  FROM UnEstimatedCustomers o \n";
        s += "       left outer join tbldbassemblymaster a \n";
        s += "          on (a.optionid=''\n";
        s += "          and a.assembly=o.modelassembly \n";
        s += $"          and a.DivisionID = {SessionState.DivisionID}\n";
        s += $"          and isnull(a.Community,'')=isnull(dbo.Purch_GetAssemblyCommunity(o.modelassembly,o.model,'',o.community,{SessionState.DivisionID}),'')\n";
        s += "          and a.Model=o.Model)\n";
        // Division filter matches the sidebar count (FMain.GetInboxCount): a LEFT join that
        // also keeps unestimated jobs whose community isn't registered in divisioncommunities
        // (d.DivisionID IS NULL). VB6 used a strict INNER join here + a dead `join system_setup`
        // (no s.* column is selected) — the INNER join silently dropped all 162 rows in this
        // DB, so the grid was empty while the sidebar still counted them. Dropped system_setup.
        s += "       left outer join divisioncommunities d on d.Community=o.Community\n";
        s += $" where (d.DivisionID is null or d.DivisionID = {SessionState.DivisionID})\n";
        s += "UNION All\n";
        s += "SELECT o.FullCommunityDesc\n";
        s += "      ,o.Job JobNo\n";
        s += "      ,ISNULL(o.Job,'') + ISNULL(' - ' + o.JobDesc,'') Job\n";
        s += "      ,ISNULL(o.CustomerDesc,o.Customer_No) + '   (' + ISNULL(o.Model,'') + ' ' + ISNULL(o.Elevation,'') + ' ' + ISNULL(o.Series,'') + ')' Customer\n";
        s += "      ,ISNULL(o.Municipal_Address,'address not entered') Address\n";
        s += "      ,left(o.Description,50) AssemblyDesc\n";
        s += "      ,o.Customer_No\n";
        s += "      ,o.Location\n";
        s += "      ,o.Change_order_No\n";
        s += "      ,o.Seq\n";
        s += "      ,o.assembly\n";
        s += "      ,case when isnull(o.assembly,'')='' then   1\n";
        s += "            when isnull(a.assembly,'')='' then   2\n";
        s += "            when isnull(o.assembly,'')='CUSTOM' then   3\n";
        s += "            else 0 end Quality\n";
        s += ",o.Model,o.community,o.opt optionid,o.qty quantity,o.estimatornotes notes\n";
        s += ",o.InvertedFloorPlan\n";
        s += "  FROM UnEstimatedOptions o\n";
        s += "       left outer join tbldbassemblymaster a \n";
        s += "          on (a.optionid=o.opt\n";
        s += "          and a.assembly=o.assembly \n";
        s += $"          and a.DivisionID = {SessionState.DivisionID}\n";
        s += "          and ISNULL(a.Model,'') = CASE WHEN (o.AssemblyType=3 OR o.AssemblyType=4) THEN '' ELSE o.Model END\n";
        s += $"          and isnull(a.Community,'')=isnull(dbo.Purch_GetAssemblyCommunity(o.assembly,CASE WHEN (o.AssemblyType=3 OR o.AssemblyType=4) THEN '' ELSE o.Model END,o.opt,o.community,{SessionState.DivisionID}),''))\n";
        // Same permissive division filter as the 1st half / the sidebar count. (VB6 added the
        // divisioncommunities join only when DivisionID<>"" yet referenced d.DivisionID in the
        // WHERE unconditionally — a latent "d.DivisionID could not be bound" for division 0;
        // a single unconditional LEFT join is correct and can't throw.)
        s += "       left outer join divisioncommunities d on d.Community=o.Community\n";
        s += $" where (d.DivisionID is null or d.DivisionID = {SessionState.DivisionID})\n";
        s += "ORDER BY 1,3,4,8,6";

        return s;
    }

    // === Helpers ===
    private string GetOption(string name)
    {
        return AppOptions.TryGetValue(name, out var val) ? val : "";
    }

    private string FormatJob(string jobNo)
    {
        // Simple job formatting - could be enhanced
        return (jobNo ?? "").Trim();
    }

    private int ToInt(string? str, int defaultValue = 0)
    {
        if (string.IsNullOrWhiteSpace(str)) return defaultValue;
        return int.TryParse(str.Trim(), out var result) ? result : defaultValue;
    }

    private string? GetNodeIcon(InboxJobRow row) =>
        row.NodeType switch
        {
            "Community" => "images/16/Areas.ico",
            "Job" => "images/16/Job.ico",
            "Customer" => "images/16/customer.ico",
            "Detail" => "images/16/Option.ico",
            _ => null
        };

    private string? GetWarningIcon(InboxJobRow row) =>
        row.WarningQuality switch
        {
            3 => "images/32/TakeoffCustom.ico",
            2 => "images/16/Warn.ico",
            1 => "images/16/question.ico",
            _ => null
        };

    // === Models ===
    public class JCCategoryItem
    {
        public string Category { get; set; } = "";
        public string Description { get; set; } = "";
        public string Display => string.IsNullOrEmpty(Category) ? "" : $"{Category} - {Description}";
    }

    public class InboxJobRow
    {
        public int NodeId { get; set; }
        public int? ParentNodeId { get; set; }
        public int OutlineLevel { get; set; }
        public bool IsSubtotal { get; set; }
        public string NodeType { get; set; } = ""; // Community, Job, Customer, Detail
        public bool IsChecked { get; set; }
        public bool IsCheckIndeterminate { get; set; }

        // Column data
        public string Description { get; set; } = "";
        public string Inverted { get; set; } = "";
        public string ChangeOrderNo { get; set; } = "";
        public string JCCat { get; set; } = "";
        public string Warnings { get; set; } = "";
        public int WarningQuality { get; set; }
        public string CustomerNo { get; set; } = "";
        public string Location { get; set; } = "";
        public string Seq { get; set; } = "";
        public string Job { get; set; } = "";
        public string Model { get; set; } = "";
        public string Community { get; set; } = "";
        public string Quantity { get; set; } = "";
        public string OptionID { get; set; } = "";
        public string Notes { get; set; } = "";
    }
