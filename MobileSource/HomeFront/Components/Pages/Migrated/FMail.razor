@namespace HomeFront.Components.Pages

@using System
@using System.Collections.Generic
@using System.IO
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject ILogger<FMail> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState

<PageTitle>New Message - HomeFront</PageTitle>

<div class="mail-container">
    @* ── TOOLBAR ─────────────────────────────────────────── *@
    <div class="toolbar-cntr">
        <button class="tbar-btn" @onclick="OnAttachFileClick">
            <span>📎</span>
            <span class="tool-label">Attach File</span>
        </button>
        <div class="tbar-separator"></div>
        <button class="tbar-btn" @onclick="OnCutClick">
            <span>✂️</span>
            <span class="tool-label">Cut</span>
        </button>
        <button class="tbar-btn" @onclick="OnCopyClick">
            <span>📋</span>
            <span class="tool-label">Copy</span>
        </button>
        <button class="tbar-btn" @onclick="OnPasteClick">
            <span>📄</span>
            <span class="tool-label">Paste</span>
        </button>
    </div>

    @* ── HEADER PANEL ────────────────────────────────────── *@
    <div class="header-panel">
        <div style="display: flex; align-items: flex-start;">
            @* Send Button *@
            <button class="send-btn" @onclick="OnSendClick" title="Send Message">
                <span style="font-size: 24px;">✉️</span>
                <span>&amp;Send</span>
            </button>

            @* Address Fields *@
            <div style="flex: 1;">
                <div class="header-row">
                    <button class="header-btn" @onclick="OnToPickClick">&amp;To</button>
                    <TextBoxControl @bind-Value="txtTo" Placeholder="Recipients..." CssClass="mail-input" />
                </div>
                <div class="header-row">
                    <button class="header-btn" @onclick="OnCcPickClick">&amp;Cc</button>
                    <TextBoxControl @bind-Value="txtCC" Placeholder="CC Recipients..." CssClass="mail-input" />
                </div>
                <div class="header-row">
                    <label class="mail-subject-label">S&amp;ubject</label>
                    <TextBoxControl @bind-Value="txtSubject" Placeholder="Subject..." CssClass="mail-input" />
                </div>
            </div>
        </div>

        @* Attachments *@
        @if (Attachments.Count > 0)
        {
            <div class="attachments-panel">
                @foreach (var attachment in Attachments)
                {
                    <span class="attachment-item">
                        <span class="attachment-name" @onclick="() => OnAttachmentDoubleClick(attachment)">
                            @GetFileName(attachment)
                        </span>
                        <span class="attachment-remove" @onclick="() => OnRemoveAttachment(attachment)" title="Remove attachment">×</span>
                    </span>
                }
            </div>
        }
    </div>

    @* ── BODY ────────────────────────────────────────────── *@
    <div class="body-panel">
        <TextAreaControl @bind-Value="txtBody" Placeholder="Type your message here..." CssClass="mail-body" />
    </div>
</div>

@* ── FILE INPUT (hidden) ────────────────────────────────── *@
<InputFile id="fileInput" OnChange="OnFileSelected" style="display: none;" />

@* ── VALIDATION DIALOG ──────────────────────────────────── *@
<DialogControl Visible="@IsValidationDialogVisible"
               Header="HomeFront"
               Width="500px"
               IsModal="true"
               ShowCloseIcon="false">
    <ChildContent>
        <p class="mail-dialog-message">@ValidationMessage</p>
    </ChildContent>
    <FooterContent>
        @if (IsValidationYesNo)
        {
            <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="OnValidationYes">Yes</ButtonControl>
            <ButtonControl CssClass="fx-dialog-btn" OnClick="OnValidationNo">No</ButtonControl>
        }
        else
        {
            <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="OnValidationOk">OK</ButtonControl>
        }
    </FooterContent>
</DialogControl>

@* ── PICK LIST (Email Address Book) ────────────────────────── *@
<FPickList @ref="pickListRef" OnSelected="OnPickListSelected" OnCancel="OnPickListCancelled" />

@* ── CLOSE CONFIRM DIALOG ───────────────────────────────── *@
<DialogControl Visible="@IsCloseConfirmVisible"
               Header="HomeFront"
               Width="500px"
               IsModal="true"
               ShowCloseIcon="false">
    <ChildContent>
        <p class="mail-dialog-message">Do you want to send this message?</p>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn mail-btn-primary" OnClick="OnCloseConfirmYes">Yes</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn mail-btn-danger" OnClick="OnCloseConfirmNo">No</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnCloseConfirmCancel">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    // ── Parameters for modal-like usage ──────────────────────────────────
    [Parameter] public string TORecipients { get; set; } = "";
    [Parameter] public string CCRecipients { get; set; } = "";
    [Parameter] public string Subject { get; set; } = "";
    [Parameter] public string Body { get; set; } = "";
    [Parameter] public string AttachmentsParam { get; set; } = "";

    [Parameter] public EventCallback<MailResult> OnComplete { get; set; }

    // ── State ────────────────────────────────────────────────────────────
    private string txtTo = "";
    private string txtCC = "";
    private string txtSubject = "";
    private string txtBody = "";
    private List<string> Attachments = new();

    private bool mInitialized = false;
    private bool mCancel = true;

    // Validation dialog state
    private bool IsValidationDialogVisible = false;
    private string ValidationMessage = "";
    private bool IsValidationYesNo = false;
    private TaskCompletionSource<bool>? _validationTcs;

    // Close confirm dialog state
    private bool IsCloseConfirmVisible = false;

    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        if (!mInitialized)
        {
            txtTo = TORecipients ?? "";
            txtCC = CCRecipients ?? "";
            txtSubject = Subject ?? "";
            txtBody = Body ?? "";

            if (!string.IsNullOrWhiteSpace(AttachmentsParam))
            {
                var files = AttachmentsParam.Split(';', StringSplitOptions.RemoveEmptyEntries);
                foreach (var file in files)
                {
                    var trimmed = file.Trim();
                    if (!string.IsNullOrEmpty(trimmed))
                        Attachments.Add(trimmed);
                }
            }

            mInitialized = true;
            mCancel = true;
        }
    }

    // ── Send Button ──────────────────────────────────────────────────────
    private async Task OnSendClick()
    {
        if (!await ValidMessage())
            return;

        mCancel = false;
        await CompleteEdit();
    }

    // ── Validation ───────────────────────────────────────────────────────
    private async Task<bool> ValidMessage()
    {
        if (string.IsNullOrWhiteSpace(txtTo) && string.IsNullOrWhiteSpace(txtCC))
        {
            await ShowMessageBox("At least one recipient is required.", false);
            return false;
        }

        // Validate To recipients
        var toRecipients = txtTo.Split(';', StringSplitOptions.RemoveEmptyEntries);
        foreach (var recipient in toRecipients)
        {
            var email = ExtractEmail(recipient.Trim());

            if (email.Contains(' ') || !email.Contains('@') || !email.Contains('.'))
            {
                var proceed = await ShowMessageBox(
                    $"HomeFront does not recognize this address\n\n{email}\n\nDo you want to send the message anyway?",
                    true);
                if (!proceed)
                    return false;
            }
        }

        if (string.IsNullOrWhiteSpace(txtSubject))
        {
            var proceed = await ShowMessageBox(
                "There is no subject. Do you want to send the message anyway?",
                true);
            if (!proceed)
                return false;
        }

        return true;
    }

    private string ExtractEmail(string recipientString)
    {
        // Extract email from format "Name <email@domain.com>"
        var ltIdx = recipientString.IndexOf('<');
        var gtIdx = recipientString.IndexOf('>');
        if (ltIdx >= 0 && gtIdx > ltIdx)
        {
            return recipientString.Substring(ltIdx + 1, gtIdx - ltIdx - 1).Trim();
        }
        return recipientString.Trim();
    }

    // ── To / CC Pick List ────────────────────────────────────────────────
    private FPickList? pickListRef;
    private string PickListTarget = ""; // "To" or "Cc"

    private async Task OnToPickClick()
    {
        PickListTarget = "To";
        if (pickListRef != null)
        {
            var divisionId = SessionState.DivisionID;
            var sql = $"SELECT * FROM dbo.EmailAddressBook WHERE divisionid IS NULL OR divisionid={divisionId}";
            await pickListRef.Open("Contact", sql, hideColumns: "divisionid");
        }
    }

    private async Task OnCcPickClick()
    {
        PickListTarget = "Cc";
        if (pickListRef != null)
        {
            var divisionId = SessionState.DivisionID;
            var sql = $"SELECT * FROM dbo.EmailAddressBook WHERE divisionid IS NULL OR divisionid={divisionId}";
            await pickListRef.Open("Contact", sql, hideColumns: "divisionid");
        }
    }

    private void OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        if (selectedRows == null || selectedRows.Count == 0) return;

        var row = selectedRows[0];
        var name = row.ContainsKey("name") ? row["name"]?.ToString() ?? "" : "";
        var email = row.ContainsKey("email") ? row["email"]?.ToString() ?? "" : "";
        var formatted = string.IsNullOrWhiteSpace(name) ? email : $"{name} <{email}>";

        if (PickListTarget == "To")
            txtTo = AppendRecipient(txtTo, formatted);
        else if (PickListTarget == "Cc")
            txtCC = AppendRecipient(txtCC, formatted);

        StateHasChanged();
    }

    private void OnPickListCancelled()
    {
        // Nothing to do on cancel
    }

    private string AppendRecipient(string existing, string newRecipient)
    {
        var combined = existing + "; " + newRecipient;
        // Trim leading semicolons and spaces
        while (combined.Length > 0 && (combined[0] == ' ' || combined[0] == ';'))
            combined = combined.Substring(1);
        return combined;
    }

    // ── Toolbar: Attach / Cut / Copy / Paste ─────────────────────────────
    private async Task OnAttachFileClick()
    {
        // Trigger the hidden file input
        await JSRuntime.InvokeVoidAsync("eval",
            "document.getElementById('fileInput').click()");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(10))
        {
            // In a real app, you'd upload the file and store the path
            // For now, just add the file name
            if (!string.IsNullOrEmpty(file.Name))
            {
                Attachments.Add(file.Name);
            }
        }
        StateHasChanged();
    }

    private async Task OnCutClick()
    {
        // Cut requires JS interop for clipboard and selection
        await JSRuntime.InvokeVoidAsync("eval", @"
            const el = document.activeElement;
            if (el && el.tagName === 'TEXTAREA') {
                const start = el.selectionStart;
                const end = el.selectionEnd;
                const selected = el.value.substring(start, end);
                if (selected) {
                    navigator.clipboard.writeText(selected);
                    el.setRangeText('', start, end, 'end');
                    el.dispatchEvent(new Event('input', { bubbles: true }));
                }
            }
        ");
    }

    private async Task OnCopyClick()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            const el = document.activeElement;
            if (el && el.tagName === 'TEXTAREA') {
                const selected = el.value.substring(el.selectionStart, el.selectionEnd);
                if (selected) navigator.clipboard.writeText(selected);
            }
        ");
    }

    private async Task OnPasteClick()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            const el = document.activeElement;
            if (el && el.tagName === 'TEXTAREA') {
                navigator.clipboard.readText().then(text => {
                    const start = el.selectionStart;
                    const end = el.selectionEnd;
                    el.setRangeText(text, start, end, 'end');
                    el.dispatchEvent(new Event('input', { bubbles: true }));
                });
            }
        ");
    }

    // ── Attachments ──────────────────────────────────────────────────────
    private async Task OnAttachmentDoubleClick(string filePath)
    {
        // In VB6 this called ShellFile to open the attachment
        if (!string.IsNullOrWhiteSpace(filePath))
        {
            await JSRuntime.InvokeVoidAsync("open", filePath, "_blank");
        }
    }

    private void OnRemoveAttachment(string filePath)
    {
        Attachments.Remove(filePath);
        StateHasChanged();
    }

    private string GetFileName(string fullPath)
    {
        try
        {
            return Path.GetFileName(fullPath);
        }
        catch
        {
            return fullPath;
        }
    }

    // ── Message Box Helpers ──────────────────────────────────────────────
    private Task<bool> ShowMessageBox(string message, bool yesNo)
    {
        ValidationMessage = message;
        IsValidationYesNo = yesNo;
        IsValidationDialogVisible = true;
        _validationTcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _validationTcs.Task;
    }

    private void OnValidationOk()
    {
        IsValidationDialogVisible = false;
        _validationTcs?.TrySetResult(true);
    }

    private void OnValidationYes()
    {
        IsValidationDialogVisible = false;
        _validationTcs?.TrySetResult(true);
    }

    private void OnValidationNo()
    {
        IsValidationDialogVisible = false;
        _validationTcs?.TrySetResult(false);
    }

    // ── Close Confirm (QueryUnload equivalent) ───────────────────────────
    private async Task OnCloseClick()
    {
        if (mCancel)
        {
            IsCloseConfirmVisible = true;
            StateHasChanged();
        }
        else
        {
            await CompleteEdit();
        }
    }

    private async Task OnCloseConfirmYes()
    {
        IsCloseConfirmVisible = false;
        mCancel = false;
        await CompleteEdit();
    }

    private async Task OnCloseConfirmNo()
    {
        IsCloseConfirmVisible = false;
        mCancel = true;
        await CompleteEdit();
    }

    private void OnCloseConfirmCancel()
    {
        IsCloseConfirmVisible = false;
        // Stay on the form
    }

    // ── Complete / Return Result ─────────────────────────────────────────
    private async Task CompleteEdit()
    {
        var result = new MailResult
        {
            Cancelled = mCancel,
            TORecipients = txtTo,
            CCRecipients = txtCC,
            Subject = txtSubject,
            Body = txtBody,
            Attachments = string.Join("; ", Attachments)
        };

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(result);
        }
    }

    // ── Result Model ─────────────────────────────────────────────────────
    public class MailResult
    {
        public bool Cancelled { get; set; } = true;
        public string TORecipients { get; set; } = "";
        public string CCRecipients { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Body { get; set; } = "";
        public string Attachments { get; set; } = "";
    }
}
