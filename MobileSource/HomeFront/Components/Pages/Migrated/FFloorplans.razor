@page "/floorplans"
@rendermode InteractiveServer
@namespace HomeFront.Components.Pages
@layout HFComponent

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FFloorplans> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>Floorplan Dimensions - HomeFront</PageTitle>

<div class="floorplans-container" style="position: relative;">
    @if (IsLoading)
    {
        <div class="loading-overlay">
            <div class="loading-spinner">⏳ Loading...</div>
        </div>
    }

    <div class="floorplans-header">Floorplan Dimensions</div>

    <div class="main-layout">
        @* ── Left Panel: Models Grid ──────────────────────────── *@
        <div class="models-panel">
            <div class="panel-label">Models</div>
            <GridControl @ref="ModelsGrid"
                    TValue="ModelRow"
                    DataSource="@ModelsData"
                    AllowSelection="true"
                    AllowResizing="true"
                    Height="440px"
                    SelectionSettingsRef="@modelsSelectionSettings"
                    EventsRef="@modelsGridEvents">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(ModelRow.ModelID)" HeaderText="ModelID" Width="1px" Visible="false" />
                    <GridColumn Field="@nameof(ModelRow.Model)" HeaderText="Model" Width="280px" AllowEditing="false" />
                </GridColumnsBase>
            </GridControl>
        </div>

        @* ── Right Panel: Categories Grid ─────────────────────── *@
        <div class="categories-panel">
            <GridControl @ref="CategoriesGrid"
                    TValue="CategoryRow"
                    DataSource="@CategoriesData"
                    AllowSelection="true"
                    AllowResizing="true"
                    AllowSorting="true"
                    Height="440px"
                    SelectionSettingsRef="@categoriesSelectionSettings"
                    EditSettingsRef="@categoriesEditSettings"
                    EventsRef="@categoriesGridEvents">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(CategoryRow.Room)" HeaderText="Room" Width="150px" />
                    <GridColumn Field="@nameof(CategoryRow.SubCategory)" HeaderText="Sub Category" Width="150px" />
                    <GridColumn Field="@nameof(CategoryRow.Qty)" HeaderText="Qty" Width="80px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(CategoryRow.UOM)" HeaderText="UOM" Width="80px" />
                    <GridColumn Field="@nameof(CategoryRow.RowState)" HeaderText="" Width="1px" Visible="false" />
                </GridColumnsBase>
            </GridControl>
        </div>
    </div>

    @* ── Button Bar ───────────────────────────────────────────── *@
    <div class="button-bar">
        <button class="btn-nav primary" disabled="@(!mDirty)" @onclick="OnOkClick">
            &amp;OK
        </button>
        <button class="btn-nav" @onclick="OnCancelClick">
            &amp;Cancel
        </button>
    </div>
</div>

@* ── Context Menu for Models Grid ─────────────────────────────── *@
@if (IsContextMenuVisible)
{
    <div class="context-menu-overlay" @onclick="CloseContextMenu">
        <div class="context-menu" style="left: @(ContextMenuX)px; top: @(ContextMenuY)px;" @onclick:stopPropagation="true">
            <button @onclick="OnAddModel">Add Model...</button>
            <button disabled="@(SelectedModel == null)" @onclick="OnAddRoom">Add Room...</button>
        </div>
    </div>
}

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    private const string SRCFILE = "FFloorplans::";

    // === Database ===
// === UI State ===
    private bool IsLoading = false;
    private bool mDirty = false;
    private string mModelID = "";

    // === Grid Refs ===
    private GridControl<ModelRow>? ModelsGrid;
    private GridControl<CategoryRow>? CategoriesGrid;

    // === Data Sources ===
    private List<ModelRow> ModelsData = new();
    private List<CategoryRow> CategoriesData = new();

    // === Selection ===
    private ModelRow? SelectedModel;

    // === Context Menu ===
    private bool IsContextMenuVisible = false;
    private double ContextMenuX = 0;
    private double ContextMenuY = 0;

    // === Grid Settings ===
    private SelectionSettings modelsSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    private SelectionSettings categoriesSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    private EditSettings categoriesEditSettings = new()
    {
        AllowAdding = true,
        AllowEditing = true,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };

    private GridControlEvents<ModelRow> modelsGridEvents = new();
    private GridControlEvents<CategoryRow> categoriesGridEvents = new();

    // === Dirty Property ===
    private bool Dirty
    {
        get => mDirty;
        set => mDirty = value;
    }

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        modelsGridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<ModelRow>>(this, OnModelSelected);
        categoriesGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<CategoryRow>>(this, OnCategoryCellSaved);

        await LoadModels();
    }

    // === ShowForm (entry point, equivalent to VB6 ShowForm) ===
    public void ShowForm()
    {
        // In Blazor, navigation to this page is the equivalent of ShowForm
    }

    // === Load Models ===
    private async Task LoadModels()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            ModelsData.Clear();

            var sql = @"
                SELECT DISTINCT q.model
                FROM RoomQtyByModel q
                JOIN roommaster r ON q.roomid = r.roomid
                WHERE r.divisionid = @DivisionID
                ORDER BY q.model";

            var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });

            foreach (var row in rows)
            {
                var model = row["model"]?.ToString() ?? "";
                ModelsData.Add(new ModelRow
                {
                    ModelID = model,
                    Model = model
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}LoadModels]");

        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Load Model Categories ===
    private async Task LoadModel(string modelID)
    {
        mModelID = modelID;
        CategoriesData.Clear();

        try
        {
            var sql = @"
                SELECT q.*, m.Room
                FROM RoomQtyByModel q
                JOIN RoomMaster m ON q.roomid = m.roomid
                WHERE q.model = @ModelID
                ORDER BY m.room, q.subcategory, q.uom";

            var rows = await db.QueryAsync(sql, new { ModelID = modelID });

            foreach (var row in rows)
            {
                CategoriesData.Add(new CategoryRow
                {
                    Room = row["room"]?.ToString() ?? "",
                    SubCategory = row["subcategory"]?.ToString() ?? "",
                    Qty = SafeDecimal(row["qty"]),
                    UOM = row["uom"]?.ToString() ?? "",
                    RowState = "clean"
                });
            }

            // Add empty row at end for new entry
            CategoriesData.Add(new CategoryRow { RowState = "" });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}LoadModel]");

        }

        Dirty = false;
        StateHasChanged();
    }

    // === Save Data ===
    // VB6: SaveData(prompt) — prompt=True shows Yes/No/Cancel; prompt=False saves immediately.
    // Yes=save+return true, No=discard+return true, Cancel=return false (stay).
    private async Task<bool> SaveData(bool prompt)
    {
        if (!mDirty)
            return true;

        if (prompt)
        {
            // VB6 uses vbYesNoCancel: Yes=save, No=discard, Cancel=stay
            var result = await Dialogs.ConfirmCancelAsync(
                "This data has changed.\n\nDo you want to save these changes?");

            if (result == MessageBoxResult.Cancel)
                return false; // Stay on the form, cancel navigation
            if (result == MessageBoxResult.No)
                return true; // Discard changes, allow navigation
        }

        try
        {
            // Delete existing records for this model
            var deleteSql = "DELETE roommastersubcategory WHERE roomid = @ModelID";
            await db.ExecuteAsync(deleteSql, new { ModelID = mModelID });

            // Insert non-deleted rows (skip last empty row)
            for (int r = 0; r < CategoriesData.Count - 1; r++)
            {
                var row = CategoriesData[r];
                if (row.RowState == "delete")
                    continue;

                try
                {
                    var insertSql = @"
                        INSERT INTO roommastersubcategory (ModelID, SubCategory, UOM)
                        VALUES (@ModelID, @SubCategory, @UOM)";

                    await db.ExecuteAsync(insertSql, new
                    {
                        ModelID = mModelID,
                        SubCategory = row.SubCategory ?? "",
                        UOM = row.UOM ?? ""
                    });

                    row.RowState = "";
                }
                catch (Exception ex)
                {
                    if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                        continue;
                    else
                        throw;
                }
            }

            Dirty = false;
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}SaveData]");

            Notifications.Error($"Error saving data: {ex.Message}");
            return false;
        }
    }

    // === Event Handlers ===
    // VB6: gModels_BeforeSelChange — SaveData(True) prompts before switching models
    private async Task OnModelSelected(RowSelectEventArgs<ModelRow> args)
    {
        if (SelectedModel != null && mDirty)
        {
            if (!await SaveData(true))
                return;
        }

        SelectedModel = args.Data;
        if (SelectedModel != null)
        {
            await LoadModel(SelectedModel.ModelID);
        }
    }

    private void OnCategoryCellSaved(CellSaveArgs<CategoryRow> args)
    {
        if (args.Data == null) return;

        var row = args.Data;
        var index = CategoriesData.IndexOf(row);

        // If editing the last (empty) row, add a new empty row
        if (index == CategoriesData.Count - 1)
        {
            row.RowState = "new";
            CategoriesData.Add(new CategoryRow { RowState = "" });
        }
        else if (string.IsNullOrEmpty(row.RowState))
        {
            row.RowState = "dirty";
        }

        Dirty = true;
        StateHasChanged();
    }

    // VB6: cmdNav(0) = OK => SaveData(False) — save without prompting
    private async Task OnOkClick()
    {
        if (await SaveData(false))
        {
            Dirty = false;
            ClosePage();
        }
    }

    // VB6: cmdNav(1) = Cancel => SaveData(True) — prompt if dirty
    private async Task OnCancelClick()
    {
        if (await SaveData(true))
        {
            Dirty = false;
            ClosePage();
        }
    }

    // === Models Grid KeyDown — Delete Model Dimensions ===
    public async Task OnModelsKeyDown(string key, bool shiftKey)
    {
        if (key == "Delete" && shiftKey && SelectedModel != null)
        {
            var confirm = await Dialogs.ConfirmAsync(
                "Are you sure you want to delete the dimensions for this model?");
            if (!confirm) return;

            try
            {
                var sql = "DELETE RoomQtyByModel WHERE RoomID = @ModelID";
                await db.ExecuteAsync(sql, new { ModelID = SelectedModel.ModelID });

                ModelsData.Remove(SelectedModel);

                if (ModelsData.Count > 0)
                {
                    SelectedModel = ModelsData[0];
                    await LoadModel(SelectedModel.ModelID);
                }
                else
                {
                    SelectedModel = null;
                    CategoriesData.Clear();
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[{SRCFILE}OnModelsKeyDown]");

            }
        }
    }

    // === Categories Grid KeyDown — Delete Category Row ===
    public async Task OnCategoriesKeyDown(CategoryRow? row, string key, bool shiftKey)
    {
        if (row == null) return;
        var index = CategoriesData.IndexOf(row);
        if (index < 1) return;
        if (index == CategoriesData.Count - 1) return; // Don't delete the empty row

        if (key == "Delete" && shiftKey)
        {
            row.RowState = "delete";
            // Hide the row by removing it from the visible list
            CategoriesData.Remove(row);
            Dirty = true;
            StateHasChanged();
        }
    }

    // === Context Menu (right-click on Models grid) ===
    public async Task OnModelsContextMenu(double x, double y)
    {
        ContextMenuX = x;
        ContextMenuY = y;
        IsContextMenuVisible = true;
        StateHasChanged();
    }

    private void CloseContextMenu()
    {
        IsContextMenuVisible = false;
    }

    private async Task OnAddModel()
    {
        CloseContextMenu();
        Notifications.Info("Add Model - not yet implemented");
    }

    private async Task OnAddRoom()
    {
        CloseContextMenu();
        Notifications.Info("Add Room - not yet implemented");
    }

    // === Helpers ===
    private decimal SafeDecimal(object? val, decimal def = 0) =>
        val != null && val != DBNull.Value && !string.IsNullOrEmpty(val.ToString())
            ? Convert.ToDecimal(val)
            : def;

    // === Model Classes ===
    public class ModelRow
    {
        public string ModelID { get; set; } = "";
        public string Model { get; set; } = "";
    }

    public class CategoryRow
    {
        public string Room { get; set; } = "";
        public string SubCategory { get; set; } = "";
        public decimal Qty { get; set; }
        public string UOM { get; set; } = "";
        public string RowState { get; set; } = "";
    }
}
