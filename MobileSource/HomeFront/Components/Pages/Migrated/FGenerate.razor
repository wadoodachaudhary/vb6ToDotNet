@using HomeFront.Components.Grid
@using HomeFront.Data
@using System.Data
@using System.Dynamic
@using System.Text

<style>
    .fg-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1100;
    }

    .fg-dialog {
        width: 980px;
        max-width: 96vw;
        max-height: 92vh;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.25);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .fg-header {
        padding: 12px 16px;
        font-weight: 600;
        border-bottom: 1px solid #dee2e6;
        background: #f8f9fa;
    }

    .fg-body {
        padding: 16px;
        overflow: auto;
    }

    .fg-message {
        font-size: 14px;
        margin-bottom: 12px;
    }

    .fg-footer {
        padding: 10px 16px;
        border-top: 1px solid #dee2e6;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        background: #f8f9fa;
    }

    .fg-btn {
        padding: 6px 16px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 13px;
    }

    .fg-btn.primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }
</style>

@if (IsVisible)
{
    <div class="fg-overlay">
        <div class="fg-dialog">
            <div class="fg-header">@DialogTitle</div>
            <div class="fg-body">
                <div class="fg-message">@Message</div>
                <HfGrid TValue="ExpandoObject"
                        DataSource="@GridData"
                        AllowSorting="true"
                        AllowResizing="true"
                        AllowSelection="true"
                        Height="360px">
                    <HfGridColumnsBase>
                        @foreach (var col in GridColumns)
                        {
                            <HfGridColumn Field="@col" HeaderText="@col" />
                        }
                    </HfGridColumnsBase>
                </HfGrid>
            </div>
            <div class="fg-footer">
                @if (ShowCancel)
                {
                    <button class="fg-btn" @onclick="OnCancel">Cancel</button>
                }
                <button class="fg-btn primary" @onclick="OnOk">OK</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly DbWrapperSqlServer db = new();

    private bool IsVisible;
    private string DialogTitle = "";
    private string Message = "";
    private bool ShowCancel;
    private TaskCompletionSource<bool>? _dialogTcs;

    private List<ExpandoObject> GridData = new();
    private List<string> GridColumns = new();

    private bool TaxGroupRequired = false;

    public async Task<bool> VerifyBudgets(string whereClause)
    {
        var sql = BuildVerifyBudgetsSql(whereClause);
        var dt = db.SqlExec(sql);
        if (dt.Rows.Count == 0)
            return true;

        DialogTitle = "Warning";
        Message = "The PO's you are about to generate will exceed the jobs budgeted amounts. Are you sure you want to continue?";
        ShowCancel = true;
        LoadData(dt);

        var result = await ShowDialogAsync();
        return result;
    }

    public async Task<bool> ValidateData(string whereClause, bool budgets)
    {
        var sql = BuildValidateDataSql(whereClause, budgets);
        var dt = db.SqlExec(sql);
        if (dt.Rows.Count == 0)
            return true;

        DialogTitle = "Validation";
        Message = "The following items are missing required data. Please correct the problems listed below.";
        ShowCancel = false;
        LoadData(dt);

        await ShowDialogAsync();
        return false;
    }

    private void LoadData(DataTable dt)
    {
        GridColumns = dt.Columns.Cast<DataColumn>().Select(c => c.ColumnName).ToList();
        GridData = new List<ExpandoObject>();

        foreach (DataRow row in dt.Rows)
        {
            IDictionary<string, object?> expando = new ExpandoObject();
            foreach (DataColumn col in dt.Columns)
            {
                var value = row[col];
                expando[col.ColumnName] = value == DBNull.Value ? "" : value;
            }
            GridData.Add((ExpandoObject)expando);
        }
    }

    private async Task<bool> ShowDialogAsync()
    {
        _dialogTcs = new TaskCompletionSource<bool>();
        IsVisible = true;
        await InvokeAsync(StateHasChanged);
        return await _dialogTcs.Task;
    }

    private void CloseDialog(bool result)
    {
        IsVisible = false;
        _dialogTcs?.TrySetResult(result);
        _dialogTcs = null;
        StateHasChanged();
    }

    private void OnOk() => CloseDialog(true);
    private void OnCancel() => CloseDialog(false);

    private string BuildVerifyBudgetsSql(string whereClause)
    {
        var sb = new StringBuilder();
        sb.AppendLine("SELECT JCCostCodeDesc CostCode,JCCategoryDesc Category");
        sb.AppendLine("      ,convert(varchar(50),cast(SUM(isnull(BudgetPretax,0)) as money),1) Budgeted");
        sb.AppendLine("      ,convert(varchar(50),cast(SUM(isnull(POPretax,0)) as money),1) Committed");
        sb.AppendLine("      ,convert(varchar(50),cast(SUM(isnull(POPretax,0))-SUM(isnull(BudgetPretax,0)) as money),1) OverBudget");
        sb.AppendLine("      ,case sum(isnull(budgetpretax,0)) when 0 then 100 else round((SUM(POPretax)-SUM(BudgetPretax))/SUM(BudgetPretax)*100,2) end Percentage");
        sb.AppendLine("FROM EstimatedItems i");
        sb.AppendLine($"WHERE PODeleted = 0 And POGenBatch = 0 And {whereClause}");
        sb.AppendLine("GROUP BY JCCostCode,JCCostCodeDesc,JCCategory,JCCategoryDesc");
        sb.AppendLine("HAVING SUM(isnull(POPretax,0))>SUM(isnull(BudgetPretax,0))");
        sb.AppendLine("ORDER BY 1,2");
        return sb.ToString();
    }

    private string BuildValidateDataSql(string whereClause, bool budgets)
    {
        var prefix = budgets ? "Budget" : "PO";
        var taxGroupCheck = TaxGroupRequired ? "1=1" : "1=0";

        var sb = new StringBuilder();
        sb.AppendLine($"select {prefix}vendor Vendor");
        sb.AppendLine("      ,POIndex");
        sb.AppendLine("      ,EstPhase");
        sb.AppendLine("      ,EstItem");
        sb.AppendLine("      ,ItemDesc");
        sb.AppendLine("      ,JCCostCode");
        sb.AppendLine("      ,JCCategory");
        sb.AppendLine($"      ,{prefix}TaxGroup TaxGroup");
        sb.AppendLine("      ,substring(case when jccostcodedesc='' then ', Cost code is missing or invalid' else '' end +");
        sb.AppendLine("       case when jccategorydesc='' then ', Category is missing or invalid' else '' end +");
        sb.AppendLine("       case when poindex='' then ', PO index is missing or invalid' else '' end +");
        if (!budgets)
            sb.AppendLine("       case when variancejccategorydesc ='' and variancepretax<>0 and BudgetsLocked = 1 then ', Variance category is missing or invalid' else '' end +");
        sb.AppendLine($"       case when {prefix}vendorname='' then ', Vendor is missing or invalid' else '' end +");
        sb.AppendLine($"       case when {taxGroupCheck} and {prefix}taxgroup='' then ', Tax group is missing or invalid' else '' end,3,999) Problem");
        sb.AppendLine(" from estimateditems i");
        sb.AppendLine(" where (JCcostcodeDesc ='' or ");
        sb.AppendLine("        jccategorydesc ='' or ");
        sb.AppendLine("        jccategorydesc ='' or ");
        if (!budgets)
            sb.AppendLine("        (variancejccategorydesc ='' and variancepretax<>0  and BudgetsLocked = 1) or ");
        sb.AppendLine("        poindex ='' or ");
        sb.AppendLine($"        {prefix}vendorname='' or ");
        sb.AppendLine($"        ({taxGroupCheck} and {prefix}taxgroup=''))");
        sb.AppendLine($"   and {prefix}deleted=0");
        if (!budgets)
            sb.AppendLine("and pogenbatch = 0");
        sb.AppendLine($"   and {whereClause}");
        return sb.ToString();
    }
}