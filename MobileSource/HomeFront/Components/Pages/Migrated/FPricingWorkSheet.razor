    // VB6: RefreshCosts — queries assembly costs from stored procedure
    private async Task OnRefreshCostsClick()
    {
        if (IsReadOnly) return;
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Refresh costs from estimating? This will update all cost fields."))
            return;

        IsLoading = true;
        StateHasChanged();
        try
        {
            foreach (var row in WorksheetData.Where(r => !r.Inactive))
            {
                // Query assembly cost via stored procedure
                var costRows = await db.QueryAsync(
                    $"EXEC dbo.Purch_GetAssemblySalesSheetCost @DivisionID={DivisionID}, @Assembly='{row.Assembly}', @Model='{row.Model}', @CostBasisType={CostBasisType}");
                if (costRows.Any())
                {
                    var cr = costRows.First();
                    row.ConstructionCost = SafeDecimal(cr.ContainsKey("ConstructionCost") ? cr["ConstructionCost"] : null);
                    row.LandCost = SafeDecimal(cr.ContainsKey("LandCost") ? cr["LandCost"] : null);
                    row.IncentiveCost = row.ConstructionCost * IncentiveCostPercent / 100m;
                    row.Cost = row.ConstructionCost + row.LandCost + row.IncentiveCost;
                }
                CalcData(row, "cost");
                row.RowState = "DIRTY";
            }
            mDirty = true;
            await JSRuntime.InvokeVoidAsync("alert", "Costs refreshed.");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Refresh costs error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // VB6: RefreshPublished — loads published prices from database
    private async Task OnRefreshPublishedClick()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            foreach (var row in WorksheetData)
            {
                var pubRows = await db.QueryAsync(
                    $@"SELECT TOP 1 Pretax, Tax, Price, COPrice, Markup, Margin, Incentive
                       FROM tblPublishedPrices
                       WHERE DivisionID={DivisionID} AND Model='{row.Model}' AND Assembly='{row.Assembly}'
                       ORDER BY EffectiveDate DESC");
                if (pubRows.Any())
                {
                    var pr = pubRows.First();
                    row.PublishedPretax = SafeDecimal(pr.ContainsKey("Pretax") ? pr["Pretax"] : null);
                    row.PublishedTax = SafeDecimal(pr.ContainsKey("Tax") ? pr["Tax"] : null);
                    row.PublishedPrice = SafeDecimal(pr.ContainsKey("Price") ? pr["Price"] : null);
                    row.PublishedCOPrice = SafeDecimal(pr.ContainsKey("COPrice") ? pr["COPrice"] : null);
                    row.PublishedMarkup = SafeDecimal(pr.ContainsKey("Markup") ? pr["Markup"] : null);
                    row.PublishedMargin = SafeDecimal(pr.ContainsKey("Margin") ? pr["Margin"] : null);
                    row.PublishedIncentive = SafeDecimal(pr.ContainsKey("Incentive") ? pr["Incentive"] : null);
                    row.PublishedProfit = row.PublishedPretax - row.Cost;
                }
            }
            await JSRuntime.InvokeVoidAsync("alert", "Published prices refreshed.");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Refresh published error: {ex.Message}");
