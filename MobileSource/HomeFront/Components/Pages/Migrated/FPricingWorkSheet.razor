    // KEPT VERBATIM (not _g.GetOrdered): different signature — takes the layout
    // dict as a PARAMETER (also called on the hidden-field probe in
    // ResolveLookupTargetsAsync) — and DOES NOT filter Hidden (the markup's
    // Visible="@(!col.Hidden)" does that, after deciding picker/notes/plain by
    // field). The presenter's GetOrdered filters Hidden + resolves field/type/align,
    // which would drop the hidden columns this method must still surface.
    private IEnumerable<GridLayoutColumn> GetOrderedGridLayout(Dictionary<string, GridLayoutColumn> layoutDict)
    {
        return layoutDict.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field))
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase);
    }

    // twips → px is the single canonical GridLayoutPresenter.WidthPx now
    // (was a hand-copied /15 +16 clamp — identical formula). BuildDefaultGridLayout's
    // inverse (px-16)*15 still round-trips this exactly.
    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // KEPT VERBATIM (not _g.ColumnTypeFor): driven by the CheckboxFields /
    // NumericFields HASHSETS, NOT reflection on WorksheetRow. The presenter infers
    // the type from the property's CLR type — which here would mis-type columns
    // (e.g. ConstCutOff is a decimal property but VB6 stored a string in it, and
    // several bool-ish flags aren't in CheckboxFields). The hashsets are the
    // VB6-faithful source of truth, so this stays.
    private ColumnType GetColumnTypeForField(string field)
    {
        if (CheckboxFields.Contains(field)) return ColumnType.CheckBox;
        if (NumericFields.Contains(field)) return ColumnType.Number;
        return ColumnType.Text;
    }

    private TextAlign GetTextAlignForField(string field)
    {
        if (NumericFields.Contains(field)) return TextAlign.Right;
        return TextAlign.Left;
    }

    private string? GetFormatForField(string field)
    {
        // VB6 blank-on-zero columns use a 3-section custom mask whose third
        // (zero) section is empty, so 0 / NULL renders as a blank cell.
        //   section 1 = positive, section 2 = negative, section 3 = zero("")
        if (BlankOnZeroFields.Contains(field))
        {
            if (CurrencyFields.Contains(field)) return "$#,##0.00;($#,##0.00);";
            if (PercentFields.Contains(field)) return "#,##0.00;-#,##0.00;";
            return "#,##0.00;-#,##0.00;";
        }

        if (CurrencyFields.Contains(field)) return "C2";
        if (PercentFields.Contains(field)) return "N2";
        if (field.Equals("FloorArea", StringComparison.OrdinalIgnoreCase) || field.Equals("Bedrooms", StringComparison.OrdinalIgnoreCase))
            return "N0";
        if (field.Equals("Bathrooms", StringComparison.OrdinalIgnoreCase) || field.Equals("Qty", StringComparison.OrdinalIgnoreCase))
            return "N1";
        if (field.Equals("RoundTo", StringComparison.OrdinalIgnoreCase)) return "N0";
        return null;
    }

    /// <summary>Column-level editability: true when the field is editable on
    /// AT LEAST ONE assembly type. Lets the column participate in editing; the
    /// per-row gate in <see cref="OnCellEditStart"/> then vetoes the specific
    /// (row, column) combinations VB6 would block. Multi-line columns return
    /// false here so they never open the grid's inline text box — their ✏️
    /// button opens the MultiLineEditControl instead.</summary>
    private bool GetAllowEditForField(string field)
    {
        if (MultiLineEditFields.Contains(field)) return false;
        return AlwaysEditableFields.Contains(field)
            || NonModelEditableFields.Contains(field)
            || ModelOnlyEditableFields.Contains(field)
            || DesignCenterOnlyFields.Contains(field);
    }

    /// <summary>Per-(row, column) editability — the VB6 gData_BeforeEdit gate.
    /// Decides whether a cell on THIS row (with its AssemblyType) may edit.
    /// AssemblyType is compared by its raw int (VB6 MMain.AssemblyTypes:
    /// atModel=0, atOption=2, atGlobal=3, atDesignCenter=4) so the page has no
    /// dependency on a specific AssemblyTypes enum declaration.</summary>
    private const int AssemblyTypeModel = 0;
    private const int AssemblyTypeDesignCenter = 4;

    private bool IsCellEditable(WorksheetRow row, string field)
    {
        if (IsReadOnly) return false;
        var t = row.AssemblyType;
        if (AlwaysEditableFields.Contains(field)) return true;
        if (NonModelEditableFields.Contains(field)) return t != AssemblyTypeModel;
        if (ModelOnlyEditableFields.Contains(field)) return t == AssemblyTypeModel;
        if (DesignCenterOnlyFields.Contains(field)) return t == AssemblyTypeDesignCenter;
        return false;
    }

    /// <summary>Wired to the grid's OnCellEdit (raised just before a cell
    /// enters edit mode). Cancels the edit for (row, column) pairs VB6 blocks
    /// — the inline port of gData_BeforeEdit's per-type Select Case.</summary>
    private void OnCellEditStart(CellEditArgs<WorksheetRow> args)
    {
        if (args.Data == null) return;
        if (!IsCellEditable(args.Data, args.ColumnName ?? ""))
            args.Cancel = true;
    }

    private bool IsNotesOrCommentsField(string field)
    {
        return MultiLineEditFields.Contains(field);
    }

    /// <summary>Returns the current value of a multi-line column
    /// (Description / Notes / Comments) for the ✏️ editor dialog.</summary>
    private static string GetMultiLineValue(WorksheetRow row, string field)
    {
        if (field.Equals("Notes", StringComparison.OrdinalIgnoreCase)) return row.Notes;
        if (field.Equals("Description", StringComparison.OrdinalIgnoreCase)) return row.Description;
        return row.Comments;
    }

    // === Initialization ===
    private void InitializeCostBasis()
    {
        // VB6 parity: MMain.LoadCostTypes seeds the cboCostBasis combo with
        // these six fixed cost periods (Id = ListIndex, persisted as
        // tblSalesSheetMaster.CostBasisType). Forecast 1..12 names are then
        // appended from CustomDescriptions in LoadCostBasisForecastsAsync.
        CostBasisList = new List<CostBasisItem>
        {
            new() { Id = 0, Name = "Current" },
            new() { Id = 1, Name = "Next 1" },
            new() { Id = 2, Name = "Next 2" },
            new() { Id = 3, Name = "Last 1" },
            new() { Id = 4, Name = "Last 2" },
            new() { Id = 5, Name = "Last 3" },
        };
    }

    /// <summary>VB6 parity (MMain.LoadCostTypes): append the Forecast 1..12
    /// cost periods to the Cost Basis combo, using each forecast's custom
    /// label from CustomDescriptions when one exists (else "Forecast N").
    /// These follow the six fixed periods, so their Ids continue at 6.</summary>
    private async Task LoadCostBasisForecastsAsync()
    {
        try
        {
            var rows = await Db.QueryAsync(@"
                SELECT Item, MAX(Custom_Description) AS Label
                FROM CustomDescriptions
                WHERE Item LIKE 'Forecast%'
                GROUP BY Item");
            // Map the DB rows by their numeric suffix so we can emit them in
            // order (Forecast1..Forecast12) regardless of GROUP BY ordering.
            var labels = new Dictionary<int, string>();
            foreach (var r in rows)
            {
                var item = r["Item"]?.ToString() ?? "";
                if (item.Length > 8 && int.TryParse(item.AsSpan(8), out var n))
                {
                    var custom = r["Label"]?.ToString();
                    labels[n] = string.IsNullOrWhiteSpace(custom) ? $"Forecast {n}" : custom;
                }
            }
            for (int n = 1; n <= 12; n++)
            {
                var name = labels.TryGetValue(n, out var lbl) ? lbl : $"Forecast {n}";
                CostBasisList.Add(new CostBasisItem { Id = 5 + n, Name = name });
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load Forecast cost-basis labels; using fixed periods only");
        }
    }

