        "CategoryDesc"   => row.CategoryDesc,
        "Series"         => row.Series,
        "AssemblyUOM"    => row.AssemblyUOM,
        _ => ""
    };

    /// <summary>Opens the shared FPickList for a lookup cell. Mirrors VB6
    /// gData_CellButtonClick: each field has its own query; the pick is applied
    /// in OnPickListSelected's "Lookup" branch and fanned across the selected
    /// rows.</summary>
    private Task OnGridEditButtonClick(CellEditButtonArgs<WorksheetRow> args)
    {
        if (args.Data == null || string.IsNullOrWhiteSpace(args.ColumnName))
            return Task.CompletedTask;

        // Multi-line text columns (Description/Notes/Comments) open the text dialog;
        // every other edit-button column (lookups/pickers) opens FPickList.
        if (IsNotesOrCommentsField(args.ColumnName))
        {
            OnEditText(args.Data, args.ColumnName);
            return Task.CompletedTask;
        }

        return OnLookupButton(args.Data, args.ColumnName);
    }

    private async Task OnLookupButton(WorksheetRow row, string field)
    {
        if (IsReadOnly || pickList == null) return;
        var (title, query, hideCols) = BuildLookupQuery(field, row);
        if (string.IsNullOrWhiteSpace(query)) return;
        _lookupRow = row;
        _lookupField = field;
        _lookupTargets.Clear();
        _lookupTargets.AddRange(await ResolveLookupTargetsAsync(row, field));
        _pickListContext = "Lookup";
        await pickList.Open(title: title, queries: query, hideColumns: hideCols,
                            defaultItem: GetLookupDisplay(row, field), multiSelect: false);
    }

    private async Task<List<WorksheetRow>> ResolveLookupTargetsAsync(WorksheetRow row, string field)
    {
        if (gData == null)
            return [row];

        var selectedCells = await gData.GetSelectedRowCellIndexesAsync();
        if (selectedCells.Count == 0)
            return [row];

        var visibleFields = GetOrderedGridLayout(gDataLayout)
            .Where(c => !c.Hidden)
            .Select(c => c.Field)
            .ToList();
        var fieldIndex = visibleFields.FindIndex(f => string.Equals(f, field, StringComparison.OrdinalIgnoreCase));
        var clickedRowIndex = WorksheetData.IndexOf(row);
        if (fieldIndex < 0
            || clickedRowIndex < 0
            || !selectedCells.Any(c => c.CellIndex == fieldIndex && c.RowIndex == clickedRowIndex))
            return [row];

        var targets = new List<WorksheetRow>();
        var seen = new HashSet<WorksheetRow>();
        foreach (var cell in selectedCells
                     .Where(c => c.CellIndex == fieldIndex)
                     .OrderBy(c => c.RowIndex))
        {
            if (cell.RowIndex < 0 || cell.RowIndex >= WorksheetData.Count)
                continue;

            var target = WorksheetData[cell.RowIndex];
            if (seen.Add(target))
                targets.Add(target);
        }

        return targets.Count == 0 ? [row] : targets;
    }

    /// <summary>Per-field picklist query (VB6 gData_CellButtonClick). DivisionID
    /// is an int (safe to interpolate); the only row-derived string is the
    /// current Community for the phase query, single-quote-escaped.</summary>
    private (string Title, string Query, string? HideColumns) BuildLookupQuery(string field, WorksheetRow row)
    {
        var div = SessionState.DivisionID;
        switch (field)
        {
            case "Location":
                return ("Location", "SELECT Area, Description FROM tblAreas ORDER BY Description", null);
            case "Community":
            case "CommunityDesc":
                return ("Community",
                    $@"SELECT l.area Community, l.Description
                         FROM tbllocality l
                         LEFT OUTER JOIN DivisionCommunities d ON d.Community = l.Area
                        WHERE ISNULL(l.Inactive,0)=0
                          AND (d.DivisionID IS NULL OR d.DivisionID = {div})
                        ORDER BY l.Description", null);
            case "CommunityPhase":
                var comm = (row.Community ?? "").Replace("'", "''");
                return ("Phase",
                    $@"SELECT CommunityPhase Phase, Description
                         FROM communityphase
                        WHERE Community = '{comm}'
                        ORDER BY Description", null);
            case "Category":
                return ("Category",
                    "SELECT Category, Description, COMarkup FROM tblCategories ORDER BY Description", "COMarkup");
            case "CategoryDesc":
                return ("Category",
                    "SELECT Description, Category, COMarkup FROM tblCategories ORDER BY Description", "COMarkup");
            case "Series":
                return ("Series",
                    $"SELECT Series, Description FROM tblSeries WHERE DivisionID = {div} ORDER BY Series", null);
            case "AssemblyUOM":
                return ("UOM",
                    "SELECT DISTINCT ISNULL(AssemblyUOM,'') UOM FROM tblDBAssemblyMaster WHERE ISNULL(AssemblyUOM,'') <> '' ORDER BY UOM", null);
            default:
                return ("", "", null);
        }
    }

    /// <summary>Applies a lookup pick to the target rows. VB6 fans the value
    /// across .Row To .RowSel — here, across the grid's selected rows (plus the
    /// clicked row), so a drag-select then pick updates the whole range.</summary>
    private void ApplyLookupPick(IDictionary<string, object> picked)
    {
        if (_lookupRow == null || string.IsNullOrEmpty(_lookupField)) return;

        var targets = _lookupTargets.Count > 0
            ? _lookupTargets.ToList()
            : new List<WorksheetRow> { _lookupRow };
        if (!targets.Contains(_lookupRow)) targets.Insert(0, _lookupRow);
        targets = targets.Where(r => IsCellEditable(r, _lookupField)).ToList();
        if (targets.Count == 0)
        {
            _lookupRow = null;
            _lookupField = "";
            _lookupTargets.Clear();
            return;
        }

        string Get(string col) => picked.TryGetValue(col, out var v) ? v?.ToString() ?? "" : "";

        foreach (var r in targets)
        {
            switch (_lookupField)
            {
                case "Location":
                    r.Location = Get("Area");
                    break;
                case "Community":
                case "CommunityDesc":
                    r.Community = Get("Community");
                    r.CommunityDesc = Get("Description");
                    r.CommunityPhase = "";
                    break;
                case "CommunityPhase":
                    r.CommunityPhase = Get("Phase");
                    break;
                case "Category":
                case "CategoryDesc":
                    r.Category = Get("Category");
                    r.CategoryDesc = Get("Description");
                    if (decimal.TryParse(Get("COMarkup"), out var coMk))
                        r.COMarkup = coMk;
                    break;
                case "Series":
                    r.Series = Get("Series");
                    break;
                case "AssemblyUOM":
                    r.AssemblyUOM = Get("UOM");
                    break;
            }
            r.RowState = "DIRTY";
            CalcData(r, _lookupField);
        }

        mDirty = true;
        _lookupRow = null;
        _lookupField = "";
        _lookupTargets.Clear();
        StateHasChanged();
    }

