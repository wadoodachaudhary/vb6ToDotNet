@page "/pricing-worksheet"
@page "/pricing-worksheet/{WorksheetIdParam}"

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Dynamic
@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject ILogger<FPricingWorkSheet> Logger
@inject NotificationService Notifications
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHost
@inject IReportSeedParameters ReportSeeds
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer Db
@using HomeFront.Models
@layout HFComponent


@if (IsLoading)
{
    <div class="loading">
        <div class="loading-spinner"></div>
        <span>Loading Worksheet...</span>
    </div>
}

<div class="tabs-container pricing-vb6">
            <!-- Toolbar — VB6 (FPricingWorksheet.frm) always shows Add /
                 Remove / Refresh Costs / Refresh Published in the layout
                 and disables them via runtime state. POC previously HID
                 them with @if guards which left users wondering where
                 they went. Buttons now always render; Disabled gates the
                 ones that need it (matches VB6 Enabled = 0). -->
            <ToolbarControl>
                @* VB6 parity: toolbar buttons use the same .ico glyphs as
                   FPricingWorksheet.frm's Toolbar control (wwwroot/images/32).
                   onerror hides a missing icon so the text label still shows. *@
                <ToolbarButtonControl CssClass="btn-primary"
                                      Disabled="@(WorksheetView != "Estimating" || IsReadOnly)"
                                      OnClick="OnAddClick">
                    <img class="spw-tbar-icon" src="images/32/Add.ico" alt="" onerror="this.style.display='none'" /> Add
                </ToolbarButtonControl>
                <ToolbarButtonControl CssClass="btn-danger"
                                      Disabled="@(WorksheetView != "Estimating" || IsReadOnly || SelectedRow == null)"
                                      OnClick="OnRemoveClick">
                    <img class="spw-tbar-icon" src="images/32/delete.ico" alt="" onerror="this.style.display='none'" /> Remove
                </ToolbarButtonControl>
                <ToolbarSeparatorControl />

                <ToolbarButtonControl OnClick="OnPreviewClick">
                    <img class="spw-tbar-icon" src="images/32/Preview.ico" alt="" onerror="this.style.display='none'" /> Preview
                </ToolbarButtonControl>

                @if (ShowCostsButton)
                {
                    <ToolbarButtonControl OnClick="OnCostsClick">
                        <img class="spw-tbar-icon" src="images/32/Pricebook.ico" alt="" onerror="this.style.display='none'" /> Costs
                    </ToolbarButtonControl>
                }

                <ToolbarButtonControl CssClass="btn-success" Disabled="@(!mDirty || IsReadOnly)" OnClick="OnSaveClick">
                    <img class="spw-tbar-icon" src="images/32/save.ico" alt="" onerror="this.style.display='none'" /> Save
                </ToolbarButtonControl>

                <ToolbarButtonControl OnClick="OnSaveAsClick">
                    <img class="spw-tbar-icon" src="images/32/saveas.ico" alt="" onerror="this.style.display='none'" /> Save As
                </ToolbarButtonControl>

                <ToolbarButtonControl CssClass="btn-info"
                                      Disabled="@IsReadOnly"
                                      OnClick="OnPublishClick">
                    <img class="spw-tbar-icon" src="images/32/Publish.ico" alt="" onerror="this.style.display='none'" /> Publish
                </ToolbarButtonControl>

                <ToolbarSeparatorControl />

                <ToolbarButtonControl Disabled="@IsReadOnly" OnClick="OnRefreshCostsClick">
                    <img class="spw-tbar-icon" src="images/32/refresh.ico" alt="" onerror="this.style.display='none'" /> Rfrsh Costs
                </ToolbarButtonControl>

                <ToolbarButtonControl OnClick="OnRefreshPublishedClick">
                    <img class="spw-tbar-icon" src="images/32/refresh.ico" alt="" onerror="this.style.display='none'" /> Rfrsh Published
                </ToolbarButtonControl>

                <ToolbarSeparatorControl />

                <div class="export-dropdown">
                    <ToolbarButtonControl OnClick="ToggleExportMenu">
                        <img class="spw-tbar-icon" src="images/32/export.ico" alt="" onerror="this.style.display='none'" /> Export ▾
                    </ToolbarButtonControl>
                    @if (ShowExportMenu)
                    {
                        <div class="export-menu">
                            <button @onclick="OnExportCsv">Export CSV</button>
                            <button @onclick="OnExportExcel">Export Excel</button>
                            <button @onclick="OnExportPdf">Save as PDF</button>
                        </div>
                    }
                </div>
            </ToolbarControl>

            <h4 class="page-title">@WorksheetView Worksheet @(WorksheetId > 0 ? $"(number {WorksheetId})" : "(New)") @(IsReadOnly ? " [Read Only]" : "")</h4>

            <!-- Header Panel -->
            <div class="header-panel">
                <div class="header-layout">
                    <!-- Column 1 -->
                    <div class="header-col header-col-info">
                        <div class="header-section">
                            <div class="field-row">
                                <label>Description</label>
                                <TextBoxControl @bind-Value="WorksheetDescription" CssClass="field-value-wide"
                                           Placeholder="Description" MaxLength="50"
                                           Enabled="@(!IsReadOnly)" />
                            </div>
                            <div class="field-row">
                                <label>Cost Basis</label>
                                <DropDownListControl TValue="int" TItem="CostBasisItem"
                                                @bind-Value="CostBasisType"
                                                DataSource="@CostBasisList"
                                                TextFieldName="Name" ValueFieldName="Id"
                                                Width="118px" Enabled="@(!IsReadOnly)" />
                            </div>
                            <div class="field-row">
                                <label>Costs Effective</label>
                                <span class="field-static">@CostsEffectiveDate.ToString("MMM d, yyyy")</span>
                            </div>
                            @if (WorksheetView == "Estimating")
                            {
                                <div class="field-row">
                                    <label>Published to Sales</label>
                                    <span class="field-static @(SalesEffectiveDate.HasValue ? "" : "field-static-empty")">
                                        @(SalesEffectiveDate?.ToString("MMM d, yyyy") ?? "")
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Column 2 -->
                    <div class="header-col header-col-options">
                        <div class="header-section">
                            <div class="field-row">
                                <label>Round all prices to</label>
                                <NumericTextBoxControl TValue="decimal" @bind-Value="RoundTo" Format="N0" Min="0"
                                                  Width="72px" Enabled="@(!IsReadOnly)"
                                                  ValueChange="OnRoundToChange" />
                            </div>
                            @if (WorksheetView == "Estimating")
                            {
                                <div class="field-row">
                                    <label>Incentive Cost%</label>
                                    <NumericTextBoxControl TValue="decimal" @bind-Value="IncentiveCostPercent" Format="N2"
                                                      Min="0" Max="100" Width="72px"
                                                      Enabled="@(IncentiveCostEnabled && !IsReadOnly)"
                                                      ValueChange="OnIncentiveCostPercentChange" />
                                </div>
                            }
                            <div class="field-row">
                                <label>Layout</label>
                                <DropDownListControl TValue="string" TItem="string"
                                                @bind-Value="SelectedLayout"
                                                DataSource="@LayoutList"
                                                Width="114px"
                                                ValueChange="OnLayoutChanged" />
                            </div>
                        </div>
                    </div>

                    <!-- Column 3 -->
                    <div class="header-col header-col-price">
                        <div class="header-section">
                            <div class="header-section-title">Price Change</div>
                            <div class="field-row">
                                <label>By Dollar Value</label>
                                <NumericTextBoxControl TValue="decimal" @bind-Value="DollarChange" Format="C2" Width="84px"
                                                  Enabled="@(!IsReadOnly)"
                                                  ValueChange="OnDollarPriceChange" />
                            </div>
                            <div class="field-row">
                                <label>Percent Increase</label>
                                <NumericTextBoxControl TValue="decimal" @bind-Value="PercentIncrease" Format="N2"
                                                  Width="84px" Enabled="@(!IsReadOnly)"
                                                  ValueChange="OnPercentIncreaseChange" />
                            </div>
                            <div class="field-row">
                                <label>Percent Decrease</label>
                                <NumericTextBoxControl TValue="decimal" @bind-Value="PercentDecrease" Format="N2"
                                                  Width="84px" Enabled="@(!IsReadOnly)"
                                                  ValueChange="OnPercentDecreaseChange" />
                            </div>
                        </div>
                    </div>

                    <!-- Column 4 -->
                    <div class="header-col header-col-archive">
                        <div class="archive-row">
                            <CheckBoxControl @bind-Checked="IsArchived" Label="Archive this sheet"
                                        Disabled="@IsReadOnly" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Data Grid (VB6 name: gData) -->
            <div class="grid-container">
                <GridControl @ref="gData" TValue="WorksheetRow" DataSource="@WorksheetData"
                        AllowPaging="false" AllowSorting="true" AllowFiltering="true" AllowResizing="true"
                        AllowSelection="true" EnableHover="true"
                        ShowSelectionInfoBar="false"
                        RowHeight="17"
                        Height="@WorksheetGridHeight"
                        FilterSettingsRef="@worksheetFilterSettings"
                        SelectionSettingsRef="@worksheetSelectionSettings"
                        EditSettingsRef="@worksheetEditSettings"
                        BatchEditBehavior="GridBatchEditBehavior.SingleCell"
                        AllowSingleCellColumnMassEdit="true"
                        EventsRef="@worksheetEvents">

                    <GridColumnsBase @key="gDataLayoutVersion" DebugTag="FPricingWorkSheet-gData">
                        @if (gDataLayout.Count > 0)
                        {
                            @foreach (var col in GetOrderedGridLayout(gDataLayout))
                            {
                                var headerText = string.IsNullOrWhiteSpace(col.Caption) ? col.Field : col.Caption;
                                var width = col.Width.HasValue && col.Width.Value > 0
                                    ? $"{ConvertLayoutWidthToPx(col.Width.Value)}px" : null;
                                var colType = GetColumnTypeForField(col.Field);
                                var textAlign = GetTextAlignForField(col.Field);
                                var format = GetFormatForField(col.Field);
                                var allowEdit = GetAllowEditForField(col.Field);
                                var visible = !col.Hidden;

                                @if (IsNotesOrCommentsField(col.Field))
                                {
                                    @* Multi-line text (Description/Notes/Comments): the STANDARD FlexKit edit
                                       button (AlwaysShowEditButton) opens the text dialog via OnEditButtonClick
                                       → OnEditText. Replaces the hand-rolled span+✏️ template; the cell shows
                                       the value (Ellipsis-clipped) and OnEditText no-ops when read-only. *@
                                    <GridColumn Field="@col.Field" HeaderText="@headerText" Width="@(width ?? "150px")"
                                                  AllowEditing="false"
                                                  ShowEditButton="true" AlwaysShowEditButton="true"
                                                  Visible="@visible"
                                                  ClipMode="ClipMode.Ellipsis" />
                                }
                                else if (PickerButtonFields.Contains(col.Field))
                                {
                                    @* Lookup picker: the STANDARD FlexKit edit button (AlwaysShowEditButton, gated
                                       per-row by IsCellEditable) opens FPickList via OnEditButtonClick →
                                       OnLookupButton. Replaces the hand-rolled div/span/button template; the cell
                                       shows the value (same raw property GetLookupDisplay returned), Ellipsis-clipped. *@
                                    <GridColumn Field="@col.Field" HeaderText="@headerText" Width="@width"
                                                  Type="@colType" TextAlign="@textAlign"
                                                  Format="@format" AllowEditing="false"
                                                  AllowCellDragSelection="true"
                                                  ShowEditButton="true" AlwaysShowEditButton="true"
                                                  ShowEditButtonPredicate="@(o => IsCellEditable((WorksheetRow)o, col.Field))"
                                                  Visible="@visible"
                                                  ClipMode="ClipMode.Ellipsis" />
                                }
                                else
                                {
                                    @* VB6 gData_BeforeEdit sets .ComboList ("|..." / "...")
                                       on lookup columns so a "…" ComboButton appears on the
                                       ACTIVE edit cell — not a permanent per-row button.
                                       ShowEditButton drives that FlexKit behavior; clicking
                                       the … raises OnEditButtonClick → OnLookupButton →
                                       FPickList (gData_CellButtonClick parity). *@
                                    <GridColumn Field="@col.Field" HeaderText="@headerText" Width="@width"
                                                  Type="@colType" TextAlign="@textAlign"
                                                  Format="@format" AllowEditing="@(allowEdit && !IsReadOnly)"
                                                  ShowEditButton="@(LookupFields.Contains(col.Field) && !PickerButtonFields.Contains(col.Field))"
                                                  Visible="@visible"
                                                  ClipMode="ClipMode.Ellipsis" />
                                }
                            }
                        }
                    </GridColumnsBase>
                </GridControl>
           </div>
</div>

<!-- Text Edit Dialog -->
<DialogControl @bind-Visible="IsTextDialogVisible" Width="550px" Header="@TextDialogTitle"
          IsModal="true" ShowCloseIcon="true" CloseOnEscape="true">
    <ChildContent>
        <TextAreaControl @bind-Value="EditingText" Rows="6" Placeholder="Enter text..." CssClass="dialog-textarea" />
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="OnTextDialogOk">OK</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="@(() => IsTextDialogVisible = false)">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

<!-- Add Assembly Dialog -->
<DialogControl @bind-Visible="IsAddDialogVisible" Width="600px" Header="Add Assembly to Worksheet"
          IsModal="true" ShowCloseIcon="true" CloseOnEscape="true">
    <ChildContent>
        <div class="mb-3">
            <label class="form-label">@CommunityLabel:</label>
            <DropDownListControl TValue="string" TItem="CommunityItem"
                            @bind-Value="AddCommunity"
                            DataSource="@CommunityList"
                            TextFieldName="Description" ValueFieldName="Area"
                            Placeholder="Select" />
        </div>
        <div class="mb-3">
            <label class="form-label">Model:</label>
            <DropDownListControl TValue="string" TItem="ModelItem"
                            @bind-Value="AddModel"
                            DataSource="@ModelList"
                            TextFieldName="Description" ValueFieldName="Model"
                            Placeholder="Select"
                            ValueChange="OnAddModelChanged" />
        </div>
        <div class="mb-3">
            <label class="form-label">Assembly:</label>
            <DropDownListControl TValue="string" TItem="AssemblyItem"
                            @bind-Value="AddAssemblyValue"
                            DataSource="@AssemblyList"
                            TextFieldName="Description" ValueFieldName="Assembly"
                            Placeholder="Select" />
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="OnAddAssemblyConfirm">Add</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="@(() => IsAddDialogVisible = false)">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

<!-- SaveAs Dialog -->
<DialogControl @bind-Visible="IsSaveAsDialogVisible" Width="450px" Header="Save Worksheet As"
          IsModal="true" ShowCloseIcon="true" CloseOnEscape="true">
    <ChildContent>
        <div class="mb-3">
            <label class="form-label">New Description:</label>
            <TextBoxControl @bind-Value="SaveAsDescription" MaxLength="50" Placeholder="New worksheet name" CssClass="dialog-input" />
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="OnSaveAsConfirm">Save</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="@(() => IsSaveAsDialogVisible = false)">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@* ── Pick List (VB6: FMain → FPickList.Choose before opening FPricingWorksheet) ─── *@
<FPickList @ref="pickList" OnSelected="OnPickListSelected" OnCancel="OnPickListCancelled" />

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    // VB6 MDI child title: FlexKit MdiHost provides a per-pane "SetPageTitle"
    // Action<string> cascade (MdiHost.razor:33). Calling it renames THIS worksheet's
    // tab so each open worksheet shows its own id -- distinct tabs, and you can tell
    // which worksheet a tab holds.
    [CascadingParameter(Name = "SetPageTitle")]
    private Action<string>? SetPageTitle { get; set; }

    /// <summary>Rename this MDI tab to reflect the current worksheet. Saved sheets
    /// show "Pricing Worksheet {id}"; an unsaved sheet shows "(New)".</summary>
    private void UpdateWindowTitle()
    {
        var title = WorksheetId > 0
            ? $"Pricing Worksheet {WorksheetId}"
            : "Pricing Worksheet (New)";
        SetPageTitle?.Invoke(title);
    }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    // === Route Parameters ===
    [Parameter] public int WorksheetId { get; set; } = 80;
    [Parameter] public string ViewMode { get; set; } = "Estimating";

    // MDI multi-window route param (VB6 "Set f = New FPricingWorksheet").
    // A bare /pricing-worksheet opens a fresh window that prompts the worksheet
    // picklist; once a worksheet is chosen (or saved-as), SyncWorksheetRouteState()
    // publishes /pricing-worksheet/{id} so the tab gets a unique MDI key and
    // re-opening the SAME worksheet re-focuses its existing tab instead of
    // duplicating. Mirrors FAssembly's /edit-model-assembly + SyncAssemblyRouteState.
    // REQUIRES the matching FMain.InferParameterName arm
    //   "/pricing-worksheet" => "WorksheetIdParam"
    // in BOTH apps' FMain — without it FMain infers the default "Id" param,
    // which this page doesn't have, and the circuit crashes on render.
    [Parameter] public string? WorksheetIdParam { get; set; }

    // === Database ===    private int activeTab = 1;

    // === UI State ===
    private bool IsLoading = false;
    private bool mDirty = false;
    private bool IsReadOnly = false;
    private bool ShowExportMenu = false;
    private GridControl<WorksheetRow>? gData;
    private FPickList? pickList;
    private string _pickListContext = "";

    // === Grid Layout (IniGetGrid pattern) — via the shared GridLayoutPresenter ===
    // The load/width boilerplate lives in GridLayoutPresenter<WorksheetRow>; only the
    // VB6 form/grid NAME strings stay here (fidelity, passed to the ctor). The members
    // gDataLayout / gDataLayoutVersion below are now thin delegations onto the presenter,
    // so the markup and the rest of this file are unchanged. This grid's runtime-dynamic
    // instanceKey (WorksheetView+SelectedLayout), its hand-built BuildDefaultGridLayout
    // empty-result fallback (NOT the service default-user layout), its hashset-driven
    // GetColumnTypeForField (bool→CheckBox, no reflection), and its dict-parameter
    // GetOrderedGridLayout (no Hidden filter) remain form-specific and are KEPT verbatim
    // below — they are intentionally NOT the presenter's reflection equivalents.
    private readonly GridLayoutPresenter<WorksheetRow> _g = new(FormName, GridName);

    private Dictionary<string, GridLayoutColumn> gDataLayout => _g.Layout;
    private int gDataLayoutVersion => _g.Version;

    // === Worksheet Properties ===
    private string WorksheetView = "Estimating";
    private WorksheetTypes WorksheetType = WorksheetTypes.General;
    private string WorksheetDescription = "New Worksheet";
    private int CostBasisType = 0;
    private DateTime CostsEffectiveDate = DateTime.Now;
    private DateTime? SalesEffectiveDate = null;
    private decimal RoundTo = 0;
    private decimal IncentiveCostPercent = 0;
    private decimal DollarChange = 0;
    private decimal PercentIncrease = 0;
    private decimal PercentDecrease = 0;
    private bool IsArchived = false;
    private string SelectedLayout = "General";
    private string CommunityLabel = "Community";
    private bool ShowIncludeTax = false;
    private bool ShowCostsButton = true;
    private bool IncentiveCostEnabled = true;
    private bool MaxVendorPricing = false;
    // VB6 HFApp.Options(LockPostedSalesWorksheets): when ON, a worksheet that has
    // been published to sales (SalesEffectiveDate set) becomes read-only. Default
    // OFF (VB6 default) so published worksheets stay editable. Wire to the real
    // app-options load when SPW gains an options service.
    private bool LockPostedSalesWorksheets = false;
    private decimal TaxRate = 0;

    // === Data Sources ===
    private List<WorksheetRow> WorksheetData = new();
    private List<CostBasisItem> CostBasisList = new();
    private List<string> LayoutList = new() { "General", "Detailed", "Summary" };
    private List<LegendItem> LegendItems = new();
    private List<CommunityItem> CommunityList = new();
    private List<ModelItem> ModelList = new();
    private List<AssemblyItem> AssemblyList = new();
    // VB6 gData_CellButtonClick "Category" picker source (tblCategories).
    private List<CategoryItem> CategoryList = new();

    // === Selection ===
    private WorksheetRow? SelectedRow;

    // === Dialog State ===
    private bool IsTextDialogVisible = false;
    private string TextDialogTitle = "";
    private string EditingText = "";
    private WorksheetRow? EditingTextRow;
    private string EditingTextField = "";
    private bool IsAddDialogVisible = false;
    private string AddCommunity = "";
    private string AddModel = "";
    private string AddAssemblyValue = "";
    private bool IsSaveAsDialogVisible = false;
    private string SaveAsDescription = "";

    // === Grid Settings ===
    private readonly FilterSettings worksheetFilterSettings = new() { Type = FilterType.FilterBar };
    // VB6 grid fills all remaining form height (no pager). Subtract the
    // toolbar + header-panel + page chrome (~320px) from the viewport so the
    // grid's own vertical scrollbar handles overflow instead of a pager.
    private const string WorksheetGridHeight = "calc(100vh - 320px)";
    // VB6 gData edits ONE cell at a time, selected by mouse click/drag
    // (not a whole row like FAssembly gItems). Mirror FTakeoff: cell-level
    // selection, multi-select with toggle so a drag across several rows in
    // one column fans an edit out to all of them (VB6 .Row To .RowSel loop).
    private readonly SelectionSettings worksheetSelectionSettings = new()
    {
        Type = SelectionType.Multiple,
        Mode = SelectionMode.Cell,
        EnableToggle = true
    };
    private readonly EditSettings worksheetEditSettings = new()
    {
        AllowAdding = true,
        AllowEditing = true,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch
    };
    private readonly GridControlEvents<WorksheetRow> worksheetEvents = new();

    // === Column classification sets (VB6 NewColumns, PublishedColumns) ===
    private static readonly HashSet<string> NumericFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "FloorArea", "Bedrooms", "Bathrooms", "ConstCutOff", "LandCost", "ConstructionCost",
        "IncentiveCost", "IncentiveRetail", "Cost", "Pretax", "Tax", "Total", "Profit",
        "Markup", "Margin", "RoundTo", "COPretax", "COTax", "COTotal", "COMarkup", "COMargin",
        "CostPerFt", "PricePerFt", "Qty",
        "PublishedPretax", "PublishedTax", "PublishedPrice", "PublishedProfit",
        "PublishedMarkup", "PublishedMargin", "PublishedCOPrice", "PublishedIncentive"
    };

    private static readonly HashSet<string> CurrencyFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "LandCost", "ConstructionCost", "IncentiveCost", "Cost",
        "Pretax", "Tax", "Total", "Profit", "COPretax", "COTax", "COTotal",
        "CostPerFt", "PricePerFt", "ConstCutOff",
        "PublishedPretax", "PublishedTax", "PublishedPrice", "PublishedProfit",
        "PublishedCOPrice", "PublishedIncentive"
    };

    private static readonly HashSet<string> PercentFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "Markup", "Margin", "COMarkup", "COMargin", "PublishedMarkup", "PublishedMargin",
        // The editable "Incentive" column (IncentiveRetail) is a rate/number, not a
        // dollar amount — display it as a plain N2 number (no "$"), same family as
        // Markup/Margin. User directive 2026-05-31. IncentiveCost stays currency.
        "IncentiveRetail"
    };

    private static readonly HashSet<string> CheckboxFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "IncludedOption", "Inactive", "ReadyToPublish", "IncludeTax", "InSpec"
    };

    private static readonly HashSet<string> ReadOnlyFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "Community", "CommunityPhase", "Model", "Assembly", "ModelDescription", "Elevation",
        "OptionID", "CategoryDesc", "ConstructionCost", "IncentiveCost", "Cost", "Tax",
        "Total", "COTax", "COTotal", "Profit", "CostPerFt", "PricePerFt",
        "PublishedPretax", "PublishedTax", "PublishedPrice", "PublishedProfit",
        "PublishedMarkup", "PublishedMargin", "PublishedCOPrice", "PublishedIncentive",
        "RowState"
    };

    // ── Editable column map (VB6 gData_BeforeEdit parity) ───────────────
    // VB6 decides editability per (column, row AssemblyType). The four sets
    // below mirror the Select Case in gData_BeforeEdit:
    //   • AlwaysEditable      — editable on every row regardless of type
    //   • NonModelEditable    — VB6 `Cancel = t = atModel`  (edit when NOT a Model row)
    //   • ModelOnlyEditable   — VB6 `Cancel = t <> atModel` (edit ONLY on Model rows)
    //   • DesignCenterOnly    — VB6 `Cancel = t <> atDesignCenter`
    // Anything not in a set is read-only (VB6 `Case Else: Cancel = True`).
    private static readonly HashSet<string> AlwaysEditableFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "Community", "CommunityDesc", "CommunityPhase", "Color", "AssemblyUOM",
        "Comments", "Notes", "Description",
        "Profit", "Margin", "Markup", "RoundTo", "IncludeTax",
        "Pretax", "Total", "IncludedOption", "Qty", "Inactive"
    };
    private static readonly HashSet<string> NonModelEditableFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "Location", "Category", "CategoryDesc", "ConstCutOff", "JCExtra",
        "COPretax", "COTotal", "COMargin", "COMarkup"
    };
    private static readonly HashSet<string> ModelOnlyEditableFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "FloorArea", "Style", "Bedrooms", "Bathrooms", "IncentiveRetail", "LandCost"
    };
    private static readonly HashSet<string> DesignCenterOnlyFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "InSpec"
    };

    // Columns whose cell editor is a FlexKit dropdown rather than the grid's
    // built-in text box (VB6 ComboList / picklist). Limited to the four with
    // loaded lookup lists (CommunityList / CategoryList) — Community &
    // CommunityDesc share the community picker, Category & CategoryDesc share
    // the category picker, each setting both code + description on pick (VB6
    // gData_CellButtonClick parity). Location / ConstCutOff / Style /
    // AssemblyUOM remain editable via the built-in text editor for now.
    // VB6 gData_CellButtonClick columns: each shows a "…" button that opens
    // FPickList. ConstCutOff/Style are intentionally NOT here — ConstCutOff is
    // a decimal in the model (VB6 stored a Job_Status string in it; treating it
    // as a free-numeric batch-edit cell avoids a type mismatch) and VB6's Style
    // picker passes an empty query. Everything here resolves to a string column.
    private static readonly HashSet<string> LookupFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "Location", "Community", "CommunityDesc", "CommunityPhase",
        "Category", "CategoryDesc", "Series", "AssemblyUOM"
    };
    private static readonly HashSet<string> PickerButtonFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "CommunityDesc", "CategoryDesc", "Category"
    };
    private static readonly HashSet<string> MultiLineEditFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "Description", "Notes", "Comments"
    };

    // ── Zero-suppression (VB6 parity) ───────────────────────────────────
    // The VB6 MSFlexGrid uses the "#,###.##" mask on its computed/read-only
    // money columns (see FPricingWorksheet.frx) — the "#" placeholder renders
    // a 0 / NULL value as a BLANK cell, not "$0.00". These are the columns
    // that should blank-on-zero. Editable inputs (Incentive*, Pretax, Markup,
    // Margin, Qty, RoundTo, etc.) keep showing 0 so the user can see and edit
    // the value — matching ScreenShot1 where the Incentive column shows ".00".
    private static readonly HashSet<string> BlankOnZeroFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "Cost", "Tax", "Total", "Profit", "COTax", "COTotal", "ConstructionCost",
        "CostPerFt", "PricePerFt",
        "PublishedPretax", "PublishedTax", "PublishedPrice", "PublishedProfit",
        "PublishedMarkup", "PublishedMargin", "PublishedCOPrice", "PublishedIncentive"
    };

    // === Enums ===
    public enum WorksheetTypes
    {
        General = 0,
        DesignCenter = 1
    }

    // === Lifecycle ===
    // VB6 flow: FMain shows FPickList.Choose first, user selects a worksheet,
    //   then FPricingWorksheet opens with that worksheet ID.
    //   Blazor equivalent: page loads → picklist opens automatically →
    //   user picks a worksheet → data loads.
    private bool _pickListShown = false;

    protected override async Task OnInitializedAsync()
    {
        // Wire events
        worksheetEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<WorksheetRow>>(this, OnRowSelected);
        worksheetEvents.RowDeselected = EventCallback.Factory.Create<RowSelectEventArgs<WorksheetRow>>(this, OnRowDeselected);
        worksheetEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<WorksheetRow>>(this, OnCellSaved);
        worksheetEvents.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<WorksheetRow>>(this, OnCellEditStart);
        worksheetEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<WorksheetRow>>(this, OnGridEditButtonClick);
        worksheetEvents.QueryCellInfo = EventCallback.Factory.Create<QueryCellInfoEventArgs<WorksheetRow>>(this, OnQueryCellInfo);

        WorksheetId = 0;
        WorksheetView = ViewMode ?? "Estimating";
        InitializeCostBasis();
        await LoadCostBasisForecastsAsync();   // VB6 MMain.LoadCostTypes — append Forecast 1..12
        InitializeLegend();
        await LoadLookupDataAsync();
        await LoadGridLayouts();

        // MDI deep-link: FMain hands a re-focused / restored window the
        // /pricing-worksheet/{id} route. When an id is supplied, open THAT
        // worksheet directly and skip the picklist (parity with FAssembly
        // opening /edit-model-assembly/{Id}). A bare /pricing-worksheet (no id)
        // falls through to the picklist in OnAfterRenderAsync.
        if (int.TryParse(WorksheetIdParam, out var deepLinkId) && deepLinkId > 0)
        {
            WorksheetId = deepLinkId;
            _pickListShown = true;          // suppress the auto-picklist
            await LoadDataAsync();
        }
        // Otherwise don't load data yet — wait for the picklist pick.
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_pickListShown)
        {
            _pickListShown = true;
            await ShowWorksheetPickList();
        }
    }

    /// <summary>VB6-parity MDI window keying (mirror of FAssembly's
    /// SyncAssemblyRouteState). Publishes /pricing-worksheet/{WorksheetId} to
    /// FMain so each open worksheet owns a distinct MDI window: a second
    /// "Sales Pricing Worksheet" menu open spawns a fresh window (the bare route
    /// is in FMain._alwaysFreshRoutes) with its own picklist, while re-opening
    /// THIS worksheet re-focuses this tab. WorksheetId == 0 (not yet chosen) is
    /// left untouched so the picklist window keeps the bare route.</summary>
    private void SyncWorksheetRouteState()
    {
        UpdateWindowTitle();
        if (WorksheetId <= 0) return;
        var target = $"/pricing-worksheet/{WorksheetId}";
        if (ParentNavigate != null)
        {
            ParentNavigate(target);
        }
        else
        {
            var current = new Uri(NavigationManager.Uri).PathAndQuery;
            if (!string.Equals(current, target, StringComparison.Ordinal))
                NavigationManager.NavigateTo(target, replace: true);
        }
    }

    // === Grid Layout Loading (IniGetGrid pattern — VB6: Call IniGetGrid(Me, gData, , , mWorksheetView & cboLayouts.Text)) ===
    private const string FormName = "FPricingWorkSheet";
    private const string GridName = "gData";

    private async Task LoadGridLayouts()
    {
        // instanceKey is runtime-dynamic (WorksheetView + the chosen Layout) — VB6
        // IniGetGrid(Me, gData, , , mWorksheetView & cboLayouts.Text). The two
        // candidates reproduce the EXACT prior calls byte-for-byte: the presenter
        // builds the AppGridLayout tag from form+grid+gridIndex(0)+instanceKey, so
        //   1. (GridName, 0, instanceKey) → tag "FPricingWorkSheet.gData.{view}{layout}"
        //   2. (GridName, 0, null)        → tag "FPricingWorkSheet.gData"  (the VB6 (0) fallback)
        var instanceKey = WorksheetView + SelectedLayout;
        await _g.LoadAsync(GridLayoutSvc,
            (GridName, 0, instanceKey),
            (GridName, 0, (string?)null));

        // VB6 parity: the MSFlexGrid is defined at design time with a fixed
        // column set, and IniGetGrid only OVERLAYS the user's saved
        // width/order/hidden from AppGridLayout on top of that base. When no
        // AppGridLayout rows exist for FPricingWorkSheet.gData (the common
        // case — they were never seeded), fall back to the canonical
        // design-time column set built in code so the grid still renders with
        // its editable cells + lookup buttons. Without this, the page used to
        // drop into a dead hard-coded <GridColumn> branch that had no edit
        // gating and no … pickers — i.e. "nothing editable". This is exactly
        // what SetLayout is for (a hand-built default, NOT the service's
        // default-user layout). SetLayout bumps Version, as LoadAsync already did.
        if (!_g.Has)
            _g.SetLayout(BuildDefaultGridLayout());
    }

    // KEPT VERBATIM (not a presenter equivalent): the presenter's empty-result
    // fallback is the service default-user layout; this form's fallback is instead
    // the full VB6 design-time column set, fed in via _g.SetLayout above.
    /// <summary>Canonical VB6 design-time column set for gData (mirrors the
    /// column list FPricingWorksheet.frm declares + VisibleColumns()).
    /// Used only when AppGridLayout has no saved rows. Width is stored in the
    /// same twips unit AppGridLayout uses, so <see cref="ConvertLayoutWidthToPx"/>
    /// renders the intended pixel widths. Hidden mirrors the VB6
    /// VisibleColumns() filter for the current WorksheetView. Editability and
    /// lookup-button behavior come from the VB6-parity field sets
    /// (GetAllowEditForField / LookupFields / IsCellEditable), NOT from here —
    /// exactly as FAssembly drives gItems through ApplyVB6EditableColumnGates.</summary>
    private Dictionary<string, GridLayoutColumn> BuildDefaultGridLayout()
    {
        var est = WorksheetView == "Estimating";
        // (Field, Caption, px, Hidden) — order = VB6 design-time column order.
        // px is converted to the AppGridLayout twips unit below.
        var defs = new List<(string Field, string Caption, int Px, bool Hidden)>
        {
            ("Community",        CommunityLabel,               100, true),
            ("CommunityPhase",   CommunityLabel + " Phase",     90, true),
            ("Model",            "Model",                      100, false),
            ("Assembly",         "Assembly",                   120, false),
            ("ModelDescription", "Model Desc",                 150, !est),
            ("Elevation",        "Elevation",                   90, true),
            ("OptionID",         "Option",                     100, true),
            ("Description",      "Description",                200, false),
            ("Category",         "Category",                    90, false),
            ("CategoryDesc",     "Category Desc",              120, false),
            ("IncludedOption",   "Included",                    80, false),
            ("Inactive",         "Inactive",                    75, false),
            ("ReadyToPublish",   "Ready",                       70, true),
            ("Series",           "Series",                      90, true),
            ("FloorArea",        "Floor Area",                  90, true),
            ("Bedrooms",         "Beds",                        60, true),
            ("Bathrooms",        "Baths",                       60, true),
            ("Style",            "Style",                       80, true),
            ("ConstCutOff",      "Const Cutoff",               100, true),
            ("LandCost",         "Land Cost",                  100, true),
            ("ConstructionCost", "Const Cost",                 100, true),
            ("IncentiveCost",    "Incent Cost",                100, true),
            ("Cost",             "Total Cost",                 100, false),
            ("CostPerFt",        "Cost/SqFt",                   90, false),
            ("Pretax",           "Pretax",                     100, false),
            ("Tax",              "Tax",                         80, false),
            ("Total",            "Total",                      100, false),
            ("Profit",           "Profit",                      90, false),
            ("Markup",           "Markup %",                    85, false),
            ("Margin",           "Margin %",                    85, false),
            ("InSpec",           "In Spec",                     70, true),
            ("IncentiveRetail",  "Incent Retail",              100, true),
            ("COPretax",         "CO Pretax",                  100, false),
            ("COTax",            "CO Tax",                      80, false),
            ("COTotal",          "CO Total",                   100, false),
            ("COMarkup",         "CO Markup %",                 95, false),
            ("COMargin",         "CO Margin %",                 95, true),
            ("PublishedPretax",  "Pub Pretax",                 100, true),
            ("PublishedTax",     "Pub Tax",                     80, true),
            ("PublishedPrice",   "Pub Price",                  100, true),
            ("PublishedProfit",  "Pub Profit",                  95, true),
            ("PublishedMarkup",  "Pub Markup %",               100, true),
            ("PublishedMargin",  "Pub Margin %",               100, true),
            ("PublishedCOPrice", "Pub CO Price",               100, true),
            ("PublishedIncentive","Pub Incentive",             100, true),
            ("PricePerFt",       "Price/SqFt",                  90, false),
            ("RoundTo",          "Round To",                    80, false),
            ("AssemblyUOM",      "UOM",                         70, true),
            ("Color",            "Color",                       90, true),
            ("Location",         "Location",                    90, true),
            ("Qty",              "Qty",                         60, true),
            ("Notes",            "Notes",                      150, !est),
            ("Comments",         "Comments",                   150, !est),
            ("JCExtra",          "JC Extra",                    90, true),
            ("IncludeTax",       "Tax Incl",                    75, !ShowIncludeTax),
        };

        var dict = new Dictionary<string, GridLayoutColumn>(StringComparer.OrdinalIgnoreCase);
        var colIndex = 0;
        foreach (var (field, caption, px, hidden) in defs)
        {
            dict[field] = new GridLayoutColumn
            {
                Field = field,
                Caption = caption,
                Width = (px - 16) * 15,   // px → AppGridLayout twips (inverse of ConvertLayoutWidthToPx)
