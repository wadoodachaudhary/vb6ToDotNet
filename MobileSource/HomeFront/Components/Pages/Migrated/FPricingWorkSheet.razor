    private void OnPercentIncreaseChange(HfNumericTextBox<decimal>.NumericChangeEventArgs<decimal> args)
    {
        if (PercentIncrease == 0) return;
        foreach (var row in WorksheetData.Where(r => !r.Inactive))
        {
            row.Pretax *= (1 + PercentIncrease / 100m);
            CalcData(row, "pretax");
            row.RowState = "DIRTY";
        }
        PercentIncrease = 0;
        mDirty = true;
        StateHasChanged();
    }

    private void OnPercentDecreaseChange(HfNumericTextBox<decimal>.NumericChangeEventArgs<decimal> args)
    {
        if (PercentDecrease == 0) return;
        foreach (var row in WorksheetData.Where(r => !r.Inactive))
        {
            row.Pretax *= (1 - PercentDecrease / 100m);
            CalcData(row, "pretax");
            row.RowState = "DIRTY";
        }
        PercentDecrease = 0;
        mDirty = true;
        StateHasChanged();
    }

    // VB6: txtIncentiveCostPercent_Validate
    private void OnIncentiveCostPercentChange(HfNumericTextBox<decimal>.NumericChangeEventArgs<decimal> args)
    {
        foreach (var row in WorksheetData.Where(r => !r.Inactive))
        {
            row.IncentiveCost = row.ConstructionCost * IncentiveCostPercent / 100m;
            row.Cost = row.ConstructionCost + row.LandCost + row.IncentiveCost;
            CalcData(row);
            row.RowState = "DIRTY";
        }
        mDirty = true;
        StateHasChanged();
    }

    // VB6: txtRoundTo_Validate
    private void OnRoundToChange(HfNumericTextBox<decimal>.NumericChangeEventArgs<decimal> args)
    {
        if (RoundTo <= 0) return;
        foreach (var row in WorksheetData.Where(r => !r.Inactive))
        {
            if (row.Pretax > 0)
            {
                row.Pretax = Math.Round(row.Pretax / RoundTo) * RoundTo;
                CalcData(row, "pretax");
                row.RowState = "DIRTY";
            }
        }
        mDirty = true;
        StateHasChanged();
    }

    // === Save Data ===
    private async Task<bool> SaveDataAsync()
    {
        if (!mDirty) return true;

        // VB6: ValidateForm
        if (!ValidateForm()) return false;

        IsLoading = true;
        StateHasChanged();
        try
        {
            // Update master
            await db.ExecuteAsync($@"
                UPDATE tblSalesSheetMaster SET
                    Description=@Description, CostBasisType=@CostBasisType,
                    IncentiveCostPercent=@IncentiveCostPercent, Inactive=@Inactive
                WHERE Worksheet={WorksheetId}",
                new { Description = WorksheetDescription, CostBasisType, IncentiveCostPercent, Inactive = IsArchived });

            // Update dirty details
            foreach (var row in WorksheetData.Where(r => r.RowState == "DIRTY"))
            {
                await db.ExecuteAsync($@"
                    UPDATE tblSalesSheetDetails SET
                        Description=@Description, Notes=@Notes, Comments=@Comments, Category=@Category,
                        Series=@Series, Style=@Style, FloorArea=@FloorArea, Bedrooms=@Bedrooms, Bathrooms=@Bathrooms,
                        LandCost=@LandCost, Pretax=@Pretax, Tax=@Tax, Markup=@Markup, Margin=@Margin, Roundto=@RoundTo,
                        COPretax=@COPretax, COTax=@COTax, COMarkup=@COMarkup, Qty=@Qty, Color=@Color, Location=@Location,
                        IncludedOption=@IncludedOption, Inactive=@Inactive, ReadyToPublish=@ReadyToPublish,
                        IncludeTax=@IncludeTax, IncludedInSpec=@InSpec, IncentiveRetail=@IncentiveRetail
                    WHERE Worksheet={WorksheetId} AND Community=@Community AND Assembly=@Assembly AND ISNULL(OptionID,'')=@OptionID",
                    new
                    {
                        row.Description, row.Notes, row.Comments, row.Category, row.Series, row.Style,
                        row.FloorArea, row.Bedrooms, row.Bathrooms, row.LandCost, row.Pretax, row.Tax,
                        row.Markup, row.Margin, row.RoundTo, row.COPretax, row.COTax, row.COMarkup,
                        row.Qty, row.Color, row.Location, row.IncludedOption, row.Inactive, row.ReadyToPublish,
                        row.IncludeTax, row.InSpec, row.IncentiveRetail, row.Community, row.Assembly,
                        OptionID = row.OptionID ?? ""
                    });
                row.RowState = "CLEAN";
            }
            mDirty = false;
            await JSRuntime.InvokeVoidAsync("alert", "Worksheet saved successfully.");
            return true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // VB6: ValidateForm — check for duplicate assemblies
    private bool ValidateForm()
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var row in WorksheetData)
        {
            var key = $"{row.Community}|{row.CommunityPhase}|{row.Model}|{row.Series}|{row.OptionID}|{row.Assembly}";
            if (!seen.Add(key))
            {
                JSRuntime.InvokeVoidAsync("alert", $"Duplicate assembly found: {row.Assembly} in model {row.Model}");
                return false;
            }
        }
        return true;
    }

