    // === Text Edit ===
    private void OnEditText(WorksheetRow? row, string colField)
    {
        if (row == null || IsReadOnly) return;
        EditingTextRow = row;
        EditingTextField = colField;
        EditingText = GetMultiLineValue(row, colField);
        TextDialogTitle = $"Edit {colField}";
        IsTextDialogVisible = true;
    }

    private void OnTextDialogOk()
    {
        if (EditingTextRow != null)
        {
            if (EditingTextField.Equals("Notes", StringComparison.OrdinalIgnoreCase))
                EditingTextRow.Notes = EditingText;
            else if (EditingTextField.Equals("Description", StringComparison.OrdinalIgnoreCase))
                EditingTextRow.Description = EditingText;
            else
                EditingTextRow.Comments = EditingText;
            EditingTextRow.RowState = "DIRTY";
            mDirty = true;
        }
        IsTextDialogVisible = false;
        StateHasChanged();
    }

    // === Add Assembly ===
    private async Task OnAddModelChanged(DropDownListControl<string, ModelItem>.ChangeEventArgs<string, ModelItem> args)
    {
        if (string.IsNullOrEmpty(args.Value))
        {
            AssemblyList.Clear();
            return;
        }
        var assemblies = await Db.QueryAsync(
            $"SELECT Assembly, Description FROM tblDBAssemblyMaster WHERE DivisionID ={SessionState.DivisionID} AND Model='{args.Value}' ORDER BY Assembly");
        AssemblyList = assemblies.Select(r => new AssemblyItem
        {
            Assembly = r["Assembly"]?.ToString() ?? "",
            Description = $"{r["Assembly"]} - {r["Description"]}"
        }).ToList();
    }

    // VB6: AddAssemblyToGridOLD — full implementation
    private async Task OnAddAssemblyConfirm()
    {
        if (string.IsNullOrEmpty(AddCommunity) || string.IsNullOrEmpty(AddAssemblyValue))
        {
            Notifications.Info("Select Community and Assembly.");
            return;
        }

        // Check for duplicate
        if (WorksheetData.Any(r => r.Community == AddCommunity && r.Assembly == AddAssemblyValue && r.Model == AddModel))
        {
            Notifications.Info("This assembly is already in the worksheet.");
            return;
        }

        IsAddDialogVisible = false;
        try
        {
            // Load assembly details from database
            var asmRows = await Db.QueryAsync(
                $@"SELECT a.*, c.Description AS CategoryDesc
                   FROM tblDBAssemblyMaster a
                   LEFT JOIN tblCategories c ON a.Category = c.Category
                   WHERE a.DivisionID={SessionState.DivisionID} AND a.Assembly='{AddAssemblyValue}' AND a.Model='{AddModel}'");

            var newRow = new WorksheetRow
            {
                Community = AddCommunity,
                CommunityPhase = "",
                SourceCommunity = AddCommunity,
                Assembly = AddAssemblyValue,
                Model = AddModel,
                RowState = "DIRTY"
            };

            if (asmRows.Any())
            {
                var a = asmRows.First();
                newRow.Description = a["Description"]?.ToString() ?? "";
                newRow.Category = a["Category"]?.ToString() ?? "";
                newRow.CategoryDesc = a["CategoryDesc"]?.ToString() ?? "";
                newRow.AssemblyUOM = a["AssemblyUOM"]?.ToString() ?? "";
                newRow.AssemblyType = SafeInt(a["AssemblyType"]);
                newRow.Series = a["Series"]?.ToString() ?? "";
                newRow.Style = a["Style"]?.ToString() ?? "";
                newRow.FloorArea = SafeInt(a["FloorArea"]);
                newRow.Bedrooms = SafeInt(a["Bedrooms"]);
                newRow.Bathrooms = SafeDecimal(a["Bathrooms"]);
                newRow.ModelDescription = a.ContainsKey("ModelDesc") ? a["ModelDesc"]?.ToString() ?? "" : "";
            }

            // Get pricing defaults from category
            var catRows = await Db.QueryAsync(
                $"SELECT ISNULL(DefaultMarkup,0) AS Markup, ISNULL(DefaultCOMarkup,0) AS COMarkup FROM tblCategories WHERE Category='{newRow.Category}'");
            if (catRows.Any())
            {
                var cat = catRows.First();
                newRow.Markup = SafeDecimal(cat["Markup"]);
                newRow.COMarkup = SafeDecimal(cat["COMarkup"]);
            }

            // Calculate cost
            newRow.IncentiveCost = newRow.ConstructionCost * IncentiveCostPercent / 100m;
            newRow.Cost = newRow.ConstructionCost + newRow.LandCost + newRow.IncentiveCost;

            // Calculate pretax from markup
            if (newRow.Cost > 0 && newRow.Markup > 0)
                newRow.Pretax = newRow.Cost * (1 + newRow.Markup / 100m);

            CalcData(newRow);

            // Insert to database
            await Db.ExecuteAsync($@"
                INSERT INTO tblSalesSheetDetails
                    (Worksheet, Community, CommunityPhase, SourceCommunity, Assembly, AssemblyUOM,
                     Model, Elevation, OptionID, AssemblyType, Description, Category, Series, Style,
                     FloorArea, Bedrooms, Bathrooms, LandCost, ConstructionCost, IncentiveCost,
                     IncentiveRetail, Cost, Pretax, Tax, Markup, Margin, COPretax, COTax, COMarkup, Qty)
                VALUES ({WorksheetId}, @Community, @CommunityPhase, @SourceCommunity, @Assembly, @AssemblyUOM,
                        @Model, '', '', @AssemblyType, @Description, @Category, @Series, @Style,
                        @FloorArea, @Bedrooms, @Bathrooms, @LandCost, @ConstructionCost, @IncentiveCost,
                        @IncentiveRetail, @Cost, @Pretax, @Tax, @Markup, @Margin, @COPretax, @COTax, @COMarkup, @Qty)",
                new
                {
                    newRow.Community, newRow.CommunityPhase, newRow.SourceCommunity, newRow.Assembly,
                    newRow.AssemblyUOM, newRow.Model, newRow.AssemblyType, newRow.Description,
                    newRow.Category, newRow.Series, newRow.Style, newRow.FloorArea, newRow.Bedrooms,
                    newRow.Bathrooms, newRow.LandCost, newRow.ConstructionCost, newRow.IncentiveCost,
                    newRow.IncentiveRetail, newRow.Cost, newRow.Pretax, newRow.Tax, newRow.Markup,
                    newRow.Margin, newRow.COPretax, newRow.COTax, newRow.COMarkup, newRow.Qty
                });

            newRow.RowState = "CLEAN";
            WorksheetData.Add(newRow);
            mDirty = false; // Just saved to DB
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Notifications.Error($"Add assembly error: {ex.Message}");
        }
    }

    // === Helpers ===
    private string TruncateText(string? text, int max) =>
        string.IsNullOrEmpty(text) ? "" : text.Length <= max ? text : text[..max] + "...";

    private int SafeInt(object? val, int def = 0) =>
        val != null && val != DBNull.Value && (val?.ToString() ?? "") != "" ? Convert.ToInt32(val) : def;

    private decimal SafeDecimal(object? val, decimal def = 0) =>
        val != null && val != DBNull.Value && (val?.ToString() ?? "") != "" ? Convert.ToDecimal(val) : def;

    private static string GetRowStr(IDictionary<string, object> row, string key) =>
        row.TryGetValue(key, out var v) ? v?.ToString() ?? "" : "";

    // ═══════════════════════════════════════════════════════════════════════
    // ── AddAssemblyToGrid (VB6: FPricingWorksheet.frm:2048) ──────────────
    // ═══════════════════════════════════════════════════════════════════════
    /// <summary>Looks up the assembly master record + category defaults and
    /// inserts a row into tblSalesSheetDetails + WorksheetData. Shared by
    /// the per-assembly and per-(assembly,community) callers in the two-step
    /// FPickList flow (OnPickListSelected "AddAssembly" / "AddAssemblyCommunities").
    /// VB6 (line 2048-…) takes the same 7-arg shape; we drop SourceCommunity
    /// because the call sites never set it differently from community.</summary>
    private async Task AddAssemblyToGridAsync(
        string community, string phase, string assembly,
        string model, string optionId, string series)
    {
        // Skip duplicates — VB6's gData_AfterEdit doesn't allow them either.
        if (WorksheetData.Any(r =>
                r.Community == community && r.CommunityPhase == phase
                && r.Assembly == assembly && r.Model == model
                && (r.OptionID ?? "") == optionId))
        {
            return;
        }

        try
        {
            var asmRows = await Db.QueryAsync(
                $@"SELECT a.*, c.Description AS CategoryDesc
                   FROM tblDBAssemblyMaster a
                   LEFT JOIN tblCategories c ON a.Category = c.Category
                   WHERE a.DivisionID = {SessionState.DivisionID}
                     AND ISNULL(a.Assembly,'') = @Assembly
                     AND ISNULL(a.Model,'')    = @Model
                     AND ISNULL(a.OptionID,'') = @OptionID",
                new { Assembly = assembly ?? "", Model = model ?? "", OptionID = optionId ?? "" });

            var newRow = new WorksheetRow
            {
                Community = community ?? "",
                CommunityPhase = phase ?? "",
                SourceCommunity = community ?? "",
                Assembly = assembly ?? "",
                Model = model ?? "",
                OptionID = optionId ?? "",
                Series = series ?? "",
                RowState = "DIRTY"
            };

            if (asmRows.Any())
            {
                var a = asmRows.First();
                newRow.Description     = a.ContainsKey("Description")     ? a["Description"]?.ToString() ?? "" : "";
                newRow.Category        = a.ContainsKey("Category")        ? a["Category"]?.ToString() ?? "" : "";
                newRow.CategoryDesc    = a.ContainsKey("CategoryDesc")    ? a["CategoryDesc"]?.ToString() ?? "" : "";
                newRow.AssemblyUOM     = a.ContainsKey("AssemblyUOM")     ? a["AssemblyUOM"]?.ToString() ?? "" : "";
                newRow.AssemblyType    = a.ContainsKey("AssemblyType")    ? SafeInt(a["AssemblyType"]) : 0;
                // VB6 AddAssemblyToGrid: SourceCommunity = the assembly MASTER's own
                // Community (m.Community SourceCommunity), NOT the selling community.
                // Purch_GetAssemblySalesSheetCost joins sd.SourceCommunity =
                // tbldbassemblydetails.community, so a mismatch here yields cost 0.
                // For a global model this is '' (matching the detail rows' '' community).
                newRow.SourceCommunity = a.ContainsKey("Community") ? a["Community"]?.ToString() ?? "" : "";
                if (string.IsNullOrEmpty(newRow.Series)
                    && a.ContainsKey("Series")) newRow.Series = a["Series"]?.ToString() ?? "";
                newRow.Style           = a.ContainsKey("Style")           ? a["Style"]?.ToString() ?? "" : "";
                newRow.FloorArea       = a.ContainsKey("FloorArea")       ? SafeInt(a["FloorArea"]) : 0;
                newRow.Bedrooms        = a.ContainsKey("Bedrooms")        ? SafeInt(a["Bedrooms"]) : 0;
                newRow.Bathrooms       = a.ContainsKey("Bathrooms")       ? SafeDecimal(a["Bathrooms"]) : 0;
                newRow.ModelDescription = a.ContainsKey("ModelDesc")      ? a["ModelDesc"]?.ToString() ?? "" : "";
            }

            // VB6 FPricingWorksheet.frm AddAssemblyToGrid: pricing fields come from the
            // assembly master record (m.Markup / m.Margin / m.Pretax / ...), NOT category
            // defaults -- Proposed Price (Pretax) is the master's value, so it stays 0
            // when the assembly carries no retail (matches VB6). a.* already SELECTed them.
            if (asmRows.Any())
            {
                var am = asmRows.First();
                newRow.Markup          = am.ContainsKey("Markup")          ? SafeDecimal(am["Markup"])          : 0;
                newRow.Margin          = am.ContainsKey("Margin")          ? SafeDecimal(am["Margin"])          : 0;
                newRow.RoundTo         = am.ContainsKey("Roundto")         ? SafeDecimal(am["Roundto"])         : 0;
                newRow.IncludeTax      = am.ContainsKey("IncludeTax")      && (am["IncludeTax"]?.ToString() == "True" || am["IncludeTax"]?.ToString() == "1");
                newRow.IncentiveRetail = am.ContainsKey("IncentiveRetail") ? SafeDecimal(am["IncentiveRetail"]) : 0;
                newRow.Pretax          = am.ContainsKey("Pretax")          ? SafeDecimal(am["Pretax"])          : 0;
                newRow.COMarkup        = am.ContainsKey("COMarkup")        ? SafeDecimal(am["COMarkup"])        : 0;
                newRow.COPretax        = am.ContainsKey("COPretax")        ? SafeDecimal(am["COPretax"])        : 0;
            }

            // VB6 AddAssemblyToGrid: CommunityDesc = tblLocality.Description (l.area = community).
            if (!string.IsNullOrEmpty(newRow.Community))
            {
                var locRows = await Db.QueryAsync(
                    "SELECT TOP 1 Description AS CommunityDesc FROM tblLocality WHERE area = @Area",
                    new { Area = newRow.Community });
                if (locRows.Any())
                    newRow.CommunityDesc = locRows.First()["CommunityDesc"]?.ToString() ?? "";
            }

            // VB6 AddAssembly calls SaveData(False) before RefreshCosts, so a brand-new
            // (unsaved) sheet gets a real Worksheet number first. Mirror that: persist
            // the master row now if this sheet has never been saved.
            if (WorksheetId <= 0)
                await EnsureWorksheetSavedAsync();

            // Insert the detail row FIRST. Purch_GetAssemblySalesSheetCost is an ACTION
            // proc: it UPDATEs cost/landcost/incentivecost/constructioncost on the
            // tblSalesSheetDetails row in place (no resultset), so the row must exist.
            await Db.ExecuteAsync($@"
                INSERT INTO tblSalesSheetDetails
                    (Worksheet, Community, CommunityPhase, SourceCommunity, Assembly, AssemblyUOM,
                     Model, Elevation, OptionID, AssemblyType, Description, Category, Series, Style,
                     FloorArea, Bedrooms, Bathrooms, LandCost, ConstructionCost, IncentiveCost,
                     IncentiveRetail, Cost, Pretax, Tax, Markup, Margin, COPretax, COTax, COMarkup, Qty)
                VALUES (@Worksheet, @Community, @CommunityPhase, @SourceCommunity, @Assembly, @AssemblyUOM,
                        @Model, @Elevation, @OptionID, @AssemblyType, @Description, @Category, @Series, @Style,
                        @FloorArea, @Bedrooms, @Bathrooms, @LandCost, @ConstructionCost, @IncentiveCost,
                        @IncentiveRetail, @Cost, @Pretax, @Tax, @Markup, @Margin, @COPretax, @COTax, @COMarkup, 1)",
                new
                {
                    Worksheet = WorksheetId,
                    newRow.Community, newRow.CommunityPhase, newRow.SourceCommunity,
                    newRow.Assembly, newRow.AssemblyUOM, newRow.Model, Elevation = "",
                    newRow.OptionID, newRow.AssemblyType, newRow.Description, newRow.Category,
                    newRow.Series, newRow.Style, newRow.FloorArea, newRow.Bedrooms, newRow.Bathrooms,
                    newRow.LandCost, newRow.ConstructionCost, newRow.IncentiveCost,
                    newRow.IncentiveRetail, newRow.Cost, newRow.Pretax, newRow.Tax,
                    newRow.Markup, newRow.Margin, newRow.COPretax, newRow.COTax, newRow.COMarkup
                });

            // VB6 RefreshCosts: EXEC the proc (computes & writes the real cost for this
            // Cost Basis into the row), then re-read the cost columns it produced.
            // Proc signature: (@SalesSheet, @Assembly, @Model, @OptionID, @Community, @CommunityPhase).
            await RefreshRowCostAsync(newRow);

            // VB6 CalcData(,"Cost",r): recompute Tax/Total/Profit/Markup/Margin from the
            // real Cost and the master Pretax (Markup=(Pretax-Cost)/Cost*100, etc.).
            CalcData(newRow, "cost");

            WorksheetData.Add(newRow);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AddAssemblyToGridAsync failed for {Community}/{Assembly}", community, assembly);
            Notifications.Error($"Failed to add {assembly}: {ex.Message}");
        }
    }

