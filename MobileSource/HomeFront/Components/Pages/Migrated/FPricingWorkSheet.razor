    // VB6: HFApp.RecordLockedBy — checks if a record is locked by another user
    private async Task<string> RecordLockedByAsync(string tableName, object recordKey)
    {
        try
        {
            var sql = $@"
                SELECT User_ID + ' on ' + Workstation_name
                FROM TableLog
                WHERE TableName = @TableName
                  AND RecordLocked = 1
                  AND KeyRecord = @KeyRecord";
            var result = await Db.ExecuteScalarAsync<string>(sql,
                new { TableName = tableName, KeyRecord = recordKey.ToString() });
            return result ?? "";
        }
        catch
        {
            return "";
        }
    }

