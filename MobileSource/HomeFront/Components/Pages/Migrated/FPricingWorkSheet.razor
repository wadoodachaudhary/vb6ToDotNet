    private WorksheetRow? _lookupRow;
    private string _lookupField = "";
    private readonly List<WorksheetRow> _lookupTargets = new();

    /// <summary>Cell display text for a lookup column (Community shows the area
    /// code, CommunityDesc the description, etc.).</summary>
    private static string GetLookupDisplay(WorksheetRow row, string field) => field switch
    {
        "Location"       => row.Location,
        "Community"      => row.Community,
        "CommunityDesc"  => row.CommunityDesc,
        "CommunityPhase" => row.CommunityPhase,
