    // VB6: RefreshCosts — queries assembly costs from stored procedure
    private async Task OnRefreshCostsClick()
    {
        if (IsReadOnly) return;
        if (!await Dialogs.ConfirmAsync("Refresh costs from estimating? This will update all cost fields."))
            return;

        IsLoading = true;
        StateHasChanged();
        try
        {
            foreach (var row in WorksheetData.Where(r => !r.Inactive))
            {
                // VB6 RefreshCosts: action proc writes the real cost for this Cost Basis
                // into the row; RefreshRowCostAsync re-reads it (correct proc params).
                await RefreshRowCostAsync(row);
                CalcData(row, "cost");
                row.RowState = "DIRTY";
            }
            mDirty = true;
            Notifications.Info("Costs refreshed.");
        }
        catch (Exception ex)
        {
            Notifications.Error($"Refresh costs error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // VB6: RefreshPublished — loads published prices from database
    private async Task OnRefreshPublishedClick()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            foreach (var row in WorksheetData)
            {
                var pubRows = await Db.QueryAsync(
                    $@"SELECT TOP 1 Pretax, Tax, Price, COPrice, Markup, Margin, Incentive
                       FROM tblPublishedPrices
                       WHERE DivisionID ={SessionState.DivisionID} AND Model='{row.Model}' AND Assembly='{row.Assembly}'
                       ORDER BY EffectiveDate DESC");
                if (pubRows.Any())
                {
                    var pr = pubRows.First();
                    row.PublishedPretax = SafeDecimal(pr.ContainsKey("Pretax") ? pr["Pretax"] : null);
                    row.PublishedTax = SafeDecimal(pr.ContainsKey("Tax") ? pr["Tax"] : null);
                    row.PublishedPrice = SafeDecimal(pr.ContainsKey("Price") ? pr["Price"] : null);
                    row.PublishedCOPrice = SafeDecimal(pr.ContainsKey("COPrice") ? pr["COPrice"] : null);
                    row.PublishedMarkup = SafeDecimal(pr.ContainsKey("Markup") ? pr["Markup"] : null);
                    row.PublishedMargin = SafeDecimal(pr.ContainsKey("Margin") ? pr["Margin"] : null);
                    row.PublishedIncentive = SafeDecimal(pr.ContainsKey("Incentive") ? pr["Incentive"] : null);
                    row.PublishedProfit = row.PublishedPretax - row.Cost;
                }
            }
            Notifications.Info("Published prices refreshed.");
        }
        catch (Exception ex)
        {
            Notifications.Error($"Refresh published error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

