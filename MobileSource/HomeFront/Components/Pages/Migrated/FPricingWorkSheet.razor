    // === VB6 CalcData — Full Calculation Engine ===
    private void CalcData(WorksheetRow row, string changedField = "")
    {
        // Apply rounding if set
        decimal rowRound = row.RoundTo > 0 ? row.RoundTo : (RoundTo > 0 ? RoundTo : 0);

        switch (changedField.ToLower())
        {
            case "pretax":
                if (rowRound > 0)
                    row.Pretax = Math.Round(row.Pretax / rowRound) * rowRound;
                row.Tax = row.IncludeTax ? row.Pretax * TaxRate : 0;
                row.Total = row.Pretax + row.Tax;
                CalcMarkup(row, calcProfit: true, calcMarkup: true, calcMargin: true);
                break;

            case "markup":
                if (row.Cost != 0)
                    row.Pretax = row.Cost * (1 + row.Markup / 100m);
                if (rowRound > 0)
                    row.Pretax = Math.Round(row.Pretax / rowRound) * rowRound;
                row.Tax = row.IncludeTax ? row.Pretax * TaxRate : 0;
                row.Total = row.Pretax + row.Tax;
                CalcMarkup(row, calcProfit: true, calcMargin: true);
                break;

            case "margin":
                if (row.Margin < 100)
                    row.Pretax = row.Cost / (1 - row.Margin / 100m);
                if (rowRound > 0)
                    row.Pretax = Math.Round(row.Pretax / rowRound) * rowRound;
                row.Tax = row.IncludeTax ? row.Pretax * TaxRate : 0;
                row.Total = row.Pretax + row.Tax;
                CalcMarkup(row, calcProfit: true, calcMarkup: true);
                break;

            case "incentiveretail":
                // VB6 gData_MYValidateEdit Case "IncentiveRetail" (FPricingWorksheet.frm):
                // the typed retail drives the derived IncentiveCost; that rolls into
                // total Cost, and pricing (Profit/Markup/Margin) recomputes off the new
                // Cost with Pretax held. IncentiveRetail itself is left exactly as typed.
                row.IncentiveCost = row.IncentiveRetail * IncentiveCostPercent / 100m;
                row.Cost = row.ConstructionCost + row.LandCost + row.IncentiveCost;
                CalcMarkup(row, calcProfit: true, calcMarkup: true, calcMargin: true);
                break;

            case "copretax":
                row.COTax = row.IncludeTax ? row.COPretax * TaxRate : 0;
                row.COTotal = row.COPretax + row.COTax;
                CalcMarkup(row, calcCOMarkup: true, calcCOMargin: true);
                break;

            case "comarkup":
                if (row.Cost != 0)
                    row.COPretax = row.Cost * (1 + row.COMarkup / 100m);
                row.COTax = row.IncludeTax ? row.COPretax * TaxRate : 0;
                row.COTotal = row.COPretax + row.COTax;
                CalcMarkup(row, calcCOMargin: true);
                break;

            default:
                // Recalculate everything
                row.Tax = row.IncludeTax ? row.Pretax * TaxRate : 0;
                row.Total = row.Pretax + row.Tax;
                row.COTax = row.IncludeTax ? row.COPretax * TaxRate : 0;
                row.COTotal = row.COPretax + row.COTax;
                CalcMarkup(row, calcProfit: true, calcMarkup: true, calcMargin: true, calcCOMarkup: true, calcCOMargin: true);
                break;
        }

        // NOTE: do NOT recompute IncentiveRetail here. VB6 treats IncentiveRetail
        // as a user-entered STORED column; the derivation runs the OTHER way
        // (IncentiveCost = IncentiveRetail * IncentiveCostPercent/100, handled in
        // the "incentiveretail" case above and txtIncentiveCostPercent_Validate).
        // The old line here (IncentiveRetail = IncentiveCost*(1+Markup/100)) was
        // invented and overwrote the value the user just typed on every CalcData.
        CalculateDerivedFields(row);
    }

    private void CalcMarkup(WorksheetRow row,
        bool calcProfit = false, bool calcMarkup = false, bool calcMargin = false,
        bool calcCOMarkup = false, bool calcCOMargin = false)
    {
        if (calcProfit)
            row.Profit = row.Pretax - row.Cost;

        if (calcMarkup)
            row.Markup = row.Cost != 0 ? (row.Pretax - row.Cost) / row.Cost * 100m : 0;

        if (calcMargin)
            row.Margin = row.Pretax != 0 ? (row.Pretax - row.Cost) / row.Pretax * 100m : 0;

        if (calcCOMarkup)
            row.COMarkup = row.Cost != 0 ? (row.COPretax - row.Cost) / row.Cost * 100m : 0;

        if (calcCOMargin)
            row.COMargin = row.COPretax != 0 ? (row.COPretax - row.Cost) / row.COPretax * 100m : 0;
    }

    private void CalculateDerivedFields(WorksheetRow row)
    {
        row.Total = row.Pretax + row.Tax;
        row.COTotal = row.COPretax + row.COTax;
        row.Profit = row.Pretax - row.Cost;
        if (row.FloorArea > 0)
        {
            row.CostPerFt = row.ConstructionCost / row.FloorArea;
            row.PricePerFt = row.Pretax / row.FloorArea;
        }
        // Published profit
        row.PublishedProfit = row.PublishedPretax - row.Cost;
    }

    // === VB6 Price Change Handlers ===
    private void OnDollarPriceChange(NumericTextBoxControl<decimal>.NumericChangeEventArgs<decimal> args)
    {
        if (DollarChange == 0) return;
        foreach (var row in WorksheetData.Where(r => !r.Inactive))
        {
            row.Pretax += DollarChange;
            CalcData(row, "pretax");
            row.RowState = "DIRTY";
        }
        DollarChange = 0;
        mDirty = true;
        StateHasChanged();
    }

    private void OnPercentIncreaseChange(NumericTextBoxControl<decimal>.NumericChangeEventArgs<decimal> args)
    {
        if (PercentIncrease == 0) return;
        foreach (var row in WorksheetData.Where(r => !r.Inactive))
        {
            row.Pretax *= (1 + PercentIncrease / 100m);
            CalcData(row, "pretax");
            row.RowState = "DIRTY";
        }
        PercentIncrease = 0;
        mDirty = true;
        StateHasChanged();
    }

    private void OnPercentDecreaseChange(NumericTextBoxControl<decimal>.NumericChangeEventArgs<decimal> args)
    {
        if (PercentDecrease == 0) return;
        foreach (var row in WorksheetData.Where(r => !r.Inactive))
        {
            row.Pretax *= (1 - PercentDecrease / 100m);
            CalcData(row, "pretax");
            row.RowState = "DIRTY";
        }
        PercentDecrease = 0;
        mDirty = true;
        StateHasChanged();
    }

    // VB6: txtIncentiveCostPercent_Validate
    private void OnIncentiveCostPercentChange(NumericTextBoxControl<decimal>.NumericChangeEventArgs<decimal> args)
    {
        foreach (var row in WorksheetData.Where(r => !r.Inactive))
        {
            row.IncentiveCost = row.ConstructionCost * IncentiveCostPercent / 100m;
            row.Cost = row.ConstructionCost + row.LandCost + row.IncentiveCost;
            CalcData(row);
            row.RowState = "DIRTY";
        }
        mDirty = true;
        StateHasChanged();
    }

    // VB6: txtRoundTo_Validate
    private void OnRoundToChange(NumericTextBoxControl<decimal>.NumericChangeEventArgs<decimal> args)
    {
        if (RoundTo <= 0) return;
        foreach (var row in WorksheetData.Where(r => !r.Inactive))
        {
            if (row.Pretax > 0)
            {
                row.Pretax = Math.Round(row.Pretax / RoundTo) * RoundTo;
                CalcData(row, "pretax");
                row.RowState = "DIRTY";
            }
        }
        mDirty = true;
        StateHasChanged();
    }

    // === Save Data ===
    private async Task<bool> SaveDataAsync()
    {
        if (!mDirty) return true;

        // VB6: ValidateForm
        if (!ValidateForm()) return false;

        IsLoading = true;
        StateHasChanged();
        try
        {
            // Update master
            await Db.ExecuteAsync($@"
                UPDATE tblSalesSheetMaster SET
                    Description=@Description, CostBasisType=@CostBasisType,
                    IncentiveCostPercent=@IncentiveCostPercent, Inactive=@Inactive
                WHERE Worksheet={WorksheetId}",
                new { Description = WorksheetDescription, CostBasisType, IncentiveCostPercent, Inactive = IsArchived });

            // Update dirty details
            foreach (var row in WorksheetData.Where(r => r.RowState == "DIRTY"))
            {
                await Db.ExecuteAsync($@"
                    UPDATE tblSalesSheetDetails SET
                        Description=@Description, Notes=@Notes, Comments=@Comments, Category=@Category,
                        Series=@Series, Style=@Style, FloorArea=@FloorArea, Bedrooms=@Bedrooms, Bathrooms=@Bathrooms,
                        LandCost=@LandCost, Pretax=@Pretax, Tax=@Tax, Markup=@Markup, Margin=@Margin, Roundto=@RoundTo,
                        COPretax=@COPretax, COTax=@COTax, COMarkup=@COMarkup, Qty=@Qty, Color=@Color, Location=@Location,
                        IncludedOption=@IncludedOption, Inactive=@Inactive, ReadyToPublish=@ReadyToPublish,
                        IncludeTax=@IncludeTax, IncludedInSpec=@InSpec, IncentiveRetail=@IncentiveRetail
                    WHERE Worksheet={WorksheetId} AND Community=@Community AND Assembly=@Assembly AND ISNULL(OptionID,'')=@OptionID",
                    new
                    {
                        row.Description, row.Notes, row.Comments, row.Category, row.Series, row.Style,
                        row.FloorArea, row.Bedrooms, row.Bathrooms, row.LandCost, row.Pretax, row.Tax,
                        row.Markup, row.Margin, row.RoundTo, row.COPretax, row.COTax, row.COMarkup,
                        row.Qty, row.Color, row.Location, row.IncludedOption, row.Inactive, row.ReadyToPublish,
                        row.IncludeTax, row.InSpec, row.IncentiveRetail, row.Community, row.Assembly,
                        OptionID = row.OptionID ?? ""
                    });
                row.RowState = "CLEAN";
            }
            mDirty = false;
            Notifications.Info("Worksheet saved successfully.");
            return true;
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error saving: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // VB6: ValidateForm — check for duplicate assemblies
    private bool ValidateForm()
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var row in WorksheetData)
        {
            var key = $"{row.Community}|{row.CommunityPhase}|{row.Model}|{row.Series}|{row.OptionID}|{row.Assembly}";
            if (!seen.Add(key))
            {
                _ = Dialogs.AlertAsync($"Duplicate assembly found: {row.Assembly} in model {row.Model}");
                return false;
            }
        }
        return true;
    }

