    /// <summary>VB6 (FPricingWorksheet.frm line 1993-2022): "Preview" toolbar
    /// button opens one of FOUR Crystal Reports depending on the
    /// RecordSalesSheetCosts AppOption + whether DivisionID is set:
    ///
    ///   Record=true,  no division → salessheetcosts.xml
    ///   Record=true,  division    → SalesSheetCosts Division version.xml
    ///   Record=false, no division → salessheetCurrentCosts.xml
    ///   Record=false, division    → salessheetCurrentCosts Division version.xml
    ///
    /// The four XML files live in <c>wwwroot/resources/System/Estimating/</c>
    /// (NOT the regular <c>Estimating/Reports/xml</c> tree). VB6 paths
    /// were <c>System\Reports\Estimating\</c>; POC drops the redundant
    /// <c>Reports\</c> segment.
    ///
    /// FRptViewer accepts an XML path directly (ShowReportAsync handles
    /// both .rpt and .xml — see ReportWriterControl line 1016). Worksheet
    /// + DivisionID get prompted via the embedded
    /// ReportParamDialogControl; DivisionID auto-fills from SessionState.
    ///
    /// VB6 also forces a save before opening preview (msgbox "You must
    /// save your changes before opening the print preview window."). Same
    /// here, using JSRuntime confirm.</summary>
    private async Task OnPreviewClick()
    {
        if (mDirty)
        {
            var answer = await Dialogs.ConfirmAsync(
                "You must save your changes before opening the print preview window.\n\nSave now?");
            if (!answer) return;
            if (!await SaveDataAsync()) return;
        }

        // VB6: HFApp.Options(RecordSalesSheetCosts) — appoptions table row
        // keyed by optionname. Default false → "Current" cost flavour.
        var recordSalesSheetCosts = false;
        try
        {
            var raw = await Db.ExecuteScalarAsync<string>(
                $@"SELECT TOP 1 optionvalue FROM appoptions
                   WHERE DivisionID = {SessionState.DivisionID}
                     AND optionname = 'RecordSalesSheetCosts'");
            recordSalesSheetCosts = string.Equals(raw, "true", StringComparison.OrdinalIgnoreCase)
                                    || raw == "1";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Couldn't read RecordSalesSheetCosts AppOption — defaulting to false");
        }

        // SessionState.DivisionID is int — "no division" maps to ≤ 0
        // (VB6 stored it as a string and checked for empty, same intent).
        var hasDivision = SessionState.DivisionID > 0;
        var reportFileName = (recordSalesSheetCosts, hasDivision) switch
        {
            (true,  false) => "salessheetcosts.xml",
            (true,  true ) => "SalesSheetCosts Division version.xml",
            (false, false) => "salessheetCurrentCosts.xml",
            (false, true ) => "salessheetCurrentCosts Division version.xml",
        };

        var xmlPath = System.IO.Path.Combine(
            WebHost.WebRootPath ?? "wwwroot",
            "resources", "System", "Estimating",
            reportFileName);

        // Pre-seed the Worksheet parameter so FRptViewer's parameter
        // dialog skips the prompt — VB6 (FPricingWorksheet.frm:2017-2019)
        // does the same with `c.ParameterValue("Worksheet", mWorksheet)`.
        // Parameter name matches the XML's <ParameterFieldDefinition
        // Name="Worksheet" NumberParameter>. ReportSeeds is one-shot —
        // FRptViewer consumes + clears in OnAfterRenderAsync, so this
        // doesn't leak into the next /report-viewer navigation.
        if (WorksheetId > 0)
            ReportSeeds.Set("Worksheet", WorksheetId.ToString());

        var route = $"/report-viewer/{Uri.EscapeDataString(xmlPath)}";
        if (ParentNavigate != null)
            ParentNavigate.Invoke(route);     // stays inside FMain shell
        else
            NavigationManager.NavigateTo(route);  // standalone fallback
    }
