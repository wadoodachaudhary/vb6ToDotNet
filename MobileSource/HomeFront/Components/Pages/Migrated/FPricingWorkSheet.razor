    // to. We stash the picked rows + the chosen view index here so the
    // second picklist's callback can run AddAssemblyToGrid for every
    // (assembly × community) pair.
    private List<IDictionary<string, object>> _pendingAssemblyPicks = new();
    private int _lastAddAssemblyView = 0;

