    // ── Worksheet Pick List (VB6: FMain → FPickList.Choose before opening FPricingWorksheet) ──
    // VB6: FPickList.Choose(dbHomefront, "Pricing Worksheet", s, , False, True)
    //   Two views: "Worksheets" (active) and "Archived Sheets" (inactive)
    //   Then checks record lock, opens worksheet if not locked.
    private async Task ShowWorksheetPickList()
    {
        if (pickList == null) return;

        var worksheetsQuery = $@"
            SELECT m.Worksheet, m.Description,
                   m.CostsEffectiveDate ""Costs Effective"",
                   m.SalesEffectiveDate Posted,
                   l.User_ID + ' on ' + l.Workstation_name ""Locked by""
            FROM tblSalesSheetMaster m
            LEFT OUTER JOIN TableLog l ON (l.TableName='tblSalesSheetMaster'
                AND RecordLocked=1 AND l.KeyRecord=CAST(m.Worksheet AS VARCHAR))
            WHERE ISNULL(m.inactive,0)=0
              AND m.WorksheetType=0
              AND m.DivisionID = {SessionState.DivisionID}";

        var archivedQuery = $@"
            SELECT m.Worksheet, m.Description,
                   m.CostsEffectiveDate ""Costs Effective"",
                   m.SalesEffectiveDate Posted,
                   l.User_ID + ' on ' + l.Workstation_name ""Locked by""
            FROM tblSalesSheetMaster m
            LEFT OUTER JOIN TableLog l ON (l.TableName='tblSalesSheetMaster'
                AND RecordLocked=1 AND l.KeyRecord=CAST(m.Worksheet AS VARCHAR))
            WHERE ISNULL(m.inactive,0)=1
              AND m.WorksheetType=0
              AND m.DivisionID = {SessionState.DivisionID}";

        var queries = $"Worksheets;{worksheetsQuery}|Archived Sheets;{archivedQuery}";

        _pickListContext = "OpenWorksheet";
        await pickList.Open(
            title: "Pricing Worksheet",
            queries: queries,
            multiSelect: false,
            sortAsc: false,
            showNew: true);
    }

    /// <summary>VB6 AddAssembly calls SaveData(False) before computing costs.
    /// Persist the master row for an unsaved sheet so it gets a real Worksheet
    /// number (Purch_GetAssemblySalesSheetCost keys off @SalesSheet). Idempotent:
    /// no-op once WorksheetId &gt; 0.</summary>
    private async Task EnsureWorksheetSavedAsync()
    {
        if (WorksheetId > 0) return;
        var newId = await Db.ExecuteScalarAsync<int>($@"
            INSERT INTO tblSalesSheetMaster (Description, DivisionID, WorksheetType, CostBasisType,
                IncentiveCostPercent, CostsEffectiveDate, Inactive)
            OUTPUT INSERTED.Worksheet
            VALUES (@Desc, {SessionState.DivisionID}, {(int)WorksheetType}, {CostBasisType},
                {IncentiveCostPercent}, GETDATE(), 0)",
            new { Desc = string.IsNullOrEmpty(WorksheetDescription) ? "New Worksheet" : WorksheetDescription });
        WorksheetId = newId;
        SyncWorksheetRouteState();
    }

    /// <summary>VB6 RefreshCosts: run Purch_GetAssemblySalesSheetCost (an action proc
    /// that UPDATEs the cost columns on tblSalesSheetDetails for this Cost Basis),
    /// then re-read Cost/LandCost/IncentiveCost/ConstructionCost/Pretax back into the
    /// row. Safe no-op when the sheet isn't saved yet.</summary>
    private async Task RefreshRowCostAsync(WorksheetRow row)
    {
        if (WorksheetId <= 0) return;
        var p = new
        {
            WS = WorksheetId, A = row.Assembly ?? "", M = row.Model ?? "",
            O = row.OptionID ?? "", C = row.Community ?? "", P = row.CommunityPhase ?? ""
        };
        await Db.ExecuteAsync(
            "EXEC dbo.Purch_GetAssemblySalesSheetCost @SalesSheet=@WS, @Assembly=@A, @Model=@M, @OptionID=@O, @Community=@C, @CommunityPhase=@P",
            p);
        var costRows = await Db.QueryAsync(
            @"SELECT TOP 1 Cost, LandCost, IncentiveCost, ConstructionCost, Pretax
              FROM tblSalesSheetDetails
              WHERE Worksheet=@WS AND Community=@C AND ISNULL(CommunityPhase,'')=@P
                AND Assembly=@A AND Model=@M AND ISNULL(OptionID,'')=@O", p);
        if (costRows.Any())
        {
            var cr = costRows.First();
            row.Cost             = SafeDecimal(cr["Cost"]);
            row.LandCost         = SafeDecimal(cr["LandCost"]);
            row.IncentiveCost    = SafeDecimal(cr["IncentiveCost"]);
            row.ConstructionCost = SafeDecimal(cr["ConstructionCost"]);
            row.Pretax           = SafeDecimal(cr["Pretax"]);
        }
    }

    /// <summary>VB6 FPricingWorksheet.frm LoadData else-branch (lines 1079-1086):
    /// start a brand-new sheet. Description "New Worksheet", Cost Basis = Current
    /// (cboCostBasis.ListIndex 0), Incentive Cost% from HFApp.Options(IncentiveCostPercent)
    /// (Options.cls built-in default 55). No saved row exists to load.</summary>
    private async Task InitializeNewWorksheet()
    {
        WorksheetId = 0;
        WorksheetDescription = "New Worksheet";
        CostBasisType = 0;                 // VB6 cboCostBasis.ListIndex = 0 -> "Current"
        RoundTo = 0;
        IsArchived = false;
        IncentiveCostPercent = await GetIncentiveCostPercentDefaultAsync();
        WorksheetData.Clear();
        mDirty = false;
        UpdateWindowTitle();
        StateHasChanged();
    }

    /// <summary>VB6 HFApp.Options(IncentiveCostPercent): read the division's
    /// IncentiveCostPercent app-option (appoptions table). Options.cls initializes the
    /// option to 55, so 55 is the value when no override row exists -- the genuine VB6
    /// default, not a masking fallback. Mirrors the RecordSalesSheetCosts read.</summary>
    private async Task<decimal> GetIncentiveCostPercentDefaultAsync()
    {
        try
        {
            var raw = await Db.ExecuteScalarAsync<string>(
                $@"SELECT TOP 1 optionvalue FROM appoptions
                   WHERE DivisionID = {SessionState.DivisionID}
                     AND optionname = 'IncentiveCostPercent'");
            if (decimal.TryParse(raw, out var pct)) return pct;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Couldn't read IncentiveCostPercent AppOption -- using VB6 default 55");
        }
        return 55m;
    }

    private async Task OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        // VB6 gData_CellButtonClick result: apply the chosen lookup row to the
        // target cells, then we're done (no further picklist chaining).
        if (_pickListContext == "Lookup")
        {
            _pickListContext = "";
            if (selectedRows.Count > 0)
                ApplyLookupPick(selectedRows[0]);
            else
            {
                _lookupRow = null;
                _lookupField = "";
                _lookupTargets.Clear();
            }
            return;
        }

        if (_pickListContext == "AddAssembly")
        {
            // VB6 (line 4239): iView = AssemblyPL.SelectedView; If IsIn(iView, 2, 4, 6)
            //   → community-specific views in the 1-based VB6 list. Zero-based
            //     here, so the community-specific views are indices 1, 3, 5.
            // Community-specific views carry SourceCommunity / Community columns
            // in their SELECT; global views (0, 2, 4) don't — those need a
            // second picklist to choose selling communities.
            var viewIndex = pickList?.SelectedViewIndex ?? 0;
            _lastAddAssemblyView = viewIndex;
            _pickListContext = "";

            if (selectedRows.Count == 0) return;
            // DesignCenter worksheets get a single view (index 0) that already
            // includes SourceCommunity — treat them like a community-specific
            // view in the General flow.
            var isCommunitySpecific = WorksheetType == WorksheetTypes.DesignCenter
                                      || viewIndex == 1 || viewIndex == 3 || viewIndex == 5;

            if (isCommunitySpecific)
            {
                foreach (var row in selectedRows)
                {
                    await AddAssemblyToGridAsync(
                        community: GetRowStr(row, "SourceCommunity"),
                        phase:     "",
                        assembly:  GetRowStr(row, "Assembly"),
                        model:     GetRowStr(row, "Model"),
                        optionId:  GetRowStr(row, "Option"),
                        series:    GetRowStr(row, "Series"));
                }
                mDirty = true;
                StateHasChanged();
                return;
            }

            // Global view: stash the assemblies, then open the second
            // picklist for selling communities.
            _pendingAssemblyPicks = selectedRows;
            if (pickList != null)
            {
                _pickListContext = "AddAssemblyCommunities";
                var sql = $@"
SELECT '** All Communities **' AS Description, '' AS Community, '' AS Phase, '' AS Inactive, -1 AS SortOrder
UNION
SELECT c.Description, c.area AS Community, '' AS Phase,
       CASE WHEN c.Inactive = 1 THEN 'Inactive' ELSE '' END, c.inactive AS SortOrder
FROM tbllocality c
LEFT OUTER JOIN DivisionCommunities d ON d.Community = c.Area
WHERE d.DivisionID = {SessionState.DivisionID}
UNION
SELECT c.description + ISNULL(' ' + p.description, ''), c.area AS Community,
       ISNULL(p.communityphase, '') AS Phase,
       CASE WHEN c.Inactive = 1 THEN 'Inactive' ELSE '' END, c.inactive AS SortOrder
FROM tbllocality c
LEFT OUTER JOIN communityphase p ON c.area = p.community
LEFT OUTER JOIN DivisionCommunities d ON d.Community = c.Area
WHERE d.DivisionID = {SessionState.DivisionID}
ORDER BY 5, 1";
                await pickList.Open(
                    title: "Selling Communities",
                    queries: sql,
                    hideColumns: "SortOrder",
                    multiSelect: true,
                    dialogCaption: "Select selling communities");
            }
            return;
        }

        if (_pickListContext == "AddAssemblyCommunities")
        {
            // Second-step picklist (global view → choose communities).
            // For every (assembly × community) pair, run AddAssemblyToGrid.
            _pickListContext = "";
            if (_pendingAssemblyPicks.Count > 0 && selectedRows.Count > 0)
            {
                foreach (var asm in _pendingAssemblyPicks)
                {
                    foreach (var com in selectedRows)
                    {
                        await AddAssemblyToGridAsync(
                            community: GetRowStr(com, "Community"),
                            phase:     GetRowStr(com, "Phase"),
                            assembly:  GetRowStr(asm, "Assembly"),
                            model:     GetRowStr(asm, "Model"),
                            optionId:  GetRowStr(asm, "Option"),
                            series:    GetRowStr(asm, "Series"));
                    }
                }
                mDirty = true;
                StateHasChanged();
            }
            _pendingAssemblyPicks = new List<IDictionary<string, object>>();
            return;
        }

        if (_pickListContext == "OpenWorksheet")
        {
            // VB6 ShowForm flow. FPickList's "New" button returns an EMPTY list
            // (FPickList.OnNewClick), while picking an existing row returns it with
            // a "Worksheet" key. So branch on whether a real worksheet was chosen
            // -- NOT on selectedRows.Count, or the "New" path is unreachable.
            _pickListContext = "";
            var worksheetNum = 0;
            if (selectedRows.Count > 0)
            {
                var row = selectedRows[0];
                var worksheetStr = row.ContainsKey("Worksheet") ? row["Worksheet"]?.ToString() ?? "" : "";
                int.TryParse(worksheetStr, out worksheetNum);
            }

            if (worksheetNum > 0)
            {
                // VB6: s = HFApp.RecordLockedBy("tblSalesSheetMaster", i)
                var lockedBy = await RecordLockedByAsync("tblSalesSheetMaster", worksheetNum);
                if (!string.IsNullOrEmpty(lockedBy))
                {
                    Notifications.Info($"Unable to open this worksheet. It is in use by {lockedBy}");
                    await ShowWorksheetPickList();
                }
                else
                {
                    WorksheetId = worksheetNum;
                    await LoadDataAsync();
                    // Publish /pricing-worksheet/{id} (distinct MDI key) AND retitle
                    // this tab to the worksheet number, so opening an existing sheet
                    // gives it its own titled tab instead of re-focusing a generic one.
                    SyncWorksheetRouteState();
                }
            }
            else
            {
                // VB6 FPricingWorksheet.frm LoadData else-branch (lines 1079-1086):
                // the "New Worksheet" pick (empty list) starts a fresh sheet.
                // Cost Basis = Current (ListIndex 0), Incentive Cost% from the
                // IncentiveCostPercent app-option (default 55).
                await InitializeNewWorksheet();
            }
            return;
        }

        _pickListContext = "";
    }

    // VB6: user cancelled the picklist — navigate back (equivalent to not opening the form)
    private void OnPickListCancelled()
    {
