    // VB6: SaveAs toolbar button — creates new worksheet copy
    private async Task OnSaveAsConfirm()
    {
        if (string.IsNullOrWhiteSpace(SaveAsDescription))
        {
            Notifications.Info("Enter a description for the new worksheet.");
            return;
        }
        IsSaveAsDialogVisible = false;
        IsLoading = true;
        StateHasChanged();
        try
        {
            // Insert new master record
            var newId = await Db.ExecuteScalarAsync<int>($@"
                INSERT INTO tblSalesSheetMaster (Description, DivisionID, WorksheetType, CostBasisType,
                    IncentiveCostPercent, CostsEffectiveDate, Inactive)
                SELECT @Desc, {SessionState.DivisionID}, WorksheetType, CostBasisType,
                    IncentiveCostPercent, CostsEffectiveDate, 0
                FROM tblSalesSheetMaster WHERE Worksheet={WorksheetId};
                SELECT SCOPE_IDENTITY();",
                new { Desc = SaveAsDescription });

            if (newId > 0)
            {
                // Copy detail rows
                await Db.ExecuteAsync($@"
                    INSERT INTO tblSalesSheetDetails
                    SELECT {newId} AS Worksheet, Community, CommunityPhase, SourceCommunity,
                           Assembly, AssemblyUOM, Model, Elevation, OptionID, AssemblyType,
                           Description, Notes, Comments, Category, Series, Style,
                           FloorArea, Bedrooms, Bathrooms, ConstCutOff, JCExtra,
                           LandCost, ConstructionCost, IncentiveCost, IncentiveRetail, Cost,
                           Pretax, Tax, Markup, Margin, Roundto,
                           COPretax, COTax, COMarkup, Qty, Color, Location,
                           IncludedOption, Inactive, ReadyToPublish, IncludeTax, IncludedInSpec
                    FROM tblSalesSheetDetails WHERE Worksheet={WorksheetId}");

                WorksheetId = newId;
                WorksheetDescription = SaveAsDescription;
                mDirty = false;
                Notifications.Info($"Worksheet saved as number {newId}.");
                await LoadDataAsync();
                // Re-key this MDI window to the new worksheet number so it no
                // longer collides with the source worksheet's tab.
                SyncWorksheetRouteState();
            }
        }
        catch (Exception ex)
        {
            Notifications.Error($"SaveAs error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── Add Assembly (VB6: FPricingWorksheet.frm AddAssembly()) ───────────
    // ═══════════════════════════════════════════════════════════════════════
    /// <summary>VB6 (line 4092) builds a multi-view FPickList — the user sees
    /// a "View:" dropdown at the top (Models / Community Models / Model
    /// Options / Community Model Options / Global Options / Community Global
    /// Options) and a grid of assemblies for the chosen view. After the
    /// assembly is picked, if it's a "global" view (not community-specific),
    /// VB6 opens a SECOND picklist for "Selling Communities" so the user can
    /// pick which communities to assign each global assembly to. Then for
    /// every (assembly × community) pair, AddAssemblyToGrid runs.
    ///
    /// POC reuses the existing FPickList component (which already supports
    /// multi-view via the `View1;SQL1|View2;SQL2|...` query string). The
    /// follow-up community pick is handled via a second pickList.Open call
    /// from the OnPickListSelected callback when SelectedViewIndex points
    /// at one of the global views (0 = Models, 2 = Model Options,
    /// 4 = Global Options).</summary>
    private async Task OnAddClick()
    {
        if (IsReadOnly || pickList == null) return;

        var divId = SessionState.DivisionID;
        string queries;

        if (WorksheetType == WorksheetTypes.DesignCenter)
        {
            // Design Center worksheet — single view, all DC options.
            // Mirrors VB6 fallback when neither DCOptionByAreaPhase nor
            // DCOptionByArea is set (line 4133-4140). POC ignores those
            // two AppOptions for now and uses the simplest variant; if a
            // host needs the phase/area-keyed flavours, branch on the
            // option here.
            var dcSql =
                $@"SELECT ISNULL(k.description, a.Category) AS Category,
                          a.Model, a.OptionID AS [Option], a.Assembly, a.Description,
                          a.assemblytype, a.community AS SourceCommunity, '' AS AreaID
                   FROM tbldbassemblymaster a
                   LEFT OUTER JOIN tblcategories k ON a.category = k.category
                   WHERE a.divisionid = {divId}
                     AND ISNULL(a.IsBaseAssembly, 0) = 0
                     AND ISNULL(a.inactive, 0) = 0
                     AND a.assemblytype = 4
                     AND ISNULL(a.community, '') = ''
                   ORDER BY 1, 2, 3, 4, 5, 6, 7";
            queries = $"Design Center Options;{dcSql}";
        }
        else
        {
            // Six-view General/Estimating set — port of VB6 lines 4146-4234.
            // The "Community ..." variants include a SourceCommunity / Community
            // column so the consumer can route directly to AddAssemblyToGrid
            // with that community. The bare variants are "global" — they
            // trigger the second FPickList for selling communities.
            string models = $@"
SELECT DISTINCT m.Model, s.Series, m.Assembly, m.Description
FROM tbldbassemblymaster m
LEFT JOIN tblseries s ON s.DivisionID = {divId} AND (ISNULL(m.series,'')='' OR m.series = s.series)
WHERE m.divisionid = {divId} AND ISNULL(m.community,'')=''
  AND ISNULL(m.inactive,0)=0 AND m.assemblytype = 0 AND ISNULL(m.isbaseassembly,0)=0
ORDER BY 1,2,3,4";

            string communityModels = $@"
SELECT DISTINCT m.Model, s.Series, m.Assembly, m.Description,
       m.community AS SourceCommunity, c.description AS Community
FROM tbldbassemblymaster m
JOIN tbllocality c ON c.area = m.community
LEFT JOIN divisioncommunities d ON m.community=d.community AND m.divisionid=d.divisionid
LEFT JOIN tblseries s ON s.DivisionID = {divId} AND (ISNULL(m.series,'')='' OR m.series=s.series)
WHERE m.divisionid = {divId}
  AND (d.community IS NOT NULL OR ISNULL(m.community,'')='')
  AND ISNULL(m.inactive,0)=0 AND m.assemblytype = 0 AND ISNULL(m.isbaseassembly,0)=0
ORDER BY 1,2,3,4";

            string modelOptions = $@"
SELECT DISTINCT k.Description AS Category, m.Model, dm.description AS ModelDesc,
       s.Series, m.OptionID AS [Option], m.Assembly, m.Description
FROM tbldbassemblymaster m
LEFT JOIN distinctmodelsbydivision dm ON m.model = dm.model AND m.divisionid = dm.divisionid
LEFT OUTER JOIN tblcategories k ON m.category = k.category
LEFT JOIN tblseries s ON s.DivisionID = {divId} AND (ISNULL(m.series,'')='' OR m.series=s.series)
WHERE m.divisionid = {divId} AND ISNULL(m.community,'')=''
  AND ISNULL(m.inactive,0)=0 AND m.assemblytype = 2 AND ISNULL(m.isbaseassembly,0)=0
ORDER BY 1,2,3,4";

            string communityModelOptions = $@"
SELECT DISTINCT k.Description AS Category, m.Model, dm.description AS ModelDesc,
       s.Series, m.OptionID AS [Option], m.Assembly, m.Description,
       m.community AS SourceCommunity, c.description AS Community
FROM tbldbassemblymaster m
LEFT JOIN distinctmodelsbydivision dm ON m.model = dm.model AND m.divisionid = dm.divisionid
JOIN tbllocality c ON c.area = m.community
LEFT JOIN divisioncommunities d ON m.community=d.community AND m.divisionid=d.divisionid
LEFT OUTER JOIN tblcategories k ON m.category = k.category
LEFT JOIN tblseries s ON s.DivisionID = {divId} AND (ISNULL(m.series,'')='' OR m.series=s.series)
WHERE m.divisionid = {divId}
  AND (d.community IS NOT NULL OR ISNULL(m.community,'')='')
  AND ISNULL(m.inactive,0)=0 AND m.assemblytype = 2 AND ISNULL(m.isbaseassembly,0)=0
ORDER BY 1,2,3,4";

            string globalOptions = $@"
SELECT DISTINCT k.Description AS Category, m.OptionID AS [Option], m.Assembly, m.Description
FROM tbldbassemblymaster m
LEFT JOIN distinctmodelsbydivision dm ON m.model=dm.model AND m.divisionid=dm.divisionid
LEFT OUTER JOIN tblcategories k ON m.category = k.category
WHERE m.divisionid = {divId} AND ISNULL(m.community,'')=''
  AND ISNULL(m.inactive,0)=0 AND ISNULL(m.isbaseassembly,0)=0 AND m.assemblytype = 3
UNION
SELECT DISTINCT k.Description AS Category, a.OptionID AS [Option], '' AS Assembly, a.Description
FROM tblphaseitem a
LEFT OUTER JOIN tblcategories k ON a.optioncategory = k.category
WHERE a.divisionid = {divId} AND ISNULL(a.optionid,'') <> ''
ORDER BY 1,2,3,4";

            string communityGlobalOptions = $@"
SELECT DISTINCT k.Description AS Category, m.OptionID AS [Option], m.Assembly, m.Description,
       m.community AS SourceCommunity, c.description AS Community
FROM tbldbassemblymaster m
JOIN tbllocality c ON c.area = m.community
LEFT JOIN divisioncommunities d ON m.community=d.community AND m.divisionid=d.divisionid
LEFT OUTER JOIN tblcategories k ON m.category = k.category
WHERE m.divisionid = {divId}
  AND (d.community IS NOT NULL OR ISNULL(m.community,'')='')
  AND ISNULL(m.inactive,0)=0 AND m.assemblytype = 3 AND ISNULL(m.isbaseassembly,0)=0
ORDER BY 1,2,3,4";

            // FPickList multi-view format: "View1;SQL1|View2;SQL2|..."
            queries = string.Join("|", new[]
            {
                "Models;"                    + models,
                "Community Models;"          + communityModels,
                "Model Options;"             + modelOptions,
                "Community Model Options;"   + communityModelOptions,
                "Global Options;"            + globalOptions,
                "Community Global Options;" + communityGlobalOptions,
            });
        }

        _pendingAssemblyPicks = new List<IDictionary<string, object>>();
        _pickListContext = "AddAssembly";
        await pickList.Open(
            title: "Assembly",
            queries: queries,
            hideColumns: "areaID,modelid,optionid,assemblytype,SourceCommunity",
            multiSelect: true,
            defaultView: _lastAddAssemblyView);
    }

    // ── Add-assembly state plumbing ────────────────────────────────────
    // Cached between the two-step VB6 flow: when the first picklist returns
