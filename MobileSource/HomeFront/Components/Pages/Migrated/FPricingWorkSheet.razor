            {
                Area = r["Area"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? ""
            }).ToList();

            // Models
            var models = await db.QueryAsync($"SELECT DISTINCT Model, Description FROM tblDBAssemblyMaster WHERE DivisionID={DivisionID} ORDER BY Model");
            ModelList = models.Select(r => new ModelItem
            {
                Model = r["Model"]?.ToString() ?? "",
                Description = $"{r["Model"]} - {r["Description"]}"
            }).ToList();

            // Custom labels
            var label = await db.ExecuteScalarAsync<string>("SELECT ISNULL(NULLIF(custom_description,''),'Community') FROM customdescriptions WHERE item='Community'");
            if (!string.IsNullOrEmpty(label)) CommunityLabel = label;

            // Include tax setting and tax rate
            var taxSetting = await db.ExecuteScalarAsync<string>($"SELECT ISNULL(IncludeTax,0) FROM system_setup WHERE id={DivisionID}");
            ShowIncludeTax = taxSetting == "True" || taxSetting == "1";

            var taxRateStr = await db.ExecuteScalarAsync<string>($"SELECT ISNULL(TaxRate,0) FROM system_setup WHERE id={DivisionID}");
            if (decimal.TryParse(taxRateStr, out var tr)) TaxRate = tr / 100m;

            // MaxVendorPricing
            var mvpStr = await db.ExecuteScalarAsync<string>($"SELECT TOP 1 ISNULL(MaxVendorPricing,0) FROM system_setup WHERE id={DivisionID}");
            MaxVendorPricing = mvpStr == "True" || mvpStr == "1";

            // Assembly costs button visibility (VB6: Options(RecordSalesSheetCosts))
            ShowCostsButton = true;
            IncentiveCostEnabled = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadLookupDataAsync error: {ex.Message}");
        }
    }

    // === Data Loading ===
    private async Task LoadDataAsync()
    {
        if (WorksheetId == 0) return;
        IsLoading = true;
        StateHasChanged();
        try
        {
            // Load master
            var masterRows = await db.QueryAsync($"SELECT * FROM tblSalesSheetMaster WHERE Worksheet={WorksheetId}");
            if (masterRows.Any())
            {
                var m = masterRows.First();
                IsArchived = m["Inactive"]?.ToString() == "True";
                WorksheetDescription = m["Description"]?.ToString() ?? "New Worksheet";
                CostBasisType = m["CostBasisType"] != null && m["CostBasisType"] != DBNull.Value
                    ? Convert.ToInt32(m["CostBasisType"]) : 0;
                IncentiveCostPercent = m["IncentiveCostPercent"] != null && m["IncentiveCostPercent"] != DBNull.Value
                    ? Convert.ToDecimal(m["IncentiveCostPercent"]) : 0;
                if (m["CostsEffectiveDate"] != null && m["CostsEffectiveDate"] != DBNull.Value)
                    CostsEffectiveDate = Convert.ToDateTime(m["CostsEffectiveDate"]);
                if (m["SalesEffectiveDate"] != null && m["SalesEffectiveDate"] != DBNull.Value)
                    SalesEffectiveDate = Convert.ToDateTime(m["SalesEffectiveDate"]);
            }

            // VB6: ReadOnly when SalesEffectiveDate is set (worksheet has been published)
            IsReadOnly = SalesEffectiveDate.HasValue;

            // Load details
            var sql = $@"
                SELECT l.Description AS CommunityDesc, c.Description AS CategoryDesc,
                       dm.Description AS ModelDescription, d.*
                FROM tblSalesSheetDetails d
                JOIN tblSalesSheetMaster m ON m.Worksheet = d.Worksheet
                LEFT JOIN tblLocality l ON d.Community = l.Area
                LEFT JOIN tblCategories c ON d.Category = c.Category
                LEFT JOIN distinctmodelsByDivision dm ON dm.DivisionID = m.DivisionID AND d.Model = dm.Model
                WHERE d.Worksheet = {WorksheetId}
                ORDER BY d.Model, d.Assembly";
            var rows = await db.QueryAsync(sql);
            WorksheetData = rows.Select(r => MapRowFromDb(r)).ToList();

            // Calculate derived fields for all rows
            foreach (var row in WorksheetData)
                CalculateDerivedFields(row);

            mDirty = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadDataAsync error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading worksheet: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private WorksheetRow MapRowFromDb(Dictionary<string, object> r)
    {
        return new WorksheetRow
        {
            Community = r["Community"]?.ToString() ?? "",
            CommunityPhase = r["CommunityPhase"]?.ToString() ?? "",
            CommunityDesc = r["CommunityDesc"]?.ToString() ?? "",
            SourceCommunity = r["SourceCommunity"]?.ToString() ?? "",
            Assembly = r["Assembly"]?.ToString() ?? "",
            AssemblyUOM = r["AssemblyUOM"]?.ToString() ?? "",
            Model = r["Model"]?.ToString() ?? "",
            ModelDescription = r["ModelDescription"]?.ToString() ?? "",
            Elevation = r["Elevation"]?.ToString() ?? "",
            OptionID = r["OptionID"]?.ToString() ?? "",
            AssemblyType = SafeInt(r["AssemblyType"]),
            Description = r["Description"]?.ToString() ?? "",
            Notes = r["Notes"]?.ToString() ?? "",
            Comments = r["Comments"]?.ToString() ?? "",
            Category = r["Category"]?.ToString() ?? "",
            CategoryDesc = r["CategoryDesc"]?.ToString() ?? "",
            Series = r["Series"]?.ToString() ?? "",
            Style = r["Style"]?.ToString() ?? "",
            FloorArea = SafeInt(r["FloorArea"]),
            Bedrooms = SafeInt(r["Bedrooms"]),
            Bathrooms = SafeDecimal(r["Bathrooms"]),
            ConstCutOff = SafeDecimal(r["ConstCutOff"]),
            JCExtra = r["JCExtra"]?.ToString() ?? "",
            LandCost = SafeDecimal(r["LandCost"]),
            ConstructionCost = SafeDecimal(r["ConstructionCost"]),
            IncentiveCost = SafeDecimal(r["IncentiveCost"]),
            IncentiveRetail = SafeDecimal(r["IncentiveRetail"]),
            Cost = SafeDecimal(r["Cost"]),
            Pretax = SafeDecimal(r["Pretax"]),
            Tax = SafeDecimal(r["Tax"]),
            Markup = SafeDecimal(r["Markup"]),
            Margin = SafeDecimal(r["Margin"]),
            RoundTo = SafeDecimal(r["Roundto"]),
            COPretax = SafeDecimal(r["COPretax"]),
            COTax = SafeDecimal(r["COTax"]),
            COMarkup = SafeDecimal(r["COMarkup"]),
            Qty = SafeDecimal(r["Qty"], 1),
            Color = r["Color"]?.ToString() ?? "",
            Location = r["Location"]?.ToString() ?? "",
            IncludedOption = (r["IncludedOption"]?.ToString() ?? "0") == "1",
            Inactive = (r["Inactive"]?.ToString() ?? "0") == "1",
            ReadyToPublish = r["ReadyToPublish"]?.ToString() == "True" || r["ReadyToPublish"]?.ToString() == "1",
            IncludeTax = r["IncludeTax"]?.ToString() == "True" || r["IncludeTax"]?.ToString() == "1",
            InSpec = r["IncludedInSpec"]?.ToString() == "True" || r["IncludedInSpec"]?.ToString() == "1",
            PublishedPretax = SafeDecimal(r.ContainsKey("PublishedPretax") ? r["PublishedPretax"] : null),
            PublishedTax = SafeDecimal(r.ContainsKey("PublishedTax") ? r["PublishedTax"] : null),
            PublishedPrice = SafeDecimal(r.ContainsKey("PublishedPrice") ? r["PublishedPrice"] : null),
            PublishedProfit = SafeDecimal(r.ContainsKey("PublishedProfit") ? r["PublishedProfit"] : null),
            PublishedMarkup = SafeDecimal(r.ContainsKey("PublishedMarkup") ? r["PublishedMarkup"] : null),
            PublishedMargin = SafeDecimal(r.ContainsKey("PublishedMargin") ? r["PublishedMargin"] : null),
            PublishedCOPrice = SafeDecimal(r.ContainsKey("PublishedCOPrice") ? r["PublishedCOPrice"] : null),
            PublishedIncentive = SafeDecimal(r.ContainsKey("PublishedIncentive") ? r["PublishedIncentive"] : null),
            RowState = "CLEAN"
        };
    }

    // === VB6 CalcData — Full Calculation Engine ===
    private void CalcData(WorksheetRow row, string changedField = "")
    {
        // Apply rounding if set
        decimal rowRound = row.RoundTo > 0 ? row.RoundTo : (RoundTo > 0 ? RoundTo : 0);

        switch (changedField.ToLower())
        {
            case "pretax":
                if (rowRound > 0)
                    row.Pretax = Math.Round(row.Pretax / rowRound) * rowRound;
                row.Tax = row.IncludeTax ? row.Pretax * TaxRate : 0;
                row.Total = row.Pretax + row.Tax;
                CalcMarkup(row, calcProfit: true, calcMarkup: true, calcMargin: true);
                break;

            case "markup":
                if (row.Cost != 0)
                    row.Pretax = row.Cost * (1 + row.Markup / 100m);
                if (rowRound > 0)
                    row.Pretax = Math.Round(row.Pretax / rowRound) * rowRound;
                row.Tax = row.IncludeTax ? row.Pretax * TaxRate : 0;
                row.Total = row.Pretax + row.Tax;
                CalcMarkup(row, calcProfit: true, calcMargin: true);
                break;

            case "margin":
                if (row.Margin < 100)
                    row.Pretax = row.Cost / (1 - row.Margin / 100m);
                if (rowRound > 0)
                    row.Pretax = Math.Round(row.Pretax / rowRound) * rowRound;
                row.Tax = row.IncludeTax ? row.Pretax * TaxRate : 0;
                row.Total = row.Pretax + row.Tax;
                CalcMarkup(row, calcProfit: true, calcMarkup: true);
                break;

            case "copretax":
                row.COTax = row.IncludeTax ? row.COPretax * TaxRate : 0;
                row.COTotal = row.COPretax + row.COTax;
                CalcMarkup(row, calcCOMarkup: true, calcCOMargin: true);
                break;

            case "comarkup":
                if (row.Cost != 0)
                    row.COPretax = row.Cost * (1 + row.COMarkup / 100m);
                row.COTax = row.IncludeTax ? row.COPretax * TaxRate : 0;
                row.COTotal = row.COPretax + row.COTax;
                CalcMarkup(row, calcCOMargin: true);
                break;

            default:
                // Recalculate everything
                row.Tax = row.IncludeTax ? row.Pretax * TaxRate : 0;
                row.Total = row.Pretax + row.Tax;
                row.COTax = row.IncludeTax ? row.COPretax * TaxRate : 0;
                row.COTotal = row.COPretax + row.COTax;
                CalcMarkup(row, calcProfit: true, calcMarkup: true, calcMargin: true, calcCOMarkup: true, calcCOMargin: true);
                break;
        }

        // IncentiveRetail = IncentiveCost * (1 + Markup/100)
        if (row.IncentiveCost > 0 && row.Markup > 0)
            row.IncentiveRetail = row.IncentiveCost * (1 + row.Markup / 100m);

        CalculateDerivedFields(row);
    }

    private void CalcMarkup(WorksheetRow row,
        bool calcProfit = false, bool calcMarkup = false, bool calcMargin = false,
        bool calcCOMarkup = false, bool calcCOMargin = false)
    {
        if (calcProfit)
            row.Profit = row.Pretax - row.Cost;

        if (calcMarkup)
            row.Markup = row.Cost != 0 ? (row.Pretax - row.Cost) / row.Cost * 100m : 0;

        if (calcMargin)
            row.Margin = row.Pretax != 0 ? (row.Pretax - row.Cost) / row.Pretax * 100m : 0;

        if (calcCOMarkup)
            row.COMarkup = row.Cost != 0 ? (row.COPretax - row.Cost) / row.Cost * 100m : 0;

        if (calcCOMargin)
            row.COMargin = row.COPretax != 0 ? (row.COPretax - row.Cost) / row.COPretax * 100m : 0;
    }

    private void CalculateDerivedFields(WorksheetRow row)
    {
        row.Total = row.Pretax + row.Tax;
        row.COTotal = row.COPretax + row.COTax;
        row.Profit = row.Pretax - row.Cost;
        if (row.FloorArea > 0)
        {
            row.CostPerFt = row.ConstructionCost / row.FloorArea;
            row.PricePerFt = row.Pretax / row.FloorArea;
        }
        // Published profit
        row.PublishedProfit = row.PublishedPretax - row.Cost;
    }

