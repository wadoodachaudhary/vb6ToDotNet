```razor
@namespace HomeFront.Components.Pages

@using System.Data
@using HomeFront.Data

@inject IJSRuntime JSRuntime

<style>
    .fpo-dialog-overlay {
        position: fixed; inset: 0; z-index: 1000;
        background: rgba(0,0,0,0.3); display: flex;
        align-items: center; justify-content: center;
    }
    .fpo-dialog {
        background: #fff; border-radius: 8px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.2);
        width: 580px; max-height: 90vh;
        display: flex; flex-direction: column; overflow: hidden;
    }
    .fpo-header {
        background: linear-gradient(to bottom, #f0f4ff, #dce4f8);
        padding: 12px 16px; border-bottom: 1px solid #c0c8d8;
    }
    .fpo-header h4 { margin: 0; font-size: 15px; color: #003366; }
    .fpo-header p { margin: 2px 0 0; font-size: 12px; color: #555; }
    .fpo-body {
        padding: 16px; overflow-y: auto; flex: 1;
        display: grid; grid-template-columns: 380px 1fr; gap: 12px;
    }
    .fpo-left { display: flex; flex-direction: column; gap: 8px; }
    .fpo-right { display: flex; flex-direction: column; gap: 6px; }
    .fpo-field { display: flex; align-items: flex-start; gap: 8px; }
    .fpo-field label {
        min-width: 100px; text-align: right; font-size: 12px;
        font-weight: 600; padding-top: 4px; color: #333;
    }
    .fpo-field input, .fpo-field select, .fpo-field textarea {
        flex: 1; padding: 4px 8px; border: 1px solid #ced4da;
        border-radius: 4px; font-size: 13px;
    }
    .fpo-field input:focus, .fpo-field select:focus, .fpo-field textarea:focus {
        border-color: #86b7fe; outline: 0;
        box-shadow: 0 0 0 2px rgba(13,110,253,0.15);
    }
    .fpo-section-title {
        font-weight: 700; font-size: 12px; color: #003366;
        margin-bottom: 4px; border-bottom: 1px solid #dee2e6;
        padding-bottom: 2px;
    }
    .fpo-checkbox-row {
        display: flex; align-items: center; gap: 6px;
        font-size: 12px; justify-content: flex-end;
    }
    .fpo-checkbox-row input[type="checkbox"] { width: 14px; height: 14px; }
    .fpo-checkbox-row label { min-width: unset; text-align: left; font-weight: normal; }
    .fpo-attachments {
        border: 1px solid #dee2e6; border-radius: 4px;
        max-height: 180px; overflow-y: auto; padding: 4px;
        background: #fafafa;
    }
    .fpo-attachment-item {
        display: flex; align-items: center; gap: 6px;
        padding: 2px 4px; font-size: 12px;
    }
    .fpo-attachment-item input[type="checkbox"] { width: 14px; height: 14px; }
    .fpo-footer {
        display: flex; justify-content: flex-end; gap: 8px;
        padding: 10px 16px; border-top: 1px solid #dee2e6;
        background: #f8f9fa;
    }
    .fpo-footer button {
        padding: 6px 20px; border: 1px solid #ced4da; border-radius: 4px;
        background: #fff; cursor: pointer; font-size: 13px;
    }
    .fpo-footer button:hover { background: #e9ecef; }
    .fpo-footer button.btn-primary { background: #0d6efd; color: #fff; border-color: #0d6efd; }
    .fpo-footer button.btn-primary:hover { background: #0b5ed7; }
    .fpo-retainage-row {
        display: flex; align-items: center; gap: 6px;
        font-size: 12px;
    }
    .fpo-retainage-row label { min-width: unset; font-weight: normal; }
    .fpo-retainage-row input { width: 50px; text-align: center; }
</style>

@if (IsVisible)
{
    <div class="fpo-dialog-overlay">
        <div class="fpo-dialog">
            <!-- Header -->
            <div class="fpo-header">
                <h4>PO Index Setup</h4>
                <p>Define your standard purchase orders.</p>
            </div>

            <!-- Body -->
            <div class="fpo-body">
                <!-- Left Column -->
                <div class="fpo-left">
                    <div class="fpo-field">
                        <label>Purchase Order</label>
                        <input type="text" @bind="txtPOIndex" @bind:event="oninput"
                               @onfocus="() => SelectAll(nameof(txtPOIndex))"
                               maxlength="20" @bind:after="OnFieldChanged" />
                    </div>
                    <div class="fpo-field">
                        <label>Description</label>
                        <textarea rows="2" @bind="txtDescription" @bind:event="oninput"
                                  maxlength="100" @bind:after="OnFieldChanged"></textarea>
                    </div>
                    <div class="fpo-field">
                        <label>Standard Text</label>
                        <textarea rows="2" @bind="txtStandardText" @bind:event="oninput"
                                  maxlength="2000" @bind:after="OnFieldChanged"></textarea>
                    </div>
                    <div class="fpo-field">
                        <label>Ship Via</label>
                        <input type="text" @bind="txtShipVia" @bind:event="oninput"
                               maxlength="50" @bind:after="OnFieldChanged" />
                    </div>
                    <div class="fpo-field">
                        <label>Free On Board</label>
                        <input type="text" @bind="txtFOB" @bind:event="oninput"
                               maxlength="50" @bind:after="OnFieldChanged" />
                    </div>
                    <div class="fpo-field">
                        <label>Terms</label>
                        <textarea rows="4" @bind="txtTerms" @bind:event="oninput"
                                  maxlength="2000" @bind:after="OnFieldChanged"></textarea>
                    </div>
                    <div class="fpo-field">
                        <label>Notes</label>
                        <textarea rows="4" @bind="txtNotes" @bind:event="oninput"
                                  maxlength="2000" @bind:after="OnFieldChanged"></textarea>
                    </div>
                    <div class="fpo-field">
                        <label>Cost Code</label>
                        <select @bind="SelectedCostCode" @bind:after="OnFieldChanged">
                            <option value="">-- Select --</option>
                            @foreach (var item in CostCodeItems)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="fpo-field">
                        <label>Category</label>
                        <select @bind="SelectedCategory" @bind:after="OnFieldChanged">
                            <option value="">-- Select --</option>
                            @foreach (var item in CategoryItems)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="fpo-right">
                    <div class="fpo-section-title">Type</div>
                    <select @bind="SelectedPOType" @bind:after="OnFieldChanged" style="font-size:12px; padding:3px 6px;">
                        <option value="Purchase Order">Purchase Order</option>
                        <option value="Subcontract">Subcontract</option>
                    </select>

                    <div class="fpo-section-title" style="margin-top:8px;">Options</div>
                    <div class="fpo-checkbox-row">
                        <label for="chkLiens">Require Lien Release</label>
                        <input type="checkbox" id="chkLiens" @bind="chkLiens" @onclick="OnFieldChanged" />
                    </div>
                    <div class="fpo-checkbox-row">
                        <label for="chkMPO">Measurement PO</label>
                        <input type="checkbox" id="chkMPO" @bind="chkMPO" @onclick="OnFieldChanged" />
                    </div>
                    <div class="fpo-checkbox-row">
                        <label for="chkBuildPro">BuildPro</label>
                        <input type="checkbox" id="chkBuildPro" @bind="chkBuildPro" @onclick="OnFieldChanged" />
                    </div>
                    <div class="fpo-checkbox-row">
                        <label for="chkRequiresPaymentApproval">Approval Rqrd</label>
                        <input type="checkbox" id="chkRequiresPaymentApproval" @bind="chkRequiresPaymentApproval" @onclick="OnFieldChanged" />
                    </div>
                    <div class="fpo-checkbox-row">
                        <label for="chkHidePrice">Hide Price</label>
                        <input type="checkbox" id="chkHidePrice" @bind="chkHidePrice" @onclick="OnFieldChanged" />
                    </div>
                    <div class="fpo-checkbox-row">
                        <label for="chkHideQty">Hide Qty</label>
                        <input type="checkbox" id="chkHideQty" @bind="chkHideQty" @onclick="OnFieldChanged" />
                    </div>
                    <div class="fpo-checkbox-row">
                        <label for="chkTotalOnly">Total Only</label>
                        <input type="checkbox" id="chkTotalOnly" @bind="chkTotalOnly" @onclick="OnFieldChanged" />
                    </div>
                    <div class="fpo-retainage-row" style="justify-content: flex-end;">
                        <label>Retainage</label>
                        <input type="text" @bind="txtRetainagePercent"
                               @onfocusout="OnRetainageValidate"
                               @bind:after="OnFieldChanged"
                               style="width:50px; text-align:center; font-size:12px; padding:3px;" />
                    </div>

                    <div class="fpo-section-title" style="margin-top:8px;">Attachments</div>
                    <div class="fpo-attachments">
                        @foreach (var att in AttachmentItems)
                        {
                            <div class="fpo-attachment-item">
                                <input type="checkbox" @bind="att.Selected"
                                       @onclick="OnFieldChanged" />
                                <span>@att.DocumentClass</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="fpo-footer">
                <button class="btn-primary" @onclick="OnOkClick">OK</button>
                <button @onclick="OnCancelClick">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    // === Parameters ===
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<bool> OnClosed { get; set; }

    // === Database ===
    private DbWrapperSqlServer db = new();
    private int DivisionID = 1;
    private string LoginID = "SYSTEM";

    // === State ===
    private string mPOIndex = "";
    private bool mDirty = false;
    private bool mSaved = false;

    // === Form Fields ===
    private string txtPOIndex = "";
    private string txtDescription = "";
    private string txtStandardText = "";
    private string txtShipVia = "";
    private string txtFOB = "";
    private string txtTerms = "";
    private string txtNotes = "";
    private string txtRetainagePercent = "0%";
    private string SelectedPOType = "Purchase Order";
    private string SelectedCostCode = "";
    private string SelectedCategory = "";

    // === Checkboxes ===
    private bool chkLiens = false;
    private bool chkMPO = false;
    private bool chkBuildPro = true;
    private bool chkRequiresPaymentApproval = false;
    private bool chkHidePrice = false;
    private bool chkHideQty = false;
    private bool chkTotalOnly = false;

    // === Combo Data ===
    private List<ComboItem> CostCodeItems = new();
    private List<ComboItem> CategoryItems = new();
    private List<AttachmentItem> AttachmentItems = new();

    // === Models ===
    public class ComboItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    public class AttachmentItem
    {
        public string DocumentClass { get; set; } = "";
        public bool Selected { get; set; } = false;
    }

    // === Public API ===
    public async Task<bool> Edit(string poIndex)
    {
        mPOIndex = poIndex ?? "";
        mSaved = false;
        mDirty = false;
        await LoadFormData();
        IsVisible = true;
        await IsVisibleChanged.InvokeAsync(true);
        StateHasChanged();
        return mSaved;
    }

    // === Load Data ===
    private async Task LoadFormData()
    {
        await LoadComboBoxes();
        await LoadRecord();
        await LoadAttachments();
        mDirty = false;
    }

    private async Task LoadComboBoxes()
    {
        try
        {
            // Load Cost Codes
            var ccRows = await db.QueryAsync(
                "SELECT ISNULL(CostCode,'') + '    ' + ISNULL(Description,'') AS DisplayText, CostCode " +
                "FROM StandardCostCodes WHERE DivisionID = @DivisionID ORDER BY 1",
                new { DivisionID });
            CostCodeItems = ccRows.Select(r => new ComboItem
            {
                Text = r["DisplayText"]?.ToString() ?? "",
                Value = r["CostCode"]?.ToString() ?? ""
            }).ToList();

            // Load Categories
            var catRows = await db.QueryAsync(
                "SELECT ISNULL(Category,'') + '    ' + ISNULL(Description,'') AS DisplayText, Category " +
                "FROM StandardCategories WHERE DivisionID = @DivisionID ORDER BY 1",
                new { DivisionID });
            CategoryItems = catRows.Select(r => new ComboItem
            {
                Text = r["DisplayText"]?.ToString() ?? "",
                Value = r["Category"]?.ToString() ?? ""
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadComboBoxes error: {ex.Message}");
        }
    }

    private async Task LoadRecord()
    {
        try
        {
            var rows = await db.QueryAsync(
                "SELECT * FROM tblPOIndex WHERE DivisionID = @DivisionID AND POIndex = @POIndex",
                new { DivisionID, POIndex = mPOIndex });

            if (!rows.Any())
            {
                // New record defaults
                txtPOIndex = mPOIndex;
                txtDescription = "";
                txtStandardText = "";
                txtShipVia = "";
                txtFOB = "";
                txtTerms = "";
                txtNotes = "";
                SelectedCostCode = "";
                SelectedCategory = "";
                SelectedPOType = "Purchase Order";
                chkBuildPro = true;
                chkMPO = false;
                chkRequiresPaymentApproval = false;
                chkLiens = false;
                chkHidePrice = false;
                chkHideQty = false;
                chkTotalOnly = false;
                txtRetainagePercent = "0%";
            }
            else
            {
                var rs = rows.First();
                txtPOIndex = rs["POIndex"]?.ToString() ?? "";
                txtDescription = rs["Description"]?.ToString() ?? "";
                txtStandardText = rs["StandardText"]?.ToString() ?? "";
                txtShipVia = rs["ShipVia"]?.ToString() ?? "";
                txtFOB = rs["FOB"]?.ToString() ?? "";
                txtTerms = rs["Terms"]?.ToString() ?? "";
                txtNotes = rs["Notes"]?.ToString() ?? "";

                SelectedPOType = (rs["POType"]?.ToString() ?? "") == "Subcontract" ? "Subcontract" : "Purchase Order";
                SelectedCostCode = rs["JCCostCode"]?.ToString() ?? "";
                SelectedCategory = rs["JCCategory"]?.ToString() ?? "";

                chkLiens = rs["RequireLienRelease"]?.ToString() == "True";
                chkMPO = rs["MPO"]?.ToString() == "True";
                chkBuildPro = rs["BuildProEnabled"]?.ToString() == "True";
                chkRequiresPaymentApproval = rs["RequiresPaymentApproval"]?.ToString() == "True";
                chkHidePrice = rs["HidePrice"]?.ToString() == "True";
                chkHideQty = rs["HideQty"]?.ToString() == "True";
                chkTotalOnly = rs["TotalOnly"]?.ToString() == "True";

                var retPct = 0m;
                if (rs["RetainagePercent"] != null && rs["RetainagePercent"] != DBNull.Value)
                    decimal.TryParse(rs["RetainagePercent"]?.ToString(), out retPct);
                txtRetainagePercent = $"{retPct}%";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadRecord error: {ex.Message}");
        }
    }

    private async Task LoadAttachments()
    {
        try
        {
            var sql = @"
                SELECT DISTINCT j.DocumentClass,
                       CASE WHEN p.Class IS NULL THEN 'False' ELSE 'True' END AS Selected
                FROM Attachments j
                LEFT OUTER JOIN POIndexDocuments p ON (j.DocumentClass = p.Class AND p.POIndex = @POIndex)
                WHERE ISNULL(j.DocumentClass, '') <> ''
                ORDER BY 1";
            var rows = await db.QueryAsync(sql, new { POIndex = mPOIndex });
            AttachmentItems = rows.Select(r => new AttachmentItem
            {
                DocumentClass = r["DocumentClass"]?.ToString() ?? "",
                Selected = r["Selected"]?.ToString() == "True"
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadAttachments error: {ex.Message}");
            AttachmentItems = new();
        }
    }

    // === Event Handlers ===
    private void OnFieldChanged()
    {
        mDirty = true;
    }

    private void OnRetainageValidate()
    {
        if (decimal.TryParse(txtRetainagePercent.Replace("%", "").Trim(), out var val))
        {
            val = Math.Min(Math.Max(val, 0), 100);
            txtRetainagePercent = $"{val}%";
        }
        else
        {
            txtRetainagePercent = "0%";
        }
    }

    private void SelectAll(string fieldName)
    {
        // In Blazor, text selection on focus is typically handled via JS interop if needed
    }

    private async Task OnOkClick()
    {
        await SaveData(false);
    }

    private async Task OnCancelClick()
    {
        await SaveData(true);
    }

    // === Validation ===
    private async Task<bool> ValidateData()
    {
        var errors = "";
        if (string.IsNullOrWhiteSpace(txtPOIndex))
            errors += "Purchase order is required";

        if (!string.IsNullOrEmpty(errors))
        {
            await JSRuntime.InvokeVoidAsync("alert", errors);
            return false;
        }
        return true;
    }

    // === Save ===
    private async Task SaveData(bool isCancel)
    {
        if (!mDirty)
        {
            await CloseDialog();
            return;
        }

        if (isCancel)
        {
            var result = await JSRuntime.InvokeAsync<string>("eval",
                "(() => { const r = confirm('This data has changed.\\n\\nDo you want to save the changes?'); return r ? 'Yes' : 'No'; })()");

            if (result == "No")
            {
                await CloseDialog();
                return;
            }
        }

        if (!await ValidateData())
            return;

        try
        {
            txtPOIndex = txtPOIndex.Trim();

            var retainageValue = 0m;
            decimal.TryParse(txtRetainagePercent.Replace("%", "").Trim(), out retainageValue);

            // Update main record
            var updateSql = @"
                UPDATE tblPOIndex SET
                    POIndex = @NewPOIndex,
                    Description = @Description,
                    StandardText = @StandardText,
                    ShipVia = @ShipVia,
                    POType = @POType,
                    FOB = @FOB,
                    Terms = @Terms,
                    Notes = @Notes,
                    RetainagePercent = @RetainagePercent,
                    JCCostCode = @JCCostCode,
                    JCCategory = @JCCategory,
                    MPO = @MPO,
                    BuildProEnabled = @BuildProEnabled,
                    RequireLienRelease = @RequireLienRelease,
                    RequiresPaymentApproval = @RequiresPaymentApproval,
                    HidePrice = @HidePrice,
                    HideQty = @HideQty,
                    TotalOnly = @TotalOnly,
                    UStmp = @LoginID,
                    TStmp = GETDATE()
                WHERE DivisionID = @DivisionID AND POIndex = @OldPOIndex";

            await db.ExecuteAsync(updateSql, new
            {
                NewPOIndex = txtPOIndex,
                Description = txtDescription,
                StandardText = txtStandardText,
                ShipVia = txtShipVia,
                POType = SelectedPOType,
                FOB = txtFOB,
                Terms = txtTerms,
                Notes = txtNotes,
                RetainagePercent = retainageValue,
                JCCostCode = SelectedCostCode,
                JCCategory = SelectedCategory,
                MPO = chkMPO,
                BuildProEnabled = chkBuildPro,
                RequireLienRelease = chkLiens,
                RequiresPaymentApproval = chkRequiresPaymentApproval,
                HidePrice = chkHidePrice,
                HideQty = chkHideQty,
                TotalOnly = chkTotalOnly,
                LoginID,
                DivisionID,
                OldPOIndex = mPOIndex
            });

            // Update doc attachments
            await db.ExecuteAsync(
                "DELETE FROM POIndexDocuments WHERE POIndex = @POIndex",
                new { POIndex = mPOIndex });

            foreach (var att in AttachmentItems.Where(a => a.Selected))
            {
                await db.ExecuteAsync(
                    "INSERT INTO POIndexDocuments(POIndex, Class) VALUES(@POIndex, @Class)",
                    new { POIndex = txtPOIndex, Class = att.DocumentClass });
            }

            // Update retainage for un-issued items
            await db.ExecuteAsync(@"
                UPDATE JobPOIndex
                SET RetainagePercent = @RetainagePercent
                FROM EstimateItems e
                JOIN JobPOIndex j ON (e.Job = j.Job_No AND e.POIndex = j.POIndex)
                WHERE e.POGenBatch = 0
                  AND e.POIndex = @POIndex",
                new { RetainagePercent = retainageValue, POIndex = mPOIndex });

            // Update foreign tables if POIndex name changed
            if (txtPOIndex != mPOIndex)
            {
                var updateTables = new[]
                {
                    "UPDATE CustomPreEstimateItems SET POIndex = @NewPOIndex WHERE POIndex = @OldPOIndex",
                    $"UPDATE EstimateItems SET POIndex = @NewPOIndex WHERE DivisionID = {DivisionID} AND POIndex = @OldPOIndex",
                    $"UPDATE JobPOIndex SET POIndex = @NewPOIndex WHERE DivisionID = {DivisionID} AND POIndex = @OldPOIndex",
                    "UPDATE PayPoints SET POIndex = @NewPOIndex WHERE POIndex = @OldPOIndex",
                    $"UPDATE POAreaVendor SET POIndex = @NewPOIndex WHERE DivisionID = {DivisionID} AND POIndex = @OldPOIndex",
                    $"UPDATE POMaster SET POIndex = @NewPOIndex WHERE DivisionID = {DivisionID} AND POIndex = @OldPOIndex",
                    $"UPDATE tblPhaseItem SET POIndex = @NewPOIndex WHERE DivisionID = {DivisionID} AND POIndex = @OldPOIndex",
                    $"UPDATE tbldbAssemblyDetails SET POIndex = @NewPOIndex WHERE DivisionID = {DivisionID} AND POIndex = @OldPOIndex"
                };

                foreach (var sql in updateTables)
                {
                    try
                    {
                        await db.ExecuteAsync(sql, new { NewPOIndex = txtPOIndex, OldPOIndex = mPOIndex });
                    }
                    catch { /* Ignore errors on foreign table updates */ }
                }
            }

            // Ensure DivisionPOIndexes
            await db.ExecuteAsync($@"
                INSERT INTO DivisionPOIndexes(POIndex, DivisionID, POFormat)
                SELECT p.POIndex, d.DivisionID, p.POFormat
                FROM tblPOIndex p
                JOIN Divisions d ON 1 = 1
                LEFT OUTER JOIN DivisionPOIndexes dp ON (dp.POIndex = p.POIndex AND dp.DivisionID = d.DivisionID)
                WHERE dp.DivisionID IS NULL AND p.DivisionID = {DivisionID}");

            mSaved = true;
            mDirty = false;
            await CloseDialog();
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
            {
                await JSRuntime.InvokeVoidAsync("alert",
                    $"Purchase order \"{txtPOIndex.Trim()}\" has already been entered. Please specify a different value.");
            }
            else
            {
                Console.WriteLine($"SaveData error: {ex.Message}");
                await JSRuntime.InvokeVoidAsync("alert", $"Error saving data: {ex.Message}");
            }
        }
    }

    private async Task CloseDialog()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnClosed.InvokeAsync(mSaved);
    }
}
```