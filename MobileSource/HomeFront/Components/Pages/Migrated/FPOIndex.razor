@namespace HomeFront.Components.Pages

@using System.Data
@using HomeFront.Data
@using Fx.ControlKit
@using Fx.ControlKit.Notifications

@inject ILogger<FPOIndex> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

@if (IsVisible)
{
    <DialogControl Visible="IsVisible"
                   VisibleChanged="OnDialogVisibleChanged"
                   Header="Purchase Order"
                   ShowWindowIcon="true"
                   IsModal="true"
                   Width="650px"
                   Height="auto"
                   Resizable="true"
                   Draggable="true"
                   CloseOnEscape="true"
                   OnClose="OnTitleBarClose"
                   CssClass="fpo-dialog-control">
        <ChildContent>
            <!-- Header — VB6 WizHead1 (frm:70-82): bold caption, indented description, navy icon box right. -->
            <div class="fpo-header">
                <div class="fpo-header-text">
                    <div class="fpo-header-title">PO Index Setup</div>
                    <div class="fpo-header-desc">Define your standard purchase orders.</div>
                </div>
                <div class="fpo-header-iconbox">
                    <img class="fpo-header-icon" src="images/32/PurchaseOrderEdit.ico" alt="" aria-hidden="true" onerror="this.parentElement.style.display='none'" />
                </div>
            </div>

            <!-- Body -->
            <div class="fpo-body">
                <!-- Left Column -->
                <div class="fpo-left">
                    <div class="fpo-field">
                        <label class="fpo-blue-label">Purchase Order</label>
                        <TextBoxControl @bind-Value="txtPOIndex" @bind-Value:after="OnFieldChanged"
                                        MaxLength="20" CssClass="fpo-input fpo-input-narrow"
                                        SelectAllOnDoubleClick="true" />
                    </div>
                    <div class="fpo-field">
                        <label>Description</label>
                        <TextAreaControl @bind-Value="txtDescription" @bind-Value:after="OnFieldChanged"
                                         MaxLength="100" Rows="2" CssClass="fpo-input"
                                         SelectAllOnDoubleClick="true" />
                    </div>
                    <div class="fpo-field">
                        <label>Standard Text</label>
                        <TextAreaControl @bind-Value="txtStandardText" @bind-Value:after="OnFieldChanged"
                                         MaxLength="2000" Rows="2" CssClass="fpo-input"
                                         SelectAllOnDoubleClick="true" />
                    </div>
                    <div class="fpo-field">
                        <label>Ship Via</label>
                        <TextBoxControl @bind-Value="txtShipVia" @bind-Value:after="OnFieldChanged"
                                        MaxLength="50" CssClass="fpo-input fpo-input-narrow-extra"
                                        SelectAllOnDoubleClick="true" />
                    </div>
                    <div class="fpo-field">
                        <label>Free On Board</label>
                        <TextBoxControl @bind-Value="txtFOB" @bind-Value:after="OnFieldChanged"
                                        MaxLength="50" CssClass="fpo-input fpo-input-narrow-extra"
                                        SelectAllOnDoubleClick="true" />
                    </div>
                    <div class="fpo-field">
                        <label>Terms</label>
                        <TextAreaControl @bind-Value="txtTerms" @bind-Value:after="OnFieldChanged"
                                         MaxLength="2000" Rows="4" CssClass="fpo-input"
                                         SelectAllOnDoubleClick="true" />
                    </div>
                    <div class="fpo-field">
                        <label>Notes</label>
                        <TextAreaControl @bind-Value="txtNotes" @bind-Value:after="OnFieldChanged"
                                         MaxLength="2000" Rows="4" CssClass="fpo-input"
                                         SelectAllOnDoubleClick="true" />
                    </div>
                    <div class="fpo-field">
                        <label>Cost Code</label>
                        <DropDownListControl TValue="string" TItem="ComboItem"
                                             DataSource="@CostCodeItems"
                                             ValueFieldName="Value" TextFieldName="Text"
                                             @bind-Value="SelectedCostCode"
                                             @bind-Value:after="OnFieldChanged"
                                             Placeholder="-- Select --"
                                             Width="100%" CssClass="fpo-select" />
                    </div>
                    <div class="fpo-field">
                        <label>Category</label>
                        <DropDownListControl TValue="string" TItem="ComboItem"
                                             DataSource="@CategoryItems"
                                             ValueFieldName="Value" TextFieldName="Text"
                                             @bind-Value="SelectedCategory"
                                             @bind-Value:after="OnFieldChanged"
                                             Placeholder="-- Select --"
                                             Width="100%" CssClass="fpo-select" />
                    </div>
                </div>

                <!-- Right Column -->
                <div class="fpo-right">
                    <div class="fpo-section-title">Type</div>
                    <DropDownListControl TValue="string" TItem="string"
                                         DataSource="@POTypeItems"
                                         @bind-Value="SelectedPOType"
                                         @bind-Value:after="OnFieldChanged"
                                         Width="100%" CssClass="fpo-select" />

                    <div class="fpo-section-title fpo-mt">Options</div>
                    <div class="fpo-options-group">
                        <div class="fpo-checkbox-row">
                            <CheckBoxControl Checked="chkLiens" CheckedChanged="OnLiensChanged" Label="Require Lien Release" CssClass="fpo-chk" />
                        </div>
                        <div class="fpo-checkbox-row">
                            <CheckBoxControl Checked="chkMPO" CheckedChanged="OnMPOChanged" Label="Measurement PO" CssClass="fpo-chk" />
                        </div>
                        <div class="fpo-checkbox-row">
                            <CheckBoxControl Checked="chkWarrantyPO" CheckedChanged="OnWarrantyPOChanged" Label="Warranty PO" CssClass="fpo-chk" />
                        </div>
                        <div class="fpo-checkbox-row">
                            <CheckBoxControl Checked="chkPreConPO" CheckedChanged="OnPreConPOChanged" Label="Precon PO" CssClass="fpo-chk" />
                        </div>
                        <div class="fpo-checkbox-row">
                            <CheckBoxControl Checked="chkBuildPro" CheckedChanged="OnBuildProChanged" Label="Send to BuildPro" CssClass="fpo-chk" />
                        </div>
                        <div class="fpo-checkbox-row">
                            <CheckBoxControl Checked="chkRequiresPaymentApproval" CheckedChanged="OnRequiresPaymentApprovalChanged" Label="Approval Rqrd" CssClass="fpo-chk" />
                        </div>
                        <div class="fpo-checkbox-row">
                            <CheckBoxControl Checked="chkHidePrice" CheckedChanged="OnHidePriceChanged" Label="Hide Price" CssClass="fpo-chk" />
                        </div>
                        <div class="fpo-checkbox-row">
                            <CheckBoxControl Checked="chkHideQty" CheckedChanged="OnHideQtyChanged" Label="Hide Qty" CssClass="fpo-chk" />
                        </div>
                        <div class="fpo-checkbox-row">
                            <CheckBoxControl Checked="chkTotalOnly" CheckedChanged="OnTotalOnlyChanged" Label="Total Only" CssClass="fpo-chk" />
                        </div>
                    </div>
                    <div class="fpo-retainage-row">
                        <label>Retainage</label>
                        <span class="fpo-percent-input">
                            <NumericTextBoxControl TValue="decimal" @bind-Value="RetainagePercent"
                                                   @bind-Value:after="OnRetainageValidate"
                                                   Min="0" Max="100" Format="N0"
                                                   MaxLength="50"
                                                   Width="64px" CssClass="fpo-retainage" />
                            <span class="fpo-pct">%</span>
                        </span>
                    </div>

                    <div class="fpo-section-title fpo-mt">Attachments</div>
                    <div class="fpo-attachments">
                        @foreach (var att in AttachmentItems)
                        {
                            <div class="fpo-attachment-item">
                                <CheckBoxControl Checked="att.Selected"
                                                 CheckedChanged="(v) => OnAttachmentChanged(att, v)"
                                                 Label="@att.DocumentClass" CssClass="fpo-chk" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <!-- Footer (VB6 cmdNav: index 0 = OK, index 1 = Cancel) -->
            <div class="fpo-footer">
                <ButtonControl CssClass="fpo-btn fpo-btn-primary" OnClick="OnOkClick">OK</ButtonControl>
                <ButtonControl CssClass="fpo-btn" OnClick="OnCancelClick">Cancel</ButtonControl>
            </div>
        </FooterContent>
    </DialogControl>
}

<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />

@code {
    // === Parameters (PUBLIC API — FPOFormats depends on these; do not rename/change) ===
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<bool> OnClosed { get; set; }

    private async Task OnDialogVisibleChanged(bool visible)
    {
        IsVisible = visible;
        await IsVisibleChanged.InvokeAsync(visible);
        if (!visible)
        {
            await OnTitleBarClose();
        }
    }

    // === State ===
    private string mPOIndex = "";
    private bool mDirty = false;
    private bool mSaved = false;
    private TaskCompletionSource<bool>? _tcs;
    private Fx.ControlKit.Dialogs.MessageBoxControl? _messageBox;

    // VB6: HFApp.LoginID — stamps UStmp on save.
    private string LoginID => string.IsNullOrEmpty(SessionState.LoginID) ? "SYSTEM" : SessionState.LoginID;

    // === Form Fields ===
    private string txtPOIndex = "";
    private string txtDescription = "";
    private string txtStandardText = "";
    private string txtShipVia = "";
    private string txtFOB = "";
    private string txtTerms = "";
    private string txtNotes = "";
    private decimal RetainagePercent = 0m;
    private string SelectedPOType = "Purchase Order";
    private string SelectedCostCode = "";
    private string SelectedCategory = "";

    // === Checkboxes ===
    private bool chkLiens = false;
    private bool chkMPO = false;
    private bool chkBuildPro = true;
    private bool chkRequiresPaymentApproval = false;
    private bool chkHidePrice = false;
    private bool chkHideQty = false;
    private bool chkTotalOnly = false;
    private bool chkWarrantyPO = false;
    private bool chkPreConPO = false;

    // === Combo Data ===
    private List<ComboItem> CostCodeItems = new();
    private List<ComboItem> CategoryItems = new();
    private List<AttachmentItem> AttachmentItems = new();

    // VB6 cboPOType.AddItem "Purchase Order" / "Subcontract"
    private static readonly List<string> POTypeItems = new() { "Purchase Order", "Subcontract" };

    // === Models ===
    public class ComboItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    public class AttachmentItem
    {
        public string DocumentClass { get; set; } = "";
        public bool Selected { get; set; } = false;
    }

    // === Public API ===
    /// <summary>
    /// Mirrors VB6 Edit() — shows modal dialog, waits for user to OK/Cancel, returns whether data was saved.
    /// </summary>
    public async Task<bool> Edit(string poIndex)
    {
        mPOIndex = poIndex ?? "";
        mSaved = false;
        mDirty = false;
        _tcs = new TaskCompletionSource<bool>();
        await LoadFormData();
        IsVisible = true;
        await IsVisibleChanged.InvokeAsync(true);
        StateHasChanged();
        return await _tcs.Task;
    }

    // === Load Data ===
    private async Task LoadFormData()
    {
        await LoadComboBoxes();
        await LoadRecord();
        await LoadAttachments();
        mDirty = false;
    }

    private async Task LoadComboBoxes()
    {
        try
        {
            // VB6 Form_Load branches the DISPLAY format on AccountingSystem = asQuickBooks (3):
            //   QuickBooks -> show Description only; everything else -> "CostCode    Description".
            // The stored Value (CostCode / Category) is the same either way.
            bool isQuickBooks = await IsQuickBooksAsync();

            var ccDisplay = isQuickBooks
                ? "ISNULL(Description,'')"
                : "ISNULL(CostCode,'') + '    ' + ISNULL(Description,'')";
            var ccRows = await db.QueryAsync(
                $"SELECT {ccDisplay} AS DisplayText, CostCode " +
                "FROM StandardCostCodes WHERE DivisionID = @DivisionID ORDER BY 1",
                new { SessionState.DivisionID });
            CostCodeItems = ccRows.Select(r => new ComboItem
            {
                Text = r["DisplayText"]?.ToString() ?? "",
                Value = r["CostCode"]?.ToString() ?? ""
            }).ToList();

            var catDisplay = isQuickBooks
                ? "ISNULL(Description,'')"
                : "ISNULL(Category,'') + '    ' + ISNULL(Description,'')";
            var catRows = await db.QueryAsync(
                $"SELECT {catDisplay} AS DisplayText, Category " +
                "FROM StandardCategories WHERE DivisionID = @DivisionID ORDER BY 1",
                new { SessionState.DivisionID });
            CategoryItems = catRows.Select(r => new ComboItem
            {
                Text = r["DisplayText"]?.ToString() ?? "",
                Value = r["Category"]?.ToString() ?? ""
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadComboBoxes error");
        }
    }

    private async Task LoadRecord()
    {
        try
        {
            var rows = await db.QueryAsync(
                "SELECT * FROM tblPOIndex WHERE DivisionID = @DivisionID AND POIndex = @POIndex",
                new { SessionState.DivisionID, POIndex = mPOIndex });

            if (!rows.Any())
            {
                // New record defaults (VB6 rs.EOF branch)
                txtPOIndex = mPOIndex;
                txtDescription = "";
                txtStandardText = "";
                txtShipVia = "";
                txtFOB = "";
                txtTerms = "";
                txtNotes = "";
                SelectedCostCode = "";
                SelectedCategory = "";
                SelectedPOType = "Purchase Order";
                chkBuildPro = true;
                chkMPO = false;
                chkRequiresPaymentApproval = false;
                chkLiens = false;
                chkHidePrice = false;
                chkHideQty = false;
                chkTotalOnly = false;
                chkWarrantyPO = false;
                chkPreConPO = false;
                RetainagePercent = 0m;
            }
            else
            {
                var rs = rows.First();
                txtPOIndex = rs["POIndex"]?.ToString() ?? "";
                txtDescription = rs["Description"]?.ToString() ?? "";
                txtStandardText = rs["StandardText"]?.ToString() ?? "";
                txtShipVia = rs["ShipVia"]?.ToString() ?? "";
                txtFOB = rs["FOB"]?.ToString() ?? "";
                txtTerms = rs["Terms"]?.ToString() ?? "";
                txtNotes = rs["Notes"]?.ToString() ?? "";

                SelectedPOType = (rs["POType"]?.ToString() ?? "") == "Subcontract" ? "Subcontract" : "Purchase Order";
                SelectedCostCode = rs["JCCostCode"]?.ToString() ?? "";
                SelectedCategory = rs["JCCategory"]?.ToString() ?? "";

                chkLiens = rs["RequireLienRelease"]?.ToString() == "True";
                chkMPO = rs["MPO"]?.ToString() == "True";
                chkBuildPro = rs["BuildProEnabled"]?.ToString() == "True";
                chkRequiresPaymentApproval = rs["RequiresPaymentApproval"]?.ToString() == "True";
                chkHidePrice = rs["HidePrice"]?.ToString() == "True";
                chkHideQty = rs["HideQty"]?.ToString() == "True";
                chkTotalOnly = rs["TotalOnly"]?.ToString() == "True";
                chkWarrantyPO = rs["WarrantyPO"]?.ToString() == "True";
                chkPreConPO = rs["PreconPO"]?.ToString() == "True";

                // VB6: Val("" & rs("RetainagePercent")) & "%"
                var retPct = 0m;
                if (rs["RetainagePercent"] != null && rs["RetainagePercent"] != DBNull.Value)
                    decimal.TryParse(rs["RetainagePercent"]?.ToString(), out retPct);
                RetainagePercent = retPct;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadRecord error");
        }
    }

    private async Task LoadAttachments()
    {
        try
        {
            // VB6 (the "OLD" block it actually executes): distinct attachment doc classes,
            // pre-checked when already linked in POIndexDocuments.
            var sql = @"
                SELECT DISTINCT j.DocumentClass,
                       CASE WHEN p.Class IS NULL THEN 'False' ELSE 'True' END AS Selected
                FROM Attachments j
                LEFT OUTER JOIN POIndexDocuments p ON (j.DocumentClass = p.Class AND p.POIndex = @POIndex)
                WHERE ISNULL(j.DocumentClass, '') <> ''
                ORDER BY 1";
            var rows = await db.QueryAsync(sql, new { POIndex = mPOIndex });
            AttachmentItems = rows.Select(r => new AttachmentItem
            {
                DocumentClass = r["DocumentClass"]?.ToString() ?? "",
                Selected = r["Selected"]?.ToString() == "True"
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadAttachments error");
            AttachmentItems = new();
        }
    }

    /// <summary>VB6 HFApp.Options(AccountingSystem) == asQuickBooks (3). Read from system_setup.</summary>
    private async Task<bool> IsQuickBooksAsync()
    {
        try
        {
            var dt = db.SqlExec(
                "SELECT AccountingSystem FROM system_setup WHERE id=@DivisionID",
                new { SessionState.DivisionID });
            if (dt.Rows.Count > 0 && dt.Rows[0][0] != DBNull.Value
                && int.TryParse(dt.Rows[0][0]?.ToString(), out var sys))
                return sys == 3; // asQuickBooks
        }
        catch { /* column may not exist — treat as non-QuickBooks */ }
        return false;
    }

    // === Event Handlers ===
    private void OnFieldChanged()
    {
        mDirty = true;
    }

    // VB6: chk*_Click / cbo*_Click → mDirty = True
    private void OnLiensChanged(bool v) { chkLiens = v; mDirty = true; }
    private void OnMPOChanged(bool v) { chkMPO = v; mDirty = true; }
    private void OnBuildProChanged(bool v) { chkBuildPro = v; mDirty = true; }
    private void OnRequiresPaymentApprovalChanged(bool v) { chkRequiresPaymentApproval = v; mDirty = true; }
    private void OnHidePriceChanged(bool v) { chkHidePrice = v; mDirty = true; }
    private void OnHideQtyChanged(bool v) { chkHideQty = v; mDirty = true; }
    private void OnTotalOnlyChanged(bool v) { chkTotalOnly = v; mDirty = true; }
    private void OnWarrantyPOChanged(bool v) { chkWarrantyPO = v; mDirty = true; }
    private void OnPreConPOChanged(bool v) { chkPreConPO = v; mDirty = true; }

    // VB6 lstAttachments_ItemCheck → mDirty = True
    private void OnAttachmentChanged(AttachmentItem att, bool v)
    {
        att.Selected = v;
        mDirty = true;
    }

    /// <summary>
    /// Mirrors VB6 HFApp.Options.ValueByName — two-tier lookup: system_setup column first,
    /// then the appoptions table (where BuildProCompanyCode lives).
    /// </summary>
    private async Task<string> GetOptionValue(string optionName)
    {
        try
        {
            var dt = db.SqlExec(
                $"SELECT {optionName} FROM system_setup WHERE id=@DivisionID",
                new { SessionState.DivisionID });
            if (dt.Rows.Count > 0 && dt.Rows[0][0] != DBNull.Value)
                return dt.Rows[0][0]?.ToString() ?? "";
        }
        catch { /* column may not exist in system_setup — fall through */ }

        try
        {
            var dt = db.SqlExec(
                @"SELECT optionvalue FROM appoptions
                  WHERE ISNULL(divisionid,0) IN (0, @DivisionID)
                    AND optionname = @OptionName
                  ORDER BY divisionid DESC",
                new { SessionState.DivisionID, OptionName = optionName });
            if (dt.Rows.Count > 0 && dt.Rows[0][0] != DBNull.Value)
                return dt.Rows[0][0]?.ToString() ?? "";
        }
        catch { /* non-critical */ }

        return "";
    }

    // VB6 txtRetainagePercent_Validate: Min(Max(Val,0),100) & "%". NumericTextBoxControl
    // already clamps to Min/Max; this keeps the dirty flag + normalizes on commit.
    private void OnRetainageValidate()
    {
        RetainagePercent = Math.Min(Math.Max(RetainagePercent, 0), 100);
        mDirty = true;
    }

    // VB6 cmdNav index 0 (OK, Default) → SaveData(False): no prompt.
    private async Task OnOkClick()
    {
        await SaveData(false);
    }

    // VB6 cmdNav index 1 (Cancel) → SaveData(True): prompt Yes/No/Cancel.
    private async Task OnCancelClick()
    {
        await SaveData(true);
    }

    // HHM-407: title-bar ✕ = VB6 window close — unload without the save prompt.
    private async Task OnTitleBarClose()
    {
        mSaved = false;
        await CloseDialog();
    }

    // === Validation (VB6 ValidateData) ===
    private async Task<bool> ValidateData()
    {
        var errors = "";
        if (string.IsNullOrWhiteSpace(txtPOIndex))
            errors += "Purchase order is required\n";

        // VB6: when BuildProCompanyCode is set and Send-to-BuildPro is checked,
        // Cost Code and Category are both required.
        if (!string.IsNullOrEmpty(await GetOptionValue("BuildProCompanyCode")) && chkBuildPro)
        {
            if (string.IsNullOrWhiteSpace(SelectedCostCode))
                errors += "Cost Code is required\n";
            if (string.IsNullOrWhiteSpace(SelectedCategory))
                errors += "Category is required\n";
        }

        if (!string.IsNullOrEmpty(errors))
        {
            // HHM-413: VB6 frm:766 MsgBox s, vbExclamation, App.ProductName — a modal
            // warning that stays up until OK, not a transient toast.
            if (_messageBox != null)
                await _messageBox.ShowAsync(errors.TrimEnd('\n'),
                    title: "Precision Builder",
                    buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.Ok,
                    icon: "warning");
            return false;
        }
        return true;
    }

    // === Save (VB6 SaveData) ===
    private async Task SaveData(bool prompt)
    {
        // VB6: If Not mDirty Then SaveData = True : Exit (treated as success, closes).
        if (!mDirty)
        {
            mSaved = false;
            await CloseDialog();
            return;
        }

        // VB6: rc = vbYes; If prompt Then rc = MsgBox(...vbYesNoCancel)
        //   vbNo     -> SaveData = True (close without saving)
        //   vbCancel -> stay open
        if (prompt)
        {
            if (_messageBox == null) return;
            var rc = await _messageBox.ShowAsync(
                "This data has changed.\n\nDo you want to save the changes?",
                title: "Purchase Order",
                buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel,
                icon: "warning");

            if (rc == Fx.ControlKit.Dialogs.MessageBoxResult.Cancel)
                return;
            if (rc == Fx.ControlKit.Dialogs.MessageBoxResult.No)
            {
                mSaved = false;
                await CloseDialog();
                return;
            }
        }

        if (!await ValidateData())
            return;

        try
        {
            // VB6 txtPOIndex_Validate: Trim
            txtPOIndex = txtPOIndex.Trim();

            var retainageValue = Math.Min(Math.Max(RetainagePercent, 0), 100);

            // Update main record
            var updateSql = @"
                UPDATE tblPOIndex SET
                    POIndex = @NewPOIndex,
                    Description = @Description,
                    StandardText = @StandardText,
                    ShipVia = @ShipVia,
                    POType = @POType,
                    FOB = @FOB,
                    Terms = @Terms,
                    Notes = @Notes,
                    RetainagePercent = @RetainagePercent,
                    JCCostCode = @JCCostCode,
                    JCCategory = @JCCategory,
                    MPO = @MPO,
                    WarrantyPO = @WarrantyPO,
                    PreconPO = @PreconPO,
                    BuildProEnabled = @BuildProEnabled,
                    RequireLienRelease = @RequireLienRelease,
                    RequiresPaymentApproval = @RequiresPaymentApproval,
                    HidePrice = @HidePrice,
                    HideQty = @HideQty,
                    TotalOnly = @TotalOnly,
                    UStmp = @LoginID,
                    TStmp = GETDATE()
                WHERE DivisionID = @DivisionID AND POIndex = @OldPOIndex";

            await db.ExecuteAsync(updateSql, new
            {
                NewPOIndex = txtPOIndex,
                Description = txtDescription,
                StandardText = txtStandardText,
                ShipVia = txtShipVia,
                POType = SelectedPOType,
                FOB = txtFOB,
                Terms = txtTerms,
                Notes = txtNotes,
                RetainagePercent = retainageValue,
                JCCostCode = SelectedCostCode,
                JCCategory = SelectedCategory,
                MPO = chkMPO,
                WarrantyPO = chkWarrantyPO,
                PreconPO = chkPreConPO,
                BuildProEnabled = chkBuildPro,
                RequireLienRelease = chkLiens,
                RequiresPaymentApproval = chkRequiresPaymentApproval,
                HidePrice = chkHidePrice,
                HideQty = chkHideQty,
                TotalOnly = chkTotalOnly,
                LoginID,
                SessionState.DivisionID,
                OldPOIndex = mPOIndex
            });

            // Update doc attachments
            await db.ExecuteAsync(
                "DELETE FROM POIndexDocuments WHERE POIndex = @POIndex",
                new { POIndex = mPOIndex });

            foreach (var att in AttachmentItems.Where(a => a.Selected))
            {
                await db.ExecuteAsync(
                    "INSERT INTO POIndexDocuments(POIndex, Class) VALUES(@POIndex, @Class)",
                    new { POIndex = txtPOIndex, Class = att.DocumentClass });
            }

            // Update retainage for un-issued items
            await db.ExecuteAsync(@"
                UPDATE JobPOIndex
                SET RetainagePercent = @RetainagePercent
                FROM EstimateItems e
                JOIN JobPOIndex j ON (e.Job = j.Job_No AND e.POIndex = j.POIndex)
                WHERE e.POGenBatch = 0
                  AND e.POIndex = @POIndex",
                new { RetainagePercent = retainageValue, POIndex = mPOIndex });

            // Update foreign tables if POIndex name changed (VB6 On Error Resume Next block)
            if (txtPOIndex != mPOIndex)
            {
                var updateTables = new[]
                {
                    "UPDATE CustomPreEstimateItems SET POIndex = @NewPOIndex WHERE POIndex = @OldPOIndex",
                    "UPDATE EstimateItems SET POIndex = @NewPOIndex WHERE DivisionID = @DivisionID AND POIndex = @OldPOIndex",
                    "UPDATE JobPOIndex SET POIndex = @NewPOIndex WHERE DivisionID = @DivisionID AND POIndex = @OldPOIndex",
                    "UPDATE PayPoints SET POIndex = @NewPOIndex WHERE POIndex = @OldPOIndex",
                    "UPDATE POAreaVendor SET POIndex = @NewPOIndex WHERE DivisionID = @DivisionID AND POIndex = @OldPOIndex",
                    "UPDATE POMaster SET POIndex = @NewPOIndex WHERE DivisionID = @DivisionID AND POIndex = @OldPOIndex",
                    "UPDATE tblPhaseItem SET POIndex = @NewPOIndex WHERE DivisionID = @DivisionID AND POIndex = @OldPOIndex",
                    "UPDATE tbldbAssemblyDetails SET POIndex = @NewPOIndex WHERE DivisionID = @DivisionID AND POIndex = @OldPOIndex"
                };

                foreach (var sql in updateTables)
                {
                    try
                    {
                        await db.ExecuteAsync(sql, new
                        {
                            NewPOIndex = txtPOIndex,
                            OldPOIndex = mPOIndex,
                            SessionState.DivisionID
                        });
                    }
                    catch { /* non-critical */ }
                }
            }

            // Ensure DivisionPOIndexes (VB6 final insert)
            await db.ExecuteAsync(@"
                INSERT INTO DivisionPOIndexes(POIndex, DivisionID, POFormat)
                SELECT p.POIndex, d.DivisionID, p.POFormat
                FROM tblPOIndex p
                JOIN Divisions d ON 1 = 1
                LEFT OUTER JOIN DivisionPOIndexes dp ON (dp.POIndex = p.POIndex AND dp.DivisionID = d.DivisionID)
                WHERE dp.DivisionID IS NULL AND p.DivisionID = @DivisionID",
                new { SessionState.DivisionID });

            mSaved = true;
            mDirty = false;
            await CloseDialog();
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
            {
                // HHM-413: VB6 frm:752 MsgBox vbInformation, App.ProductName — modal, not a toast.
                if (_messageBox != null)
                    await _messageBox.ShowAsync(
                        $"Purchase order \"{txtPOIndex.Trim()}\" has already been entered. Please specify a different value.",
                        title: "Precision Builder",
                        buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.Ok,
                        icon: "info");
            }
            else
            {
                Logger.LogError(ex, "SaveData error");
                Notifications.Error($"Error saving data: {ex.Message}");
            }
        }
    }

    private async Task CloseDialog()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnClosed.InvokeAsync(mSaved);
        _tcs?.TrySetResult(mSaved);
    }
}
