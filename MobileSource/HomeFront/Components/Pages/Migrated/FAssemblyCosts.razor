```razor
@page "/assembly-costs"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Assembly Costs - HomeFront</PageTitle>

<style>
    .assembly-costs-container {
        font-family: 'MS Sans Serif', Arial, sans-serif;
        font-size: 13px;
        padding: 10px;
        max-width: 100%;
    }

    .header-panel {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 12px;
    }

    .header-icon {
        width: 32px;
        height: 32px;
        margin-top: 4px;
    }

    .header-fields {
        flex: 1;
    }

    .field-row {
        display: flex;
        align-items: center;
        margin-bottom: 4px;
    }

    .field-row label {
        min-width: 130px;
        text-align: right;
        padding-right: 10px;
        font-size: 13px;
        color: #333;
    }

    .field-row .field-value {
        font-size: 13px;
        color: #333;
    }

    .field-row .field-value.bold {
        font-weight: 700;
    }

    .grid-container {
        margin-bottom: 12px;
    }

    .footer-bar {
        display: flex;
        justify-content: flex-end;
        padding-top: 8px;
    }

    .btn-cancel {
        padding: 6px 20px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #f7f7f7;
        cursor: pointer;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-cancel:hover {
        background: #e8e8e8;
    }

    .total-row {
        font-weight: bold;
    }
</style>

<div class="assembly-costs-container">
    <!-- Header Info -->
    <div class="header-panel">
        <div class="header-fields">
            <div class="field-row">
                <label>Community/Phase</label>
                <span class="field-value">@CommunityDisplay</span>
            </div>
            <div class="field-row">
                <label>Model/Option</label>
                <span class="field-value">@ModelOptionDisplay</span>
            </div>
            <div class="field-row">
                <label>Assembly</label>
                <span class="field-value bold">@AssemblyDisplay</span>
            </div>
        </div>
    </div>

    <!-- Data Grid -->
    <div class="grid-container">
        <HfGrid @ref="CostsGrid"
                TValue="AssemblyCostRow"
                DataSource="@CostsData"
                AllowSorting="true"
                AllowResizing="true"
                AllowSelection="true"
                EnableHover="true"
                Height="500px"
                SelectionSettingsRef="@selectionSettings">
            <HfGridColumnsBase>
                <HfGridColumn Field="@nameof(AssemblyCostRow.POIndex)" HeaderText="PO Index" Width="90px" />
                <HfGridColumn Field="@nameof(AssemblyCostRow.PODesc)" HeaderText="PO Description" Width="180px" />
                <HfGridColumn Field="@nameof(AssemblyCostRow.Phase)" HeaderText="Phase" Width="80px" />
                <HfGridColumn Field="@nameof(AssemblyCostRow.Item)" HeaderText="Item" Width="80px" />
                <HfGridColumn Field="@nameof(AssemblyCostRow.ItemDesc)" HeaderText="Description" Width="200px" />
                <HfGridColumn Field="@nameof(AssemblyCostRow.OrderQty)" HeaderText="Order Qty" Width="90px"
                              Format="N2" TextAlign="TextAlign.Right" Type="ColumnType.Number" />
                <HfGridColumn Field="@nameof(AssemblyCostRow.Rate)" HeaderText="Rate" Width="90px"
                              Format="C2" TextAlign="TextAlign.Right" Type="ColumnType.Number" />
                <HfGridColumn Field="@nameof(AssemblyCostRow.Total)" HeaderText="Total" Width="100px"
                              Format="C2" TextAlign="TextAlign.Right" Type="ColumnType.Number" />
                <HfGridColumn Field="@nameof(AssemblyCostRow.OrderUOM)" HeaderText="UOM" Width="70px" />
                <HfGridColumn Field="@nameof(AssemblyCostRow.Vendor)" HeaderText="Vendor" Width="80px" />
                <HfGridColumn Field="@nameof(AssemblyCostRow.VendorDesc)" HeaderText="Vendor Name" Width="180px" />
            </HfGridColumnsBase>
        </HfGrid>
    </div>

    <!-- Footer -->
    <div class="footer-bar">
        <button class="btn-cancel" @onclick="OnCancelClick">
            &amp;Cancel
        </button>
    </div>
</div>

@code {
    // === Parameters ===
    [Parameter] public long WorksheetID { get; set; }
    [Parameter] public string Community { get; set; } = "";
    [Parameter] public string CommunityPhase { get; set; } = "";
    [Parameter] public string Model { get; set; } = "";
    [Parameter] public string OptionID { get; set; } = "";
    [Parameter] public string Assembly { get; set; } = "";

    // === Database ===
    private DbWrapperSqlServer db = new();
    private int DivisionID = 1;

    // === Display Fields ===
    private string CommunityDisplay = "";
    private string ModelOptionDisplay = "";
    private string AssemblyDisplay = "";

    // === Grid ===
    private HfGrid<AssemblyCostRow>? CostsGrid;
    private List<AssemblyCostRow> CostsData = new();

    private HfSelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        await ShowForm(WorksheetID, Community, CommunityPhase, Model, OptionID, Assembly);
    }

    // === ShowForm — main entry point (mirrors VB6 ShowForm) ===
    public async Task ShowForm(long worksheetId, string community, string communityPhase,
                                string model, string optionId, string assembly)
    {
        WorksheetID = worksheetId;
        Community = community;
        CommunityPhase = communityPhase;
        Model = model;
        OptionID = optionId;
        Assembly = assembly;

        try
        {
            // Load header info
            await LoadHeaderAsync();

            // Load cost details
            await LoadCostDetailsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FAssemblyCosts.ShowForm] Error: {ex.Message}\n{ex.StackTrace}");
        }

        await InvokeAsync(StateHasChanged);
    }

    // === Load Header Info ===
    private async Task LoadHeaderAsync()
    {
        var sql = @"
            SELECT community + ISNULL('.' + communityphase,'') + ' -- ' + CommunityDesc + ISNULL(' ' + CommunityPhaseDesc,'') AS CommunityDisplay
                  ,model + ISNULL(' / ' + NULLIF(optionid,''),'') AS ModelOptionDisplay
                  ,AssemblyDesc
              FROM assemblylist
             WHERE community = @Community
               AND communityphase = @CommunityPhase
               AND assembly = @Assembly
               AND model = @Model
               AND optionid = @OptionID
               AND DivisionID = @DivisionID";

        var rows = await db.QueryAsync(sql, new
        {
            Community = Community ?? "",
            CommunityPhase = CommunityPhase ?? "",
            Assembly = Assembly ?? "",
            Model = Model ?? "",
            OptionID = OptionID ?? "",
            DivisionID
        });

        if (rows.Any())
        {
            var row = rows.First();
            CommunityDisplay = row["CommunityDisplay"]?.ToString() ?? "";
            ModelOptionDisplay = row["ModelOptionDisplay"]?.ToString() ?? "";
            AssemblyDisplay = row["AssemblyDesc"]?.ToString() ?? "";
        }
    }

    // === Load Cost Details ===
    private async Task LoadCostDetailsAsync()
    {
        var sql = @"
            SELECT i.poindex AS POIndex
                  ,ISNULL(p.description,'** unknown **') AS PODesc
                  ,c.Phase
                  ,c.Item
                  ,ISNULL(i.description,'** unknown **') AS ItemDesc
                  ,c.OrderQty
                  ,c.Rate
                  ,i.OrderUOM
                  ,c.Vendor
                  ,ISNULL(v.Vendor_name,'** unknown **') AS VendorDesc
              FROM tblSalesSheetDetails d
                   JOIN tblSalesSheetMaster m ON (m.worksheet = d.Worksheet)
                   LEFT OUTER JOIN tblSalesSheetCosts c ON (d.Worksheet=c.Worksheet AND d.community=c.community AND d.communityphase=c.communityphase AND d.model=c.model AND d.optionid=c.optionid AND d.assembly=c.assembly)
                   LEFT OUTER JOIN tblPhaseItem i ON (i.DivisionID = m.DivisionID AND c.Phase=i.Phase AND c.Item=i.Item)
                   LEFT OUTER JOIN tblPOIndex p ON (i.DivisionID = p.DivisionID AND i.poindex=p.poindex)
                   LEFT OUTER JOIN tblVendors v ON (c.Vendor=v.Vendor_ID AND v.DivisionID = m.DivisionID)
             WHERE d.Worksheet = @WorksheetID
               AND d.community = @Community
               AND d.communityphase = @CommunityPhase
               AND d.model = @Model
               AND d.optionid = @OptionID
               AND d.assembly = @Assembly
               AND m.DivisionID = @DivisionID
             ORDER BY p.poindex, c.sequence";

        var rows = await db.QueryAsync(sql, new
        {
            WorksheetID,
            Community = Community ?? "",
            CommunityPhase = CommunityPhase ?? "",
            Model = Model ?? "",
            OptionID = OptionID ?? "",
            Assembly = Assembly ?? "",
            DivisionID
        });

        var items = new List<AssemblyCostRow>();
        double sum = 0;

        foreach (var row in rows)
        {
            var orderQty = ToDouble(row.ContainsKey("OrderQty") ? row["OrderQty"] : null);
            var rate = ToDouble(row.ContainsKey("Rate") ? row["Rate"] : null);
            var total = Math.Round(orderQty * rate, 2);
            sum += total;

            items.Add(new AssemblyCostRow
            {
                POIndex = row["POIndex"]?.ToString() ?? "",
                PODesc = row["PODesc"]?.ToString() ?? "",
                Phase = row["Phase"]?.ToString() ?? "",
                Item = row["Item"]?.ToString() ?? "",
                ItemDesc = row["ItemDesc"]?.ToString() ?? "",
                OrderQty = orderQty,
                Rate = rate,
                Total = total,
                OrderUOM = row["OrderUOM"]?.ToString() ?? "",
                Vendor = row["Vendor"]?.ToString() ?? "",
                VendorDesc = row["VendorDesc"]?.ToString() ?? "",
                IsTotalRow = false
            });
        }

        // Add summary total row
        items.Add(new AssemblyCostRow
        {
            POIndex = "",
            PODesc = "",
            Phase = "",
            Item = "",
            ItemDesc = "",
            OrderQty = 0,
            Rate = 0,
            Total = sum,
            OrderUOM = "",
            Vendor = "",
            VendorDesc = "",
            IsTotalRow = true
        });

        CostsData = items;
    }

    // === Event Handlers ===
    private void OnCancelClick()
    {
        NavigationManager.NavigateTo("javascript:history.back()");
    }

    // === Helpers ===
    private double ToDouble(object? val)
    {
        if (val == null || val == DBNull.Value) return 0;
        return double.TryParse(val.ToString(), out var result) ? result : 0;
    }

    // === Model ===
    public class AssemblyCostRow
    {
        public string POIndex { get; set; } = "";
        public string PODesc { get; set; } = "";
        public string Phase { get; set; } = "";
        public string Item { get; set; } = "";
        public string ItemDesc { get; set; } = "";
        public double OrderQty { get; set; }
        public double Rate { get; set; }
        public double Total { get; set; }
        public string OrderUOM { get; set; } = "";
        public string Vendor { get; set; } = "";
        public string VendorDesc { get; set; } = "";
        public bool IsTotalRow { get; set; }
    }
}
```