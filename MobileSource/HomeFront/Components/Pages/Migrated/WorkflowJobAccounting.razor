@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-30
   Changes     :
     - Port VB6 Job Accounting workflow diagram (Vendor / Invoice
       Approval → Invoices → Journal Entries / Job → Billing →
       Customer). Same DiagramControl pattern as the Estimating /
       Project Management workflow tabs.
     - Node click targets follow the AUTHORITATIVE VB6 dispatcher: the
       per-node `Select Case Task(Index).Tag` in HFEst/FHome2.frm. The
       rule: where VB6 calls FMain.RunTask / HFApp.RunTask (an action
       INSIDE the estimating app) the node is wired to the migrated route;
       where VB6 calls Shell(<external>.exe) — i.e. the work lives in a
       SEPARATE app not part of this migration — or the case is empty, the
       node renders but doesn't navigate (same as the PM workflow's RFI's
       node). VB6 source line → mapping:
         Invoice Approval → Shell(hfpayables.exe)        → (none, external app)
         Vendor           → RunTask("vendor setup")      → /vendor
         Invoices         → Shell(hfpayables.exe)        → (none, external app)
         Journal Entries  → HFApp.RunTask("JournalEntries") → (none, FJournalEntry not migrated)
         Time & Equipment → Shell(hfworkticket.exe)      → (none, external app)
         Job              → RunTask("Job setup")         → /job-setup
         Cost Plus Billing→ Shell(hfworkticket.exe)      → (none, external app)
         Inquiry          → (empty case — no-op in VB6)  → (none)
         Progress Billing → RunTask("Billing") → FEstimateItems(fceBilling) → /estimate-items/Billing
         Customer         → RunTask("EditCustomer|…")    → /customer
       Net: 4 live links (Vendor, Job, Progress Billing, Customer); the
       other 6 match VB6, where they launched the external Payables /
       work-ticket apps or an unmigrated form.
   ───────────────────────────────────────────────────────────────── *@
@page "/workflow-job-accounting"
@rendermode InteractiveServer

@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications

<PageTitle>HSMC - Job Accounting Workflow</PageTitle>

<h3 style="margin: 16px 0 8px 16px; color: #2C5F8A;">Job Accounting Workflow</h3>

<DiagramControl Nodes="@_nodes"
           Connectors="@_connectors"
           Width="1000"
           Height="720"
           NodeClicked="OnNodeClicked" />

@code {
    // ── Icon path helper ────────────────────────────────────────────────
    private const string IconBase = "images/workflow/icons";

    // ── Shared style: transparent background, icon above label ──────────
    private static DiagramNode MakeNode(
        string id, string label, double x, double y,
        string icon, string? navigateUrl = null,
        double w = 90, double h = 80) => new()
    {
        Id = id,
        Label = label,
        OffsetX = x,
        OffsetY = y,
        Width = w,
        Height = h,
        Shape = DiagramControlShape.Rectangle,
        FillColor = "transparent",
        StrokeColor = "transparent",
        StrokeWidth = 0,
        TextColor = "#2C5F8A",
        CornerRadius = 0,
        BackgroundImage = $"{IconBase}/{icon}",
        BackgroundImageFit = ImageFit.Contain,
        BackgroundImageOpacity = 1.0,
        BackgroundImagePadding = 0,
        NavigateUrl = navigateUrl,
        Tooltip = label
    };

    // ── Connector style ─────────────────────────────────────────────────
    private const string ArrowColor = "#4A7FB5";

    private static DiagramConnector MakeConn(
        string id, string from, string to,
        DiagramPort srcPort = DiagramPort.Auto,
        DiagramPort tgtPort = DiagramPort.Auto,
        ConnectorType type = ConnectorType.Straight) => new()
    {
        Id = id,
        SourceId = from,
        TargetId = to,
        Type = type,
        StrokeColor = ArrowColor,
        StrokeWidth = 2,
        ShowArrow = true,
        SourcePort = srcPort,
        TargetPort = tgtPort
    };

    // ── Nodes ───────────────────────────────────────────────────────────
    //
    //  Row 1 (y=70):                Invoice Approval
    //  Row 2 (y=235):  Vendor   Invoices            Journal Entries
    //  Row 3 (y=425):  Time & Equipment   Job       Cost Plus Billing
    //  Row 4 (y=605):              Inquiry  Progress Billing  Customer
    //
    private readonly List<DiagramNode> _nodes = new()
    {
        // ── Row 1 ──
        MakeNode("invoice-approval", "Invoice\nApproval", 340,  70, "invoice-approval.svg", null, w: 100),

        // ── Row 2 ──
        MakeNode("vendor",           "Vendor",            110, 235, "vendor.svg",           "/vendor"),
        MakeNode("invoices",         "Invoices",          340, 235, "invoices.svg",         null),
        MakeNode("journal",          "Journal\nEntries",  760, 235, "journal-entries.svg",  null, w: 100),

        // ── Row 3 ──
        MakeNode("time-equip",       "Time &\nEquipment", 290, 425, "time-equipment.svg",   null,  w: 110),
        MakeNode("job",              "Job",               560, 425, "job.svg",              "/job-setup"),
        MakeNode("cost-plus",        "Cost Plus\nBilling",890, 425, "cost-plus-billing.svg",null, w: 100),

        // ── Row 4 ──
        MakeNode("inquiry",          "Inquiry",           560, 605, "inquiry.svg",          null),
        MakeNode("progress",         "Progress\nBilling", 755, 605, "progress-billing.svg", "/estimate-items/Billing", w: 100),
        MakeNode("customer",         "Customer",          890, 605, "customer.svg",         "/customer"),
    };

    // ── Connectors ──────────────────────────────────────────────────────
    private readonly List<DiagramConnector> _connectors = new()
    {
        // Invoice Approval → Invoices (down)
        MakeConn("c1",  "invoice-approval", "invoices", DiagramPort.Bottom, DiagramPort.Top),

        // Vendor → Invoices (right)
        MakeConn("c2",  "vendor",           "invoices", DiagramPort.Right,  DiagramPort.Left),

        // Invoices → Journal Entries (right, top rail)
        MakeConn("c3",  "invoices",         "journal",  DiagramPort.Right,  DiagramPort.Left),

        // Invoices → Job (down) and Journal Entries → Job (down) — the two
        // parallel vertical rails feeding the Job folder in the VB6 diagram.
        MakeConn("c4",  "invoices",         "job",      DiagramPort.Bottom, DiagramPort.Top, ConnectorType.Orthogonal),
        MakeConn("c5",  "journal",          "job",      DiagramPort.Bottom, DiagramPort.Top, ConnectorType.Orthogonal),

        // Time & Equipment → Job (right)
        MakeConn("c6",  "time-equip",       "job",      DiagramPort.Right,  DiagramPort.Left),

        // Inquiry → Job (up)
        MakeConn("c7",  "inquiry",          "job",      DiagramPort.Top,    DiagramPort.Bottom),

        // Job → Cost Plus Billing (right)
        MakeConn("c8",  "job",              "cost-plus",DiagramPort.Right,  DiagramPort.Left),

        // Job → Progress Billing (down)
        MakeConn("c9",  "job",              "progress", DiagramPort.Bottom, DiagramPort.Top, ConnectorType.Orthogonal),

        // Cost Plus Billing → Customer (down)
        MakeConn("c10", "cost-plus",        "customer", DiagramPort.Bottom, DiagramPort.Top),

        // Progress Billing → Customer (right)
        MakeConn("c11", "progress",         "customer", DiagramPort.Right,  DiagramPort.Left),
    };

    // ── Navigation ──────────────────────────────────────────────────────
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void OnNodeClicked(DiagramNodeClickEventArgs args)
    {
        if (ParentNavigate != null && !string.IsNullOrWhiteSpace(args.Node?.NavigateUrl))
        {
            args.Handled = true;
            ParentNavigate.Invoke(args.Node.NavigateUrl);
        }
    }
}
