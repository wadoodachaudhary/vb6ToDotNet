    {
        if (mRFIRow < 0 || mRFIRow >= RFIData.Count) return;
        HighPressed = !HighPressed;
        if (HighPressed) LowPressed = false;
        RFIData[mRFIRow].Priority = HighPressed ? 2 : 1;
        SetDirty(true);
    }

    private void OnLowClick()
    {
        if (mRFIRow < 0 || mRFIRow >= RFIData.Count) return;
        LowPressed = !LowPressed;
        if (LowPressed) HighPressed = false;
        RFIData[mRFIRow].Priority = LowPressed ? 0 : 1;
        SetDirty(true);
    }

    // Browse handlers
    private async Task BrowseContacts(int index)
    {
        // VB6: FPickList.Choose(dbHomefront, "Contact", "select * from addressbook", multi-select)
        // Returns semicolon-separated list of selected contact names
        // For now, use prompt as picklist dialog is not yet integrated
        var contact = await Dialogs.PromptAsync("Enter contact name:");
        if (string.IsNullOrEmpty(contact)) return;

        switch (index)
        {
            case 3: txtSender = AppendContact(txtSender, contact); break;
            case 4: txtRecipients = AppendContact(txtRecipients, contact); break;
            case 5: txtRecipientsCC = AppendContact(txtRecipientsCC, contact); break;
            case 6: txtRecipientsBCC = AppendContact(txtRecipientsBCC, contact); break;
            case 7: txtApprovedBy = AppendContact(txtApprovedBy, contact); break;
        }
        SetDirty(true);
    }

    private async Task BrowseDate(int index)
    {
        var dateStr = await Dialogs.PromptAsync("Enter date (e.g. Jan 15, 2024):");
        if (string.IsNullOrEmpty(dateStr)) return;

        if (!DateTime.TryParse(dateStr, out var dt))
        {
            Notifications.Info("Invalid date format.");
            return;
        }

        var formatted = dt.ToString("MMM d, yyyy");
        switch (index)
        {
            case 0: txtSentDate = formatted; break;
            case 1: txtClosedDate = formatted; break;
            case 2: txtDueDate = formatted; break;
            case 8: txtApprovedDate = formatted; break;
        }
        SetDirty(true);
    }

