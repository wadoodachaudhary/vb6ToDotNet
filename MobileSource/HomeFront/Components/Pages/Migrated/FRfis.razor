@page "/rfis"
@page "/rfis/{Job}"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages
@layout HFComponent

@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Components.Layout
@using HomeFront.Data
@using HomeFront.Models
@using System.Data

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FRfis> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db

<PageTitle>Request For Information - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading RFIs...</div>
    </div>
}

<!-- Toolbar -->
<div class="toolbar-cntr">
    <button class="tbar-btn" @onclick="OnOpenClick">
        <img src="images/32/open.ico" alt="Open" onerror="this.style.display='none'" />
        <span class="tool-label">Open</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" disabled="@(!mDirty)" @onclick="() => SaveData(false)">
        <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
        <span class="tool-label">Save</span>
    </button>
    <button class="tbar-btn" @onclick="OnNewRFI">
        <img src="images/32/new.ico" alt="New" onerror="this.style.display='none'" />
        <span class="tool-label">New</span>
    </button>
    <button class="tbar-btn" disabled>
        <span class="tool-label">Delete</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" @onclick="OnPreviewClick">
        <img src="images/32/ChangeView.ico" alt="Preview" onerror="this.style.display='none'" />
        <span class="tool-label">Preview</span>
    </button>
    <button class="tbar-btn" disabled>
        <span class="tool-label">Send</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn @(HighPressed ? "active" : "")" @onclick="OnHighClick">
        <span class="tool-label">High</span>
    </button>
    <button class="tbar-btn @(LowPressed ? "active" : "")" @onclick="OnLowClick">
        <span class="tool-label">Low</span>
    </button>
</div>

<!-- Main Layout -->
<div class="rfi-container">
    <!-- Left: RFI List -->
    <div class="rfi-list-panel">
        <GridControl @ref="RFIGrid"
                TValue="RFIRow"
                DataSource="@RFIData"
                AllowSelection="true"
                AllowSorting="true"
                AllowResizing="true"
                EnableHover="true"
                Height="100%"
                RowHeight="32"
                SelectionSettingsRef="@rfiSelectionSettings"
                EventsRef="@rfiGridEvents">
            <GridColumnsBase @key="gRFILayoutVersion">
                @if (HasRFIGridLayout)
                {
                    foreach (var entry in GetOrderedRFIGridLayout())
                    {
                        var layout = entry.Layout;
                        var fieldName = entry.Field;
                        var columnType = entry.ColumnType;
                        var textAlign = entry.TextAlign;
                        var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                        var width = layout.Width.HasValue && layout.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;

                        <GridColumn Field="@fieldName"
                                      HeaderText="@headerText"
                                      Width="@width"
                                      Type="@columnType"
                                      TextAlign="@textAlign"
                                      ClipMode="ClipMode.Ellipsis" />
                    }
                }
                else
                {
                    <GridColumn Field="@nameof(RFIRow.Priority)" HeaderText="!" Width="40px" TextAlign="TextAlign.Center" />
                    <GridColumn Field="@nameof(RFIRow.RFIID)" HeaderText="RFI #" Width="60px" TextAlign="TextAlign.Center" />
                    <GridColumn Field="@nameof(RFIRow.Subject)" HeaderText="Subject" Width="180px" />
                    <GridColumn Field="@nameof(RFIRow.Status)" HeaderText="Status" Width="120px" />
                }
            </GridColumnsBase>
        </GridControl>
    </div>

    <!-- Right: RFI Detail -->
    <div class="rfi-detail-panel">
        <!-- From / To / CC / BCC -->
        <div class="form-row">
            <label>From</label>
            <TextBoxControl @bind-Value="txtSender" MaxLength="50" @onfocus="() => SelectAll(nameof(txtSender))" />
            <button class="browse-btn" @onclick="() => BrowseContacts(3)" title="Pick Contact">📇</button>
            <label class="lbl-sm">Sent</label>
            <TextBoxControl @bind-Value="txtSentDate" CssClass="date-field date-readonly" readonly />
            <button class="browse-btn" @onclick="() => BrowseDate(0)" title="Calendar">📅</button>
        </div>
        <div class="form-row">
            <label>To</label>
            <TextBoxControl @bind-Value="txtRecipients" MaxLength="50" />
            <button class="browse-btn" @onclick="() => BrowseContacts(4)" title="Pick Contact">📇</button>
            <label class="lbl-sm">Due</label>
            <TextBoxControl @bind-Value="txtDueDate" CssClass="date-field" />
            <button class="browse-btn" @onclick="() => BrowseDate(2)" title="Calendar">📅</button>
        </div>
        <div class="form-row">
            <label>CC</label>
            <TextBoxControl @bind-Value="txtRecipientsCC" MaxLength="50" />
            <button class="browse-btn" @onclick="() => BrowseContacts(5)" title="Pick Contact">📇</button>
            <label class="lbl-sm">Closed</label>
            <TextBoxControl @bind-Value="txtClosedDate" CssClass="date-field" />
            <button class="browse-btn" @onclick="() => BrowseDate(1)" title="Calendar">📅</button>
        </div>
        <div class="form-row">
            <label>BCC</label>
            <TextBoxControl @bind-Value="txtRecipientsBCC" MaxLength="50" />
            <button class="browse-btn" @onclick="() => BrowseContacts(6)" title="Pick Contact">📇</button>
            <label class="lbl-sm">Status</label>
            <DropDownListControl TValue="string" TItem="string" DataSource="@StatusOptions" @bind-Value="cboStatus" Width="180px" />
        </div>

        <!-- Subject -->
        <div class="form-row">
            <label>Subject</label>
            <TextBoxControl @bind-Value="txtSubject" MaxLength="50" />
        </div>

        <!-- Question -->
        <div class="form-row form-row-top">
            <label class="lbl-top">Issue or Question</label>
            <TextAreaControl @bind-Value="txtQuestion" Rows="4" MaxLength="8000" />
        </div>

        <!-- Answer -->
        <div class="form-row form-row-top">
            <label class="lbl-top">Resolution or Answer</label>
            <TextAreaControl @bind-Value="txtAnswer" Rows="4" MaxLength="8000" />
        </div>

        <!-- Cost Impact / Scheduling Impact -->
        <div class="form-row">
            <label>Cost Impact</label>
            <TextBoxControl @bind-Value="txtCostImpact" CssClass="cost-field" @onblur="OnCostImpactBlur" MaxLength="50" />
            <label class="lbl-md">Scheduling Impact</label>
            <TextBoxControl @bind-Value="txtSchedulingImpact" MaxLength="50" />
        </div>

        <!-- Approved By / Approved Date -->
        <div class="form-row">
            <label>Approved By</label>
            <TextBoxControl @bind-Value="txtApprovedBy" CssClass="approvedby-field" MaxLength="50" />
            <button class="browse-btn" @onclick="() => BrowseContacts(7)" title="Pick Contact">📇</button>
            <label class="lbl-md2">Approved Date</label>
            <TextBoxControl @bind-Value="txtApprovedDate" CssClass="date-field" />
            <button class="browse-btn" @onclick="() => BrowseDate(8)" title="Calendar">📅</button>
        </div>

        <!-- Attachments -->
        <div style="margin-top:12px;">
            <span class="section-label" style="display:block; text-align:left;">Attachments</span>
            <GridControl @ref="AttachmentsGrid"
                    TValue="AttachmentRow"
                    DataSource="@AttachmentsData"
                    AllowSelection="true"
                    AllowResizing="true"
                    EnableHover="true"
                    Height="180px"
                    RowHeight="28">
                <GridColumnsBase @key="gAttachmentsLayoutVersion">
                    @if (HasAttachmentsGridLayout)
                    {
                        foreach (var entry in GetOrderedAttachmentsGridLayout())
                        {
                            var layout = entry.Layout;
                            var fieldName = entry.Field;
                            var columnType = entry.ColumnType;
                            var textAlign = entry.TextAlign;
                            var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                            var width = layout.Width.HasValue && layout.Width.Value > 0
                                ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;

                            <GridColumn Field="@fieldName"
                                          HeaderText="@headerText"
                                          Width="@width"
                                          Type="@columnType"
                                          TextAlign="@textAlign"
                                          ClipMode="ClipMode.Ellipsis" />
                        }
                    }
                    else
                    {
                        <GridColumn Field="@nameof(AttachmentRow.FileTitle)" HeaderText="Name" Width="200px" />
                        <GridColumn Field="@nameof(AttachmentRow.DocumentClass)" HeaderText="Class" Width="100px" />
                        <GridColumn Field="@nameof(AttachmentRow.Revision)" HeaderText="Revision" Width="80px" />
                        <GridColumn Field="@nameof(AttachmentRow.Path)" HeaderText="Location" Width="200px" />
                        <GridColumn Field="@nameof(AttachmentRow.FileSize)" HeaderText="Size" Width="80px" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(AttachmentRow.ModifiedDate)" HeaderText="Modified" Width="140px" />
                        <GridColumn Field="@nameof(AttachmentRow.CreatedDate)" HeaderText="Created" Width="140px" />
                        <GridColumn Field="@nameof(AttachmentRow.AttachedDate)" HeaderText="Attached" Width="140px" />
                        <GridColumn Field="@nameof(AttachmentRow.WebPortals)" HeaderText="Web Portals" Width="100px" />
                        <GridColumn Field="@nameof(AttachmentRow.WebLocation)" HeaderText="Web Location" Width="100px" />
                        <GridColumn Field="@nameof(AttachmentRow.Embedded)" HeaderText="Embedded" Width="80px" Visible="false" />
                        <GridColumn Field="@nameof(AttachmentRow.FileName)" HeaderText="FileName" Width="1px" Visible="false" />
                    }
                </GridColumnsBase>
            </GridControl>
        </div>

        <!-- Conversation / Messages -->
        <div style="margin-top:12px;">
            <span class="section-label" style="display:block; text-align:left;">Conversation</span>
            <GridControl @ref="MessagesGrid"
                    TValue="MessageRow"
                    DataSource="@MessagesData"
                    AllowSelection="true"
                    AllowSorting="true"
                    AllowResizing="true"
                    EnableHover="true"
                    Height="350px"
                    RowHeight="28"
                    EditSettingsRef="@messageEditSettings"
                    EventsRef="@messageGridEvents">
                <GridColumnsBase @key="gMessagesLayoutVersion">
                    <GridColumn Field="@nameof(MessageRow.ID)" Visible="false" AllowEditing="false" />
                    @if (HasMessagesGridLayout)
                    {
                        foreach (var entry in GetOrderedMessagesGridLayout())
                        {
                            var layout = entry.Layout;
                            var fieldName = entry.Field;
                            var columnType = entry.ColumnType;
                            var textAlign = entry.TextAlign;
                            var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                            var width = layout.Width.HasValue && layout.Width.Value > 0
                                ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;
                            var allowEdit = IsMessageFieldEditable(fieldName);

                            if (fieldName == "Priority")
                            {
                                <GridColumn Field="Priority" HeaderText="@headerText" Width="@(width ?? "40px")" TextAlign="TextAlign.Center">
                                    <Template>
                                        @{
                                            var msg = (MessageRow)context;
                                            var icon = msg.Priority switch { 0 => "🔽", 2 => "🔺", _ => "" };
                                        }
                                        <span style="cursor:pointer;" @onclick="() => ToggleMessagePriority(msg)">@icon</span>
                                    </Template>
                                </GridColumn>
                            }
                            else if (fieldName == "Original")
                            {
                                <GridColumn Field="Original" HeaderText="@headerText" Width="@(width ?? "40px")" TextAlign="TextAlign.Center">
                                    <Template>
                                        @{
                                            var msg = (MessageRow)context;
                                        }
                                        @if (msg.MessageType == "Email")
                                        {
                                            <span style="cursor:pointer;" @onclick="() => OpenOriginalMessage(msg)" title="Open original email">📧</span>
                                        }
                                    </Template>
                                </GridColumn>
                            }
                            else if (fieldName == "MessageType")
                            {
                                <GridColumn Field="MessageType" HeaderText="@headerText" Width="@(width ?? "80px")">
                                    <EditTemplate>
                                        @{
                                            var msg = (MessageRow)context;
                                        }
                                        <select @bind="msg.MessageType">
                                            <option value="Mail">Mail</option>
                                            <option value="Fax">Fax</option>
                                            <option value="Phone">Phone</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </EditTemplate>
                                </GridColumn>
                            }
                            else
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              AllowEditing="@allowEdit"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                        }
                    }
                    else
                    {
                        <GridColumn Field="@nameof(MessageRow.Priority)" HeaderText="!" Width="40px" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var msg = (MessageRow)context;
                                    var icon = msg.Priority switch { 0 => "🔽", 2 => "🔺", _ => "" };
                                }
                                <span style="cursor:pointer;" @onclick="() => ToggleMessagePriority(msg)">@icon</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(MessageRow.Original)" HeaderText="📧" Width="40px" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var msg = (MessageRow)context;
                                }
                                @if (msg.MessageType == "Email")
                                {
                                    <span style="cursor:pointer;" @onclick="() => OpenOriginalMessage(msg)" title="Open original email">📧</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(MessageRow.MessageType)" HeaderText="Type" Width="80px">
                            <EditTemplate>
                                @{
                                    var msg = (MessageRow)context;
                                }
                                <select @bind="msg.MessageType">
                                    <option value="Mail">Mail</option>
                                    <option value="Fax">Fax</option>
                                    <option value="Phone">Phone</option>
                                    <option value="Other">Other</option>
                                </select>
                            </EditTemplate>
                        </GridColumn>
                        <GridColumn Field="@nameof(MessageRow.Sender)" HeaderText="Sender" Width="150px" />
                        <GridColumn Field="@nameof(MessageRow.Recipients)" HeaderText="Recipients" Width="150px" />
                        <GridColumn Field="@nameof(MessageRow.RecipientsCC)" HeaderText="CC" Width="120px" />
                        <GridColumn Field="@nameof(MessageRow.RecipientsBCC)" HeaderText="BCC" Width="120px" />
                        <GridColumn Field="@nameof(MessageRow.Subject)" HeaderText="Subject" Width="200px" />
                        <GridColumn Field="@nameof(MessageRow.Body)" HeaderText="Body" Width="250px" />
                        <GridColumn Field="@nameof(MessageRow.SentDate)" HeaderText="Sent" Width="120px" />
                        <GridColumn Field="@nameof(MessageRow.ReceivedDate)" HeaderText="Received" Width="120px" />
                        <GridColumn Field="@nameof(MessageRow.Size)" HeaderText="Size" Width="80px" TextAlign="TextAlign.Right" AllowEditing="false" />
                    }
                </GridColumnsBase>
            </GridControl>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Job { get; set; }

    private const string SRCFILE = "FRfis::";

    // Database
// UI State
    private bool IsLoading = false;
    private bool mDirty = false;
    private bool mLoading = false;
    private string mJob = "";
    private int mRFIRow = -1;
    private bool HighPressed = false;
    private bool LowPressed = false;

    // Grid refs
    private GridControl<RFIRow>? RFIGrid;
    private GridControl<AttachmentRow>? AttachmentsGrid;
    private GridControl<MessageRow>? MessagesGrid;

    // Grid settings
    private SelectionSettings rfiSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };
    private GridControlEvents<RFIRow> rfiGridEvents = new();
    private EditSettings messageEditSettings = new()
    {
        AllowAdding = true,
        AllowEditing = true,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };
    private GridControlEvents<MessageRow> messageGridEvents = new();

    // === Grid layout via the shared GridLayoutPresenter ===
    // The load/resolve/order/width boilerplate lives in GridLayoutPresenter<TRow>;
    // only the VB6 form/grid name strings stay here (fidelity). The members named
    // gRFILayout / HasRFIGridLayout / …Version below are thin delegations, so the
    // markup and the rest of this file are unchanged.
    private readonly GridLayoutPresenter<RFIRow> _rfiGrid =
        new("FRfis", "RFIGrid", instanceKey: "(0)");
    private readonly GridLayoutPresenter<AttachmentRow> _attachmentsGrid =
        new("FRfis", "AttachmentsGrid", instanceKey: "(0)");
    private readonly GridLayoutPresenter<MessageRow> _messagesGrid =
        new("FRfis", "MessagesGrid", instanceKey: "(0)");

    private Dictionary<string, GridLayoutColumn> gRFILayout => _rfiGrid.Layout;
    private bool HasRFIGridLayout => _rfiGrid.Has;
    private int gRFILayoutVersion => _rfiGrid.Version;

    private Dictionary<string, GridLayoutColumn> gAttachmentsLayout => _attachmentsGrid.Layout;
    private bool HasAttachmentsGridLayout => _attachmentsGrid.Has;
    private int gAttachmentsLayoutVersion => _attachmentsGrid.Version;

    private Dictionary<string, GridLayoutColumn> gMessagesLayout => _messagesGrid.Layout;
    private bool HasMessagesGridLayout => _messagesGrid.Has;
    private int gMessagesLayoutVersion => _messagesGrid.Version;

    // Data
    private List<RFIRow> RFIData = new();
    private List<AttachmentRow> AttachmentsData = new();
    private List<MessageRow> MessagesData = new();

    // Form fields
    private string txtSender = "";
    private string txtRecipients = "";
    private string txtRecipientsCC = "";
    private string txtRecipientsBCC = "";
    private string txtSubject = "";
    private string txtQuestion = "";
    private string txtAnswer = "";
    private string txtSentDate = "";
    private string txtDueDate = "";
    private string txtClosedDate = "";
    private string txtCostImpact = "";
    private string txtSchedulingImpact = "";
    private string txtApprovedBy = "";
    private string txtApprovedDate = "";
    private string cboStatus = "Open";

    private List<string> StatusOptions = new()
    {
        "Open", "Awaiting Response", "Requires Attention", "Approved", "Closed"
    };

    // Lifecycle
    protected override async Task OnInitializedAsync()
    {
        rfiGridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<RFIRow>>(this, OnRFIRowSelected);
        messageGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<MessageRow>>(this, OnMessageCellSaved);

        await LoadGridLayoutAsync();

        mJob = Job ?? "";
        await LoadJob(mJob);
    }

    // === Load Grid Layout ===
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            // The keyed/unkeyed "(0)" fallback + Version bump live in the presenter
            // (its ctor was given the form/grid names and instanceKey "(0)").
            await _rfiGrid.LoadAsync(GridLayoutSvc);
            await _attachmentsGrid.LoadAsync(GridLayoutSvc);
            await _messagesGrid.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");

        }
    }

    // ShowForm equivalent
    public async Task ShowForm(string job, long rfiId = 0)
    {
        mJob = job;
        await LoadJob(mJob);
    }

    // Load Job
    private async Task LoadJob(string job)
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            if (string.IsNullOrEmpty(job))
            {
                // VB6: FPickList.Choose with SQL:
                // SELECT DISTINCT j.Job_No Job, j.Description, j.Municipal_Address Address,
                //   j.PM, Purchaser, j.Estimator FROM tblJobs j WHERE ISNULL(j.Inactive,0)=0
                // For now, use prompt as picklist dialog is not yet integrated
                var promptResult = await Dialogs.PromptAsync("Enter Job Number:");
                if (string.IsNullOrWhiteSpace(promptResult)) return;
                mJob = promptResult.Trim();
            }
            else
            {
                mJob = job;
            }

            var sql = "SELECT * FROM rfis WHERE job=@Job";
            var rows = await db.QueryAsync(sql, new { Job = mJob });

            mLoading = true;
            RFIData.Clear();

            foreach (var rs in rows)
            {
                var rfi = new RFIRow
                {
                    Priority = SafeInt(rs, "Priority", 1),
                    RFIID = SafeInt(rs, "RFIID"),
                    Subject = SafeStr(rs, "Subject"),
                    Status = SafeStr(rs, "Status"),
                    Sender = SafeStr(rs, "Sender"),
                    Recipients = SafeStr(rs, "Recipients"),
                    RecipientsCC = SafeStr(rs, "RecipientsCC"),
                    RecipientsBCC = SafeStr(rs, "RecipientsBCC"),
                    Question = SafeStr(rs, "Question"),
                    Answer = SafeStr(rs, "Answer"),
                    CostImpact = FormatCostImpact(rs, "CostImpact"),
                    SchedulingImpact = SafeStr(rs, "SchedulingImpact"),
                    ApprovedBy = SafeStr(rs, "ApprovedBy"),
                    ApprovedDate = FormatMediumDate(rs, "ApprovedDate"),
                    SentDate = FormatMediumDate(rs, "SentDate"),
                    DueDate = FormatMediumDate(rs, "DueDate"),
                    ClosedDate = FormatMediumDate(rs, "ClosedDate")
                };
                RFIData.Add(rfi);
            }

            mLoading = false;
            mRFIRow = -1;

            if (RFIData.Count > 0)
            {
                mRFIRow = 0;
                LoadRFI(0);
            }

            SetDirty(false);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{SRCFILE}LoadJob");

            // VB6: errHandler(SRCFILE & "LoadJob")
            Notifications.Error($"Error loading job: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Load RFI detail
    private async void LoadRFI(int rfiIndex)
    {
        if (mLoading) return;
        mLoading = true;

        try
        {
            mRFIRow = rfiIndex;
            var rfi = RFIData[rfiIndex];

            // Set priority buttons
            HighPressed = rfi.Priority == 2;
            LowPressed = rfi.Priority == 0;

            // Load form fields
            txtSubject = rfi.Subject;
            cboStatus = rfi.Status;
            txtSender = rfi.Sender;
            txtRecipients = rfi.Recipients;
            txtRecipientsCC = rfi.RecipientsCC;
            txtRecipientsBCC = rfi.RecipientsBCC;
            txtQuestion = rfi.Question;
            txtAnswer = rfi.Answer;
            txtSentDate = rfi.SentDate;
            txtDueDate = rfi.DueDate;
            txtClosedDate = rfi.ClosedDate;
            txtApprovedBy = rfi.ApprovedBy;
            txtApprovedDate = rfi.ApprovedDate;
            txtCostImpact = rfi.CostImpact;
            txtSchedulingImpact = rfi.SchedulingImpact;

            // Load messages
            await LoadMessages(rfi.RFIID);

            // Load attachments
            await LoadAttachments();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{SRCFILE}LoadRFI");

        }
        finally
        {
            mLoading = false;
            mDirty = false;
            StateHasChanged();
        }
    }

    private async Task LoadMessages(int rfiId)
    {
        var sql = @"SELECT * FROM messages WHERE job=@Job AND rfiid=@RFIID";
        var rows = await db.QueryAsync(sql, new { Job = mJob, RFIID = rfiId });

        MessagesData.Clear();
        foreach (var rs in rows)
        {
            var msg = new MessageRow
            {
                ID = SafeStr(rs, "ID"),
                Priority = SafeInt(rs, "Priority", 1),
                MessageType = SafeStr(rs, "MessageType"),
                Sender = SafeStr(rs, "Sender"),
                Recipients = SafeStr(rs, "Recipients"),
                RecipientsCC = SafeStr(rs, "RecipientsCC"),
                RecipientsBCC = SafeStr(rs, "RecipientsBCC"),
                Subject = SafeStr(rs, "Subject"),
                Body = SafeStr(rs, "Body"),
                SentDate = SafeStr(rs, "SentDate"),
                ReceivedDate = SafeStr(rs, "ReceivedDate"),
                Size = SafeInt(rs, "Size") > 0 ? $"{SafeInt(rs, "Size")} KB" : "",
                Attachments = SafeInt(rs, "Attachments"),
                Original = SafeStr(rs, "MessageType") == "Email" ? "📧" : "",
                RowState = "CLEAN",
                IsDeleted = false
            };
            MessagesData.Add(msg);
        }

        // Add empty row for new entry
        MessagesData.Add(new MessageRow { RowState = "NEW" });
    }

    private async Task LoadAttachments()
    {
        var objectId = GetObjectID();
        var sql = @"SELECT a.filename, a.documentclass, a.filesize, a.filetitle, a.path,
                           a.modifieddate, a.createddate, a.attacheddate, a.embedded,
                           a.webcustomers, a.webvendors, a.weblocation, a.Revision
                    FROM attachments a
                    WHERE a.objectid=@ObjectId
                    ORDER BY 1";
        var rows = await db.QueryAsync(sql, new { ObjectId = objectId });

        AttachmentsData.Clear();
        foreach (var rs in rows)
        {
            var fileName = SafeStr(rs, "FileName");
            if (string.IsNullOrEmpty(fileName)) continue;

            var embedded = SafeStr(rs, "Embedded") == "True";
            var webCustomers = SafeStr(rs, "WebCustomers") == "True";
            var webVendors = SafeStr(rs, "WebVendors") == "True";

            string webPortals;
            if (webCustomers && webVendors) webPortals = "All";
            else if (webCustomers) webPortals = "Customer";
            else if (webVendors) webPortals = "Vendor";
            else webPortals = "None";

            var att = new AttachmentRow
            {
                FileName = fileName,
                FileTitle = SafeStr(rs, "FileTitle"),
                Path = SafeStr(rs, "Path"),
                FileSize = SafeStr(rs, "FileSize"),
                DocumentClass = SafeStr(rs, "DocumentClass"),
                Revision = SafeStr(rs, "Revision"),
                ModifiedDate = FormatGeneralDate(rs, "ModifiedDate"),
                CreatedDate = FormatGeneralDate(rs, "CreatedDate"),
                AttachedDate = FormatGeneralDate(rs, "AttachedDate"),
                Embedded = embedded ? "True" : "False",
                WebPortals = webPortals,
                WebLocation = string.IsNullOrEmpty(SafeStr(rs, "WebLocation")) ? "Documents" : SafeStr(rs, "WebLocation")
            };
            AttachmentsData.Add(att);
        }
    }

    // Unload RFI (save form fields back to data)
    private void UnloadRFI()
    {
        if (mRFIRow < 0 || mRFIRow >= RFIData.Count) return;

        var rfi = RFIData[mRFIRow];
        rfi.Subject = txtSubject;
        rfi.Status = cboStatus;
        rfi.Sender = txtSender;
        rfi.Recipients = txtRecipients;
        rfi.RecipientsCC = txtRecipientsCC;
        rfi.RecipientsBCC = txtRecipientsBCC;
        rfi.Question = txtQuestion;
        rfi.Answer = txtAnswer;
        rfi.SentDate = txtSentDate;
        rfi.DueDate = txtDueDate;
        rfi.ClosedDate = txtClosedDate;
        rfi.CostImpact = txtCostImpact;
        rfi.SchedulingImpact = txtSchedulingImpact;
        rfi.ApprovedBy = txtApprovedBy;
        rfi.ApprovedDate = txtApprovedDate;
    }

    // Save Data
    private async Task<bool> SaveData(bool prompt)
    {
        try
        {
            UnloadRFI();

            if (!mDirty) return true;

            if (prompt)
            {
                // VB6: MsgBox "This data has changed..." vbYesNoCancel
                // confirm() returns true=Yes(save), false=No(discard). Cancel not available in JS confirm.
                var doSave = await Dialogs.ConfirmAsync(
                    "This data has changed.\n\nDo you want to save these changes?");
                if (!doSave) { mDirty = false; return true; }
            }

            IsLoading = true;
            StateHasChanged();

            if (mRFIRow < 0 || mRFIRow >= RFIData.Count) return true;

            var rfi = RFIData[mRFIRow];

            // If new RFI (no RFIID), generate one
            if (rfi.RFIID == 0)
            {
                var nextIdSql = "SELECT ISNULL(LastRFIID,0)+1 FROM tbljobs WHERE job_no=@Job";
                var nextId = await db.ExecuteScalarAsync<int>(nextIdSql, new { Job = mJob });
                rfi.RFIID = nextId;

                await db.ExecuteAsync("UPDATE tbljobs SET lastrfiid=ISNULL(LastRFIID,0)+1 WHERE job_no=@Job",
                    new { Job = mJob });

                await db.ExecuteAsync("INSERT INTO rfis(job,rfiid) VALUES(@Job,@RFIID)",
                    new { Job = mJob, RFIID = rfi.RFIID });
            }

            // Update RFI
            var updateSql = @"UPDATE rfis SET
                priority=@Priority, subject=@Subject, status=@Status,
                Sender=@Sender, Recipients=@Recipients, RecipientsCC=@RecipientsCC,
                RecipientsBCC=@RecipientsBCC, Question=@Question, Answer=@Answer,
                SentDate=@SentDate, DueDate=@DueDate, ClosedDate=@ClosedDate,
                CostImpact=@CostImpact, SchedulingImpact=@SchedulingImpact,
                ApprovedBy=@ApprovedBy, ApprovedDate=@ApprovedDate
                WHERE job=@Job AND rfiid=@RFIID";

            await db.ExecuteAsync(updateSql, new
            {
                rfi.Priority,
                rfi.Subject,
                rfi.Status,
                rfi.Sender,
                rfi.Recipients,
                rfi.RecipientsCC,
                rfi.RecipientsBCC,
                rfi.Question,
                rfi.Answer,
                SentDate = ParseDateOrNull(rfi.SentDate),
                DueDate = ParseDateOrNull(rfi.DueDate),
                ClosedDate = ParseDateOrNull(rfi.ClosedDate),
                CostImpact = ParseDecimalOrNull(rfi.CostImpact),
                SchedulingImpact = rfi.SchedulingImpact,
                ApprovedBy = rfi.ApprovedBy,
                ApprovedDate = ParseDateOrNull(rfi.ApprovedDate),
                Job = mJob,
                RFIID = rfi.RFIID
            });

            // Save messages
            // Delete hidden/deleted messages
            foreach (var msg in MessagesData.Where(m => m.IsDeleted && !string.IsNullOrEmpty(m.ID)))
            {
                await db.ExecuteAsync("DELETE FROM messages WHERE id=@ID", new { msg.ID });
            }
            MessagesData.RemoveAll(m => m.IsDeleted);

            // Save dirty messages
            foreach (var msg in MessagesData.Where(m => m.RowState == "DIRTY"))
            {
                if (string.IsNullOrEmpty(msg.ID))
                {
                    msg.ID = Guid.NewGuid().ToString();
                    await db.ExecuteAsync(@"INSERT INTO messages(job,rfiid,id,priority,messagetype,sender,recipients,
                        recipientscc,recipientsbcc,subject,body,sentdate,receiveddate)
                        VALUES(@Job,@RFIID,@ID,@Priority,@MessageType,@Sender,@Recipients,
                        @RecipientsCC,@RecipientsBCC,@Subject,@Body,@SentDate,@ReceivedDate)",
                        new
                        {
                            Job = mJob,
                            RFIID = rfi.RFIID,
                            msg.ID,
                            msg.Priority,
                            msg.MessageType,
                            msg.Sender,
                            msg.Recipients,
                            msg.RecipientsCC,
                            msg.RecipientsBCC,
                            msg.Subject,
                            msg.Body,
                            SentDate = ParseDateOrNull(msg.SentDate),
                            ReceivedDate = ParseDateOrNull(msg.ReceivedDate)
                        });
                }
                else
                {
                    await db.ExecuteAsync(@"UPDATE messages SET
                        priority=@Priority, messagetype=@MessageType, sender=@Sender,
                        recipients=@Recipients, recipientscc=@RecipientsCC,
                        recipientsbcc=@RecipientsBCC, subject=@Subject, body=@Body,
                        sentdate=@SentDate, receiveddate=@ReceivedDate
                        WHERE id=@ID",
                        new
                        {
                            msg.Priority,
                            msg.MessageType,
                            msg.Sender,
                            msg.Recipients,
                            msg.RecipientsCC,
                            msg.RecipientsBCC,
                            msg.Subject,
                            msg.Body,
                            SentDate = ParseDateOrNull(msg.SentDate),
                            ReceivedDate = ParseDateOrNull(msg.ReceivedDate),
                            msg.ID
                        });
                }
                msg.RowState = "CLEAN";
            }

            mDirty = false;
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{SRCFILE}SaveData");

            Notifications.Error($"Error saving: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Event Handlers
    private async Task OnRFIRowSelected(RowSelectEventArgs<RFIRow> args)
    {
        if (mLoading) return;

        if (!await SaveData(true)) return;

        var index = RFIData.IndexOf(args.Data);
        if (index >= 0)
        {
            LoadRFI(index);
        }
    }

    private void OnMessageCellSaved(CellSaveArgs<MessageRow> args)
    {
        if (args.Data != null)
        {
            args.Data.RowState = "DIRTY";
            SetDirty(true);

            // If editing the last (empty) row, add a new empty row
            var idx = MessagesData.IndexOf(args.Data);
            if (idx == MessagesData.Count - 1 && args.Data.RowState == "DIRTY")
            {
                args.Data.Priority = 1;
                args.Data.MessageType = string.IsNullOrEmpty(args.Data.MessageType) ? "Other" : args.Data.MessageType;
                args.Data.ReceivedDate = DateTime.Now.ToString("MMM d, yyyy");
                MessagesData.Add(new MessageRow { RowState = "NEW" });
            }
        }
    }

    private void ToggleMessagePriority(MessageRow msg)
    {
        if (msg.MessageType == "Email") return;
        msg.Priority = msg.Priority switch
        {
            0 => 1,
            1 => 2,
            2 => 0,
            _ => 1
        };
        msg.RowState = "DIRTY";
        SetDirty(true);
        StateHasChanged();
    }

    private async Task OpenOriginalMessage(MessageRow msg)
    {
        if (msg.MessageType != "Email" || string.IsNullOrEmpty(msg.ID)) return;

        try
        {
            // VB6: DBGetFile to extract .msg from messages table, then ShellFile to open it
            // In web context, we query for the original message data and present it
            var sql = "SELECT Subject, Body, Sender, Recipients FROM messages WHERE id=@ID";
            var rows = await db.QueryAsync(sql, new { msg.ID });
            if (rows.Count > 0)
            {
                var r = rows[0];
                var subject = SafeStr(r, "Subject");
                var body = SafeStr(r, "Body");
                var sender = SafeStr(r, "Sender");
                var recipients = SafeStr(r, "Recipients");
                Notifications.Info($"Original Email\n\nFrom: {sender}\nTo: {recipients}\nSubject: {subject}\n\n{body}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{SRCFILE}OpenOriginalMessage");

        }
    }

