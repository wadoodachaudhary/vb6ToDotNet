    private static string SafeStr(Dictionary<string, object> row, string key)
    {
        if (row.TryGetValue(key, out var val) && val != null && val != DBNull.Value)
            return val.ToString() ?? "";
        return "";
    }

    private static int SafeInt(Dictionary<string, object> row, string key, int defaultVal = 0)
    {
        var s = SafeStr(row, key);
        return int.TryParse(s, out var v) ? v : defaultVal;
    }

    private static string FormatMediumDate(Dictionary<string, object> row, string key)
    {
        var s = SafeStr(row, key);
        if (string.IsNullOrEmpty(s)) return "";
        return DateTime.TryParse(s, out var dt) ? dt.ToString("MMM d, yyyy") : "";
    }

    private static string FormatGeneralDate(Dictionary<string, object> row, string key)
    {
        var s = SafeStr(row, key);
        if (string.IsNullOrEmpty(s)) return "";
        return DateTime.TryParse(s, out var dt) ? dt.ToString("g") : "";
    }

    private static string FormatCostImpact(Dictionary<string, object> row, string key)
    {
        var s = SafeStr(row, key);
        if (string.IsNullOrEmpty(s)) return "";
        if (decimal.TryParse(s, out var val) && val != 0)
            return val.ToString("#,##0.00");
        return "";
    }

    private static DateTime? ParseDateOrNull(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        return DateTime.TryParse(s, out var dt) ? dt : null;
    }

    private static decimal? ParseDecimalOrNull(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        return decimal.TryParse(s, out var v) ? v : null;
    }

