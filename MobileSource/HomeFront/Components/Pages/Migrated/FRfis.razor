    private string GetObjectID()
    {
        // VB6: ObjectID = "RFI~" & mJob & ":" & mRFIRow
        // mRFIRow in VB6 is the grid row index (1-based), used as the key in the objectid column
        if (mRFIRow >= 0 && mRFIRow < RFIData.Count)
            return $"RFI~{mJob}:{mRFIRow + 1}";
        return $"RFI~{mJob}:0";
    }

    private string AppendContact(string existing, string newContact)
    {
        if (string.IsNullOrEmpty(existing)) return newContact;
        return $"{existing}; {newContact}";
    }

