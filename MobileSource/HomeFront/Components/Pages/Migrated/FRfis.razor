    private void OnHighClick()
    {
        if (mRFIRow < 0 || mRFIRow >= RFIData.Count) return;
        HighPressed = !HighPressed;
        if (HighPressed) LowPressed = false;
        RFIData[mRFIRow].Priority = HighPressed ? 2 : 1;
        SetDirty(true);
    }

    private void OnLowClick()
    {
        if (mRFIRow < 0 || mRFIRow >= RFIData.Count) return;
