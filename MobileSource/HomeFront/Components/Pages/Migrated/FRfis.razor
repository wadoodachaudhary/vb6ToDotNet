    // Browse handlers
    private async Task BrowseContacts(int index)
    {
        var contact = await JSRuntime.InvokeAsync<string?>("prompt", "Enter contact name:");
        if (string.IsNullOrEmpty(contact)) return;

        switch (index)
        {
            case 3: txtSender = AppendContact(txtSender, contact); break;
            case 4: txtRecipients = AppendContact(txtRecipients, contact); break;
            case 5: txtRecipientsCC = AppendContact(txtRecipientsCC, contact); break;
            case 6: txtRecipientsBCC = AppendContact(txtRecipientsBCC, contact); break;
            case 7: txtApprovedBy = AppendContact(txtApprovedBy, contact); break;
        }
        SetDirty(true);
    }

    private async Task BrowseDate(int index)
    {
        var dateStr = await JSRuntime.InvokeAsync<string?>("prompt", "Enter date (e.g. Jan 15, 2024):");
        if (string.IsNullOrEmpty(dateStr)) return;

        if (!DateTime.TryParse(dateStr, out var dt))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Invalid date format.");
            return;
        }

        var formatted = dt.ToString("MMM d, yyyy");
        switch (index)
        {
            case 0: txtSentDate = formatted; break;
            case 1: txtClosedDate = formatted; break;
            case 2: txtDueDate = formatted; break;
            case 8: txtApprovedDate = formatted; break;
        }
        SetDirty(true);
    }

