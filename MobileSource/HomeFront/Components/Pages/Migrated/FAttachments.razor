@namespace HomeFront.Components.Pages
@using System.IO
@using System.Text
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data
@using HomeFront.Services
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject ILogger<FAttachments> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer _db
@inject ISessionStateService SessionState
@inject ExportFileStash ExportStash

<DialogControl Visible="@IsVisible"
          Header="@Caption"
          Width="1280px"
          Height="400px"
          IsModal="true"
          ShowCloseIcon="true"
          ShowWindowIcon="true"
          CssClass="fattachments-dialog"
          OnClose="Close">
    <ChildContent>
        @* VB6 FAttachments.frm:217-233 — toolbar buttons (in this order):
           Open / Print / Save As / Remove / Find. Each renders as an icon
           above its label, matching the VB6 LargeIcons toolbar style used
           by other migrated forms (FItemChart, FVendor, etc.).
           Insert File... and Link to File... live on the folder right-
           click menu in VB6 (FAttachments.frm:476-484); we expose them
           in a secondary toolbar row so users without right-click muscle
           memory can still find them. *@
        <div class="attachments-toolbar">
            <button class="tbar-btn"                    title="Open" @onclick="OpenSelectedAsync">
                <img src="images/32/open.ico" class="tbar-icon" onerror="this.style.display='none'" />
                <span class="tool-label">Open</span>
            </button>
            <button class="tbar-btn"                    title="Print" @onclick="PrintSelectedAsync">
                <img src="images/32/printer.ico" class="tbar-icon" onerror="this.style.display='none'" />
                <span class="tool-label">Print</span>
            </button>
            <button class="tbar-btn"                    title="Save As..." @onclick="SaveAsSelectedAsync">
                <img src="images/32/saveas.ico" class="tbar-icon" onerror="this.style.display='none'" />
                <span class="tool-label">Save As</span>
            </button>
            <button class="tbar-btn"                    title="Remove" @onclick="RemoveSelectedAsync">
                <img src="images/32/delete.ico" class="tbar-icon" onerror="this.style.display='none'" />
                <span class="tool-label">Remove</span>
            </button>
            <button class="tbar-btn" title="Find" @onclick="OnFindClick">
                <img src="images/32/PricebookSearch.ico" class="tbar-icon" onerror="this.style.display='none'" />
                <span class="tool-label">Find</span>
            </button>
        </div>

        <div class="attachments-grid-host" @oncontextmenu="OnGridContextMenu" @oncontextmenu:preventDefault="true">
            <GridControl @ref="_grid"
                    TValue="AttachmentRow"
                    DataSource="@Rows"
                    AllowSorting="true"
                    AllowFiltering="true"
                    AllowSelection="true"
                    AllowGrouping="true"
                    HeaderContextMenuShowsColumns="true"
                    GroupColumns="@GroupColumns"
                    Height="240px"
                    RowHeight="17"
                    EditSettingsRef="@EditSettings"
                    SelectionSettingsRef="@SelectionSettings"
                    EventsRef="@GridEvents"
                    RowCssClassSelector="@GetRowCssClass">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(AttachmentRow.Folder)" HeaderText="📁" Visible="false" AllowEditing="false" />
                    <GridColumn Field="@nameof(AttachmentRow.FileTitle)" HeaderText="Name" Width="220px" AllowHiding="false" AllowEditing="false">
                        <Template>
                            @{
                                var row = (AttachmentRow)context;
                                if (!string.IsNullOrEmpty(row.FileIconUrl))
                                {
                                    <img src="@row.FileIconUrl" class="file-type-icon" alt="" />
                                }
                                @* HHM-485: embedded files show a BLUE name like VB6
                                   (frm:624 flexcpForeColor &H C00000 = RGB 0,0,192),
                                   not a paperclip glyph. *@
                                <span class="@(row.Embedded ? "embedded-name" : null)">@row.FileTitle</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(AttachmentRow.WebPortals)" HeaderText="Web Portals" Width="85px" AllowEditing="false" />
                    <GridColumn Field="@nameof(AttachmentRow.WebLocation)" HeaderText="Web Location" Width="90px" AllowEditing="false" />
                    <GridColumn Field="@nameof(AttachmentRow.DocumentClass)" HeaderText="Classification" Width="95px"
                                EditOptions="@DocumentClassEditOptions" MaxLength="50" />
                    <GridColumn Field="@nameof(AttachmentRow.LocationDisplay)" HeaderText="Location" Width="170px" AllowEditing="false" />
                    <GridColumn Field="@nameof(AttachmentRow.Revision)" HeaderText="Revision" Width="60px" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(AttachmentRow.FileSizeDisplay)" HeaderText="Size" Width="60px" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(AttachmentRow.ModifiedDateDisplay)" HeaderText="Date Modified" Width="85px" AllowEditing="false" />
                    <GridColumn Field="@nameof(AttachmentRow.CreatedDateDisplay)" HeaderText="Date Created" Width="85px" AllowEditing="false" />
                    <GridColumn Field="@nameof(AttachmentRow.AttachedDateDisplay)" HeaderText="Date Attached" Width="85px" AllowEditing="false" />
                </GridColumnsBase>
            </GridControl>
        </div>
    </ChildContent>
</DialogControl>

<ContextMenuControl Visible="@_showContextMenu"
                    X="@_contextMenuX"
                    Y="@_contextMenuY"
                    MinWidth="180"
                    OnClose="CloseContextMenu">
    @if (_selectedRow != null && _selectedRow.HasFile)
    {
        <ContextMenuItemControl Text="Open" OnClick="OpenSelectedAsync" />
        <ContextMenuItemControl Text="Print" OnClick="PrintSelectedAsync" />
        <ContextMenuItemControl Text="Save As..." OnClick="SaveAsSelectedAsync" />
        <ContextMenuItemControl Text="Remove" OnClick="RemoveSelectedAsync" />
        @* VB6 mnuFiles popup (frm:488-548) — full file menu order. *@
        <ContextMenuSeparatorControl />
        <ContextMenuItemControl Text="Show in web folder..." Disabled="@(!ShowInWebFolderEnabled)" OnClick="ShowInWebFolderAsync" />
        <ContextMenuSeparatorControl />
        <ContextMenuItemControl Text="Cut" Disabled="true" />
        <ContextMenuItemControl Text="Copy" OnClick="CopySelectedAsync" />
        <ContextMenuItemControl Text="Paste" Disabled="true" />
        @* Send to / Properties are Windows shell actions with no web equivalent. *@
        <ContextMenuSeparatorControl />
        <ContextMenuItemControl Text="Send to..." Disabled="true" />
        <ContextMenuSeparatorControl />
        <ContextMenuItemControl Text="Properties..." Disabled="true" />
        @* VB6 keeps a permanent folder row whose right-click offers Link/Insert;
           the web grid auto-selects the newly attached file, which made the
           folder actions unreachable after the first attach (HHM-629). *@
        <ContextMenuSeparatorControl />
        <ContextMenuItemControl Text="Link to File..." OnClick="() => TriggerFileBrowser(false)" />
        <ContextMenuItemControl Text="Insert File..." Disabled="@(!_insertFileEnabled)" OnClick="() => TriggerFileBrowser(true)" />
    }
    else
    {
        <ContextMenuItemControl Text="Link to File..." OnClick="() => TriggerFileBrowser(false)" />
        <ContextMenuItemControl Text="Insert File..." Disabled="@(!_insertFileEnabled)" OnClick="() => TriggerFileBrowser(true)" />
    }
</ContextMenuControl>

<div style="display: none;" class="fattachments-file-input">
    <InputFile OnChange="OnFolderFileSelected" />
</div>

@code {
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;

    private GridControl<AttachmentRow>? _grid;

    private void OnGridContextMenu(MouseEventArgs e)
    {
        // VB6 pops the menu for the row UNDER THE CURSOR (.Row = .MouseRow,
        // FAttachments.frm:1236). The grid marks the right-clicked row current
        // before this bubbles, so read it back — otherwise every menu action
        // runs against a stale/null selection and silently does nothing (HHM-631).
        var current = _grid?.GetCurrentRecord();
        if (current != null) _selectedRow = current;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
    }

    private string GetRowCssClass(AttachmentRow row, int index)
    {
        if (!row.HasFile) return "hidden-placeholder-row";
        // HHM-487: highlight the row found via Find (independent of the grid's own selection).
        return ReferenceEquals(row, _selectedRow) ? "attachment-found-row" : "";
    }

    private readonly GridControlEvents<AttachmentRow> GridEvents = new();
    private readonly EditSettings EditSettings = new()
    {
        AllowEditing = true,
        Mode = EditMode.Batch,
        ShowConfirmDialog = false
    };
    private readonly SelectionSettings SelectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single,
        EnableToggle = true
    };

    private List<AttachmentRow> Rows { get; set; } = new();
    private AttachmentRow? _selectedRow;
    private string Caption { get; set; } = "Attachments";
    private bool IsVisible { get; set; }
    private List<(string ObjectId, string FolderName)> _targets = new();
    private List<string> DocumentClassEditOptions { get; set; } = new() { "" };

    private List<string> GroupColumns => new() { nameof(AttachmentRow.Folder) };

    protected override void OnInitialized()
    {
        GridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<AttachmentRow>>(this, OnRowSelected);
        GridEvents.OnRecordDoubleClick = EventCallback.Factory.Create<CellClickEventArgs<AttachmentRow>>(this, OnRowDoubleClick);
        GridEvents.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<AttachmentRow>>(this, OnCellEdit);
        GridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<AttachmentRow>>(this, OnCellSave);
    }

    public async Task ShowForm(string formCaption, params (string ObjectId, string FolderName)[] objectIdsAndFolders)
    {
        Caption = formCaption;
        _targets = objectIdsAndFolders.ToList();
        await EnsureInsertFileStateAsync();
        await LoadDataAsync();
        IsVisible = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDataAsync()
    {
        Rows.Clear();

        if (_targets.Count == 0)
            return;

        await LoadDocumentClassOptionsAsync();

        var folderByObject = _targets
            .GroupBy(t => t.ObjectId)
            .ToDictionary(g => g.Key, g => g.First().FolderName);

        var objectIds = folderByObject.Keys.ToList();
        var inClause = string.Join(",", objectIds.Select(id => $"'{id.Replace("'", "''")}'"));
        // VB6 LoadData SQL (FAttachments.frm:663) selects the full attachment
        // schema including revision + webvendors + weblocation. We were
        // dropping those columns on the .NET side, which is why the
        // "Revision / Web Portals / Web Location" columns rendered empty.
        // HHM-485: DATALENGTH(FileImage) rides along so rows whose bytes are
        // stored server-side (embedded + browser-linked uploads) can display a
        // Size even when the filesize column was never written.
        var sql = $@"
            SELECT objectid, filename, documentclass, filesize, filetitle, path,
                   modifieddate, createddate, attacheddate, embedded,
                   revision, webcustomers, webvendors, weblocation,
                   ISNULL(DATALENGTH(FileImage), 0) AS imagesize
            FROM attachments
            WHERE objectid IN ({inClause})
            ORDER BY objectid, filetitle, filename";

        var result = await _db.QueryAsync(sql);
        var foundObjectIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var row in result)
        {
            var objectId = row["objectid"]?.ToString() ?? "";
            foundObjectIds.Add(objectId);
            var fileName = row["filename"]?.ToString() ?? "";
            var embedded = ToBool(row["embedded"]);

            // attachments.filetitle/path are computed by splitting filename on
            // its last backslash, so a name with no directory (every browser
            // upload — <InputFile> exposes no path) computes filetitle = "" and
            // path = the whole name. Split in code instead: Name is always the
            // file, Location is the directory or blank.
            var fileTitle = SplitFileTitle(fileName, row["filetitle"]?.ToString());
            var path = SplitFilePath(fileName, row["path"]?.ToString());

            // VB6 stats the linked file to fill Size/Modified/Created
            // (frm:626-635). The server cannot reach a client path, but the
            // upload stores the bytes and both dates, so read the row first and
            // only stat when the file is genuinely reachable from here.
            long fileSize = ToLong(row["filesize"]);
            if (fileSize <= 0) fileSize = ToLong(row["imagesize"]);
            DateTime? modified = ToDate(row["modifieddate"]);
            DateTime? created = ToDate(row["createddate"]);

            if ((fileSize <= 0 || modified == null || created == null) && File.Exists(fileName))
            {
                var fi = new FileInfo(fileName);
                if (fileSize <= 0) fileSize = fi.Length;
                modified ??= fi.LastWriteTime;
                created ??= fi.CreationTime;
            }
            var attached = ToDate(row["attacheddate"]);

            // VB6 FAttachments.frm:709-721 — Web Portals text is computed from
            // the webcustomers + webvendors bit flags (not the raw bit), Web
            // Location defaults to "Documents" when blank, and both are blanked
            // for object ids that are not customer ("C~") or job ("J~") folders.
            var webCustomers = ToBool(row["webcustomers"]);
            var webVendors = ToBool(row["webvendors"]);
            string webPortals;
            if (webCustomers && webVendors) webPortals = "All";
            else if (webCustomers) webPortals = "Customer";
            else if (webVendors) webPortals = "Vendor";
            else webPortals = "None";

            var webLocation = row["weblocation"]?.ToString() ?? "";
            if (string.IsNullOrWhiteSpace(webLocation))
                webLocation = "Documents";

            if (!(objectId.StartsWith("C~", StringComparison.Ordinal) || objectId.StartsWith("J~", StringComparison.Ordinal)))
            {
                webPortals = "";
                webLocation = "";
            }

            Rows.Add(new AttachmentRow
            {
                ObjectID = objectId,
                Folder = folderByObject.TryGetValue(objectId, out var folder) ? folder : "",
                FileName = fileName,
                FileTitle = fileTitle ?? "",
                DocumentClass = row["documentclass"]?.ToString() ?? "",
                Path = path ?? "",
                FileSizeBytes = fileSize,
                FileSizeDisplay = FormatFileSize(fileSize),
                ModifiedDate = modified,
                CreatedDate = created,
                AttachedDate = attached,
                Embedded = embedded,
                Revision = row["revision"]?.ToString() ?? "",
                WebCustomers = webCustomers,
                WebPortals = webPortals,
                WebLocation = webLocation
            });
        }

        // Add placeholders for target folders that have no files
        foreach (var target in _targets)
        {
            if (!foundObjectIds.Contains(target.ObjectId))
            {
                Rows.Add(new AttachmentRow
                {
                    ObjectID = target.ObjectId,
                    Folder = target.FolderName,
                    FileName = "",
                    FileTitle = "",
                    DocumentClass = "",
                    Path = "",
                    FileSizeBytes = 0,
                    FileSizeDisplay = "",
                    ModifiedDate = null,
                    CreatedDate = null,
                    AttachedDate = null,
                    Embedded = false,
                    Revision = "",
                    WebPortals = "",
                    WebLocation = ""
                });
            }
        }

        // HHM-490 (07-27 "Nothing happens when I click Save As"): VB6's toolbar
        // acts on the grid's CURRENT row (Toolbar_ButtonClick, FAttachments.frm:
        // 1360-1377 uses gData.Row), and a VSFlexGrid always has a current row —
        // the first data row right after load — so legacy Save As works without
        // an explicit row click. The port's _selectedRow stayed null until a
        // click, so the toolbar silently no-opped. Mirror VB6: after every
        // reload keep the previous current row when it still exists, else
        // default to the first file row (highlighted via GetRowCssClass).
        _selectedRow = Rows.FirstOrDefault(r =>
                _selectedRow != null &&
                string.Equals(r.ObjectID, _selectedRow.ObjectID, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(r.FileName, _selectedRow.FileName, StringComparison.OrdinalIgnoreCase))
            ?? Rows.FirstOrDefault(r => r.HasFile);
    }

    private async Task LoadDocumentClassOptionsAsync()
    {
        var rows = await _db.QueryAsync(
            "SELECT DISTINCT documentclass FROM attachments WHERE ISNULL(documentclass,'') <> '' ORDER BY documentclass");

        DocumentClassEditOptions = new[] { "" }
            .Concat(rows.Select(row => row["documentclass"]?.ToString() ?? "")
                .Where(value => !string.IsNullOrWhiteSpace(value)))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>HHM-487: VB6 Find toolbar (FAttachments.frm:233) opens FFind over the
    /// attachments grid. Minimal in-grid Find: prompt for text, then select + highlight
    /// the next attachment whose name contains it (wraps around, find-next from the
    /// current selection). Uses window.prompt (DOM-only, no host prompt primitive exists;
    /// flagged per minimize-JS).</summary>
    private async Task OnFindClick()
    {
        var files = Rows.Where(r => r.HasFile).ToList();
        if (files.Count == 0)
        {
            await Dialogs.AlertAsync("There are no attached files to search.");
            return;
        }

        string? term = await JS.InvokeAsync<string>("prompt", "Find file (by name):", "");
        if (string.IsNullOrWhiteSpace(term)) return;
        term = term.Trim();

        // Find-next: start just after the current selection, wrapping around the list.
        int start = _selectedRow != null ? files.IndexOf(_selectedRow) + 1 : 0;
        if (start < 0) start = 0;
        AttachmentRow? match = null;
        for (int i = 0; i < files.Count; i++)
        {
            var row = files[(start + i) % files.Count];
            if ((row.FileTitle?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (row.FileName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
            {
                match = row;
                break;
            }
        }

        if (match == null)
        {
            await Dialogs.AlertAsync($"No attachment matching \"{term}\" was found.");
            return;
        }

        _selectedRow = match;                 // makes it the active row (toolbar acts on it)
        StateHasChanged();                    // GetRowCssClass highlights it (attachment-found-row)
    }

    private bool _uploadEmbeddedMode;

    // VB6 Form_Load (FAttachments.frm:730): mnuFoldersSub(mcFOLDER_EMBED).Enabled =
    // HFApp.SQLEdition Like "*Express Edition*". Insert File embeds the file's bytes in
    // the database and is only offered on SQL Server Express Edition; on every full
    // edition the folder menu shows it permanently disabled (HHM-480).
    private bool _insertFileEnabled;
    private bool _insertFileEditionChecked;

    private async Task EnsureInsertFileStateAsync()
    {
        if (_insertFileEditionChecked) return;
        _insertFileEditionChecked = true;
        try
        {
            var edition = await _db.ExecuteScalarAsync<string>(
                "SELECT CAST(SERVERPROPERTY('edition') AS varchar(150))");
            _insertFileEnabled = (edition ?? "").Contains("Express Edition", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            _insertFileEnabled = false;
        }
    }

    private async Task TriggerFileBrowser(bool embedded)
    {
        if (embedded && !_insertFileEnabled) return;

        _uploadEmbeddedMode = embedded;
        _showContextMenu = false;
        await JS.InvokeVoidAsync("eval",
            "document.querySelector('.fattachments-file-input input[type=file]').click()");
    }

    private async Task OnFolderFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        var objectId = _selectedRow?.ObjectID ?? _targets.FirstOrDefault().ObjectId;
        if (string.IsNullOrWhiteSpace(objectId))
            return;

        try
        {
            var fileName = file.Name;
            
            // Check if already exists in this folder (represented by objectId)
            var exists = Rows.Any(r => string.Equals(r.ObjectID, objectId, StringComparison.OrdinalIgnoreCase) 
                                       && string.Equals(r.FileName, fileName, StringComparison.OrdinalIgnoreCase));
            if (exists)
            {
                await Dialogs.AlertAsync("This file is already attached.");
                return;
            }

            // VB6 FAttachments.frm:283-287 (AddFile) — warn when linking (not
            // embedding) a local file that may be inaccessible to other users.
            // Blazor <InputFile> exposes only the file name (no path), so a
            // browser-linked file is inherently local-only; warn on every Link
            // (Embedded = false). Insert/Embed mode never warns (VB6 "And Not Embedded").
            if (!_uploadEmbeddedMode)
            {
                if (!await Dialogs.ConfirmAsync(
                        "This is a local file.  It may not be accessible to other users.\nAre you sure this is what you want to do?",
                        "Attach File"))
                    return;
            }

            // IBrowserFile.LastModified is a UTC DateTimeOffset; attacheddate on the
            // same row is GETDATE() (local), so take the local wall clock to match.
            var modified = file.LastModified.LocalDateTime;

            // VB6 AddFile (frm:296-305) writes only base attachment fields.
            // FileTitle/FileSize/Path are computed on Attachments and reject
            // direct insert/update writes.
            var sql = @"
                INSERT INTO attachments(objectid, filename, modifieddate, createddate, attacheddate, embedded)
                VALUES(@ObjectID, @FileName, @ModifiedDate, @CreatedDate, GETDATE(), @Embedded)";

            await _db.ExecuteAsync(sql, new
            {
                ObjectID = objectId,
                FileName = fileName,
                ModifiedDate = modified,
                CreatedDate = modified,
                Embedded = _uploadEmbeddedMode
            });

            // HHM-490: persist the uploaded bytes for Link mode too (Embedded
            // stays false above). VB6 linked rows point at a shared path the
            // desktop app could re-read (FAttachments.frm:806-821), but a
            // browser upload exposes only the bare file name — the server can
            // never re-reach the client's path, so without the bytes every
            // later Open/Print/Save As hit "File not found." Storing FileImage
            // gives linked rows a server-side content source while the grid
            // still presents them as linked (Embedded=false).
            using (var ms = new MemoryStream())
            {
                await file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(ms);
                var data = ms.ToArray();
                var updateSql = "UPDATE attachments SET FileImage=@Data WHERE objectid=@ObjectID AND filename=@FileName";
                await _db.ExecuteAsync(updateSql, new { Data = data, ObjectID = objectId, FileName = fileName });
            }

            await LoadDataAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await Dialogs.AlertAsync($"Error attaching file: {ex.Message}");
        }
    }

    public async Task AddFileAsync(string objectId, bool embedded, string? fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName))
        {
            fileName = await Dialogs.PromptAsync("Enter file path to attach:");
        }

        if (string.IsNullOrWhiteSpace(fileName))
            return;

        if (!File.Exists(fileName))
        {
            await Dialogs.AlertAsync("File not found.");
            return;
        }

        var fileInfo = new FileInfo(fileName);

        // VB6 FAttachments.frm:283-287 — warn when linking (not embedding) a
        // local file. Here a real path is available, so mirror VB6's
        // PathIsLocalPath test: only warn when the path is NOT a UNC/network path.
        if (!embedded && !fileName.StartsWith(@"\\", StringComparison.Ordinal))
        {
            if (!await Dialogs.ConfirmAsync(
                    "This is a local file.  It may not be accessible to other users.\nAre you sure this is what you want to do?",
                    "Attach File"))
                return;
        }

        // VB6 AddFile (frm:296-305) writes only base attachment fields.
        // FileTitle/FileSize/Path are computed on Attachments and reject direct
        // insert/update writes.
        var sql = @"
            INSERT INTO attachments(objectid, filename, modifieddate, createddate, attacheddate, embedded)
            VALUES(@ObjectID, @FileName, @ModifiedDate, @CreatedDate, GETDATE(), @Embedded)";
        await _db.ExecuteAsync(sql, new
        {
            ObjectID = objectId,
            FileName = fileName,
            ModifiedDate = fileInfo.LastWriteTime,
            CreatedDate = fileInfo.CreationTime,
            Embedded = embedded
        });

        if (embedded)
        {
            try
            {
                var data = await File.ReadAllBytesAsync(fileName);
                var updateSql = "UPDATE attachments SET FileImage=@Data WHERE objectid=@ObjectID AND filename=@FileName";
                await _db.ExecuteAsync(updateSql, new { Data = data, ObjectID = objectId, FileName = fileName });
            }
            catch { }
        }

        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task<string?> GetEmbeddedFileAsync(AttachmentRow row)
    {
        var sql = "SELECT FileImage FROM attachments WHERE objectid=@ObjectID AND filename=@FileName";
        var table = _db.SqlExec(sql, new { ObjectID = row.ObjectID, FileName = row.FileName });
        if (table.Rows.Count == 0 || table.Rows[0][0] is not byte[] data)
            return null;

        var tempFile = Path.Combine(Path.GetTempPath(), Path.GetFileName(row.FileName));
        await File.WriteAllBytesAsync(tempFile, data);
        return tempFile;
    }

    private async Task OpenSelectedAsync()
    {
        if (_selectedRow == null || !_selectedRow.HasFile)
            return;

        // HHM-488: VB6 mcFILE_OPEN ShellExecutes the file. A browser cannot open a
        // server/UNC filesystem path (window.open on a path just spawns a broken
        // tab), so read the bytes host-side (HHM-490: shared fallback chain in
        // GetAttachmentBytesAsync) and hand them to hfOpenFile, which blob-opens
        // them in a new tab (PDF/images/text render inline; other types download).
        var bytes = await GetAttachmentBytesAsync(_selectedRow);
        if (bytes == null)
        {
            await Dialogs.AlertAsync("File not found.");
            return;
        }

        var fileName = Path.GetFileName(_selectedRow.FileName);
        if (string.IsNullOrWhiteSpace(fileName)) fileName = _selectedRow.FileTitle;
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("hfOpenFile", fileName, base64, MimeForExtension(fileName));
    }

    // HHM-488: minimal extension→MIME map so viewable types open inline; everything
    // else falls back to octet-stream (browser offers to save).
    private static string MimeForExtension(string fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName)?.TrimStart('.').ToLowerInvariant() ?? "";
        return ext switch
        {
            "pdf" => "application/pdf",
            "png" => "image/png",
            "jpg" or "jpeg" => "image/jpeg",
            "gif" => "image/gif",
            "bmp" => "image/bmp",
            "svg" => "image/svg+xml",
            "txt" or "log" or "csv" => "text/plain",
            "htm" or "html" => "text/html",
            _ => "application/octet-stream",
        };
    }

    private async Task PrintSelectedAsync()
    {
        if (_selectedRow == null || !_selectedRow.HasFile)
            return;

        // HHM-489: VB6 Print ShellExecutes the file's "print" verb. A browser can only
        // print what it can render, so open printable types (PDF / image / text / html)
        // in a hidden frame and invoke the print dialog; anything else can't be printed
        // from the web client (direct the user to Open/Save As + print from its app).
        var ext = System.IO.Path.GetExtension(_selectedRow.FileName)?.TrimStart('.').ToLowerInvariant() ?? "";
        var printable = new[] { "pdf", "png", "jpg", "jpeg", "gif", "bmp", "svg", "txt", "log", "csv", "htm", "html" };
        if (!printable.Contains(ext))
        {
            await Dialogs.AlertAsync(
                $"'{_selectedRow.FileTitle}' can't be printed from the web client. "
                + "Use Open or Save As, then print from the file's own application.");
            return;
        }

        // HHM-490: shared fallback chain (FileImage / server path / web folder).
        var bytes = await GetAttachmentBytesAsync(_selectedRow);
        if (bytes == null)
        {
            await Dialogs.AlertAsync("File not found.");
            return;
        }

        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("hfPrintFile", base64, MimeForExtension(_selectedRow.FileName));
    }

    private async Task SaveAsSelectedAsync()
    {
        if (_selectedRow == null || !_selectedRow.HasFile)
            return;

        // VB6 mcFILE_SAVE (frm:914-915) prompts Save As then FileCopy. In the
        // browser we can't write to an arbitrary server path, so offer the
        // browser's own Save dialog over the file bytes.
        // HHM-490: bytes come from the shared fallback chain, so browser-linked
        // and web-folder files no longer dead-end in "File not found."
        var bytes = await GetAttachmentBytesAsync(_selectedRow);
        if (bytes == null)
        {
            await Dialogs.AlertAsync("File not found.");
            return;
        }

        var suggestedName = Path.GetFileName(_selectedRow.FileName);
        if (string.IsNullOrWhiteSpace(suggestedName))
            suggestedName = _selectedRow.FileTitle;

        // HHM-490 (07-27 "Nothing happens"): the bytes used to ride to the
        // client as base64 over a SignalR JS-interop call (hfSaveFile) — the
        // same blob path the Import/Export wizard dropped on 07-27 for being
        // flaky in Blazor Server ("exported but no file"). Reuse the wizard's
        // proven stack instead: stash the bytes server-side (10-min TTL) and
        // let the browser fetch the real attachment URL (/export/file/{token})
        // via hfSaveAsFromUrl — File System Access Save-As picker where
        // supported, plain download elsewhere. No large payload ever crosses
        // the SignalR circuit.
        var mime = MimeForExtension(suggestedName);
        var token = ExportStash.Put(bytes, suggestedName, mime);
        await JS.InvokeAsync<string>("hfSaveAsFromUrl", $"/export/file/{token}", suggestedName, mime);
    }

    // HHM-490: shared byte-source resolver for Open / Print / Save As.
    // VB6 mnuFilesSub_Click (FAttachments.frm:806-825) layers its sources: the
    // linked path, then "If Not FileExists(Filename) Then Filename =
    // WebFileName" (frm:821 — the web-folder copy from GetDetails), and
    // embedded rows extract FileImage via DBGetFile. The port dropped the
    // web-folder fallback, and browser-linked rows ("Link to File...") carry a
    // bare client-side name the server can never re-read — their uploaded
    // FileImage bytes are the only server-reachable content. Chain:
    // Embedded -> FileImage; server File.Exists(FileName); FileImage
    // (browser-linked rows); web-folder copy under the WebAttachmentsFolder
    // option. Null only after every source fails ("File not found.").
    private async Task<byte[]?> GetAttachmentBytesAsync(AttachmentRow row)
    {
        // Embedded rows: FileImage is the canonical source (VB6 DBGetFile).
        if (row.Embedded)
        {
            var data = TryGetFileImage(row);
            if (data != null) return data;
        }

        // Linked rows whose path the server can actually read (VB6 FileExists).
        if (File.Exists(row.FileName))
            return await File.ReadAllBytesAsync(row.FileName);

        // Browser-linked rows: bytes persisted at upload time (see
        // OnFolderFileSelected) even though Embedded=false.
        if (!row.Embedded)
        {
            var data = TryGetFileImage(row);
            if (data != null) return data;
        }

        // VB6 frm:821 — fall back to the web-folder copy.
        var webFile = await GetWebFolderFilePathAsync(row);
        if (!string.IsNullOrEmpty(webFile) && File.Exists(webFile))
            return await File.ReadAllBytesAsync(webFile);

        return null;
    }

    private byte[]? TryGetFileImage(AttachmentRow row)
    {
        var table = _db.SqlExec(
            "SELECT FileImage FROM attachments WHERE objectid=@ObjectID AND filename=@FileName",
            new { ObjectID = row.ObjectID, FileName = row.FileName });
        if (table.Rows.Count > 0 && table.Rows[0][0] is byte[] data && data.Length > 0)
            return data;
        return null;
    }

    // HHM-490 / VB6 GetDetails (FAttachments.frm:1023-1043): WebRoot comes
    // from the WebAttachmentsFolder option; "C~<customer>" folders look up
    // job_no from tblcustomers and map to WebRoot\Job\Customer\FileTitle,
    // "J~<job>" folders map to WebRoot\Job\FileTitle. Returns "" when the
    // option is blank or the ObjectID has no web-folder mapping (VB6 leaves
    // WebFile empty in exactly those cases).
    private async Task<string> GetWebFolderFilePathAsync(AttachmentRow row)
    {
        try
        {
            var webRoot = await _db.ExecuteScalarAsync<string>(
                @"SELECT TOP 1 OptionValue FROM AppOptions
                  WHERE OptionName='WebAttachmentsFolder'
                    AND ISNULL(UID,'')=''
                    AND ISNULL(divisionid,0) IN (0, @DivisionID)
                  ORDER BY divisionid DESC",
                new { SessionState.DivisionID }) ?? "";
            if (string.IsNullOrWhiteSpace(webRoot))
                return "";

            if (row.ObjectID.StartsWith("C~", StringComparison.Ordinal))
            {
                var customer = row.ObjectID.Substring(2);
                if (customer.Length == 0) return "";
                var job = await _db.ExecuteScalarAsync<string>(
                    "select job_no from tblcustomers where customer_no=@Customer",
                    new { Customer = customer }) ?? "";
                if (job.Length == 0) return "";
                return Path.Combine(webRoot, job, customer, row.FileTitle);
            }

            if (row.ObjectID.StartsWith("J~", StringComparison.Ordinal))
            {
                var job = row.ObjectID.Substring(2);
                if (job.Length == 0) return "";
                return Path.Combine(webRoot, job, row.FileTitle);
            }

            return "";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Couldn't resolve web-folder path for attachment {FileName}", row.FileName);
            return "";
        }
    }

    private async Task RemoveSelectedAsync()
    {
        if (_selectedRow == null || !_selectedRow.HasFile)
            return;

        var sql = "DELETE FROM attachments WHERE objectid=@ObjectID AND filename=@FileName";
        await _db.ExecuteAsync(sql, new { ObjectID = _selectedRow.ObjectID, FileName = _selectedRow.FileName });

        // HHM-490: VB6 .RemoveItem keeps a current row (the next row slides
        // into the removed row's index — VSFlexGrid behavior), so the toolbar
        // never goes dead after a Remove. Mirror that instead of nulling the
        // selection: next file row at the same index, else the previous one.
        var removedObjectId = _selectedRow.ObjectID;
        var removedFolder = _selectedRow.Folder;
        var idx = Rows.IndexOf(_selectedRow);
        Rows.Remove(_selectedRow);
        _selectedRow = Rows.Skip(Math.Max(idx, 0)).FirstOrDefault(r => r.HasFile)
            ?? Rows.Take(Math.Max(idx, 0)).LastOrDefault(r => r.HasFile);

        // A target folder always keeps its header row, empty or not — same
        // placeholder LoadDataAsync adds. Without this the folder disappeared
        // when its last file was removed.
        if (_targets.Any(t => string.Equals(t.ObjectId, removedObjectId, StringComparison.OrdinalIgnoreCase))
            && !Rows.Any(r => string.Equals(r.ObjectID, removedObjectId, StringComparison.OrdinalIgnoreCase)))
        {
            Rows.Add(new AttachmentRow { ObjectID = removedObjectId, Folder = removedFolder });
        }

        await InvokeAsync(StateHasChanged);
    }

    // VB6 FAttachments.frm:869 — "Show in web folder" is enabled only for
    // customer ("C~") or job ("J~") object folders.
    private bool ShowInWebFolderEnabled =>
        _selectedRow != null &&
        (_selectedRow.ObjectID.StartsWith("C~", StringComparison.Ordinal) ||
         _selectedRow.ObjectID.StartsWith("J~", StringComparison.Ordinal));

    // VB6 mcFILE_SHOWINWEBFOLDER (frm:903-906) shells the web folder in
    // Explorer. A Blazor Server app cannot open a native shell window, so we
    // surface the web location instead. Platform-limited follow-up.
    private async Task ShowInWebFolderAsync()
    {
        if (_selectedRow == null || !ShowInWebFolderEnabled)
            return;

        var loc = string.IsNullOrWhiteSpace(_selectedRow.WebLocation) ? "Documents" : _selectedRow.WebLocation;
        await Dialogs.AlertAsync($"Web folder: {loc}\n\n(Opening the server web folder requires the desktop shell and is not available in the web client.)");
    }

    // VB6 mcFILE_COPY (frm:924-925) copies the file path to the clipboard.
    private async Task CopySelectedAsync()
    {
        if (_selectedRow == null || !_selectedRow.HasFile)
            return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _selectedRow.FileName);
        }
        catch
        {
            await Dialogs.AlertAsync("Unable to copy to the clipboard.");
        }
    }

    private void OnRowSelected(RowSelectEventArgs<AttachmentRow> args)
    {
        _selectedRow = args.Data;
    }

    private async Task OnRowDoubleClick(CellClickEventArgs<AttachmentRow> args)
    {
        if (args.Data != null && args.Data.HasFile)
            await OpenSelectedAsync();
    }

    private Task OnCellEdit(CellEditArgs<AttachmentRow> args)
    {
        if (!string.Equals(args.ColumnName, nameof(AttachmentRow.DocumentClass), StringComparison.Ordinal)
            || args.Data?.HasFile != true)
        {
            args.Cancel = true;
        }

        return Task.CompletedTask;
    }

    private async Task OnCellSave(CellSaveArgs<AttachmentRow> args)
    {
        if (string.Equals(args.ColumnName, nameof(AttachmentRow.DocumentClass), StringComparison.Ordinal)
            && args.Data != null)
        {
            await OnDocumentClassChanged(args.Data, args.Value?.ToString());
        }
    }

    private async Task OnDocumentClassChanged(AttachmentRow row, string? value)
    {
        if (!row.HasFile)
            return;

        row.DocumentClass = value ?? "";
        var sql = "UPDATE attachments SET documentclass=@Doc WHERE objectid=@ObjectID AND filename=@FileName";
        await _db.ExecuteAsync(sql, new { Doc = row.DocumentClass, ObjectID = row.ObjectID, FileName = row.FileName });
    }

    private void Close()
    {
        IsVisible = false;
        StateHasChanged();
    }

    private static bool ToBool(object? value)
    {
        if (value == null || value == DBNull.Value) return false;
        if (value is bool b) return b;
        if (value is int i) return i != 0;
        return value.ToString()?.Equals("True", StringComparison.OrdinalIgnoreCase) == true;
    }

    private static long ToLong(object? value)
    {
        if (value == null || value == DBNull.Value) return 0;
        if (value is long l) return l;
        if (long.TryParse(value.ToString(), out var parsed)) return parsed;
        return 0;
    }

    private static DateTime? ToDate(object? value)
    {
        if (value == null || value == DBNull.Value) return null;
        if (value is DateTime dt) return dt;
        if (DateTime.TryParse(value.ToString(), out var parsed)) return parsed;
        return null;
    }

    // HHM-485: exact port of VB6 ClsFileInfo.FormatFileSize
    // (ClsFileInfo.cls:545-565) so the Size text matches legacy —
    // "n,nnn bytes" under 1 KB, whole kilobytes ("20 KB") up to ~1 MB,
    // then MB / GB with VB6's banded precisions. The previous 2-decimal
    // format ("19.53 KB") did not match the legacy grid.
    private static string FormatFileSize(long bytes)
    {
        const long KB = 1024;
        const long MB = KB * KB;
        if (bytes <= 0) return "";
        if (bytes < KB) return $"{bytes:#,##0} bytes";
        var band = bytes / KB;                       // VB6 "SIZE \ KB"
        if (band < 1000) return $"{bytes / (double)KB:0} KB";
        if (band < 10000) return $"{bytes / (double)MB:0.00} MB";
        if (band < 100000) return $"{bytes / (double)MB:0.0} MB";
        if (band < 1000000) return $"{bytes / (double)MB:0} MB";
        return $"{bytes / (double)MB / KB:0.00} GB";
    }

    private static int LastSeparator(string fileName) =>
        Math.Max(fileName.LastIndexOf('\\'), fileName.LastIndexOf('/'));

    private static string SplitFileTitle(string fileName, string? computed)
    {
        if (!string.IsNullOrEmpty(computed)) return computed;
        var i = LastSeparator(fileName);
        return i < 0 ? fileName : fileName[(i + 1)..];
    }

    // Blank for anything attached from the browser: a page is never given the
    // local file path, so there is no directory to store. Desktop-attached rows
    // keep their real path.
    private static string SplitFilePath(string fileName, string? computed) =>
        LastSeparator(fileName) < 0 ? "" : computed ?? "";

    public class AttachmentRow
    {
        public string ObjectID { get; set; } = "";
        public string Folder { get; set; } = "";
        public string FileName { get; set; } = "";
        public string FileTitle { get; set; } = "";
        public string DocumentClass { get; set; } = "";
        public string Path { get; set; } = "";
        public long FileSizeBytes { get; set; }
        public string FileSizeDisplay { get; set; } = "";
        public DateTime? ModifiedDate { get; set; }
        public DateTime? CreatedDate { get; set; }
        public DateTime? AttachedDate { get; set; }
        public bool Embedded { get; set; }

        // VB6 columns previously dropped on the .NET side — added so the
        // grid no longer renders empty Revision / Web Portals / Web
        // Location columns. Mapped from attachments.revision /
        // attachments.webvendors / attachments.weblocation respectively.
        public string Revision { get; set; } = "";
        public bool WebCustomers { get; set; }
        public string WebPortals { get; set; } = "";
        public string WebLocation { get; set; } = "";

        public bool HasFile => !string.IsNullOrWhiteSpace(FileName);
        // HHM-485: VB6 always shows the real path in Location (frm:643) — an
        // embedded row is marked by the blue name, never by the word "Embedded".
        public string LocationDisplay => Path;

        // HHM-485: VB6 formats with "general date" — date-only when the time
        // is exactly midnight, otherwise with seconds (frm:621-637).
        private static string GeneralDate(DateTime? d) =>
            d == null ? "" : d.Value.TimeOfDay == TimeSpan.Zero
                ? d.Value.ToString("M/d/yyyy")
                : d.Value.ToString("M/d/yyyy h:mm:ss tt");
        public string ModifiedDateDisplay => GeneralDate(ModifiedDate);
        public string CreatedDateDisplay => GeneralDate(CreatedDate);
        public string AttachedDateDisplay => GeneralDate(AttachedDate);

        // VB6 showed the Windows shell file-type icon before each filename
        // (SHGetFileInfo). The web client has no shell; map the extension to a
        // bundled icon so a file-type glyph still precedes every name. Only
        // Excel and a generic document icon ship with the app, so Excel files
        // get the Excel glyph and everything else the generic document glyph.
        public string FileIconUrl
        {
            get
            {
                if (!HasFile) return "";
                var ext = System.IO.Path.GetExtension(FileName)?.TrimStart('.').ToLowerInvariant() ?? "";
                return ext switch
                {
                    "xls" or "xlsx" or "xlsm" or "csv" => "images/16/excel2.ico",
                    _ => "images/16/document.ico",
                };
            }
        }
    }
}
