@page "/feedback-ticket/{TicketNumber}"
@layout HFComponent
@rendermode InteractiveServer
@namespace HomeFront.Components.Pages

@*
    One feedback ticket, opened from the Feedback board into its OWN MDI tab.

    This is deliberately a THIN WRAPPER around FFeedback rather than a second @page route on
    FFeedback itself: FMain's "in-place update of the active tab" branch fires whenever the
    route being opened maps to the SAME component type as the active tab. With the board and a
    ticket both being FFeedback, clicking "Feedback" from a ticket while another ticket tab sat
    next to it silently rewrote THAT ticket tab's route to the board instead of focusing the
    board tab. A distinct page type for the ticket keeps the two apart, so board↔ticket always
    goes through the focus/dedup path.

    The ticket UI itself is not duplicated — FFeedback renders it, in ticket-only mode, from
    the same template the board uses for its own new-ticket composer.
*@

<FFeedback TicketNumber="@TicketNumber" />

@code {
    /// <summary>Ticket number from the route (FMain maps the path segment onto this parameter).</summary>
    [Parameter] public string? TicketNumber { get; set; }
}
