@page "/quote"
@page "/quote/{QuoteNumber}"
@rendermode InteractiveServer

@using HomeFront.Models
@using HomeFront.Components.Pages
@using System.Data
@using System.Globalization
@using System.Reflection
@using Microsoft.Data.SqlClient
@using Fx.ControlKit.Notifications

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject ILogger<FQuote> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject IGridLayoutService GridLayoutSvc
@inject ISessionStateService SessionState
@inject IReportSeedParameters ReportSeeds
@inject IWebHostEnvironment WebHost
@using HomeFront.Data
@inject DbWrapperSqlServer db

<PageTitle>Quote - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Quote...</div>
    </div>
}

@* ── TOOLBAR ─────────────────────────────────────────── *@
@namespace HomeFront.Components.Pages
<div class="toolbar-cntr">
    <button class="tbar-btn" @onclick="OnOpenClick">
        <img src="images/32/open.ico" alt="Open" onerror="this.style.display='none'" />
        <span class="tool-label">Open</span>
    </button>
    <button class="tbar-btn" disabled="@(!mDirty)" @onclick="OnSaveClick">
        <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
        <span class="tool-label">Save</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingQuote)" @onclick="OnDeleteClick">
        <img src="images/32/delete.ico" alt="Delete" onerror="this.style.display='none'" />
        <span class="tool-label">Delete</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingQuote)" @onclick="OnSaveAsClick">
        <img src="images/32/saveas.ico" alt="Save As" onerror="this.style.display='none'" />
        <span class="tool-label">Save As</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingQuote)" @onclick="OnAttachmentsClick">
        <img src="images/32/Attachments.ico" alt="Attachments" onerror="this.style.display='none'" />
        <span class="tool-label">Attachments</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" disabled="@(!IsExistingQuote)" @onclick="OnTakeoffOneTimeClick">
        <img src="images/32/TakeoffOneTime.ico" alt="One Time" onerror="this.style.display='none'" />
        <span class="tool-label">One Time</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingQuote)" @onclick="OnTakeoffItemClick">
        <img src="images/32/TakeoffItem.ico" alt="Item" onerror="this.style.display='none'" />
        <span class="tool-label">Item</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingQuote)" @onclick="OnTakeoffAssemblyClick">
        <img src="images/32/TakeoffAssembly.ico" alt="Assembly" onerror="this.style.display='none'" />
        <span class="tool-label">Assembly</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingQuote)" @onclick="OnTakeoffCustomClick">
        <img src="images/32/TakeoffCustom.ico" alt="Custom" onerror="this.style.display='none'" />
        <span class="tool-label">Custom</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" disabled="@(!IsExistingQuote)" @onclick="OnPreviewClick">
        <img src="images/32/Preview.ico" alt="Preview" onerror="this.style.display='none'" />
        <span class="tool-label">Preview</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingQuote)" @onclick="OnRePriceClick">
        <img src="images/32/RePrice.ico" alt="Rfrsh Costs" onerror="this.style.display='none'" />
        <span class="tool-label">Rfrsh Costs</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" disabled="@(!IsExistingQuote)" @onclick="OnGenerateJobClick">
        <img src="images/32/CreateJob.ico" alt="Create Job" onerror="this.style.display='none'" />
        <span class="tool-label">Create Job</span>
    </button>
</div>

<h3 style="margin-bottom: 16px;">@FormCaption</h3>

@* ── HEADER SECTION ─────────────────────────────────── *@
<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 16px;">
    @* LEFT: Quote Info Fields *@
    <div class="panel-card">
        <div class="section-title">Quote Information</div>
        <div class="form-field">
            <label>Quote #</label>
            <TextBoxControl @bind-Value="txtJob" @bind-Value:after="OnJobChanged"
                            Enabled="@JobFieldEnabled" MaxLength="12" CssClass="qf-input" />
        </div>
        <div class="form-field">
            <label>Description</label>
            <TextBoxControl @bind-Value="txtDescription" @bind-Value:after="OnDescriptionChanged"
                            Enabled="@FieldsEnabled" MaxLength="50" CssClass="qf-input" />
        </div>
        <div class="form-field">
            <label>GL Prefix</label>
            @if (ShowGLPrefixCombo)
            {
                <DropDownListControl TValue="string" TItem="ComboItem"
                                     Value="@cboGLPrefixValue"
                                     ValueChanged="OnGLPrefixComboChanged"
                                     DataSource="@GLPrefixItems"
                                     TextFieldName="Text" ValueFieldName="Value"
                                     Placeholder="-- Select --"
                                     Enabled="@FieldsEnabled" Width="100%" CssClass="qf-input" />
            }
            else
            {
                <TextBoxControl @bind-Value="txtGLPrefix" @bind-Value:after="OnGLPrefixTextChanged"
                                Enabled="@FieldsEnabled" CssClass="qf-input" />
            }
        </div>
        <div class="form-field">
            <label>Address</label>
            <TextBoxControl @bind-Value="txtAddress" @bind-Value:after="OnFieldChanged"
                            Enabled="@FieldsEnabled" CssClass="qf-input" />
        </div>
        <div class="form-field">
            <label>City</label>
            <TextBoxControl @bind-Value="txtCity" @bind-Value:after="OnFieldChanged"
                            Enabled="@FieldsEnabled" CssClass="qf-input" />
        </div>
        <div class="form-field qf-gap4">
            <label>Province</label>
            <TextBoxControl @bind-Value="txtProvince" @bind-Value:after="OnFieldChanged"
                            Enabled="@FieldsEnabled" CssClass="qf-w80" />
            <label class="qf-lbl50">Postal</label>
            <TextBoxControl @bind-Value="txtPostal" @bind-Value:after="OnFieldChanged"
                            Enabled="@FieldsEnabled" CssClass="qf-w100" />
        </div>
        <div class="form-field qf-gap4">
            <label>Phone</label>
            <TextBoxControl @bind-Value="txtPhone" @bind-Value:after="OnFieldChanged"
                            Enabled="@FieldsEnabled" CssClass="qf-w120" />
            <label class="qf-lbl30">Fax</label>
            <TextBoxControl @bind-Value="txtFax" @bind-Value:after="OnFieldChanged"
                            Enabled="@FieldsEnabled" CssClass="qf-w120" />
        </div>
        <div class="form-field">
            <label>Community</label>
            <DropDownListControl TValue="string" TItem="ComboItem"
                                 Value="@cboCommunityValue"
                                 ValueChanged="OnCommunityValueChanged"
                                 DataSource="@CommunityItems"
                                 TextFieldName="Text" ValueFieldName="Value"
                                 Enabled="@FieldsEnabled" Width="100%" CssClass="qf-input" />
        </div>
        <div class="form-field">
            <label>Phase</label>
            <DropDownListControl TValue="string" TItem="ComboItem"
                                 Value="@cboPhaseValue"
                                 ValueChanged="OnPhaseValueChanged"
                                 DataSource="@PhaseItems"
                                 TextFieldName="Text" ValueFieldName="Value"
                                 Enabled="@FieldsEnabled" Width="100%" CssClass="qf-input" />
        </div>
        <div class="form-field">
            <label>Model</label>
            <DropDownListControl TValue="string" TItem="ComboItem"
                                 Value="@cboModelValue"
                                 ValueChanged="OnModelValueChanged"
                                 DataSource="@ModelItems"
                                 TextFieldName="Text" ValueFieldName="Value"
                                 Enabled="@FieldsEnabled" Width="100%" CssClass="qf-input" />
        </div>
        <div class="form-field qf-gap4">
            <label>Lot</label>
            <TextBoxControl @bind-Value="txtLot" @bind-Value:after="OnFieldChanged"
                            Enabled="@FieldsEnabled" CssClass="qf-w80" />
            <label class="qf-lbl40">Block</label>
            <TextBoxControl @bind-Value="txtBlock" @bind-Value:after="OnFieldChanged"
                            Enabled="@FieldsEnabled" CssClass="qf-w80" />
            <label class="qf-lbl50">LotPlan</label>
            <TextBoxControl @bind-Value="txtLotPlan" @bind-Value:after="OnFieldChanged"
                            Enabled="@FieldsEnabled" CssClass="qf-w80" />
        </div>
        <div class="form-field">
            <label>Status</label>
            <DropDownListControl TValue="int" TItem="ComboItem"
                                 Value="@cboStatusIndex"
                                 ValueChanged="OnStatusValueChanged"
                                 DataSource="@StatusItems"
                                 TextFieldName="Text" ValueFieldName="Value"
                                 Enabled="@FieldsEnabled" Width="100%" CssClass="qf-input" />
        </div>
    </div>

    @* MIDDLE: Properties Panel *@
    <div class="panel-card" style="overflow-y: auto; max-height: 440px;">
        <div class="section-title">Properties</div>
        @if (FieldsEnabled)
        {
            <div style="font-size: 12px;">
                @* Tax Groups *@
                <details open>
                    <summary style="font-weight: 700; cursor: pointer; padding: 4px 0; color: #0d6efd;">Tax Groups</summary>
                    <div style="padding-left: 16px;">
                        <div class="form-field qf-prop-row">
                            <label class="qf-prop-lbl">Labour</label>
                            <DropDownListControl TValue="string" TItem="ComboItem"
                                                 Value="@LabourTaxGroup"
                                                 ValueChanged="OnLabourTaxGroupChanged"
                                                 DataSource="@TaxGroupItems"
                                                 TextFieldName="Text" ValueFieldName="Value"
                                                 Width="100%" CssClass="qf-prop-input" />
                        </div>
                        <div class="form-field qf-prop-row">
                            <label class="qf-prop-lbl">Material</label>
                            <DropDownListControl TValue="string" TItem="ComboItem"
                                                 Value="@MaterialTaxGroup"
                                                 ValueChanged="OnMaterialTaxGroupChanged"
                                                 DataSource="@TaxGroupItems"
                                                 TextFieldName="Text" ValueFieldName="Value"
                                                 Width="100%" CssClass="qf-prop-input" />
                        </div>
                        <div class="form-field qf-prop-row">
                            <label class="qf-prop-lbl">Subcontract</label>
                            <DropDownListControl TValue="string" TItem="ComboItem"
                                                 Value="@SubContractTaxGroup"
                                                 ValueChanged="OnSubContractTaxGroupChanged"
                                                 DataSource="@TaxGroupItems"
                                                 TextFieldName="Text" ValueFieldName="Value"
                                                 Width="100%" CssClass="qf-prop-input" />
                        </div>
                        <div class="form-field qf-prop-row">
                            <label class="qf-prop-lbl">Equipment</label>
                            <DropDownListControl TValue="string" TItem="ComboItem"
                                                 Value="@EquipmentTaxGroup"
                                                 ValueChanged="OnEquipmentTaxGroupChanged"
                                                 DataSource="@TaxGroupItems"
                                                 TextFieldName="Text" ValueFieldName="Value"
                                                 Width="100%" CssClass="qf-prop-input" />
                        </div>
                        <div class="form-field qf-prop-row">
                            <label class="qf-prop-lbl">Overhead</label>
                            <DropDownListControl TValue="string" TItem="ComboItem"
                                                 Value="@OverheadTaxGroup"
                                                 ValueChanged="OnOverheadTaxGroupChanged"
                                                 DataSource="@TaxGroupItems"
                                                 TextFieldName="Text" ValueFieldName="Value"
                                                 Width="100%" CssClass="qf-prop-input" />
                        </div>
                        <div class="form-field qf-prop-row">
                            <label class="qf-prop-lbl">Other</label>
                            <DropDownListControl TValue="string" TItem="ComboItem"
                                                 Value="@OtherTaxGroup"
                                                 ValueChanged="OnOtherTaxGroupChanged"
                                                 DataSource="@TaxGroupItems"
                                                 TextFieldName="Text" ValueFieldName="Value"
                                                 Width="100%" CssClass="qf-prop-input" />
                        </div>
                    </div>
                </details>

                @* Custom Fields — grouped by category *@
                @foreach (var group in GetPropertiesGrouped())
                {
                    <details>
                        <summary style="font-weight: 700; cursor: pointer; padding: 4px 0; color: #0d6efd;">@group.CategoryName</summary>
                        <div style="padding-left: 16px;">
                            @foreach (var prop in group.Fields)
                            {
                                var capturedProp = prop;
                                <div class="form-field qf-prop-row">
                                    <label class="qf-prop-lbl">@prop.Name</label>
                                    @if (prop.DataType == "Bit")
                                    {
                                        <DropDownListControl TValue="string" TItem="ComboItem"
                                                             Value="@capturedProp.Value"
                                                             ValueChanged="@(v => OnPropertyValueChanged(capturedProp, v))"
                                                             DataSource="@BitPickItems"
                                                             TextFieldName="Text" ValueFieldName="Value"
                                                             Width="100%" CssClass="qf-prop-input" />
                                    }
                                    else if (!string.IsNullOrEmpty(prop.PickList))
                                    {
                                        <DropDownListControl TValue="string" TItem="ComboItem"
                                                             Value="@capturedProp.Value"
                                                             ValueChanged="@(v => OnPropertyValueChanged(capturedProp, v))"
                                                             DataSource="@GetPickListItems(capturedProp.PickList)"
                                                             TextFieldName="Text" ValueFieldName="Value"
                                                             Width="100%" CssClass="qf-prop-input" />
                                    }
                                    else
                                    {
                                        <TextBoxControl Value="@capturedProp.Value"
                                                        ValueChanged="@(v => OnPropertyValueChanged(capturedProp, v))"
                                                        MaxLength="@(prop.Length > 0 ? prop.Length : 255)"
                                                        CssClass="qf-prop-input" />
                                    }
                                </div>
                            }
                        </div>
                    </details>
                }
            </div>
        }
    </div>

    @* RIGHT: Notes *@
    <div class="panel-card">
        <div class="section-title">Notes</div>
        <TextAreaControl @bind-Value="txtNotes" @bind-Value:after="OnNotesChanged"
                         Rows="14" MaxLength="8000" Enabled="@FieldsEnabled"
                         CssClass="qf-notes" />
    </div>
</div>

@* ── ITEMS GRID ─────────────────────────────────────── *@
@* VB6 ColorizeItems (FQuote.frm:2410): per-row fore/back colour come from the
   AppOptions Format_* values. RowCssClassSelector can only return class names,
   so the DB-derived colours are surfaced as inherited CSS custom properties on
   the host below and the scoped .qi-* classes (FQuote.razor.css) consume them
   via var() — colours stay DB-driven, never hardcoded. *@
<div class="panel-card quote-items-host" style="@ItemsHostStyle"
     @oncontextmenu="OnItemsContextMenu" @oncontextmenu:preventDefault="true">
    <div class="section-title">Items</div>
    <GridControl @ref="gItems"
            TValue="QuoteItemRow"
            DataSource="@ItemsData"
            AllowSelection="true"
            AllowSorting="true"
            AllowResizing="true"
            EnableHover="true"
            Height="600px"
            RowHeight="32"
            RowCssClassSelector="@GetItemRowCss"
            FilterSettingsRef="@filterSettings"
            PageSettingsRef="@pageSettings"
            SelectionSettingsRef="@selectionSettings"
            EditSettingsRef="@editSettings"
            EventsRef="@gridEvents">
        <GridColumnsBase @key="gItemsLayoutVersion">
            <GridColumn Field="EstItemID" HeaderText="ID" Width="1px" Visible="false" IsPrimaryKey="true" AllowEditing="false" />
            <GridColumn Field="RowState" HeaderText="" Width="1px" Visible="false" AllowEditing="false" />
            @if (HasGridLayout)
            {
                foreach (var entry in GetOrderedGridLayout())
                {
                    var layout = entry.Layout;
                    var fieldName = entry.Field;
                    var columnType = entry.ColumnType;
                    var textAlign = entry.TextAlign;
                    var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                    var width = layout.Width.HasValue && layout.Width.Value > 0
                        ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                        : null;
                    var format = GetFormatForField(fieldName, columnType);
                    var allowEdit = IsFieldEditable(fieldName);

                    @* ── Long-text fields: display + popup-button (VB6 FComments.Edit) ─── *@
                    if (_popupTextFields.Contains(fieldName))
                    {
                        <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="false" Visible="true">
                            <Template>
                                @{ var data = (QuoteItemRow)context; }
                                <div class="poindex-cell">
                                    <span class="poindex-text" title="@GetPopupFieldValue(data, fieldName)">@TruncateText(GetPopupFieldValue(data, fieldName), fieldName.Equals("ItemDesc", StringComparison.OrdinalIgnoreCase) ? 35 : 20)</span>
                                    <button class="poindex-btn fx-grid-popup-btn"
                                            @onclick="() => OnEditPopupField(data, fieldName)"
                                            @onclick:stopPropagation="true">…</button>
                                </div>
                            </Template>
                        </GridColumn>
                    }
                    @* ── Lookup fields with … button (VB6 gItems_CellButtonClick) ───
                       STANDARD FlexKit edit button (AlwaysShowEditButton) opens FPickList
                       via OnEditButtonClick → OnPickLookupField. Replaces the hand-rolled
                       span+… template; the cell shows the raw field value (GetLookupDisplayValue
                       returned the same row.<field> the Field binds), Ellipsis-clipped. *@
                    else if (_lookupPickerFields.Contains(fieldName))
                    {
                        @* TextAlign flows from GetOrderedGridLayout so PO Index
                           data right-aligns like legacy (HHM-613 issue 4); the
                           other lookup fields stay left-aligned. *@
                        <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width"
                                      AllowEditing="false" Visible="true"
                                      TextAlign="@textAlign"
                                      ShowEditButton="true" AlwaysShowEditButton="true"
                                      ClipMode="ClipMode.Ellipsis" />
                    }
                    else
                    {
                    <GridColumn Field="@fieldName"
                                  HeaderText="@headerText"
                                  Width="@width"
                                  Type="@columnType"
                                  TextAlign="@textAlign"
                                  Format="@format"
                                  AllowEditing="@allowEdit"
                                  ClipMode="ClipMode.Ellipsis"
                                  Visible="true" />
                    }
                }
            }
            else
            {
                @* Belt-and-braces fallback (pre-layout-load render only —
                   LoadGridLayoutAsync injects the same set as a real layout when
                   AppGridLayout is empty). Mirrors the VB6 FQuote.frx designer
                   defaults: visible set, order, captions, twip widths /15+16
                   (HHM-613 issue 3). Two "Costed Tax" columns are faithful. *@
                <GridColumn Field="JCCostCodeDesc" HeaderText="Cost Code Desc" Width="105px" AllowEditing="false" />
                <GridColumn Field="JCCategoryDesc" HeaderText="JC Category Desc" Width="113px" AllowEditing="false" />
                <GridColumn Field="ItemDesc" HeaderText="Description" Width="80px" />
                <GridColumn Field="BudgetVendorName" HeaderText="Vendor Name" Width="80px" AllowEditing="false" />
                <GridColumn Field="BudgetQty" HeaderText="Qty" Width="44px" Format="N2" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                <GridColumn Field="OrderUOM" HeaderText="UOM" Width="53px" />
                <GridColumn Field="BudgetRate" HeaderText="Unit Cost" Width="71px" Format="N4" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                <GridColumn Field="BudgetPretax" HeaderText="Pretax" Width="58px" Format="C2" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                <GridColumn Field="BudgetTaxGroup" HeaderText="Tax Grp" Width="66px" />
                <GridColumn Field="BudgetJCTax" HeaderText="Costed Tax" Width="80px" Format="C2" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                <GridColumn Field="POJCTax" HeaderText="Costed Tax" Width="80px" Format="C2" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                <GridColumn Field="BudgetNJCTax" HeaderText="Non Costed Tax" Width="93px" Format="C2" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                <GridColumn Field="POIndex" HeaderText="POIndex" Width="80px" TextAlign="TextAlign.Right" />
                <GridColumn Field="ExcludeFromPO" HeaderText="Exclude From PO" Width="69px" Type="ColumnType.CheckBox" />
            }
        </GridColumnsBase>
    </GridControl>
</div>

@* ── CONFIRM SAVE DIALOG ────────────────────────────── *@
<DialogControl Visible="@ShowSavePrompt"
               Header="Save Changes"
               Width="400px"
               IsModal="true"
               ShowCloseIcon="true"
               OnClose="OnSavePromptCancel">
    <ChildContent>
        <h5>@FormCaption has changed.</h5>
        <p>Do you want to save these changes?</p>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="OnSavePromptYes">Yes</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnSavePromptNo">No</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnSavePromptCancel">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@* ── In-grid popup text editor (VB6 FComments.Edit) ──── *@
<DialogControl Visible="@ShowTextEditor"
               Header="@TextEditorTitle"
               Width="480px"
               IsModal="true"
               ShowCloseIcon="true"
               OnClose="OnTextEditorCancel">
    <ChildContent>
        <TextAreaControl @bind-Value="TextEditorValue" Rows="10"
                         MaxLength="@TextEditorMaxLength" CssClass="qf-texteditor" />
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="OnTextEditorOk">OK</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnTextEditorCancel">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@* ── Items Grid Context Menu (VB6 FMain.mnuEstimateItemsGrid) ──────────
   Captions mirror FMain.frm:1356-1414; each item is wired to the action VB6's
   mnuEstimateItemsGridSub_Click (FQuote.frm:2543) runs for that menu Index. *@
@if (_showItemsContextMenu)
{
    <div class="context-menu-backdrop"
         @onclick="CloseContextMenu"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"></div>
    <div class="context-menu" style="left:@(_contextMenuX)px;top:@(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <button class="context-menu-close" type="button"
                title="Close" aria-label="Close menu"
                @onclick="CloseContextMenu">×</button>
        @* Index 0 — mcITEM_COPYITEMS *@
        <button @onclick="OnCtxMakeCopy" disabled="@(_ctxRow == null)">Make a Copy</button>
        @* Index 1 — mcITEM_CHANGEITEM (Substitute phase/item via picklist) *@
        <button @onclick="OnCtxSplitItems" disabled="@(!CtxChangeItemEnabled)">Split items...</button>
        @* Index 2 — mcITEM_REMOVEITEMS *@
        <button @onclick="OnCtxRemoveItems" disabled="@(_ctxRow == null)">Substitute Item...</button>
        @* Index 4 — mcITEM_VIEWFILES *@
        <button @onclick="OnCtxViewFiles" disabled="@(_ctxRow == null)">Modify Item</button>
        <hr />
        @* Index 6 — mcITEM_LINKTOFILE / Index 5 — mcITEM_INSERTFILE *@
        <button @onclick="OnCtxInsertFile" disabled="@(_ctxRow == null)">Insert File...</button>
        <button @onclick="OnCtxLinkToFile" disabled="@(_ctxRow == null)">Attachments...</button>
        <hr />
        @* Index 8 — mcITEM_CANCELBUDGETS (VB6 force-disables this on gItems) *@
        <button disabled="true">Cancel Budget...</button>
        <hr />
        @* Index 10 — mcITEM_SAVEONETIMETODB (only when item is one-time) *@
        <button @onclick="OnCtxSaveOneTime" disabled="@(!CtxSaveOneTimeEnabled)">Save to phase/item db...</button>
        @* Index 11 — mcITEM_UPDATEPRICELIST (FQuote.frm:2683) — opens
           FPriceListUpdate for the right-clicked line and pushes its vendor cost
           into tblVendorCost (VB6 single-row r = .Row). *@
        <button @onclick="OnCtxUpdatePricelist" disabled="@(_ctxRow == null)">Update Pricelist...</button>
        @* Index 12 — mcITEM_COMPAREPRICES *@
        <button @onclick="OnCtxComparePricing" disabled="@(_ctxRow == null)">Compare Pricing...</button>
        @* Index 13 — Formatting Rules (FEstimateItemsFormatting) *@
        <button @onclick="OnCtxFormattingRules">Formatting Rules...</button>
    </div>
}

@* ── Refresh-Costs dialog (VB6 FEstimateItemsRefreshCosts.Showform) ──── *@
<FEstimateItemsRefreshCosts @ref="refreshCostsDialog"
                            @bind-IsVisible="_showRefreshCostsDialog"
                            DivisionID="@SessionState.DivisionID.ToString()"
                            OnConfirmed="OnRefreshCostsConfirmed" />

@* ── Compare-Pricing dialog (VB6 FPriceComparison.Showform) ──────────── *@
<FPriceComparison @ref="priceComparisonDialog" @bind-IsVisible="_showPriceComparison" />

@* ── Formatting-Rules dialog (VB6 FEstimateItemsFormatting) ──────────── *@
<FEstimateItemsFormatting @ref="formattingDialog" @bind-Visible="_showFormatting" OnAccepted="OnFormattingAccepted" />

@* ── Update-Pricelist dialog (VB6 FPriceListUpdate.ShowForm) ─────────── *@
<FPriceListUpdate @ref="priceListUpdateDialog"
                  @bind-IsVisible="_showPriceListUpdate"
                  ShowBudgets="@ShowBudgets"
                  Community="@cboCommunityValue"
                  CommunityPhase="@cboPhaseValue"
                  CommunityDescription="@cboCommunityValue"
                  AssemblyType="@_priceListUpdateAssemblyType"
                  DivisionID="@SessionState.DivisionID"
