    private async Task OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        if (_pickListContext == "GridCell")
        {
            _pickListContext = "";
            if (selectedRows.Count > 0 && _gridPickRow != null)
            {
                await ApplyGridCellPick(selectedRows[0]);
            }
            _gridPickRow = null;
            _gridPickField = "";
            StateHasChanged();
            return;
        }

        if (_pickListContext == "OpenQuote")
        {
            if (selectedRows.Count == 0)
            {
                // "New" was selected
                mJob = "\x01";
                SetFieldsForNewQuote();
                Dirty = false;
                StateHasChanged();
                return;
            }

            var firstRow = selectedRows[0];
            var quote = firstRow.ContainsKey("Quote") ? firstRow["Quote"]?.ToString()?.Trim() ?? "" : "";

            if (string.IsNullOrWhiteSpace(quote))
            {
                mJob = "\x01";
                SetFieldsForNewQuote();
                Dirty = false;
            }
            else
            {
                mJob = quote;
                await LoadData();
            }
            StateHasChanged();
        }
    }

