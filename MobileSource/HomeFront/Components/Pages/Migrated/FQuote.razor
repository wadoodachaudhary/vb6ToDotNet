    // ── Load Properties (Tax Groups + Custom Fields) ──────────
    private async Task LoadProperties()
    {
        PropertiesData = new();

        if (mJob == "\x01") return;

        try
        {
            // Load tax groups from tblJobs
            var jobDt = db.SqlExec(
                @"SELECT LabourTaxGroup, MaterialTaxGroup, SubContractTaxGroup,
                         EquipmentTaxGroup, OverheadTaxGroup, OtherTaxGroup
                  FROM tblJobs WHERE job_no = @JobNo", new { JobNo = mJob });
            if (jobDt.Rows.Count > 0)
            {
                var jr = jobDt.Rows[0];
                LabourTaxGroup = jr["LabourTaxGroup"]?.ToString() ?? "";
                MaterialTaxGroup = jr["MaterialTaxGroup"]?.ToString() ?? "";
                SubContractTaxGroup = jr["SubContractTaxGroup"]?.ToString() ?? "";
                EquipmentTaxGroup = jr["EquipmentTaxGroup"]?.ToString() ?? "";
                OverheadTaxGroup = jr["OverheadTaxGroup"]?.ToString() ?? "";
                OtherTaxGroup = jr["OtherTaxGroup"]?.ToString() ?? "";
            }

            // Load custom field definitions
            var fieldsDt = db.SqlExec("SELECT * FROM JobCustomFieldDefs ORDER BY Category, Name", new { });

            // Load custom field data for this job
            DataTable? dataDt = null;
            try
            {
                dataDt = db.SqlExec("SELECT * FROM JobCustomFields WHERE Job_No = @JobNo", new { JobNo = mJob });
            }
            catch { /* non-critical */ }

            string lastCategory = "";
            foreach (DataRow fRow in fieldsDt.Rows)
            {
                var category = fRow["Category"]?.ToString() ?? "";
                var fieldName = fRow["Name"]?.ToString() ?? "";
                var pickList = fRow["PickList"]?.ToString() ?? "";

                if (category != lastCategory)
                {
                    PropertiesData.Add(new PropertyRow
                    {
                        Category = category,
                        Name = string.IsNullOrEmpty(category) ? "Unclassified" : category,
                        IsCategory = true,
                        OutlineLevel = 0
                    });
                    lastCategory = category;
                }

                var value = "";
                var dataType = "Str";
                var length = 255;

                if (dataDt != null && dataDt.Rows.Count > 0 && dataDt.Columns.Contains(fieldName))
                {
                    var dataRow = dataDt.Rows[0];
                    value = dataRow[fieldName]?.ToString() ?? "";
                    var col = dataDt.Columns[fieldName];
                    if (col != null)
                    {
                        length = col.MaxLength > 0 ? col.MaxLength : 255;
                        dataType = col.DataType switch
                        {
                            Type t when t == typeof(int) || t == typeof(short) || t == typeof(long) || t == typeof(byte) => "NumInt",
                            Type t when t == typeof(double) || t == typeof(float) || t == typeof(decimal) => "Num",
                            Type t when t == typeof(bool) => "Bit",
                            Type t when t == typeof(DateTime) => "DateTime",
                            _ => "Str"
                        };
                    }
                }

                PropertiesData.Add(new PropertyRow
                {
                    Category = category,
                    Name = fieldName,
                    Value = value,
                    DataType = dataType,
                    PickList = pickList,
                    Length = length,
                    IsCategory = false,
                    OutlineLevel = 1
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadProperties error");

        }
    }

    // ── Load Data ─────────────────────────────────────────────
    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            if (mJob == "\x01")
            {
                SetFieldsForNewQuote();
            }
            else
            {
                JobFieldEnabled = false;
                var sql = @"
                    SELECT j.job_no, j.Notes, j.description, j.gl_prefix,
                           j.community, j.communityphase, j.model, j.lot, j.block, j.lotplan,
                           j.inactive, j.municipal_address, j.city, j.province, j.zip,
                           j.sitephone, j.sitefax
                    FROM tblJobs j
                    WHERE job_no = @JobNo";
                var dt = db.SqlExec(sql, new { JobNo = mJob });

                if (dt.Rows.Count > 0)
                {
                    var row = dt.Rows[0];
                    txtJob = row["Job_No"]?.ToString() ?? "";
                    txtDescription = row["Description"]?.ToString() ?? "";
                    txtNotes = row["Notes"]?.ToString() ?? "";
                    txtGLPrefix = row["gl_prefix"]?.ToString() ?? "";
                    cboGLPrefixValue = row["gl_prefix"]?.ToString() ?? "";
                    txtAddress = row["municipal_address"]?.ToString() ?? "";
                    txtCity = row["city"]?.ToString() ?? "";
                    txtProvince = row["province"]?.ToString() ?? "";
                    txtPostal = row["zip"]?.ToString() ?? "";
                    txtPhone = row["sitephone"]?.ToString() ?? "";
                    txtFax = row["sitefax"]?.ToString() ?? "";
                    cboCommunityValue = row["community"]?.ToString() ?? "";
                    cboPhaseValue = row["communityphase"]?.ToString() ?? "";
                    cboModelValue = row["model"]?.ToString() ?? "";
                    txtLot = row["lot"]?.ToString() ?? "";
                    txtBlock = row["block"]?.ToString() ?? "";
                    txtLotPlan = row["lotplan"]?.ToString() ?? "";
                    cboStatusIndex = (row["inactive"]?.ToString() == "True") ? 1 : 0;

                    // Load phases for selected community
                    await LoadPhases();

                    FieldsEnabled = true;
                }
                else
                {
                    FieldsEnabled = false;
                }
            }

            await LoadProperties();
            await LoadItems();
            Dirty = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadData error");

            Notifications.Error($"Error loading quote: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

