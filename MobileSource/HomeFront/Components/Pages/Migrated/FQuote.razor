    // Build a DropDownList DataSource from a custom-field PickList string
    // ("val<tab>desc|val<tab>desc|…") — mirrors the old inline <option> loop.
    private List<ComboItem> GetPickListItems(string pickList)
    {
        var items = new List<ComboItem> { new ComboItem { Text = "", Value = "" } };
        if (string.IsNullOrEmpty(pickList)) return items;
        foreach (var pl in pickList.Split('|'))
        {
            var parts = pl.Split('\t');
            items.Add(new ComboItem
            {
                Value = parts[0],
                Text = parts.Length > 1 ? $"{parts[0]} - {parts[1]}" : parts[0]
            });
        }
        return items;
    }

    // ── In-grid cell pickers (VB6 gItems_CellButtonClick) ─────
    // Fields that show a "…" button opening FPickList (mirror FItems _lookupPickerFields).
    private static readonly HashSet<string> _lookupPickerFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "JCExtra", "JCCostCode", "JCCostCodeDesc", "JCCategory", "JCCategoryDesc",
        "OrderUOM", "BudgetVendor", "BudgetVendorName", "POVendor", "POVendorName",
        "BudgetTaxGroup", "POTaxGroup", "POIndex", "POIndexDescription"
    };

    // Long-text fields that open a popup textarea editor (VB6 FComments.Edit).
    private static readonly HashSet<string> _popupTextFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "ItemDesc", "ItemComments"
    };

    // Tracks the row/field a grid-cell pick targets (kept separate from the
    // Open-Quote dialog so OnPickListSelected can branch correctly).
    private QuoteItemRow? _gridPickRow;
    private string _gridPickField = "";

    private static string TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }

    private static string GetPopupFieldValue(QuoteItemRow row, string field) => field switch
    {
        "ItemDesc" => row.ItemDesc,
        "ItemComments" => row.ItemComments,
        _ => ""
    };

    private static string GetLookupDisplayValue(QuoteItemRow row, string field) => field switch
    {
        "JCExtra" => row.JCExtra,
        "JCCostCode" => row.JCCostCode,
        "JCCostCodeDesc" => row.JCCostCodeDesc,
        "JCCategory" => row.JCCategory,
        "JCCategoryDesc" => row.JCCategoryDesc,
        "OrderUOM" => row.OrderUOM,
        "BudgetVendor" => row.BudgetVendor,
        "BudgetVendorName" => row.BudgetVendorName,
        "POVendor" => row.POVendor,
        "POVendorName" => row.POVendorName,
        "BudgetTaxGroup" => row.BudgetTaxGroup,
        "POTaxGroup" => row.POTaxGroup,
        "POIndex" => row.POIndex,
        "POIndexDescription" => row.POIndexDescription,
        _ => ""
    };

    // Popup text editor — reuses the Yes/No save-prompt overlay style via a small inline dialog.
    private bool ShowTextEditor = false;
    private string TextEditorTitle = "";
    private string TextEditorValue = "";
    private int TextEditorMaxLength = 8000;
    private QuoteItemRow? _textEditorRow;
    private string _textEditorField = "";

    private void OnEditPopupField(QuoteItemRow row, string field)
    {
        _textEditorRow = row;
        _textEditorField = field;
        switch (field)
        {
            case "ItemDesc":
                TextEditorTitle = "Description";
                TextEditorValue = row.ItemDesc;
                TextEditorMaxLength = 200;       // VB6: FComments.Edit(s, gItems, , "Description", 200)
                break;
            case "ItemComments":
                TextEditorTitle = "Comments";
                TextEditorValue = row.ItemComments;
                TextEditorMaxLength = 8000;
                break;
        }
        ShowTextEditor = true;
        StateHasChanged();
    }

    private void OnTextEditorOk()
    {
        if (_textEditorRow != null)
        {
            switch (_textEditorField)
            {
                case "ItemDesc": _textEditorRow.ItemDesc = TextEditorValue; break;
                case "ItemComments": _textEditorRow.ItemComments = TextEditorValue; break;
            }
            // VB6 calls gItems_AfterEdit after the popup edit; ItemDesc/ItemComments have no recalc.
            Dirty = true;
            if (_textEditorRow.RowState != "NEW") _textEditorRow.RowState = "DIRTY";
            ColorizeItem(_textEditorRow);
        }
        ShowTextEditor = false;
        _textEditorRow = null;
        StateHasChanged();
    }

    private void OnTextEditorCancel()
    {
        ShowTextEditor = false;
        _textEditorRow = null;
    }

    // Items grid edit-button dispatch (VB6 gItems_CellButtonClick). The STANDARD
    // FlexKit edit button raises OnEditButtonClick; route the lookup-picker
    // columns to OnPickLookupField (the same handler the old in-cell "…" button
    // called). args.Data is the clicked row. (The popup-text fields ItemDesc /
    // ItemComments still use their own in-cell "…" button + dialog — they show a
    // truncated/transformed value, not a plain Field binding.)
    private async Task OnGridEditButtonClick(CellEditButtonArgs<QuoteItemRow> args)
    {
        if (args.Data == null || string.IsNullOrEmpty(args.ColumnName)) return;
        if (_lookupPickerFields.Contains(args.ColumnName))
            await OnPickLookupField(args.Data, args.ColumnName);
    }

    // VB6 gItems_CellButtonClick — open FPickList for the clicked field.
    private async Task OnPickLookupField(QuoteItemRow row, string field)
    {
        if (pickList == null) return;
        _gridPickRow = row;
        _gridPickField = field;
        _pickListContext = "GridCell";

        var community = cboCommunityValue ?? "";
        var phase = cboPhaseValue ?? "";

        switch (field)
        {
            case "JCExtra":
                // VB6: select Extra,Description from jcm_master__extra where job=FormatJob(Job_No)
                await pickList.Open("Extra",
                    "SELECT Extra, Description FROM jcm_master__extra WHERE job = @Job",
                    defaultItem: row.JCExtra,
                    parameters: new Dictionary<string, object> { ["Job"] = FormatJob(string.IsNullOrWhiteSpace(row.Job_No) ? mJob : row.Job_No) });
                break;

            case "JCCostCode":
                await pickList.Open("Cost Code",
                    "SELECT CostCode, Description FROM StandardCostCodes",
                    defaultItem: row.JCCostCode);
                break;
            case "JCCostCodeDesc":
                await pickList.Open("Cost Code",
                    "SELECT Description, CostCode FROM StandardCostCodes",
                    defaultItem: row.JCCostCodeDesc);
                break;

            case "JCCategory":
                await pickList.Open("Category",
                    "SELECT Category, Description FROM StandardCategories",
                    defaultItem: row.JCCategory);
                break;
            case "JCCategoryDesc":
                await pickList.Open("Category",
                    "SELECT Description, Category FROM StandardCategories",
                    defaultItem: row.JCCategoryDesc);
                break;

            case "OrderUOM":
                await pickList.Open("Units",
                    "SELECT DISTINCT OrderUOM Unit FROM tblPhaseItem",
                    defaultItem: row.OrderUOM);
                break;

            case "BudgetVendor":
            case "POVendor":
                await pickList.Open("Vendor", BuildVendorViews(companyFirst: false, row),
                    defaultItem: field == "BudgetVendor" ? row.BudgetVendor : row.POVendor,
                    parameters: BuildVendorParams(community, row));
                break;
            case "BudgetVendorName":
            case "POVendorName":
                await pickList.Open("Vendor", BuildVendorViews(companyFirst: true, row),
                    defaultItem: field == "BudgetVendorName" ? row.BudgetVendorName : row.POVendorName,
                    parameters: BuildVendorParams(community, row));
                break;

            case "BudgetTaxGroup":
            case "POTaxGroup":
                await pickList.Open("Tax Groups",
                    "SELECT TaxGroup, Description FROM TaxGroups",
                    defaultItem: field == "BudgetTaxGroup" ? row.BudgetTaxGroup : row.POTaxGroup);
                break;

            case "POIndex":
                // VB6: SELECT POIndex,case when poindex=description then '' else Description end Description FROM tblPOIndex
                await pickList.Open("PO Index",
                    "SELECT POIndex, case when poindex=description then '' else Description end Description FROM tblPOIndex",
                    defaultItem: row.POIndex);
                break;
            case "POIndexDescription":
                await pickList.Open("PO Index",
                    "SELECT Description, POIndex FROM tblPOIndex",
                    defaultItem: row.POIndexDescription);
                break;
        }
    }

    // VB6 vendor picker is two views joined by Chr(0); FPickList uses '|' between views
    // and ';' between name and SQL. companyFirst swaps the first SELECT column so the
    // grid's first column matches the field that was clicked (Vendor vs Company).
    private static string BuildVendorViews(bool companyFirst, QuoteItemRow row)
    {
        var approvedCols = companyFirst
            ? "v.Vendor_Name Company, v.Vendor_ID Vendor, v.City, v.Phone"
            : "v.Vendor_ID Vendor, v.Vendor_Name Company, v.City, v.Phone";
        var allCols = companyFirst
            ? "Vendor_Name Company, Vendor_ID Vendor, City, Phone"
            : "Vendor_ID Vendor, Vendor_Name Company, City, Phone";

        var approved =
            $"SELECT DISTINCT {approvedCols} FROM tblVendors v " +
            "JOIN tblVendorCost c ON (v.Vendor_ID = c.Vendor) " +
            "WHERE (ISNULL(Community,'') = '' OR Community = @Community) " +
            "AND (ISNULL(Assembly,'') = '' OR Assembly = @Assembly) " +
            "AND Phase = @EstPhase AND Item = @EstItem";
        var all = $"SELECT {allCols} FROM tblVendors";

        return $"Approved Vendors;{approved}|All Vendors;{all}";
    }

    private static Dictionary<string, object> BuildVendorParams(string community, QuoteItemRow row) => new()
    {
        ["Community"] = community ?? "",
        ["Assembly"] = row.Assembly ?? "",
        ["EstPhase"] = row.EstPhase ?? "",
        ["EstItem"] = row.EstItem ?? ""
    };

    // VB6 HFApp.FormatJob — right-justify the job number to width 7 with leading spaces.
    private static string FormatJob(string job)
    {
        job = (job ?? "").Trim();
        return job.Length >= 7 ? job : job.PadLeft(7);
    }

    // Apply a grid-cell pick result (called from OnPickListSelected for _pickListContext == "GridCell").
    private async Task ApplyGridCellPick(IDictionary<string, object> picked)
    {
        if (_gridPickRow == null) return;
        var item = _gridPickRow;
        string Col(string name) => picked.ContainsKey(name) ? picked[name]?.ToString() ?? "" : "";

        switch (_gridPickField)
        {
            // VB6 mcITEM_CHANGEITEM substitution (FQuote.frm:2637): replace the
            // row's phase/item/description/POIndex and clear the overridden flags.
            case "ChangeItem":
                item.EstPhase = Col("Phase");
                item.EstItem = Col("Item");
                item.ItemDesc = Col("Description");
                item.POIndex = Col("POIndex");
                item.POOverridden = "False";
                item.BudgetOverridden = "False";
                break;
            case "JCExtra":
                item.JCExtra = Col("Extra");
                break;
            case "JCCostCode":
            case "JCCostCodeDesc":
                item.JCCostCode = Col("CostCode");
                item.JCCostCodeDesc = Col("Description");
                break;
            case "JCCategory":
            case "JCCategoryDesc":
                item.JCCategory = Col("Category");
                item.JCCategoryDesc = Col("Description");
                break;
            case "OrderUOM":
                item.OrderUOM = Col("OrderUOM");
                break;
            case "BudgetVendor":
            case "BudgetVendorName":
                item.BudgetVendor = Col("Vendor");
                item.BudgetVendorName = Col("Company");
                break;
            case "POVendor":
            case "POVendorName":
                item.POVendor = Col("Vendor");
                item.POVendorName = Col("Company");
                break;
            case "BudgetTaxGroup":
                item.BudgetTaxGroup = Col("TaxGroup");
                break;
            case "POTaxGroup":
                item.POTaxGroup = Col("TaxGroup");
                break;
            case "POIndex":
            case "POIndexDescription":
                item.POIndex = Col("POIndex");
                item.POIndexDescription = Col("Description");
                break;
        }

        // VB6 calls gItems_AfterEdit(Row, col) after every CellButtonClick → run the recalc.
        await RecalculateAfterEdit(item, _gridPickField);

        Dirty = true;
        if (item.RowState != "NEW") item.RowState = "DIRTY";
        ColorizeItem(item);
    }

    // ── Grid Layout (dynamic from AppGridLayout) ──────────────
    private async Task LoadGridLayoutAsync()
    {
        // VB6: Call IniGetGrid(Me, gItems) — gridname = "FQuote.gItems.(0)"
        // Keyed/unkeyed fallback + Version bump handled by the presenter (ctor
        // was given the "FQuote"/"gItems" names + instanceKey "(0)").
        await _itemsGrid.LoadAsync(GridLayoutSvc);

        // No stored layout, or nothing renderable once the legacy empty-caption
        // rule is applied (below) — inject the VB6 designer-default column set
        // (FQuote.frx gItems custom format) so the web shows the same columns a
        // fresh legacy install shows. Same last-resort pattern as
        // FAssembly.BuildItemsBuiltInDefaultLayout (HHM-613 issue 3).
        if (!HasGridLayout || !GetOrderedGridLayout().Any())
        {
            Logger.LogWarning("FQuote.gItems: no usable AppGridLayout — using VB6 designer-default columns");
            _itemsGrid.SetLayout(BuildItemsBuiltInDefaultLayout());
        }
    }

    /// <summary>The VB6 designer-default gItems columns — the visible set, order,
    /// captions and twip widths serialized in FQuote.frx (grid custom format;
    /// ColHidden=0 entries). This is exactly what legacy paints when AppGridLayout
    /// has no FQuote.gItems rows, which is the shipped-DB state (HHM-613 issue 3).
    /// Two "Costed Tax" columns (BudgetJCTax + POJCTax) are faithful to the frx.</summary>
    private static Dictionary<string, GridLayoutColumn> BuildItemsBuiltInDefaultLayout()
    {
        var defs = new (string Field, string Caption, double Width)[]
        {
            ("JCCostCodeDesc",   "Cost Code Desc",   1335),
            ("JCCategoryDesc",   "JC Category Desc", 1455),
            ("ItemDesc",         "Description",       960),
            ("BudgetVendorName", "Vendor Name",       960),
            ("BudgetQty",        "Qty",               420),
            ("OrderUOM",         "UOM",               555),
            ("BudgetRate",       "Unit Cost",         825),
            ("BudgetPretax",     "Pretax",            630),
            ("BudgetTaxGroup",   "Tax Grp",           750),
            ("BudgetJCTax",      "Costed Tax",        960),
            ("POJCTax",          "Costed Tax",        960),
            ("BudgetNJCTax",     "Non Costed Tax",   1155),
            ("POIndex",          "POIndex",           960),
            ("ExcludeFromPO",    "Exclude From PO",   795),
        };
        var layout = new Dictionary<string, GridLayoutColumn>(StringComparer.OrdinalIgnoreCase);
        for (int i = 0; i < defs.Length; i++)
        {
            layout[defs[i].Field] = new GridLayoutColumn
            {
                Field = defs[i].Field,
                Caption = defs[i].Caption,
                Width = defs[i].Width,
                ColIndex = i,
                Hidden = false
            };
        }
        return layout;
    }

    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedGridLayout()
    {
        if (!HasGridLayout)
            yield break;

        // VB6 MMain.DBGetGrid: `.ColHidden(Col) = rs("hidden")="True" OR
        // .TextMatrix(0, Col) = ""` — a stored column with an EMPTY caption is
        // hidden in legacy even when hidden=0 (that's how the frx's caption-less
        // PO* twins stay invisible). The web used to render those with the field
        // name as the header — the "extra columns" mismatch of HHM-613 issue 3.
        var ordered = gItemsLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden
                        && !string.IsNullOrWhiteSpace(c.Caption))
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = ResolveGridField(layout.Field);
            var columnType = GetColumnTypeForField(resolvedField);
            // PO Index data is right-aligned in legacy (HHM-613 issue 4) — the
            // values are numeric index strings, not free text.
            var textAlign = columnType == ColumnType.Number
                || resolvedField.Equals("POIndex", StringComparison.OrdinalIgnoreCase)
                ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    // NOT delegated to GridLayoutPresenter.ResolveField: this resolver matches the
    // raw (non-normalized) layout field against a literal alias switch and has no
    // normalized-property fallback, so its behavior diverges from the presenter's
    // exact→normalized→alias→literal path. Left as-is to preserve FQuote semantics.
    private static string ResolveGridField(string layoutField)
    {
        if (string.IsNullOrWhiteSpace(layoutField))
            return "";

        var trimmed = layoutField.Trim();
        var exact = typeof(QuoteItemRow).GetProperty(trimmed, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
        if (exact != null)
            return exact.Name;

        // Common VB6 → Blazor field mappings
        return trimmed switch
        {
            "Description" => "ItemDesc",
            "Comments" => "ItemComments",
            "Phase" => "EstPhase",
            "Item" => "EstItem",
            _ => trimmed
        };
    }

    // NOT delegated to GridLayoutPresenter.ColumnTypeFor: this maps specific field
    // names to ColumnType.Number and returns ColumnType.CheckBox for Selected /
    // ExcludeFromPO. The presenter infers types from the CLR property and returns
    // ColumnType.Boolean (not CheckBox) for bool — a real rendering difference —
    // so this stays. GetOrderedGridLayout (which calls it) therefore stays too.
    private static ColumnType GetColumnTypeForField(string field)
    {
        return field switch
        {
            "TakeoffQty" or "BudgetQty" or "BudgetRate" or "BudgetPretax"
                or "BudgetJCTax" or "BudgetNJCTax" or "BudgetTax"
                or "BudgetJCTaxRate" or "BudgetNJCTaxRate"
                or "POQty" or "PORate" or "POPretax"
                or "POJCTax" or "PONJCTax" or "POTax"
                or "POJCTaxRate" or "PONJCTaxRate"
                or "ConversionFactor" or "WastePercent" or "RoundTo" or "Seq"
                => ColumnType.Number,
            "Selected" or "ExcludeFromPO" => ColumnType.CheckBox,
            _ => ColumnType.Text
        };
    }

    private static string? GetFormatForField(string field, ColumnType colType)
    {
        if (colType != ColumnType.Number) return null;
        return field switch
        {
            "BudgetRate" or "PORate" => "N4",
            "BudgetPretax" or "POPretax" or "BudgetJCTax" or "BudgetNJCTax" or "BudgetTax"
                or "POJCTax" or "PONJCTax" or "POTax" => "C2",
            "ConversionFactor" => "N4",
            _ => "N2"
        };
    }

    private static bool IsFieldEditable(string field)
    {
        // Read-only fields
        return field switch
        {
            "EstItemID" or "RowState" or "Assembly" or "AssemblyDescription"
                or "EstPhase" or "EstItem" or "JCCostCodeDesc" or "JCCategoryDesc"
                or "BudgetVendorName" or "POVendorName" or "BudgetTax" or "POTax"
                or "BudgetGenerated" or "BudgetOverridden" or "POOverridden"
                or "PONumber" or "WarningMessage" => false,
            _ => true
        };
    }

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);
}
