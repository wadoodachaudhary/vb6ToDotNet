    private string BuildTakeoffUrl(string takeoffMode)
    {
        // VB6: Call FTakeoff.Takeoff(Me, Mid(Button.Key, 8), "", GetComboBoxListKey(cboCommunity), cboPhase.Text, "", "", mJob)
        var qs = new Dictionary<string, string?>
        {
            ["mode"] = takeoffMode,
            ["isChangeOrder"] = "false",
            ["job"] = mJob,
            ["community"] = string.IsNullOrWhiteSpace(cboCommunityValue) ? null : cboCommunityValue,
            ["phase"] = string.IsNullOrWhiteSpace(cboPhaseValue) ? null : cboPhaseValue
        };
        var queryString = string.Join("&",
            qs.Where(kv => kv.Value != null)
                .Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value!)}"));
        return $"/takeoff?{queryString}";
    }

    // VB6 (FQuote.frm:801 "Preview" → the quote report). The Crystal report
    // for a quote is JobQuote.rpt (FEstimateItems.frm:8780, record selection
    // {EstimateAssemblies.Job}={?Job}); its parameters are DivisionID + Job
    // (FEstimateItems.frm:8805/8810). When the accounting system is
    // QuickBooks (HFApp.Options(AccountingSystem)=asQuickBooks) the
    // QuickBooks-format report "JobQuote QB" is used instead — it adds a
    // Margin markup parameter. We reuse FRptViewer's report host
    // (ReportWriterControl) the same way FPricingWorkSheet/FBilling do:
    // seed the known parameters and navigate to /report-viewer/<xml>.
    private async Task OnPreviewClick()
    {
        // VB6 disables Preview until the quote is saved (Toolbar.Buttons
        // ("Preview").Enabled = mJob <> Chr(1)); a dirty quote is flushed
        // first so the report reads committed rows.
        if (!IsExistingQuote) return;
        if (mDirty && !await SaveData(true)) return;

        // HFApp.Options(AccountingSystem) — appoptions row keyed by
        // DivisionID + optionname, stored as the numeric AccountingSystems
        // value (asQuickBooks = 3). Parameterized read.
        var isQuickBooks = false;
        try
        {
            var optDt = db.SqlExec(
                @"SELECT TOP 1 optionvalue FROM appoptions
                   WHERE DivisionID = @DivisionID AND optionname = 'AccountingSystem'",
                new { DivisionID = SessionState.DivisionID });
            if (optDt.Rows.Count > 0
                && int.TryParse(optDt.Rows[0][0]?.ToString(), out var acctSys))
                isQuickBooks = acctSys == (int)Application.AccountingSystems.asQuickBooks;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Couldn't read AccountingSystem AppOption — defaulting to standard JobQuote report");
        }

        var reportFileName = isQuickBooks ? "JobQuote QB.xml" : "JobQuote.xml";
        var xmlPath = System.IO.Path.Combine(
            WebHost.WebRootPath ?? "wwwroot",
            "resources", "Estimating", "Reports", "xml",
            reportFileName);

        // Seed the Job parameter (record-selection key) so FRptViewer's
        // parameter dialog skips it; DivisionID is auto-injected by
        // ReportWriterControl. The QuickBooks report additionally prompts
        // for Margin — there is no quote-side margin value in VB6, so the
        // viewer's parameter dialog collects it at preview time. ReportSeeds
        // is one-shot (FRptViewer consumes + clears in OnAfterRenderAsync).
        ReportSeeds.Set("Job", mJob);

        var route = $"/report-viewer/{Uri.EscapeDataString(xmlPath)}";
        if (ParentNavigate != null)
            ParentNavigate.Invoke(route);          // stays inside FMain shell
        else
            NavigationManager.NavigateTo(route);   // standalone fallback
    }

    // VB6: RePrice (FQuote.frm:730) — Save, verify something is refreshable,
    // then open FEstimateItemsRefreshCosts to pick CostBasis + EffectiveDate.
    // The actual SQL runs in OnRefreshCostsConfirmed once the dialog returns.
    private async Task OnRePriceClick()
    {
        if (!await SaveData(true)) return;

        // VB6: MsgBox when nothing un-generated can be refreshed.
        var countDt = db.SqlExec(
            "SELECT COUNT(*) FROM EstimatedItems WHERE BudgetGenerated=0 AND Job_no=@JobNo",
            new { JobNo = mJob });
        _refreshCount = countDt.Rows.Count > 0 ? Convert.ToInt32(countDt.Rows[0][0]) : 0;
        if (_refreshCount == 0)
        {
            Notifications.Warning(
                "You have nothing selected that can be refreshed. " +
                "Use the check boxes to select some assemblies or items that have not already been generated.");
            return;
        }

        // VB6: bRePrice = FEstimateItemsRefreshCosts.Showform(CostBasis, EffectiveDate)
        _showRefreshCostsDialog = true;
        StateHasChanged();
    }

    // VB6 FQuote.frm:737-790 — runs after the Refresh-Costs dialog is confirmed.
    // CostBasis: VB6 converts a non-zero forecast basis with "CostBasis = CostBasis + 1"
    // before passing it to Purch_GetItemRate. EffectiveDate flows into the lookup.
    // ZeroRateOnRefreshCosts (AppOptions): when set, a non-overridden item whose
    // rate looks up to nothing is forced to rate 0 (FQuote.frm:747); and the
    // re-extend's "rate <> 0" guard is dropped (FQuote.frm:765-767).
    private async Task OnRefreshCostsConfirmed(FEstimateItemsRefreshCosts.RefreshCostsResult result)
    {
        _showRefreshCostsDialog = false;

        // VB6: 'convert costbasis to lookuptype — If CostBasis <> 0 Then CostBasis = CostBasis + 1
        var costBasis = (int)result.CostBasis;
        if (costBasis != 0) costBasis += 1;
        var effectiveDate = result.EffectiveDate == default ? DateTime.Today : result.EffectiveDate;
        var zeroRate = _optZeroRateOnRefreshCosts;

        try
        {
            IsLoading = true;
            StateHasChanged();

            // Get item rates. The ZeroRate branch (FQuote.frm:747) forces 0 when
            // the option is on and the item is not budget-overridden.
            var zeroRateBranch = zeroRate
                ? "WHEN i.BudgetOverridden = 0 THEN 0\n"
                : "";
            var updateRateSql = $@"
                UPDATE EstimateItems
                SET BudgetOverridden = 0,
                    BudgetRate = CASE
                        WHEN ISNULL(dbo.Purch_GetItemRate(@CostBasis,0,v.Community,v.CommunityPhase,v.Assembly,
                             CASE WHEN v.assemblytype=0 OR v.assemblytype=2 THEN v.model ELSE '' END,
                             '',v.EstPhase,v.EstItem,0,v.BudgetVendor,@EffectiveDate,@DivisionID),0) <> 0
                        THEN ISNULL(dbo.Purch_GetItemRate(@CostBasis,0,v.Community,v.CommunityPhase,v.Assembly,
                             CASE WHEN v.assemblytype=0 OR v.assemblytype=2 THEN v.model ELSE '' END,
                             '',v.EstPhase,v.EstItem,0,v.BudgetVendor,@EffectiveDate,@DivisionID),0)
                        {zeroRateBranch}ELSE i.BudgetRate END
                FROM EstimateItems i
                JOIN EstimatedItems v ON (i.EstItemID = v.EstItemID)
                WHERE v.BudgetDeleted = 0
                  AND v.BudgetGenerated = 0
                  AND v.Job_no = @JobNo";
            await db.ExecuteAsync(updateRateSql, new
            {
                JobNo = mJob,
                DivisionID = SessionState.DivisionID,
                CostBasis = costBasis,
                EffectiveDate = effectiveDate
            });

            // Re-extend prices and taxes. VB6 only applies the "rate <> 0" guard
            // when ZeroRateOnRefreshCosts is OFF (FQuote.frm:765-767) so that
            // zeroed rates still re-extend (to $0) when the option is ON.
            var rateGuard = zeroRate
                ? ""
                : @"AND ISNULL(dbo.Purch_GetItemRate(@CostBasis,0,v.Community,v.CommunityPhase,v.Assembly,'','',
                          v.EstPhase,v.EstItem,0,v.BudgetVendor,@EffectiveDate,@DivisionID),0) <> 0
                  ";
            var extendSql = $@"
                UPDATE EstimateItems
                SET BudgetPretax = i.BudgetRate * i.BudgetQty,
                    BudgetJCTax = i.BudgetRate * i.BudgetQty * i.BudgetJCTaxRate / 100,
                    BudgetNJCTax = i.BudgetRate * i.BudgetQty * i.BudgetNJCTaxRate / 100
                FROM EstimateItems i
                JOIN EstimatedItems v ON (i.EstItemID = v.EstItemID)
                WHERE v.BudgetDeleted = 0
                  AND v.BudgetGenerated = 0
                  {rateGuard}AND v.Job_no = @JobNo";
            await db.ExecuteAsync(extendSql, new
            {
                JobNo = mJob,
                DivisionID = SessionState.DivisionID,
                CostBasis = costBasis,
                EffectiveDate = effectiveDate
            });

            // Keep PO values in sync where not yet POed (FQuote.frm:772-785).
            var syncPoSql = @"
                UPDATE EstimateItems
                SET PORate = v.BudgetRate,
                    POPretax = v.BudgetPretax,
                    POJCTax = v.BudgetJCTax,
                    PONJCTax = v.BudgetNJCTax,
                    POOverridden = 0
                FROM EstimateItems i
                JOIN EstimatedItems v ON (i.EstItemID = v.EstItemID)
                WHERE v.BudgetRate IS NOT NULL
                  AND v.BudgetDeleted = 0
                  AND v.BudgetGenerated = 0
                  AND v.POGenBatch = 0
                  AND v.Job_no = @JobNo";
            await db.ExecuteAsync(syncPoSql, new { JobNo = mJob });

            Dirty = false;
            await LoadItems();
            Notifications.Success($"Costs have been successfully refreshed. {_refreshCount} items were updated.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "RefreshCosts error");
            Notifications.Error($"Error refreshing costs: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnGenerateJobClick()
    {
        if (!await SaveData(false)) return;

        var jobNumber = await Dialogs.PromptAsync("Enter Job Number:");
        if (string.IsNullOrWhiteSpace(jobNumber)) return;

        // Save as job
        var originalQuote = txtJob;
        txtJob = jobNumber.Trim();
        mJob = "\x01";

        foreach (var item in ItemsData)
            item.RowState = "NEW";

        if (await SaveData(false, true))
        {
            Notifications.Success($"Job {jobNumber} created successfully from quote {originalQuote}.");
            NavigationManager.NavigateTo($"/job/{jobNumber}");
        }
        else
        {
            // Restore quote number
            txtJob = originalQuote;
            mJob = originalQuote;
        }
    }

