    private async Task OnCellSaved(CellSaveArgs<QuoteItemRow> args)
    {
        if (args.Data == null) return;

        var item = args.Data;
        var colName = args.ColumnName ?? "";

        // Recalculate based on which column changed
        await RecalculateAfterEdit(item, colName);

        if (colName != "Selected")
        {
            Dirty = true;
            if (item.RowState != "NEW")
                item.RowState = "DIRTY";
        }

        ColorizeItem(item);
        StateHasChanged();
    }

    private async Task RecalculateAfterEdit(QuoteItemRow item, string colName)
    {
        var rowBudgeted = item.BudgetGenerated != "0" && item.BudgetGenerated != "False";
        var rowPOed = !string.IsNullOrWhiteSpace(item.PONumber);

        switch (colName)
        {
            case "TakeoffQty":
                if (ShowBudgets)
                {
                    // VB6 Val("" & WastePercent) — NULL participates as 0.
                    item.BudgetQty = RoundToValue(item.TakeoffQty * (100 + (item.WastePercent ?? 0)) / 100 * item.ConversionFactor, item.RoundTo, item.RoundDir);
                    item.BudgetPretax = Math.Round(item.BudgetQty * item.BudgetRate, 2);
                    item.BudgetJCTax = Math.Round(item.BudgetPretax * item.BudgetJCTaxRate / 100, 2);
                    item.BudgetNJCTax = Math.Round(item.BudgetPretax * item.BudgetNJCTaxRate / 100, 2);
                    item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                    if (!rowPOed)
                    {
                        item.POQty = item.BudgetQty;
                        item.POPretax = item.BudgetPretax;
                        item.POJCTax = item.BudgetJCTax;
                        item.PONJCTax = item.BudgetNJCTax;
                        item.POTax = item.BudgetTax;
                    }
                }
                break;

            case "BudgetQty":
                item.BudgetPretax = Math.Round(item.BudgetQty * item.BudgetRate, 2);
                item.BudgetJCTax = Math.Round(item.BudgetPretax * item.BudgetJCTaxRate / 100, 2);
                item.BudgetNJCTax = Math.Round(item.BudgetPretax * item.BudgetNJCTaxRate / 100, 2);
                item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                if (!rowPOed)
                {
                    item.POQty = item.BudgetQty;
                    item.POPretax = item.BudgetPretax;
                    item.POJCTax = item.BudgetJCTax;
                    item.PONJCTax = item.BudgetNJCTax;
                    item.POTax = item.BudgetTax;
                }
                break;

            case "BudgetRate":
                item.BudgetOverridden = "True";
                item.BudgetPretax = Math.Round(item.BudgetQty * item.BudgetRate, 2);
                item.BudgetJCTax = Math.Round(item.BudgetPretax * item.BudgetJCTaxRate / 100, 2);
                item.BudgetNJCTax = Math.Round(item.BudgetPretax * item.BudgetNJCTaxRate / 100, 2);
                item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                if (!rowPOed)
                {
                    item.POOverridden = "True";
                    item.PORate = item.BudgetRate;
                    item.POPretax = item.BudgetPretax;
                    item.POJCTax = item.BudgetJCTax;
                    item.PONJCTax = item.BudgetNJCTax;
                    item.POTax = item.BudgetTax;
                }
                break;

            case "BudgetPretax":
                if (item.BudgetQty == 0) item.BudgetQty = 1;
                item.BudgetRate = Math.Round(item.BudgetPretax / item.BudgetQty, 4);
                item.BudgetOverridden = "True";
                item.BudgetJCTax = Math.Round(item.BudgetPretax * item.BudgetJCTaxRate / 100, 2);
                item.BudgetNJCTax = Math.Round(item.BudgetPretax * item.BudgetNJCTaxRate / 100, 2);
                item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                if (!rowPOed)
                {
                    item.POOverridden = "True";
                    item.POQty = item.BudgetQty;
                    item.PORate = item.BudgetRate;
                    item.POPretax = item.BudgetPretax;
                    item.POJCTax = item.BudgetJCTax;
                    item.PONJCTax = item.BudgetNJCTax;
                    item.POTax = item.BudgetTax;
                }
                break;

            case "POQty":
                item.POPretax = Math.Round(item.POQty * item.PORate, 2);
                item.POJCTax = Math.Round(item.POPretax * item.POJCTaxRate / 100, 2);
                item.PONJCTax = Math.Round(item.POPretax * item.PONJCTaxRate / 100, 2);
                item.POTax = item.POJCTax + item.PONJCTax;
                if (!rowBudgeted)
                {
                    item.BudgetQty = item.POQty;
                    item.BudgetPretax = item.POPretax;
                    item.BudgetJCTax = item.POJCTax;
                    item.BudgetNJCTax = item.PONJCTax;
                    item.BudgetTax = item.POTax;
                }
                break;

            case "PORate":
                item.POOverridden = "True";
                item.POPretax = Math.Round(item.POQty * item.PORate, 2);
                item.POJCTax = Math.Round(item.POPretax * item.POJCTaxRate / 100, 2);
                item.PONJCTax = Math.Round(item.POPretax * item.PONJCTaxRate / 100, 2);
                item.POTax = item.POJCTax + item.PONJCTax;
                if (!rowBudgeted)
                {
                    item.BudgetOverridden = "True";
                    item.BudgetRate = item.PORate;
                    item.BudgetPretax = item.POPretax;
                    item.BudgetJCTax = item.POJCTax;
                    item.BudgetNJCTax = item.PONJCTax;
                    item.BudgetTax = item.POTax;
                }
                break;

            case "POPretax":
                if (item.POQty == 0) item.POQty = 1;
                item.POOverridden = "True";
                item.PORate = Math.Round(item.POPretax / item.POQty, 4);
                item.POJCTax = Math.Round(item.POPretax * item.POJCTaxRate / 100, 2);
                item.PONJCTax = Math.Round(item.POPretax * item.PONJCTaxRate / 100, 2);
                item.POTax = item.POJCTax + item.PONJCTax;
                if (!rowBudgeted)
                {
                    item.BudgetOverridden = "True";
                    item.BudgetQty = item.POQty;
                    item.BudgetRate = item.PORate;
                    item.BudgetPretax = item.POPretax;
                    item.BudgetJCTax = item.POJCTax;
                    item.BudgetNJCTax = item.PONJCTax;
                    item.BudgetTax = item.POTax;
                }
                break;

            case "JCCategory":
                // VB6: when BudgetTaxGroup blank, auto-fill from dbo.Purch_GetDefaultTaxGroup, then re-tax.
                if (string.IsNullOrWhiteSpace(item.BudgetTaxGroup))
                {
                    var (tg, jc, njc) = await GetDefaultTaxGroup(item, item.BudgetVendor);
                    if (tg != null)
                    {
                        item.BudgetTaxGroup = tg;
                        item.BudgetJCTaxRate = jc;
                        item.BudgetNJCTaxRate = njc;
                        item.BudgetJCTax = Math.Round(item.BudgetPretax * item.BudgetJCTaxRate / 100, 2);
                        item.BudgetNJCTax = Math.Round(item.BudgetPretax * item.BudgetNJCTaxRate / 100, 2);
                        item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                    }
                }
                if (string.IsNullOrWhiteSpace(item.POTaxGroup))
                {
                    var (tg, jc, njc) = await GetDefaultTaxGroup(item, item.POVendor);
                    if (tg != null)
                    {
                        item.POTaxGroup = tg;
                        item.POJCTaxRate = jc;
                        item.PONJCTaxRate = njc;
                        item.POJCTax = Math.Round(item.POPretax * item.POJCTaxRate / 100, 2);
                        item.PONJCTax = Math.Round(item.POPretax * item.PONJCTaxRate / 100, 2);
                        item.POTax = item.POJCTax + item.PONJCTax;
                    }
                }
                break;

            case "BudgetVendor":
            case "BudgetVendorName":
                {
                    var (ok, rate) = await GetVendorCost(item, item.BudgetVendor);
                    if (ok)
                    {
                        item.BudgetOverridden = "False";
                        item.BudgetRate = rate;
                        item.BudgetPretax = Math.Round(item.BudgetQty * item.BudgetRate, 2);
                        item.BudgetJCTax = Math.Round(item.BudgetPretax * item.BudgetJCTaxRate / 100, 2);
                        item.BudgetNJCTax = Math.Round(item.BudgetPretax * item.BudgetNJCTaxRate / 100, 2);
                        item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                        if (!rowPOed)
                        {
                            item.POOverridden = "False";
                            item.PORate = item.BudgetRate;
                            item.POPretax = item.BudgetPretax;
                            item.POJCTax = item.BudgetJCTax;
                            item.PONJCTax = item.BudgetNJCTax;
                            item.POTax = item.BudgetTax;
                        }
                    }
                    if (!rowPOed)
                    {
                        item.POVendor = item.BudgetVendor;
                        item.POVendorName = item.BudgetVendorName;
                    }
                }
                break;

            case "POVendor":
            case "POVendorName":
                {
                    var (ok, rate) = await GetVendorCost(item, item.POVendor);
                    if (ok)
                    {
                        item.PORate = rate;
                        item.POOverridden = "False";
                        item.POPretax = Math.Round(item.POQty * item.PORate, 2);
                        item.POJCTax = Math.Round(item.POPretax * item.POJCTaxRate / 100, 2);
                        item.PONJCTax = Math.Round(item.POPretax * item.PONJCTaxRate / 100, 2);
                        item.POTax = item.POJCTax + item.PONJCTax;
                        if (!rowBudgeted)
                        {
                            item.BudgetOverridden = "False";
                            item.BudgetRate = item.PORate;
                            item.BudgetPretax = item.POPretax;
                            item.BudgetJCTax = item.POJCTax;
                            item.BudgetNJCTax = item.PONJCTax;
                            item.BudgetTax = item.POTax;
                        }
                    }
                    if (!rowBudgeted)
                    {
                        item.BudgetVendor = item.POVendor;
                        item.BudgetVendorName = item.POVendorName;
                    }
                }
                break;

            case "BudgetTaxGroup":
                {
                    var (jc, njc) = await GetTaxGroupRates(item.BudgetTaxGroup);
                    item.BudgetJCTaxRate = jc;
                    item.BudgetNJCTaxRate = njc;
                    item.BudgetJCTax = Math.Round(item.BudgetPretax * item.BudgetJCTaxRate / 100, 2);
                    item.BudgetNJCTax = Math.Round(item.BudgetPretax * item.BudgetNJCTaxRate / 100, 2);
                    item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                    if (!rowPOed)
                    {
                        item.POTaxGroup = item.BudgetTaxGroup;
                        item.POJCTaxRate = item.BudgetJCTaxRate;
                        item.PONJCTaxRate = item.BudgetNJCTaxRate;
                        item.POJCTax = item.BudgetJCTax;
                        item.PONJCTax = item.BudgetNJCTax;
                        item.POTax = item.BudgetTax;
                    }
                }
                break;

            case "POTaxGroup":
                {
                    var (jc, njc) = await GetTaxGroupRates(item.POTaxGroup);
                    item.POJCTaxRate = jc;
                    item.PONJCTaxRate = njc;
                    item.POJCTax = Math.Round(item.POPretax * item.POJCTaxRate / 100, 2);
                    item.PONJCTax = Math.Round(item.POPretax * item.PONJCTaxRate / 100, 2);
                    item.POTax = item.POJCTax + item.PONJCTax;
                    if (!rowBudgeted)
                    {
                        item.BudgetTaxGroup = item.POTaxGroup;
                        item.BudgetJCTaxRate = item.POJCTaxRate;
                        item.BudgetNJCTaxRate = item.PONJCTaxRate;
                        item.BudgetJCTax = item.POJCTax;
                        item.BudgetNJCTax = item.PONJCTax;
                        item.BudgetTax = item.POTax;
                    }
                }
                break;

            case "BudgetJCTax":
                item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                if (!rowPOed)
                {
                    item.POJCTax = item.BudgetJCTax;
                    item.POTax = item.BudgetTax;
                }
                break;

            case "BudgetNJCTax":
                item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                if (!rowPOed)
                {
                    item.PONJCTax = item.BudgetNJCTax;
                    item.POTax = item.BudgetTax;
                }
                break;

            case "POJCTax":
                item.POTax = item.POJCTax + item.PONJCTax;
                if (!rowBudgeted)
                {
                    item.BudgetJCTax = item.POJCTax;
                    item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                }
                break;

            case "PONJCTax":
                item.POTax = item.POJCTax + item.PONJCTax;
                if (!rowBudgeted)
                {
                    item.BudgetNJCTax = item.PONJCTax;
                    item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                }
                break;

            default:
                break;
        }
    }

    // VB6 GetVendorCost — Purch_GetItemRate(0,0,Community,CommunityPhase,Assembly,Model,OptionID,
    //   EstPhase,EstItem,Seq,vendor,GETDATE()). Returns (true, rate) when rate<>0 (or ZeroRate option).
    // CostBasis is the literal 0 VB6 passes; EffectiveDate is GETDATE() (the quote's effective date).
    private async Task<(bool ok, double rate)> GetVendorCost(QuoteItemRow item, string vendor)
    {
        if (string.IsNullOrWhiteSpace(vendor)) return (false, 0);
        try
        {
            var rate = await db.ExecuteScalarAsync<double>(
                @"SELECT dbo.Purch_GetItemRate(0, 0, @Community, @CommunityPhase, @Assembly, @Model,
                         @OptionID, @EstPhase, @EstItem, @Seq, @Vendor, GETDATE(), @DivisionID)",
                new
                {
                    Community = cboCommunityValue ?? "",
                    CommunityPhase = cboPhaseValue ?? "",
                    Assembly = item.Assembly ?? "",
                    Model = item.Model ?? "",
                    OptionID = item.OptionID ?? "",
                    EstPhase = item.EstPhase ?? "",
                    EstItem = item.EstItem ?? "",
                    Seq = item.Seq,
                    Vendor = vendor,
                    DivisionID = SessionState.DivisionID
                });
            // VB6 keeps the new rate only when non-zero (ZeroRateOnChangeVendor option not modelled here).
            return rate != 0 ? (true, rate) : (false, 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "GetVendorCost error");
            return (false, 0);
        }
    }

    // VB6: SELECT * FROM TaxGroups WHERE TaxGroup = dbo.Purch_GetDefaultTaxGroup(Job_No,Community,
    //   CommunityPhase,Model,Assembly,EstPhase,EstItem,vendor,JCCategory). Returns (taxgroup,JCRate,NJCRate).
    private async Task<(string? taxGroup, double jcRate, double njcRate)> GetDefaultTaxGroup(QuoteItemRow item, string vendor)
    {
        try
        {
            var dt = db.SqlExec(
                @"SELECT TaxGroup, JCRate, NJCRate FROM TaxGroups WHERE TaxGroup =
                  dbo.Purch_GetDefaultTaxGroup(@Job, @Community, @CommunityPhase, @Model, @Assembly,
                      @EstPhase, @EstItem, @Vendor, @JCCategory, @DivisionID)",
                new
                {
                    Job = string.IsNullOrWhiteSpace(item.Job_No) ? mJob : item.Job_No,
                    Community = cboCommunityValue ?? "",
                    CommunityPhase = cboPhaseValue ?? "",
                    Model = item.Model ?? "",
                    Assembly = item.Assembly ?? "",
                    EstPhase = item.EstPhase ?? "",
                    EstItem = item.EstItem ?? "",
                    Vendor = vendor ?? "",
                    JCCategory = item.JCCategory ?? "",
                    DivisionID = SessionState.DivisionID
                });
            if (dt.Rows.Count > 0)
            {
                var r = dt.Rows[0];
                return (r["TaxGroup"]?.ToString() ?? "", ToDouble(r["JCRate"]), ToDouble(r["NJCRate"]));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "GetDefaultTaxGroup error");
        }
        return (null, 0, 0);
    }

    // VB6: SELECT JCRate,NJCRate FROM TaxGroups WHERE TaxGroup = <selected>.
    private async Task<(double jcRate, double njcRate)> GetTaxGroupRates(string taxGroup)
    {
        if (string.IsNullOrWhiteSpace(taxGroup)) return (0, 0);
        try
        {
            var rows = await db.QueryAsync(
                "SELECT JCRate, NJCRate FROM TaxGroups WHERE TaxGroup = @TaxGroup",
                new { TaxGroup = taxGroup });
            var r = rows.FirstOrDefault();
            if (r != null)
                return (ToDouble(r["JCRate"]), ToDouble(r["NJCRate"]));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "GetTaxGroupRates error");
        }
        return (0, 0);
    }

    private static double ToDouble(object? value)
    {
        if (value == null || value == DBNull.Value) return 0;
        if (value is double d) return d;
        if (value is float f) return f;
        if (value is decimal dec) return (double)dec;
        return double.TryParse(value.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var result)
            ? result
            : 0;
    }

    private static int ToInt(object? value, int defaultValue = 0)
    {
        if (value == null || value == DBNull.Value) return defaultValue;
        if (value is int i) return i;
        if (int.TryParse(value.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var result)) return result;
        if (double.TryParse(value.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var asDouble))
        {
            return (int)asDouble;
        }
        return defaultValue;
    }

    private static double RoundToValue(double value, double roundTo, int roundDir)
    {
        if (roundTo <= 0) return value;
        var quotient = value / roundTo;
        if (Math.Abs(quotient - Math.Round(quotient)) < 1e-12) return value;

        if (roundDir > 0) return Math.Ceiling(quotient) * roundTo;
        if (roundDir < 0) return Math.Floor(quotient) * roundTo;
        return Math.Round(quotient) * roundTo;
    }

    // ── Save Properties (custom fields) ──────────────────────
    private async Task SaveProperties()
    {
        var customFields = PropertiesData.Where(p => !p.IsCategory && !string.IsNullOrEmpty(p.DataType)).ToList();
        if (customFields.Count == 0) return;

        try
        {
            // Ensure row exists
            try
            {
                await db.ExecuteAsync("INSERT INTO JobCustomFields(Job_No) VALUES(@JobNo)", new { JobNo = mJob });
            }
            catch { /* non-critical */ }

            // Build dynamic SET clause
            var setClauses = new List<string>();
            foreach (var f in customFields)
            {
                var quotedName = $"[{f.Name}]";
                var quotedValue = f.Value?.Replace("'", "''") ?? "";
                setClauses.Add($"{quotedName} = '{quotedValue}'");
            }

            if (setClauses.Count > 0)
            {
                var sql = $"UPDATE JobCustomFields SET {string.Join(", ", setClauses)} WHERE Job_No = @JobNo";
                await db.ExecuteAsync(sql, new { JobNo = mJob });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SaveProperties error");

        }
    }

