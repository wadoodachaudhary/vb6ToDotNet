    // Index 10 — mcITEM_SAVEONETIMETODB (FQuote.frm:2575): promote a one-time
    // item into the phase/item database. VB6 opens FItem.Add to capture a
    // phase/item code; the result is handled in OnItemAddCompleted.
    private async Task OnCtxSaveOneTime()
    {
        CloseContextMenu();
        if (_ctxRow == null || !CtxSaveOneTimeEnabled || itemAddDialog == null) return;
        _saveOneTimeRow = _ctxRow;
        await itemAddDialog.Add("", "", _ctxRow.ItemDesc);
    }

    // VB6 FQuote.frm:2576-2598 — after FItem.Add confirms, stamp the new
    // phase/item/description onto the row, mark it dirty, push the row's
    // UOM/price/index/cost-code/category/tax-group into tblphaseitem, then save.
    private async Task OnItemAddCompleted(FItem.FItemResult result)
    {
        if (result.Cancelled || _saveOneTimeRow == null) { _saveOneTimeRow = null; return; }

        var row = _saveOneTimeRow;
        _saveOneTimeRow = null;

        row.EstPhase = result.Phase;
        row.EstItem = result.Item;
        row.ItemDesc = result.Description;
        if (row.RowState != "NEW") row.RowState = "DIRTY";
        Dirty = true;

        try
        {
            await db.ExecuteAsync(@"
                UPDATE tblphaseitem
                SET takeoffuom = @TakeoffUOM,
                    orderuom   = @OrderUOM,
                    price      = @Price,
                    poindex    = @POIndex,
                    jccostcode = @JCCostCode,
                    jccategory = @JCCategory,
                    ustmp      = @User,
                    tstmp      = getdate(),
                    taxgroup   = @TaxGroup
                WHERE phase = @Phase AND item = @Item",
                new
                {
                    row.TakeoffUOM,
                    row.OrderUOM,
                    Price = ShowBudgets ? row.BudgetRate : row.PORate,
                    row.POIndex,
                    row.JCCostCode,
                    row.JCCategory,
                    User = SessionState.LoginID,
                    TaxGroup = ShowBudgets ? row.BudgetTaxGroup : row.POTaxGroup,
                    Phase = result.Phase,
                    Item = result.Item
                });

            await SaveData(false);
            ColorizeItem(row);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SaveOneTimeToDb error");
            Notifications.Error($"Error saving item to database: {ex.Message}");
        }
    }

    // Index 11 — mcITEM_UPDATEPRICELIST (FQuote.frm:2683): VB6 calls
    //   FPriceListUpdate.Showform(mShowBudgets, Assembly,
    //     GetComboBoxListKey(cboCommunity), cboPhase.Text, BudgetVendor,
    //     BudgetVendorName, EstPhase, EstItem, ItemDesc, BudgetRate, OrderUOM)
    // on the single right-clicked row (r = .Row) to push that line's vendor
    // cost into tblVendorCost.
    //
    // FPriceListUpdate.razor was migrated from the newer Showform(ShowBudgets,
    // Grid, Community, CommunityPhase, CommunityDescription, AssemblyType)
    // overload (FPriceListUpdate.frm:202) that FEstimateItems uses: the dialog
    // reads each selected grid row's columns by name (mPrefix = "Budget"/"PO")
    // and writes the INSERT/UPDATE against tblVendorCost itself. To call it
    // faithfully for FQuote's single-row case we project the right-clicked
    // QuoteItemRow into one GridRowData carrying exactly the columns the dialog
    // reads, host it with SelectedRowStart = SelectedRowEnd = 0, and let the
    // dialog perform the same write VB6's SaveData does.
    private void OnCtxUpdatePricelist()
    {
        CloseContextMenu();
        if (_ctxRow == null) return;   // VB6: If r < 1 Then Exit Sub

        // mPrefix in the dialog = "Budget" when ShowBudgets, else "PO". FQuote
        // is budget-only (mShowBudgets = True, FQuote.frm:399) so VB6 passes the
        // Budget* fields; honour the IIf so the PO branch stays correct if that
        // ever changes. Populate the prefix-qualified columns the dialog reads
        // (mPrefix & "Vendor"/"VendorName"/"Rate") plus the plain columns it
        // uses for the message + the tblVendorCost write (EstPhase/EstItem/
        // ItemDesc/OrderUOM/Model/Assembly).
        var prefix = ShowBudgets ? "Budget" : "PO";
        var vendor = ShowBudgets ? _ctxRow.BudgetVendor : _ctxRow.POVendor;
        var vendorName = ShowBudgets ? _ctxRow.BudgetVendorName : _ctxRow.POVendorName;
        var rate = ShowBudgets ? _ctxRow.BudgetRate : _ctxRow.PORate;

        var rowData = new FPriceListUpdate.GridRowData { IsSubtotal = false };
        rowData.Values[$"{prefix}Vendor"] = vendor ?? "";
        rowData.Values[$"{prefix}VendorName"] = vendorName ?? "";
        rowData.Values[$"{prefix}Rate"] = rate.ToString(CultureInfo.InvariantCulture);
        rowData.Values["EstPhase"] = _ctxRow.EstPhase ?? "";
        rowData.Values["EstItem"] = _ctxRow.EstItem ?? "";
        rowData.Values["ItemDesc"] = _ctxRow.ItemDesc ?? "";
        rowData.Values["OrderUOM"] = _ctxRow.OrderUOM ?? "";
        rowData.Values["Model"] = _ctxRow.Model ?? "";
        rowData.Values["Assembly"] = _ctxRow.Assembly ?? "";

        _priceListUpdateRows = new List<FPriceListUpdate.GridRowData> { rowData };
        _priceListUpdateRowEnd = 0;
        // FQuote rows carry no numeric assembly type; VB6 passes Val("" & "") = 0
        // here, i.e. the normal (non type-3) Model-handling branch in SaveData.
        _priceListUpdateAssemblyType = "";
        // Community / phase scope come from the form's cboCommunity (key) and
        // cboPhase, bound to the dialog in markup (Community / CommunityPhase) —
        // VB6 passes GetComboBoxListKey(cboCommunity) + cboPhase.Text.
        _showPriceListUpdate = true;
    }

