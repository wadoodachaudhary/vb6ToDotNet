    // ── Load Items ────────────────────────────────────────────
    private async Task LoadItems()
    {
        ItemsData = new();
        if (mJob == "\x01") return;

        try
        {
            var sql = "SELECT * FROM EstimatedItems WHERE Job_no = @JobNo";
            var dt = db.SqlExec(sql, new { JobNo = mJob });

            foreach (DataRow row in dt.Rows)
            {
                var estAssemblyId = ToInt(row["EstAssemblyID"]);
                if (estAssemblyId == 0) continue;

                var budgetDeleted = row["BudgetDeleted"]?.ToString() == "True";
                var poDeleted = row["PODeleted"]?.ToString() == "True";

                if ((ShowBudgets && budgetDeleted) || (!ShowBudgets && poDeleted))
                    continue;

                mEstAssemblyID = estAssemblyId;

                var convFactor = ToDouble(row["ConversionFactor"]);
                var budgetQty = ToDouble(row[ShowBudgets ? "BudgetQty" : "POQty"]);
                var takeoffQty = convFactor != 0 ? budgetQty / convFactor : budgetQty;

                var item = new QuoteItemRow
                {
                    EstItemID = row["EstItemID"]?.ToString() ?? "",
                    EstAssemblyID = row["EstAssemblyID"]?.ToString() ?? "",
                    Job_No = row["Job_No"]?.ToString() ?? "",
                    Assembly = row["Assembly"]?.ToString() ?? "",
                    AssemblyDescription = row["AssemblyDescription"]?.ToString() ?? "",
                    EstPhase = row["EstPhase"]?.ToString() ?? "",
                    EstItem = row["EstItem"]?.ToString() ?? "",
                    // View columns are ItemDesc / ItemComments (the EstimateItems
                    // TABLE has Description/Comments, but LoadItems reads the
                    // EstimatedItems VIEW — VB6 colkeys ItemDesc/ItemComments).
                    // row["Description"] threw and emptied the grid (HHM-613).
                    ItemDesc = row["ItemDesc"]?.ToString() ?? "",
                    ItemComments = row["ItemComments"]?.ToString() ?? "",
                    JCExtra = row["JCExtra"]?.ToString() ?? "",
                    JCCostCode = row["JCCostCode"]?.ToString() ?? "",
                    JCCostCodeDesc = row["JCCostCodeDesc"]?.ToString() ?? "",
                    JCCategory = row["JCCategory"]?.ToString() ?? "",
                    JCCategoryDesc = row["JCCategoryDesc"]?.ToString() ?? "",
                    OriginalJCCategory = row["OriginalJCCategory"]?.ToString() ?? "",
                    TakeoffQty = takeoffQty,
                    TakeoffUOM = row["TakeoffUOM"]?.ToString() ?? "",
                    OrderUOM = row["OrderUOM"]?.ToString() ?? "",
                    ConversionFactor = convFactor,
                    // VB6 fills EVERY grid colkey from rs — these were dropped in
                    // migration so WastePercent always showed 0 (HHM-613 issue 1).
                    // WastePercent stays null on DB NULL so the cell renders blank
                    // like legacy; RoundTo/RoundDir feed RoundToValue (Val(...)=0).
                    WastePercent = row["WastePercent"] == null || row["WastePercent"] == DBNull.Value
                        ? (double?)null : ToDouble(row["WastePercent"]),
                    RoundTo = ToDouble(row["RoundTo"]),
                    RoundDir = ToInt(row["RoundDir"]),
                    Seq = ToInt(row["Seq"]),
                    OptionID = row["OptionID"]?.ToString() ?? "",
                    POIndexDescription = row["POIndexDescription"]?.ToString() ?? "",
                    Model = row["Model"]?.ToString() ?? "",
                    BudgetVendor = row["BudgetVendor"]?.ToString() ?? "",
                    BudgetVendorName = row["BudgetVendorName"]?.ToString() ?? "",
                    BudgetQty = ToDouble(row["BudgetQty"]),
                    BudgetRate = ToDouble(row["BudgetRate"]),
                    BudgetPretax = ToDouble(row["BudgetPretax"]),
                    BudgetTaxGroup = row["BudgetTaxGroup"]?.ToString() ?? "",
                    BudgetJCTaxRate = ToDouble(row["BudgetJCTaxRate"]),
                    BudgetNJCTaxRate = ToDouble(row["BudgetNJCTaxRate"]),
                    BudgetJCTax = ToDouble(row["BudgetJCTax"]),
                    BudgetNJCTax = ToDouble(row["BudgetNJCTax"]),
                    BudgetOverridden = row["BudgetOverridden"]?.ToString() ?? "False",
                    BudgetGenerated = row["BudgetGenerated"]?.ToString() ?? "0",
                    POVendor = row["POVendor"]?.ToString() ?? "",
                    POVendorName = row["POVendorName"]?.ToString() ?? "",
                    POQty = ToDouble(row["POQty"]),
                    PORate = ToDouble(row["PORate"]),
                    POPretax = ToDouble(row["POPretax"]),
                    POTaxGroup = row["POTaxGroup"]?.ToString() ?? "",
                    POJCTaxRate = ToDouble(row["POJCTaxRate"]),
                    PONJCTaxRate = ToDouble(row["PONJCTaxRate"]),
                    POJCTax = ToDouble(row["POJCTax"]),
                    PONJCTax = ToDouble(row["PONJCTax"]),
                    POOverridden = row["POOverridden"]?.ToString() ?? "False",
                    PONumber = row["PONumber"]?.ToString() ?? "",
                    POIndex = row["POIndex"]?.ToString() ?? "",
                    ExcludeFromPO = row["ExcludeFromPO"]?.ToString() == "True" || row["ExcludeFromPO"]?.ToString() == "1",
                    RowState = ""
                };

                item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                item.POTax = item.POJCTax + item.PONJCTax;

                ColorizeItem(item);
                ItemsData.Add(item);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadItems error");

        }

        Dirty = false;
    }

    // ── Colorize / Validate Items ─────────────────────────────
    private void ColorizeItem(QuoteItemRow item)
    {
        var warnings = new List<string>();
        var rowBudgeted = item.BudgetGenerated != "0" && item.BudgetGenerated != "False";
        var rowPOed = !string.IsNullOrWhiteSpace(item.PONumber);
        var rowLocked = (rowBudgeted && ShowBudgets) || (rowPOed && !ShowBudgets);

        if (!rowLocked)
        {
            if (ShowBudgets)
            {
                if (string.IsNullOrWhiteSpace(item.POIndex)) warnings.Add("PO Index not specified");
                if (string.IsNullOrWhiteSpace(item.JCCostCode)) warnings.Add("Cost Code not specified");
                if (string.IsNullOrWhiteSpace(item.JCCategory)) warnings.Add("Category not specified");
                if (string.IsNullOrWhiteSpace(item.BudgetVendor)) warnings.Add("Vendor not specified");
                if (_optTaxGroupRequired && string.IsNullOrWhiteSpace(item.BudgetTaxGroup)) warnings.Add("Tax Group not specified");
            }
            else
            {
                if (string.IsNullOrWhiteSpace(item.POIndex)) warnings.Add("PO Index not specified");
                if (string.IsNullOrWhiteSpace(item.JCCostCode)) warnings.Add("Cost code not specified");
                if (string.IsNullOrWhiteSpace(item.JCCategory)) warnings.Add("Category not specified");
                if (string.IsNullOrWhiteSpace(item.POVendor)) warnings.Add("Vendor not specified");
                if (_optTaxGroupRequired && string.IsNullOrWhiteSpace(item.POTaxGroup)) warnings.Add("Tax Group not specified");
            }
        }

        item.WarningMessage = warnings.Count > 0 ? "⚠" : "";
    }

    private void ColorizeAllItems()
    {
        foreach (var item in ItemsData)
            ColorizeItem(item);
    }

    // ── AppOptions: Format_* colours + booleans (VB6 HFApp.Options) ───────
    // Mirrors FOptions' AppOptions read: division-specific value wins via
    // ORDER BY DivisionID. Missing rows fall back to VB6 design-time defaults
    // (Options.razor mOptions seed). VB6 ColorizeItems (FQuote.frm:2410) reads
    // Format_QtyRateLTZero / _QtyRateEQZero / _NonSysRate / _InvalidData.
    private async Task LoadAppOptionsAsync()
    {
        try
        {
            var opts = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            var dt = db.SqlExec(
                "SELECT OptionName, OptionValue FROM AppOptions WHERE DivisionID IN (0, @DivisionID) ORDER BY DivisionID",
                new { SessionState.DivisionID });
            foreach (DataRow r in dt.Rows)
                opts[r["OptionName"]?.ToString() ?? ""] = r["OptionValue"]?.ToString() ?? "";

            // VB6 Options.razor design-time defaults for any missing key.
            string Opt(string name, string fallback) =>
                opts.TryGetValue(name, out var v) && !string.IsNullOrEmpty(v) ? v : fallback;

            _fmtLtZeroFgRaw = Opt("Format_QtyRateLTZero_ForeColor", "0");
            _fmtLtZeroBgRaw = Opt("Format_QtyRateLTZero_BackColor", "12640511");
            _fmtLtZeroStyle = Opt("Format_QtyRateLTZero_FontStyle", "Regular");
            (_fmtLtZeroFg, _fmtLtZeroBg, _fmtLtZeroBold, _fmtLtZeroItalic) =
                ReadFormat(_fmtLtZeroFgRaw, _fmtLtZeroBgRaw, _fmtLtZeroStyle);

            _fmtEqZeroFgRaw = Opt("Format_QtyRateEQZero_ForeColor", "0");
            _fmtEqZeroBgRaw = Opt("Format_QtyRateEQZero_BackColor", "16773869");
            _fmtEqZeroStyle = Opt("Format_QtyRateEQZero_FontStyle", "Regular");
            (_fmtEqZeroFg, _fmtEqZeroBg, _fmtEqZeroBold, _fmtEqZeroItalic) =
                ReadFormat(_fmtEqZeroFgRaw, _fmtEqZeroBgRaw, _fmtEqZeroStyle);

            _fmtNonSysFgRaw = Opt("Format_NonSysRate_ForeColor", "8404992");
            _fmtNonSysBgRaw = Opt("Format_NonSysRate_BackColor", "16777215");
            _fmtNonSysStyle = Opt("Format_NonSysRate_FontStyle", "Bold Italic");
            (_fmtNonSysFg, _fmtNonSysBg, _fmtNonSysBold, _fmtNonSysItalic) =
                ReadFormat(_fmtNonSysFgRaw, _fmtNonSysBgRaw, _fmtNonSysStyle);

            _fmtInvalidFgRaw = Opt("Format_InvalidData_ForeColor", "255");
            _fmtInvalidBgRaw = Opt("Format_InvalidData_BackColor", "16777215");
            _fmtInvalidStyle = Opt("Format_InvalidData_FontStyle", "Bold");
            (_fmtInvalidFg, _fmtInvalidBg, _fmtInvalidBold, _fmtInvalidItalic) =
                ReadFormat(_fmtInvalidFgRaw, _fmtInvalidBgRaw, _fmtInvalidStyle);

            _optZeroRateOnRefreshCosts = OptBool(Opt("ZeroRateOnRefreshCosts", "False"));
            _optTaxGroupRequired = OptBool(Opt("TaxGroupRequired", "False"));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadAppOptions error");
        }
    }

    private static bool OptBool(string v) =>
        v == "1" || v.Equals("True", StringComparison.OrdinalIgnoreCase);

    // VB6 OLE_COLOR is a BGR long (or one of the system vbWindow* constants).
    // Returns (foreHex, backHex, bold, italic). VB6 substitutes near-black 1
    // for true black via the colour grid; we keep whatever value is stored.
    private static (string fore, string back, bool bold, bool italic) ReadFormat(
        string foreColor, string backColor, string fontStyle)
    {
        var bold = fontStyle.IndexOf("Bold", StringComparison.OrdinalIgnoreCase) >= 0;
        var italic = fontStyle.IndexOf("Italic", StringComparison.OrdinalIgnoreCase) >= 0;
        return (BgrToHex(foreColor), BgrToHex(backColor), bold, italic);
    }

    private static string BgrToHex(string bgrValue)
    {
        if (!long.TryParse(bgrValue, NumberStyles.Any, CultureInfo.InvariantCulture, out var bgr))
            return "transparent";
        // VB6 stores colour as &H00BBGGRR — low byte is Red.
        var r = (int)(bgr & 0xFF);
        var g = (int)((bgr >> 8) & 0xFF);
        var b = (int)((bgr >> 16) & 0xFF);
        return $"#{r:X2}{g:X2}{b:X2}";
    }

    // ── ColorizeItems → per-row CSS class names (VB6 FQuote.frm:2410) ─────
    // VB6 sets fore/back/italic/bold per row in this precedence order:
    //   locked (greyed)  →  LTZero  →  EQZero  →  NonSysRate(overridden)  →
    //   InvalidData (warnings, applied last so it wins). The .qi-* classes
    //   consume the DB-derived CSS vars declared in the scoped <style> block.
    private string? GetItemRowCss(QuoteItemRow row, int index)
    {
        var rowBudgeted = row.BudgetGenerated != "0" && row.BudgetGenerated != "False";
        var rowPOed = !string.IsNullOrWhiteSpace(row.PONumber);
        var rowLocked = (rowBudgeted && ShowBudgets) || (rowPOed && !ShowBudgets);

        if (rowLocked)
            return "qi-locked";   // VB6: vbGrayText fore colour

        var classes = new List<string>();

        // less than zero — rate or qty < 0
        var rate = ShowBudgets ? row.BudgetRate : row.PORate;
        var qty = ShowBudgets ? row.BudgetQty : row.POQty;
        if (rate < 0 || qty < 0)
        {
            classes.Add("qi-ltzero");
            if (_fmtLtZeroBold) classes.Add("qi-ltzero-b");
            if (_fmtLtZeroItalic) classes.Add("qi-ltzero-i");
        }

        // equal to zero — pretax = 0
        var pretax = ShowBudgets ? row.BudgetPretax : row.POPretax;
        if (pretax == 0)
        {
            classes.Add("qi-eqzero");
            if (_fmtEqZeroBold) classes.Add("qi-eqzero-b");
            if (_fmtEqZeroItalic) classes.Add("qi-eqzero-i");
        }

        // overridden (non-system) rate — Budget or PO overridden
        if (row.BudgetOverridden == "True" || row.POOverridden == "True")
        {
            classes.Add("qi-nonsys");
            if (_fmtNonSysBold) classes.Add("qi-nonsys-b");
            if (_fmtNonSysItalic) classes.Add("qi-nonsys-i");
        }

        // invalid data (warnings) — wins last in VB6
        if (RowHasWarnings(row))
        {
            classes.Add("qi-invalid");
            if (_fmtInvalidBold) classes.Add("qi-invalid-b");
            if (_fmtInvalidItalic) classes.Add("qi-invalid-i");
        }

        return classes.Count > 0 ? string.Join(" ", classes) : null;
    }

    // Mirror of ColorizeItem's warning detection (FQuote.frm:2482-2504), used
    // by GetItemRowCss so the row paints "invalid" exactly when ⚠ would show.
    private bool RowHasWarnings(QuoteItemRow row)
    {
        var rowBudgeted = row.BudgetGenerated != "0" && row.BudgetGenerated != "False";
        var rowPOed = !string.IsNullOrWhiteSpace(row.PONumber);
        var rowLocked = (rowBudgeted && ShowBudgets) || (rowPOed && !ShowBudgets);
        if (rowLocked) return false;

        if (string.IsNullOrWhiteSpace(row.POIndex)) return true;
        if (string.IsNullOrWhiteSpace(row.JCCostCode)) return true;
        if (string.IsNullOrWhiteSpace(row.JCCategory)) return true;
        if (string.IsNullOrWhiteSpace(ShowBudgets ? row.BudgetVendor : row.POVendor)) return true;
        if (_optTaxGroupRequired &&
            string.IsNullOrWhiteSpace(ShowBudgets ? row.BudgetTaxGroup : row.POTaxGroup)) return true;
        return false;
    }

