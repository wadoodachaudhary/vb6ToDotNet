```razor
@page "/direct-costs"
@rendermode InteractiveServer

@using System.Data
@using System.Linq
@using System.Collections.Generic
@using HomeFront.Data

@inject IJSRuntime JSRuntime

<PageTitle>Journal Entries - HomeFront</PageTitle>

<style>
    .toolbar-cntr {
        padding: 8px 12px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }
    .tbar-btn {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        padding: 6px 12px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 11px;
        min-width: 70px;
    }
    .tbar-btn:hover:not(:disabled) { background: #e9ecef; }
    .tbar-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .tbar-separator { width: 1px; height: 36px; background: #ced4da; margin: 0 4px; }
    .header-panel {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 12px;
        background: #fff;
        margin-bottom: 10px;
    }
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }
    .form-col .form-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }
    .form-row label {
        min-width: 120px;
        text-align: right;
        font-weight: 600;
        font-size: 13px;
    }
    .form-row input, .form-row select, .form-row textarea {
        flex: 1;
        padding: 5px 10px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 13px;
    }
    .form-row textarea { min-height: 70px; }
    .batch-number {
        font-weight: 700;
        color: #343a40;
    }
    .footer-panel {
        display: flex;
        justify-content: space-between;
        padding: 8px 12px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
        margin-top: 10px;
        font-size: 13px;
    }
    .footer-left div {
        margin-bottom: 4px;
    }
    .totals {
        text-align: right;
        font-weight: 600;
    }
</style>

<div class="toolbar-cntr">
    <button class="tbar-btn" @onclick="OnNewClick">
        <span>New</span>
    </button>
    <button class="tbar-btn" @onclick="OnOpenClick">
        <span>Open</span>
    </button>
    <button class="tbar-btn" disabled="@(!CanSave)" @onclick="OnSaveClick">
        <span>Save</span>
    </button>
    <button class="tbar-btn" disabled="@(!CanSaveAs)" @onclick="OnSaveAsClick">
        <span>Save As</span>
    </button>
    <button class="tbar-btn" disabled="@(!CanDelete)" @onclick="OnDeleteClick">
        <span>Delete</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" disabled="@(!CanPost)" @onclick="OnPostClick">
        <span>Post</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" @onclick="OnAttachmentsClick">
        <span>Attachments</span>
    </button>
</div>

<div class="header-panel">
    <div class="form-grid">
        <div class="form-col">
            <div class="form-row">
                <label>Batch Number</label>
                <span class="batch-number">@BatchNumber</span>
            </div>
            <div class="form-row">
                <label>Description</label>
                <input type="text" maxlength="200" @bind="BatchDescription" @bind:event="oninput" @bind:after="MarkDirty" disabled="@mLocked" />
            </div>
            <div class="form-row">
                <label>Batch Type</label>
                <select @bind="BatchType" @bind:after="OnBatchTypeChanged" disabled="@mLocked">
                    <option value=""></option>
                    @foreach (var bt in BatchTypes)
                    {
                        <option value="@bt">@bt</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label>Accounting Date</label>
                <input type="date" @bind="AccountingDateValue" @bind:after="OnDateChanged" disabled="@mLocked" />
            </div>
        </div>
        <div class="form-col">
            <div class="form-row">
                <label>Notes</label>
                <textarea @bind="Comments" @bind:event="oninput" @bind:after="MarkDirty" disabled="@mLocked"></textarea>
            </div>
        </div>
    </div>
</div>

<HfGrid @ref="DataGrid"
        TValue="JournalLine"
        DataSource="@Lines"
        AllowSelection="true"
        AllowSorting="true"
        AllowFiltering="true"
        AllowResizing="true"
        Height="420px"
        EditSettingsRef="@editSettings"
        EventsRef="@gridEvents">
    <HfGridColumnsBase>
        <HfGridColumn Field="@nameof(JournalLine.Sequence)" HeaderText="#" Width="60px" AllowEditing="false" />
        <HfGridColumn Field="@nameof(JournalLine.Job)" HeaderText="Job" Width="90px" />
        <HfGridColumn Field="@nameof(JournalLine.JobDesc)" HeaderText="Job Desc" Width="160px" AllowEditing="false" />
        <HfGridColumn Field="@nameof(JournalLine.Extra)" HeaderText="Extra" Width="70px" />
        <HfGridColumn Field="@nameof(JournalLine.ExtraDesc)" HeaderText="Extra Desc" Width="160px" AllowEditing="false" />
        <HfGridColumn Field="@nameof(JournalLine.CostCode)" HeaderText="Cost Code" Width="90px" />
        <HfGridColumn Field="@nameof(JournalLine.CostCodeDesc)" HeaderText="Cost Code Desc" Width="160px" AllowEditing="false" />
        <HfGridColumn Field="@nameof(JournalLine.Category)" HeaderText="Category" Width="90px" />
        <HfGridColumn Field="@nameof(JournalLine.CategoryDesc)" HeaderText="Category Desc" Width="160px" AllowEditing="false" />
        <HfGridColumn Field="@nameof(JournalLine.Description)" HeaderText="Line Description" Width="200px" />
        <HfGridColumn Field="@nameof(JournalLine.Account)" HeaderText="Account" Width="100px" />
        <HfGridColumn Field="@nameof(JournalLine.AccountDesc)" HeaderText="Account Desc" Width="160px" AllowEditing="false" />
        <HfGridColumn Field="@nameof(JournalLine.Debit)" HeaderText="Debit" Width="110px"
                      Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
        <HfGridColumn Field="@nameof(JournalLine.Credit)" HeaderText="Credit" Width="110px"
                      Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
    </HfGridColumnsBase>
</HfGrid>

<div class="footer-panel">
    <div class="footer-left">
        <div><strong>Modified:</strong> @ModifiedDate</div>
        <div><strong>Posted:</strong> @PostedDate</div>
    </div>
    <div class="totals">
        <div>Total Debits: @TotalDebitLabel</div>
        <div>Total Credits: @TotalCreditLabel</div>
    </div>
</div>

@code {
    private readonly DbWrapperSqlServer db = new();
    private HfGrid<JournalLine>? DataGrid;

    private readonly int DivisionID = 1;
    private bool mLocked;
    private bool mDirty;
    private bool mCancelEdit;

    private long BatchId;
    private string BatchNumber = "";
    private string BatchDescription = "";
    private string BatchType = "";
    private DateTime? AccountingDateValue = DateTime.Today;
    private string Comments = "";
    private string ModifiedDate = "";
    private string PostedDate = "";

    private List<string> BatchTypes = new();
    private List<JournalLine> Lines = new();

    private decimal TotalDebit;
    private decimal TotalCredit;
    private bool IsValid;

    private string TotalDebitLabel => TotalDebit.ToString("$#,##0.00");
    private string TotalCreditLabel => TotalCredit.ToString("$#,##0.00");

    private bool CanSave => IsValid && !mLocked && mDirty;
    private bool CanSaveAs => IsValid;
    private bool CanPost => IsValid && !mLocked;
    private bool CanDelete => !mLocked;

    private readonly HfEditSettings editSettings = new()
    {
        AllowAdding = true,
        AllowEditing = true,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };
    private readonly HfGridEvents<JournalLine> gridEvents = new();

    protected override async Task OnInitializedAsync()
    {
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<JournalLine>>(this, OnCellSaved);
        await LoadTypesAsync();
        await LoadDataAsync(0, false);
    }

    private async Task LoadTypesAsync()
    {
        var dt = db.SqlExec("select distinct isnull(batchtype,'') BatchType from journalentries order by 1");
        BatchTypes = dt.AsEnumerable().Select(r => r["BatchType"]?.ToString() ?? "").ToList();
    }

    private async Task LoadDataAsync(long batchId, bool createNew)
    {
        if (batchId == 0)
        {
            if (!createNew)
            {
                batchId = await db.ExecuteScalarAsync<long?>(
                    "select min(batchid) from journalentries where isnull(postingbatchid,0)=0") ?? 0;
            }
            if (batchId == 0)
            {
                await db.ExecuteAsync("insert into journalentries(Description,AccountingDate) values('new batch',convert(date,getdate()))");
                batchId = await db.ExecuteScalarAsync<long>("select cast(scope_identity() as bigint)");
            }
        }

        BatchId = batchId;
        await LoadTypesAsync();

        var master = db.SqlExec("select * from journalentries where batchid=@BatchID", new { BatchID = BatchId });
        if (master.Rows.Count == 0) return;

        var row = master.Rows[0];
        SetLocked(ToInt(row["PostingBatchID"]) != 0);

        BatchNumber = row["BatchID"]?.ToString() ?? "";
        BatchDescription = row["Description"]?.ToString() ?? "";
        BatchType = row["BatchType"]?.ToString() ?? "";
        AccountingDateValue = ToDate(row["AccountingDate"]);
        Comments = row["Comments"]?.ToString() ?? "";
        ModifiedDate = FormatDate(row["ModifiedDate"]);
        PostedDate = FormatDate(row["PostingDate"]);

        var sql = @"
            select l.*, j.description JobDesc, e.description ExtraDesc,
                   c.description CostCodeDesc, g.description CategoryDesc, a.description AccountDesc
              from journalentrylines l
              left join tbljobs j on (l.DivisionID=j.DivisionID and l.job=j.job_no)
              left join jobextras e on (l.DivisionID=e.DivisionID and l.job=e.job and l.extra=e.extra)
              left join standardcostcodes c on (l.DivisionID=c.DivisionID and l.costcode=c.costcode)
              left join standardcategories g on (l.DivisionID=g.DivisionID and l.category=g.category)
              left join glaccounts a on (l.DivisionID=a.DivisionID and l.account=a.account)
             where l.DivisionID=@DivisionID and batchid=@BatchID";
        var dt = db.SqlExec(sql, new { DivisionID, BatchID = BatchId });

        Lines = new List<JournalLine>();
        int seq = 1;
        foreach (DataRow r in dt.Rows)
        {
            var line = new JournalLine
            {
                Sequence = seq++,
                Job = r["Job"]?.ToString() ?? "",
                JobDesc = r["JobDesc"]?.ToString() ?? "",
                Extra = r["Extra"]?.ToString() ?? "",
                ExtraDesc = r["ExtraDesc"]?.ToString() ?? "",
                CostCode = r["CostCode"]?.ToString() ?? "",
                CostCodeDesc = r["CostCodeDesc"]?.ToString() ?? "",
                Category = r["Category"]?.ToString() ?? "",
                CategoryDesc = r["CategoryDesc"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? "",
                Account = r["Account"]?.ToString() ?? "",
                AccountDesc = r["AccountDesc"]?.ToString() ?? "",
                Debit = ToDecimal(r["DebitAmount"]),
                Credit = ToDecimal(r["CreditAmount"]),
                RowState = "CLEAN"
            };
            Lines.Add(line);
        }
        EnsureBlankRow();
        ReindexSequence();
        ValidateData();
        mDirty = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> SaveDataAsync(bool prompt)
    {
        if (!mDirty) return true;

        if (!ValidateData())
        {
            if (!prompt)
            {
                await JSRuntime.InvokeVoidAsync("alert", "This data is incomplete and cannot be saved.");
                return false;
            }
            var ok = await JSRuntime.InvokeAsync<bool>("confirm",
                "This data is incomplete and cannot be saved.\n\nYour changes will be lost.");
            return ok;
        }

        if (prompt)
        {
            var res = await JSRuntime.InvokeAsync<bool>("confirm",
                "This data has changed.\n\nDo you want to save these changes?");
            if (!res) return true;
        }

        await db.ExecuteAsync(@"
            update journalentries
               set Description=@Description,
                   BatchType=@BatchType,
                   AccountingDate=@AccountingDate,
                   Comments=@Comments
             where BatchID=@BatchID",
            new
            {
                Description = BatchDescription,
                BatchType,
                AccountingDate = AccountingDateValue,
                Comments,
                BatchID = BatchId
            });

        await db.ExecuteAsync("delete from journalentrylines where batchid=@BatchID", new { BatchID = BatchId });

        foreach (var line in Lines.Where(l => !l.IsEmpty))
        {
            await db.ExecuteAsync(@"
                insert into journalentrylines
                    (DivisionID,BatchID,Description,Job,Extra,CostCode,Category,Account,DebitAmount,CreditAmount)
                values
                    (@DivisionID,@BatchID,@Description,@Job,@Extra,@CostCode,@Category,@Account,@Debit,@Credit)",
                new
                {
                    DivisionID,
                    BatchID = BatchId,
                    Description = line.Description ?? "",
                    Job = line.Job ?? "",
                    Extra = line.Extra ?? "",
                    CostCode = line.CostCode ?? "",
                    Category = line.Category ?? "",
                    Account = line.Account ?? "",
                    Debit = line.Debit,
                    Credit = line.Credit
                });
        }

        mDirty = false;
        return true;
    }

    private bool ValidateData()
    {
        var sMissing = string.IsNullOrWhiteSpace(BatchType);
        var dMissing = AccountingDateValue == null;

        TotalDebit = 0;
        TotalCredit = 0;
        bool rowMissingAmount = false;
        bool rowMissingAccount = false;

        foreach (var line in Lines.Where(l => !l.IsEmpty))
        {
            TotalDebit += Math.Round(line.Debit, 2);
            TotalCredit += Math.Round(line.Credit, 2);

            if (line.Debit == 0 && line.Credit == 0) rowMissingAmount = true;
            if (string.IsNullOrWhiteSpace(line.Account)) rowMissingAccount = true;
        }

        IsValid = Math.Round(TotalDebit, 2) == Math.Round(TotalCredit, 2)
            && TotalDebit != 0
            && !rowMissingAmount
            && !rowMissingAccount
            && !sMissing
            && !dMissing;

        StateHasChanged();
        return IsValid;
    }

    private async Task OnCellSaved(CellSaveArgs<JournalLine> args)
    {
        if (args.Data == null) return;
        var row = args.Data;
        var col = args.ColumnName ?? "";

        switch (col)
        {
            case nameof(JournalLine.Job):
                await ValidateJobAsync(row);
                break;
            case nameof(JournalLine.Extra):
                await ValidateExtraAsync(row);
                break;
            case nameof(JournalLine.CostCode):
                await ValidateCostCodeAsync(row);
                break;
            case nameof(JournalLine.Category):
                await ValidateCategoryAsync(row);
                break;
            case nameof(JournalLine.Account):
                await ValidateAccountAsync(row);
                break;
            case nameof(JournalLine.Debit):
                if (row.Debit != 0) row.Credit = 0;
                break;
            case nameof(JournalLine.Credit):
                if (row.Credit != 0) row.Debit = 0;
                break;
        }

        row.RowState = row.RowState == "NEW" ? "NEW" : "DIRTY";
        mDirty = true;
        EnsureBlankRow();
        ReindexSequence();
        ValidateData();
    }

    private async Task ValidateJobAsync(JournalLine row)
    {
        if (string.IsNullOrWhiteSpace(row.Job))
        {
            row.Job = row.JobDesc = row.Extra = row.ExtraDesc = row.CostCode = row.CostCodeDesc = row.Category = row.CategoryDesc = "";
            return;
        }
        var dt = db.SqlExec("select job_no,description from tbljobs where DivisionID=@DivisionID and job_no=@Job",
            new { DivisionID, Job = row.Job });
        if (dt.Rows.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Job not found.");
            row.Job = "";
            row.JobDesc = "";
            return;
        }
        row.Job = dt.Rows[0]["job_no"]?.ToString() ?? row.Job;
        row.JobDesc = dt.Rows[0]["description"]?.ToString() ?? "";
        row.Extra = row.ExtraDesc = row.CostCode = row.CostCodeDesc = row.Category = row.CategoryDesc = "";
    }

    private async Task ValidateExtraAsync(JournalLine row)
    {
        if (string.IsNullOrWhiteSpace(row.Extra))
        {
            row.Extra = row.ExtraDesc = row.CostCode = row.CostCodeDesc = row.Category = row.CategoryDesc = "";
            return;
        }
        var dt = db.SqlExec("select extra,description from jobextras where DivisionID=@DivisionID and job=@Job and extra=@Extra",
            new { DivisionID, Job = row.Job ?? "", Extra = row.Extra ?? "" });
        if (dt.Rows.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Extra not found.");
            row.Extra = "";
            row.ExtraDesc = "";
            return;
        }
        row.ExtraDesc = dt.Rows[0]["description"]?.ToString() ?? "";
        row.CostCode = row.CostCodeDesc = row.Category = row.CategoryDesc = "";
    }

    private async Task ValidateCostCodeAsync(JournalLine row)
    {
        if (string.IsNullOrWhiteSpace(row.CostCode))
        {
            row.CostCode = row.CostCodeDesc = row.Category = row.CategoryDesc = "";
            return;
        }
        var dt = db.SqlExec("select costcode,description,debitaccount from standardcostcodes where DivisionID=@DivisionID and costcode=@CostCode",
            new { DivisionID, CostCode = row.CostCode ?? "" });
        if (dt.Rows.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Cost code not found.");
            row.CostCode = "";
            row.CostCodeDesc = "";
            return;
        }
        row.CostCode = dt.Rows[0]["costcode"]?.ToString() ?? row.CostCode;
        row.CostCodeDesc = dt.Rows[0]["description"]?.ToString() ?? "";
        var acct = dt.Rows[0]["debitaccount"]?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(acct))
        {
            row.Account = acct;
            await ValidateAccountAsync(row);
        }
        row.Category = row.CategoryDesc = "";
    }

    private async Task ValidateCategoryAsync(JournalLine row)
    {
        if (string.IsNullOrWhiteSpace(row.Category))
        {
            row.Category = row.CategoryDesc = "";
            return;
        }
        var dt = db.SqlExec("select category,description from standardcategories where DivisionID=@DivisionID and category=@Category",
            new { DivisionID, Category = row.Category ?? "" });
        if (dt.Rows.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Category not found.");
            row.Category = "";
            row.CategoryDesc = "";
            return;
        }
        row.CategoryDesc = dt.Rows[0]["description"]?.ToString() ?? "";
    }

    private async Task ValidateAccountAsync(JournalLine row)
    {
        if (string.IsNullOrWhiteSpace(row.Account))
        {
            row.Account = row.AccountDesc = "";
            return;
        }
        var dt = db.SqlExec("select account,description from glaccounts where DivisionID=@DivisionID and account=@Account",
            new { DivisionID, Account = row.Account ?? "" });
        if (dt.Rows.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Account not found.");
            row.Account = "";
            row.AccountDesc = "";
            return;
        }
        row.AccountDesc = dt.Rows[0]["description"]?.ToString() ?? "";
    }

    private void EnsureBlankRow()
    {
        if (Lines.Count == 0 || !Lines.Last().IsEmpty)
            Lines.Add(new JournalLine { RowState = "NEW" });
    }

    private void ReindexSequence()
    {
        int seq = 1;
        foreach (var l in Lines)
            l.Sequence = seq++;
    }

    private void SetLocked(bool value)
    {
        mLocked = value;
        editSettings.AllowEditing = !mLocked;
        editSettings.AllowAdding = !mLocked;
        editSettings.AllowDeleting = !mLocked;
    }

    private void MarkDirty() { mDirty = true; ValidateData(); }

    private void OnBatchTypeChanged() { mDirty = true; ValidateData(); }

    private void OnDateChanged() { mDirty = true; ValidateData(); }

    private async Task OnNewClick()
    {
        if (!await SaveDataAsync(true)) return;
        await LoadDataAsync(0, true);
    }

    private async Task OnOpenClick()
    {
        if (!await SaveDataAsync(true)) return;
        var result = await JSRuntime.InvokeAsync<string>("prompt", "Enter Batch ID to open:");
        if (long.TryParse(result, out var id))
            await LoadDataAsync(id, true);
    }

    private async Task OnSaveClick() => await SaveDataAsync(false);

    private async Task OnSaveAsClick()
    {
        await db.ExecuteAsync("insert into journalentries(Description,AccountingDate) values('new batch',convert(date,getdate()))");
        BatchId = await db.ExecuteScalarAsync<long>("select cast(scope_identity() as bigint)");
        BatchNumber = BatchId.ToString();
        mDirty = true;
        await SaveDataAsync(false);
        PostedDate = "";
        SetLocked(false);
        ValidateData();
    }

    private async Task OnDeleteClick()
    {
        if (mLocked) return;
        var ok = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this batch?");
        if (!ok) return;
        await db.ExecuteAsync("delete from journalentrylines where batchid=@BatchID", new { BatchID = BatchId });
        await db.ExecuteAsync("delete from journalentries where batchid=@BatchID", new { BatchID = BatchId });
        await LoadDataAsync(0, false);
    }

    private async Task OnPostClick()
    {
        if (!await SaveDataAsync(false)) return;
        await db.ExecuteAsync("update journalentries set postingdate=getdate(),postingbatchid=batchid where batchid=@BatchID",
            new { BatchID = BatchId });
        await LoadDataAsync(0, true);
    }

    private async Task OnAttachmentsClick()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Attachments dialog not implemented.");
    }

    private static int ToInt(object? val) =>
        val == null || val == DBNull.Value ? 0 : Convert.ToInt32(val);

    private static decimal ToDecimal(object? val) =>
        val == null || val == DBNull.Value ? 0 : Convert.ToDecimal(val);

    private static DateTime? ToDate(object? val) =>
        val == null || val == DBNull.Value ? null : Convert.ToDateTime(val);

    private static string FormatDate(object? val) =>
        val == null || val == DBNull.Value ? "" : Convert.ToDateTime(val).ToString("MM/dd/yyyy");

    public class JournalLine
    {
        public int Sequence { get; set; }
        public string Job { get; set; } = "";
        public string JobDesc { get; set; } = "";
        public string Extra { get; set; } = "";
        public string ExtraDesc { get; set; } = "";
        public string CostCode { get; set; } = "";
        public string CostCodeDesc { get; set; } = "";
        public string Category { get; set; } = "";
        public string CategoryDesc { get; set; } = "";
        public string Description { get; set; } = "";
        public string Account { get; set; } = "";
        public string AccountDesc { get; set; } = "";
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public string RowState { get; set; } = "CLEAN";

        public bool IsEmpty =>
            string.IsNullOrWhiteSpace(Job) &&
            string.IsNullOrWhiteSpace(Extra) &&
            string.IsNullOrWhiteSpace(CostCode) &&
            string.IsNullOrWhiteSpace(Category) &&
            string.IsNullOrWhiteSpace(Description) &&
            string.IsNullOrWhiteSpace(Account) &&
            Debit == 0 &&
            Credit == 0;
    }
}
```