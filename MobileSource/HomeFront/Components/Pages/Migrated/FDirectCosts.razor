@page "/direct-costs"
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using System.Data
@using System.Linq
@using System.Collections.Generic
@using System.Reflection
@using System.Text
@using HomeFront.Data
@using HomeFront.Models
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FDirectCosts> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db

<PageTitle>Journal Entries - HomeFront</PageTitle>

<div class="toolbar-cntr">
    <button class="tbar-btn" @onclick="OnNewClick">
        <span>New</span>
    </button>
    <button class="tbar-btn" @onclick="OnOpenClick">
        <span>Open</span>
    </button>
    <button class="tbar-btn" disabled="@(!CanSave)" @onclick="OnSaveClick">
        <span>Save</span>
    </button>
    <button class="tbar-btn" disabled="@(!CanSaveAs)" @onclick="OnSaveAsClick">
        <span>Save As</span>
    </button>
    <button class="tbar-btn" disabled="@(!CanDelete)" @onclick="OnDeleteClick">
        <span>Delete</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" disabled="@(!CanPost)" @onclick="OnPostClick">
        <span>Post</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" @onclick="OnAttachmentsClick">
        <span>Attachments</span>
    </button>
</div>

<div class="header-panel">
    <div class="form-grid">
        <div class="form-col">
            <div class="form-row">
                <label>Batch Number</label>
                <span class="batch-number">@BatchNumber</span>
            </div>
            <div class="form-row">
                <label>Description</label>
                <TextBoxControl @bind-Value="BatchDescription" @bind-Value:after="MarkDirty" MaxLength="200" Enabled="@(!mLocked)" CssClass="dc-input" />
            </div>
            <div class="form-row">
                <label>Batch Type</label>
                <DropDownListControl TValue="string" TItem="string" DataSource="@BatchTypeOptions"
                                     @bind-Value="BatchType" @bind-Value:after="OnBatchTypeChanged"
                                     Enabled="@(!mLocked)" CssClass="dc-input" />
            </div>
            <div class="form-row">
                <label>Accounting Date</label>
                <DatePickerControl @bind-Value="AccountingDateValue" @bind-Value:after="OnDateChanged" Enabled="@(!mLocked)" />
            </div>
        </div>
        <div class="form-col">
            <div class="form-row">
                <label>Notes</label>
                <TextAreaControl @bind-Value="Comments" @bind-Value:after="MarkDirty" Enabled="@(!mLocked)" CssClass="dc-textarea" />
            </div>
        </div>
    </div>
</div>

<GridControl @ref="DataGrid"
        TValue="JournalLine"
        DataSource="@Lines"
        AllowSelection="true"
        AllowSorting="true"
        AllowFiltering="true"
        AllowResizing="true"
        Height="420px"
        EditSettingsRef="@editSettings"
        EventsRef="@gridEvents">
    <GridColumnsBase @key="gDirectCostsLayoutVersion">
        @if (HasGridLayout)
        {
            foreach (var entry in GetOrderedGridLayout())
            {
                var layout = entry.Layout;
                var fieldName = entry.Field;
                var columnType = entry.ColumnType;
                var textAlign = entry.TextAlign;
                var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                var width = layout.Width.HasValue && layout.Width.Value > 0
                    ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;
                var allowEdit = IsFieldEditable(fieldName);
                var format = (columnType == ColumnType.Number) ? "N2" : null;

                <GridColumn Field="@fieldName"
                              HeaderText="@headerText"
                              Width="@width"
                              Type="@columnType"
                              TextAlign="@textAlign"
                              AllowEditing="@allowEdit"
                              Format="@format"
                              ClipMode="ClipMode.Ellipsis" />
            }
        }
        else
        {
            <GridColumn Field="@nameof(JournalLine.Sequence)" HeaderText="#" Width="60px" AllowEditing="false" />
            <GridColumn Field="@nameof(JournalLine.Job)" HeaderText="Job" Width="90px" />
            <GridColumn Field="@nameof(JournalLine.JobDesc)" HeaderText="Job Desc" Width="160px" AllowEditing="false" />
            <GridColumn Field="@nameof(JournalLine.Extra)" HeaderText="Extra" Width="70px" />
            <GridColumn Field="@nameof(JournalLine.ExtraDesc)" HeaderText="Extra Desc" Width="160px" AllowEditing="false" />
            <GridColumn Field="@nameof(JournalLine.CostCode)" HeaderText="Cost Code" Width="90px" />
            <GridColumn Field="@nameof(JournalLine.CostCodeDesc)" HeaderText="Cost Code Desc" Width="160px" AllowEditing="false" />
            <GridColumn Field="@nameof(JournalLine.Category)" HeaderText="Category" Width="90px" />
            <GridColumn Field="@nameof(JournalLine.CategoryDesc)" HeaderText="Category Desc" Width="160px" AllowEditing="false" />
            <GridColumn Field="@nameof(JournalLine.Description)" HeaderText="Line Description" Width="200px" />
            <GridColumn Field="@nameof(JournalLine.Account)" HeaderText="Account" Width="100px" />
            <GridColumn Field="@nameof(JournalLine.AccountDesc)" HeaderText="Account Desc" Width="160px" AllowEditing="false" />
            <GridColumn Field="@nameof(JournalLine.Debit)" HeaderText="Debit" Width="110px"
                          Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
            <GridColumn Field="@nameof(JournalLine.Credit)" HeaderText="Credit" Width="110px"
                          Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
        }
    </GridColumnsBase>
</GridControl>

<div class="footer-panel">
    <div class="footer-left">
        <div><strong>Modified:</strong> @ModifiedDate</div>
        <div><strong>Posted:</strong> @PostedDate</div>
    </div>
    <div class="totals">
        <div>Total Debits: @TotalDebitLabel</div>
        <div>Total Credits: @TotalCreditLabel</div>
    </div>
</div>

@* ── Open Batch Dialog ── *@
<DialogControl @bind-Visible="ShowOpenDialog" Header="Select Batch" Width="700px" CssClass="dc-open-dialog">
    <ChildContent>
        <div class="dc-open-tabs">
            <ButtonControl CssClass="@(OpenDialogTab == "open" ? "tbar-btn dc-tab-active" : "tbar-btn")"
                           OnClick="OnOpenBatchesTab">Open Batches</ButtonControl>
            <ButtonControl CssClass="@(OpenDialogTab == "posted" ? "tbar-btn dc-tab-active" : "tbar-btn")"
                           OnClick="OnPostedBatchesTab">Posted Batches</ButtonControl>
        </div>
        <div class="dc-open-body">
            <table class="grid-table dc-open-table">
                <thead>
                    <tr>
                        <th>BatchID</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>Accounting Date</th>
                        @if (OpenDialogTab == "posted")
                        {
                            <th>Posting Date</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in OpenBatchList)
                    {
                        <tr class="dc-open-row" @onclick="() => OnBatchSelected(b.Id)">
                            <td>@b.Id</td>
                            <td>@b.Description</td>
                            <td>@b.Type</td>
                            <td>@b.AccountingDate</td>
                            @if (OpenDialogTab == "posted")
                            {
                                <td>@b.PostingDate</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="tbar-btn" OnClick="@(() => { ShowOpenDialog = false; })">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
private GridControl<JournalLine>? DataGrid;
    private bool mLocked;
    private bool mDirty;

    private long BatchId;
    private string BatchNumber = "";
    private string BatchDescription = "";
    private string BatchType = "";
    private DateTime? AccountingDateValue = DateTime.Today;
    private string Comments = "";
    private string ModifiedDate = "";
    private string PostedDate = "";

    // Open dialog state
    private bool ShowOpenDialog;
    private string OpenDialogTab = "open";
    private List<BatchListItem> OpenBatchList = new();

    private List<string> BatchTypes = new();
    // Dropdown source: keep a leading blank entry (mirrors the old <select>'s explicit empty <option>)
    private List<string> BatchTypeOptions =>
        BatchTypes.Any(t => string.IsNullOrEmpty(t))
            ? BatchTypes
            : new List<string> { "" }.Concat(BatchTypes).ToList();
    private List<JournalLine> Lines = new();

    private decimal TotalDebit;
    private decimal TotalCredit;
    private bool IsValid;

    private string TotalDebitLabel => TotalDebit.ToString("$#,##0.00");
    private string TotalCreditLabel => TotalCredit.ToString("$#,##0.00");

    private bool CanSave => IsValid && !mLocked && mDirty;
    private bool CanSaveAs => IsValid;
    private bool CanPost => IsValid && !mLocked;
    private bool CanDelete => !mLocked;

    private readonly EditSettings editSettings = new()
    {
        AllowAdding = true,
        AllowEditing = true,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };
    private readonly GridControlEvents<JournalLine> gridEvents = new();

    // ── Grid Layout via the shared GridLayoutPresenter ────────
    // The load/resolve/order/width boilerplate lives in GridLayoutPresenter<TRow>;
    // only the VB6 form/grid name strings stay here (fidelity). gDirectCostsLayout
    // / HasGridLayout / gDirectCostsLayoutVersion below are thin delegations so the
    // markup is unchanged. VB6 gridname has the .(0) index suffix → instanceKey
    // "(0)" drives the keyed-then-unkeyed two-call fallback inside LoadAsync. The
    // three column-name aliases (DebitAmount→Debit, CreditAmount→Credit,
    // LineDescription→Description) that were a fallback switch in ResolveGridField
    // move verbatim into the ctor alias map (keyed by NormalizeKey).
    private readonly GridLayoutPresenter<JournalLine> _g =
        new("FDirectCosts", "gDirectCosts", instanceKey: "(0)",
            aliases: new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["debitamount"] = nameof(JournalLine.Debit),
                ["creditamount"] = nameof(JournalLine.Credit),
                ["linedescription"] = nameof(JournalLine.Description)
            });

    private Dictionary<string, GridLayoutColumn> gDirectCostsLayout => _g.Layout;
    private bool HasGridLayout => _g.Has;
    private int gDirectCostsLayoutVersion => _g.Version;

    protected override async Task OnInitializedAsync()
    {
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<JournalLine>>(this, OnCellSaved);
        await LoadGridLayoutAsync();
        await LoadTypesAsync();
        await LoadDataAsync(0, false);
    }

    private async Task LoadTypesAsync()
    {
        var dt = db.SqlExec("select distinct isnull(batchtype,'') BatchType from journalentries order by 1");
        BatchTypes = dt.AsEnumerable().Select(r => r["BatchType"]?.ToString() ?? "").ToList();
    }

    private async Task LoadDataAsync(long batchId, bool createNew)
    {
        if (batchId == 0)
        {
            if (!createNew)
            {
                batchId = await db.ExecuteScalarAsync<long?>(
                    "select min(batchid) from journalentries where isnull(postingbatchid,0)=0") ?? 0;
            }
            if (batchId == 0)
            {
                await db.ExecuteAsync("insert into journalentries(Description,AccountingDate) values('new batch',convert(date,getdate()))");
                batchId = await db.ExecuteScalarAsync<long>("select cast(scope_identity() as bigint)");
            }
        }

        BatchId = batchId;
        await LoadTypesAsync();

        var master = db.SqlExec("select * from journalentries where batchid=@BatchID", new { BatchID = BatchId });
        if (master.Rows.Count == 0) return;

        var row = master.Rows[0];
        SetLocked(ToInt(row["PostingBatchID"]) != 0);

        BatchNumber = row["BatchID"]?.ToString() ?? "";
        BatchDescription = row["Description"]?.ToString() ?? "";
        BatchType = row["BatchType"]?.ToString() ?? "";
        AccountingDateValue = ToDate(row["AccountingDate"]);
        Comments = row["Comments"]?.ToString() ?? "";
        ModifiedDate = FormatDate(row["ModifiedDate"]);
        PostedDate = FormatDate(row["PostingDate"]);

        var sql = @"
            select l.*, j.description JobDesc, e.description ExtraDesc,
                   c.description CostCodeDesc, g.description CategoryDesc, a.description AccountDesc
              from journalentrylines l
              left join tbljobs j on (l.DivisionID=j.DivisionID and l.job=j.job_no)
              left join jobextras e on (l.DivisionID=e.DivisionID and l.job=e.job and l.extra=e.extra)
              left join standardcostcodes c on (l.DivisionID=c.DivisionID and l.costcode=c.costcode)
              left join standardcategories g on (l.DivisionID=g.DivisionID and l.category=g.category)
              left join glaccounts a on (l.DivisionID=a.DivisionID and l.account=a.account)
             where l.DivisionID=@DivisionID and batchid=@BatchID";
        var dt = db.SqlExec(sql, new { SessionState.DivisionID, BatchID = BatchId });

        Lines = new List<JournalLine>();
        int seq = 1;
        foreach (DataRow r in dt.Rows)
        {
            var line = new JournalLine
            {
                Sequence = seq++,
                Job = r["Job"]?.ToString() ?? "",
                JobDesc = r["JobDesc"]?.ToString() ?? "",
                Extra = r["Extra"]?.ToString() ?? "",
                ExtraDesc = r["ExtraDesc"]?.ToString() ?? "",
                CostCode = r["CostCode"]?.ToString() ?? "",
                CostCodeDesc = r["CostCodeDesc"]?.ToString() ?? "",
                Category = r["Category"]?.ToString() ?? "",
                CategoryDesc = r["CategoryDesc"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? "",
                Account = r["Account"]?.ToString() ?? "",
                AccountDesc = r["AccountDesc"]?.ToString() ?? "",
                Debit = ToDecimal(r["DebitAmount"]),
                Credit = ToDecimal(r["CreditAmount"]),
                RowState = "CLEAN"
            };
            Lines.Add(line);
        }
        EnsureBlankRow();
        ReindexSequence();
        ValidateData();
        mDirty = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> SaveDataAsync(bool prompt)
    {
        if (!mDirty) return true;

        if (!ValidateData())
        {
            if (!prompt)
            {
                Notifications.Success("This data is incomplete and cannot be saved.");
                return false;
            }
            var ok = await Dialogs.ConfirmAsync(
                "This data is incomplete and cannot be saved.\n\nYour changes will be lost.");
            return ok;
        }

        if (prompt)
        {
            var res = await Dialogs.ConfirmAsync(
                "This data has changed.\n\nDo you want to save these changes?");
            if (!res) return true;
        }

        await db.ExecuteAsync(@"
            update journalentries
               set Description=@Description,
                   BatchType=@BatchType,
                   AccountingDate=@AccountingDate,
                   Comments=@Comments
             where BatchID=@BatchID",
            new
            {
                Description = BatchDescription,
                BatchType,
                AccountingDate = AccountingDateValue,
                Comments,
                BatchID = BatchId
            });

        await db.ExecuteAsync("delete from journalentrylines where batchid=@BatchID", new { BatchID = BatchId });

        foreach (var line in Lines.Where(l => !l.IsEmpty))
        {
            await db.ExecuteAsync(@"
                insert into journalentrylines
                    (DivisionID,BatchID,Description,Job,Extra,CostCode,Category,Account,DebitAmount,CreditAmount)
                values
                    (@DivisionID,@BatchID,@Description,@Job,@Extra,@CostCode,@Category,@Account,@Debit,@Credit)",
                new
                {
                    SessionState.DivisionID,
                    BatchID = BatchId,
                    Description = line.Description ?? "",
                    Job = line.Job ?? "",
                    Extra = line.Extra ?? "",
                    CostCode = line.CostCode ?? "",
                    Category = line.Category ?? "",
                    Account = line.Account ?? "",
                    Debit = line.Debit,
                    Credit = line.Credit
                });
        }

        mDirty = false;
        return true;
    }

    private bool ValidateData()
    {
        var sMissing = string.IsNullOrWhiteSpace(BatchType);
        var dMissing = AccountingDateValue == null;

        TotalDebit = 0;
        TotalCredit = 0;
        bool rowMissingAmount = false;
        bool rowMissingAccount = false;

        foreach (var line in Lines.Where(l => !l.IsEmpty))
        {
            TotalDebit += Math.Round(line.Debit, 2);
            TotalCredit += Math.Round(line.Credit, 2);

            if (line.Debit == 0 && line.Credit == 0) rowMissingAmount = true;
            if (string.IsNullOrWhiteSpace(line.Account)) rowMissingAccount = true;
        }

        IsValid = Math.Round(TotalDebit, 2) == Math.Round(TotalCredit, 2)
            && TotalDebit != 0
            && !rowMissingAmount
            && !rowMissingAccount
            && !sMissing
            && !dMissing;

        StateHasChanged();
        return IsValid;
    }

    private async Task OnCellSaved(CellSaveArgs<JournalLine> args)
    {
        if (args.Data == null) return;
        var row = args.Data;
        var col = args.ColumnName ?? "";

        switch (col)
        {
            case nameof(JournalLine.Job):
                await ValidateJobAsync(row);
                break;
            case nameof(JournalLine.Extra):
                await ValidateExtraAsync(row);
                break;
            case nameof(JournalLine.CostCode):
                await ValidateCostCodeAsync(row);
                break;
            case nameof(JournalLine.Category):
                await ValidateCategoryAsync(row);
                break;
            case nameof(JournalLine.Account):
                await ValidateAccountAsync(row);
                break;
            case nameof(JournalLine.Debit):
                if (row.Debit != 0) row.Credit = 0;
                break;
            case nameof(JournalLine.Credit):
                if (row.Credit != 0) row.Debit = 0;
                break;
        }

        row.RowState = row.RowState == "NEW" ? "NEW" : "DIRTY";
        mDirty = true;
        EnsureBlankRow();
        ReindexSequence();
        ValidateData();
    }

    private async Task ValidateJobAsync(JournalLine row)
    {
        if (string.IsNullOrWhiteSpace(row.Job))
        {
            row.Job = row.JobDesc = row.Extra = row.ExtraDesc = row.CostCode = row.CostCodeDesc = row.Category = row.CategoryDesc = "";
            return;
        }
        var dt = db.SqlExec("select job_no,description from tbljobs where DivisionID =@DivisionID and job_no=@Job",
            new { SessionState.DivisionID, Job = row.Job });
        if (dt.Rows.Count == 0)
        {
            Notifications.Info("Job not found.");
            row.Job = "";
            row.JobDesc = "";
            return;
        }
        row.Job = dt.Rows[0]["job_no"]?.ToString() ?? row.Job;
        row.JobDesc = dt.Rows[0]["description"]?.ToString() ?? "";
        row.Extra = row.ExtraDesc = row.CostCode = row.CostCodeDesc = row.Category = row.CategoryDesc = "";
    }

    private async Task ValidateExtraAsync(JournalLine row)
    {
        if (string.IsNullOrWhiteSpace(row.Extra))
        {
            row.Extra = row.ExtraDesc = row.CostCode = row.CostCodeDesc = row.Category = row.CategoryDesc = "";
            return;
        }
        var dt = db.SqlExec("select extra,description from jobextras where DivisionID =@DivisionID and job=@Job and extra=@Extra",
            new { SessionState.DivisionID, Job = row.Job ?? "", Extra = row.Extra ?? "" });
        if (dt.Rows.Count == 0)
        {
            Notifications.Info("Extra not found.");
            row.Extra = "";
            row.ExtraDesc = "";
            return;
        }
        row.ExtraDesc = dt.Rows[0]["description"]?.ToString() ?? "";
        row.CostCode = row.CostCodeDesc = row.Category = row.CategoryDesc = "";
    }

    private async Task ValidateCostCodeAsync(JournalLine row)
    {
        if (string.IsNullOrWhiteSpace(row.CostCode))
        {
            row.CostCode = row.CostCodeDesc = row.Category = row.CategoryDesc = "";
            return;
        }
        var dt = db.SqlExec("select costcode,description,debitaccount from standardcostcodes where DivisionID =@DivisionID and costcode=@CostCode",
            new { SessionState.DivisionID, CostCode = row.CostCode ?? "" });
        if (dt.Rows.Count == 0)
        {
            Notifications.Info("Cost code not found.");
            row.CostCode = "";
            row.CostCodeDesc = "";
            return;
        }
        row.CostCode = dt.Rows[0]["costcode"]?.ToString() ?? row.CostCode;
        row.CostCodeDesc = dt.Rows[0]["description"]?.ToString() ?? "";
        var acct = dt.Rows[0]["debitaccount"]?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(acct))
        {
            row.Account = acct;
            await ValidateAccountAsync(row);
        }
        row.Category = row.CategoryDesc = "";
    }

    private async Task ValidateCategoryAsync(JournalLine row)
    {
        if (string.IsNullOrWhiteSpace(row.Category))
        {
            row.Category = row.CategoryDesc = "";
            return;
        }
        var dt = db.SqlExec("select category,description from standardcategories where DivisionID =@DivisionID and category=@Category",
            new { SessionState.DivisionID, Category = row.Category ?? "" });
        if (dt.Rows.Count == 0)
        {
            Notifications.Info("Category not found.");
            row.Category = "";
            row.CategoryDesc = "";
            return;
        }
        row.CategoryDesc = dt.Rows[0]["description"]?.ToString() ?? "";
    }

    private async Task ValidateAccountAsync(JournalLine row)
    {
        if (string.IsNullOrWhiteSpace(row.Account))
        {
            row.Account = row.AccountDesc = "";
            return;
        }
        var dt = db.SqlExec("select account,description from glaccounts where DivisionID =@DivisionID and account=@Account",
            new { SessionState.DivisionID, Account = row.Account ?? "" });
        if (dt.Rows.Count == 0)
        {
            Notifications.Info("Account not found.");
            row.Account = "";
            row.AccountDesc = "";
            return;
        }
        row.AccountDesc = dt.Rows[0]["description"]?.ToString() ?? "";
    }

    // VB6 gData_StartEdit: when editing the last (blank) row, copy Job/Extra/CostCode/Category/Account from previous row
    private void EnsureBlankRow()
    {
        if (Lines.Count == 0 || !Lines.Last().IsEmpty)
        {
            var newLine = new JournalLine { RowState = "NEW" };
            if (Lines.Count > 0)
            {
                var prev = Lines.Last(l => !l.IsEmpty || l == Lines.Last());
                if (prev != null && !prev.IsEmpty)
                {
                    newLine.Job = prev.Job;
                    newLine.JobDesc = prev.JobDesc;
                    newLine.Extra = prev.Extra;
                    newLine.ExtraDesc = prev.ExtraDesc;
                    newLine.CostCode = prev.CostCode;
                    newLine.CostCodeDesc = prev.CostCodeDesc;
                    newLine.Category = prev.Category;
                    newLine.CategoryDesc = prev.CategoryDesc;
                    newLine.Account = prev.Account;
                    newLine.AccountDesc = prev.AccountDesc;
                }
            }
            Lines.Add(newLine);
        }
    }

    private void ReindexSequence()
    {
        int seq = 1;
        foreach (var l in Lines)
            l.Sequence = seq++;
    }

    private void SetLocked(bool value)
    {
        mLocked = value;
        editSettings.AllowEditing = !mLocked;
        editSettings.AllowAdding = !mLocked;
        editSettings.AllowDeleting = !mLocked;
    }

    private void MarkDirty() { mDirty = true; ValidateData(); }

    private void OnBatchTypeChanged() { mDirty = true; ValidateData(); }

    private void OnDateChanged() { mDirty = true; ValidateData(); }

    private async Task OnNewClick()
    {
        if (!await SaveDataAsync(true)) return;
        await LoadDataAsync(0, true);
    }

    private async Task OnOpenClick()
    {
        if (!await SaveDataAsync(true)) return;
        OpenDialogTab = "open";
        await LoadOpenBatchesAsync();
        ShowOpenDialog = true;
    }

    private async Task OnOpenBatchesTab()
    {
        OpenDialogTab = "open";
        await LoadOpenBatchesAsync();
    }

    private async Task OnPostedBatchesTab()
    {
        OpenDialogTab = "posted";
        await LoadPostedBatchesAsync();
    }

    private async Task LoadOpenBatchesAsync()
    {
        try
        {
            var dt = db.SqlExec("select BatchID,Description,BatchType,AccountingDate from journalentries where isnull(postingbatchid,0)=0 order by BatchID");
            OpenBatchList = dt.AsEnumerable().Select(r => new BatchListItem
            {
                Id = Convert.ToInt64(r["BatchID"]),
                Description = r["Description"]?.ToString() ?? "",
                Type = r["BatchType"]?.ToString() ?? "",
                AccountingDate = FormatDate(r["AccountingDate"]),
                PostingDate = ""
            }).ToList();
        }
        catch (Exception ex) { Logger.LogWarning(ex, "LoadOpenBatches"); OpenBatchList.Clear(); }
        StateHasChanged();
    }

    private async Task LoadPostedBatchesAsync()
    {
        try
        {
            var dt = db.SqlExec("select BatchID,Description,BatchType,AccountingDate,PostingDate from journalentries where postingbatchid<>0 order by BatchID");
            OpenBatchList = dt.AsEnumerable().Select(r => new BatchListItem
            {
                Id = Convert.ToInt64(r["BatchID"]),
                Description = r["Description"]?.ToString() ?? "",
                Type = r["BatchType"]?.ToString() ?? "",
                AccountingDate = FormatDate(r["AccountingDate"]),
                PostingDate = FormatDate(r["PostingDate"])
            }).ToList();
        }
        catch (Exception ex) { Logger.LogWarning(ex, "LoadPostedBatches"); OpenBatchList.Clear(); }
        StateHasChanged();
    }

    private async Task OnBatchSelected(long batchId)
    {
        ShowOpenDialog = false;
        await LoadDataAsync(batchId, true);
    }

    private async Task OnSaveClick() => await SaveDataAsync(false);

    private async Task OnSaveAsClick()
    {
        await db.ExecuteAsync("insert into journalentries(Description,AccountingDate) values('new batch',convert(date,getdate()))");
        BatchId = await db.ExecuteScalarAsync<long>("select cast(scope_identity() as bigint)");
        BatchNumber = BatchId.ToString();
        mDirty = true;
        await SaveDataAsync(false);
        PostedDate = "";
        SetLocked(false);
        ValidateData();
    }

    private async Task OnDeleteClick()
    {
        if (mLocked) return;
        var ok = await Dialogs.ConfirmAsync("Are you sure you want to delete this batch?");
        if (!ok) return;
        await db.ExecuteAsync("delete from journalentrylines where batchid=@BatchID", new { BatchID = BatchId });
        await db.ExecuteAsync("delete from journalentries where batchid=@BatchID", new { BatchID = BatchId });
        await LoadDataAsync(0, false);
    }

    private async Task OnPostClick()
    {
        if (!await SaveDataAsync(false)) return;
        await db.ExecuteAsync("update journalentries set postingdate=getdate(),postingbatchid=batchid where batchid=@BatchID",
            new { BatchID = BatchId });
        await LoadDataAsync(0, true);
    }

    private async Task OnAttachmentsClick()
    {
        // VB6: FDocuments.ShowForm("File Attachments - " & txtDescription.Text, "JE~" & lblBatchNumber.Caption, "Documents")
        // Navigate to the documents/attachments page with the batch context
        if (BatchId > 0)
        {
            NavigationManager.NavigateTo($"/documents?source=JE~{BatchId}&title=File Attachments - {Uri.EscapeDataString(BatchDescription)}");
        }
    }

    private static int ToInt(object? val) =>
        val == null || val == DBNull.Value ? 0 : Convert.ToInt32(val);

    private static decimal ToDecimal(object? val) =>
        val == null || val == DBNull.Value ? 0 : Convert.ToDecimal(val);

    private static DateTime? ToDate(object? val) =>
        val == null || val == DBNull.Value ? null : Convert.ToDateTime(val);

    private static string FormatDate(object? val) =>
        val == null || val == DBNull.Value ? "" : Convert.ToDateTime(val).ToString("MM/dd/yyyy");

    // ── Load Grid Layout ──────────────────────────────────────
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            await _g.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");

        }
    }

    // ── Grid Layout Helpers (delegated to the shared GridLayoutPresenter) ──
    // JournalLine is int/string/decimal only (its bool IsEmpty is a computed
    // helper, never a layout column), so the presenter's ColumnTypeFor
    // (bool→Boolean, +Date/byte/short/float) is behaviour-identical to the former
    // local helper (int/decimal→Number, string→Text). The DebitAmount/CreditAmount/
    // LineDescription aliases moved to the presenter ctor. Full delegation is exact.
    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedGridLayout()
        => _g.GetOrdered();

    // Form-specific glue (no FAssembly analogue): VB6 gData_BeforeEdit cancels
    // editing on the read-only description/sequence columns.
    private static bool IsFieldEditable(string field)
    {
        return field switch
        {
            "Sequence" or "JobDesc" or "ExtraDesc" or "CostCodeDesc" or "CategoryDesc" or "AccountDesc" or "RowState" => false,
            _ => true
        };
    }

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    public class BatchListItem
    {
        public long Id { get; set; }
        public string Description { get; set; } = "";
        public string Type { get; set; } = "";
        public string AccountingDate { get; set; } = "";
        public string PostingDate { get; set; } = "";
    }

    public class JournalLine
    {
        public int Sequence { get; set; }
        public string Job { get; set; } = "";
        public string JobDesc { get; set; } = "";
        public string Extra { get; set; } = "";
        public string ExtraDesc { get; set; } = "";
        public string CostCode { get; set; } = "";
        public string CostCodeDesc { get; set; } = "";
        public string Category { get; set; } = "";
        public string CategoryDesc { get; set; } = "";
        public string Description { get; set; } = "";
        public string Account { get; set; } = "";
        public string AccountDesc { get; set; } = "";
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public string RowState { get; set; } = "CLEAN";

        public bool IsEmpty =>
            string.IsNullOrWhiteSpace(Job) &&
            string.IsNullOrWhiteSpace(Extra) &&
            string.IsNullOrWhiteSpace(CostCode) &&
            string.IsNullOrWhiteSpace(Category) &&
            string.IsNullOrWhiteSpace(Description) &&
            string.IsNullOrWhiteSpace(Account) &&
            Debit == 0 &&
            Credit == 0;
    }
}
