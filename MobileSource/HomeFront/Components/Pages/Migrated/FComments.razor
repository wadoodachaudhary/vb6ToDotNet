@namespace HomeFront.Components.Pages
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Microsoft.AspNetCore.Components.Web

<DialogControl Visible="@Visible"
          Header="@Title"
          Width="520px"
          Height="320px"
          IsModal="true"
          ShowCloseIcon="true"
          CloseOnEscape="false"
          OnClose="HandleCancel">
    <ChildContent>
        <div class="fcomments-body" tabindex="0" @onkeydown="HandleKeyDown">
            @* VB6 FComments.frm Text1 is the form's only control (TabIndex 0), so the caret
               lands in it on show. AutoFocus also switches TextBoxControl off its
               <InputTextArea> branch onto one that stops keydown propagation, hence the
               explicit @onkeydown here as well as on the wrapper. *@
            <TextBoxControl @bind-Value="EditText"
                       @bind-Value:after="OnTextChanged"
                       Multiline="true"
                       Rows="10"
                       CssClass="fcomments-textbox"
                       Enabled="@Editable"
                       AutoFocus="true"
                       MaxLength="@EffectiveMaxLength"
                       HtmlAttributes="@TextBoxAttributes"
                       @onkeydown="HandleKeyDown" />
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="HandleSave">OK</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="HandleCancel">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public bool Editable { get; set; } = true;
    [Parameter] public string Title { get; set; } = "Comments";
    [Parameter] public int? MaxLength { get; set; }

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string EditText { get; set; } = "";
    private string _originalValue = "";
    private bool _wasVisible;

    private int? EffectiveMaxLength => MaxLength.HasValue && MaxLength.Value > 0 ? MaxLength : null;

    private Dictionary<string, object> TextBoxAttributes
    {
        get
        {
            var attrs = new Dictionary<string, object>();
            if (Editable)
            {
                attrs["title"] = "(Ctrl + Enter) to save -- (Esc) to cancel";
            }
            return attrs;
        }
    }

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            _originalValue = Value ?? "";
            EditText = NormalizeLineEndings(_originalValue);
        }
        _wasVisible = Visible;
    }

    private void OnTextChanged()
    {
        // Mirror VB6 Text1_Change
    }

    private async Task HandleSave()
    {
        var normalized = NormalizeLineEndings(EditText);
        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(normalized);

        if (OnSave.HasDelegate)
            await OnSave.InvokeAsync();

        await CloseAsync();
    }

    private async Task HandleCancel()
    {
        EditText = NormalizeLineEndings(_originalValue);

        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();

        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (VisibleChanged.HasDelegate)
            await VisibleChanged.InvokeAsync(false);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _ = HandleCancel();
        }
        else if (e.Key == "Enter" && e.CtrlKey)
        {
            _ = HandleSave();
        }
    }

    private static string NormalizeLineEndings(string? value)
    {
        if (string.IsNullOrEmpty(value))
            return "";

        var s = value.Replace("\n", "\r");
        s = s.Replace("\r\r", "\r");
        return s.Replace("\r", "\r\n");
    }
}