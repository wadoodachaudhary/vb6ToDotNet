@page "/system-settings"
@rendermode InteractiveServer

@using HomeFront.Data
@using System.Data

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>System Settings - HomeFront</PageTitle>

<style>
    .settings-container { display: flex; height: calc(100vh - 80px); font-family: 'MS Sans Serif', Arial, sans-serif; font-size: 13px; }
    .toc-panel { width: 200px; min-width: 180px; border-right: 2px solid #ccc; overflow-y: auto; background: #f8f9fa; }
    .toc-item { padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #e0e0e0; user-select: none; }
    .toc-item:hover { background: #e8f0fe; }
    .toc-item.selected { background: #cce5ff; font-weight: 700; }
    .content-panel { flex: 1; overflow-y: auto; padding: 16px; background: #fff; }
    .section-title { font-weight: 700; color: #800080; font-size: 13px; margin-bottom: 4px; }
    .section-divider { border-top: 1px solid #808080; border-bottom: 1px solid #fff; margin: 4px 40px 12px 0; }
    .field-row { display: flex; align-items: center; margin-bottom: 6px; gap: 8px; }
    .field-label { min-width: 160px; text-align: right; font-size: 12px; color: #333; }
    .field-label-sm { min-width: 120px; text-align: right; font-size: 12px; color: #333; }
    .field-input { padding: 3px 6px; border: 1px solid #ced4da; border-radius: 3px; font-size: 12px; }
    .field-input-wide { width: 280px; }
    .field-input-med { width: 180px; }
    .field-input-sm { width: 100px; }
    .field-input-xs { width: 60px; }
    .field-select { padding: 3px 6px; border: 1px solid #ced4da; border-radius: 3px; font-size: 12px; background: #fff; }
    .field-checkbox { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; font-size: 12px; }
    .field-checkbox input[type="checkbox"] { width: 14px; height: 14px; }
    .field-radio { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; font-size: 12px; }
    .field-radio input[type="radio"] { width: 14px; height: 14px; }
    .frame-box { border: 1px solid #999; border-radius: 4px; padding: 12px; margin-bottom: 12px; background: #fafafa; }
    .frame-title { font-weight: 600; font-size: 12px; margin-bottom: 8px; color: #333; }
    .frame-icon { width: 32px; height: 32px; margin-right: 8px; }
    .link-label { color: #800080; text-decoration: underline; cursor: pointer; font-size: 12px; }
    .link-label:hover { color: #4B0082; }
    .btn-nav { padding: 6px 24px; border: 1px solid #999; border-radius: 4px; background: #f0f0f0; cursor: pointer; font-size: 13px; }
    .btn-nav:hover { background: #e0e0e0; }
    .btn-action { padding: 4px 16px; border: 1px solid #999; border-radius: 3px; background: #f0f0f0; cursor: pointer; font-size: 12px; }
    .btn-action:hover { background: #e0e0e0; }
    .footer-bar { display: flex; justify-content: flex-end; gap: 8px; padding: 10px 16px; border-top: 2px solid #800080; background: #f8f9fa; }
    .grid-simple { width: 100%; border-collapse: collapse; font-size: 12px; }
    .grid-simple th { background: #e0e0e0; border: 1px solid #ccc; padding: 4px 8px; text-align: left; font-weight: 600; }
    .grid-simple td { border: 1px solid #ccc; padding: 4px 8px; }
    .grid-simple input { width: 100%; border: none; background: transparent; font-size: 12px; padding: 2px; }
    .textarea-field { width: 100%; min-height: 80px; border: 1px solid #ced4da; border-radius: 3px; font-size: 12px; padding: 4px; resize: vertical; }
    .subsection { margin-left: 20px; margin-bottom: 8px; }
    .po-sample { background: #f0f0f0; border: 1px solid #ccc; padding: 4px 12px; text-align: center; font-size: 12px; margin-top: 4px; }
    .accounting-frame { display: flex; gap: 12px; align-items: flex-start; }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .tab-frame { display: none; }
    .tab-frame.active { display: block; }
</style>

<div class="settings-container">
    <!-- Table of Contents -->
    <div class="toc-panel">
        @foreach (var tab in TabItems.OrderBy(t => t.Caption))
        {
            var tocClass = SelectedTab == tab.Index ? "toc-item selected" : "toc-item";
            <div class="@tocClass" @onclick="() => SelectTab(tab.Index)">
                @tab.Caption
            </div>
        }
    </div>

    <!-- Content Panel -->
    <div class="content-panel">

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Accounting Integration *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 4)
        {
            <div class="section-title">Accounting System</div>
            <div class="section-divider"></div>

            <div class="field-row">
                <span class="field-label">System</span>
                <select class="field-select field-input-wide" @bind="AccountingSystemIndex" @bind:after="OnAccountingSystemChanged">
                    <option value="0">No accounting integration</option>
                    <option value="1">Sage 300 Construction and Real Estate</option>
                    <option value="2">Sage 100 Contractor</option>
                    <option value="3">Sage 50 Accounting</option>
                    <option value="9">Sage Intacct</option>
                    <option value="5">QuickBooks</option>
                    <option value="10">Quickbooks Online</option>
                    <option value="7">Xero</option>
                </select>
            </div>

            <div class="field-row">
                <span class="field-label">Book of Account</span>
                <select class="field-select field-input-med" @bind="BookOfAccount">
                    @foreach (var boa in BookOfAccountList)
                    {
                        <option value="@boa">@boa</option>
                    }
                </select>
                <span class="link-label" @onclick="OnEditBookOfAccounts">Wallet Configuration</span>
            </div>

            @* Sage 300 CRE *@
            @if (AccountingSystemIndex == 1)
            {
                <div class="frame-box">
                    <div class="frame-title">Sage 300 Construction and Real Estate</div>
                    <div class="accounting-frame">
                        <div>
                            <div class="field-row"><span class="field-label-sm">Data Folder</span><input class="field-input field-input-wide" @bind="TLFolder" /></div>
                            <div class="field-row"><span class="field-label-sm">AR Data Folder</span><input class="field-input field-input-wide" @bind="TLARFolder" /></div>
                            <div class="field-row"><span class="field-label-sm">Security Context</span><input class="field-input field-input-med" @bind="TLUser" /></div>
                            <div class="field-row"><span class="field-label-sm">Password</span><input type="password" class="field-input field-input-med" @bind="TLPswd" /></div>
                        </div>
                    </div>
                </div>
            }

            @* Sage 100 Contractor *@
            @if (AccountingSystemIndex == 2)
            {
                <div class="frame-box">
                    <div class="frame-title">Sage 100 Contractor</div>
                    <div class="field-row">
                        <span class="field-label-sm">API Level</span>
                        <select class="field-select field-input-xs" @bind="MBAPILevel" @bind:after="OnMBAPILevelChanged">
                            <option value="v18">v18</option>
                            <option value="v19">v19</option>
                            <option value="v20">v20</option>
                        </select>
                    </div>
                    @if (MBAPILevel == "v20")
                    {
                        <div class="field-row"><span class="field-label-sm">Instance</span><input class="field-input field-input-wide" @bind="MBInstance" /></div>
                    }
                    else
                    {
                        <div class="field-row">
                            <span class="field-label-sm">Drive</span>
                            <select class="field-select field-input-sm" @bind="MBDrive">
                                @foreach (var d in DriveList)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="field-row"><span class="field-label-sm">Company</span><input class="field-input field-input-wide" @bind="MBCompany" /></div>
                    <div class="field-row"><span class="field-label-sm">Security Context</span><input class="field-input field-input-med" @bind="MBUser" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><input type="password" class="field-input field-input-med" @bind="MBPswd" /></div>
                    <div class="field-checkbox"><input type="checkbox" @bind="MBUseSubAcct" /><label>Use Job as Sub Account</label></div>
                </div>
            }

            @* Sage 50 Accounting *@
            @if (AccountingSystemIndex == 3)
            {
                <div class="frame-box">
                    <div class="frame-title">Sage 50 Accounting</div>
                    <div class="field-row"><span class="field-label-sm">Company File</span><input class="field-input field-input-wide" @bind="SimplyFile" /></div>
                    <div class="field-row"><span class="field-label-sm">Security Context</span><input class="field-input field-input-med" @bind="SimplyUser" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><input type="password" class="field-input field-input-med" @bind="SimplyPswd" /></div>
                    <div class="field-row">
                        <span class="field-label-sm">Internal Customer</span>
                        <select class="field-select field-input-med" @bind="SimplyInternalCustomer">
                            @foreach (var c in SimplyInternalCustomerList)
                            {
                                <option value="@c.Value">@c.Text</option>
                            }
                        </select>
                    </div>
                </div>
            }

            @* QuickBooks *@
            @if (AccountingSystemIndex == 5)
            {
                <div class="frame-box">
                    <div class="frame-title">QuickBooks</div>
                    <div class="field-row"><span class="field-label-sm">Company File</span><input class="field-input field-input-wide" @bind="QuickBooksFile" /></div>
                    <div class="field-row">
                        <span class="field-label-sm">Edition</span>
                        <select class="field-select field-input-xs" @bind="QuickBooksVersion">
                            <option value="US">US</option>
                            <option value="CA">CA</option>
                        </select>
                    </div>
                    <div class="field-row"><span class="field-label-sm">Job Creation</span></div>
                    <div class="subsection">
                        <div class="field-radio"><input type="radio" name="qbJobStyle" checked='@(QBJobStyle == "Simple")' @onchange='() => QBJobStyle = "Simple"' /><label>Simple - create the customer record only</label></div>
                        <div class="field-radio"><input type="radio" name="qbJobStyle" checked='@(QBJobStyle == "Heirarchical")' @onchange='() => QBJobStyle = "Heirarchical"' /><label>Hierarchical - create customer records and sub jobs</label></div>
                    </div>
                    <div class="field-checkbox"><input type="checkbox" @bind="QBPostRevenueToJob" /><label>Post revenue to job</label></div>
                </div>
            }

            @* QuickBooks Online *@
            @if (AccountingSystemIndex == 10)
            {
                <div class="frame-box">
                    <div class="frame-title">Quickbooks Online</div>
                    <div class="field-row">
                        <span class="field-label-sm">Edition</span>
                        <select class="field-select field-input-xs" @bind="QBOVersion">
                            <option value="US">US</option>
                        </select>
                    </div>
                    <div class="field-row"><span class="field-label-sm">Job Creation</span></div>
                    <div class="subsection">
                        <div class="field-radio"><input type="radio" name="qboJobStyle" checked='@(QBOJobStyle == "Simple")' @onchange='() => QBOJobStyle = "Simple"' /><label>Simple - create the customer record only</label></div>
                        <div class="field-radio"><input type="radio" name="qboJobStyle" checked='@(QBOJobStyle == "Heirarchical")' @onchange='() => QBOJobStyle = "Heirarchical"' /><label>Hierarchical - create customer records and sub jobs</label></div>
                    </div>
                </div>
            }

            @* Sage Intacct *@
            @if (AccountingSystemIndex == 9)
            {
                <div class="frame-box">
                    <div class="frame-title">Sage Intacct</div>
                    <div class="field-row"><span class="field-label-sm">Company ID</span><input class="field-input field-input-wide" @bind="IntacctCompanyID" /></div>
                    <div class="field-row"><span class="field-label-sm">User ID</span><input class="field-input field-input-med" @bind="IntacctUID" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><input type="password" class="field-input field-input-med" @bind="IntacctPWD" /></div>
                    <div class="field-row">
                        <span class="field-label-sm">Entity</span>
                        <select class="field-select field-input-med" @bind="IntacctEntity">
                            @foreach (var e in IntacctEntityList)
                            {
                                <option value="@e">@e</option>
                            }
                        </select>
                    </div>
                    <div class="field-row"><span class="field-label-sm">One Time ItemID</span>
                        <select class="field-select field-input-med" @bind="IntacctOneTimeItemID">
                            @foreach (var i in IntacctItemList) { <option value="@i">@i</option> }
                        </select>
                    </div>
                    <div class="field-row"><span class="field-label-sm">GST ItemID</span>
                        <select class="field-select field-input-med" @bind="IntacctGstItemID">
                            @foreach (var i in IntacctItemList) { <option value="@i">@i</option> }
                        </select>
                    </div>
                    <div class="field-row"><span class="field-label-sm">Budget GL</span><input class="field-input field-input-med" @bind="IntacctBudgetGL" /></div>
                    <div class="field-row"><span class="field-label-sm">PO Reference Fld</span>
                        <select class="field-select field-input-med" @bind="IntacctPOReferenceFld">
                            <option value="Job Number">Job Number</option>
                            <option value="PO Number">PO Number</option>
                        </select>
                    </div>
                    <div class="field-row"><span class="field-label-sm">Inv Reference Fld</span>
                        <select class="field-select field-input-med" @bind="IntacctInvReferenceFld">
                            <option value="Job Number">Job Number</option>
                            <option value="Job Description">Job Description</option>
                            <option value="Invoice Description">Invoice Description</option>
                            <option value="PO Number">PO Number</option>
                        </select>
                    </div>
                    <div style="margin-top:8px;">
                        <span style="color:#800080; font-size:12px;">Transaction Types</span>
                        <div class="field-row"><span class="field-label-sm">PO</span>
                            <select class="field-select field-input-med" @bind="IntacctPOType">
                                @foreach (var t in IntacctTranTypeList) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div class="field-row"><span class="field-label-sm">PO CO</span>
                            <select class="field-select field-input-med" @bind="IntacctPOCOType">
                                @foreach (var t in IntacctTranTypeList) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div class="field-row"><span class="field-label-sm">Contract</span>
                            <select class="field-select field-input-med" @bind="IntacctSubContractType">
                                @foreach (var t in IntacctTranTypeList) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div class="field-row"><span class="field-label-sm">Contract CO</span>
                            <select class="field-select field-input-med" @bind="IntacctSubContractCOType">
                                @foreach (var t in IntacctTranTypeList) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div class="field-row"><span class="field-label-sm">Invoice</span>
                            <select class="field-select field-input-med" @bind="IntacctInvoiceType">
                                @foreach (var t in IntacctTranTypeList) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div class="field-row"><span class="field-label-sm">Estimate</span>
                            <select class="field-select field-input-med" @bind="IntacctEstimateType">
                                @foreach (var t in IntacctEstimateTypeList) { <option value="@t">@t</option> }
                            </select>
                        </div>
                    </div>
                </div>
            }

            @* PO Numbering *@
            <div class="two-col" style="margin-top:16px;">
                <div>
                    <div class="section-title">PO Numbering</div>
                    <div class="section-divider"></div>
                    <div class="field-radio"><input type="radio" name="poStyle" checked='@(PONumberingStyle == "Job")' @onchange='() => { PONumberingStyle = "Job"; UpdatePOSample(); }' /><label>Use job specific numbering.</label></div>
                    @if (PONumberingStyle == "Job")
                    {
                        <div class="field-row" style="margin-left:20px;">
                            <span class="field-label-sm">Format</span>
                            <input class="field-input field-input-xs" @bind="POSegment1" readonly />
                            <input class="field-input" style="width:30px;" @bind="POSegment2" @bind:after="UpdatePOSample" />
                            <input class="field-input field-input-xs" @bind="POSegment3" @bind:after="UpdatePOSample" />
                        </div>
                    }
                    <div class="field-radio"><input type="radio" name="poStyle" checked='@(PONumberingStyle == "JobPOIndex")' @onchange='() => { PONumberingStyle = "JobPOIndex"; UpdatePOSample(); }' /><label>Use job and PO specific numbering.</label></div>
                    @if (PONumberingStyle == "JobPOIndex")
                    {
                        <div class="field-row" style="margin-left:20px;">
                            <span class="field-label-sm">Format</span>
                            <input class="field-input field-input-xs" @bind="POSegment4" readonly />
                            <input class="field-input" style="width:30px;" @bind="POSegment5" @bind:after="UpdatePOSample" />
                            <input class="field-input field-input-xs" @bind="POSegment6" @bind:after="UpdatePOSample" />
                            <input class="field-input" style="width:30px;" @bind="POSegment7" @bind:after="UpdatePOSample" />
                            <input class="field-input field-input-xs" @bind="POSegment8" @bind:after="UpdatePOSample" />
                        </div>
                    }
                    <div class="field-radio"><input type="radio" name="poStyle" checked='@(PONumberingStyle == "Sequential")' @onchange='() => { PONumberingStyle = "Sequential"; UpdatePOSample(); }' /><label>Use sequential numbering</label></div>
                    @if (PONumberingStyle == "Sequential")
                    {
                        <div class="field-row" style="margin-left:20px;">
                            <span class="field-label-sm">Next Num</span>
                            <input class="field-input field-input-sm" @bind="NextPO" readonly />
                            <button class="btn-action" @onclick="OnChangeNextPO">Change</button>
                        </div>
                        <div class="field-row" style="margin-left:20px;">
                            <span class="field-label-sm">Prefix</span>
                            <input class="field-input field-input-xs" @bind="POPrefix" maxlength="4" @bind:after="UpdatePOSample" />
                        </div>
                    }
                    <div class="field-row" style="margin-left:20px;">
                        <span class="field-label-sm">Sample</span>
                        <div class="po-sample">@PONumberSample</div>
                    </div>
                </div>

                <div>
                    <div class="section-title">Cost Codes &amp; Taxes</div>
                    <div class="section-divider"></div>
                    @for (int i = 0; i < TaxGroupLabels.Length; i++)
                    {
                        var idx = i;
                        <div class="field-row">
                            <span class="field-label-sm">@TaxGroupLabels[idx]</span>
                            <select class="field-select field-input-sm" @bind="TaxGroups[idx]">
                                <option value=""></option>
                                @foreach (var tg in TaxGroupList)
                                {
                                    <option value="@tg">@tg</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="field-checkbox"><input type="checkbox" @bind="UseTaxGroups" /><label>required</label></div>
                    <div class="field-checkbox"><input type="checkbox" @bind="UseVarianceReporting" /><label>required</label></div>
                    <div style="margin-top:8px;">
                        <span class="link-label" @onclick="OnEditCostCodes">Cost codes...</span><br />
                        <span class="link-label" @onclick="OnEditCategories">Categories...</span><br />
                        <span class="link-label" @onclick="OnEditTaxGroups">Tax groups...</span>
                    </div>
                    <div class="field-row" style="margin-top:8px;">
                        <span class="field-label-sm">Default category</span>
                        <select class="field-select field-input-med" @bind="DefaultVarianceCategory">
                            @foreach (var vc in VarianceCategoryList)
                            {
                                <option value="@vc.Value">@vc.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Corporate Info *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 1)
        {
            <div class="section-title">Corporate Info</div>
            <div class="section-divider"></div>
            <div class="field-row"><span class="field-label">Company Name</span><input class="field-input field-input-wide" @bind="CompanyName" maxlength="50" /></div>
            <div class="field-row"><span class="field-label">Address</span><input class="field-input field-input-wide" @bind="CompanyAddr1" maxlength="50" /></div>
            <div class="field-row"><span class="field-label"></span><input class="field-input field-input-wide" @bind="CompanyAddr2" maxlength="50" /></div>
            <div class="field-row">
                <span class="field-label">City/Prov</span>
                <input class="field-input field-input-med" @bind="CompanyCity" maxlength="30" />
                <select class="field-select field-input-xs" @bind="CompanyProvince">
                    @foreach (var p in ProvinceList) { <option value="@p">@p</option> }
                </select>
            </div>
            <div class="field-row"><span class="field-label">Postal Code</span><input class="field-input field-input-med" @bind="CompanyPostalCode" maxlength="10" /></div>
            <div class="field-row">
                <span class="field-label">Country</span>
                <select class="field-select field-input-sm" @bind="CompanyCountry" @bind:after="OnCountryChanged">
                    @foreach (var c in CountryList) { <option value="@c">@c</option> }
                </select>
            </div>
            <div class="field-row"><span class="field-label">Contact</span><input class="field-input field-input-wide" @bind="ContactPerson" maxlength="50" /></div>
            <div class="field-row"><span class="field-label">Phone</span><input class="field-input field-input-med" @bind="CompanyPhone" maxlength="30" /></div>
            <div class="field-row"><span class="field-label">Fax</span><input class="field-input field-input-med" @bind="CompanyFax" maxlength="30" /></div>
            <div class="field-row"><span class="field-label">Email Address</span><input class="field-input field-input-wide" @bind="CompanyEmail" maxlength="150" /></div>
            <div class="field-row">
                <span class="field-label">Builder Type</span>
                <select class="field-select field-input-med" @bind="BuilderType">
                    <option value="Commercial">Commercial</option>
                    <option value="Homebuilder">Homebuilder</option>
                </select>
            </div>
            <div class="field-checkbox"><input type="checkbox" @bind="EnforcePasswordComplexity" /><label>Enforce password complexity</label></div>

            <div class="section-title" style="margin-top:16px;">Divisions</div>
            <div class="section-divider"></div>
            <table class="grid-simple">
                <thead><tr><th>Code</th><th>Company</th><th></th></tr></thead>
                <tbody>
                    @foreach (var div in Divisions)
                    {
                        <tr>
                            <td><input @bind="div.Code" maxlength="15" /></td>
                            <td><input @bind="div.Company" /></td>
                            <td><button class="btn-action" @onclick="() => OnEditDivisionCompany(div)">...</button></td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="margin-top:12px;">
                <button class="btn-action" @onclick="OnSetupUserPermissions">Setup User Permissions</button>
            </div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Purchasing Options *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 6)
        {
            <div class="section-title">Budgeting &amp; Purchasing</div>
            <div class="section-divider"></div>
            <div class="field-checkbox"><input type="checkbox" @bind="PurchasingRequiresSalesApproval" /><label>Jobs require Sales approval before purchasing can begin.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="AllowForecast" @bind:after="OnAllowForecastChanged" /><label>Let me use a forecasted cost basis to refresh PO costs.</label></div>
            <div class="field-checkbox" style="margin-left:20px;"><input type="checkbox" @bind="WarnForecast" disabled="@(!AllowForecast)" /><label>Warn me when I use a forecasted cost basis to refresh PO costs.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="CanAddContractItemsFromPurchasing" /><label>Let me add and remove contract items (model and option assemblies) on jobs.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="LetPurchaserChangeSaleQty" /><label>Let purchasers change the sale quantity.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="UseComponents" /><label>Use components in assembly definitions.</label></div>

            <div class="section-title" style="margin-top:12px;">Posting Options</div>
            <div class="section-divider"></div>
            <div class="field-checkbox"><input type="checkbox" @bind="PostPOQtyToAccounting" /><label>Post PO order quantity to accounting.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="PostSummarizedBudgets" /><label>Post budgets summarized by job, cost code and category.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="PostAssembliesAsSalesInvoices" /><label>Post Precision Builder job assemblies as AR estimates.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="PostJCExtraAsSubJob" /><label>Post JC Extra as sub job</label></div>

            <div class="section-title" style="margin-top:12px;">Vendor Rate Retrieval</div>
            <div class="section-divider"></div>
            <div class="field-checkbox"><input type="checkbox" @bind="ZeroRateOnRefreshCosts" /><label>When costs are refreshed set the item rate to zero if no value can be found.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="ZeroRateOnChangeVendor" /><label>When the vendor changes set the item rate to zero if no value can be found.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="UsePricingFromEstimating" /><label>When looking up prices don't use the item db. Use vendor pricelists only.</label></div>

            <div class="section-title" style="margin-top:12px;">Takeoff Handling</div>
            <div class="section-divider"></div>
            <div class="field-row">
                <span class="field-label">How do you want to handle zero quantity takeoff items?</span>
                <select class="field-select field-input-med" @bind="ZeroQtyTakeoffMode">
                    <option value="0">Prompt me</option>
                    <option value="1">Always skip</option>
                    <option value="2">Always add</option>
                </select>
            </div>
            <div style="margin-top:8px;">
                <span>When are the alternate cost codes and categories used?</span>
                <div class="field-radio"><input type="radio" name="altCostCodes" checked="@(!UseAltCostCodesForCO)" @onchange="() => UseAltCostCodesForCO = false" /><label>On all options</label></div>
                <div class="field-radio"><input type="radio" name="altCostCodes" checked="@UseAltCostCodesForCO" @onchange="() => UseAltCostCodesForCO = true" /><label>Only on change orders</label></div>
            </div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Estimating Options *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 2)
        {
            <div class="section-title">Estimating System</div>
            <div class="section-divider"></div>
            <div class="field-row">
                <span class="field-label">System</span>
                <select class="field-select field-input-wide" @bind="EstimatingSystemIndex">
                    <option value="0">none</option>
                    <option value="1">CG Visions BIM Pipeline</option>
                    <option value="2">Sage Estimating</option>
                </select>
            </div>

            @if (EstimatingSystemIndex == 1)
            {
                <div class="frame-box">
                    <div class="frame-title">CG Visions BIM Pipeline</div>
                    <div class="field-row"><span class="field-label-sm">Root URI</span><input class="field-input field-input-wide" @bind="CGVisionsRootURI" /></div>
                    <div class="field-row"><span class="field-label-sm">Security Context</span><input class="field-input field-input-med" @bind="CGVisionsUID" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><input type="password" class="field-input field-input-med" @bind="CGVisionsPWD" /></div>
                    <div class="field-row"><span class="field-label-sm">Base Model Number</span><input class="field-input field-input-med" @bind="BIMBaseModelNumber" /></div>
                    <div class="field-row"><span class="field-label-sm">Model Style</span></div>
                    <div class="subsection">
                        <div class="field-radio"><input type="radio" name="pipelineStyle" checked="@(!BIMCommunitySpecific)" @onchange="() => BIMCommunitySpecific = false" /><label>Global Plans and Options</label></div>
                        <div class="field-radio"><input type="radio" name="pipelineStyle" checked="@BIMCommunitySpecific" @onchange="() => BIMCommunitySpecific = true" /><label>Community specific Plans and Options</label></div>
                    </div>
                </div>
            }

            @if (EstimatingSystemIndex == 2)
            {
                <div class="frame-box">
                    <div class="frame-title">Sage Estimating</div>
                    <div class="field-row"><span class="field-label-sm">SQL Server</span><input class="field-input field-input-wide" @bind="SageSqlEstServer" /></div>
                    <div class="field-row"><span class="field-label-sm">Database</span><input class="field-input field-input-wide" @bind="SageSqlEstDatabase" /></div>
                    <div class="field-row"><span class="field-label-sm">Login/Password</span><input class="field-input field-input-med" @bind="SageSqlEstUser" /><input type="password" class="field-input field-input-sm" @bind="SageSqlEstPswd" /></div>
                    <div class="field-checkbox"><input type="checkbox" @bind="SageSqlEstConsolidateItems" /><label>Consolidate items to lump sum when importing estimates.</label></div>
                </div>
            }

            <div class="section-title" style="margin-top:12px;">Options</div>
            <div class="section-divider"></div>
            <div class="field-row"><span class="field-label">Incentive Cost%</span><input class="field-input field-input-xs" @bind="IncentiveCostPercent" /></div>
            <div class="field-row"><span class="field-label">Sales Incentives</span><input class="field-input field-input-wide" @bind="IncentiveItemDisplay" readonly /></div>
            <div class="field-row"><span class="field-label">Land Costs</span><input class="field-input field-input-wide" @bind="LandItemDisplay" readonly /></div>
            <div class="field-row"><span class="field-label">Select At Takeoff</span><input class="field-input field-input-wide" @bind="SelectAtTakeoffDisplay" readonly /></div>
            <span class="link-label" @onclick="OnEditWBSDescriptions">Edit WBS default descriptions...</span>

            <div class="section-title" style="margin-top:12px;">Takeoff System</div>
            <div class="section-divider"></div>
            <div class="field-row">
                <span class="field-label">Takeoff System</span>
                <select class="field-select field-input-med" @bind="TakeoffSystemIndex">
                    <option value="0">none</option>
                    <option value="1">On-Screen Takeoff</option>
                    <option value="2">PlanSwift</option>
                </select>
            </div>
            @if (TakeoffSystemIndex == 1)
            {
                <div class="frame-box">
                    <div class="field-radio"><input type="radio" name="osType" checked="@(!OnScreenTypeSQL)" @onchange="() => OnScreenTypeSQL = false" /><label>MS Access Database</label></div>
                    <div class="field-row"><span class="field-label-sm">File Name</span><input class="field-input field-input-wide" @bind="OnScreenMDB" /></div>
                    <div class="field-radio"><input type="radio" name="osType" checked="@OnScreenTypeSQL" @onchange="() => OnScreenTypeSQL = true" /><label>MS SQL Server Database</label></div>
                    <div class="field-row"><span class="field-label-sm">Server</span><input class="field-input field-input-wide" @bind="OnScreenServer" /></div>
                    <div class="field-row"><span class="field-label-sm">Database</span><input class="field-input field-input-wide" @bind="OnScreenDatabase" /></div>
                    <div class="field-row"><span class="field-label-sm">Login Name</span><input class="field-input field-input-med" @bind="OnScreenUID" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><input type="password" class="field-input field-input-med" @bind="OnScreenPWD" /></div>
                </div>
            }
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Sales System Integration *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 3)
        {
            <div class="section-title">Sales System</div>
            <div class="section-divider"></div>
            <div class="field-row">
                <span class="field-label">System</span>
                <select class="field-select field-input-med" @bind="SalesSystemIndex">
                    <option value="0">No sales system integration</option>
                    <option value="1">HomeFront Profit Builder</option>
                    <option value="2">Builder 1440</option>
                </select>
            </div>

            @if (SalesSystemIndex == 0)
            {
                <div style="margin-top:8px;">
                    <span class="link-label" @onclick="OnEditCommunities">Edit communities...</span><br />
                    <span class="link-label" @onclick="OnEditCommunityPhases">Edit community phases...</span><br />
                    <span class="link-label" @onclick="OnEditModelSeries">Edit model series list...</span><br />
                    <span class="link-label" @onclick="OnEditOptionGroups">Edit option groups...</span><br />
                    <span class="link-label" @onclick="OnEditOptionCategories">Edit option categories...</span>
                </div>
            }

            @if (SalesSystemIndex == 1)
            {
                <div class="frame-box">
                    <div class="frame-title">HomeFront Profit Builder / CRM</div>
                    <div class="field-row"><span class="field-label-sm">Client ID</span><input class="field-input field-input-wide" @bind="CrmClientID" /></div>
                    <div class="field-row"><span class="field-label-sm">API Key</span><input type="password" class="field-input field-input-wide" @bind="CrmApiKey" /></div>
                    <div class="field-row">
                        <span class="field-label-sm">Environment</span>
                        <select class="field-select field-input-wide" @bind="CrmEnvironment">
                            <option value="User Acceptance Testing (UAT)">User Acceptance Testing (UAT)</option>
                            <option value="Production">Production</option>
                        </select>
                    </div>
                </div>
            }

            @if (SalesSystemIndex == 2)
            {
                <div class="frame-box">
                    <div class="frame-title">Builder 1440</div>
                    <div class="field-row"><span class="field-label-sm">Builder Code</span><input class="field-input field-input-med" @bind="BuilderCode" maxlength="15" /></div>
                    <div class="field-row"><span class="field-label-sm">Administrator</span><input class="field-input field-input-med" @bind="WebAdminUser" maxlength="50" /></div>
                    <div class="field-row"><span class="field-label-sm">Ftp Upload Path</span><input class="field-input field-input-wide" @bind="WebUploadPath" /></div>
                    <div class="field-row"><span class="field-label-sm">Security Context</span><input class="field-input field-input-med" @bind="WebUploadUser" maxlength="50" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><input type="password" class="field-input field-input-med" @bind="WebUploadPswd" maxlength="50" /></div>
                    <div class="field-checkbox"><input type="checkbox" @bind="AppendUOMtoOptionDesc" /><label>Append UOM to option descriptions.</label></div>
                    <div class="field-radio"><input type="radio" name="webUpload" checked="@WebUploadByCommunity" @onchange="() => WebUploadByCommunity = true" /><label>Prompt for communities when uploading</label></div>
                    <div class="field-radio"><input type="radio" name="webUpload" checked="@(!WebUploadByCommunity)" @onchange="() => WebUploadByCommunity = false" /><label>Prompt for divisions when uploading</label></div>
                </div>
            }
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Sales Pricing Settings *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 8)
        {
            <div class="section-title">Sales Worksheets</div>
            <div class="section-divider"></div>
            <div class="field-checkbox"><input type="checkbox" @bind="AdjustSelling" /><label>Calculate selling prices when costs change.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="AdjustIncentive" /><label>Calculate incentive retail when incentive cost changes.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="LockPostedSheets" /><label>Lock worksheets when they are published.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="EstimatingWorksheetsOnly" /><label>Hide marketing worksheet interface.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="MarketingWorkSheetAutoRefreshCosts" /><label>Refresh costs when a marketing worksheet opens.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="SellingPriceIncludesTax" /><label>Selling prices include GST &amp; PST less rebates.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="UseMaxVendorPricing" /><label>Use Maximum price if no vendor price found.</label></div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Vendor Communications *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 9)
        {
            <div class="section-title">Notices</div>
            <div class="section-divider"></div>
            <div style="margin-bottom:8px;">
                @{
                    var issuedClass = NoticeTabIndex == 0 ? "btn-action btn-nav" : "btn-action";
                    var canceledClass = NoticeTabIndex == 1 ? "btn-action btn-nav" : "btn-action";
                }
                <button class="@issuedClass" @onclick="() => NoticeTabIndex = 0">PO Issued</button>
                <button class="@canceledClass" @onclick="() => NoticeTabIndex = 1">PO Canceled</button>
            </div>
            @if (NoticeTabIndex == 0)
            {
                <div class="field-row"><span class="field-label-sm">Subject</span><input class="field-input field-input-wide" @bind="MsgSendPOSubject" /></div>
                <textarea class="textarea-field" @bind="MsgSendPOBody" rows="6"></textarea>
            }
            @if (NoticeTabIndex == 1)
            {
                <div class="field-row"><span class="field-label-sm">Subject</span><input class="field-input field-input-wide" @bind="MsgCancelPOSubject" /></div>
                <textarea class="textarea-field" @bind="MsgCancelPOBody" rows="6"></textarea>
            }
            <div class="field-checkbox"><input type="checkbox" @bind="CCPrjMgr" /><label>Always CC: the project manager</label></div>
            <span class="link-label" @onclick="OnShowReplacementParameters">Replacement Parameters</span>

            <div class="section-title" style="margin-top:16px;">Email Configuration</div>
            <div class="section-divider"></div>
            <div class="field-radio"><input type="radio" name="emailProto" checked="@(EmailProtocol == 0)" @onchange="() => EmailProtocol = 0" /><label>Send using the current users Outlook account</label></div>
            <div class="field-radio"><input type="radio" name="emailProto" checked="@(EmailProtocol == 1)" @onchange="() => EmailProtocol = 1" /><label>Send using an SMTP server</label></div>
            <div class="field-radio"><input type="radio" name="emailProto" checked="@(EmailProtocol == 2)" @onchange="() => EmailProtocol = 2" /><label>Send using SMTP via Office 365</label></div>

            @if (EmailProtocol == 1)
            {
                <div class="frame-box">
                    <div class="field-row"><span class="field-label-sm">Server:Port</span><input class="field-input field-input-wide" @bind="SMTPServer" /></div>
                    <div class="field-checkbox"><input type="checkbox" @bind="EmailAuthentication" /><label>Require Authentication?</label></div>
                    <div class="field-checkbox"><input type="checkbox" @bind="EmailSSL" @bind:after="OnSSLChanged" /><label>SSL</label></div>
                    <div class="field-checkbox"><input type="checkbox" @bind="EmailSTARTTLS" @bind:after="OnSTARTTLSChanged" /><label>STARTTLS</label></div>
                    <div class="field-row"><span class="field-label-sm">User</span><input class="field-input field-input-med" @bind="EmailUserID" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><input type="password" class="field-input field-input-med" @bind="EmailPwd" /></div>
                </div>
            }

            @if (EmailProtocol == 2)
            {
                <div class="frame-box">
                    <div class="field-row"><span class="field-label-sm">Application ID</span><input class="field-input field-input-wide" @bind="O365AppID" /></div>
                    <div class="field-row"><span class="field-label-sm">Tenant ID</span><input class="field-input field-input-wide" @bind="O365TenantID" /></div>
                    <div class="field-row"><span class="field-label-sm">Secret Value</span><input class="field-input field-input-wide" @bind="O365Secret" /></div>
                    <div class="field-row"><span class="field-label-sm">User</span><input class="field-input field-input-med" @bind="O365User" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><input type="password" class="field-input field-input-sm" @bind="O365Pswd" /></div>
                </div>
            }

            @if (EmailProtocol != 0)
            {
                <div style="margin-top:8px;">
                    <div class="field-radio"><input type="radio" name="sendFrom" checked="@SendFromCurrentUser" @onchange="() => SendFromCurrentUser = true" /><label>Send from the current users email address</label></div>
                    <div class="field-radio"><input type="radio" name="sendFrom" checked="@(!SendFromCurrentUser)" @onchange="() => SendFromCurrentUser = false" /><label>Send from the corporate address</label></div>
                    <div class="field-row"><span class="field-label-sm">Address</span><input class="field-input field-input-wide" @bind="EmailAddress" /></div>
                </div>
            }
            <span class="link-label" @onclick="OnSendTestEmail">Send a test message...</span>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Role Definitions *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 12)
        {
            <div class="two-col">
                <div>
                    <div class="section-title">Vendor Contact Roles</div>
                    <textarea class="textarea-field" rows="8" @bind="VendorRoles"></textarea>
                    <div class="section-title" style="margin-top:12px;">Customer Contact Roles</div>
                    <textarea class="textarea-field" rows="8" @bind="CustomerRoles"></textarea>
                </div>
                <div>
                    <div class="section-title">Job Contact Template</div>
                    <textarea class="textarea-field" rows="18" @bind="JobRoles"></textarea>
                </div>
            </div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Accounting Import Options *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 5)
        {
            <div class="section-title">Import Options</div>
            <div class="section-divider"></div>
            <div>Active Vendors</div>
            <div class="field-radio"><input type="radio" name="activeVendors" checked="@(!ManageActiveVendors)" @onchange="() => ManageActiveVendors = false" /><label>Let accounting manage which vendors are active.</label></div>
            <div class="field-radio"><input type="radio" name="activeVendors" checked="@ManageActiveVendors" @onchange="() => ManageActiveVendors = true" /><label>I will manage which vendors are active in HomeFront.</label></div>
            <div style="margin-top:12px;">Excluded Vendor Types - don't import these ones.</div>
            <textarea class="textarea-field" rows="15" @bind="ExcludedVendorTypes"></textarea>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Community Standards *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 7)
        {
            <div class="section-title">Community Standards</div>
            <div class="section-divider"></div>
            <div class="field-checkbox"><input type="checkbox" @bind="UseCommunityStandards" /><label>Enable community standards to automatically replace items during takeoff.</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="CommunityStandardsArePhaseSpecific" /><label>Community standards are also phase specific.</label></div>
            <div style="margin-top:12px;"><strong>Standard Items</strong></div>
            <table class="grid-simple">
                <thead><tr><th>Phase</th><th>Item</th><th>Description</th></tr></thead>
                <tbody>
                    @foreach (var si in StandardItems)
                    {
                        <tr>
                            <td>@si.Phase</td>
                            <td>@si.Item</td>
                            <td>@si.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: BuildPro Integration *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 14)
        {
            <div class="section-title">BuildPro Settings</div>
            <div class="section-divider"></div>
            <div class="field-row"><span class="field-label">Company Mnemonic</span><input class="field-input field-input-med" @bind="BuildProCompany" /></div>
            <div class="field-row">
                <span class="field-label">Environment</span>
                <select class="field-select field-input-wide" @bind="BuildProEnvironment">
                    <option value="User Acceptance Testing (UAT)">User Acceptance Testing (UAT)</option>
                    <option value="Production">Production</option>
                </select>
            </div>
            <div class="field-row"><span class="field-label">Security Context</span><input class="field-input field-input-med" @bind="BuildProUID" /></div>
            <div class="field-row"><span class="field-label">Password</span><input type="password" class="field-input field-input-med" @bind="BuildProPwd" /></div>
            <div class="field-checkbox"><input type="checkbox" @bind="BuildProSendPOsImmediately" /><label>Publish POs to BuildPro immediately upon generation</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="BuildProMultiFamily" /><label>Send shell and unit schedules for Multi family construction</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="BuildProSendPhases" /><label>Send phases to BuildPro</label></div>
            <div class="field-checkbox"><input type="checkbox" @bind="TarionEnabled" /><label>Integrate with Tarion Warranty Services</label></div>
            <div class="field-row"><span class="field-label">Warranty buyer type</span><input class="field-input field-input-med" @bind="BuildProWarrantyOwnerType" /></div>
            <div class="field-row"><span class="field-label">co buyer type</span><input class="field-input field-input-med" @bind="BuildProWarrantyCoOwnerType" /></div>

            <div class="section-title" style="margin-top:12px;">Schedule Templates</div>
            <textarea class="textarea-field" rows="8" @bind="ScheduleTemplates"></textarea>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Supply Chain Integration *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 11)
        {
            <div class="section-title">Field PO Settings</div>
            <div class="section-divider"></div>
            <div class="field-row"><span class="field-label">Default Purchasing Manager</span>
                <select class="field-select field-input-wide" @bind="DefaultPurchasingManager">
                    @foreach (var pm in PurchasingManagerList) { <option value="@pm.Value">@pm.Text</option> }
                </select>
            </div>
            <div class="field-row"><span class="field-label">Field PO Prefix</span><input class="field-input field-input-wide" @bind="FieldPOPrefix" maxlength="50" /></div>
            <div style="margin-top:8px;">Fields Required on a request:</div>
            <div class="subsection">
                @for (int i = 0; i < FieldPOFieldLabels.Length; i++)
                {
                    var idx = i;
                    <div class="field-checkbox"><input type="checkbox" @bind="FieldPOFields[idx]" /><label>@FieldPOFieldLabels[idx]</label></div>
                }
            </div>
            <div class="field-checkbox"><input type="checkbox" @bind="UseDetailedFieldPOView" /><label>Use detailed edit view for all Field PO users</label></div>

            <div class="section-title" style="margin-top:12px;">Vendor and Customer Portals</div>
            <div class="section-divider"></div>
            <div class="field-row"><span class="field-label">Attachments Folder</span><input class="field-input field-input-wide" @bind="WebAttachmentsFolder" /></div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Custom Job Properties *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 10)
        {
            <div class="section-title" style="font-weight:700; color:#800080;">Job Properties</div>
            <table class="grid-simple">
                <thead><tr><th>Category</th><th>Field Name</th><th>Data Type</th></tr></thead>
                <tbody>
                    @foreach (var cf in CustomFields)
                    {
                        <tr>
                            <td>@cf.Category</td>
                            <td>@cf.FieldName</td>
                            <td>@cf.DataType</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div style="margin-top:8px;">
                <button class="btn-action" @onclick="OnAddCustomField">Add Field</button>
                <button class="btn-action" @onclick="OnDeleteCustomField">Delete Field</button>
            </div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Department Approvals *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 13)
        {
            <div class="two-col">
                <div>
                    <div class="section-title">Departments</div>
                    <div class="section-divider"></div>
                    <table class="grid-simple">
                        <thead><tr><th>Department Name</th></tr></thead>
                        <tbody>
                            @foreach (var dept in Departments)
                            {
                                var deptClass = SelectedDepartment == dept ? "selected" : "";
                                <tr class="@deptClass" style="cursor:pointer;"
                                    @onclick="() => SelectDepartment(dept)">
                                    <td><input @bind="dept.Name" style="width:100%;border:none;background:transparent;" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button class="btn-action" style="margin-top:4px;" @onclick="OnAddDepartment">Add</button>
                    <button class="btn-action" @onclick="OnDeleteDepartment">Delete</button>
                </div>
                <div>
                    <div class="section-title">Approvers for: @(SelectedDepartment?.Name ?? "")</div>
                    <div class="section-divider"></div>
                    @if (SelectedDepartment != null)
                    {
                        <table class="grid-simple">
                            <thead><tr><th>PM</th><th>Supervisor</th><th>Invoice Limit</th></tr></thead>
                            <tbody>
                                @foreach (var a in SelectedDepartment.Approvers)
                                {
                                    <tr>
                                        <td>@a.PMName</td>
                                        <td style="text-align:center;"><input type="checkbox" @bind="a.IsSupervisor" /></td>
                                        <td><input type="number" @bind="a.InvoiceLimit" style="width:80px;" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Document Management *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 15)
        {
            <div class="section-title">Document Classes</div>
            <div class="section-divider"></div>
            <table class="grid-simple">
                <thead><tr><th>Document Class</th><th>Vendor Visible</th><th>Customer Visible</th></tr></thead>
                <tbody>
                    @foreach (var dc in DocumentClasses)
                    {
                        <tr>
                            <td><input @bind="dc.DocumentClass" /></td>
                            <td style="text-align:center;"><input type="checkbox" @bind="dc.VendorVisible" /></td>
                            <td style="text-align:center;"><input type="checkbox" @bind="dc.CustomerVisible" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button class="btn-action" style="margin-top:4px;" @onclick="OnAddDocumentClass">Add</button>
            <button class="btn-action" @onclick="OnDeleteDocumentClass">Delete</button>
        }

    </div>
</div>

<!-- Footer -->
<div class="footer-bar">
    <button class="btn-nav" @onclick="OnSave">OK</button>
    <button class="btn-nav" @onclick="OnCancel">Cancel</button>
</div>

@if (ShowSaveConfirmDialog)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);z-index:9999;display:flex;align-items:center;justify-content:center;">
        <div style="background:#fff;border:2px solid #800080;border-radius:6px;padding:24px;min-width:320px;">
            <div style="font-weight:700;margin-bottom:12px;">Settings Saved</div>
            <div style="margin-bottom:16px;">System settings have been saved successfully.</div>
            <div style="text-align:right;">
                <button class="btn-nav" @onclick="() => ShowSaveConfirmDialog = false">OK</button>
            </div>
        </div>
    </div>
}

@if (ShowErrorDialog)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);z-index:9999;display:flex;align-items:center;justify-content:center;">
        <div style="background:#fff;border:2px solid #c00;border-radius:6px;padding:24px;min-width:320px;">
            <div style="font-weight:700;color:#c00;margin-bottom:12px;">Error</div>
            <div style="margin-bottom:16px;">@ErrorMessage</div>
            <div style="text-align:right;">
                <button class="btn-nav" @onclick="() => ShowErrorDialog = false">OK</button>
            </div>
        </div>
    </div>
}

