    // VB6 lblEditList_Click(11) tail: after the grid closes, backfill any null DataSourceIDs
    // (handled inside FDBGrid's "Book of Accounts" resolver) then reload cboBookOfAccount from
    // "select distinct BookOfAccount,'',0 from DataSources order by 1", preserving the current
    // selection. We refresh BookOfAccountList the same way (it may have gained/lost accounts).
    private async Task OnBookOfAccountsClosed()
    {
        _showBookOfAccountsModal = false;
        var prev = BookOfAccount;
        var boa = await db.QueryAsync("SELECT DISTINCT BookOfAccount FROM DataSources ORDER BY 1");
        BookOfAccountList = boa.Select(r => r["BookOfAccount"]?.ToString() ?? "").ToList();
        // VB6 SetComboBoxListIndex: keep the prior pick if it still exists.
        BookOfAccount = BookOfAccountList.Contains(prev) ? prev : (BookOfAccountList.FirstOrDefault() ?? "");
        await InvokeAsync(StateHasChanged);
    }

    // VB6 lblEditList_Click(2) tail: after the Tax Groups grid closes,
    // "update taxgroups set grouprate=njcrate+jcrate" so the derived rate stays consistent.
    private async Task OnTaxGroupsClosed()
    {
        _showTaxGroupsModal = false;
        _taxGroupsGrid = null;
        try { await db.ExecuteAsync("update taxgroups set grouprate=njcrate+jcrate"); }
        catch (Exception ex) { Logger.LogWarning(ex, "Tax Groups grouprate recompute"); }
        await InvokeAsync(StateHasChanged);
