        QBPostRevenueToJob = OptBool("UseQBARByJob"); QBOJobStyle = QBJobStyle;
        SimplyFile = Sys("SimplyDataFile"); SimplyUser = Opt("SimplyUID"); SimplyPswd = Opt("SimplyPWD");
        SimplyInternalCustomer = Opt("SimplyInternalCustomer");
        IntacctCompanyID = Opt("IntacctCompanyID"); IntacctUID = Opt("IntacctUID"); IntacctPWD = Opt("IntacctPWD");
        IntacctEntity = Opt("IntacctEntity"); IntacctPOType = Opt("IntacctPOType");
        IntacctPOCOType = Opt("IntacctPOCOType"); IntacctSubContractType = Opt("IntacctSubContractType");
