    // Drive the freshly-instantiated Tax Groups FDBGrid via an explicit ShowForm(…) so the
    // VB6 args are matched verbatim (esp. hiddenColumns:"divisionid", which the caption
    // resolver would otherwise treat as a locked column). One-shot, mirroring FDBGrid's own
    // nested-grid pattern.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_taxGroupsShowPending && _taxGroupsGrid != null)
        {
            _taxGroupsShowPending = false;
            await _taxGroupsGrid.ShowForm(
                formCaption: "Tax Groups",
                sqlStatement: "select divisionid, TaxGroup, Description, JCRate, NJCRate from taxgroups where DivisionID = @DivisionID",
                tableName: "taxgroups",
                keyColumns: "divisionid,taxgroup",
                readOnly: AccountingSystemIndex == 1, // asTimberline
                hiddenColumns: "divisionid",
                addRecords: true,
                parameters: new Dictionary<string, object> { ["DivisionID"] = SessionState.DivisionID });
        }
    }

