        ScheduleTemplates = Opt("ScheduleTemplates");

        // Supply Chain
        DefaultPurchasingManager = Opt("DefaultPurchasingManager"); FieldPOPrefix = Opt("FieldPOPrefix");
        FieldPOFields[0] = OptBool("Detail_Description"); FieldPOFields[1] = OptBool("Detail_Quantity");
        FieldPOFields[2] = OptBool("Detail_Rate"); FieldPOFields[3] = OptBool("Detail_Job");
        FieldPOFields[4] = OptBool("Detail_Extra"); FieldPOFields[5] = OptBool("Detail_CostCode");
        FieldPOFields[6] = OptBool("Detail_Category"); FieldPOFields[7] = OptBool("Detail_TaxGroup");
        UseDetailedFieldPOView = OptBool("ViewPurchasingManagerDetailsForm"); WebAttachmentsFolder = Opt("WebAttachmentsFolder");

        // Book of Account
        var boaRow = await db.QueryAsync("SELECT BookOfAccount FROM divisions WHERE DivisionID=@DivisionID", new { DivisionID });
        BookOfAccount = boaRow.FirstOrDefault()?["BookOfAccount"]?.ToString() ?? "";

        // Divisions
        var divRows = await db.QueryAsync("SELECT DivisionID, DivisionCode, DivisionName FROM divisions ORDER BY DivisionCode");
        Divisions = divRows.Select(r => new DivisionRow { DivisionID = Convert.ToInt32(r["DivisionID"]), Code = r["DivisionCode"]?.ToString() ?? "", Company = r["DivisionName"]?.ToString() ?? "" }).ToList();

        // Community Standards
        var csRows = await db.QueryAsync(@"SELECT s.phase, s.item, i.description FROM communitystandarditems s
            LEFT OUTER JOIN tblphaseitem i ON (i.phase=s.phase AND i.item=s.item) WHERE i.DivisionID=@DivisionID ORDER BY 1,2,3", new { DivisionID });
        StandardItems = csRows.Select(r => new StandardItemRow { Phase = r["phase"]?.ToString() ?? "", Item = r["item"]?.ToString() ?? "", Description = r["description"]?.ToString() ?? "" }).ToList();

        // Custom Properties
        var cfRows = await db.QueryAsync("SELECT Category, Name, DataType FROM JobCustomFieldDefs ORDER BY Category, Name");
        CustomFields = cfRows.Select(r => new CustomFieldRow { Category = r["Category"]?.ToString() ?? "", FieldName = r["Name"]?.ToString() ?? "", DataType = r["DataType"]?.ToString() ?? "" }).ToList();

        // Department Approvals
        var deptRows = await db.QueryAsync("SELECT deptid, name FROM departments WHERE divisionid=@DivisionID ORDER BY name", new { DivisionID });
        Departments = new();
        foreach (var dr in deptRows)
        {
            var dept = new DepartmentRow { DeptID = Convert.ToInt32(dr["deptid"]), Name = dr["name"]?.ToString() ?? "" };
            var aRows = await db.QueryAsync(@"SELECT p.pmname, da.pm, da.supervisor, da.invoicelimit FROM departmentapprovers da
                JOIN tblprojectmanager p ON da.pm=p.pm WHERE da.deptid=@DeptID ORDER BY da.invoicelimit DESC", new { DeptID = dept.DeptID });
            dept.Approvers = aRows.Select(a => new ApproverRow { PM = a["pm"]?.ToString() ?? "", PMName = a["pmname"]?.ToString() ?? "", IsSupervisor = Convert.ToBoolean(a["supervisor"]), InvoiceLimit = Convert.ToDecimal(a["invoicelimit"] ?? 0) }).ToList();
            Departments.Add(dept);
        }
        SelectedDepartment = Departments.FirstOrDefault();

        // Document Classes
        var dcRows = await db.QueryAsync("SELECT documentclass, vendorvisible, customervisible FROM dms_documentclasses ORDER BY documentclass");
        DocumentClasses = dcRows.Select(r => new DocumentClassRow { DocumentClass = r["documentclass"]?.ToString() ?? "", VendorVisible = Convert.ToBoolean(r["vendorvisible"] ?? false), CustomerVisible = Convert.ToBoolean(r["customervisible"] ?? false) }).ToList();

        UpdatePOSample();
    }

