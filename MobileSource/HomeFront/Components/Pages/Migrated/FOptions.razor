@namespace HomeFront.Components.Pages
@page "/system-settings"
@rendermode InteractiveServer
@* HHM-621: System Settings requires an authenticated session like every
   other admin surface — a hand-typed URL must not bypass the login. *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using HomeFront.Data
@using System.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FOptions> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@using HomeFront.Models
@using HomeFront.Components.Pages
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db
@inject IGridLayoutService GridLayoutSvc

<PageTitle>System Settings - HomeFront</PageTitle>

<div class="settings-root">
<div class="settings-container">
    <!-- Table of Contents -->
    <SideNavigationControl Title="System Settings" SubHeader="Select a page"
                           Items="@NavItems" SelectedKey="@SelectedTab"
                           SelectedKeyChanged="OnNavSelect"
                           Position="SideNavPosition.Left" Width="250px" />

    <!-- Content Panel -->
    <div class="content-panel">

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Accounting Integration *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 4)
        {
            <div class="section-title">Accounting System</div>
            <div class="section-divider"></div>

            <div class="field-row">
                <span class="field-label">System</span>
                <DropDownListControl TValue="int" TItem="SelOpt" DataSource="@AccountingSystemOptions" ValueFieldName="Value" TextFieldName="Text" @bind-Value="AccountingSystemIndex" @bind-Value:after="OnAccountingSystemChanged" Width="280px" />
            </div>

            <div class="field-row">
                <span class="field-label">Book of Account</span>
                <DropDownListControl TValue="string" TItem="string" DataSource="@BookOfAccountList" @bind-Value="BookOfAccount" Width="180px" />
                <span class="link-label" @onclick="OnEditBookOfAccounts">Wallet Configuration</span>
            </div>

            @* Sage 300 CRE *@
            @if (AccountingSystemIndex == 1)
            {
                <div class="frame-box">
                    <div class="frame-title">Sage 300 Construction and Real Estate</div>
                    <div class="accounting-frame">
                        <div>
                            <div class="field-row"><span class="field-label-sm">Data Folder</span><TextBoxControl @bind-Value="TLFolder" CssClass="field-input field-input-wide" /></div>
                            <div class="field-row"><span class="field-label-sm">AR Data Folder</span><TextBoxControl @bind-Value="TLARFolder" CssClass="field-input field-input-wide" /></div>
                            <div class="field-row"><span class="field-label-sm">Security Context</span><TextBoxControl @bind-Value="TLUser" CssClass="field-input field-input-med" /></div>
                            <div class="field-row"><span class="field-label-sm">Password</span><TextBoxControl @bind-Value="TLPswd" InputType="password" CssClass="field-input field-input-med" /></div>
                        </div>
                    </div>
                </div>
            }

            @* Sage 100 Contractor *@
            @if (AccountingSystemIndex == 2)
            {
                <div class="frame-box">
                    <div class="frame-title">Sage 100 Contractor</div>
                    <div class="field-row">
                        <span class="field-label-sm">API Level</span>
                        <DropDownListControl TValue="string" TItem="string" DataSource="@MBAPILevelOptions" @bind-Value="MBAPILevel" @bind-Value:after="OnMBAPILevelChanged" Width="60px" />
                    </div>
                    @if (MBAPILevel == "v20")
                    {
                        <div class="field-row"><span class="field-label-sm">Instance</span><TextBoxControl @bind-Value="MBInstance" CssClass="field-input field-input-wide" /></div>
                    }
                    else
                    {
                        <div class="field-row">
                            <span class="field-label-sm">Drive</span>
                            <DropDownListControl TValue="string" TItem="string" DataSource="@DriveList" @bind-Value="MBDrive" Width="100px" />
                        </div>
                    }
                    <div class="field-row"><span class="field-label-sm">Company</span><TextBoxControl @bind-Value="MBCompany" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Security Context</span><TextBoxControl @bind-Value="MBUser" CssClass="field-input field-input-med" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><TextBoxControl @bind-Value="MBPswd" InputType="password" CssClass="field-input field-input-med" /></div>
                    <div class="field-checkbox"><CheckBoxControl @bind-Checked="MBUseSubAcct" Label="Use Job as Sub Account" /></div>
                </div>
            }

            @* Sage 50 Accounting *@
            @if (AccountingSystemIndex == 3)
            {
                <div class="frame-box">
                    <div class="frame-title">Sage 50 Accounting</div>
                    <div class="field-row"><span class="field-label-sm">Company File</span><TextBoxControl @bind-Value="SimplyFile" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Security Context</span><TextBoxControl @bind-Value="SimplyUser" CssClass="field-input field-input-med" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><TextBoxControl @bind-Value="SimplyPswd" InputType="password" CssClass="field-input field-input-med" /></div>
                    <div class="field-row">
                        <span class="field-label-sm">Internal Customer</span>
                        <DropDownListControl TValue="string" TItem="SelectItem" DataSource="@SimplyInternalCustomerList" ValueFieldName="Value" TextFieldName="Text" @bind-Value="SimplyInternalCustomer" Width="180px" />
                    </div>
                </div>
            }

            @* QuickBooks *@
            @if (AccountingSystemIndex == 5)
            {
                <div class="frame-box">
                    <div class="frame-title">QuickBooks</div>
                    <div class="field-row"><span class="field-label-sm">Company File</span><TextBoxControl @bind-Value="QuickBooksFile" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row">
                        <span class="field-label-sm">Edition</span>
                        <DropDownListControl TValue="string" TItem="string" DataSource="@QBEditionOptions" @bind-Value="QuickBooksVersion" Width="60px" />
                    </div>
                    <div class="field-row"><span class="field-label-sm">Job Creation</span></div>
                    <div class="subsection">
                        <div class="field-radio"><RadioControl TValue="string" Name="qbJobStyle" Value="@("Simple")" @bind-SelectedValue="QBJobStyle" Label="Simple - create the customer record only" /></div>
                        <div class="field-radio"><RadioControl TValue="string" Name="qbJobStyle" Value="@("Heirarchical")" @bind-SelectedValue="QBJobStyle" Label="Hierarchical - create customer records and sub jobs" /></div>
                    </div>
                    <div class="field-checkbox"><CheckBoxControl @bind-Checked="QBPostRevenueToJob" Label="Post revenue to job" /></div>
                </div>
            }

            @* QuickBooks Online *@
            @if (AccountingSystemIndex == 10)
            {
                <div class="frame-box">
                    <div class="frame-title">Quickbooks Online</div>
                    <div class="field-row">
                        <span class="field-label-sm">Edition</span>
                        <DropDownListControl TValue="string" TItem="string" DataSource="@QBOEditionOptions" @bind-Value="QBOVersion" Width="60px" />
                    </div>
                    <div class="field-row"><span class="field-label-sm">Job Creation</span></div>
                    <div class="subsection">
                        <div class="field-radio"><RadioControl TValue="string" Name="qboJobStyle" Value="@("Simple")" @bind-SelectedValue="QBOJobStyle" Label="Simple - create the customer record only" /></div>
                        <div class="field-radio"><RadioControl TValue="string" Name="qboJobStyle" Value="@("Heirarchical")" @bind-SelectedValue="QBOJobStyle" Label="Hierarchical - create customer records and sub jobs" /></div>
                    </div>
                </div>
            }

            @* Sage Intacct *@
            @if (AccountingSystemIndex == 11)
            {
                <div class="frame-box">
                    <div class="frame-title">D365 -- ABN</div>
                    <div class="field-row"><span class="field-label-sm">Resource</span><TextBoxControl @bind-Value="ABNResource" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Tenant ID</span><TextBoxControl @bind-Value="ABNTenantID" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Client ID</span><TextBoxControl @bind-Value="ABNClientID" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Client Secret</span><TextBoxControl @bind-Value="ABNClientSecret" InputType="password" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Legal Entity</span><TextBoxControl @bind-Value="ABNLegalEntity" CssClass="field-input field-input-med" /></div>
                    <div class="field-row"><span class="field-label-sm">D01 Division</span><TextBoxControl @bind-Value="ABND01Division" CssClass="field-input field-input-med" /></div>
                </div>
            }

            @if (AccountingSystemIndex == 9)
            {
                <div class="frame-box">
                    <div class="frame-title">Sage Intacct</div>
                    <div class="field-row"><span class="field-label-sm">Company ID</span><TextBoxControl @bind-Value="IntacctCompanyID" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">User ID</span><TextBoxControl @bind-Value="IntacctUID" CssClass="field-input field-input-med" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><TextBoxControl @bind-Value="IntacctPWD" InputType="password" CssClass="field-input field-input-med" /></div>
                    <div class="field-row">
                        <span class="field-label-sm">Entity</span>
                        <DropDownListControl TValue="string" TItem="string" DataSource="@IntacctEntityList" @bind-Value="IntacctEntity" Width="180px" />
                    </div>
                    <div class="field-row"><span class="field-label-sm">One Time ItemID</span>
                        <DropDownListControl TValue="string" TItem="string" DataSource="@IntacctItemList" @bind-Value="IntacctOneTimeItemID" Width="180px" />
                    </div>
                    <div class="field-row"><span class="field-label-sm">GST ItemID</span>
                        <DropDownListControl TValue="string" TItem="string" DataSource="@IntacctItemList" @bind-Value="IntacctGstItemID" Width="180px" />
                    </div>
                    <div class="field-row"><span class="field-label-sm">Budget GL</span><TextBoxControl @bind-Value="IntacctBudgetGL" CssClass="field-input field-input-med" /></div>
                    <div class="field-row"><span class="field-label-sm">PO Reference Fld</span>
                        <DropDownListControl TValue="string" TItem="string" DataSource="@IntacctPORefOptions" @bind-Value="IntacctPOReferenceFld" Width="180px" />
                    </div>
                    <div class="field-row"><span class="field-label-sm">Inv Reference Fld</span>
                        <DropDownListControl TValue="string" TItem="string" DataSource="@IntacctInvRefOptions" @bind-Value="IntacctInvReferenceFld" Width="180px" />
                    </div>
                    <div style="margin-top:8px;">
                        <span style="color:#800080; font-size:12px;">Transaction Types</span>
                        <div class="field-row"><span class="field-label-sm">PO</span>
                            <DropDownListControl TValue="string" TItem="string" DataSource="@IntacctTranTypeList" @bind-Value="IntacctPOType" Width="180px" />
                        </div>
                        <div class="field-row"><span class="field-label-sm">PO CO</span>
                            <DropDownListControl TValue="string" TItem="string" DataSource="@IntacctTranTypeList" @bind-Value="IntacctPOCOType" Width="180px" />
                        </div>
                        <div class="field-row"><span class="field-label-sm">Contract</span>
                            <DropDownListControl TValue="string" TItem="string" DataSource="@IntacctTranTypeList" @bind-Value="IntacctSubContractType" Width="180px" />
                        </div>
                        <div class="field-row"><span class="field-label-sm">Contract CO</span>
                            <DropDownListControl TValue="string" TItem="string" DataSource="@IntacctTranTypeList" @bind-Value="IntacctSubContractCOType" Width="180px" />
                        </div>
                        <div class="field-row"><span class="field-label-sm">Invoice</span>
                            <DropDownListControl TValue="string" TItem="string" DataSource="@IntacctTranTypeList" @bind-Value="IntacctInvoiceType" Width="180px" />
                        </div>
                        <div class="field-row"><span class="field-label-sm">Estimate</span>
                            <DropDownListControl TValue="string" TItem="string" DataSource="@IntacctEstimateTypeList" @bind-Value="IntacctEstimateType" Width="180px" />
                        </div>
                    </div>
                </div>
            }

            @* PO Numbering *@
            <div class="two-col" style="margin-top:16px;">
                <div>
                    <div class="section-title">PO Numbering</div>
                    <div class="section-divider"></div>
                    <div class="field-radio"><RadioControl TValue="string" Name="poStyle" Value="@("Job")" @bind-SelectedValue="PONumberingStyle" @bind-SelectedValue:after="UpdatePOSample" Label="Use job specific numbering." /></div>
                    @if (PONumberingStyle == "Job")
                    {
                        <div class="field-row" style="margin-left:20px;">
                            <span class="field-label-sm">Format</span>
                            <TextBoxControl @bind-Value="POSegment1" CssClass="field-input field-input-xs" readonly="readonly" />
                            <TextBoxControl @bind-Value="POSegment2" @bind-Value:after="UpdatePOSample" CssClass="field-input" style="width:30px;" />
                            <TextBoxControl @bind-Value="POSegment3" @bind-Value:after="UpdatePOSample" CssClass="field-input field-input-xs" />
                        </div>
                    }
                    <div class="field-radio"><RadioControl TValue="string" Name="poStyle" Value="@("JobPOIndex")" @bind-SelectedValue="PONumberingStyle" @bind-SelectedValue:after="UpdatePOSample" Label="Use job and PO specific numbering." /></div>
                    @if (PONumberingStyle == "JobPOIndex")
                    {
                        <div class="field-row" style="margin-left:20px;">
                            <span class="field-label-sm">Format</span>
                            <TextBoxControl @bind-Value="POSegment4" CssClass="field-input field-input-xs" readonly="readonly" />
                            <TextBoxControl @bind-Value="POSegment5" @bind-Value:after="UpdatePOSample" CssClass="field-input" style="width:30px;" />
                            <TextBoxControl @bind-Value="POSegment6" @bind-Value:after="UpdatePOSample" CssClass="field-input field-input-xs" />
                            <TextBoxControl @bind-Value="POSegment7" @bind-Value:after="UpdatePOSample" CssClass="field-input" style="width:30px;" />
                            <TextBoxControl @bind-Value="POSegment8" @bind-Value:after="UpdatePOSample" CssClass="field-input field-input-xs" />
                        </div>
                    }
                    <div class="field-radio"><RadioControl TValue="string" Name="poStyle" Value="@("Sequential")" @bind-SelectedValue="PONumberingStyle" @bind-SelectedValue:after="UpdatePOSample" Label="Use sequential numbering" /></div>
                    @if (PONumberingStyle == "Sequential")
                    {
                        <div class="field-row" style="margin-left:20px;">
                            <span class="field-label-sm">Next Num</span>
                            <TextBoxControl @bind-Value="NextPO" CssClass="field-input field-input-sm" readonly="readonly" />
                            <ButtonControl CssClass="btn-action" OnClick="OnChangeNextPO">Change</ButtonControl>
                        </div>
                        <div class="field-row" style="margin-left:20px;">
                            <span class="field-label-sm">Prefix</span>
                            <TextBoxControl @bind-Value="POPrefix" CssClass="field-input field-input-xs" MaxLength="4" @bind-Value:after="UpdatePOSample" />
                        </div>
                    }
                    <div class="field-row" style="margin-left:20px;">
                        <span class="field-label-sm">Sample</span>
                        <div class="po-sample">@PONumberSample</div>
                    </div>
                </div>

                <div>
                    <div class="section-title">Cost Codes &amp; Taxes</div>
                    <div class="section-divider"></div>
                    @for (int i = 0; i < TaxGroupLabels.Length; i++)
                    {
                        var idx = i;
                        <div class="field-row">
                            <span class="field-label-sm">@TaxGroupLabels[idx]</span>
                            <DropDownListControl TValue="string" TItem="string" DataSource="@TaxGroupOptions" @bind-Value="TaxGroups[idx]" Width="100px" />
                        </div>
                    }
                    <div class="field-checkbox"><CheckBoxControl @bind-Checked="UseTaxGroups" Label="required" /></div>
                    <div class="field-checkbox"><CheckBoxControl @bind-Checked="UseVarianceReporting" Label="required" /></div>
                    <div style="margin-top:8px;">
                        <span class="link-label" @onclick="OnEditCostCodes">Cost codes...</span><br />
                        <span class="link-label" @onclick="OnEditCategories">Categories...</span><br />
                        <span class="link-label" @onclick="OnEditTaxGroups">Tax groups...</span>
                    </div>
                    <div class="field-row" style="margin-top:8px;">
                        <span class="field-label-sm">Default category</span>
                        <DropDownListControl TValue="string" TItem="SelectItem" DataSource="@VarianceCategoryList" ValueFieldName="Value" TextFieldName="Text" @bind-Value="DefaultVarianceCategory" Width="180px" />
                    </div>
                </div>
            </div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Corporate Info *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 1)
        {
            <div class="section-title">Corporate Info</div>
            <div class="section-divider"></div>
            <div class="field-row"><span class="field-label">Company Name</span><TextBoxControl @bind-Value="CompanyName" CssClass="field-input field-input-wide" MaxLength="50" /></div>
            <div class="field-row"><span class="field-label">Address</span><TextBoxControl @bind-Value="CompanyAddr1" CssClass="field-input field-input-wide" MaxLength="50" /></div>
            <div class="field-row"><span class="field-label"></span><TextBoxControl @bind-Value="CompanyAddr2" CssClass="field-input field-input-wide" MaxLength="50" /></div>
            <div class="field-row">
                <span class="field-label">City/Prov</span>
                <TextBoxControl @bind-Value="CompanyCity" CssClass="field-input field-input-med" MaxLength="30" />
                <DropDownListControl TValue="string" TItem="string" DataSource="@ProvinceList" @bind-Value="CompanyProvince" Width="60px" />
            </div>
            <div class="field-row"><span class="field-label">Postal Code</span><TextBoxControl @bind-Value="CompanyPostalCode" CssClass="field-input field-input-med" MaxLength="10" /></div>
            <div class="field-row">
                <span class="field-label">Country</span>
                <DropDownListControl TValue="string" TItem="string" DataSource="@CountryList" @bind-Value="CompanyCountry" @bind-Value:after="OnCountryChanged" Width="100px" />
            </div>
            <div class="field-row"><span class="field-label">Contact</span><TextBoxControl @bind-Value="ContactPerson" CssClass="field-input field-input-wide" MaxLength="50" /></div>
            <div class="field-row"><span class="field-label">Phone</span><TextBoxControl @bind-Value="CompanyPhone" CssClass="field-input field-input-med" MaxLength="30" /></div>
            <div class="field-row"><span class="field-label">Fax</span><TextBoxControl @bind-Value="CompanyFax" CssClass="field-input field-input-med" MaxLength="30" /></div>
            <div class="field-row"><span class="field-label">Email Address</span><TextBoxControl @bind-Value="CompanyEmail" CssClass="field-input field-input-wide" MaxLength="150" /></div>
            <div class="field-row">
                <span class="field-label">Builder Type</span>
                <DropDownListControl TValue="string" TItem="string" DataSource="@BuilderTypeOptions" @bind-Value="BuilderType" Width="180px" />
            </div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="EnforcePasswordComplexity" Label="Enforce password complexity" /></div>

            <div class="section-title" style="margin-top:16px;">Divisions</div>
            <div class="section-divider"></div>
            <GridControl TValue="DivisionRow" DataSource="@Divisions"
                         AllowPaging="false" AllowSorting="false" AllowFiltering="false"
                         AllowSelection="false" AllowResizing="true" Height="180px" RowHeight="26">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(DivisionRow.Code)" HeaderText="Code" Width="120px">
                        <Template>
                            @{ var div = (DivisionRow)context; }
                            <TextBoxControl @bind-Value="div.Code" MaxLength="15" style="width:100%;border:none;background:transparent;" />
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(DivisionRow.Company)" HeaderText="Company" Width="220px">
                        <Template>
                            @{ var div = (DivisionRow)context; }
                            <TextBoxControl @bind-Value="div.Company" style="width:100%;border:none;background:transparent;" />
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="" Width="48px" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var div = (DivisionRow)context; }
                            <ButtonControl CssClass="btn-action" OnClick="() => OnEditDivisionCompany(div)">...</ButtonControl>
                        </Template>
                    </GridColumn>
                </GridColumnsBase>
            </GridControl>

            <div style="margin-top:12px;">
                <ButtonControl CssClass="btn-action" OnClick="OnSetupUserPermissions">Setup User Permissions</ButtonControl>
            </div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Purchasing Options *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 6)
        {
            <div class="section-title">Budgeting &amp; Purchasing</div>
            <div class="section-divider"></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="PurchasingRequiresSalesApproval" Label="Jobs require Sales approval before purchasing can begin." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="AllowForecast" @bind-Checked:after="OnAllowForecastChanged" Label="Let me use a forecasted cost basis to refresh PO costs." /></div>
            <div class="field-checkbox" style="margin-left:20px;"><CheckBoxControl @bind-Checked="WarnForecast" Disabled="@(!AllowForecast)" Label="Warn me when I use a forecasted cost basis to refresh PO costs." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="CanAddContractItemsFromPurchasing" Label="Let me add and remove contract items (model and option assemblies) on jobs." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="LetPurchaserChangeSaleQty" Label="Let purchasers change the sale quantity." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="UseComponents" Label="Use components in assembly definitions." /></div>

            <div class="section-title" style="margin-top:12px;">Posting Options</div>
            <div class="section-divider"></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="PostPOQtyToAccounting" Label="Post PO order quantity to accounting." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="PostSummarizedBudgets" Label="Post budgets summarized by job, cost code and category." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="PostAssembliesAsSalesInvoices" Label="Post Precision Builder job assemblies as AR estimates." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="PostJCExtraAsSubJob" Label="Post JC Extra as sub job" /></div>

            <div class="section-title" style="margin-top:12px;">Vendor Rate Retrieval</div>
            <div class="section-divider"></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="ZeroRateOnRefreshCosts" Label="When costs are refreshed set the item rate to zero if no value can be found." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="ZeroRateOnChangeVendor" Label="When the vendor changes set the item rate to zero if no value can be found." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="UsePricingFromEstimating" Label="When looking up prices don't use the item db. Use vendor pricelists only." /></div>

            <div class="section-title" style="margin-top:12px;">Takeoff Handling</div>
            <div class="section-divider"></div>
            <div class="field-row">
                <span class="field-label">How do you want to handle zero quantity takeoff items?</span>
                <DropDownListControl TValue="string" TItem="SelOpt" DataSource="@ZeroQtyTakeoffOptions" ValueFieldName="Value" TextFieldName="Text" @bind-Value="ZeroQtyTakeoffMode" Width="180px" />
            </div>
            <div style="margin-top:8px;">
                <span>When are the alternate cost codes and categories used?</span>
                <div class="field-radio"><RadioControl TValue="bool" Name="altCostCodes" Value="false" @bind-SelectedValue="UseAltCostCodesForCO" Label="On all options" /></div>
                <div class="field-radio"><RadioControl TValue="bool" Name="altCostCodes" Value="true" @bind-SelectedValue="UseAltCostCodesForCO" Label="Only on change orders" /></div>
            </div>

            <div class="section-title" style="margin-top:12px;">Conditional Formatting</div>
            <div class="section-divider"></div>
            @for (int i = 0; i < FormatRules.Length; i++)
            {
                var idx = i;
                <div class="field-row">
                    <span class="cf-sample" style="@CfSampleStyle(FormatRules[idx])">@FormatConditionLabels[idx]</span>
                    <DropDownListControl TValue="string" TItem="string" DataSource="@FontStyleOptions" @bind-Value="FormatRules[idx].FontStyle" />
                    <ColorPickerControl @bind-Value="FormatRules[idx].BackColor" DropUp="true" DropAlignRight="true" />
                    <ColorPickerControl @bind-Value="FormatRules[idx].ForeColor" DropUp="true" DropAlignRight="true" />
                </div>
            }
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Estimating Options *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 2)
        {
            <div class="section-title">Estimating System</div>
            <div class="section-divider"></div>
            <div class="field-row">
                <span class="field-label">System</span>
                <DropDownListControl TValue="int" TItem="SelOpt" DataSource="@EstimatingSystemOptions" ValueFieldName="Value" TextFieldName="Text" @bind-Value="EstimatingSystemIndex" Width="280px" />
            </div>

            @if (EstimatingSystemIndex == 1)
            {
                <div class="frame-box">
                    <div class="frame-title">CG Visions BIM Pipeline</div>
                    <div class="field-row"><span class="field-label-sm">Root URI</span><TextBoxControl @bind-Value="CGVisionsRootURI" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Security Context</span><TextBoxControl @bind-Value="CGVisionsUID" CssClass="field-input field-input-med" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><TextBoxControl @bind-Value="CGVisionsPWD" InputType="password" CssClass="field-input field-input-med" /></div>
                    <div class="field-row"><span class="field-label-sm">Base Model Number</span><TextBoxControl @bind-Value="BIMBaseModelNumber" CssClass="field-input field-input-med" /></div>
                    <div class="field-row"><span class="field-label-sm">Model Style</span></div>
                    <div class="subsection">
                        <div class="field-radio"><RadioControl TValue="bool" Name="pipelineStyle" Value="false" @bind-SelectedValue="BIMCommunitySpecific" Label="Global Plans and Options" /></div>
                        <div class="field-radio"><RadioControl TValue="bool" Name="pipelineStyle" Value="true" @bind-SelectedValue="BIMCommunitySpecific" Label="Community specific Plans and Options" /></div>
                    </div>
                </div>
            }

            @if (EstimatingSystemIndex == 2)
            {
                <div class="frame-box">
                    <div class="frame-title">Sage Estimating</div>
                    <div class="field-row"><span class="field-label-sm">SQL Server</span><TextBoxControl @bind-Value="SageSqlEstServer" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Database</span><TextBoxControl @bind-Value="SageSqlEstDatabase" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Login/Password</span><TextBoxControl @bind-Value="SageSqlEstUser" CssClass="field-input field-input-med" /><TextBoxControl @bind-Value="SageSqlEstPswd" InputType="password" CssClass="field-input field-input-sm" /></div>
                    <div class="field-checkbox"><CheckBoxControl @bind-Checked="SageSqlEstConsolidateItems" Label="Consolidate items to lump sum when importing estimates." /></div>
                </div>
            }

            <div class="section-title" style="margin-top:12px;">Options</div>
            <div class="section-divider"></div>
            <div class="field-row"><span class="field-label">Incentive Cost%</span><TextBoxControl @bind-Value="IncentiveCostPercent" CssClass="field-input field-input-xs" /></div>
            <div class="field-row"><span class="field-label">Sales Incentives</span><TextBoxControl @bind-Value="IncentiveItemDisplay" CssClass="field-input field-input-wide" readonly="readonly" /><ButtonControl CssClass="btn-action" OnClick="() => OpenItemPicker(0)">...</ButtonControl></div>
            <div class="field-row"><span class="field-label">Land Costs</span><TextBoxControl @bind-Value="LandItemDisplay" CssClass="field-input field-input-wide" readonly="readonly" /><ButtonControl CssClass="btn-action" OnClick="() => OpenItemPicker(1)">...</ButtonControl></div>
            <div class="field-row"><span class="field-label">Select At Takeoff</span><TextBoxControl @bind-Value="SelectAtTakeoffDisplay" CssClass="field-input field-input-wide" readonly="readonly" /><ButtonControl CssClass="btn-action" OnClick="() => OpenItemPicker(2)">...</ButtonControl></div>
            <span class="link-label" @onclick="OnEditWBSDescriptions">Edit WBS default descriptions...</span>

            <div class="section-title" style="margin-top:12px;">Takeoff System</div>
            <div class="section-divider"></div>
            <div class="field-row">
                <span class="field-label">Takeoff System</span>
                <DropDownListControl TValue="int" TItem="SelOpt" DataSource="@TakeoffSystemOptions" ValueFieldName="Value" TextFieldName="Text" @bind-Value="TakeoffSystemIndex" Width="180px" />
            </div>
            @if (TakeoffSystemIndex == 1)
            {
                <div class="frame-box">
                    <div class="field-radio"><RadioControl TValue="bool" Name="osType" Value="false" @bind-SelectedValue="OnScreenTypeSQL" Label="MS Access Database" /></div>
                    <div class="field-row"><span class="field-label-sm">File Name</span><TextBoxControl @bind-Value="OnScreenMDB" CssClass="field-input field-input-wide" /></div>
                    <div class="field-radio"><RadioControl TValue="bool" Name="osType" Value="true" @bind-SelectedValue="OnScreenTypeSQL" Label="MS SQL Server Database" /></div>
                    <div class="field-row"><span class="field-label-sm">Server</span><TextBoxControl @bind-Value="OnScreenServer" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Database</span><TextBoxControl @bind-Value="OnScreenDatabase" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Login Name</span><TextBoxControl @bind-Value="OnScreenUID" CssClass="field-input field-input-med" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><TextBoxControl @bind-Value="OnScreenPWD" InputType="password" CssClass="field-input field-input-med" /></div>
                </div>
            }
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Sales System Integration *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 3)
        {
            <div class="section-title">Sales System</div>
            <div class="section-divider"></div>
            <div class="field-row">
                <span class="field-label">System</span>
                <DropDownListControl TValue="int" TItem="SelOpt" DataSource="@SalesSystemOptions" ValueFieldName="Value" TextFieldName="Text" @bind-Value="SalesSystemIndex" Width="180px" />
            </div>

            @if (SalesSystemIndex == 0)
            {
                <div style="margin-top:8px;">
                    <span class="link-label" @onclick="OnEditCommunities">Edit communities...</span><br />
                    <span class="link-label" @onclick="OnEditCommunityPhases">Edit community phases...</span><br />
                    <span class="link-label" @onclick="OnEditModelSeries">Edit model series list...</span><br />
                    <span class="link-label" @onclick="OnEditOptionGroups">Edit option groups...</span><br />
                    <span class="link-label" @onclick="OnEditOptionCategories">Edit option categories...</span>
                </div>
            }

            @if (SalesSystemIndex == 1)
            {
                <div class="frame-box">
                    <div class="frame-title">HomeFront Profit Builder / CRM</div>
                    <div class="field-row"><span class="field-label-sm">Client ID</span><TextBoxControl @bind-Value="CrmClientID" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">API Key</span><TextBoxControl @bind-Value="CrmApiKey" InputType="password" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row">
                        <span class="field-label-sm">Environment</span>
                        <DropDownListControl TValue="string" TItem="string" DataSource="@BuildProEnvOptions" @bind-Value="CrmEnvironment" Width="280px" />
                    </div>
                </div>
            }

            @if (SalesSystemIndex == 2)
            {
                <div class="frame-box">
                    <div class="frame-title">Builder 1440</div>
                    <div class="field-row"><span class="field-label-sm">Builder Code</span><TextBoxControl @bind-Value="BuilderCode" CssClass="field-input field-input-med" MaxLength="15" /></div>
                    <div class="field-row"><span class="field-label-sm">Administrator</span><TextBoxControl @bind-Value="WebAdminUser" CssClass="field-input field-input-med" MaxLength="50" /></div>
                    <div class="field-row"><span class="field-label-sm">Ftp Upload Path</span><TextBoxControl @bind-Value="WebUploadPath" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Security Context</span><TextBoxControl @bind-Value="WebUploadUser" CssClass="field-input field-input-med" MaxLength="50" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><TextBoxControl @bind-Value="WebUploadPswd" InputType="password" CssClass="field-input field-input-med" MaxLength="50" /></div>
                    <div class="field-checkbox"><CheckBoxControl @bind-Checked="AppendUOMtoOptionDesc" Label="Append UOM to option descriptions." /></div>
                    <div class="field-radio"><RadioControl TValue="bool" Name="webUpload" Value="true" @bind-SelectedValue="WebUploadByCommunity" Label="Prompt for communities when uploading" /></div>
                    <div class="field-radio"><RadioControl TValue="bool" Name="webUpload" Value="false" @bind-SelectedValue="WebUploadByCommunity" Label="Prompt for divisions when uploading" /></div>
                </div>
            }
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Sales Pricing Settings *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 8)
        {
            <div class="section-title">Sales Worksheets</div>
            <div class="section-divider"></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="AdjustSelling" Label="Calculate selling prices when costs change." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="AdjustIncentive" Label="Calculate incentive retail when incentive cost changes." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="LockPostedSheets" Label="Lock worksheets when they are published." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="EstimatingWorksheetsOnly" Label="Hide marketing worksheet interface." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="MarketingWorkSheetAutoRefreshCosts" Label="Refresh costs when a marketing worksheet opens." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="SellingPriceIncludesTax" Label="@("Selling prices include GST & PST less rebates.")" /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="UseMaxVendorPricing" Label="Use Maximum price if no vendor price found." /></div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Vendor Communications *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 9)
        {
            <div class="section-title">Notices</div>
            <div class="section-divider"></div>
            <div style="margin-bottom:8px;">
                @{
                    var issuedClass = NoticeTabIndex == 0 ? "btn-action btn-nav" : "btn-action";
                    var canceledClass = NoticeTabIndex == 1 ? "btn-action btn-nav" : "btn-action";
                }
                <ButtonControl CssClass="@issuedClass" OnClick="() => { NoticeTabIndex = 0; }">PO Issued</ButtonControl>
                <ButtonControl CssClass="@canceledClass" OnClick="() => { NoticeTabIndex = 1; }">PO Canceled</ButtonControl>
            </div>
            @if (NoticeTabIndex == 0)
            {
                <div class="field-row"><span class="field-label-sm">Subject</span><TextBoxControl @bind-Value="MsgSendPOSubject" CssClass="field-input field-input-wide" /></div>
                <TextAreaControl @bind-Value="MsgSendPOBody" Rows="6" />
            }
            @if (NoticeTabIndex == 1)
            {
                <div class="field-row"><span class="field-label-sm">Subject</span><TextBoxControl @bind-Value="MsgCancelPOSubject" CssClass="field-input field-input-wide" /></div>
                <TextAreaControl @bind-Value="MsgCancelPOBody" Rows="6" />
            }
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="CCPrjMgr" Label="Always CC: the project manager" /></div>
            <span class="link-label" @onclick="OnShowReplacementParameters">Replacement Parameters</span>

            <div class="section-title" style="margin-top:16px;">Email Configuration</div>
            <div class="section-divider"></div>
            <div class="field-radio"><RadioControl TValue="int" Name="emailProto" Value="0" @bind-SelectedValue="EmailProtocol" Label="Send using the current users Outlook account" /></div>
            <div class="field-radio"><RadioControl TValue="int" Name="emailProto" Value="1" @bind-SelectedValue="EmailProtocol" Label="Send using an SMTP server" /></div>
            <div class="field-radio"><RadioControl TValue="int" Name="emailProto" Value="2" @bind-SelectedValue="EmailProtocol" Label="Send using SMTP via Office 365" /></div>

            @if (EmailProtocol == 1)
            {
                <div class="frame-box">
                    <div class="field-row"><span class="field-label-sm">Server:Port</span><TextBoxControl @bind-Value="SMTPServer" CssClass="field-input field-input-wide" /></div>
                    <div class="field-checkbox"><CheckBoxControl @bind-Checked="EmailAuthentication" Label="Require Authentication?" /></div>
                    <div class="field-checkbox"><CheckBoxControl @bind-Checked="EmailSSL" @bind-Checked:after="OnSSLChanged" Label="SSL" /></div>
                    <div class="field-checkbox"><CheckBoxControl @bind-Checked="EmailSTARTTLS" @bind-Checked:after="OnSTARTTLSChanged" Label="STARTTLS" /></div>
                    <div class="field-row"><span class="field-label-sm">User</span><TextBoxControl @bind-Value="EmailUserID" CssClass="field-input field-input-med" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><TextBoxControl @bind-Value="EmailPwd" InputType="password" CssClass="field-input field-input-med" /></div>
                </div>
            }

            @if (EmailProtocol == 2)
            {
                <div class="frame-box">
                    <div class="field-row"><span class="field-label-sm">Application ID</span><TextBoxControl @bind-Value="O365AppID" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Tenant ID</span><TextBoxControl @bind-Value="O365TenantID" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">Secret Value</span><TextBoxControl @bind-Value="O365Secret" CssClass="field-input field-input-wide" /></div>
                    <div class="field-row"><span class="field-label-sm">User</span><TextBoxControl @bind-Value="O365User" CssClass="field-input field-input-med" /></div>
                    <div class="field-row"><span class="field-label-sm">Password</span><TextBoxControl @bind-Value="O365Pswd" InputType="password" CssClass="field-input field-input-sm" /></div>
                </div>
            }

            @if (EmailProtocol != 0)
            {
                <div style="margin-top:8px;">
                    <div class="field-radio"><RadioControl TValue="bool" Name="sendFrom" Value="true" @bind-SelectedValue="SendFromCurrentUser" Label="Send from the current users email address" /></div>
                    <div class="field-radio"><RadioControl TValue="bool" Name="sendFrom" Value="false" @bind-SelectedValue="SendFromCurrentUser" Label="Send from the corporate address" /></div>
                    <div class="field-row"><span class="field-label-sm">Address</span><TextBoxControl @bind-Value="EmailAddress" CssClass="field-input field-input-wide" /></div>
                </div>
            }
            <span class="link-label" @onclick="OnSendTestEmail">Send a test message...</span>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Role Definitions *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 12)
        {
            <div class="two-col">
                <div>
                    <div class="section-title">Vendor Contact Roles</div>
                    <TextAreaControl @bind-Value="VendorRoles" Rows="8" />
                    <div class="section-title" style="margin-top:12px;">Customer Contact Roles</div>
                    <TextAreaControl @bind-Value="CustomerRoles" Rows="8" />
                </div>
                <div>
                    <div class="section-title">Job Contact Template</div>
                    <TextAreaControl @bind-Value="JobRoles" Rows="18" />
                </div>
            </div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Accounting Import Options *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 5)
        {
            <div class="section-title">Import Options</div>
            <div class="section-divider"></div>
            <div>Active Vendors</div>
            <div class="field-radio"><RadioControl TValue="bool" Name="activeVendors" Value="false" @bind-SelectedValue="ManageActiveVendors" Label="Let accounting manage which vendors are active." /></div>
            <div class="field-radio"><RadioControl TValue="bool" Name="activeVendors" Value="true" @bind-SelectedValue="ManageActiveVendors" Label="I will manage which vendors are active in HomeFront." /></div>
            <div style="margin-top:12px;">Excluded Vendor Types - don't import these ones.</div>
            <TextAreaControl @bind-Value="ExcludedVendorTypes" Rows="15" />
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Community Standards *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 7)
        {
            <div class="section-title">Community Standards</div>
            <div class="section-divider"></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="UseCommunityStandards" Label="Enable community standards to automatically replace items during takeoff." /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="CommunityStandardsArePhaseSpecific" Label="Community standards are also phase specific." /></div>
            <div style="margin-top:12px;"><strong>Standard Items</strong></div>
            <GridControl TValue="StandardItemRow" DataSource="@StandardItems"
                         AllowPaging="false" AllowSorting="false" AllowFiltering="false"
                         AllowSelection="false" AllowResizing="true" Height="240px" RowHeight="22">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(StandardItemRow.Phase)" HeaderText="Phase" Width="100px" />
                    <GridColumn Field="@nameof(StandardItemRow.Item)" HeaderText="Item" Width="120px" />
                    <GridColumn Field="@nameof(StandardItemRow.Description)" HeaderText="Description" Width="320px" />
                </GridColumnsBase>
            </GridControl>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: BuildPro Integration *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 14)
        {
            <div class="section-title">BuildPro Settings</div>
            <div class="section-divider"></div>
            <div class="field-row"><span class="field-label">Company Mnemonic</span><TextBoxControl @bind-Value="BuildProCompany" CssClass="field-input field-input-med" /></div>
            <div class="field-row">
                <span class="field-label">Environment</span>
                <DropDownListControl TValue="string" TItem="string" DataSource="@BuildProEnvOptions" @bind-Value="BuildProEnvironment" CssClass="field-select field-input-wide" Width="280px" />
            </div>
            <div class="field-row"><span class="field-label">Security Context</span><TextBoxControl @bind-Value="BuildProUID" CssClass="field-input field-input-med" /></div>
            <div class="field-row"><span class="field-label">Password</span><TextBoxControl @bind-Value="BuildProPwd" InputType="password" CssClass="field-input field-input-med" /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="EnablePreconJobs" Label="Enable Precon jobs" /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="AutoApproveTBDVendorAssignments" Label="Auto-approve TBD vendor assignments" /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="AllowJobReassignInBudgetsAndPOs" Label="Allow job reassignment in budgets and POs" /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="BuildProMultiFamily" Label="Send shell and unit schedules for Multi family construction" /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="BuildProSendPhases" Label="Send phases to BuildPro" /></div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="TarionEnabled" Label="Integrate with Tarion Warranty Services" /></div>
            <div class="field-row"><span class="field-label">Warranty buyer type</span><TextBoxControl @bind-Value="BuildProWarrantyOwnerType" CssClass="field-input field-input-med" /></div>
            <div class="field-row"><span class="field-label">co buyer type</span><TextBoxControl @bind-Value="BuildProWarrantyCoOwnerType" CssClass="field-input field-input-med" /></div>
            <div class="field-row"><span class="field-label">Warranty document type</span><TextBoxControl @bind-Value="BuildProWarrantyDocType" CssClass="field-input field-input-med" /></div>

            <div class="section-title" style="margin-top:12px;">Schedule Templates</div>
            <TextAreaControl @bind-Value="ScheduleTemplates" Rows="8" />

            <div class="section-title" style="margin-top:12px;">EPO Reasons@(HasEPOReasonsLayout ? "" : " [gEPOReasons FALLBACK]")</div>
            <div class="section-divider"></div>
            <GridControl @ref="_epoGrid" TValue="EPOReasonRow" DataSource="@EPOReasons"
                         AllowPaging="false" AllowSorting="false" AllowFiltering="false"
                         AllowSelection="false" AllowResizing="true" Height="200px" RowHeight="26"
                         OnLayoutChanged="@OnEPOReasonsLayoutChangedAsync">
                <GridColumnsBase @key="gEPOReasonsLayoutVersion">
                    @if (HasEPOReasonsLayout)
                    {
                        foreach (var entry in GetOrderedEPOLayout())
                        {
                            var field = entry.Field;
                            var caption = string.IsNullOrWhiteSpace(entry.Layout.Caption) ? entry.Layout.Field : entry.Layout.Caption;
                            var width = entry.Layout.Width.HasValue && entry.Layout.Width.Value > 0 ? $"{ConvertLayoutWidthToPx(entry.Layout.Width.Value)}px" : "180px";
                            <GridColumn Field="@field" HeaderText="@caption" Width="@width">
                                <Template>
                                    @{ var row = (EPOReasonRow)context; }
                                    @if (string.Equals(field, nameof(EPOReasonRow.Category), StringComparison.OrdinalIgnoreCase))
                                    {
                                        <TextBoxControl @bind-Value="row.Category" @bind-Value:after="EPORowEdited" style="width:100%;border:none;background:transparent;" />
                                    }
                                    else
                                    {
                                        <TextBoxControl @bind-Value="row.ReasonCode" @bind-Value:after="EPORowEdited" style="width:100%;border:none;background:transparent;" />
                                    }
                                </Template>
                            </GridColumn>
                        }
                    }
                    else
                    {
                        <GridColumn Field="@nameof(EPOReasonRow.ReasonCode)" HeaderText="Reason Code" Width="160px">
                            <Template>
                                @{ var row = (EPOReasonRow)context; }
                                <TextBoxControl @bind-Value="row.ReasonCode" @bind-Value:after="EPORowEdited" style="width:100%;border:none;background:transparent;" />
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(EPOReasonRow.Category)" HeaderText="Category" Width="240px">
                            <Template>
                                @{ var row = (EPOReasonRow)context; }
                                <TextBoxControl @bind-Value="row.Category" @bind-Value:after="EPORowEdited" style="width:100%;border:none;background:transparent;" />
                            </Template>
                        </GridColumn>
                    }
                </GridColumnsBase>
            </GridControl>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Supply Chain Integration *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 11)
        {
            <div class="section-title">Field PO Settings</div>
            <div class="section-divider"></div>
            <div class="field-row"><span class="field-label">Default Purchasing Manager</span>
                <DropDownListControl TValue="string" TItem="SelectItem" DataSource="@PurchasingManagerList" ValueFieldName="Value" TextFieldName="Text" @bind-Value="DefaultPurchasingManager" Width="280px" />
            </div>
            <div class="field-row"><span class="field-label">Field PO Prefix</span><TextBoxControl @bind-Value="FieldPOPrefix" CssClass="field-input field-input-wide" MaxLength="50" /></div>
            <div style="margin-top:8px;">Fields Required on a request:</div>
            <div class="subsection">
                @for (int i = 0; i < FieldPOFieldLabels.Length; i++)
                {
                    var idx = i;
                    <div class="field-checkbox"><CheckBoxControl @bind-Checked="FieldPOFields[idx]" Label="@FieldPOFieldLabels[idx]" /></div>
                }
            </div>
            <div class="field-checkbox"><CheckBoxControl @bind-Checked="UseDetailedFieldPOView" Label="Use detailed edit view for all Field PO users" /></div>

            <div class="section-title" style="margin-top:12px;">Vendor and Customer Portals</div>
            <div class="section-divider"></div>
            <div class="field-row"><span class="field-label">Attachments Folder</span><TextBoxControl @bind-Value="WebAttachmentsFolder" CssClass="field-input field-input-wide" /></div>
        }

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* TAB: Custom Job Properties *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        @if (SelectedTab == 10)
        {
            <div class="section-title" style="font-weight:700; color:#800080;">Job Properties</div>
            <GridControl TValue="CustomFieldRow" DataSource="@CustomFields"
                         AllowPaging="false" AllowSorting="false" AllowFiltering="false"
                         AllowSelection="true" AllowResizing="true" Height="240px" RowHeight="22"
                         SelectionSettingsRef="@_rowSelect" EventsRef="@_customFieldsEvents">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(CustomFieldRow.Category)" HeaderText="Category" Width="140px" AllowEditing="false" />
                    <GridColumn Field="@nameof(CustomFieldRow.FieldName)" HeaderText="Field Name" Width="160px" AllowEditing="false" />
