    // VB6 colors are OLE longs (R + G*256 + B*65536); ColorPickerControl uses #RRGGBB hex.
    private static string OleToHex(string? stored)
    {
        var s = (stored ?? "").Trim();
        if (s.Length >= 4 && s[0] == '#') return s;            // already hex
        if (long.TryParse(s, out var n) && n >= 0)
        {
            int r = (int)(n & 0xFF), g = (int)((n >> 8) & 0xFF), b = (int)((n >> 16) & 0xFF);
            return $"#{r:X2}{g:X2}{b:X2}";
        }
        return "#000000";
    }

    private static string HexToOle(string? hex)
    {
        var s = (hex ?? "").Trim().TrimStart('#');
        if (s.Length == 6 && int.TryParse(s, System.Globalization.NumberStyles.HexNumber, null, out var rgb))
        {
            int r = (rgb >> 16) & 0xFF, g = (rgb >> 8) & 0xFF, b = rgb & 0xFF;
            return (r + g * 256 + b * 65536).ToString();
        }
        return "0";
    }

    // Black or white — whichever contrasts with the given #RRGGBB (perceived luminance).
    private static string ContrastColor(string? hexBack)
    {
        var s = (hexBack ?? "").Trim().TrimStart('#');
        if (s.Length == 6 && int.TryParse(s, System.Globalization.NumberStyles.HexNumber, null, out var rgb))
        {
            int r = (rgb >> 16) & 0xFF, g = (rgb >> 8) & 0xFF, b = rgb & 0xFF;
            return (0.299 * r + 0.587 * g + 0.114 * b) > 140 ? "#000000" : "#FFFFFF";
        }
        return "#000000";
    }

    // Conditional-Formatting sample cell: the condition text rendered with its own back/fore
    // colours + font style (VB6 shows the effect on a sample, so no "Back"/"Fore" text labels).
    private static string CfSampleStyle(FormatRule r)
    {
        var s = $"background:{r.BackColor}; color:{r.ForeColor};";
        if (r.FontStyle.Contains("Bold")) s += "font-weight:bold;";
        if (r.FontStyle.Contains("Italic")) s += "font-style:italic;";
        return s;
    }

