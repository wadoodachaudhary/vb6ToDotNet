        }
        return Task.CompletedTask;
    }

    // === EPO Reasons grid — AppGridLayout-driven columns + VB6 auto-add trailing row ===
    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // DRIFT (intentional — left un-delegated): ordering matches the presenter, but
    // the field resolution uses the bespoke two-column ResolveEPOField below rather
    // than the presenter's reflection-based ResolveField, so this iterates the
    // layout directly. (gEPOReasonsLayout is now _epoReasonsGrid.Layout.)
    private IEnumerable<(GridLayoutColumn Layout, string Field)> GetOrderedEPOLayout()
    {
        foreach (var layout in gEPOReasonsLayout.Values
                     .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
                     .OrderBy(c => c.ColIndex ?? int.MaxValue)
                     .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase))
            yield return (layout, ResolveEPOField(layout.Field));
    }

    // DRIFT (intentional — left un-delegated): this is a bespoke two-column
    // heuristic — any field whose name contains "categ" edits Category, everything
    // else edits ReasonCode. The presenter's reflection ResolveField can't express
    // this, so it stays local. Map an AppGridLayout field name to the EPOReasonRow
    // property it edits.
    private static string ResolveEPOField(string field) =>
        field.Replace(" ", "").ToLowerInvariant().Contains("categ")
            ? nameof(EPOReasonRow.Category) : nameof(EPOReasonRow.ReasonCode);

    // The new widths live on the snapshot, not in the presenter's layout dict, so
    // they have to be merged in before the save. ResolveEPOField is the same map the
    // columns were rendered with, so the snapshot's field names find their layout rows.
    private async Task OnEPOReasonsLayoutChangedAsync(GridSettings snapshot)
    {
        if (snapshot == null || gEPOReasonsLayout.Count == 0) return;

        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FOptions", "gEPOReasons", instanceKey: null,
                gEPOReasonsLayout, snapshot, layoutFieldResolver: ResolveEPOField, staticNames: false);

            _epoReasonsGrid.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FOptions gEPOReasons layout");
        }
    }

