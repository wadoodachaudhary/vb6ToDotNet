    // VB6 gCustomFields delete (FOptions.frm:6612-6622): unbind defaults, DROP the
    // column from both wide tables, remove the JobCustomFieldDefs row. Per user
    // decision this admin form follows VB6's schema-changing design — the custom-field
    // values live in JobCustomFields.<col>, so Add adds a column and Delete drops it.
    private async Task OnDeleteCustomField()
    {
        var cf = SelectedCustomField;
        if (cf == null || string.IsNullOrEmpty(cf.FieldName)) return;
        var ok = await Dialogs.ConfirmAsync(
            $"Delete custom property \"{cf.FieldName}\"?\n\nThis removes the column and all of its data permanently.");
        if (!ok) return;

        var col = "[" + cf.FieldName.Replace("]", "]]") + "]";
        try
        {
            try { await db.ExecuteAsync($"EXEC sp_unbindefault 'dbo.JobCustomFields.{col}'"); } catch { /* no default bound */ }
            try { await db.ExecuteAsync($"EXEC sp_unbindefault 'dbo.WorkticketCustomFlds.{col}'"); } catch { }
            try { await db.ExecuteAsync($"ALTER TABLE dbo.WorkticketCustomFlds DROP COLUMN {col}"); } catch { /* column may not exist here */ }
            try { await db.ExecuteAsync($"ALTER TABLE dbo.JobCustomFields DROP COLUMN {col}"); } catch { /* leave orphan column if it can't drop */ }
            await db.ExecuteAsync("DELETE FROM JobCustomFieldDefs WHERE Name=@Name", new { Name = cf.FieldName });
            SelectedCustomField = null;
            await ReloadCustomFieldsAsync();
            Notifications.Info($"Custom property \"{cf.FieldName}\" deleted.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Delete custom property error");
            Notifications.Error($"Could not delete property: {ex.Message}");
        }
    }

    private async Task ReloadCustomFieldsAsync()
    {
        var cfRows = await db.QueryAsync("SELECT Category, Name, PickList FROM JobCustomFieldDefs ORDER BY Category, Name");
        CustomFields = cfRows.Select(r => new CustomFieldRow { Category = r["Category"]?.ToString() ?? "", FieldName = r["Name"]?.ToString() ?? "", PickList = r["PickList"]?.ToString() ?? "" }).ToList();
        StateHasChanged();
    }

    // === VB6 FOptions delimiter transforms (stored value ↔ one-entry-per-line textarea) ===
    // Contact Roles + Schedule Templates: stored pipe-delimited, shown one per line
    // (VB6 load: Replace(value, "|", vbCrLf)).
    private static string PipeToLines(string? stored) => (stored ?? "").Replace("|", "\n");
    // VB6 PDL(): split on newline, trim each element, strip embedded '|', drop blank lines, join with '|'.
    private static string LinesToPipe(string? text) => string.Join("|",
        (text ?? "").Replace("\r\n", "\n").Split('\n').Select(l => l.Trim().Replace("|", "")).Where(l => l.Length > 0));
    // ExcludedVendorTypes: stored as a quoted SQL IN-list 'A','B','C', shown one per line
    // (VB6 load: strip "'" then Replace(",", vbCrLf); save: wrap items as '...','...').
    private static string ExcludedToLines(string? stored) => (stored ?? "").Replace("'", "").Replace(",", "\n");
    private static string LinesToExcluded(string? text) => "'" + string.Join("','",
        (text ?? "").Replace("\r\n", "\n").Split('\n').Select(l => l.Trim()).Where(l => l.Length > 0)) + "'";

