            FormatRules[i].BackColor = string.IsNullOrWhiteSpace(rawBack) ? FormatDefaults[i].Back : OleToHex(rawBack);
            FormatRules[i].ForeColor = string.IsNullOrWhiteSpace(rawFore) ? FormatDefaults[i].Fore : OleToHex(rawFore);
            // Background and foreground must differ, else the sample text is invisible.
            if (string.Equals(FormatRules[i].BackColor, FormatRules[i].ForeColor, StringComparison.OrdinalIgnoreCase))
                FormatRules[i].ForeColor = ContrastColor(FormatRules[i].BackColor);
        }

        UpdatePOSample();
    }

