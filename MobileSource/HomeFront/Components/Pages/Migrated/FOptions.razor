            new() { Index = 13, Caption = "Department Approvals" },
            new() { Index = 14, Caption = "BuildPro Integration" },
            new() { Index = 15, Caption = "Document Management" },
        };
        try { await LoadAllDataAsync(); }
        catch (Exception ex) { ErrorMessage = ex.Message; ShowErrorDialog = true; }
    }

    private void SelectTab(int idx) => SelectedTab = idx;

    // VB6 "Select a page" TOC, now the FlexKit SideNavigationControl. Map the tab defs to
    // nav items (sorted by caption like the VB6 list) and route selection back to SelectTab.
    private IEnumerable<SideNavigationItem> NavItems => TabItems
        .OrderBy(t => t.Caption)
        .Select(t => new SideNavigationItem { Key = t.Index, Text = t.Caption, IconUrl = "images/pointing_hand.png" });

    private void OnNavSelect(object? key) => SelectTab(Convert.ToInt32(key));

    // ════════════════════════════════════════════════════════
    // Load All Data
    // ════════════════════════════════════════════════════════

    private async Task LoadAllDataAsync()
    {
        var countries = await db.QueryAsync("SELECT DISTINCT country FROM countrycodes ORDER BY 1");
        CountryList = countries.Select(r => r["country"]?.ToString() ?? "").ToList();
        ProvinceList = new() { "AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT" };
        var boa = await db.QueryAsync("SELECT DISTINCT BookOfAccount FROM DataSources ORDER BY 1");
        BookOfAccountList = boa.Select(r => r["BookOfAccount"]?.ToString() ?? "").ToList();
        var pms = await db.QueryAsync("SELECT pmname, pm FROM tblprojectmanager WHERE purchaser=1");
        PurchasingManagerList = pms.Select(r => new SelectItem { Value = r["pm"]?.ToString() ?? "", Text = r["pmname"]?.ToString() ?? "" }).ToList();

        var tgRows = await db.QueryAsync("SELECT TaxGroup, Description FROM TaxGroups WHERE DivisionID =@DivisionID", new { SessionState.DivisionID });
        TaxGroupList = tgRows.Select(r => r["TaxGroup"]?.ToString() ?? "").ToList();
        var vcRows = await db.QueryAsync("SELECT description, category FROM standardcategories WHERE isvariance=1 AND DivisionID =@DivisionID", new { SessionState.DivisionID });
        VarianceCategoryList = vcRows.Select(r => new SelectItem { Value = r["category"]?.ToString() ?? "", Text = r["description"]?.ToString() ?? "" }).ToList();

        // Load AppOptions for this division AND the global (DivisionID 0) rows — many options
        // (e.g. the Conditional-Formatting Format_* values) live at division 0. ORDER BY so the
        // division-specific row is applied last and overrides the global one.
        var optRows = await db.QueryAsync("SELECT OptionName, OptionValue FROM AppOptions WHERE DivisionID IN (0, @DivisionID) ORDER BY DivisionID", new { SessionState.DivisionID });
        var opts = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var r in optRows)
            opts[r["OptionName"]?.ToString() ?? ""] = r["OptionValue"]?.ToString() ?? "";
        // Load system_setup row
        var sysRows = await db.QueryAsync("SELECT * FROM system_setup WHERE id=@DivisionID", new { SessionState.DivisionID });
        var sys = sysRows.FirstOrDefault() ?? new Dictionary<string, object>();

        string Opt(string n) => opts.TryGetValue(n, out var v) ? v : "";
        string Sys(string n) => sys.TryGetValue(n, out var v) ? v?.ToString() ?? "" : "";
        bool OptBool(string n) => Opt(n).Equals("True", StringComparison.OrdinalIgnoreCase);
        bool SysBool(string n) { var v = Sys(n); return v == "1" || v.Equals("True", StringComparison.OrdinalIgnoreCase); }

        // Corporate Info
        CompanyName = Sys("CompanyName"); ContactPerson = Sys("ContactPerson");
        CompanyAddr1 = Sys("address1"); CompanyAddr2 = Sys("address2");
        CompanyCity = Sys("city"); CompanyProvince = Sys("province");
