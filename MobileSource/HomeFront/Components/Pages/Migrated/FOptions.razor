    private Task OnItemPicked(List<IDictionary<string, object>> rows)
    {
        if (rows.Count == 0) return Task.CompletedTask;
        var r = rows[0];
        var p = PickCol(r, "Phase"); var i = PickCol(r, "Item"); var d = PickCol(r, "Description");
        switch (_itemPickTarget)
        {
            case 0: _incPhase = p; _incItem = i; _incDesc = d; IncentiveItemDisplay = ItemDisplay(p, i, d); break;
            case 1: _landPhase = p; _landItem = i; _landDesc = d; LandItemDisplay = ItemDisplay(p, i, d); break;
