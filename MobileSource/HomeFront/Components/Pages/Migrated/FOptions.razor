            await SetOpt("BuildProUID", BuildProUID); await SetOpt("BuildProPwd", BuildProPwd);
            await SetOpt("ABN_Resource", ABNResource); await SetOpt("ABN_TenantID", ABNTenantID); await SetOpt("ABN_ClientID", ABNClientID);
            await SetOpt("ABN_ClientSecret", ABNClientSecret); await SetOpt("ABN_LegalEntity", ABNLegalEntity); await SetOpt("ABN_D01Division", ABND01Division);
            await SetOpt("EnablePreconJobs", EnablePreconJobs ? "true" : "false");
            await SetOpt("AutoApproveTBDVendorAssignments", AutoApproveTBDVendorAssignments ? "true" : "false");
            await SetOpt("AllowJobReassignInBudgetsAndPOs", AllowJobReassignInBudgetsAndPOs.ToString());
            await SetOpt("BuildProWarrantyDocType", BuildProWarrantyDocType);
            await SetOpt("UseBPDocManagment", UseBPDocManagment.ToString());
            await SetOpt("BuildProMultiFamily", BuildProMultiFamily.ToString());
            await SetOpt("BuildProDontSendPhases", (!BuildProSendPhases).ToString());
            await SetOpt("EnableTarionFields", TarionEnabled.ToString());
            await SetOpt("BuildProWarrantyOwnerType", BuildProWarrantyOwnerType);
            await SetOpt("BuildProWarrantyCoOwnerType", BuildProWarrantyCoOwnerType);
            await SetOpt("ScheduleTemplates", LinesToPipe(ScheduleTemplates));

            // EPO Reasons — delete all then re-insert from grid rows (skip blanks). VB6 FOptions.frm:8330-8343.
            await db.ExecuteAsync("DELETE FROM appoptions WHERE divisionid=@DivisionID AND optionname like 'EPOReason%'", new { SessionState.DivisionID });
            foreach (var epo in EPOReasons.Where(e => !string.IsNullOrWhiteSpace(e.ReasonCode)))
                await db.ExecuteAsync("INSERT INTO appoptions(uid,divisionid,optionname,optionvalue) VALUES('',@DivisionID,@Name,@Val)",
                    new { SessionState.DivisionID, Name = "EPOReason" + epo.ReasonCode, Val = epo.Category });

            // Conditional Formatting — write the 12 Format_* AppOptions (hex → OLE long).
            for (int i = 0; i < FormatConditionKeys.Length; i++)
            {
                var k = FormatConditionKeys[i];
                await SetOpt($"Format_{k}_FontStyle", FormatRules[i].FontStyle);
                await SetOpt($"Format_{k}_BackColor", HexToOle(FormatRules[i].BackColor));
                await SetOpt($"Format_{k}_ForeColor", HexToOle(FormatRules[i].ForeColor));
            }
            await SetOpt("DefaultPurchasingManager", DefaultPurchasingManager); await SetOpt("FieldPOPrefix", FieldPOPrefix);
            await SetOpt("Detail_Description", FieldPOFields[0].ToString()); await SetOpt("Detail_Quantity", FieldPOFields[1].ToString());
            await SetOpt("Detail_Rate", FieldPOFields[2].ToString()); await SetOpt("Detail_Job", FieldPOFields[3].ToString());
            await SetOpt("Detail_Extra", FieldPOFields[4].ToString()); await SetOpt("Detail_CostCode", FieldPOFields[5].ToString());
            await SetOpt("Detail_Category", FieldPOFields[6].ToString()); await SetOpt("Detail_TaxGroup", FieldPOFields[7].ToString());
            await SetOpt("ViewPurchasingManagerDetailsForm", UseDetailedFieldPOView.ToString());
            await SetOpt("WebAttachmentsFolder", WebAttachmentsFolder);

            await db.ExecuteAsync("UPDATE divisions SET bookofaccount=@BookOfAccount WHERE divisionid=@DivisionID", new { BookOfAccount, SessionState.DivisionID });

            // Divisions
            foreach (var div in Divisions)
                await db.ExecuteAsync("UPDATE divisions SET divisioncode=@Code, divisionname=@Company WHERE divisionid=@DivisionID", new { div.Code, div.Company, div.DivisionID });

            // Department Approvals
            await db.ExecuteAsync("DELETE FROM departmentapprovers WHERE deptid IN (SELECT deptid FROM departments WHERE divisionid=@DivisionID)", new { SessionState.DivisionID });
            await db.ExecuteAsync("DELETE FROM departmentglaccounts WHERE deptid IN (SELECT deptid FROM departments WHERE divisionid=@DivisionID)", new { SessionState.DivisionID });
            foreach (var dept in Departments)
            {
                if (dept.DeptID > 0)
                    await db.ExecuteAsync("UPDATE departments SET name=@Name WHERE deptid=@DeptID", new { dept.Name, dept.DeptID });
                int so = 0;
                foreach (var a in dept.Approvers)
                    await db.ExecuteAsync("INSERT INTO departmentapprovers(deptid,pm,supervisor,invoicelimit,sortorder) VALUES(@DeptID,@PM,@S,@L,@SO)",
                        new { dept.DeptID, a.PM, S=a.IsSupervisor, L=a.InvoiceLimit, SO=so++ });
                foreach (var gl in dept.GLAccounts.Where(g => !string.IsNullOrWhiteSpace(g.Account)))
                    await db.ExecuteAsync("INSERT INTO departmentglaccounts(deptid,account) VALUES(@DeptID,@Account)",
                        new { dept.DeptID, gl.Account });
            }

            // Document Classes
            await db.ExecuteAsync("DELETE FROM dms_documentclasses");
            foreach (var dc in DocumentClasses.Where(d => !string.IsNullOrWhiteSpace(d.DocumentClass)))
                await db.ExecuteAsync("INSERT INTO dms_documentclasses(documentclass,vendorvisible) VALUES(@DocumentClass,@VendorVisible)",
                    new { dc.DocumentClass, dc.VendorVisible });

            ShowSaveConfirmDialog = true;
        }
        catch (Exception ex) { ErrorMessage = ex.Message; ShowErrorDialog = true; }
    }

