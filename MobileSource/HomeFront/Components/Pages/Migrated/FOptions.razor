    {
        PONumberSample = PONumberingStyle switch
        {
            "Job" => $"JOB{POSegment2}{new string('0', int.TryParse(POSegment3, out var n3) ? n3 : 3)}",
            "JobPOIndex" => $"JOB{POSegment5}{new string('0', int.TryParse(POSegment6, out var n6) ? n6 : 4)}{POSegment7}{new string('0', int.TryParse(POSegment8, out var n8) ? n8 : 2)}",
            _ => $"{POPrefix}{NextPO}"
        };
    }
