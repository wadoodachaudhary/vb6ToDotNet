    private async Task OnSave()
    {
        try
        {
            async Task SetOpt(string name, string value)
            {
                await db.ExecuteAsync(@"IF EXISTS (SELECT 1 FROM AppOptions WHERE DivisionID=@DivisionID AND OptionName=@Name)
                    UPDATE AppOptions SET OptionValue=@Value WHERE DivisionID=@DivisionID AND OptionName=@Name
                    ELSE INSERT INTO AppOptions(UID,DivisionID,OptionName,OptionValue) VALUES('',@DivisionID,@Name,@Value)",
                    new { DivisionID, Name = name, Value = value });
            }

            // system_setup
            await db.ExecuteAsync(@"UPDATE system_setup SET CompanyName=@CompanyName, ContactPerson=@ContactPerson,
                address1=@A1, address2=@A2, city=@City, province=@Prov, zip=@Zip, country=@Country,
                phone=@Phone, fax=@Fax, email=@Email, TaxGroupRequired=@UseTaxGroups,
                TaxGroupLabour=@T0, TaxGroupMaterial=@T1, TaxGroupSubContract=@T2,
                TaxGroupEquipment=@T3, TaxGroupOverhead=@T4, TaxGroupOther=@T5,
                POPrefix=@POPrefix, ZeroQtyTakeoffs=@ZQT, Msg_SendPO_Subject=@MSS,
                Msg_SendPO_Body=@MSB, Msg_CancelPO_Subject=@MCS, Msg_CancelPO_Body=@MCB,
                MaxVendorPricing=@MVP, Estimator_Email=@EA WHERE id=@DivisionID",
                new { CompanyName, ContactPerson, A1=CompanyAddr1, A2=CompanyAddr2,
                    City=CompanyCity, Prov=CompanyProvince, Zip=CompanyPostalCode, Country=CompanyCountry,
                    Phone=CompanyPhone, Fax=CompanyFax, Email=CompanyEmail, UseTaxGroups,
                    T0=TaxGroups[0], T1=TaxGroups[1], T2=TaxGroups[2], T3=TaxGroups[3], T4=TaxGroups[4], T5=TaxGroups[5],
                    POPrefix, ZQT=ZeroQtyTakeoffMode, MSS=MsgSendPOSubject, MSB=MsgSendPOBody,
                    MCS=MsgCancelPOSubject, MCB=MsgCancelPOBody, MVP=UseMaxVendorPricing, EA=EmailAddress, DivisionID });

            await db.ExecuteAsync(@"UPDATE d SET address1=s.address1,address2=s.address2,city=s.city,
                province=s.province,country=s.country,postal=s.zip,phone=s.phone,fax=s.fax
                FROM system_setup s JOIN divisions d ON s.id=d.divisionid WHERE s.id=@DivisionID", new { DivisionID });

            // AppOptions
            await SetOpt("BuilderType", BuilderType);
            await SetOpt("EnforcePasswordComplexity", EnforcePasswordComplexity.ToString());
            await SetOpt("UseAltCostCodesForCO", UseAltCostCodesForCO.ToString());
            await SetOpt("DefaultVarianceCategory", DefaultVarianceCategory);
            await SetOpt("UseVarianceReporting", UseVarianceReporting.ToString());
            await SetOpt("PurchasingRequiresSalesApproval", PurchasingRequiresSalesApproval.ToString());
            await SetOpt("LetPurchaserChangeSaleQty", LetPurchaserChangeSaleQty.ToString());
            await SetOpt("UseComponents", UseComponents.ToString());
            await SetOpt("PostPOQtyToAccounting", PostPOQtyToAccounting.ToString());
            await SetOpt("PostAssembliesAsSalesInvoices", PostAssembliesAsSalesInvoices.ToString());
            await SetOpt("PostJCExtraAsSubJob", PostJCExtraAsSubJob.ToString());
            await SetOpt("PONumberingStyle", PONumberingStyle);
            await SetOpt("POFormatSegment1", POSegment1); await SetOpt("POFormatSegment2", POSegment2);
            await SetOpt("POFormatSegment3", POSegment3); await SetOpt("POFormatSegment4", POSegment4);
            await SetOpt("POFormatSegment5", POSegment5); await SetOpt("POFormatSegment6", POSegment6);
            await SetOpt("POFormatSegment7", POSegment7); await SetOpt("POFormatSegment8", POSegment8);
            await SetOpt("SendPO_CCPrjMgr", CCPrjMgr.ToString());
            await SetOpt("SendPO_ViaOutlook", (EmailProtocol==0).ToString());
            await SetOpt("SendPO_ViaSMTP", (EmailProtocol==1).ToString());
            await SetOpt("SendPO_Via365SMTP", (EmailProtocol==2).ToString());
            await SetOpt("SendPO_SMTPServer", SMTPServer);
            await SetOpt("Email_Authenticate", EmailAuthentication.ToString());
            await SetOpt("Email_SSL", EmailSSL.ToString()); await SetOpt("Email_STARTTLS", EmailSTARTTLS.ToString());
            await SetOpt("Email_User", EmailUserID); await SetOpt("Email_Pswd", EmailPwd);
            await SetOpt("SendPO_FromCurrentUsersEmail", SendFromCurrentUser.ToString());
            await SetOpt("Smtp365EmailAppID", O365AppID); await SetOpt("Smtp365EmailTenantID", O365TenantID);
            await SetOpt("Smtp365EmailSecret", O365Secret); await SetOpt("Smtp365EmailUser", O365User);
            await SetOpt("Smtp365EmailPswd", O365Pswd);
            await SetOpt("AdjustIncentiveRetailWithCosts", AdjustIncentive.ToString());
            await SetOpt("EstimatingSystem", EstimatingSystemIndex.ToString());
            await SetOpt("CGVisionsRootURI", CGVisionsRootURI); await SetOpt("CGVisionsUID", CGVisionsUID);
            await SetOpt("CGVisionsPWD", CGVisionsPWD); await SetOpt("BIMBaseModelNumber", BIMBaseModelNumber);
            await SetOpt("BIMCommunitySpecificPlansAndOptions", BIMCommunitySpecific.ToString());
            await SetOpt("SageSqlEstServer", SageSqlEstServer); await SetOpt("SageSqlEstDatabase", SageSqlEstDatabase);
            await SetOpt("SageSqlEstUser", SageSqlEstUser); await SetOpt("SageSqlEstPswd", SageSqlEstPswd);
            await SetOpt("SageSqlEstConsolidateItems", SageSqlEstConsolidateItems.ToString());
            await SetOpt("TakeoffSystem", TakeoffSystemIndex.ToString());
            await SetOpt("OnScreenType", OnScreenTypeSQL ? "SQL" : "MDB");
            await SetOpt("OnScreenMDB", OnScreenMDB); await SetOpt("OnScreenServer", OnScreenServer);
            await SetOpt("OnScreenDatabase", OnScreenDatabase); await SetOpt("OnScreenUID", OnScreenUID);
            await SetOpt("OnScreenPWD", OnScreenPWD);
            await SetOpt("CRMClientID", CrmClientID); await SetOpt("CRMApiKey", CrmApiKey);
            await SetOpt("CRMEnvironment", CrmEnvironment);
            await SetOpt("AppendUOMtoOptionDesc", AppendUOMtoOptionDesc.ToString());
            await SetOpt("WebUploadByCommunity", WebUploadByCommunity.ToString());
            await SetOpt("ManageActiveVendors", ManageActiveVendors.ToString());
            await SetOpt("ExcludedVendorTypes", ExcludedVendorTypes);
            await SetOpt("IntacctCompanyID", IntacctCompanyID); await SetOpt("IntacctUID", IntacctUID);
            await SetOpt("IntacctPWD", IntacctPWD); await SetOpt("IntacctEntity", IntacctEntity);
            await SetOpt("IntacctPOType", IntacctPOType); await SetOpt("IntacctPOCOType", IntacctPOCOType);
            await SetOpt("IntacctSubContractType", IntacctSubContractType);
            await SetOpt("IntacctSubcontractCOType", IntacctSubContractCOType);
            await SetOpt("IntacctInvoiceType", IntacctInvoiceType); await SetOpt("IntacctEstimateType", IntacctEstimateType);
            await SetOpt("IntacctEstimateGLBudgetID", IntacctBudgetGL);
            await SetOpt("IntacctPOReferenceFld", IntacctPOReferenceFld);
            await SetOpt("IntacctInvReferenceFld", IntacctInvReferenceFld);
            await SetOpt("IntacctOneTimeItemID", IntacctOneTimeItemID); await SetOpt("IntacctGstItemID", IntacctGstItemID);
            await SetOpt("Sage100APILevel", MBAPILevel); await SetOpt("UseJobAsSubAcct", MBUseSubAcct.ToString());
            await SetOpt("AccountingVersion", QuickBooksVersion); await SetOpt("QuickBooksJobStyle", QBJobStyle);
            await SetOpt("UseQBARByJob", QBPostRevenueToJob.ToString());
            await SetOpt("SimplyUID", SimplyUser); await SetOpt("SimplyPWD", SimplyPswd);
            await SetOpt("SimplyInternalCustomer", SimplyInternalCustomer);
            await SetOpt("VendorContactRoles", VendorRoles); await SetOpt("CustomerContactRoles", CustomerRoles);
            await SetOpt("JobContactRoles", JobRoles);
            await SetOpt("BuildProCompanyCode", BuildProCompany); await SetOpt("BuildProEnvironment", BuildProEnvironment);
            await SetOpt("BuildProUID", BuildProUID); await SetOpt("BuildProPwd", BuildProPwd);
            await SetOpt("BuildProSendPOsImmediately", BuildProSendPOsImmediately.ToString());
            await SetOpt("BuildProMultiFamily", BuildProMultiFamily.ToString());
            await SetOpt("BuildProDontSendPhases", (!BuildProSendPhases).ToString());
            await SetOpt("EnableTarionFields", TarionEnabled.ToString());
            await SetOpt("BuildProWarrantyOwnerType", BuildProWarrantyOwnerType);
            await SetOpt("BuildProWarrantyCoOwnerType", BuildProWarrantyCoOwnerType);
            await SetOpt("ScheduleTemplates", ScheduleTemplates);
            await SetOpt("DefaultPurchasingManager", DefaultPurchasingManager); await SetOpt("FieldPOPrefix", FieldPOPrefix);
            await SetOpt("Detail_Description", FieldPOFields[0].ToString()); await SetOpt("Detail_Quantity", FieldPOFields[1].ToString());
            await SetOpt("Detail_Rate", FieldPOFields[2].ToString()); await SetOpt("Detail_Job", FieldPOFields[3].ToString());
            await SetOpt("Detail_Extra", FieldPOFields[4].ToString()); await SetOpt("Detail_CostCode", FieldPOFields[5].ToString());
            await SetOpt("Detail_Category", FieldPOFields[6].ToString()); await SetOpt("Detail_TaxGroup", FieldPOFields[7].ToString());
            await SetOpt("ViewPurchasingManagerDetailsForm", UseDetailedFieldPOView.ToString());
            await SetOpt("WebAttachmentsFolder", WebAttachmentsFolder);

            await db.ExecuteAsync("UPDATE divisions SET bookofaccount=@BookOfAccount WHERE divisionid=@DivisionID", new { BookOfAccount, DivisionID });

            // Divisions
            foreach (var div in Divisions)
                await db.ExecuteAsync("UPDATE divisions SET divisioncode=@Code, divisionname=@Company WHERE divisionid=@DivisionID", new { div.Code, div.Company, div.DivisionID });

            // Department Approvals
            await db.ExecuteAsync("DELETE FROM departmentapprovers WHERE deptid IN (SELECT deptid FROM departments WHERE divisionid=@DivisionID)", new { DivisionID });
            foreach (var dept in Departments)
            {
                if (dept.DeptID > 0)
                    await db.ExecuteAsync("UPDATE departments SET name=@Name WHERE deptid=@DeptID", new { dept.Name, dept.DeptID });
                int so = 0;
                foreach (var a in dept.Approvers)
                    await db.ExecuteAsync("INSERT INTO departmentapprovers(deptid,pm,supervisor,invoicelimit,sortorder) VALUES(@DeptID,@PM,@S,@L,@SO)",
                        new { dept.DeptID, a.PM, S=a.IsSupervisor, L=a.InvoiceLimit, SO=so++ });
            }

            // Document Classes
            await db.ExecuteAsync("DELETE FROM dms_documentclasses");
            foreach (var dc in DocumentClasses.Where(d => !string.IsNullOrWhiteSpace(d.DocumentClass)))
                await db.ExecuteAsync("INSERT INTO dms_documentclasses(documentclass,vendorvisible,customervisible) VALUES(@DocumentClass,@VendorVisible,@CustomerVisible)",
                    new { dc.DocumentClass, dc.VendorVisible, dc.CustomerVisible });

            ShowSaveConfirmDialog = true;
        }
        catch (Exception ex) { ErrorMessage = ex.Message; ShowErrorDialog = true; }
    }

