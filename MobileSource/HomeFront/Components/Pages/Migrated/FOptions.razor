        string Opt(string n) => opts.TryGetValue(n, out var v) ? v : "";
        string Sys(string n) => sys.TryGetValue(n, out var v) ? v?.ToString() ?? "" : "";
        bool OptBool(string n) => Opt(n).Equals("True", StringComparison.OrdinalIgnoreCase);
        bool SysBool(string n) { var v = Sys(n); return v == "1" || v.Equals("True", StringComparison.OrdinalIgnoreCase); }

