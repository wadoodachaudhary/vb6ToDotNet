@page "/web-export"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.IO
@using System.Text
@using System.Xml
@using System.Xml.Xsl
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FWebExport> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db
@layout HFComponent

<PageTitle>Transfering Data - HomeFront</PageTitle>

<div class="transfer-container">
    <div class="transfer-panel">
        @if (!ShowFail)
        {
            <div class="animation-area">
                @if (IsProcessing)
                {
                    <div class="progress-bar-container">
                        <div class="progress-bar-fill" style="width: @(ProgressPercent)%"></div>
                    </div>
                }
                else
                {
                    <span style="color: #6c757d;">Ready</span>
                }
            </div>
        }

        @if (ShowFail)
        {
            <div class="fail-panel">
                <span class="fail-icon">⚠️</span>
                <div class="fail-text">
                    <div class="fail-title">Data Transfer failed.</div>
                    <div>
                        Click <a @onclick="OnMoreInfoClick">info</a> for more details...
                    </div>
                </div>
            </div>
        }

        <div class="caption-label">@CaptionText</div>
        <div class="desc-label">@DescriptionText</div>

        @if (ShowErrorDetails && !string.IsNullOrEmpty(ErrorDetailText))
        {
            <div class="error-details">@ErrorDetailText</div>
        }

        @if (!IsProcessing)
        {
            <button class="btn-close-transfer" @onclick="OnCloseClick">Close</button>
        }
    </div>
</div>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    // === Database ===
// === UI State ===
    private bool IsProcessing = false;
    private bool ShowFail = false;
    private bool ShowErrorDetails = false;
    private int ProgressPercent = 0;
    private string CaptionText = "Initializing...";
    private string DescriptionText = "";
    private string ErrorDetailText = "";

    // === App Settings (would come from configuration/service in real app) ===
    private string AppWorkingFolder => Path.Combine(Path.GetTempPath(), "HomeFront", "Working");
    private string AppPath => AppDomain.CurrentDomain.BaseDirectory;

    // === Options (would come from app options service) ===
    private string BuilderCode = "";
    private string WebAdminUser = "";
    private string Country = "US";
    private string CompanyName = "";
    private bool IncludeTax = false;

    // === Public Methods ===

    /// <summary>
    /// Entry point: call WriteToWeb("Models") or WriteToWeb("") to begin export.
    /// </summary>
    public async Task WriteToWeb(string mode)
    {
        if (string.Equals(mode, "Models", StringComparison.OrdinalIgnoreCase))
        {
            await WriteTo1440(sendOptions: false);
        }
        else
        {
            await WriteTo1440(sendOptions: true);
        }
    }

    /// <summary>
    /// Downloads and processes data from the sales center (1440).
    /// </summary>
    public async Task<bool> ReadFrom1440(bool downloadNew)
    {
        try
        {
            if (!downloadNew)
            {
                var confirm = await Dialogs.ConfirmAsync(
                    "Holding the CTRL key prevents Precision Builder from retrieving new data from the sales center. " +
                    "It will simply reprocess the data that was most recently downloaded. " +
                    "This is only beneficial during system setup and integration testing.\n\n" +
                    "Is this what you want to do?");
                if (!confirm) return false;
            }

            SetCaptions("Initializing...", "");
            IsProcessing = true;
            await InvokeAsync(StateHasChanged);

            var workingDir = Path.Combine(AppWorkingFolder, "1440");
            Directory.CreateDirectory(workingDir);

            var srcFile = Path.Combine(workingDir, "1440Export.xml");
            var dstFile = Path.Combine(workingDir, "HFImport.xml");
            var trnFile = Path.Combine(workingDir, "transform.xsl");

            if (File.Exists(dstFile)) File.Delete(dstFile);
            if (File.Exists(trnFile)) File.Delete(trnFile);

            var xslSource = Path.Combine(AppPath, "1440transform.xsl");
            if (File.Exists(xslSource))
                File.Copy(xslSource, trnFile, true);

            if (downloadNew)
            {
                SetCaptions("Downloading information...", "");
                await InvokeAsync(StateHasChanged);

                if (File.Exists(srcFile)) File.Delete(srcFile);

                // FTP download would happen here
                // await FtpDownload("exports/BuilderExport.xml", srcFile);
                // await FtpDelete("exports/BuilderExport.xml");

                await Task.Delay(100); // Placeholder
            }

            if (!File.Exists(srcFile))
            {
                IsProcessing = false;
                await InvokeAsync(StateHasChanged);
                return false;
            }

            SetCaptions("Processing...", "");
            await InvokeAsync(StateHasChanged);

            // Load source and transform
            var xslTransform = new XslCompiledTransform();
            xslTransform.Load(trnFile);

            using var writer = new StringWriter();
            using var xmlReader = XmlReader.Create(srcFile);
            xslTransform.Transform(xmlReader, null, writer);
            var transformedXml = writer.ToString();

            // Save results to temp file for debug
            await File.WriteAllTextAsync(dstFile, transformedXml);

            // Send results to stored proc
            var sql = "exec importcustomer @XmlData";
            await db.ExecuteAsync(sql, new { XmlData = transformedXml });

            IsProcessing = false;
            await InvokeAsync(StateHasChanged);
            return true;
        }
        catch (Exception ex)
        {
            IsProcessing = false;

            if (ex.Message.Contains("550") && ex.Message.Contains("BuilderExport.xml"))
            {
                // File not found on server - not an error
                await InvokeAsync(StateHasChanged);
                return true;
            }
            else if (ex.Message.Contains("530") && ex.Message.Contains("Invalid userid/password"))
            {
                ShowFail = true;
                ErrorDetailText = "Invalid security context or password.\n\nPlease check your system settings.";
                Notifications.Error(ErrorDetailText);
            }
            else
            {
                ShowFail = true;
                ErrorDetailText = ex.Message;
                Notifications.Error(ex.Message);
            }

            await InvokeAsync(StateHasChanged);
            return false;
        }
    }

    // === Private Methods ===

    private async Task WriteTo1440(bool sendOptions = true)
    {
        try
        {
            IsProcessing = true;
            ShowFail = false;
            ShowErrorDetails = false;
            await InvokeAsync(StateHasChanged);

            if (!await Validate1440())
            {
                IsProcessing = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Check for release pricing
            var rc = 0;
            var rcDt = db.SqlExec("SELECT count(*) AS cnt FROM communityphase");
            if (rcDt.Rows.Count > 0)
                rc = Convert.ToInt32(rcDt.Rows[0]["cnt"]);
            bool useReleasePricing = rc != 0;

            // Load options
            bool bAppendUOM = GetOptionValue("AppendUOMtoOptionDesc") == "True";
            bool bUploadByCommunity = GetOptionValue("WebUploadByCommunity") != "False";
            bool bFilterByModels = GetOptionValue("WebUploadByModel") != "False";

            string sModels = "";
            if (bFilterByModels)
            {
                // In a real implementation, this would show a pick list dialog
                // For now, we skip model filtering
                bFilterByModels = false;
            }

            // Get division selections - in real implementation this would show a pick list
            // For now, load all divisions
            string divisionQuery;
            if (bUploadByCommunity)
            {
                divisionQuery = @"
                    SELECT d.divisionid, d.modifieddate, d.divisioncode AS Division,
                           d.divisionname AS DivisionDesc, c.area AS Community,
                           c.description AS CommunityDesc
                    FROM divisions d
                    JOIN divisioncommunities dc ON (d.divisionid = dc.divisionid)
                    JOIN tbllocality c ON (c.area = dc.community)";
            }
            else
            {
                divisionQuery = @"
                    SELECT d.divisionid, d.modifieddate, d.divisioncode AS Division,
                           d.divisionname AS DivisionDesc, '' AS Community
                    FROM divisions d";
            }

            var divisionsDt = db.SqlExec(divisionQuery);
            if (divisionsDt.Rows.Count == 0)
            {
                IsProcessing = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            var totalDivisions = divisionsDt.Rows.Count;
            var currentDivision = 0;

            foreach (DataRow divRow in divisionsDt.Rows)
            {
                currentDivision++;
                ProgressPercent = (int)((double)currentDivision / totalDivisions * 100);

                var ud = DateTime.Now;
                var divID = Convert.ToInt64(divRow["divisionid"]);
                var divCode = divRow["Division"]?.ToString() ?? "";
                var divName = divRow["DivisionDesc"]?.ToString() ?? "";
                var comID = divRow["Community"]?.ToString() ?? "";
                var ld = GetLastUpdate($"1440:{divID}:{comID}");
                var modDateStr = divRow["modifieddate"]?.ToString() ?? "";
                bool divChgd = false;
                if (DateTime.TryParse(modDateStr, out var modDate))
                    divChgd = modDate.Date >= ld;

                // Create working directory
                var workingDir = Path.Combine(AppWorkingFolder, "1440");
                Directory.CreateDirectory(workingDir);

                var fileName = CleanFileName((divCode + (bUploadByCommunity ? "_" + comID : "")).ToUpper()) + ".xml";
                var sFile = Path.Combine(workingDir, fileName);

                if (File.Exists(sFile))
                {
                    try { File.Delete(sFile); } catch { /* non-critical */ }
                }

                var sb = new StringBuilder();

                SetCaptions($"Preparing division {divCode}{(bUploadByCommunity ? $", community {comID}..." : "...")}", "");
                await InvokeAsync(StateHasChanged);

                // Build XML header
                sb.Append("<?xml version='1.0' encoding=\"UTF-8\" standalone=\"no\" ?>");
                sb.Append("<!DOCTYPE hasp SYSTEM \"file:/N:/opt/hasp/xml/hasp.dtd\">");
                sb.Append("<hasp>");
                sb.Append($"<builder action=\"update\" buildercode={XmlQuote(BuilderCode, true)} adminname={XmlQuote(WebAdminUser, true)} country={XmlQuote(Country, true)}>");
                sb.Append($"<name>{XmlQuote(CompanyName)}</name>");

                // Address (B)
                sb.Append(await SqlXML($"SELECT address1,address2,city,upper(province) state,zip postalcode,isnull(nullif(upper(country),''),'US') country FROM system_setup address WHERE id = {SessionState.DivisionID} FOR XML AUTO, ELEMENTS"));

                // Contact (C)
                sb.Append(await SqlXML($"SELECT contactperson name,phone,fax,email FROM system_setup contact WHERE id = {SessionState.DivisionID} FOR XML AUTO, ELEMENTS"));

                // Division (D)
                sb.Append("<division action=\"add\">");
                sb.Append($"<divisioncode>{XmlQuote(divCode)}</divisioncode>");
                sb.Append($"<name>{XmlQuote(divName)}</name>");

                // Option Types (EE)
                SetCaptions("", "Processing Option Types...");
                await InvokeAsync(StateHasChanged);
                var optTypeSql = BuildOptionTypesSql(divChgd, ld);
                sb.Append(await SqlXML(optTypeSql));

                // Option Categories (E)
                SetCaptions("", "Processing Option Categories...");
                await InvokeAsync(StateHasChanged);
                var optCatSql = BuildOptionCategoriesSql(divChgd, ld);
                sb.Append(await SqlXML(optCatSql));

                // Room Names (F)
                SetCaptions("", "Processing Room Names...");
                await InvokeAsync(StateHasChanged);
                var roomSql = BuildRoomNamesSql(divChgd, ld);
                sb.Append(await SqlXML(roomSql));

                // Construction Phases (G)
                SetCaptions("", "Processing Construction Phases...");
                await InvokeAsync(StateHasChanged);
                var phasesSql = BuildConstructionPhasesSql(divChgd, ld);
                sb.Append(await SqlXML(phasesSql));

                // Options (H)
                SetCaptions("", "Processing Options...");
                await InvokeAsync(StateHasChanged);
                var optionsSql = BuildOptionsSql(divChgd, ld, bAppendUOM);
                sb.Append(await SqlXML(optionsSql));

                // Series (I)
                SetCaptions("", "Processing Series...");
                await InvokeAsync(StateHasChanged);
                var seriesSql = BuildSeriesSql(divChgd, ld);
                sb.Append(await SqlXML(seriesSql));

                // Models (J)
                SetCaptions("", "Processing Models...");
                await InvokeAsync(StateHasChanged);
                var modelsSql = BuildModelsSql(divChgd, ld, sModels);
                sb.Append(await SqlXML(modelsSql));

                // Addon types (K)
                sb.Append("<addontype action=\"add\">");
                sb.Append("<divisionaddontypecode>PRKING</divisionaddontypecode>");
                sb.Append("<name>Parking Space</name>");
                sb.Append("<description>Parking Space</description>");
                sb.Append("</addontype>");

                sb.Append("<addontype action=\"add\">");
                sb.Append("<divisionaddontypecode>STOR</divisionaddontypecode>");
                sb.Append("<name>Storage Cabinet</name>");
                sb.Append("<description>Storage Cabinet</description>");
                sb.Append("</addontype>");

                // Community data (L) - this is the large community query
                SetCaptions("", "Querying Community...");
                await InvokeAsync(StateHasChanged);
                var communitySql = BuildCommunitySql(divID, divCode, comID, ld, divChgd,
                    bUploadByCommunity, useReleasePricing, sendOptions, sModels);

                // Save SQL for debugging
                var sqlFile = Path.Combine(workingDir, "HFExport.sql");
                await File.WriteAllTextAsync(sqlFile, communitySql);

                // Execute community query and build XML
                var rs = db.SqlExec(communitySql);
                int rowCount = 0;
                foreach (DataRow row in rs.Rows)
                {
                    rowCount++;
                    SetCaptions("", $"generating row {rowCount}");
                    await InvokeAsync(StateHasChanged);
                    sb.Append(CleanXML(row[0]?.ToString() ?? ""));
                }

                sb.Append("</division>");
                sb.Append("</builder>");
                sb.Append("</hasp>");

                SetCaptions("", "closing file...");
                await InvokeAsync(StateHasChanged);

                // Save to file
                var xmlContent = sb.ToString();

                // Strip removeme tags
                xmlContent = xmlContent.Replace("<removeme>", "").Replace("</removeme>", "");

                await File.WriteAllTextAsync(sFile, xmlContent, new UTF8Encoding(false));

                // FTP Upload
                SetCaptions("", "Transfering Data...");
                await InvokeAsync(StateHasChanged);

                var remoteFileName = (CleanFileName(divCode) +
                    (bUploadByCommunity ? "_" + CleanFileName(comID) : "") + ".xml").ToUpper();

                // In real implementation: await FtpStore(remoteFileName, sFile);
                await Task.Delay(100); // Placeholder

                SetLastUpdate($"1440:{divID}:{comID}", ud);
            }

            // Update tblmodels sentto1440 flag
            var updateSql = new StringBuilder();
            updateSql.AppendLine("UPDATE tblmodels SET SentTo1440=1");
            updateSql.AppendLine("WHERE isnull(inactive,0) = 0");
            updateSql.AppendLine("  AND isnull(SentTo1440,0)=0");
            if (!string.IsNullOrEmpty(sModels))
                updateSql.AppendLine($" AND model in({sModels})");
            await db.ExecuteAsync(updateSql.ToString());

            IsProcessing = false;
            CaptionText = "Transfer Complete";
            DescriptionText = "";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            IsProcessing = false;
            ShowFail = true;
            ErrorDetailText = ex.Message;
            CaptionText = "Transfer Failed";
            DescriptionText = ex.Message;
            Notifications.Error(ex.Message);
            await InvokeAsync(StateHasChanged);
        }
    }

    // === SQL Builder Methods ===

    private string BuildOptionTypesSql(bool divChgd, DateTime ld)
    {
        var s = new StringBuilder();
        s.AppendLine("SELECT 1 tag");
        s.AppendLine("      ,0 parent");
        s.AppendLine("      ,'add'       [optiontype!1!action]");
        s.AppendLine("      ,major_group [optiontype!1!optiontypecode!element]");
        s.AppendLine("      ,description [optiontype!1!description!element]");
        s.AppendLine("FROM tblmajorgroups");
        if (!divChgd) s.AppendLine($"WHERE modifieddate>='{ld:yyyy-MM-dd HH:mm:ss}'");
        s.AppendLine("FOR XML EXPLICIT");
        return s.ToString();
    }

    private string BuildOptionCategoriesSql(bool divChgd, DateTime ld)
    {
        var s = new StringBuilder();
        s.AppendLine("SELECT 1 tag");
        s.AppendLine("      ,0 parent");
        s.AppendLine("      ,'add'       [optioncategory!1!action]");
        s.AppendLine("      ,category    [optioncategory!1!optioncategorycode!element]");
        s.AppendLine("      ,description [optioncategory!1!description!element]");
        s.AppendLine("FROM tblcategories");
        if (!divChgd) s.AppendLine($"WHERE modifieddate>='{ld:yyyy-MM-dd HH:mm:ss}'");
        s.AppendLine("FOR XML EXPLICIT");
        return s.ToString();
    }

    private string BuildRoomNamesSql(bool divChgd, DateTime ld)
    {
        var s = new StringBuilder();
        s.AppendLine("SELECT 1 tag");
        s.AppendLine("      ,0 parent");
        s.AppendLine("      ,'add'       [room!1!action]");
        s.AppendLine("      ,area        [room!1!roomcode!element]");
        s.AppendLine("      ,description [room!1!roomname!element]");
        s.AppendLine("FROM tblareas");
        if (!divChgd) s.AppendLine($"WHERE modifieddate>='{ld:yyyy-MM-dd HH:mm:ss}'");
        s.AppendLine("FOR XML EXPLICIT");
        return s.ToString();
    }

    private string BuildConstructionPhasesSql(bool divChgd, DateTime ld)
    {
        var s = new StringBuilder();
        s.AppendLine("SELECT 1 tag");
        s.AppendLine("      ,0 parent");
        s.AppendLine("      ,'add'     [phase!1!action]");
        s.AppendLine("      ,1         [phase!1!phasecode!element]");
        s.AppendLine("      ,'construction' [phase!1!description!element]");
        s.AppendLine("      ,1         [phase!1!phasesequence!element]");
        s.AppendLine($"FROM system_setup LEFT OUTER JOIN tbljobstatus ON(1=1) WHERE tbljobstatus.job_status IS NULL AND system_setup.ID={SessionState.DivisionID}");
        s.AppendLine("UNION ALL");
        s.AppendLine("SELECT 1 tag");
        s.AppendLine("      ,0 parent");
        s.AppendLine("      ,'add'         [phase!1!action]");
        s.AppendLine("      ,job_status+1  [phase!1!phasecode!element]");
        s.AppendLine("      ,description [phase!1!description!element]");
        s.AppendLine("      ,(SELECT count(*) FROM tbljobstatus b WHERE b.job_status<=tbljobstatus.job_status) [phase!1!phasesequence!element]");
        s.AppendLine("FROM tbljobstatus");
        if (!divChgd) s.AppendLine($"WHERE modifieddate>='{ld:yyyy-MM-dd HH:mm:ss}'");
        s.AppendLine("FOR XML EXPLICIT");
        return s.ToString();
    }

    private string BuildOptionsSql(bool divChgd, DateTime ld, bool bAppendUOM)
    {
        var descExpr = bAppendUOM
            ? "left(o.description,242)+isnull(' ('+nullif(uom,'')+')','')         [option!1!shortdescription!element]"
            : "left(o.description,255)         [option!1!shortdescription!element]";

        var s = new StringBuilder();
        // tblOptions
        s.AppendLine("SELECT 1 tag, 0 parent");
        s.AppendLine("      ,'add'                         [option!1!action]");
        s.AppendLine("      ,opt                           [option!1!optioncode!element]");
        s.AppendLine("      ,isnull(c.Group_Code,'')      [option!1!optiontypecode!element]");
        s.AppendLine("      ,o.category                    [option!1!optioncategorycode!element]");
        s.AppendLine("      ,construction_cut_off+1        [option!1!phasecode!element]");
        s.AppendLine($"      ,{descExpr}");
        s.AppendLine("      ,''                            [option!1!longdescription!element]");
        s.AppendLine("      ,cast(max(price) as varchar)   [option!1!price!element]");
        s.AppendLine("      ,dbo.fn_Parse1440RoomsXML(location,';') [option!1!rooms!element]");
        s.AppendLine("FROM tblOptions o LEFT OUTER JOIN tblcategories c ON o.category=c.category");
        if (!divChgd) s.AppendLine($"WHERE o.modifieddate>='{ld:yyyy-MM-dd HH:mm:ss}'");
        s.AppendLine("GROUP BY opt,c.Group_Code,uom,o.category,construction_cut_off,o.description,cast(comments as varchar),dbo.fn_Parse1440RoomsXML(location,';')");

        // tblglobalOptions
        s.AppendLine("UNION");
        s.AppendLine("SELECT 1 tag, 0 parent");
        s.AppendLine("      ,'add'                         [option!1!action]");
        s.AppendLine("      ,opt                           [option!1!optioncode!element]");
        s.AppendLine("      ,isnull(c.Group_Code,'')      [option!1!optiontypecode!element]");
        s.AppendLine("      ,o.category                    [option!1!optioncategorycode!element]");
        s.AppendLine("      ,construction_cut_off+1        [option!1!phasecode!element]");
        s.AppendLine($"      ,{descExpr}");
        s.AppendLine("      ,''                            [option!1!longdescription!element]");
        s.AppendLine("      ,cast(max(price) as varchar)   [option!1!price!element]");
        s.AppendLine("      ,dbo.fn_Parse1440RoomsXML(location,';') [option!1!rooms!element]");
        s.AppendLine("FROM tblglobalOptions o LEFT OUTER JOIN tblcategories c ON o.category=c.category");
        if (!divChgd) s.AppendLine($"WHERE o.modifieddate>='{ld:yyyy-MM-dd HH:mm:ss}'");
        s.AppendLine("GROUP BY opt,c.Group_Code,uom,o.category,construction_cut_off,o.description,cast(comments as varchar),dbo.fn_Parse1440RoomsXML(location,';')");

        // tbldcOptions
        s.AppendLine("UNION");
        s.AppendLine("SELECT 1 tag, 0 parent");
        s.AppendLine("      ,'add'                         [option!1!action]");
        s.AppendLine("      ,opt                           [option!1!optioncode!element]");
        s.AppendLine("      ,isnull(c.Group_Code,'')      [option!1!optiontypecode!element]");
        s.AppendLine("      ,o.category                    [option!1!optioncategorycode!element]");
        s.AppendLine("      ,1                             [option!1!phasecode!element]");
        s.AppendLine($"      ,{(bAppendUOM ? "left(o.description,242)+isnull(' ('+nullif(uom,'')+')','')         [option!1!shortdescription!element]" : "left(o.description,255)         [option!1!shortdescription!element]")}");
        s.AppendLine("      ,''                            [option!1!longdescription!element]");
        s.AppendLine("      ,cast(max(item1) as varchar)   [option!1!price!element]");
        s.AppendLine("      ,dbo.fn_Parse1440RoomsXML(location,';') [option!1!rooms!element]");
        s.AppendLine("FROM tbldcOptions o LEFT OUTER JOIN tblcategories c ON o.category=c.category");
        if (!divChgd) s.AppendLine($"WHERE o.modifieddate>='{ld:yyyy-MM-dd HH:mm:ss}'");
        s.AppendLine("GROUP BY opt,c.Group_Code,uom,o.category,o.description,cast(comments as varchar),dbo.fn_Parse1440RoomsXML(location,';')");
        s.AppendLine("FOR XML EXPLICIT");
        return s.ToString();
    }

    private string BuildSeriesSql(bool divChgd, DateTime ld)
    {
        var s = new StringBuilder();
        s.AppendLine("SELECT 1 tag, 0 parent");
        s.AppendLine("      ,'add'       [series!1!action]");
        s.AppendLine("      ,series      [series!1!seriescode!element]");
        s.AppendLine("      ,description [series!1!seriesname!element]");
        s.AppendLine("      ,description [series!1!description!element]");
        s.AppendLine("FROM tblseries");
        if (!divChgd) s.AppendLine($"WHERE DivisionID = {SessionState.DivisionID} AND modifieddate>='{ld:yyyy-MM-dd HH:mm:ss}'");
        s.AppendLine("FOR XML EXPLICIT");
        return s.ToString();
    }

    private string BuildModelsSql(bool divChgd, DateTime ld, string sModels)
    {
        var s = new StringBuilder();
        s.AppendLine("SELECT 1 tag, 0 parent");
        s.AppendLine("      ,'add'            [plan!1!action]");
        s.AppendLine("      ,m.model          [plan!1!plancode!element]");
        s.AppendLine("      ,isnull(nullif(m.elevation,''),m.model)      [plan!1!elevationcode!element]");
        s.AppendLine("      ,m.series         [plan!1!seriescode!element]");
        s.AppendLine("      ,m.description    [plan!1!planelevationname!element]");
        s.AppendLine("      ,m.description    [plan!1!description!element]");
        s.AppendLine("      ,case when m.style in ('Single-Family','Condo','Townhouse') then m.style else 'Single-Family' end [plan!1!plantype!element]");
        s.AppendLine("      ,cast(m.modelsize as varchar) [plan!1!squarefootage!element]");
        s.AppendLine("      ,cast(m.base_house as varchar)     [plan!1!baseprice!element]");
        s.AppendLine("FROM tblmodels m");
        s.AppendLine("WHERE isnull(m.inactive,0) = 0");
        if (!divChgd)
            s.AppendLine($"AND (isnull(m.SentTo1440,0)=0 OR modifieddate>='{ld:yyyy-MM-dd HH:mm:ss}')");
        if (!string.IsNullOrEmpty(sModels))
            s.AppendLine($" AND m.model in({sModels})");
        s.AppendLine("FOR XML EXPLICIT");
        return s.ToString();
    }

    private string BuildCommunitySql(long divID, string divCode, string comID, DateTime ld,
        bool divChgd, bool bUploadByCommunity, bool useReleasePricing, bool sendOptions, string sModels)
    {
        var s = new StringBuilder();
        var divIdStr = divID.ToString();
        var comIdQuoted = $"'{comID.Replace("'", "''")}'";
        var divCodeQuoted = $"'{divCode.Replace("'", "''")}'";
        var ldQuoted = $"'{ld:yyyy-MM-dd HH:mm:ss}'";
