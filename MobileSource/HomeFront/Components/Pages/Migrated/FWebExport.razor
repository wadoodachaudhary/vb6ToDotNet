    }

    // === Last Update Tracking ===
    private DateTime GetLastUpdate(string key)
    {
        try
        {
            var dt = db.SqlExec(
                "SELECT LastUpdate FROM tblLastUpdate WHERE UpdateKey = @Key",
                new { Key = key });
            if (dt.Rows.Count > 0 && dt.Rows[0]["LastUpdate"] != DBNull.Value)
                return Convert.ToDateTime(dt.Rows[0]["LastUpdate"]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

        }
        return DateTime.MinValue;
    }

    private void SetLastUpdate(string key, DateTime value)
    {
        try
        {
            var existing = db.SqlExec(
                "SELECT COUNT(*) AS cnt FROM tblLastUpdate WHERE UpdateKey = @Key",
                new { Key = key });
            if (existing.Rows.Count > 0 && Convert.ToInt32(existing.Rows[0]["cnt"]) > 0)
            {
                db.SqlExec(
                    "UPDATE tblLastUpdate SET LastUpdate = @Value WHERE UpdateKey = @Key",
                    new { Key = key, Value = value });
            }
            else
            {
                db.SqlExec(
                    "INSERT INTO tblLastUpdate (UpdateKey, LastUpdate) VALUES (@Key, @Value)",
                    new { Key = key, Value = value });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

        }
    }

    // === Options Helper ===
    private string GetOptionValue(string name)
    {
        try
        {
            var dt = db.SqlExec("SELECT OptionValue FROM tblOptions_System WHERE OptionName = @Name",
                new { Name = name });
            if (dt.Rows.Count > 0)
                return dt.Rows[0]["OptionValue"]?.ToString() ?? "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error reading '{name}'");

        }
        return "";
    }

