     JOIN divisioncommunities div ON(div.community=c.area)
WHERE div.divisionid={divIdStr}
{comFilterLot}{(!divChgd ? $"  AND p.modifieddate>='{ld:yyyy-MM-dd HH:mm:ss}'\n" : "")}  AND isnull(c.inactive,0)=0
ORDER BY 5,3,17,20,21,22,26,34,55,1
FOR XML EXPLICIT");

        return s.ToString();
    }

    // === Helper Methods ===

    private async Task<string> SqlXML(string sql, string message = "")
    {
        try
        {
            var rs = db.SqlExec(sql);
            var sb = new StringBuilder();
            int i = 0;
            foreach (DataRow row in rs.Rows)
            {
                i++;
                if (!string.IsNullOrEmpty(message))
                {
                    SetCaptions("", $"{message}  (row {i})");
                    await InvokeAsync(StateHasChanged);
                }
                sb.Append(row[0]?.ToString() ?? "");
            }
            return CleanXML(sb.ToString());
        }
        catch
        {
            return "";
        }
    }

    private string XmlQuote(string text, bool quote = false)
    {
        if (string.IsNullOrEmpty(text)) return quote ? "\"\"" : "";

        var s = text;
        s = s.Replace("\0", "&#00;");
        s = s.Replace("\t", "&#09;");
        s = s.Replace("\n", "&#10;");
        s = s.Replace("\r", "&#13;");
        s = s.Replace("!", "&#33;");
        s = s.Replace("\"", "&#34;");
        s = s.Replace("#", "&#35;");
        s = s.Replace("$", "&#36;");
        s = s.Replace("%", "&#37;");
        s = s.Replace("&", "&#38;");
        s = s.Replace("'", "&#39;");
        s = s.Replace("*", "&#42;");
        s = s.Replace("+", "&#43;");
        s = s.Replace(":", "&#58;");
        s = s.Replace(";", "&#59;");
        s = s.Replace("<", "&#60;");
        s = s.Replace(">", "&#62;");
        s = s.Replace("?", "&#63;");
        s = s.Replace("^", "&#94;");
        s = s.Replace("`", "&#96;");
        s = s.Replace("{", "&#123;");
        s = s.Replace("}", "&#125;");
        s = s.Replace("|", "&#124;");
        s = s.Replace("~", "&#126;");

        if (quote) s = "\"" + s + "\"";
        return s;
    }

    private string CleanXML(string s)
    {
        // In the VB6 code, CleanXML returns the input unchanged (exits immediately).
        return s;
    }

    private string CleanFileName(string s)
    {
        if (string.IsNullOrEmpty(s)) return "";
        s = s.Replace(" ", "");
        s = s.Replace("\\", "");
        s = s.Replace("/", "");
        s = s.Replace(":", "");
        s = s.Replace("*", "");
        s = s.Replace("?", "");
        s = s.Replace("<", "");
        s = s.Replace(">", "");
        s = s.Replace("|", "");
        s = s.Replace("\"", "");
        return s;
    }

    private async Task<bool> Validate1440()
    {
        try
        {
            // Fix duplicate category descriptions
            var fixSql = @"
                UPDATE tblcategories
                SET description = a.description + isnull((SELECT ' '+cast(nullif(count(*),0) as varchar)
                    FROM tblcategories b WHERE a.description=b.description AND b.category<a.category),'')
                FROM tblcategories a";
            await db.ExecuteAsync(fixSql);

            // Check for data errors
            var rs = db.SqlExec("Purch_GetDataErrorsSummary");
            var errors = new StringBuilder();
            foreach (DataRow row in rs.Rows)
            {
                errors.AppendLine(row["description"]?.ToString() ?? "");
            }

            if (errors.Length == 0)
            {
                return true;
            }
            else
            {
                Notifications.Error($"Unable to post\n\n{errors}");
                return false;
            }
        }
        catch (Exception ex)
        {
            Notifications.Error($"Validation error: {ex.Message}");
            return false;
        }
    }

