@page "/bim-import"
@rendermode InteractiveServer
@namespace HomeFront.Components.Pages
@layout HFComponent

@using System
@using System.Data
@using System.IO
@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FBIMImport> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>Import BIM Assemblies - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Processing BIM Import...</div>
    </div>
}

<div class="wizard-container" style="position: relative;">

    <!-- Wizard Header -->
    <div class="wizard-header">
        <div class="wizard-header-icon">📦</div>
        <div class="wizard-header-text">
            <h3>Import Assemblies from BIM Pipeline</h3>
            <p>@WizardDescription</p>
        </div>
    </div>

    <!-- Step Indicator -->
    <div style="padding: 12px 24px; background: #f8f9fa; border: 1px solid #dee2e6; border-top: none;">
        <div class="step-indicator">
            <span class="step @(GetStepClass(0))">Upload</span>
            @if (!IsModelFile)
            {
                <span class="step @(GetStepClass(1))">Conditions</span>
            }
            <span class="step @(GetStepClass(2))">Assemblies</span>
            <span class="step @(GetStepClass(3))">Building Phases</span>
            <span class="step @(GetStepClass(4))">Unknown Items</span>
            <span class="step @(GetStepClass(5))">Finish</span>
        </div>
    </div>

    <!-- Wizard Body -->
    <div class="wizard-body">

        @if (CurrentStep == WizardStep.Upload)
        {
            <div class="file-upload-area" @onclick="OnSelectFile">
                <p style="font-size: 48px; margin: 0;">📁</p>
                <p style="font-size: 16px; font-weight: 600;">Click to select a BIM Pipeline file</p>
                <p style="font-size: 13px; color: #6c757d;">Supported formats: CSV, XLS, XLSX</p>
                @if (!string.IsNullOrEmpty(SelectedFileName))
                {
                    <p style="color: #198754; font-weight: 600;">Selected: @SelectedFileName</p>
                }
            </div>
        }
        else if (CurrentStep == WizardStep.SizeErrors)
        {
            <p style="color: #dc3545; font-weight: 600;">
                This file contains data that exceeds HomeFront field sizes. Please shrink the data before importing.
            </p>
            <GridControl @ref="SizeErrorsGrid"
                    TValue="SizeErrorRow"
                    DataSource="@SizeErrorsData"
                    AllowSorting="true"
                    AllowResizing="true"
                    Height="400px">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(SizeErrorRow.SizeError)" HeaderText="Size Error" Width="600px" />
                </GridColumnsBase>
            </GridControl>
        }
        else if (CurrentStep == WizardStep.Conditions)
        {
            <p style="font-size: 13px; color: #546e7a; margin-bottom: 12px;">
                Check the conditions you would like to include in the import.
            </p>
            <GridControl @ref="ConditionsGrid"
                    TValue="ConditionRow"
                    DataSource="@ConditionsData"
                    AllowSorting="true"
                    AllowResizing="true"
                    AllowSelection="true"
                    Height="400px"
                    EditSettingsRef="@conditionsEditSettings"
                    EventsRef="@conditionsGridEvents">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(ConditionRow.DependentCondition)" HeaderText="Dependent Condition"
                                  Width="400px" AllowEditing="false" IsPrimaryKey="true" />
                    <GridColumn Field="@nameof(ConditionRow.Include)" HeaderText="Include"
                                  Width="100px" Type="ColumnType.CheckBox" />
                </GridColumnsBase>
            </GridControl>
        }
        else if (CurrentStep == WizardStep.Assemblies)
        {
            <p style="font-size: 13px; color: #546e7a; margin-bottom: 12px;">
                Step 1 - These are the assemblies you are about to import. Please verify that they are correct.
            </p>
            <GridControl @ref="AssembliesGrid"
                    TValue="AssemblyRow"
                    DataSource="@AssembliesData"
                    AllowSorting="true"
                    AllowResizing="true"
                    AllowSelection="true"
                    Height="400px"
                    EditSettingsRef="@assembliesEditSettings"
                    EventsRef="@assembliesGridEvents">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(AssemblyRow.Model)" HeaderText="Model" Width="120px"
                                  AllowEditing="false" IsPrimaryKey="true" />
                    <GridColumn Field="@nameof(AssemblyRow.OptionID)" HeaderText="Option ID" Width="120px"
                                  AllowEditing="false" Visible="@(!IsModelFile)" />
                    <GridColumn Field="@nameof(AssemblyRow.Description)" HeaderText="Description" Width="250px" />
                    <GridColumn Field="@nameof(AssemblyRow.Series)" HeaderText="Series" Width="120px">
                        <EditTemplate>
                            @{
                                var data = (AssemblyRow)context;
                                <div style="display:flex; align-items:center; gap:4px;">
                                    <input type="text" @bind="data.Series" style="flex:1; padding:4px;" />
                                    <button style="padding:2px 8px; border:1px solid #ced4da; border-radius:3px; background:#fff; cursor:pointer;"
                                            @onclick="() => OnPickSeries(data)">...</button>
                                </div>
                            }
                        </EditTemplate>
                    </GridColumn>
                    <GridColumn Field="@nameof(AssemblyRow.FloorArea)" HeaderText="Floor Area" Width="100px"
                                  Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(AssemblyRow.Bedrooms)" HeaderText="Bedrooms" Width="100px"
                                  Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(AssemblyRow.Bathrooms)" HeaderText="Bathrooms" Width="100px"
                                  Type="ColumnType.Number" Format="N1" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(AssemblyRow.Style)" HeaderText="Style" Width="150px" />
                    <GridColumn Field="@nameof(AssemblyRow.AssemblyType)" HeaderText="Type" Width="80px"
                                  Visible="false" />
                </GridColumnsBase>
            </GridControl>
        }
        else if (CurrentStep == WizardStep.BuildingPhases)
        {
            <p style="font-size: 13px; color: #546e7a; margin-bottom: 12px;">
                Step 2 - Mark any BIM Pipeline building phases that you don't want to import into HomeFront.
            </p>
            <GridControl @ref="BuildingPhasesGrid"
                    TValue="BuildingPhaseRow"
                    DataSource="@BuildingPhasesData"
                    AllowSorting="true"
                    AllowResizing="true"
                    AllowSelection="true"
                    Height="400px"
                    EditSettingsRef="@buildingPhasesEditSettings"
                    EventsRef="@buildingPhasesGridEvents">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(BuildingPhaseRow.BuildingPhase)" HeaderText="Building Phase"
                                  Width="400px" AllowEditing="false" IsPrimaryKey="true" />
                    <GridColumn Field="@nameof(BuildingPhaseRow.Ignore)" HeaderText="Ignore"
                                  Width="100px" Type="ColumnType.CheckBox" />
                </GridColumnsBase>
            </GridControl>
        }
        else if (CurrentStep == WizardStep.UnknownItems)
        {
            <p style="font-size: 13px; color: #546e7a; margin-bottom: 12px;">
                @if (EditItemDB)
                {
                    <text>Step 3 - These items don't exist in your HomeFront item database. Skip them, create new items, or map to an existing item?</text>
                }
                else
                {
                    <text>Step 3 - These items don't exist in your HomeFront item database. They cannot be imported. You must correct the import file or skip these items.</text>
                }
            </p>
            <GridControl @ref="UnknownItemsGrid"
                    TValue="UnknownItemRow"
                    DataSource="@UnknownItemsData"
                    AllowSorting="true"
                    AllowResizing="true"
                    AllowSelection="true"
                    Height="400px"
                    EditSettingsRef="@unknownItemsEditSettings"
                    EventsRef="@unknownItemsGridEvents">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(UnknownItemRow.Skip)" HeaderText="Skip" Width="70px"
                                  Type="ColumnType.CheckBox" />
                    <GridColumn Field="@nameof(UnknownItemRow.Create)" HeaderText="Create" Width="70px"
                                  Type="ColumnType.CheckBox" Visible="@EditItemDB" />
                    <GridColumn Field="@nameof(UnknownItemRow.Map)" HeaderText="Map" Width="70px"
                                  Type="ColumnType.CheckBox" Visible="@EditItemDB" />
                    <GridColumn Field="@nameof(UnknownItemRow.BuildingPhase)" HeaderText="Building Phase"
                                  Width="150px" AllowEditing="false" IsPrimaryKey="true" />
                    <GridColumn Field="@nameof(UnknownItemRow.Product)" HeaderText="Product" Width="120px"
                                  AllowEditing="false" />
                    <GridColumn Field="@nameof(UnknownItemRow.POIndex)" HeaderText="PO Index" Width="100px">
                        <EditTemplate>
                            @{
                                var data = (UnknownItemRow)context;
                                <div style="display:flex; align-items:center; gap:4px;">
                                    <input type="text" @bind="data.POIndex" style="flex:1; padding:4px;" />
                                    <button style="padding:2px 8px; border:1px solid #ced4da; border-radius:3px; background:#fff; cursor:pointer;"
                                            @onclick="() => OnPickPOIndex(data)">...</button>
                                </div>
                            }
                        </EditTemplate>
                    </GridColumn>
                    <GridColumn Field="@nameof(UnknownItemRow.Phase)" HeaderText="Phase" Width="100px">
                        <EditTemplate>
                            @{
                                var data = (UnknownItemRow)context;
                                <div style="display:flex; align-items:center; gap:4px;">
                                    <input type="text" @bind="data.Phase" style="flex:1; padding:4px;" />
                                    <button style="padding:2px 8px; border:1px solid #ced4da; border-radius:3px; background:#fff; cursor:pointer;"
                                            @onclick="() => OnPickPhase(data)">...</button>
                                </div>
                            }
                        </EditTemplate>
                    </GridColumn>
                    <GridColumn Field="@nameof(UnknownItemRow.Item)" HeaderText="Item" Width="120px"
                                  Visible="@EditItemDB">
                        <EditTemplate>
                            @{
                                var data = (UnknownItemRow)context;
                                <div style="display:flex; align-items:center; gap:4px;">
                                    <input type="text" @bind="data.Item" style="flex:1; padding:4px;" />
                                    <button style="padding:2px 8px; border:1px solid #ced4da; border-radius:3px; background:#fff; cursor:pointer;"
                                            @onclick="() => OnPickItem(data)">...</button>
                                </div>
                            }
                        </EditTemplate>
                    </GridColumn>
                    <GridColumn Field="@nameof(UnknownItemRow.Description)" HeaderText="Description" Width="200px" />
                    <GridColumn Field="@nameof(UnknownItemRow.TakeoffUnit)" HeaderText="Takeoff Unit" Width="100px" />
                </GridColumnsBase>
            </GridControl>
        }
        else if (CurrentStep == WizardStep.Finish)
        {
            <div class="finish-panel">
                <div class="finish-icon">✅</div>
                <div class="finish-text">
                    <p><strong>The BIM Pipeline import is ready to proceed.</strong></p>
                    <p>This process will import <strong>@AssemblyCount</strong> assemblies into HomeFront's database.
                        If they already exist they will be completely replaced with the BIM version.
                        Once completed this import is irreversible and cannot be undone.</p>
                    <p><strong>Are you sure you would like to proceed?</strong></p>
                </div>
            </div>
        }
    </div>

    <!-- Wizard Footer -->
    <div class="wizard-footer">
        @if (CurrentStep == WizardStep.SizeErrors)
        {
            <ButtonControl CssClass="btn-danger" OnClick="OnCancel">Close</ButtonControl>
        }
        else
        {
            @if (ShowNextButton)
            {
                <ButtonControl CssClass="btn-primary" OnClick="OnNext">
                    @(CurrentStep == WizardStep.Finish ? "Save" : "Next")
                </ButtonControl>
            }
            <ButtonControl OnClick="OnCancel">Cancel</ButtonControl>
        }
    </div>
</div>

<!-- Pick List Dialog -->
<DialogControl @bind-Visible="IsPickListVisible"
               Header="@PickListTitle"
               Width="700px"
               IsModal="true">
    <ChildContent>
        <GridControl TValue="PickListItem"
                DataSource="@PickListData"
                AllowSorting="true"
                AllowFiltering="true"
                AllowSelection="true"
                Height="400px"
                FilterSettingsRef="@pickListFilterSettings">
            <GridColumnsBase>
                @foreach (var col in PickListColumns)
                {
                    <GridColumn Field="@col.Field" HeaderText="@col.Header" Width="@col.Width" />
                }
            </GridColumnsBase>
        </GridControl>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="btn-primary" OnClick="OnPickListSelect">Select</ButtonControl>
        <ButtonControl OnClick="@(() => IsPickListVisible = false)">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    // === Constants ===
    private const string SRCFILE = "FBIMImport::";

    // === Database ===
// === State ===
    private string SessionCode = "";
    private bool IsLoading = false;
    private bool IsModelFile = false;
    private bool EditItemDB = false;
    private bool ShowNextButton = true;
    private string WizardDescription = "Select a BIM Pipeline file to import.";
    private string SelectedFileName = "";
    private int AssemblyCount = 0;

    // === Wizard Steps ===
    private enum WizardStep
    {
        Upload,
        SizeErrors,
        Conditions,
        Assemblies,
        BuildingPhases,
        UnknownItems,
        Finish
    }

    private WizardStep CurrentStep = WizardStep.Upload;

    // === Grid Refs ===
    private GridControl<SizeErrorRow>? SizeErrorsGrid;
    private GridControl<ConditionRow>? ConditionsGrid;
    private GridControl<AssemblyRow>? AssembliesGrid;
    private GridControl<BuildingPhaseRow>? BuildingPhasesGrid;
    private GridControl<UnknownItemRow>? UnknownItemsGrid;

    // === Grid Data ===
    private List<SizeErrorRow> SizeErrorsData = new();
    private List<ConditionRow> ConditionsData = new();
    private List<AssemblyRow> AssembliesData = new();
    private List<BuildingPhaseRow> BuildingPhasesData = new();
    private List<UnknownItemRow> UnknownItemsData = new();

    // === Grid Settings ===
    private EditSettings conditionsEditSettings = new() { AllowEditing = true, AllowEditOnDblClick = true };
    private EditSettings assembliesEditSettings = new() { AllowEditing = true, AllowEditOnDblClick = true };
    private EditSettings buildingPhasesEditSettings = new() { AllowEditing = true, AllowEditOnDblClick = true };
    private EditSettings unknownItemsEditSettings = new() { AllowEditing = true, AllowEditOnDblClick = true };

    private GridControlEvents<ConditionRow> conditionsGridEvents = new();
    private GridControlEvents<AssemblyRow> assembliesGridEvents = new();
    private GridControlEvents<BuildingPhaseRow> buildingPhasesGridEvents = new();
    private GridControlEvents<UnknownItemRow> unknownItemsGridEvents = new();

    // === Pick List ===
    private bool IsPickListVisible = false;
    private string PickListTitle = "";
    private List<PickListItem> PickListData = new();
    private List<PickListColumnDef> PickListColumns = new();
    private FilterSettings pickListFilterSettings = new() { Type = FilterType.FilterBar };
    private Action<PickListItem>? PickListCallback;

    // === Lifecycle ===
    protected override void OnInitialized()
    {
        SessionCode = Guid.NewGuid().ToString();

        conditionsGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<ConditionRow>>(this, (args) =>
        {
            if (args.Data != null) args.Data.IsDirty = true;
        });
        assembliesGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<AssemblyRow>>(this, (args) =>
        {
            if (args.Data != null)
            {
                args.Data.IsDirty = true;
                // VB6: FloorArea/Bedrooms/Bathrooms are numeric validated
                // VB6: Style/Series/FloorArea/Bedrooms/Bathrooms only editable for models (AssemblyType=0)
                if (args.Data.AssemblyType != "0")
                {
                    // Revert non-description edits for option rows
                    if (args.ColumnName != nameof(AssemblyRow.Description))
                    {
                        // The grid should prevent this, but enforce here too
                    }
                }
            }
        });
        buildingPhasesGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<BuildingPhaseRow>>(this, (args) =>
        {
            if (args.Data != null) args.Data.IsDirty = true;
        });
        unknownItemsGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<UnknownItemRow>>(this, (args) =>
        {
            if (args.Data != null)
            {
                args.Data.IsDirty = true;

                // Enforce mutual exclusivity of checkboxes (VB6 gData_ValidateEdit)
                if (args.ColumnName == nameof(UnknownItemRow.Skip) && args.Data.Skip)
                {
                    args.Data.Create = false;
                    args.Data.Map = false;
                }
                else if (args.ColumnName == nameof(UnknownItemRow.Create) && args.Data.Create)
                {
                    args.Data.Skip = false;
                    args.Data.Map = false;
                }
                else if (args.ColumnName == nameof(UnknownItemRow.Map) && args.Data.Map)
                {
                    args.Data.Skip = false;
                    args.Data.Create = false;
                }
                // VB6: Phase edit sets Create=true, Skip/Map=false
                else if (args.ColumnName == nameof(UnknownItemRow.Phase))
                {
                    args.Data.Map = false;
                    args.Data.Create = true;
                    args.Data.Skip = false;
                }
                // VB6: Item validation - ensure item ends with cost type, uppercase, max 16 chars
                else if (args.ColumnName == nameof(UnknownItemRow.Item))
                {
                    var item = (args.Data.Item ?? "").Trim();
                    if (!string.IsNullOrEmpty(item))
                    {
                        var validCostTypes = new[] { 'L', 'E', 'M', 'S', 'O' };
                        if (!validCostTypes.Contains(char.ToUpper(item[^1])))
                            item += "M";
                        // Ensure cost type is uppercase
                        item = item[..^1] + char.ToUpper(item[^1]);
                        // Max 16 chars
                        if (item.Length > 16)
                            item = item[..15] + item[^1];
                        args.Data.Item = item;
                    }
                    args.Data.Map = false;
                    args.Data.Create = true;
                    args.Data.Skip = false;
                }
            }
        });
    }

    // === Step Class Helper ===
    private string GetStepClass(int stepIndex)
    {
        var currentIndex = GetCurrentStepIndex();
        if (stepIndex < currentIndex) return "completed";
        if (stepIndex == currentIndex) return "active";
        return "";
    }

    private int GetCurrentStepIndex()
    {
        return CurrentStep switch
        {
            WizardStep.Upload => 0,
            WizardStep.SizeErrors => 0,
            WizardStep.Conditions => 1,
            WizardStep.Assemblies => 2,
            WizardStep.BuildingPhases => 3,
            WizardStep.UnknownItems => 4,
            WizardStep.Finish => 5,
            _ => 0
        };
    }

    // === File Selection ===
    private async Task OnSelectFile()
    {
        // VB6: check permissions first, before opening the file dialog
        var hasPermission = await CheckUserPermission("editassemblies");
        if (!hasPermission)
        {
            Notifications.Info("You don't have permissions to update assemblies. Contact an administrator to change your permissions.");
            return;
        }
        EditItemDB = await CheckUserPermission("edititemdb");

        // In Blazor we cannot use native file dialogs directly like VB6.
        // We simulate with a prompt. In production, use InputFile component.
        var fileName = await Dialogs.PromptAsync(
            "Enter the path to the BIM Pipeline file (CSV, XLS, or XLSX):");

        if (string.IsNullOrWhiteSpace(fileName)) return;

        SelectedFileName = fileName;

        IsLoading = true;
        StateHasChanged();

        try
        {
            await LoadFileAsync(fileName);
            await CheckSizeErrors();
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error loading file: {ex.Message}");
            Logger.LogError(ex, "[{SRCFILE}OnSelectFile]");

        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Load File into Staging ===
    private async Task LoadFileAsync(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLower().TrimStart('.');

        // Read CSV lines (VB6 converts XLS/XLSX to CSV first via SaveToCSV)
        string csvPath = fileName;
        // If not already CSV, the caller should convert. Here we assume CSV input.
        if (!File.Exists(csvPath))
            throw new FileNotFoundException($"File not found: {csvPath}");

        var lines = await File.ReadAllLinesAsync(csvPath);
        if (lines.Length < 2) return;

        // Parse header row to get column keys (VB6: remove spaces, dots, underscores)
        var headers = ParseCsvLine(lines[0]);
        var colKeys = new string[headers.Length];
        var colTypes = new string[headers.Length];

        // Determine if model file based on first header (VB6: "Plan Name")
        IsModelFile = headers[0].Replace("\uFEFF", "").Trim() == "Plan Name";

        for (int c = 0; c < headers.Length; c++)
        {
            var key = headers[c].Replace(" ", "").Replace(".", "").Replace("_", "").Replace("\uFEFF", "");
            if (key == "PlanNo") key = "PlanNumber";
            // v3 changes
            if (key == "ProductQty") key = "Qty";
            if (key == "TotalQty") key = "AdjustedQty";
            if (key == "WasteQty") key = "";
            if (key == "RoundingQty") key = "";

            colKeys[c] = key;

            // Set data types (VB6 logic)
            switch (key)
            {
                case "BasePrice": case "BasementSQF": case "FirstSQF": case "SecondSQF":
                case "HeatedSQF": case "TotalSQF": case "Stories": case "Bedrooms":
                case "Bathrooms": case "Qty": case "Waste": case "Accuracy": case "AdjustedQty":
                    colTypes[c] = "numeric";
                    break;
                case "Style":
                    colTypes[c] = "string:200";
                    break;
                case "Description":
                    colTypes[c] = IsModelFile ? "string:200" : "string:150";
                    break;
                default:
                    colTypes[c] = "string";
                    break;
            }
        }

        // Build column list for INSERT
        var tableName = IsModelFile ? "BIMImportModels" : "BIMImportDetails";
        var validCols = new List<int>();
        for (int c = 0; c < colKeys.Length; c++)
        {
            if (!string.IsNullOrEmpty(colKeys[c])) validCols.Add(c);
        }

        var colList = string.Join(",", validCols.Select(c => $"[{colKeys[c]}]"));

        // Batch insert rows (VB6 does batches of 150)
        const int batchSize = 150;
        var batch = new List<string>();

        for (int r = 1; r < lines.Length; r++)
        {
            var cells = ParseCsvLine(lines[r]);
            if (cells.Length == 0) continue;

            // VB6: skip rows where PlanNumber is empty
            var planIdx = Array.IndexOf(colKeys, "PlanNumber");
            if (planIdx >= 0 && planIdx < cells.Length && string.IsNullOrWhiteSpace(cells[planIdx]))
                continue;

            var vals = new List<string>();
            vals.Add(SessionState.DivisionID.ToString());
            vals.Add($"'{SessionCode.Replace("'", "''")}'");

            foreach (var c in validCols)
            {
                var val = c < cells.Length ? cells[c].Trim() : "";
                if (colTypes[c] == "numeric")
                {
                    if (decimal.TryParse(val, out var num))
                        vals.Add(num.ToString());
                    else
                        vals.Add("0");
                }
                else
                {
                    var maxLen = colTypes[c] switch
                    {
                        "string:200" => 200,
                        "string:150" => 150,
                        _ => 0
                    };
                    if (maxLen > 0 && val.Length > maxLen) val = val.Substring(0, maxLen);
                    vals.Add($"'{val.Replace("'", "''")}'");
                }
            }

            batch.Add($"({string.Join(",", vals)})");

            if (batch.Count >= batchSize)
            {
                var insertSql = $"INSERT INTO {tableName}(divisionid,sessioncode,{colList}) VALUES\n{string.Join(",\n", batch)}";
                await db.ExecuteAsync(insertSql);
                batch.Clear();
            }
        }

        // Insert remaining batch
        if (batch.Count > 0)
        {
            var insertSql = $"INSERT INTO {tableName}(divisionid,sessioncode,{colList}) VALUES\n{string.Join(",\n", batch)}";
            await db.ExecuteAsync(insertSql);
        }

        // VB6: extract models from details file
        if (!IsModelFile)
        {
            var baseModel = "BASE0100"; // VB6: HFApp.Options.ValueByName("BIMBaseModelNumber")
            try
            {
                var rows = await db.QueryAsync(
                    "SELECT TOP 1 ValueData FROM tblOptions WHERE ValueName='BIMBaseModelNumber'");
                if (rows.Any())
                    baseModel = rows.First()["ValueData"]?.ToString() ?? baseModel;
            }
            catch { /* non-critical */ }

            var extractSql = $@"
                INSERT INTO BIMImportModels(DivisionID, SessionCode, PlanName, PlanNumber, SalesHouseName, Description)
                SELECT TOP 1 x.divisionid, x.SessionCode, m.Assembly, m.Assembly, m.Assembly, m.Description
                FROM bimimportdetails x
                JOIN tbldbassemblymaster m ON m.assembly = x.PlanNumber AND AssemblyType = 0
                WHERE x.sessioncode = '{SessionCode.Replace("'", "''")}'
                AND x.Optionnumber = '{baseModel.Replace("'", "''")}'";
            try { await db.ExecuteAsync(extractSql); } catch { /* non-critical */ }
        }
    }

    // Helper to parse a CSV line respecting quoted fields
    private static string[] ParseCsvLine(string line)
    {
        var fields = new List<string>();
        bool inQuotes = false;
        var field = new System.Text.StringBuilder();

        for (int i = 0; i < line.Length; i++)
        {
            char c = line[i];
            if (c == '"')
            {
                inQuotes = !inQuotes;
            }
            else if (c == ',' && !inQuotes)
            {
                fields.Add(field.ToString());
                field.Clear();
            }
            else
            {
                field.Append(c);
            }
        }
        fields.Add(field.ToString());
        return fields.ToArray();
    }

    // === Check Size Errors ===
    private async Task CheckSizeErrors()
    {
        try
        {
            var sql = "SELECT SizeError FROM dbo.BIMImportSizeErrors WHERE sessioncode=@SessionCode";
            var dt = db.SqlExec(sql, new { SessionCode });

            if (dt.Rows.Count > 0)
            {
                SizeErrorsData = dt.AsEnumerable().Select(r => new SizeErrorRow
                {
                    SizeError = r["SizeError"]?.ToString() ?? ""
                }).ToList();

                WizardDescription = "This file contains data that exceeds HomeFront field sizes. Please shrink the data before importing.";
                ShowNextButton = false;
                CurrentStep = WizardStep.SizeErrors;
            }
            else
            {
                // No size errors, proceed to conditions or assemblies
                if (!IsModelFile)
                {
                    await LoadConditions();
                }
                else
                {
                    await LoadAssemblies();
                }
            }
        }
        catch
        {
            // If the size errors table doesn't exist or query fails, proceed
            if (!IsModelFile)
            {
                await LoadConditions();
            }
            else
            {
                await LoadAssemblies();
            }
        }
    }

    // === Load Conditions ===
    private async Task LoadConditions()
    {
        try
        {
            var sql = @"
                SELECT DISTINCT d.DependentCondition, 
                       CAST(CASE WHEN c.condition IS NULL THEN 0 ELSE 1 END AS BIT) AS Include
                FROM BIMImportDetails d
                LEFT OUTER JOIN BIMImportIncludedConditions c ON d.DependentCondition = c.Condition
                WHERE sessioncode = @SessionCode
                ORDER BY Include DESC, DependentCondition";

            var dt = db.SqlExec(sql, new { SessionCode });

            if (dt.Rows.Count > 0)
            {
                ConditionsData = dt.AsEnumerable().Select(r => new ConditionRow
                {
                    DependentCondition = r["DependentCondition"]?.ToString() ?? "",
                    Include = Convert.ToBoolean(r["Include"]),
                    IsDirty = false
                }).ToList();

                WizardDescription = "Which BIM Pipeline conditions would you like to import into HomeFront?";
                CurrentStep = WizardStep.Conditions;
            }
            else
            {
                await LoadAssemblies();
            }
        }
        catch
        {
            await LoadAssemblies();
        }
    }

    // === Save Conditions ===
    private async Task SaveConditions()
    {
        foreach (var row in ConditionsData.Where(r => r.IsDirty))
        {
            try
            {
                if (row.Include)
                {
                    var sql = "INSERT INTO BIMImportIncludedConditions(Condition) VALUES(@Condition)";
                    await db.ExecuteAsync(sql, new { Condition = row.DependentCondition });
                }
                else
                {
                    var sql = "DELETE BIMImportIncludedConditions WHERE Condition=@Condition";
                    await db.ExecuteAsync(sql, new { Condition = row.DependentCondition });
                }
            }
            catch { /* non-critical */ }
        }
    }

    // === Load Assemblies ===
    private async Task LoadAssemblies()
    {
        try
        {
            var sql = @"
                SELECT Model, OptionID, Description, Series, FloorArea, Bedrooms, Bathrooms, Style, AssemblyType
                FROM BIMImportAssemblyMasters
                WHERE sessioncode = @SessionCode
                ORDER BY Model, OptionID";

            var dt = db.SqlExec(sql, new { SessionCode });

            AssembliesData = dt.AsEnumerable().Select(r => new AssemblyRow
            {
                Model = r["Model"]?.ToString() ?? "",
                OptionID = r["OptionID"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? "",
                Series = r["Series"]?.ToString() ?? "",
                FloorArea = r["FloorArea"] != DBNull.Value ? Convert.ToDecimal(r["FloorArea"]) : 0,
                Bedrooms = r["Bedrooms"] != DBNull.Value ? Convert.ToDecimal(r["Bedrooms"]) : 0,
                Bathrooms = r["Bathrooms"] != DBNull.Value ? Convert.ToDecimal(r["Bathrooms"]) : 0,
                Style = r["Style"]?.ToString() ?? "",
                AssemblyType = r["AssemblyType"]?.ToString() ?? "0",
                IsDirty = false
            }).ToList();

            WizardDescription = "Step 1 - These are the assemblies you are about to import. Please verify that they are correct.";
            CurrentStep = WizardStep.Assemblies;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadAssemblies error");

            WizardDescription = "Step 1 - These are the assemblies you are about to import. Please verify that they are correct.";
            CurrentStep = WizardStep.Assemblies;
        }
    }

    // === Save Assemblies ===
    private async Task SaveAssemblies()
    {
        foreach (var row in AssembliesData.Where(r => r.IsDirty))
        {
            string sql;
            if (row.AssemblyType == "0")
            {
                sql = @"
                    UPDATE BIMImportModels
                    SET description=@Description, style=@Style, series=@Series,
                        totalsqf=@FloorArea, bedrooms=@Bedrooms, bathrooms=@Bathrooms
                    WHERE sessioncode=@SessionCode AND plannumber=@Model";
                await db.ExecuteAsync(sql, new
                {
                    row.Description, row.Style, row.Series,
                    row.FloorArea, row.Bedrooms, row.Bathrooms,
                    SessionCode, row.Model
                });
            }
            else
            {
                sql = @"
                    UPDATE BIMImportDetails
                    SET optiondescription=@Description
                    WHERE sessioncode=@SessionCode AND plannumber=@Model AND optionnumber=@OptionID";
                await db.ExecuteAsync(sql, new
                {
                    row.Description, SessionCode, row.Model, row.OptionID
                });
            }
        }
    }

