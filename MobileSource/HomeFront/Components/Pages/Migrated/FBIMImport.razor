    // === Load Unknown Items ===
    private async Task LoadUnknownItems()
    {
        try
        {
            var sql = @"
                SELECT DISTINCT Skip, [Create], Map, BuildingPhase, Product, POIndex, Phase, Item, Description, TakeoffUnit
                FROM BIMImportAssemblyDetails
                WHERE UnknownItem = 1 AND IgnoreBuildingPhase = 0 AND ISNULL(Skip, 0) = 0
                AND sessioncode = @SessionCode
                ORDER BY POIndex, Item";

            var dt = db.SqlExec(sql, new { SessionCode });

            if (dt.Rows.Count > 0)
            {
                UnknownItemsData = dt.AsEnumerable().Select(r => new UnknownItemRow
                {
                    Skip = r["Skip"] != DBNull.Value && Convert.ToBoolean(r["Skip"]),
                    Create = r["Create"] != DBNull.Value && Convert.ToBoolean(r["Create"]),
                    Map = r["Map"] != DBNull.Value && Convert.ToBoolean(r["Map"]),
                    BuildingPhase = r["BuildingPhase"]?.ToString() ?? "",
                    Product = r["Product"]?.ToString() ?? "",
                    POIndex = r["POIndex"]?.ToString() ?? "",
                    Phase = r["Phase"]?.ToString() ?? "",
                    Item = r["Item"]?.ToString() ?? "",
                    Description = r["Description"]?.ToString() ?? "",
                    TakeoffUnit = r["TakeoffUnit"]?.ToString() ?? "",
                    IsDirty = false
                }).ToList();

                WizardDescription = EditItemDB
                    ? "Step 3 - These items don't exist in your HomeFront item database. Skip them, create new items, or map to an existing item?"
                    : "Step 3 - These items don't exist in your HomeFront item database. They cannot be imported. You must correct the import file or skip these items.";
                CurrentStep = WizardStep.UnknownItems;
            }
            else
            {
                await GoToFinish();
            }
        }
        catch
        {
            await GoToFinish();
        }
    }

    // === Validate Unknown Items ===
    private async Task<bool> ValidateItems()
    {
        foreach (var row in UnknownItemsData)
        {
            if (row.Create)
            {
                if (string.IsNullOrWhiteSpace(row.POIndex) || string.IsNullOrWhiteSpace(row.Phase) || string.IsNullOrWhiteSpace(row.Item))
                {
                    Notifications.Info("POIndex, Phase, and Item are all required to create a new item.");
                    return false;
                }
            }
            else if (row.Map)
            {
                if (string.IsNullOrWhiteSpace(row.Phase) || string.IsNullOrWhiteSpace(row.Item))
                {
                    Notifications.Info("Phase and Item are required to map an item.");
                    return false;
                }
            }
        }
        return true;
    }

    // === Save Unknown Items ===
    private async Task SaveUnknownItems()
    {
        foreach (var row in UnknownItemsData.Where(r => r.IsDirty))
        {
            var sql = @"
                UPDATE BIMImportDetails
                SET map=@Map, skip=@Skip, [create]=@Create,
                    poindex=@POIndex, phase=@Phase, item=@Item,
                    description=@Description, unit=@TakeoffUnit
                WHERE sessioncode=@SessionCode
                AND buildingphase=@BuildingPhase AND product=@Product";
            await db.ExecuteAsync(sql, new
            {
                row.Map, row.Skip, row.Create,
                row.POIndex, row.Phase, row.Item,
                row.Description, row.TakeoffUnit,
                SessionCode, row.BuildingPhase, row.Product
            });
        }

        // Map items
        var mapSql = @"
            UPDATE tblphaseitem SET partnumber = d.product
            FROM bimimportassemblydetails d
            JOIN tblphaseitem i ON d.phase = i.phase AND d.item = i.item AND i.divisionid = @DivisionID
            WHERE d.sessioncode = @SessionCode
            AND d.unknownitem = 1 AND d.ignorebuildingphase = 0 AND d.map = 1";
        await db.ExecuteAsync(mapSql, new { SessionState.DivisionID, SessionCode });

        // Create items
        if (EditItemDB)
        {
            var createSql = @"
                INSERT INTO tblphaseitem(partnumber, poindex, Phase, ItemNumber, Item, CostCategory, Description,
                    OrderUOM, TakeoffUOM, ConversionFactor, WastePercent, RoundDir, Roundto, IsQuote, DivisionID)
                SELECT DISTINCT d.product, d.poindex, d.phase, LEFT(d.item, LEN(d.item)-1), d.item,
                    RIGHT(RTRIM(d.item), 1), d.Description, d.TakeoffUnit, d.TakeoffUnit, 1, 0, 0, 0, 0, @DivisionID
                FROM bimimportassemblydetails d
                WHERE d.sessioncode = @SessionCode
                AND d.unknownitem = 1 AND d.ignorebuildingphase = 0 AND d.[create] = 1";
            try
            {
                await db.ExecuteAsync(createSql, new { SessionState.DivisionID, SessionCode });
            }
            catch (Exception ex)
            {
                if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                {
                    Notifications.Error("Unable to create a new item because the phase/item number has already been used.\n\n" + ex.Message);
                }
                else throw;
            }
        }
    }

    // === Go to Finish ===
    private async Task GoToFinish()
    {
        try
        {
            var countResult = db.SqlExec(
                "SELECT COUNT(*) AS Cnt FROM bimimportassemblymasters WHERE sessioncode=@SessionCode",
                new { SessionCode });
            AssemblyCount = countResult.Rows.Count > 0 ? Convert.ToInt32(countResult.Rows[0]["Cnt"]) : 0;
        }
        catch
        {
            AssemblyCount = 0;
        }

        WizardDescription = "Ready to proceed.";
        CurrentStep = WizardStep.Finish;
    }

    // === Execute Final Import ===
    private async Task ExecuteImport()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var sql = "";

            // UPDATE EXISTING MASTERS
            sql += @"
                UPDATE tbldbassemblymaster
                SET description = CASE WHEN x.Description = '' THEN m.description ELSE x.Description END,
                    series = CASE WHEN x.Series = '' THEN m.series ELSE x.Series END,
                    floorarea = CASE WHEN ISNULL(x.FloorArea, 0) = 0 THEN m.floorarea ELSE ISNULL(x.FloorArea, 0) END,
                    bedrooms = CASE WHEN ISNULL(x.Bedrooms, 0) = 0 THEN m.bedrooms ELSE ISNULL(x.Bedrooms, 0) END,
                    bathrooms = CASE WHEN ISNULL(x.Bathrooms, 0) = 0 THEN m.bathrooms ELSE ISNULL(x.Bathrooms, 0) END,
                    style = CASE WHEN x.Style = '' THEN m.style ELSE x.Style END
                FROM bimimportassemblymasters x
                JOIN tbldbassemblymaster m ON m.community = '' AND m.assembly = x.assembly
                    AND m.model = x.model AND m.optionid = x.optionid AND m.divisionid = @DivisionID
                WHERE x.sessioncode = @SessionCode
            ";

            // CREATE NEW MASTERS
            sql += @"
                INSERT INTO tblDBAssemblyMaster(Community, Assembly, Description, OptionID, Model, Series,
                    AssemblyType, FloorArea, Bedrooms, Bathrooms, Style, DivisionID)
                SELECT '', x.Assembly, x.Description, x.OptionID, x.Model, x.Series, x.AssemblyType,
                    ISNULL(x.FloorArea, 0), ISNULL(x.Bedrooms, 0), ISNULL(x.Bathrooms, 0), x.Style, @DivisionID
                FROM bimimportassemblymasters x
                LEFT OUTER JOIN tbldbassemblymaster m ON m.community = '' AND m.assembly = x.assembly
                    AND m.model = x.model AND m.optionid = x.optionid AND m.divisionid = @DivisionID
                WHERE m.assembly IS NULL AND sessioncode = @SessionCode
            ";

            if (!IsModelFile)
            {
                // REMOVE ALL DETAILS
                sql += @"
                    DELETE tbldbassemblydetails
                    FROM bimimportassemblymasters x
                    JOIN tbldbassemblydetails m ON m.community = ''
                        AND m.assembly = x.assembly
                        AND m.model = CASE WHEN SUBSTRING(x.OptionID, 1, 4) = '9999' THEN '' ELSE x.model END
                        AND m.optionid = x.optionid
                        AND m.divisionid = @DivisionID
                    WHERE x.sessioncode = @SessionCode
                ";

                // CREATE NEW DETAILS
                sql += @"
                    INSERT INTO tbldbassemblydetails(Community, Assembly, Model, OptionID, Phase, Item,
                        TakeoffQty, OrderQty, POIndex, Notes, DivisionID, AssemblyID)
                    SELECT '', m.Assembly, m.Model, m.OptionID, d.Phase, d.Item, d.TakeoffQty, d.TakeoffQty,
                        d.POIndex, d.Notes, m.divisionid, m.AssemblyID
                    FROM bimimportassemblydetails d
                    JOIN tbldbassemblymaster m ON m.community = ''
                        AND m.assembly = d.assembly
                        AND m.model = CASE WHEN SUBSTRING(d.OptionID, 1, 4) = '9999' THEN '' ELSE d.model END
                        AND m.optionid = d.optionid
                        AND m.divisionid = ISNULL(d.divisionid, @DivisionID)
                    WHERE d.ignorebuildingphase = 0 AND ISNULL(d.skip, 0) = 0
                    AND d.sessioncode = @SessionCode
                ";
            }

            await db.ExecuteAsync(sql, new { SessionState.DivisionID, SessionCode });

            Notifications.Info("BIM import completed successfully.");
            await CleanupAndClose();
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
            {
                Notifications.Error("Unable to create a new item because the phase/item number has already been used.\n\n" + ex.Message);
            }
            else
            {
                Notifications.Info($"Error during import: {ex.Message}");
                Logger.LogError(ex, "[{SRCFILE}ExecuteImport]");

            }
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Cleanup ===
    private async Task CleanupAndClose()
    {
        try
        {
            var sql = @"
                DELETE BIMImportModels WHERE SessionCode = @SessionCode
                DELETE BIMImportDetails WHERE SessionCode = @SessionCode";
            await db.ExecuteAsync(sql, new { SessionCode });
        }
        catch { /* non-critical */ }

        ClosePage();
    }

    // === Navigation ===
    private async Task OnNext()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            switch (CurrentStep)
            {
                case WizardStep.Upload:
                    // File should already be selected and loaded
                    if (string.IsNullOrEmpty(SelectedFileName))
                    {
                        Notifications.Info("Please select a file first.");
                        return;
                    }
                    break;

                case WizardStep.Conditions:
                    await SaveConditions();
                    await LoadAssemblies();
                    break;

                case WizardStep.Assemblies:
                    await SaveAssemblies();
                    await LoadBuildingPhases();
                    break;

                case WizardStep.BuildingPhases:
                    await SaveBuildingPhases();
                    await LoadUnknownItems();
                    break;

                case WizardStep.UnknownItems:
                    if (!await ValidateItems()) return;
                    await SaveUnknownItems();
                    // Reload unknown items to check if any remain
                    await LoadUnknownItemsCheck();
                    break;

                case WizardStep.Finish:
                    await ExecuteImport();
                    break;
            }
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error: {ex.Message}");
            Logger.LogError(ex, "[{SRCFILE}OnNext]");

        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadUnknownItemsCheck()
    {
        try
        {
            var sql = @"
                SELECT COUNT(*) AS Cnt
                FROM BIMImportAssemblyDetails
                WHERE UnknownItem = 1 AND IgnoreBuildingPhase = 0 AND ISNULL(Skip, 0) = 0
                AND sessioncode = @SessionCode";
            var dt = db.SqlExec(sql, new { SessionCode });
            var count = dt.Rows.Count > 0 ? Convert.ToInt32(dt.Rows[0]["Cnt"]) : 0;

            if (count > 0)
            {
                // Still have unknown items, reload the grid
                await LoadUnknownItems();
            }
            else
            {
                await GoToFinish();
            }
        }
        catch
        {
            await GoToFinish();
        }
    }

    private async Task OnCancel()
    {
        await CleanupAndClose();
    }

    // === Permission Check ===
    private async Task<bool> CheckUserPermission(string permission)
    {
        try
        {
            var sql = @"SELECT COUNT(*) AS Cnt FROM tblUserPermissions
                        WHERE PermissionName = @Permission AND Allowed = 1";
            var dt = db.SqlExec(sql, new { Permission = permission });
            if (dt.Rows.Count > 0 && Convert.ToInt32(dt.Rows[0]["Cnt"]) > 0)
                return true;
            // Fallback: if the permission table doesn't have the entry, allow by default
            return await Task.FromResult(true);
        }
        catch
        {
            // If permission table doesn't exist or query fails, allow by default
            return true;
        }
    }

