@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject ILogger<FDuplicateItems> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer db

<DialogControl Visible="@IsVisible"
               Header="Duplicate Items"
               Width="560px"
               IsModal="false"
               ShowCloseIcon="false">
    <ChildContent>
        <div class="dialog-icon-row">
            <img src="images/32/duplicate.ico" alt="Duplicate" onerror="this.style.display='none'" />
            <div class="info-text">Make a copy of these items.</div>
        </div>

        <div class="form-field">
            <label>Phase</label>
            <DropDownListControl TValue="string" TItem="ComboItem"
                                 DataSource="@PhaseItems"
                                 TextFieldName="Text"
                                 ValueFieldName="Value"
                                 @bind-Value="SelectedPhase"
                                 Width="100%" />
        </div>

        <div class="checkbox-row">
            <CheckBoxControl @bind-Checked="Renumber" Label="Re-number the new items." />
        </div>

        <div class="sub-field">
            <label class="@(Renumber ? "" : "disabled-label")">Starting number</label>
            <TextBoxControl @bind-Value="StartNumber"
                            Enabled="@Renumber"
                            CssClass="@(Renumber ? "sub-input" : "sub-input sub-input-disabled")"
                            @onfocus="() => SelectAllText(nameof(StartNumber))" />
        </div>

        <div class="sub-field">
            <label class="@(Renumber ? "" : "disabled-label")">Increment By</label>
            <TextBoxControl @bind-Value="IncrementBy"
                            Enabled="@Renumber"
                            CssClass="@(Renumber ? "sub-input" : "sub-input sub-input-disabled")"
                            @onfocus="() => SelectAllText(nameof(IncrementBy))" />
        </div>

        <div class="checkbox-row">
            <CheckBoxControl @bind-Checked="ChangePO" Label="Change the PO index" />
        </div>

        <div class="form-field">
            <label></label>
            <DropDownListControl TValue="string" TItem="ComboItem"
                                 DataSource="@POIndexItems"
                                 TextFieldName="Text"
                                 ValueFieldName="Value"
                                 @bind-Value="SelectedPOIndex"
                                 Enabled="@ChangePO"
                                 Width="100%" />
        </div>
    </ChildContent>

    <FooterContent>
        <div class="dialog-footer">
            <ButtonControl BareStyle="true" CssClass="btn btn-primary" OnClick="OnOkClick">OK</ButtonControl>
            <ButtonControl BareStyle="true" CssClass="btn" OnClick="OnCancelClick">Cancel</ButtonControl>
        </div>
    </FooterContent>
</DialogControl>

@code {
    // === Parameters ===
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<bool> OnClosed { get; set; }
    [Parameter] public int DivisionID { get; set; } = 1;

    // === Database ===
// === Form State ===
    private bool mCancel = true;
    private string mWhereClause = "";

    private string SelectedPhase = "";
    private bool Renumber = false;
    private string StartNumber = "0010";
    private string IncrementBy = "10";
    private bool ChangePO = false;
    private string SelectedPOIndex = "";

    // === Combo Data ===
    private List<ComboItem> PhaseItems = new();
    private List<ComboItem> POIndexItems = new();

    // === Models ===
    public class ComboItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    // === Public API ===
    public async Task<bool> ShowForm(string whereClause)
    {
        mCancel = true;
        mWhereClause = whereClause;
        await LoadComboBoxes();
        IsVisible = true;
        await IsVisibleChanged.InvokeAsync(true);
        StateHasChanged();
        // Note: In Blazor we cannot block like VB6's vbModal.
        // The result is returned via the OnClosed callback.
        // Return value is set when OK/Cancel is clicked.
        return !mCancel;
    }

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        await LoadComboBoxes();
    }

    // === Load Combo Boxes ===
    private async Task LoadComboBoxes()
    {
        try
        {
            // Load PO Index
            var poSql = @"SELECT
                CASE WHEN poindex = description THEN poindex
                     ELSE poindex + ISNULL(' ' + NULLIF(description,''),'')
                END AS DisplayText,
                poindex AS Value
                FROM tblpoindex
                WHERE DivisionID = @DivisionID
                ORDER BY 1";
            var poRows = await db.QueryAsync(poSql, new { DivisionID });
            POIndexItems = poRows.Select(r => new ComboItem
            {
                Text = r["DisplayText"]?.ToString() ?? "",
                Value = r["Value"]?.ToString() ?? ""
            }).ToList();

            // Load Phases
            var phaseSql = @"SELECT
                ISNULL(phase,'') + ' - ' + ISNULL(description,'') AS DisplayText,
                phase AS Value
                FROM tblestphases
                WHERE DivisionID = @DivisionID AND groupphase = 0
                ORDER BY 1";
            var phaseRows = await db.QueryAsync(phaseSql, new { DivisionID });
            PhaseItems = phaseRows.Select(r => new ComboItem
            {
                Text = r["DisplayText"]?.ToString() ?? "",
                Value = r["Value"]?.ToString() ?? ""
            }).ToList();

            // Set defaults
            if (PhaseItems.Any())
                SelectedPhase = PhaseItems.First().Value;
            if (POIndexItems.Any())
                SelectedPOIndex = POIndexItems.First().Value;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FDuplicateItems.LoadComboBoxes error");

        }
    }

    // === Event Handlers ===
    private async Task OnOkClick()
    {
        if (await SaveData())
        {
            mCancel = false;
            IsVisible = false;
            await IsVisibleChanged.InvokeAsync(false);
            await OnClosed.InvokeAsync(true);
        }
    }

    private async Task OnCancelClick()
    {
        mCancel = true;
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnClosed.InvokeAsync(false);
    }

    // === Save Data ===
    private async Task<bool> SaveData()
    {
        double start = 0;
        double incr = 0;
        int i = 0;
        string itemFormat = "";
        try
        {
            var phase = SelectedPhase;
            var poIndex = SelectedPOIndex;
            if (!double.TryParse(StartNumber, out start))
            {
                Notifications.Info("Starting number must be numeric.");
                return false;
            }
            if (!double.TryParse(IncrementBy, out incr))
            {
                Notifications.Warning("Increment must be numeric.");
                return false;
            }

            // Calculate format
            var startDecimalPart = StartNumber.Contains('.') ? StartNumber.Split('.')[1].Trim() : "";
            var incrDecimalPart = IncrementBy.Contains('.') ? IncrementBy.Split('.')[1].Trim() : "";
            var decimals = Math.Max(startDecimalPart.Length, incrDecimalPart.Length);

            var startIntPart = StartNumber.Contains('.') ? StartNumber.Split('.')[0].Trim() : StartNumber.Trim();
            var incrIntPart = IncrementBy.Contains('.') ? IncrementBy.Split('.')[0].Trim() : IncrementBy.Trim();
            var digits = Math.Max(startIntPart.Length, incrIntPart.Length);

            itemFormat = new string('0', digits) + (decimals < 1 ? "" : ".") + new string('0', decimals);

            // Build where clause for select
            var whereCondition = !string.IsNullOrEmpty(mWhereClause)
                ? $"{mWhereClause} AND DivisionID = {DivisionID}"
                : $"DivisionID = {DivisionID}";

            var selectSql = $"SELECT * FROM tblPhaseItem WHERE {whereCondition} ORDER BY item";
            var rs = db.SqlExec(selectSql);

            i = 0;
            foreach (DataRow row in rs.Rows)
            {
                string item;
                string itemNumber;

                if (Renumber)
                {
                    item = (start + i * incr).ToString(itemFormat);
                    itemNumber = item;
                }
                else
                {
                    item = row["Item"]?.ToString() ?? "";
                    itemNumber = row["ItemNumber"]?.ToString() ?? "";
                }

                var costCategory = row["CostCategory"]?.ToString() ?? "";
                var itemKey = Renumber ? item + costCategory : item;

                var effectivePOIndex = ChangePO ? poIndex : (row["POIndex"]?.ToString() ?? "");

                var insertSql = @"INSERT INTO tblPhaseItem(
                    DivisionID, Phase, Item, ItemNumber, CostCategory, POIndex, PriceLink,
                    Description, Notes, JCCostCode, JCCategory, OrderUOM, TakeoffUOM,
                    ConversionFactor, Price, TaxGroup, WastePercent, RoundDir, RoundTo,
                    PhaseSortOrder, ItemSortOrder)
                    VALUES(
                    @DivisionID, @Phase, @Item, @ItemNumber, @CostCategory, @POIndex, @PriceLink,
                    @Description, @Notes, @JCCostCode, @JCCategory, @OrderUOM, @TakeoffUOM,
                    @ConversionFactor, @Price, @TaxGroup, @WastePercent, @RoundDir, @RoundTo,
                    @PhaseSortOrder, @ItemSortOrder)";

                await db.ExecuteAsync(insertSql, new
                {
                    DivisionID,
                    Phase = phase,
                    Item = itemKey,
                    ItemNumber = itemNumber,
                    CostCategory = costCategory,
                    POIndex = effectivePOIndex,
                    PriceLink = ToDecimalSafe(row["PriceLink"]),
                    Description = row["Description"]?.ToString() ?? "",
                    Notes = row["Notes"]?.ToString() ?? "",
                    JCCostCode = row["JCCostCode"]?.ToString() ?? "",
                    JCCategory = row["JCCategory"]?.ToString() ?? "",
                    OrderUOM = row["OrderUOM"]?.ToString() ?? "",
                    TakeoffUOM = row["TakeoffUOM"]?.ToString() ?? "",
                    ConversionFactor = ToDecimalSafe(row["ConversionFactor"]),
                    Price = ToDecimalSafe(row["Price"]),
                    TaxGroup = row["TaxGroup"]?.ToString() ?? "",
                    WastePercent = ToDecimalSafe(row["WastePercent"]),
                    RoundDir = ToDecimalSafe(row["RoundDir"]),
                    RoundTo = ToDecimalSafe(row["RoundTo"]),
                    PhaseSortOrder = ToDecimalSafe(row["Phase"]),
                    ItemSortOrder = ToDecimalSafe(row["ItemNumber"])
                });

                i++;
            }

            return true;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
            {
                // Match VB6: show the phase/item that caused the conflict
                var conflictPhase = SelectedPhase;
                var conflictItem = Renumber ? (start + i * incr).ToString(itemFormat) : "";
                Notifications.Info($"Precision Builder already has an item numbered {conflictPhase}/{conflictItem}. Please specify a different value.");
            }
            else
            {
                Logger.LogError(ex, "FDuplicateItems.SaveData error");

                Notifications.Error($"Error duplicating items: {ex.Message}");
            }
            return false;
        }
    }

    // === Validation Helpers ===
    private async Task SelectAllText(string fieldName)
    {
        // Select all text in the focused input (equivalent to VB6 SelectAll)
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "if(document.activeElement) document.activeElement.select()");
        }
        catch { /* non-critical */ }
    }

    private decimal ToDecimalSafe(object? val)
    {
        if (val == null || val == DBNull.Value) return 0;
        var s = val.ToString() ?? "";
        return decimal.TryParse(s, out var result) ? result : 0;
    }
}
