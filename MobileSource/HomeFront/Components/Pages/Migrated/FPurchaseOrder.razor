    private void OpenComments(PoCommentsTarget target, string current, string title, int maxLen)
    {
        _commentsTarget   = target;
        _commentsBuffer   = current ?? "";
        _commentsTitle    = title;
        _commentsMaxLength = maxLen;
        _commentsVisible  = true;
    }

    private void OnCommentsSaved()
    {
        var v = _commentsBuffer ?? "";
        switch (_commentsTarget)
        {
            case PoCommentsTarget.Description:  PODescription = v; break;
            case PoCommentsTarget.StandardText: StandardText  = v; break;
            case PoCommentsTarget.Terms:        Terms         = v; break;
        }
        Dirty = true;
    }

    private async Task<bool> ConfirmSaveIfDirty()
    {
        if (!Dirty) return true;
        var confirm = await Dialogs.ConfirmAsync("This data has changed. Save changes?");
        if (!confirm) return true;
        return await SaveDataAsync();
    }

    private static double ToDouble(object? o)
    {
        if (o == null || o == DBNull.Value) return 0;
        return Convert.ToDouble(o, CultureInfo.InvariantCulture);
    }

