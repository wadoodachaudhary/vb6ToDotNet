    private async Task LoadPOAsync()
    {
        try
        {
            var sql = @"
                SELECT p.PONumber, p.PODate, p.POIndex, p.Job, p.Vendor, v.Vendor_Name, p.Description,
                       p.StandardText, p.DeliveryRecipient, p.DeliveryAddress, p.DueDate, p.ShipVia, p.FOB,
                       p.Terms, p.OrderedBy, p.RetainagePercent, p.Status, p.ApprovedBy, p.ApprovedDate
                  FROM POMaster p
                  LEFT JOIN tblVendors v ON p.Vendor = v.Vendor_ID AND p.DivisionID = v.DivisionID
                 WHERE p.DivisionID = @DivisionID AND p.PONumber = @PONumber AND p.Cancelled = 0";
            var rows = await db.QueryAsync(sql, new { DivisionID = Session.DivisionID, PONumber });

            if (!rows.Any())
            {
                Notifications.Warning("Purchase order not found.");
                return;
            }

            var row = rows.First();
            VendorId          = row["Vendor"]?.ToString() ?? "";
            VendorName        = row["Vendor_Name"]?.ToString() ?? "";
            DateIssued        = row["PODate"] as DateTime?;
            DateDue           = row["DueDate"] as DateTime?;
            POIndex           = row["POIndex"]?.ToString() ?? "";
            PODescription     = row["Description"]?.ToString() ?? "";
            StandardText      = row["StandardText"]?.ToString() ?? "";
            ShipVia           = row["ShipVia"]?.ToString() ?? "";
            FOB               = row["FOB"]?.ToString() ?? "";
            Terms             = row["Terms"]?.ToString() ?? "";
            OrderedBy         = row["OrderedBy"]?.ToString() ?? "";
            DeliveryRecipient = row["DeliveryRecipient"]?.ToString() ?? "";
            DeliveryAddress   = row["DeliveryAddress"]?.ToString() ?? "";
            Job               = row["Job"]?.ToString() ?? "";
            RetainagePercent  = Convert.ToDecimal(row["RetainagePercent"] ?? 0);

            var status = row["Status"]?.ToString() ?? "";
            if (string.Equals(status, "Pending", StringComparison.OrdinalIgnoreCase))
            {
                ApprovalRequired = true;
                ApprovalText = "APPROVAL REQUIRED";
            }
            else
            {
                ApprovalRequired = false;
                var ab = row["ApprovedBy"]?.ToString() ?? "";
                var ad = row["ApprovedDate"] as DateTime?;
                ApprovalText = string.IsNullOrEmpty(ab)
                    ? ""
                    : $"Approved by {ab}: {(ad.HasValue ? ad.Value.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) : "")}";
            }

            await LoadVendorAsync(VendorId);

            Items.Clear();
            var itemsSql = @"
                SELECT ItemSeq, Description, Comments, OrderQty, OrderUOM, TakeoffQty, TakeoffUOM, Rate, Pretax,
                       TaxGroup, JCTax, JCTaxRate, NJCTax, NJCTaxRate, Job, JCExtra, JCCostCode, JCCategory,
                       EstPhase, EstItem, EstItemID
                  FROM POItems
                 WHERE DivisionID = @DivisionID AND PONumber = @PONumber
                 ORDER BY ItemSeq";
            var itemRows = await db.QueryAsync(itemsSql, new { DivisionID = Session.DivisionID, PONumber });
            foreach (var ir in itemRows)
            {
                var item = new PurchaseOrderItem
                {
                    Seq         = Convert.ToInt32(ir["ItemSeq"] ?? 0),
                    Description = ir["Description"]?.ToString() ?? "",
                    Comments    = ir["Comments"]?.ToString() ?? "",
                    OrderQty    = ToDouble(ir["OrderQty"]),
                    OrderUOM    = ir["OrderUOM"]?.ToString() ?? "",
                    TakeoffQty  = ToDouble(ir["TakeoffQty"]),
                    TakeoffUOM  = ir["TakeoffUOM"]?.ToString() ?? "",
                    Rate        = ToDouble(ir["Rate"]),
                    Pretax      = ToDouble(ir["Pretax"]),
                    TaxGroup    = ir["TaxGroup"]?.ToString() ?? "",
                    JCTax       = ToDouble(ir["JCTax"]),
                    JCTaxRate   = ToDouble(ir["JCTaxRate"]),
                    NJCTax      = ToDouble(ir["NJCTax"]),
                    NJCTaxRate  = ToDouble(ir["NJCTaxRate"]),
                    Job_No      = ir["Job"]?.ToString() ?? "",
                    JCExtra     = ir["JCExtra"]?.ToString() ?? "",
                    JCCostCode  = ir["JCCostCode"]?.ToString() ?? "",
                    JCCategory  = ir["JCCategory"]?.ToString() ?? "",
                    EstPhase    = ir["EstPhase"]?.ToString() ?? "",
                    EstItem     = ir["EstItem"]?.ToString() ?? "",
                    EstItemID   = Convert.ToInt64(ir["EstItemID"] ?? 0)
                };
                RecalculateItem(item);
                item.RowState = RowState.Unchanged;
                Items.Add(item);
            }

            if (!Items.Any()) Items.Add(new PurchaseOrderItem());
            CalculateTotals();
            FieldsLocked = false;
            IsNew = false;
            Dirty = false;
        }
        catch (Exception ex)
        {
            _lastError = $"LoadPO error: {ex.Message}";
            Logger.LogError(ex, "LoadPOAsync failed");
        }
    }

    private async Task OnSave()
    {
        var ok = await SaveDataAsync();
        if (ok) Notifications.Success("Purchase order saved.");
    }

    private async Task<bool> SaveDataAsync()
    {
        if (!Dirty) return true;
        if (!ValidateData()) return false;

        try
        {
            if (IsNew)
            {
                var insertSql = @"
                    INSERT INTO POMaster(PONumber,DivisionID,POIndex,Job,Vendor,Description,StandardText,
                        DeliveryRecipient,DeliveryAddress,DueDate,ShipVia,FOB,Terms,OrderedBy,PODate,RetainagePercent)
                    VALUES(@PONumber,@DivisionID,@POIndex,@Job,@Vendor,@Description,@StandardText,
                        @DeliveryRecipient,@DeliveryAddress,@DueDate,@ShipVia,@FOB,@Terms,@OrderedBy,@PODate,@RetainagePercent)";
                await db.ExecuteAsync(insertSql, new
                {
                    PONumber, DivisionID = Session.DivisionID, POIndex, Job, Vendor = VendorId,
                    Description = PODescription, StandardText, DeliveryRecipient, DeliveryAddress,
                    DueDate = DateDue, ShipVia, FOB, Terms, OrderedBy,
                    PODate = DateIssued, RetainagePercent
                });
            }
            else
            {
                var updateSql = @"
                    UPDATE POMaster
                       SET Description=@Description, StandardText=@StandardText, ShipVia=@ShipVia,
                           POIndex=@POIndex, FOB=@FOB, Terms=@Terms, OrderedBy=@OrderedBy, PODate=@PODate,
                           DueDate=@DueDate, DeliveryRecipient=@DeliveryRecipient, DeliveryAddress=@DeliveryAddress,
                           RetainagePercent=@RetainagePercent
                     WHERE DivisionID=@DivisionID AND PONumber=@PONumber";
                await db.ExecuteAsync(updateSql, new
                {
                    PONumber, DivisionID = Session.DivisionID,
                    Description = PODescription, StandardText, ShipVia, POIndex, FOB, Terms, OrderedBy,
                    PODate = DateIssued, DueDate = DateDue, DeliveryRecipient, DeliveryAddress, RetainagePercent
                });
            }

            await SaveItemsAsync();
            Dirty = false;
            IsNew = false;
            return true;
        }
        catch (Exception ex)
        {
            _lastError = $"Save failed: {ex.Message}";
            Logger.LogError(ex, "SaveData failed");
            Notifications.Error($"Save failed: {ex.Message}");
            return false;
        }
    }

    private async Task SaveItemsAsync()
    {
        foreach (var item in Items)
        {
            if (item.IsDeleted)
            {
                if (item.Seq > 0)
                {
                    await db.ExecuteAsync(
                        "DELETE FROM POItems WHERE DivisionID=@DivisionID AND PONumber=@PONumber AND ItemSeq=@Seq",
                        new { DivisionID = Session.DivisionID, PONumber, Seq = item.Seq });
                }
                continue;
            }

            RecalculateItem(item);

            if (item.RowState == RowState.New)
            {
                var insertSql = @"
                    INSERT INTO POItems(PONumber,DivisionID,Description,Comments,OrderQty,OrderUOM,TakeoffQty,TakeoffUOM,
                        Rate,Pretax,TaxGroup,JCTax,JCTaxRate,NJCTax,NJCTaxRate,Job,JCExtra,JCCostCode,JCCategory,EstPhase,EstItem,EstItemID)
                    VALUES(@PONumber,@DivisionID,@Description,@Comments,@OrderQty,@OrderUOM,@TakeoffQty,@TakeoffUOM,
                        @Rate,@Pretax,@TaxGroup,@JCTax,@JCTaxRate,@NJCTax,@NJCTaxRate,@Job,@JCExtra,@JCCostCode,@JCCategory,@EstPhase,@EstItem,@EstItemID)";
                await db.ExecuteAsync(insertSql, new
                {
                    PONumber, DivisionID = Session.DivisionID,
                    item.Description, item.Comments, item.OrderQty, item.OrderUOM, item.TakeoffQty, item.TakeoffUOM,
                    item.Rate, item.Pretax, item.TaxGroup, item.JCTax, item.JCTaxRate, item.NJCTax, item.NJCTaxRate,
                    Job = item.Job_No, item.JCExtra, item.JCCostCode, item.JCCategory, item.EstPhase, item.EstItem, item.EstItemID
                });
                item.RowState = RowState.Unchanged;
            }
            else if (item.RowState == RowState.Modified)
            {
                var updateSql = @"
                    UPDATE POItems
                       SET Description=@Description, Comments=@Comments, OrderQty=@OrderQty, OrderUOM=@OrderUOM,
                           TakeoffQty=@TakeoffQty, TakeoffUOM=@TakeoffUOM, Rate=@Rate, Pretax=@Pretax, TaxGroup=@TaxGroup,
                           JCTax=@JCTax, JCTaxRate=@JCTaxRate, NJCTax=@NJCTax, NJCTaxRate=@NJCTaxRate,
                           Job=@Job, JCExtra=@JCExtra, JCCostCode=@JCCostCode, JCCategory=@JCCategory, EstPhase=@EstPhase, EstItem=@EstItem
                     WHERE DivisionID=@DivisionID AND PONumber=@PONumber AND ItemSeq=@Seq";
                await db.ExecuteAsync(updateSql, new
                {
                    DivisionID = Session.DivisionID, PONumber, Seq = item.Seq,
                    item.Description, item.Comments, item.OrderQty, item.OrderUOM, item.TakeoffQty, item.TakeoffUOM,
                    item.Rate, item.Pretax, item.TaxGroup, item.JCTax, item.JCTaxRate, item.NJCTax, item.NJCTaxRate,
                    Job = item.Job_No, item.JCExtra, item.JCCostCode, item.JCCategory, item.EstPhase, item.EstItem
                });
                item.RowState = RowState.Unchanged;
            }
        }
    }

    private bool ValidateData()
    {
        if (string.IsNullOrWhiteSpace(Job))
        {
            Notifications.Warning("A Job number is required.");
            return false;
        }
        if (string.IsNullOrWhiteSpace(VendorId))
        {
            Notifications.Warning("A Vendor is required.");
            return false;
        }
        return true;
    }

    private async Task OnCancelPO()
    {
        if (IsNew)
        {
            ResetForm();
            FieldsLocked = true;
            return;
        }

        var confirm = await Dialogs.ConfirmAsync($"Cancel purchase order {PONumber}?");
        if (!confirm) return;

        try
        {
            await db.ExecuteAsync(
                "UPDATE POMaster SET Cancelled=1, TStmp=GETDATE(), DateSentToBuildPro=NULL WHERE DivisionID=@DivisionID AND PONumber=@PONumber",
                new { DivisionID = Session.DivisionID, PONumber });
            ResetForm();
            FieldsLocked = true;
            Notifications.Info("Purchase order cancelled.");
        }
        catch (Exception ex)
        {
            _lastError = $"Cancel failed: {ex.Message}";
        }
    }

