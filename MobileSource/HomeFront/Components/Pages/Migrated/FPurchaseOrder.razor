@namespace HomeFront.Components.Pages
@page "/purchase-order"
@page "/purchase-order/{Mode}"
@page "/purchase-order/{Mode}/{Job}"

@rendermode InteractiveServer

@using System.Globalization
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using HomeFront.Data
@using HomeFront.Services
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject ILogger<FPurchaseOrder> Logger
@inject NotificationService Notifications
@inject NavigationManager Nav
@inject ISessionStateService Session
@inject DbWrapperSqlServer db

@*
    FPurchaseOrder — VB6 FPurchaseOrder.frm migration ("Issue PO's").

    Layout faithfully reproduces the VB6 screenshot:
      Toolbar: New | Open | Save || OneTime | Item | Assembly | Custom || Preview | Email || Cancel
      Header (3 columns):
        - Left:  Vendor (with picker + edit), Address, Ship Via, FOB, Recipient, Email/Fax
        - Center: PURCHASE ORDER title, Approval banner, Email line, Description
        - Right:  PO #, Date, Ordered By, Due, Format, Job, Retainage, [Description ...]
      Scope of Work (Standard Text)
      Items grid: Job, Extra, Cost Code, JC Category, Description, Comments, Qty, UOM,
                  Unit Cost, Pretax, Tax Grp, Total Tax, Total
      Footer: Terms (left), Subtotal/Tax/Total (right)
*@

<PageTitle>Issue PO's - HomeFront</PageTitle>

@if (!string.IsNullOrEmpty(_lastError))
{
    <div class="po-error">
        <strong>Error:</strong> @_lastError
        <button @onclick="() => _lastError = string.Empty">×</button>
    </div>
}

<div class="po-root">
    @* ── Toolbar (mirrors VB6 Toolbar buttons; matches the screenshot order) ─── *@
    <div class="po-toolbar">
        <button class="po-tbar-btn" @onclick="OnNew">
            <img src="images/32/New.ico" alt="New" onerror="this.style.display='none'" />
            <span>New</span>
        </button>
        <button class="po-tbar-btn" @onclick="OnOpen">
            <img src="images/32/open.ico" alt="Open" onerror="this.style.display='none'" />
            <span>Open</span>
        </button>
        <button class="po-tbar-btn" disabled="@FieldsLocked" @onclick="OnSave">
            <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
            <span>Save</span>
        </button>
        <div class="po-tbar-sep"></div>
        <button class="po-tbar-btn" disabled="@(!CanTakeoff)" @onclick='() => OnTakeoffAsync("OneTime")'>
            <img src="images/32/TakeoffOneTime.ico" alt="One Time" onerror="this.style.display='none'" />
            <span>One Time</span>
        </button>
        <button class="po-tbar-btn" disabled="@(!CanTakeoff)" @onclick='() => OnTakeoffAsync("Item")'>
            <img src="images/32/TakeoffItem.ico" alt="Item" onerror="this.style.display='none'" />
            <span>Item</span>
        </button>
        <button class="po-tbar-btn" disabled="@(!CanTakeoff)" @onclick='() => OnTakeoffAsync("Assembly")'>
            <img src="images/32/TakeoffAssembly.ico" alt="Assembly" onerror="this.style.display='none'" />
            <span>Assembly</span>
        </button>
        <button class="po-tbar-btn" disabled="@(!CanTakeoff)" @onclick='() => OnTakeoffAsync("Custom")'>
            <img src="images/32/TakeoffCustom.ico" alt="Custom" onerror="this.style.display='none'" />
            <span>Custom</span>
        </button>
        <div class="po-tbar-sep"></div>
        <button class="po-tbar-btn" disabled="@FieldsLocked" @onclick="OnPreview">
            <img src="images/32/Preview.ico" alt="Preview" onerror="this.style.display='none'" />
            <span>Preview</span>
        </button>
        <button class="po-tbar-btn" disabled="@FieldsLocked" @onclick="OnSend">
            <img src="images/32/email.ico" alt="Email" onerror="this.style.display='none'" />
            <span>Email</span>
        </button>
        <div class="po-tbar-sep"></div>
        <button class="po-tbar-btn po-tbar-btn-danger" disabled="@FieldsLocked" @onclick="OnCancelPO">
            <img src="images/32/delete.ico" alt="Cancel" onerror="this.style.display='none'" />
            <span>Cancel</span>
        </button>
    </div>

    @* ── Header — three columns matching the screenshot ─── *@
    <div class="po-header">

        @* LEFT — Vendor + Address + Ship Via + FOB + Recipient/Email *@
        <div class="po-header-left">
            <div class="po-row">
                <a href="javascript:void(0)" class="po-label-link" @onclick="OnVendorPick">Vendor 🔍</a>
                <span class="po-vendor-name">@VendorName</span>
                <button class="po-edit-icon" title="Edit vendor" disabled="@(string.IsNullOrEmpty(VendorId))" @onclick="OnEditVendor">✎</button>
            </div>
            <div class="po-vendor-address">@((MarkupString)FormatAddress(Address))</div>

            <div class="po-row po-row-tight">
                <label>Ship Via</label>
                <TextBoxControl CssClass="po-input" @bind-Value="ShipVia" Enabled="@(!FieldsLocked)" @bind-Value:after="MarkDirty" />
            </div>
            <div class="po-row po-row-tight">
                <label>Free On Board</label>
                <TextBoxControl CssClass="po-input" @bind-Value="FOB" Enabled="@(!FieldsLocked)" @bind-Value:after="MarkDirty" />
            </div>

            <div class="po-row po-row-tight">
                <label>Recipient</label>
                <TextBoxControl CssClass="po-input" @bind-Value="DeliveryRecipient" Enabled="@(!FieldsLocked)" @bind-Value:after="MarkDirty" />
            </div>
            <div class="po-row po-row-tight">
                <label>Email/Fax</label>
                <TextBoxControl CssClass="po-input" @bind-Value="DeliveryAddress" Enabled="@(!FieldsLocked)" @bind-Value:after="OnDeliveryAddressChanged" />
            </div>
        </div>

        @* CENTER — Title + Approval banner + Email status *@
        <div class="po-header-center">
            <div class="po-title">PURCHASE ORDER</div>
            <div class="po-approval @(ApprovalRequired ? "po-approval-required" : "")">
                @if (!string.IsNullOrEmpty(ApprovalText)) { @ApprovalText }
            </div>
            <div class="po-row">
                <label>Email</label>
                <span class="po-value">@SendViaText</span>
            </div>
            <div class="po-row">
                <label>Description</label>
                <TextBoxControl CssClass="po-input" @bind-Value="PODescription" Enabled="@(!FieldsLocked)" @bind-Value:after="MarkDirty" />
                <button class="po-browse" disabled="@FieldsLocked" @onclick='() => OpenComments(PoCommentsTarget.Description, PODescription, "Description", 100)'>…</button>
            </div>
        </div>

        @* RIGHT — PO #, Date, Ordered By, Due, Format, Job, Retainage *@
        <div class="po-header-right">
            <div class="po-po-number-block">
                <div class="po-po-number-label">Purchase Order</div>
                <div class="po-po-number">@PONumber</div>
            </div>

            @* VB6 date fields → FlexKit DatePickerControl (DateIssued/DateDue are DateTime?).
               Enabled mirrors the FieldsLocked guard; @bind-Value:after keeps MarkDirty. *@
            <div class="po-row po-row-right">
                <label>Date</label>
                <DatePickerControl CssClass="po-input po-input-narrow" @bind-Value="DateIssued" Enabled="@(!FieldsLocked)" @bind-Value:after="MarkDirty" />
            </div>
            <div class="po-row po-row-right">
                <label>Ordered By</label>
                <TextBoxControl CssClass="po-input po-input-narrow" @bind-Value="OrderedBy" Enabled="@(!FieldsLocked)" @bind-Value:after="MarkDirty" />
            </div>
            <div class="po-row po-row-right">
                <label>Due</label>
                <DatePickerControl CssClass="po-input po-input-narrow" @bind-Value="DateDue" Enabled="@(!FieldsLocked)" @bind-Value:after="MarkDirty" />
            </div>
            <div class="po-row po-row-right">
                <label>Format</label>
                <TextBoxControl CssClass="po-input po-input-narrow" @bind-Value="POIndex" Enabled="@(!FieldsLocked)" @bind-Value:after="MarkDirty" />
                <button class="po-browse" disabled="@FieldsLocked" @onclick="OnPoIndexPick">…</button>
            </div>
            <div class="po-row po-row-right">
                <label>Job</label>
                <span class="po-value po-value-mono">@Job</span>
            </div>
            <div class="po-row po-row-right">
                <label>Retainage</label>
                <TextBoxControl CssClass="po-input po-input-tiny" @bind-Value="RetainagePercentText" Enabled="@(!FieldsLocked)" @bind-Value:after="MarkDirty" />
                <span class="po-value">%</span>
            </div>
        </div>
    </div>

    @* ── Scope of Work (Standard Text) ─── *@
    <div class="po-sow">
        <a href="javascript:void(0)" class="po-label-link" @onclick='() => OpenComments(PoCommentsTarget.StandardText, StandardText, "Scope of Work", 2000)'>Scope of Work</a>
        <TextAreaControl CssClass="po-sow-text" @bind-Value="StandardText" Enabled="@(!FieldsLocked)" @bind-Value:after="MarkDirty" />
    </div>

    @* ── Items grid (matches screenshot column order) ─── *@
    <div class="po-items">
        <GridControl @ref="_gridRef"
                     TValue="PurchaseOrderItem"
                     DataSource="@VisibleItems"
                     AllowSelection="true"
                     AllowSorting="true"
                     AllowResizing="true"
                     AllowGrouping="false"
                     EnableHover="true"
                     Height="100%"
                     RowHeight="22"
                     SelectionSettingsRef="@_itemsSelection">
            @* In-cell <input> editors below stay raw: they are wired to per-row grid
               edit-state (@bind="row.X" + per-row OnItemChanged/OnTaxGroupChanged recalc),
               not standalone form fields. The .po-grid-del/×/… glyph buttons likewise
               stay raw. *@
            <GridColumnsBase>
                <GridColumn HeaderText=""           Width="36px" Visible="@(!FieldsLocked)">
                    <Template>
                        @{ var row = (PurchaseOrderItem)context; }
                        <button class="po-grid-del" @onclick="() => DeleteItem(row)" title="Delete row">×</button>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(PurchaseOrderItem.Job_No)"         HeaderText="Job"          Width="80px"  AllowEditing="false" />
                <GridColumn Field="@nameof(PurchaseOrderItem.JCExtra)"        HeaderText="Extra"        Width="60px" />
                <GridColumn Field="@nameof(PurchaseOrderItem.JCCostCode)"     HeaderText="Cost Code"    Width="80px" />
                <GridColumn Field="@nameof(PurchaseOrderItem.JCCategory)"     HeaderText="JC Category"  Width="90px" />
                <GridColumn Field="@nameof(PurchaseOrderItem.Description)"   HeaderText="Description"  Width="240px">
                    <Template>
                        @{ var row = (PurchaseOrderItem)context; }
                        <input class="po-grid-input" @bind="row.Description" @bind:after="() => OnItemChanged(row)" disabled="@FieldsLocked" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(PurchaseOrderItem.Comments)"      HeaderText="Comments"     Width="120px">
                    <Template>
                        @{ var row = (PurchaseOrderItem)context; }
                        <input class="po-grid-input" @bind="row.Comments" @bind:after="() => OnItemChanged(row)" disabled="@FieldsLocked" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(PurchaseOrderItem.OrderQty)"      HeaderText="Qty"          Width="60px"  TextAlign="TextAlign.Right" Format="N2">
                    <Template>
                        @{ var row = (PurchaseOrderItem)context; }
                        <input type="number" step="0.01" class="po-grid-input po-grid-input-num" @bind="row.OrderQty" @bind:after="() => OnItemChanged(row)" disabled="@FieldsLocked" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(PurchaseOrderItem.OrderUOM)"      HeaderText="UOM"          Width="60px">
                    <Template>
                        @{ var row = (PurchaseOrderItem)context; }
                        <input class="po-grid-input" @bind="row.OrderUOM" @bind:after="() => OnItemChanged(row)" disabled="@FieldsLocked" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(PurchaseOrderItem.Rate)"          HeaderText="Unit Cost"    Width="80px"  TextAlign="TextAlign.Right" Format="N2">
                    <Template>
                        @{ var row = (PurchaseOrderItem)context; }
                        <input type="number" step="0.0001" class="po-grid-input po-grid-input-num" @bind="row.Rate" @bind:after="() => OnItemChanged(row)" disabled="@FieldsLocked" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(PurchaseOrderItem.Pretax)"        HeaderText="Pretax"       Width="90px"  TextAlign="TextAlign.Right" Format="N2" AllowEditing="false" />
                <GridColumn Field="@nameof(PurchaseOrderItem.TaxGroup)"      HeaderText="Tax Grp"      Width="70px">
                    <Template>
                        @{ var row = (PurchaseOrderItem)context; }
                        <input class="po-grid-input" value="@row.TaxGroup" @onchange="async e => await OnTaxGroupChanged(row, e)" disabled="@FieldsLocked" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(PurchaseOrderItem.TotalTax)"      HeaderText="Total Tax"    Width="80px"  TextAlign="TextAlign.Right" Format="N2" AllowEditing="false" />
                <GridColumn Field="@nameof(PurchaseOrderItem.Total)"         HeaderText="Total"        Width="100px" TextAlign="TextAlign.Right" Format="N2" AllowEditing="false" />
            </GridColumnsBase>
        </GridControl>
    </div>

    @* ── Footer — Terms (left) + totals (right) ─── *@
    <div class="po-footer">
        <div class="po-footer-left">
            <a href="javascript:void(0)" class="po-label-link" @onclick='() => OpenComments(PoCommentsTarget.Terms, Terms, "Terms", 2000)'>Terms</a>
            <TextAreaControl CssClass="po-footer-terms" @bind-Value="Terms" Enabled="@(!FieldsLocked)" @bind-Value:after="MarkDirty" />
        </div>
        <div class="po-footer-right">
            <div class="po-total-row"><span>Subtotal</span><span>@SubtotalLabel</span></div>
            <div class="po-total-row"><span>Tax</span><span>@TaxLabel</span></div>
            <div class="po-total-row po-total-bold"><span>Total</span><span>@TotalLabel</span></div>
        </div>
    </div>
</div>

@* ── Shared dialogs ─── *@
<FPickList @ref="_pickList" OnSelected="OnPickListSelected" />
<FComments @bind-Visible="_commentsVisible"
           @bind-Value="_commentsBuffer"
           Title="@_commentsTitle"
           MaxLength="_commentsMaxLength"
           OnSave="OnCommentsSaved" />

@code {
    // ── Route parameters ──────────────────────────────────────────────────
    [Parameter] public string? Mode { get; set; }
    [Parameter] public string? Job { get; set; }

    // ── Form state ────────────────────────────────────────────────────────
    private bool FieldsLocked = true;
    private bool IsNew;
    private bool Dirty;
    private string _lastError = "";

    private string PONumber = "";
    private string POIndex = "";
    private string VendorId = "";
    private string VendorName = "";
    private string Address = "";
    private string ShipVia = "";
    private string FOB = "";
    private string DeliveryRecipient = "";
    private string DeliveryAddress = "";
    private DateTime? DateIssued = DateTime.Today;
    private DateTime? DateDue = DateTime.Today;
    private string OrderedBy = "";
    private string PODescription = "";
    private string StandardText = "";
    private string Terms = "";
    private string ApprovalText = "";
    private bool   ApprovalRequired = false;
    private string SendViaText = "Print";
    private decimal RetainagePercent;
    private string RetainagePercentText
    {
        get => RetainagePercent.ToString("0.##", CultureInfo.InvariantCulture);
        set
        {
            var clean = (value ?? "").Trim().TrimEnd('%').Trim();
            if (decimal.TryParse(clean, NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
                RetainagePercent = v;
        }
    }

    private long mEstAssemblyID = 0;

    private double Subtotal;
    private double TaxTotal;
    private double GrandTotal;

    private string SubtotalLabel => Subtotal.ToString("#,##0.00", CultureInfo.CurrentCulture);
    private string TaxLabel      => TaxTotal.ToString("#,##0.00", CultureInfo.CurrentCulture);
    private string TotalLabel    => GrandTotal.ToString("#,##0.00", CultureInfo.CurrentCulture);

    private readonly List<PurchaseOrderItem> Items = new();
    private IEnumerable<PurchaseOrderItem> VisibleItems => Items.Where(i => !i.IsDeleted).ToList();

    // ── Component refs ────────────────────────────────────────────────────
    private GridControl<PurchaseOrderItem>? _gridRef;
    private FPickList? _pickList;
    private readonly SelectionSettings _itemsSelection = new() { Mode = SelectionMode.Row, Type = SelectionType.Single };

    // FComments dialog routing
    private enum PoCommentsTarget { Description, StandardText, Terms }
    private PoCommentsTarget _commentsTarget = PoCommentsTarget.Description;
    private bool   _commentsVisible;
    private string? _commentsBuffer;
    private string _commentsTitle = "Description";
    private int?   _commentsMaxLength = 100;

    // FPickList dispatch
    private string _pickContext = "";

    // CanTakeoff: the takeoff buttons need a Job + EstAssembly context to work.
    private bool CanTakeoff => !FieldsLocked && !string.IsNullOrEmpty(Job);

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadDefaultPOIndexAsync();
        ResetForm();
        FieldsLocked = true;
        CalculateTotals();

        // Route-supplied Job pre-loads context (used when navigating from
        // FMain → "Create Manual PO's" with a current job).
        if (!string.IsNullOrWhiteSpace(Job))
        {
            await StartNewWithJob(Job);
        }
    }

    private async Task LoadDefaultPOIndexAsync()
    {
        try
        {
            var value = await db.ExecuteScalarAsync<string>(
                "SELECT TOP 1 optionvalue FROM appoptions WHERE DivisionID=@DivisionID AND optionname='DefaultPOIndex'",
                new { DivisionID = Session.DivisionID });
            POIndex = string.IsNullOrWhiteSpace(value) ? "99 Manual PO" : value;
        }
        catch
        {
            POIndex = "99 Manual PO";
        }
    }

    private void ResetForm()
    {
        VendorId = "";
        VendorName = "";
        Address = "";
        ShipVia = "";
        FOB = "";
        DeliveryRecipient = "";
        DeliveryAddress = "";
        DateIssued = DateTime.Today;
        DateDue = DateTime.Today;
        OrderedBy = "";
        Job = "";
        RetainagePercent = 0;
        PODescription = "";
        StandardText = "";
        Terms = "";
        ApprovalText = "";
        ApprovalRequired = false;
        SendViaText = "Print";
        PONumber = "";
        Items.Clear();
        Items.Add(new PurchaseOrderItem());
        Dirty = false;
        IsNew = false;
        CalculateTotals();
    }

    private void MarkDirty() => Dirty = true;

    // ── Vendor picker ─────────────────────────────────────────────────────
    private async Task OnVendorPick()
    {
        if (_pickList == null) return;
        _pickContext = "Vendor";
        var sql = @"SELECT Vendor_ID Vendor, Vendor_Name ""Vendor Name""
                      FROM tblVendors
                     WHERE DivisionID = " + Session.DivisionID + @"
                       AND ISNULL(active,1) = 1
                     ORDER BY Vendor_Name";
        await _pickList.Open(title: "Vendor", queries: sql, defaultItem: VendorName, showNew: false);
    }

    private void OnEditVendor()
    {
        if (string.IsNullOrEmpty(VendorId))
        {
            Notifications.Info("Select a vendor first.");
            return;
        }
        // VB6 cmdEditVendor → HFApp.EditVendor(txtVendor.Tag) opens FVendor.
        Nav.NavigateTo($"/vendor/{Uri.EscapeDataString(VendorId)}");
    }

    private async Task LoadVendorAsync(string vendorIdOrName)
    {
        if (string.IsNullOrWhiteSpace(vendorIdOrName))
        {
            VendorId = "";
            VendorName = "";
            Address = "";
            return;
        }

        var sql = @"
            SELECT TOP 1 v.Vendor_ID, v.Vendor_Name, v.Addr1, v.Addr2, v.City, v.State, v.Zip, e.Email
              FROM tblVendors v
              LEFT JOIN ContactPurchasingEmails e ON v.Vendor_ID = e.VendorCode AND v.DivisionID = e.DivisionID
             WHERE v.DivisionID = @DivisionID
               AND (v.Vendor_ID = @Value OR v.Vendor_Name = @Value)";
        var rows = await db.QueryAsync(sql, new { DivisionID = Session.DivisionID, Value = vendorIdOrName });
        if (!rows.Any()) return;

        var row = rows.First();
        VendorId = row["Vendor_ID"]?.ToString() ?? "";
        VendorName = row["Vendor_Name"]?.ToString() ?? VendorName;
        var addr1 = row["Addr1"]?.ToString() ?? "";
        var addr2 = row["Addr2"]?.ToString() ?? "";
        var city = row["City"]?.ToString() ?? "";
        var state = row["State"]?.ToString() ?? "";
        var zip = row["Zip"]?.ToString() ?? "";
        Address = string.Join("\n", new[] {
            addr1,
            addr2,
            ($"{city} {state}").Trim(),
            zip
        }.Where(s => !string.IsNullOrWhiteSpace(s)));
        DeliveryAddress = row["Email"]?.ToString() ?? DeliveryAddress;
        UpdateSendVia();
    }

    private static string FormatAddress(string addr) =>
        string.IsNullOrEmpty(addr) ? "" : System.Net.WebUtility.HtmlEncode(addr).Replace("\n", "<br />");

    private void OnDeliveryAddressChanged()
    {
        UpdateSendVia();
        Dirty = true;
    }

    private void UpdateSendVia()
    {
        if (string.IsNullOrWhiteSpace(DeliveryAddress)) SendViaText = "Print";
        else if (DeliveryAddress.Contains("@")) SendViaText = "Email";
        else SendViaText = "Fax";
    }

    // ── Items grid ────────────────────────────────────────────────────────
    private void DeleteItem(PurchaseOrderItem item)
    {
        item.IsDeleted = true;
        item.RowState = RowState.Deleted;
        Dirty = true;
        CalculateTotals();
    }

    private void OnItemChanged(PurchaseOrderItem item)
    {
        RecalculateItem(item);
        MarkItemDirty(item);
        CalculateTotals();
    }

    private async Task OnTaxGroupChanged(PurchaseOrderItem item, ChangeEventArgs e)
    {
        item.TaxGroup = e.Value?.ToString() ?? "";
        await LoadTaxRatesAsync(item);
        RecalculateItem(item);
        MarkItemDirty(item);
        CalculateTotals();
    }

    private async Task LoadTaxRatesAsync(PurchaseOrderItem item)
    {
        if (string.IsNullOrWhiteSpace(item.TaxGroup))
        {
            item.JCTaxRate = 0;
            item.NJCTaxRate = 0;
            return;
        }

        try
        {
            var rows = await db.QueryAsync(
                "SELECT JCRate, NJCRate FROM TaxGroups WHERE DivisionID=@DivisionID AND TaxGroup=@TaxGroup",
                new { DivisionID = Session.DivisionID, TaxGroup = item.TaxGroup });
            if (!rows.Any()) return;
            var row = rows.First();
            item.JCTaxRate = ToDouble(row["JCRate"]);
            item.NJCTaxRate = ToDouble(row["NJCRate"]);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "TaxGroups query failed for {TaxGroup}", item.TaxGroup);
        }
    }

    private void RecalculateItem(PurchaseOrderItem item)
    {
        item.Pretax   = Math.Round(item.OrderQty * item.Rate, 2);
        item.JCTax    = Math.Round(item.Pretax * item.JCTaxRate / 100, 2);
        item.NJCTax   = Math.Round(item.Pretax * item.NJCTaxRate / 100, 2);
        item.TotalTax = item.JCTax + item.NJCTax;
        item.Total    = item.Pretax + item.TotalTax;
    }

    private void MarkItemDirty(PurchaseOrderItem item)
    {
        if (item.RowState == RowState.Unchanged)
            item.RowState = RowState.Modified;
        Dirty = true;
    }

    private void CalculateTotals()
    {
        Subtotal   = Items.Where(i => !i.IsDeleted).Sum(i => i.Pretax);
        TaxTotal   = Items.Where(i => !i.IsDeleted).Sum(i => i.TotalTax);
        GrandTotal = Subtotal + TaxTotal;
    }

    // ── Toolbar handlers ──────────────────────────────────────────────────
    private async Task OnNew()
    {
        if (!await ConfirmSaveIfDirty()) return;
        if (_pickList == null) return;

        _pickContext = "NewJob";
        var sql = @"SELECT Job_No Job, Description
                      FROM tblJobs
                     WHERE DivisionID = " + Session.DivisionID + @"
                       AND ISNULL(Inactive,0) = 0
                     ORDER BY Job_No";
        await _pickList.Open(title: "Open Job", queries: sql, defaultItem: Job ?? "", showNew: false);
    }

    private async Task StartNewWithJob(string job)
    {
        ResetForm();
        Job = job;
        FieldsLocked = false;
        IsNew = true;

        // VB6: Purch_CreatePONumber stored proc generates a fresh PO number.
        if (!string.IsNullOrWhiteSpace(Job) && !string.IsNullOrWhiteSpace(POIndex))
        {
            PONumber = await CreatePONumberAsync(Job, POIndex);
        }

        Items.Clear();
        Items.Add(new PurchaseOrderItem { Job_No = Job, RowState = RowState.New });
        Dirty = true;
        StateHasChanged();
    }

    private async Task<string> CreatePONumberAsync(string job, string poIndex)
    {
        try
        {
            var value = await db.ExecuteScalarAsync<string>(
                "SELECT dbo.Purch_CreatePONumber(@DivisionID,@Job,@POIndex)",
                new { DivisionID = Session.DivisionID, Job = job, POIndex = poIndex });
            if (!string.IsNullOrWhiteSpace(value)) return value;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Purch_CreatePONumber failed");
        }
        return $"PO{DateTime.Now:yyyyMMddHHmmss}";
    }

    private async Task OnOpen()
    {
        if (!await ConfirmSaveIfDirty()) return;
        if (_pickList == null) return;

        _pickContext = "OpenPO";
        var sql = @"SELECT p.PONumber ""PO #"", p.PODate Date, p.Job, p.Vendor, v.Vendor_Name ""Vendor Name"", p.Description
                      FROM POMaster p
                      LEFT JOIN tblVendors v ON p.Vendor = v.Vendor_ID AND p.DivisionID = v.DivisionID
                     WHERE p.Cancelled = 0 AND p.DivisionID = " + Session.DivisionID + @"
                     ORDER BY p.PODate DESC";
        await _pickList.Open(title: "Open PO", queries: sql, defaultItem: PONumber ?? "", showNew: false);
    }

    private async Task OnPickListSelected(List<IDictionary<string, object>> selected)
    {
        try
        {
            if (selected.Count == 0) return;
            var row = selected[0];

            switch (_pickContext)
            {
                case "Vendor":
                    var vid = (row.ContainsKey("Vendor") ? row["Vendor"]?.ToString() : null) ?? "";
                    if (string.IsNullOrEmpty(vid)) return;
                    await LoadVendorAsync(vid);
                    Dirty = true;
                    break;

                case "NewJob":
                    var newJob = (row.ContainsKey("Job") ? row["Job"]?.ToString() : null) ?? "";
                    if (!string.IsNullOrEmpty(newJob))
                        await StartNewWithJob(newJob);
                    break;

                case "OpenPO":
                    var poNum = (row.ContainsKey("PO #") ? row["PO #"]?.ToString()
                              : row.ContainsKey("PONumber") ? row["PONumber"]?.ToString() : null) ?? "";
                    if (!string.IsNullOrEmpty(poNum))
                    {
                        PONumber = poNum;
                        await LoadPOAsync();
                    }
                    break;
            }
        }
        finally
        {
            _pickContext = "";
        }
    }

