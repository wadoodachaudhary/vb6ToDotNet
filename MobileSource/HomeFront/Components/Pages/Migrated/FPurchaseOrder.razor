    // Takeoff buttons — VB6 FPurchaseOrder.frm:2079-2145.
    // Mirrors VB6 logic precisely:
    //   1. Validate Job + Vendor
    //   2. If no EstAssemblyID exists for this Job, INSERT a "Manual
    //      Estimates" placeholder via the same SQL VB6 uses (line 2086-2098)
    //   3. Pick the EstAssemblyID and look up assembly context
    //      (community, phase, model, optionId, etc.)
    //   4. Navigate to /takeoff with query params; FTakeoff picks them up
    //      in OnInitializedAsync and auto-calls its Takeoff() method.
    private async Task OnTakeoffAsync(string kind)
    {
        if (string.IsNullOrWhiteSpace(Job))
        {
            Notifications.Warning("Open or start a PO first.");
            return;
        }

        try
        {
            await EnsureManualEstimatesAssemblyAsync();
            var ctx = await LoadAssemblyTakeoffContextAsync();
            if (ctx == null)
            {
                Notifications.Warning("Could not resolve assembly context for takeoff.");
                return;
            }

            // Persist any in-flight PO edits before leaving the page.
            if (Dirty && !await SaveDataAsync()) return;

            // Build /takeoff?mode=…&job=…&vendor=…&community=…&… query string
            // matching the parameters FTakeoff.OnInitializedAsync consumes.
            var qs = new List<string>
            {
                $"mode={Uri.EscapeDataString(kind)}",
                $"isChangeOrder={(string.IsNullOrEmpty(ctx.ChangeOrder) ? "false" : "true")}",
                $"assemblyType={ctx.AssemblyType}",
                $"description={Uri.EscapeDataString(ctx.AssemblyDescription)}",
                $"community={Uri.EscapeDataString(ctx.Community)}",
                $"communityPhase={Uri.EscapeDataString(ctx.CommunityPhase)}",
                $"model={Uri.EscapeDataString(ctx.Model)}",
                $"optionID={Uri.EscapeDataString(ctx.OptionId)}",
                $"assembly={Uri.EscapeDataString(ctx.Assembly)}",
                $"job={Uri.EscapeDataString(Job)}",
                $"vendor={Uri.EscapeDataString(VendorId)}",
                $"returnUrl={Uri.EscapeDataString($"/purchase-order/{Mode ?? ""}/{Job}")}"
            };
            Nav.NavigateTo("/takeoff?" + string.Join("&", qs));
        }
        catch (Exception ex)
        {
            _lastError = $"Takeoff error: {ex.Message}";
            Logger.LogError(ex, "OnTakeoffAsync failed");
        }
    }

    // VB6 FPurchaseOrder.frm:2086-2099. Creates a "Manual Estimates"
    // EstimateAssemblies row when the job has none — so the takeoff has
    // an EstAssemblyID to attach items to.
    private async Task EnsureManualEstimatesAssemblyAsync()
    {
        if (mEstAssemblyID > 0) return;

        var existing = await db.ExecuteScalarAsync<long?>(@"
            SELECT TOP 1 a.EstAssemblyID
              FROM tblCustomers c
              JOIN EstimateAssemblies a
                ON c.DivisionID = a.DivisionID AND c.Job_No = a.Job
             WHERE c.Job_No = @Job AND c.DivisionID = @DivisionID
             ORDER BY a.EstAssemblyID", new { Job, DivisionID = Session.DivisionID });
        if (existing.HasValue && existing.Value > 0)
        {
            mEstAssemblyID = existing.Value;
            return;
        }

        await db.ExecuteAsync(@"
            INSERT INTO EstimateAssemblies(Customer_No, Job, HFDescription, AssemblyType, DivisionID)
            SELECT TOP 1 c.Customer_No, c.Job_No, 'Manual Estimates', -1, c.DivisionID
              FROM tblCustomers c
              LEFT OUTER JOIN EstimateAssemblies a
                ON c.DivisionID = a.DivisionID AND c.Job_No = a.Job
             WHERE a.EstAssemblyID IS NULL
               AND c.Job_No = @Job AND c.DivisionID = @DivisionID",
            new { Job, DivisionID = Session.DivisionID });

        mEstAssemblyID = await db.ExecuteScalarAsync<long>(@"
            SELECT TOP 1 a.EstAssemblyID
              FROM tblCustomers c
              JOIN EstimateAssemblies a
                ON c.DivisionID = a.DivisionID AND c.Job_No = a.Job
             WHERE c.Job_No = @Job AND c.DivisionID = @DivisionID
             ORDER BY a.EstAssemblyID", new { Job, DivisionID = Session.DivisionID });
    }

    private record TakeoffContext(
        string Community, string CommunityPhase, string Assembly,
        string Model, string OptionId, string AssemblyDescription,
        string ChangeOrder, int AssemblyType);

    // VB6 FPurchaseOrder.frm:2105-2120. Loads the assembly-level context
    // FTakeoff needs (community, phase, model, option, descriptor, change
    // order, assembly type) for the chosen EstAssemblyID.
    private async Task<TakeoffContext?> LoadAssemblyTakeoffContextAsync()
    {
        if (mEstAssemblyID <= 0) return null;
        var rows = await db.QueryAsync(@"
            SELECT j.community, j.communityphase, a.assembly, j.job_no,
                   a.jcextra, j.description jobdesc,
                   ISNULL(NULLIF(a.model,''), j.model) model,
                   a.optionid, a.hfdescription, a.assemblytype,
                   ISNULL(a.budgetslocked,0) budgetslocked,
                   ISNULL(a.changeorder,'') changeorder
              FROM EstimateAssemblies a
              JOIN tblJobs j ON a.job = j.job_no AND j.DivisionID = @DivisionID
             WHERE a.EstAssemblyID = @Id",
            new { DivisionID = Session.DivisionID, Id = mEstAssemblyID });
        if (rows.Count == 0) return null;
        var r = rows[0];
        return new TakeoffContext(
            Community:           r["community"]?.ToString() ?? "",
            CommunityPhase:      r["communityphase"]?.ToString() ?? "",
            Assembly:            r["assembly"]?.ToString() ?? "",
            Model:               r["model"]?.ToString() ?? "",
            OptionId:            r["optionid"]?.ToString() ?? "",
            AssemblyDescription: r["hfdescription"]?.ToString() ?? "",
            ChangeOrder:         r["changeorder"]?.ToString() ?? "",
            AssemblyType:        Convert.ToInt32(r["assemblytype"] ?? 0));
    }

