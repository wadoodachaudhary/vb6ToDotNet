    {
        public int Seq { get; set; }
        public long EstItemID { get; set; }
        public string Job_No { get; set; } = "";
        public string JCExtra { get; set; } = "";
        public string EstPhase { get; set; } = "";
        public string EstItem { get; set; } = "";
        public string Description { get; set; } = "";
        public string Comments { get; set; } = "";
        public double TakeoffQty { get; set; }
        public string TakeoffUOM { get; set; } = "";
        public string OrderUOM { get; set; } = "";
        public double OrderQty { get; set; }
        public double Rate { get; set; }
        public double Pretax { get; set; }
        public string TaxGroup { get; set; } = "";
        public double JCTaxRate { get; set; }
        public double NJCTaxRate { get; set; }
        public double JCTax { get; set; }
        public double NJCTax { get; set; }
        public double TotalTax { get; set; }
