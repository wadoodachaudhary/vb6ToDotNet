@namespace HomeFront.Components.Pages

@using System
@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit.Notifications

@inject ILogger<FSplitItems> Logger
@inject NotificationService Notifications

<div class="split-items-dialog">
    <!-- Header -->
    <div class="split-header">
        <img src="images/split-items.png" alt="Split" onerror="this.style.display='none'" />
        <div class="header-text">Split the selected items.</div>
    </div>

    <!-- Copies -->
    <div class="field-row">
        <label>Copies</label>
        <NumericTextBoxControl TValue="int"
                               Min="0" Max="99"
                               Value="Copies" ValueChanged="OnCopiesValueChanged" />
    </div>

    <!-- Allocate checkbox -->
    <div class="checkbox-row">
        <CheckBoxControl Checked="AllocateDollarAmount"
                         CheckedChanged="OnAllocateCheckChanged"
                         Label="Allocate dollar amount across all copies." />
    </div>

    <!-- Allocate options (VB6: optAllocate(0), optAllocate(1)) -->
    <div class="radio-row @(AllocateDollarAmount ? "" : "disabled")">
        <RadioControl TValue="int" Name="allocateOption" Value="0"
                      SelectedValue="AllocateOption"
                      SelectedValueChanged="OnAllocateOptionChanged"
                      Disabled="@(!AllocateDollarAmount)"
                      Label="Equal shares" />
    </div>

    <div class="radio-row @(AllocateDollarAmount ? "" : "disabled")">
        <RadioControl TValue="int" Name="allocateOption" Value="1"
                      SelectedValue="AllocateOption"
                      SelectedValueChanged="OnAllocateOptionChanged"
                      Disabled="@(!AllocateDollarAmount)"
                      Label="Custom percentages" />
    </div>

    <!-- Custom percentages grid (VB6: gData - VSFlexGrid) -->
    @if (AllocateDollarAmount && AllocateOption == 1 && Copies > 0)
    {
        <div class="percent-grid">
            @for (int i = 0; i < Copies; i++)
            {
                var idx = i;
                if (idx < Copies - 1)
                {
                    <NumericTextBoxControl @key="idx" TValue="double" CssClass="percent-cell"
                                           Step="1" Min="0" Max="100"
                                           Value="PercentValues[idx]"
                                           ValueChanged="(v) => OnPercentChanged(idx, v)" />
                }
                else
                {
                    <!-- Last column is read-only (VB6: gData_BeforeEdit cancels edit on last col) -->
                    <NumericTextBoxControl @key="idx" TValue="double" CssClass="percent-cell readonly"
                                           Enabled="false"
                                           Value="PercentValues[idx]" />
                }
            }
        </div>
    }

    <!-- Use Units checkbox (VB6: chkUseUnits) -->
    <div class="checkbox-row">
        <CheckBoxControl Checked="UseUnits"
                         CheckedChanged="OnUseUnitsChanged"
                         Label="Assign the new items to apt/unit numbers" />
    </div>

    <!-- Starting number (VB6: txtStart) -->
    <div class="field-row">
        <label class="@(UseUnits ? "" : "label-disabled")">Starting number</label>
        <NumericTextBoxControl TValue="long" Min="0" @bind-Value="UnitStart" Enabled="@UseUnits" />
    </div>

    <!-- Increment By (VB6: txtIncrement) -->
    <div class="field-row">
        <label class="@(UseUnits ? "" : "label-disabled")">Increment By</label>
        <NumericTextBoxControl TValue="long" Min="0" @bind-Value="UnitIncrement" Enabled="@UseUnits" />
    </div>

    <!-- Buttons (VB6: cmdNav(0)=OK, cmdNav(1)=Cancel) -->
    <div class="button-row">
        <ButtonControl CssClass="btn-primary" Disabled="@(Copies <= 0)" OnClick="OnOkClick">&amp;OK</ButtonControl>
        <ButtonControl OnClick="OnCancelClick">&amp;Cancel</ButtonControl>
    </div>
</div>

@code {
    // === Result callback (replaces VB6 modal ShowForm ByRef pattern) ===
    [Parameter] public EventCallback<SplitItemsResult> OnCompleted { get; set; }

    // === Form State ===
    private string CopiesText { get; set; } = "";
    private int Copies { get; set; } = 0;
    private bool AllocateDollarAmount { get; set; } = true;   // VB6: chkAllocate.Value = vbChecked
    private int AllocateOption { get; set; } = 0;              // 0 = Equal shares, 1 = Custom percentages
    private bool UseUnits { get; set; } = false;
    private long UnitStart { get; set; } = 100;
    private long UnitIncrement { get; set; } = 1;

    // Percent values for custom allocation (mirrors VB6 gData grid cells)
    private List<double> PercentValues { get; set; } = new();

    /// <summary>
    /// Adapter for NumericTextBoxControl ValueChanged (replaces the old
    /// txtCopies @bind/@bind:after wiring): stash the typed value as text,
    /// then run the VB6 txtCopies_Validate normalization.
    /// </summary>
    private void OnCopiesValueChanged(int value)
    {
        CopiesText = value.ToString();
        OnCopiesChanged();
    }

    /// <summary>
    /// VB6: txtCopies_Validate -- normalizes input and resizes the percent grid.
    /// </summary>
    private void OnCopiesChanged()
    {
        // VB6: i = Abs(Int(Val(txtCopies.Text)))
        int parsed = 0;
        if (double.TryParse(CopiesText, out var raw))
            parsed = (int)Math.Abs(Math.Floor(raw));

        Copies = parsed;
        CopiesText = Copies.ToString();

        // VB6: gData.Cols = i  then gData_AfterEdit(0, 0)
        ResizePercentGrid();
        RecalculateGrid();
    }

    /// <summary>
    /// VB6: chkAllocate_Click -- enables/disables radio buttons and grid visibility.
    /// </summary>
    private void OnAllocateCheckChanged(bool value)
    {
        AllocateDollarAmount = value;
        // VB6: optAllocate(0).Enabled / optAllocate(1).Enabled driven by AllocateDollarAmount
        // VB6: gData.Visible = optAllocate(1).value (driven by template @if)
    }

    /// <summary>
    /// VB6: optAllocate_Click -- calls chkAllocate_Click then gData_AfterEdit.
    /// </summary>
    private void OnAllocateOptionChanged(int option)
    {
        AllocateOption = option;
        RecalculateGrid();
    }

    /// <summary>
    /// VB6: chkUseUnits_Click -- enables/disables txtStart, txtIncrement, lblStart, lblIncrement.
    /// </summary>
    private void OnUseUnitsChanged(bool value)
    {
        UseUnits = value;
    }

    /// <summary>
    /// Resize percent list to match Copies count (VB6: gData.Cols = i).
    /// </summary>
    private void ResizePercentGrid()
    {
        while (PercentValues.Count < Copies)
            PercentValues.Add(0);
        while (PercentValues.Count > Copies)
            PercentValues.RemoveAt(PercentValues.Count - 1);
    }

    /// <summary>
    /// VB6: gData_AfterEdit -- recalculates grid cells.
    /// Equal shares: each cell = Int(1/Cols * 100), last = 100 - sum.
    /// Custom: user values kept, last = 100 - sum.
    /// </summary>
    private void RecalculateGrid()
    {
        if (Copies <= 0)
        {
            PercentValues.Clear();
            return;
        }

        ResizePercentGrid();

        double total = 0;
        for (int i = 0; i < Copies - 1; i++)
        {
            if (AllocateOption == 0) // Equal shares
            {
                // VB6: .TextMatrix(0, i) = Int(1 / .Cols * 100)
                PercentValues[i] = Math.Floor(1.0 / Copies * 100);
            }
            // Custom: keep user-entered values as-is
            total += PercentValues[i];
        }
        // VB6: .TextMatrix(0, i) = 100 - t  (last column is remainder)
        PercentValues[Copies - 1] = 100 - total;
    }

    /// <summary>
    /// User edited a custom percent cell (not the last one, which is read-only per gData_BeforeEdit).
    /// </summary>
    private void OnPercentChanged(int index, double val)
    {
        PercentValues[index] = val;
        // Recalculate the last column
        double total = 0;
        for (int i = 0; i < Copies - 1; i++)
            total += PercentValues[i];
        PercentValues[Copies - 1] = 100 - total;
    }

    /// <summary>
    /// VB6: cmdNav_Click(0) -- OK pressed; mCancel = False, Me.Hide.
    /// Builds result matching VB6 ShowForm ByRef outputs.
    /// </summary>
    private async Task OnOkClick()
    {
        var result = new SplitItemsResult
        {
            Success = true,
            WriteUnits = UseUnits,
            UnitStart = UnitStart,
            UnitIncrement = UnitIncrement,
            Percents = BuildPercents()
        };

        if (OnCompleted.HasDelegate)
            await OnCompleted.InvokeAsync(result);
    }

    /// <summary>
    /// VB6: cmdNav_Click(1) -- Cancel pressed; mCancel = True, Me.Hide.
    /// </summary>
    private async Task OnCancelClick()
    {
        var result = new SplitItemsResult { Success = false };

        if (OnCompleted.HasDelegate)
            await OnCompleted.InvokeAsync(result);
    }

    /// <summary>
    /// Builds the 1-based Percents array matching VB6 ShowForm output.
    /// VB6: ReDim Percents(c), Percents(1..c) filled based on chkAllocate / optAllocate / gData.
    /// </summary>
    private double[] BuildPercents()
    {
        int c = Copies;
        if (c <= 0) return Array.Empty<double>();

        // 1-based array like VB6 (index 0 unused, 1..c used)
        var percents = new double[c + 1];

        if (!AllocateDollarAmount)
        {
            // VB6: If chkAllocate.value = vbUnchecked Then Percents(1) = 1
            percents[1] = 1.0;
        }
        else if (AllocateOption == 0) // Equal shares
        {
            // VB6: For i = 1 To c - 1: Percents(i) = 1 / c: Next
            for (int i = 1; i <= c - 1; i++)
            {
                percents[i] = 1.0 / c;
            }
            // VB6: Percents(c) = 1 - ((c - 1) / c)
            percents[c] = 1.0 - ((c - 1.0) / c);
        }
        else // Custom percentages
        {
            // VB6: Percents(i) = gData.ValueMatrix(0, i - 1) / 100
            for (int i = 1; i <= c; i++)
            {
                percents[i] = PercentValues[i - 1] / 100.0;
            }
        }

        return percents;
    }

    // === Result Model (replaces VB6 ShowForm ByRef parameters) ===
    public class SplitItemsResult
    {
        public bool Success { get; set; }
        public double[] Percents { get; set; } = Array.Empty<double>();
        public bool WriteUnits { get; set; }
        public long UnitStart { get; set; }
        public long UnitIncrement { get; set; }
    }
}
