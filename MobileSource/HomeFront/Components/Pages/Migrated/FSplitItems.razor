```razor
@page "/split-items"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using System
@using System.Collections.Generic
@using System.Linq

@inject IJSRuntime JSRuntime

<PageTitle>Split Items - HomeFront</PageTitle>

<style>
    .split-items-dialog {
        max-width: 500px;
        margin: 40px auto;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 4px 16px rgba(0,0,0,0.12);
        padding: 24px;
        font-family: 'MS Sans Serif', Arial, sans-serif;
        font-size: 13px;
    }

    .split-header {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 16px;
    }

    .split-header img {
        width: 48px;
        height: 48px;
    }

    .split-header .header-text {
        font-size: 14px;
        color: #333;
    }

    .field-row {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        margin-left: 64px;
    }

    .field-row label {
        min-width: 130px;
        text-align: right;
        padding-right: 10px;
        font-size: 13px;
        color: #333;
    }

    .field-row input[type="number"],
    .field-row input[type="text"] {
        width: 60px;
        text-align: center;
        padding: 3px 6px;
        border: 1px solid #ced4da;
        border-radius: 3px;
        font-size: 13px;
    }

    .field-row input:disabled {
        background-color: #e9ecef;
        border: none;
    }

    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        margin-left: 64px;
        font-size: 13px;
    }

    .checkbox-row input[type="checkbox"] {
        width: 16px;
        height: 16px;
    }

    .radio-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
        margin-left: 90px;
        font-size: 13px;
    }

    .radio-row input[type="radio"] {
        width: 14px;
        height: 14px;
    }

    .radio-row.disabled label {
        color: #999;
    }

    .percent-grid {
        margin-left: 100px;
        margin-bottom: 10px;
        display: flex;
        gap: 2px;
        flex-wrap: wrap;
    }

    .percent-grid .percent-cell {
        width: 60px;
        text-align: center;
        padding: 3px 4px;
        border: 1px solid #ced4da;
        border-radius: 3px;
        font-size: 12px;
    }

    .percent-grid .percent-cell:disabled,
    .percent-grid .percent-cell.readonly {
        background-color: #e9ecef;
        color: #6c757d;
    }

    .button-row {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 20px;
    }

    .button-row button {
        padding: 8px 24px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #f7f7f7;
        cursor: pointer;
        font-size: 13px;
        min-width: 100px;
    }

    .button-row button:hover:not(:disabled) {
        background: #e9ecef;
    }

    .button-row button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .button-row button.btn-primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }

    .button-row button.btn-primary:hover:not(:disabled) {
        background: #0b5ed7;
    }

    .label-disabled {
        color: #999;
    }
</style>

<div class="split-items-dialog">
    <!-- Header -->
    <div class="split-header">
        <img src="images/split-items.png" alt="Split" onerror="this.style.display='none'" />
        <div class="header-text">Split the selected items.</div>
    </div>

    <!-- Copies -->
    <div class="field-row">
        <label>Copies</label>
        <input type="number" min="0" max="99" @bind="Copies" @bind:event="oninput" @onfocusin="() => SelectAllOnFocus(nameof(Copies))" />
    </div>

    <!-- Allocate checkbox -->
    <div class="checkbox-row">
        <input type="checkbox" id="chkAllocate" @bind="AllocateDollarAmount" />
        <label for="chkAllocate">Allocate dollar amount across all copies.</label>
    </div>

    <!-- Allocate options -->
    <div class="radio-row @(AllocateDollarAmount ? "" : "disabled")">
        <input type="radio" id="optEqual" name="allocateOption" value="0"
               checked="@(AllocateOption == 0)"
               disabled="@(!AllocateDollarAmount)"
               @onchange="() => OnAllocateOptionChanged(0)" />
        <label for="optEqual">Equal shares</label>
    </div>

    <div class="radio-row @(AllocateDollarAmount ? "" : "disabled")">
        <input type="radio" id="optCustom" name="allocateOption" value="1"
               checked="@(AllocateOption == 1)"
               disabled="@(!AllocateDollarAmount)"
               @onchange="() => OnAllocateOptionChanged(1)" />
        <label for="optCustom">Custom percentages</label>
    </div>

    <!-- Custom percentages grid -->
    @if (AllocateDollarAmount && AllocateOption == 1 && Copies > 0)
    {
        <div class="percent-grid">
            @for (int i = 0; i < Copies; i++)
            {
                var idx = i;
                if (idx < Copies - 1)
                {
                    <input type="number" class="percent-cell" step="1" min="0" max="100"
                           value="@PercentValues[idx]"
                           @onchange="(e) => OnPercentChanged(idx, e)" />
                }
                else
                {
                    <!-- Last column is calculated (read-only) -->
                    <input type="number" class="percent-cell readonly" readonly
                           value="@PercentValues[idx]" />
                }
            }
        </div>
    }

    <!-- Use Units checkbox -->
    <div class="checkbox-row">
        <input type="checkbox" id="chkUseUnits" @bind="UseUnits" />
        <label for="chkUseUnits">Assign the new items to apt/unit numbers</label>
    </div>

    <!-- Starting number -->
    <div class="field-row">
        <label class="@(UseUnits ? "" : "label-disabled")">Starting number</label>
        <input type="number" min="0" @bind="UnitStart" disabled="@(!UseUnits)"
               @onfocusin="() => SelectAllOnFocus(nameof(UnitStart))" />
    </div>

    <!-- Increment By -->
    <div class="field-row">
        <label class="@(UseUnits ? "" : "label-disabled")">Increment By</label>
        <input type="number" min="0" @bind="UnitIncrement" disabled="@(!UseUnits)"
               @onfocusin="() => SelectAllOnFocus(nameof(UnitIncrement))" />
    </div>

    <!-- Buttons -->
    <div class="button-row">
        <button class="btn-primary" disabled="@(Copies <= 0)" @onclick="OnOkClick">&amp;OK</button>
        <button @onclick="OnCancelClick">&amp;Cancel</button>
    </div>
</div>

@code {
    // === Result callback ===
    [Parameter] public EventCallback<SplitItemsResult> OnCompleted { get; set; }

    // === Form State ===
    private int Copies { get; set; } = 0;
    private bool AllocateDollarAmount { get; set; } = true;
    private int AllocateOption { get; set; } = 0; // 0 = Equal shares, 1 = Custom percentages
    private bool UseUnits { get; set; } = false;
    private long UnitStart { get; set; } = 100;
    private long UnitIncrement { get; set; } = 1;
    private bool Cancelled { get; set; } = false;

    // Percent values for custom allocation
    private List<double> PercentValues { get; set; } = new();

    // Track previous copies to resize percent array
    private int _previousCopies = 0;

    protected override void OnInitialized()
    {
        RecalculatePercentValues();
    }

    protected override void OnParametersSet()
    {
        if (Copies != _previousCopies)
        {
            RecalculatePercentValues();
            _previousCopies = Copies;
        }
    }

    private void OnAllocateOptionChanged(int option)
    {
        AllocateOption = option;
        RecalculatePercentValues();
    }

    private void RecalculatePercentValues()
    {
        if (Copies <= 0)
        {
            PercentValues = new List<double>();
            return;
        }

        // Resize the list
        while (PercentValues.Count < Copies)
            PercentValues.Add(0);
        while (PercentValues.Count > Copies)
            PercentValues.RemoveAt(PercentValues.Count - 1);

        if (AllocateOption == 0) // Equal shares
        {
            for (int i = 0; i < Copies - 1; i++)
            {
                PercentValues[i] = Math.Floor(100.0 / Copies);
            }
            // Last one gets the remainder
            double sumOthers = 0;
            for (int i = 0; i < Copies - 1; i++)
                sumOthers += PercentValues[i];
            PercentValues[Copies - 1] = 100 - sumOthers;
        }
        else // Custom — just recalculate last column
        {
            RecalculateLastPercent();
        }
    }

    private void OnPercentChanged(int index, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var val))
        {
            PercentValues[index] = val;
        }
        RecalculateLastPercent();
    }

    private void RecalculateLastPercent()
    {
        if (Copies <= 0) return;
        double total = 0;
        for (int i = 0; i < Copies - 1; i++)
            total += PercentValues[i];
        PercentValues[Copies - 1] = 100 - total;
    }

    private async Task OnOkClick()
    {
        Cancelled = false;

        var result = new SplitItemsResult
        {
            Success = true,
            WriteUnits = UseUnits,
            UnitStart = UnitStart,
            UnitIncrement = UnitIncrement,
            Percents = BuildPercents()
        };

        if (OnCompleted.HasDelegate)
            await OnCompleted.InvokeAsync(result);
    }

    private async Task OnCancelClick()
    {
        Cancelled = true;

        var result = new SplitItemsResult { Success = false };

        if (OnCompleted.HasDelegate)
            await OnCompleted.InvokeAsync(result);
    }

    private double[] BuildPercents()
    {
        int c = Copies;
        if (c <= 0) return Array.Empty<double>();

        // 1-based array like VB6 (index 0 unused, 1..c used)
        var percents = new double[c + 1];

        if (!AllocateDollarAmount)
        {
            // No allocation: first copy gets 100%
            percents[1] = 1.0;
        }
        else if (AllocateOption == 0) // Equal shares
        {
            for (int i = 1; i <= c - 1; i++)
            {
                percents[i] = 1.0 / c;
            }
            percents[c] = 1.0 - ((c - 1.0) / c);
        }
        else // Custom percentages
        {
            for (int i = 1; i <= c; i++)
            {
                percents[i] = PercentValues[i - 1] / 100.0;
            }
        }

        return percents;
    }

    private void SelectAllOnFocus(string fieldName)
    {
        // In Blazor, text selection on focus requires JS interop.
        // This is a placeholder; implement via JSRuntime if needed.
    }

    // === Result Model ===
    public class SplitItemsResult
    {
        public bool Success { get; set; }
        public double[] Percents { get; set; } = Array.Empty<double>();
        public bool WriteUnits { get; set; }
        public long UnitStart { get; set; }
        public long UnitIncrement { get; set; }
    }
}
