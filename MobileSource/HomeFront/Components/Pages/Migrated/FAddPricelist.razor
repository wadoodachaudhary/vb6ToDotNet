    // === Community Changed (VB6 cboCommunity_Click) ===
    // Corporate (ListIndex 0) → no assembly allowed: disable the gAssemblies grid (and
    // its label). VB6 only toggles .Enabled — it does NOT clear the rows.
    private void OnCommunityChanged()
    {
        AssemblyEnabled = !SelectedCommunityKey.StartsWith("Corporate");
    }

    // === Parse Community Key ===
    private (string Community, string CommunityPhase) ParseCommunityKey()
    {
        var parts = SelectedCommunityKey.Split('\x02');
        var community = parts.Length > 0 ? parts[0] : "";
        var phase = parts.Length > 1 ? parts[1] : "";

        if (community == "Corporate (any Division)" || community == $"Global (any {CD_Community})")
            community = "";

        return (community, phase);
    }

    // === PO Index Checked Changed ===
    private async Task OnPOIndexCheckedChanged(POIndexCheckItem po, bool isChecked)
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            po.IsChecked = isChecked;

            if (!isChecked)
            {
                // Remove items for this PO index (VB6 gPOIndexes_AfterEdit unchecked path)
                AllItemsData.RemoveAll(i => i.POIndex == po.POIndex);
            }
            else
            {
                // VB6 gPOIndexes_AfterEdit (checked path), NEW multi-assembly model:
                // build ONE query that UNION-ALLs a per-assembly block for every real
                // gAssemblies row (For r = 0 To .Rows - 2 — i.e. every row EXCEPT the
                // trailing blank), each carrying that row's
                // AssemblyDescription/Model/OptionID/Assembly/RowKey as literals plus
                // its own Purch_GetItemRate / Quality / VendorSKU (those funcs take the
                // per-assembly Assembly/Model/Option), then strip the leading "UNION ALL".
                // Each block is parameterized — the literals/args become @p0_Xxx params.
                var (community, communityPhase) = ParseCommunityKey();

                var assemblies = GAssemblyRows.Where(a => !a.IsBlank).ToList();

                var sb = new StringBuilder();
                var prms = new Dictionary<string, object>
                {
                    ["Community"] = community,
                    ["CommunityPhase"] = communityPhase,
                    ["Vendor"] = VendorId ?? "",
                    ["POIndex"] = po.POIndex
                };

                // VB6 quirk: when there are NO assemblies the loop body never runs and
                // s = Mid(s, 12) on an empty string yields "" (no items load). We mirror
                // that — a unit-prices-only list with the blank row checks a PO but loads
                // nothing until an assembly is added. (VB6 leaves gItems empty too.)
                for (int idx = 0; idx < assemblies.Count; idx++)
                {
                    var a = assemblies[idx];
                    var p = $"a{idx}";
                    prms[$"{p}_Desc"] = a.Description ?? "";
                    prms[$"{p}_Model"] = a.Model ?? "";
                    prms[$"{p}_Option"] = a.Option ?? "";
                    prms[$"{p}_Assembly"] = a.Assembly ?? "";
                    prms[$"{p}_Key"] = a.Key ?? "";

                    sb.AppendLine("UNION ALL");
                    sb.AppendLine(
                        $@"SELECT @{p}_Desc AssemblyDescription, @{p}_Model Model, @{p}_Option OptionID, @{p}_Assembly Assembly, @{p}_Key RowKey
                           ,i.POIndex,i.Phase,i.Item,i.Description,i.OrderUOM,i.PriceLink,t.TaxGroup,t.Description TaxGroupDesc,i.PartNumber
                           ,dbo.Purch_GetItemRate(0,0,@Community,@CommunityPhase,@{p}_Assembly,@{p}_Model,@{p}_Option,i.phase,i.item,0,@Vendor,getdate(),{SessionState.DivisionID}) Price
                           ,dbo.Purch_GetItemRateQuality(0,0,@Community,@CommunityPhase,@{p}_Assembly,@{p}_Model,@{p}_Option,i.phase,i.item,0,@Vendor,getdate(),{SessionState.DivisionID}) Quality
                           ,dbo.Purch_GetVendorSKU(@Vendor,@Community,@{p}_Assembly,@{p}_Model,i.phase,i.item,{SessionState.DivisionID}) VendorSKU
                           FROM tblPhaseItem i
                           LEFT OUTER JOIN TaxGroups t ON(i.DivisionID = t.DivisionID and i.TaxGroup=t.TaxGroup)
                           WHERE i.DivisionID = {SessionState.DivisionID} and POIndex=@POIndex");
                }

                if (sb.Length > 0)
                {
                    // Strip the leading "UNION ALL\r\n" (VB6 s = Mid(s, 12)).
                    var sql = sb.ToString();
                    var firstNl = sql.IndexOf('\n');
                    sql = firstNl >= 0 ? sql.Substring(firstNl + 1) : sql;

                    var rows = await db.QueryAsync(sql, prms);

                    foreach (var r in rows)
                    {
                        var quality = r["Quality"]?.ToString() ?? "";
                        var vendorSKU = r["VendorSKU"]?.ToString() ?? "";
                        var partNumber = r["PartNumber"]?.ToString() ?? "";

                        AllItemsData.Add(new PricelistItemRow
                        {
                            POIndex = r["POIndex"]?.ToString() ?? "",
                            Phase = r["Phase"]?.ToString() ?? "",
                            Item = r["Item"]?.ToString() ?? "",
                            Description = r["Description"]?.ToString() ?? "",
                            OrderUOM = r["OrderUOM"]?.ToString() ?? "",
                            PriceLink = r["PriceLink"]?.ToString() ?? "",
                            TaxGroup = r["TaxGroup"]?.ToString() ?? "",
                            TaxGroupDesc = r["TaxGroupDesc"]?.ToString() ?? "",
                            SKU = !string.IsNullOrEmpty(vendorSKU) ? vendorSKU : partNumber,
                            Price = SafeDecimal(r["Price"]),
                            Quality = quality,
                            IsNewItem = quality == "12" || quality == "13" || string.IsNullOrEmpty(quality),
                            // VB6 carries the per-assembly identity onto every loaded
                            // gItems row (5 new cols) — Save reads Assembly/Model PER ROW,
                            // and gAssemblies_KeyDown matches rows to delete by RowKey.
                            AssemblyDescription = r["AssemblyDescription"]?.ToString() ?? "",
                            Model = r["Model"]?.ToString() ?? "",
                            Assembly = r["Assembly"]?.ToString() ?? "",
                            Option = r["OptionID"]?.ToString() ?? "",
                            RowKey = r["RowKey"]?.ToString() ?? ""
                        });
                    }
                }
            }

            ApplyFilter();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnPOIndexCheckedChanged error");

            Notifications.Error($"Error loading items: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

