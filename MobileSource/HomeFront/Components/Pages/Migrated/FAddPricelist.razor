@page "/add-pricelist"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using System.Reflection
@using System.Text
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FAddPricelist> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@using HomeFront.Models
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db
@layout HFComponent

<PageTitle>Add Vendor Pricing - HomeFront</PageTitle>

@* VB6 FAddPricelist.Show vbModal over FPriceList. Rendered as the STANDARD FlexKit
   modal (DialogControl): a title bar ("Add Vendor Pricing"), a single managed body
   scroller, and a footer for the action buttons. Sized to the VB6 form (ClientWidth
   14115 twips ≈ 941px × ClientHeight 7230 ≈ 482px → 960×540 with chrome). The two
   grids scroll INTERNALLY (bounded height) so the window itself never scrolls — one
   scroller per grid, no window scrollbar (VB6 fixed-form behaviour). *@
<DialogControl Visible="true"
               Header="@DialogHeader"
               Width="1200px"
               Height="675px"
               CssClass="addpl-dialog"
               ShowCloseIcon="true"
               CloseOnEscape="true"
               OnClose="ClosePage">
    <ChildContent>
        @if (IsLoading)
        {
            <div class="loading-overlay"><div class="loading-spinner">⏳ Loading...</div></div>
        }

        @* VB6 WizHead: bold sub-heading + description on the left, the Pricebook icon
           top-right INSIDE the window (beneath the title bar). *@
        <div class="addpl-wizhead">
            <div class="addpl-wizhead-text">
                <div class="addpl-wizhead-title">Create a Vendor Pricelist</div>
                <div class="addpl-wizhead-desc">Select the vendor and price list information, then select purchase orders and enter prices.</div>
            </div>
            <img class="addpl-wizhead-icon" src="images/32/Pricebook.ico" alt="" onerror="this.style.display='none'" />
        </div>

        @* Card layout: column 1 = Vendor + Community; column 2 = "Assemblies" grid.
           Vendor is a read-only display with a "…" ButtonControl that opens the shared
           FPickList (VB6 cmdVendor → .Choose); Community is a DropDownListControl (VB6
           cboCommunity). All FlexKit — no raw inputs.

           NEW VB6 MODEL: the dialog now prices MANY assemblies at once. The single
           scalar Assembly display + one "…" button was replaced by the gAssemblies grid
           (VB6 VSFlexGrid gAssemblies, 5 cols Description/Assembly/Model/Option/Key) —
           a one-column visible "Description" list with a "…" cell button (VB6
           gAssemblies_CellButtonClick → multi-pick FPickList) and a trailing blank
           "Unit Prices" row so picking always APPENDS. Pressing the row's "✕" (VB6
           gAssemblies_KeyDown Delete) drops that assembly AND its loaded gItems rows. *@
        <div class="addpl-cards">
            <div class="addpl-card-col">
                <div class="addpl-field">
                    <label>Vendor</label>
                    <div class="addpl-field-input">
                        <span class="addpl-value">@VendorDisplay</span>
                        <ButtonControl BareStyle="true" CssClass="addpl-pick-btn fx-grid-popup-btn" OnClick="OnVendorPickerClick">…</ButtonControl>
                    </div>
                </div>
                <div class="addpl-field">
                    <label>Community</label>
                    <div class="addpl-field-input">
                        <DropDownListControl TValue="string" TItem="CommunityComboItem"
                                             Value="@SelectedCommunityKey"
                                             ValueChanged="OnCommunityKeyChanged"
                                             DataSource="@CommunityItems"
                                             TextFieldName="Display"
                                             ValueFieldName="Key"
                                             Width="300px" />
                    </div>
                </div>
            </div>
            <div class="addpl-card-col">
                <div class="addpl-section-title">Assemblies</div>
                @* VB6 gAssemblies: VirtualData VSFlexGrid, 5 cols (only "Description"
                   visible; Assembly/Model/Option/Key are data carriers). Each row's
                   "…" opens the multi-assembly FPickList; the trailing blank row keeps
                   "Unit Prices" so a unit-price-only list is still possible. Disabled
                   when Community = Corporate (VB6 cboCommunity_Click). *@
                <GridControl @ref="AssembliesGrid"
                        TValue="GAssemblyRow"
                        DataSource="@GAssemblyRows"
                        AllowSorting="false"
                        AllowSelection="true"
                        EnableHover="true"
                        Height="120px"
                        CssClass='@("addpl-asm-grid" + (AssemblyEnabled ? "" : " addpl-asm-disabled"))'>
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(GAssemblyRow.Description)" HeaderText="" Width="460px" AllowEditing="false" ClipMode="ClipMode.Ellipsis">
                            <Template>
                                @{ var asm = (GAssemblyRow)context; }
                                <div class="addpl-asm-cell">
                                    <span class="addpl-asm-text">@(string.IsNullOrEmpty(asm.Description) ? "Unit Prices" : asm.Description)</span>
                                    @* VB6 gAssemblies_KeyDown (Delete) — only real (non-trailing) rows. *@
                                    @if (!asm.IsBlank)
                                    {
                                        <button class="addpl-asm-del fx-grid-popup-btn"
                                                title="Remove this assembly"
                                                @onclick="() => OnRemoveAssemblyRow(asm)"
                                                @onclick:stopPropagation="true">✕</button>
                                    }
                                    @* VB6 gAssemblies_CellButtonClick — opens the multi-assembly picker. *@
                                    <button class="addpl-asm-pick fx-grid-popup-btn"
                                            disabled="@(!AssemblyEnabled)"
                                            title="Add assemblies"
                                            @onclick="() => OnAssemblyCellButtonClick(asm)"
                                            @onclick:stopPropagation="true">…</button>
                                </div>
                            </Template>
                        </GridColumn>
                    </GridColumnsBase>
                </GridControl>
            </div>
        </div>

        @* Split: PO Index grid (left) + Item Prices grid (right). Both are FlexKit
           GridControls with bounded Height → each scrolls internally; the dialog body
           does not scroll. *@
        <div class="addpl-split">
            <div class="addpl-po">
                <div class="addpl-section-title">PO Index</div>
                @* VB6 gPOIndexes: a one-column checklist grid. FlexKit GridControl with
                   a CheckBox column (toggling it loads/removes that PO's items via
                   OnCellSave → OnPOIndexCheckedChanged) + the PO display column. *@
                <GridControl @ref="POIndexGrid"
                        TValue="POIndexCheckItem"
                        DataSource="@POIndexItems"
                        AllowSorting="false"
                        AllowSelection="true"
                        EnableHover="true"
                        Height="300px"
                        EditSettingsRef="@poEditSettings"
                        SelectionSettingsRef="@poSelectionSettings"
                        EventsRef="@poGridEvents">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(POIndexCheckItem.IsChecked)" HeaderText="" Width="34px" Type="ColumnType.CheckBox" AllowEditing="true" />
                        <GridColumn Field="@nameof(POIndexCheckItem.Display)" HeaderText="PO Index" Width="180px" AllowEditing="false" />
                    </GridColumnsBase>
                </GridControl>
            </div>

            <div class="addpl-items">
                <div class="addpl-items-head">
                    <span class="addpl-section-title">Item Prices</span>
                    @* VB6 chkNewOnly → ShowItems filter. FlexKit CheckBoxControl. *@
                    <CheckBoxControl Checked="@ShowNewOnly"
                                     Label="show new items only"
                                     CheckedChanged="OnShowNewOnlyChanged" />
                </div>

                @* Multi-select bulk edit on Price / SKU, mirroring FTakeoff /
                   FAssembly's TakeoffQty / OrderQty fan-out: SelectionMode.Cell +
                   SelectionType.Multiple lets the user Ctrl/Cmd-click several Price
                   (or SKU) cells (or whole rows), then type a value and press Enter
                   to commit it to every selected cell in one shot via
                   OnTypeAheadCommit. EditMode.Batch gives the inline cell editor
                   (no "edit box" popup); BatchEditBehavior.SingleCell +
                   AllowSingleCellColumnMassEdit enable the per-column mass edit.
                   Price is numeric (digits only); SKU is a free-text string —
                   GridControl's type-ahead allows any character on non-Number
                   columns, so the same gesture bulk-edits SKUs. *@
                <GridControl @ref="ItemsGrid"
                        TValue="PricelistItemRow"
                        DataSource="@FilteredItemsData"
                        AllowSorting="true"
                        AllowResizing="true"
                        AllowSelection="true"
                        EnableHover="true"
                        Height="300px"
                        EditSettingsRef="@editSettings"
                        SelectionSettingsRef="@selectionSettings"
                        BatchEditBehavior="GridBatchEditBehavior.SingleCell"
                        AllowSingleCellColumnMassEdit="true"
                        TypeAheadTargetField="@ItemsTypeAheadTargetField"
                        EventsRef="@itemsGridEvents"
                        OnLayoutChanged="@OnItemsLayoutChangedAsync">
                    @* VB6 FAddPricelist.Form_Load → IniGetGrid(Me, gItems): the gItems
                       column set (which columns appear, their captions, widths, hidden
                       flags and order) is DATA-DRIVEN from AppGridLayout (gridname
                       'FAddPricelist.gItems') — NOT hardcoded. We render exactly the
                       visible columns the saved layout defines, in its colindex order,
                       with its twips→px widths. For the canonical (admin) layout that is
                       Phase, Item, Description, Price, SKU and Assembly (colkey
                       AssemblyDescription, caption "Assembly"). Editable cells follow VB6
                       gItems_BeforeEdit (Price, TaxGroup, TaxGroupDesc, SKU editable;
                       everything else Cancel=True) — of the visible set only Price and
                       SKU apply because TaxGroup/TaxGroupDesc are hidden. *@
                    @if (HasItemsGridLayout)
                    {
                        <GridColumnsBase @key="ItemsGridLayoutVersion" DebugTag="FAddPricelist-gItems">
                            @foreach (var entry in GetOrderedItemsGridLayout())
                            {
                                var layout = entry.Layout;
                                var fieldName = entry.Field;
                                var columnType = entry.ColumnType;
                                var textAlign = entry.TextAlign;
                                var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                                var width = layout.Width.HasValue && layout.Width.Value > 0
                                    ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                                    : null;

                                if (fieldName.Equals(nameof(PricelistItemRow.Price), StringComparison.OrdinalIgnoreCase))
                                {
                                    <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width"
                                                Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="N2"
                                                ClipMode="ClipMode.Ellipsis"
                                                AllowEditing="true" SelectAllOnEdit="true" Visible="true" />
                                }
                                else if (fieldName.Equals(nameof(PricelistItemRow.TaxGroup), StringComparison.OrdinalIgnoreCase))
                                {
                                    <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width"
                                                ClipMode="ClipMode.Ellipsis" AllowEditing="true" Visible="true">
                                        <EditTemplate>
                                            @{ var data = (PricelistItemRow)context; }
                                            <DropDownListControl TValue="string" TItem="TaxGroupItem"
                                                                 Value="@data.TaxGroup"
                                                                 ValueChanged="@(v => { data.TaxGroup = v ?? string.Empty; OnTaxGroupChanged(data); })"
                                                                 DataSource="@TaxGroupList"
                                                                 TextFieldName="Display"
                                                                 ValueFieldName="TaxGroup"
                                                                 Placeholder="-- Select --" />
                                        </EditTemplate>
                                    </GridColumn>
                                }
                                else if (fieldName.Equals(nameof(PricelistItemRow.SKU), StringComparison.OrdinalIgnoreCase))
                                {
                                    <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width"
                                                Type="@columnType" TextAlign="@textAlign"
                                                ClipMode="ClipMode.Ellipsis"
                                                AllowEditing="true" Visible="true" />
                                }
                                else
                                {
                                    <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width"
                                                Type="@columnType" TextAlign="@textAlign"
                                                ClipMode="ClipMode.Ellipsis"
                                                AllowEditing="false" Visible="true" />
                                }
                            }
                        </GridColumnsBase>
                    }
                    else
                    {
                        @* No AppGridLayout rows for this user AND no default-user ('')
                           seed exists for FAddPricelist.gItems (unlike FAssembly.gItems,
                           which ships a '' default). Surface "[gItems FALLBACK]" in the
                           dialog header (see DialogHeader) and render the VB6 design-time
                           default visible columns so the grid is never blank. *@
                        <GridColumnsBase DebugTag="FAddPricelist-gItems-fallback">
                            <GridColumn Field="@nameof(PricelistItemRow.Phase)" HeaderText="Phase" Width="80px" AllowEditing="false" />
                            <GridColumn Field="@nameof(PricelistItemRow.Item)" HeaderText="Item" Width="63px" AllowEditing="false" />
                            <GridColumn Field="@nameof(PricelistItemRow.Description)" HeaderText="Description" Width="458px" AllowEditing="false" ClipMode="ClipMode.Ellipsis" />
                            <GridColumn Field="@nameof(PricelistItemRow.Price)" HeaderText="Price" Width="80px" Format="N2" TextAlign="TextAlign.Right" Type="ColumnType.Number" AllowEditing="true" SelectAllOnEdit="true" />
                            <GridColumn Field="@nameof(PricelistItemRow.SKU)" HeaderText="SKU" Width="80px" AllowEditing="true" />
                            <GridColumn Field="@nameof(PricelistItemRow.AssemblyDescription)" HeaderText="Assembly" Width="80px" AllowEditing="false" />
                        </GridColumnsBase>
                    }
                </GridControl>
            </div>
        </div>

        @* Shared FlexKit picklist for Vendor (cmdVendor) and Assembly (cmdAssembly).
           VB6 .Choose maps to FPickList. *@
        <FPickList @ref="_pickList" OnSelected="OnPickListSelected" />
    </ChildContent>
    <FooterContent>
        @* VB6 cmdNav(Save / Clear List / Close) — in the dialog footer (fixed; never
           scrolls with the body). *@
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnSaveClick">Save</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnClearListClick">Clear List</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnCloseClick">Close</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    // === Modal hosting (VB6 FAddPricelist.Show vbModal over FPriceList) ===
    // When IsModal=true the host (FPriceList) renders this as a child
    // component behind a backdrop; Close raises OnClose so the host hides it.
    // When false (standalone /add-pricelist route) Close navigates home.
    [Parameter] public bool IsModal { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task ClosePage()
    {
        if (IsModal)
        {
            if (OnClose.HasDelegate) await OnClose.InvokeAsync();
        }
        else if (ParentNavigate != null)
        {
            ParentNavigate.Invoke("");
        }
    }

    // === Parameters (passed from parent or navigation) ===
    // NEW VB6 MODEL: no DefaultAssembly — the dialog no longer opens against a single
    // assembly (the user adds many via the gAssemblies grid). ShowForm/host pass only
    // Vendor + community + CommunityPhase.
    [Parameter] public string? DefaultVendor { get; set; }
    [Parameter] public string? DefaultCommunity { get; set; }
    [Parameter] public string? DefaultCommunityPhase { get; set; }

    // === Database ===
private string CD_Community = "Community";

    // === UI State ===
    private bool IsLoading = false;
    private bool ShowNewOnly = false;

    // === Vendor ===
    private string VendorId = "";
    private string VendorDisplay = "";

    // === Community ===
    private string SelectedCommunityKey = "";
    private List<CommunityComboItem> CommunityItems = new();
    private bool AssemblyEnabled = true;

    // === Assemblies (VB6 gAssemblies grid) ===
    // NEW VB6 MODEL: the dialog prices MANY assemblies. gAssemblies is a list of rows,
    // each with Description / Assembly / Model / Option / Key. The list ALWAYS ends with
    // one blank "Unit Prices" row (IsBlank) — VB6's last row is the type-into/append
    // anchor (".Row = .Rows - 1"). Picking assemblies inserts real rows ABOVE the blank
    // one; deleting the last real row restores the lone blank row. The per-assembly
    // gItems load (OnPOIndexCheckedChanged) UNION-ALLs one block per row in this list.
    private GridControl<GAssemblyRow>? AssembliesGrid;
    private List<GAssemblyRow> GAssemblyRows = new() { new GAssemblyRow() };

    // VB6 BuilderType (HFApp.Options.ValueByName("BuilderType")) gates the picker view
    // set: "Commercial" → Master/Specific-Extras/Design/Global Assemblies; anything else
    // → Models / Model-Specific-Options / Design-Center / Global Options (+ a second
    // model→option pick). Loaded from appoptions on init; default "Residential".
    private string BuilderType = "Residential";

    // The gAssemblies row whose "…" launched the current pick (VB6 ByVal Row). New rows
    // append at/above the trailing blank one regardless, but we remember it so a re-pick
    // on a populated row still routes correctly.
    private GAssemblyRow? _assemblyPickRow;

    // === PO Indexes ===
    private List<POIndexCheckItem> POIndexItems = new();

    // === PO Index Grid (VB6 gPOIndexes checklist) ===
    private GridControl<POIndexCheckItem>? POIndexGrid;
    private readonly EditSettings poEditSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch
    };
    private readonly SelectionSettings poSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Cell
    };
    private readonly GridControlEvents<POIndexCheckItem> poGridEvents = new();

    // === Items Grid ===
    private GridControl<PricelistItemRow>? ItemsGrid;
    private List<PricelistItemRow> AllItemsData = new();
    private List<PricelistItemRow> FilteredItemsData = new();

    // === Items Grid layout (VB6 IniGetGrid(Me, gItems) → AppGridLayout) ===
    // The gItems columns are NOT hardcoded: which columns show, their captions,
    // widths, hidden flags and order all come from AppGridLayout under gridname
    // 'FAddPricelist.gItems' (formName "FAddPricelist", gridName "gItems"). Mirror
    // of FAssembly's gItems dynamic-layout pattern.
    // The load/resolve/order/width boilerplate lives in GridLayoutPresenter<TRow>;
    // only the VB6 form/grid name strings stay here (fidelity). The members below
    // are thin delegations so the markup and the rest of this file are unchanged.
    private readonly GridLayoutPresenter<PricelistItemRow> _itemsGrid =
        new("FAddPricelist", "gItems", grouped: false);
    private Dictionary<string, GridLayoutColumn> ItemsGridLayout => _itemsGrid.Layout;
    private bool HasItemsGridLayout => _itemsGrid.Has;
    private int ItemsGridLayoutVersion => _itemsGrid.Version;
    // True when the AppGridLayout load fell back (no rows for this user). Surfaced
    // in the dialog header as "[gItems FALLBACK]" — no silent fallbacks.
    private bool ItemsGridLayoutFallbackUsed => _itemsGrid.FallbackUsed;

    // Dialog title — VB6 caption "Add Vendor Pricing", with the gItems-fallback
    // marker appended when the saved column layout could not be loaded for this
    // user (FAddPricelist.gItems has no default-user '' seed, unlike FAssembly).
    private string DialogHeader =>
        (ItemsGridLayoutFallbackUsed || !HasItemsGridLayout)
            ? "Add Vendor Pricing  [gItems FALLBACK]"
            : "Add Vendor Pricing";

    // === Tax Groups ===
    private List<TaxGroupItem> TaxGroupList = new();

    // === Shared FlexKit picklist (Vendor + Assembly) — VB6 .Choose ===
    private FPickList? _pickList;
    private string _pickListContext = "";

    // === Grid Settings ===
    // EditMode.Batch = inline cell editor (no popup "edit box"); matches FTakeoff /
    // FAssembly so multi-select type-ahead fan-out works on Price / SKU. Single-cell
    // edits commit via the grid's reflection write; multi-cell / multi-row edits go
    // through OnTypeAheadCommit (see OnItemsTypeAheadCommit).
    private EditSettings editSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch
    };
    // Cell selection + Multiple = the user can Ctrl/Cmd-click several Price (or SKU)
    // cells, or shift-select a range, then bulk-edit them (FTakeoff parity).
    private SelectionSettings selectionSettings = new()
    {
        Mode = SelectionMode.Cell,
        Type = SelectionType.Multiple,
        EnableToggle = true
    };

    // === Items grid events + mass-edit fan-out (FTakeoff / FAssembly parity) ===
    private GridControlEvents<PricelistItemRow> itemsGridEvents = new();
    // The editable column the user last entered — tells type-ahead which column to
    // fan a typed value across when multiple ROWS (not cells) are selected. Default
    // target is Price (the most common bulk edit on this dialog).
    private string? _activeEditColumn;
    private string ItemsTypeAheadTargetField =>
        string.IsNullOrEmpty(_activeEditColumn) ? nameof(PricelistItemRow.Price) : _activeEditColumn;

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        // VB6 gPOIndexes_AfterEdit: toggling a PO's checkbox loads/removes its items.
        // FlexKit commits a checkbox-column toggle via OnCellSave; route it to the
        // existing handler (the bound IsChecked is already flipped by the grid).
        poGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<POIndexCheckItem>>(
            this, async args =>
            {
                if (args.Data != null)
                    await OnPOIndexCheckedChanged(args.Data, args.Data.IsChecked);
            });

        // Multi-select bulk edit on the Item Prices grid (Price / SKU), FTakeoff /
        // FAssembly parity. OnCellEdit captures which editable column the user is in
        // (so a multi-ROW type-ahead knows the target); OnTypeAheadCommit fans the
        // typed value across every selected cell/row in one shot.
        itemsGridEvents.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<PricelistItemRow>>(
            this, args => { _activeEditColumn = args.ColumnName; });
        itemsGridEvents.OnTypeAheadCommit = EventCallback.Factory.Create<TypeAheadCommitArgs<PricelistItemRow>>(
            this, OnItemsTypeAheadCommit);

        await LoadLookupData();
        await LoadItemsGridLayoutAsync();
        await LoadCommunities();
        await LoadPOIndexes();

        // Apply defaults
        if (!string.IsNullOrEmpty(DefaultVendor))
            await ValidateAndSetVendor(DefaultVendor);

        if (!string.IsNullOrEmpty(DefaultCommunity))
        {
            var key = (DefaultCommunity ?? "") + "\x02" + (DefaultCommunityPhase ?? "");
            var match = CommunityItems.FirstOrDefault(c => c.Key == key);
            if (match != null)
                SelectedCommunityKey = match.Key;
            else if (CommunityItems.Count > 1)
                SelectedCommunityKey = CommunityItems[1].Key;
            OnCommunityChanged();
        }
        else if (CommunityItems.Count > 1)
        {
            SelectedCommunityKey = CommunityItems[1].Key;
            OnCommunityChanged();
        }
    }

    // === ShowForm (callable from parent) ===
    // NEW VB6 SIGNATURE: ShowForm(Vendor, community, CommunityPhase) — the Assembly
    // parameter was REMOVED (the dialog no longer opens against one assembly; the user
    // adds them via the gAssemblies grid).
    public async Task ShowForm(string vendor, string community, string communityPhase)
    {
        DefaultVendor = vendor;
        DefaultCommunity = community;
        DefaultCommunityPhase = communityPhase;

        if (!string.IsNullOrEmpty(vendor))
            await ValidateAndSetVendor(vendor);

        var key = (community ?? "") + "\x02" + (communityPhase ?? "");
        var match = CommunityItems.FirstOrDefault(c => c.Key == key);
        if (match != null)
            SelectedCommunityKey = match.Key;
        OnCommunityChanged();

        StateHasChanged();
    }

    // === Load Lookup Data ===
    private async Task LoadLookupData()
    {
        try
        {
            // Tax groups
            var tgRows = await db.QueryAsync(
                $"SELECT TaxGroup, Description FROM TaxGroups WHERE DivisionID = {SessionState.DivisionID} ORDER BY TaxGroup");
            TaxGroupList = tgRows.Select(r => new TaxGroupItem
            {
                TaxGroup = r["TaxGroup"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? ""
            }).ToList();

            // CD_Community label
            var label = await db.ExecuteScalarAsync<string>(
                "SELECT ISNULL(NULLIF(custom_description,''),'Community') FROM customdescriptions WHERE item='Community'");
            if (!string.IsNullOrEmpty(label)) CD_Community = label;

            // VB6 HFApp.Options.ValueByName("BuilderType") — gates the assembly picker
            // view set (Commercial vs Residential). Default "Residential" when absent.
            var bt = await db.ExecuteScalarAsync<string>(
                $"SELECT optionvalue FROM appoptions WHERE optionname='BuilderType' AND DivisionID IN (0,{SessionState.DivisionID}) ORDER BY DivisionID DESC");
            if (!string.IsNullOrWhiteSpace(bt)) BuilderType = bt;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadLookupData error");

        }
    }

    // === Load Communities ===
    private async Task LoadCommunities()
    {
        CommunityItems.Clear();

        // Add special entries
        CommunityItems.Add(new CommunityComboItem { Display = "Corporate (any Division)", Key = "Corporate (any Division)\x02" });
        CommunityItems.Add(new CommunityComboItem { Display = $"Global (any {CD_Community})", Key = $"Global (any {CD_Community})\x02" });

        try
        {
            var sql = $@"
                SELECT c.Area+' -- '+ISNULL(c.Description,c.Area)+' (all phases)' AS Display,
                       c.Area+char(2) AS KeyVal, 0 AS SortOrd
                FROM tblLocality c
                JOIN DivisionCommunities dc ON c.Area = dc.Community
                WHERE c.Inactive<>1 AND dc.DivisionID = {SessionState.DivisionID}
                UNION ALL
                SELECT c.Area + '.' + p.CommunityPhase + ' -- ' + ISNULL(c.Description + ' ' + p.Description, c.Description) AS Display,
                       c.Area+char(2)+p.CommunityPhase AS KeyVal, 0 AS SortOrd
                FROM tblLocality c
                JOIN CommunityPhase p ON c.Area = p.Community
                JOIN DivisionCommunities dc ON c.Area = dc.Community
                WHERE c.Inactive<>1 AND dc.DivisionID = {SessionState.DivisionID}
                ORDER BY 1";

            var rows = await db.QueryAsync(sql);
            foreach (var r in rows)
            {
                CommunityItems.Add(new CommunityComboItem
                {
                    Display = r["Display"]?.ToString() ?? "",
                    Key = r["KeyVal"]?.ToString() ?? ""
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadCommunities error");

        }
    }

    // === Load PO Indexes ===
    private async Task LoadPOIndexes()
    {
        POIndexItems.Clear();
        try
        {
            var rows = await db.QueryAsync(
                $"SELECT poindex, description FROM tblpoindex WHERE DivisionID = {SessionState.DivisionID} ORDER BY 1");
            foreach (var r in rows)
            {
                var poIndex = r["poindex"]?.ToString() ?? "";
                if (!string.IsNullOrEmpty(poIndex))
                {
                    POIndexItems.Add(new POIndexCheckItem
                    {
                        POIndex = poIndex,
                        Description = r["description"]?.ToString() ?? "",
                        Display = $"{poIndex} {r["description"]}",
                        IsChecked = false
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadPOIndexes error");

        }
    }

