    // === Multi-select bulk edit fan-out (FTakeoff / FAssembly parity) ===
    // GridControl raises OnTypeAheadCommit once per type-ahead Enter when 2+
    // cells/rows are selected: we write the typed value to the target column on
    // every selected row. Price parses to decimal (numeric column); SKU takes the
    // raw string (free-text column — GridControl's type-ahead allows any character
    // on non-Number columns). Restricted to Price / SKU by design — the other
    // gItems columns are read-only (VB6 gItems_BeforeEdit Case Else: Cancel=True).
    private async Task OnItemsTypeAheadCommit(TypeAheadCommitArgs<PricelistItemRow> args)
    {
        var field = !string.IsNullOrEmpty(args.ColumnName)
            ? args.ColumnName
            : ItemsTypeAheadTargetField;

        if (field != nameof(PricelistItemRow.Price)
            && field != nameof(PricelistItemRow.SKU))
            return;

        var applied = 0;
        foreach (var item in args.SelectedItems)
        {
            switch (field)
            {
                case nameof(PricelistItemRow.Price):
                    item.Price = decimal.TryParse(args.Value, out var price) ? price : 0m;
                    break;
                case nameof(PricelistItemRow.SKU):
                    item.SKU = args.Value ?? "";
                    break;
            }
            applied++;
        }
        if (applied == 0) return;

        if (ItemsGrid != null)
            await ItemsGrid.Refresh();
        StateHasChanged();
    }

