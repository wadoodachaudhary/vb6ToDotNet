    {
        var div = SessionState.DivisionID;
        var ca = SqlAlias(CD_Community);
        var views = new List<(string Name, string Sql)>();

        if (isCommercial)
        {
            views.Add(("Master Assemblies", $@"
select c.area AreaID,c.description {ca},a.Model,a.Model modelid,a.OptionID,a.Assembly,a.Description,a.assemblytype,0 Source,a.Series,a.Style,a.Elevation
from tbldbassemblymaster a left outer join tbllocality c on(a.community=c.area)
where a.DivisionID = {div} and isnull(a.inactive,0)=0 and a.assemblytype=0 order by 1,2,3,4,5,6,7"));

            views.Add(("Assembly Specific Extras", $@"
select ct.Description Category,c.area AreaID,c.description {ca},a.Model,dm.description ModelDescription,a.Series,a.Model modelid,a.OptionID,a.OptionID [Option],a.Assembly,a.Description,a.assemblytype,0 Source
from tbldbassemblymaster a left outer join tbllocality c on(a.community=c.area) left outer join tblcategories ct on(a.category=ct.category) left outer join distinctmodelsbydivision dm on(a.model=dm.model and a.divisionid=dm.divisionid)
where a.DivisionID = {div} and isnull(a.inactive,0)=0 and a.assemblytype=2 order by 1,2,3,4,5,6,7"));

            views.Add(("Design Assemblies", $@"
select ct.Description Category,c.area AreaID,c.description {ca},a.Model modelid,a.OptionID,a.OptionID [Option],a.Assembly,a.Description,a.assemblytype,0 Source
from tbldbassemblymaster a left outer join tbllocality c on(a.community=c.area) left outer join tblcategories ct on(a.category=ct.category)
where a.DivisionID = {div} and isnull(a.inactive,0)=0 and a.assemblytype=4 order by 1,2,3,4,5,6,7"));

            views.Add(("Global Assemblies", $@"
select ct.Description Category,c.area AreaID,c.description {ca},a.Model modelid,a.OptionID,a.OptionID [Option],a.Assembly,a.Description,a.assemblytype,0 Source
from tbldbassemblymaster a left outer join tbllocality c on(a.community=c.area) left outer join tblcategories ct on(a.category=ct.category)
where a.DivisionID = {div} and isnull(a.inactive,0)=0 and a.assemblytype=3 order by 1,2,3,4,5,6,7"));
        }
        else
        {
            views.Add(("Models", $@"
select c.area AreaID,c.description {ca},a.Model,a.Model modelid,a.OptionID,a.Assembly,a.Description,a.assemblytype,0 Source,a.Series,a.Style,a.Elevation
from tbldbassemblymaster a left outer join tbllocality c on(a.community=c.area)
where a.DivisionID = {div} and isnull(a.inactive,0)=0 and a.assemblytype=0 order by 1,2,3,4,5,6,7"));

            views.Add(("Model Specific Options", $@"
select distinct m.Model,m.Description,0 Source,m.Model ModelID
from tbldbassemblymaster o
join DistinctModelsByDivision m on o.divisionid=m.divisionid and m.model=o.model
where o.assemblytype=2 and isnull(o.inactive,0)=0 and o.divisionid={div}"));

            views.Add(("Design Center Options", $@"
select ct.Description Category,c.area AreaID,c.description {ca},a.Model modelid,a.OptionID,a.OptionID [Option],a.Assembly,a.Description,a.assemblytype,0 Source
from tbldbassemblymaster a left outer join tbllocality c on(a.community=c.area) left outer join tblcategories ct on(a.category=ct.category)
where a.DivisionID = {div} and isnull(a.inactive,0)=0 and a.assemblytype=4 order by 1,2,3,4,5,6,7"));

            views.Add(("Global Options", $@"
select ct.Description Category,c.area AreaID,c.description {ca},a.Model modelid,a.OptionID,a.OptionID [Option],a.Assembly,a.Description,a.assemblytype,0 Source
from tbldbassemblymaster a left outer join tbllocality c on(a.community=c.area) left outer join tblcategories ct on(a.category=ct.category)
where a.DivisionID = {div} and isnull(a.inactive,0)=0 and a.assemblytype=3 order by 1,2,3,4,5,6,7"));
