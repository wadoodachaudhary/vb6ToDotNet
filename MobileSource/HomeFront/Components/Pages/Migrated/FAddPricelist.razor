    // VB6 second pick (residential "Model Specific Options"): after a model row is
    // chosen (SelectedView=2), pick the OPTION for that model (assemblytype=2).
    private string BuildAssemblyOptionsPickListQuery(string modelId)
    {
        var div = SessionState.DivisionID;
        var ca = SqlAlias(CD_Community);
        return $@"
select ct.Description Category,c.area AreaID,c.description {ca},a.Model,dm.description ModelDescription,a.Series,a.Model modelid,a.OptionID,a.OptionID [Option],a.Assembly,a.Description,a.assemblytype,0 Source
from tbldbassemblymaster a left outer join tbllocality c on(a.community=c.area) left outer join tblcategories ct on(a.category=ct.category) left outer join distinctmodelsbydivision dm on(a.model=dm.model and a.divisionid=dm.divisionid)
where a.DivisionID = {div} and isnull(a.inactive,0)=0 and a.assemblytype=2 and a.model={SqlQuote(modelId)}
order by 1,2,3,4,5,6,7";
    }

    private static string BuildPickListQueries(IEnumerable<(string Name, string Sql)> views) =>
        string.Join("|", views.Select(v => $"{v.Name};{v.Sql}"));

    private static string SqlAlias(string alias) =>
        string.IsNullOrWhiteSpace(alias) ? "[Community]" : $"[{alias.Replace("]", "]]")}]";

    private static string SqlQuote(string value) => $"'{(value ?? "").Replace("'", "''")}'";

    // === Remove an assembly row (VB6 gAssemblies_KeyDown, Delete) ===
    // Drop this assembly AND every gItems row it loaded (matched by RowKey). When the
    // last real row is removed, restore the lone blank "Unit Prices" row and clear the
    // items grid + uncheck all PO indexes (VB6).
    private async Task OnRemoveAssemblyRow(GAssemblyRow row)
    {
        if (row.IsBlank) return;

        // Remove this assembly's loaded prices (VB6 loops gItems matching RowKey).
        AllItemsData.RemoveAll(i => i.RowKey == row.Key);

        GAssemblyRows.Remove(row);

        if (GAssemblyRows.Count(a => !a.IsBlank) == 0)
        {
            // VB6: all assemblies removed → restore the blank Unit Prices row, clear the
            // items grid, uncheck every PO index.
            GAssemblyRows = new List<GAssemblyRow> { new GAssemblyRow() };
            AllItemsData.Clear();
            foreach (var po in POIndexItems) po.IsChecked = false;
            if (POIndexGrid != null) await POIndexGrid.Refresh();
        }
        else
        {
            // New list instance so the grid re-derives rows.
            GAssemblyRows = new List<GAssemblyRow>(GAssemblyRows);
        }

        ApplyFilter();
        if (AssembliesGrid != null) await AssembliesGrid.Refresh();
        if (ItemsGrid != null) await ItemsGrid.Refresh();
        StateHasChanged();
    }

    // === Shared picklist callback (VB6 cmdVendor result + gAssemblies_CellButtonClick) ===
    private async Task OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        var ctx = _pickListContext;

        if (ctx == "Vendor")
        {
            _pickListContext = "";
            if (selectedRows.Count == 0) { StateHasChanged(); return; }
            var pick = selectedRows[0];
            VendorId = pick.ContainsKey("vendor_id") ? pick["vendor_id"]?.ToString() ?? "" : "";
            var name = pick.ContainsKey("vendor_name") ? pick["vendor_name"]?.ToString() ?? "" : "";
            VendorDisplay = string.IsNullOrEmpty(VendorId) ? "" : $"{VendorId} - {name}";
            StateHasChanged();
            return;
        }

        if (ctx == "Assembly")
        {
            // VB6: empty result = Cancel / "New" → Exit Sub (no append).
            if (selectedRows.Count == 0) { _pickListContext = ""; StateHasChanged(); return; }

            // VB6: residential "Model Specific Options" view (SelectedViewIndex 1, VB6
            // SelectedView=2) → now pick the OPTION for the chosen model. Re-open the
            // picker; the SECOND result (assemblytype=2 rows) is what we actually append.
            if (!IsCommercial && (_pickList?.SelectedViewIndex ?? 0) == 1)
            {
                var modelId = GetRowString(selectedRows[0], "modelid");
                if (string.IsNullOrWhiteSpace(modelId))
                    modelId = GetRowString(selectedRows[0], "ModelID");
                if (string.IsNullOrWhiteSpace(modelId))
                    modelId = GetRowString(selectedRows[0], "Model");

                if (!string.IsNullOrWhiteSpace(modelId) && _pickList != null)
                {
                    _pickListContext = "AssemblyOption";
                    await _pickList.Open(
                        title: "Model and Option",
                        queries: BuildAssemblyOptionsPickListQuery(modelId),
                        hideColumns: "areaid,modelid,optionid,assemblytype,Source",
                        multiSelect: true);
                    return;
                }
            }

            await AppendPickedAssembliesAsync(selectedRows);
            _pickListContext = "";
            StateHasChanged();
            return;
        }

        if (ctx == "AssemblyOption")
        {
            _pickListContext = "";
            if (selectedRows.Count == 0) { StateHasChanged(); return; }
            await AppendPickedAssembliesAsync(selectedRows);
            StateHasChanged();
            return;
        }

        _pickListContext = "";
        StateHasChanged();
    }

    // VB6 gAssemblies_CellButtonClick append loop: For i = 1 To FPickList.SelectedItems —
    // build key = assembly|modelid|optionid, skip duplicates (.FindRow(key) <> -1), else
    // insert a row ABOVE the trailing blank one with Assembly/Model/Option/Key + a
    // "<assembly> -- <DistinctAssemblies.Description>" Description.
    private async Task AppendPickedAssembliesAsync(List<IDictionary<string, object>> picks)
    {
        foreach (var pick in picks)
        {
            var assembly = GetRowString(pick, "assembly");
            var model = GetRowString(pick, "modelid");
            if (string.IsNullOrWhiteSpace(model)) model = GetRowString(pick, "Model");
            var optionId = GetRowString(pick, "optionid");

            var key = $"{assembly}\x01{model}\x01{optionId}";
            // VB6 .FindRow(key, , .ColIndex("key")) = -1 → not already present.
            if (GAssemblyRows.Any(a => !a.IsBlank && a.Key == key)) continue;

            // VB6: s = SELECT Description FROM DistinctAssemblies WHERE Model=.. and
            // Assembly=.. and DivisionID=.. ; Description = assembly & " -- " & s.
            string desc = "";
            try
            {
                desc = await db.ExecuteScalarAsync<string>(
                    $"SELECT Description FROM DistinctAssemblies WHERE Model=@Model AND Assembly=@Assembly AND DivisionID = {SessionState.DivisionID}",
                    new { Model = model, Assembly = assembly }) ?? "";
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "AppendPickedAssemblies: DistinctAssemblies lookup failed");
            }

            var newRow = new GAssemblyRow
            {
                Assembly = assembly,
                Model = model,
                Option = optionId,
                Key = key,
                Description = $"{assembly} -- {desc}"
            };

            // Insert ABOVE the trailing blank row (VB6 inserts at .Row then advances).
            var blankIdx = GAssemblyRows.FindIndex(a => a.IsBlank);
            if (blankIdx < 0) blankIdx = GAssemblyRows.Count;
            GAssemblyRows.Insert(blankIdx, newRow);
        }

        // VB6 tail: gItems.Rows = 1 ; uncheck all PO indexes (the assembly set changed,
        // so any loaded prices are stale).
        AllItemsData.Clear();
        ApplyFilter();
        foreach (var po in POIndexItems) po.IsChecked = false;

        // New list instance so the grid re-derives rows.
        GAssemblyRows = new List<GAssemblyRow>(GAssemblyRows);
        if (AssembliesGrid != null) await AssembliesGrid.Refresh();
        if (POIndexGrid != null) await POIndexGrid.Refresh();
        if (ItemsGrid != null) await ItemsGrid.Refresh();
    }

    // === Save ===
    private async Task OnSaveClick()
    {
        if (AllItemsData.Count == 0) return;
        if (!ValidateData()) return;

        var (community, communityPhase) = ParseCommunityKey();
        var isCorporate = SelectedCommunityKey.StartsWith("Corporate");
        var divId = isCorporate ? 0 : SessionState.DivisionID;

        // Determine which items are visible (not filtered out)
        var visibleItems = FilteredItemsData.ToList();
        if (visibleItems.Count == 0) return;

        // Check for zero prices among visible items
        bool saveZeros = true;
        if (visibleItems.Any(i => i.Price == 0))
        {
            var result = await Dialogs.ConfirmAsync(
                "This list has items with a price of $0.00.\n\nDo you want to save them?");
            if (!result)
            {
                // User clicked Cancel equivalent -- abort save entirely
                // (VB6 had Yes/No/Cancel: Yes=save zeros, No=skip zeros, Cancel=abort)
                saveZeros = false;
            }
        }

        IsLoading = true;
        StateHasChanged();

        try
        {
            foreach (var item in visibleItems)
            {
                // Only save if price is non-zero, or user agreed to save zeros
                if (item.Price == 0 && !saveZeros) continue;

                // NEW VB6 MODEL: Assembly/Model come from the GRID ROW (the per-assembly
                // identity carried onto it at load), NOT a single scalar mAssembly/mModel.
                var rowAssembly = item.Assembly ?? "";
                var rowModel = item.Model ?? "";

                // INSERT (ignore if exists)
                var insertSql = $@"
                    IF NOT EXISTS (
                        SELECT 1 FROM tblVendorCost
                        WHERE Community=@Community AND CommunityPhase=@CommunityPhase
                          AND Assembly=@Assembly AND Model=@Model
                          AND Phase=@Phase AND Item=@Item AND Vendor=@Vendor
                          AND DivisionID =@DivisionID
                    )
                    INSERT INTO tblVendorCost(DivisionID, Community, CommunityPhase, Assembly, Model, Phase, Item, Vendor)
                    VALUES(@DivisionID, @Community, @CommunityPhase, @Assembly, @Model, @Phase, @Item, @Vendor)";

                await db.ExecuteAsync(insertSql, new
                {
                    DivisionID = divId,
                    Community = community,
                    CommunityPhase = communityPhase,
                    Assembly = rowAssembly,
                    Model = rowModel,
                    Phase = item.Phase,
                    Item = item.Item,
                    Vendor = VendorId
                });

                // UPDATE — VB6: PriceLink=0 when this row HAS an assembly, else keep its
                // existing PriceLink (now read per-row from item.Assembly).
                var priceLink = !string.IsNullOrEmpty(rowAssembly) ? 0 : SafeInt(item.PriceLink);
                var updateSql = $@"
                    UPDATE tblVendorCost SET
                        PriceLink=@PriceLink,
                        Current_Cost=@Price, Forecast1=@Price, Forecast2=@Price, Forecast3=@Price,
                        Forecast4=@Price, Forecast5=@Price, Forecast6=@Price, Forecast7=@Price,
                        Forecast8=@Price, Forecast9=@Price, Forecast10=@Price, Forecast11=@Price, Forecast12=@Price,
                        TaxGroup=@TaxGroup, PartNumber=@SKU
                    WHERE Community=@Community AND CommunityPhase=@CommunityPhase
                      AND Assembly=@Assembly AND Model=@Model
                      AND Phase=@Phase AND Item=@Item AND Vendor=@Vendor
                      AND DivisionID =@DivisionID";

                await db.ExecuteAsync(updateSql, new
                {
                    DivisionID = divId,
                    PriceLink = priceLink,
                    Price = item.Price,
                    TaxGroup = item.TaxGroup ?? "",
                    SKU = item.SKU ?? "",
                    Community = community,
                    CommunityPhase = communityPhase,
                    Assembly = rowAssembly,
                    Model = rowModel,
                    Phase = item.Phase,
                    Item = item.Item,
                    Vendor = VendorId
                });
            }

            Notifications.Info("Vendor prices saved successfully.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SaveData error");

            Notifications.Error($"Error saving data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Clear List (VB6 cmdNav_Click case 1) ===
    // Clears gItems + unchecks every PO index. VB6 does NOT touch gAssemblies here, so
    // the picked assemblies survive a Clear List (only the loaded prices are cleared).
    private async Task OnClearListClick()
    {
        AllItemsData.Clear();
        FilteredItemsData.Clear();
        foreach (var po in POIndexItems)
            po.IsChecked = false;
        if (POIndexGrid != null) await POIndexGrid.Refresh();
        if (ItemsGrid != null) await ItemsGrid.Refresh();
        StateHasChanged();
    }

    // === Close ===
    private async Task OnCloseClick()
    {
        await ClosePage();
    }

    // === Validate ===
    private bool ValidateData()
    {
        var errors = new List<string>();
        if (string.IsNullOrEmpty(VendorId))
            errors.Add("• Vendor is required");

        if (errors.Any())
        {
            Notifications.Error("Unable to save data\n\n" + string.Join("\n", errors));

            return false;
        }
        return true;
    }

    // === Helpers ===
    private decimal SafeDecimal(object? val, decimal def = 0) =>
        val != null && val != DBNull.Value && !string.IsNullOrEmpty(val.ToString())
            ? Convert.ToDecimal(val) : def;

    private int SafeInt(string? val, int def = 0) =>
        int.TryParse(val, out var result) ? result : def;

    // === Items Grid layout (VB6 IniGetGrid(Me, gItems)) ============================
    // Loads the gItems column layout from AppGridLayout (gridname
    // 'FAddPricelist.gItems'). Faithful to VB6 Form_Load's Call IniGetGrid(Me,
    // gItems): the columns are data-driven, never hardcoded. Delegated to the
    // shared GridLayoutPresenter (see _itemsGrid) like FAssembly.
    private async Task LoadItemsGridLayoutAsync()
    {
        await _itemsGrid.LoadAsync(GridLayoutSvc);
        Logger.LogInformation(
            "FAddPricelist.gItems load: {RowCount} dict entries, fallback={Fallback}",
            ItemsGridLayout.Count, ItemsGridLayoutFallbackUsed);
    }

    // VB6 IniPutGrid: a resize / reorder / hide / group / header-rename raises
    // GridControl.OnLayoutChanged with the new state, which lives on the snapshot
    // rather than in the presenter's dict — merge it in before writing through.
    private async Task OnItemsLayoutChangedAsync(GridSettings snapshot)
    {
        if (snapshot == null || !HasItemsGridLayout) return;

        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FAddPricelist", "gItems", instanceKey: null,
                ItemsGridLayout, snapshot, layoutFieldResolver: ResolveItemsGridField,
                staticNames: false);

            _itemsGrid.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FAddPricelist gItems layout");
        }
    }

    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedItemsGridLayout()
        => _itemsGrid.GetOrdered();

    private string ResolveItemsGridField(string layoutField)
        => _itemsGrid.ResolveField(layoutField);

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // === Models ===
    public class CommunityComboItem
    {
        public string Display { get; set; } = "";
        public string Key { get; set; } = "";
    }

    public class POIndexCheckItem
    {
        public string POIndex { get; set; } = "";
        public string Description { get; set; } = "";
        public string Display { get; set; } = "";
        public bool IsChecked { get; set; }
    }

    public class PricelistItemRow
    {
        public string POIndex { get; set; } = "";
        public string Phase { get; set; } = "";
        public string Item { get; set; } = "";
        public string Description { get; set; } = "";
        public string OrderUOM { get; set; } = "";
        public string PriceLink { get; set; } = "";
        public string TaxGroup { get; set; } = "";
        public string TaxGroupDesc { get; set; } = "";
        public string SKU { get; set; } = "";
        public decimal Price { get; set; }
        public string Quality { get; set; } = "";
        public bool IsNewItem { get; set; }
        // NEW VB6 MODEL: the 5 per-assembly columns the UNION-ALL load carries onto each
        // gItems row (gItems gained these 5 cols). AssemblyDescription is the visible
        // "Assembly" column (colkey AssemblyDescription); Model/Assembly/Option drive the
        // per-row Save; RowKey ties the row back to its gAssemblies row (delete matches
        // on it). These render via the AppGridLayout (or its fallback) like every other
        // gItems column.
        public string Model { get; set; } = "";
        public string Assembly { get; set; } = "";
        public string Option { get; set; } = "";
        public string AssemblyDescription { get; set; } = "";
        public string RowKey { get; set; } = "";
    }

    // VB6 gAssemblies row. The grid shows only "Description"; Assembly/Model/Option/Key
    // are data carriers. The list always ends with one blank row (IsBlank) = VB6's
    // trailing "Unit Prices" append anchor. Key = assembly\x01modelid\x01optionid (VB6
    // Chr(1)-joined) — the de-dupe key (.FindRow on "key") and the gItems RowKey link.
    public class GAssemblyRow
    {
        public string Description { get; set; } = "";
        public string Assembly { get; set; } = "";
        public string Model { get; set; } = "";
        public string Option { get; set; } = "";
        public string Key { get; set; } = "";
        // The trailing blank row: no assembly picked yet. Rendered as "Unit Prices",
        // never deletable, and skipped by the UNION-ALL load (For r = 0 To .Rows - 2).
        public bool IsBlank => string.IsNullOrEmpty(Assembly)
                            && string.IsNullOrEmpty(Model)
                            && string.IsNullOrEmpty(Option)
                            && string.IsNullOrEmpty(Key);
    }

    public class TaxGroupItem
    {
        public string TaxGroup { get; set; } = "";
        public string Description { get; set; } = "";
        // DropDownListControl display text (VB6 combo showed "TaxGroup - Description").
        public string Display => string.IsNullOrEmpty(Description) ? TaxGroup : $"{TaxGroup} - {Description}";
    }

    // Case-insensitive value read from an FPickList result row (mirrors FAssembly's
    // GetRowString) — the picker's column names come straight from the SQL aliases.
    private static string GetRowString(IDictionary<string, object> row, string key)
    {
        if (row.TryGetValue(key, out var value) && value != null)
            return value.ToString() ?? "";

        foreach (var k in row.Keys)
        {
            if (string.Equals(k, key, StringComparison.OrdinalIgnoreCase))
                return row[k]?.ToString() ?? "";
        }
        return "";
    }
}
