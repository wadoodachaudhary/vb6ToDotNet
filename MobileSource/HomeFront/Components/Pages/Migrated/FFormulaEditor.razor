@* ── Custom Delete Confirmation Dialog (VB6 MsgBox replacement) ── *@
<DialogControl Visible="@_deleteConfirmVisible"
               Header="Precision Builder"
               Width="340px"
               IsModal="true"
               ShowCloseIcon="true"
               CssClass="ffe-variable-dialog"
               OnClose="OnDeleteConfirmCancel">
