@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-07-02
   Changes     :
     - Port of VB6 FFormulaEditor.frm (HHM-211): three panes (Variables /
       Formulas / grouped function library), large formula editor below,
       Test + OK + Cancel. Test = VB6 FFormulaTest (variable prompts →
       "Formula is valid. return value: …", aggregate lookups stubbed to 0).
     - HHM-610: Formula Test dialog — numeric-only value inputs (list
       variables get the VB6 value combo), caption "Formula Test", window
       icon on the dialog chrome.
     - HHM-614: Test errors use the VB6 "Error Evaluating Formula" message
       box (MFormulas.bas CalcFormula eh) instead of a toast.
     - HHM-615: Formulas-pane context menu enables Insert/Rename/Edit/
       Delete like VB6 gFormulas_MouseDown (root right-click targets the
       current formula); New-prompt titled "Precision Builder"; New closes
       back to the editor instead of opening the Edit Formula window.
   ───────────────────────────────────────────────────────────────── *@
@namespace HomeFront.Components.Pages

@using Fx.ControlKit
@using Fx.ControlKit.Dialogs
@using Fx.ControlKit.Notifications
@using HomeFront.Data
@using HomeFront.Models
@inject DbWrapperSqlServer db
@inject NotificationService Notifications
@inject IDialogService Dialogs
@inject ILogger<FFormulaEditor> Logger

<DialogControl Visible="@_visible"
               Header="@_title"
               Width="940px"
               Height="620px"
               Resizable="true"
               IsModal="true"
               ShowCloseIcon="true"
               ShowWindowIcon="true"
               OnClose="Cancel"
               CssClass="ffe-dialog">
    <ChildContent>
        <div class="ffe-body">
            @* Focus containment: Shift+Tab past the first control bounces back to
               the editor instead of escaping the dialog (VB6 modal Tab cycle). *@
            <div class="ffe-focus-sentinel" tabindex="0" @onfocus="FocusEditorAsync"></div>
            @* ── Top: the three legacy panes. Root rows are bold and collapsible;
               double-clicking a leaf inserts it into the formula (VB6 mc_INSERT:
               Variables → [name], Formulas → {name}, Functions → the code text). *@
            <div class="ffe-panes">
                <div class="ffe-pane" tabindex="0" @ref="_paneVarsRef"
                     @onkeydown="@(e => OnPaneKeyDownAsync(CtxPane.Variables, e))" @onkeydown:preventDefault="true">
                    <div class="ffe-group @(KbActive(CtxPane.Variables, "g:Variables"))" @onclick="@(() => { if (_variables.Count > 0) _variablesExpanded = !_variablesExpanded; })"
                         @oncontextmenu="@(e => OpenCtxMenu(CtxPane.Variables, false, "", "", e))" @oncontextmenu:preventDefault="true">
                        @if (_variables.Count > 0)
                        {
                            <span class="ffe-toggle">@(_variablesExpanded ? "−" : "+")</span>
                        }
                        <b>Variables</b>
                    </div>
                    @if (_variablesExpanded)
                    {
                        @foreach (var v in _variables)
                        {
                            var vv = v;
                            <div class="ffe-leaf @(KbActive(CtxPane.Variables, "v:" + vv.Name))" title="@vv.Tooltip" @ondblclick="@(() => Insert("[" + vv.Name + "]"))"
                                 @oncontextmenu="@(e => OpenCtxMenu(CtxPane.Variables, true, vv.Name, "[" + vv.Name + "]", e))" @oncontextmenu:preventDefault="true">@vv.Name</div>
                        }
                    }
                </div>
                <div class="ffe-pane" tabindex="0" @ref="_paneFormulasRef"
                     @onkeydown="@(e => OnPaneKeyDownAsync(CtxPane.Formulas, e))" @onkeydown:preventDefault="true">
                    <div class="ffe-group @(KbActive(CtxPane.Formulas, "g:Formulas"))" @onclick="@(() => { if (_formulas.Count > 0) _formulasExpanded = !_formulasExpanded; })"
                         @oncontextmenu="@(e => OpenCtxMenu(CtxPane.Formulas, false, "", "", e))" @oncontextmenu:preventDefault="true">
                        @if (_formulas.Count > 0)
                        {
                            <span class="ffe-toggle">@(_formulasExpanded ? "−" : "+")</span>
                        }
                        <b>Formulas</b>
                    </div>
                    @if (_formulasExpanded)
                    {
                        @foreach (var f in _formulas)
                        {
                            var ff = f;
                            <div class="ffe-leaf @(string.Equals(ff.Name, _selectedFormula, StringComparison.OrdinalIgnoreCase) ? "selected" : "") @(KbActive(CtxPane.Formulas, "f:" + ff.Name))"
                                 title="@ff.Tooltip"
                                 @onclick="@(() => _selectedFormula = ff.Name)"
                                 @ondblclick="@(() => Insert("{" + ff.Name + "}"))"
                                 @oncontextmenu="@(e => OpenCtxMenu(CtxPane.Formulas, true, ff.Name, "{" + ff.Name + "}", e))" @oncontextmenu:preventDefault="true">@ff.Name</div>
                        }
                    }
                </div>
                <div class="ffe-pane" tabindex="0" @ref="_paneFuncsRef"
                     @onkeydown="@(e => OnPaneKeyDownAsync(CtxPane.Functions, e))" @onkeydown:preventDefault="true">
                    @foreach (var g in _functionGroups)
                    {
                        <div class="ffe-group @(KbActive(CtxPane.Functions, "g:" + g.Name))" @onclick="@(() => g.Expanded = !g.Expanded)"
                             @oncontextmenu="@(e => OpenCtxMenu(CtxPane.Functions, false, "", "", e))" @oncontextmenu:preventDefault="true">
                            <span class="ffe-toggle">@(g.Expanded ? "−" : "+")</span><b>@g.Name</b>
                        </div>
                        @if (g.Expanded)
                        {
                            @foreach (var it in g.Items)
                            {
                                var itm = it;
                                <div class="ffe-leaf @(KbActive(CtxPane.Functions, "fn:" + itm.Display))" title="@itm.Tooltip" @ondblclick="@(() => Insert(itm.InsertText))"
                                     @oncontextmenu="@(e => OpenCtxMenu(CtxPane.Functions, true, itm.Display, itm.InsertText, e))" @oncontextmenu:preventDefault="true">@itm.Display</div>
                            }
                        }
                    }
                </div>
            </div>

            @* ── Bottom: the large dedicated formula area (VB6 txtFormula). ── *@
            <textarea class="ffe-editor" @ref="_editorRef" @bind="_text" @bind:event="oninput"
                      spellcheck="false" wrap="off"></textarea>
        </div>
    </ChildContent>
    <FooterContent>
        <div class="ffe-footer-left">
            <ButtonControl CssClass="ffe-btn" OnClick="@(_ => TestAsync())"><u>T</u>est</ButtonControl>
        </div>
        <div class="ffe-footer-right">
            <ButtonControl CssClass="ffe-btn ffe-default-btn" OnClick="@(_ => OkAsync())">OK</ButtonControl>
            <ButtonControl CssClass="ffe-btn" OnClick="@(_ => Cancel())"><u>C</u>ancel</ButtonControl>
        </div>
        @* Focus containment: Tab past the last button wraps to the editor. *@
        <div class="ffe-focus-sentinel" tabindex="0" @onfocus="FocusEditorAsync"></div>
    </FooterContent>
</DialogControl>

@* ── Formula Test — VB6 FFormulaTest: prompts a value per [variable] found in the
   resolved formula, then evaluates. With no variables it evaluates immediately.
   HHM-610: caption is the VB6 form caption "Formula Test" (FFormulaTest.frm:4),
   the chrome shows a window icon (frm Icon property; calc.ico precedent from the
   main .ffe-dialog), and values are numeric-only — VB6 gVariables_ValidateEdit
   cancels any non-numeric edit; list-of-values variables get the VB6 value combo. *@
<DialogControl Visible="@_testVisible"
               Header="Formula Test"
               Width="420px"
               IsModal="true"
               ShowCloseIcon="true"
               ShowWindowIcon="true"
               OnClose="@(() => _testVisible = false)"
               CssClass="ffe-test-dialog">
    <ChildContent>
        <div class="ffe-test-grid">
            @foreach (var tv in _testVariables)
            {
                <label class="ffe-test-name" title="@tv.Tooltip">@tv.Name</label>
                @if (tv.IsList)
                {
                    <DropDownListControl TValue="string" TItem="string"
                                         @bind-Value="tv.Value"
                                         DataSource="@tv.ListValues"
                                         Width="120px" />
                }
                else
                {
                    <NumericTextBoxControl TValue="double"
                                           Value="@tv.NumValue"
                                           ValueChanged="@((double v) => tv.NumValue = v)"
                                           CssClass="ffe-test-value" Width="120px" />
                }
            }
        </div>
    </ChildContent>
    <FooterContent>
        <div class="ffe-footer-right">
            <ButtonControl CssClass="ffe-btn ffe-default-btn" OnClick="@(_ => RunTestAsync())">Test</ButtonControl>
            <ButtonControl CssClass="ffe-btn" OnClick="@(_ => { _testVisible = false; })">Close</ButtonControl>
        </div>
    </FooterContent>
</DialogControl>

@* ── Right-click context menu on the Variables / Formulas / Functions panes
   (VB6 mnuPopup: Insert / Rename / New / Edit / Delete with per-pane Enabled rules). *@
<ContextMenuControl Visible="@_ctxVisible" X="@_ctxX" Y="@_ctxY" MinWidth="150" OnClose="@(() => _ctxVisible = false)">
    <ContextMenuItemControl Text="Insert" Disabled="@(!CtxInsertEnabled)" OnClick="CtxInsert" />
    <ContextMenuSeparatorControl />
    <ContextMenuItemControl Text="Rename" Disabled="@(!CtxRenameEnabled)" OnClick="CtxRenameAsync" />
    <ContextMenuItemControl Text="New" Disabled="@(!CtxNewEnabled)" OnClick="CtxNewAsync" />
    <ContextMenuItemControl Text="Edit" Disabled="@(!CtxEditEnabled)" OnClick="CtxEditAsync" />
    <ContextMenuSeparatorControl />
    <ContextMenuItemControl Text="Delete" Disabled="@(!CtxDeleteEnabled)" OnClick="CtxDeleteAsync" />
</ContextMenuControl>

@* ── Edit a formula's body (VB6 mc_EDIT for gFormulas — opens a sub-editor and
   writes back to formulas.text). ── *@
<DialogControl Visible="@_editFormulaVisible"
               Header="@($"Edit Formula - {_editFormulaName}")"
               Width="620px"
               Height="360px"
               Resizable="true"
               IsModal="true"
               ShowCloseIcon="true"
               OnClose="@(() => _editFormulaVisible = false)"
               CssClass="ffe-dialog">
    <ChildContent>
        <textarea class="ffe-editor" @bind="_editFormulaText" @bind:event="oninput"
                  spellcheck="false" wrap="off"></textarea>
    </ChildContent>
    <FooterContent>
        <div class="ffe-footer-right">
            <ButtonControl CssClass="ffe-btn ffe-default-btn" OnClick="@(_ => SaveFormulaBodyAsync())">OK</ButtonControl>
            <ButtonControl CssClass="ffe-btn" OnClick="@(_ => { _editFormulaVisible = false; })">Cancel</ButtonControl>
        </div>
    </FooterContent>
</DialogControl>

<DialogControl Visible="@IsVariableEditorVisible"
               Header="Variable"
               Width="360px"
               IsModal="true"
               ShowCloseIcon="true"
               CssClass="ffe-variable-dialog"
               OnClose="OnVariableEditorCancel">
    <ChildContent>
        <div class="dialog-body ic-var-body">
            <div class="ic-var-name-row">
                <label class="ic-var-group-label">Name</label>
                @if (_editingVarIsNew)
                {
                    <TextBoxControl @bind-Value="EditingVarName" MaxLength="50" />
                }
                else
                {
                    <TextBoxControl Value="@EditingVarName" readonly="readonly" CssClass="ic-readonly-input" />
                }
            </div>

            <div class="ic-var-columns">
                <div class="ic-var-type-col">
                    <label class="ic-var-group-label">Type</label>
                    <div class="ic-var-radios">
                        <RadioControl TValue="int" Name="varType" Value="0"
                                      @bind-SelectedValue="EditingVarType" Label="Numeric" />
                        <RadioControl TValue="int" Name="varType" Value="1"
                                      @bind-SelectedValue="EditingVarType" Label="List of values" />
                    </div>
                </div>
                @if (EditingVarType == 0)
                {
                    <div class="ic-var-props-col">
                        <label class="ic-var-group-label">Properties</label>
                        <div class="ic-var-props-grid">
                            <label>Min</label>
                            <TextBoxControl @bind-Value="EditingVarMin" />
                            <label>Default</label>
                            <TextBoxControl @bind-Value="EditingVarDefault" />
                            <label>Max</label>
                            <TextBoxControl @bind-Value="EditingVarMax" />
                            <label>UOM</label>
                            <DropDownListControl TValue="string" TItem="string"
                                                 @bind-Value="EditingVarUOM"
                                                 Width="56px"
                                                 DataSource="@UomOptionList" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="ic-var-props-col">
                        <label class="ic-var-group-label">Values</label>
                        <TextAreaControl @bind-Value="EditingVarListOfValues" Rows="5"
                                         CssClass="ic-monospace-area" />
                    </div>
                }
            </div>

            <div class="ic-var-help">
                <label class="ic-var-group-label">Help Notes</label>
                <TextAreaControl @bind-Value="EditingVarHelp" Rows="4" />
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <div class="ffe-footer-right">
            <ButtonControl CssClass="ffe-btn ffe-default-btn" OnClick="OnVariableEditorOk">OK</ButtonControl>
            <ButtonControl CssClass="ffe-btn" OnClick="OnVariableEditorCancel">Cancel</ButtonControl>
        </div>
    </FooterContent>
</DialogControl>

@* ── Custom New Formula Dialog (VB6 Prompt replacement) ── *@
