    private void OnVariableEditorCancel()
    {
        IsVariableEditorVisible = false;
        StateHasChanged();
    }

    private async Task OnVariableEditorOk()
    {
        string values;
        if (EditingVarType == 1)
        {
            values = (EditingVarListOfValues ?? "")
                .Replace("\r\n", "\n")
                .Replace("\n", "|");

            var stripped = values.Replace("|", "").Replace(" ", "").Trim();
            if (string.IsNullOrEmpty(stripped))
            {
                Notifications.Error("You must specify at least one value.");
                return;
            }
        }
        else
        {
            values = "";
        }

        double minV = ParseDoubleOrZero(EditingVarMin);
        double maxV = ParseDoubleOrZero(EditingVarMax);
        double defV = ParseDoubleOrZero(EditingVarDefault);

        try
        {
            EditingVarName = (EditingVarName ?? "").Trim();
            if (string.IsNullOrEmpty(EditingVarName))
            {
                Notifications.Info("Variable name is required.");
                return;
            }

            if (_editingVarIsNew)
            {
                var exists = await db.ExecuteScalarAsync<int>(
                    "SELECT COUNT(*) FROM variables WHERE Name=@Name", new { Name = EditingVarName });
                if (exists > 0)
                {
                    Notifications.Error($"A variable named '{EditingVarName}' already exists.");
                    return;
                }
                await db.ExecuteAsync("INSERT INTO variables(Name) VALUES(@Name)", new { Name = EditingVarName });
            }

            await db.ExecuteAsync(
                @"UPDATE variables SET
                    VariableType=@VariableType,
                    MinimumValue=@MinimumValue,
                    MaximumValue=@MaximumValue,
                    DefaultValue=@DefaultValue,
                    ListOfValues=@ListOfValues,
                    UOM=@UOM,
                    Help=@Help,
                    conditionname=@ConditionName,
                    conditiontype=@ConditionType,
                    conditionuom=@ConditionUOM
                  WHERE Name=@Name",
                new
                {
                    Name = EditingVarName,
                    VariableType = EditingVarType,
                    MinimumValue = minV,
                    MaximumValue = maxV,
                    DefaultValue = defV,
                    ListOfValues = values,
                    UOM = EditingVarUOM ?? "",
                    Help = EditingVarHelp ?? "",
                    ConditionName = EditingVarConditionName ?? "",
                    ConditionType = EditingVarConditionType ?? "",
                    ConditionUOM = EditingVarConditionUOM ?? ""
                });

            IsVariableEditorVisible = false;
            await LoadListsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnVariableEditorOk: update failed");
            Notifications.Error($"Could not save variable: {ex.Message}");
        }
    }

    private static double ParseDoubleOrZero(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return 0;
        return double.TryParse(s, System.Globalization.NumberStyles.Any,
                               System.Globalization.CultureInfo.InvariantCulture,
                               out var v) ? v : 0;
    }
}
