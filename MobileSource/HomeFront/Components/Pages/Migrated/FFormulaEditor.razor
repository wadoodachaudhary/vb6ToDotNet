            {
                if (_messageBox != null)
                    await _messageBox.ShowAsync($"A formula named {name} already exists. You must specify a unique name.", "Precision Builder", Fx.ControlKit.Dialogs.MessageBoxButtons.Ok, "exclamation");
                return;
