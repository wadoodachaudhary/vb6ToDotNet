    {
        _newFormulaDialogVisible = false;
        var name = (_newFormulaNameInput ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name)) return;
        try
        {
            var exists = await db.ExecuteScalarAsync<int>(
                "select count(*) from formulas where name=@n", new { n = name });
