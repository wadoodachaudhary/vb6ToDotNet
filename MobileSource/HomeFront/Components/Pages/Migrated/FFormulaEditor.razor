    /// <summary>Open the editor (VB6 <c>FFormulaEditor.EditFormula(Name, Text)</c>). The caller
    /// receives the accepted text via <see cref="OnAccepted"/>; Cancel / ✕ discards (VB6
    /// Form_QueryUnload sets mCancel).</summary>
    public async Task Open(string name, string text)
    {
        _title = string.IsNullOrWhiteSpace(name) ? "Formula Editor" : $"Formula Editor - {name}";
        _text = text ?? "";
        _testVisible = false;
        await LoadListsAsync();
        _visible = true;
        _focusEditorOnRender = true;
        StateHasChanged();
    }

    private async Task LoadListsAsync()
    {
        try
        {
            // VB6 LoadVariables/LoadFormulas (FFormulaEditor.frm:906/925) — no division filter.
            var vars = await db.QueryAsync("select name, help from variables order by name");
            _variables = vars.Select(r => new NamedLeaf
            {
                Name = r["name"]?.ToString() ?? "",
                Tooltip = r["help"]?.ToString() ?? ""
            }).Where(v => !string.IsNullOrEmpty(v.Name)).ToList();

            var fx = await db.QueryAsync("select name, text from formulas order by name");
            _formulas = fx.Select(r => new NamedLeaf
            {
                Name = r["name"]?.ToString() ?? "",
                Tooltip = r["text"]?.ToString() ?? ""
            }).Where(f => !string.IsNullOrEmpty(f.Name)).ToList();

            var uoms = await db.QueryAsync("select uom from uom order by uom");
            _uomList = uoms.Select(r => (r["uom"]?.ToString() ?? "").Trim()).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Formula editor list load failed");
            _variables = new(); _formulas = new(); _uomList = new();
        }
    }

    // ── Focus & keyboard navigation (owner directive 2026-08-01) ──────────
    // VB6 opens with txtFormula focused and Tab cycles the form's own controls;
    // the web dialog opened with focus nowhere and Tab escaped the window.
    private ElementReference _editorRef;
    private ElementReference _paneVarsRef;
    private ElementReference _paneFormulasRef;
    private ElementReference _paneFuncsRef;
    private bool _focusEditorOnRender;
    private readonly Dictionary<CtxPane, string> _kbKey = new();

    private async Task FocusEditorAsync()
    {
        try { await _editorRef.FocusAsync(); } catch { /* dialog closing */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusEditorOnRender && _visible)
        {
            _focusEditorOnRender = false;
            await FocusEditorAsync();
        }
    }

    private string KbActive(CtxPane pane, string key)
        => _kbKey.TryGetValue(pane, out var k) && string.Equals(k, key, StringComparison.Ordinal)
            ? "kb-active" : "";

    private sealed record KbEntry(string Key, Action Activate);

    /// <summary>The pane's keyboard walk = its VISIBLE rows top-to-bottom
    /// (group headers + expanded leaves), same rows the mouse sees.</summary>
    private List<KbEntry> BuildPaneEntries(CtxPane pane)
    {
        var list = new List<KbEntry>();
        switch (pane)
        {
            case CtxPane.Variables:
                list.Add(new("g:Variables", () => { if (_variables.Count > 0) _variablesExpanded = !_variablesExpanded; }));
                if (_variablesExpanded)
                    foreach (var v in _variables)
                    {
                        var vv = v;
                        list.Add(new("v:" + vv.Name, () => Insert("[" + vv.Name + "]")));
                    }
                break;
            case CtxPane.Formulas:
                list.Add(new("g:Formulas", () => { if (_formulas.Count > 0) _formulasExpanded = !_formulasExpanded; }));
                if (_formulasExpanded)
                    foreach (var f in _formulas)
                    {
                        var ff = f;
                        list.Add(new("f:" + ff.Name, () => { _selectedFormula = ff.Name; Insert("{" + ff.Name + "}"); }));
                    }
                break;
            case CtxPane.Functions:
                foreach (var g in _functionGroups)
                {
                    var gg = g;
                    list.Add(new("g:" + gg.Name, () => gg.Expanded = !gg.Expanded));
                    if (gg.Expanded)
                        foreach (var it in gg.Items)
                        {
                            var itm = it;
                            list.Add(new("fn:" + itm.Display, () => Insert(itm.InsertText)));
                        }
                }
                break;
        }
        return list;
    }

    /// <summary>Arrow keys walk the pane rows, Enter/Space activates (toggle a
    /// group, insert a leaf). The pane swallows key defaults, so Tab is moved by
    /// hand: pane → pane → editor, Shift+Tab reverses.</summary>
    private async Task OnPaneKeyDownAsync(CtxPane pane, KeyboardEventArgs e)
    {
        if (e.Key == "Tab")
        {
            var target = pane switch
            {
                CtxPane.Variables => e.ShiftKey ? _editorRef : _paneFormulasRef,
                CtxPane.Formulas => e.ShiftKey ? _paneVarsRef : _paneFuncsRef,
                _ => e.ShiftKey ? _paneFormulasRef : _editorRef,
            };
            try { await target.FocusAsync(); } catch { }
            return;
        }

        var entries = BuildPaneEntries(pane);
        if (entries.Count == 0) return;
        _kbKey.TryGetValue(pane, out var cur);
        var idx = entries.FindIndex(en => string.Equals(en.Key, cur, StringComparison.Ordinal));

        switch (e.Key)
        {
            case "ArrowDown":
                _kbKey[pane] = entries[Math.Min(entries.Count - 1, idx + 1)].Key;
                break;
            case "ArrowUp":
                _kbKey[pane] = entries[Math.Max(0, idx <= 0 ? 0 : idx - 1)].Key;
                break;
            case "Home":
                _kbKey[pane] = entries[0].Key;
                break;
            case "End":
                _kbKey[pane] = entries[^1].Key;
                break;
            case "Enter":
            case " ":
                if (idx >= 0) entries[idx].Activate();
                break;
        }
    }

    // Double-click insert. VB6 inserts at the caret (txtFormula.SelText); tracking the caret
    // needs JS, so we append — the dominant left-to-right build flow is identical.
    private void Insert(string token)
    {
        if (string.IsNullOrEmpty(token)) return;
        _text = string.IsNullOrEmpty(_text) ? token : _text + (_text.EndsWith(" ") ? "" : " ") + token;
    }

    private async Task OkAsync()
    {
        _visible = false;
        _testVisible = false;
        await OnAccepted.InvokeAsync(NormalizeQuotes(_text));
    }

    private void Cancel()
    {
        _visible = false;
        _testVisible = false;
    }

    // VB6 txtFormula_Change: curly quotes/dashes pasted from Word → plain ASCII.
    private static string NormalizeQuotes(string s) =>
        (s ?? "").Replace('–', '-').Replace('“', '"').Replace('”', '"').Replace('‘', '\'').Replace('’', '\'');

    // ── Test (VB6 FFormulaTest.TestFormula) ────────────────────────────────────
    private async Task TestAsync()
    {
        _resolvedForTest = ResolveFormula(NormalizeQuotes(_text));
        var names = System.Text.RegularExpressions.Regex.Matches(_resolvedForTest, @"\[([^\[\]]+)\]")
            .Select(m => m.Groups[1].Value)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (names.Count == 0)
        {
            await EvaluateAndReportAsync(_resolvedForTest);
            return;
        }
        // Prompt a value per variable, defaulted from the variables table (VB6
        // MFormulas.bas LoadVariables(True,…)): numeric variables seed
        // Val(defaultvalue) into a numeric-only box; list-of-values variables get
        // the pipe-separated combo with the first entry preselected (HHM-610).
        var defaults = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var listValues = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var helps = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        try
        {
            var rows = await db.QueryAsync("select name, defaultvalue, listofvalues, help from variables");
            foreach (var r in rows)
            {
                var n = r["name"]?.ToString() ?? "";
                if (n.Length == 0) continue;
                defaults[n] = r["defaultvalue"]?.ToString() ?? "0";
                listValues[n] = r["listofvalues"]?.ToString() ?? "";
                helps[n] = r["help"]?.ToString() ?? "";
            }
        }
        catch { }
        _testVariables = names.Select(n =>
        {
            var tv = new TestVariable { Name = n };
            if (helps.TryGetValue(n, out var h)) tv.Tooltip = h;
            if (listValues.TryGetValue(n, out var lov) && !string.IsNullOrWhiteSpace(lov))
            {
                // VB6 ComboList = " |" & listofvalues — a leading blank entry
                // then the stored values; Value defaults to the first real one.
                tv.IsList = true;
                var opts = lov.Split('|').Select(v => v.Trim()).Where(v => v.Length > 0).ToList();
                tv.ListValues = new List<string> { "" };
                tv.ListValues.AddRange(opts);
                tv.Value = opts.FirstOrDefault() ?? "";
            }
            else
            {
                tv.NumValue = defaults.TryGetValue(n, out var d) &&
                    double.TryParse(d, System.Globalization.NumberStyles.Any,
                        System.Globalization.CultureInfo.InvariantCulture, out var dv) ? dv : 0;
            }
            return tv;
        }).ToList();
        _testVisible = true;
    }

    private async Task RunTestAsync()
    {
        // VB6 MFormulas.bas CalcFormula: list variables substitute as a quoted
        // string, numeric variables as Val(value).
        var s = _resolvedForTest;
        foreach (var tv in _testVariables.OrderByDescending(t => t.Name.Length))
        {
            var replacement = tv.IsList
                ? "\"" + tv.Value + "\""
                : tv.NumValue.ToString(System.Globalization.CultureInfo.InvariantCulture);
            s = ReplaceCaseInsensitive(s, "[" + tv.Name + "]", replacement);
        }
        await EvaluateAndReportAsync(s);
    }

    private async Task EvaluateAndReportAsync(string expression)
    {
        try
        {
            // Aggregate DB lookups (Total*/Assembly*) stub to 0 in the test — exactly VB6's
            // FFormulaTest.GetItemTotal (frm:173-175).
            var result = new FormulaEquation(expression).Solve();
            if (double.IsInfinity(result) || double.IsNaN(result))
            {
                // VB6 CalcFormula divide-by-zero branch (MFormulas.bas:242-243).
                if (_messageBox != null)
                    await _messageBox.ShowAsync("Divide by zero error encountered.", "Error Evaluating Formula", Fx.ControlKit.Dialogs.MessageBoxButtons.Ok, "critical");
                return;
            }
            Notifications.Success($"Formula is valid. Return value: {Math.Round(result, 3)}");
        }
        catch (Exception ex)
        {
            // HHM-614: legacy shows a message box titled "Error Evaluating
            // Formula" whose body is the engine error, a blank line, then the
            // evaluated expression (MFormulas.bas CalcFormula eh:238-247) —
            // e.g. "Undefined Function: ssss" / "" / "ssss".
            if (_messageBox != null)
                await _messageBox.ShowAsync($"{ex.Message}\n\n{expression}", "Error Evaluating Formula", Fx.ControlKit.Dialogs.MessageBoxButtons.Ok, "critical");
        }
    }

    // VB6 MFormulas.bas ResolveFormula — expand {name} from the loaded formulas list,
    // recursively, 30-substitution circular-reference guard.
    private string ResolveFormula(string raw)
    {
        var s = (raw ?? "").Replace('\r', ' ').Replace('\n', ' ').Trim();
        int guard = 0, open;
        while ((open = s.IndexOf('{')) >= 0 && guard++ < 30)
        {
            var close = s.IndexOf('}', open + 1);
            if (close < 0) break;
            var name = s.Substring(open + 1, close - open - 1);
            var f = _formulas.FirstOrDefault(x => string.Equals(x.Name, name, StringComparison.OrdinalIgnoreCase));
            if (f == null) break;   // unknown name — leave for the solver to surface
            s = s.Substring(0, open) + "(" + f.Tooltip + ")" + s.Substring(close + 1);
        }
        return s;
    }

    private static string ReplaceCaseInsensitive(string input, string search, string replacement)
    {
        if (string.IsNullOrEmpty(input) || string.IsNullOrEmpty(search)) return input;
        var sb = new System.Text.StringBuilder();
        int idx = 0;
        while (true)
        {
            int found = input.IndexOf(search, idx, StringComparison.OrdinalIgnoreCase);
            if (found < 0) { sb.Append(input, idx, input.Length - idx); break; }
            sb.Append(input, idx, found - idx);
            sb.Append(replacement);
            idx = found + search.Length;
        }
        return sb.ToString();
    }

