            <ButtonControl CssClass="ffe-btn" OnClick="OnNewFormulaCancel">Cancel</ButtonControl>
        </div>
    </FooterContent>
</DialogControl>

@* ── Custom Rename Dialog (VB6 Prompt replacement) ── *@
<DialogControl Visible="@_renameDialogVisible"
               Header="Precision Builder"
               Width="340px"
               IsModal="true"
               ShowCloseIcon="true"
               CssClass="ffe-variable-dialog"
               OnClose="OnRenameCancel">
