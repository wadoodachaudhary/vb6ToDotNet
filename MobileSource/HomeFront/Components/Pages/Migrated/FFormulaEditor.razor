<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />

@code {
    /// <summary>Raised with the edited formula text when the user accepts with OK.</summary>
    [Parameter] public EventCallback<string> OnAccepted { get; set; }

    private bool _visible;
    private MessageBoxControl? _messageBox;
    private string _title = "Formula Editor";
    private string _text = "";
    private bool _variablesExpanded = true;   // VB6: Variables/Formulas roots load expanded,
    private bool _formulasExpanded = true;    // the function groups load COLLAPSED (Outline(0)).

    private sealed class NamedLeaf { public string Name = ""; public string Tooltip = ""; }
    private sealed class FunctionLeaf { public string Display = ""; public string InsertText = ""; public string Tooltip = ""; }
    private sealed class FunctionGroup { public string Name = ""; public bool Expanded; public List<FunctionLeaf> Items = new(); }

    private List<NamedLeaf> _variables = new();
    private List<NamedLeaf> _formulas = new();
    private readonly List<FunctionGroup> _functionGroups = BuildFunctionGroups();

    // ── Test dialog state ──
    private bool _testVisible;
    private string _resolvedForTest = "";
    // HHM-610: numeric variables carry a double (NumericTextBoxControl rejects
    // alphabetic input); list-of-values variables carry the picked string for
    // the VB6 combo (MFormulas.bas LoadVariables fills Value/ListOfValues).
    private sealed class TestVariable
    {
        public string Name = "";
        public string Tooltip = "";
        public bool IsList;
        public double NumValue;                  // numeric variables
        public string Value = "";                // list variables (picked entry)
        public List<string> ListValues = new();  // list variables (combo options)
    }
    private List<TestVariable> _testVariables = new();

    // ── Right-click context menu state (VB6 mnuPopup on the three panes) ──
    private enum CtxPane { Variables, Formulas, Functions }
    private bool _ctxVisible;
    private double _ctxX, _ctxY;
    private CtxPane _ctxPane;
    private bool _ctxHasTarget;          // a concrete row the menu actions act on
    private string _ctxName = "";        // leaf name (Variables/Formulas) / display (Functions)
    private string _ctxInsertToken = ""; // exact text inserted by "Insert"

    // HHM-615: the Formulas pane's "current row" (VB6 gFormulas.Row) — set by
    // click/right-click on a leaf; a right-click on the "Formulas" root targets
    // it, exactly like VB6 where the popup actions run against the grid cursor
    // rather than the hit row (gFormulas_MouseDown enables everything).
    private string _selectedFormula = "";

    // ── Edit-formula-body sub-dialog state (VB6 mc_EDIT for gFormulas) ──
    private bool _editFormulaVisible;
    private string _editFormulaName = "";
    private string _editFormulaText = "";

    // ── Variable Editor dialog state ──
    private bool IsVariableEditorVisible;
    private bool _editingVarIsNew;
    private string EditingVarName = "";
    private int EditingVarType = 0; // 0 = Numeric, 1 = List of values
    private string EditingVarMin = "0";
    private string EditingVarMax = "9999999";
    private string EditingVarDefault = "0";
    private string EditingVarListOfValues = "";
    private string EditingVarHelp = "";
    private string EditingVarConditionName = "";
    private string EditingVarConditionType = "";
    private string EditingVarConditionUOM = "";
    private string EditingVarUOM = "";
    private List<string> _uomList = new();
    private IEnumerable<string> UomOptionList => new[] { "" }.Concat(_uomList);

    // ── Custom popup states for VB6 parity ──
    private bool _newFormulaDialogVisible;
    private string _newFormulaNameInput = "";

    private bool _renameDialogVisible;
    private string _renameNewNameInput = "";
    private string _renameKind = "";
    private string _renameOldName = "";

    private bool _deleteConfirmVisible;
    private string _deleteTargetTable = "";
    private string _deleteTargetName = "";

    // Per-pane Enabled rules (VB6 gVariables/gFormulas/gFunctions_MouseDown).
    // Variables New/Edit require FVariable, which is NOT ported to PB, so they stay disabled.
    // HHM-615: on the Formulas pane VB6 enables Insert/Rename/New/Edit/Delete
    // for the whole pane (FFormulaEditor.frm:559-567) — the root right-click
    // resolves a target row in OpenCtxMenu, so _ctxHasTarget drives Enabled.
    private bool CtxInsertEnabled => _ctxHasTarget;
    private bool CtxRenameEnabled => _ctxHasTarget && (_ctxPane == CtxPane.Variables || _ctxPane == CtxPane.Formulas);
    private bool CtxNewEnabled => _ctxPane == CtxPane.Formulas || _ctxPane == CtxPane.Variables;
    private bool CtxEditEnabled => (_ctxPane == CtxPane.Formulas || _ctxPane == CtxPane.Variables) && _ctxHasTarget;
    private bool CtxDeleteEnabled => _ctxHasTarget && (_ctxPane == CtxPane.Variables || _ctxPane == CtxPane.Formulas);

    private void OpenCtxMenu(CtxPane pane, bool isLeaf, string name, string insertToken, MouseEventArgs e)
    {
        _ctxPane = pane;

        if (pane == CtxPane.Formulas)
        {
            if (isLeaf)
            {
                _selectedFormula = name ?? "";
            }
            else
            {
                // Root ("Formulas") right-click — act on the current row like
                // VB6; fall back to the first formula when nothing is current.
                var target = _formulas.FirstOrDefault(f =>
                        string.Equals(f.Name, _selectedFormula, StringComparison.OrdinalIgnoreCase))
                    ?? _formulas.FirstOrDefault();
                name = target?.Name ?? "";
                insertToken = target == null ? "" : "{" + target.Name + "}";
                _selectedFormula = name;
            }
            _ctxHasTarget = !string.IsNullOrEmpty(name);
        }
        else
        {
            _ctxHasTarget = isLeaf;
        }

        _ctxName = name ?? "";
        _ctxInsertToken = insertToken ?? "";
        _ctxX = e.ClientX;
        _ctxY = e.ClientY;
        _ctxVisible = true;
    }

    // VB6 mc_INSERT — insert the pane token into the formula editor.
    private void CtxInsert()
    {
        _ctxVisible = false;
        if (_ctxHasTarget) Insert(_ctxInsertToken);
    }

    // VB6 mc_RENAME — EditCell + ValidateEdit: rename the variable/formula and cascade the
    // token replacement into formulas.text, tblphaseitem.formula, tbldbassemblydetails.formula.
    private void CtxRenameAsync()
    {
        _ctxVisible = false;
        if (!_ctxHasTarget) return;
        _renameKind = _ctxPane == CtxPane.Variables ? "variable" : "formula";
        _renameOldName = _ctxName;
        _renameNewNameInput = _ctxName;
        _renameDialogVisible = true;
        StateHasChanged();
    }

    private void OnRenameCancel()
    {
        _renameDialogVisible = false;
        StateHasChanged();
    }

    private async Task OnRenameOk()
    {
        _renameDialogVisible = false;
        var newName = (_renameNewNameInput ?? "").Trim();
        if (string.IsNullOrWhiteSpace(newName) || string.Equals(newName, _renameOldName, StringComparison.Ordinal)) return;
        try
        {
            var table = _renameKind == "variable" ? "variables" : "formulas";
            var exists = await db.ExecuteScalarAsync<int>(
                $"select count(*) from {table} where name=@n", new { n = newName });
            if (exists > 0)
            {
                if (_messageBox != null)
                    await _messageBox.ShowAsync($"There is already a {_renameKind} named {newName}. Please specify a unique name.", "Precision Builder", Fx.ControlKit.Dialogs.MessageBoxButtons.Ok, "exclamation");
                return;
            }
            await db.ExecuteAsync($"update {table} set name=@new where name=@old",
                new { @new = newName, old = _renameOldName });

            // Cascade: [old]->[new] for variables, {old}->{new} for formulas.
            var oldTok = _renameKind == "variable" ? $"[{_renameOldName}]" : "{" + _renameOldName + "}";
            var newTok = _renameKind == "variable" ? $"[{newName}]" : "{" + newName + "}";
            await db.ExecuteAsync("update formulas set text = replace(text,@o,@n)", new { o = oldTok, n = newTok });
            await db.ExecuteAsync("update tblphaseitem set formula = replace(formula,@o,@n)", new { o = oldTok, n = newTok });
            await db.ExecuteAsync("update tbldbassemblydetails set formula = replace(formula,@o,@n)", new { o = oldTok, n = newTok });

            if (_renameKind == "formula" &&
                string.Equals(_selectedFormula, _renameOldName, StringComparison.OrdinalIgnoreCase))
               _selectedFormula = newName;

            await LoadListsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Formula editor rename failed");
            Notifications.Error($"Rename failed: {ex.Message}");
        }
    }

    // VB6 mc_NEW (gFormulas) — InputBox("Formula name?", App.ProductName), insert a
    // blank formula, reselect it in the list. HHM-615: the prompt is titled
    // "Precision Builder" (InputBox parity) and, matching the shipping legacy app,
    // accepting the name returns straight to the Formula window — it does NOT
    // open the Edit Formula dialog (the user edits via right-click → Edit).
    private void CtxNewAsync()
    {
        _ctxVisible = false;
        if (_ctxPane == CtxPane.Formulas)
        {
            _newFormulaNameInput = "";
            _newFormulaDialogVisible = true;
            StateHasChanged();
        }
        else if (_ctxPane == CtxPane.Variables)
        {
            _editingVarIsNew = true;
            EditingVarName = "";
