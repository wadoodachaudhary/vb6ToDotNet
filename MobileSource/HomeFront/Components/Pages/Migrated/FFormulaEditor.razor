    // VB6 mc_EDIT (gFormulas) — load the formula body into the sub-editor.
    private async Task CtxEditAsync()
    {
        _ctxVisible = false;
        if (!_ctxHasTarget) return;

        if (_ctxPane == CtxPane.Formulas)
        {
            try
            {
                var rows = await db.QueryAsync("select text from formulas where name=@n", new { n = _ctxName });
                var first = rows.FirstOrDefault();
                _editFormulaText = first?["text"]?.ToString() ?? "";
                _editFormulaName = _ctxName;
                _editFormulaVisible = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Formula editor edit-body load failed");
                Notifications.Error($"Edit failed: {ex.Message}");
            }
        }
        else if (_ctxPane == CtxPane.Variables)
        {
            try
            {
                _editingVarIsNew = false;
                EditingVarName = _ctxName;

                var rows = await db.QueryAsync("select * from variables where name=@n", new { n = _ctxName });
                var rs = rows.FirstOrDefault();
                if (rs != null)
                {
                    EditingVarType = Convert.ToInt32(rs["VariableType"] ?? 0);
                    EditingVarMin = (rs["minimumvalue"] ?? "0").ToString();
                    EditingVarMax = (rs["maximumvalue"] ?? "9999999").ToString();
                    EditingVarDefault = (rs["defaultvalue"] ?? "0").ToString();
                    EditingVarListOfValues = (rs["ListOfValues"] ?? "").ToString().Replace("|", "\n");
                    EditingVarHelp = (rs["Help"] ?? "").ToString();
                    EditingVarConditionName = (rs["Conditionname"] ?? "").ToString();
                    EditingVarConditionType = (rs["Conditiontype"] ?? "").ToString();
                    EditingVarConditionUOM = (rs["Conditionuom"] ?? "").ToString();
                    EditingVarUOM = (rs["uom"] ?? "").ToString().Trim();
                }
                else
                {
                    EditingVarType = 0;
                    EditingVarMin = "0";
                    EditingVarMax = "9999999";
                    EditingVarDefault = "0";
                    EditingVarListOfValues = "";
                    EditingVarHelp = "";
                    EditingVarConditionName = "";
                    EditingVarConditionType = "";
                    EditingVarConditionUOM = "";
                    EditingVarUOM = "";
                }
                IsVariableEditorVisible = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Formula editor edit-variable load failed");
                Notifications.Error($"Edit failed: {ex.Message}");
