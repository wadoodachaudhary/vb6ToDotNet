    // === Formula Text Change — replace curly quotes ===
    private void OnFormulaTextChanged(ChangeEventArgs e)
    {
        var s = e.Value?.ToString() ?? "";
        // Replace curly/smart quotes with standard ASCII equivalents
        s = s.Replace('\u0093', '"')  // left double quote
             .Replace('\u0094', '"')  // right double quote
             .Replace('\u0098', '"')  // another smart quote variant
             .Replace('\u0096', '-'); // en dash
        FormulaText = s;
    }

