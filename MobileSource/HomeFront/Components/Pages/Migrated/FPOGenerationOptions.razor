@namespace HomeFront.Components.Pages

@using Fx.ControlKit
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject ILogger<FPOGenerationOptions> Logger
@inject NotificationService Notifications

@* FlexKit DialogControl replaces the hand-rolled overlay/panel modal.
   IsModal="false" preserves the original behavior where clicking the backdrop does nothing.
   OnClose routes the × close icon to OnCancel so the cancel semantics (resolve _tcs with "")
   are preserved exactly. Visible is one-way bound to IsVisible — the component drives
   IsVisible itself via OnOkClick/OnCancel, just as the original @if did. *@
<DialogControl Visible="IsVisible"
               Header="Generation Options"
               Width="380px"
               IsModal="false"
               ShowCloseIcon="true"
               OnClose="OnCancel">
    <ChildContent>
        <div class="prompt-label">
            <img src="images/32/question.ico" alt="?" onerror="this.style.display='none'" />
            <span>How do you want to generate these POs?</span>
        </div>
        <div class="option-group">
            <RadioControl TValue="string" Name="poGenerationOption" Value="@("Vendor")"
                          @bind-SelectedValue="SelectedOption" Label="One PO per Vendor" />
            <RadioControl TValue="string" Name="poGenerationOption" Value="@("Job")"
                          @bind-SelectedValue="SelectedOption" Label="One PO per Job" />
            <RadioControl TValue="string" Name="poGenerationOption" Value="@("Unit")"
                          @bind-SelectedValue="SelectedOption" Label="One PO per Unit" />
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl OnClick="OnOkClick">OK</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    /// <summary>
    /// Controls visibility of the dialog.
    /// </summary>
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>
    /// Two-way binding support for IsVisible.
    /// </summary>
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>
    /// Fires when the user confirms a selection. Returns "Vendor", "Job", or "Unit".
    /// </summary>
    [Parameter] public EventCallback<string> OnChoose { get; set; }

    /// <summary>
    /// The currently selected option. Defaults to "Job" (matching VB6 default).
    /// </summary>
    private string SelectedOption { get; set; } = "Job";

    /// <summary>
    /// Mirrors the VB6 Choose() function. Opens the dialog, waits for user input,
    /// and returns the selected generation option.
    /// Call this from a parent component instead of toggling IsVisible manually.
    /// </summary>
    private TaskCompletionSource<string>? _tcs;

    public async Task<string> ChooseAsync()
    {
        SelectedOption = "Job"; // Reset to default each time
        _tcs = new TaskCompletionSource<string>();
        IsVisible = true;
        await IsVisibleChanged.InvokeAsync(true);
        StateHasChanged();
        return await _tcs.Task;
    }

    private async Task OnOkClick()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);

        if (OnChoose.HasDelegate)
        {
            await OnChoose.InvokeAsync(SelectedOption);
        }

        _tcs?.TrySetResult(SelectedOption);
        StateHasChanged();
    }

    private async Task OnCancel()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);

        // Return empty string on cancel (no selection made)
        _tcs?.TrySetResult(string.Empty);
        StateHasChanged();
    }
}
