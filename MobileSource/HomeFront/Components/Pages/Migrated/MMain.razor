    // ── Utility: Parse ───────────────────────────────────────────────────
    /// <summary>
    /// Parses items out of a delimited string.
    /// If index == 0, returns the count of items.
    /// If index > 0, returns the Nth item (1-based).
    /// </summary>
    public static string Parse(string delimitedString, int index = 0, string delimiter = ",")
    {
        if (string.IsNullOrEmpty(delimitedString))
            return index == 0 ? "0" : "";

        if (index < 0) return "";

        var parts = delimitedString.Split(new[] { delimiter }, StringSplitOptions.None);

        if (index == 0)
            return parts.Length.ToString();

        if (index > parts.Length)
            return "";

        return parts[index - 1];
    }

    /// <summary>Returns the count of delimited items.</summary>
    public static int ParseCount(string delimitedString, string delimiter = ",")
    {
        if (string.IsNullOrEmpty(delimitedString)) return 0;
        return delimitedString.Split(new[] { delimiter }, StringSplitOptions.None).Length;
    }

    // ── Utility: Update ──────────────────────────────────────────────────
    /// <summary>Updates items in a delimited string at a given 1-based column.</summary>
    public static string Update(string inputString, int col, string value, string delimiter = ",")
    {
        var parts = (inputString ?? "").Split(new[] { delimiter }, StringSplitOptions.None).ToList();
        while (parts.Count < col)
            parts.Add("");
        parts[col - 1] = value;
        return string.Join(delimiter, parts);
    }

    // ── Utility: Min / Max ───────────────────────────────────────────────
    public static T Min<T>(params T[] items) where T : IComparable<T>
    {
        var result = items[0];
        for (int i = 1; i < items.Length; i++)
            if (items[i].CompareTo(result) < 0) result = items[i];
        return result;
    }

    public static T Max<T>(params T[] items) where T : IComparable<T>
    {
        var result = items[0];
        for (int i = 1; i < items.Length; i++)
            if (items[i].CompareTo(result) > 0) result = items[i];
        return result;
    }

    // ── Utility: IsBetween / Between ─────────────────────────────────────
    public static bool IsBetween<T>(T value, T minimum, T maximum, bool inclusive = true) where T : IComparable<T>
    {
        if (inclusive)
            return value.CompareTo(minimum) >= 0 && value.CompareTo(maximum) <= 0;
        else
            return value.CompareTo(minimum) > 0 && value.CompareTo(maximum) < 0;
    }

    public static T Between<T>(T minimum, T maximum, T value) where T : IComparable<T>
    {
        if (value.CompareTo(maximum) > 0) value = maximum;
        if (value.CompareTo(minimum) < 0) value = minimum;
        return value;
    }

    // ── Utility: ItemInList ──────────────────────────────────────────────
    public static bool ItemInList(string item, string list, string delimiter = ",")
    {
        var wrappedList = delimiter + list + delimiter;
        var wrappedItem = delimiter + item + delimiter;
        return wrappedList.Contains(wrappedItem, StringComparison.OrdinalIgnoreCase);
    }

    // ── Utility: ParseDistinctList ───────────────────────────────────────
    public static string ParseDistinctList(string list, string delimiter = ",")
    {
        var parts = list.Split(new[] { delimiter }, StringSplitOptions.None);
        var distinct = new List<string>();
        foreach (var part in parts)
        {
            if (!distinct.Contains(part, StringComparer.OrdinalIgnoreCase))
                distinct.Add(part);
        }
        return string.Join(delimiter, distinct);
    }

    // ── Utility: IsIn ────────────────────────────────────────────────────
    public static bool IsIn(string expression, params string[] items)
    {
        foreach (var item in items)
            if (string.Equals(expression, item, StringComparison.OrdinalIgnoreCase))
                return true;
        return false;
    }

