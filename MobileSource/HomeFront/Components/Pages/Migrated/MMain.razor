        foreach (var c in invalidChars)
            fileName = fileName.Replace(c.ToString(), "");
        return fileName;
    }

    public static string PathAppend(params string[] paths)
    {
        if (paths.Length == 0) return "";
        var result = paths[0].TrimEnd('\\');
        for (int i = 1; i < paths.Length; i++)
        {
            var segment = paths[i].Trim().TrimStart('\\').TrimEnd('\\');
            result = result + "\\" + segment;
        }
        return result;
    }

    public static string QualifyPath(string path)
    {
        if (!path.EndsWith("\\")) return path + "\\";
        return path;
    }

    public static void CreatePath(string pathDescription, string path)
    {
        try
        {
            if (!string.IsNullOrEmpty(path) && !Directory.Exists(path))
                Directory.CreateDirectory(path);
        }
        catch { /* ignore */ }
    }

    public static string FileDrive(string fullpath)
    {
        fullpath = (fullpath ?? "").Trim();
        if (fullpath.StartsWith("\\\\"))
        {
            var parts = fullpath.Substring(2).Split('\\');
            return "\\\\" + (parts.Length > 0 ? parts[0] : "");
        }
        return fullpath.Length >= 2 ? fullpath.Substring(0, 2) : "";
    }

