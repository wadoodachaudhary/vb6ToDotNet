    // ── RollPrices ───────────────────────────────────────────────────────
    /// <summary>
    /// Checks for expired vendor pricing and rolls prices forward.
    /// Returns a message describing what happened.
    /// </summary>
    public static async Task<string> RollPrices(int divisionId, bool prompt = true)
    {
        var checkSql = @"
            SELECT ISNULL(SUM(CASE WHEN next_effective1<=CONVERT(datetime, getdate()) AND ISNULL(next_cost1,0)=0 THEN 1 ELSE 0 END),0) ZeroRows1
                  ,ISNULL(SUM(CASE WHEN next_effective2<=CONVERT(datetime, getdate()) AND ISNULL(next_cost2,0)=0 THEN 1 ELSE 0 END),0) ZeroRows2
                  ,COUNT(*) AllRows
            FROM tblvendorcost
            WHERE (next_effective1<=CONVERT(datetime, getdate()) OR next_effective2<=CONVERT(datetime, getdate()))
              AND (divisionid=0 OR DivisionID = @DivisionID)";

        var dt = db.SqlExec(checkSql, new { DivisionID = divisionId });
        if (dt.Rows.Count == 0)
            return "No pricing data found.";

        var row = dt.Rows[0];
        int zeroRows = Math.Max(Convert.ToInt32(row[0]), Convert.ToInt32(row[1]));
        int allRows = Convert.ToInt32(row[2]);

        if (allRows == 0)
        {
            return prompt ? "" : "No prices have expired. Your pricing database is current.";
        }

        // Execute the roll
        var rollSql = @"
            UPDATE tblVendorCost
            SET last_cost3      = ISNULL(last_cost2,0)
               ,last3_expiry    = last2_expiry
               ,last_cost2      = ISNULL(last_cost1,0)
               ,last2_expiry    = last1_expiry
               ,last_cost1      = ISNULL(current_cost,0)
               ,last1_expiry    = CAST(FLOOR(CAST(GETDATE() AS float)) AS datetime)
               ,Current_Cost    = ISNULL(next_Cost1,0)
               ,next_cost1      = ISNULL(next_cost2,0)
               ,next_effective1 = next_effective2
               ,next_cost2      = 0
               ,next_effective2 = NULL
            WHERE (next_effective1 <= CAST(FLOOR(CAST(GETDATE() AS float)) AS datetime)
               OR  next_effective2 <= CAST(FLOOR(CAST(GETDATE() AS float)) AS datetime))
              AND (divisionid=0 OR DivisionID = @DivisionID)";

        db.SqlExec(rollSql, new { DivisionID = divisionId });
        // Execute twice as in VB6
        db.SqlExec(rollSql, new { DivisionID = divisionId });

        return $"{allRows} items have been updated. Your pricing database is current.";
    }

    // ── FixGroupPhaseValue ───────────────────────────────────────────────
    public static void FixGroupPhaseValue(int divisionId)
    {
        var sql = @"
            UPDATE pp
            SET GroupPhaseValue=gg.phase
            FROM
            (
              SELECT p.divisionid,MAX(g.sortorder) groupsort,p.phase
              FROM tblestphases p
              JOIN estgroups g ON g.divisionid=p.divisionid AND g.sortorder<p.sortorder
              WHERE p.groupphase=0
              GROUP BY p.divisionid,p.sortorder,p.phase
            ) x
            JOIN tblestphases pp ON pp.divisionid=x.divisionid AND pp.phase=x.phase
            JOIN estgroups gg ON gg.divisionid=x.divisionid AND gg.sortorder=x.groupsort
            WHERE x.DivisionID = @DivisionID

            UPDATE tblestphases
            SET GroupPhaseValue=Phase
            WHERE DivisionID = @DivisionID AND GroupPhase=1

            UPDATE tblestphases
            SET groupphasevalue=(SELECT MIN(phase) FROM tblestphases WHERE divisionid=@DivisionID AND groupphase=1)
            WHERE groupphasevalue IS NULL";

        db.SqlExec(sql, new { DivisionID = divisionId });
    }

    // ── PublishPricingWorksheet ───────────────────────────────────────────
    public static void PublishPricingWorksheet(int worksheet, int divisionId)
    {
        var selectSql = @"
            SELECT sd.assemblytype, sd.community, sd.CommunityPhase, sd.OptionID, sd.model,
                   sd.JCExtra, sd.elevation, sd.series, sd.description, sd.AssemblyUOM,
                   sd.floorarea, sd.bedrooms, sd.bathrooms, sd.style, sd.cost, sd.pretax,
                   sd.copretax, sd.IncludeTax, sd.IncentiveCost, sd.IncentiveRetail,
                   sd.tax, sd.cotax, sd.optionid, sd.constcutoff, sd.assembly, sd.category,
                   sd.GraphicPath, sd.SpecDocument, sd.MaxWidth, sd.MaxLength, sd.Inactive,
                   sd.color, sd.location, sd.qty, sd.includedoption,
                   oc.group_code, sd.notes, sd.comments, sd.Markup, sd.Margin,
                   sd.pretax2, sd.tax2, sd.Margin2, sd.Markup2,
                   sd.pretax3, sd.tax3, sd.Margin3, sd.Markup3,
                   sd.pretax4, sd.tax4, sd.Margin4, sd.Markup4,
                   sd.pretax5, sd.tax5, sd.Margin5, sd.Markup5,
                   sd.pretax6, sd.tax6, sd.Margin6, sd.Markup6,
                   sd.pretax7, sd.tax7, sd.Margin7, sd.Markup7,
                   sd.pretax8, sd.tax8, sd.Margin8, sd.Markup8,
                   sd.pretax9, sd.tax9, sd.Margin9, sd.Markup9,
                   sd.pretax10, sd.tax10, sd.Margin10, sd.Markup10,
                   sd.ColorListID, sd.StyleListID, sd.FinishListID, sd.OtherListID,
                   sd.StyleValue, sd.FinishValue, sd.OtherValue, m.Worksheet,
                   sd.DesignCenterSalesOnly, sd.SelectByRoom, sd.DisplayTotalOnly
            FROM tblSalesSheetDetails sd
            JOIN tblSalesSheetMaster m ON m.Worksheet=sd.Worksheet
            LEFT OUTER JOIN tblCategories oc ON sd.Category=oc.Category
            WHERE sd.Worksheet=@Worksheet";

        var dt = db.SqlExec(selectSql, new { Worksheet = worksheet });

        foreach (DataRow rs in dt.Rows)
        {
            try
            {
                var assemblyType = (AssemblyTypes)Convert.ToInt32(rs["AssemblyType"] ?? 0);

                switch (assemblyType)
                {
                    case AssemblyTypes.atModel:
                        PublishModel(rs, worksheet, divisionId);
                        break;
                    case AssemblyTypes.atOption:
                        PublishOption(rs, worksheet, divisionId);
                        break;
                    case AssemblyTypes.atDesignCenter:
                        PublishDesignCenter(rs, worksheet, divisionId);
                        break;
                    case AssemblyTypes.atGlobal:
                        PublishGlobal(rs, worksheet, divisionId);
                        break;
                }
            }
            catch (Exception ex)
            {
                // Skip duplicates, rethrow others
                if (!ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                    throw;
            }
        }

        db.SqlExec("UPDATE tblSalesSheetMaster SET SalesEffectiveDate=GETDATE() WHERE Worksheet=@Worksheet",
            new { Worksheet = worksheet });
        db.SqlExec("UPDATE tblSalesSheetDetails SET ReadyToPublish = 0 WHERE Worksheet=@Worksheet",
            new { Worksheet = worksheet });
    }

