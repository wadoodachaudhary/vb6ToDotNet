    public static string AddQuotes(string s) => $"\"{s}\"";

    public static string Quote(string s, bool removeFormatting = true, int length = 0, bool removeSpecial = true)
    {
        if (removeFormatting)
        {
            s = s.Replace("\t", " ").Replace("\n", " ").Replace("\r", " ");
        }
        if (removeSpecial)
            s = RemoveSpecialChar(s);
        s = s.Replace("\"", "''");
        if (length > 0 && s.Length > length)
            s = s.Substring(0, length);
        return "\"" + s + "\"";
    }

    private static string RemoveSpecialChar(string text)
    {
        var sb = new StringBuilder();
        foreach (var c in text)
        {
            if (c <= 0x7F)
                sb.Append(c);
        }
        return sb.ToString();
    }

    public static string StripFormatting(string s)
    {
        const string formatChars = "+=_-)(*&^%$#@!~`[]{}\\|/?'\"<>;:,";
        foreach (var c in formatChars)
            s = s.Replace(c.ToString(), "");
        return s;
    }

    // ── SpaceCase ────────────────────────────────────────────────────────
    public static string SpaceCase(string s)
    {
        if (string.IsNullOrEmpty(s)) return "";
        s = s.Replace("_", "").Replace(" ", "");
        var sb = new StringBuilder();
        for (int i = 0; i < s.Length; i++)
        {
            char cPrev = i > 0 ? s[i - 1] : '\0';
            char cThis = s[i];
            char cNext = i < s.Length - 1 ? s[i + 1] : 'Z';
            if (char.IsUpper(cThis) && (char.IsLower(cPrev) || char.IsLower(cNext)))
                sb.Append(' ');
            sb.Append(cThis);
        }
        return sb.ToString().Trim();
    }

    // ── FormatExcelColRef ────────────────────────────────────────────────
    public static string FormatExcelColRef(int index)
    {
        const string abc = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        var s = "";
        if (index > 26)
        {
            int i = (index - 1) / 26;
            if (i > 0) s += abc[i - 1];
        }
        int remainder = index % 26;
        s += remainder == 0 ? "Z" : abc[remainder - 1].ToString();
        return s;
    }

    // ── FormatPhone ──────────────────────────────────────────────────────
    public static string FormatPhone(string number, string countryCode = "US")
    {
        if (string.IsNullOrWhiteSpace(number)) return "";
        number = number.Trim();
        var digitsOnly = new string(number.Where(char.IsDigit).ToArray());

        switch (countryCode.ToUpper())
        {
            case "AU":
                if (digitsOnly.Length == 11) digitsOnly = "+" + digitsOnly;
                if (digitsOnly.Length == 9) digitsOnly = "0" + digitsOnly;
                bool isInternational = number.StartsWith("+");
                bool isMobile;
                if (isInternational)
                    isMobile = digitsOnly.Length >= 4 && IsIn(digitsOnly[3].ToString(), "4", "5");
                else
                    isMobile = digitsOnly.Length >= 2 && IsIn(digitsOnly.Substring(0, 2), "04", "05");

                if (!digitsOnly.All(char.IsDigit)) return number;
                if (isMobile && isInternational && digitsOnly.Length == 12)
                    return $"+{digitsOnly.Substring(0, 2)} {digitsOnly.Substring(2, 3)} {digitsOnly.Substring(5, 3)} {digitsOnly.Substring(8, 3)}";
                if (isMobile && digitsOnly.Length == 10)
                    return $"{digitsOnly.Substring(0, 4)} {digitsOnly.Substring(4, 3)} {digitsOnly.Substring(7, 3)}";
                if (isInternational && digitsOnly.Length == 12)
                    return $"+{digitsOnly.Substring(0, 2)} {digitsOnly.Substring(2, 1)} {digitsOnly.Substring(3, 4)} {digitsOnly.Substring(7, 4)}";
                if (digitsOnly.Length == 10)
                    return $"{digitsOnly.Substring(0, 2)} {digitsOnly.Substring(2, 4)} {digitsOnly.Substring(6, 4)}";
                return number;

            default: // US/CA
                if (!digitsOnly.All(char.IsDigit)) return number;
                return digitsOnly.Length switch
                {
                    10 => $"({digitsOnly.Substring(0, 3)}) {digitsOnly.Substring(3, 3)}-{digitsOnly.Substring(6, 4)}",
                    11 => $"{digitsOnly[0]} ({digitsOnly.Substring(1, 3)}) {digitsOnly.Substring(4, 3)}-{digitsOnly.Substring(7, 4)}",
                    7 => $"{digitsOnly.Substring(0, 3)}-{digitsOnly.Substring(3, 4)}",
                    _ => number
                };
        }
    }

    // ── SimpleEncrypt ────────────────────────────────────────────────────
    public static string SimpleEncrypt(string secret, string key)
    {
        if (string.IsNullOrEmpty(secret) || string.IsNullOrEmpty(key)) return secret;
        var chars = secret.ToCharArray();
        for (int i = 0; i < chars.Length; i++)
        {
            int keyIndex = i % key.Length;
            chars[i] = (char)(chars[i] ^ key[keyIndex]);
        }
        return new string(chars);
    }

