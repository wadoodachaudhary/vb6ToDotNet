@using HomeFront.Components.Grid
@using HomeFront.Components.Hf
@using HomeFront.Data

<HfDialog Visible="@Visible"
          Header="Choose Columns"
          Width="520px"
          Height="660px"
          IsModal="true"
          ShowCloseIcon="true"
          CloseOnEscape="true"
          OnClose="HandleCancel">
    <ChildContent>
        <div class="fcolumns-body">
            <div class="fcolumns-info">@InfoText</div>

            <div class="fcolumns-main">
                <div class="fcolumns-grid">
                    <HfGrid @ref="ColumnsGrid"
                            TValue="ColumnItem"
                            DataSource="@_workingColumns"
                            AllowSelection="true"
                            AllowSorting="false"
                            AllowFiltering="false"
                            Height="420px"
                            SelectionSettingsRef="@_selectionSettings"
                            EventsRef="@_gridEvents">
                        <HfGridColumnsBase>
                            <HfGridColumn HeaderText="Visible" Width="80px" AllowSorting="false" AllowFiltering="false">
                                <Template>
                                    @{
                                        var item = (ColumnItem)context;
                                        <HfCheckBox Checked="@item.Visible"
                                                    CheckedChanged="v => OnVisibleChanged(item, v)" />
                                    }
                                </Template>
                            </HfGridColumn>
                            <HfGridColumn Field="@nameof(ColumnItem.Caption)"
                                          HeaderText="Column"
                                          Width="220px"
                                          AllowEditing="false" />
                            <HfGridColumn Field="@nameof(ColumnItem.Key)"
                                          HeaderText="Key"
                                          Visible="false" />
                        </HfGridColumnsBase>
                    </HfGrid>
                </div>

                <div class="fcolumns-actions">
                    <HfButton CssClass="hf-dialog-btn" OnClick="() => MoveSelected(-1)">Move Up</HfButton>
                    <HfButton CssClass="hf-dialog-btn" OnClick="() => MoveSelected(1)">Move Down</HfButton>
                    <HfButton CssClass="hf-dialog-btn" OnClick="() => SetSelectedVisibility(true)">Show</HfButton>
                    <HfButton CssClass="hf-dialog-btn" OnClick="() => SetSelectedVisibility(false)">Hide</HfButton>
                    <HfButton CssClass="hf-dialog-btn" OnClick="() => SetAllVisibility(true)">Show All</HfButton>
                    <HfButton CssClass="hf-dialog-btn" OnClick="() => SetAllVisibility(false)">Hide All</HfButton>
                    <HfButton CssClass="hf-dialog-btn" OnClick="RestoreDefaultLayout">Restore Default Layout</HfButton>
                </div>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <div class="fcolumns-footer">
            <HfButton CssClass="hf-dialog-btn hf-primary" OnClick="HandleOk">OK</HfButton>
            <HfButton CssClass="hf-dialog-btn" OnClick="HandleCancel">Cancel</HfButton>
        </div>
    </FooterContent>
</HfDialog>

<style>
    .fcolumns-body {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .fcolumns-info {
        font-size: 13px;
        color: #555;
        padding: 6px 4px;
    }

    .fcolumns-main {
        display: grid;
        grid-template-columns: 1fr 160px;
        gap: 12px;
    }

    .fcolumns-actions {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .fcolumns-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }
</style>

@code {
    private const string SRCFILE = "FColumns::";

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public List<ColumnItem> Columns { get; set; } = new();
    [Parameter] public EventCallback<List<ColumnItem>> Applied { get; set; }
    [Parameter] public string GridTag { get; set; } = "";
    [Parameter] public string InfoText { get; set; } =
        "Select the columns to display and their order. Use the buttons to show, hide, or move columns.";

    private readonly DbWrapperSqlServer _db = new();
    private readonly HfSelectionSettings _selectionSettings = new()
    {
        Type = SelectionType.Multiple,
        Mode = SelectionMode.Row,
        EnableToggle = true
    };

    private readonly HfGridEvents<ColumnItem> _gridEvents = new();
    private HfGrid<ColumnItem>? ColumnsGrid;

    private List<ColumnItem> _workingColumns = new();
    private int _selectedIndex = -1;
    private bool _wasVisible;

    protected override void OnInitialized()
    {
        _gridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<ColumnItem>>(this, OnRowSelected);
    }

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            _workingColumns = Columns.Select(c => c.Clone()).ToList();
            _selectedIndex = _workingColumns.Count > 0 ? 0 : -1;
        }
        _wasVisible = Visible;
    }

    private void OnRowSelected(RowSelectEventArgs<ColumnItem> args)
    {
        _selectedIndex = args.RowIndex;
    }

    private void OnVisibleChanged(ColumnItem item, bool value)
    {
        item.Visible = value;
    }

    private IEnumerable<ColumnItem> GetSelectedColumns()
    {
        return ColumnsGrid?.GetSelectedRecords() ?? Enumerable.Empty<ColumnItem>();
    }

    private void SetSelectedVisibility(bool visible)
    {
        var selected = GetSelectedColumns().ToList();
        if (selected.Count == 0 && _selectedIndex >= 0 && _selectedIndex < _workingColumns.Count)
        {
            selected.Add(_workingColumns[_selectedIndex]);
        }

        foreach (var item in selected)
        {
            item.Visible = visible;
        }
    }

    private void SetAllVisibility(bool visible)
    {
        foreach (var item in _workingColumns)
        {
            item.Visible = visible;
        }
    }

    private async Task MoveSelected(int direction)
    {
        if (_selectedIndex < 0 || _selectedIndex >= _workingColumns.Count)
            return;

        var newIndex = Math.Clamp(_selectedIndex + direction, 0, _workingColumns.Count - 1);
        if (newIndex == _selectedIndex)
            return;

        var item = _workingColumns[_selectedIndex];
        _workingColumns.RemoveAt(_selectedIndex);
        _workingColumns.Insert(newIndex, item);
        _selectedIndex = newIndex;

        await InvokeAsync(StateHasChanged);
        ColumnsGrid?.SelectRow(newIndex);
    }

    private async Task RestoreDefaultLayout()
    {
        if (string.IsNullOrWhiteSpace(GridTag))
            return;

        var sql = @"
            SELECT colkey, caption, hidden
            FROM AppGridLayout
            WHERE uid = CHAR(1)
              AND gridname = @GridName
            ORDER BY colindex";

        var rows = await _db.QueryAsync(sql, new { GridName = GridTag });
        if (!rows.Any())
            return;

        var index = 0;
        foreach (var row in rows)
        {
            var key = row["colkey"]?.ToString() ?? "";
            var caption = row["caption"]?.ToString() ?? "";
            var hidden = row["hidden"]?.ToString() ?? "";

            var currentIndex = _workingColumns.FindIndex(c =>
                string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));

            if (currentIndex < 0)
                continue;

            var item = _workingColumns[currentIndex];
            item.Caption = caption;
            item.Visible = !string.Equals(hidden, "True", StringComparison.OrdinalIgnoreCase);

            _workingColumns.RemoveAt(currentIndex);
            if (index > _workingColumns.Count)
                index = _workingColumns.Count;

            _workingColumns.Insert(index, item);
            index++;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleOk()
    {
        Columns.Clear();
        Columns.AddRange(_workingColumns.Select(c => c.Clone()));

        if (Applied.HasDelegate)
            await Applied.InvokeAsync(Columns);

        await CloseAsync();
    }

    private async Task HandleCancel()
    {
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        Visible = false;
        if (VisibleChanged.HasDelegate)
            await VisibleChanged.InvokeAsync(false);
    }

    public class ColumnItem
    {
        public string Key { get; set; } = "";
        public string Caption { get; set; } = "";
        public bool Visible { get; set; } = true;

        public ColumnItem Clone() => new()
        {
            Key = Key,
            Caption = Caption,
            Visible = Visible
        };
    }
}
