    // === Computed Properties ===
    private bool CanGoNext
    {
        get
        {
            if (CurrentFrame == 2 && SelectedTask == 3) return true; // Edit quantities goes to step 3
            if (CurrentFrame == 2 && SelectedTask != 3) return false; // Other tasks commit from step 2
            if (CurrentFrame >= 3) return false;
            return true;
        }
    }

    private bool CanCommit
    {
        get
        {
            if (CurrentFrame == 2 && SelectedTask != 3) return true;
            if (CurrentFrame == 3 && SelectedTask == 3) return true;
            return false;
        }
    }



    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        // gItems mass-edit wiring (NEW VB6 gItems_AfterEdit). OnCellSave =
        // single edited row → dirty; OnTypeAheadCommit = fan the typed
        // Quantity down the whole vertical selection range → all dirty.
        itemsGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<ItemDetailRow>>(this, OnItemsCellSave);
        itemsGridEvents.OnTypeAheadCommit = EventCallback.Factory.Create<TypeAheadCommitArgs<ItemDetailRow>>(this, OnItemsTypeAheadCommit);

        await LoadGridLayoutAsync();
        await LoadCustomDescriptions();
    }

    // ── gItems inline-edit (NEW VB6 gItems_AfterEdit, single-cell case) ──
    // GridControl raises OnCellSave AFTER it has written the typed value back
    // to the row via reflection, so args.Data already carries the new
    // Quantity. VB6 marks the row "DIRTY"; ApplyEditQuantities saves only
    // dirty rows. (The multi-row vertical-selection case is handled by
    // OnItemsTypeAheadCommit below.)
    private async Task OnItemsCellSave(CellSaveArgs<ItemDetailRow> args)
    {
        if (args?.Data == null) return;
        if (args.ColumnName != nameof(ItemDetailRow.Quantity)) return;

        args.Data.IsDirty = true;

        if (ItemsGrid != null)
            await ItemsGrid.Refresh();
        StateHasChanged();
    }

    // ── gItems multi-select fan-out (NEW VB6 gItems_AfterEdit, range case) ──
    // VB6: For r = Min(.Row,.RowSel) To Max(.Row,.RowSel): RowData(r)="DIRTY".
    // GridControl fires OnTypeAheadCommit once per type-ahead Enter when 2+
    // cells/rows are selected, with the typed Value + every SelectedItem in
    // the run. We write the typed Quantity to each one and mark them dirty —
    // "edit one cell, apply the change down all the selected rows."
    private async Task OnItemsTypeAheadCommit(TypeAheadCommitArgs<ItemDetailRow> args)
    {
        var field = !string.IsNullOrEmpty(args.ColumnName)
            ? args.ColumnName
            : nameof(ItemDetailRow.Quantity);

        if (field != nameof(ItemDetailRow.Quantity)) return;

        var qty = double.TryParse(args.Value, out var q) ? q : 0;
        var applied = 0;
        foreach (var item in args.SelectedItems)
        {
            item.Quantity = qty;
            item.IsDirty = true;
            applied++;
        }
        if (applied == 0) return;

        if (ItemsGrid != null)
            await ItemsGrid.Refresh();
        StateHasChanged();
    }

    private async Task LoadCustomDescriptions()
    {
        try
        {
            var label = await db.ExecuteScalarAsync<string>(
                "SELECT ISNULL(NULLIF(custom_description,''),'Community') FROM customdescriptions WHERE item='Community'");
            if (!string.IsNullOrEmpty(label)) CommunityLabel = label;
        }
        catch { /* non-critical */ }
    }

    // === Navigation ===
    private async Task OnCancel()
    {
        // Modal mode wins over navigation — host expects OnClose so it can
        // flip _showMassChangeModal back to false. Standalone /mass-change-
        // wizard route falls back to navigating to the assembly editor
        // (the only sensible "where do I go now" target — the wizard has
        // no parent URL of its own).
        if (IsModal && OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
            return;
        }
        NavigationManager.NavigateTo("/edit-model-assembly");
    }

    private async Task OnBack()
    {
        if (CurrentFrame > 0)
        {
            CurrentFrame--;
            await OnFrameChanged();
        }
    }

    private async Task OnNext()
    {
        if (CurrentFrame == 2 && SelectedTask != 3) return;
        CurrentFrame++;
        await OnFrameChanged();
    }

    private async Task OnFrameChanged()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            switch (CurrentFrame)
            {
                case 0:
                    // Reset assemblies
                    AssembliesData.Clear();
                    RemovedAssemblies.Clear();
                    break;

                case 1:
                    // Load assemblies matching filter
                    await LoadAssembliesAsync();
                    break;

                case 2:
                    // Choose action - nothing to load
                    break;

                case 3:
                    // Load items for editing
                    await LoadItemsAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Step 1: Load Assemblies ===
    private async Task LoadAssembliesAsync()
    {
        var sql = @"
            SELECT Community, Model, OptionID, Assembly,
                   AssemblyTypeDesc AS [AssemblyType],
                   Description,
                   Style, Category,
                   CASE Inactive WHEN 1 THEN 'Inactive' ELSE 'Active' END AS Active
            FROM tbldbassemblymaster
            WHERE DivisionID = @DivisionID";

        sql += BuildAssemblyWhereClause("");
        sql += "\nORDER BY Community, Model, OptionID, Assembly, AssemblyTypeDesc, Description, Style";

        var dt = db.SqlExec(sql, new { SessionState.DivisionID });
        AssembliesData = dt.AsEnumerable().Select(r => new AssemblyRow
        {
            Community = r["Community"]?.ToString() ?? "",
            Model = r["Model"]?.ToString() ?? "",
            OptionID = r["OptionID"]?.ToString() ?? "",
            Assembly = r["Assembly"]?.ToString() ?? "",
            AssemblyType = r["AssemblyType"]?.ToString() ?? "",
            Description = r["Description"]?.ToString() ?? "",
            Style = r["Style"]?.ToString() ?? "",
            Category = r["Category"]?.ToString() ?? "",
            Active = r["Active"]?.ToString() ?? "",
            IsHidden = false
        }).ToList();

        RemovedAssemblies.Clear();
    }

    // === Step 3: Load Items ===
    private async Task LoadItemsAsync()
    {
        var sql = @"
            SELECT m.Community, m.Model, m.OptionID, m.Assembly,
                   m.AssemblyTypeDesc AS [AssemblyType],
                   m.Description AS [AssemblyDesc],
                   m.Style, m.Category,
                   CASE Inactive WHEN 1 THEN 'Inactive' ELSE 'Active' END AS Active,
                   d.Phase, d.Item,
                   i.Description AS [ItemDesc],
                   d.TakeoffQty AS Quantity,
                   i.TakeoffUOM AS UOM
            FROM tbldbassemblymaster m
            JOIN tbldbassemblydetails d ON (m.DivisionID = d.DivisionID AND m.community=d.community AND m.assembly=d.assembly AND m.model=d.model AND m.optionid=d.optionid)
            JOIN tblphaseitem i ON (d.DivisionID = i.DivisionID AND d.phase=i.phase AND d.item=i.item)
            WHERE m.DivisionID = @DivisionID";

        if (!string.IsNullOrEmpty(tagPhaseItem4))
        {
            var parts = tagPhaseItem4.Split('\x01');
            if (parts.Length >= 2)
            {
                sql += $"\n   AND d.phase='{EscapeSql(parts[0])}'";
                sql += $"\n   AND d.item='{EscapeSql(parts[1])}'";
            }
        }

        sql += BuildAssemblyWhereClause("m");
        sql += "\nORDER BY m.Community, m.Model, m.OptionID, m.Assembly, m.Style, m.Category";

        var dt = db.SqlExec(sql, new { SessionState.DivisionID });
        ItemsData = dt.AsEnumerable().Select(r => new ItemDetailRow
        {
            Community = r["Community"]?.ToString() ?? "",
            Model = r["Model"]?.ToString() ?? "",
            OptionID = r["OptionID"]?.ToString() ?? "",
            Assembly = r["Assembly"]?.ToString() ?? "",
            AssemblyType = r["AssemblyType"]?.ToString() ?? "",
            AssemblyDesc = r["AssemblyDesc"]?.ToString() ?? "",
            Style = r["Style"]?.ToString() ?? "",
            Category = r["Category"]?.ToString() ?? "",
            Active = r["Active"]?.ToString() ?? "",
            Phase = r["Phase"]?.ToString() ?? "",
            Item = r["Item"]?.ToString() ?? "",
            ItemDesc = r["ItemDesc"]?.ToString() ?? "",
            Quantity = r["Quantity"] != DBNull.Value ? Convert.ToDouble(r["Quantity"]) : 0,
            UOM = r["UOM"]?.ToString() ?? "",
            IsDirty = false
        }).ToList();
    }

    // === Build WHERE Clause ===
    private string BuildAssemblyWhereClause(string tableAlias)
    {
        var s = "";
        var prefix = string.IsNullOrEmpty(tableAlias) ? "" : tableAlias + ".";

        if (!string.IsNullOrEmpty(txtCommunity)) s += $"\n   AND {prefix}community LIKE '{EscapeSql(txtCommunity)}'";
        if (!string.IsNullOrEmpty(txtModel)) s += $"\n   AND {prefix}Model LIKE '{EscapeSql(txtModel)}'";
        if (!string.IsNullOrEmpty(txtOption)) s += $"\n   AND {prefix}OptionID LIKE '{EscapeSql(txtOption)}'";
        if (!string.IsNullOrEmpty(txtAssembly)) s += $"\n   AND {prefix}Assembly LIKE '{EscapeSql(txtAssembly)}'";
        if (!string.IsNullOrEmpty(txtDescription)) s += $"\n   AND {prefix}Description LIKE '{EscapeSql(txtDescription)}'";
        if (!string.IsNullOrEmpty(txtStyle)) s += $"\n   AND {prefix}Style LIKE '{EscapeSql(txtStyle)}'";
        if (!string.IsNullOrEmpty(txtSeries)) s += $"\n   AND {prefix}Series LIKE '{EscapeSql(txtSeries)}'";
        if (!string.IsNullOrEmpty(txtCategory)) s += $"\n   AND {prefix}Category LIKE '{EscapeSql(txtCategory)}'";
        if (!string.IsNullOrEmpty(cboAssemblyType)) s += $"\n   AND {prefix}AssemblyTypeDesc LIKE '{EscapeSql(cboAssemblyType)}'";
        if (chkActiveOnly) s += $"\n   AND ISNULL({prefix}inactive,0)=0";

        // Exclude removed assemblies
        foreach (var removed in RemovedAssemblies)
        {
            s += $"\n   AND NOT ({prefix}assembly='{EscapeSql(removed.Assembly)}'";
            s += $"\n        AND {prefix}model='{EscapeSql(removed.Model)}'";
            s += $"\n        AND {prefix}optionid='{EscapeSql(removed.OptionID)}'";
            s += $"\n        AND {prefix}community='{EscapeSql(removed.Community)}')";
        }

        return s;
    }

    // === Task Changed ===
    // RadioControl @bind-SelectedValue adapter: it fires SelectedValueChanged
    // with the clicked radio's Value (the task index). Mirror the old raw
    // <input type=radio @onchange="() => OnTaskChanged(n)"> by routing straight
    // into OnTaskChanged, which sets SelectedTask + clears the other tasks'
    // fields. (SelectedValue is one-way bound to SelectedTask, so OnTaskChanged
    // assigning SelectedTask keeps every radio's checked state correct.)
    private void OnTaskRadioChanged(int taskIndex) => OnTaskChanged(taskIndex);

    private void OnTaskChanged(int taskIndex)
    {
        SelectedTask = taskIndex;

        // Clear fields for non-selected tasks
        switch (taskIndex)
        {
            case 0:
                txtPhaseItem1 = ""; tagPhaseItem1 = "";
                txtPhaseItem2 = ""; tagPhaseItem2 = "";
                txtPhaseItem3 = ""; tagPhaseItem3 = "";
                txtPhaseItem4 = ""; tagPhaseItem4 = "";
                break;
            case 1:
                txtPhaseItem0 = ""; tagPhaseItem0 = "";
                txtTakeoffQty = 0;
                txtPhaseItem2 = ""; tagPhaseItem2 = "";
                txtPhaseItem3 = ""; tagPhaseItem3 = "";
                txtPhaseItem4 = ""; tagPhaseItem4 = "";
                break;
            case 2:
                txtPhaseItem0 = ""; tagPhaseItem0 = "";
                txtTakeoffQty = 0;
                txtPhaseItem1 = ""; tagPhaseItem1 = "";
                txtPhaseItem4 = ""; tagPhaseItem4 = "";
                break;
            case 3:
                txtPhaseItem0 = ""; tagPhaseItem0 = "";
                txtTakeoffQty = 0;
                txtPhaseItem1 = ""; tagPhaseItem1 = "";
                txtPhaseItem2 = ""; tagPhaseItem2 = "";
                txtPhaseItem3 = ""; tagPhaseItem3 = "";
                break;
        }
    }

    // === Choose Item (FPickList) ===
    private async Task OnChooseItem(int index)
    {
        if (_pickList == null) return;
        _pickListContext = $"PhaseItem:{index}";
        string defaultItem = index switch
        {
            0 => GetCodeFromTag(tagPhaseItem0),
            1 => GetCodeFromTag(tagPhaseItem1),
            2 => GetCodeFromTag(tagPhaseItem2),
            3 => GetCodeFromTag(tagPhaseItem3),
            4 => GetCodeFromTag(tagPhaseItem4),
            _ => ""
        };

        var sql = $"SELECT phase AS [Phase], item AS [Item], description AS [Description] FROM tblphaseitem WHERE DivisionID = {SessionState.DivisionID} ORDER BY phase, item";
        await _pickList.Open("Item", sql, defaultItem: defaultItem);
    }

    // === Choose PO Index (FPickList) ===
    private async Task OnChoosePOIndex()
    {
        if (_pickList == null) return;
        _pickListContext = "POIndex";
        var sql = $"SELECT POIndex AS [PO Index], description AS [Description] FROM tblpoindex WHERE DivisionID = {SessionState.DivisionID} ORDER BY POIndex";
        await _pickList.Open("PO Index", sql, defaultItem: txtPOIndex);
    }

    private void OnPickListCancelled()
    {
        _pickListContext = "";
    }

    private void OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        if (selectedRows.Count == 0)
        {
            _pickListContext = "";
            return;
        }

        var pick = selectedRows[0];

        if (_pickListContext.StartsWith("PhaseItem:"))
        {
            var parts = _pickListContext.Split(':');
            if (parts.Length > 1 && int.TryParse(parts[1], out var targetIndex))
            {
                var phase = GetVal(pick, "phase");
                var item = GetVal(pick, "item");
                var desc = GetVal(pick, "description");

                var tag = $"{phase}\x01{item}";
                var display = $"{phase}/{item} - {desc}";

                switch (targetIndex)
                {
                    case 0: txtPhaseItem0 = display; tagPhaseItem0 = tag; break;
                    case 1: txtPhaseItem1 = display; tagPhaseItem1 = tag; break;
                    case 2: txtPhaseItem2 = display; tagPhaseItem2 = tag; break;
                    case 3: txtPhaseItem3 = display; tagPhaseItem3 = tag; break;
                    case 4: txtPhaseItem4 = display; tagPhaseItem4 = tag; break;
                }
            }
        }
        else if (_pickListContext == "POIndex")
        {
            txtPOIndex = GetVal(pick, "poindex");
        }

        _pickListContext = "";
        StateHasChanged();
    }

    private static string GetVal(IDictionary<string, object> dict, string key)
    {
        if (dict.TryGetValue(key, out var v) && v != null) return v.ToString() ?? "";
        var match = dict.FirstOrDefault(k => string.Equals(k.Key, key, StringComparison.OrdinalIgnoreCase));
        return match.Value?.ToString() ?? "";
    }

    private static string GetCodeFromTag(string tag)
    {
        if (string.IsNullOrEmpty(tag)) return "";
        var parts = tag.Split('\x01');
        return parts.Length > 1 ? parts[1] : "";
    }

    // === Remove Selected Assemblies ===
    // Reached only via the right-click Remove context menu (HHM-252) since
    // the non-legacy "Remove Selected" button below the grid was removed
    // (HHM-251) — VB6 FMassChange.frm:1245-1249 hides selected rows from
    // its popup menu, the only removal mechanism.
    private async Task OnRemoveSelectedAssemblies()
    {
        if (AssembliesGrid == null) return;
        var selected = AssembliesGrid.GetSelectedRecords().ToList();
        if (selected.Count == 0)
        {
            Notifications.Info("Select one or more rows to remove.");
            return;
        }

        foreach (var row in selected)
        {
            RemovedAssemblies.Add(row);
            AssembliesData.Remove(row);
        }

        if (AssembliesGrid != null)
            await AssembliesGrid.Refresh();
    }

    // ── Verify-grid context menu (HHM-252) — the step's instruction text says
    //    "Right-click on a row to remove it from the list" (VB6 gAssemblies
    //    right-click removal); the menu routes to the same removal handler.
    private bool _showAssembliesMenu;
    private double _assembliesMenuX;
    private double _assembliesMenuY;

    private void OnAssembliesContextMenu(MouseEventArgs e)
    {
        if (AssembliesData.Count == 0) return;
        _assembliesMenuX = e.ClientX;
        _assembliesMenuY = e.ClientY;
        _showAssembliesMenu = true;
    }

    private async Task OnCtxRemoveAssemblies()
    {
        _showAssembliesMenu = false;
        await OnRemoveSelectedAssemblies();
    }

    // === Commit (Apply Change) ===
    private async Task OnCommit()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            // VB6: a failed validation leaves the wizard OPEN on the same step
            // (HHM-257) — and so does a SUCCESSFUL commit (HHM-578): VB6
            // cmdNav_Click Case 3 (Commit, FMassChange.frm:1159) only calls
            // ApplyChange (frm:1363), which runs the SQL, shows the "N items
            // updated." MsgBox and (for edit-quantities) clears its own grid;
            // the form is NEVER unloaded here. Only Case 0 (Cancel,
            // frm:1156) does Unload Me, so the wizard closes solely via
            // Cancel or the × header (both wired to OnClose).
            await (SelectedTask switch
            {
                0 => ApplyAddItem(),
                1 => ApplyRemoveItem(),
                2 => ApplySubstituteItem(),
                3 => ApplyEditQuantities(),
                _ => Task.FromResult(false)
            });
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error applying change: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Apply: Add Item ===
    private async Task<bool> ApplyAddItem()
    {
        if (string.IsNullOrEmpty(tagPhaseItem0) || txtTakeoffQty == 0)
        {
            Notifications.Info("You must select an item and enter a quantity.");
            return false;
        }

        var parts = tagPhaseItem0.Split('\x01');
        var phase1 = parts[0];
        var item1 = parts[1];

        // Count affected assemblies
        var countSql = @"
            SELECT COUNT(*)
            FROM tbldbassemblymaster m, tblphaseitem i
            WHERE i.DivisionID = @DivisionID AND i.phase=@Phase AND i.item=@Item
              AND m.DivisionID = @DivisionID" + BuildAssemblyWhereClause("m");

        var count = await db.ExecuteScalarAsync<int>(countSql, new { SessionState.DivisionID, Phase = phase1, Item = item1 });

        // Insert
        var poIndexValue = chkDefaultPOIndex ? "''" : $"'{EscapeSql(txtPOIndex)}'";
        var insertSql = $@"
            INSERT INTO tbldbassemblydetails(AssemblyID, DivisionID, community, assembly, model, optionid, phase, item, poindex, takeoffqty, orderqty, ustmp, tstmp)
            SELECT m.assemblyid, {SessionState.DivisionID}, m.community, m.assembly, m.model, m.optionid,
                   i.phase, i.item, {poIndexValue},
                   {txtTakeoffQty},
                   {txtTakeoffQty} * (100 + i.WastePercent) / 100 * ISNULL(NULLIF(i.ConversionFactor,0),1),
                   '{EscapeSql(LoginID)}', GETDATE()
            FROM tbldbassemblymaster m, tblphaseitem i
            WHERE i.DivisionID = {SessionState.DivisionID} AND i.phase='{EscapeSql(phase1)}' AND i.item='{EscapeSql(item1)}'
              AND m.DivisionID = {SessionState.DivisionID}" + BuildAssemblyWhereClause("m");

        await db.ExecuteAsync(insertSql);
        Notifications.Info($"The item was added to {count} assemblies.");
        return true;
    }

    // === Apply: Remove Item ===
    private async Task<bool> ApplyRemoveItem()
    {
        if (string.IsNullOrEmpty(tagPhaseItem1))
        {
            Notifications.Info("You must select an item.");
            return false;
        }

        var parts = tagPhaseItem1.Split('\x01');
        var phase1 = parts[0];
        var item1 = parts[1];

        // Count
        var countSql = $@"
            SELECT COUNT(*)
            FROM tbldbassemblymaster m
            JOIN tbldbassemblydetails d ON (m.DivisionID = d.DivisionID AND m.community=d.community AND m.assembly=d.assembly AND m.model=d.model AND m.optionid=d.optionid)
            WHERE d.phase='{EscapeSql(phase1)}' AND d.item='{EscapeSql(item1)}'
              AND d.DivisionID = {SessionState.DivisionID}" + BuildAssemblyWhereClause("m");

        var count = await db.ExecuteScalarAsync<int>(countSql);

        // Delete
        var deleteSql = $@"
            DELETE FROM tbldbassemblydetails
            FROM tbldbassemblymaster m
            JOIN tbldbassemblydetails d ON (m.DivisionID = d.DivisionID AND m.community=d.community AND m.assembly=d.assembly AND m.model=d.model AND m.optionid=d.optionid)
            WHERE d.phase='{EscapeSql(phase1)}' AND d.item='{EscapeSql(item1)}'
              AND d.DivisionID = {SessionState.DivisionID}" + BuildAssemblyWhereClause("m");

        await db.ExecuteAsync(deleteSql);
        Notifications.Info($"{count} items removed.");
        return true;
    }

    // === Apply: Substitute Item ===
    private async Task<bool> ApplySubstituteItem()
    {
        if (string.IsNullOrEmpty(tagPhaseItem2) || string.IsNullOrEmpty(tagPhaseItem3))
        {
            Notifications.Info("You must select both items.");
            return false;
        }

        var parts1 = tagPhaseItem2.Split('\x01');
        var phase1 = parts1[0];
        var item1 = parts1[1];
        var parts2 = tagPhaseItem3.Split('\x01');
        var phase2 = parts2[0];
        var item2 = parts2[1];

        // Count
        var countSql = $@"
            SELECT COUNT(*)
            FROM tbldbassemblymaster m
            JOIN tbldbassemblydetails d ON (m.DivisionID = d.DivisionID AND m.community=d.community AND m.assembly=d.assembly AND m.model=d.model AND m.optionid=d.optionid)
            WHERE d.phase='{EscapeSql(phase1)}' AND d.item='{EscapeSql(item1)}'
              AND d.DivisionID = {SessionState.DivisionID}" + BuildAssemblyWhereClause("m");

        var count = await db.ExecuteScalarAsync<int>(countSql);

        // Update
        var updateSql = $@"
            UPDATE tbldbassemblydetails
            SET phase=p.phase, item=p.item, poindex=p.poindex
            FROM tbldbassemblymaster m
            JOIN tbldbassemblydetails d ON (m.DivisionID = d.DivisionID AND m.community=d.community AND m.assembly=d.assembly AND m.model=d.model AND m.optionid=d.optionid)
            JOIN tblphaseitem p ON (d.divisionid=p.divisionid AND p.phase='{EscapeSql(phase2)}' AND p.item='{EscapeSql(item2)}')
            WHERE d.phase='{EscapeSql(phase1)}' AND d.item='{EscapeSql(item1)}'
              AND d.DivisionID={SessionState.DivisionID}" + BuildAssemblyWhereClause("m");

        await db.ExecuteAsync(updateSql);
        Notifications.Info($"{count} items replaced.");
        return true;
    }

    // === Apply: Edit Quantities ===
    private async Task<bool> ApplyEditQuantities()
    {
        var updatedCount = 0;
        foreach (var item in ItemsData.Where(i => i.IsDirty))
        {
            updatedCount++;
            var sql = $@"
                UPDATE tbldbassemblydetails
                SET takeoffqty={item.Quantity},
                    orderqty={item.Quantity} * (100 + i.WastePercent) / 100 * ISNULL(NULLIF(i.ConversionFactor,0),1)
                FROM tbldbassemblydetails d
                JOIN tblphaseitem i ON (d.DivisionID = i.DivisionID AND d.phase=i.phase AND d.item=i.item)
                WHERE d.community='{EscapeSql(item.Community)}'
                  AND d.model='{EscapeSql(item.Model)}'
                  AND d.optionid='{EscapeSql(item.OptionID)}'
                  AND d.assembly='{EscapeSql(item.Assembly)}'
                  AND d.phase='{EscapeSql(item.Phase)}'
                  AND d.item='{EscapeSql(item.Item)}'
                  AND d.DivisionID = {SessionState.DivisionID}";

            await db.ExecuteAsync(sql);
        }

        ItemsData.Clear();
        if (updatedCount > 0)
            Notifications.Info($"{updatedCount} items updated.");
        return true;
    }

    // === Helpers ===
    private string EscapeSql(string value) => value?.Replace("'", "''") ?? "";

    // ── Load Grid Layout ──────────────────────────────────────
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            // The keyed/unkeyed "(0)" fallback + Version bump live in the presenter
            // (its ctor was given the form/grid names, instanceKey "(0)", aliases).
            await _assembliesGrid.LoadAsync(GridLayoutSvc);
            await _itemsGrid.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");

        }
    }

    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedAssembliesGridLayout()
        => _assembliesGrid.GetOrdered();

    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedItemsGridLayout()
        => _itemsGrid.GetOrdered();

    // ── Persist user column changes (resize / reorder / hide / group / rename) ──
    private Task OnAssembliesLayoutChangedAsync(GridSettings snapshot)
        => PersistGridLayoutAsync("gAssemblies", gAssembliesLayout, snapshot, _assembliesGrid, ResolveAssembliesGridField);

    private Task OnItemsLayoutChangedAsync(GridSettings snapshot)
        => PersistGridLayoutAsync("gItems", gItemsLayout, snapshot, _itemsGrid, ResolveItemsGridField);

    private async Task PersistGridLayoutAsync<T>(string gridName,
        IDictionary<string, GridLayoutColumn> layout, GridSettings snapshot,
        GridLayoutPresenter<T> presenter, Func<string, string> layoutFieldResolver)
    {
        if (snapshot == null || layout.Count == 0) return;
        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FMassChange", gridName, instanceKey: null,
                layout, snapshot, layoutFieldResolver);

            presenter.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FMassChange {Grid} layout", gridName);
        }
    }

    // The layout colkeys differ from the row property names (see the alias maps),
    // so the merge needs the same resolution the render path uses.
    private string ResolveAssembliesGridField(string layoutField)
        => _assembliesGrid.ResolveField(layoutField);

    private string ResolveItemsGridField(string layoutField)
        => _itemsGrid.ResolveField(layoutField);

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

