@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - Initial port from VB6
   ───────────────────────────────────────────────────────────────── *@
@page "/mass-change-wizard"

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data
@using HomeFront.Models

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FMassChange> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db
@layout HFComponent
<PageTitle>Mass Change Wizard - HomeFront</PageTitle>


@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Processing...</div>
    </div>
}

@* IsModal: when FAssembly (or any caller) hosts FMassChange inline, wrap
   the wizard in a backdrop + frame so the caller stays visible behind it.
   VB6 FMassChange.Show vbModal blocked the calling form; this preserves
   that UX without stealing the MDI tab. Standalone /mass-change-wizard
   route navigation leaves IsModal=false → full-page layout. Mirrors the
   FDBGrid / FTakeoff / FItemChart IsModal pattern. *@
@if (IsModal)
{
    <div class="fx-masschange-modal-backdrop"></div>
}
<div class="@(IsModal ? "fx-masschange-modal" : "")">
@if (IsModal)
{
    @* VB6 title bar: the form's Caption = "Mass Change Wizard". The
       inner blue wizard-header shows the page title underneath. *@
    <div class="fx-masschange-modal-header">
        <span class="fx-masschange-modal-title">Mass Change Wizard</span>
        <button type="button" class="fx-masschange-modal-close" title="Close"
                aria-label="Close" @onclick="OnCancel">×</button>
    </div>
}

<div class="wizard-container @(IsModal ? "fx-masschange-modal-body" : "")">
    @* ── HEADER ──────────────────────────────────────────── *@
    <div class="wizard-header">
        <div class="fx-mc-header-left">
            <h3>Model/Option Mass Change</h3>
            <p>The mass change wizard will help you update your model/option library</p>
        </div>
        @* VB6 WizHead1 gear/document icon on the upper right of the header
           band (FMassChange.frx:000C, rendered by WizHead.ctl Image1) —
           real icon extracted from the .frx replaces the 📋 emoji
           stand-in (HHM-251). *@
        <img class="fx-mc-header-icon" src="/images/32/MassChange.ico" alt=""
             aria-hidden="true" onerror="this.style.display='none'" />
    </div>

    @* ── BODY ────────────────────────────────────────────── *@
    <div class="wizard-body">

        @* ── STEP 0: Choose Models and Options ──────────── *@
        @if (CurrentFrame == 0)
        {
            <div class="step-title">
                @* VB6 used a small question-mark info icon for prompt
                   steps. ❓ keeps it cross-platform with no .ico
                   dependency. *@
                <img class="step-icon-img" src="/images/32/posting wizard.ico" alt="" onerror="this.style.display='none'" />
                Choose models and options
            </div>
            @* VB6 lblDescription(1) (frx:3665) + lblDescription "Click next to review…" —
               verbatim, the earlier paraphrase was flagged as a text deviation (HHM-245). *@
            <div class="step-description">
                Choose which models or options you would like to change by using the filters below.
                Enter a value into one or more of the following fields. You can match partial values
                using the % wildcard.
                Click next to review the records you have selected.
            </div>

            <div class="form-row">
                <label>@CommunityLabel</label>
                <TextBoxControl @bind-Value="txtCommunity" CssClass="fx-mc-input" />
            </div>
            <div class="form-row">
                <label>Model</label>
                <TextBoxControl @bind-Value="txtModel" CssClass="fx-mc-input" />
            </div>
            <div class="form-row">
                <label>Option</label>
                <TextBoxControl @bind-Value="txtOption" CssClass="fx-mc-input" />
            </div>
            <div class="form-row">
                <label>Assembly</label>
                <TextBoxControl @bind-Value="txtAssembly" CssClass="fx-mc-input" />
            </div>
            <div class="form-row">
                <label>Description</label>
                <TextBoxControl @bind-Value="txtDescription" CssClass="fx-mc-input" />
            </div>
            <div class="form-row">
                <label>Style</label>
                <TextBoxControl @bind-Value="txtStyle" CssClass="fx-mc-input" />
            </div>
            <div class="form-row">
                <label>Series</label>
                <TextBoxControl @bind-Value="txtSeries" CssClass="fx-mc-input" />
            </div>
            <div class="form-row">
                <label>Option Category</label>
                <TextBoxControl @bind-Value="txtCategory" CssClass="fx-mc-input" />
            </div>
            <div class="form-row">
                <label>Assembly Type</label>
                <DropDownListControl TValue="string" TItem="ComboBoxItem"
                                     DataSource="@AssemblyTypeItems"
                                     @bind-Value="cboAssemblyType"
                                     TextFieldName="Text" ValueFieldName="Value"
                                     Width="100%" CssClass="fx-mc-input" />
            </div>
            <div class="checkbox-row">
                <CheckBoxControl @bind-Checked="chkActiveOnly" Label="Active assemblies only" />
            </div>
        }

        @* ── STEP 1: Verify Selection ──────────────────── *@
        else if (CurrentFrame == 1)
        {
            <div class="step-title">
                @* VB6 composite icon: blue help bubble imgOK(1)
                   (FMassChange.frx:2D9B at 240,180) overlapping the yellow
                   caution shield imgOK(2) (frx:23E0 at 420,300) — real icons
                   extracted from the .frx replace the ⚠️ emoji stand-in
                   (HHM-251). *@
                <span class="fx-mc-verify-icon" aria-hidden="true">
                    <img class="fx-mc-verify-shield" src="/images/wizard/verify-shield.ico" alt=""
                         onerror="this.style.display='none'" />
                    <img class="fx-mc-verify-bubble" src="/images/wizard/verify-bubble.ico" alt=""
                         onerror="this.style.display='none'" />
                </span>
                Verify your selection
            </div>
            @* VB6 lblDescription (frx:2CAA) + "Click next if the list is correct" — verbatim
               (HHM-245). Right-click on a row still removes it (HHM-252). *@
            <div class="step-description">
                These are the models and options that will be modified if you continue. Please review
                the list carefully to be sure it only includes the records you wish to change. If it
                doesn't, press the Back button and adjust your selection criteria.
                Click next if the list is correct.
            </div>

            <div class="grid-container" @oncontextmenu="OnAssembliesContextMenu" @oncontextmenu:preventDefault="true">
                @* ShowSelectionInfoBar="false": the default "X rows selected
                   | Clear Selection" strip toggles in/out as the user
                   ticks rows in the wizard's Assemblies grid (Step 1),
                   pushing the grid up by ~24px on every click and making
                   the whole wizard "shake". VB6 has no such strip either —
                   removal feedback is simply rows disappearing via the
                   right-click Remove menu (HHM-252/HHM-251). *@
                <GridControl @ref="AssembliesGrid"
                        TValue="AssemblyRow"
                        DataSource="@AssembliesData"
                        AllowSorting="true"
                        AllowResizing="true"
                        AllowSelection="true"
                        ShowSelectionInfoBar="false"
                        AllowFiltering="true"
                        EnableHover="true"
                        Height="400px"
                        @* owner 2026-07-28: CELL selection (see selectionSettings) — VB6
                           gAssemblies is SelectionMode=0 flexSelectionFree (frm:544), so a
                           click highlights just the CELL, never the whole row. The whole-row
                           highlight wrongly implied the clicked Model was "chosen" and would
                           carry to the next step — it never does (VB6 either): the change set
                           is the FILTERED verify list minus right-click→Removed rows. Remove
                           still works: GetSelectedRecords maps selected cells → their rows,
                           exactly VB6's Min(.Row,.RowSel)..Max hide-span (frm:1236-1243).
                           (AutoSelectFirstRow dropped — it is a Row-mode-only no-op here.) *@
                        FilterSettingsRef="@filterSettings"
                        PageSettingsRef="@pageSettings"
                        SelectionSettingsRef="@selectionSettings"
                        OnLayoutChanged="@OnAssembliesLayoutChangedAsync">
                    <GridColumnsBase @key="gAssembliesLayoutVersion">
                        @if (HasAssembliesGridLayout)
                        {
                            foreach (var entry in GetOrderedAssembliesGridLayout())
                            {
                                var layout = entry.Layout;
                                var fieldName = entry.Field;
                                var columnType = entry.ColumnType;
                                var textAlign = entry.TextAlign;
                                var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                                @* HHM-577 (corrected 2026-07-28): the option column header is
                                   "OptionID", NOT "Option". VB6 binds gAssemblies to a recordset
                                   whose SQL selects OptionID UNALIASED (FMassChange.frm:1049 —
                                   unlike "AssemblyTypeDesc [Assembly Type]"), then IniGetGrid
                                   applies the saved layout (caption "OptionID"), so the running
                                   grid header is "OptionID". frm:923 "Option" is the txtOption
                                   SEARCH-FIELD label (VB.Label2 idx 2), not the grid header — so
                                   NO normalization; the layout caption "OptionID" passes through. *@
                                var width = layout.Width.HasValue && layout.Width.Value > 0
                                    ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;

                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                        }
                        else
                        {
                            <GridColumn Field="@nameof(AssemblyRow.Community)" HeaderText="@CommunityLabel" Width="120px" />
                            <GridColumn Field="@nameof(AssemblyRow.Model)" HeaderText="Model" Width="100px" />
                            <GridColumn Field="@nameof(AssemblyRow.OptionID)" HeaderText="OptionID" Width="100px" />
                            <GridColumn Field="@nameof(AssemblyRow.Assembly)" HeaderText="Assembly" Width="120px" />
                            <GridColumn Field="@nameof(AssemblyRow.AssemblyType)" HeaderText="Assembly Type" Width="150px" />
                            <GridColumn Field="@nameof(AssemblyRow.Description)" HeaderText="Assembly Desc" Width="200px" />
                            <GridColumn Field="@nameof(AssemblyRow.Style)" HeaderText="Style" Width="100px" />
                            <GridColumn Field="@nameof(AssemblyRow.Category)" HeaderText="Category" Width="100px" />
                            <GridColumn Field="@nameof(AssemblyRow.Active)" HeaderText="Active" Width="80px" />
                        }
                    </GridColumnsBase>
                </GridControl>
            </div>

            @* HHM-252: the right-click Remove ContextMenuControl used to render
               HERE, inside .fx-masschange-modal — whose translateX(-50%)
               transform made it the containing block for the menu's
               position:fixed, so the menu landed offset from the cursor and
               (with the modal's overflow:hidden) was clipped away entirely,
               i.e. "not showing". It now renders OUTSIDE the modal wrapper
               (see below, next to FPickList) so its fixed positioning is
               truly viewport-based. *@
            @* HHM-251: the "Remove Selected" button + "N assembly(ies)
               selected" counter that used to sit here have no VB6
               counterpart — FMassChange.frm has no controls below
               gAssemblies; removal is exclusively via the right-click
               Remove popup (frm:983-990, 1211, 1245-1249), which the
               ContextMenuControl outside the modal wrapper reproduces
               (HHM-252). *@
        }

        @* ── STEP 2: Choose Action ─────────────────────── *@
        else if (CurrentFrame == 2)
        {
            <div class="step-title">
                @* HHM-253: VB6 imgOK(3) on WizFrame(2) (FMassChange.frx:1A41) is
                   the blue help-bubble icon — byte-identical to question.ico —
                   not the Step-0 "posting wizard" graphic. *@
                <img class="step-icon-img" src="/images/32/question.ico" alt="" onerror="this.style.display='none'" />
                How would you like to change these models and options?
            </div>

            @* Add an item *@
            <div class="task-option">
                <RadioControl TValue="int" Name="taskOption" Value="0"
                              SelectedValue="SelectedTask" SelectedValueChanged="OnTaskRadioChanged"
                              Label="Add an item" />
            </div>
            @* VB6 keeps EVERY task's sub-fields visible, merely disabled while its
               radio isn't selected — hiding them shifted the layout and hid context
               (HHM-253). *@
            <div class="task-fields @(SelectedTask == 0 ? "" : "task-fields-disabled")">
                    <div class="form-row">
                        <label>Phase / Item</label>
                        <TextBoxControl Value="@txtPhaseItem0" readonly CssClass="fx-mc-input" />
                        <ButtonControl BareStyle="true" CssClass="choose-btn" Disabled="@(SelectedTask != 0)" OnClick="() => OnChooseItem(0)">...</ButtonControl>
                    </div>
                    <div class="form-row">
                        <label>Takeoff Qty</label>
                        <NumericTextBoxControl TValue="double" @bind-Value="txtTakeoffQty" Enabled="@(SelectedTask == 0)" Width="120px" />
                    </div>
                    <div class="checkbox-row">
                        <CheckBoxControl @bind-Checked="chkDefaultPOIndex" Disabled="@(SelectedTask != 0)" Label="Use Default PO Index" />
                    </div>
                    <div class="form-row @(chkDefaultPOIndex ? "task-fields-disabled" : "")">
                        <label>PO Index</label>
                        <TextBoxControl Value="@txtPOIndex" readonly Enabled="@(SelectedTask == 0 && !chkDefaultPOIndex)" CssClass="fx-mc-input" />
                        <ButtonControl BareStyle="true" CssClass="choose-btn" Disabled="@(SelectedTask != 0 || chkDefaultPOIndex)" OnClick="OnChoosePOIndex">...</ButtonControl>
                    </div>
            </div>

            @* Remove an item *@
            <div class="task-option">
                <RadioControl TValue="int" Name="taskOption" Value="1"
                              SelectedValue="SelectedTask" SelectedValueChanged="OnTaskRadioChanged"
                              Label="Remove an item" />
            </div>
            <div class="task-fields @(SelectedTask == 1 ? "" : "task-fields-disabled")">
                    <div class="form-row">
                        <label>Phase / Item</label>
                        <TextBoxControl Value="@txtPhaseItem1" readonly CssClass="fx-mc-input" />
                        <ButtonControl BareStyle="true" CssClass="choose-btn" Disabled="@(SelectedTask != 1)" OnClick="() => OnChooseItem(1)">...</ButtonControl>
                    </div>
            </div>

            @* Substitute one item for another *@
            <div class="task-option">
                <RadioControl TValue="int" Name="taskOption" Value="2"
                              SelectedValue="SelectedTask" SelectedValueChanged="OnTaskRadioChanged"
                              Label="Substitute one item for another" />
            </div>
            <div class="task-fields @(SelectedTask == 2 ? "" : "task-fields-disabled")">
                    <div class="form-row">
                        <label>Remove this</label>
                        <TextBoxControl Value="@txtPhaseItem2" readonly CssClass="fx-mc-input" />
                        <ButtonControl BareStyle="true" CssClass="choose-btn" Disabled="@(SelectedTask != 2)" OnClick="() => OnChooseItem(2)">...</ButtonControl>
                    </div>
                    <div class="form-row">
                        <label>Replace with</label>
                        <TextBoxControl Value="@txtPhaseItem3" readonly CssClass="fx-mc-input" />
                        <ButtonControl BareStyle="true" CssClass="choose-btn" Disabled="@(SelectedTask != 2)" OnClick="() => OnChooseItem(3)">...</ButtonControl>
                    </div>
            </div>

            @* Edit quantities *@
            <div class="task-option">
                <RadioControl TValue="int" Name="taskOption" Value="3"
                              SelectedValue="SelectedTask" SelectedValueChanged="OnTaskRadioChanged"
                              Label="Edit quantities" />
            </div>
            @* HHM-255: the "(Optional: filter to a specific item)" hint line does not
               exist in VB6 — removed. *@
            <div class="task-fields @(SelectedTask == 3 ? "" : "task-fields-disabled")">
                    <div class="form-row">
                        <label>Phase / Item</label>
                        <TextBoxControl Value="@txtPhaseItem4" readonly CssClass="fx-mc-input" />
                        <ButtonControl BareStyle="true" CssClass="choose-btn" Disabled="@(SelectedTask != 3)" OnClick="() => OnChooseItem(4)">...</ButtonControl>
                    </div>
            </div>
        }

        @* ── STEP 3: Edit Items (only for Edit Quantities task) ── *@
        else if (CurrentFrame == 3)
        {
            <div class="step-title">
                @* HHM-577: VB6 does NOT reuse the warning triangle here —
                   imgOK(4) on the edit-items frame is the notepad-with-pencil
                   edit icon (FMassChange.frx offset 0x09BB), extracted
                   byte-for-byte to /images/wizard/edit-quantities.ico. *@
                <img class="step-icon-img" src="/images/wizard/edit-quantities.ico" alt="" onerror="this.style.display='none'" />
                Edit item quantities
            </div>

            <div class="grid-container">
                @* Same ShowSelectionInfoBar suppression as the Step 1
                   Assemblies grid — the selection-info bar would shake
                   the wizard frame on every row tick.

                   NEW VB6 FMassChange.frm: gItems now has AllowSelection=True
                   plus gItems_AfterSelChange (keeps the selection to a single
                   column) and a gItems_AfterEdit that marks EVERY row in the
                   current vertical selection range DIRTY —
                     For r = Min(.Row,.RowSel) To Max(.Row,.RowSel):
                         gItems.RowData(r) = "DIRTY"
                   i.e. "edit one cell, apply the change down all the selected
                   rows." We mirror that with the FlexKit GridControl batch
                   single-cell mass-edit pattern used by FTakeoff / FAddPricelist:
                   SelectionMode.Cell + SelectionType.Multiple lets the user
                   shift/Ctrl-select a vertical run of Quantity cells, then type
                   a value + Enter to fan it down every selected row in one shot
                   via OnTypeAheadCommit. EditMode.Batch gives the inline cell
                   editor; BatchEditBehavior.SingleCell + AllowSingleCellColumnMassEdit
                   enable the per-column mass edit; OnCellSave marks the single
                   edited row dirty (the no-multiselect case). *@
                <GridControl @ref="ItemsGrid"
                        TValue="ItemDetailRow"
                        DataSource="@ItemsData"
                        AllowSorting="true"
                        AllowResizing="true"
                        AllowSelection="true"
                        ShowSelectionInfoBar="false"
                        AllowFiltering="true"
                        EnableHover="true"
                        Height="400px"
                        FilterSettingsRef="@filterSettings"
                        PageSettingsRef="@itemsPageSettings"
                        EditSettingsRef="@itemsEditSettings"
                        SelectionSettingsRef="@itemsSelectionSettings"
                        BatchEditBehavior="GridBatchEditBehavior.SingleCell"
                        AllowSingleCellColumnMassEdit="true"
                        TypeAheadTargetField="@nameof(ItemDetailRow.Quantity)"
                        EventsRef="@itemsGridEvents"
                        OnLayoutChanged="@OnItemsLayoutChangedAsync">
                    <GridColumnsBase @key="gItemsLayoutVersion">
                        @if (HasItemsGridLayout)
                        {
                            foreach (var entry in GetOrderedItemsGridLayout())
                            {
                                var layout = entry.Layout;
                                var fieldName = entry.Field;
                                var columnType = entry.ColumnType;
                                var textAlign = entry.TextAlign;
                                var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                                @* HHM-577 (corrected 2026-07-28): header is "OptionID" — the VB6
                                   gItems grid binds a recordset selecting m.OptionID UNALIASED
                                   (FMassChange.frm:1080) + IniGetGrid saved caption "OptionID".
                                   frm:923 "Option" is a search-field label, not the grid header.
                                   No normalization — the layout caption "OptionID" passes through. *@
                                var width = layout.Width.HasValue && layout.Width.Value > 0
                                    ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;
                                var allowEdit = fieldName == nameof(ItemDetailRow.Quantity);

                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              AllowEditing="@allowEdit"
                                              Format="@(columnType == ColumnType.Number ? "N2" : null)"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                        }
                        else
                        {
                            <GridColumn Field="@nameof(ItemDetailRow.Community)" HeaderText="@CommunityLabel" Width="100px" AllowEditing="false" />
                            <GridColumn Field="@nameof(ItemDetailRow.Model)" HeaderText="Model" Width="90px" AllowEditing="false" />
                            <GridColumn Field="@nameof(ItemDetailRow.OptionID)" HeaderText="OptionID" Width="90px" AllowEditing="false" />
                            <GridColumn Field="@nameof(ItemDetailRow.Assembly)" HeaderText="Assembly" Width="110px" AllowEditing="false" />
                            <GridColumn Field="@nameof(ItemDetailRow.AssemblyType)" HeaderText="Assembly Type" Width="130px" AllowEditing="false" />
                            <GridColumn Field="@nameof(ItemDetailRow.AssemblyDesc)" HeaderText="Assembly Desc" Width="150px" AllowEditing="false" />
                            <GridColumn Field="@nameof(ItemDetailRow.Style)" HeaderText="Style" Width="80px" AllowEditing="false" />
                            <GridColumn Field="@nameof(ItemDetailRow.Category)" HeaderText="Category" Width="80px" AllowEditing="false" />
                            <GridColumn Field="@nameof(ItemDetailRow.Active)" HeaderText="Active" Width="70px" AllowEditing="false" />
                            <GridColumn Field="@nameof(ItemDetailRow.Phase)" HeaderText="Phase" Width="80px" AllowEditing="false" />
                            <GridColumn Field="@nameof(ItemDetailRow.Item)" HeaderText="Item" Width="80px" AllowEditing="false" />
                            <GridColumn Field="@nameof(ItemDetailRow.ItemDesc)" HeaderText="Item Desc" Width="180px" AllowEditing="false" />
                            <GridColumn Field="@nameof(ItemDetailRow.Quantity)" HeaderText="Quantity" Width="100px"
                                          Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" AllowEditing="true" />
                            <GridColumn Field="@nameof(ItemDetailRow.UOM)" HeaderText="UOM" Width="70px" AllowEditing="false" />
                        }
                    </GridColumnsBase>
                </GridControl>
            </div>
        }
    </div>

    @* ── FOOTER ──────────────────────────────────────────── *@
    @* VB6 button order + access keys: &Cancel, < &Back, &Next >, Commi&t.
       accesskey gives Alt+C / Alt+B / Alt+N / Alt+T just like the VB6
       form's &-prefixed captions. Underline marks the accelerator
       letter (matches the VB6 cmdOK underline cue). *@
    <div class="wizard-footer">
        <button accesskey="C" @onclick="OnCancel"><u>C</u>ancel</button>
        <button accesskey="B" disabled="@(CurrentFrame <= 0)" @onclick="OnBack">&lt; <u>B</u>ack</button>
        <button accesskey="N" disabled="@(!CanGoNext)" @onclick="OnNext"><u>N</u>ext &gt;</button>
        <button class="btn-primary" accesskey="T" disabled="@(!CanCommit)" @onclick="OnCommit">Commi<u>t</u></button>
    </div>
</div>
</div> @* close .fx-masschange-modal / non-modal wrapper *@

@* HHM-252: Verify-step right-click Remove menu (VB6 gAssemblies
   BeforeMouseDown → PopupMenu(mnuPopup), FMassChange.frm:1211). Rendered
   OUTSIDE the modal wrapper on purpose: any ancestor with a CSS transform
   becomes the containing block for position:fixed, which displaced the menu
   from the cursor and let the modal's overflow:hidden clip it out of view.
   As a sibling of the modal it positions at the true viewport ClientX/Y and
   stacks above the wizard (menu z-index 10000 > modal 9000). *@
@if (_showAssembliesMenu && CurrentFrame == 1)
{
    <ContextMenuControl Visible="true" X="@_assembliesMenuX" Y="@_assembliesMenuY"
                        MinWidth="160" OnClose="@(() => _showAssembliesMenu = false)">
        <ContextMenuItemControl Text="Remove" OnClick="OnCtxRemoveAssemblies" />
    </ContextMenuControl>
}

@* ── Pick List Dialog ──────────────────────────────────────────
   Was a hand-rolled backdrop+panel modal; now a FlexKit DialogControl.
   @bind-Visible drives close on both the built-in × icon and overlay
   click (replaces the old @onclick="() => IsPickListVisible=false"
   on the backdrop + the manual × button). The selectable phase/item
   table stays raw markup — it is a load-bearing row-selection list,
   not a form control (FlexKit has no equivalent and FPickList isn't
   wired here). *@
@* HHM-254: child pick dialogs must stack ABOVE the wizard modal (z-index 9000);
   DialogControl's default overlay is z-index 1000, so it opened BEHIND. The
   scoped host div lets the .razor.css ::deep rule raise it to 9100. *@
<FPickList @ref="_pickList" OnSelected="OnPickListSelected" OnCancel="OnPickListCancelled" />

@code {
    // === Parameters ===
    /// <summary>When true, FMassChange renders inside a backdrop+frame
    /// so the host page (e.g. FAssembly) stays visible behind it. VB6
    /// FMassChange was modal-blocking; this preserves that UX without
    /// stealing a tab. Standalone /mass-change-wizard route navigation
    /// leaves IsModal=false → full-page layout.</summary>
    [Parameter] public bool IsModal { get; set; }

    /// <summary>Fires when the wizard should be dismissed (Cancel, the
    /// modal × header, or a successful Commit). Only used when
    /// <see cref="IsModal"/> is true — host flips its visibility flag.
    /// Standalone mode falls back to NavigationManager.NavigateTo of the
    /// assembly editor.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    // === Database ===
private string LoginID = "admin";

    // === UI State ===
    private bool IsLoading = false;
    private int CurrentFrame = 0;
    private string CommunityLabel = "Community";

    // === Step 0: Filter Fields ===
    private string txtCommunity = "";
    private string txtModel = "";
    private string txtOption = "";
    private string txtAssembly = "";
    private string txtDescription = "";
    private string txtStyle = "";
    private string txtSeries = "";
    private string txtCategory = "";
    private string cboAssemblyType = "";
    private bool chkActiveOnly = true;

    // Assembly Type dropdown options — was a static <select><option> list;
    // DropDownListControl binds from a DataSource (it has no <option>
    // ChildContent mode), so the same five choices live here. Value ""
    // = "(All)" (no AssemblyTypeDesc filter), matching the old first option.
    private static readonly List<ComboBoxItem> AssemblyTypeItems = new()
    {
        new ComboBoxItem { Text = "(All)", Value = "" },
        new ComboBoxItem { Text = "Model", Value = "Model" },
