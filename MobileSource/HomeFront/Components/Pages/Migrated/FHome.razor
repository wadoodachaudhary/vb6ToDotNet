@page "/home"
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using HomeFront.Components.Layout
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<FHome> Logger
@inject NotificationService Notifications

<PageTitle>Home - HomeFront</PageTitle>

<div class="home-container">

    @* ── Regions (background panels) ──────────────────────────────── *@
    <div class="region region-0"></div>
    <div class="region region-1"></div>
    <div class="region region-2"></div>

    @* ── Region Labels ────────────────────────────────────────────── *@
    <div class="region-label" style="left: 0.1%; top: 1%;">Job</div>
    <div class="region-label" style="left: 0.1%; top: 51%;">Job</div>

    @* ── SVG Flow Lines ───────────────────────────────────────────── *@
    <svg class="flow-lines">
        @foreach (var flow in FlowLines.Where(f => f.Visible))
        {
            <line x1="@Pct(flow.X1, DesignWidth)" y1="@Pct(flow.Y1, DesignHeight)"
                  x2="@Pct(flow.X2, DesignWidth)" y2="@Pct(flow.Y2, DesignHeight)" />
        }
    </svg>

    @* ── Task Icons ───────────────────────────────────────────────── *@
    @foreach (var task in Tasks)
    {
        var cssClass = "task-icon"
            + (task.Visible ? "" : " hidden")
            + (task.Enabled ? "" : " disabled")
            + (task.IsUnavailable ? " unavailable" : "");

        <div class="@cssClass"
             style="left: @Pct(task.CenterX, DesignWidth); top: @Pct(task.CenterY, DesignHeight); transform: translate(-50%, -50%);"
             title="@(task.ToolTipText ?? task.Tag)"
             @onclick="() => OnTaskClick(task)">
            <img src="@task.ImageUrl" alt="@task.Tag" onerror="this.style.display='none'" />
            <span>@task.Tag</span>
        </div>
    }
</div>

@code {
    // ── Design-time dimensions (from VB6 ScaleWidth/ScaleHeight in twips) ──
    private const double DesignWidth = 15180.0;
    private const double DesignHeight = 10590.0;

    // ── Application State (simulated HFApp) ──
    private SalesSystems SalesSystem = SalesSystems.asNone;
    private AccountingSystems AccountingSystem = AccountingSystems.asNone;

    public enum SalesSystems { asNone = 0, asBuilder1440 = 1, asHomeFront = 2 }
    public enum AccountingSystems { asNone = 0, asTimberline = 1, asJDEdwards = 2 }

    // ── Task and Flow models ──
    private List<TaskItem> Tasks = new();
    private List<FlowLine> FlowLines = new();

    // ── Permissions (simulated) ──
    private Dictionary<string, bool> Permissions = new()
    {
        { "SetupJobs", true },
        { "EditAssemblies", true },
        { "EditItemDb", true },
        { "SetupVendorPricing", true },
        { "SetupPOIndex", true },
        { "OpenEstimatingWorkSheets", true },
        { "SetupVendors", true },
        { "SetupDefaultVendor", true },
        { "SendPO", true },
        { "PostCommitments", true },
        { "PostBudgets", true },
        { "SetupCommunity", true },
        { "Setupseries", true },
        { "SetupMajorGroup", true },
        { "SetupCategory", true },
        { "TaskEntQuote", true }
    };

    protected override void OnInitialized()
    {
        InitializeTasks();
        InitializeFlowLines();
        ConfigForm();
    }

