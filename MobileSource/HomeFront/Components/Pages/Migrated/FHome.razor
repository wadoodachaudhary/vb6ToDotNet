            new(29, 9870,  1740, 885,  915,  "",                               "images/home/task_29_grey.png", visible: false, toolTip: "no accounting system is configured", unavailable: true),
            new(30, 3795,  3420, 660,  720,  "Field PO's",                     "images/home/task_30.png"),
            new(31, 1020,  3750, 690,  960,  "Custom Requests",                "images/home/task_31.png"),
        };
    }

    private void InitializeFlowLines()
    {
        FlowLines = new List<FlowLine>
        {
            new(0,  2100, 8640, 3510, 7800),
            new(1,  6540, 2910, 7920, 3690),
            new(2,  4200, 7650, 5490, 6750),
            new(3,  6300, 6720, 7710, 6720),
            new(4,  4200, 7800, 5490, 8640),
            new(5,  6270, 8670, 7650, 8670),
            new(6,  2400, 2820, 3720, 2100),
            new(7,  6510, 1110, 7770, 690),
            new(8,  6540, 2760, 9870, 2040),
            new(9,  4470, 2100, 5790, 2670),
            new(10, 4500, 1890, 5670, 1260),
            new(11, 2340, 1230, 3750, 1860),
            new(12, 2130, 6840, 3510, 7620),
            new(13, 8520, 6720, 9660, 6720),
            new(14, 9570, 8670, 8430, 8670),
            new(15, 2310, 1110, 3720, 600, visible: false),
            new(16, 4080, 2580, 4080, 3330),
