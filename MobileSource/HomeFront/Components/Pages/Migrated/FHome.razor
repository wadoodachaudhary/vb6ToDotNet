            new(21, 13860, 5760, 915,  975,  "option categories",              "images/home/task_21.png"),
            new(22, 13770, 2340, 795,  945,  "community phases setup",         "images/home/task_22.png"),
            new(23, 1650,  795,  630,  915,  "Prepare Job Quote",              "images/home/task_23.png"),
            new(24, 9375,  8355, 1260, 1080, "WriteToWeb",                     "images/home/task_24.png"),
            new(25, 3705,  330,  840,  855,  "Send RFQ's",                     "images/home/task_25.png", visible: false),
            new(26, 12067, 7380, 930,  915,  "Library Mass Change",            "images/home/task_26.png", visible: false),
            new(27, 1440,  2550, 1320, 915,  "",                               "images/home/task_27_grey.png", visible: false, toolTip: "no sales system is configured", unavailable: true),
