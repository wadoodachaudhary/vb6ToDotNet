    }

    private void ConfigForm()
    {
        // Sales system visibility
        bool hasSales = SalesSystem != SalesSystems.asNone;
        SetTaskVisible(1, hasSales);
        SetTaskVisible(27, !hasSales);

        bool isBuilder1440 = SalesSystem == SalesSystems.asBuilder1440;
        SetTaskVisible(24, isBuilder1440);
        SetFlowVisible(14, isBuilder1440);

        // Accounting system visibility
        bool hasAccounting = AccountingSystem != AccountingSystems.asNone;
        SetTaskVisible(4, hasAccounting);
        SetTaskVisible(28, !hasAccounting);
        SetTaskVisible(6, hasAccounting);
        SetTaskVisible(29, !hasAccounting);

        // Permissions
        SetTaskEnabled(2, GetPermission("SetupJobs"));
        SetTaskEnabled(12, GetPermission("EditAssemblies"));
        SetTaskEnabled(11, GetPermission("EditItemDb"));
        SetTaskEnabled(9, GetPermission("SetupVendorPricing"));
        SetTaskEnabled(10, GetPermission("SetupPOIndex"));
        SetTaskEnabled(14, GetPermission("OpenEstimatingWorkSheets"));
        SetTaskEnabled(8, GetPermission("SetupVendors"));
        SetTaskEnabled(18, GetPermission("SetupDefaultVendor"));
        SetTaskEnabled(7, GetPermission("SendPO"));
        SetTaskEnabled(6, GetPermission("PostCommitments"));
        SetTaskEnabled(4, GetPermission("PostBudgets"));
        SetTaskEnabled(17, GetPermission("SetupCommunity"));
        SetTaskEnabled(22, GetPermission("SetupCommunity"));
        SetTaskEnabled(19, GetPermission("Setupseries"));
        SetTaskEnabled(20, GetPermission("SetupMajorGroup"));
        SetTaskEnabled(21, GetPermission("SetupCategory"));
        SetTaskEnabled(31, GetPermission("TaskEntQuote"));

        if (GetPermission("EditAssemblies"))
            SetTaskVisible(26, true);
        SetTaskEnabled(26, GetPermission("EditAssemblies"));
    }

    // ── Helpers ──────────────────────────────────────────────────────────

    private bool GetPermission(string key) =>
        Permissions.TryGetValue(key, out var val) && val;

    private void SetTaskVisible(int index, bool visible)
    {
        var task = Tasks.FirstOrDefault(t => t.Index == index);
        if (task != null) task.Visible = visible;
    }

    private void SetTaskEnabled(int index, bool enabled)
    {
        var task = Tasks.FirstOrDefault(t => t.Index == index);
        if (task != null) task.Enabled = enabled;
    }

    private void SetFlowVisible(int index, bool visible)
    {
        var flow = FlowLines.FirstOrDefault(f => f.Index == index);
        if (flow != null) flow.Visible = visible;
    }

    /// <summary>Convert twips coordinate to CSS percentage string.</summary>
    private string Pct(double twips, double designDimension) =>
        $"{(twips / designDimension * 100.0):F2}%";

    // ── Task Click Handler ───────────────────────────────────────────────

    private async Task OnTaskClick(TaskItem task)
    {
        if (!task.Enabled || string.IsNullOrEmpty(task.Tag) || task.IsUnavailable)
            return;

        // Map VB6 task tags to Blazor routes
        var route = task.Tag switch
        {
            "Job setup" => "/job-setup",
            "Retrieve Jobs from Sales Center" => "/retrieve-jobs",
            "Prepare Job Quote" => "/prepare-job-quote",
            "issue budgets" => "/issue-budgets",
            "post budgets" => "/post-budgets",
            "issue po's" => "/issue-pos",
            "post purchase orders" => "/post-purchase-orders",
            "send purchase orders" => "/send-purchase-orders",
            "vendor setup" => "/vendor-setup",
            "edit item prices" => "/vendor-pricelist",
            "purchase orders" => "/purchase-orders",
            "edit item database" => "/items-db",
            "edit models and options" => "/edit-model-assembly",
            "community standards" => "/community-standards",
            "open an estimating worksheet" => "/pricing-worksheet-opus",
            "default vendors" => "/default-vendors",
            "community setup" => "/community-setup",
            "community phases setup" => "/community-phases-setup",
            "job cost codes" => "/job-cost-codes",
            "job cost categories" => "/job-cost-categories",
            "series" => "/series-setup",
            "option groups" => "/option-groups",
            "option categories" => "/option-categories",
            "project managers" => "/project-managers",
            "Library Mass Change" => "/library-mass-change",
            "WriteToWeb" => "/write-to-web",
            "Send RFQ's" => "/send-rfqs",
            "Field PO's" => "/field-pos",
            "Custom Requests" => "/custom-requests",
            _ => null
        };

        if (!string.IsNullOrEmpty(route))
        {
            NavigationManager.NavigateTo(route);
        }
        else
        {
            Notifications.Info($"Task '{task.Tag}' is not yet implemented.");
        }
    }

    // ── Models ───────────────────────────────────────────────────────────

    public class TaskItem
    {
        public int Index { get; set; }
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
        public string Tag { get; set; } = "";
        public string ImageUrl { get; set; } = "";
        public bool Visible { get; set; } = true;
        public bool Enabled { get; set; } = true;
        public string? ToolTipText { get; set; }
        public bool IsUnavailable { get; set; }

        /// <summary>Center X in design twips.</summary>
        public double CenterX => Left + Width / 2.0;
        /// <summary>Center Y in design twips.</summary>
        public double CenterY => Top + Height / 2.0;

        public TaskItem() { }

        public TaskItem(int index, double left, double top, double width, double height,
            string tag, string imageUrl, bool visible = true, string? toolTip = null, bool unavailable = false)
        {
            Index = index;
            Left = left;
            Top = top;
            Width = width;
            Height = height;
            Tag = tag;
            ImageUrl = imageUrl;
            Visible = visible;
            ToolTipText = toolTip;
            IsUnavailable = unavailable;
        }
    }

    public class FlowLine
    {
        public int Index { get; set; }
        public double X1 { get; set; }
        public double Y1 { get; set; }
        public double X2 { get; set; }
        public double Y2 { get; set; }
        public bool Visible { get; set; } = true;

        public FlowLine() { }

        public FlowLine(int index, double x1, double y1, double x2, double y2, bool visible = true)
        {
            Index = index;
            X1 = x1;
            Y1 = y1;
            X2 = x2;
            Y2 = y2;
            Visible = visible;
        }
    }
}
