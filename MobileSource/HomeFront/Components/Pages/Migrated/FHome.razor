            new(1,  1440,  2550, 1320, 915,  "Retrieve Jobs from Sales Center","images/home/task_01.png"),
            new(2,  3780,  1770, 690,  675,  "Job setup",                      "images/home/task_02.png"),
            new(3,  5775,  870,  915,  765,  "issue budgets",                  "images/home/task_03.png"),
            new(4,  7815,  300,  885,  915,  "post budgets",                   "images/home/task_04.png"),
            new(5,  5700,  2550, 1065, 1005, "issue po's",                     "images/home/task_05.png"),
            new(6,  9840,  1740, 885,  915,  "post purchase orders",           "images/home/task_06.png"),
            new(7,  7950,  3420, 795,  855,  "send purchase orders",           "images/home/task_07.png"),
            new(8,  7755,  6480, 705,  870,  "vendor setup",                   "images/home/task_08.png"),
            new(9,  5520,  6480, 690,  930,  "edit item prices",               "images/home/task_09.png"),
            new(10, 1425,  8400, 645,  870,  "purchase orders",                "images/home/task_10.png"),
            new(11, 3540,  7440, 630,  765,  "edit item database",             "images/home/task_11.png"),
            new(12, 5295,  8400, 1155, 990,  "edit models and options",        "images/home/task_12.png"),
            new(13, 1230,  6480, 1020, 1035, "community standards",            "images/home/task_13.png"),
            new(14, 7575,  8385, 1050, 1035, "open an estimating worksheet",   "images/home/task_14.png"),
            new(15, 13830, 4020, 810,  960,  "project managers",               "images/home/task_15.png"),
            new(16, 12240, 600,  690,  990,  "job cost codes",                 "images/home/task_16.png"),
            new(17, 12120, 2340, 945,  720,  "community setup",                "images/home/task_17.png"),
            new(18, 9630,  6480, 765,  960,  "default vendors",                "images/home/task_18.png"),
            new(19, 12045, 4020, 960,  750,  "series",                         "images/home/task_19.png"),
