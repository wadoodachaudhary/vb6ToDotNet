@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - Initial port from VB6 (FDefaultVendors.frm)
     - 2026-06-11: Dynamic grid columns from AppGridLayout overlay
       (VB6 IniGetGrid), FPickList vendor picker (VB6
       gData_CellButtonClick → FPickList.Choose), TextBoxControl
       search box, fully parameterized SQL.
     - 2026-07-09: HHM-326 / HHM-327 — removed the invented toolbar
       (disabled Save icon + inline Find box): VB6 FDefaultVendors.frm
       declares NO toolbar, the form is just gData. Ctrl+F now opens a
       faithful modal port of FFind.frm (current-column FindNextSimple,
       Up/Down direction, Match case); save stays on Ctrl+S
       (gData_KeyDown) and the close-prompt path (SaveData(True)).
     - 2026-07-28: HHM-598 — EnableHeaderContextMenu=false (VB6 frm has no
       column-header menu). HHM-606 — mouse-drag range selection over the
       vendor cells (VB6 AllowBigSelection) + Enter/F4 opens the picker on
       the active cell with the pick fanning out across the selection (VB6
       F4 → gData_CellButtonClick, Cell(...,r1,c1,r2,c2)); cell mousedown
       now focuses the page container so Delete/Ctrl+Delete & co. always
       reach OnPageKeyDown.
   ───────────────────────────────────────────────────────────────── *@
@page "/default-vendor"

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Dynamic
@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data
@using HomeFront.Models
@using HomeFront.Services
@layout HFComponent
@inject IJSRuntime JSRuntime
@inject ILogger<FDefaultVendors> Logger
@inject DbWrapperSqlServer DbHelper
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@implements IDisposable

<PageTitle>@(_gridLayoutFallbackUsed ? "Default Vendors [gData FALLBACK]" : "Default Vendors")</PageTitle>


<div class="default-vendors-page" tabindex="0" @ref="_pageElement"
     @onkeydown="OnPageKeyDown" @onmouseup="EndCellDrag">
    @* NO toolbar — VB6 FDefaultVendors.frm declares only the VSFlexGrid gData
       (frm 3-14; no MSComctlLib.Toolbar, unlike FCommunities/FDBGrid). Save is
       Ctrl+S (gData_KeyDown, frm 396-397) or the close prompt (Form_QueryUnload
       → SaveData(True), frm 145-147); Find is Ctrl+F → the modal FFind dialog
       below (frm 399-400). HHM-326 / HHM-327. *@
    <div class="default-vendors-container">
        @if (_isLoading)
        {
            <div class="loading-spinner">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            @* HHM-598: EnableHeaderContextMenu=false — VB6 FDefaultVendors.frm has NO
               column-header menu (the frm declares no MouseDown/menu handler at all;
               right-clicking a header does nothing in legacy). Same page-side switch
               FJob / FPickList use. *@
            <GridControl @ref="_grid"
                    TValue="ExpandoObject"
                    DataSource="@_gridData"
                    AllowSelection="true"
                    AllowResizing="true"
                    AllowSorting="true"
                    EnableHeaderContextMenu="false"
                    OnLayoutChanged="@OnGridLayoutChangedAsync"
                    SelectionSettingsRef="@_selection"
                    EventsRef="@_gridEvents"
                    RowCssClassSelector="@GetRowCssClass"
                    Height="100%"
                    Width="100%">
                <GridColumnsBase @key="_gridLayoutVersion" DebugTag="FDefaultVendors-gData">
                    @* VB6 col 0 = PO Index (frozen, OutlineBar, not editable). *@
                    <GridColumn Field="POIndexDisplay"
                                  HeaderText="@_poIndexCaption"
                                  IsPrimaryKey="true"
                                  AllowEditing="false"
                                  Width="@_poIndexWidth">
                        <Template Context="dvPoi">
                            @{
                                var dvPoiData = dvPoi as IDictionary<string, object>;
                                <div class="poindex-cell" style="display: flex; align-items: center; gap: 4px;">
                                    <img src="images/16/Assembly2.ico" style="width: 16px; height: 16px; flex-shrink: 0;" alt="" onerror="this.style.display='none'" />
                                    <span class="poindex-text" title="@dvPoiData?["POIndexDisplay"]">@dvPoiData?["POIndexDisplay"]</span>
                                </div>
                            }
                        </Template>
                    </GridColumn>
                    @* VB6 col 1 = "Global Default" (empty area key → Area_GBL). *@
                    <GridColumn Field="Area_GBL"
                                  HeaderText="@_globalCaption"
                                  Width="@_globalWidth"
                                  AllowEditing="false"
                                  ShowEditButton="true">
                        <Template Context="dvGbl">
                            @{
                                var dvGblData = dvGbl as IDictionary<string, object>;
                                var dvGblCell = dvGblData?.ContainsKey("Area_GBL") == true ? dvGblData["Area_GBL"] as VendorCell : null;
                                <div class="poindex-cell @(dvGblCell?.IsDirty == true ? "dirty-cell" : "") @(IsCellSelected(dvGblData, GlobalKey) ? "dv-cell-selected" : "")"
                                     @onclick="(e) => OnCellClick(e, (IDictionary<string, object>)dvGbl, GlobalKey)"
                                     @onmousedown="(e) => OnCellMouseDown(e, (IDictionary<string, object>)dvGbl, GlobalKey)"
                                     @onmouseenter="(e) => OnCellMouseEnter(e, (IDictionary<string, object>)dvGbl, GlobalKey)"
                                     @ondblclick="() => OnPickVendor((IDictionary<string, object>)dvGbl, string.Empty, GlobalKey)"
                                     @ondblclick:stopPropagation="true">
                                    <span class="poindex-text" title="@(dvGblCell?.VendorName ?? "")">@(dvGblCell?.VendorName ?? "")</span>
                                    <button class="poindex-btn fx-grid-popup-btn"
                                            @onclick="() => OnPickVendor((IDictionary<string, object>)dvGbl, string.Empty, GlobalKey)"
                                            @onclick:stopPropagation="true">…</button>
                                </div>
                            }
                        </Template>
                    </GridColumn>
                    @* VB6 cols 2..n = one column per active community/area
                       (tblLocality, VB6 lines 195-210). Width / order / visibility
                       overlaid from AppGridLayout (VB6 line 236 IniGetGrid). *@
                    @foreach (var area in GetOrderedAreas())
                    {
                        var areaCode = area.AreaCode;
                        var areaDesc = area.Description;
                        var areaWidth = area.WidthPx;
                        <GridColumn Field="@($"Area_{areaCode}")"
                                      HeaderText="@areaDesc"
                                      Width="@areaWidth"
                                      AllowEditing="false"
                                      ShowEditButton="true">
                            <Template Context="dvArea">
                                @{
                                    var dvAreaData = dvArea as IDictionary<string, object>;
                                    var dvAreaKey = $"Area_{areaCode}";
                                    var dvAreaCell = dvAreaData?.ContainsKey(dvAreaKey) == true ? dvAreaData[dvAreaKey] as VendorCell : null;
                                    <div class="poindex-cell @(dvAreaCell?.IsDirty == true ? "dirty-cell" : "") @(IsCellSelected(dvAreaData, dvAreaKey) ? "dv-cell-selected" : "")"
                                         @onclick="(e) => OnCellClick(e, (IDictionary<string, object>)dvArea, dvAreaKey)"
                                         @onmousedown="(e) => OnCellMouseDown(e, (IDictionary<string, object>)dvArea, dvAreaKey)"
                                         @onmouseenter="(e) => OnCellMouseEnter(e, (IDictionary<string, object>)dvArea, dvAreaKey)"
                                         @ondblclick="() => OnPickVendor((IDictionary<string, object>)dvArea, areaCode, dvAreaKey)"
                                         @ondblclick:stopPropagation="true">
                                        <span class="poindex-text" title="@(dvAreaCell?.VendorName ?? "")">@(dvAreaCell?.VendorName ?? "")</span>
                                        <button class="poindex-btn fx-grid-popup-btn"
                                                @onclick="() => OnPickVendor((IDictionary<string, object>)dvArea, areaCode, dvAreaKey)"
                                                @onclick:stopPropagation="true">…</button>
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                    }
                </GridColumnsBase>
            </GridControl>
        }
    </div>
</div>

@* HHM-343: save prompt is the standard FlexKit MessageBox, titled with VB6 Me.Caption. *@
<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />

@* Error Dialog (VB6 MsgBox "unknown vendor") *@
<DialogControl @bind-Visible="@_showErrorDialog"
          Width="300px"
          Header="Error"
          IsModal="true"
          ShowCloseIcon="true">
    <ChildContent>
        <p>@_errorMessage</p>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="@(() => _showErrorDialog = false)">OK</ButtonControl>
    </FooterContent>
</DialogControl>

@* Find Dialog (VB6 Ctrl+F → FFind.ShowForm(gData), FDefaultVendors.frm 399-400:
   the MODAL FFind dialog, FFind.frm). Faithful port: "Find what:" text box
   (txtFind), Match whole word (permanently disabled, FFind.frm 44) + Match case
   checkboxes (FFind.frm 42-57), Up/Down Direction frame with Down as the default
   (optUp/optDown, FFind.frm 24-40), Find Next (Default, enabled only while the
   text is non-blank — txtFind_Change, FFind.frm 159-161) / Cancel (Cancel=True →
   Esc) buttons (FFind.frm 68-88). VB6 persists the inputs via AppIni (FFind.frm
   141-157) — no form-ini infrastructure here, so they persist for the page's
   lifetime only. *@
<DialogControl @bind-Visible="@_showFindDialog"
          Width="420px"
          Header="Find"
          IsModal="true"
          ShowCloseIcon="true"
          CloseOnEscape="true">
    <ChildContent>
        <div class="dv-find-row">
            <label class="dv-find-label">Find what:</label>
            @* AutoFocus forces TextBoxControl's native-input branch so
               UpdateOnInput commits _findWhat per keystroke (live Find Next
               enablement = VB6 txtFind_Change) and the typed value renders
               correctly. SelectOnFocus = VB6 txtFind_GotFocus → SelectAll
               (FFind.frm 271-273). Enter = Find Next (cmdNav(0) Default,
               FFind.frm 80) via the splatted @onkeydown — TextBoxControl
               tolerates unmatched attributes (CaptureUnmatchedValues). *@
            <TextBoxControl @bind-Value="_findWhat"
                            CssClass="dv-find-input"
                            UpdateOnInput="true"
                            AutoFocus="true"
                            SelectOnFocus="true"
                            @onkeydown="OnFindWhatKeyDown" />
        </div>
        <div class="dv-find-options">
            <div class="dv-find-checks">
                @* VB6 chkMatchWholeWord ships permanently disabled (FFind.frm 44). *@
                <CheckBoxControl Label="Match whole word only" Disabled="true" />
                <CheckBoxControl Label="Match case" @bind-Checked="_findMatchCase" />
            </div>
            <fieldset class="dv-find-direction">
                <legend>Direction</legend>
                <RadioControl TValue="string" Name="dv-find-direction" Value="@("up")"
                              Label="Up" @bind-SelectedValue="_findDirection" />
                <RadioControl TValue="string" Name="dv-find-direction" Value="@("down")"
                              Label="Down" @bind-SelectedValue="_findDirection" />
            </fieldset>
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn" Disabled="@(!CanFindNext)"
                       OnClick="@(() => FindNext())">Find Next</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="@(() => _showFindDialog = false)">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@* VB6 gData_CellButtonClick → FPickList.Choose(... "Vendor" ...) *@
<FPickList @ref="_pickList" OnSelected="OnVendorPickListSelected" />

@code {
    private GridControl<ExpandoObject>? _grid;
    private FPickList? _pickList;
    private List<ExpandoObject> _gridData = new();
    private List<AreaInfo> _areas = new();
    private GridControlEvents<ExpandoObject> _gridEvents = new();
    private bool _isDirty = false;
    private bool _isLoading = true;
    private bool _isSavePromptOpen = false;
    private bool _showErrorDialog = false;
    private bool _gridLayoutFallbackUsed = false;
    private string _errorMessage = string.Empty;
    private int _divisionId;
    private int _gridLayoutVersion;
    private Fx.ControlKit.Dialogs.MessageBoxControl? _messageBox;

    // ── Primary AppGridLayout overlay load via the shared GridLayoutPresenter ────
    // ONLY the primary overlay load (VB6 line 236 IniGetGrid → the standard
    // GetGridLayoutAsync("FDefaultVendors","gData",0,grouped:true) call) is routed
    // through the presenter — TRow is ExpandoObject, so its reflection helpers
    // (ResolveField / ColumnTypeFor / GetOrdered / Choose-Columns) are NOT used here
    // (an ExpandoObject has no static properties to reflect over). We use the
    // presenter purely as the "load the layout + expose Layout + track FallbackUsed"
    // wrapper, reproducing the EXACT same gridTag the inline call produced
    // (gridIndex 0 → "FDefaultVendors.gData", no instanceKey, staticNames default
    // false so captions stay populated). The tblLocality column derivation, the
    // overlay-onto-AreaInfo loop, and the raw second read (ApplyFixedColumnLayout
    // for the empty-colkey fixed columns) stay form-specific and read from
    // _gridLayout.Layout — the presenter does not model any of those.
    private readonly GridLayoutPresenter<ExpandoObject> _gridLayout =
        new("FDefaultVendors", "gData", gridIndex: 0, grouped: true);

    // ── Find (VB6 Ctrl+F → FFind.ShowForm(gData), FDefaultVendors.frm 399-400:
    //    the MODAL FFind dialog, FFind.frm). It LOCATES the next match in the
    //    grid's CURRENT COLUMN (FindNextSimple, .TextMatrix(r, .Col)), scrolls
    //    it on screen and highlights it — it does NOT filter. _findWhat /
    //    _findMatchCase / _findDirection mirror txtFind / chkMatchCase /
    //    optUp+optDown (Down is the VB6 default, FFind.frm 30). _findMatchKey is
    //    the POIndex of the row the last find landed on: it drives the
    //    .find-match highlight via RowCssClassSelector. _scrollToFindMatch asks
    //    OnAfterRenderAsync to scroll it on screen (VB6 .ShowCell) once the
    //    .find-match row exists in the DOM. ─────────────────────────────────────
    private bool _showFindDialog;
    private string _findWhat = string.Empty;
    private bool _findMatchCase;
    private string _findDirection = "down";   // VB6 optDown.Value = True (FFind.frm 30)
    private string? _findMatchKey;
    private bool _scrollToFindMatch;
    private int _openFocusAttempts;

    // ── Cell selection (VB6 SelectionMode = 0 / cell-oriented). SelectionMode.Cell
    //    gives the grid's own single-cell visual highlight; the copy/paste range
    //    below is tracked separately so a rectangular block can be tiled. ──────────
    private SelectionSettings _selection = new() { Mode = SelectionMode.Cell, Type = SelectionType.Single };

    // ── Copy / paste cell-tiling (VB6 gData_KeyDown Ctrl+C / Ctrl+V,
    //    FDefaultVendors.frm 369-458). VB6's copy/paste is PURELY INTERNAL: it reads
    //    the source block's cell .Text/.Data straight out of the grid and writes them
    //    across the destination block — it never touches the Windows clipboard
    //    (no DataObject / Clipboard.SetText). So an in-memory buffer is the faithful
    //    port and NO JavaScript is needed.
    //
    //    _curCell = the active cell (VB6 .Row/.Col). _selRange = the current
    //    rectangular selection (VB6 GetSelection r1,c1,r2,c2) built by Shift+click;
    //    a plain click collapses it to one cell. _clip = the copied source block
    //    (VB6 Static ClipRow1..ClipCols), a row-major grid of VendorCell snapshots. ──
    private (IDictionary<string, object> Row, string Key)? _curCell;
    private readonly List<(int RowIdx, int ColIdx)> _selRange = new();
    private VendorCell[,]? _clip;

    // ── HHM-606: mouse-drag range selection (VB6 AllowBigSelection drag) +
    //    keyboard focus guarantee. _pageElement is the page container that owns
    //    OnPageKeyDown; OnCellMouseDown focuses it explicitly so Delete /
    //    Ctrl+Delete / Ctrl+C/V/S/F / Enter always land on the handler no matter
    //    where focus was before the click. _dragAnchor is the mousedown cell
    //    (VB6 .Row/.Col while the mouse extends the block); mouseenter over
    //    other cells while the left button is held builds the rectangle exactly
    //    like Shift+click does (BuildRange), and mouseup ends the drag. Same
    //    mousedown/mouseenter/mouseup pattern as GridControl's own row
    //    drag-selection — pure Blazor, no JS. ────────────────────────────────
    private ElementReference _pageElement;
    private (int RowIdx, int ColIdx)? _dragAnchor;
    private bool _isCellDragging;

    // ── PO Index + Global Default column captions/widths (from layout overlay) ──
    private string _poIndexCaption = "PO Index";
    private string _poIndexWidth = "200px";
    private string _globalCaption = "Global Default";
    private string _globalWidth = "200px";

    // ── In-flight pick context (VB6 GetSelection / current cell) ────────
    private IDictionary<string, object>? _pickRow;
    private string _pickAreaCode = "";   // tblLocality area code ("" = Global)
    private string _pickKey = "";         // grid dictionary key ("Area_GBL" / "Area_<code>")

    protected override async Task OnInitializedAsync()
    {
        _gridEvents.OnEditButtonClick = new EventCallback<CellEditButtonArgs<ExpandoObject>>(this, (Func<CellEditButtonArgs<ExpandoObject>, Task>)OnGridEditButtonClick);
        _divisionId = SessionState.DivisionID;
        await CleanupOrphanRecords();
        await LoadData();
        _isLoading = false;
    }

    public void Dispose()
    {
    }

    /// <summary>
    /// VB6 LoadData lines 162-165: this screen is very sensitive to orphan
    /// records, so delete them first. Three deletes purge POAreaVendor rows
    /// whose POIndex / Area / Vendor no longer exist for this division.
    /// </summary>
    private async Task CleanupOrphanRecords()
    {
        try
        {
            // VB6 line 162 — orphaned PO indexes.
            await DbHelper.ExecuteAsync(@"
                DELETE FROM POAreaVendor
                WHERE DivisionID = @DivisionID
                AND POIndex IN (
                    SELECT a.POIndex FROM POAreaVendor a
                    LEFT OUTER JOIN tblPOIndex b ON a.POIndex = b.POIndex AND a.DivisionID = b.DivisionID
                    WHERE b.POIndex IS NULL AND a.DivisionID = @DivisionID
                )", new { DivisionID = _divisionId });

            // VB6 line 163 — orphaned (non-empty) areas.
            await DbHelper.ExecuteAsync(@"
                DELETE FROM POAreaVendor
                WHERE DivisionID = @DivisionID
                AND ISNULL(Area, '') <> ''
                AND Area IN (
                    SELECT a.Area FROM POAreaVendor a
                    LEFT OUTER JOIN tblLocality b ON a.Area = b.Area
                    WHERE b.Area IS NULL AND a.DivisionID = @DivisionID
                )", new { DivisionID = _divisionId });

            // VB6 line 165 — orphaned vendors.
            await DbHelper.ExecuteAsync(@"
                DELETE FROM POAreaVendor
                WHERE DivisionID = @DivisionID
                AND Vendor IN (
                    SELECT a.Vendor FROM POAreaVendor a
                    LEFT OUTER JOIN tblVendors b ON a.Vendor = b.Vendor_ID AND a.DivisionID = b.DivisionID
                    WHERE b.Vendor_ID IS NULL AND a.DivisionID = @DivisionID
                )", new { DivisionID = _divisionId });
        }
        catch (Exception ex)
        {
            // VB6 wraps these in On Error Resume Next — non-critical.
            Logger.LogWarning(ex, "FDefaultVendors orphan cleanup failed (non-critical)");
        }
    }

    private async Task LoadData()
    {
        // VB6 line 178 — load PO indexes (rows).
        var poIndexRows = await DbHelper.QueryAsync(@"
            SELECT POIndex, Description
            FROM tblPOIndex
            WHERE DivisionID = @DivisionID
            ORDER BY POIndex", new { DivisionID = _divisionId });

        // VB6 lines 195-200 — load communities/areas (columns). The set of
        // area columns is data-driven from tblLocality, exactly like VB6.
        var areaRows = await DbHelper.QueryAsync(@"
            SELECT l.Area AS AreaCode, l.Description
            FROM tblLocality l
            JOIN DivisionCommunities d ON d.Community = l.Area
            WHERE l.Area <> 'N/A'
            AND l.Inactive = 0
            AND ISNULL(l.Area, '') <> ''
            AND d.DivisionID = @DivisionID
            ORDER BY l.Description", new { DivisionID = _divisionId });

        _areas = areaRows.Select(a => new AreaInfo
        {
            AreaCode = a["AreaCode"]?.ToString() ?? "",
            Description = a["Description"]?.ToString() ?? ""
        }).ToList();

        // VB6 line 236: IniGetGrid(Me, gData, , , , True, True) — overlay the
        // persisted AppGridLayout (column widths / order / visibility) on top
        // of the data-driven columns. gridname = "FDefaultVendors.gData",
        // grouped:true to read the grouped-column schema.
        await ApplyGridLayoutOverlay();

        // VB6 lines 214-229 — load existing vendor assignments and fill cells.
        var vendorAssignments = await DbHelper.QueryAsync(@"
            SELECT l.Area AS AreaCode, pav.POIndex, pav.Vendor AS VendorId, v.Vendor_Name AS VendorName
            FROM POAreaVendor pav
            JOIN tblVendors v ON pav.Vendor = v.Vendor_ID AND v.DivisionID = pav.DivisionID
            LEFT OUTER JOIN tblLocality l ON pav.Area = l.Area
            WHERE pav.DivisionID = @DivisionID
            AND (l.Inactive = 0 OR l.Area IS NULL)
            ORDER BY pav.POIndex", new { DivisionID = _divisionId });

        _gridData = new List<ExpandoObject>();
        foreach (var poi in poIndexRows)
        {
            dynamic row = new ExpandoObject();
            var dict = (IDictionary<string, object>)row;
            var poIndex = poi["POIndex"]?.ToString() ?? "";
            var poDesc = poi["Description"]?.ToString() ?? "";
            dict["POIndex"] = poIndex;
            // VB6 line 180: poindex + (description unless identical).
            dict["POIndexDisplay"] = poIndex == poDesc ? poIndex : $"{poIndex} {poDesc}";

            dict["Area_GBL"] = new VendorCell();
            foreach (var area in _areas)
            {
                dict["Area_" + area.AreaCode] = new VendorCell();
            }
            _gridData.Add(row);
        }

        foreach (var assignment in vendorAssignments)
        {
            var matchRow = _gridData.FirstOrDefault(r =>
            {
                var d = (IDictionary<string, object>)r;
                return (d["POIndex"]?.ToString() ?? "") == (assignment["POIndex"]?.ToString() ?? "");
            });
            if (matchRow != null)
            {
                var dict = (IDictionary<string, object>)matchRow;
                var areaCode = assignment["AreaCode"]?.ToString();
                // VB6: a null/blank area resolves to the "Global Default" column.
                var key = string.IsNullOrEmpty(areaCode) ? "Area_GBL" : "Area_" + areaCode;
                if (dict.ContainsKey(key))
                {
                    dict[key] = new VendorCell
                    {
                        VendorId = assignment["VendorId"]?.ToString() ?? "",
                        VendorName = assignment["VendorName"]?.ToString() ?? "",
                        IsDirty = false
                    };
                }
            }
        }
    }

    /// <summary>
    /// VB6 line 236 IniGetGrid overlay. Loads the persisted AppGridLayout for
    /// FDefaultVendors.gData and applies width / order / hidden onto the
    /// data-driven area columns. The area COLUMN SET still comes from
    /// tblLocality (VB6 builds columns first, then IniGetGrid only adjusts
    /// them) — the layout merely overlays appearance. Surfaces a
    /// [gData FALLBACK] marker in the page title when no layout row exists.
    ///
    /// OUTLINE BAR — N/A here. VB6's gData sets OutlineBar=5 / OutlineCol=1
    /// (FDefaultVendors.frm 78-79), but this grid is a FLAT PO-Index × Area matrix:
    /// every AppGridLayout row for FDefaultVendors.gData is grouped=0 (verified: all
    /// 139 rows), so there are no grouped columns to roll up and nothing for an
    /// outline bar to expand/collapse. We pass grouped:true to read the same column
    /// schema VB6 reads, but no grouping is fabricated — there is none in the data.
    /// </summary>
    private async Task ApplyGridLayoutOverlay()
    {
        // VB6 line 236 IniGetGrid → standard GetGridLayoutAsync, now routed through
        // the presenter. Produces the IDENTICAL gridTag ("FDefaultVendors.gData",
        // gridIndex 0, no instanceKey, staticNames=false) and sets FallbackUsed from
        // the same IGridLayoutService.LastLoadUsedFallback flag. _gridLayout.Layout
        // is the hydrated dictionary keyed by colkey — exactly what the old local
        // `layout` variable was.
        await _gridLayout.LoadAsync(GridLayoutSvc);
        var layout = _gridLayout.Layout;
        _gridLayoutFallbackUsed = _gridLayout.FallbackUsed;

        Logger.LogInformation(
            "FDefaultVendors.gData layout: {Count} entries, fallback={Fallback}",
            layout.Count, _gridLayoutFallbackUsed);

        // colindex 0 = POIndex (colkey "POIndex"); colindex 1 = Global Default
        // (empty colkey, dropped by GetGridLayoutAsync); colindex 2+ keyed by
        // the area code. Pull width/caption for the two fixed columns directly
        // from the raw rows (the empty-key Global column needs the raw read).
        await ApplyFixedColumnLayout();

        // Areas: overlay width + colindex + hidden by area-code key.
        foreach (var area in _areas)
        {
            if (layout.TryGetValue(area.AreaCode, out var col))
            {
                area.Hidden = col.Hidden;
                area.ColIndex = col.ColIndex;
                area.WidthPx = col.Width.HasValue && col.Width.Value > 0
                    ? $"{ConvertLayoutWidthToPx(col.Width.Value)}px"
                    : DefaultAreaWidthPx;
                if (!string.IsNullOrWhiteSpace(col.Caption))
                    area.Description = col.Caption;
            }
            else
            {
                // Area exists in tblLocality but not in the saved layout — show
                // it with a sensible default width and natural (tail) order.
                area.WidthPx = DefaultAreaWidthPx;
            }
        }

        _gridLayoutVersion++;
    }

    /// <summary>VB6 IniPutGrid. GridControl raises OnLayoutChanged when a resize /
    /// reorder / hide / rename finishes; the new widths live on the snapshot, not in
    /// the layout dict, so they are merged in before the save.
    ///
    /// _gridLayoutVersion is deliberately NOT bumped: the rendered widths come from
    /// _areas / _poIndexWidth / _globalWidth (the tblLocality-driven column set), so
    /// re-keying GridColumnsBase would rebuild the columns from those stale values and
    /// discard the grid's runtime width — the drag would snap back. The database now
    /// holds the new layout and the next load applies it.</summary>
    private async Task OnGridLayoutChangedAsync(GridSettings snapshot)
    {
        if (snapshot == null || _gridLayout.Layout.Count == 0) return;
        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FDefaultVendors", "gData", instanceKey: null,
                _gridLayout.Layout, snapshot, ResolveGridLayoutField);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FDefaultVendors gData layout");
        }
    }

    /// <summary>AppGridLayout colkey → the grid's GridColumn.Field: colkey "POIndex"
    /// renders as POIndexDisplay, the Global Default column carries an EMPTY colkey
    /// and renders as Area_GBL, and every other colkey is a tblLocality area code
    /// rendering as "Area_&lt;code&gt;". Mapping the empty key to "" left the Global
    /// column unmatched on save, so its layout row was orphaned to the 1,000,000+
    /// range and lost its position.</summary>
    private static string ResolveGridLayoutField(string layoutField)
    {
        var field = (layoutField ?? "").Trim();
        if (field.Length == 0)
            return GlobalKey;
        return string.Equals(field, "POIndex", StringComparison.OrdinalIgnoreCase)
            ? "POIndexDisplay"
            : "Area_" + field;
    }

    /// <summary>
    /// Read the raw AppGridLayout rows for the two fixed columns (colkey "POIndex",
    /// and Global Default whose colkey is empty — so GetGridLayoutAsync drops it).
    /// Falls back to VB6 defaults when the layout has no rows.
    /// </summary>
    private async Task ApplyFixedColumnLayout()
    {
        // Mirror GetGridLayoutAsync's uid resolution + empty-uid fallback so the
        // fixed-column widths come from the SAME row set the overlay used.
        var uid = !string.IsNullOrEmpty(SessionState.LoginID) ? SessionState.LoginID : "admin";
        const string sql = @"
            SELECT colkey, caption, width, colindex, hidden
            FROM AppGridLayout
            WHERE uid = @Uid AND gridname = 'FDefaultVendors.gData'
            ORDER BY colindex";

        var rows = await DbHelper.QueryAsync(sql, new { Uid = uid });
        if (rows.Count == 0 && !string.Equals(uid, "", StringComparison.Ordinal))
            rows = await DbHelper.QueryAsync(sql, new { Uid = "" });

        foreach (var r in rows)
        {
            // Anchored on colkey rather than colindex: saving the layout renumbers
            // colindex across the grid's rows and pushes the empty-colkey Global
            // Default row (which no save can address) out of the way, so colindex
            // 0/1 stop identifying the two fixed columns after the first save.
            var colKey = (r["colkey"]?.ToString() ?? "").Trim();
            var caption = r["caption"]?.ToString() ?? "";
            double.TryParse(r["width"]?.ToString(), out var w);
            var widthPx = w > 0 ? $"{ConvertLayoutWidthToPx(w)}px" : null;

            if (string.Equals(colKey, "POIndex", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrWhiteSpace(caption)) _poIndexCaption = caption;
                if (widthPx != null) _poIndexWidth = widthPx;
            }
            else if (colKey.Length == 0) // Global Default (empty colkey)
            {
                if (!string.IsNullOrWhiteSpace(caption)) _globalCaption = caption;
                if (widthPx != null) _globalWidth = widthPx;
            }
        }
    }

    private const string DefaultAreaWidthPx = "120px";
    private const string GlobalKey = "Area_GBL";

    /// <summary>tblLocality area code for a grid dictionary key
    /// ("Area_GBL" → "" = Global Default, "Area_&lt;code&gt;" → code).</summary>
    private static string AreaCodeOf(string key)
        => key == GlobalKey
            ? string.Empty
            : key.StartsWith("Area_", StringComparison.OrdinalIgnoreCase)
                ? key["Area_".Length..]
                : string.Empty;

    /// <summary>Area columns in persisted order, hidden ones filtered out
    /// (mirrors FAssembly's GetOrderedItemsGridLayout / FVendor's
    /// GetOrderedLayout — visible-only, ColIndex then Description).</summary>
    private IEnumerable<AreaInfo> GetOrderedAreas()
    {
        return _areas
            .Where(a => !a.Hidden && !string.IsNullOrWhiteSpace(a.AreaCode))
            .OrderBy(a => a.ColIndex ?? int.MaxValue)
            .ThenBy(a => a.Description, StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>VB6 grid widths are twips (15 twips/px). Delegates to the canonical
    /// GridLayoutPresenter.WidthPx (byte-identical to the old body here). This is the
    /// ONLY width math in the form — both the area overlay (ApplyGridLayoutOverlay)
    /// and the raw fixed-column read (ApplyFixedColumnLayout) funnel through it.
    ///
    /// NOTE: only the PRIMARY overlay LOAD is routed through GridLayoutPresenter
    /// (_gridLayout.LoadAsync → _gridLayout.Layout, see ApplyGridLayoutOverlay). The
    /// presenter's TRow-reflection machinery (ResolveField / ColumnTypeFor /
    /// GetOrdered / Choose-Columns) is deliberately NOT used: unlike FAssembly et al.,
    /// gData is a flat PO-Index × Area matrix over <c>ExpandoObject</c> rows whose
    /// COLUMN SET comes from tblLocality (AreaInfo), with AppGridLayout merely
    /// OVERLAYING width/order/hidden — there is no static TRow to reflect over, no
    /// Resolve/GetOrdered/ColumnType/Choose-Columns step. The raw SECOND AppGridLayout
    /// read (ApplyFixedColumnLayout) for the empty-colkey fixed columns also stays
    /// form-specific (the presenter drops empty-colkey rows, so it cannot supply
    /// them). So the presenter contributes the load + Layout + FallbackUsed and this
    /// shared width helper; the overlay/derivation/fixed-read logic remains here.</summary>
    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // ── VB6 gData_CellButtonClick → FPickList.Choose ────────────────────
    private async Task OnPickVendor(IDictionary<string, object> row, string areaCode, string key)
    {
        if (_pickList == null) return;
        _pickRow = row;
        _pickAreaCode = areaCode;
        _pickKey = key;

        // VB6 gData_CellButtonClick writes the pick across the CURRENT SELECTION
        // (GetSelection r1,c1,r2,c2 → Cell(...,r1,c1,r2,c2)). Make this cell the
        // active cell so a no-range pick targets exactly it, but PRESERVE an existing
        // multi-cell selection that already covers this cell (so the user can select a
        // block, hit "…" on one of its cells and fan the vendor across the block).
        var rowIdx = RowIdxOf(row);
        var colIdx = ColIdxOf(key);
        if (!(rowIdx >= 0 && colIdx >= 0 && _selRange.Contains((rowIdx, colIdx)) && _selRange.Count > 1))
        {
            _curCell = (row, key);
            _selRange.Clear();
            if (rowIdx >= 0 && colIdx >= 0)
                _selRange.Add((rowIdx, colIdx));
        }

        // VB6 line 359: FPickList.Choose(dbHomefront, "Vendor",
        //   "SELECT vendorgroupid Trade, Vendor_Name Company, Vendor_ID Vendor,
        //    City, Phone FROM tblVendors WHERE divisionid=@Div AND Inactive=0", s)
        var sql = "SELECT VendorGroupID Trade, Vendor_Name Company, Vendor_ID Vendor, City, Phone " +
                  "FROM tblVendors WHERE DivisionID = @DivisionID AND ISNULL(Inactive, 0) = 0 " +
                  "ORDER BY Vendor_Name";

        await _pickList.Open(
            title: "Vendor",
            queries: sql,
            hideColumns: null,
            multiSelect: false,
            parameters: new Dictionary<string, object> { ["DivisionID"] = _divisionId });
    }

    private async Task OnGridEditButtonClick(CellEditButtonArgs<ExpandoObject> args)
    {
        if (args.Data is not IDictionary<string, object> row)
            return;

        var key = args.ColumnName ?? string.Empty;
        if (string.IsNullOrWhiteSpace(key) || key == "POIndexDisplay")
            return;

        if (!row.TryGetValue(key, out var value) || value is not VendorCell)
            return;

        var areaCode = key == GlobalKey
            ? string.Empty
            : key.StartsWith("Area_", StringComparison.OrdinalIgnoreCase)
                ? key["Area_".Length..]
                : string.Empty;

        await OnPickVendor(row, areaCode, key);
    }

    /// <summary>VB6 gData_CellButtonClick body: on a successful pick, write the
    /// vendor name (text) + id (data) across the CURRENT SELECTION and mark those
    /// cells dirty. VB6: Cell(flexcpText/Data/ForeColor, r1, c1, r2, c2) = pick —
    /// i.e. the whole selected block, not just one cell, so a vendor can be applied
    /// to many PO-Index × Area cells at once.</summary>
    private void OnVendorPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        if (selectedRows.Count > 0)
        {
            var pick = selectedRows[0];
            var vendorId = GetRowString(pick, "Vendor");
            var vendorName = GetRowString(pick, "Company");

            // Write across the selection (VB6 GetSelection block). If somehow nothing
            // is selected, fall back to the single clicked cell.
            if (_selRange.Count > 0)
            {
                foreach (var (rowIdx, colIdx) in _selRange)
                    SetCellAt(rowIdx, colIdx, vendorId, vendorName);
            }
            else if (_pickRow != null && _pickRow.ContainsKey(_pickKey))
            {
                _pickRow[_pickKey] = new VendorCell
                {
                    VendorId = vendorId,
                    VendorName = vendorName,
                    IsDirty = true   // VB6: .Cell(flexcpForeColor,...) = DIRTYCOLOR
                };
            }
            _isDirty = true;     // VB6: mDirty = True
        }
        _pickRow = null;
        _pickAreaCode = "";
        _pickKey = "";
        StateHasChanged();
    }

    private static string GetRowString(IDictionary<string, object> row, string key)
        => row.TryGetValue(key, out var v) && v != null ? v.ToString() ?? "" : "";

    /// <summary>VB6 SaveData. Walks every dirty cell: delete the old
    /// (Division, Area, POIndex) row, validate the vendor exists, then insert
    /// the new assignment. Returns true to allow navigation.</summary>
    public async Task<bool> SaveData(bool prompt = true)
    {
        // VB6: If Not mDirty Then SaveData = True : Exit Function
        if (!_isDirty)
            return true;

        if (prompt)
        {
            if (_messageBox == null) return false;
            _isSavePromptOpen = true;
            Fx.ControlKit.Dialogs.MessageBoxResult result;
            try
            {
                // VB6: MsgBox vbExclamation + vbYesNoCancel, title = Me.Caption.
                result = await _messageBox.ShowAsync(
                    "This data has changed.\n\nDo you want to save the changes?",
                    title: "Default Vendors",
                    buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel,
                    icon: "warning");
            }
            finally
            {
                _isSavePromptOpen = false;
            }

            switch (result)
            {
                case Fx.ControlKit.Dialogs.MessageBoxResult.No:
                    return true;   // VB6 Case vbNo: SaveData = True
                case Fx.ControlKit.Dialogs.MessageBoxResult.Cancel:
                    return false;  // VB6 Case vbCancel: Exit Function
            }
        }

        try
        {
            // Persist the two fixed-area columns (Global = "") plus every area.
            foreach (var row in _gridData)
            {
                var dict = (IDictionary<string, object>)row;
                var poIndex = dict["POIndex"]?.ToString();

                // Global Default column → empty Area.
                if (!await SaveCellAsync(dict, "Area_GBL", "", poIndex))
                    return false;

                foreach (var area in _areas)
                {
                    if (!await SaveCellAsync(dict, $"Area_{area.AreaCode}", area.AreaCode, poIndex))
                        return false;
                }
            }
            _isDirty = false;   // VB6: mDirty = False
            StateHasChanged();
            return true;
        }
        catch (Exception ex) when (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
        {
            // VB6 eh: If InStr(..., "duplicate") Then Resume Next
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FDefaultVendors SaveData failed");
            _errorMessage = "Save failed: " + ex.Message;
            _showErrorDialog = true;
            return false;
        }
    }

    /// <summary>One dirty cell's worth of VB6 SaveData (DELETE + validate +
    /// INSERT). Returns false only when validation surfaces an unknown vendor
    /// (VB6 Exit Function after MsgBox "unknown vendor").</summary>
    private async Task<bool> SaveCellAsync(IDictionary<string, object> dict, string key, string area, string? poIndex)
    {
        if (!dict.TryGetValue(key, out var value) || value is not VendorCell cell || !cell.IsDirty)
            return true;

        // VB6 lines 271-274: DELETE FROM POAreaVendor WHERE Division/Area/POIndex.
        await DbHelper.ExecuteAsync(@"
            DELETE FROM POAreaVendor
            WHERE DivisionID = @DivisionID
            AND Area = @Area
            AND POIndex = @POIndex",
            new { DivisionID = _divisionId, Area = area, POIndex = poIndex });

        var vendor = (cell.VendorId ?? "").Trim();
        if (!string.IsNullOrWhiteSpace(vendor))
        {
            // VB6 lines 280-290: verify the vendor exists for this division.
            var vendorExists = await DbHelper.QueryAsync(@"
                SELECT Vendor_ID FROM tblVendors
                WHERE Vendor_ID = @VendorId AND DivisionID = @DivisionID",
                new { VendorId = vendor, DivisionID = _divisionId });
            if (!vendorExists.Any())
            {
                // VB6: MsgBox "unknown vendor" : Exit Function
                _errorMessage = "Unknown vendor";
                _showErrorDialog = true;
                return false;
            }

            // VB6 lines 294-299: INSERT the assignment.
            await DbHelper.ExecuteAsync(@"
                INSERT INTO POAreaVendor (DivisionID, Area, POIndex, Vendor)
                VALUES (@DivisionID, @Area, @POIndex, @VendorId)",
                new { DivisionID = _divisionId, Area = area, POIndex = poIndex, VendorId = vendor });
        }

        cell.IsDirty = false;   // VB6: .Cell(flexcpForeColor,...) = vbWindowText
        return true;
    }

    // ════════════════════════════════════════════════════════════════════════
    //  FIND  (VB6 Ctrl+F → FFind.ShowForm(gData): the modal FFind dialog —
    //  locate + scroll + highlight the next match in the grid's CURRENT
    //  COLUMN, NOT a filter. FFind.frm FindNextSimple, lines 163-218.)
    // ════════════════════════════════════════════════════════════════════════

    // RowCssClassSelector: tag the row the Find dialog landed on with .find-match
    // (styled in FDefaultVendors.razor.css). Keyed by POIndex — the stable row
    // identity (the PK that drives the grid).
    private string? GetRowCssClass(ExpandoObject row, int rowIndex)
    {
        if (string.IsNullOrEmpty(_findMatchKey))
            return null;
        var dict = (IDictionary<string, object>)row;
        var poIndex = dict.TryGetValue("POIndex", out var v) ? v?.ToString() ?? "" : "";
        return string.Equals(poIndex, _findMatchKey, StringComparison.OrdinalIgnoreCase)
            ? "find-match" : null;
    }

    // VB6 txtFind_Change (FFind.frm 159-161): Find Next is enabled only while
    // the text is non-blank. UpdateOnInput keeps _findWhat live per keystroke.
    private bool CanFindNext => !string.IsNullOrWhiteSpace(_findWhat);

    // Enter in the Find box = Find Next (VB6 cmdNav(0) Default = True, FFind.frm
    // 80 — a default button only fires while it is enabled).
    private void OnFindWhatKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanFindNext)
            FindNext();
    }

    // VB6 FFind.FindNextSimple (FFind.frm 163-218): search the grid's CURRENT
    // COLUMN only (.TextMatrix(r, .Col)), stepping Up/Down from the current row
    // WITHOUT wrapping (iTop/iBottom/iStep, frm 186-195). Substring match — VB6
    // wraps the needle as "*needle*" for Like (frm 181; whole-word is disabled) —
    // honoring Match case (frm 177/183/196). On a hit VB6 .Select(found, .Col) +
    // .ShowCell (frm 207-208): here the hit becomes the active cell, the row is
    // tagged .find-match (RowCssClassSelector) and scrolled on screen. No hit →
    // exit silently, exactly like VB6 (FindNextSimple has no "Cannot find"
    // MsgBox — only FindNextHierarchy does, frm 266, and gData is not grouped).
    private void FindNext()
    {
        var needle = _findWhat ?? "";
        if (needle.Trim().Length == 0 || _gridData.Count == 0)
            return;

        // VB6 .Col: the active column; no active cell → the PO Index column.
        var colKey = _curCell?.Key ?? "POIndexDisplay";

        // VB6 .Row: the active row (a previous hit moved it via .Select; VB6's
        // default active row is the first data row, so no active cell → 0).
        var cur = _curCell != null ? RowIdxOf(_curCell.Value.Row) : 0;
        if (cur < 0) cur = 0;

        var down = _findDirection == "down";
        // VB6 frm 188-193: iTop/iBottom clamped into the data rows, step ±1.
        var from = Math.Min(Math.Max(0, down ? cur + 1 : cur - 1), _gridData.Count - 1);
        var to = down ? _gridData.Count - 1 : 0;
        var step = down ? 1 : -1;
        var comparison = _findMatchCase ? StringComparison.Ordinal : StringComparison.OrdinalIgnoreCase;

        for (var r = from; down ? r <= to : r >= to; r += step)
        {
            var dict = (IDictionary<string, object>)_gridData[r];
            if (!CellTextAt(dict, colKey).Contains(needle, comparison))
                continue;

            // VB6 .Select(iFoundIT, .Col): the hit becomes the active cell (and,
            // for a vendor column, the one-cell selection block).
            _curCell = (dict, colKey);
            var colIdx = ColIdxOf(colKey);
            if (colIdx >= 0)
            {
                _selRange.Clear();
                _selRange.Add((r, colIdx));
            }
            _findMatchKey = dict.TryGetValue("POIndex", out var v) ? v?.ToString() : null;
            _scrollToFindMatch = true;   // VB6 .ShowCell — OnAfterRenderAsync scrolls it on screen
            StateHasChanged();
            return;
        }
    }

    // VB6 .TextMatrix(r, col): the VISIBLE cell text — the PO Index display for
    // the index column, the vendor NAME (not the Vendor_ID .Data) for a vendor
    // column.
    private static string CellTextAt(IDictionary<string, object> dict, string colKey)
    {
        if (!dict.TryGetValue(colKey, out var v) || v == null)
            return "";
        return v is VendorCell cell ? cell.VendorName : v.ToString() ?? "";
    }

    // Scroll the highlighted find-match row into view AFTER the grid has re-rendered
    // the row with its .find-match class (so the element exists). Uses the existing
    // globally-loaded helper window.hfScrollSelectorIntoView (a thin
    // element.scrollIntoView wrapper, already in wwwroot/js/fx-report.js — reused,
    // not re-added); on any failure we just skip the scroll (C# best-effort fallback —
    // the row is still highlighted, the user can scroll manually). Same pattern as
    // FCommunities.OnAfterRenderAsync.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_grid != null && _gridData.Count > 0 && _openFocusAttempts < 3)
        {
            _openFocusAttempts++;
            try
            {
                await _grid.SelectCellAsync((0, 0));
                await _grid.FocusGridAsync();
            }
            catch (Exception) { }
        }

        if (_scrollToFindMatch)
        {
            _scrollToFindMatch = false;
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "hfScrollSelectorIntoView", ".default-vendors-page .fx-row.find-match");
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "[FDefaultVendors Find] scroll-into-view unavailable");
            }
        }
    }

    // ════════════════════════════════════════════════════════════════════════
    //  COPY / PASTE CELL-TILING  (VB6 gData_KeyDown Ctrl+C / Ctrl+V / Delete,
    //  FDefaultVendors.frm 369-458). PURELY INTERNAL — VB6 copies cell .Text/.Data
    //  within the grid and tiles them across the destination block; it never uses
    //  the Windows clipboard. So an in-memory buffer is the faithful port and NO
    //  JavaScript is needed.
    // ════════════════════════════════════════════════════════════════════════

    // Editable column order for the copy/paste coordinate system: Global Default = 0,
    // then the ordered/visible area columns = 1..n. (PO Index is NOT a copy target —
    // VB6 SaveData + paste loop run c = 1 To Cols-1, skipping the frozen index col.)
    private List<string> EditableColumnKeys()
    {
        var keys = new List<string> { GlobalKey };
        keys.AddRange(GetOrderedAreas().Select(a => $"Area_{a.AreaCode}"));
        return keys;
    }

    private int RowIdxOf(IDictionary<string, object> row)
        => _gridData.FindIndex(r => ReferenceEquals(r, row));

    private int ColIdxOf(string key) => EditableColumnKeys().IndexOf(key);

    // VB6 .Row/.Col + GetSelection: a plain click sets the active cell and collapses
    // the selection to it; Shift+click extends a rectangular block from the active
    // cell to the clicked cell (VB6 AllowBigSelection). The block is what Ctrl+C
    // copies and Ctrl+V tiles across.
    private void OnCellClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs e,
                             IDictionary<string, object> row, string key)
    {
        var rowIdx = RowIdxOf(row);
        var colIdx = ColIdxOf(key);
        if (rowIdx < 0 || colIdx < 0) return;

        if (e.ShiftKey && _curCell != null)
        {
            var anchorRow = RowIdxOf(_curCell.Value.Row);
            var anchorCol = ColIdxOf(_curCell.Value.Key);
            if (anchorRow >= 0 && anchorCol >= 0)
            {
                BuildRange(anchorRow, anchorCol, rowIdx, colIdx);
                StateHasChanged();
                return;
            }
        }

        _curCell = (row, key);
        _selRange.Clear();
        _selRange.Add((rowIdx, colIdx));
        StateHasChanged();
    }

    // HHM-606: mousedown = drag-selection anchor (VB6 pressing the button on a
    // cell starts a big-selection drag). A Shift+mousedown extends from the
    // active cell instead (same as Shift+click — OnCellClick then repeats the
    // identical BuildRange, which is idempotent). Also focuses the page
    // container so the very next keystroke (Ctrl+Delete, Ctrl+C/V, Enter…)
    // reaches OnPageKeyDown even when focus was outside the page before.
    private async Task OnCellMouseDown(Microsoft.AspNetCore.Components.Web.MouseEventArgs e,
                                       IDictionary<string, object> row, string key)
    {
        if (e.Button != 0) return;   // left button only
        var rowIdx = RowIdxOf(row);
        var colIdx = ColIdxOf(key);
        if (rowIdx < 0 || colIdx < 0) return;

        if (e.ShiftKey && _curCell != null)
        {
            var anchorRow = RowIdxOf(_curCell.Value.Row);
            var anchorCol = ColIdxOf(_curCell.Value.Key);
            if (anchorRow >= 0 && anchorCol >= 0)
                BuildRange(anchorRow, anchorCol, rowIdx, colIdx);
        }
        else
        {
            _curCell = (row, key);
            _selRange.Clear();
            _selRange.Add((rowIdx, colIdx));
            _dragAnchor = (rowIdx, colIdx);
            _isCellDragging = true;
        }

        try { await _pageElement.FocusAsync(preventScroll: true); } catch { /* prerender/teardown */ }
        StateHasChanged();
    }

    // HHM-606: extend the rectangle while the left button is held (VB6 dragging
    // a big selection). e.Buttons==0 means the button was released outside the
    // grid — end the drag instead of extending.
    private void OnCellMouseEnter(Microsoft.AspNetCore.Components.Web.MouseEventArgs e,
                                  IDictionary<string, object> row, string key)
    {
        if (!_isCellDragging || _dragAnchor == null) return;
        if ((e.Buttons & 1) == 0) { _isCellDragging = false; _dragAnchor = null; return; }

        var rowIdx = RowIdxOf(row);
        var colIdx = ColIdxOf(key);
        if (rowIdx < 0 || colIdx < 0) return;

        BuildRange(_dragAnchor.Value.RowIdx, _dragAnchor.Value.ColIdx, rowIdx, colIdx);
        StateHasChanged();
    }

    // HHM-606: mouseup anywhere on the page ends the drag (the built range stays).
    private void EndCellDrag()
    {
        _isCellDragging = false;
        _dragAnchor = null;
    }

    private void BuildRange(int r1, int c1, int r2, int c2)
    {
        _selRange.Clear();
        for (var r = Math.Min(r1, r2); r <= Math.Max(r1, r2); r++)
            for (var c = Math.Min(c1, c2); c <= Math.Max(c1, c2); c++)
                _selRange.Add((r, c));
    }

    private bool IsCellSelected(IDictionary<string, object>? row, string key)
    {
        if (row == null || _selRange.Count == 0) return false;
        var rowIdx = RowIdxOf(row);
        var colIdx = ColIdxOf(key);
        return rowIdx >= 0 && colIdx >= 0 && _selRange.Contains((rowIdx, colIdx));
    }

    private VendorCell? CellAt(int rowIdx, int colIdx)
    {
        if (rowIdx < 0 || rowIdx >= _gridData.Count) return null;
        var keys = EditableColumnKeys();
        if (colIdx < 0 || colIdx >= keys.Count) return null;
        var dict = (IDictionary<string, object>)_gridData[rowIdx];
        return dict.TryGetValue(keys[colIdx], out var v) ? v as VendorCell : null;
    }

    private void SetCellAt(int rowIdx, int colIdx, string vendorId, string vendorName)
    {
        if (rowIdx < 0 || rowIdx >= _gridData.Count) return;
        var keys = EditableColumnKeys();
        if (colIdx < 0 || colIdx >= keys.Count) return;
        var dict = (IDictionary<string, object>)_gridData[rowIdx];
        dict[keys[colIdx]] = new VendorCell
        {
            VendorId = vendorId,
            VendorName = vendorName,
            IsDirty = true   // VB6: .Cell(flexcpForeColor,...) = DIRTYCOLOR
        };
    }

    // VB6 gData_KeyDown (369-458): Ctrl+S save, Ctrl+F find, F4/Enter open the
    // vendor picker on the active cell, Ctrl+C copy block, Ctrl+V paste/tile,
    // Delete clear block. The grid's own batch-edit keydown only
    // fires in edit mode (we're never in it — cells are picker templates with
    // AllowEditing=false), so catch the shortcuts on the page container instead.
    // (No preventDefault: Blazor evaluates @onkeydown:preventDefault at render time,
    // not per-event, so it can't suppress THIS keystroke's browser default anyway —
    // FCommunities' grid-keydown takes the same plain approach.)
    private void OnPageKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        var ctrl = e.CtrlKey || e.MetaKey;

        // VB6 Case KeyCode = vbKeyS And Shift = vbCtrlMask: Call SaveData(False)
        if (ctrl && (e.Key == "s" || e.Key == "S"))
        {
            _ = SaveData(false);
            return;
        }

        // VB6 Case KeyCode = vbKeyF And Shift = vbCtrlMask: Call FFind.ShowForm(gData)
        // — open the modal Find dialog. (The browser's own find bar may open too:
        // Blazor can't preventDefault this live keystroke, see the note above.)
        if (ctrl && (e.Key == "f" || e.Key == "F"))
        {
            _showFindDialog = true;
            return;
        }

        // VB6 Case KeyCode = vbKeyF4 (frm 402-403): If .Row > 0 And .Col > 0 Then
        // Call gData_CellButtonClick(.Row, .Col) — open the vendor picker on the
        // active cell. Enter is the web-grid equivalent (HHM-606 multi-cell entry):
        // drag-select a block, press Enter, pick the vendor in the "first" (active)
        // cell's picker — OnVendorPickListSelected then writes it across the whole
        // _selRange, exactly VB6 CellButtonClick's Cell(..., r1, c1, r2, c2) write.
        if ((e.Key == "Enter" || e.Key == "F4") && !ctrl && !e.AltKey
            && _curCell != null
            && !_showFindDialog && !_isSavePromptOpen && !_showErrorDialog)
        {
            var (row, key) = _curCell.Value;
            _ = OnPickVendor(row, AreaCodeOf(key), key);
            return;
        }

        // VB6 Case Shift = vbCtrlMask And KeyCode = vbKeyC: snapshot the selected block.
        if (ctrl && (e.Key == "c" || e.Key == "C"))
        {
            CopySelection();
            return;
        }

        // VB6 Case Shift = vbCtrlMask And KeyCode = vbKeyV: paste / tile the block.
        if (ctrl && (e.Key == "v" || e.Key == "V"))
        {
            PasteSelection();
            return;
        }

        // VB6 Case KeyCode = vbKeyDelete: blank every selected cell, mark dirty.
        // The VB6 case tests ONLY the KeyCode, so plain Delete AND Ctrl+Delete
        // (QA's HHM-606 keystroke) both clear the block — mirror that here.
        if (e.Key == "Delete")
        {
            DeleteSelection();
            return;
        }
    }

    // VB6 Ctrl+C (411-414): GetSelection(ClipRow1,ClipCol1,ClipRow2,ClipCol2);
    // ClipRows/ClipCols = block size. We snapshot the VendorCell values of the
    // selected rectangle into a row-major buffer (the in-memory equivalent of VB6's
    // Static Clip* coords pointing back into the grid cells).
    private void CopySelection()
    {
        if (_selRange.Count == 0) { _clip = null; return; }
        var r1 = _selRange.Min(c => c.RowIdx);
        var r2 = _selRange.Max(c => c.RowIdx);
        var c1 = _selRange.Min(c => c.ColIdx);
        var c2 = _selRange.Max(c => c.ColIdx);
        var rows = r2 - r1 + 1;
        var cols = c2 - c1 + 1;
        var clip = new VendorCell[rows, cols];
        for (var r = 0; r < rows; r++)
            for (var c = 0; c < cols; c++)
            {
                var src = CellAt(r1 + r, c1 + c);
                clip[r, c] = new VendorCell
                {
                    VendorId = src?.VendorId ?? "",
                    VendorName = src?.VendorName ?? ""
                };
            }
        _clip = clip;
    }

    // VB6 Ctrl+V (417-454): paste the copied block at the destination.
    //   • destination is a SINGLE cell  → paste the whole block once, anchored there
    //     (clipped at the sheet edge — VB6 "cell is not on sheet" skip).
    //   • destination is a RANGE         → "tile" the block across the region, the
    //     source index wrapping with Mod ClipCols / Mod ClipRows.
    private void PasteSelection()
    {
        if (_clip == null) return;
        if (_selRange.Count == 0) return;

        var clipRows = _clip.GetLength(0);
        var clipCols = _clip.GetLength(1);
        if (clipRows == 0 || clipCols == 0) return;

        var dr1 = _selRange.Min(c => c.RowIdx);
        var dr2 = _selRange.Max(c => c.RowIdx);
        var dc1 = _selRange.Min(c => c.ColIdx);
        var dc2 = _selRange.Max(c => c.ColIdx);

        var maxRow = _gridData.Count - 1;
        var maxCol = EditableColumnKeys().Count - 1;

        if (dr1 == dr2 && dc1 == dc2)
        {
            // VB6 425-435: single destination cell → paste entire clip once.
            for (var c = 0; c < clipCols; c++)
                for (var r = 0; r < clipRows; r++)
                {
                    var tr = dr1 + r;
                    var tc = dc1 + c;
                    if (tr > maxRow || tc > maxCol) continue;   // not on sheet
                    var src = _clip[r, c];
                    SetCellAt(tr, tc, src.VendorId, src.VendorName);
                }
        }
        else
        {
            // VB6 437-449: range destination → tile the clip, wrapping with Mod.
            for (var c = dc1; c <= dc2; c++)
                for (var r = dr1; r <= dr2; r++)
                {
                    var sc = (c - dc1) % clipCols;
                    var sr = (r - dr1) % clipRows;
                    var src = _clip[sr, sc];
                    SetCellAt(r, c, src.VendorId, src.VendorName);
                }
        }

        _isDirty = true;   // VB6: mDirty = True
        StateHasChanged();
    }

    // VB6 Delete (405-409): blank every cell in the selection (.Data + .Text = "")
    // and mark them dirty so SaveData deletes the assignment.
    private void DeleteSelection()
    {
        if (_selRange.Count == 0) return;
        foreach (var (rowIdx, colIdx) in _selRange)
            SetCellAt(rowIdx, colIdx, "", "");
        _isDirty = true;
        StateHasChanged();
    }

    public class VendorCell
    {
        public string VendorId { get; set; } = string.Empty;
        public string VendorName { get; set; } = string.Empty;
        public bool IsDirty { get; set; } = false;
    }

    public class AreaInfo
    {
        public string AreaCode { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        // ── Layout overlay (VB6 IniGetGrid) ──
        public bool Hidden { get; set; }
        public int? ColIndex { get; set; }
        public string WidthPx { get; set; } = DefaultAreaWidthPx;
    }
}
