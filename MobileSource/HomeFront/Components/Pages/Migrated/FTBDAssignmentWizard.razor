@page "/tbd-assignment-wizard"
@rendermode InteractiveServer
@namespace HomeFront.Components.Pages
@layout HFComponent

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FTBDAssignmentWizard> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>PO Assignment Wizard - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading TBD Purchase Orders...</div>
    </div>
}

<div class="wizard-container">
    @* ── Wizard Header ─────────────────────────────────────── *@
    <div class="wiz-head">
        <div class="wiz-head-text">
            <h2>Assign TBD Purchase Orders</h2>
            <p>Assign these POs to vendors or contractors.</p>
        </div>
    </div>

    @* ── Grid Area ─────────────────────────────────────────── *@
    <div class="grid-area">
        @* Filter Row *@
        <div class="filter-row">
            <TextBoxControl Placeholder="Community" @bind-Value="FilterCommunity" @bind-Value:after="ApplyFilter" style="width:120px;" />
            <TextBoxControl Placeholder="Community Desc" @bind-Value="FilterCommunityDesc" @bind-Value:after="ApplyFilter" style="width:140px;" />
            <TextBoxControl Placeholder="Job" @bind-Value="FilterJob" @bind-Value:after="ApplyFilter" style="width:80px;" />
            <TextBoxControl Placeholder="Job Desc" @bind-Value="FilterJobDesc" @bind-Value:after="ApplyFilter" style="width:140px;" />
            <TextBoxControl Placeholder="PO Group" @bind-Value="FilterPOGroup" @bind-Value:after="ApplyFilter" style="width:100px;" />
            <TextBoxControl Placeholder="PO Number" @bind-Value="FilterPONumber" @bind-Value:after="ApplyFilter" style="width:100px;" />
            <TextBoxControl Placeholder="PO Desc" @bind-Value="FilterPODesc" @bind-Value:after="ApplyFilter" style="width:140px;" />
            <TextBoxControl Placeholder="Vendor" @bind-Value="FilterVendor" @bind-Value:after="ApplyFilter" style="width:100px;" />
            <TextBoxControl Placeholder="Vendor Desc" @bind-Value="FilterVendorDesc" @bind-Value:after="ApplyFilter" style="width:140px;" />
            <TextBoxControl Placeholder="Status" @bind-Value="FilterStatus" @bind-Value:after="ApplyFilter" style="width:100px;" />
            <ButtonControl CssClass="tbd-filter-btn" OnClick="ClearFilters" Title="Clear all filters">✕ Clear</ButtonControl>
            <ButtonControl CssClass="tbd-filter-btn tbd-filter-btn-danger" OnClick="OnClearVendorClick" Title="Clear vendor from selected rows (Delete)">✕ Clear Vendor</ButtonControl>
        </div>

        <GridControl @ref="DataGrid"
                TValue="TBDPurchaseOrderRow"
                DataSource="@FilteredData"
                AllowSorting="true"
                AllowResizing="true"
                AllowSelection="true"
                EnableHover="true"
                Height="100%"
                SelectionSettingsRef="@selectionSettings"
                EditSettingsRef="@editSettings"
                EventsRef="@gridEvents">
            <GridColumnsBase>
                <GridColumn Field="@nameof(TBDPurchaseOrderRow.Community)" HeaderText="Community" Width="100px" AllowEditing="false" />
                <GridColumn Field="@nameof(TBDPurchaseOrderRow.CommunityDesc)" HeaderText="Community Desc" Width="150px" AllowEditing="false" />
                <GridColumn Field="@nameof(TBDPurchaseOrderRow.Job)" HeaderText="Job" Width="80px" AllowEditing="false" />
                <GridColumn Field="@nameof(TBDPurchaseOrderRow.JobDesc)" HeaderText="Job Desc" Width="150px" AllowEditing="false" />
                <GridColumn Field="@nameof(TBDPurchaseOrderRow.POGroup)" HeaderText="PO Group" Width="100px" AllowEditing="false" />
                <GridColumn Field="@nameof(TBDPurchaseOrderRow.POIndex)" HeaderText="PO Index" Width="80px" AllowEditing="false" Visible="false" />
                <GridColumn Field="@nameof(TBDPurchaseOrderRow.PONumber)" HeaderText="PO Number" Width="110px" AllowEditing="false" IsPrimaryKey="true" />
                <GridColumn Field="@nameof(TBDPurchaseOrderRow.PODesc)" HeaderText="PO Desc" Width="180px" AllowEditing="false" />
                <GridColumn Field="@nameof(TBDPurchaseOrderRow.PODate)" HeaderText="PO Date" Width="100px" AllowEditing="false" Format="d" />
                <GridColumn Field="@nameof(TBDPurchaseOrderRow.Vendor)" HeaderText="Vendor" Width="100px" AllowEditing="false">
                    <Template>
                        @{
                            var row = (TBDPurchaseOrderRow)context;
                            <span>@row.Vendor</span>
                            <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                    @onclick="() => OnVendorButtonClick(row)" @onclick:stopPropagation="true">...</button>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(TBDPurchaseOrderRow.VendorDesc)" HeaderText="Vendor Name" Width="200px" AllowEditing="false">
                    <Template>
                        @{
                            var row = (TBDPurchaseOrderRow)context;
                            <span>@row.VendorDesc</span>
                            <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                    @onclick="() => OnVendorButtonClick(row)" @onclick:stopPropagation="true">...</button>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(TBDPurchaseOrderRow.Status)" HeaderText="Status" Width="100px" AllowEditing="false" />
            </GridColumnsBase>
        </GridControl>

        <div class="status-info">
            @FilteredData.Count of @AllData.Count TBD purchase orders shown.
            @if (mDirty)
            {
                <span style="color: #dc3545; font-weight: 600;"> (Unsaved changes)</span>
            }
        </div>
    </div>

    @* ── Wizard Footer ─────────────────────────────────────── *@
    <div class="wiz-foot">
        <ButtonControl CssClass="btn-primary" OnClick="OnSaveClick">&amp;Save</ButtonControl>
        <ButtonControl OnClick="OnCancelClick">&amp;Cancel</ButtonControl>
    </div>
</div>

@* ── Vendor Pick List Dialog ──────────────────────────────── *@
<DialogControl Visible="@IsVendorDialogVisible"
               Header="Select Vendor"
               Width="600px"
               IsModal="true"
               ShowCloseIcon="true"
               OnClose="OnVendorDialogCancel">
    <ChildContent>
        @* Body markup is authored here, so it carries this page's scope — host
           CSS anchored on .tbd-vendor-dialog reaches the FlexKit input internals
           via ::deep (mirrors the FItems .fitems-dialog-form pattern). *@
        <div class="tbd-vendor-dialog">
            @* Search box: TextBoxControl commits on @onchange (blur). Filtering
               must stay as-you-type (the old <input> used @bind:event="oninput"
               @bind:after="FilterVendors"), so drive it via the pass-through
               @oninput handler — TextBoxControl tolerates unmatched attributes. *@
            <TextBoxControl Value="@VendorSearchText"
                            CssClass="vendor-search"
                            Placeholder="Search vendors..."
                            @oninput="OnVendorSearchInput" />
            <div class="vendor-list-scroll">
                @foreach (var vendor in FilteredVendors)
                {
                    <div class="vendor-list-item @(SelectedVendor?.VendorId == vendor.VendorId ? "selected" : "")"
                         @onclick="() => SelectedVendor = vendor">
                        <span class="vendor-list-id">@vendor.VendorId</span>
                        <span>@vendor.VendorName</span>
                    </div>
                }
                @if (!FilteredVendors.Any())
                {
                    <div class="vendor-list-empty">No vendors found.</div>
                }
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        @* Primary look via ButtonControl's dedicated Style param (a real
           parameter, not pass-through) — host ::deep can't reliably reach a
           button rendered inside DialogControl's own footer. *@
        <ButtonControl Style="@(SelectedVendor == null ? "" : "background:#0d6efd;color:#fff;border-color:#0d6efd;")"
                       Disabled="@(SelectedVendor == null)" OnClick="OnVendorDialogOk">OK</ButtonControl>
        <ButtonControl OnClick="OnVendorDialogCancel">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    // === Constants ===
    private const string SRCFILE = "FTBDAssignmentWizard::";

    // === Database ===
// === UI State ===
    private bool IsLoading = false;
    private bool mDirty = false;
    private GridControl<TBDPurchaseOrderRow>? DataGrid;

    // === Grid Settings ===
    private SelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Multiple,
        Mode = SelectionMode.Row,
        EnableToggle = true
    };
    private EditSettings editSettings = new()
    {
        AllowEditing = false,
        AllowAdding = false,
        AllowDeleting = false,
        ShowConfirmDialog = false
    };
    private GridControlEvents<TBDPurchaseOrderRow> gridEvents = new();

    // === Data ===
    private List<TBDPurchaseOrderRow> AllData = new();
    private List<TBDPurchaseOrderRow> FilteredData = new();

    // === Filter Fields ===
    private string FilterCommunity = "";
    private string FilterCommunityDesc = "";
    private string FilterJob = "";
    private string FilterJobDesc = "";
    private string FilterPOGroup = "";
    private string FilterPONumber = "";
    private string FilterPODesc = "";
    private string FilterVendor = "";
    private string FilterVendorDesc = "";
    private string FilterStatus = "";

    // === Vendor Dialog ===
    private bool IsVendorDialogVisible = false;
    private string VendorSearchText = "";
    private List<VendorItem> AllVendors = new();
    private List<VendorItem> FilteredVendors = new();
    private VendorItem? SelectedVendor;
    private TBDPurchaseOrderRow? VendorDialogTargetRow;

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        await ShowForm();
    }

    // === ShowForm (mirrors VB6 ShowForm) ===
    private async Task ShowForm()
    {
        // Permission check would go here
        // if (!HFApp.UserPermission("IssuePOs")) { ... }

        IsLoading = true;
        StateHasChanged();

        try
        {
            await LoadVendorsAsync();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}ShowForm]");

            Notifications.Error($"Error loading data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Load TBD Purchase Orders ===
    private async Task LoadDataAsync()
    {
        var sql = @"
            SELECT Community, CommunityDesc, Job, JobDesc, POGroup, POIndex, PONumber, PODesc, PODate,
                   NULL AS Vendor, NULL AS VendorDesc, Status
            FROM purchaseorders
            WHERE Cancelled = 0 AND PostingBatch = 0 AND isTBDVendor = 1
              AND DivisionID = @DivisionID";

        var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });

        AllData = rows.Select(r => new TBDPurchaseOrderRow
        {
            Community = r["Community"]?.ToString() ?? "",
            CommunityDesc = r["CommunityDesc"]?.ToString() ?? "",
            Job = r["Job"]?.ToString() ?? "",
            JobDesc = r["JobDesc"]?.ToString() ?? "",
            POGroup = r["POGroup"]?.ToString() ?? "",
            POIndex = r["POIndex"]?.ToString() ?? "",
            PONumber = r["PONumber"]?.ToString() ?? "",
            PODesc = r["PODesc"]?.ToString() ?? "",
            PODate = r["PODate"] != null && r["PODate"] != DBNull.Value
                ? Convert.ToDateTime(r["PODate"]).ToString("d") : "",
            Vendor = r["Vendor"]?.ToString() ?? "",
            VendorDesc = r["VendorDesc"]?.ToString() ?? "",
            Status = r["Status"]?.ToString() ?? ""
        }).ToList();

        ApplyFilter();
        mDirty = false;
    }

    // === Load Vendors for Pick List ===
    private async Task LoadVendorsAsync()
    {
        var sql = @"
            SELECT vendor_id AS Vendor, vendor_name AS Name
            FROM tblvendors
            WHERE ISNULL(istbd, 0) = 0 AND inactive = 0 AND DivisionID = @DivisionID
            ORDER BY vendor_name";

        var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });

        AllVendors = rows.Select(r => new VendorItem
        {
            VendorId = r["Vendor"]?.ToString() ?? "",
            VendorName = r["Name"]?.ToString() ?? ""
        }).ToList();

        FilteredVendors = AllVendors.ToList();
    }

    // === Apply Filter (mirrors VB6 ApplyFilter) ===
    private void ApplyFilter()
    {
        FilteredData = AllData.Where(row =>
            MatchesFilter(row.Community, FilterCommunity) &&
            MatchesFilter(row.CommunityDesc, FilterCommunityDesc) &&
            MatchesFilter(row.Job, FilterJob) &&
            MatchesFilter(row.JobDesc, FilterJobDesc) &&
            MatchesFilter(row.POGroup, FilterPOGroup) &&
            MatchesFilter(row.PONumber, FilterPONumber) &&
            MatchesFilter(row.PODesc, FilterPODesc) &&
            MatchesFilter(row.Vendor, FilterVendor) &&
            MatchesFilter(row.VendorDesc, FilterVendorDesc) &&
            MatchesFilter(row.Status, FilterStatus)
        ).ToList();

        StateHasChanged();
    }

    private bool MatchesFilter(string value, string filter)
    {
        if (string.IsNullOrEmpty(filter)) return true;
        return (value ?? "").Contains(filter, StringComparison.OrdinalIgnoreCase);
    }

    private void ClearFilters()
    {
        FilterCommunity = "";
        FilterCommunityDesc = "";
        FilterJob = "";
        FilterJobDesc = "";
        FilterPOGroup = "";
        FilterPONumber = "";
        FilterPODesc = "";
        FilterVendor = "";
        FilterVendorDesc = "";
        FilterStatus = "";
        ApplyFilter();
    }

    // === Vendor Button Click (mirrors VB6 gData_CellButtonClick) ===
    private async Task OnVendorButtonClick(TBDPurchaseOrderRow row)
    {
        VendorDialogTargetRow = row;
        VendorSearchText = "";
        SelectedVendor = null;
        FilteredVendors = AllVendors.ToList();
        IsVendorDialogVisible = true;
    }

    // Live-update VendorSearchText on every keystroke then re-filter (the old
    // <input> did this via @bind:event="oninput" @bind:after="FilterVendors").
    // TextBoxControl commits its bound value only on blur (@onchange), so to keep
    // the search filtering as-you-type we drive it through this pass-through
    // @oninput handler instead (TextBoxControl tolerates unmatched attributes).
    private void OnVendorSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        VendorSearchText = e.Value?.ToString() ?? "";
        FilterVendors();
    }

    private void FilterVendors()
    {
        if (string.IsNullOrWhiteSpace(VendorSearchText))
        {
            FilteredVendors = AllVendors.ToList();
        }
        else
        {
            FilteredVendors = AllVendors.Where(v =>
                (v.VendorId?.Contains(VendorSearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (v.VendorName?.Contains(VendorSearchText, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }
    }

    private async Task OnVendorDialogOk()
    {
        if (SelectedVendor == null) return;

        // Apply vendor to all selected rows (mirrors VB6 SelectedRows logic)
        var selectedRecords = DataGrid?.GetSelectedRecords()?.ToList();
        if (selectedRecords != null && selectedRecords.Count > 0)
        {
            foreach (var row in selectedRecords)
            {
                row.Vendor = SelectedVendor.VendorId;
                row.VendorDesc = SelectedVendor.VendorName;
            }
        }
        else if (VendorDialogTargetRow != null)
        {
            // Fall back to the row that was clicked
            VendorDialogTargetRow.Vendor = SelectedVendor.VendorId;
            VendorDialogTargetRow.VendorDesc = SelectedVendor.VendorName;
        }

        mDirty = true;
        IsVendorDialogVisible = false;
        StateHasChanged();

        if (DataGrid != null)
            await DataGrid.Refresh();
    }

    private void OnVendorDialogCancel()
    {
        IsVendorDialogVisible = false;
    }

    // === Save Click (mirrors VB6 cmdNav_Click Index=0) ===
    private async Task OnSaveClick()
    {
        if (!mDirty) return;
        await SaveData();
    }

    // === Cancel Click (mirrors VB6 cmdNav_Click Index=1) ===
    private async Task OnCancelClick()
    {
        if (mDirty)
        {
            var save = await Dialogs.ConfirmAsync(
                "Do you want to save these vendor assignments?");
            if (save)
            {
                await SaveData();
            }
        }

        ClosePage();
    }

    // === SaveData (mirrors VB6 SaveData) ===
    private async Task SaveData()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            int assignedCount = 0;
            int approvedCount = 0;
            var approvedPOs = new List<string>();

            var assignedRows = AllData.Where(r => !string.IsNullOrWhiteSpace(r.Vendor)).ToList();

            foreach (var row in assignedRows)
            {
                assignedCount++;

                // Change PO vendor
                await ChangePOVendor(row.PONumber, row.Vendor, true);

                if (string.Equals(row.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                {
                    approvedCount++;
                    approvedPOs.Add($"'{row.PONumber.Replace("'", "''")}'");
                }
            }

            if (assignedCount == 0)
            {
                return;
            }

            // Remove assigned rows from the list (mirrors VB6 RemoveItem)
            foreach (var row in assignedRows)
            {
                AllData.Remove(row);
            }
            ApplyFilter();

            // Check if we should send approved POs
            // VB6: If ApprovedCount > 0 And HFApp.UserPermission("SendPO") Then ...
            if (approvedCount > 0)
            {
                var sendNow = await Dialogs.ConfirmAsync(
                    $"{assignedCount} purchase orders have been assigned. {approvedCount} are approved. Do you want to send them now?");
                if (sendNow)
                {
                    // VB6: Call SendingWizard("PO", , Mid(ApprovedPOs, 2))
                    var poList = string.Join(",", approvedPOs);
                    Notifications.Info($"Sending wizard would be invoked for {approvedCount} approved PO(s). (Not yet implemented)");

                }
            }
            else
            {
                Notifications.Info($"{assignedCount} purchase orders have been assigned.");
            }

            mDirty = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}SaveData]");

            Notifications.Error($"Error saving data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === ChangePOVendor (mirrors VB6 ChangePOVendor call) ===
    private async Task ChangePOVendor(string poNumber, string vendor, bool updateDetails)
    {
        try
        {
            var sql = @"
                UPDATE purchaseorders
                SET Vendor = @Vendor, isTBDVendor = 0
                WHERE PONumber = @PONumber AND DivisionID = @DivisionID";

            await db.ExecuteAsync(sql, new
            {
                Vendor = vendor,
                PONumber = poNumber,
                SessionState.DivisionID
            });

            if (updateDetails)
            {
                var detailSql = @"
                    UPDATE PurchaseOrderDetails
                    SET Vendor = @Vendor
                    WHERE PONumber = @PONumber AND DivisionID = @DivisionID";

                await db.ExecuteAsync(detailSql, new
                {
                    Vendor = vendor,
                    PONumber = poNumber,
                    SessionState.DivisionID
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}ChangePOVendor] Error for PO {poNumber}");

            throw;
        }
    }

    // === Clear Vendor (mirrors VB6 gData_KeyDown with vbKeyDelete) ===
    private async Task OnClearVendorClick()
    {
        var selectedRecords = DataGrid?.GetSelectedRecords()?.ToList();
        if (selectedRecords == null || selectedRecords.Count == 0)
        {
            Notifications.Info("Select one or more rows first.");
            return;
        }

        foreach (var row in selectedRecords)
        {
            row.Vendor = "";
            row.VendorDesc = "";
        }

        mDirty = true;
        StateHasChanged();
        if (DataGrid != null)
            await DataGrid.Refresh();
    }

    // === Helpers ===
    private string DbQuote(string value)
    {
        return value?.Replace("'", "''") ?? "";
    }

    // === Model Classes ===
    public class TBDPurchaseOrderRow
    {
        public string Community { get; set; } = "";
        public string CommunityDesc { get; set; } = "";
        public string Job { get; set; } = "";
        public string JobDesc { get; set; } = "";
        public string POGroup { get; set; } = "";
        public string POIndex { get; set; } = "";
        public string PONumber { get; set; } = "";
        public string PODesc { get; set; } = "";
        public string PODate { get; set; } = "";
        public string Vendor { get; set; } = "";
        public string VendorDesc { get; set; } = "";
        public string Status { get; set; } = "";
    }

    public class VendorItem
    {
        public string VendorId { get; set; } = "";
        public string VendorName { get; set; } = "";
    }
}
