@page "/po-sending-wizard"
@page "/po-sending-wizard/{DocType}"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages
@layout HFComponent

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Components.Layout
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FSendingWizard> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer db

<PageTitle>PO Sending Wizard - HomeFront</PageTitle>

<div class="wizard-container">
    @* ── WIZARD HEADER ─────────────────────────────────────── *@
    <div class="wizard-header">
        <div class="wizard-header-icon">📧</div>
        <div class="wizard-header-text">
            <h4>@WizardCaption</h4>
            <p>@WizardDescription</p>
        </div>
    </div>

    @* ── WIZARD BODY ───────────────────────────────────────── *@
    <div class="wizard-body">
        @switch (CurrentFrame)
        {
            case 0:
                @* Frame 0: Task Selection *@
                <div class="frame-content">
                    <div class="frame-icon">📋</div>
                    <div class="frame-main">
                        <div class="frame-label">Choose the task you would like to perform</div>
                        @if (mDocType == "NOI")
                        {
                            <div class="task-option">
                                <RadioControl TValue="int" Name="sendTask" Value="0" @bind-SelectedValue="SelectedTask" Label="Send new Notices of Intent" />
                            </div>
                            <div class="task-option">
                                <RadioControl TValue="int" Name="sendTask" Value="1" @bind-SelectedValue="SelectedTask" Label="Resend a Notice of Intent" />
                            </div>
                        }
                        else if (mDocType == "RFQ")
                        {
                            <div class="task-option">
                                <RadioControl TValue="int" Name="sendTask" Value="2" @bind-SelectedValue="SelectedTask" Label="Send new RFP's" />
                            </div>
                            <div class="task-option">
                                <RadioControl TValue="int" Name="sendTask" Value="3" @bind-SelectedValue="SelectedTask" Label="Resend an RFP" />
                            </div>
                        }
                        else
                        {
                            <div class="task-option">
                                <RadioControl TValue="int" Name="sendTask" Value="0" @bind-SelectedValue="SelectedTask" Label="Send new purchase orders" />
                            </div>
                            <div class="task-option">
                                <RadioControl TValue="int" Name="sendTask" Value="1" @bind-SelectedValue="SelectedTask" Label="Resend a purchase order" />
                            </div>
                        }
                    </div>
                </div>
                break;

            case 1:
                @* Frame 1: Select Communities *@
                <div class="frame-content">
                    <div class="frame-icon">🏘️</div>
                    <div class="frame-main">
                        <div class="select-all-row">
                            <label>Select Communities</label>
                            <div class="select-all-check">
                                <CheckBoxControl Checked="@SelectAllCommunities" CheckedChanged="@(v => OnSelectAllChanged(1, v))" Label="Select All" />
                            </div>
                        </div>
                        <div class="grid-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th style="width:30px;"></th>
                                        <th>Community</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in CommunityData)
                                    {
                                        <tr>
                                            <td><CheckBoxControl @bind-Checked="item.IsChecked" @bind-Checked:after="() => UpdateSelectAll(1)" /></td>
                                            <td>@item.Code</td>
                                            <td>@item.Description</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                break;

            case 2:
                @* Frame 2: Select Jobs *@
                <div class="frame-content">
                    <div class="frame-icon">🏠</div>
                    <div class="frame-main">
                        <div class="select-all-row">
                            <label>@JobsLabel</label>
                            <div class="select-all-check">
                                <CheckBoxControl Checked="@SelectAllJobs" CheckedChanged="@(v => OnSelectAllChanged(2, v))" Label="Select All" />
                            </div>
                        </div>
                        <div class="grid-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th style="width:30px;"></th>
                                        <th>Job</th>
                                        <th>Description</th>
                                        @if (SelectedTask >= 2)
                                        {
                                            <th>RFP</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in JobData)
                                    {
                                        <tr>
                                            <td><CheckBoxControl @bind-Checked="item.IsChecked" @bind-Checked:after="() => UpdateSelectAll(2)" /></td>
                                            <td>@item.Code</td>
                                            <td>@item.Description</td>
                                            @if (SelectedTask >= 2)
                                            {
                                                <td>@item.Extra</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                break;

            case 3:
                @* Frame 3: Select Vendors *@
                <div class="frame-content">
                    <div class="frame-icon">🏢</div>
                    <div class="frame-main">
                        <div class="select-all-row">
                            <label>Select Vendors</label>
                            <div class="select-all-check">
                                <CheckBoxControl Checked="@SelectAllVendors" CheckedChanged="@(v => OnSelectAllChanged(3, v))" Label="Select All" />
                            </div>
                        </div>
                        <div class="grid-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th style="width:30px;"></th>
                                        <th>Vendor</th>
                                        <th>Name</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in VendorData)
                                    {
                                        <tr>
                                            <td><CheckBoxControl @bind-Checked="item.IsChecked" @bind-Checked:after="() => UpdateSelectAll(3)" /></td>
                                            <td>@item.Code</td>
                                            <td>@item.Description</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                break;

            case 4:
                @* Frame 4: Select PO Groups *@
                <div class="frame-content">
                    <div class="frame-icon">📦</div>
                    <div class="frame-main">
                        <div class="select-all-row">
                            <label>Select PO Groups</label>
                            <div class="select-all-check">
                                <CheckBoxControl Checked="@SelectAllPOGroups" CheckedChanged="@(v => OnSelectAllChanged(4, v))" Label="Select All" />
                            </div>
                        </div>
                        <div class="grid-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th style="width:30px;"></th>
                                        <th>PO Group</th>
                                        <th>PO Index</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in POGroupData)
                                    {
                                        <tr>
                                            <td><CheckBoxControl @bind-Checked="item.IsChecked" @bind-Checked:after="() => UpdateSelectAll(4)" /></td>
                                            <td>@item.Code</td>
                                            <td>@item.Extra</td>
                                            <td>@item.Description</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                break;

            case 5:
                @* Frame 5: Select Purchase Orders *@
                <div class="frame-content">
                    <div class="frame-icon">📄</div>
                    <div class="frame-main">
                        <div class="select-all-row">
                            <label>Select Purchase Orders</label>
                            <div class="select-all-check">
                                <CheckBoxControl Checked="@SelectAllPOs" CheckedChanged="@(v => OnSelectAllChanged(5, v))" Label="Select All" />
                            </div>
                        </div>
                        <div class="grid-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th style="width:30px;"></th>
                                        <th>PO Number</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in POData)
                                    {
                                        <tr>
                                            <td><CheckBoxControl @bind-Checked="item.IsChecked" @bind-Checked:after="() => UpdateSelectAll(5)" /></td>
                                            <td>@item.Code</td>
                                            <td>@item.Description</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                break;

            case 6:
                @* Frame 6: Finish / Processing *@
                <div class="frame-content">
                    <div class="frame-icon">✅</div>
                    <div class="frame-main">
                        <div class="finish-panel">
                            <div class="finish-info">@FinishMessage</div>

                            @if (PrintedPOCount > 0 && !IsProcessing)
                            {
                                <div class="printer-section">
                                    <div class="finish-info">@PrinterInfoMessage</div>
                                    <div class="field-row" style="margin-top:6px;">
                                        <label style="font-weight:700;">Printer:</label>
                                    </div>
                                    <DropDownListControl TValue="string" TItem="string" DataSource="@PrinterList" @bind-Value="SelectedPrinter" Width="100%" CssClass="printer-select" />
                                    <div class="field-row"><label>Status:</label><span>@PrinterStatus</span></div>
                                    <div class="field-row"><label>Model:</label><span>@PrinterModel</span></div>
                                    <div class="field-row"><label>Where:</label><span>@PrinterLocation</span></div>
                                    <div class="field-row"><label>Comment:</label><span>@PrinterComments</span></div>
                                </div>
                            }

                            @if (IsProcessing)
                            {
                                <div class="processing-labels">
                                    <div><strong>Processing:</strong></div>
                                    <div class="progress-bar-container">
                                        <div class="progress-bar-fill" style="width: @ProgressPercent%;">
                                            @if (ProgressMax > 0)
                                            {
                                                @($"{ProgressValue} of {ProgressMax}")
                                            }
                                        </div>
                                    </div>
                                    <div style="margin-top:4px;">@ProgressCountLabel</div>
                                    <div>@ProgressItemLabel</div>
                                </div>
                                <TextAreaControl Value="@StatusText" CssClass="status-text" />
                            }
                        </div>
                    </div>
                </div>
                break;
        }
    </div>

    @* ── WIZARD FOOTER ─────────────────────────────────────── *@
    <div class="wizard-footer">
        <ButtonControl OnClick="OnCancelClick">Cancel</ButtonControl>
        <ButtonControl Disabled="@(!CanGoBack)" OnClick="OnBackClick">&lt; Back</ButtonControl>
        <ButtonControl Disabled="@(!CanGoNext)" OnClick="OnNextClick">Next &gt;</ButtonControl>
        <ButtonControl CssClass="btn-primary" Disabled="@(!CanFinish)" OnClick="OnFinishClick">Finish</ButtonControl>
    </div>
</div>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    // === Database ===
// === Parameters ===
    [Parameter] public string? Job { get; set; }

    // === Wizard State ===
    private int CurrentFrame = 0;
    private int SelectedTask = 0; // 0=Send new POs, 1=Resend PO, 2=Send new RFPs, 3=Resend RFP
    private bool IsProcessing = false;

    // === Document type (VB6 SendingWizard DocType: PO | RFQ | NOI) ===
    [Parameter] public string? DocType { get; set; }
    private string mDocType = "PO";

    // === Header ===
    private string WizardCaption => mDocType switch
    {
        "NOI" => "Send Notices of Intent to vendors",
        "RFQ" => "Send RFP's to vendors",
        _ => "Send purchase orders to vendors"
    };
    private string WizardDescription => mDocType switch
    {
        "NOI" => "The Sending wizard will help you deliver your Notices of Intent.",
        "RFQ" => "The Sending wizard will help you deliver your RFP's.",
        _ => "The PO Sending wizard will help you deliver your purchase orders."
    };

    // === Navigation ===
    private bool CanGoBack => CurrentFrame > 0 && !IsProcessing;
    private bool CanGoNext => CurrentFrame < 6 && !IsProcessing;
    private bool CanFinish => CurrentFrame == 6 && !IsProcessing;

    // === Data Lists ===
    private List<GridRowItem> CommunityData = new();
    private List<GridRowItem> JobData = new();
    private List<GridRowItem> VendorData = new();
    private List<GridRowItem> POGroupData = new();
    private List<GridRowItem> POData = new();

    // === Select All Flags ===
    private bool SelectAllCommunities = true;
    private bool SelectAllJobs = true;
    private bool SelectAllVendors = true;
    private bool SelectAllPOGroups = true;
    private bool SelectAllPOs = true;

    // === Finish Frame ===
    private int AllPOCount = 0;
    private int PrintedPOCount = 0;
    private string FinishMessage = "";
    private string PrinterInfoMessage = "";

    // === Printer ===
    private List<string> PrinterList = new() { "Default Printer" };
    private string SelectedPrinter = "Default Printer";
    private string PrinterStatus = "Ready";
    private string PrinterModel = "";
    private string PrinterLocation = "";
    private string PrinterComments = "";

    // === Progress ===
    private int ProgressValue = 0;
    private int ProgressMax = 0;
    private double ProgressPercent => ProgressMax > 0 ? (double)ProgressValue / ProgressMax * 100 : 0;
    private string ProgressCountLabel = "";
    private string ProgressItemLabel = "";
    private string StatusText = "";

    // === Labels ===
    private string JobsLabel => SelectedTask >= 2 ? "Select Jobs/RFP's" : "Select Jobs";

    // === Lifecycle ===
    protected override void OnInitialized()
    {
        mDocType = (DocType ?? "").Trim().ToUpperInvariant() switch
        {
            "NOI" => "NOI",
            "RFQ" or "RFP" => "RFQ",
            _ => "PO"
        };
        // RFQ defaults to "Send new RFP's" (task 2); PO and NOI use the PO-flow tasks (0/1).
        SelectedTask = mDocType == "RFQ" ? 2 : 0;
        _ = SetCurrentFrame(0, true);
    }

    // === Navigation ===
    private async Task OnCancelClick()
    {
        ClosePage();
    }

    private async Task OnBackClick()
    {
        await SetCurrentFrame(GetPreviousFrame(), false);
    }

    private async Task OnNextClick()
    {
        await SetCurrentFrame(GetNextFrame(), true);
    }

    private async Task OnFinishClick()
    {
        if (mDocType == "NOI")
        {
            await SendNOIs();   // see SendNOIs() — recipient selection is faithful; NOI document delivery is HFSend-owned
        }
        else if (SelectedTask < 2)
        {
            if (await SendPOs())
                ClosePage();
        }
        else
        {
            if (await SendRFPs())
                ClosePage();
        }
    }

    // VB6: SendingWizard("NOI") shells HFSend.exe, which builds AND delivers the Notice-of-Intent
    // document. NOI is grouped with PO sending (same "sendpos" command bar, same
    // SendNOIsFromPrecisionBuilder gating as SendPOsFromPrecisionBuilder), so the recipient-selection
    // frames above are the faithful PO-flow. BUT the NOI document definition + delivery live entirely
    // in HFSend.exe, whose source is NOT part of this migration — there is no NOI report (NOI.rpt) or
    // NOI data/marking in the available source. We therefore do NOT fabricate a document send here:
    // the wizard collects recipients faithfully and surfaces that final delivery is pending the HFSend
    // NOI spec. (When that spec is available, mirror SendPOs() delivery with the NOI document.)
    private async Task<bool> SendNOIs()
    {
        await Task.CompletedTask;
        Notifications.Warning("Notice-of-Intent recipients selected. NOI document generation & delivery " +
            "is handled by the HFSend service, whose definition is not part of this migration's source — " +
            "no NOI was sent. (Wire SendNOIs() to the HFSend NOI document once that spec is available.)");
        return false; // keep the wizard open so the message is visible
    }

    private int GetNextFrame()
    {
        var next = CurrentFrame + 1;
        if (SelectedTask < 2)
        {
            // PO flow: 0 -> 1 -> 2 -> 3 -> 4 -> 5 -> 6
            if (next == 1 && !string.IsNullOrEmpty(Job)) next = 3;
        }
        else
        {
            // RFP flow: 0 -> 2 -> 3 -> 6 (skip 1, 4, 5)
            if (next == 1) next = 2;
            if (next == 4) next = 6;
        }
        return Math.Min(next, 6);
    }

    private int GetPreviousFrame()
    {
        var prev = CurrentFrame - 1;
        if (SelectedTask < 2)
        {
            if (prev == 2 && !string.IsNullOrEmpty(Job)) prev = 0;
        }
        else
        {
            // RFP flow backwards
            if (prev == 5) prev = 3;
            if (prev == 4) prev = 3;
            if (prev == 1) prev = 0;
        }
        return Math.Max(prev, 0);
    }

    private async Task SetCurrentFrame(int frame, bool forward)
    {
        CurrentFrame = frame;

        if (SelectedTask < 2)
        {
            // PO flow
            switch (frame)
            {
                case 1:
                    if (forward) await LoadCommunities();
                    break;
                case 2:
                    if (forward) await LoadJobs();
                    break;
                case 3:
                    if (forward) await LoadVendors();
                    break;
                case 4:
                    if (forward) await LoadPOGroups();
                    break;
                case 5:
                    if (forward) await LoadPurchaseOrders();
                    break;
                case 6:
                    await LoadFinishSummary();
                    break;
            }
        }
        else
        {
            // RFP flow
            switch (frame)
            {
                case 2:
                    if (forward) await LoadRFPJobs();
                    break;
                case 3:
                    if (forward) await LoadRFPVendors();
                    break;
                case 6:
                    await LoadRFPFinishSummary();
                    break;
            }
        }

        StateHasChanged();
    }

    // === PO Data Loading ===
    private async Task LoadCommunities()
    {
        try
        {
            var whereClause = BuildPOWhereClause(1);
            var sql = $"SELECT DISTINCT Community, CommunityDesc FROM PurchaseOrders p {whereClause} ORDER BY 1";
            var rows = await db.QueryAsync(sql);
            CommunityData = rows.Select(r => new GridRowItem
            {
                Code = r["Community"]?.ToString() ?? "",
                Description = r["CommunityDesc"]?.ToString() ?? "",
                IsChecked = true
            }).ToList();
            SelectAllCommunities = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadCommunities error");

            CommunityData = new();
        }
    }

    private async Task LoadJobs()
    {
        try
        {
            var whereClause = BuildPOWhereClause(2);
            var sql = $"SELECT DISTINCT Job, JobDesc FROM PurchaseOrders p {whereClause} ORDER BY 1";
            var rows = await db.QueryAsync(sql);
            JobData = rows.Select(r => new GridRowItem
            {
                Code = r["Job"]?.ToString() ?? "",
                Description = r["JobDesc"]?.ToString() ?? "",
                IsChecked = true
            }).ToList();
            SelectAllJobs = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadJobs error");

            JobData = new();
        }
    }

    private async Task LoadVendors()
    {
        try
        {
            var whereClause = BuildPOWhereClause(3);
            var sql = $"SELECT DISTINCT Vendor, VendorDesc FROM PurchaseOrders p {whereClause} ORDER BY 1";
            var rows = await db.QueryAsync(sql);
            VendorData = rows.Select(r => new GridRowItem
            {
                Code = r["Vendor"]?.ToString() ?? "",
                Description = r["VendorDesc"]?.ToString() ?? "",
                IsChecked = true
            }).ToList();
            SelectAllVendors = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadVendors error");

            VendorData = new();
        }
    }

    private async Task LoadPOGroups()
    {
        try
        {
            var whereClause = BuildPOWhereClause(4);
            var sql = $"SELECT DISTINCT POGroup, POIndex, CASE WHEN POIndex=POIndexDescription THEN '' ELSE POIndexDescription END FROM PurchaseOrders p {whereClause} ORDER BY 1, 2";
            var rows = await db.QueryAsync(sql);
            POGroupData = rows.Select(r =>
            {
                var vals = r.Values.ToArray();
                return new GridRowItem
                {
                    Code = vals[0]?.ToString() ?? "",
                    Extra = vals[1]?.ToString() ?? "",
                    Description = vals[2]?.ToString() ?? "",
                    IsChecked = true
                };
            }).ToList();
            SelectAllPOGroups = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadPOGroups error");

            POGroupData = new();
        }
    }

    private async Task LoadPurchaseOrders()
    {
        try
        {
            var whereClause = BuildPOWhereClause(5);
            var sql = $"SELECT DISTINCT PONumber, PODesc + char(9) + DeliveryAddress AS PODesc FROM PurchaseOrders p {whereClause} ORDER BY 1";
            var rows = await db.QueryAsync(sql);
            POData = rows.Select(r => new GridRowItem
            {
                Code = r["PONumber"]?.ToString() ?? "",
                Description = (r["PODesc"]?.ToString() ?? "").Replace("\t", " - "),
                IsChecked = true
            }).ToList();
            SelectAllPOs = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadPurchaseOrders error");

            POData = new();
        }
    }

    // Defensive integer reader — handles null / DBNull / strings / decimals
    // (SQL Server returns SUM() as decimal in many cases) without throwing.
    private static int ToInt(object? value)
    {
        if (value == null || value == DBNull.Value) return 0;
        if (value is int i) return i;
        if (value is long l) return (int)l;
        if (value is decimal d) return (int)d;
        if (value is double db) return (int)db;
        if (int.TryParse(value.ToString(), out var parsed)) return parsed;
        return 0;
    }

    private async Task LoadFinishSummary()
    {
        try
        {
            // VB6 (FPOSendingWizard.frm:1271) reads the two aggregates by
            // ordinal — `rs(0)` / `rs(1)` — which works because ADO recordsets
            // expose unnamed columns positionally. DotNet's QueryAsync returns
            // a Dictionary<string, object> keyed by column name; two columns
            // both named "" collide and the second one overwrites the first,
            // leaving only one entry. Alias the aggregates so each lands in
            // its own dict slot.
            var whereClause = BuildPOWhereClause(6);
            var sql = $@"SELECT COUNT(DISTINCT PONumber)                                     AS AllPOs,
                                SUM(CASE ISNULL(DeliveryMethod,0) WHEN 0 THEN 1 ELSE 0 END)  AS PrintedPOs
                           FROM PurchaseOrders p {whereClause}";
            var rows = await db.QueryAsync(sql);
            if (rows.Count > 0)
            {
                AllPOCount     = ToInt(rows[0]["AllPOs"]);
                PrintedPOCount = ToInt(rows[0]["PrintedPOs"]);
            }
            else
            {
                AllPOCount = PrintedPOCount = 0;
            }
            ProgressMax = AllPOCount;
            FinishMessage = $"Ready for processing. You have selected {AllPOCount} purchase orders for sending. Click Finish to send these documents now.";
            PrinterInfoMessage = $"{PrintedPOCount} documents are set to print. They will be sent to:";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadFinishSummary error");

            FinishMessage = "Error loading summary.";
        }
    }

    // === RFP Data Loading ===
    private async Task LoadRFPJobs()
    {
        try
        {
            var sql = "SELECT DISTINCT Job, Title, RFP FROM RFPs ORDER BY 1, 2";
            var rows = await db.QueryAsync(sql);
            JobData = rows.Select(r => new GridRowItem
            {
                Code = r["Job"]?.ToString() ?? "",
                Description = r["Title"]?.ToString() ?? "",
                Extra = r["RFP"]?.ToString() ?? "",
                IsChecked = true
            }).ToList();
            SelectAllJobs = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadRFPJobs error");

            JobData = new();
        }
    }

    private async Task LoadRFPVendors()
    {
        try
        {
            var whereClause = BuildRFPWhereClause(3);
            var sql = $"SELECT DISTINCT b.vendor, v.vendor_name FROM vendorbids b JOIN tblvendors v ON (b.vendor=v.vendor_id) {whereClause} ORDER BY 1";
            var rows = await db.QueryAsync(sql);
            VendorData = rows.Select(r => new GridRowItem
            {
                Code = r["vendor"]?.ToString() ?? "",
                Description = r["vendor_name"]?.ToString() ?? "",
                IsChecked = true
            }).ToList();
            SelectAllVendors = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadRFPVendors error");

            VendorData = new();
        }
    }

    private async Task LoadRFPFinishSummary()
    {
        try
        {
            // Same fix as LoadFinishSummary — alias the aggregates so
            // unnamed columns don't collide in the result dictionary.
            var whereClause = BuildRFPWhereClause(6);
            var sql = $@"SELECT COUNT(*)                                                       AS AllPOs,
                                SUM(CASE ISNULL(PurchDelMethod,0) WHEN 0 THEN 1 ELSE 0 END)    AS PrintedPOs
                           FROM VendorBids b
                           JOIN tblvendors v ON (b.vendor = v.vendor_id) {whereClause}";
            var rows = await db.QueryAsync(sql);
            if (rows.Count > 0)
            {
                AllPOCount     = ToInt(rows[0]["AllPOs"]);
                PrintedPOCount = ToInt(rows[0]["PrintedPOs"]);
            }
            else
            {
                AllPOCount = PrintedPOCount = 0;
            }
            ProgressMax = AllPOCount;
            FinishMessage = $"Ready for processing. You have selected {AllPOCount} documents for sending. Click Finish to send these documents now.";
            PrinterInfoMessage = $"{PrintedPOCount} documents are set to print. They will be sent to:";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadRFPFinishSummary error");

            FinishMessage = "Error loading summary.";
        }
    }

    // === WHERE Clause Builders ===
    // SECURITY / SQL-injection note (deferred identifier-pass audit, 2026-06-14):
    // Every dynamic fragment these builders emit comes from APP-INTERNAL state, not
    // free-typed user input, so there is nothing here that needs parameterizing:
    //   • the column/table names ("Community","Job","Vendor","POIndex","PONumber",
    //     "p","b.rfp","b.vendor") are all hardcoded literals in this file;
    //   • the IN(...) value lists are built by FormatInClause/EscapeSql from the
    //     CODE values of grid rows the user merely CHECKED (GetSelectedCodes /
    //     POGroupData.Extra) — codes the wizard itself loaded from the DB a step
    //     earlier, never typed; each value is single-quoted and '-escaped (the VB6
    //     DbQuote(Str,…) equivalent — see FPOSendingWizard.frm BuildWhereClause);
    //   • Job is a caller-supplied [Parameter] (a job number passed in by the
    //     opening form, mirroring VB6 mJob = Job), and it too is EscapeSql'd.
    // Mirrors VB6 exactly (FPOSendingWizard.frm:1388-1471): the IN-list must stay a
    // dynamically-assembled quoted-literal list, so this is intentionally left as a
    // string build rather than a parameterized query.
    private string BuildPOWhereClause(int frameIndex)
    {
        var c = $" WHERE Delivered={(SelectedTask == 1 ? "1" : "0")}";

        if (!string.IsNullOrEmpty(Job))
        {
            c += $" AND job='{EscapeSql(Job)}'";
        }
        else
        {
            if (frameIndex > 1 && !SelectAllCommunities)
            {
                var selected = GetSelectedCodes(CommunityData);
                c += selected.Any() ? $" AND p.Community IN({FormatInClause(selected)})" : " AND 1=2";
            }

            if (frameIndex > 2 && !SelectAllJobs)
            {
                var selected = GetSelectedCodes(JobData);
                c += selected.Any() ? $" AND p.Job IN({FormatInClause(selected)})" : " AND 1=2";
            }
        }

        if (frameIndex > 3 && !SelectAllVendors)
        {
            var selected = GetSelectedCodes(VendorData);
            c += selected.Any() ? $" AND p.Vendor IN({FormatInClause(selected)})" : " AND 1=2";
        }

        if (frameIndex > 4 && !SelectAllPOGroups)
        {
            var selected = POGroupData.Where(x => x.IsChecked).Select(x => x.Extra).ToList();
            c += selected.Any() ? $" AND p.POIndex IN({FormatInClause(selected)})" : " AND 1=2";
        }

        if (frameIndex > 5 && !SelectAllPOs)
        {
            var selected = GetSelectedCodes(POData);
            c += selected.Any() ? $" AND p.PONumber IN({FormatInClause(selected)})" : " AND 1=2";
        }

        return c;
    }

    // Same provenance/escaping guarantee as BuildPOWhereClause above — all
    // fragments come from app-internal grid-selection state, not free-typed input.
    // (VB6 parity: FPOSendingWizard.frm:1342-1373.)
    private string BuildRFPWhereClause(int frameIndex)
    {
        var c = " WHERE b.SentDate" + (SelectedTask == 3 ? " IS NOT NULL" : " IS NULL");

        if (frameIndex > 2 && !SelectAllJobs)
        {
            // b.rfp is a numeric RFP id pulled from the (DB-loaded) JobData grid's
            // Extra column for the rows the user checked — not typed, so VB6 leaves
            // it unquoted (FPOSendingWizard.frm:1356 "IN(" & Mid(s,2) & ")"). Kept
            // identical; the values are app-internal ids, never user free-text.
            var selected = JobData.Where(x => x.IsChecked).Select(x => x.Extra).ToList();
            c += selected.Any() ? $" AND b.rfp IN({string.Join(",", selected)})" : " AND 1=2";
        }

        if (frameIndex > 3 && !SelectAllVendors)
        {
            var selected = GetSelectedCodes(VendorData);
            c += selected.Any() ? $" AND b.vendor IN({FormatInClause(selected)})" : " AND 1=2";
        }

        return c;
    }

    // === Send POs ===
    private async Task<bool> SendPOs()
    {
        IsProcessing = true;
        StatusText = "";
        ProgressValue = 0;
        StateHasChanged();

        try
        {
            var whereClause = BuildPOWhereClause(99);
            // VB6: If SendPO_CCPrjMgr option is set, join project manager to get PM email for CC
            // For now, include the PM email join by default (matches VB6 extended query)
            var sql = $@"SELECT p.DeliveryMethod, p.DeliveryAddress, p.POFormat, p.PONumber, p.VendorDesc, ISNULL(pm.email,'') AS PMEmail
                         FROM PurchaseOrders p
                         LEFT OUTER JOIN tblJobs j ON (p.job=j.job_no)
                         LEFT OUTER JOIN tblProjectManager pm ON (j.pm=pm.pm)
                         {whereClause} ORDER BY 1, 2, 5";
            var rows = await db.QueryAsync(sql);

            int i = 0;
            string prevSendVia = "", prevAddress = "", prevFormat = "", prevPMEmail = "";
            var poNumbers = new List<string>();

            foreach (var row in rows)
            {
                i++;
                var sendVia = row["DeliveryMethod"]?.ToString() ?? "0";
                var address = row["DeliveryAddress"]?.ToString() ?? "";
                var format = row["POFormat"]?.ToString() ?? "";
                var pmEmail = row["PMEmail"]?.ToString() ?? "";
                var poNumber = row["PONumber"]?.ToString() ?? "";
                var vendorDesc = row["VendorDesc"]?.ToString() ?? "";

                ProgressValue = i;
                ProgressCountLabel = $"Purchase Order {i} of {ProgressMax}";
                ProgressItemLabel = $"{poNumber} -- {vendorDesc}";
                StateHasChanged();
                await Task.Delay(1); // Allow UI to update

                if (sendVia != prevSendVia || address != prevAddress || format != prevFormat || pmEmail != prevPMEmail)
                {
                    if (poNumbers.Any())
                    {
                        await SendPOGroup(int.Parse(prevSendVia), prevAddress, prevPMEmail, prevFormat, poNumbers);
                    }
                    prevSendVia = sendVia;
                    prevAddress = address;
                    prevFormat = format;
                    prevPMEmail = pmEmail;
                    poNumbers = new List<string>();
                }

                poNumbers.Add(poNumber);
            }

            if (poNumbers.Any())
            {
                await SendPOGroup(int.Parse(prevSendVia.Length > 0 ? prevSendVia : "0"), prevAddress, prevPMEmail, prevFormat, poNumbers);
            }

            return true;
        }
        catch (Exception ex)
        {
            StatusText += $"Error: {ex.Message}\n";
            Notifications.Error($"Failed to send POs: {ex.Message}");
            return false;
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task SendPOGroup(int sendVia, string recipient, string ccRecipient, string rptFormat, List<string> poNumbers)
    {
        if (!poNumbers.Any() || string.IsNullOrEmpty(rptFormat)) return;

        // poNumbers were read straight out of the PO query result rows above
        // (row["PONumber"]), never typed by the user; FormatInClause '-escapes each
        // one. Safe to interpolate into the PONumber IN(...) clauses below (the
        // sender/attachment lookups and the "mark sent" UPDATE POMaster), matching
        // VB6 (FPOSendingWizard.frm:1713/1812 "WHERE p.PONumber IN(" & PONumbers & ")").
        var poNumbersInClause = FormatInClause(poNumbers);

        // VB6: dtFax -> dtPrint fallback; empty recipient -> dtPrint
        if (sendVia == 2) sendVia = 0;
        if (string.IsNullOrWhiteSpace(recipient)) sendVia = 0;

        StatusText += "Loading PO format...\n";
        StatusText += "Reading data...\n";
        StateHasChanged();
        await Task.Delay(1);

        // VB6: Query sender/recipient info for email subject/body templates
        try
        {
            var infoSql = $@"SELECT pm.PMName SenderName
                  ,s.CompanyName SenderCompany
                  ,CASE WHEN s.SendFaxUsingPurchasersInfo=1 THEN pm.fax   ELSE s.fax END SenderFax
                  ,CASE WHEN s.SendFaxUsingPurchasersInfo=1 THEN pm.phone ELSE s.fax END SenderPhone
                  ,CASE WHEN s.SendFaxUsingPurchasersInfo=1 THEN pm.email ELSE s.estimator_email END SenderEmail
                  ,v.PurchContact RecipientName
                  ,v.Vendor_Name RecipientCompany
                  ,v.PurchFax RecipientFax
                  ,v.PurchPhone RecipientPhone
                  ,v.PurchEmail RecipientEmail
                  ,p.Job Quote
                  ,p.Job
                  ,p.Vendor
                  ,v.Vendor_Name VendorName
                  ,j.Model
                  ,j.Municipal_Address MunicipalAddress
                  ,j.Legal_Address LegalAddress
                  ,j.County
                  ,j.Township
                  ,ISNULL(NULLIF(l.Description,''),j.Community) Community
                  ,ISNULL(NULLIF(a.Description,''),j.CommunityPhase) Phase
              FROM System_setup s
                  ,POMaster p
                   LEFT OUTER JOIN tblJobs j on(p.Job=j.Job_no)
                   LEFT OUTER JOIN tblProjectManager pm on(j.Purchaser=pm.PM)
                   LEFT OUTER JOIN tblVendors v on(p.vendor=v.vendor_id)
                   LEFT OUTER JOIN tblLocality l on(j.community=l.area)
                   LEFT OUTER JOIN CommunityPhase a on(j.CommunityPhase=a.CommunityPhase)
             WHERE p.PONumber IN({poNumbersInClause})";
            var infoRows = await db.QueryAsync(infoSql);
            var info = infoRows.FirstOrDefault();

            switch (sendVia)
            {
                case 0: // Print
                    // VB6: Crystal Reports SelectPrinter + PrintOut
                    StatusText += $"Printing {poNumbers.Count} PO(s) to {SelectedPrinter}...\n";
                    StatusText += "Crystal Reports printing is not yet available in the web application.\n";
                    break;

                case 1: // Email
                    StatusText += "Retrieving attachments...\n";
                    StateHasChanged();
                    await Task.Delay(1);

                    // VB6: Query POIndexDocuments for attached documents
                    var attachSql = $@"SELECT DISTINCT p.Job, a.FileName, a.Embedded
                         FROM POMaster p
                         JOIN Attachments a ON(a.ObjectID='J~'+p.Job)
                         JOIN POIndexDocuments i ON(p.POIndex=i.POIndex AND a.DocumentClass=i.Class)
                         WHERE p.IncludeDocuments = 1 AND p.PONumber IN({poNumbersInClause})";
                    var attachRows = await db.QueryAsync(attachSql);
                    var attachmentCount = attachRows.Count;

                    StatusText += $"Found {attachmentCount} attachment(s).\n";

                    // VB6: Generate PDF via Crystal Reports, then send via SMTP or MAPI
                    var vendorName = info != null && info.ContainsKey("VendorName")
                        ? info["VendorName"]?.ToString() ?? "" : "";
                    StatusText += $"Sending email to {recipient} for {vendorName}...\n";
                    // Email sending requires server-side SMTP implementation
                    StatusText += "Email sending is not yet available in the web application.\n";
                    break;
            }
        }
        catch (Exception ex)
        {
            StatusText += $"Error preparing PO group: {ex.Message}\n";
        }

        // Mark sent date
        try
        {
            await db.ExecuteAsync($"UPDATE POMaster SET DeliveryDate=GETDATE() WHERE PONumber IN({poNumbersInClause})");
            StatusText += $"Marked {poNumbers.Count} PO(s) as sent.\n";
        }
        catch (Exception ex)
        {
            StatusText += $"Error marking sent: {ex.Message}\n";
        }

        StateHasChanged();
    }

    // === Send RFPs ===
    private async Task<bool> SendRFPs()
    {
        IsProcessing = true;
        StatusText = "";
        ProgressValue = 0;
        StateHasChanged();

        try
        {
            var whereClause = BuildRFPWhereClause(99);
            var sql = $@"SELECT PurchDelMethod, 
                                CASE purchdelmethod WHEN 1 THEN purchemail WHEN 2 THEN purchfax ELSE '' END AS address,
                                v.Vendor_id, v.Vendor_Name, b.rfp
                         FROM vendorbids b
                         JOIN tblvendors v ON (b.vendor=v.vendor_id)
                         {whereClause}
                         ORDER BY 1, 2, 3, 5";
            var rows = await db.QueryAsync(sql);

            int i = 0;
            foreach (var row in rows)
            {
                i++;
                ProgressValue = i;
                ProgressCountLabel = $"RFP {i} of {ProgressMax}";
                ProgressItemLabel = row["Vendor_Name"]?.ToString() ?? "";
                StateHasChanged();
                await Task.Delay(1);

                var sendVia = Convert.ToInt32(row["PurchDelMethod"] ?? 0);
                var address = row["address"]?.ToString() ?? "";
                var rfp = Convert.ToInt64(row["rfp"] ?? 0);
                var vendor = row["Vendor_id"]?.ToString() ?? "";

                await SendRFPGroup(sendVia, address, rfp, vendor);
            }

            return true;
        }
        catch (Exception ex)
        {
            StatusText += $"Error: {ex.Message}\n";
            Notifications.Error($"Failed to send RFPs: {ex.Message}");
            return false;
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task SendRFPGroup(int sendVia, string recipient, long rfp, string vendor)
    {
        if (rfp == 0 || string.IsNullOrEmpty(vendor)) return;

        // VB6: dtFax -> dtPrint fallback; empty recipient -> dtPrint
        if (sendVia == 2) sendVia = 0;
        if (string.IsNullOrWhiteSpace(recipient)) sendVia = 0;

        StatusText += "Reading RFP...\n";
        StatusText += "Reading data...\n";
        StateHasChanged();
        await Task.Delay(1);

        // VB6: Crystal Reports RFQ.rpt with RFP and Vendor parameters
        // Query sender/recipient info for email subject/body templates
        try
        {
            var infoSql = $@"SELECT CASE WHEN s.SendFaxUsingPurchasersInfo=1 THEN pm.pmname ELSE s.companyname END SenderName
                  ,s.CompanyName SenderCompany
                  ,CASE WHEN s.SendFaxUsingPurchasersInfo=1 THEN pm.fax   ELSE s.fax END SenderFax
                  ,CASE WHEN s.SendFaxUsingPurchasersInfo=1 THEN pm.phone ELSE s.fax END SenderPhone
                  ,CASE WHEN s.SendFaxUsingPurchasersInfo=1 THEN pm.email ELSE s.estimator_email END SenderEmail
                  ,v.PurchContact RecipientName
                  ,v.Vendor_Name RecipientCompany
                  ,v.PurchFax RecipientFax
                  ,v.PurchPhone RecipientPhone
                  ,v.PurchEmail RecipientEmail
                  ,p.Job Quote
                  ,p.Job
                  ,p.RFP
                  ,b.Vendor
                  ,b.BidGUID
                  ,v.Vendor_Name VendorName
                  ,j.Model
                  ,j.Municipal_Address MunicipalAddress
                  ,j.Legal_Address LegalAddress
                  ,j.County
                  ,j.Township
                  ,ISNULL(NULLIF(l.Description,''),j.Community) Community
                  ,ISNULL(NULLIF(a.Description,''),j.CommunityPhase) Phase
              FROM System_setup s
                  ,RFPs p
                   JOIN VendorBids b on(p.rfp=b.rfp)
                   LEFT OUTER JOIN tblJobs j on(p.Job=j.Job_no)
                   LEFT OUTER JOIN tblProjectManager pm on(j.Purchaser=pm.PM)
                   LEFT OUTER JOIN tblVendors v on(b.vendor=v.vendor_id)
                   LEFT OUTER JOIN tblLocality l on(j.community=l.area)
                   LEFT OUTER JOIN CommunityPhase a on(j.CommunityPhase=a.CommunityPhase)
             WHERE p.RFP=@RFP AND b.vendor=@Vendor";
            var infoRows = await db.QueryAsync(infoSql, new { RFP = rfp, Vendor = vendor });
            var info = infoRows.FirstOrDefault();

            var vendorName = info != null && info.ContainsKey("VendorName")
                ? info["VendorName"]?.ToString() ?? "" : "";

            switch (sendVia)
            {
                case 0: // Print
                    // VB6: Crystal Reports SelectPrinter + PrintOut
                    StatusText += $"Printing RFP {rfp} for {vendorName} to {SelectedPrinter}...\n";
                    StatusText += "Crystal Reports printing is not yet available in the web application.\n";
                    break;

                case 1: // Email
                    StatusText += "Retrieving attachments...\n";
                    StateHasChanged();
                    await Task.Delay(1);

                    // VB6: Query attachments for ObjectID='RFP~{rfp}'
                    var attachSql = "SELECT DISTINCT FileName, Embedded, FileTitle FROM Attachments WHERE ObjectID=@ObjectId";
                    var attachRows = await db.QueryAsync(attachSql, new { ObjectId = $"RFP~{rfp}" });
                    StatusText += $"Found {attachRows.Count} attachment(s).\n";

                    // VB6: Options for AttachRFP_PDF or AttachRFP_XLS, then send via MAPI or SMTP
                    StatusText += $"Sending email to {recipient} for {vendorName}...\n";
                    StatusText += "Email sending is not yet available in the web application.\n";
                    break;
            }
        }
        catch (Exception ex)
        {
            StatusText += $"Error preparing RFP group: {ex.Message}\n";
        }

        // Mark sent date
        try
        {
            await db.ExecuteAsync("UPDATE vendorbids SET SentDate=GETDATE() WHERE RFP=@RFP AND Vendor=@Vendor",
                new { RFP = rfp, Vendor = vendor });
            StatusText += $"Marked RFP {rfp} / Vendor {vendor} as sent.\n";
        }
        catch (Exception ex)
        {
            StatusText += $"Error marking sent: {ex.Message}\n";
        }

        StateHasChanged();
    }

    // === Select All Handling ===
    private void OnSelectAllChanged(int frame, bool isChecked)
    {
        switch (frame)
        {
            case 1:
                SelectAllCommunities = isChecked;
                foreach (var item in CommunityData) item.IsChecked = isChecked;
                break;
            case 2:
                SelectAllJobs = isChecked;
                foreach (var item in JobData) item.IsChecked = isChecked;
                break;
            case 3:
                SelectAllVendors = isChecked;
                foreach (var item in VendorData) item.IsChecked = isChecked;
                break;
            case 4:
                SelectAllPOGroups = isChecked;
                foreach (var item in POGroupData) item.IsChecked = isChecked;
                break;
            case 5:
                SelectAllPOs = isChecked;
                foreach (var item in POData) item.IsChecked = isChecked;
                break;
        }
    }

    private void UpdateSelectAll(int frame)
    {
        switch (frame)
        {
            case 1:
                SelectAllCommunities = CommunityData.All(x => x.IsChecked);
                break;
            case 2:
                SelectAllJobs = JobData.All(x => x.IsChecked);
                break;
            case 3:
                SelectAllVendors = VendorData.All(x => x.IsChecked);
                break;
            case 4:
                SelectAllPOGroups = POGroupData.All(x => x.IsChecked);
                break;
            case 5:
                SelectAllPOs = POData.All(x => x.IsChecked);
                break;
        }
    }

    // === Helpers ===
    private List<string> GetSelectedCodes(List<GridRowItem> data)
    {
        return data.Where(x => x.IsChecked).Select(x => x.Code).ToList();
    }

    // Builds a quoted, '-escaped comma list for a SQL IN(...) clause. Inputs are
    // always app-internal codes (grid selections / DB-derived PO numbers), never
    // free-typed input; EscapeSql doubles embedded single quotes so a code that
    // legitimately contains a quote can't break out of its string literal. This is
    // the VB6 DbQuote(Str,…) equivalent — the deferred identifier-pass audit
    // (2026-06-14) confirmed there are no user-typed segments to parameterize here.
    private string FormatInClause(List<string> values)
    {
        return string.Join(",", values.Select(v => $"'{EscapeSql(v)}'"));
    }

    // Doubles single quotes (VB6 DbQuote string-escaping). Used for the IN(...)
    // value lists and the Job= predicate; all callers pass app-internal values.
    private string EscapeSql(string value)
    {
        return (value ?? "").Replace("'", "''");
    }

    // === Models ===
    public class GridRowItem
    {
        public string Code { get; set; } = "";
        public string Description { get; set; } = "";
        public string Extra { get; set; } = "";
        public bool IsChecked { get; set; } = true;
    }
}
