@page "/export-pos"
@rendermode InteractiveServer
@namespace HomeFront.Components.Pages
@layout HFComponent

@using HomeFront.Data
@using HomeFront.Models
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using System.Reflection
@using System.Text

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FExportPOs> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db

<PageTitle>Purchase Order Posting Wizard - HomeFront</PageTitle>

<div class="wizard-container" style="position: relative;">

    @if (IsLoading)
    {
        <div class="loading-overlay">
            ⏳ Processing...
        </div>
    }

    @* ── Wizard Header ─────────────────────────────────────── *@
    <div class="wizard-head">
        <img src="images/32/accounting.ico" alt="Accounting" onerror="this.style.display='none'" />
        <div class="wizard-head-text">
            <h4>Post Purchase Orders to Accounting</h4>
            <p>The posting wizard will send Purchase Orders to accounting</p>
        </div>
    </div>

    @* ── Wizard Body ───────────────────────────────────────── *@
    <div class="wizard-body">

        @* ── Frame 0: Task Selection ──────────────────────── *@
        @if (CurrentFrame == 0)
        {
            <div class="frame-content">
                <img src="images/32/accounting.ico" class="frame-icon" onerror="this.style.display='none'" />
                <div class="frame-description">Choose the task you would like to perform</div>
                <div class="task-option">
                    <RadioControl TValue="bool" Name="taskOption" Value="true" @bind-SelectedValue="IsPostNew" Label="Post purchase orders" />
                </div>
                <div class="task-option">
                    <RadioControl TValue="bool" Name="taskOption" Value="false" @bind-SelectedValue="IsPostNew" Label="Review a previous posting" />
                </div>
            </div>
        }

        @* ── Frame 1: Data Selection ─────────────────────── *@
        @if (CurrentFrame == 1)
        {
            <div class="frame-content">
                <img src="images/32/accounting.ico" class="frame-icon" onerror="this.style.display='none'" />
                <div class="frame-description">@ListDescription</div>

                <GridControl @ref="DataGrid"
                        TValue="POGridRow"
                        DataSource="@GridData"
                        AllowSelection="true"
                        AllowSorting="true"
                        AllowResizing="true"
                        EnableHover="true"
                        Height="280px"
                        SelectionSettingsRef="@gridSelectionSettings"
                        EventsRef="@gridEvents">
                    <GridColumnsBase @key="gPOGridLayoutVersion">
                        @if (HasGridLayout)
                        {
                            foreach (var entry in GetOrderedGridLayout())
                            {
                                var layout = entry.Layout;
                                var fieldName = entry.Field;
                                var columnType = entry.ColumnType;
                                var textAlign = entry.TextAlign;
                                var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                                var width = layout.Width.HasValue && layout.Width.Value > 0
                                    ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;

                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                        }
                        else if (!IsPostNew)
                        {
                            <GridColumn Field="@nameof(POGridRow.Col0)" HeaderText="Batch" Width="80px" />
                            <GridColumn Field="@nameof(POGridRow.Col1)" HeaderText="Posted By" Width="120px" />
                            <GridColumn Field="@nameof(POGridRow.Col2)" HeaderText="Posted" Width="140px" />
                            <GridColumn Field="@nameof(POGridRow.Col3)" HeaderText="Status" Width="200px" />
                        }
                        else
                        {
                            <GridColumn Field="@nameof(POGridRow.Col0)" HeaderText="PO Number" Width="100px" />
                            <GridColumn Field="@nameof(POGridRow.Col1)" HeaderText="CO" Width="60px" />
                            <GridColumn Field="@nameof(POGridRow.Col2)" HeaderText="Job" Width="200px" />
                            <GridColumn Field="@nameof(POGridRow.Col3)" HeaderText="Vendor" Width="180px" />
                            <GridColumn Field="@nameof(POGridRow.Col4)" HeaderText="Purchase Order" Width="120px" />
                            <GridColumn Field="@nameof(POGridRow.Col5)" HeaderText="Description" Width="180px" />
                        }
                    </GridColumnsBase>
                </GridControl>
            </div>
        }

        @* ── Frame 2: Confirm / Review ───────────────────── *@
        @if (CurrentFrame == 2)
        {
            <div class="frame-content">
                <img src="images/32/accounting.ico" class="frame-icon" onerror="this.style.display='none'" />
                <div class="message-text">@PostMessage</div>

                @if (!IsPostNew)
                {
                    @* Review mode: batch task links *@
                    <div style="margin-left: 24px;">
                        <a class="batch-task-link" @onclick="() => OnBatchTaskClick(0)">Open the posting summary report</a>
                        @if (ShowTimberlineOptions)
                        {
                            <a class="batch-task-link" @onclick="() => OnBatchTaskClick(1)">Review the posting file</a>
                            <a class="batch-task-link" @onclick="() => OnBatchTaskClick(2)">Review the rejected records</a>
                            <a class="batch-task-link" @onclick="() => OnBatchTaskClick(3)">Open the processing journal</a>
                        }
                        @if (ShowRepostOption)
                        {
                            <a class="batch-task-link @(RepostEnabled ? "" : "disabled")" @onclick="() => { if (RepostEnabled) OnBatchTaskClick(4); }">Re-post batch</a>
                        }
                    </div>
                }
                else
                {
                    @* Post mode: options *@
                    @if (PostOptionsVisible)
                    {
                        <div class="post-options">
                            <div class="checkbox-row">
                                <CheckBoxControl @bind-Checked="ShowBatchReport" Label="Show posting summary report when finished." />
                            </div>
                            @if (ShowTimberlineOptions)
                            {
                                <div class="checkbox-row">
                                    <CheckBoxControl @bind-Checked="ShowProcessingJournal" Label="Show processing journal when finished." />
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>

    @* ── Wizard Footer ─────────────────────────────────────── *@
    <div class="wizard-footer">
        <ButtonControl OnClick="OnCancelClick">Cancel</ButtonControl>
        <ButtonControl Disabled="@(!BackEnabled)" OnClick="OnBackClick">&lt; Back</ButtonControl>
        <ButtonControl Disabled="@(!NextEnabled)" OnClick="OnNextClick">Next &gt;</ButtonControl>
        <ButtonControl CssClass="btn-primary" Disabled="@(!FinishEnabled)" OnClick="OnFinishClick">Finish</ButtonControl>
    </div>
</div>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    // ── Constants ────────────────────────────────────────────────
    private const string SRCFILE = "FExportPOs::";

    // ── Database ─────────────────────────────────────────────────
// ── App State (would come from injected service in real app) ─
    private string LoginID = "admin";
    private int AccountingSystem = 0; // 0=None, 1=Intacct, 2=Timberline, 3=MasterBuilder, 4=QuickBooks, 5=QBO
    private bool PostSummarizedPOs = false;

    // Accounting system constants (VB6: AccountingSystem option values)
    private const int asIntacct = 1;
    private const int asTimberline = 2;
    private const int asMasterBuilder = 3;
    private const int asQuickBooks = 4;
    private const int asQuickbooksOnline = 5;

    // ── Wizard State ─────────────────────────────────────────────
    private int CurrentFrame = 0;
    private bool IsPostNew = true;
    private long mBatch = 0;
    private bool IsLoading = false;

    // ── Frame 1 State ────────────────────────────────────────────
    private string ListDescription = "Select the purchase orders you would like to post.";
    private List<POGridRow> GridData = new();
    private GridControl<POGridRow>? DataGrid;

    // ── Frame 2 State ────────────────────────────────────────────
    private string PostMessage = "The posting wizard is ready to proceed.";
    private bool PostOptionsVisible = false;
    private bool ShowBatchReport = true;
    private bool ShowProcessingJournal = false;
    private bool RepostEnabled = false;

    // ── Computed Properties ──────────────────────────────────────
    private bool ShowTimberlineOptions => AccountingSystem == asTimberline;
    private bool ShowRepostOption => AccountingSystem != asQuickBooks; // VB6: QuickBooks hides repost
    private bool BackEnabled => CurrentFrame > 0;
    private bool NextEnabled => CurrentFrame < 2 && (CurrentFrame != 1 || HasSelectedRows);
    private bool FinishEnabled => CurrentFrame == 2 && FinishAllowed;
    private bool FinishAllowed = false;
    private bool HasSelectedRows = false;

    // ── Grid Settings ────────────────────────────────────────────
    private SelectionSettings gridSelectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Multiple,
        EnableToggle = true
    };
    private GridControlEvents<POGridRow> gridEvents = new();

    // ── Grid Layout via the shared GridLayoutPresenter ──────────
    // The load/resolve/order/width boilerplate lives in GridLayoutPresenter<TRow>;
    // only the VB6 form/grid name strings stay here (fidelity). The members named
    // gPOGridLayout / HasGridLayout / gPOGridLayoutVersion below are thin
    // delegations, so the markup is unchanged. The VB6 gridname carries the
    // explicit index suffix .(0) → instanceKey "(0)" drives the keyed-then-unkeyed
    // two-call fallback inside LoadAsync.
    private readonly GridLayoutPresenter<POGridRow> _g =
        new("FExportPOs", "DataGrid", instanceKey: "(0)");

    private Dictionary<string, GridLayoutColumn> gPOGridLayout => _g.Layout;
    private bool HasGridLayout => _g.Has;
    private int gPOGridLayoutVersion => _g.Version;

    // ── Lifecycle ────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        gridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<POGridRow>>(this, OnGridSelectionChanged);
        gridEvents.RowDeselected = EventCallback.Factory.Create<RowSelectEventArgs<POGridRow>>(this, OnGridSelectionChanged);

        // Load saved preferences (VB6: Form_Load reads from HFApp.Options)
        try
        {
            var showReport = await db.ExecuteScalarAsync<string>(
                "SELECT Value FROM tblOptions WHERE Name = 'ShowBudgetExportReport' AND DivisionID = @DivisionID",
                new { SessionState.DivisionID });
            ShowBatchReport = showReport?.Equals("True", StringComparison.OrdinalIgnoreCase) != false;

            var showJournal = await db.ExecuteScalarAsync<string>(
                "SELECT Value FROM tblOptions WHERE Name = 'ShowBudgetProcessingJournal' AND DivisionID = @DivisionID",
                new { SessionState.DivisionID });
            ShowProcessingJournal = showJournal?.Equals("True", StringComparison.OrdinalIgnoreCase) == true;

            // Non-Timberline systems don't show processing journal
            if (AccountingSystem != asTimberline)
                ShowProcessingJournal = false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadOptions");

            ShowBatchReport = true;
            ShowProcessingJournal = false;
        }

        await LoadGridLayoutAsync();
    }

    // ── Load Grid Layout ────────────────────────────────────────
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            await _g.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");

        }
    }

    // ── Navigation ───────────────────────────────────────────────
    private void SetTaskOption(bool postNew)
    {
        IsPostNew = postNew;
    }

    private async Task OnCancelClick()
    {
        ClosePage();
    }

    private async Task OnBackClick()
    {
        if (CurrentFrame > 0)
        {
            CurrentFrame--;
        }
    }

    private async Task OnNextClick()
    {
        if (CurrentFrame < 2)
        {
            CurrentFrame++;
            await OnFrameChanged();
        }
    }

    private async Task OnFinishClick()
    {
        if (!IsPostNew)
        {
            // Review mode - just close
            ClosePage();
        }
        else
        {
            // Post mode - create batch and post
            await CreateBatch();
            ClosePage();
        }
    }

    private async Task OnFrameChanged()
    {
        switch (CurrentFrame)
        {
            case 0:
                break;
            case 1:
                await LoadData();
                break;
            case 2:
                await LoadTasks();
                break;
        }
    }

    // ── Grid Selection ───────────────────────────────────────────
    private void OnGridSelectionChanged(RowSelectEventArgs<POGridRow> args)
    {
        HasSelectedRows = (DataGrid?.GetSelectedRecords()?.Count() ?? 0) > 0;
        StateHasChanged();
    }

    // ── LoadTasks (Frame 2) ──────────────────────────────────────
    private async Task LoadTasks()
    {
        try
        {
            if (!IsPostNew)
            {
                // Review mode (VB6: frmReview.Visible = True, frmPost.Visible = False)
                var selectedRecords = DataGrid?.GetSelectedRecords()?.ToList();
                if (selectedRecords != null && selectedRecords.Count > 0)
                {
                    var selectedRow = selectedRecords.First();
                    if (long.TryParse(selectedRow.Col0, out var batchId))
                    {
                        mBatch = batchId;
                    }
                    // VB6: lblBatchTask(4).Enabled = gData.TextMatrix(gData.Row, 3) = ""
                    RepostEnabled = string.IsNullOrEmpty(selectedRow.Col3);
                }
                PostMessage = "Select a task to perform on the selected batch.";
                PostOptionsVisible = false;
                FinishAllowed = true;
            }
            else
            {
                // Post mode (VB6: cmdNav(3).Enabled = False initially, then set based on accounting system)
                PostOptionsVisible = false;
                FinishAllowed = false;

                // VB6: check accounting system for MasterBuilder API
                if (AccountingSystem == asMasterBuilder)
                {
                    // Check if MasterBuilder API is running
                    bool mbApiRunning = await CheckMbApiRunning();
                    if (mbApiRunning)
                    {
                        PostMessage = "The posting wizard is ready to proceed.";
                        PostOptionsVisible = true;
                        FinishAllowed = true;
                    }
                    else
                    {
                        PostMessage = "Unable to post. The Master Builder API is not accepting requests.";
                        PostOptionsVisible = false;
                        FinishAllowed = false;
                    }
                }
                else
                {
                    // VB6: frmPost.Visible = True, cmdNav(3).Enabled = True
                    PostMessage = "The posting wizard is ready to proceed.";
                    PostOptionsVisible = true;
                    FinishAllowed = true;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{SRCFILE}LoadTasks");

            PostMessage = $"Error: {ex.Message}";
        }
    }

    private async Task<bool> CheckMbApiRunning()
    {
        // TODO: Implement MasterBuilder API health check (VB6: MbApiIsRunning)
        return true;
    }

    // ── LoadData (Frame 1) ───────────────────────────────────────
    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            GridData.Clear();
            string sql;

            if (!IsPostNew)
            {
                // Review mode - load batches
                sql = @"
                    SELECT Batch, UStmp AS PostedBy, TStmp AS Posted,
                           CASE WHEN repostbatch <> 0
                                THEN 'Reposted as batch ' + CAST(repostbatch AS VARCHAR)
                                ELSE '' END AS Status
                    FROM Batches
                    WHERE (DivisionID = @DivisionID OR ISNULL(DivisionID, 0) = 0)
                      AND BatchType IN ('Repost PO Batch', 'PO Posting')
                    ORDER BY Batch DESC";

                ListDescription = "Select the batch you would like to review.";
                gridSelectionSettings = new SelectionSettings
                {
                    Mode = SelectionMode.Row,
                    Type = SelectionType.Single,
                    EnableToggle = false
                };

                var dt = db.SqlExec(sql, new { SessionState.DivisionID });
                foreach (DataRow row in dt.Rows)
                {
                    GridData.Add(new POGridRow
                    {
                        Col0 = row["Batch"]?.ToString() ?? "",
                        Col1 = row["PostedBy"]?.ToString() ?? "",
                        Col2 = row["Posted"]?.ToString() ?? "",
                        Col3 = row["Status"]?.ToString() ?? ""
                    });
                }
            }
            else
            {
                // Post mode - load POs and COs
                sql = @"
                    SELECT p.PONumber AS [PO Number],
                           '' AS CO,
                           p.Job + ISNULL(' - ' + j.Description, '') AS Job,
                           ISNULL(v.Vendor_Name, p.Vendor) AS Vendor,
                           p.POIndex AS [Purchase Order],
                           p.Description
                    FROM POMaster p
                         LEFT OUTER JOIN tblVendors v ON (v.Vendor_id = p.Vendor AND v.DivisionID = p.DivisionID)
                         LEFT OUTER JOIN tblJobs j ON (j.Job_No = p.Job AND j.DivisionID = p.DivisionID)
                    WHERE p.status <> 'Pending' AND Cancelled = 0 AND PostingBatch = 0
                      AND p.DivisionID = @DivisionID
                      AND ISNULL(v.isTBD, 0) = 0
                      AND (ISNULL(p.ismpo, 0) = 0 OR ISNULL(p.mporeceived, 0) = 1)
                    UNION ALL
                    SELECT c.PONumber,
                           c.ChangeOrder AS CO,
                           p.Job + ISNULL(' - ' + j.Description, '') AS Job,
                           ISNULL(v.Vendor_Name, p.Vendor) AS Vendor,
                           p.POIndex,
                           p.Description
                    FROM POMaster p
                         JOIN POChangeOrders c ON (p.PONumber = c.PONumber AND p.DivisionID = c.DivisionID)
                         LEFT OUTER JOIN tblVendors v ON (v.Vendor_id = p.Vendor AND v.DivisionID = p.DivisionID)
                         LEFT OUTER JOIN tblJobs j ON (j.Job_No = p.Job AND j.DivisionID = p.DivisionID)
                    WHERE p.status <> 'Pending' AND c.PostingBatch = 0
                      AND p.DivisionID = @DivisionID
                      AND ISNULL(v.isTBD, 0) = 0
                      AND (ISNULL(p.ismpo, 0) = 0 OR ISNULL(p.mporeceived, 0) = 1)
                    ORDER BY 1, 2, 3, 4";

                ListDescription = "Select the purchase orders you would like to post.";
                gridSelectionSettings = new SelectionSettings
                {
                    Mode = SelectionMode.Row,
                    Type = SelectionType.Multiple,
                    EnableToggle = true
                };

                var dt = db.SqlExec(sql, new { SessionState.DivisionID });
                foreach (DataRow row in dt.Rows)
                {
                    GridData.Add(new POGridRow
                    {
                        Col0 = row[0]?.ToString() ?? "",
                        Col1 = row[1]?.ToString() ?? "",
                        Col2 = row[2]?.ToString() ?? "",
                        Col3 = row[3]?.ToString() ?? "",
                        Col4 = row[4]?.ToString() ?? "",
                        Col5 = row[5]?.ToString() ?? ""
                    });
                }
            }

            HasSelectedRows = false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{SRCFILE}LoadData");

            Logger.LogError(ex, "{SRCFILE}LoadData error");

        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ── CreateBatch ──────────────────────────────────────────────
    private async Task CreateBatch()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var selectedRecords = DataGrid?.GetSelectedRecords()?.ToList() ?? new();
            if (selectedRecords.Count == 0)
            {
                Console.WriteLine($"{SRCFILE}CreateBatch: No purchase orders selected.");

                return;
            }

            // Create new batch
            await db.ExecuteAsync(
                "INSERT INTO Batches(BatchType, UStmp, TStmp, DivisionID) VALUES('PO Posting', @LoginID, GETDATE(), @DivisionID)",
                new { LoginID, SessionState.DivisionID });

            mBatch = await db.ExecuteScalarAsync<long>("SELECT IDENT_CURRENT('Batches')");

            // Update POs (rows where CO column is blank)
            var poNumbers = selectedRecords
                .Where(r => string.IsNullOrEmpty(r.Col1))
                .Select(r => $"'{r.Col0.Replace("'", "''")}'")
                .ToList();

            if (poNumbers.Count > 0)
            {
                var poList = string.Join(",", poNumbers);
                var sql = $@"
                    UPDATE pomaster
                    SET PostingBatch = {mBatch}
                    FROM pomaster p
                    JOIN tblvendors v ON p.divisionid = v.divisionid AND p.vendor = v.vendor_id
                    WHERE p.DivisionID = {SessionState.DivisionID}
                      AND p.PONumber IN ({poList})
                      AND ISNULL(v.isTBD, 0) = 0
                      AND (ISNULL(p.isMPO, 0) = 0 OR ISNULL(p.MPOReceived, 0) = 1)";
                await db.ExecuteAsync(sql);
            }

            // Update COs (rows where CO column is not blank)
            var coKeys = selectedRecords
                .Where(r => !string.IsNullOrEmpty(r.Col1))
                .Select(r => $"'{r.Col0.Replace("'", "''")}' + CHAR(1) + '{r.Col1.Replace("'", "''")}'")
                .ToList();

            if (coKeys.Count > 0)
            {
                var coList = string.Join(",", coKeys.Select(k => k));
                // Build the IN clause values
                var coInValues = selectedRecords
                    .Where(r => !string.IsNullOrEmpty(r.Col1))
                    .Select(r => $"'{r.Col0.Replace("'", "''")}' + CHAR(1) + '{r.Col1.Replace("'", "''")}'");
                // Simplified: update by individual PO+CO pairs
                foreach (var rec in selectedRecords.Where(r => !string.IsNullOrEmpty(r.Col1)))
                {
                    await db.ExecuteAsync(
                        $@"UPDATE POChangeOrders
                           SET PostingDate = GETDATE(), PostingBatch = {mBatch}
                           WHERE DivisionID = {SessionState.DivisionID}
                             AND PONumber = @PONumber AND ChangeOrder = @CO",
                        new { PONumber = rec.Col0, CO = rec.Col1 });
                }
            }

            // Send batch
            await SendBatch();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{SRCFILE}CreateBatch");

            Logger.LogError(ex, "{SRCFILE}CreateBatch error");

        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ── SendBatch ────────────────────────────────────────────────
    private async Task<bool> SendBatch()
    {
        try
        {
            // VB6: Ensure jobs exist for non-Timberline, non-None accounting systems
            if (AccountingSystem != asTimberline && AccountingSystem != 0)
            {
                var jobRs = db.SqlExec(
                    $"SELECT DISTINCT p.job, j.ExternalJobID FROM pomaster p JOIN tbljobs j ON (p.Job = j.Job_No AND p.DivisionID = j.DivisionID) WHERE p.PostingBatch = {mBatch}");
                foreach (DataRow jobRow in jobRs.Rows)
                {
                    if (string.IsNullOrEmpty(jobRow["ExternalJobID"]?.ToString()))
                    {
                        // TODO: Call WriteJobToAccounting for job (VB6: HFApp.WriteJobToAccounting)
                        Console.WriteLine($"Job '{jobRow["job"]}' needs to be written to accounting system.");
                    }
                }
            }

            // Set summarized flag on pomaster
            await db.ExecuteAsync(
                $"UPDATE pomaster SET summarized = @Summarized WHERE PostingBatch = {mBatch}",
                new { Summarized = PostSummarizedPOs });

            // Set line item numbers and descriptions on poitems
            if (PostSummarizedPOs)
            {
                var sql = $@"
                    UPDATE poitems
                    SET linedescription = ISNULL(c.description, a.Description),
                        linenumber = (SELECT LineNumber
                                      FROM (SELECT ROW_NUMBER() OVER (PARTITION BY ponumber
                                            ORDER BY ponumber, job, jcextra, jccostcode, jccategory, ISNULL(taxgroup,'')) LineNumber,
                                            ponumber, job, jcextra, jccostcode, jccategory, ISNULL(taxgroup,'') TaxGroup
                                            FROM poitems x WHERE x.ponumber = a.ponumber
                                            GROUP BY ponumber, job, jcextra, jccostcode, jccategory, ISNULL(taxgroup,'')) b
                                      WHERE a.ponumber = b.ponumber
                                        AND ISNULL(a.taxgroup,'') = ISNULL(b.taxgroup,'')
                                        AND a.job = b.job
                                        AND ISNULL(a.jcextra,'') = ISNULL(b.jcextra,'')
                                        AND a.jccostcode = b.jccostcode
                                        AND a.jccategory = b.jccategory)
                    FROM poitems a
                    LEFT OUTER JOIN standardcostcodes c ON a.DivisionID = c.DivisionID AND a.jccostcode = c.costcode
                    WHERE a.DivisionID = {SessionState.DivisionID} AND a.genBatch = {mBatch}";
                await db.ExecuteAsync(sql);
            }
            else
            {
                var sql = $@"
                    UPDATE poitems
                    SET linedescription = a.description,
                        linenumber = (SELECT LineNumber
                                      FROM (SELECT ROW_NUMBER() OVER (PARTITION BY DivisionID, ponumber
                                            ORDER BY ponumber, ItemSeq) LineNumber, ponumber, ItemSeq
                                            FROM poitems x WHERE x.ponumber = a.ponumber AND x.DivisionID = a.DivisionID
                                            GROUP BY DivisionID, ponumber, ItemSeq) b
                                      WHERE a.ponumber = b.ponumber AND a.itemseq = b.itemseq)
                    FROM poitems a
                    WHERE a.DivisionID = {SessionState.DivisionID} AND a.genBatch = {mBatch}";
                await db.ExecuteAsync(sql);
            }

            // VB6: Dispatch to accounting system
            switch (AccountingSystem)
            {
                case asIntacct:
                    await SendPOsToIntacct(mBatch);
                    break;
                case asTimberline:
                    await SendBatchToSage300();
                    break;
                case asMasterBuilder:
                    await SendBatchToSage100();
                    break;
                case asQuickBooks:
                    // TODO: Implement SendBatchToQuickbooks
                    break;
                case asQuickbooksOnline:
                    // TODO: Implement SendBatchToQuickBooksOnline
                    break;
            }

            // Update posting date
            await db.ExecuteAsync(
                $"UPDATE pomaster SET postingdate = GETDATE() WHERE postingbatch = {mBatch}");

            // Show summary report if requested (VB6: Crystal report ExportPOBatch.rpt)
            if (ShowBatchReport)
            {
                // TODO: Implement report viewer (VB6: Crystal Reports ExportPOBatch.rpt with Batch/PostSummaries params)
                Console.WriteLine($"Batch {mBatch} posted. Summary report requested.");

            }

            // Save preferences on completion (VB6: Form_Unload saves options)
            await SaveBatchPreferences();

            return true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{SRCFILE}SendBatch");

            return false;
        }
    }

