    private async Task SaveOption(string name, string value)
    {
        try
        {
            var exists = await db.ExecuteScalarAsync<int>(
                "SELECT COUNT(*) FROM tblOptions WHERE Name = @Name AND DivisionID = @DivisionID",
                new { Name = name, SessionState.DivisionID });
            if (exists > 0)
                await db.ExecuteAsync(
                    "UPDATE tblOptions SET Value = @Value WHERE Name = @Name AND DivisionID = @DivisionID",
                    new { Value = value, Name = name, SessionState.DivisionID });
            else
                await db.ExecuteAsync(
                    "INSERT INTO tblOptions (Name, Value, DivisionID) VALUES (@Name, @Value, @DivisionID)",
                    new { Name = name, Value = value, SessionState.DivisionID });
        }
        catch { /* non-critical */ }
    }

    // ── Batch Task Click (Review Mode) ───────────────────────────
    private async Task OnBatchTaskClick(int index)
    {
        try
        {
            switch (index)
            {
                case 0: // Open summary report (VB6: Crystal report ExportPOBatch.rpt with Batch param)
                    // TODO: Implement report viewer (VB6: ZybUtil.Crystal.LoadODBCReport + PrintPreview)
                    Console.WriteLine($"Opening posting summary report for batch {mBatch}");

                    break;

                case 1: // Review posting file (VB6: DBGetFile + ShellFile for DataFile column)
                    // TODO: Retrieve DataFile blob from Batches table and display
                    Console.WriteLine($"Opening posting file for batch {mBatch}");

                    break;

                case 2: // Review rejected records (VB6: DBGetFile + ShellFile for RejectFile column)
                    // TODO: Retrieve RejectFile blob from Batches table and display
                    Console.WriteLine($"Opening rejected records for batch {mBatch}");

                    break;

                case 3: // Open processing journal (VB6: DBGetFile for ImportPrintFile, checks pdf vs prn)
                    {
                        var fileType = await db.ExecuteScalarAsync<string>(
                            $"SELECT importprintfiletype FROM batches WHERE batch = {mBatch}");
                        // TODO: Retrieve ImportPrintFile blob from Batches table and display
                        Console.WriteLine($"Opening processing journal for batch {mBatch} (type: {fileType})");

                    }
                    break;

                case 4: // Repost batch
                    if (!RepostEnabled) return;
                    var confirm = await Dialogs.ConfirmAsync(
                        $"Are you sure you want to re-post batch {mBatch}?");
                    if (!confirm) return;

                    IsLoading = true;
                    StateHasChanged();

                    var oldBatch = mBatch;

                    // Create new repost batch
                    await db.ExecuteAsync(
                        "INSERT INTO Batches(DivisionID, BatchType, UStmp, TStmp) VALUES(@DivisionID, 'Repost PO Batch', @LoginID, GETDATE())",
                        new { SessionState.DivisionID, LoginID });
                    var newBatch = await db.ExecuteScalarAsync<long>("SELECT IDENT_CURRENT('Batches')");

                    // Update references
                    await db.ExecuteAsync($@"
                        UPDATE Batches SET repostbatch = {newBatch} WHERE batch = {oldBatch};
                        UPDATE pomaster SET postingbatch = {newBatch} WHERE postingbatch = {oldBatch};
                        UPDATE pochangeorders SET postingbatch = {newBatch} WHERE postingbatch = {oldBatch}");

                    mBatch = newBatch;
                    var success = await SendBatch();

                    IsLoading = false;
                    if (success)
                    {
                        ClosePage();
                    }
                    StateHasChanged();
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{SRCFILE}OnBatchTaskClick");

            Logger.LogError(ex, "{SRCFILE}OnBatchTaskClick error");

            IsLoading = false;
            StateHasChanged();
        }
    }

