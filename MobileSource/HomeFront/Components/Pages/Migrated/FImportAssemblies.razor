                ROW_COSellingPretax = 9;
                ROW_SellingPriceTaxIncl = 10;
                ROW_COSellingPriceTaxIncl = 11;
                ROW_ConstructionCutoff = 12;
                ROW_AssemblyUOM = 13;
                break;
        }

        // Handle unassigned indexes (VB6 logic: fallback to last row index)
        int lastRowIndex = 17; // safety fallback
        if (ROW_AssemblyID == -1) ROW_AssemblyID = lastRowIndex;
        if (ROW_AssemblyDescription == -1) ROW_AssemblyDescription = lastRowIndex;
        if (ROW_ModelAssemblyID == -1) ROW_ModelAssemblyID = lastRowIndex;
        if (ROW_OptionAssemblyID == -1) ROW_OptionAssemblyID = lastRowIndex;
        if (ROW_OptionPrefix == -1) ROW_OptionPrefix = lastRowIndex;
        if (ROW_ModelPrefix == -1) ROW_ModelPrefix = lastRowIndex;
        if (ROW_SalesCategory == -1) ROW_SalesCategory = lastRowIndex;
        if (ROW_AssemblyNotes == -1) ROW_AssemblyNotes = lastRowIndex;
        if (ROW_JCExtra == -1) ROW_JCExtra = lastRowIndex;
        if (ROW_SellingPretax == -1) ROW_SellingPretax = lastRowIndex;
        if (ROW_COSellingPretax == -1) ROW_COSellingPretax = lastRowIndex;
        if (ROW_SellingPriceTaxIncl == -1) ROW_SellingPriceTaxIncl = lastRowIndex;
        if (ROW_COSellingPriceTaxIncl == -1) ROW_COSellingPriceTaxIncl = lastRowIndex;
        if (ROW_ConstructionCutoff == -1) ROW_ConstructionCutoff = lastRowIndex;
        if (ROW_AssemblyUOM == -1) ROW_AssemblyUOM = lastRowIndex;
        if (ROW_Series == -1) ROW_Series = lastRowIndex;
        if (ROW_Elevation == -1) ROW_Elevation = lastRowIndex;
        if (ROW_FloorArea == -1) ROW_FloorArea = lastRowIndex;
        if (ROW_Bedrooms == -1) ROW_Bedrooms = lastRowIndex;
        if (ROW_Bathrooms == -1) ROW_Bathrooms = lastRowIndex;
        if (ROW_Style == -1) ROW_Style = lastRowIndex;
    }

    private async Task ParseWorkbook(Stream stream)
    {
        using var workbook = new XLWorkbook(stream);
        
        // 1. Load Assemblies Sheet
        var assembliesWorksheet = workbook.Worksheets.FirstOrDefault(w => w.Name.Equals("Assemblies", StringComparison.OrdinalIgnoreCase));
        if (assembliesWorksheet == null)
        {
            AddMsg(0, "The \"Assemblies\" worksheet could not be found.");
            return;
        }
        var assemblyMatrix = LoadSheetToMatrix(assembliesWorksheet);
        AssemblyMatrix = assemblyMatrix;

        // 2. Load Phases Sheet
        var phasesWorksheet = workbook.Worksheets.FirstOrDefault(w => w.Name.Equals("Phases", StringComparison.OrdinalIgnoreCase));
        var phaseMatrix = phasesWorksheet != null ? LoadSheetToMatrix(phasesWorksheet) : new List<List<string>>();
        
        // 3. Load Categories Sheet
        var categoriesWorksheet = workbook.Worksheets.FirstOrDefault(w => w.Name.Equals("Categories", StringComparison.OrdinalIgnoreCase));
        var categoryMatrix = categoriesWorksheet != null ? LoadSheetToMatrix(categoriesWorksheet) : new List<List<string>>();

        // Read headers
        TemplateVersion = GetCellText(assemblyMatrix, 1, 1).ToUpper();
        Community = GetCellText(assemblyMatrix, 4, 2);
        CommunityDesc = GetCellText(assemblyMatrix, 5, 2);
        CommunityPhase = GetCellText(assemblyMatrix, 6, 2);
        
        // Parse template version format
        var versionParts = TemplateVersion.Split('.');
        var versionNum = versionParts.Length > 1 ? versionParts[1] : "";
        
        if (versionNum == "3" || versionNum == "4")
        {
            COL_POIndex = 1;
            COL_JCCostCode = 2;
            COL_JCCategory = 3;
            COL_EstPhase = 4;
            COL_EstItem = 5;
            COL_ItemDescription = 6;
            COL_ItemUOM = 7;
            COL_ItemNotes = 8;
            FirstAssemblyCol = 9;
        }
        else
        {
            COL_POIndex = -1;
            COL_JCCostCode = 1;
            COL_JCCategory = 2;
            COL_EstPhase = 3;
            COL_EstItem = 4;
            COL_ItemDescription = 5;
            COL_ItemUOM = 6;
            COL_ItemNotes = 7;
            FirstAssemblyCol = 8;
        }
        
        // Map row indexes based on version
        MapRowIndexes(TemplateVersion);

        // VB6: if header label at (AssemblyNotes, 8) says "Notes" write to Notes column,
        // else write to Comments column.
        AssemblyNoteField =
            GetCellText(assemblyMatrix, ROW_AssemblyNotes, 8).Equals("Notes", StringComparison.OrdinalIgnoreCase)
                ? "Notes" : "Comments";

        // Determine Cols per assembly and short form
        if (TemplateVersion.StartsWith("M")) AssemblyType = AssemblyTypes.atModel;
        else if (TemplateVersion.StartsWith("O")) AssemblyType = AssemblyTypes.atoption;
        else if (TemplateVersion.StartsWith("G")) AssemblyType = AssemblyTypes.atGlobal;
        else if (TemplateVersion.StartsWith("D")) AssemblyType = AssemblyTypes.atDesignCenter;
        
        var secondChar = TemplateVersion.Length > 1 ? TemplateVersion[1] : 'S';
        ColsPerAssembly = secondChar == 'S' ? 1 : 3;
        IsShortForm = ColsPerAssembly == 1;
        
        // Trim trailing columns in assembly sheet
        int lastCol = 0;
        if (assemblyMatrix.Count > 1)
        {
            var row1 = assemblyMatrix[1];
            for (int c = row1.Count - 1; c >= 0; c--)
            {
                if (!string.IsNullOrEmpty(row1[c]))
                {
                    lastCol = c;
                    break;
                }
            }
        }
        int maxCol = lastCol + ColsPerAssembly;
        
        // Trim trailing rows
        int lastRow = 0;
        for (int r = assemblyMatrix.Count - 1; r >= FirstItemRow; r--)
        {
            if (!string.IsNullOrEmpty(GetCellText(assemblyMatrix, r, COL_EstPhase)) || 
                !string.IsNullOrEmpty(GetCellText(assemblyMatrix, r, COL_EstItem)))
            {
                lastRow = r;
                break;
            }
        }
        LastItemRow = lastRow;
        
        // Map Assemblies Grid Data
        AssemblyGridData.Clear();
        if (assemblyMatrix.Count > 1)
        {
            var colCount = assemblyMatrix[1].Count;
            for (int col = FirstAssemblyCol; col < maxCol && col < colCount; col += ColsPerAssembly)
            {
                var asmId = GetCellText(assemblyMatrix, ROW_AssemblyID, col);
                if (string.IsNullOrEmpty(asmId)) continue;
                
                var asm = new AssemblyGridRow
                {
                    Col = col,
                    AssemblyID = asmId,
                    Description = GetCellText(assemblyMatrix, ROW_AssemblyDescription, col),
                    ModelAssemblyID = GetCellText(assemblyMatrix, ROW_ModelAssemblyID, col),
                    OptionAssemblyID = GetCellText(assemblyMatrix, ROW_OptionAssemblyID, col),
                    OptionPrefix = GetCellText(assemblyMatrix, ROW_OptionPrefix, col),
                    ModelPrefix = GetCellText(assemblyMatrix, ROW_ModelPrefix, col),
                    Series = GetCellText(assemblyMatrix, ROW_Series, col),
                    Elevation = GetCellText(assemblyMatrix, ROW_Elevation, col),
                    SalesCategory = GetCellText(assemblyMatrix, ROW_SalesCategory, col),
                    Notes = GetCellText(assemblyMatrix, ROW_AssemblyNotes, col),
                    JCExtra = GetCellText(assemblyMatrix, ROW_JCExtra, col),
                    SellingPretax = GetCellDouble(assemblyMatrix, ROW_SellingPretax, col),
                    SellingTaxIncl = GetCellDouble(assemblyMatrix, ROW_SellingPriceTaxIncl, col),
                    COSellingPretax = GetCellDouble(assemblyMatrix, ROW_COSellingPretax, col),
                    COSellingTaxIncl = GetCellDouble(assemblyMatrix, ROW_COSellingPriceTaxIncl, col),
                    ConstructionCutoff = GetCellDouble(assemblyMatrix, ROW_ConstructionCutoff, col),
                    AssemblyUOM = GetCellText(assemblyMatrix, ROW_AssemblyUOM, col),
                    FloorArea = GetCellDouble(assemblyMatrix, ROW_FloorArea, col),
                    Bedrooms = (int)GetCellDouble(assemblyMatrix, ROW_Bedrooms, col),
                    Bathrooms = GetCellDouble(assemblyMatrix, ROW_Bathrooms, col),
                    Style = GetCellText(assemblyMatrix, ROW_Style, col),
                    // raw cell text for IsNumeric/zero validation (VB6 TextMatrix)
                    SellingPretaxText = GetCellText(assemblyMatrix, ROW_SellingPretax, col),
                    SellingTaxInclText = GetCellText(assemblyMatrix, ROW_SellingPriceTaxIncl, col),
                    COSellingPretaxText = GetCellText(assemblyMatrix, ROW_COSellingPretax, col),
                    COSellingTaxInclText = GetCellText(assemblyMatrix, ROW_COSellingPriceTaxIncl, col),
                    ConstructionCutoffText = GetCellText(assemblyMatrix, ROW_ConstructionCutoff, col),
                    FloorAreaText = GetCellText(assemblyMatrix, ROW_FloorArea, col),
                    BedroomsText = GetCellText(assemblyMatrix, ROW_Bedrooms, col),
                    BathroomsText = GetCellText(assemblyMatrix, ROW_Bathrooms, col)
                };
                AssemblyGridData.Add(asm);
            }
        }
        ModelCount = AssemblyGridData.Count;
        
        // Map Item Grid Data (from FirstItemRow to LastItemRow)
        ItemGridData.Clear();
        AssemblyDetailData.Clear();
        
        for (int r = FirstItemRow; r <= LastItemRow; r++)
        {
            var phase = GetCellText(assemblyMatrix, r, COL_EstPhase);
            var itemCode = GetCellText(assemblyMatrix, r, COL_EstItem);
            
            // Skip rows with no phase and item code (VB6 comment items)
            if (string.IsNullOrEmpty(phase) && string.IsNullOrEmpty(itemCode))
                continue;
                
            // Cost type character logic
            if (!string.IsNullOrEmpty(itemCode))
            {
                var lastChar = itemCode.ToUpper().Last();
                if (lastChar != 'M' && lastChar != 'S' && lastChar != 'L' && lastChar != 'E' && lastChar != 'O')
                {
                    itemCode += "M";
                }
            }
            
            var item = new ItemGridRow
            {
                Row = r,
                Phase = phase,
                Item = itemCode,
                Description = GetCellText(assemblyMatrix, r, COL_ItemDescription),
                UOM = GetCellText(assemblyMatrix, r, COL_ItemUOM),
                Notes = GetCellText(assemblyMatrix, r, COL_ItemNotes),
                POIndex = COL_POIndex != -1 ? GetCellText(assemblyMatrix, r, COL_POIndex) : "",
                JCCostCode = GetCellText(assemblyMatrix, r, COL_JCCostCode),
                JCCategory = GetCellText(assemblyMatrix, r, COL_JCCategory)
            };
            ItemGridData.Add(item);
            
            // Loop through assemblies to build AssemblyDetailRow
            for (int a = 0; a < AssemblyGridData.Count; a++)
            {
                var asm = AssemblyGridData[a];
                int col = FirstAssemblyCol + a * ColsPerAssembly;
                
                string qtyStr = "", rateStr = "", notes = "";
                if (IsShortForm)
                {
                    rateStr = GetCellText(assemblyMatrix, r, col);
                    qtyStr = "1";
                }
                else
                {
                    notes = GetCellText(assemblyMatrix, r, col);
                    qtyStr = GetCellText(assemblyMatrix, r, col + 1);
                    rateStr = GetCellText(assemblyMatrix, r, col + 2);
                }
                
                var detail = new AssemblyDetailRow
                {
                    Row = r,
                    Col = col,
                    AssemblyID = asm.AssemblyID,
                    Phase = phase,
                    Item = itemCode,
                    QtyStr = qtyStr,
                    RateStr = rateStr,
                    Notes = notes,
                    ItemNotes = item.Notes,
                    POIndex = item.POIndex
                };
                AssemblyDetailData.Add(detail);
            }
        }
        ItemCount = ItemGridData.Count;
        
        // Map Phase Grid Data
        PhaseGridData.Clear();
        int phaseLastRow = 0;
        for (int r = phaseMatrix.Count - 1; r >= 1; r--)
        {
            if (!string.IsNullOrEmpty(GetCellText(phaseMatrix, r, 1)) || 
                !string.IsNullOrEmpty(GetCellText(phaseMatrix, r, 2)))
            {
                phaseLastRow = r;
                break;
            }
        }
        for (int r = 2; r <= phaseLastRow; r++)
        {
            var ph = GetCellText(phaseMatrix, r, 1);
            var gr = GetCellText(phaseMatrix, r, 2);
            if (string.IsNullOrEmpty(ph) && string.IsNullOrEmpty(gr))
                continue;
                
            PhaseGridData.Add(new PhaseGridRow
            {
                Row = r,
                Phase = ph,
                GroupPhase = gr,
                Description = GetCellText(phaseMatrix, r, 3)
            });
        }
        PhaseCount = PhaseGridData.Count;
        
        // Map Category Grid Data
        CategoryGridData.Clear();
        int catLastRow = 0;
        for (int r = categoryMatrix.Count - 1; r >= 1; r--)
        {
            if (!string.IsNullOrEmpty(GetCellText(categoryMatrix, r, 1)))
            {
                catLastRow = r;
                break;
            }
        }
        for (int r = 2; r <= catLastRow; r++)
        {
            var cat = GetCellText(categoryMatrix, r, 1);
            if (string.IsNullOrEmpty(cat)) continue;
            
            CategoryGridData.Add(new CategoryGridRow
            {
                Category = cat,
                Description = GetCellText(categoryMatrix, r, 2),
                MajorGroup = GetCellText(categoryMatrix, r, 3),
                MajorGroupDesc = GetCellText(categoryMatrix, r, 4)
            });
        }
        await Task.CompletedTask;
    }

    private async Task ValidateData()
    {
        Messages.Clear();
        ErrorCount = 0;
        WarningCount = 0;
        InfoMsgCount = 0;

        // VB6: the Community / CommunityPhase / default-vendor / item-exists checks
        // run only for an Assembly import (the "If mImportMode = ""Assembly""" block).
        if (ImportMode == "Assembly")
        {
            await ValidateCommunity();
            await ValidateCommunityPhase();
            await ValidateVendors();
            await ValidateItems();
        }

        // VB6 runs these for BOTH import modes (they are outside the Assembly-only block):
        // phase uniqueness, assembly duplicate / per-type field checks, item field checks.
        ValidatePhases();
        await ValidateAssemblies();
        ValidateItemFields();
        ValidateItemsInAssemblies();

        ErrorCount = Messages.Count(m => m.Level == 0);
        WarningCount = Messages.Count(m => m.Level == 1);
        InfoMsgCount = Messages.Count(m => m.Level == 2);

        // VB6: select Messages tab whenever there are errors (cmdNav OK disabled then).
        if (ErrorCount > 0)
            SelectTabByName("Messages");

        StateHasChanged();
    }

    private async Task ValidateCommunity()
    {
        if (string.IsNullOrEmpty(Community)) return;

        bool needsCommunity =
            (AssemblyType == AssemblyTypes.atModel && ModelByArea) ||
            (AssemblyType == AssemblyTypes.atoption && OptionByArea) ||
            (AssemblyType == AssemblyTypes.atGlobal && GlobalOptionByArea) ||
            (AssemblyType == AssemblyTypes.atDesignCenter && DCOptionByArea);

        if (needsCommunity)
        {
            var dt = db.SqlExec("SELECT * FROM tblLocality WHERE Area=@Area", new { Area = Community });
            if (dt.Rows.Count == 0)
                AddMsg(0, "Unknown Community.");
        }
    }

    private async Task ValidateCommunityPhase()
    {
        if (string.IsNullOrEmpty(CommunityPhase)) return;

        bool needsPhase =
            (AssemblyType == AssemblyTypes.atModel && ModelsByArea_Phase) ||
            (AssemblyType == AssemblyTypes.atoption && OptionByAreaPhase) ||
            (AssemblyType == AssemblyTypes.atGlobal && GlobalOptionByAreaPhase) ||
            (AssemblyType == AssemblyTypes.atDesignCenter && DCOptionByAreaPhase);

        if (needsPhase)
        {
            var dt = db.SqlExec(
                "SELECT * FROM CommunityPhase WHERE Community=@Community AND CommunityPhase=@Phase",
                new { Community, Phase = CommunityPhase });
            if (dt.Rows.Count == 0)
                AddMsg(0, "Unknown Community Phase.");
        }
    }

    private async Task ValidateVendors()
    {
        try
        {
            // VB6: warn for any PO index with no default (global or community) vendor.
            var sql = @"
                SELECT p.poindex
                FROM tblpoindex p
                LEFT OUTER JOIN poareavendor g ON (p.DivisionID = g.DivisionID AND p.poindex=g.poindex AND ISNULL(g.area,'')='')
                LEFT OUTER JOIN poareavendor c ON (p.DivisionID = c.DivisionID AND p.poindex=c.poindex AND c.area=@Community)
                WHERE g.vendor IS NULL AND c.vendor IS NULL AND p.DivisionID = @DivisionID";
            var rows = await db.QueryAsync(sql, new { Community, SessionState.DivisionID });
            foreach (var row in rows)
            {
                var po = row.TryGetValue("poindex", out var v) ? v?.ToString() : "";
                AddMsg(1, $"No vendor for \"{po}\" has been specified. Vendor pricing cannot be written for items on this PO.");
            }
        }
        catch { /* non-critical */ }
    }

    private async Task ValidateItems()
    {
        // VB6: check that all items exist, are assigned to a PO, and any given PO index is valid.
        foreach (var item in ItemGridData)
        {
            // VB6 reads the given poindex only when the template has a POIndex column.
            string po = COL_POIndex == -1 ? "" : (item.POIndex ?? "").Trim();

            var dt = db.SqlExec(
                "SELECT POIndex FROM tblPhaseItem WHERE DivisionID =@DivisionID AND Phase=@Phase AND Item=@Item",
                new { SessionState.DivisionID, Phase = item.Phase, Item = item.Item });
            if (dt.Rows.Count == 0)
            {
                AddMsg(0, $"{CellAddress(item.Row, COL_EstItem)} - unknown item \"{item.Phase}/{item.Item} {item.Description}\"");
            }
            else
            {
                var poIndex = dt.Rows[0][0]?.ToString() ?? "";
                // VB6: warn only when the item has no PO in tblPhaseItem AND the template
                // has no POIndex column (POIndex = -1).
                if (poIndex == "" && COL_POIndex == -1)
                    AddMsg(1, $"\"{item.Phase}/{item.Item} {item.Description}\" is not assigned to a PO. Vendor pricing can't be written.");
            }

            // Validate the given PO index if specified.
            if (po != "")
            {
                var poDt = db.SqlExec(
                    "SELECT POIndex FROM tblPOIndex WHERE DivisionID =@DivisionID AND POIndex=@POIndex",
                    new { SessionState.DivisionID, POIndex = po });
                if (poDt.Rows.Count == 0)
                    AddMsg(0, $"{CellAddress(item.Row, COL_POIndex)} - unknown poindex\"{po}\"");
            }
        }
    }

    private void ValidatePhases()
    {
        // VB6: a row can't be both a phase and a group phase; phases must be unique.
        // Uses a "previous row" CSV comparison (only adjacent duplicates), so mirror that.
        string prevKey = "";
        foreach (var phase in PhaseGridData)
        {
            var p1 = (phase.Phase ?? "").Trim();
            var p2 = (phase.GroupPhase ?? "").Trim();
            if (p1 != "" && p2 != "")
                AddMsg(0, $"Phases Row {phase.Row} - can't be both a phase and a group phase.");

            var key = (phase.Phase ?? "") + (phase.GroupPhase ?? "");
            if (key == prevKey && key != "")
                AddMsg(0, $"Phases must be unique - \"{key}\" used more than once.");
            prevKey = key;
        }
    }

    // VB6 IsNumeric on the raw cell text.
    private static bool IsNum(string? s) =>
        !string.IsNullOrWhiteSpace(s) && double.TryParse(s.Trim(), out _);

    // === VB6 duplicate-assembly check + per-type field validation (single With gAssemblies block) ===
    private async Task ValidateAssemblies()
    {
        // -- duplicate assemblies (worksheet + database) --
        string prevKey = "";
        foreach (var asm in AssemblyGridData)
        {
            var key = $"{asm.AssemblyID}\t{asm.ModelAssemblyID}\t{asm.OptionAssemblyID}";
            // VB6 compares against the accumulated CSV (any prior), so use a set.
            if (_seenAssemblyKeys.Contains(key))
                AddMsg(0, $"Assembly/Model/Option must be unique. {asm.AssemblyID} / {asm.ModelAssemblyID} / {asm.OptionAssemblyID} is specified multiple times.");
            _seenAssemblyKeys.Add(key);
            prevKey = key;

            // database duplicate → warn it will be replaced
            string dupCommunity = AssemblyTypeUsesArea() ? (SaveCommunity ? Community : "") : "";
            var dupSql = @"SELECT Community FROM tblDBAssemblyMaster
                           WHERE AssemblyType=@AssemblyType AND Community=@Community
                             AND Assembly=@Assembly AND Model=@Model AND OptionID=@OptionID
                             AND DivisionID =@DivisionID";
            var dupDt = db.SqlExec(dupSql, new
            {
                AssemblyType = (int)AssemblyType,
                Community = dupCommunity,
                Assembly = asm.AssemblyID,
                Model = asm.ModelAssemblyID ?? "",
                OptionID = asm.OptionAssemblyID ?? "",
                SessionState.DivisionID
            });
            if (dupDt.Rows.Count > 0)
                AddMsg(1, $"{CellAddress(ROW_AssemblyID, asm.Col)} - Duplicate Assembly. The database already contains this assembly. It will be replaced.");
        }
        _seenAssemblyKeys.Clear();

        // -- per-type field checks --
        if (AssemblyType == AssemblyTypes.atModel)
        {
            foreach (var asm in AssemblyGridData)
            {
                int c = asm.Col;
                // required
                if (string.IsNullOrWhiteSpace(asm.Series)) AddMsg(0, $"{CellAddress(ROW_Series, c)} - series is required.");
                // too big
                if ((asm.AssemblyID?.Length ?? 0) > 20) AddMsg(0, $"{CellAddress(ROW_AssemblyID, c)} - Assembly ID is too long (max 20)");
                if ((asm.Description?.Length ?? 0) > 50) AddMsg(0, $"{CellAddress(ROW_AssemblyDescription, c)} - Model Description is too long (max 50)");
                if ((asm.ModelAssemblyID?.Length ?? 0) > 20) AddMsg(0, $"{CellAddress(ROW_ModelAssemblyID, c)} - Model Assembly ID is too long (max 20)");
                if ((asm.Series?.Length ?? 0) > 10) AddMsg(0, $"{CellAddress(ROW_Series, c)} - Series is too long (max 20)");
                if ((asm.Elevation?.Length ?? 0) > 20) AddMsg(0, $"{CellAddress(ROW_Elevation, c)} - Elevation is too long (max 20)");
                if ((asm.Notes?.Length ?? 0) > 4000) AddMsg(0, $"{CellAddress(ROW_AssemblyNotes, c)} - Notes are too long (max 4000)");
                if ((asm.Style?.Length ?? 0) > 30) AddMsg(0, $"{CellAddress(ROW_Style, c)} - Style is too long (max 30)");
                // is number
                if (asm.SellingPretaxText != "" && !IsNum(asm.SellingPretaxText)) AddMsg(0, $"{CellAddress(ROW_SellingPretax, c)} - selling price (pretax) is not a number.");
                if (asm.SellingTaxInclText != "" && !IsNum(asm.SellingTaxInclText)) AddMsg(0, $"{CellAddress(ROW_SellingPriceTaxIncl, c)} - selling price (incl tax) is not a number.");
                if (asm.FloorAreaText != "" && !IsNum(asm.FloorAreaText)) AddMsg(0, $"{CellAddress(ROW_FloorArea, c)} - floor area is not a number.");
                if (asm.BedroomsText != "" && !IsNum(asm.BedroomsText)) AddMsg(0, $"{CellAddress(ROW_Bedrooms, c)} - bedrooms is not a number.");
                if (asm.BathroomsText != "" && !IsNum(asm.BathroomsText)) AddMsg(0, $"{CellAddress(ROW_Bathrooms, c)} - bathrooms is not a number.");
                // is zero
                if (asm.SellingPretaxText != "" && asm.SellingPretax == 0) AddMsg(1, $"{CellAddress(ROW_SellingPretax, c)} - selling price (pretax) is zero.");
                if (asm.SellingTaxInclText != "" && asm.SellingTaxIncl == 0) AddMsg(1, $"{CellAddress(ROW_SellingPriceTaxIncl, c)} - selling price (incl tax) is zero.");
                if (asm.FloorAreaText != "" && asm.FloorArea == 0) AddMsg(1, $"{CellAddress(ROW_FloorArea, c)} - floor area is zero.");
                if (asm.BedroomsText != "" && asm.Bedrooms == 0) AddMsg(1, $"{CellAddress(ROW_Bedrooms, c)} - bedrooms is zero.");
                if (asm.BathroomsText != "" && asm.Bathrooms == 0) AddMsg(1, $"{CellAddress(ROW_Bathrooms, c)} - bathrooms is zero.");
            }
        }

        if (AssemblyType == AssemblyTypes.atoption || AssemblyType == AssemblyTypes.atGlobal)
        {
            foreach (var asm in AssemblyGridData)
            {
                int c = asm.Col;
                // const cutoff existence (warn it will be created)
                if (asm.ConstructionCutoff != 0)
                {
                    var jsDt = db.SqlExec("SELECT Job_Status FROM tblJobStatus WHERE Job_Status=@S", new { S = (int)asm.ConstructionCutoff });
                    if (jsDt.Rows.Count == 0)
                        AddMsg(1, $"{CellAddress(ROW_ConstructionCutoff, c)} - Construction cutoff \"{(int)asm.ConstructionCutoff}\" not found. It will be created.");
                }
                // too big
                if ((asm.AssemblyID?.Length ?? 0) > 20) AddMsg(0, $"{CellAddress(ROW_AssemblyID, c)} - Assembly ID is too long (max 20)");
                if ((asm.Description?.Length ?? 0) > 200) AddMsg(0, $"{CellAddress(ROW_AssemblyDescription, c)} - Model Description is too long (max 50)");
                if (AssemblyType == AssemblyTypes.atoption && (asm.ModelAssemblyID?.Length ?? 0) > 20) AddMsg(0, $"{CellAddress(ROW_ModelAssemblyID, c)} - Model ID is too long (max 20)");
                if (AssemblyType == AssemblyTypes.atoption && (asm.Series?.Length ?? 0) > 10) AddMsg(0, $"{CellAddress(ROW_Series, c)} - Series is too long (max 20)");
                if ((asm.SalesCategory?.Length ?? 0) > 15) AddMsg(0, $"{CellAddress(ROW_SalesCategory, c)} - Category is too long (max 15)");
                if ((asm.Notes?.Length ?? 0) > 4000) AddMsg(0, $"{CellAddress(ROW_AssemblyNotes, c)} - Notes are too long (max 4000)");
                if ((asm.JCExtra?.Length ?? 0) > 10) AddMsg(0, $"{CellAddress(ROW_JCExtra, c)} - JC Extra is too long (max 10)");
                if ((asm.AssemblyUOM?.Length ?? 0) > 10) AddMsg(0, $"{CellAddress(ROW_AssemblyUOM, c)} - Sales UOM is too long (max 10)");
                // is number
                if (asm.SellingPretaxText != "" && !IsNum(asm.SellingPretaxText)) AddMsg(0, $"{CellAddress(ROW_SellingPretax, c)} - selling price (pretax) is not a number.");
                if (asm.SellingTaxInclText != "" && !IsNum(asm.SellingTaxInclText)) AddMsg(0, $"{CellAddress(ROW_SellingPriceTaxIncl, c)} - selling price (incl tax) is not a number.");
                if (asm.COSellingPretaxText != "" && !IsNum(asm.COSellingPretaxText)) AddMsg(0, $"{CellAddress(ROW_COSellingPretax, c)} - co selling price (pretax) is not a number.");
                if (asm.COSellingTaxInclText != "" && !IsNum(asm.COSellingTaxInclText)) AddMsg(0, $"{CellAddress(ROW_COSellingPriceTaxIncl, c)} - co selling price (incl tax) is not a number.");
                if (asm.ConstructionCutoffText != "" && !IsNum(asm.ConstructionCutoffText)) AddMsg(0, $"{CellAddress(ROW_ConstructionCutoff, c)} - const cutoff is not a number.");
                // is zero
                if (asm.SellingPretaxText != "" && asm.SellingPretax == 0) AddMsg(1, $"{CellAddress(ROW_SellingPretax, c)} - selling price (pretax) is zero.");
                if (asm.SellingTaxInclText != "" && asm.SellingTaxIncl == 0) AddMsg(1, $"{CellAddress(ROW_SellingPriceTaxIncl, c)} - selling price (incl tax) is zero.");
                if (asm.COSellingPretaxText != "" && asm.COSellingPretax == 0) AddMsg(1, $"{CellAddress(ROW_COSellingPretax, c)} - co selling price (pretax) is zero.");
                if (asm.COSellingTaxInclText != "" && asm.COSellingTaxIncl == 0) AddMsg(1, $"{CellAddress(ROW_COSellingPriceTaxIncl, c)} - co selling price (incl tax) is zero.");
                if (asm.ConstructionCutoffText != "" && asm.ConstructionCutoff == 0) AddMsg(1, $"{CellAddress(ROW_ConstructionCutoff, c)} - const cutoff is zero.");
            }
        }

        await Task.CompletedTask;
    }

