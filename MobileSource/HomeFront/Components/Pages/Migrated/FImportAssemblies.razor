    protected override void OnInitialized()
    {
        ImportMode ??= "Assembly";
    }

    private async Task OnSelectFile()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('input[type=file]').click()");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        IsLoading = true;
        StatusMessage = "Loading file...";
        StateHasChanged();

        try
        {
            FileName = file.Name;

            // In a real implementation, we would parse the Excel file here
            // For now, simulate loading with placeholder data
            await SimulateFileLoad();

            FileLoaded = true;
            ActiveTab = Messages.Any() ? "Messages" : "Assemblies";

            await ValidateData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading file: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task SimulateFileLoad()
    {
        // Placeholder: In production, use a library like EPPlus or ClosedXML to parse Excel
        // This simulates the structure that would come from parsing the Excel workbook

        AssemblyGridData = new List<AssemblyGridRow>();
        PhaseGridData = new List<PhaseGridRow>();
        CategoryGridData = new List<CategoryGridRow>();
        Messages = new List<ImportMessage>();

        ModelCount = 0;
        ItemCount = 0;
        PhaseCount = 0;

        await Task.CompletedTask;
    }

    private async Task ValidateData()
    {
        Messages.Clear();
        ErrorCount = 0;
        WarningCount = 0;
        InfoMsgCount = 0;

        if (ImportMode == "Assembly")
        {
            await ValidateCommunity();
            await ValidateCommunityPhase();
            await ValidateVendors();
            await ValidateItems();
        }

        ValidatePhases();
        ValidateAssemblyDuplicates();
        ValidateAssemblyFields();
        ValidateItemFields();
        ValidateItemsInAssemblies();

        ErrorCount = Messages.Count(m => m.Level == 0);
        WarningCount = Messages.Count(m => m.Level == 1);
        InfoMsgCount = Messages.Count(m => m.Level == 2);

        if (Messages.Any())
        {
            ActiveTab = "Messages";
        }

        StateHasChanged();
    }

    private async Task ValidateCommunity()
    {
        if (string.IsNullOrEmpty(Community)) return;

        bool needsCommunity =
            (AssemblyType == AssemblyTypes.atModel && ModelByArea) ||
            (AssemblyType == AssemblyTypes.atoption && OptionByArea) ||
            (AssemblyType == AssemblyTypes.atGlobal && GlobalOptionByArea) ||
            (AssemblyType == AssemblyTypes.atDesignCenter && DCOptionByArea);

        if (needsCommunity)
        {
            var dt = db.SqlExec("SELECT * FROM tblLocality WHERE Area=@Area", new { Area = Community });
            if (dt.Rows.Count == 0)
                AddMsg(0, "Unknown Community.");
        }
    }

    private async Task ValidateCommunityPhase()
    {
        if (string.IsNullOrEmpty(CommunityPhase)) return;

        bool needsPhase =
            (AssemblyType == AssemblyTypes.atModel && ModelsByArea_Phase) ||
            (AssemblyType == AssemblyTypes.atoption && OptionByAreaPhase) ||
            (AssemblyType == AssemblyTypes.atGlobal && GlobalOptionByAreaPhase) ||
            (AssemblyType == AssemblyTypes.atDesignCenter && DCOptionByAreaPhase);

        if (needsPhase)
        {
            var dt = db.SqlExec(
                "SELECT * FROM CommunityPhase WHERE Community=@Community AND CommunityPhase=@Phase",
                new { Community, Phase = CommunityPhase });
            if (dt.Rows.Count == 0)
                AddMsg(0, "Unknown Community Phase.");
        }
    }

    private async Task ValidateVendors()
    {
        try
        {
            var sql = @"
                SELECT p.poindex
                FROM tblpoindex p
                LEFT OUTER JOIN poareavendor g ON (p.DivisionID = g.DivisionID AND p.poindex=g.poindex AND ISNULL(g.area,'')='')
                LEFT OUTER JOIN poareavendor c ON (p.DivisionID = c.DivisionID AND p.poindex=c.poindex AND c.area=@Community)
                WHERE g.vendor IS NULL AND c.vendor IS NULL AND p.DivisionID = @DivisionID";
            var dt = db.SqlExec(sql, new { Community, DivisionID });
            foreach (DataRow row in dt.Rows)
            {
                AddMsg(1, $"No vendor for \"{row[0]}\" has been specified. Vendor pricing cannot be written for items on this PO.");
            }
        }
        catch { }
    }

    private async Task ValidateItems()
    {
        // Validate each item row exists in the database
        foreach (var item in AssemblyGridData)
        {
            // In production, check each phase/item combination against tblPhaseItem
        }
    }

    private void ValidatePhases()
    {
        var phaseCSV = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var phase in PhaseGridData)
        {
            if (!string.IsNullOrWhiteSpace(phase.Phase) && !string.IsNullOrWhiteSpace(phase.GroupPhase))
            {
                AddMsg(0, $"Phases Row - can't be both a phase and a group phase.");
            }

            var key = (phase.Phase ?? "") + (phase.GroupPhase ?? "");
            if (!string.IsNullOrEmpty(key))
            {
                if (phaseCSV.Contains(key))
                {
                    AddMsg(0, $"Phases must be unique - \"{key}\" used more than once.");
                }
                phaseCSV.Add(key);
            }
        }
    }

    private void ValidateAssemblyDuplicates()
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var asm in AssemblyGridData)
        {
            var key = $"{asm.AssemblyID}\t{asm.ModelAssemblyID}\t{asm.OptionAssemblyID}";
            if (seen.Contains(key))
            {
                AddMsg(0, $"Assembly/Model/Option must be unique. {asm.AssemblyID} / {asm.ModelAssemblyID} / {asm.OptionAssemblyID} is specified multiple times.");
            }
            seen.Add(key);
        }
    }

    private void ValidateAssemblyFields()
    {
        foreach (var asm in AssemblyGridData)
        {
            // Check required fields based on assembly type
            if (AssemblyType == AssemblyTypes.atModel)
            {
                if (string.IsNullOrWhiteSpace(asm.Series))
                    AddMsg(0, $"Assembly {asm.AssemblyID} - series is required.");
                if ((asm.AssemblyID?.Length ?? 0) > 20)
                    AddMsg(0, $"Assembly {asm.AssemblyID} - Assembly ID is too long (max 20)");
                if ((asm.Description?.Length ?? 0) > 50)
                    AddMsg(0, $"Assembly {asm.AssemblyID} - Model Description is too long (max 50)");
                if ((asm.Series?.Length ?? 0) > 10)
                    AddMsg(0, $"Assembly {asm.AssemblyID} - Series is too long (max 10)");
                if ((asm.Notes?.Length ?? 0) > 4000)
                    AddMsg(0, $"Assembly {asm.AssemblyID} - Notes are too long (max 4000)");
            }
            else if (AssemblyType == AssemblyTypes.atoption || AssemblyType == AssemblyTypes.atGlobal || AssemblyType == AssemblyTypes.atDesignCenter)
            {
                if ((asm.AssemblyID?.Length ?? 0) > 20)
                    AddMsg(0, $"Assembly {asm.AssemblyID} - Assembly ID is too long (max 20)");
                if ((asm.Description?.Length ?? 0) > 200)
                    AddMsg(0, $"Assembly {asm.AssemblyID} - Description is too long (max 200)");
                if ((asm.SalesCategory?.Length ?? 0) > 15)
                    AddMsg(0, $"Assembly {asm.AssemblyID} - Category is too long (max 15)");
                if ((asm.Notes?.Length ?? 0) > 4000)
                    AddMsg(0, $"Assembly {asm.AssemblyID} - Notes are too long (max 4000)");
            }

            // Numeric checks
            if (asm.SellingPretax != 0 && asm.SellingPretax == 0)
                AddMsg(1, $"Assembly {asm.AssemblyID} - selling price (pretax) is zero.");
        }
    }

