    };

    private readonly HashSet<string> _seenAssemblyKeys = new(StringComparer.OrdinalIgnoreCase);

    private void ValidateItemFields()
    {
        foreach (var item in ItemGridData)
        {
            int r = item.Row;
            // required (VB6 CellAddress messages)
            if (string.IsNullOrWhiteSpace(item.UOM)) AddMsg(0, $"{CellAddress(r, COL_ItemUOM)} - unit of measure is required.");
            if (string.IsNullOrWhiteSpace(item.Phase)) AddMsg(0, $"{CellAddress(r, COL_EstPhase)} - phase is required.");
            if (string.IsNullOrWhiteSpace(item.Description)) AddMsg(0, $"{CellAddress(r, COL_ItemDescription)} - description is required.");
            if (string.IsNullOrWhiteSpace(item.Item)) AddMsg(0, $"{CellAddress(r, COL_EstItem)} - item is required.");
            // too big
            if ((item.UOM?.Length ?? 0) > 10) AddMsg(0, $"{CellAddress(r, COL_ItemUOM)} - UOM is too long (max 10).");
            if ((item.Phase?.Length ?? 0) > 20) AddMsg(0, $"{CellAddress(r, COL_EstPhase)} - phase is too long (max 20).");
            if ((item.Item?.Length ?? 0) > 16) AddMsg(0, $"{CellAddress(r, COL_EstItem)} - item is too long (max 16).");
            if ((item.Description?.Length ?? 0) > 200) AddMsg(0, $"{CellAddress(r, COL_ItemDescription)} - description is too long (max 200).");
            if ((item.Notes?.Length ?? 0) > 4000) AddMsg(0, $"{CellAddress(r, COL_ItemNotes)} - description is too long (max 200).");
            if (_phaseItemJcCostCodeMaxLength is > 0 && (item.JCCostCode?.Length ?? 0) > _phaseItemJcCostCodeMaxLength.Value) AddMsg(0, $"{CellAddress(r, COL_JCCostCode)} - cost code is too long (max {_phaseItemJcCostCodeMaxLength.Value}).");
            if ((item.JCCategory?.Length ?? 0) > 40) AddMsg(0, $"{CellAddress(r, COL_JCCategory)} - category is too long (max 3).");
            // item code must end with a valid cost type
            if (!string.IsNullOrWhiteSpace(item.Item))
            {
                var lastChar = item.Item.Trim().ToUpper().LastOrDefault();
                if (lastChar != 'M' && lastChar != 'S' && lastChar != 'L' && lastChar != 'E' && lastChar != 'O')
                    AddMsg(0, $"{CellAddress(r, COL_EstItem)} - item code is invalid.");
            }
        }
    }

    private void ValidateItemsInAssemblies()
    {
        // VB6 sorts by phase/item and reports adjacent duplicates.
        var sortedItems = ItemGridData
            .OrderBy(i => i.Phase, StringComparer.OrdinalIgnoreCase)
            .ThenBy(i => i.Item, StringComparer.OrdinalIgnoreCase)
            .ToList();
        for (int i = 1; i < sortedItems.Count; i++)
        {
            if (string.Equals(sortedItems[i].Phase, sortedItems[i - 1].Phase, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(sortedItems[i].Item, sortedItems[i - 1].Item, StringComparison.OrdinalIgnoreCase))
            {
                AddMsg(0, $"{CellAddress(sortedItems[i].Row, COL_EstPhase)} - phase and item is not unique.");
            }
        }

        // Per-assembly qty/rate checks.
        bool qtyDefaultsToOneWarned = false;
        foreach (var detail in AssemblyDetailData)
        {
            if (IsShortForm)
            {
                if (!string.IsNullOrWhiteSpace(detail.RateStr) && !IsNum(detail.RateStr))
                    AddMsg(0, $"{CellAddress(detail.Row, detail.Col)} - rate is not a number.");
            }
            else
            {
                if ((detail.Notes?.Length ?? 0) > 4000)
                    AddMsg(0, $"{CellAddress(detail.Row, detail.Col)} - Notes are too long (max 4000).");
                if (!string.IsNullOrWhiteSpace(detail.QtyStr) && !IsNum(detail.QtyStr))
                    AddMsg(0, $"{CellAddress(detail.Row, detail.Col + 1)} - qty is not a number.");
                if (!string.IsNullOrWhiteSpace(detail.RateStr) && !IsNum(detail.RateStr))
                    AddMsg(0, $"{CellAddress(detail.Row, detail.Col + 2)} - rate is not a number.");

                double qty = 0, rate = 0;
                double.TryParse(detail.QtyStr, out qty);
                double.TryParse(detail.RateStr, out rate);
                if (qty > 0 && rate == 0)
                    AddMsg(1, $"{CellAddress(detail.Row, detail.Col + 2)} - item rate is zero.");

                if (string.IsNullOrWhiteSpace(detail.QtyStr) && !qtyDefaultsToOneWarned)
                {
                    AddMsg(2, "Quantities not specified default to one.");
                    qtyDefaultsToOneWarned = true;
                }
            }
        }
    }

