```razor
@page "/import-assemblies"
@page "/import-assemblies/{ImportMode}"
@rendermode InteractiveServer

@using HomeFront.Models
@using System.Data
@using Microsoft.Data.SqlClient

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>@(ImportMode ?? "Assembly") Import - HomeFront</PageTitle>

<style>
    .import-container {
        font-family: 'MS Sans Serif', Arial, sans-serif;
        font-size: 13px;
        padding: 10px;
    }

    .header-panel {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 12px;
        align-items: flex-start;
    }

    .header-left {
        flex: 1;
        min-width: 300px;
    }

    .header-right {
        display: flex;
        flex-direction: column;
        gap: 6px;
        align-items: flex-end;
    }

    .field-row {
        display: flex;
        align-items: center;
        margin-bottom: 4px;
    }

    .field-row label {
        min-width: 100px;
        text-align: right;
        padding-right: 8px;
        font-size: 13px;
        color: #333;
    }

    .field-row .field-value {
        font-size: 13px;
        color: #000;
    }

    .field-row .field-value.bold {
        font-weight: 700;
    }

    .field-row .field-value.error {
        font-weight: 700;
        color: red;
    }

    .btn-nav {
        padding: 4px 16px;
        border: 1px solid #ced4da;
        border-radius: 3px;
        background: #f0f0f0;
        cursor: pointer;
        font-size: 13px;
        min-width: 80px;
    }

    .btn-nav:hover:not(:disabled) {
        background: #e0e0e0;
    }

    .btn-nav:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-nav.primary {
        font-weight: 600;
    }

    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
    }

    .checkbox-row input[type="checkbox"] {
        width: 16px;
        height: 16px;
    }

    .status-label {
        font-size: 13px;
        color: #333;
        margin-bottom: 4px;
    }

    .progress-bar-container {
        width: 100%;
        height: 22px;
        background: #e0e0e0;
        border: 1px solid #ccc;
        border-radius: 3px;
        overflow: hidden;
        margin-top: 8px;
    }

    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(to right, #0078d7, #00a2ed);
        transition: width 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 11px;
        font-weight: 600;
    }

    .tab-buttons {
        display: flex;
        border-bottom: 2px solid #ddd;
        margin-bottom: 0;
    }

    .tab-buttons button {
        padding: 8px 20px;
        border: 1px solid #ddd;
        border-bottom: none;
        background: #f0f0f0;
        cursor: pointer;
        font-size: 13px;
        transition: background 0.15s;
        margin-right: 2px;
        border-radius: 4px 4px 0 0;
    }

    .tab-buttons button:hover {
        background: #e0e0e0;
    }

    .tab-buttons button.active {
        background: #fff;
        border-bottom: 2px solid #fff;
        margin-bottom: -2px;
        color: #0078d7;
        font-weight: bold;
    }

    .tab-content {
        border: 1px solid #ddd;
        border-top: none;
        background: #fff;
        min-height: 300px;
    }

    .icon-container {
        margin-right: 8px;
    }

    .icon-error {
        color: red;
        font-size: 24px;
    }

    .icon-warning {
        color: orange;
        font-size: 24px;
    }

    .icon-info {
        color: #0078d7;
        font-size: 24px;
    }

    .msg-row {
        display: flex;
        align-items: center;
        padding: 3px 6px;
        border-bottom: 1px solid #f0f0f0;
        font-size: 13px;
    }

    .msg-row.error-msg {
        color: red;
    }

    .msg-row.warn-msg {
        color: #b8860b;
    }

    .msg-row.info-msg {
        color: #0078d7;
    }

    .msg-icon {
        width: 20px;
        text-align: center;
        margin-right: 6px;
        font-size: 14px;
    }

    .loading-overlay {
        position: fixed;
        inset: 0;
        z-index: 10000;
        background: rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .loading-spinner {
        padding: 20px 40px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
        font-size: 16px;
        font-weight: 500;
        color: #333;
    }

    .file-upload-area {
        border: 2px dashed #ccc;
        border-radius: 8px;
        padding: 30px;
        text-align: center;
        cursor: pointer;
        margin-bottom: 16px;
        background: #fafafa;
        transition: border-color 0.2s;
    }

    .file-upload-area:hover {
        border-color: #0078d7;
        background: #f0f8ff;
    }
</style>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ @StatusMessage</div>
    </div>
}

<div class="import-container">
    <h3>@(ImportMode ?? "Assembly") Import</h3>

    @if (!FileLoaded)
    {
        <div class="file-upload-area" @onclick="OnSelectFile">
            <p style="font-size: 16px; color: #666;">📂 Click to select an Excel file (.xls, .xlsx)</p>
            <p style="font-size: 12px; color: #999;">Or drag and drop a file here</p>
            <InputFile OnChange="OnFileSelected" accept=".xls,.xlsx" style="display:none" @ref="fileInputRef" />
        </div>
    }
    else
    {
        <!-- Header Info -->
        <div class="header-panel">
            <div class="header-left">
                <div class="field-row">
                    <label>File Name:</label>
                    <span class="field-value">@FileName</span>
                </div>
                <div class="field-row">
                    <label>Assemblies:</label>
                    <span class="field-value">@ModelCount</span>
                </div>
                <div class="field-row">
                    <label>Items:</label>
                    <span class="field-value">@ItemCount</span>
                </div>
                <div class="field-row">
                    <label>Phases:</label>
                    <span class="field-value">@PhaseCount</span>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 4px;">
                @if (ErrorCount > 0)
                {
                    <div class="field-row">
                        <label>Errors:</label>
                        <span class="field-value error">@ErrorCount</span>
                    </div>
                }
                @if (WarningCount > 0)
                {
                    <div class="field-row">
                        <label>Warnings:</label>
                        <span class="field-value bold">@WarningCount</span>
                    </div>
                }
            </div>

            <div class="header-right">
                <button class="btn-nav primary" disabled="@(ErrorCount > 0 || IsSaving)" @onclick="OnOkClick">
                    &amp;OK
                </button>
                <button class="btn-nav" @onclick="OnCancelClick">
                    &amp;Cancel
                </button>
                <div class="checkbox-row" style="margin-top: 8px;">
                    <input type="checkbox" id="chkSaveCommunity" @bind="SaveCommunity" @bind:after="OnSaveCommunityChanged" />
                    <label for="chkSaveCommunity">Save Community on Assemblies?</label>
                </div>
            </div>
        </div>

        <!-- Status -->
        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <div class="status-label">@StatusMessage</div>
        }

        <!-- Icon indicator -->
        <div style="margin-bottom: 8px;">
            @if (ErrorCount > 0)
            {
                <span class="icon-error">❌</span>
                <span style="color: red; font-weight: 600;">Errors found - cannot import</span>
            }
            else if (WarningCount > 0)
            {
                <span class="icon-warning">⚠️</span>
                <span style="color: #b8860b; font-weight: 600;">Warnings found - review before importing</span>
            }
            else
            {
                <span class="icon-info">ℹ️</span>
                <span style="color: #0078d7;">Ready to import</span>
            }
        </div>

        <!-- Tabs -->
        <div class="tab-buttons">
            @if (Messages.Any())
            {
                <button class="@(ActiveTab == "Messages" ? "active" : "")" @onclick='() => ActiveTab = "Messages"'>
                    Messages (@Messages.Count)
                </button>
            }
            <button class="@(ActiveTab == "Assemblies" ? "active" : "")" @onclick='() => ActiveTab = "Assemblies"'>
                Assemblies
            </button>
            <button class="@(ActiveTab == "Phases" ? "active" : "")" @onclick='() => ActiveTab = "Phases"'>
                Phases
            </button>
            @if (AssemblyType != AssemblyTypes.atModel)
            {
                <button class="@(ActiveTab == "Categories" ? "active" : "")" @onclick='() => ActiveTab = "Categories"'>
                    Categories
                </button>
            }
        </div>

        <div class="tab-content">
            @if (ActiveTab == "Messages")
            {
                <div style="max-height: 400px; overflow-y: auto; padding: 4px;">
                    @foreach (var msg in Messages.OrderBy(m => m.Level))
                    {
                        <div class="msg-row @(msg.Level == 0 ? "error-msg" : msg.Level == 1 ? "warn-msg" : "info-msg")">
                            <span class="msg-icon">
                                @(msg.Level == 0 ? "❌" : msg.Level == 1 ? "⚠️" : "ℹ️")
                            </span>
                            <span>@msg.Text</span>
                        </div>
                    }
                    @if (!Messages.Any())
                    {
                        <div style="padding: 20px; text-align: center; color: #999;">No messages</div>
                    }
                </div>
            }
            else if (ActiveTab == "Assemblies")
            {
                <HfGrid TValue="AssemblyGridRow"
                        DataSource="@AssemblyGridData"
                        AllowSorting="true"
                        AllowResizing="true"
                        AllowSelection="true"
                        Height="400px">
                    <HfGridColumnsBase>
                        <HfGridColumn Field="@nameof(AssemblyGridRow.AssemblyID)" HeaderText="Assembly ID" Width="120px" />
                        <HfGridColumn Field="@nameof(AssemblyGridRow.Description)" HeaderText="Description" Width="200px" />
                        <HfGridColumn Field="@nameof(AssemblyGridRow.ModelAssemblyID)" HeaderText="Model" Width="120px" />
                        <HfGridColumn Field="@nameof(AssemblyGridRow.OptionAssemblyID)" HeaderText="Option" Width="120px" />
                        <HfGridColumn Field="@nameof(AssemblyGridRow.Series)" HeaderText="Series" Width="100px" />
                        <HfGridColumn Field="@nameof(AssemblyGridRow.SalesCategory)" HeaderText="Category" Width="100px" />
                        <HfGridColumn Field="@nameof(AssemblyGridRow.SellingPretax)" HeaderText="Pretax" Format="C2" Width="100px" TextAlign="TextAlign.Right" Type="ColumnType.Number" />
                        <HfGridColumn Field="@nameof(AssemblyGridRow.SellingTaxIncl)" HeaderText="Tax Incl" Format="C2" Width="100px" TextAlign="TextAlign.Right" Type="ColumnType.Number" />
                        <HfGridColumn Field="@nameof(AssemblyGridRow.Notes)" HeaderText="Notes" Width="200px" />
                    </HfGridColumnsBase>
                </HfGrid>
            }
            else if (ActiveTab == "Phases")
            {
                <HfGrid TValue="PhaseGridRow"
                        DataSource="@PhaseGridData"
                        AllowSorting="true"
                        AllowResizing="true"
                        AllowSelection="true"
                        Height="400px">
                    <HfGridColumnsBase>
                        <HfGridColumn Field="@nameof(PhaseGridRow.Phase)" HeaderText="Phase" Width="120px" />
                        <HfGridColumn Field="@nameof(PhaseGridRow.GroupPhase)" HeaderText="Group Phase" Width="120px" />
                        <HfGridColumn Field="@nameof(PhaseGridRow.Description)" HeaderText="Description" Width="300px" />
                    </HfGridColumnsBase>
                </HfGrid>
            }
            else if (ActiveTab == "Categories")
            {
                <HfGrid TValue="CategoryGridRow"
                        DataSource="@CategoryGridData"
                        AllowSorting="true"
                        AllowResizing="true"
                        AllowSelection="true"
                        Height="400px">
                    <HfGridColumnsBase>
                        <HfGridColumn Field="@nameof(CategoryGridRow.Category)" HeaderText="Category" Width="120px" />
                        <HfGridColumn Field="@nameof(CategoryGridRow.Description)" HeaderText="Description" Width="200px" />
                        <HfGridColumn Field="@nameof(CategoryGridRow.MajorGroup)" HeaderText="Major Group" Width="120px" />
                        <HfGridColumn Field="@nameof(CategoryGridRow.MajorGroupDesc)" HeaderText="Group Desc" Width="200px" />
                    </HfGridColumnsBase>
                </HfGrid>
            }
        </div>

        <!-- Progress Bar -->
        @if (ProgressValue > 0)
        {
            <div class="progress-bar-container">
                <div class="progress-bar-fill" style="width: @(ProgressValue)%;">
                    @(ProgressValue.ToString("0"))%
                </div>
            </div>
        }
    }
</div>

@code {
