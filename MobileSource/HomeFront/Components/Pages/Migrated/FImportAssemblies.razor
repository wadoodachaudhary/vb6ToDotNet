    protected override async Task OnInitializedAsync()
    {
        ImportMode ??= "Assembly";
        await LoadAppOptionsAsync();
        _phaseItemJcCostCodeMaxLength = LoadColumnMaxLength("tblPhaseItem", "JCCostCode");
    }

    private int? LoadColumnMaxLength(string tableName, string columnName)
    {
        try
        {
            var dt = db.SqlExec(
                @"SELECT CHARACTER_MAXIMUM_LENGTH
                  FROM INFORMATION_SCHEMA.COLUMNS
                  WHERE TABLE_NAME=@TableName AND COLUMN_NAME=@ColumnName",
                new { TableName = tableName, ColumnName = columnName });
            var value = dt?.Rows.Count > 0 ? dt.Rows[0]["CHARACTER_MAXIMUM_LENGTH"] : null;
            return value != null
                && value != DBNull.Value
                && int.TryParse(value.ToString(), out var maxLength)
                && maxLength > 0
                    ? maxLength
                    : null;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not read schema max length for {TableName}.{ColumnName}", tableName, columnName);
            return null;
        }
    }

    // === HFApp.Options(name) → SELECT OptionValue FROM AppOptions WHERE OptionName=name AND UID='' AND divisionid=@Div ===
    private async Task<string> GetOptionAsync(string name)
    {
        try
        {
            var v = await db.ExecuteScalarAsync<string>(
                "SELECT OptionValue FROM AppOptions WHERE OptionName=@Name AND ISNULL(UID,'')='' AND divisionid=@DivisionID",
                new { Name = name, SessionState.DivisionID });
            return v ?? "";
        }
        catch
        {
            return "";
        }
    }

    // VB6 truthiness: the option store holds "1"/"0"/"True"/"" — Val()<>0 OR "true".
    private static bool OptBool(string v) =>
        !string.IsNullOrWhiteSpace(v) &&
        (v.Trim() == "1" || string.Equals(v.Trim(), "true", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(v.Trim(), "yes", StringComparison.OrdinalIgnoreCase));

    private static double OptNum(string v) =>
        double.TryParse(v?.Trim(), out var d) ? d : 0;

    private async Task LoadAppOptionsAsync()
    {
        ModelByArea = OptBool(await GetOptionAsync("ModelByArea"));
        OptionByArea = OptBool(await GetOptionAsync("OptionByArea"));
        GlobalOptionByArea = OptBool(await GetOptionAsync("GlobalOptionByArea"));
        DCOptionByArea = OptBool(await GetOptionAsync("DCOptionByArea"));
        ModelsByArea_Phase = OptBool(await GetOptionAsync("ModelsByArea_Phase"));
        OptionByAreaPhase = OptBool(await GetOptionAsync("OptionByAreaPhase"));
        GlobalOptionByAreaPhase = OptBool(await GetOptionAsync("GlobalOptionByAreaPhase"));
        DCOptionByAreaPhase = OptBool(await GetOptionAsync("DCOptionByAreaPhase"));
        ModelTaxRate = OptNum(await GetOptionAsync("ModelTaxRate"));
        MSOPTTaxRate = OptNum(await GetOptionAsync("MSOPTTaxRate"));
        GLOPTTaxRate = OptNum(await GetOptionAsync("GLOPTTaxRate"));
        var icp = OptNum(await GetOptionAsync("IncentiveCostPercent"));
        IncentiveCostPercent_Option = icp;
        IncentivePhase = await GetOptionAsync("IncentivePhase");
        IncentiveItem = await GetOptionAsync("IncentiveItem");
        LandPhase = await GetOptionAsync("LandPhase");
        LandItem = await GetOptionAsync("LandItem");
        GST_Rate = OptNum(await GetOptionAsync("GST_Rate"));
        PST_Rate = OptNum(await GetOptionAsync("PST_Rate"));
        UsePst = OptBool(await GetOptionAsync("UsePst"));
        PST_Province = await GetOptionAsync("PST_Province");
        Country = await GetOptionAsync("Country");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        IsLoading = true;
        StatusMessage = "Loading file...";
        StateHasChanged();

        try
        {
            FileName = file.Name;
            Messages.Clear();

            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            await ParseWorkbook(memoryStream);

            FileLoaded = true;
            // VB6 Form_Load selects the Assemblies tab after loading; ValidateData()
            // then switches to Messages if any errors are found.
            SelectTabByName("Assemblies");

            await ValidateData();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error loading file: {ex.Message}";
            AddMsg(0, $"Error loading file: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private List<List<string>> LoadSheetToMatrix(IXLWorksheet worksheet)
    {
        var matrix = new List<List<string>>();
        
        // Add row 0 (empty headers or placeholders)
        matrix.Add(new List<string>());
        
        var lastRow = worksheet.LastRowUsed()?.RowNumber() ?? 0;
        var lastCol = worksheet.LastColumnUsed()?.ColumnNumber() ?? 0;
        
        for (int r = 1; r <= lastRow; r++)
        {
            var rowList = new List<string>();
            rowList.Add(""); // column 0 is empty (row numbers)
            
            var xlRow = worksheet.Row(r);
            for (int c = 1; c <= lastCol; c++)
            {
                var cell = xlRow.Cell(c);
                rowList.Add(cell.Value.ToString() ?? "");
            }
            matrix.Add(rowList);
        }
        
        return matrix;
    }

    private string GetCellText(List<List<string>> matrix, int row, int col)
    {
        if (row < 0 || row >= matrix.Count) return "";
        var rowData = matrix[row];
        if (col < 0 || col >= rowData.Count) return "";
        return rowData[col]?.Trim() ?? "";
    }
    
    private double GetCellDouble(List<List<string>> matrix, int row, int col)
    {
        var text = GetCellText(matrix, row, col);
        if (double.TryParse(text, out var val)) return val;
        return 0;
    }

