    private async Task OnOkClick()
    {
        if (ErrorCount > 0) return;

        IsSaving = true;
        IsLoading = true;
        StatusMessage = "Saving data...";
        StateHasChanged();

        try
        {
            await WriteCommunity();
            await WriteSeries();
            await WriteCategories();
            await WritePhases();

            if (ImportMode != "Assembly")
            {
                await WriteItems();
            }

            if (ImportMode == "Assembly")
            {
                await WriteAssemblies();
            }

            await JSRuntime.InvokeVoidAsync("alert", "Import completed successfully.");
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error during import: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnCancelClick()
    {
        NavigationManager.NavigateTo("/");
    }

    private async Task WriteCommunity()
    {
        if (string.IsNullOrWhiteSpace(Community)) return;

        try
        {
            var sql = @"INSERT INTO tblLocality(Area, Description, Abr, Inactive)
                        VALUES(@Area, @Description, @Abr, 0)";
            await db.ExecuteAsync(sql, new { Area = Community, Description = CommunityDesc, Abr = Community });
        }
        catch (Exception ex)
        {
            if (!ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                throw;
        }

        if (!string.IsNullOrWhiteSpace(CommunityPhase))
        {
            try
            {
                var sql = @"INSERT INTO CommunityPhase(Community, CommunityPhase, Description)
                            VALUES(@Community, @CommunityPhase, @Description)";
                await db.ExecuteAsync(sql, new { Community, CommunityPhase, Description = CommunityPhase });
            }
            catch (Exception ex)
            {
                if (!ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                    throw;
            }
        }
    }

    private async Task WriteSeries()
    {
        foreach (var asm in AssemblyGridData)
        {
            if (!string.IsNullOrWhiteSpace(asm.Series))
            {
                try
                {
                    var sql = @"INSERT INTO tblSeries(DivisionID, Series, Description)
                                VALUES(@DivisionID, @Series, @Description)";
                    await db.ExecuteAsync(sql, new { DivisionID, Series = asm.Series, Description = asm.Series });
                }
                catch (Exception ex)
                {
                    if (!ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                        throw;
                }
            }
        }
    }

    private async Task WriteCategories()
    {
        foreach (var cat in CategoryGridData)
        {
            try
            {
                if (!string.IsNullOrWhiteSpace(cat.MajorGroup))
                {
                    var sql = @"INSERT INTO tblMajorGroups(Major_Group, Description)
                                VALUES(@MajorGroup, @Description)";
                    await db.ExecuteAsync(sql, new { MajorGroup = cat.MajorGroup, Description = cat.MajorGroupDesc });
                }

                var catSql = @"INSERT INTO tblCategories(Category, Description, Group_Code)
                               VALUES(@Category, @Description, @GroupCode)";
                await db.ExecuteAsync(catSql, new { cat.Category, cat.Description, GroupCode = cat.MajorGroup });
            }
            catch (Exception ex)
            {
                if (!ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                    throw;
            }
        }
    }

    private async Task WritePhases()
    {
        foreach (var phase in PhaseGridData)
        {
            try
            {
                bool isGroupPhase = !string.IsNullOrWhiteSpace(phase.GroupPhase);
                var phaseCode = isGroupPhase ? phase.GroupPhase : phase.Phase;

                var sql = @"INSERT INTO tblEstPhases(DivisionID, Phase, SortOrder, Description, GroupPhase, UpdateEstimating, UStmp, TStmp)
                            VALUES(@DivisionID, @Phase, @SortOrder, @Description, @IsGroup, 1, @LoginID, GETDATE())";
                await db.ExecuteAsync(sql, new
                {
                    DivisionID,
                    Phase = phaseCode,
                    SortOrder = phaseCode,
                    Description = phase.Description,
                    IsGroup = isGroupPhase ? 0 : 1,
                    LoginID
                });
            }
            catch (Exception ex)
            {
                if (!ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                    throw;
            }
        }
    }

