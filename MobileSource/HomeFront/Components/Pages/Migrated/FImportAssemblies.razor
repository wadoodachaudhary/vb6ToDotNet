    private async Task OnOkClick()
    {
        if (ErrorCount > 0) return;

        IsSaving = true;
        IsLoading = true;
        StatusMessage = "Saving data...";
        StateHasChanged();

        try
        {
            await WriteCommunity();
            await WriteSeries();
            await WriteCategories();
            await WritePhases();

            if (ImportMode != "Assembly")
            {
                await WriteItems();
            }

            if (ImportMode == "Assembly")
            {
                await WriteAssemblies();
            }

            StatusMessage = "Import completed successfully.";
            StateHasChanged();
            ClosePage();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error during import: {ex.Message}";
            AddMsg(0, $"Error during import: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
            IsLoading = false;
            StateHasChanged();
        }
    }

