@page "/std-addons"
@rendermode InteractiveServer
@namespace HomeFront.Components.Pages
@layout HFComponent

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using System.Reflection
@using System.Text
@using HomeFront.Data
@using HomeFront.Components.Pages.Migrated
@using Fx.ControlKit.Notifications

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject ILogger<FStdAddons> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@using HomeFront.Models
@inject DbWrapperSqlServer db

<PageTitle>Standard Addons - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Standard Addons...</div>
    </div>
}

<div class="tabs-container">
    <div class="tab-buttons">
        <button class="@(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">.NET</button>
        <button class="@(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">VB6</button>
    </div>

    <div class="tab-content">
        @if (activeTab == 1)
        {
            @* ── Toolbar ──────────────────────────────────────────── *@
            <div class="toolbar-cntr">
                <button class="tbar-btn btn-success" disabled="@(!mDirty)" @onclick="OnSaveClick">
                    <span>💾</span>
                    <span class="tool-label">Save</span>
                </button>

                <div class="toolbar-sep"></div>

                <button class="tbar-btn btn-primary" @onclick="OnAddClick">
                    <span>➕</span>
                    <span class="tool-label">Add</span>
                </button>
                <button class="tbar-btn btn-danger" disabled="@(SelectedAddon == null)" @onclick="OnDeleteClick">
                    <span>🗑️</span>
                    <span class="tool-label">Delete</span>
                </button>

                <div class="toolbar-sep"></div>

                <button class="tbar-btn" @onclick="OnRefreshClick">
                    <span>🔄</span>
                    <span class="tool-label">Refresh</span>
                </button>
                <button class="tbar-btn" @onclick="OnExportClick">
                    <span>📊</span>
                    <span class="tool-label">Export</span>
                </button>
            </div>

            <h3 class="page-title">Standard Addons</h3>

            @* ── Main Grid ────────────────────────────────────────── *@
            <div class="grid-container">
                <GridControl @ref="AddonsGrid"
                        TValue="StdAddonRow"
                        DataSource="@AddonsData"
                        AllowPaging="true"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowResizing="true"
                        AllowSelection="true"
                        EnableHover="true"
                        Height="600px"
                        FilterSettingsRef="@filterSettings"
                        PageSettingsRef="@pageSettings"
                        SelectionSettingsRef="@selectionSettings"
                        EditSettingsRef="@editSettings"
                        EventsRef="@gridEvents">
                    <GridColumnsBase @key="gAddonsLayoutVersion">
                        <GridColumn Field="@nameof(StdAddonRow.AddonId)" HeaderText="ID" Width="80px"
                                      IsPrimaryKey="true" AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(StdAddonRow.RowState)" HeaderText="" Width="1px" Visible="false" AllowEditing="false" />
                        @if (HasGridLayout)
                        {
                            foreach (var entry in GetOrderedGridLayout())
                            {
                                var layout = entry.Layout;
                                var fieldName = entry.Field;
                                var columnType = entry.ColumnType;
                                var textAlign = entry.TextAlign;
                                var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                                var width = layout.Width.HasValue && layout.Width.Value > 0
                                    ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;
                                var format = columnType == ColumnType.Number ? "N2" : null;

                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@(width ?? "120px")"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              Format="@format"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                        }
                        else
                        {
                            @* Fallback: hardcoded columns *@
                            <GridColumn Field="@nameof(StdAddonRow.AddonCode)" HeaderText="Addon Code" Width="120px" />
                            <GridColumn Field="@nameof(StdAddonRow.Description)" HeaderText="Description" Width="250px" />
                            <GridColumn Field="@nameof(StdAddonRow.Category)" HeaderText="Category" Width="120px" />
                            <GridColumn Field="@nameof(StdAddonRow.Phase)" HeaderText="Phase" Width="100px" />
                            <GridColumn Field="@nameof(StdAddonRow.Item)" HeaderText="Item" Width="100px" />
                            <GridColumn Field="@nameof(StdAddonRow.Qty)" HeaderText="Qty" Width="80px"
                                          Format="N2" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(StdAddonRow.UOM)" HeaderText="UOM" Width="80px" />
                            <GridColumn Field="@nameof(StdAddonRow.UnitCost)" HeaderText="Unit Cost" Width="100px"
                                          Format="C2" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(StdAddonRow.ExtendedCost)" HeaderText="Extended Cost" Width="120px"
                                          Format="C2" Type="ColumnType.Number" TextAlign="TextAlign.Right"
                                          AllowEditing="false" />
                            <GridColumn Field="@nameof(StdAddonRow.Assembly)" HeaderText="Assembly" Width="120px" />
                            <GridColumn Field="@nameof(StdAddonRow.Model)" HeaderText="Model" Width="100px" />
                            <GridColumn Field="@nameof(StdAddonRow.Community)" HeaderText="Community" Width="120px" />
                            <GridColumn Field="@nameof(StdAddonRow.IsActive)" HeaderText="Active" Width="70px"
                                          Type="ColumnType.CheckBox" />
                            <GridColumn Field="@nameof(StdAddonRow.Notes)" HeaderText="Notes" Width="200px" />
                            <GridColumn Field="@nameof(StdAddonRow.SortOrder)" HeaderText="Sort Order" Width="90px"
                                          Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                        }
                    </GridColumnsBase>
                </GridControl>
            </div>

            <div class="status-bar">
                @StatusMessage
            </div>
        }
        else if (activeTab == 2)
        {
            <div class="panel">
                <p style="padding: 40px; color: #6c757d;">VB6 screenshot not available in this build.</p>
            </div>
        }
    </div>
</div>

@* ── Add Addon Dialog ──────────────────────────────────────────── *@
<DialogControl @bind-Visible="IsAddDialogVisible"
               Header="Add Standard Addon"
               Width="480px"
               IsModal="true"
               ShowCloseIcon="true"
               OnClose="() => IsAddDialogVisible = false">
    <ChildContent>
        <div class="dialog-body">
            <div class="form-group">
                <label>Addon Code:</label>
                <TextBoxControl @bind-Value="NewAddonCode" Placeholder="Enter addon code" CssClass="addon-input" />
            </div>
            <div class="form-group">
                <label>Description:</label>
                <TextBoxControl @bind-Value="NewAddonDescription" Placeholder="Enter description" CssClass="addon-input" />
            </div>
            <div class="form-group">
                <label>Category:</label>
                <TextBoxControl @bind-Value="NewAddonCategory" Placeholder="Enter category" CssClass="addon-input" />
            </div>
            <div class="form-group">
                <label>Phase:</label>
                <TextBoxControl @bind-Value="NewAddonPhase" Placeholder="Enter phase" CssClass="addon-input" />
            </div>
            <div class="form-group">
                <label>Item:</label>
                <TextBoxControl @bind-Value="NewAddonItem" Placeholder="Enter item" CssClass="addon-input" />
            </div>
            <div class="form-group">
                <label>Qty:</label>
                <NumericTextBoxControl TValue="decimal" @bind-Value="NewAddonQty" Step="0.01M" Width="100%" CssClass="addon-input" />
            </div>
            <div class="form-group">
                <label>UOM:</label>
                <TextBoxControl @bind-Value="NewAddonUOM" Placeholder="Enter UOM" CssClass="addon-input" />
            </div>
            <div class="form-group">
                <label>Unit Cost:</label>
                <NumericTextBoxControl TValue="decimal" @bind-Value="NewAddonUnitCost" Step="0.01M" Width="100%" CssClass="addon-input" />
            </div>
            <div class="form-group">
                <label>Notes:</label>
                <TextAreaControl @bind-Value="NewAddonNotes" Rows="3" Placeholder="Enter notes..." CssClass="addon-input" />
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="OnCreateAddon">Create</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="() => IsAddDialogVisible = false">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    // === Database ===
// === UI State ===
    private int activeTab = 1;
    private bool IsLoading = false;
    private bool mDirty = false;
    private string StatusMessage = "Ready";

    // === Grid ===
    private GridControl<StdAddonRow>? AddonsGrid;
    private List<StdAddonRow> AddonsData = new();
    private StdAddonRow? SelectedAddon;

    // === Grid Settings ===
    private FilterSettings filterSettings = new() { Type = FilterType.FilterBar };
    private PageSettings pageSettings = new() { PageSize = 50, PageSizes = new int[] { 25, 50, 100, 200 } };
    private SelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row,
        EnableToggle = true
    };
    private EditSettings editSettings = new()
    {
        AllowEditing = true,
        AllowAdding = true,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = true
    };
    private GridControlEvents<StdAddonRow> gridEvents = new();

    // ── Grid Layout via the shared GridLayoutPresenter ────────
    // The load/resolve/width boilerplate lives in GridLayoutPresenter<TRow>; only
    // the VB6 form/grid name strings stay here (fidelity). gAddonsLayout /
    // HasGridLayout / gAddonsLayoutVersion below are thin delegations so the markup
    // is unchanged. VB6 gridname has the .(0) index suffix → instanceKey "(0)"
    // drives the keyed-then-unkeyed two-call fallback inside LoadAsync.
    //
    // DRIFT NOTE: GetOrderedGridLayout + GetColumnTypeForField are deliberately
    // kept LOCAL here (not delegated to _g.GetOrdered) because this form's
    // ColumnTypeFor maps bool → ColumnType.CheckBox, whereas the presenter's
    // canonical ColumnTypeFor maps bool → ColumnType.Boolean. StdAddonRow.IsActive
    // is a bool column and the form's own fallback markup renders it as
    // Type="ColumnType.CheckBox", so delegating to the presenter would silently
    // change a checkbox column into a Boolean column. Field resolution (exact →
    // normalized → literal) IS delegated to _g.ResolveField; only the type-mapping
    // half stays local.
    private readonly GridLayoutPresenter<StdAddonRow> _g =
        new("FStdAddons", "gAddons", instanceKey: "(0)");

    private Dictionary<string, GridLayoutColumn> gAddonsLayout => _g.Layout;
    private bool HasGridLayout => _g.Has;
    private int gAddonsLayoutVersion => _g.Version;

    // === Add Dialog State ===
    private bool IsAddDialogVisible = false;
    private string NewAddonCode = "";
    private string NewAddonDescription = "";
    private string NewAddonCategory = "";
    private string NewAddonPhase = "";
    private string NewAddonItem = "";
    private decimal NewAddonQty = 1;
    private string NewAddonUOM = "";
    private decimal NewAddonUnitCost = 0;
    private string NewAddonNotes = "";

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        gridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<StdAddonRow>>(this, OnRowSelected);
        gridEvents.RowDeselected = EventCallback.Factory.Create<RowSelectEventArgs<StdAddonRow>>(this, OnRowDeselected);
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<StdAddonRow>>(this, OnCellSaved);

        await LoadGridLayoutAsync();
        await LoadDataAsync();
    }

    // ── Load Grid Layout ──────────────────────────────────────
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            await _g.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");

        }
    }

    // === Load Data ===
    private async Task LoadDataAsync()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var sql = @"
                SELECT 
                    AddonId, AddonCode, Description, Category, Phase, Item,
                    Qty, UOM, UnitCost, Assembly, Model, Community,
                    ISNULL(Inactive, 0) AS Inactive, Notes, SortOrder
                FROM tblStdAddons
                WHERE DivisionID = @DivisionID
                ORDER BY SortOrder, AddonCode";

            var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });

            AddonsData = rows.Select(r => new StdAddonRow
            {
                AddonId = SafeInt(r.ContainsKey("AddonId") ? r["AddonId"] : null),
                AddonCode = r["AddonCode"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? "",
                Category = r["Category"]?.ToString() ?? "",
                Phase = r["Phase"]?.ToString() ?? "",
                Item = r["Item"]?.ToString() ?? "",
                Qty = SafeDecimal(r["Qty"], 1),
                UOM = r["UOM"]?.ToString() ?? "",
                UnitCost = SafeDecimal(r["UnitCost"]),
                ExtendedCost = SafeDecimal(r["Qty"], 1) * SafeDecimal(r["UnitCost"]),
                Assembly = r["Assembly"]?.ToString() ?? "",
                Model = r["Model"]?.ToString() ?? "",
                Community = r["Community"]?.ToString() ?? "",
                IsActive = r["Inactive"]?.ToString() != "1" && r["Inactive"]?.ToString() != "True",
                Notes = r["Notes"]?.ToString() ?? "",
                SortOrder = SafeInt(r.ContainsKey("SortOrder") ? r["SortOrder"] : null),
                RowState = "CLEAN"
            }).ToList();

            mDirty = false;
            StatusMessage = $"Loaded {AddonsData.Count} standard addon(s)";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadDataAsync error");

            StatusMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Save Data ===
    private async Task<bool> SaveDataAsync()
    {
        if (!mDirty) return true;
        IsLoading = true;
        StateHasChanged();
        try
        {
            // Delete marked rows
            foreach (var row in AddonsData.Where(r => r.RowState == "Deleted"))
            {
                if (row.AddonId > 0)
                {
                    await db.ExecuteAsync(
                        "DELETE FROM tblStdAddons WHERE DivisionID = @DivisionID AND AddonId = @AddonId",
                        new { SessionState.DivisionID, row.AddonId });
                }
            }

            // Update dirty rows
            foreach (var row in AddonsData.Where(r => r.RowState == "DIRTY"))
            {
                if (row.AddonId > 0)
                {
                    await db.ExecuteAsync(@"
                        UPDATE tblStdAddons SET
                            AddonCode = @AddonCode, Description = @Description, Category = @Category,
                            Phase = @Phase, Item = @Item, Qty = @Qty, UOM = @UOM,
                            UnitCost = @UnitCost, Assembly = @Assembly, Model = @Model,
                            Community = @Community, Inactive = @Inactive, Notes = @Notes,
                            SortOrder = @SortOrder
                        WHERE DivisionID = @DivisionID AND AddonId = @AddonId",
                        new
                        {
                            SessionState.DivisionID,
                            row.AddonId,
                            row.AddonCode,
                            row.Description,
                            row.Category,
                            row.Phase,
                            row.Item,
                            row.Qty,
                            row.UOM,
                            row.UnitCost,
                            row.Assembly,
                            row.Model,
                            row.Community,
                            Inactive = !row.IsActive,
                            row.Notes,
                            row.SortOrder
                        });
                }
                row.RowState = "CLEAN";
            }

            AddonsData.RemoveAll(r => r.RowState == "Deleted");
            mDirty = false;
            StatusMessage = "Data saved successfully.";
            Notifications.Success("Data saved successfully.");
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SaveDataAsync error");

            StatusMessage = $"Error saving data: {ex.Message}";
            Notifications.Error($"Error saving data: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Event Handlers ===
    private async Task OnSaveClick() => await SaveDataAsync();

    private void OnAddClick()
    {
        NewAddonCode = "";
        NewAddonDescription = "";
        NewAddonCategory = "";
        NewAddonPhase = "";
        NewAddonItem = "";
        NewAddonQty = 1;
        NewAddonUOM = "";
        NewAddonUnitCost = 0;
        NewAddonNotes = "";
        IsAddDialogVisible = true;
    }

    private async Task OnCreateAddon()
    {
        if (string.IsNullOrWhiteSpace(NewAddonCode))
        {
            Notifications.Info("Addon Code is required.");
            return;
        }
        if (string.IsNullOrWhiteSpace(NewAddonDescription))
        {
            Notifications.Warning("Description is required.");
            return;
        }

        try
        {
            await db.ExecuteAsync(@"
                INSERT INTO tblStdAddons 
                    (DivisionID, AddonCode, Description, Category, Phase, Item, Qty, UOM, UnitCost, Notes, Inactive, SortOrder)
                VALUES 
                    (@DivisionID, @AddonCode, @Description, @Category, @Phase, @Item, @Qty, @UOM, @UnitCost, @Notes, 0, 0)",
                new
                {
                    SessionState.DivisionID,
                    AddonCode = NewAddonCode,
                    Description = NewAddonDescription,
                    Category = NewAddonCategory,
                    Phase = NewAddonPhase,
                    Item = NewAddonItem,
                    Qty = NewAddonQty,
                    UOM = NewAddonUOM,
                    UnitCost = NewAddonUnitCost,
                    Notes = NewAddonNotes
                });

            IsAddDialogVisible = false;
            await LoadDataAsync();
            StatusMessage = $"Addon '{NewAddonCode}' created successfully.";
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error creating addon: {ex.Message}");
        }
    }

    private async Task OnDeleteClick()
    {
        if (SelectedAddon == null) return;
        var confirm = await Dialogs.ConfirmAsync(
            $"Are you sure you want to delete addon '{SelectedAddon.AddonCode}'?");
        if (confirm)
        {
            SelectedAddon.RowState = "Deleted";
            mDirty = true;
            StatusMessage = $"Addon '{SelectedAddon.AddonCode}' marked for deletion. Save to confirm.";
            StateHasChanged();
        }
    }

    private async Task OnRefreshClick()
    {
        if (mDirty)
        {
            var confirm = await Dialogs.ConfirmAsync(
                "You have unsaved changes. Discard and refresh?");
            if (!confirm) return;
        }
        await LoadDataAsync();
    }

    private async Task OnExportClick()
    {
        Notifications.Success("Export to Excel - not yet implemented.");
    }

    private void OnRowSelected(RowSelectEventArgs<StdAddonRow> args)
    {
        SelectedAddon = args.Data;
    }

    private void OnRowDeselected(RowSelectEventArgs<StdAddonRow> args)
    {
        SelectedAddon = null;
    }

    private void OnCellSaved(CellSaveArgs<StdAddonRow> args)
    {
        if (args.Data != null)
        {
            args.Data.ExtendedCost = args.Data.Qty * args.Data.UnitCost;
            args.Data.RowState = "DIRTY";
            mDirty = true;
        }
    }

    // === Helpers ===
    private int SafeInt(object? val, int def = 0) =>
        val != null && val != DBNull.Value && !string.IsNullOrEmpty(val.ToString())
            ? Convert.ToInt32(val)
            : def;

    private decimal SafeDecimal(object? val, decimal def = 0) =>
        val != null && val != DBNull.Value && !string.IsNullOrEmpty(val.ToString())
            ? Convert.ToDecimal(val)
            : def;

    // ── Grid Layout Helpers ────────────────────────────────────
    // Field resolution + width are delegated to the shared GridLayoutPresenter
    // (_g.ResolveField / GridLayoutPresenter.WidthPx). GetOrderedGridLayout +
    // GetColumnTypeForField stay LOCAL — see the DRIFT NOTE on the _g field:
    // this form maps bool → ColumnType.CheckBox (its IsActive column is a
    // checkbox), but the presenter maps bool → ColumnType.Boolean. Keeping the
    // ordering loop + type mapping local preserves the exact rendered column type.
    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedGridLayout()
    {
        if (!HasGridLayout) yield break;

        var ordered = gAddonsLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = _g.ResolveField(layout.Field);
            var columnType = GetColumnTypeForField(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    // DRIFT from GridLayoutPresenter.ColumnTypeFor: bool → CheckBox (not Boolean),
    // and only int/long/double/decimal count as Number (no Date/byte/short/float).
    // Kept local intentionally so StdAddonRow.IsActive renders as a checkbox.
    private static ColumnType GetColumnTypeForField(string field)
    {
        if (string.IsNullOrWhiteSpace(field)) return ColumnType.Text;
        if (GridLayoutPresenter<StdAddonRow>.PropFor(field) is { } prop)
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool)) return ColumnType.CheckBox;
            if (type == typeof(int) || type == typeof(long) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
        }
        return ColumnType.Text;
    }

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // === Model ===
    public class StdAddonRow
    {
        public int AddonId { get; set; }
        public string AddonCode { get; set; } = "";
        public string Description { get; set; } = "";
        public string Category { get; set; } = "";
        public string Phase { get; set; } = "";
        public string Item { get; set; } = "";
        public decimal Qty { get; set; } = 1;
        public string UOM { get; set; } = "";
        public decimal UnitCost { get; set; }
        public decimal ExtendedCost { get; set; }
        public string Assembly { get; set; } = "";
        public string Model { get; set; } = "";
        public string Community { get; set; } = "";
        public bool IsActive { get; set; } = true;
        public string Notes { get; set; } = "";
        public int SortOrder { get; set; }
        public string RowState { get; set; } = "CLEAN";
    }
}
