@page "/super-user"
@namespace HomeFront.Components.Pages
@layout HFComponent
@rendermode InteractiveServer

@using System.Collections.Generic
@using System.IO
@using System.Linq
@using System.Text
@using Microsoft.Data.SqlClient
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Auth.Cognito
@using HomeFront.Data
@using HomeFront.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IDialogService Dialogs
@inject ILogger<FSuperUser> Logger
@inject NotificationService Notifications
@inject ICognitoAuthService CognitoAuth
@inject DbWrapperSqlServer _db
@inject ISessionStateService SessionState

<PageTitle>Super User Client Provisioning</PageTitle>

@if (IsLoading)
{
    <div class="su-loading">⏳ Provisioning Client... Please wait...</div>
}

<div class="superuser-container">
    <div class="su-toolbar">
        <span class="su-title">Super User Administration</span>
        @if (!string.IsNullOrEmpty(_directoryError))
        {
            <span class="su-error" style="color: #d32f2f; font-weight: bold; font-size: 11px; margin-left: 15px;" title="@_directoryError">⚠ @_directoryError</span>
        }
        <ButtonControl CssClass="su-btn" OnClick="RefreshClientsAsync">↻ Refresh Clients</ButtonControl>
    </div>

    <div class="su-panes">
        @* ── LEFT: Provision New Client ──────────────────────── *@
        <div class="su-pane su-form-pane">
            <div class="su-pane-head">
                <span class="su-pane-title">Provision New Client / Company</span>
            </div>

            <div class="su-form-box">
                <div class="su-row">
                    <label>Client ID / Company Name</label>
                    <TextBoxControl @bind-Value="_clientId" Placeholder="e.g. company-MELS" />
                </div>
                <div class="su-row">
                    <label>Database Catalog Name</label>
                    <TextBoxControl @bind-Value="_databaseName" Placeholder="e.g. HomeFront_MELS" />
                </div>
                <div class="su-row">
                    <label>Admin User ID</label>
                    <TextBoxControl @bind-Value="_adminUserId" Placeholder="e.g. mels_admin" />
                </div>
                <div class="su-row">
                    <label>Admin User Email</label>
                    <TextBoxControl @bind-Value="_adminEmail" Placeholder="e.g. admin@mels.com" />
                </div>
                <div class="su-row">
                    <label>Temporary Password</label>
                    <TextBoxControl @bind-Value="_adminPassword" InputType="password" Placeholder="Min 8 chars, mixed case, symbols" />
                </div>

                <div class="su-actions">
                    <ButtonControl CssClass="su-btn su-btn-primary" OnClick="ProvisionClientAsync" Disabled="@(!CanProvision)">
                        🚀 Provision Client & Admin
                    </ButtonControl>
                </div>
            </div>

            @if (_logs.Any())
            {
                <div class="su-log-box">
                    <div class="su-log-title">Provisioning Logs</div>
                    <div class="su-log-content">
                        @foreach (var log in _logs)
                        {
                            <div class="su-log-line">@log</div>
                        }
                    </div>
                </div>
            }
        </div>

        @* ── RIGHT: Existing Clients & User Tree Explorer ─────────────────────────── *@
        <div class="su-pane su-grid-pane">
            <div class="su-pane-head" style="display: flex; justify-content: space-between; align-items: center;">
                <span class="su-pane-title">Client Access Explorer</span>
                <div class="su-view-toggle" style="display: flex; gap: 4px;">
                    <ButtonControl CssClass="@("su-btn " + (_viewMode == ViewMode.Grid ? "su-btn-active" : ""))" Style="@(_viewMode == ViewMode.Grid ? "padding: 2px 8px; font-size: 9px; background: #0a64c8; color: #fff; font-weight: bold; border-color: #0850a0;" : "padding: 2px 8px; font-size: 9px; background: #e0e0e0; color: #000;")" OnClick="() => SetViewMode(ViewMode.Grid)">Grid View</ButtonControl>
                    <ButtonControl CssClass="@("su-btn " + (_viewMode == ViewMode.Tree ? "su-btn-active" : ""))" Style="@(_viewMode == ViewMode.Tree ? "padding: 2px 8px; font-size: 9px; background: #0a64c8; color: #fff; font-weight: bold; border-color: #0850a0;" : "padding: 2px 8px; font-size: 9px; background: #e0e0e0; color: #000;")" OnClick="() => SetViewMode(ViewMode.Tree)">Tree View</ButtonControl>
                </div>
            </div>

            @if (_viewMode == ViewMode.Grid)
            {
                <div class="su-grid-host">
                    <GridControl TValue="ClientDatabaseItem"
                                 DataSource="@Clients"
                                 AllowSelection="true"
                                 AllowSorting="true"
                                 EnableHover="true"
                                 Height="100%"
                                 WidthMode="GridWidthMode.FillAvailable">
                        <GridColumnsBase>
                            <GridColumn Field="@nameof(ClientDatabaseItem.DatabaseName)" HeaderText="Client Database Name" Width="300px" />
                            <GridColumn Field="@nameof(ClientDatabaseItem.UserCount)" HeaderText="Registered Users" Width="120px"
                                        Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                        </GridColumnsBase>
                    </GridControl>
                </div>
            }
            else
            {
                <div class="su-tree-explorer" style="display: flex; flex-direction: column; flex: 1; min-height: 0; background: #fff; border-top: 1px solid #9f9f9f;">
                    <div style="padding: 8px; border-bottom: 1px solid #9f9f9f; background: #f5f5f5; display: flex; gap: 8px; align-items: center;">
                        <span style="font-weight: bold; font-size: 10px; color: #333;">Filter by User:</span>
                        <TextBoxControl @bind-Value="_filterUserId" Placeholder="Enter User ID (e.g. admin)" Style="flex: 1;" />
                        <ButtonControl CssClass="su-btn su-btn-primary" Style="padding: 3px 10px; font-size: 10px; margin: 0;" OnClick="ApplyFilterAsync">Apply Filter</ButtonControl>
                        <ButtonControl CssClass="su-btn" Style="padding: 3px 10px; font-size: 10px; margin: 0;" OnClick="ClearFilterAsync">Clear</ButtonControl>
                        <ButtonControl CssClass="su-btn" Style="padding: 3px 10px; font-size: 10px; margin: 0;" OnClick="ExpandAllNodes">Expand All</ButtonControl>
                        <ButtonControl CssClass="su-btn" Style="padding: 3px 10px; font-size: 10px; margin: 0;" OnClick="CollapseAllNodes">Collapse All</ButtonControl>
                        <ButtonControl CssClass="su-btn" Style="padding: 3px 10px; font-size: 10px; margin: 0;" OnClick="() => _showQueryDialog = true" Disabled="@(string.IsNullOrEmpty(_lastBuiltQuery))">Show SQL</ButtonControl>
                    </div>
                    <div class="su-tree-host" style="flex: 1; overflow-y: auto; padding: 10px;">
                        @if (_treeNodes != null && _treeNodes.Any())
                        {
                            <TreeViewControl Nodes="@_treeNodes" UseVb6TreeStyle="true" FolderStyle="TreeFolderStyle.Yellow" ToggleOnNodeClick="true" />
                        }
                        else
                        {
                            <div style="color: #64748b; font-style: italic; padding: 20px; text-align: center; font-size: 10px;">No databases/users found matching filter.</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<DialogControl @bind-Visible="_showQueryDialog" Header="Dynamically Built SQL Query" Width="650px">
    <div style="padding: 12px; font-family: Consolas, monospace; font-size: 11px; white-space: pre-wrap; background: #f9f9f9; border: 1px solid #9f9f9f; max-height: 400px; overflow-y: auto; color: #111;">
        @_lastBuiltQuery
    </div>
    <div style="margin-top: 12px; display: flex; justify-content: flex-end; gap: 8px;">
        <ButtonControl CssClass="su-btn" OnClick="() => _showQueryDialog = false">Close</ButtonControl>
    </div>
</DialogControl>

@code {
    private bool IsLoading;
    private string _clientId = "";
    private string _databaseName = "";
    private string _adminUserId = "";
    private string _adminEmail = "";
    private string _adminPassword = "";

    private List<ClientDatabaseItem> Clients = new();
    private List<string> _logs = new();
    private string? _directoryError;

    private enum ViewMode { Grid, Tree }
    private ViewMode _viewMode = ViewMode.Grid;
    private string _filterUserId = "";
    private List<TreeNode> _treeNodes = new();
    private bool _showQueryDialog;
    private string _lastBuiltQuery = "";

    private bool CanProvision =>
        !string.IsNullOrWhiteSpace(_clientId) &&
        !string.IsNullOrWhiteSpace(_databaseName) &&
        !string.IsNullOrWhiteSpace(_adminUserId) &&
        !string.IsNullOrWhiteSpace(_adminEmail) &&
        !string.IsNullOrWhiteSpace(_adminPassword);

    protected override async Task OnInitializedAsync()
    {
        await RefreshClientsAsync();
    }

    private async Task RefreshClientsAsync()
    {
        IsLoading = true;
        _directoryError = null;
        try
        {
            var dbList = new List<ClientDatabaseItem>();
            var dbs = await _db.QueryAsync(
                "SELECT name FROM sys.databases WHERE name NOT IN ('master', 'tempdb', 'model', 'msdb') " +
                "AND DATABASEPROPERTYEX(name, 'Status') = 'ONLINE'");
                
            foreach (var db in dbs)
            {
                var dbName = db["name"]?.ToString();
                if (string.IsNullOrEmpty(dbName)) continue;
                
                try
                {
                    var tableExists = await _db.ExecuteScalarAsync<int?>(
                        $"SELECT COUNT(*) FROM [{dbName}].sys.tables WHERE name = 'user_manager'") ?? 0;
                        
                    if (tableExists > 0)
                    {
                        var userCount = await _db.ExecuteScalarAsync<int?>(
                            $"SELECT COUNT(*) FROM [{dbName}].dbo.user_manager") ?? 0;
                            
                        dbList.Add(new ClientDatabaseItem
                        {
                            DatabaseName = dbName,
                            UserCount = userCount
                        });
                    }
                }
                catch
                {
                    // Ignore databases we don't have permission to query
                }
            }
            
            Clients = dbList.OrderBy(d => d.DatabaseName).ToList();

            if (_viewMode == ViewMode.Tree)
            {
                await LoadTreeDataAsync();
            }
        }
        catch (Exception ex)
        {
            _directoryError = ex.Message;
            Notifications.Error($"Error loading databases: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SetViewMode(ViewMode mode)
    {
        _viewMode = mode;
        if (mode == ViewMode.Tree)
        {
            await LoadTreeDataAsync();
        }
        StateHasChanged();
    }

    private async Task ApplyFilterAsync()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            await LoadTreeDataAsync();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearFilterAsync()
    {
        _filterUserId = "";
        IsLoading = true;
        StateHasChanged();
        try
        {
            await LoadTreeDataAsync();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadTreeDataAsync()
    {
        _treeNodes.Clear();
        try
        {
            var isFilterActive = !string.IsNullOrWhiteSpace(_filterUserId);
            var querySql = @"
SET NOCOUNT ON;
DECLARE @dbName NVARCHAR(128);
DECLARE @sql NVARCHAR(MAX);
DECLARE @tableExists INT;

CREATE TABLE #MatchingUsers (
    DbName NVARCHAR(128) COLLATE database_default,
    user_id VARCHAR(50) COLLATE database_default,
    firstname VARCHAR(50) COLLATE database_default,
    lastname VARCHAR(50) COLLATE database_default,
    email VARCHAR(100) COLLATE database_default
);

DECLARE db_cursor CURSOR FOR 
SELECT name FROM sys.databases WHERE name NOT IN ('master', 'tempdb', 'model', 'msdb') AND DATABASEPROPERTYEX(name, 'Status') = 'ONLINE';

OPEN db_cursor;
FETCH NEXT FROM db_cursor INTO @dbName;

WHILE @@FETCH_STATUS = 0
BEGIN
    SET @tableExists = 0;
    SET @sql = 'SELECT @exists = COUNT(*) FROM [' + @dbName + '].sys.tables WHERE name = ''user_manager''';
    BEGIN TRY
        EXEC sp_executesql @sql, N'@exists INT OUTPUT', @exists = @tableExists OUTPUT;
        IF @tableExists > 0
        BEGIN
            IF @FilterActive = 1
            BEGIN
                SET @sql = 'INSERT INTO #MatchingUsers SELECT ''' + @dbName + ''' COLLATE database_default, user_id COLLATE database_default, firstname COLLATE database_default, lastname COLLATE database_default, email COLLATE database_default FROM [' + @dbName + '].dbo.user_manager WHERE user_id = @FilterUser';
                EXEC sp_executesql @sql, N'@FilterUser VARCHAR(50)', @FilterUser = @FilterUserParam;
            END
            ELSE
            BEGIN
                SET @sql = 'INSERT INTO #MatchingUsers SELECT ''' + @dbName + ''' COLLATE database_default, user_id COLLATE database_default, firstname COLLATE database_default, lastname COLLATE database_default, email COLLATE database_default FROM [' + @dbName + '].dbo.user_manager';
                EXEC sp_executesql @sql;
            END
        END
    END TRY
    BEGIN CATCH
        -- Ignore offline or inaccessible databases
    END CATCH
    FETCH NEXT FROM db_cursor INTO @dbName;
END

CLOSE db_cursor;
DEALLOCATE db_cursor;

SELECT DbName, user_id, firstname, lastname, email FROM #MatchingUsers ORDER BY DbName, user_id;
DROP TABLE #MatchingUsers;
";
            _lastBuiltQuery = querySql;
            var queryParams = new
            {
                FilterActive = isFilterActive ? 1 : 0,
                FilterUserParam = isFilterActive ? _filterUserId.Trim() : ""
            };

            var userRows = await _db.QueryAsync(querySql, queryParams);

            // Group by Database Name and construct tree nodes
            var groupedByDb = userRows
                .GroupBy(r => r["DbName"]?.ToString() ?? "")
                .Where(g => !string.IsNullOrEmpty(g.Key))
                .ToList();

            foreach (var group in groupedByDb)
            {
                var dbNode = new TreeNode
                {
                    Text = $"{group.Key} ({group.Count()} users)",
                    IsExpanded = true
                };

                foreach (var row in group)
                {
                    var userId = row["user_id"]?.ToString() ?? "";
                    var first = row["firstname"]?.ToString() ?? "";
                    var last = row["lastname"]?.ToString() ?? "";
                    var email = row["email"]?.ToString() ?? "";
                    
                    var displayText = string.IsNullOrWhiteSpace(first) && string.IsNullOrWhiteSpace(last)
                        ? userId
                        : $"{userId} ({first} {last} - {email})";

                    dbNode.Children.Add(new TreeNode
                    {
                        Text = displayText,
                        Tag = new { DbName = group.Key, UserId = userId }
                    });
                }

                _treeNodes.Add(dbNode);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load database tree data");
            Notifications.Error($"Failed to load tree: {ex.Message}");
        }
    }

    private void ExpandAllNodes()
    {
        SetExpandedRecursive(_treeNodes, true);
    }

    private void CollapseAllNodes()
    {
        SetExpandedRecursive(_treeNodes, false);
    }

    private void SetExpandedRecursive(List<TreeNode> nodes, bool isExpanded)
    {
        if (nodes == null) return;
        foreach (var node in nodes)
        {
            node.IsExpanded = isExpanded;
            if (node.HasChildren)
            {
                SetExpandedRecursive(node.Children, isExpanded);
            }
        }
    }

    private static string FriendlyError(string? raw)
    {
        if (!string.IsNullOrEmpty(raw) &&
            raw.Contains("resolve", StringComparison.OrdinalIgnoreCase) &&
            raw.Contains("credential", StringComparison.OrdinalIgnoreCase))
        {
            return "AWS admin credentials are not configured. Set Cognito:AccessKeyId and "
                 + "Cognito:SecretAccessKey (user-secrets in dev, env vars in prod) to manage client databases.";
        }
        return raw ?? "Cognito directory request failed.";
    }

    private void AddLog(string msg)
    {
        _logs.Add($"[{DateTime.Now:HH:mm:ss}] {msg}");
        StateHasChanged();
    }

    private async Task ProvisionClientAsync()
    {
        if (!CanProvision) return;

        IsLoading = true;
        _logs.Clear();
        AddLog($"Starting provisioning for Client: {_clientId}...");

        try
        {
            // 1. Create Cognito User
            AddLog("1. Creating AWS Cognito User...");
            var userResult = await CognitoAuth.AdminCreateUserAsync(_adminUserId, _adminEmail, _adminPassword);
            if (!userResult.Success)
            {
                throw new Exception($"Failed to create Cognito User: {userResult.ErrorMessage}");
            }
            AddLog($"AWS Cognito User '{_adminUserId}' created successfully.");

            // 2. Duplicate database
            AddLog("2. Initializing Database cloning...");
            var sourceDb = new SqlConnectionStringBuilder(_db.GetConnectionString()).InitialCatalog;
            await CopyDatabaseAsync(sourceDb, _databaseName);
            AddLog($"Database '{_databaseName}' replicated successfully.");

            // 3. Seed Admin User seed inside new database
            AddLog("3. Provisioning Admin User credentials inside database...");
            await ProvisionAdminUserAsync(_databaseName, _adminUserId, _adminEmail, _adminPassword);
            AddLog("Admin User registered in client database successfully.");

            Notifications.Success($"Client '{_clientId}' provisioned successfully!");
            AddLog("🎉 Provisioning completed successfully!");

            // Clear inputs
            _clientId = "";
            _databaseName = "";
            _adminUserId = "";
            _adminEmail = "";
            _adminPassword = "";

            await RefreshClientsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ProvisionClient failed");
            AddLog($"❌ Provisioning failed: {ex.Message}");
            Notifications.Error($"Provisioning failed: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CopyDatabaseAsync(string sourceDb, string newDbName)
    {
        // 1. Get database files
        var files = await _db.QueryAsync(
            "SELECT name, physical_name AS PhysicalPath, type FROM sys.master_files WHERE database_id = DB_ID(@DbName)",
            new { DbName = sourceDb });
            
        if (files.Count == 0)
        {
            throw new Exception($"Source database '{sourceDb}' not found or files could not be queried.");
        }

        // Get the directory containing the physical files
        var firstPath = files[0]["PhysicalPath"]?.ToString();
        if (string.IsNullOrEmpty(firstPath))
            throw new Exception("Unable to resolve physical path of source database.");
            
        var dataDir = Path.GetDirectoryName(firstPath);
        if (string.IsNullOrEmpty(dataDir))
            throw new Exception("Unable to resolve data directory of source database.");

        var tempBakPath = Path.Combine(dataDir, $"{sourceDb}_temp.bak");

        // 2. Perform BACKUP
        AddLog($"Backing up template database '{sourceDb}' to {tempBakPath}...");
        
        var masterConnStr = new SqlConnectionStringBuilder(_db.GetConnectionString())
        {
            InitialCatalog = "master"
        }.ConnectionString;
        
        var masterDb = new DbWrapperSqlServer(masterConnStr);
        
        await masterDb.ExecuteAsync(
            $"BACKUP DATABASE [{sourceDb}] TO DISK = @BakPath WITH FORMAT, INIT",
            new { BakPath = tempBakPath });

        // 3. Build RESTORE command with MOVE clauses
        AddLog($"Restoring database as '{newDbName}'...");
        var moveClauses = new List<string>();
        foreach (var file in files)
        {
            var logicalName = file["name"]?.ToString() ?? "";
            var physicalPath = file["PhysicalPath"]?.ToString() ?? "";
            var ext = Path.GetExtension(physicalPath);
            
            var newFileName = logicalName.Replace(sourceDb, newDbName, StringComparison.OrdinalIgnoreCase);
            if (!newFileName.Contains(newDbName, StringComparison.OrdinalIgnoreCase))
            {
                newFileName = newDbName + "_" + logicalName;
            }
            var newPhysicalPath = Path.Combine(dataDir, newFileName + ext);
            
            moveClauses.Add($"MOVE '{logicalName}' TO '{newPhysicalPath}'");
        }
        
        var restoreSql = $"RESTORE DATABASE [{newDbName}] FROM DISK = @BakPath WITH REPLACE, " + string.Join(", ", moveClauses);
        await masterDb.ExecuteAsync(restoreSql, new { BakPath = tempBakPath });

        // 4. Try to delete temp backup file
        try
        {
            if (File.Exists(tempBakPath))
            {
                File.Delete(tempBakPath);
            }
        }
        catch (Exception ex)
        {
            AddLog($"[Warning] Failed to delete temporary backup file: {ex.Message}");
        }
    }

    private async Task ProvisionAdminUserAsync(string clientDbName, string username, string email, string tempPassword)
    {
        AddLog($"Connecting to database '{clientDbName}'...");
        
        var clientConnStr = new SqlConnectionStringBuilder(_db.GetConnectionString())
        {
            InitialCatalog = clientDbName
        }.ConnectionString;
        
        var clientDb = new DbWrapperSqlServer(clientConnStr);
        
        // 1. Query Administrators group
        var secGroupId = await clientDb.ExecuteScalarAsync<long?>(
            "SELECT TOP 1 SecGroupID FROM SecurityGroups WHERE Description LIKE '%Admin%'") ?? 0L;
            
        if (secGroupId == 0)
        {
            secGroupId = await clientDb.ExecuteScalarAsync<long?>(
                "SELECT TOP 1 SecGroupID FROM SecurityGroups") ?? 1L;
        }

        // 2. Insert user into user_manager
        var existingCount = await clientDb.ExecuteScalarAsync<int?>(
            "SELECT COUNT(*) FROM user_manager WHERE user_id = @UserID",
            new { UserID = username }) ?? 0;
            
        var encryptedPassword = MyCrypt(tempPassword, "Fazlul");

        if (existingCount == 0)
        {
            await clientDb.ExecuteAsync(
                "INSERT INTO user_manager(user_id, SecGroupID) VALUES(@UserID, @SecGroupID)",
                new { UserID = username, SecGroupID = secGroupId });
        }
        
        await clientDb.ExecuteAsync(
            "UPDATE user_manager SET firstname=@First, lastname=@Last, email=@Email, Designation='Client Admin', " +
            "crmaccess=1, pmuser=1, user_Password=@Password WHERE user_id=@UserID",
            new { UserID = username, First = "Admin", Last = "User", Email = email, Password = encryptedPassword });

        // 3. Associate with all divisions
        await clientDb.ExecuteAsync(
            "DELETE FROM divisionusers WHERE userid=@UserID",
            new { UserID = username });
            
        await clientDb.ExecuteAsync(
            "INSERT INTO divisionusers(divisionid, userid) " +
            "SELECT divisionid, @UserID FROM divisions",
            new { UserID = username });
    }

    // VB6 ZYBFunctions MyCrypt — positional additive cipher, same shift table
    // as the login form. A local derivation here produced different ciphertext,
    // so accounts created on this form could never be authenticated.
    private static readonly int[] FazlulShift = { -4, 6, 1, 7, 0, 2 };

    private static string MyCrypt(string text, string key)
    {
        if (string.IsNullOrEmpty(text)) return "";
        if (!string.Equals(key, "Fazlul", StringComparison.Ordinal))
            throw new NotSupportedException(
                $"VB6 MyCrypt shift table is only known for key 'Fazlul' (got '{key}').");
        var sb = new StringBuilder(text.Length);
        for (int i = 0; i < text.Length; i++)
            sb.Append((char)(((text[i] + FazlulShift[i % FazlulShift.Length]) % 256 + 256) % 256));
        return sb.ToString();
    }

    public class ClientDatabaseItem
    {
        public string DatabaseName { get; set; } = "";
        public int UserCount { get; set; }
    }
}
