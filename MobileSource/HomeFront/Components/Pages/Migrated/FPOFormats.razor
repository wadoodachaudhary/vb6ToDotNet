    // === Helpers ===
    private string SafeStr(Dictionary<string, object> row, string key)
    {
        if (!row.ContainsKey(key)) return "";
        var val = row[key];
        if (val == null || val == DBNull.Value) return "";
        return val.ToString() ?? "";
    }

    private decimal? SafeDecimalNullable(Dictionary<string, object> row, string key)
    {
        if (!row.ContainsKey(key)) return null;
        var val = row[key];
        if (val == null || val == DBNull.Value) return null;
        var d = Convert.ToDecimal(val);
        return d == 0 ? null : d;
    }

    private object? NullIfEmpty(string? val) =>
        string.IsNullOrWhiteSpace(val) ? null : val;

