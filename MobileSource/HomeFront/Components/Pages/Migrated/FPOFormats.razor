@page "/po-formats"
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.IO
@using System.Collections.Generic
@using System.Linq
@using System.Text
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using Microsoft.AspNetCore.Hosting
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FPOFormats> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IWebHostEnvironment Env
@using HomeFront.Models
@inject DbWrapperSqlServer db

<PageTitle>Purchase Order Setup - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">Loading Purchase Orders...</div>
    </div>
}

<div class="po-container">
    @* Grid (VB6 gData - one grid with synthetic heading rows) *@
    <div class="grid-panel">
        <GridControl @ref="DataGrid"
                TValue="POFormatRow"
                DataSource="@GridData"
                CssClass="po-format-grid"
                AllowSorting="false"
                AllowResizing="true"
                AllowSelection="true"
                EnableAltRow="false"
                EnableHover="true"
                ShowSelectionInfoBar="false"
                Height="100%"
                Width="100%"
                WidthMode="GridWidthMode.FillAvailable"
                GridLines="GridLines.Vertical"
                RowHeight="16"
                BatchEditBehavior="GridBatchEditBehavior.SingleCell"
                AllowSingleCellColumnMassEdit="true"
                RowCssClassSelector="GetGridRowCssClass"
                SelectionSettingsRef="@selectionSettings"
                EditSettingsRef="@editSettings"
                EventsRef="@gridEvents">
            <GridColumnsBase @key="_gridColumnsKey">
                @* Hidden backing columns *@
                <GridColumn Field="@nameof(POFormatRow.RowType)" HeaderText="" Width="1px" Visible="false" AllowEditing="false" />
                <GridColumn Field="@nameof(POFormatRow.RowState)" HeaderText="" Width="1px" Visible="false" AllowEditing="false" />
                <GridColumn Field="@nameof(POFormatRow.ReleaseTaskID)" HeaderText="" Width="1px" Visible="false" AllowEditing="false" />
                <GridColumn Field="@nameof(POFormatRow.PayPoint1TaskID)" HeaderText="" Width="1px" Visible="false" AllowEditing="false" />
                <GridColumn Field="@nameof(POFormatRow.PayPoint2TaskID)" HeaderText="" Width="1px" Visible="false" AllowEditing="false" />
                <GridColumn Field="@nameof(POFormatRow.PayPoint3TaskID)" HeaderText="" Width="1px" Visible="false" AllowEditing="false" />
                <GridColumn Field="@nameof(POFormatRow.PayPoint4TaskID)" HeaderText="" Width="1px" Visible="false" AllowEditing="false" />
                <GridColumn Field="@nameof(POFormatRow.PayPoint5TaskID)" HeaderText="" Width="1px" Visible="false" AllowEditing="false" />

                @* Visible columns (VB6 FRX order: Heading/POIndex, Description, POGroup, #, $, !, Format, Release After, Pmt1-5, Pmt1-5 Task) *@
                <GridColumn Field="@nameof(POFormatRow.Heading)" HeaderText="Item" Width="112px" AllowEditing="false" />
                <GridColumn Field="@nameof(POFormatRow.POIndex)" HeaderText="Purchase Orders" Width="75px"
                              IsPrimaryKey="true" AllowEditing="false" />
                <GridColumn Field="@nameof(POFormatRow.Description)" HeaderText="Description" Width="280px" />
                <GridColumn Field="@nameof(POFormatRow.POGroup)" HeaderText="Group" Width="120px"
                              EditOptions="@POGroupEditOptions" />
                @* HHM-434: the #/$/! flag columns are ColHidden in VB6 (FRX) — kept as
                   hidden backing columns; still editable via the Edit-PO dialog and saved. *@
                <GridColumn Field="@nameof(POFormatRow.HideQty)" Visible="false" AllowEditing="false" />
                <GridColumn Field="@nameof(POFormatRow.HidePrice)" Visible="false" AllowEditing="false" />
                <GridColumn Field="@nameof(POFormatRow.TotalOnly)" Visible="false" AllowEditing="false" />
                <GridColumn Field="@nameof(POFormatRow.POFormat)" HeaderText="Format" Width="184px"
                              EditOptions="@FormatEditOptions"
                              PreferCellEditOnDoubleClick="true"
                              OpenEditOptionsOnEdit="false" />
                <GridColumn Field="@nameof(POFormatRow.ReleaseTaskDesc)" HeaderText="Release After" Width="108px"
                              AllowEditing="false"
                              ShowEditButton="true"
                              ShowEditButtonPredicate="IsPOIndexRowObject"
                              ClipMode="ClipMode.Ellipsis" />
                <GridColumn Field="@nameof(POFormatRow.PayPoint1Percent)" HeaderText="Pmt1" Width="38px"
                              Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right"
                              SelectAllOnEdit="true">
                    <Template>@GetPercentCellText((POFormatRow)context, ((POFormatRow)context).PayPoint1Percent, "Pmt1")</Template>
                </GridColumn>
                <GridColumn Field="@nameof(POFormatRow.PayPoint2Percent)" HeaderText="Pmt2" Width="38px"
                              Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right"
                              SelectAllOnEdit="true">
                    <Template>@GetPercentCellText((POFormatRow)context, ((POFormatRow)context).PayPoint2Percent, "Pmt2")</Template>
                </GridColumn>
                <GridColumn Field="@nameof(POFormatRow.PayPoint3Percent)" HeaderText="Pmt3" Width="38px"
                              Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right"
                              SelectAllOnEdit="true">
                    <Template>@GetPercentCellText((POFormatRow)context, ((POFormatRow)context).PayPoint3Percent, "Pmt3")</Template>
                </GridColumn>
                <GridColumn Field="@nameof(POFormatRow.PayPoint4Percent)" HeaderText="Pmt4" Width="38px"
                              Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right"
                              SelectAllOnEdit="true">
                    <Template>@GetPercentCellText((POFormatRow)context, ((POFormatRow)context).PayPoint4Percent, "Pmt4")</Template>
                </GridColumn>
                <GridColumn Field="@nameof(POFormatRow.PayPoint5Percent)" HeaderText="Pmt5" Width="38px"
                              Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right"
                              AllowEditing="false">
                    <Template>@GetPercentCellText((POFormatRow)context, ((POFormatRow)context).PayPoint5Percent, "Pmt5")</Template>
                </GridColumn>
                <GridColumn Field="@nameof(POFormatRow.PayPoint1Task)" HeaderText="Pmt1 Task" Width="160px"
                              AllowEditing="false"
                              ShowEditButton="true"
                              ShowEditButtonPredicate="IsPOIndexRowObject"
                              ClipMode="ClipMode.Ellipsis" />
                <GridColumn Field="@nameof(POFormatRow.PayPoint2Task)" HeaderText="Pmt2 Task" Width="160px"
                              AllowEditing="false"
                              ShowEditButton="true"
                              ShowEditButtonPredicate="IsPOIndexRowObject"
                              ClipMode="ClipMode.Ellipsis" />
                <GridColumn Field="@nameof(POFormatRow.PayPoint3Task)" HeaderText="Pmt3 Task" Width="160px"
                              AllowEditing="false"
                              ShowEditButton="true"
                              ShowEditButtonPredicate="IsPOIndexRowObject"
                              ClipMode="ClipMode.Ellipsis" />
                <GridColumn Field="@nameof(POFormatRow.PayPoint4Task)" HeaderText="Pmt4 Task" Width="160px"
                              AllowEditing="false"
                              ShowEditButton="true"
                              ShowEditButtonPredicate="IsPOIndexRowObject"
                              ClipMode="ClipMode.Ellipsis" />
                <GridColumn Field="@nameof(POFormatRow.PayPoint5Task)" HeaderText="Pmt5 Task" Width="160px"
                              AllowEditing="false"
                              ShowEditButton="true"
                              ShowEditButtonPredicate="IsPOIndexRowObject"
                              ClipMode="ClipMode.Ellipsis" />
            </GridColumnsBase>
        </GridControl>
    </div>

    @* Bottom strip (VB6 Toolbar at left, OK / Cancel at right) *@
    <div class="footer-bar">
        <div class="toolbar-cntr">
            <button class="tbar-btn" @onclick="OnNewPOClick">
                <img src="images/16/newworksheet.ico" class="tbar-icon" onerror="this.style.display='none'" />
                <span class="tool-label">New PO</span>
            </button>
            <button class="tbar-btn" disabled="@(SelectedRow == null || SelectedRow.RowType != "POINDEX")" @onclick="OnEditPOClick">
                <img src="images/16/purchaseorder.ico" class="tbar-icon" onerror="this.style.display='none'" />
                <span class="tool-label">Edit PO</span>
            </button>
            <button class="tbar-btn" disabled="@(SelectedRow == null || SelectedRow.RowType != "POINDEX")" @onclick="OnDeleteClick">
                <img src="images/16/Delete.ico" class="tbar-icon" onerror="this.style.display='none'" />
                <span class="tool-label">Delete</span>
            </button>
            <button class="tbar-btn" @onclick="OnItemsClick">
                <img src="images/16/HelpSearch.ico" class="tbar-icon" onerror="this.style.display='none'" />
                <span class="tool-label">Items</span>
            </button>
            <button class="tbar-btn" @onclick="OnVendorsClick">
                <img src="images/16/contact2.ico" class="tbar-icon" onerror="this.style.display='none'" />
                <span class="tool-label">Vendors</span>
            </button>
            @* HHM-395: VB6 keeps Preview always enabled; the click guard below no-ops safely. *@
            <button class="tbar-btn" @onclick="OnPreviewClick">
                <img src="images/16/Preview.ico" class="tbar-icon" onerror="this.style.display='none'" />
                <span class="tool-label">Preview</span>
            </button>
        </div>
        <div class="footer-actions">
            <button @onclick="OnOkClick">OK</button>
            <button @onclick="OnCancelClick">Cancel</button>
        </div>
    </div>
</div>

@* Scheduling-task picker (VB6: FPickList.Choose ... "SELECT TaskID,Description FROM LibraryTasks") *@
<FPickList @ref="taskPickList" OnSelected="OnTaskPicked" OnCancel="OnTaskPickerCancelled" />

@* PO Index Editor (child dialog) *@
<FPOIndex @ref="poIndexEditor" OnClosed="OnPOIndexClosed" />

<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            NavigationManager.NavigateTo("/main");
    }

    private const string SRCFILE = "FPOFormats";

    // === UI State ===
    private bool IsLoading = false;
    private bool mDirty = false;
    private GridControl<POFormatRow>? DataGrid;
    private Fx.ControlKit.Dialogs.MessageBoxControl? _messageBox;
    private POFormatRow? SelectedRow;
    private readonly int _gridColumnsKey = 1; // static column set

    // === Grid Settings ===
    private SelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Multiple,
        Mode = SelectionMode.Cell,
        MultiSelectBehavior = GridMultiSelectBehavior.VBMultiSelect
    };
    private EditSettings editSettings = new()
    {
        AllowEditing = true,
        Mode = EditMode.Batch,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };
    private GridControlEvents<POFormatRow> gridEvents = new();

    // === Scheduling-task picker (FPickList) ===
    private FPickList? taskPickList;
    private POFormatRow? PickTaskTargetRow;
    private int PickTaskTargetPoint = 0; // 0 = release, 1-5 = paypoint

    private async Task ResumeGridKeyboardNavigationAsync()
    {
        if (DataGrid == null) return;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await DataGrid.ResumeKeyboardNavigationAsync();
    }

    private void ClearTaskPickerState()
    {
        PickTaskTargetRow = null;
        PickTaskTargetPoint = 0;
    }

    // === Data ===
    private List<POFormatRow> GridData = new();
    private List<string> FormatList = new();
    private List<string> POGroupList = new();
    private string GlobalPOFormat = "";
    private IEnumerable<string> FormatEditOptions => new[] { "" }.Concat(FormatList);
    private IEnumerable<string> POGroupEditOptions => new[] { "" }.Concat(POGroupList);

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        gridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<POFormatRow>>(this, OnRowSelected);
        gridEvents.CellSelected = EventCallback.Factory.Create<CellSelectEventArgs<POFormatRow>>(this, OnCellSelected);
        gridEvents.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<POFormatRow>>(this, OnCellEdit);
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<POFormatRow>>(this, OnCellSaved);
        gridEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<POFormatRow>>(this, OnGridEditButtonClick);
        gridEvents.OnRecordDoubleClick = EventCallback.Factory.Create<CellClickEventArgs<POFormatRow>>(this, OnGridRecordDoubleClick);

        LoadFormats();
        await LoadData();
    }

    // === Load PO Report Formats (VB6: Dir(SystemFolder\Estimating\PO Formats\*.rpt)) ===
    private void LoadFormats()
    {
        FormatList.Clear();
        try
        {
            var dir = Path.Combine(Env.WebRootPath, "resources", "Estimating", "PO Formats");
            if (Directory.Exists(dir))
            {
                // VB6 sorts the raw Dir() results — names WITH the extension — and strips
                // afterwards (FPOFormats.frm:520-529). Sorting stripped names reorders them,
                // because '.' sorts after ' ' once the shared prefix is consumed.
                foreach (var f in Directory.GetFiles(dir, "*.rpt")
                                           .Select(p => Path.GetFileName(p))
                                           .Where(n => !string.IsNullOrWhiteSpace(n))
                                           .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                                           .Select(n => Path.GetFileNameWithoutExtension(n))
                                           .Where(n => !string.IsNullOrWhiteSpace(n)))
                {
                    if (!FormatList.Contains(f!))
                        FormatList.Add(f!);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[{SRCFILE}.LoadFormats]", SRCFILE);
        }
    }

    // === Load Data (VB6 LoadData) ===
    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            GridData.Clear();
            POGroupList.Clear();

            // VB6: DELETE FROM tblPOIndex WHERE DivisionID=.. AND ISNULL(POIndex,'')=''
            await db.ExecuteAsync(
                "DELETE FROM tblPOIndex WHERE DivisionID = @DivisionID AND ISNULL(POIndex,'')=''",
                new { SessionState.DivisionID });

            // Global default format - VB6: HFApp.Options(POFormat) -> AppOptions option 'POFormat'
            // (division-specific value overrides corporate/0)
            var globalResult = await db.ExecuteScalarAsync<string>(
                "SELECT TOP 1 OptionValue FROM AppOptions WHERE OptionName='POFormat' AND DivisionID IN (0,@DivisionID) ORDER BY DivisionID DESC",
                new { SessionState.DivisionID });
            GlobalPOFormat = globalResult ?? "";

            // VB6 row 0: synthetic in-grid heading (RowData=""), not a separate grid.
            GridData.Add(new POFormatRow
            {
                Heading = "Item",
                POFormat = "Format",
                RowType = "HEADER",
                RowState = "CLEAN"
            });

            // VB6 row 1: "Global Default" (RowData="GLOBAL"), only POFormat editable.
            GridData.Add(new POFormatRow
            {
                POIndex = "Global Default",
                POFormat = GlobalPOFormat,
                RowType = "GLOBAL",
                RowState = "CLEAN"
            });

            // VB6 row 2: synthetic purchase-order caption row.
            GridData.Add(new POFormatRow
            {
                Heading = "Purchase Orders",
                POGroup = "Group",
                POFormat = "Format",
                ReleaseTaskDesc = "Release After",
                PayPoint1Task = "Pmt1 Task",
                PayPoint2Task = "Pmt2 Task",
                PayPoint3Task = "Pmt3 Task",
                PayPoint4Task = "Pmt4 Task",
                PayPoint5Task = "Pmt5 Task",
                RowType = "HEADER",
                RowState = "CLEAN"
            });

            // VB6: SELECT p.*, rt/p1..p5 LibraryTasks descriptions
            var sql = @"
                SELECT
                    p.*,
                    rt.Description AS ReleaseTaskDesc,
                    p1.Description AS PayPoint1Desc,
                    p2.Description AS PayPoint2Desc,
                    p3.Description AS PayPoint3Desc,
                    p4.Description AS PayPoint4Desc,
                    p5.Description AS PayPoint5Desc
                FROM tblPOIndex p
                LEFT OUTER JOIN LibraryTasks rt ON p.ReleaseTaskID = rt.TaskID
                LEFT OUTER JOIN LibraryTasks p1 ON p.PayPoint1SchedTask = p1.TaskID
                LEFT OUTER JOIN LibraryTasks p2 ON p.PayPoint2SchedTask = p2.TaskID
                LEFT OUTER JOIN LibraryTasks p3 ON p.PayPoint3SchedTask = p3.TaskID
                LEFT OUTER JOIN LibraryTasks p4 ON p.PayPoint4SchedTask = p4.TaskID
                LEFT OUTER JOIN LibraryTasks p5 ON p.PayPoint5SchedTask = p5.TaskID
                WHERE p.DivisionID = @DivisionID
                ORDER BY p.POIndex";

            var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });

            foreach (var r in rows)
            {
                var row = new POFormatRow
                {
                    POIndex = r["POIndex"]?.ToString() ?? "",
                    Description = r["Description"]?.ToString() ?? "",
                    POGroup = r["POGroup"]?.ToString() ?? "",
                    HideQty = r["HideQty"]?.ToString() == "True",
                    HidePrice = r["HidePrice"]?.ToString() == "True",
                    TotalOnly = r["TotalOnly"]?.ToString() == "True",
                    POFormat = r["POFormat"]?.ToString() ?? "",
                    ReleaseTaskID = SafeStr(r, "ReleaseTaskID"),
                    ReleaseTaskDesc = r["ReleaseTaskDesc"]?.ToString() ?? "",
                    PayPoint1Percent = SafeDecimalNullable(r, "PayPoint1Percent"),
                    PayPoint2Percent = SafeDecimalNullable(r, "PayPoint2Percent"),
                    PayPoint3Percent = SafeDecimalNullable(r, "PayPoint3Percent"),
                    PayPoint4Percent = SafeDecimalNullable(r, "PayPoint4Percent"),
                    PayPoint5Percent = SafeDecimalNullable(r, "PayPoint5Percent"),
                    PayPoint1Task = r["PayPoint1Desc"]?.ToString() ?? "",
                    PayPoint2Task = r["PayPoint2Desc"]?.ToString() ?? "",
                    PayPoint3Task = r["PayPoint3Desc"]?.ToString() ?? "",
                    PayPoint4Task = r["PayPoint4Desc"]?.ToString() ?? "",
                    PayPoint5Task = r["PayPoint5Desc"]?.ToString() ?? "",
                    PayPoint1TaskID = SafeStr(r, "PayPoint1SchedTask"),
                    PayPoint2TaskID = SafeStr(r, "PayPoint2SchedTask"),
                    PayPoint3TaskID = SafeStr(r, "PayPoint3SchedTask"),
                    PayPoint4TaskID = SafeStr(r, "PayPoint4SchedTask"),
                    PayPoint5TaskID = SafeStr(r, "PayPoint5SchedTask"),
                    RowType = "POINDEX",
                    RowState = "CLEAN"
                };

                if (!string.IsNullOrWhiteSpace(row.POGroup) && !POGroupList.Contains(row.POGroup))
                    POGroupList.Add(row.POGroup);

                GridData.Add(row);
            }

            mDirty = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}.LoadData]", SRCFILE);
            Notifications.Error($"Error loading data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Save Data (VB6 SaveData) ===
    private async Task<bool> SaveData(bool prompt)
    {
        if (DataGrid != null)
            await DataGrid.EndEditAsync();

        if (!mDirty) return true;

        if (prompt)
        {
            if (_messageBox == null)
                return false;

            // VB6 FPOFormats.frm:817 — MsgBox(..., vbExclamation + vbYesNoCancel, Me.Caption)
            var result = await _messageBox.ShowAsync(
                "This data has changed.\n\nDo you want to save the changes?",
                title: "Purchase Order Setup",
                buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel,
                icon: "warning");

            if (result == Fx.ControlKit.Dialogs.MessageBoxResult.Cancel)
                return false;
            if (result == Fx.ControlKit.Dialogs.MessageBoxResult.No)
                return true;
        }

        IsLoading = true;
        StateHasChanged();
        try
        {
            foreach (var row in GridData.Where(r => r.RowState == "DIRTY"))
            {
                switch (row.RowType)
                {
                    case "GLOBAL":
                        // VB6: HFApp.Options.Value(POFormat) = ..; Options.SaveData -> AppOptions upsert
                        await db.ExecuteAsync(
                            @"IF EXISTS (SELECT 1 FROM AppOptions WHERE DivisionID=@DivisionID AND OptionName='POFormat')
                                UPDATE AppOptions SET OptionValue=@POFormat WHERE DivisionID=@DivisionID AND OptionName='POFormat'
                              ELSE
                                INSERT INTO AppOptions(UID,DivisionID,OptionName,OptionValue) VALUES('',@DivisionID,'POFormat',@POFormat)",
                            new { row.POFormat, SessionState.DivisionID });
                        break;

                    case "POINDEX":
                        var updateSql = @"
                            UPDATE tblPOIndex SET
                                POFormat = @POFormat,
                                Description = @Description,
                                POGroup = @POGroup,
                                HideQty = @HideQty,
                                HidePrice = @HidePrice,
                                TotalOnly = @TotalOnly,
                                ReleaseTaskID = @ReleaseTaskID,
                                PayPoint1Percent = @PayPoint1Percent,
                                PayPoint2Percent = @PayPoint2Percent,
                                PayPoint3Percent = @PayPoint3Percent,
                                PayPoint4Percent = @PayPoint4Percent,
                                PayPoint5Percent = @PayPoint5Percent,
                                PayPoint1SchedTask = @PayPoint1TaskID,
                                PayPoint2SchedTask = @PayPoint2TaskID,
                                PayPoint3SchedTask = @PayPoint3TaskID,
                                PayPoint4SchedTask = @PayPoint4TaskID,
                                PayPoint5SchedTask = @PayPoint5TaskID
                            WHERE DivisionID = @DivisionID
                              AND POIndex = @POIndex";

                        await db.ExecuteAsync(updateSql, new
                        {
                            row.POFormat,
                            row.Description,
                            row.POGroup,
                            row.HideQty,
                            row.HidePrice,
                            row.TotalOnly,
                            ReleaseTaskID = NullIfEmpty(row.ReleaseTaskID),
                            PayPoint1Percent = row.PayPoint1Percent,
                            PayPoint2Percent = row.PayPoint2Percent,
                            PayPoint3Percent = row.PayPoint3Percent,
                            PayPoint4Percent = row.PayPoint4Percent,
                            PayPoint5Percent = row.PayPoint5Percent,
                            PayPoint1TaskID = NullIfEmpty(row.PayPoint1TaskID),
                            PayPoint2TaskID = NullIfEmpty(row.PayPoint2TaskID),
                            PayPoint3TaskID = NullIfEmpty(row.PayPoint3TaskID),
                            PayPoint4TaskID = NullIfEmpty(row.PayPoint4TaskID),
                            PayPoint5TaskID = NullIfEmpty(row.PayPoint5TaskID),
                            SessionState.DivisionID,
                            row.POIndex
                        });

                        // VB6: backfill DivisionPOIndexes for any division missing this index
                        var insertDivPO = @"
                            INSERT INTO DivisionPOIndexes (POIndex, DivisionID, POFormat)
                            SELECT p.POIndex, p.DivisionID, p.POFormat
                            FROM tblPOIndex p
                            LEFT OUTER JOIN DivisionPOIndexes dp
                                ON dp.POIndex = p.POIndex AND dp.DivisionID = p.DivisionID
                            WHERE dp.DivisionID IS NULL
                              AND p.DivisionID = @DivisionID
                              AND p.POIndex = @POIndex";
                        await db.ExecuteAsync(insertDivPO, new { SessionState.DivisionID, row.POIndex });
                        break;
                }

                row.RowState = "CLEAN";
            }

            mDirty = false;
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}.SaveData]", SRCFILE);
            Notifications.Error($"Error saving data: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Grid Events ===
    private static bool IsHeaderRow(POFormatRow row) => row.RowType == "HEADER";

    private static bool IsPurchaseOrderHeadingRow(POFormatRow row) =>
        row.RowType == "HEADER" && row.Heading == "Purchase Orders";

    private static string GetPercentCellText(POFormatRow row, decimal? val, string headerText) =>
        IsPurchaseOrderHeadingRow(row) ? headerText : val?.ToString("F0") ?? "";

    private static string? GetGridRowCssClass(POFormatRow row, int rowIndex) =>
        IsHeaderRow(row) ? "po-heading-row" : row.RowType == "GLOBAL" ? "po-global-row" : null;

    private static bool IsPOIndexRowObject(object row) =>
        row is POFormatRow { RowType: "POINDEX" };

    private async Task OnGridRecordDoubleClick(CellClickEventArgs<POFormatRow> args)
    {
        if (args.Data == null || args.Data.RowType != "POINDEX")
            return;

        SelectedRow = args.Data;
        await OnEditPOClick();
    }

    private void OnRowSelected(RowSelectEventArgs<POFormatRow> args)
    {
        SelectedRow = args.Data;
    }

    private void OnCellSelected(CellSelectEventArgs<POFormatRow> args)
    {
        SelectedRow = args.Data;
    }

    private void OnCellEdit(CellEditArgs<POFormatRow> args)
    {
        if (args.Data == null)
        {
            args.Cancel = true;
            return;
        }

        var row = args.Data;
        var field = args.ColumnName ?? "";

        if (row.RowType == "GLOBAL")
        {
            args.Cancel = field != nameof(POFormatRow.POFormat);
            return;
        }

        if (row.RowType != "POINDEX")
        {
            args.Cancel = true;
            return;
        }

        args.Cancel = field switch
        {
            nameof(POFormatRow.POIndex) => true,
            nameof(POFormatRow.PayPoint5Percent) => true,
            nameof(POFormatRow.PayPoint2Percent) => !row.PayPoint1Percent.HasValue,
            nameof(POFormatRow.PayPoint3Percent) => !row.PayPoint2Percent.HasValue,
            nameof(POFormatRow.PayPoint4Percent) => !row.PayPoint3Percent.HasValue,
            _ => false
        };
    }

    private void OnCellSaved(CellSaveArgs<POFormatRow> args)
    {
        if (args.Data == null) return;
        var row = args.Data;
        var field = args.ColumnName ?? "";

        // VB6 gData_ValidateEdit: PayPoint percent cascade (remainder flows to the next point)
        if (field == nameof(POFormatRow.PayPoint1Percent))
        {
            var val = Math.Min(Math.Abs(row.PayPoint1Percent ?? 0), 100);
            row.PayPoint1Percent = val;
            row.PayPoint2Percent = 100 - val;
            row.PayPoint3Percent = null;
            row.PayPoint4Percent = null;
            row.PayPoint5Percent = null;
        }
        else if (field == nameof(POFormatRow.PayPoint2Percent))
        {
            var val = Math.Abs(row.PayPoint2Percent ?? 0);
            row.PayPoint2Percent = val;
            row.PayPoint3Percent = 100 - (row.PayPoint1Percent ?? 0) - val;
            row.PayPoint4Percent = null;
            row.PayPoint5Percent = null;
        }
        else if (field == nameof(POFormatRow.PayPoint3Percent))
        {
            var val = Math.Abs(row.PayPoint3Percent ?? 0);
            row.PayPoint3Percent = val;
            row.PayPoint4Percent = 100 - (row.PayPoint1Percent ?? 0) - (row.PayPoint2Percent ?? 0) - val;
            row.PayPoint5Percent = null;
        }
        else if (field == nameof(POFormatRow.PayPoint4Percent))
        {
            var val = Math.Abs(row.PayPoint4Percent ?? 0);
            row.PayPoint4Percent = val;
            row.PayPoint5Percent = 100 - (row.PayPoint1Percent ?? 0) - (row.PayPoint2Percent ?? 0) - (row.PayPoint3Percent ?? 0) - val;
        }

        // VB6: clear zero paypoints (display blank)
        if ((row.PayPoint2Percent ?? 0) == 0) row.PayPoint2Percent = null;
        if ((row.PayPoint3Percent ?? 0) == 0) row.PayPoint3Percent = null;
        if ((row.PayPoint4Percent ?? 0) == 0) row.PayPoint4Percent = null;
        if ((row.PayPoint5Percent ?? 0) == 0) row.PayPoint5Percent = null;

        if (field == nameof(POFormatRow.ReleaseTaskDesc) && string.IsNullOrWhiteSpace(row.ReleaseTaskDesc))
            row.ReleaseTaskID = "";
        else if (field == nameof(POFormatRow.PayPoint1Task) && string.IsNullOrWhiteSpace(row.PayPoint1Task))
            row.PayPoint1TaskID = "";
        else if (field == nameof(POFormatRow.PayPoint2Task) && string.IsNullOrWhiteSpace(row.PayPoint2Task))
            row.PayPoint2TaskID = "";
        else if (field == nameof(POFormatRow.PayPoint3Task) && string.IsNullOrWhiteSpace(row.PayPoint3Task))
            row.PayPoint3TaskID = "";
        else if (field == nameof(POFormatRow.PayPoint4Task) && string.IsNullOrWhiteSpace(row.PayPoint4Task))
            row.PayPoint4TaskID = "";
        else if (field == nameof(POFormatRow.PayPoint5Task) && string.IsNullOrWhiteSpace(row.PayPoint5Task))
            row.PayPoint5TaskID = "";

        MarkDirty(row);
    }

    private async Task OnGridEditButtonClick(CellEditButtonArgs<POFormatRow> args)
    {
        if (args.Data == null || args.Data.RowType != "POINDEX")
            return;

        SelectedRow = args.Data;

        switch (args.ColumnName)
        {
            case nameof(POFormatRow.ReleaseTaskDesc):
                await OnPickReleaseTask(args.Data);
                break;
            case nameof(POFormatRow.PayPoint1Task):
                await OnPickPayPointTask(args.Data, 1);
                break;
            case nameof(POFormatRow.PayPoint2Task):
                await OnPickPayPointTask(args.Data, 2);
                break;
            case nameof(POFormatRow.PayPoint3Task):
                await OnPickPayPointTask(args.Data, 3);
                break;
            case nameof(POFormatRow.PayPoint4Task):
                await OnPickPayPointTask(args.Data, 4);
                break;
            case nameof(POFormatRow.PayPoint5Task):
                await OnPickPayPointTask(args.Data, 5);
                break;
        }
    }

    private void MarkDirty(POFormatRow row)
    {
        row.RowState = "DIRTY";
        mDirty = true;
        StateHasChanged();
    }

    private void OnGroupChanged(POFormatRow row, string? v)
    {
        row.POGroup = v ?? "";
        MarkDirty(row);
    }

    private void OnFormatChanged(POFormatRow row, string? v)
    {
        row.POFormat = v ?? "";
        MarkDirty(row);
    }

    // === Scheduling-task picker (replaces VB6 FPickList.Choose modal) ===
    private async Task OnPickReleaseTask(POFormatRow row)
    {
        PickTaskTargetRow = row;
        PickTaskTargetPoint = 0;
        if (taskPickList != null)
            await taskPickList.Open("Scheduling Task",
                "SELECT TaskID,Description FROM LibraryTasks",
                hideColumns: "TaskID",
                windowTitle: "Precision Builder - Scheduling Task List",
                defaultItem: row.ReleaseTaskID);
    }

    private async Task OnPickPayPointTask(POFormatRow row, int point)
    {
        PickTaskTargetRow = row;
        PickTaskTargetPoint = point;
        var cur = point switch
        {
            1 => row.PayPoint1TaskID,
            2 => row.PayPoint2TaskID,
            3 => row.PayPoint3TaskID,
            4 => row.PayPoint4TaskID,
            5 => row.PayPoint5TaskID,
            _ => ""
        };
        if (taskPickList != null)
            await taskPickList.Open("Scheduling Task",
                "SELECT TaskID,Description FROM LibraryTasks",
                hideColumns: "TaskID",
                windowTitle: "Precision Builder - Scheduling Task List",
                defaultItem: cur);
    }

    private async Task OnTaskPicked(List<IDictionary<string, object>> rows)
    {
        if (PickTaskTargetRow != null && rows is { Count: > 0 })
        {
            var r = rows[0];
            var taskId = r.TryGetValue("TaskID", out var t) && t != null ? t.ToString() ?? "" : "";
            var desc = r.TryGetValue("Description", out var d) && d != null ? d.ToString() ?? "" : "";

            foreach (var targetRow in await GetTaskPickerTargetRowsAsync())
            {
                ApplyPickedTask(targetRow, taskId, desc);
                targetRow.RowState = "DIRTY";
                mDirty = true;
            }
            StateHasChanged();

            if (DataGrid != null)
                await DataGrid.Refresh();
        }

        ClearTaskPickerState();
        await ResumeGridKeyboardNavigationAsync();
    }

    private async Task<List<POFormatRow>> GetTaskPickerTargetRowsAsync()
    {
        if (PickTaskTargetRow == null)
            return new();

        var field = GetTaskTargetField(PickTaskTargetPoint);
        var selectedRows = DataGrid != null && !string.IsNullOrWhiteSpace(field)
            ? (await DataGrid.GetSelectedRecordsForColumnAsync(field))
                .Where(row => row.RowType == "POINDEX")
                .Distinct()
                .ToList()
            : new List<POFormatRow>();

        return selectedRows.Any(row => ReferenceEquals(row, PickTaskTargetRow))
            ? selectedRows
            : new List<POFormatRow> { PickTaskTargetRow };
    }

    private static string GetTaskTargetField(int point) => point switch
    {
        0 => nameof(POFormatRow.ReleaseTaskDesc),
        1 => nameof(POFormatRow.PayPoint1Task),
        2 => nameof(POFormatRow.PayPoint2Task),
        3 => nameof(POFormatRow.PayPoint3Task),
        4 => nameof(POFormatRow.PayPoint4Task),
        5 => nameof(POFormatRow.PayPoint5Task),
        _ => ""
    };

    private void ApplyPickedTask(POFormatRow row, string taskId, string desc)
    {
        switch (PickTaskTargetPoint)
        {
            case 0: row.ReleaseTaskID = taskId; row.ReleaseTaskDesc = desc; break;
            case 1: row.PayPoint1TaskID = taskId; row.PayPoint1Task = desc; break;
            case 2: row.PayPoint2TaskID = taskId; row.PayPoint2Task = desc; break;
            case 3: row.PayPoint3TaskID = taskId; row.PayPoint3Task = desc; break;
            case 4: row.PayPoint4TaskID = taskId; row.PayPoint4Task = desc; break;
            case 5: row.PayPoint5TaskID = taskId; row.PayPoint5Task = desc; break;
        }
    }

    private async Task OnTaskPickerCancelled()
    {
        ClearTaskPickerState();
        await ResumeGridKeyboardNavigationAsync();
    }

    // === FPOIndex Editor ===
    private FPOIndex? poIndexEditor;
    private string pendingEditAction = ""; // "New" or "Edit"

    private async Task OnPOIndexClosed(bool saved)
    {
        if (saved || pendingEditAction == "New")
        {
            await LoadData();
        }

        if (!saved && pendingEditAction == "New")
        {
            // VB6: cancelled new PO - delete the (untitled) record
            try
            {
                await db.ExecuteAsync(
                    "DELETE FROM tblPOIndex WHERE DivisionID = @DivisionID AND POIndex = '(untitled)'",
                    new { SessionState.DivisionID });
            }
            catch { /* non-critical */ }
        }

        pendingEditAction = "";
    }

    // === Toolbar Handlers ===
    private async Task OnNewPOClick()
    {
        if (!await SaveData(true)) return;

        try
        {
            // VB6: INSERT INTO tblPOIndex(DivisionID,POIndex,POType) VALUES(..,'(untitled)','Purchase Order')
            await db.ExecuteAsync(
                "INSERT INTO tblPOIndex (DivisionID, POIndex, POType) VALUES (@DivisionID, '(untitled)', 'Purchase Order')",
                new { SessionState.DivisionID });

            pendingEditAction = "New";
            if (poIndexEditor != null)
                await poIndexEditor.Edit("(untitled)");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}.OnNewPOClick]", SRCFILE);
            try
            {
                await db.ExecuteAsync(
                    "DELETE FROM tblPOIndex WHERE DivisionID = @DivisionID AND POIndex = '(untitled)'",
                    new { SessionState.DivisionID });
            }
            catch { /* non-critical */ }
        }
    }

    private async Task OnEditPOClick()
    {
        if (SelectedRow == null || SelectedRow.RowType != "POINDEX") return;
        if (!await SaveData(true)) return;

        pendingEditAction = "Edit";
        if (poIndexEditor != null)
            await poIndexEditor.Edit(SelectedRow.POIndex);
    }

    private async Task OnDeleteClick()
    {
        if (SelectedRow == null || SelectedRow.RowType != "POINDEX") return;

        if (_messageBox == null) return;

        var confirm = await _messageBox.ShowAsync(
            "If you delete this purchase order it will be removed immediately\n" +
            "and permanently. Are you sure this is what you want to do?",
            title: "Confirm Delete",
            buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNo,
            icon: "error"); // HHM-436: VB6 uses vbCritical (red X), not a question mark
        if (confirm != Fx.ControlKit.Dialogs.MessageBoxResult.Yes) return;

        try
        {
            var poIndex = SelectedRow.POIndex;
            await db.ExecuteAsync(
                "DELETE FROM tblPOIndex WHERE DivisionID = @DivisionID AND POIndex = @POIndex",
                new { SessionState.DivisionID, POIndex = poIndex });
            await db.ExecuteAsync(
                "UPDATE tblPhaseItem SET POIndex = '' WHERE DivisionID = @DivisionID AND POIndex = @POIndex",
                new { SessionState.DivisionID, POIndex = poIndex });

            GridData.Remove(SelectedRow);
            SelectedRow = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error deleting: {ex.Message}");
        }
    }

    private void OnItemsClick()
    {
        // VB6: FPOItems.Show vbModal - open the PO item-assignment screen
        if (ParentNavigate != null)
            ParentNavigate.Invoke("/po-items");
        else
            NavigationManager.NavigateTo("/po-items");
    }

    private void OnVendorsClick()
    {
        // VB6: Call HFApp.RunTask("EditDefaultVendors")
        if (ParentNavigate != null)
            ParentNavigate.Invoke("/default-vendor");
        else
            NavigationManager.NavigateTo("/default-vendor");
    }

    private async Task OnPreviewClick()
    {
        // HHM-395: heading rows carry POFormat="Format" — never preview those.
        if (SelectedRow == null || SelectedRow.RowType == "HEADER" || string.IsNullOrEmpty(SelectedRow.POFormat)) return;

        // VB6 opened a Crystal PrintPreview of the selected PO format .rpt for a sample PO number.
        try
        {
            var poNumber = await db.ExecuteScalarAsync<string>(
                "SELECT TOP 1 m.PONumber FROM POMaster m JOIN POItems i ON m.PONumber = i.PONumber") ?? "";

            if (!string.IsNullOrWhiteSpace(poNumber))
            {
                var url = $"/report-viewer?report={Uri.EscapeDataString(SelectedRow.POFormat)}&PONumber={Uri.EscapeDataString(poNumber)}&DivisionID={SessionState.DivisionID}";
                if (ParentNavigate != null) ParentNavigate.Invoke(url);
                else NavigationManager.NavigateTo(url);
            }
            else
            {
                Notifications.Info($"No purchase orders available to preview format: {SelectedRow.POFormat}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}.OnPreviewClick]", SRCFILE);
            Notifications.Error($"Error loading preview: {ex.Message}");
        }
    }

    private async Task OnOkClick()
    {
        if (await SaveData(false))
            ClosePage();
    }

    private async Task OnCancelClick()
    {
        // VB6: Form_Unload calls SaveData(True) which prompts Yes/No/Cancel
        if (!await SaveData(true)) return;
        ClosePage();
    }

    // === Helpers ===
    private string SafeStr(Dictionary<string, object> row, string key)
    {
        if (!row.ContainsKey(key)) return "";
        var val = row[key];
        if (val == null || val == DBNull.Value) return "";
        return val.ToString() ?? "";
    }

    private decimal? SafeDecimalNullable(Dictionary<string, object> row, string key)
    {
        if (!row.ContainsKey(key)) return null;
        var val = row[key];
        if (val == null || val == DBNull.Value) return null;
        var d = Convert.ToDecimal(val);
        return d == 0 ? null : d;
    }

    private object? NullIfEmpty(string? val) =>
        string.IsNullOrWhiteSpace(val) ? null : val;

    // === Models ===
    public class POFormatRow
    {
        public string Heading { get; set; } = "";
        public string POIndex { get; set; } = "";
        public string Description { get; set; } = "";
        public string POGroup { get; set; } = "";
        public bool HideQty { get; set; }
        public bool HidePrice { get; set; }
        public bool TotalOnly { get; set; }
        public object? HideQtyCell
        {
            get => IsPurchaseOrderHeading ? "#" : RowType == "POINDEX" ? HideQty : null;
            set => HideQty = ToBool(value);
        }
        public object? HidePriceCell
        {
            get => IsPurchaseOrderHeading ? "$" : RowType == "POINDEX" ? HidePrice : null;
            set => HidePrice = ToBool(value);
        }
        public object? TotalOnlyCell
        {
            get => IsPurchaseOrderHeading ? "!" : RowType == "POINDEX" ? TotalOnly : null;
            set => TotalOnly = ToBool(value);
        }
        public string POFormat { get; set; } = "";
        public string ReleaseTaskID { get; set; } = "";
        public string ReleaseTaskDesc { get; set; } = "";
        public decimal? PayPoint1Percent { get; set; }
        public decimal? PayPoint2Percent { get; set; }
        public decimal? PayPoint3Percent { get; set; }
        public decimal? PayPoint4Percent { get; set; }
        public decimal? PayPoint5Percent { get; set; }
        public string PayPoint1Task { get; set; } = "";
        public string PayPoint2Task { get; set; } = "";
        public string PayPoint3Task { get; set; } = "";
        public string PayPoint4Task { get; set; } = "";
        public string PayPoint5Task { get; set; } = "";
        public string PayPoint1TaskID { get; set; } = "";
        public string PayPoint2TaskID { get; set; } = "";
        public string PayPoint3TaskID { get; set; } = "";
        public string PayPoint4TaskID { get; set; } = "";
        public string PayPoint5TaskID { get; set; } = "";
        public string RowType { get; set; } = ""; // "HEADER", "GLOBAL", "POINDEX"
        public string RowState { get; set; } = "CLEAN"; // "CLEAN", "DIRTY"
        private bool IsPurchaseOrderHeading => RowType == "HEADER" && Heading == "Purchase Orders";
        private static bool ToBool(object? value) => value switch
        {
            bool b => b,
            string s when bool.TryParse(s, out var parsedBool) => parsedBool,
            string s when int.TryParse(s, out var parsedInt) => parsedInt != 0,
            int i => i != 0,
            _ => false
        };
    }
}
