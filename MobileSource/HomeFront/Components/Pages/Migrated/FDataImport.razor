@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using System.IO
@using HomeFront.Components.Hf
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Data Import Wizard - HomeFront</PageTitle>

<style>
    .wizard-container {
        max-width: 900px;
        margin: 0 auto;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        display: flex;
        flex-direction: column;
        min-height: 600px;
    }

    .wizard-header {
        background: linear-gradient(to right, #f8f9fa, #e9ecef);
        border-bottom: 1px solid #dee2e6;
        padding: 16px 24px;
        border-radius: 8px 8px 0 0;
    }

    .wizard-header h4 {
        margin: 0 0 4px 0;
        font-size: 18px;
        font-weight: 600;
        color: #333;
    }

    .wizard-header p {
        margin: 0;
        font-size: 13px;
        color: #6c757d;
    }

    .wizard-body {
        flex: 1;
        padding: 16px 24px;
        overflow: auto;
    }

    .wizard-footer {
        border-top: 1px solid #dee2e6;
        padding: 12px 24px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        background: #f8f9fa;
        border-radius: 0 0 8px 8px;
    }

    .wizard-footer button {
        padding: 8px 20px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 14px;
        min-width: 90px;
    }

    .wizard-footer button:hover:not(:disabled) {
        background: #e9ecef;
    }

    .wizard-footer button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .wizard-footer button.btn-primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }

    .wizard-footer button.btn-primary:hover:not(:disabled) {
        background: #0b5ed7;
    }

    .wizard-footer button.btn-success {
        background: #198754;
        color: #fff;
        border-color: #198754;
    }

    .wizard-footer button.btn-success:hover:not(:disabled) {
        background: #157347;
    }

    .file-info {
        margin-bottom: 12px;
    }

    .file-info label {
        font-size: 13px;
        color: #495057;
        display: block;
        margin-bottom: 2px;
    }

    .file-info .filename {
        font-weight: 600;
        color: #333;
    }

    .file-info .filedate {
        font-size: 12px;
        color: #6c757d;
    }

    .progress-bar-container {
        width: 100%;
        height: 24px;
        background: #e9ecef;
        border-radius: 4px;
        overflow: hidden;
        margin-top: 12px;
    }

    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(to right, #0d6efd, #0b5ed7);
        transition: width 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 11px;
        font-weight: 600;
    }

    .upload-area {
        border: 2px dashed #ced4da;
        border-radius: 8px;
        padding: 40px;
        text-align: center;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        margin-bottom: 16px;
    }

    .upload-area:hover {
        border-color: #0d6efd;
        background: #f0f7ff;
    }

    .upload-area .upload-icon {
        font-size: 48px;
        color: #6c757d;
        margin-bottom: 12px;
    }

    .upload-area p {
        margin: 0;
        font-size: 14px;
        color: #495057;
    }

    .upload-area .supported-formats {
        font-size: 12px;
        color: #6c757d;
        margin-top: 8px;
    }

    .error-message {
        background: #f8d7da;
        border: 1px solid #f5c2c7;
        border-radius: 4px;
        padding: 12px 16px;
        color: #842029;
        font-size: 13px;
        margin-bottom: 12px;
    }

    .success-message {
        background: #d1e7dd;
        border: 1px solid #badbcc;
        border-radius: 4px;
        padding: 12px 16px;
        color: #0f5132;
        font-size: 13px;
        margin-bottom: 12px;
    }

    .missing-columns {
        background: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 4px;
        padding: 12px 16px;
        color: #664d03;
        font-size: 13px;
        margin-bottom: 12px;
    }

    .grid-container {
        border: 1px solid #dee2e6;
        border-radius: 4px;
        overflow: hidden;
    }
</style>

<div class="wizard-container">
    @* ── Wizard Header ─────────────────────────────────────────── *@
    <div class="wizard-header">
        <h4>Import @mTitle</h4>
        <p>The @mTitle import wizard will help you update your database</p>
    </div>

    @* ── Wizard Body ───────────────────────────────────────────── *@
    <div class="wizard-body">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-message">@ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="success-message">@SuccessMessage</div>
        }

        @if (CurrentFrame == 0)
        {
            @* ── Frame 0: File Upload & Preview ─────────────────── *@
            @if (!FileLoaded)
            {
                <div class="upload-area" @onclick="TriggerFileUpload">
                    <div class="upload-icon">📁</div>
                    <p>Click to select a file or drag and drop</p>
                    <div class="supported-formats">
                        Supported formats: Excel (.xls, .xlsx), CSV (.csv), Text (.txt)
                    </div>
                </div>
                <InputFile @ref="fileInput" OnChange="OnFileSelected" style="display:none"
                           accept=".xls,.xlsx,.csv,.txt" />
            }
            else
            {
                <div class="file-info">
                    <label>File name:</label>
                    <span class="filename">@mFilename</span>
                    <br />
                    <span class="filedate">Last Modified: @FileLastModified</span>
                </div>

                @if (MissingColumns.Any())
                {
                    <div class="missing-columns">
                        <strong>Warning:</strong> Required columns are missing: @string.Join(", ", MissingColumns)
                    </div>
                }

                <div class="grid-container">
                    <HfGrid @ref="DataGrid"
                            TValue="ImportRow"
                            DataSource="@GridData"
                            AllowPaging="true"
                            AllowSorting="true"
                            AllowResizing="true"
                            AllowSelection="true"
                            EnableHover="true"
                            Height="380px"
                            PageSettingsRef="@pageSettings"
                            SelectionSettingsRef="@selectionSettings">
                        <HfGridColumnsBase>
                            @foreach (var col in GridColumns)
                            {
                                <HfGridColumn Field="@col.Field"
                                              HeaderText="@col.HeaderText"
                                              Width="@col.Width"
                                              AllowEditing="false"
                                              IsPrimaryKey="@col.IsPrimaryKey"
                                              Visible="@col.Visible" />
                            }
                        </HfGridColumnsBase>
                    </HfGrid>
                </div>

                @if (ShowProgressBar)
                {
                    <div class="progress-bar-container">
                        <div class="progress-bar-fill" style="width: @(ProgressValue)%;">
                            @(ProgressValue)%
                        </div>
                    </div>
                }
            }
        }
    </div>

    @* ── Wizard Footer ─────────────────────────────────────────── *@
    <div class="wizard-footer">
        <button @onclick="OnCancelClick">Cancel</button>
        <button disabled="@(!CanGoBack)" @onclick="OnBackClick">&lt; Back</button>
        <button disabled="@(!CanGoNext)" @onclick="OnNextClick">Next &gt;</button>
        <button class="btn-success" disabled="@(!CanFinish)" @onclick="OnFinishClick">Finish</button>
    </div>
</div>

@code {
    // ── Parameters ───────────────────────────────────────────────────────
    [Parameter] public string? TableName { get; set; }
    [Parameter] public string? Title { get; set; }

    // ── Database ─────────────────────────────────────────────────────────
    private DbWrapperSqlServer db = new();
    private int DivisionID = 1;

    // ── Import Configuration ─────────────────────────────────────────────
    private string mFilename = "";
    private string mTitle = "";
    private string mTableName = "";
    private string mKeyColumns = "";
    private string mRequiredColumns = "";
    private string mColumnMappings = "";
    private bool mCancel = true;

    // ── Wizard State ─────────────────────────────────────────────────────
    private int CurrentFrame = 0;
    private int MaxFrames = 0;
    private bool FileLoaded = false;
    private string FileLastModified = "";
    private string ErrorMessage = "";
    private string SuccessMessage = "";
    private List<string> MissingColumns = new();
    private bool ShowProgressBar = false;
    private int ProgressValue = 0;
    private bool IsSaving = false;

    // ── Navigation State ─────────────────────────────────────────────────
    private bool CanGoBack => CurrentFrame > 0;
    private bool CanGoNext => CurrentFrame < MaxFrames;
    private bool CanFinish => FileLoaded && !MissingColumns.Any() && GridData.Any() && !IsSaving;

    // ── Grid ─────────────────────────────────────────────────────────────
    private HfGrid<ImportRow>? DataGrid;
    private InputFile? fileInput;
    private List<ImportRow> GridData = new();
    private List<GridColumnDef> GridColumns = new();
    private List<string> ColumnKeys = new();

    // ── Grid Settings ────────────────────────────────────────────────────
    private HfPageSettings pageSettings = new() { PageSize = 50 };
    private HfSelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        mTableName = TableName ?? "";
        mTitle = Title ?? "Data";
    }

    // ── Public API: Called by parent to initiate import ───────────────────
    public async Task<bool> ImportData(
        string tableName,
        string keyColumns,
        string title,
        string requiredColumns = "",
        string columnMappings = "")
    {
        mTableName = tableName;
        mKeyColumns = keyColumns;
        mTitle = title;
        mRequiredColumns = requiredColumns;
        mColumnMappings = columnMappings;

        if (string.IsNullOrEmpty(mKeyColumns))
            throw new ArgumentException("You must specify at least one column name in the \"KeyColumns\" parameter");

        mCancel = true;
        CurrentFrame = 0;
        FileLoaded = false;
        ErrorMessage = "";
        SuccessMessage = "";
        GridData.Clear();
        GridColumns.Clear();
        MissingColumns.Clear();

        StateHasChanged();
        return !mCancel;
    }

    // ── File Upload ──────────────────────────────────────────────────────
    private async Task TriggerFileUpload()
    {
        await JSRuntime.InvokeVoidAsync("eval",
            "document.querySelector('input[type=file]').click()");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = "";
        SuccessMessage = "";
        MissingColumns.Clear();

        try
        {
            var file = e.File;
            if (file == null) return;

            mFilename = file.Name;
            FileLastModified = file.LastModified.LocalDateTime.ToString("D");

            var extension = Path.GetExtension(file.Name).ToLowerInvariant().TrimStart('.');

            // Read file content
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024); // 50MB max
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            // Parse based on file type
            char delimiter = extension == "csv" ? ',' : '\t';

            // For xls/xlsx, we'd need server-side processing; treat as CSV for now
            if (extension == "xls" || extension == "xlsx")
            {
                ErrorMessage = "Excel files (.xls/.xlsx) require server-side conversion. Please export to CSV first.";
                return;
            }

            ParseDelimitedText(content, delimiter);
            FileLoaded = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error reading file: {ex.Message}";
            FileLoaded = false;
        }

        StateHasChanged();
    }

    // ── Parse Delimited Text ─────────────────────────────────────────────
    private void ParseDelimitedText(string content, char delimiter)
    {
        GridData.Clear();
        GridColumns.Clear();
        ColumnKeys.Clear();
        MissingColumns.Clear();

        var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None)
                           .Where(l => !string.IsNullOrWhiteSpace(l))
                           .ToList();

        if (lines.Count == 0)
        {
            ErrorMessage = "The file is empty.";
            return;
        }

        // Parse header row
        var headers = ParseLine(lines[0], delimiter);

        // Apply column mappings
        var mappings = ParseColumnMappings(mColumnMappings);
        var hiddenColumns = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        for (int i = 0; i < headers.Count; i++)
        {
            var originalKey = headers[i].Replace(" ", "");
            var displayName = headers[i];

            if (mappings.TryGetValue(originalKey, out var mapping))
            {
                if (string.IsNullOrEmpty(mapping))
                {
                    hiddenColumns.Add(originalKey);
                }
                else
                {
                    displayName = mapping;
                    originalKey = mapping;
                }
            }

            ColumnKeys.Add(originalKey);

            var isKeyColumn = ParseList(mKeyColumns).Contains(originalKey, StringComparer.OrdinalIgnoreCase);

            GridColumns.Add(new GridColumnDef
            {
                Field = $"Col{i}",
                HeaderText = displayName + (isKeyColumn ? " *" : ""),
                Width = "150px",
                IsPrimaryKey = i == 0,
                Visible = !hiddenColumns.Contains(headers[i].Replace(" ", ""))
            });
        }

        // Check required columns
        var allKeys = ColumnKeys.ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var key in ParseList(mKeyColumns))
        {
            if (!string.IsNullOrEmpty(key) && !allKeys.Contains(key))
                MissingColumns.Add(key);
        }
        foreach (var req in ParseList(mRequiredColumns))
        {
            if (!string.IsNullOrEmpty(req) && !allKeys.Contains(req))
                MissingColumns.Add(req);
        }

        if (MissingColumns.Any())
        {
            ErrorMessage = $"Required columns are missing: {string.Join(", ", MissingColumns)}";
        }

        // Parse data rows, removing rows with empty keys
        for (int lineIdx = 1; lineIdx < lines.Count; lineIdx++)
        {
            var values = ParseLine(lines[lineIdx], delimiter);
            var row = new ImportRow();

            for (int c = 0; c < headers.Count && c < values.Count; c++)
            {
                row.Values[$"Col{c}"] = values[c].Trim();
            }

            // Check if row has any key values
            var keyColumns = ParseList(mKeyColumns);
            var rowKey = "";
            var missingKey = false;

            foreach (var keyCol in keyColumns)
            {
                var colIdx = GetColumnIndex(keyCol);
                if (colIdx < 0) continue;
                var val = row.GetValue($"Col{colIdx}");
                rowKey += val.Trim();
                if (string.IsNullOrWhiteSpace(val))
                    missingKey = true;
            }

            if (string.IsNullOrEmpty(rowKey))
                continue; // Skip empty rows

            if (missingKey)
            {
                ErrorMessage = "This file cannot be imported because key columns are empty. Please check your data and retry the import.";
                GridData.Clear();
                return;
            }

            row.RowIndex = GridData.Count;
            GridData.Add(row);
        }
    }

    // ── Parse a single delimited line (handles quoted fields) ────────────
    private List<string> ParseLine(string line, char delimiter)
    {
        var result = new List<string>();
        var inQuotes = false;
        var field = new System.Text.StringBuilder();

        for (int i = 0; i < line.Length; i++)
        {
            var c = line[i];
            if (c == '"')
            {
                if (inQuotes && i + 1 < line.Length && line[i + 1] == '"')
                {
                    field.Append('"');
                    i++;
                }
                else
                {
                    inQuotes = !inQuotes;
                }
            }
            else if (c == delimiter && !inQuotes)
            {
                result.Add(field.ToString());
                field.Clear();
            }
            else
            {
                field.Append(c);
            }
        }
        result.Add(field.ToString());
        return result;
    }

    // ── Parse column mappings string ─────────────────────────────────────
    private Dictionary<string, string> ParseColumnMappings(string mappings)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(mappings)) return result;

        foreach (var mapping in mappings.Split(',', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = mapping.Split('=');
            if (parts.Length == 2)
            {
                var from = parts[0].Trim();
                var to = parts[1].Trim();
                if (!string.IsNullOrEmpty(from))
                    result[from] = to;
            }
            else if (parts.Length == 1)
            {
                var from = parts[0].Trim();
                if (!string.IsNullOrEmpty(from))
                    result[from] = "";
            }
        }
        return result;
    }

    // ── Parse comma-separated list ───────────────────────────────────────
    private List<string> ParseList(string csv)
    {
        if (string.IsNullOrEmpty(csv)) return new();
        return csv.Split(',', StringSplitOptions.RemoveEmptyEntries)
                  .Select(s => s.Trim())
                  .Where(s => !string.IsNullOrEmpty(s))
                  .ToList();
    }

    // ── Get column index by key name ─────────────────────────────────────
    private int GetColumnIndex(string colKey)
    {
        for (int i = 0; i < ColumnKeys.Count; i++)
        {
            if (string.Equals(ColumnKeys[i], colKey, StringComparison.OrdinalIgnoreCase))
                return i;
        }
        return -1;
    }

    // ── Get text from a row by column key ────────────────────────────────
    private string GetTextMatrix(ImportRow row, string colKey)
    {
        var idx = GetColumnIndex(colKey);
        if (idx < 0) return "";
        return row.GetValue($"Col{idx}");
    }

    // ── Navigation Handlers ──────────────────────────────────────────────
    private void OnCancelClick()
    {
        mCancel = true;
        NavigationManager.NavigateTo("/");
    }

    private void OnBackClick()
    {
        if (CurrentFrame > 0)
            CurrentFrame--;
    }

    private void OnNextClick()
    {
        if (CurrentFrame < MaxFrames)
            CurrentFrame++;
    }

    private async Task OnFinishClick()
    {
        if (await SaveData())
        {
            mCancel = false;
            SuccessMessage = $"Successfully imported {GridData.Count} records into {mTableName}.";
        }
    }

    // ── Save Data ────────────────────────────────────────────────────────
    private async Task<bool> SaveData()
    {
        IsSaving = true;
        ShowProgressBar = true;
        ProgressValue = 0;
        ErrorMessage = "";
        SuccessMessage = "";
        StateHasChanged();

        try
        {
            // Get table definition
            var tabDef = db.SqlExec($"SELECT * FROM {mTableName} WHERE 1=2");
            var keyColumns = ParseList(mKeyColumns);
            var requiredColumns = ParseList(mRequiredColumns);

            for (int i = 0; i < GridData.Count; i++)
            {
                ProgressValue = (int)(((double)(i + 1) / GridData.Count) * 100);
                if (i % 10 == 0)
                {
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1); // Allow UI to update
                }

                var row = GridData[i];
                var insertCols = new List<string>();
                var insertVals = new List<string>();
                var whereParts = new List<string>();
                var updateParts = new List<string>();

                // Handle special case for tblPhaseItem
                if (mTableName.Equals("tblphaseitem", StringComparison.OrdinalIgnoreCase))
                {
                    // Special handling as in VB6
                    var phase = GetTextMatrix(row, "Phase");
                    var itemNumber = GetTextMatrix(row, "ItemNumber");
                    var costCategory = GetTextMatrix(row, "CostCategory");

                    insertCols.AddRange(new[] { "DivisionID", "Phase", "ItemNumber", "Item", "CostCategory" });
                    insertVals.Add(DivisionID.ToString());
                    insertVals.Add(DbQuote(phase));
                    insertVals.Add(DbQuote(itemNumber));
                    insertVals.Add(DbQuote(itemNumber + costCategory));
                    insertVals.Add(DbQuote(costCategory));

                    whereParts.Add($"DivisionID = {DivisionID}");
                    whereParts.Add($"Phase = {DbQuote(phase)}");
                    whereParts.Add($"Item = {DbQuote(itemNumber + costCategory)}");
                }
                else
                {
                    // Generic key column handling
                    insertCols.Add("DivisionID");
                    insertVals.Add(DivisionID.ToString());

                    foreach (var keyCol in keyColumns)
                    {
                        var val = GetTextMatrix(row, keyCol);
                        var dbType = GetDbColumnType(tabDef, keyCol);
                        var quotedVal = DbQuoteByType(dbType, val, tabDef, keyCol);

                        insertCols.Add(keyCol);
                        insertVals.Add(quotedVal);
                        whereParts.Add($"{keyCol} = {quotedVal}");
                    }
                }

                // Add required columns to insert
                foreach (var reqCol in requiredColumns)
                {
                    var val = GetTextMatrix(row, reqCol);
                    var dbType = GetDbColumnType(tabDef, reqCol);
                    var quotedVal = DbQuoteByType(dbType, val, tabDef, reqCol);

                    insertCols.Add(reqCol);
                    insertVals.Add(quotedVal);
                }

                // INSERT (ignore duplicates)
                var insertSql = $"INSERT INTO {mTableName} ({string.Join(",", insertCols)}) VALUES ({string.Join(",", insertVals)})";
                try
                {
                    await db.ExecuteAsync(insertSql);
                }
                catch (Exception ex)
                {
                    if (!ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                        throw;
                    // Duplicate key — will be handled by UPDATE below
                }

                // Build UPDATE for all non-key columns
                for (int c = 0; c < ColumnKeys.Count; c++)
                {
                    var colKey = ColumnKeys[c];
                    if (string.IsNullOrEmpty(colKey)) continue;
                    if (keyColumns.Contains(colKey, StringComparer.OrdinalIgnoreCase)) continue;

                    // Check if column exists in table
                    if (!ColumnExistsInTable(tabDef, colKey)) continue;

                    var val = row.GetValue($"Col{c}");
                    var dbType = GetDbColumnType(tabDef, colKey);
                    var quotedVal = DbQuoteByType(dbType, val, tabDef, colKey);

                    updateParts.Add($"{colKey} = {quotedVal}");
                }

                if (updateParts.Any() && whereParts.Any())
                {
                    var updateSql = $"UPDATE {mTableName} SET {string.Join(",", updateParts)} WHERE {string.Join(" AND ", whereParts)}";
                    try
                    {
                        await db.ExecuteAsync(updateSql);
                    }
                    catch (Exception ex)
                    {
                        if (!ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                            throw;
                    }
                }
            }

            ShowProgressBar = false;
            IsSaving = false;
            StateHasChanged();
            return true;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error saving data: {ex.Message}";
            ShowProgressBar = false;
            IsSaving = false;
            StateHasChanged();
            return false;
        }
    }

    // ── DB Helpers ───────────────────────────────────────────────────────
    private string DbQuote(string value)
    {
        if (string.IsNullOrEmpty(value)) return "''";
        return "'" + value.Replace("'", "''") + "'";
    }

    private string DbQuoteByType(Type dbType, string value, DataTable tabDef, string colName)
    {
        if (string.IsNullOrWhiteSpace(value)) return "NULL";

        if (dbType == typeof(string))
        {
            var maxLen = GetColumnMaxLength(tabDef, colName);
            var truncated = maxLen > 0 && value.Length > maxLen ? value.Substring(0, maxLen) : value;
            return DbQuote(truncated);
        }
        else if (dbType == typeof(int) || dbType == typeof(long) || dbType == typeof(short) ||
                 dbType == typeof(decimal) || dbType == typeof(double) || dbType == typeof(float))
        {
            if (decimal.TryParse(value, out _))
                return value;
            return "NULL";
        }
        else if (dbType == typeof(DateTime))
        {
            if (DateTime.TryParse(value, out var dt))
                return $"'{dt:yyyy-MM-dd HH:mm:ss}'";
            return "NULL";
        }
        else if (dbType == typeof(bool))
        {
            var lower = value.ToLowerInvariant();
            return (lower == "true" || lower == "1" || lower == "yes") ? "1" : "0";
        }

        return DbQuote(value);
    }

    private Type GetDbColumnType(DataTable tabDef, string colName)
    {
        if (tabDef.Columns.Contains(colName))
            return tabDef.Columns[colName]!.DataType;
        return typeof(string);
    }

    private int GetColumnMaxLength(DataTable tabDef, string colName)
    {
        if (tabDef.Columns.Contains(colName))
            return tabDef.Columns[colName]!.MaxLength;
        return -1;
    }

