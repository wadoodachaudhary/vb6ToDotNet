    [CascadingParameter(Name = "SetPageTitle")]
    private Action<string?>? SetPageTitle { get; set; }

    protected override async Task OnInitializedAsync()
    {
        SetPageTitle?.Invoke("Community");
        communitiesEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<CommunityRow>>(this, OnRowSelected);
        // Cell-mode parity with VB6 gData: track the active cell's row so Delete/
        // Save/Company/Accounting act on it (no row blue-bar), veto edits per the
        // BeforeEdit rules, and persist + mark dirty on commit (AfterEdit).
        communitiesEvents.CellSelected = EventCallback.Factory.Create<CellSelectEventArgs<CommunityRow>>(this, OnCommunityCellSelected);
        communitiesEvents.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<CommunityRow>>(this, OnCommunityCellEdit);
        communitiesEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<CommunityRow>>(this, OnCommunityCellSave);
        // Multi-cell entry: raised once per committed edit when 2+ cells are
        // selected in the edited column — fan the value across the selection.
        communitiesEvents.OnTypeAheadCommit = EventCallback.Factory.Create<TypeAheadCommitArgs<CommunityRow>>(this, OnCommunityTypeAheadCommit);
        communitiesEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<CommunityRow>>(this, OnGridEditButtonClick);
        await LoadColumnLengthsAsync();
        await LoadAccountingOptions();
        await LoadScheduleTemplates();
        await LoadD365Functions();
        await LoadGridLayoutAsync();
        await LoadCustomDescriptions();
        await LoadData();
        await LoadDivisions();
    }

    // VB6 FCommunityAccounting.ShowForm: layout + Tarion visibility are driven by
    // app options, NOT hardcoded. AccountingSystem is an enum (asIntacct = 9,
    // Application.cls:55); EnableTarionFields is a "true"/"false" string. Customer
    // data here has AccountingSystem = 0 (asNone) so the GL-Accounts layout shows.
    private const int asIntacct = 9;
    // VB6 Application.cls AccountingSystems.asD365_ABN = 11 — drives the
    // ABN_D02Function column's visibility (shown only for D365-ABN).
    private const int asD365_ABN = 11;
    // VB6 Application.cls AccountingSystems.asTimberline = 1.
    private const int asTimberline = 1;
    private async Task<string> GetAppOptionValueAsync(string optionName)
    {
        try
        {
            var val = await db.ExecuteScalarAsync<string>(
                @"SELECT TOP 1 optionvalue FROM appoptions
                   WHERE ISNULL(divisionid,0) IN (0, @Div) AND optionname = @Name AND ISNULL(uid,'') = ''
                   ORDER BY divisionid DESC",
                new { Div = SessionState.DivisionID, Name = optionName });
            return val ?? "";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to read appoption {Option}", optionName);
            return "";
        }
    }

    private async Task LoadAccountingOptions()
    {
        try
        {
            var acctSys = await GetAppOptionValueAsync("AccountingSystem");
            var hasSys = int.TryParse(acctSys, out var sys);
            IsIntacctSystem = hasSys && sys == asIntacct;
            IsD365ABN = hasSys && sys == asD365_ABN;
            IsTimberline = hasSys && sys == asTimberline;

            var tarion = await GetAppOptionValueAsync("EnableTarionFields");
            ShowTarionFields = string.Equals(tarion, "true", StringComparison.OrdinalIgnoreCase);

            DefaultIntacctEntity = await GetAppOptionValueAsync("IntacctEntity");

            // VB6 Form_Load (344-349): GSTRate column hidden unless Show_CDN_GST,
            // PSTRate hidden unless UsePst. Both are system_setup columns keyed by
            // id = DivisionID (with an appoptions fallback) — see Options.cls
            // ValueByName (810-811). Per-division: e.g. division 15 has UsePst=1.
            ShowGSTRate = await ReadBoolOption("Show_CDN_GST");
            ShowPSTRate = await ReadBoolOption("UsePst");
        }
        catch (Exception ex)
        {
            // VB6 default when options can't be read: non-Intacct, no Tarion, GST/PST hidden.
            Logger.LogWarning(ex, "Couldn't read accounting app-options; defaulting to non-Intacct");
            IsIntacctSystem = false;
            IsD365ABN = false;
            IsTimberline = false;
            ShowTarionFields = false;
            ShowGSTRate = false;
            ShowPSTRate = false;
        }
    }

    // VB6 Options.cls ValueByName (810-811): a boolean app-option resolves first from
    // the system_setup row for this division, then falls back to appoptions
    // (divisionid IN (0, @Div), most-specific wins). Returns the VB6-truthy
    // interpretation (1 / true / -1 / non-empty-nonzero).
    private async Task<bool> ReadBoolOption(string optionName)
    {
        string? raw = null;
        try
        {
            // system_setup.<col> — column name is a fixed VB6 option identifier (not
            // user data), so it must be a bracket-quoted identifier, not a parameter.
            raw = await db.ExecuteScalarAsync<string>(
                $"SELECT TOP 1 [{optionName}] FROM system_setup WHERE id = @Div",
                new { Div = SessionState.DivisionID });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "system_setup has no '{Option}' column; falling back to appoptions", optionName);
        }
        if (string.IsNullOrEmpty(raw))
        {
            raw = await db.ExecuteScalarAsync<string>(
                @"SELECT TOP 1 optionvalue FROM appoptions
                  WHERE ISNULL(divisionid,0) IN (0, @Div) AND optionname = @Name
                  ORDER BY divisionid DESC",
                new { Div = SessionState.DivisionID, Name = optionName });
        }
        return ToBool(raw);
    }

    // VB6: HFApp.Options.ValueByName("ScheduleTemplates") — the pipe-separated
    // PreCon-template list (same source FOptions reads/writes). Split into the
    // in-cell dropdown choices, with a leading blank so the value can be cleared.
    private async Task LoadScheduleTemplates()
    {
        try
        {
            var raw = await db.ExecuteScalarAsync<string>(
                $@"SELECT TOP 1 optionvalue FROM appoptions
                   WHERE optionname = 'ScheduleTemplates'
                     AND DivisionID IN (0, {SessionState.DivisionID})
                   ORDER BY DivisionID DESC") ?? "";
            var items = raw.Split('|', StringSplitOptions.RemoveEmptyEntries)
                           .Select(s => s.Trim())
                           .Where(s => s.Length > 0);
            ScheduleTemplateOptions = new List<string>();
            ScheduleTemplateOptions.AddRange(items);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Couldn't read ScheduleTemplates app-option");
            ScheduleTemplateOptions = new List<string>();
        }
    }

    // VB6 sub_ShowPickList Case "ABN_D02Function":
    //   s = "select Value,Description,value id from D365FinancialDimensionValues
    //        where Dimension='D02_Function' order by 1"
    // Load the D02_Function dimension values once for the in-cell dropdown. We
    // store/display the Value (matches VB6: it stores Value, the 'id' hidecol).
    // A leading blank lets the user clear the cell.
    private async Task LoadD365Functions()
    {
        try
        {
            var rows = await db.QueryAsync(
                @"SELECT Value FROM D365FinancialDimensionValues
                  WHERE Dimension = 'D02_Function'
                  ORDER BY 1");
            var items = rows.Select(r => r["Value"]?.ToString() ?? "")
                            .Where(s => s.Length > 0);
            D365FunctionOptions = new List<string> { "" };
            D365FunctionOptions.AddRange(items);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Couldn't read D365FinancialDimensionValues (D02_Function)");
            D365FunctionOptions = new List<string> { "" };
        }
    }

