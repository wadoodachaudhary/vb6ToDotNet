    // Once the user has answered the save-prompt and chosen to leave, we re-issue the
    // navigation; this flag lets that second pass through without re-prompting.
    private bool _navigationPromptSuppressed;

    // VB6 Form_Unload (FCommunities.frm 366-371): If Not SaveData(True) Then Cancel=True.
    // SaveData(true) shows the Yes/No/Cancel "save the changes?" prompt and returns false
    // ONLY when the user picks Cancel (or a save error) — in which case we keep the user
    // on the page (PreventNavigation). Yes saves then proceeds, No discards then proceeds.
    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (_navigationPromptSuppressed || !mDirty)
            return;

        context.PreventNavigation();
        if (await SaveData(true))
        {
            _navigationPromptSuppressed = true;
            NavigationManager.NavigateTo(context.TargetLocation);
        }
    }

