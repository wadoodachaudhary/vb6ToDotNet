    private bool IsColumnVisible(string fieldName)
    {
        // VB6 Form_Load applies these ColHidden overrides AFTER IniGetGrid, so the
        // GST/PST hide rules win regardless of whether the layout (or the fallback
        // default list) made the column visible — see LoadAccountingOptions /
        // VB6 lines 344-349. Check them in BOTH the dynamic-layout and fallback paths.
        if (fieldName.Equals("GSTRate", StringComparison.OrdinalIgnoreCase)) return ShowGSTRate;
        if (fieldName.Equals("PSTRate", StringComparison.OrdinalIgnoreCase)) return ShowPSTRate;
        // When using IniGetGrid layout, all returned columns are visible (hidden ones are filtered out)
        if (HasGridLayout) return true;
        // For default layout, check hidden fields and special visibility
        if (_defaultHiddenFields.Contains(fieldName)) return false;
        return true;
    }

    private RenderFragment RenderColumn(string fieldName, string headerText, string width) => builder =>
    {
        var visible = IsColumnVisible(fieldName);

        if (_checkboxFields.Contains(fieldName))
        {
            builder.OpenComponent<GridColumn>(0);
            builder.AddAttribute(1, "Field", fieldName);
            builder.AddAttribute(2, "HeaderText", headerText);
            builder.AddAttribute(3, "Width", width);
            builder.AddAttribute(4, "Visible", visible);
            builder.AddAttribute(5, "Type", ColumnType.CheckBox);
            builder.AddAttribute(6, "AllowEditing", true);
            // HHM-541: VB6 vsFlexGrid centers checkbox cells; BuildPro/Wrap Ins headers right-aligned.
            builder.AddAttribute(7, "TextAlign", TextAlign.Center);
            if (fieldName.Equals("BuildPro", StringComparison.OrdinalIgnoreCase)
                || fieldName.Equals("WrapInsuranceExempt", StringComparison.OrdinalIgnoreCase))
                builder.AddAttribute(8, "HeaderTextAlign", TextAlign.Right);
            builder.CloseComponent();
        }
        else if (_numericFields.Contains(fieldName))
        {
            builder.OpenComponent<GridColumn>(0);
            builder.AddAttribute(1, "Field", fieldName);
            builder.AddAttribute(2, "HeaderText", headerText);
            builder.AddAttribute(3, "Width", width);
            builder.AddAttribute(4, "Visible", visible);
            builder.AddAttribute(5, "Type", ColumnType.Number);
            // HHM-542: VB6 GSTRate/PSTRate use "#,###.##" (comma grouping).
            builder.AddAttribute(6, "Format", "#,##0.00");
            builder.AddAttribute(7, "AllowEditing", true);
            // HHM-541: right-align the numeric rate values and headers.
            builder.AddAttribute(8, "TextAlign", TextAlign.Right);
            builder.AddAttribute(9, "HeaderTextAlign", TextAlign.Right);
            if (fieldName.Equals("GSTRate", StringComparison.OrdinalIgnoreCase))
                builder.AddAttribute(10, "MaxLength", 12);
            builder.CloseComponent();
        }
        else if (_dropDownFields.Contains(fieldName))
        {
            builder.OpenComponent<GridColumn>(0);
            builder.AddAttribute(1, "Field", fieldName);
            builder.AddAttribute(2, "HeaderText", headerText);
            builder.AddAttribute(3, "Width", width);
            builder.AddAttribute(4, "Visible", visible);
            builder.AddAttribute(5, "AllowEditing", true);
            builder.AddAttribute(6, "EditOptions", GetDropDownOptions(fieldName));
            builder.CloseComponent();
        }
        else if (_buttonPickerFields.Contains(fieldName))
        {
            var pickerField = fieldName;
            builder.OpenComponent<GridColumn>(0);
            builder.AddAttribute(1, "Field", fieldName);
            builder.AddAttribute(2, "HeaderText", headerText);
            builder.AddAttribute(3, "Width", width);
            builder.AddAttribute(4, "Visible", visible);
            builder.AddAttribute(5, "AllowEditing", true);
            builder.AddAttribute(6, "ShowEditButton", true);
            builder.AddAttribute(7, "Template", (RenderFragment<object>)(context => cellBuilder =>
            {
                if (context is not CommunityRow row)
                    return;

                var display = GetPickerDisplayValue(row, pickerField);
                cellBuilder.OpenElement(0, "div");
                cellBuilder.AddAttribute(1, "class", "poindex-cell");

                cellBuilder.OpenElement(2, "span");
                cellBuilder.AddAttribute(3, "class", "poindex-text");
                // HHM-503: VB6 grid has no cell tooltip — dropped the native title hover.
                cellBuilder.AddContent(5, display);
                cellBuilder.CloseElement();

                cellBuilder.OpenComponent<ButtonControl>(6);
                cellBuilder.AddAttribute(7, "CssClass", "poindex-btn fx-grid-popup-btn");
                cellBuilder.AddAttribute(8, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, () => OnPickerButtonClick(row, pickerField)));
                cellBuilder.AddAttribute(9, "StopPropagation", true);
                cellBuilder.AddAttribute(10, "ChildContent", (RenderFragment)(childBuilder => childBuilder.AddContent(0, "...")));
                cellBuilder.CloseComponent();

                cellBuilder.CloseElement();
            }));
            builder.CloseComponent();
        }
        else if (_textBoxFields.Contains(fieldName))
        {
            builder.OpenComponent<GridColumn>(0);
            builder.AddAttribute(1, "Field", fieldName);
            builder.AddAttribute(2, "HeaderText", fieldName.Equals("Area", StringComparison.OrdinalIgnoreCase) ? CommunityTerm : headerText);
            builder.AddAttribute(3, "Width", width);
            builder.AddAttribute(4, "Visible", visible);
            builder.AddAttribute(5, "AllowEditing", true);
            if (GridMaxLength(fieldName) is int ml)
                builder.AddAttribute(6, "MaxLength", ml);
            builder.CloseComponent();
        }
        else
        {
            builder.OpenComponent<GridColumn>(0);
            builder.AddAttribute(1, "Field", fieldName);
            builder.AddAttribute(2, "HeaderText", headerText);
            builder.AddAttribute(3, "Width", width);
            builder.AddAttribute(4, "Visible", visible);
            builder.AddAttribute(5, "AllowEditing", true);
            if (GridMaxLength(fieldName) is int ml)
                builder.AddAttribute(6, "MaxLength", ml);
            builder.CloseComponent();
        }
    };

    private string GetPickerDisplayValue(CommunityRow row, string field)
    {
        return field switch
        {
            "Comments" => TruncateText(row.Comments, 30),
            "Company" => row.Company,
            "LotInventoryDebit" => row.LotInventoryDebit,
            "Divisions" => row.Divisions,
            "Project_Manager" => row.Project_Manager,
            "CustServiceID" => row.CustServiceID,
            "WarrantyJob" => row.WarrantyJob,
            "DC_Sales_Person" => row.DC_Sales_Person,
            "Contract_Document" => TruncateTextRight(row.Contract_Document, 20),
            "Purchaser" => row.Purchaser,
            _ => ""
        };
    }

    private async Task OnPickerButtonClick(CommunityRow row, string field)
    {
        EditingRow = row;
        switch (field)
        {
            case "Comments": EditComments(row); break;
            case "Company": _ = EditCompany(row); break;
            case "LotInventoryDebit": EditAccounting(row); break;
            case "Divisions": await EditDivisions(row); break;
            case "Project_Manager": await SelectProjectManager(row); break;
            case "CustServiceID": await SelectCustService(row); break;
            case "WarrantyJob": await SelectWarrantyJob(row); break;
            case "DC_Sales_Person": await SelectDCSalesPerson(row); break;
            case "Contract_Document": await BrowseContractDocument(row); break;
            case "Purchaser": await SelectPurchaser(row); break;
        }
    }

