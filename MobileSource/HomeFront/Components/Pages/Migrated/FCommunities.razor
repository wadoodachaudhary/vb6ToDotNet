    // Row CSS: pending-delete rows hide instantly like VB6 RowHidden (HHM-221
    // removed the Find/search highlight — VB6 FCommunities has no Find).
    private string? GetCommunityRowCssClass(CommunityRow row, int rowIndex)
    {
        // VB6 gData_KeyDown sets RowHidden(Row)=True the instant a row is marked for
        // delete, so it vanishes immediately (the actual sp_DeleteCommunity runs at
