    // ── Field caps come from the database, never hardcoded ────────────
    // Over-allowing a field is what produces "String or binary data would be
    // truncated" on save, so every capped input reads its column's real width.
    private readonly Dictionary<string, int> _colLen = new(StringComparer.OrdinalIgnoreCase);

    private async Task LoadColumnLengthsAsync()
    {
        try
        {
            var rows = await db.QueryAsync(
                @"SELECT COLUMN_NAME, CHARACTER_MAXIMUM_LENGTH
                  FROM INFORMATION_SCHEMA.COLUMNS
                  WHERE TABLE_NAME = @TableName AND CHARACTER_MAXIMUM_LENGTH > 0",
                new { TableName = "Communities" });

            foreach (var r in rows)
            {
                var col = r.TryGetValue("COLUMN_NAME", out var c) ? c?.ToString() ?? "" : "";
                if (string.IsNullOrEmpty(col)) continue;
                if (!r.TryGetValue("CHARACTER_MAXIMUM_LENGTH", out var raw) || raw == null || raw == DBNull.Value) continue;
                if (int.TryParse(raw.ToString(), out var len) && len > 0) _colLen[col] = len;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadColumnLengths");
        }
    }

    private int? ColLen(string column) => _colLen.TryGetValue(column, out var n) ? n : null;

    // The address box holds Address1 and Address2 on separate lines; the cap is
    // both columns plus the newline that splits them on save.
    private int? AddressLen =>
        ColLen("Address1") is int a && ColLen("Address2") is int b ? a + 1 + b : null;

