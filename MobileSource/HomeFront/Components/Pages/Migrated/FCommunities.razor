    // VB6 gData_CellButtonClick Case "Contract_Document" (FCommunities.frm 707-710):
    //   s = .Text
    //   If VBGetOpenFileName(s, …, "Contract Documents (*.dot;*.rpt)|*.dot;*.rpt",
    //                        …, "Select Contract Document", …, Me.hwnd) Then .Text = s
    // VB6 raised the Win32 GetOpenFileName dialog to pick a Word .dot template or a
    // Crystal .rpt contract document; the file NAME/PATH is stored in the
    // Contract_Document varchar column (nothing is uploaded — the print engine later
    // opens it by path). A browser can't raise a native file-open dialog, but per the
    // user decision we list the server-side files instead — exactly like FVendor's
    // "PO Format" dropdown lists wwwroot/resources/Estimating/PO Formats/*.rpt. Here
    // the templates live in wwwroot/resources/Estimating/Contract Documents/ and we
    // surface *.dot + *.rpt (the VB6 filter) through the shared FPickList. The chosen
    // file name is written to the cell; the cell also stays free-text so an existing
    // or hand-typed path keeps working.
    private async Task BrowseContractDocument(CommunityRow row)
    {
        if (pickList == null) return;
        EditingRow = row;

        var files = GetContractDocumentFiles();
        if (files.Count == 0)
        {
            // VB6 ALWAYS raised the native file-open dialog here (GetOpenFileName), so when no
            // server-side templates exist yet we open the client file browser to match it —
            // rather than dead-ending on a message. EditingRow was captured above; the picked
            // .dot/.rpt is uploaded + written to the cell in OnContractFileSelected.
            await OpenContractFileBrowser();
            return;
        }

        _pickHandler = rows =>
        {
            if (rows.Count > 0) { row.Contract_Document = PickCol(rows[0], "Document"); MarkDirty(row); }
            return Task.CompletedTask;
        };
        // Single "Document" column (no hidden ID) — the displayed value IS the stored
        // value, matching VB6 (.Text = the file the dialog returned).
        await pickList.Open(
            title: "Select Contract Document",
            queries: BuildFileListQuery(files),
            defaultItem: row.Contract_Document);
    }

    // The hidden <InputFile> used as the empty-folder file browser (VB6's GetOpenFileName).
    private InputFile? contractFileInput;

    // Open the OS file browser by clicking the hidden <InputFile> (the only way to raise a
    // file-open dialog from a browser — same approach FImportExportAssemblies uses). The
    // accept filter (.dot,.rpt) mirrors VB6's "Contract Documents (*.dot;*.rpt)" filter.
    private async Task OpenContractFileBrowser()
    {
        await JSRuntime.InvokeVoidAsync("eval",
            "document.querySelector('.fcomm-contract-file input[type=file]').click()");
    }

    // File chosen from the empty-folder browser. VB6 stored the file the dialog returned in the
    // Contract_Document cell; on the web the server can't reach the client's path later, so we
    // upload the .dot/.rpt into the Contract Documents templates folder (where the print engine
    // and the FPickList both read from) and write its name to the cell — the same value a list
    // pick would produce. Cancelling the dialog raises no event, so nothing changes (as in VB6).
    private async Task OnContractFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || EditingRow == null) return;

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext != ".dot" && ext != ".rpt")
        {
            Notifications.Warning("A contract document must be a Word template (*.dot) or Crystal report (*.rpt).");
            return;
        }

        try
        {
            var safeName = Path.GetFileName(file.Name);   // strip any path → no directory traversal
            var dir = Path.Combine(Env.WebRootPath, "resources", "Estimating", "Contract Documents");
            Directory.CreateDirectory(dir);
            var dest = Path.Combine(dir, safeName);

            await using (var fs = new FileStream(dest, FileMode.Create, FileAccess.Write))
            await using (var src = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024))
                await src.CopyToAsync(fs);

            EditingRow.Contract_Document = safeName;
            MarkDirty(EditingRow);
            Notifications.Info($"Contract document “{safeName}” added to the Contract Documents folder.");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{Src}OnContractFileSelected]", SRCFILE);
            Notifications.Error("Couldn't save the selected contract document", ex.Message);
        }
    }

    // List the contract-template files in wwwroot/resources/Estimating/Contract
    // Documents (VB6 filter: *.dot;*.rpt). File NAMES are returned (with extension,
    // as VB6's .Text held the file the dialog returned). Sorted, de-duped.
    private List<string> GetContractDocumentFiles()
    {
        var result = new List<string>();
        try
        {
            var dir = Path.Combine(Env.WebRootPath, "resources", "Estimating", "Contract Documents");
            if (Directory.Exists(dir))
            {
                var names = Directory.GetFiles(dir, "*.dot")
                    .Concat(Directory.GetFiles(dir, "*.rpt"))
                    .Select(Path.GetFileName)
                    .Where(n => !string.IsNullOrWhiteSpace(n))
                    .Select(n => n!)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(n => n, StringComparer.OrdinalIgnoreCase);
                result.AddRange(names);
            }
            else
            {
                Logger.LogWarning("[{Src}BrowseContractDocument] Contract Documents folder not found at {Dir}", SRCFILE, dir);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[{Src}BrowseContractDocument] Couldn't list Contract Documents folder", SRCFILE);
        }
        return result;
    }

    // FPickList runs its list off a SQL query; turn the in-memory file names into a
    // VALUES-backed single-column ("Document") result set so the picker shows them
    // with its standard search/sort. The names are server filenames (not user input),
    // but quote-escape defensively so an apostrophe in a file name stays safe. ("File"
    // is a T-SQL reserved word, so the column is named Document.)
    private static string BuildFileListQuery(List<string> files)
    {
        var rows = string.Join(",", files.Select(f => $"('{f.Replace("'", "''")}')"));
        return $"SELECT Document FROM (VALUES {rows}) AS t(Document) ORDER BY Document";
    }

