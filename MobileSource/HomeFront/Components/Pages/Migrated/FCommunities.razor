    // Column resize / reorder / hide / group / header-rename done by the user is
    // merged back into the loaded layout and written through to AppGridLayout.
    private async Task OnGridLayoutChangedAsync(GridSettings snapshot)
    {
        if (snapshot == null || GridLayout.Count == 0) return;

        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, FormName, GridName, instanceKey: null,
                GridLayout, snapshot, layoutFieldResolver: ResolveGridField);

            _grid.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FCommunities {Grid} layout", GridName);
        }
    }

