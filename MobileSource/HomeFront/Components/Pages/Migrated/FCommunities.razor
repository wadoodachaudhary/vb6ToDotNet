            return Task.CompletedTask;
        };
        await pickList.Open(
            title: "Project Manager",
            // VB6 prepends "select '' ID,'' Name union …" so the value can be cleared.
            // HHM-538: VB6 shows the id column for PM (no hidecols) and the UNION orders
            // by column 1 (id).
            queries: "SELECT '' ID, '' Name UNION SELECT pm ID, pmname Name FROM tblprojectmanager WHERE ISNULL(inactive,0)=0 AND ISNULL(PrjMgr,0)=1 ORDER BY 1",
            defaultItem: row.Project_Manager);
