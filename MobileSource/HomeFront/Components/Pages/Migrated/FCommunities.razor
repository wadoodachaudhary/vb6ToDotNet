    // HHM-532: VB6 FCommunityAccounting has no Ok/Cancel — closing the dialog (X or
    // Escape) IS the save. ShowForm (frm 665-692) copies field() back into the grid
    // row after Me.Show vbModal returns, whichever way the form was unloaded, and
    // FCommunities.frm 717 sets mDirty=True right after. Apply + mark dirty on close.
    private async Task OnAcctClose()
    {
        var data = GetCurrentData();
        if (EditingRow != null)
        {
            ApplyAccountingDataToRow(EditingRow, data);
            MarkDirty(EditingRow);
        }
        AccountingDialogVisible = false;
        RequestGridKeyboardResume();
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyAccountingDataToRow(CommunityRow row, CommunityAccountingData data)
    {
        row.WarrantyJob = data.WarrantyJob;
        row.IncomePrefix = data.IncomePrefix;
        row.BalanceSheet = data.BalanceSheet;
        row.LotInventoryDebit = data.LotInventoryDebit;
        row.LotInventoryCredit = data.LotInventoryCredit;
        row.LabourTaxGroup = data.LabourTaxGroup;
        row.MaterialTaxGroup = data.MaterialTaxGroup;
        row.SubContractTaxGroup = data.SubContractTaxGroup;
        row.EquipmentTaxGroup = data.EquipmentTaxGroup;
        row.OverheadTaxGroup = data.OverheadTaxGroup;
        row.OtherTaxGroup = data.OtherTaxGroup;
        row.IntacctEntity = data.IntacctEntity;
        row.IntacctParentJob = data.IntacctParentJob;
        row.IntacctDepartment = data.IntacctDepartment;
        row.Mortgage_Credit = data.MortgageCredit;
