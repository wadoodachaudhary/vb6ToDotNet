    // VB6 gData_BeforeEdit: decide whether a cell may enter edit mode.
    //   • Area  — editable only while blank; once saved it's the key (locked).
    //   • Popup/lookup columns (Company, Divisions, Project_Manager, …) do NOT
    //     accept typed text — they open the "…" FPickList. Veto the inline edit
    //     so the cell stays read-only and the picker button is the only way in.
    //   • Everything else (Description, Abr, SalesManagerEmail, plain address /
    //     accounting text) is freely typeable.
    private void OnCommunityCellEdit(CellEditArgs<CommunityRow> args)
    {
        var field = args.ColumnName ?? "";
        if (_buttonPickerFields.Contains(field))
        {
            args.Cancel = true;
            return;
        }
        if (field.Equals("Area", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrEmpty(args.Data?.OriginalArea))
        {
            args.Cancel = true;
        }
    }

    // VB6 gData_AfterEdit: the grid already wrote the typed value into the bound
    // property (FlexKit reflection). Just mark the row dirty so Save persists it.
    private void OnCommunityCellSave(CellSaveArgs<CommunityRow> args)
    {
        if (args.Data != null)
            MarkDirty(args.Data);
    }

    // VB6 multi-cell entry (AllowSelection=True / SelectionMode=3): one committed
    // edit applies to every selected row in the column. Same page-side fan-out as
    // FDBGrid's HHM-605 handler; the picker-button columns and the Area key column
    // keep the same gating OnCommunityCellEdit enforces for single edits.
    private async Task OnCommunityTypeAheadCommit(TypeAheadCommitArgs<CommunityRow> args)
    {
        var field = args.ColumnName ?? "";
        if (string.IsNullOrWhiteSpace(field) || _buttonPickerFields.Contains(field)) return;

        var prop = typeof(CommunityRow).GetProperty(field);
        if (prop == null || !prop.CanWrite) return;

        foreach (var row in args.SelectedItems)
        {
            // Area is the key: only still-new rows may take it (gData_BeforeEdit).
            if (field.Equals("Area", StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrEmpty(row.OriginalArea))
                continue;

            try
            {
                object? val = args.Value;
                if (prop.PropertyType != typeof(string))
                    val = string.IsNullOrWhiteSpace(args.Value)
                        ? Activator.CreateInstance(prop.PropertyType)
                        : Convert.ChangeType(args.Value,
                            Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType,
                            System.Globalization.CultureInfo.InvariantCulture);
                prop.SetValue(row, val);
                MarkDirty(row);
            }
            catch
            {
                // Unparseable value for this cell's type — leave that cell unchanged.
            }
        }

        if (gData != null) await gData.Refresh();
        await InvokeAsync(StateHasChanged);
    }

