        return Task.CompletedTask;
    }

    private static string PickCol(IDictionary<string, object> row, string col)
    {
        foreach (var kv in row)
            if (string.Equals(kv.Key, col, StringComparison.OrdinalIgnoreCase))
                return kv.Value?.ToString() ?? "";
        return "";
    }

    // VB6 (gData_CellButtonClick Case "Divisions"): FPickList.Choose("Division",
    // "select divisioncode Code,divisionname Name from divisions", MultiSelect:=True),
    // then loops ALL picked rows building a comma-separated list of Codes:
    //   For i = 1 To FPickList.SelectedItems: s = s & ", " & FPickList.SelectedItem("Code", i)
    //   .TextMatrix(Row, Col) = Mid(s, 3)
    // DivisionCommunities is genuinely many-to-many — a community can map to several
    // divisions, so this MUST be multi-select. Single-select silently collapsed the
    // junction to one code on re-open (data loss). The save side splits this comma
    // list back into one DivisionCommunities row per code.
    // (VB6 omits a DefaultItem on the multi-pick — the dialog opens fresh, no pre-seed.)
    private async Task EditDivisions(CommunityRow row)
    {
        if (pickList == null) return;
        EditingRow = row;
        _pickHandler = rows =>
        {
            if (rows.Count > 0)
            {
                row.Divisions = string.Join(", ",
                    rows.Select(r => PickCol(r, "Code"))
                        .Where(c => !string.IsNullOrWhiteSpace(c)));
                MarkDirty(row);
            }
            return Task.CompletedTask;
        };
        await pickList.Open(
            title: "Division",
            queries: "SELECT divisioncode Code, divisionname Name FROM divisions ORDER BY divisioncode",
            multiSelect: true);
    }

