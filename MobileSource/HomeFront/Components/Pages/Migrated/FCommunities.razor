    // HHM-534: VB6 FCommunityAccounting text1_Validate (Case 5-10, frm 821-837) fires
    // when focus leaves a tax-group box — which the "…" click forces. Non-empty text
    // that isn't in taxgroups pops MsgBox "Invalid Tax Group" (vbExclamation) with
    // Cancel=True, vetoing the move; a valid entry is rewritten with the DB casing
    // (text1 = rs("taxgroup")). Mirror both before opening the picker.
    private async Task BrowseTaxGroup(int fieldIndex)
    {
        var current = GetTaxGroupFieldValue(fieldIndex);
        if (!string.IsNullOrEmpty(current))
        {
            var match = await LookupTaxGroup(current);
            if (match == null)
            {
                if (_messageBox != null)
                    await _messageBox.ShowAsync("Invalid Tax Group", PRODUCT_NAME, Fx.ControlKit.Dialogs.MessageBoxButtons.Ok, "warning");
                return;
            }
            SetFieldValue(fieldIndex, match);
        }
        await OpenAcctPick(
            "Tax Group",
            $"SELECT TaxGroup, Description FROM TaxGroups WHERE DivisionID = {SessionState.DivisionID} ORDER BY TaxGroup",
            "TaxGroup", null, fieldIndex);
    }

    // Current text of a tax-group field by its VB6 text1 index (5-10).
    private string GetTaxGroupFieldValue(int index) => index switch
    {
        5 => LabourTaxGroup,
        6 => MaterialTaxGroup,
        7 => SubContractTaxGroup,
        8 => EquipmentTaxGroup,
        9 => OverheadTaxGroup,
        10 => OtherTaxGroup,
        _ => ""
    };

    // HHM-534: the stored TaxGroup (DB casing) for this division, or null when the
    // text isn't a valid tax group — VB6 text1_Validate's taxgroups SELECT.
    private async Task<string?> LookupTaxGroup(string taxGroup)
    {
        var sql = "SELECT TaxGroup FROM TaxGroups WHERE DivisionID = @DivisionID AND TaxGroup = @TaxGroup";
        var rows = await db.QueryAsync(sql, new { SessionState.DivisionID, TaxGroup = taxGroup });
        return rows.Count > 0 ? rows[0]["TaxGroup"]?.ToString() : null;
    }

