        if (pickList == null) return;
        EditingRow = row;
        _pickHandler = rows =>
        {
            if (rows.Count > 0) { row.WarrantyJob = PickCol(rows[0], "ID"); MarkDirty(row); }
            return Task.CompletedTask;
        };
        await pickList.Open(
            title: "Warranty Job",
            queries: $"SELECT job_no Job, Description, job_no ID FROM tblJobs WHERE DivisionID = {SessionState.DivisionID} AND ISNULL(inactive,0)=0 ORDER BY job_no",
            hideColumns: "ID", defaultItem: row.WarrantyJob);
    }

    // VB6 gData_ValidateEdit Case "WarrantyJob" (FCommunities.frm 768-778):
    //   If .EditText <> "" Then
    //     Set rs = SqlExec("select * from tbljobs where DivisionID=… and job_no=@j")
    //     If rs.EOF Then MsgBox "invalid job": Cancel = True
    //     Else .EditText = rs("Job_no")   ' normalize to the canonical job_no
    // The WarrantyJob cell is typeable (gData_BeforeEdit set .ComboList = "|...",
    // EditMaxLength = 12); on commit we validate the typed value is a real job for
    // this division. A blank clears the field (VB6 skips validation when EditText is
    // empty). Invalid → reject (restore prior value) + "invalid job" message.
    private async Task OnWarrantyJobTyped(CommunityRow row, string typed)
    {
        var value = (typed ?? "").Trim();

        if (value.Length == 0)
        {
            // Blank is allowed (clears the warranty job) — mark dirty so Save persists it.
            row.WarrantyJob = "";
            MarkDirty(row);
            return;
        }

        try
        {
            // Parameterized — never interpolate the typed job into SQL. Return the
            // canonical job_no so casing/padding normalizes to the stored value (VB6
            // assigned .EditText = rs("Job_no")).
            var canonical = await db.ExecuteScalarAsync<string>(
                "SELECT TOP 1 Job_No FROM tblJobs WHERE DivisionID = @Div AND Job_No = @Job",
                new { Div = SessionState.DivisionID, Job = value });

            if (string.IsNullOrEmpty(canonical))
            {
                // VB6: MsgBox "invalid job" + Cancel = True (the edit is rejected).
                Notifications.Error("invalid job");
                // Restore the prior committed value so the rejected edit doesn't stick.
                row.WarrantyJob = row.WarrantyJob ?? "";
                await InvokeAsync(StateHasChanged);
                return;
            }

            row.WarrantyJob = canonical;
            MarkDirty(row);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{Src}OnWarrantyJobTyped] Error validating job '{Job}'", SRCFILE, value);
            Notifications.Error($"Error validating job: {ex.Message}");
        }
    }

