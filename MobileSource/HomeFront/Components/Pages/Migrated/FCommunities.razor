@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - Initial port from VB6
   ───────────────────────────────────────────────────────────────── *@
@namespace HomeFront.Components.Pages
@page "/communities"
@using HomeFront.Data
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Routing
@using System.Data
@using System.Reflection
@inject ILogger<FCommunities> Logger
@inject NotificationService Notifications
@inject NavigationManager NavigationManager
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@using HomeFront.Models
@inject DbWrapperSqlServer db
@inject IWebHostEnvironment Env
@layout HFComponent
<PageTitle>Community</PageTitle>

@* VB6 Form_Unload (FCommunities.frm 366-374): If Not SaveData(True) Then Cancel=True —
   i.e. on navigate-away with unsaved changes, prompt "save the changes?" (Yes/No/Cancel)
   and CANCEL the navigation if the user picks Cancel. NavigationLock is the Blazor
   equivalent: OnBeforeInternalNavigation fires for in-app navigation, and
   ConfirmExternalNavigation guards browser-level exits. No JS. *@
<NavigationLock ConfirmExternalNavigation="@mDirty"
                OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<div class="tabs-container">
    

    <div class="tab-content">
            <div class="panel">
                <div class="toolbar-cntr">
                    @* FlexKit toolbar buttons (ToolbarButtonControl) — same icon+label
                       toolbar pattern as FItems. CssClass="e-btn" keeps the existing
                       framed look; the OnClick / disabled wiring is identical to the
                       raw <button> it replaced. *@
                    <ToolbarButtonControl CssClass="e-btn"
                                          OnClick="OnNewClick"
                                          IconSrc="images/32/new.ico"
                                          IconAlt="New"
                                          Label="New" />
                    <ToolbarButtonControl CssClass="e-btn"
                                          Disabled="@(!mDirty)"
                                          OnClick="OnSaveClick"
                                          IconSrc="images/32/save.ico"
                                          IconAlt="Save"
                                          Label="Save" />
                    <ToolbarButtonControl CssClass="e-btn"
                                          Disabled="@(SelectedCommunity == null)"
                                          OnClick="OnDeleteClick"
                                          IconSrc="images/32/delete.ico"
                                          IconAlt="Delete"
                                          Label="Delete" />

@* HHM-221: VB6 FCommunities has NO Find/search UI (frm toolbar = New/Save/Delete only) — removed. *@
                </div>

                @* VB6 KeyPreview=-1 + Form_KeyDown (Ctrl+S save) + gData_KeyDown
                   (Ctrl+Delete delete current row). The GridControl has no consumer
                   keydown event, so catch both keystrokes on a wrapper div: the grid's
                   own @onkeydown bubbles up here. No JS — pure Blazor @onkeydown. *@
                <div class="content-wrapper" @onkeydown="OnGridKeyDown">
                    @if (IsLoading)
                    {
                        <div class="loading-overlay">
                            <div class="loading-card">Loading...</div>
                        </div>
                    }
                    @* Viewport-absolute Height (NOT 100%): the grid must be its own
                       bounded scroll container so the sticky column header freezes on
                       scroll and BeginEditCellAsync can scroll a new row into view.
                       height:100% only resolves if every flex ancestor has a definite
                       height, which this page's flex:1/min-height:0 chain doesn't
                       guarantee — so the grid grew to content height and the OUTER page
                       scrolled instead (header never stuck, no in-grid autoscroll).
                       Same calc() idiom as FPricingWorkSheet (320) / FAssembly (380);
                       this page has only a toolbar above the grid, hence ~140px. *@
                    <GridControl @ref="gData"
                            TValue="CommunityRow"
                            DataSource="@CommunitiesData"
                            AllowSelection="true"
                            AllowSorting="true"
                            AllowFiltering="true"
                            AllowResizing="true"
                            EnableHover="true"
                            Height="calc(100vh - 140px)"
                            RowCssClassSelector="@GetCommunityRowCssClass"
                            BatchEditBehavior="GridBatchEditBehavior.SingleCell"
                            AllowSingleCellColumnMassEdit="true"
                            FilterSettingsRef="@filterSettings"
                            SelectionSettingsRef="@selectionSettings"
                            EditSettingsRef="@communitiesEditSettings"
                            EventsRef="@communitiesEvents"
                            OnLayoutChanged="@OnGridLayoutChangedAsync">
                        <GridColumnsBase @key="GridLayoutVersion" DebugTag="FCommunities-gData">
                            <GridColumn Field="@nameof(CommunityRow.OriginalArea)" HeaderText="OriginalArea" Visible="false" AllowEditing="false" IsPrimaryKey="true" />

                            @if (HasGridLayout)
                            {
                                @* Dynamic columns from IniGetGrid *@
                                foreach (var entry in GetOrderedGridLayout())
                                {
                                    var layout = entry.Layout;
                                    var fieldName = entry.Field;
                                    var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                                    var width = layout.Width.HasValue && layout.Width.Value > 0
                                        ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                                        : GetDefaultWidth(fieldName);

                                    @RenderColumn(fieldName, headerText, width)
                                }

                                @* VB6 frmload: IniGetGrid adds every column, then
                                   hides ABN_D02Function unless the accounting system
                                   is asD365_ABN. The Blazor AppGridLayout has NO row
                                   for ABN_D02Function (it's a new D365-ABN-only field),
                                   so the dynamic loop above never emits it — append it
                                   here, ONLY for D365-ABN, and only if the layout didn't
                                   already supply it (future-proof against a layout row). *@
                                if (IsD365ABN && !GridLayout.ContainsKey("ABN_D02Function"))
                                {
                                    @RenderColumn("ABN_D02Function", "Function (D02)", GetDefaultWidth("ABN_D02Function"))
                                }
                            }
                            else
                            {
                                @* Default columns (fallback when no DB layout exists) *@
                                @RenderColumn("Area", CommunityTerm, "120px")
                                @RenderColumn("Description", "Description", "200px")
                                @RenderColumn("Comments", "Comments", "160px")
                                @RenderColumn("Company", "Company", "150px")
                                @RenderColumn("LotInventoryDebit", "Accounting", "140px")
                                @RenderColumn("Divisions", "Divisions", "140px")
                                @RenderColumn("Project_Manager", "Project Manager", "160px")
                                @RenderColumn("CustServiceID", "Service Rep", "140px")
                                @RenderColumn("WarrantyJob", "Warranty Job", "140px")
                                @RenderColumn("DC_Sales_Person", "DC Sales Person", "160px")
                                @RenderColumn("PreconScheduleTemplate", "PreCon Template", "150px")
                                @* VB6: ABN_D02Function shown only for asD365_ABN. *@
                                @if (IsD365ABN)
                                {
                                    @RenderColumn("ABN_D02Function", "Function (D02)", "160px")
                                }
                                @RenderColumn("Inactive", "Inactive", "90px")
                                @RenderColumn("BuildPro", "BuildPro", "90px")
                                @RenderColumn("WrapInsuranceExempt", "Wrap Ins Exempt", "140px")
                                @RenderColumn("GSTRate", "GST Rate", "100px")
                                @RenderColumn("Contract_Document", "Contract Doc", "160px")
                                @RenderColumn("Abr", "Abr", "80px")
                                @RenderColumn("Purchaser", "Purchaser", "140px")
                                @RenderColumn("SalesManagerEmail", "Sales Mgr Email", "200px")
                                @RenderColumn("Email", "Email", "180px")
                                @RenderColumn("Address1", "Address 1", "150px")
                                @RenderColumn("Address2", "Address 2", "150px")
                                @RenderColumn("City", "City", "120px")
                                @RenderColumn("Province", "Province", "100px")
                                @RenderColumn("Postal", "Postal", "100px")
                                @RenderColumn("Country", "Country", "100px")
                                @RenderColumn("County", "County", "100px")
                                @RenderColumn("Phone", "Phone", "120px")
                                @RenderColumn("Fax", "Fax", "120px")
                                @RenderColumn("TaxNumber", "Tax Number", "120px")
                                @RenderColumn("IncomePrefix", "Income Prefix", "100px")
                                @RenderColumn("BalanceSheet", "Balance Sheet", "120px")
                                @RenderColumn("Mortgage_Credit", "Mortgage Credit", "140px")
                                @RenderColumn("BankAccount", "Bank Account", "120px")
                                @RenderColumn("TarionBuilderNumber", "Tarion Builder #", "140px")
                                @RenderColumn("LotInventoryCredit", "Lot Inv Credit", "140px")
                                @RenderColumn("LabourTaxGroup", "Labour Tax Grp", "140px")
                                @RenderColumn("MaterialTaxGroup", "Material Tax Grp", "140px")
                                @RenderColumn("SubContractTaxGroup", "SubContract Tax Grp", "160px")
                                @RenderColumn("EquipmentTaxGroup", "Equipment Tax Grp", "160px")
                                @RenderColumn("OverheadTaxGroup", "Overhead Tax Grp", "150px")
                                @RenderColumn("OtherTaxGroup", "Other Tax Grp", "140px")
                                @RenderColumn("PSTRate", "PST Rate", "100px")
                                @RenderColumn("IntacctEntity", "Intacct Entity", "140px")
                                @RenderColumn("IntacctParentJob", "Intacct Parent Job", "160px")
                                @RenderColumn("IntacctDepartment", "Intacct Dept", "140px")
                            }
                        </GridColumnsBase>
                    </GridControl>
                </div>
            </div>

    </div>
</div>

@* HHM-501/522/524: reuse the faithful FComments port (VB6 FComments.frm) instead of a
   hand-rolled dialog — it drops the "Enter comments..." placeholder, caps input at
   MaxLength 8000, shows the "(Ctrl + Enter) to save -- (Esc) to cancel" tooltip and
   wires those keyboard shortcuts, matching legacy. *@
<FComments @bind-Visible="CommentsDialogVisible"
           @bind-Value="EditingComments"
           Title="Comments"
           MaxLength="8000"
           OnSave="SaveComments"
           OnCancel="CloseCommentsDialog" />

@* ── Company popup (VB6 FCompany.frm) ─────────────────────────────────
   Field order + labels mirror ScreenShot3. Address is one multiline box
   that splits into Address1/Address2 on newline (VB6 Parse on vbCrLf).
   Province/Country are countrycodes combos with the province cascading
   off the selected country. All FlexKit controls. *@
<DialogControl Visible="@CompanyDialogVisible"
          Header="Company"
          Width="360px"
          IsModal="true"
          ShowCloseIcon="true"
          CssClass="company-dialog"
          CloseOnEscape="true"
          OnClose="SaveCompany">
    <ChildContent>
        <div class="form-section">
            <div class="field-row">
                <label class="field-label">Company Name</label>
                <div class="field-input"><TextBoxControl @bind-Value="CoCompanyName" AutoFocus="true" MaxLength="@ColLen("CompanyName")" /></div>
            </div>
            <div class="field-row">
                <label class="field-label">Address</label>
                <div class="field-input">
                    <TextBoxControl @bind-Value="CoAddress" Multiline="true" Rows="2" MaxLength="@AddressLen" />
                </div>
            </div>
            <div class="field-row">
                <label class="field-label">City/Prov</label>
                <div class="field-input field-input-split">
                    <TextBoxControl @bind-Value="CoCity" MaxLength="@ColLen("City")" />
                    <DropDownListControl TValue="string" TItem="string"
                                    @bind-Value="CoProvince" DataSource="@CompanyProvinces"
                                    AllowFiltering="true" Width="60px" />
                </div>
            </div>
            <div class="field-row">
                <label class="field-label">Postal Code</label>
                <div class="field-input"><TextBoxControl @bind-Value="CoPostal" MaxLength="@ColLen("Zip")" /></div>
            </div>
            <div class="field-row">
                <label class="field-label">Country</label>
                <div class="field-input">
                    <DropDownListControl TValue="string" TItem="string"
                                    Value="@CoCountry" ValueChanged="OnCompanyCountryChanged"
                                    DataSource="@CompanyCountries"
                                    AllowFiltering="true" Width="80px" />
                </div>
            </div>
            <div class="field-row">
                <label class="field-label">County</label>
                <div class="field-input"><TextBoxControl @bind-Value="CoCounty" MaxLength="@ColLen("County")" /></div>
            </div>
            <div class="field-row">
                <label class="field-label">Email</label>
                <div class="field-input"><TextBoxControl @bind-Value="CoEmail" MaxLength="@ColLen("Email")" /></div>
            </div>
            <div class="field-row">
                <label class="field-label">Phone</label>
                <div class="field-input"><TextBoxControl @bind-Value="CoPhone" MaxLength="@ColLen("Phone")" /></div>
            </div>
            <div class="field-row">
                <label class="field-label">Fax</label>
                <div class="field-input"><TextBoxControl @bind-Value="CoFax" MaxLength="@ColLen("FAX")" /></div>
            </div>
            <div class="field-row">
                <label class="field-label">Tax Number</label>
                <div class="field-input"><TextBoxControl @bind-Value="CoTaxNumber" MaxLength="@ColLen("GSTNumber")" /></div>
            </div>
        </div>
    </ChildContent>
    @* HHM-507/526: VB6 FCompany.frm has NO OK/Cancel buttons — it commits live and on
       window close (Form_Unload). The header close-icon / Escape now route to SaveCompany
       (OnClose above) so closing commits the fields, matching legacy. *@
</DialogControl>

<DialogControl Visible="@ConfirmDialogVisible"
          Header="Confirm"
          Width="400px"
          IsModal="true"
          ShowCloseIcon="true"
          OnClose="ConfirmCancel">
    <ChildContent>
        <p>@ConfirmMessage</p>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="ConfirmYes">Yes</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="ConfirmNo">No</ButtonControl>
        @if (ShowCancelButton)
        {
            <ButtonControl CssClass="fx-dialog-btn" OnClick="ConfirmCancel">Cancel</ButtonControl>
        }
    </FooterContent>
</DialogControl>

@* HHM-500: VB6 FCommunities.frm uses a modal MsgBox (OK popup) for the
   blank-community validation — MessageBoxControl replaces the inline toast. *@
<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />

@* HHM-532: VB6 FCommunityAccounting has NO Ok/Cancel buttons — ShowForm (frm 665-692)
   resumes after ANY unload (title-bar X, or Escape via Form_KeyDown frm 702-704) and
   always copies field() back into the grid row; FCommunities.frm 717 then sets
   mDirty=True. So closing the dialog IS the save — no footer, OnClose saves. *@
<DialogControl Visible="@AccountingDialogVisible"
          Header="Accounting"
          Width="470px"
          IsModal="true"
          ShowCloseIcon="true"
          CssClass="accounting-dialog"
          CloseOnEscape="true"
          OnClose="OnAcctClose">
    <ChildContent>
        @if (!IsIntacctSystem)
        {
            @* HHM-534: every text1 in VB6 FCommunityAccounting.frm has MaxLength=50 —
               cap the prefix/lot-inventory (and Intacct/Tarion) fields the same way. *@
            <div class="form-section">
                <div class="form-section-title">GL Accounts</div>
                <div class="field-row">
                    <label class="field-label">Income Stmt Prefix</label>
                    <div class="field-input">
                        <TextBoxControl @bind-Value="IncomePrefix" MaxLength="50" AutoFocus="true" />
                    </div>
                    <ButtonControl CssClass="mini-btn" OnClick="() => BrowsePrefix(1)" Disabled="@(!IsTimberline)">...</ButtonControl>
                </div>
                <div class="field-row">
                    <label class="field-label">Balance Sheet Prefix</label>
                    <div class="field-input">
                        <TextBoxControl @bind-Value="BalanceSheetPrefix" MaxLength="50" />
                    </div>
                    <ButtonControl CssClass="mini-btn" OnClick="() => BrowsePrefix(2)" Disabled="@(!IsTimberline)">...</ButtonControl>
                </div>
                <div class="field-row">
                    <label class="field-label">Lot Inventory Debit</label>
                    <div class="field-input">
                        <TextBoxControl @bind-Value="LotInventoryDebit" MaxLength="50" />
                    </div>
                </div>
                <div class="field-row">
                    <label class="field-label">Lot Inventory Credit</label>
                    <div class="field-input">
                        <TextBoxControl @bind-Value="LotInventoryCredit" MaxLength="50" />
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="form-section">
                <div class="form-section-title">Organization</div>
                <div class="field-row">
                    <label class="field-label">Entity</label>
                    <div class="field-input">
                        <TextBoxControl @bind-Value="IntacctEntity" MaxLength="50" AutoFocus="true" />
                    </div>
                    <ButtonControl CssClass="mini-btn" OnClick="BrowseIntacctEntity">...</ButtonControl>
                </div>
                <div class="field-row">
                    <label class="field-label">Location</label>
                    <div class="field-input">
                        <TextBoxControl @bind-Value="IntacctLocation" MaxLength="50" />
                    </div>
                    <ButtonControl CssClass="mini-btn" OnClick="BrowseIntacctLocation">...</ButtonControl>
                </div>
                <div class="field-row">
                    <label class="field-label">Parent Job</label>
                    <div class="field-input">
                        <TextBoxControl @bind-Value="IntacctParentJob" MaxLength="50" />
                    </div>
                    <ButtonControl CssClass="mini-btn" OnClick="BrowseIntacctParentJob">...</ButtonControl>
                </div>
                <div class="field-row">
                    <label class="field-label">Department</label>
                    <div class="field-input">
                        <TextBoxControl @bind-Value="IntacctDepartment" MaxLength="50" />
                    </div>
                    <ButtonControl CssClass="mini-btn" OnClick="BrowseIntacctDepartment">...</ButtonControl>
                </div>
            </div>
        }

        <div class="form-section">
            <div class="form-section-title">Tax Groups</div>
            <div class="tax-group-row">
                <div class="tax-group-col">
                    <div class="tax-field-row">
                        <label class="tax-field-label">Labour</label>
                        <TextBoxControl CssClass="tax-field-input" @bind-Value="LabourTaxGroup" MaxLength="50" />
                        <ButtonControl CssClass="mini-btn" OnClick="() => BrowseTaxGroup(5)">...</ButtonControl>
                    </div>
                    <div class="tax-field-row">
                        <label class="tax-field-label">Material</label>
                        <TextBoxControl CssClass="tax-field-input" @bind-Value="MaterialTaxGroup" MaxLength="50" />
                        <ButtonControl CssClass="mini-btn" OnClick="() => BrowseTaxGroup(6)">...</ButtonControl>
                    </div>
                    <div class="tax-field-row">
                        <label class="tax-field-label">Sub Contracts</label>
                        <TextBoxControl CssClass="tax-field-input" @bind-Value="SubContractTaxGroup" MaxLength="50" />
                        <ButtonControl CssClass="mini-btn" OnClick="() => BrowseTaxGroup(7)">...</ButtonControl>
                    </div>
                </div>
                <div class="tax-group-col">
                    <div class="tax-field-row">
                        <label class="tax-field-label">Equipment</label>
                        <TextBoxControl CssClass="tax-field-input" @bind-Value="EquipmentTaxGroup" MaxLength="50" />
                        <ButtonControl CssClass="mini-btn" OnClick="() => BrowseTaxGroup(8)">...</ButtonControl>
                    </div>
                    <div class="tax-field-row">
                        <label class="tax-field-label">Overhead</label>
                        <TextBoxControl CssClass="tax-field-input" @bind-Value="OverheadTaxGroup" MaxLength="50" />
                        <ButtonControl CssClass="mini-btn" OnClick="() => BrowseTaxGroup(9)">...</ButtonControl>
                    </div>
                    <div class="tax-field-row">
                        <label class="tax-field-label">Other</label>
                        <TextBoxControl CssClass="tax-field-input" @bind-Value="OtherTaxGroup" MaxLength="50" />
                        <ButtonControl CssClass="mini-btn" OnClick="() => BrowseTaxGroup(10)">...</ButtonControl>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="field-row">
                <label class="field-label">Loan Draw Liability Acct</label>
                <div class="field-input">
                    <TextBoxControl @bind-Value="MortgageCredit" MaxLength="50" />
                </div>
                <ButtonControl CssClass="mini-btn" OnClick="BrowseGLAccount">...</ButtonControl>
            </div>

            <div class="field-row">
                <label class="field-label">Bank Account</label>
                <div class="field-input">
                    <TextBoxControl @bind-Value="BankAccount" MaxLength="50" />
                </div>
                <ButtonControl CssClass="mini-btn" OnClick="BrowseBankAccount">...</ButtonControl>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Warranty</div>
            <div class="field-row">
                <label class="field-label">Warranty Job</label>
                <div class="field-input">
                    <TextBoxControl @bind-Value="WarrantyJob" MaxLength="50" />
                </div>
            </div>

            @if (ShowTarionFields)
            {
                <div class="field-row">
                    <label class="field-label">Tarion Builder No</label>
                    <div class="field-input">
                        <TextBoxControl @bind-Value="TarionBuilderNumber" MaxLength="50" />
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</DialogControl>

@* Shared FlexKit picklist (search + type-to-search + sortable) — VB6 FPickList.
   Every cell/accounting "…" picker routes through this, exactly like
   FAssembly / FPricingWorkSheet. No one-off pickers. *@
<FPickList @ref="pickList" OnSelected="OnPickListSelected" OnCancel="OnPickListCancelled" />

@* Contract-document file browser — VB6 raised a native file-open dialog (GetOpenFileName,
   *.dot;*.rpt). When NO server-side templates exist, the Contract Doc picker opens this hidden
   client file input instead of dead-ending on a message; the chosen file is uploaded into the
   Contract Documents folder and its name written to the cell (see OnContractFileSelected). *@
<div class="fcomm-contract-file" style="display:none">
    <InputFile @ref="contractFileInput" OnChange="OnContractFileSelected" accept=".dot,.rpt" />
</div>

@code {
    [Inject] public IJSRuntime JSRuntime { get; set; } = default!;

    private const string SRCFILE = "Communities::";
    private const string PRODUCT_NAME = "Precision Builder";
    private const string FormName = "FCommunities";
    private const string GridName = "gData";
private GridControl<CommunityRow>? gData;
    private FPickList? pickList;

    private bool mDirty = false;
    private bool IsLoading = false;
    private string CommunityTerm = "Community";

    // VB6 Form_Load (344-349) hides the GSTRate column unless HFApp.Options(Show_CDN_GST)
    // and the PSTRate column unless HFApp.Options(UsePst). Those options live on the
    // system_setup row (id = DivisionID) — NOT hardcoded — so the GST/PST columns vary
    // per division (e.g. division 15 uses PST). Loaded in LoadAccountingOptions(); these
    // are only the no-option-set defaults (VB6 empty-Variant → False for both).
    private bool ShowGSTRate = false;
    private bool ShowPSTRate = false;

    // === Grid Layout (from IniGetGrid) ===
    // Load/resolve/order/width boilerplate lives in the shared GridLayoutPresenter;
    // the VB6 form/grid name strings (FormName/GridName) stay here for fidelity.
    private readonly GridLayoutPresenter<CommunityRow> _grid =
        new(FormName, GridName, grouped: false);
    private Dictionary<string, GridLayoutColumn> GridLayout => _grid.Layout;
    private int GridLayoutVersion => _grid.Version;
    private bool HasGridLayout => _grid.Has;

    // VB6 gData_BeforeEdit: Case "PreconScheduleTemplate":
    //   .ComboList = HFApp.Options.ValueByName("ScheduleTemplates")
    // The PreCon Template cell is an in-cell dropdown whose choices come from the
    // pipe-separated 'ScheduleTemplates' AppOption (e.g. "DJSSHELL|SLAB"), exactly
    // like FOptions reads it. Loaded once in OnInitializedAsync; a leading blank
    // entry lets the user clear the value.
    private List<string> ScheduleTemplateOptions = new();

    // VB6 gData_BeforeEdit / sub_ShowPickList Case "ABN_D02Function":
    //   SELECT Value, Description, value id FROM D365FinancialDimensionValues
    //   WHERE Dimension='D02_Function' ORDER BY 1   (stores Value, hidecol id)
    // The D365-ABN financial-dimension (D02_Function) in-cell dropdown. Loaded
    // once in OnInitializedAsync; a leading blank entry lets the user clear it.
    // The whole column is hidden unless the accounting system is asD365_ABN.
    private List<string> D365FunctionOptions = new();

    private List<CommunityRow> CommunitiesData = new();
    private CommunityRow? SelectedCommunity;

    private bool CommentsDialogVisible = false;
    private string EditingComments = "";
    private CommunityRow? EditingRow;
    private List<DivisionItem> AvailableDivisions = new();
    private List<string> SelectedDivisionCodes = new();
    private List<PickerItem> PickerItems = new();
    private bool ConfirmDialogVisible = false;
    private string ConfirmMessage = "";
    private bool ShowCancelButton = false;
    private bool AccountingDialogVisible = false;
    // HHM-500: modal MsgBox equivalent for the blank-community validation.
    private Fx.ControlKit.Dialogs.MessageBoxControl? _messageBox;

    private TaskCompletionSource<bool?>? ConfirmTcs;
    // Defaults match VB6's "no option set" behavior (asNone, no Tarion); the real
    // values are loaded from appoptions in LoadAccountingOptions().
    private bool IsIntacctSystem { get; set; } = false;
    // VB6 frmload: If HFApp.Options(AccountingSystem) <> asD365_ABN Then
    //   gData.ColHidden(gData.ColIndex("ABN_D02Function")) = True
    // The ABN_D02Function column is shown ONLY when the accounting system is
    // asD365_ABN (=11). Set in LoadAccountingOptions from the same appoption read.
    private bool IsD365ABN { get; set; } = false;
    // HHM-515: VB6 only opens the GL-prefix picker for Timberline (asTimberline=1);
    // under the default asNone config the prefix ellipsis is a no-op.
    private bool IsTimberline { get; set; } = false;
    private bool ShowTarionFields { get; set; } = false;
    private string IntacctCompanyID { get; set; } = "";
