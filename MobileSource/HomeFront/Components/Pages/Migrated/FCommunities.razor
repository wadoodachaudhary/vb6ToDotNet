    // VB6 gData_KeyDown / Toolbar "DELETE" (FCommunities.frm 747-761, 790-791): the
    // toolbar Delete just calls gData_KeyDown(vbKeyDelete, vbCtrlMask). Both routes
    // run sp_CanDeleteCommunity, block if it returns false, else mark the row for
    // delete + hide it. OnDeleteClick is the shared handler for the toolbar button;
    // OnGridKeyDown forwards Ctrl+Delete here so the two paths stay identical.
    private async Task OnDeleteClick()
    {
        await DeleteCurrentRow(SelectedCommunity);
    }

    // VB6 gData_KeyDown (FCommunities.frm 747-761): the delete logic, factored out so
    // both the toolbar button and the Ctrl+Delete keystroke share one code path.
    private async Task DeleteCurrentRow(CommunityRow? row)
    {
        if (row == null) return;

        // Unsaved rows have no database identity yet, so delete them locally
        // instead of running sp_CanDeleteCommunity with a blank Area value.
        if (string.IsNullOrEmpty(row.OriginalArea))
        {
            CommunitiesData.Remove(row);
            if (ReferenceEquals(SelectedCommunity, row))
                SelectedCommunity = CommunitiesData.FirstOrDefault(r => !r.IsDeleted);
            mDirty = CommunitiesData.Any(r => r.IsDirty || r.IsDeleted);
            if (gData != null)
                await gData.Refresh();
            StateHasChanged();
            return;
        }

        // VB6: rs = SqlExec("select dbo.sp_CanDeleteCommunity(@Area)"); If ""&rs(0)="False".
        // sp_CanDeleteCommunity is a scalar function returning a SQL bit, so read it as
        // a bool — the old ExecuteScalar<string> + (== "False") relied on Boolean.ToString()
        // formatting and would silently let a non-deletable community through if the
        // wrapper ever yielded "0"/"1" or a non-bit value instead.
        var canDelete = await db.ExecuteScalarAsync<bool>(
            "SELECT dbo.sp_CanDeleteCommunity(@Area)",
            new { Area = row.Area });
        if (!canDelete)
        {
            Notifications.Error("You cannot delete a community that has customers, jobs or assemblies associated with it.");
            return;
        }
        // VB6: mDirty = True : RowData = "DELETE" : RowHidden(Row) = True. The row stays
        // in CommunitiesData (so Save can issue sp_DeleteCommunity) but is hidden from
        // the grid immediately via the .row-hidden CSS class (GetCommunityRowCssClass).
        row.IsDeleted = true;
        row.IsDirty = true;
        mDirty = true;
        StateHasChanged();
    }

    // VB6 Form_KeyDown (FCommunities.frm 327-332) + gData_KeyDown (747-761): the form
    // has KeyPreview=-1, so Ctrl+S saves (no prompt) and Ctrl+Delete deletes the current
    // grid row. The GridControl exposes no consumer keydown event, so we catch these on
    // the wrapper div — the grid's keydown bubbles up. Pure Blazor @onkeydown, no JS.
    private async Task OnGridKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        // VB6 gData_KeyDown: Ctrl+Delete on the current row (Row > 1, i.e. a data row).
        if (e.CtrlKey && (e.Key == "Delete" || e.Code == "Delete"))
        {
            await DeleteCurrentRow(SelectedCommunity);
            return;
        }
        // VB6 Form_KeyDown: Ctrl+S => SaveData(False) (save without the changed-data prompt).
        if (e.CtrlKey && (e.Key == "s" || e.Key == "S"))
        {
            await SaveData(false);
        }
    }

