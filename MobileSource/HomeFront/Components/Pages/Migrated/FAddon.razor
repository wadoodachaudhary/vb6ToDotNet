```razor
@using HomeFront.Components.Hf

<HfDialog Visible="@Visible"
          Header="Addon"
          Width="480px"
          IsModal="true"
          ShowCloseIcon="true"
          OnClose="Cancel">
    <ChildContent>
        <div class="faddon">
            <div class="form-row">
                <label class="field-label">Title</label>
                <HfTextBox @bind-Value="Title" CssClass="field-input" />
            </div>

            <div class="form-row">
                <label class="field-label">Cost Basis</label>
                <div class="basis-group">
                    <button type="button" class="@BasisButtonClass(BasisType.LumpSum)" @onclick="() => SetBasis(BasisType.LumpSum)">Lump Sum</button>
                    <button type="button" class="@BasisButtonClass(BasisType.Cost)" @onclick="() => SetBasis(BasisType.Cost)">Cost</button>
                    <button type="button" class="@BasisButtonClass(BasisType.PreviousSubTotal)" @onclick="() => SetBasis(BasisType.PreviousSubTotal)">Previous SubTotal</button>
                    <button type="button" class="@BasisButtonClass(BasisType.RunningTotal)" @onclick="() => SetBasis(BasisType.RunningTotal)">Running Total</button>
                </div>
            </div>

            @if (ShowRates)
            {
                <div class="frame">
                    <div class="frame-title">Amount</div>
                    <div class="rate-types">
                        <label><input type="radio" name="rateType" checked="@(RateType == RateTypeEnum.Markup)" @onchange="() => SetRateType(RateTypeEnum.Markup)" /> Mark-up</label>
                        <label><input type="radio" name="rateType" checked="@(RateType == RateTypeEnum.Margin)" @onchange="() => SetRateType(RateTypeEnum.Margin)" /> Margin</label>
                        <label><input type="radio" name="rateType" checked="@(RateType == RateTypeEnum.AmountPer)" @onchange="() => SetRateType(RateTypeEnum.AmountPer)" /> Amount Per</label>
                    </div>

                    <div class="rate-inputs">
                        <div class="rate-row">
                            <span class="rate-label">Percentage</span>
                            <div class="inline-input">
                                <HfNumericTextBox TValue="decimal"
                                                  @bind-Value="Percentage"
                                                  Format="N2"
                                                  Width="90px"
                                                  Enabled="@EnablePercentage"
                                                  ValueChange="OnPercentageChanged" />
                                <span class="suffix">%</span>
                            </div>
                        </div>

                        <div class="rate-row">
                            <span class="rate-label">Amount Per</span>
                            <div class="inline-input">
                                <HfNumericTextBox TValue="decimal"
                                                  @bind-Value="Rate1"
                                                  Format="N2"
                                                  Width="90px"
                                                  Enabled="@EnableAmountPer"
                                                  ValueChange="OnRateChanged" />
                                <span class="slash">/</span>
                                <HfNumericTextBox TValue="decimal"
                                                  @bind-Value="Rate2"
                                                  Format="N2"
                                                  Width="90px"
                                                  Enabled="@EnableAmountPer"
                                                  ValueChange="OnRateChanged" />
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (ShowLumpSum)
            {
                <div class="frame">
                    <div class="frame-title">Amount</div>
                    <HfNumericTextBox TValue="decimal" @bind-Value="LumpSumAmt" Format="N2" Width="140px" />
                </div>
            }

            @if (ShowCategories)
            {
                <div class="frame">
                    <div class="frame-title">Categories</div>
                    <div class="categories">
                        <HfCheckBox @bind-Checked="CostMaterial" Label="Material" />
                        <HfCheckBox @bind-Checked="CostEquipment" Label="Equipment" />
                        <HfCheckBox @bind-Checked="CostSubcontract" Label="Subcontract" />
                        <HfCheckBox @bind-Checked="CostLabour" Label="Labour" />
                        <HfCheckBox @bind-Checked="CostOther" Label="Other" />
                    </div>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <HfButton CssClass="hf-dialog-btn" OnClick="HandleOk">OK</HfButton>
        <HfButton CssClass="hf-dialog-btn" OnClick="Cancel">Cancel</HfButton>
    </FooterContent>
</HfDialog>

