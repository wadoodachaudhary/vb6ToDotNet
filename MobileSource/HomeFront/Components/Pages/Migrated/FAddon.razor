@code {
    private static BasisType DefaultBasis = BasisType.LumpSum;
    private bool _wasVisible;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public AddonRow? Model { get; set; }
    [Parameter] public IList<AddonRow>? DataSource { get; set; }
    [Parameter] public int EditIndex { get; set; } = -1;
    [Parameter] public bool IsCreate { get; set; } = true;
    [Parameter] public EventCallback<AddonRow> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string Title = "";
    private BasisType Basis = BasisType.LumpSum;
    private RateTypeEnum RateType = RateTypeEnum.Margin;
    private decimal Percentage = 25;
    private decimal Rate1;
    private decimal Rate2;
    private decimal LumpSumAmt;

    private bool CostMaterial;
    private bool CostEquipment;
    private bool CostSubcontract;
    private bool CostLabour;
    private bool CostOther;

    private bool ShowCategories => Basis == BasisType.Cost;
    private bool ShowLumpSum => Basis == BasisType.LumpSum;
    private bool ShowRates => !ShowLumpSum;

    private bool EnablePercentage => RateType == RateTypeEnum.Markup;
    private bool EnableAmountPer => RateType == RateTypeEnum.AmountPer;

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            LoadFromModel();
        }

        _wasVisible = Visible;
    }

    private void LoadFromModel()
    {
        if (IsCreate || Model == null)
        {
            Title = "";
            Basis = DefaultBasis;
            RateType = RateTypeEnum.Margin;
            Percentage = 25;
            Rate1 = 0;
            Rate2 = 0;
            LumpSumAmt = 0;
            CostMaterial = CostEquipment = CostSubcontract = CostLabour = CostOther = false;
        }
        else
        {
            Title = Model.Title;
            Basis = BasisFromString(Model.Basis);
            RateType = (RateTypeEnum)Math.Clamp(Model.RateType, 0, 3);
            Percentage = Model.Percentage;
            Rate1 = Model.Rate1;
            Rate2 = Model.Rate2;
            LumpSumAmt = Model.LumpSumAmt;
            CostMaterial = Model.Mat;
            CostEquipment = Model.Eq;
            CostSubcontract = Model.Sub;
            CostLabour = Model.Lab;
            CostOther = Model.Oth;
        }

        if (Basis == BasisType.LumpSum)
            RateType = RateTypeEnum.Lump;
        else if (RateType == RateTypeEnum.Lump)
            RateType = RateTypeEnum.Markup;
    }

    private async Task HandleOk()
    {
        var row = Model ?? new AddonRow();
        row.Title = Title;
        row.Basis = BasisToString(Basis);
        row.RateType = Basis == BasisType.LumpSum ? (int)RateTypeEnum.Lump : (int)RateType;
        row.Percentage = Percentage;
        row.Rate1 = Rate1;
        row.Rate2 = Rate2;
        row.LumpSumAmt = LumpSumAmt;
        row.Mat = CostMaterial;
        row.Eq = CostEquipment;
        row.Sub = CostSubcontract;
        row.Lab = CostLabour;
        row.Oth = CostOther;

        if (DataSource != null)
        {
            if (IsCreate || EditIndex < 0 || EditIndex >= DataSource.Count)
                DataSource.Add(row);
            else
                DataSource[EditIndex] = row;
        }

        if (OnSave.HasDelegate)
            await OnSave.InvokeAsync(row);

        DefaultBasis = Basis;
        await CloseDialog();
    }

    private async Task Cancel()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();

        DefaultBasis = Basis;
        await CloseDialog();
    }

    private async Task CloseDialog()
    {
        if (VisibleChanged.HasDelegate)
            await VisibleChanged.InvokeAsync(false);
    }

    private void SetBasis(BasisType basis)
    {
        Basis = basis;
        if (Basis == BasisType.LumpSum)
            RateType = RateTypeEnum.Lump;
        else if (RateType == RateTypeEnum.Lump)
            RateType = RateTypeEnum.Markup;
    }

    private void SetRateType(RateTypeEnum rateType)
    {
        RateType = rateType;
    }

    private Task OnPercentageChanged(HfNumericTextBox<decimal>.NumericChangeEventArgs<decimal> args)
    {
        Percentage = args.Value is decimal v ? v : 0;
        if (RateType != RateTypeEnum.Markup)
            RateType = RateTypeEnum.Markup;
        return Task.CompletedTask;
    }

    private Task OnRateChanged(HfNumericTextBox<decimal>.NumericChangeEventArgs<decimal> args)
    {
        if (RateType != RateTypeEnum.AmountPer)
            RateType = RateTypeEnum.AmountPer;
        return Task.CompletedTask;
    }

    private string BasisButtonClass(BasisType basis) => basis == Basis ? "active" : "";

    private static BasisType BasisFromString(string basis) => basis switch
    {
        "LumpSum" => BasisType.LumpSum,
        "Category" => BasisType.Cost,
        "LastSubTotal" => BasisType.PreviousSubTotal,
        "RunningTotal" => BasisType.RunningTotal,
        _ => DefaultBasis
    };

    private static string BasisToString(BasisType basis) => basis switch
    {
        BasisType.LumpSum => "LumpSum",
        BasisType.Cost => "Category",
        BasisType.PreviousSubTotal => "LastSubTotal",
        BasisType.RunningTotal => "RunningTotal",
        _ => "LumpSum"
    };

    public class AddonRow
    {
        public string Title { get; set; } = "";
        public string Basis { get; set; } = "LumpSum";
        public int RateType { get; set; } = 2;
        public decimal Percentage { get; set; }
        public decimal Rate1 { get; set; }
        public decimal Rate2 { get; set; }
        public decimal LumpSumAmt { get; set; }
        public bool Mat { get; set; }
        public bool Eq { get; set; }
        public bool Sub { get; set; }
        public bool Lab { get; set; }
        public bool Oth { get; set; }
    }

    public enum BasisType
    {
        Cost = 0,
        PreviousSubTotal = 1,
        RunningTotal = 2,
        LumpSum = 3
    }

    public enum RateTypeEnum
    {
        Markup = 0,
        AmountPer = 1,
        Lump = 2,
        Margin = 3
    }
}
