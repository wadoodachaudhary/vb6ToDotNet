@using HomeFront.Components.Pages.Migrated
@code {
    private const string SRCFILE = "MBuildPro::";

    public void SendBuildProPOIndexes()
    {
        Application.HFApp?.RunTask("SendBuildProPOIndexes");
    }

    public void SendBuildProVendors()
    {
        Application.HFApp?.RunTask("SendBuildProVendors");
    }

    public void SendBuildProRemittances()
    {
        Application.HFApp?.RunTask("SendBuildProRemittances");
    }

    public void SendBuildProCommunities()
    {
        Application.HFApp?.RunTask("SendBuildProCommunities");
    }

    public void SendBuildProJobs(string job)
    {
        Application.HFApp?.RunTask($"SendBuildProJobs|{job}");
    }

    public void CancelBuildProPO(string job, string poNumber)
    {
        Application.HFApp?.RunTask($"CancelBuildProPO|{job}|{poNumber}");
    }

    public void SendBuildProPOs(string job, string pos)
    {
        Application.HFApp?.RunTask($"SendBuildProPOs|{job}|{pos}");
    }
}
