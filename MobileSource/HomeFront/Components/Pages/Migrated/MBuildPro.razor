@using HomeFront.Services
@inject ITaskService TaskSvc
@code {
    private const string SRCFILE = "MBuildPro::";

    public void SendBuildProPOIndexes()
    {
        TaskSvc.RunTask("SendBuildProPOIndexes");
    }

    public void SendBuildProVendors()
    {
        TaskSvc.RunTask("SendBuildProVendors");
    }

    public void SendBuildProRemittances()
    {
        TaskSvc.RunTask("SendBuildProRemittances");
    }

    public void SendBuildProCommunities()
    {
        TaskSvc.RunTask("SendBuildProCommunities");
    }

    public void SendBuildProJobs(string job)
    {
        TaskSvc.RunTask($"SendBuildProJobs|{job}");
    }

    public void CancelBuildProPO(string job, string poNumber)
    {
        TaskSvc.RunTask($"CancelBuildProPO|{job}|{poNumber}");
    }

    public void SendBuildProPOs(string job, string pos)
    {
        TaskSvc.RunTask($"SendBuildProPOs|{job}|{pos}");
    }
}
