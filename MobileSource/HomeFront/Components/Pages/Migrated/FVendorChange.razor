@page "/vendor-change"
@rendermode InteractiveServer

@using System.Text
@using System.Linq
@using HomeFront.Components.Grid
@using HomeFront.Components.Hf
@using HomeFront.Data
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Work Reassignment Wizard - HomeFront</PageTitle>

<style>
    .wizard-container {
        max-width: 980px;
        margin: 20px auto;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #fff;
        display: flex;
        flex-direction: column;
        min-height: 600px;
    }

    .wizard-header {
        padding: 16px 20px;
        border-bottom: 1px solid #dee2e6;
        background: #f8f9fa;
    }

    .wizard-title {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .wizard-desc {
        font-size: 13px;
        color: #6c757d;
    }

    .wizard-body {
        flex: 1;
        padding: 20px;
    }

    .wizard-footer {
        border-top: 1px solid #dee2e6;
        padding: 10px 16px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        background: #f8f9fa;
    }

    .step-title {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .step-desc {
        font-size: 13px;
        color: #6c757d;
        margin-bottom: 12px;
    }

    .form-field {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 12px;
    }

    .form-field label {
        min-width: 90px;
        text-align: right;
        font-weight: 600;
        padding-top: 6px;
        font-size: 13px;
    }

    .vendor-picker {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .vendor-picker textarea {
        width: 100%;
        min-height: 120px;
        resize: vertical;
        padding: 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 13px;
        background: #f8f9fa;
    }

    .checkbox-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-left: 10px;
        font-size: 13px;
    }

    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .step-note {
        color: #6c757d;
        font-size: 13px;
        margin-top: 10px;
    }

    .dirty-indicator {
        color: #dc3545;
        font-weight: 700;
        text-align: center;
        display: block;
    }

    .loading-panel {
        padding: 16px;
        text-align: center;
        color: #6c757d;
    }

    .picker-table {
        max-height: 400px;
        overflow: auto;
        border: 1px solid #dee2e6;
        border-radius: 4px;
    }

    .picker-table table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .picker-table th, .picker-table td {
        padding: 6px 10px;
        border-bottom: 1px solid #eee;
    }

    .picker-table th {
        background: #f8f9fa;
        text-align: left;
        font-weight: 600;
    }

    .grid-note {
        margin-top: 8px;
        font-size: 12px;
        color: #6c757d;
    }
</style>

<div class="wizard-container">
    <div class="wizard-header">
        <div class="wizard-title">Change Vendors</div>
        <div class="wizard-desc">The work reassignment wizard will help you to quickly reassign incomplete work.</div>
    </div>

    <div class="wizard-body">
        @if (currentStep == 0)
        {
            <div class="step-title">Choose Vendor</div>
            <div class="step-desc">Choose one or more vendors who have work that needs to be reassigned.</div>

            <div class="form-field">
                <label>Vendor(s)</label>
                <div class="vendor-picker">
                    <textarea readonly>@SelectedVendorNames</textarea>
                    <button class="btn btn-outline-primary btn-sm" @onclick="OpenVendorPicker">Choose...</button>
                </div>
            </div>

            <div class="step-note">Click Next to continue.</div>
        }
        else if (currentStep == 1)
        {
            <div class="step-title">Work Filter</div>
            <div class="step-desc">How do you want to view the incomplete work?</div>

            <div class="checkbox-list">
                <div class="checkbox-row">
                    <input type="checkbox" checked disabled />
                    <span>Vendor</span>
                </div>
                <div class="checkbox-row">
                    <input type="checkbox" checked disabled />
                    <span>Job</span>
                </div>
                <div class="checkbox-row">
                    <input type="checkbox" @bind="GroupByPOIndex" />
                    <span>PO Index</span>
                </div>
                <div class="checkbox-row">
                    <input type="checkbox" @bind="GroupByCostCode" />
                    <span>Cost Code</span>
                </div>
                <div class="checkbox-row">
                    <input type="checkbox" @bind="GroupByCategory" />
                    <span>Category</span>
                </div>
            </div>
        }
        else
        {
            <div class="step-title">Reassign Work</div>
            <div class="step-desc">
                Change the assigned vendor. You can sort the rows and select and update multiple PO's at a time.
            </div>

            @if (IsLoadingWork)
            {
                <div class="loading-panel">Loading work items...</div>
            }
            else
            {
                <HfGrid @ref="WorkGrid"
                        TValue="ReassignRow"
                        DataSource="@WorkData"
                        AllowSorting="true"
                        AllowResizing="true"
                        AllowSelection="true"
                        Height="360px">
                    <HfGridColumnsBase>
                        <HfGridColumn Field="@nameof(ReassignRow.Dirty)" HeaderText="*" Width="40px">
                            <Template>
                                @{
                                    var row = (ReassignRow)context;
                                    <span class="dirty-indicator">@((row.Dirty) ? "●" : "")</span>
                                }
                            </Template>
                        </HfGridColumn>
                        <HfGridColumn Field="@nameof(ReassignRow.CompanyName)" HeaderText="Vendor" Width="260px">
                            <Template>
                                @{
                                    var row = (ReassignRow)context;
                                    <select class="form-select form-select-sm" value="@row.Vendor" @onchange="(e) => OnVendorChanged(row, e)">
                                        @if (!VendorOptions.Any(v => v.Vendor == row.Vendor))
                                        {
                                            <option value="@row.Vendor">@row.CompanyName</option>
                                        }
                                        @foreach (var v in VendorOptions)
                                        {
                                            <option value="@v.Vendor">@v.CompanyName</option>
                                        }
                                    </select>
                                }
                            </Template>
                        </HfGridColumn>
                        <HfGridColumn Field="@nameof(ReassignRow.Community)" HeaderText="Community" Width="110px" />
                        <HfGridColumn Field="@nameof(ReassignRow.CommunityDesc)" HeaderText="Community Desc" Width="200px" />
                        <HfGridColumn Field="@nameof(ReassignRow.Job)" HeaderText="Job" Width="90px" />
                        <HfGridColumn Field="@nameof(ReassignRow.JobDesc)" HeaderText="Job Desc" Width="200px" />
                        <HfGridColumn Field="@nameof(ReassignRow.POIndex)" HeaderText="PO Index" Width="90px" Visible="@GroupByPOIndex" />
                        <HfGridColumn Field="@nameof(ReassignRow.CostCode)" HeaderText="Cost Code" Width="90px" Visible="@GroupByCostCode" />
                        <HfGridColumn Field="@nameof(ReassignRow.CostCodeDesc)" HeaderText="Cost Code Desc" Width="180px" Visible="@GroupByCostCode" />
                        <HfGridColumn Field="@nameof(ReassignRow.Category)" HeaderText="Category" Width="90px" Visible="@GroupByCategory" />
                        <HfGridColumn Field="@nameof(ReassignRow.CategoryDesc)" HeaderText="Category Desc" Width="180px" Visible="@GroupByCategory" />
                    </HfGridColumnsBase>
                </HfGrid>

                <div class="grid-note">Rows marked with ● have pending changes.</div>
            }
        }
    </div>

    <div class="wizard-footer">
        <button class="btn btn-outline-secondary" @onclick="OnCancel">Cancel</button>
        <button class="btn btn-secondary" @onclick="OnBack" disabled="@(!CanBack)">Back</button>
        <button class="btn btn-primary" @onclick="OnNext" disabled="@(!CanNext)">Next</button>
        <button class="btn btn-success" @onclick="OnCommit" disabled="@(!CanCommit || IsSaving)">Commit</button>
    </div>
</div>

<HfDialog @bind-Visible="ShowVendorPicker" Width="650px" Header="Select Vendors"
          IsModal="true" ShowCloseIcon="true" CloseOnEscape="true">
    <ChildContent>
        <div class="picker-table">
            <table>
                <thead>
                    <tr>
                        <th style="width:40px;"></th>
                        <th>Vendor Name</th>
                        <th style="width:120px;">Vendor ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in VendorPickList)
                    {
                        <tr>
                            <td><input type="checkbox" @bind="v.Selected" /></td>
                            <td>@v.CompanyName</td>
                            <td>@v.Vendor</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-primary" @onclick="OnVendorPickerOk">OK</button>
        <button class="btn btn-secondary" @onclick="() => ShowVendorPicker = false">Cancel</button>
    </FooterContent>
</HfDialog>

@code {
    private readonly DbWrapperSqlServer db = new();
    private HfGrid<ReassignRow>? WorkGrid;

    private const int DivisionId = 1;
    private const int MaxStep = 2;

    private int currentStep = 0;
    private bool GroupByPOIndex = false;
    private bool GroupByCostCode = false;
    private bool GroupByCategory = false;

    private bool ShowVendorPicker = false;
    private bool IsLoadingWork = false;
    private bool IsSaving = false;

    private List<VendorPickItem> VendorPickList = new();
    private List<VendorOption> VendorOptions = new();
    private List<ReassignRow> WorkData = new();

    private bool ZeroRateOnRefreshCosts = false;

    private bool CanBack => currentStep > 0;
    private bool CanNext => currentStep < MaxStep && (currentStep != 0 || SelectedVendorIds.Count > 0);
    private bool CanCommit => currentStep == MaxStep;

    private List<string> SelectedVendorIds =>
        VendorPickList.Where(v => v.Selected).Select(v => v.Vendor).ToList();

    private string SelectedVendorNames =>
        string.Join(Environment.NewLine, VendorPickList.Where(v => v.Selected).Select(v => v.CompanyName));

    protected override async Task OnInitializedAsync()
    {
        await LoadVendorOptionsAsync();
    }

    private async Task OpenVendorPicker()
    {
        await LoadVendorPickListAsync();
        ShowVendorPicker = true;
    }

    private void OnVendorPickerOk()
    {
        ShowVendorPicker = false;
    }

    private async Task OnBack() => await SetCurrentStep(currentStep - 1);

    private async Task OnNext()
    {
        if (currentStep == 0 && SelectedVendorIds.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Select at least one vendor.");
            return;
        }
        await SetCurrentStep(currentStep + 1);
    }

    private void OnCancel() => NavigationManager.NavigateTo("/");

    private async Task OnCommit()
    {
        if (IsSaving) return;
        await SaveDataAsync();
    }

    private async Task SetCurrentStep(int step)
    {
        currentStep = Math.Clamp(step, 0, MaxStep);
        if (currentStep == 2)
            await LoadWorkDataAsync();
        StateHasChanged();
    }

    private async Task LoadVendorPickListAsync()
    {
        var previous = VendorPickList.Where(v => v.Selected).Select(v => v.Vendor).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var sql = @"
            select distinct v.vendor_name CompanyName, v.vendor_id Vendor
            from estimateitems e join tblvendors v
                on (e.DivisionID = v.DivisionID and e.budgetvendor=v.vendor_id)
            where budgetgenerated=0 and v.DivisionID = @DivisionID
            union
            select distinct v.vendor_name CompanyName, v.vendor_id Vendor
            from estimateitems e join tblvendors v
                on (v.DivisionID = e.DivisionID and e.povendor=v.vendor_id)
            where pogenbatch=0 and v.DivisionID = @DivisionID
            order by CompanyName";
        var rows = await db.QueryAsync(sql, new { DivisionID = DivisionId });
        VendorPickList = rows.Select(r =>
        {
            var vendor = r["Vendor"]?.ToString() ?? "";
            return new VendorPickItem
            {
                Vendor = vendor,
                CompanyName = r["CompanyName"]?.ToString() ?? "",
                Selected = previous.Contains(vendor)
            };
        }).ToList();
    }

    private async Task LoadVendorOptionsAsync()
    {
        var sql = @"select vendor_id Vendor, vendor_name CompanyName
                    from tblvendors
                    where isnull(inactive,0)=0 and DivisionID=@DivisionID
                    order by vendor_name";
        var rows = await db.QueryAsync(sql, new { DivisionID = DivisionId });
        VendorOptions = rows.Select(r => new VendorOption
        {
            Vendor = r["Vendor"]?.ToString() ?? "",
            CompanyName = r["CompanyName"]?.ToString() ?? ""
        }).ToList();
    }

    private async Task LoadWorkDataAsync()
    {
        if (SelectedVendorIds.Count == 0)
        {
            WorkData = new List<ReassignRow>();
            return;
        }

        IsLoadingWork = true;
        StateHasChanged();
        try
        {
            var sql = BuildWorkQuery();
            var rows = await db.QueryAsync(sql);
            WorkData = rows.Select(MapRow).ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading work: {ex.Message}");
        }
        finally
        {
            IsLoadingWork = false;
            StateHasChanged();
        }
    }

    private string BuildWorkQuery()
    {
        var vendorList = string.Join(", ", SelectedVendorIds.Select(Quote));
        var cols1 = new List<string>
        {
            "budgetvendor CurrentVendor",
            "budgetvendor Vendor",
            "budgetvendorname CompanyName",
            "Community",
            "CommunityDesc",
            "Job_No Job",
            "JobDesc"
        };
        var cols2 = new List<string>
        {
            "povendor CurrentVendor",
            "povendor Vendor",
            "povendorname CompanyName",
            "Community",
            "CommunityDesc",
            "Job_No Job",
            "JobDesc"
        };

        if (GroupByPOIndex)
        {
            cols1.Add("POIndex");
            cols2.Add("POIndex");
        }
        if (GroupByCostCode)
        {
            cols1.Add("JCCostCode CostCode");
            cols1.Add("JCCostCodeDesc CostCodeDesc");
            cols2.Add("JCCostCode CostCode");
            cols2.Add("JCCostCodeDesc CostCodeDesc");
        }
        if (GroupByCategory)
        {
            cols1.Add("JCCategory Category");
            cols1.Add("JCCategoryDesc CategoryDesc");
            cols2.Add("JCCategory Category");
            cols2.Add("JCCategoryDesc CategoryDesc");
        }

        var sb = new StringBuilder();
        sb.AppendLine("select distinct " + string.Join(", ", cols1));
        sb.AppendLine("from estimateditems");
        sb.AppendLine($"where budgetgenerated=0 and DivisionID = {DivisionId} and budgetvendor in({vendorList})");
        sb.AppendLine("union");
        sb.AppendLine("select distinct " + string.Join(", ", cols2));
        sb.AppendLine("from estimateditems");
        sb.AppendLine($"where pogenbatch=0 and DivisionID = {DivisionId} and povendor in({vendorList})");
        sb.AppendLine("order by 1,2,3,4,5,6");
        return sb.ToString();
    }

    private ReassignRow MapRow(Dictionary<string, object> row)
    {
        string Get(string key) =>
            row.ContainsKey(key) && row[key] != null && row[key] != DBNull.Value
                ? row[key].ToString() ?? ""
                : "";
        return new ReassignRow
        {
            CurrentVendor = Get("CurrentVendor"),
            Vendor = Get("Vendor"),
            CompanyName = Get("CompanyName"),
            Community = Get("Community"),
            CommunityDesc = Get("CommunityDesc"),
            Job = Get("Job"),
            JobDesc = Get("JobDesc"),
            POIndex = Get("POIndex"),
            CostCode = Get("CostCode"),
            CostCodeDesc = Get("CostCodeDesc"),
            Category = Get("Category"),
            CategoryDesc = Get("CategoryDesc"),
            Dirty = false
        };
    }

    private void OnVendorChanged(ReassignRow row, ChangeEventArgs e)
    {
        var newVendor = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(newVendor)) return;
        if (row.Vendor != newVendor)
        {
            row.Vendor = newVendor;
            row.CompanyName = VendorOptions.FirstOrDefault(v => v.Vendor == newVendor)?.CompanyName ?? row.CompanyName;
            row.Dirty = true;
        }
    }

    private async Task SaveDataAsync()
    {
        var dirtyRows = WorkData.Where(r => r.Dirty).ToList();
        if (!dirtyRows.Any())
        {
            await JSRuntime.InvokeVoidAsync("alert", "No changes to commit.");
            return;
        }

        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Commit changes for {dirtyRows.Count} row(s)?"))
            return;

        IsSaving = true;
        StateHasChanged();
        try
        {
            foreach (var row in dirtyRows)
            {
                await UpdateBudgetItemsAsync(row);
                await UpdatePOItemsAsync(row);
                row.Dirty = false;
                row.CurrentVendor = row.Vendor;
            }
            await LoadWorkDataAsync();
            await JSRuntime.InvokeVoidAsync("alert", "Changes committed.");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving data: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }

    private async Task UpdateBudgetItemsAsync(ReassignRow row)
    {
        var ids = await GetItemIdsAsync(row, true);
        if (ids.Count == 0) return;

        var idList = string.Join(",", ids);
        var zeroRate = ZeroRateOnRefreshCosts ? "True" : "False";

        var sql = $@"
UPDATE EstimateItems
   SET budgetvendor={Quote(row.Vendor)}
      ,BudgetOverridden=0
      ,BudgetRate= case when ISNULL(dbo.Purch_GetItemRate(0,0,v.Community,v.CommunityPhase,v.Assembly,
                            case when v.assemblytype=0 or v.assemblytype=2 then v.model else '' end,'',
                            v.EstPhase,v.EstItem,0,{Quote(row.Vendor)},getdate(),{DivisionId}),0) <>0
                        then ISNULL(dbo.Purch_GetItemRate(0,0,v.Community,v.CommunityPhase,v.Assembly,
                            case when v.assemblytype=0 or v.assemblytype=2 then v.model else '' end,'',
                            v.EstPhase,v.EstItem,0,{Quote(row.Vendor)},getdate(),{DivisionId}),0)
                        when 'True'={Quote(zeroRate)} and i.BudgetOverridden=0 then 0
                        else i.BudgetRate end
  FROM EstimateItems i JOIN EstimatedItems v ON(i.EstItemID=v.EstItemID)
 WHERE i.BudgetDeleted=0
   AND i.BudgetGenerated=0
   AND i.estitemid in({idList})
   AND i.DivisionID = {DivisionId}";
        await db.ExecuteAsync(sql);

        var sql2 = $@"
UPDATE EstimateItems
   SET BudgetPretax = i.BudgetRate * i.BudgetQty
      ,BudgetJCTax = i.BudgetRate * i.BudgetQty * i.BudgetJCTaxRate/100
      ,BudgetNJCTax = i.BudgetRate * i.BudgetQty * i.BudgetNJCTaxRate/100
  FROM EstimateItems i JOIN EstimatedItems v ON(i.EstItemID=v.EstItemID)
 WHERE v.BudgetDeleted=0
   AND v.BudgetGenerated=0
   AND i.DivisionID = {DivisionId}
   AND i.estitemid in({idList})";
        await db.ExecuteAsync(sql2);
    }

    private async Task UpdatePOItemsAsync(ReassignRow row)
    {
        var ids = await GetItemIdsAsync(row, false);
        if (ids.Count == 0) return;

        var idList = string.Join(",", ids);
        var zeroRate = ZeroRateOnRefreshCosts ? "True" : "False";

        var sql = $@"
UPDATE EstimateItems
   set povendor={Quote(row.Vendor)}
      ,POOverridden=0
      ,PORate= case when ISNULL(dbo.Purch_GetItemRate(0,0,v.Community,v.CommunityPhase,v.Assembly,
                        case when v.assemblytype=0 or v.assemblytype=2 then v.model else '' end,'',
                        v.EstPhase,v.EstItem,0,{Quote(row.Vendor)},getdate(),{DivisionId}),0) <>0
                    then ISNULL(dbo.Purch_GetItemRate(0,0,v.Community,v.CommunityPhase,v.Assembly,
                        case when v.assemblytype=0 or v.assemblytype=2 then v.model else '' end,'',
                        v.EstPhase,v.EstItem,0,{Quote(row.Vendor)},getdate(),{DivisionId}),0)
                    when 'True'={Quote(zeroRate)} and i.POOverridden=0 then 0
                    else i.PORate end
  FROM EstimateItems i JOIN EstimatedItems v ON(i.EstItemID=v.EstItemID)
 WHERE i.PODeleted=0
   AND i.POGenBatch=0
   AND i.DivisionID = {DivisionId}
   AND i.estitemid in({idList})";
        await db.ExecuteAsync(sql);

        var sql2 = $@"
UPDATE EstimateItems
   SET POPretax = i.PORate * i.POQty
      ,POJCTax = i.PORate * i.POQty * i.POJCTaxRate/100
      ,PONJCTax = i.PORate * i.POQty * i.PONJCTaxRate/100
  FROM EstimateItems i JOIN EstimatedItems v ON(i.EstItemID=v.EstItemID)
 WHERE i.PODeleted=0
   AND i.POGenBatch=0
   AND i.DivisionID = {DivisionId}
   AND i.estitemid in({idList})";
        await db.ExecuteAsync(sql2);
    }

    private async Task<List<long>> GetItemIdsAsync(ReassignRow row, bool budget)
    {
        var sb = new StringBuilder();
        sb.AppendLine("select estitemid from estimateitems");
        sb.AppendLine(budget ? " where budgetgenerated=0" : " where pogenbatch=0");
        sb.AppendLine($"   and DivisionID = {DivisionId}");
        sb.AppendLine($"   and {(budget ? "budgetvendor" : "povendor")}={Quote(row.CurrentVendor)}");
        sb.AppendLine($"   and job={Quote(row.Job)}");
        if (GroupByPOIndex) sb.AppendLine($"   and poindex={Quote(row.POIndex)}");
        if (GroupByCostCode) sb.AppendLine($"   and jccostcode={Quote(row.CostCode)}");
        if (GroupByCategory) sb.AppendLine($"   and jccategory={Quote(row.Category)}");

        var rows = await db.QueryAsync(sb.ToString());
        var ids = new List<long>();
        foreach (var r in rows)
        {
            if (r.TryGetValue("estitemid", out var idVal) && idVal != null && idVal != DBNull.Value)
                ids.Add(Convert.ToInt64(idVal));
        }
        return ids;
    }

    private string Quote(string? value) =>
        $"'{(value ?? "").Replace("'", "''")}'";

    public class VendorPickItem
    {
        public string Vendor { get; set; } = "";
        public string CompanyName { get; set; } = "";
        public bool Selected { get; set; }
    }

    public class VendorOption
    {
        public string Vendor { get; set; } = "";
        public string CompanyName { get; set; } = "";
    }

    public class ReassignRow
    {
        public string CurrentVendor { get; set; } = "";
        public string Vendor { get; set; } = "";
        public string CompanyName { get; set; } = "";
        public string Community { get; set; } = "";
        public string CommunityDesc { get; set; } = "";
        public string Job { get; set; } = "";
        public string JobDesc { get; set; } = "";
        public string? POIndex { get; set; }
        public string? CostCode { get; set; }
        public string? CostCodeDesc { get; set; }
        public string? Category { get; set; }
        public string? CategoryDesc { get; set; }
        public bool Dirty { get; set; }
    }
}