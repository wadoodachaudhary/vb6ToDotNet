@page "/item-price-update-wizard"
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FItemPriceUpdateWizard> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>Item Pricing Wizard</PageTitle>

<div class="wizard-container">
    @* ── Wizard Header ─────────────────────────────────────── *@
    <div class="wizard-header">
        <div class="wizard-header-icon">💲</div>
        <div class="wizard-header-text">
            <h4>Update Item Pricing</h4>
            <p>The item pricing wizard will update the prices of your item database.</p>
        </div>
    </div>

    @* ── Wizard Body ───────────────────────────────────────── *@
    <div class="wizard-body">
        @switch (CurrentFrame)
        {
            case 0:
                @* ── Step 0: Select Phases ─────────────────────── *@
                <div class="step-section">
                    <div class="step-icon">📋</div>
                    <div class="step-content">
                        <h5>Which phases do you want to update?</h5>

                        <div class="all-phases-check">
                            <CheckBoxControl Checked="@AllPhasesChecked"
                                             CheckedChanged="OnAllPhasesChanged"
                                             Label="All Phases" />
                        </div>

                        <div class="phase-grid-container">
                            @foreach (var phase in PhasesList)
                            {
                                <div class="phase-row">
                                    <CheckBoxControl Checked="@phase.IsChecked"
                                                     CheckedChanged="(bool v) => OnPhaseCheckedChanged(phase, v)" />
                                    <span>@phase.Phase</span>
                                    <span class="phase-desc">@phase.Description</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                break;

            case 1:
                @* ── Step 1: Pricing Options ───────────────────── *@
                <div class="step-section">
                    <div class="step-icon">💰</div>
                    <div class="step-content">
                        <h5>What prices do you want to use?</h5>

                        <div class="radio-group">
                            <div class="radio-option">
                                <RadioControl TValue="int" Name="updateOption" Value="0"
                                              @bind-SelectedValue="UpdateOption"
                                              Label="Use the highest price found in any community." />
                            </div>
                            <div class="radio-option">
                                <RadioControl TValue="int" Name="updateOption" Value="1"
                                              @bind-SelectedValue="UpdateOption"
                                              Label="Use the default vendor's price in the selected community." />
                            </div>
                            <div class="radio-option">
                                <RadioControl TValue="int" Name="updateOption" Value="2"
                                              @bind-SelectedValue="UpdateOption"
                                              Label="Use the highest price found in the selected community." />
                            </div>
                        </div>

                        <div class="community-select">
                            <label>Community</label>
                            <DropDownListControl TValue="int" TItem="CommunityComboItem"
                                                 DataSource="@CommunityOptions"
                                                 ValueFieldName="Index" TextFieldName="DisplayText"
                                                 @bind-Value="SelectedCommunityIndex"
                                                 Enabled="@(UpdateOption != 0)"
                                                 Width="100%" />
                        </div>

                        @if (EstimatingAvailable)
                        {
                            <div class="estimating-section">
                                <div class="step-section">
                                    <div class="step-icon">🏗️</div>
                                    <div class="step-content">
                                        <h5>Do you want to update Timberline Estimating?</h5>
                                        <div class="radio-group">
                                            <div class="radio-option">
                                                <RadioControl TValue="bool" Name="estimatingOption" Value="false"
                                                              @bind-SelectedValue="UpdateEstimating"
                                                              Label="No, do not update Estimating." />
                                            </div>
                                            <div class="radio-option">
                                                <RadioControl TValue="bool" Name="estimatingOption" Value="true"
                                                              @bind-SelectedValue="UpdateEstimating"
                                                              Label="Yes, make Estimating's price match HomeFront's." />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                break;

            case 2:
                @* ── Step 2: Progress / Execute ────────────────── *@
                <div class="step-section">
                    <div class="step-icon">⚙️</div>
                    <div class="step-content">
                        <div class="progress-section">
                            <div class="status-text">@StatusMessage</div>

                            @if (ShowProgressBar)
                            {
                                <div class="progress-bar-container">
                                    <div class="progress-bar-fill" style="width: @(ProgressValue)%;">
                                        @(ProgressValue)%
                                    </div>
                                </div>
                                <div class="progress-detail">@ProgressDetail</div>
                            }
                        </div>
                    </div>
                </div>
                break;
        }
    </div>

    @* ── Wizard Footer ─────────────────────────────────────── *@
    <div class="wizard-footer">
        <ButtonControl OnClick="OnCancelClick">Cancel</ButtonControl>
        <ButtonControl Disabled="@(CurrentFrame <= 0)" OnClick="OnBackClick">&lt; Back</ButtonControl>
        <ButtonControl Disabled="@(CurrentFrame >= MaxFrame)" OnClick="OnNextClick">Next &gt;</ButtonControl>
        <ButtonControl CssClass="btn-primary"
                       Disabled="@(CurrentFrame != MaxFrame || IsProcessing)"
                       OnClick="OnFinishClick">
            @(IsProcessing ? "Processing..." : "Finish")
        </ButtonControl>
    </div>
</div>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    // === Database ===
// === Wizard State ===
    private int CurrentFrame = 0;
    private const int MaxFrame = 2;
    private bool IsProcessing = false;

    // === Step 0: Phases ===
    private List<PhaseItem> PhasesList = new();
    private bool AllPhasesChecked = true;

    // === Step 1: Pricing Options ===
    private int UpdateOption = 0; // 0=highest any, 1=default vendor, 2=highest in community
    private List<CommunityComboItem> CommunityList = new();
    // DropDownListControl DataSource — items carry their list position in Index,
    // which the control binds back to SelectedCommunityIndex.
    private List<CommunityComboItem> CommunityOptions => CommunityList;
    private int SelectedCommunityIndex = 0;
    private bool EstimatingAvailable = false;
    private bool UpdateEstimating = false;

    // === Step 2: Progress ===
    private string StatusMessage = "The pricing wizard is ready to proceed.";
    private bool ShowProgressBar = false;
    private int ProgressValue = 0;
    private string ProgressDetail = "";

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        await LoadPhasesAsync();
    }

    // === Load Phases ===
    private async Task LoadPhasesAsync()
    {
        try
        {
            var rows = await db.QueryAsync(
                "SELECT Phase, Description FROM tblEstPhases WHERE DivisionID = @DivisionID AND GroupPhase = 0 ORDER BY Phase",
                new { SessionState.DivisionID });

            PhasesList = rows.Select(r => new PhaseItem
            {
                Phase = r["Phase"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? "",
                IsChecked = true
            }).ToList();

            AllPhasesChecked = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadPhasesAsync error");

        }
    }

    // === Load Communities (called when entering Step 1) ===
    private async Task LoadCommunitiesAsync()
    {
        try
        {
            CommunityList.Clear();
            CommunityList.Add(new CommunityComboItem
            {
                DisplayText = "Global Pricing",
                KeyValue = ""
            });

            var sql = @"
                SELECT ISNULL(l.Area,'') + ' -- ' + ISNULL(l.Description,'') AS DisplayText,
                       ISNULL(l.Area,'') AS KeyValue,
                       '' AS CommunityPhase
                  FROM tblLocality l
                 WHERE l.Inactive <> 1
                UNION ALL
                SELECT ISNULL(l.Area,'') + '.' + ISNULL(p.CommunityPhase,'') + ' -- ' + ISNULL(l.Description,'') + ISNULL(' ' + p.Description,'') AS DisplayText,
                       ISNULL(l.Area,'') AS KeyValue,
                       ISNULL(p.CommunityPhase,'') AS CommunityPhase
                  FROM tblLocality l
                       JOIN CommunityPhase p ON l.Area = p.Community
                 WHERE l.Inactive <> 1
                ORDER BY 1";

            var rows = await db.QueryAsync(sql);
            foreach (var r in rows)
            {
                CommunityList.Add(new CommunityComboItem
                {
                    DisplayText = r["DisplayText"]?.ToString() ?? "",
                    KeyValue = r["KeyValue"]?.ToString() ?? "",
                    CommunityPhase = r["CommunityPhase"]?.ToString() ?? ""
                });
            }

            // Stamp each item with its list position so the DropDownListControl's
            // Index value field stays in lock-step with SelectedCommunityIndex
            // (GetSelectedCommunity() indexes CommunityList by that position).
            for (var idx = 0; idx < CommunityList.Count; idx++)
                CommunityList[idx].Index = idx;

            SelectedCommunityIndex = 0;

            // Check if Estimating database is available
            try
            {
                var estCheck = await db.ExecuteScalarAsync<int>(
                    "SELECT COUNT(*) FROM EstimatingItems WHERE DivisionID = @DivisionID",
                    new { SessionState.DivisionID });
                EstimatingAvailable = true;
            }
            catch
            {
                EstimatingAvailable = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadCommunitiesAsync error");

        }
    }

    // === Phase Checkbox Handlers ===
    private void OnAllPhasesChanged(bool value)
    {
        AllPhasesChecked = value;
        foreach (var phase in PhasesList)
        {
            phase.IsChecked = AllPhasesChecked;
        }
    }

    private void OnPhaseCheckedChanged(PhaseItem phase, bool isChecked)
    {
        phase.IsChecked = isChecked;
        UpdateAllPhasesState();
    }

    private void UpdateAllPhasesState()
    {
        if (PhasesList.All(p => p.IsChecked))
            AllPhasesChecked = true;
        else if (PhasesList.All(p => !p.IsChecked))
            AllPhasesChecked = false;
        else
            AllPhasesChecked = false; // indeterminate — Blazor doesn't support tri-state natively
    }

    // === Update Option Handler ===
    private void OnUpdateOptionChanged(int option)
    {
        UpdateOption = option;
    }

    // === Navigation Handlers ===
    private void OnCancelClick()
    {
        ClosePage();
    }

    private void OnBackClick()
    {
        if (CurrentFrame > 0)
            CurrentFrame--;
    }

    private async Task OnNextClick()
    {
        if (CurrentFrame < MaxFrame)
        {
            CurrentFrame++;
            if (CurrentFrame == 1)
            {
                await LoadCommunitiesAsync();
            }
            else if (CurrentFrame == 2)
            {
                StatusMessage = "The pricing wizard is ready to proceed.";
                ShowProgressBar = false;
                ProgressValue = 0;
                ProgressDetail = "";
            }
        }
    }

    private async Task OnFinishClick()
    {
        if (IsProcessing) return;
        IsProcessing = true;
        StateHasChanged();

        try
        {
            var success = await SaveDataAsync();
            if (success)
            {
                Notifications.Success("Item pricing update completed successfully.");
                ClosePage();
            }
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    // === Build Selected Phases Clause ===
    private string GetSelectedPhases()
    {
        if (AllPhasesChecked)
            return "";

        var selected = PhasesList
            .Where(p => p.IsChecked)
            .Select(p => $"'{p.Phase.Replace("'", "''")}'");

        return string.Join(",", selected);
    }

    // === Get Selected Community ===
    private (string Community, string CommunityPhase) GetSelectedCommunity()
    {
        if (SelectedCommunityIndex < 0 || SelectedCommunityIndex >= CommunityList.Count)
            return ("", "");

        var item = CommunityList[SelectedCommunityIndex];
        return (item.KeyValue, item.CommunityPhase);
    }

    // === Save / Execute ===
    private async Task<bool> SaveDataAsync()
    {
        try
        {
            var phases = GetSelectedPhases();
            var (community, communityPhase) = GetSelectedCommunity();

            StatusMessage = "Querying vendor pricelists...";
            ShowProgressBar = false;
            StateHasChanged();
            await Task.Delay(50); // Allow UI to update

            string sql;
            string phaseFilter = string.IsNullOrEmpty(phases) ? "" : $" AND Phase IN({phases})";

            switch (UpdateOption)
            {
                case 0: // Highest price in any community
                    sql = $@"
                        UPDATE tblPhaseItem
                        SET Price = (SELECT MAX(current_cost)
                                       FROM tblVendorCost
                                      WHERE tblVendorCost.Phase = tblPhaseItem.Phase
                                        AND tblVendorCost.Item = tblPhaseItem.Item
                                        AND tblVendorCost.DivisionID = {SessionState.DivisionID})
                        WHERE 0 <> (SELECT ISNULL(MAX(current_cost), 0)
                                       FROM tblVendorCost
                                      WHERE tblVendorCost.Phase = tblPhaseItem.Phase
                                        AND tblVendorCost.Item = tblPhaseItem.Item
                                        AND tblVendorCost.DivisionID = {SessionState.DivisionID})
                        {phaseFilter}
                        AND DivisionID = {SessionState.DivisionID}";
                    await db.ExecuteAsync(sql);
                    break;

                case 1: // Default vendor in selected community
                    sql = $@"
                        UPDATE tblPhaseItem
                        SET Price = Current_Cost
                        FROM tblVendorCost c
                        JOIN tblPhaseItem i ON c.DivisionID = i.DivisionID
                            AND c.Phase = i.Phase AND c.Item = i.Item
                        WHERE c.Vendor = dbo.Purch_GetCommunityVendor(c.Community, i.POIndex, {SessionState.DivisionID})
                        {(string.IsNullOrEmpty(phases) ? "" : $" AND i.Phase IN({phases})")}
                        AND c.Community = '{community.Replace("'", "''")}'
                        AND c.CommunityPhase = '{communityPhase.Replace("'", "''")}'
                        AND c.Assembly = ''
                        AND c.Model = ''
                        AND c.DivisionID = {SessionState.DivisionID}";
                    await db.ExecuteAsync(sql);
                    break;

                case 2: // Highest cost in selected community
                    sql = $@"
                        UPDATE tblPhaseItem
                        SET Price = (SELECT MAX(Current_Cost)
                                       FROM tblVendorCost
                                      WHERE ISNULL(Community, '') = '{community.Replace("'", "''")}'
                                        AND ISNULL(CommunityPhase, '') = '{communityPhase.Replace("'", "''")}'
                                        AND ISNULL(Assembly, '') = ''
                                        AND ISNULL(Model, '') = ''
                                        AND tblVendorCost.Phase = tblPhaseItem.Phase
                                        AND tblVendorCost.Item = tblPhaseItem.Item
                                        AND tblVendorCost.DivisionID = {SessionState.DivisionID})
                        WHERE 0 <> (SELECT ISNULL(MAX(Current_Cost), 0)
                                       FROM tblVendorCost
                                      WHERE ISNULL(Community, '') = '{community.Replace("'", "''")}'
                                        AND ISNULL(CommunityPhase, '') = '{communityPhase.Replace("'", "''")}'
                                        AND ISNULL(Assembly, '') = ''
                                        AND ISNULL(Model, '') = ''
                                        AND tblVendorCost.Phase = tblPhaseItem.Phase
                                        AND tblVendorCost.Item = tblPhaseItem.Item
                                        AND tblVendorCost.DivisionID = {SessionState.DivisionID})
                        {phaseFilter}
                        AND DivisionID = {SessionState.DivisionID}";
                    await db.ExecuteAsync(sql);
                    break;
            }

            // Update Estimating if requested
            if (EstimatingAvailable && UpdateEstimating)
            {
                await UpdateEstimatingPricesAsync(phases);
            }

            StatusMessage = "Update complete.";
            StateHasChanged();
            return true;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
            {
                // Ignore duplicate errors, matching VB6 behavior
                StatusMessage = "Update complete (some duplicates skipped).";
                return true;
            }

            Logger.LogError(ex, "SaveDataAsync error");

            StatusMessage = $"Error: {ex.Message}";
            StateHasChanged();
            return false;
        }
    }

    private async Task UpdateEstimatingPricesAsync(string phases)
    {
        try
        {
            // Get count
            var countSql = $"SELECT COUNT(*) FROM EstimatingItems WHERE DivisionID = {SessionState.DivisionID}";
            if (!string.IsNullOrEmpty(phases))
                countSql += $" AND Phase IN({phases})";

            var totalCount = await db.ExecuteScalarAsync<int>(countSql);
            if (totalCount == 0) return;

            // Get items
            var itemsSql = $"SELECT * FROM EstimatingItems WHERE DivisionID = {SessionState.DivisionID}";
            if (!string.IsNullOrEmpty(phases))
                itemsSql += $" AND Phase IN({phases})";

            var items = await db.QueryAsync(itemsSql);

            ShowProgressBar = true;
            StatusMessage = "Updating Estimating prices...";
            StateHasChanged();

            int i = 0;
            foreach (var row in items)
            {
                i++;
                ProgressValue = (int)((double)i / totalCount * 100);
                ProgressDetail = $"Item {i} of {totalCount}";

                if (i % 10 == 0)
                {
                    StateHasChanged();
                    await Task.Delay(1); // Allow UI to update
                }

                var costCategory = row["CostCategory"]?.ToString() ?? "";
                var price = Math.Abs(Convert.ToDouble(row["Price"] ?? 0));
                var phase = row["Phase"]?.ToString() ?? "";
                var itemNumber = row["ItemNumber"]?.ToString() ?? "";
                var priceLink = Convert.ToDouble(row["PriceLink"] ?? 0);

                string setClause = costCategory switch
                {
                    "S" => $"sub_price = {price}",
                    "L" => $"labor_price = {price}",
                    "O" => $"other_price = {price}",
                    "E" => $"equipment_price = {price}",
                    _ => $"material_price = {price}"
                };

                var updateSql = $@"
                    UPDATE DAT_PEI__DB_ITEM
                    SET {setClause}
                    WHERE Phase_Code = '{phase.Replace("'", "''")}'
                      AND Item_Number = '{itemNumber.Replace("'", "''")}'";

                try
                {
                    await db.ExecuteAsync(updateSql);
                }
                catch (Exception ex)
                {
                    if (!ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                        Logger.LogError(ex, "Estimating update error");

                }

                // Update price links
                if (priceLink != 0)
                {
                    string? linkSql = costCategory switch
                    {
                        "M" => $"UPDATE DAT_PEI__DB_ITEM SET material_price = {price} WHERE mat_price_link = {priceLink}",
                        "L" => $"UPDATE DAT_PEI__DB_ITEM SET labor_price = {price} WHERE lab_price_link = {priceLink}",
                        "E" => $"UPDATE DAT_PEI__DB_ITEM SET equipment_price = {price} WHERE eq_price_link = {priceLink}",
                        _ => null
                    };

                    if (linkSql != null)
                    {
                        try
                        {
                            await db.ExecuteAsync(linkSql);
                        }
                        catch (Exception ex)
                        {
                            if (!ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                                Logger.LogError(ex, "Price link update error");

                        }
                    }
                }
            }

            ProgressValue = 100;
            ProgressDetail = $"Completed {totalCount} items.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "UpdateEstimatingPricesAsync error");

        }
    }

    // === Models ===
    public class PhaseItem
    {
        public string Phase { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsChecked { get; set; } = true;
    }

    public class CommunityComboItem
    {
        public int Index { get; set; }
        public string DisplayText { get; set; } = "";
        public string KeyValue { get; set; } = "";
        public string CommunityPhase { get; set; } = "";
    }
}
