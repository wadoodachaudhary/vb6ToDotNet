@namespace HomeFront.Components.Pages
@page "/field-po-requests"
@rendermode InteractiveServer

@using HomeFront.Data
@using HomeFront.Models
@using System.Reflection
@using System.Text
@using Fx.ControlKit.Notifications
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject ILogger<FFieldPOs> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db

<PageTitle>Field PO Requests</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">Loading...</div>
    </div>
}

<div class="toolbar-cntr">
    <ButtonControl BareStyle="true" CssClass="tbar-btn btn-success" Disabled="@(!HasSelection)" OnClick="ApproveSelected">
        <span>✔</span>
        <span class="tool-label">Approve</span>
    </ButtonControl>
    <ButtonControl BareStyle="true" CssClass="tbar-btn btn-danger" Disabled="@(!HasSelection)" OnClick="DeclineSelected">
        <span>✖</span>
        <span class="tool-label">Decline</span>
    </ButtonControl>
    <div class="toolbar-info">
        <span>@RequestsData.Count request(s)</span>
        @if (SelectedRequestId > 0)
        {
            <span>Selected: @SelectedRequestId</span>
        }
    </div>
</div>

<div class="fieldpo-body" style="@($"grid-template-rows: {SplitPercent}fr 28px {100 - SplitPercent}fr;")">
    <div class="grid-panel">
        <GridControl @ref="RequestsGrid"
                TValue="RequestRow"
                DataSource="@RequestsData"
                AllowSelection="true"
                AllowSorting="true"
                AllowResizing="true"
                EnableHover="true"
                Height="100%"
                SelectionSettingsRef="@requestSelectionSettings"
                EventsRef="@requestGridEvents">
            <GridColumnsBase @key="gRequestsLayoutVersion">
                @if (HasRequestsGridLayout)
                {
                    foreach (var entry in GetOrderedRequestsGridLayout())
                    {
                        var layout = entry.Layout;
                        var fieldName = entry.Field;
                        var columnType = entry.ColumnType;
                        var textAlign = entry.TextAlign;
                        var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                        var width = layout.Width.HasValue && layout.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;

                        <GridColumn Field="@fieldName"
                                      HeaderText="@headerText"
                                      Width="@width"
                                      Type="@columnType"
                                      TextAlign="@textAlign"
                                      IsPrimaryKey="@(fieldName == "RequestID")"
                                      ClipMode="ClipMode.Ellipsis" />
                    }
                }
                else
                {
                    <GridColumn Field="@nameof(RequestRow.RequestID)" HeaderText="Request ID" Width="90px" IsPrimaryKey="true" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(RequestRow.RequestedBy)" HeaderText="Requested By" Width="120px" />
                    <GridColumn Field="@nameof(RequestRow.RequestedDate)" HeaderText="Requested Date" Width="120px" Format="d" />
                    <GridColumn Field="@nameof(RequestRow.Job)" HeaderText="Job" Width="80px" />
                    <GridColumn Field="@nameof(RequestRow.JobDesc)" HeaderText="Job Desc" Width="180px" />
                    <GridColumn Field="@nameof(RequestRow.POIndex)" HeaderText="PO Index" Width="90px" />
                    <GridColumn Field="@nameof(RequestRow.Vendor)" HeaderText="Vendor" Width="90px" />
                    <GridColumn Field="@nameof(RequestRow.VendorDesc)" HeaderText="Vendor Desc" Width="200px" />
                    <GridColumn Field="@nameof(RequestRow.RequestDesc)" HeaderText="Request Desc" Width="240px" />
                    <GridColumn Field="@nameof(RequestRow.BCVendor)" HeaderText="BC Vendor" Width="90px" />
                    <GridColumn Field="@nameof(RequestRow.BCVendorDesc)" HeaderText="BC Vendor Desc" Width="200px" />
                    <GridColumn Field="@nameof(RequestRow.Comments)" HeaderText="Comments" Width="240px" />
                }
            </GridColumnsBase>
        </GridControl>
    </div>

    <div class="slider-panel">
        <input type="range" min="20" max="80" step="1" @bind="SplitPercent" @bind:event="oninput" />
        <span>@SplitPercent%</span>
    </div>

    <div class="grid-panel">
        <GridControl @ref="DetailsGrid"
                TValue="DetailRow"
                DataSource="@DetailsData"
                AllowSelection="true"
                AllowSorting="true"
                AllowResizing="true"
                EnableHover="true"
                Height="100%"
                SelectionSettingsRef="@detailSelectionSettings">
            <GridColumnsBase @key="gDetailsLayoutVersion">
                @if (HasDetailsGridLayout)
                {
                    foreach (var entry in GetOrderedDetailsGridLayout())
                    {
                        var layout = entry.Layout;
                        var fieldName = entry.Field;
                        var columnType = entry.ColumnType;
                        var textAlign = entry.TextAlign;
                        var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                        var width = layout.Width.HasValue && layout.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;

                        <GridColumn Field="@fieldName"
                                      HeaderText="@headerText"
                                      Width="@width"
                                      Type="@columnType"
                                      TextAlign="@textAlign"
                                      ClipMode="ClipMode.Ellipsis" />
                    }
                }
                else
                {
                    <GridColumn Field="@nameof(DetailRow.Sequence)" HeaderText="Seq" Width="60px" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(DetailRow.Phase)" HeaderText="Phase" Width="70px" />
                    <GridColumn Field="@nameof(DetailRow.Item)" HeaderText="Item" Width="80px" />
                    <GridColumn Field="@nameof(DetailRow.Description)" HeaderText="Description" Width="220px" />
                    <GridColumn Field="@nameof(DetailRow.Job)" HeaderText="Job" Width="80px" />
                    <GridColumn Field="@nameof(DetailRow.JobDesc)" HeaderText="Job Desc" Width="180px" />
                    <GridColumn Field="@nameof(DetailRow.JCExtra)" HeaderText="JC Extra" Width="90px" />
                    <GridColumn Field="@nameof(DetailRow.JCCostCode)" HeaderText="JC Cost Code" Width="110px" />
                    <GridColumn Field="@nameof(DetailRow.JCCostCodeDesc)" HeaderText="Cost Code Desc" Width="180px" />
                    <GridColumn Field="@nameof(DetailRow.JCCategory)" HeaderText="JC Category" Width="100px" />
                    <GridColumn Field="@nameof(DetailRow.JCCategoryDesc)" HeaderText="Category Desc" Width="180px" />
                    <GridColumn Field="@nameof(DetailRow.TaxGroup)" HeaderText="Tax Group" Width="90px" />
                    <GridColumn Field="@nameof(DetailRow.Qty)" HeaderText="Qty" Width="90px" Format="N4" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(DetailRow.Rate)" HeaderText="Rate" Width="90px" Format="N4" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(DetailRow.Amount)" HeaderText="Amount" Width="100px" Format="N2" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(DetailRow.JCTax)" HeaderText="JC Tax" Width="90px" Format="N2" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(DetailRow.NJCTax)" HeaderText="NJC Tax" Width="90px" Format="N2" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(DetailRow.UOM)" HeaderText="UOM" Width="70px" />
                    <GridColumn Field="@nameof(DetailRow.TotalAmount)" HeaderText="Total" Width="110px" Format="N2" TextAlign="TextAlign.Right" />
                }
            </GridColumnsBase>
        </GridControl>
    </div>
</div>

@code {
private const string LoginId = "SYSTEM";
    private bool IsLoading;
    private int SplitPercent = 45;

    private List<RequestRow> RequestsData = new();
    private List<DetailRow> DetailsData = new();

    private GridControl<RequestRow>? RequestsGrid;
    private GridControl<DetailRow>? DetailsGrid;

    private long SelectedRequestId;
    private int SelectedRequestCount;

    private bool HasSelection => SelectedRequestCount > 0;

    private SelectionSettings requestSelectionSettings = new()
    {
        Type = SelectionType.Multiple,
        Mode = SelectionMode.Row,
        EnableToggle = true
    };

    private SelectionSettings detailSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    private GridControlEvents<RequestRow> requestGridEvents = new();
    private GridControlEvents<DetailRow> detailGridEvents = new();

    // === Grid Layout (dynamic from AppGridLayout) ===
    // Load/resolve/order/width boilerplate lives in the shared GridLayoutPresenter
    // (Services/GridLayoutPresenter.cs); only the VB6 form/grid name strings stay
    // here. The members named gRequestsLayout / HasRequestsGridLayout / …Version
    // below are thin delegations so the markup is unchanged. The keyed-then-unkeyed
    // two-call fallback is captured by instanceKey:"(0)" in the ctors.
    private readonly GridLayoutPresenter<RequestRow> _requestsGrid =
        new("FFieldPOs", "RequestsGrid", instanceKey: "(0)");
    private readonly GridLayoutPresenter<DetailRow> _detailsGrid =
        new("FFieldPOs", "DetailsGrid", instanceKey: "(0)");

    private Dictionary<string, GridLayoutColumn> gRequestsLayout => _requestsGrid.Layout;
    private bool HasRequestsGridLayout => _requestsGrid.Has;
    private int gRequestsLayoutVersion => _requestsGrid.Version;

    private Dictionary<string, GridLayoutColumn> gDetailsLayout => _detailsGrid.Layout;
    private bool HasDetailsGridLayout => _detailsGrid.Has;
    private int gDetailsLayoutVersion => _detailsGrid.Version;

    // === Property Maps for Field Resolution ===
    // NOTE (drift): kept locally because GetColumnTypeForRequestField /
    // GetColumnTypeForDetailField below diverge from the presenter's canonical
    // ColumnTypeFor (they map bool→CheckBox, not Boolean, and recognize a narrower
    // numeric set). See the flag in GetColumnTypeForRequestField.
    private static readonly Dictionary<string, PropertyInfo> _requestRowPropMap =
        typeof(RequestRow)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .GroupBy(p => NormalizeGridKey(p.Name))
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    private static readonly Dictionary<string, PropertyInfo> _detailRowPropMap =
        typeof(DetailRow)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .GroupBy(p => NormalizeGridKey(p.Name))
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        requestGridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<RequestRow>>(this, OnRequestRowSelected);
        requestGridEvents.RowDeselected = EventCallback.Factory.Create<RowSelectEventArgs<RequestRow>>(this, OnRequestRowDeselected);
        await LoadGridLayoutAsync();
        await LoadRequestsAsync();
    }

    // === Load Grid Layout ===
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            // Presenter does the keyed-then-unkeyed fallback + Version bump
            // (ctors hold the "FFieldPOs"/grid names + instanceKey "(0)").
            await _requestsGrid.LoadAsync(GridLayoutSvc);
            await _detailsGrid.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");

        }
    }

    private async Task LoadRequestsAsync()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var sql = @"
SELECT
  fpr.RequestID,
  fpu.USER_NAME RequestedBy,
  fpr.RequestDate RequestedDate,
  j.Job_No Job,
  j.Description JobDesc,
  fpr.POIndex,
  fpr.VendorID Vendor,
  v.Vendor_Name VendorDesc,
  fpr.Description RequestDesc,
  fpr.BackChargeVendorID BCVendor,
  bc.Vendor_Name BCVendorDesc,
  fpr.BackChargeComments Comments
FROM FieldPORequests fpr
LEFT OUTER JOIN tblVendors v ON fpr.VendorID = v.Vendor_ID and fpr.DivisionID = v.DivisionID
LEFT OUTER JOIN tblVendors bc ON fpr.BackChargeVendorID = bc.Vendor_ID and fpr.DivisionID = v.DivisionID
LEFT OUTER JOIN FieldPOUsers fpu ON fpu.User_ID = fpr.UserID
LEFT OUTER JOIN tblJobs j ON fpr.Job=j.Job_No and fpr.DivisionID = j.DivisionID
WHERE fpr.Status=0
  AND fpr.DivisionID = @DivisionID
ORDER BY fpr.RequestID";
            var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });

            RequestsData = rows.Select(r => new RequestRow
            {
                RequestID = AsLong(GetValue(r, "RequestID")),
                RequestedBy = AsString(GetValue(r, "RequestedBy")),
                RequestedDate = AsDate(GetValue(r, "RequestedDate")),
                Job = AsString(GetValue(r, "Job")),
                JobDesc = AsString(GetValue(r, "JobDesc")),
                POIndex = AsString(GetValue(r, "POIndex")),
                Vendor = AsString(GetValue(r, "Vendor")),
                VendorDesc = AsString(GetValue(r, "VendorDesc")),
                RequestDesc = AsString(GetValue(r, "RequestDesc")),
                BCVendor = AsString(GetValue(r, "BCVendor")),
                BCVendorDesc = AsString(GetValue(r, "BCVendorDesc")),
                Comments = AsString(GetValue(r, "Comments"))
            }).ToList();

            if (RequestsData.Count > 0)
            {
                SelectedRequestId = RequestsData[0].RequestID;
                await LoadDetailsAsync(SelectedRequestId);
            }
            else
            {
                DetailsData = new();
            }
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error loading requests: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadDetailsAsync(long requestId)
    {
        if (requestId == 0) { DetailsData = new(); return; }

        try
        {
            var sql = @"
SELECT
  d.sequence,
  d.phase,
  d.item,
  d.description,
  d.job,
  j.Description JobDesc,
  d.jcextra,
  d.jccostcode,
  scc.description jccostcodedesc,
  d.jccategory,
  scat.description jccategorydesc,
  d.taxgroup,
  round(d.qty,4) Qty,
  round(d.rate,4) Rate,
  round(d.amount,2) Amount,
  round(d.jctax,2) jctax,
  round(d.njctax,2) njctax,
  d.orderuom uom,
  round(d.totalamount,2) totalamount
FROM FieldPORequests fpr
LEFT OUTER JOIN tblVendors v ON fpr.VendorID = v.Vendor_ID and fpr.DivisionID = v.DivisionID
LEFT OUTER JOIN tblVendors bc ON fpr.BackChargeVendorID = bc.Vendor_ID and fpr.DivisionID = v.DivisionID
LEFT OUTER JOIN FieldPOUsers fpu ON fpu.User_ID = fpr.UserID
LEFT OUTER JOIN fieldporequestdetails d ON fpr.requestid=d.requestid
LEFT OUTER JOIN tblJobs j ON d.Job=j.Job_No and fpr.DivisionID = j.DivisionID
LEFT OUTER JOIN standardcostcodes scc ON d.jccostcode=scc.costcode and fpr.DivisionID = scc.DivisionID
LEFT OUTER JOIN standardcategories scat ON d.jccategory=scat.category and fpr.DivisionID = scat.DivisionID
WHERE fpr.RequestID=@RequestID
  AND fpr.DivisionID = @DivisionID
ORDER BY d.sequence";
            var rows = await db.QueryAsync(sql, new { RequestID = requestId, SessionState.DivisionID });

            DetailsData = rows.Select(r => new DetailRow
            {
                Sequence = AsInt(GetValue(r, "sequence")),
                Phase = AsString(GetValue(r, "phase")),
                Item = AsString(GetValue(r, "item")),
                Description = AsString(GetValue(r, "description")),
                Job = AsString(GetValue(r, "job")),
                JobDesc = AsString(GetValue(r, "JobDesc")),
                JCExtra = AsString(GetValue(r, "jcextra")),
                JCCostCode = AsString(GetValue(r, "jccostcode")),
                JCCostCodeDesc = AsString(GetValue(r, "jccostcodedesc")),
                JCCategory = AsString(GetValue(r, "jccategory")),
                JCCategoryDesc = AsString(GetValue(r, "jccategorydesc")),
                TaxGroup = AsString(GetValue(r, "taxgroup")),
                Qty = AsDecimal(GetValue(r, "Qty")),
                Rate = AsDecimal(GetValue(r, "Rate")),
                Amount = AsDecimal(GetValue(r, "Amount")),
                JCTax = AsDecimal(GetValue(r, "jctax")),
                NJCTax = AsDecimal(GetValue(r, "njctax")),
                UOM = AsString(GetValue(r, "uom")),
                TotalAmount = AsDecimal(GetValue(r, "totalamount"))
            }).ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error loading details: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task OnRequestRowSelected(RowSelectEventArgs<RequestRow> args)
    {
        if (args?.Data == null) return;
        SelectedRequestId = args.Data.RequestID;
        SelectedRequestCount = RequestsGrid?.GetSelectedRecords()?.Count() ?? 1;
        await LoadDetailsAsync(SelectedRequestId);
    }

    private Task OnRequestRowDeselected(RowSelectEventArgs<RequestRow> args)
    {
        SelectedRequestCount = RequestsGrid?.GetSelectedRecords()?.Count() ?? 0;
        if (SelectedRequestCount == 0)
        {
            SelectedRequestId = 0;
            DetailsData = new();
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ApproveSelected() => await ProcessSelectionAsync("Approve");
    private async Task DeclineSelected() => await ProcessSelectionAsync("Decline");

    private async Task ProcessSelectionAsync(string action)
    {
        var selected = RequestsGrid?.GetSelectedRecords()?.ToList() ?? new List<RequestRow>();
        if (selected.Count == 0)
        {
            Notifications.Info("Select one or more requests.");
            return;
        }

        if (selected.Count > 1)
        {
            var confirm = await Dialogs.ConfirmAsync($"{action} these {selected.Count} requests?");
            if (!confirm) return;
        }

        foreach (var row in selected)
        {
            if (action == "Approve")
            {
                await db.ExecuteAsync("exec FieldPO_ApprovePORequest @RequestID, @ApprovedDate, @LoginID",
                    new { RequestID = row.RequestID, ApprovedDate = DateTime.Now, LoginID = LoginId });
            }
            else
            {
                await db.ExecuteAsync("exec FieldPO_DeclinePORequest @RequestID, @DeclinedDate",
                    new { RequestID = row.RequestID, DeclinedDate = DateTime.Now });
            }
            RequestsData.Remove(row);
        }

        SelectedRequestCount = 0;
        await InvokeAsync(StateHasChanged);

        if (RequestsData.Count > 0)
        {
            SelectedRequestId = RequestsData[0].RequestID;
            await LoadDetailsAsync(SelectedRequestId);
        }
        else
        {
            SelectedRequestId = 0;
            DetailsData = new();
        }

        if (RequestsGrid != null)
            await RequestsGrid.Refresh();
    }

    private static object? GetValue(IDictionary<string, object> row, string key) =>
        row.TryGetValue(key, out var val) ? val : null;

    private static string AsString(object? value) =>
        value == null || value == DBNull.Value ? "" : value.ToString() ?? "";

    private static long AsLong(object? value) =>
        value == null || value == DBNull.Value ? 0 : Convert.ToInt64(value);

    private static int AsInt(object? value) =>
        value == null || value == DBNull.Value ? 0 : Convert.ToInt32(value);

    private static decimal AsDecimal(object? value) =>
        value == null || value == DBNull.Value ? 0 : Convert.ToDecimal(value);

    private static DateTime? AsDate(object? value) =>
        value == null || value == DBNull.Value ? null : Convert.ToDateTime(value);

    // === Grid Layout Helpers (Requests) ===
    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedRequestsGridLayout()
    {
        if (!HasRequestsGridLayout) yield break;

        var ordered = gRequestsLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = ResolveRequestGridField(layout.Field);
            var columnType = GetColumnTypeForRequestField(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    private string ResolveRequestGridField(string layoutField)
        => _requestsGrid.ResolveField(layoutField);

    // DRIFT FLAG: bodies differ from the presenter's canonical ColumnTypeFor —
    // bool maps to ColumnType.CheckBox (not Boolean) and only int/long/double/
    // decimal are treated as Number (the presenter also covers byte/short/float).
    // Kept verbatim to preserve the rendered <GridColumn Type="…"> behavior; not
    // delegated to _requestsGrid.GetOrdered() for the same reason.
    private static ColumnType GetColumnTypeForRequestField(string field)
    {
        if (string.IsNullOrWhiteSpace(field)) return ColumnType.Text;
        if (_requestRowPropMap.TryGetValue(NormalizeGridKey(field), out var prop))
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool)) return ColumnType.CheckBox;
            if (type == typeof(int) || type == typeof(long) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
            if (type == typeof(DateTime)) return ColumnType.Date;
        }
        return ColumnType.Text;
    }

    // === Grid Layout Helpers (Details) ===
    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedDetailsGridLayout()
    {
        if (!HasDetailsGridLayout) yield break;

        var ordered = gDetailsLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = ResolveDetailGridField(layout.Field);
            var columnType = GetColumnTypeForDetailField(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    private string ResolveDetailGridField(string layoutField)
        => _detailsGrid.ResolveField(layoutField);

    // DRIFT FLAG: same divergence as GetColumnTypeForRequestField (bool→CheckBox,
    // narrower numeric set). Kept verbatim; not delegated to GetOrdered().
    private static ColumnType GetColumnTypeForDetailField(string field)
    {
        if (string.IsNullOrWhiteSpace(field)) return ColumnType.Text;
        if (_detailRowPropMap.TryGetValue(NormalizeGridKey(field), out var prop))
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool)) return ColumnType.CheckBox;
            if (type == typeof(int) || type == typeof(long) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
        }
        return ColumnType.Text;
    }

    // === Shared Grid Helpers ===
    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    private static string NormalizeGridKey(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var sb = new StringBuilder(value.Length);
        foreach (var ch in value)
        {
            if (char.IsLetterOrDigit(ch))
                sb.Append(char.ToLowerInvariant(ch));
        }
        return sb.ToString();
    }

    public class RequestRow
    {
        public long RequestID { get; set; }
        public string RequestedBy { get; set; } = "";
        public DateTime? RequestedDate { get; set; }
        public string Job { get; set; } = "";
        public string JobDesc { get; set; } = "";
        public string POIndex { get; set; } = "";
        public string Vendor { get; set; } = "";
        public string VendorDesc { get; set; } = "";
        public string RequestDesc { get; set; } = "";
        public string BCVendor { get; set; } = "";
        public string BCVendorDesc { get; set; } = "";
        public string Comments { get; set; } = "";
    }

    public class DetailRow
    {
        public int Sequence { get; set; }
        public string Phase { get; set; } = "";
        public string Item { get; set; } = "";
        public string Description { get; set; } = "";
        public string Job { get; set; } = "";
        public string JobDesc { get; set; } = "";
        public string JCExtra { get; set; } = "";
        public string JCCostCode { get; set; } = "";
        public string JCCostCodeDesc { get; set; } = "";
        public string JCCategory { get; set; } = "";
        public string JCCategoryDesc { get; set; } = "";
        public string TaxGroup { get; set; } = "";
        public decimal Qty { get; set; }
        public decimal Rate { get; set; }
        public decimal Amount { get; set; }
        public decimal JCTax { get; set; }
        public decimal NJCTax { get; set; }
        public string UOM { get; set; } = "";
        public decimal TotalAmount { get; set; }
    }
}