@namespace HomeFront.Components.Pages

@using Fx.ControlKit.Notifications

@* ClsFileInfo.razor - Blazor service component converted from VB6 ClsFileInfo class *@
@* This is a non-visual utility class; no UI markup is rendered. *@

@code {
    // ── Member variables ─────────────────────────────────────────────────
    private string m_PathName = "";
    private string m_Name = "";
    private string m_Path = "";
    private string m_Extension = "";
    private string m_DisplayName = "";
    private string m_TypeName = "";
    private string m_PathNameShort = "";
    private string m_NameShort = "";
    private string m_PathShort = "";
    private bool m_FileExists = false;
    private bool m_PathExists = false;
    private long m_FileSize = 0;
    private long m_CompFileSize = 0;
    private DateTime m_tmCreation = DateTime.MinValue;
    private DateTime m_tmAccess = DateTime.MinValue;
    private DateTime m_tmWrite = DateTime.MinValue;
    private FileAttributes m_Attributes = 0;

    // ── Enumerated constants ─────────────────────────────────────────────
    private enum FileTimes
    {
        CreationTime = 0,
        LastAccessTime = 1,
        LastWriteTime = 2
    }

    // ── Public Properties ────────────────────────────────────────────────

    /// <summary>
    /// Sets or gets the fully-qualified path/name spec. Setting triggers a Refresh.
    /// </summary>
    public string FullPathName
    {
        get => m_FileExists ? m_PathName : "";
        set
        {
            if (!string.IsNullOrEmpty(value))
            {
                try
                {
                    m_PathName = System.IO.Path.GetFullPath(value);
                    Refresh();
                }
                catch
                {
                    m_PathName = value;
                }
            }
        }
    }

    /// <summary>Returns filename only.</summary>
    public string FileName => m_FileExists ? m_Name : "";

    /// <summary>Returns fully-qualified pathname only.</summary>
    public string FilePath => m_FileExists ? m_Path : "";

    /// <summary>Returns the file's extension only (without dot).</summary>
    public string FileExtension => m_FileExists ? m_Extension : "";

    /// <summary>Returns fully-qualified short path/name spec (on Windows).</summary>
    public string ShortPathName => m_FileExists ? m_PathNameShort : "";

    /// <summary>Returns short filename only.</summary>
    public string ShortName => m_FileExists ? m_NameShort : "";

    /// <summary>Returns short fully-qualified pathname only.</summary>
    public string ShortPath => m_FileExists ? m_PathShort : "";

    /// <summary>Returns the display name for the file.</summary>
    public string DisplayName => m_FileExists ? m_DisplayName : "";

    /// <summary>Returns the string that describes the file's type.</summary>
    public string FileTypeName => m_FileExists ? m_TypeName : "";

    /// <summary>Returns whether file exists.</summary>
    public bool FileExists => m_FileExists;

    /// <summary>Returns whether path exists.</summary>
    public bool PathExists => m_PathExists;

    /// <summary>Return size of file in bytes.</summary>
    public long FileSize => m_FileExists ? m_FileSize : 0;

    /// <summary>Return compressed/actual size of file in bytes.</summary>
    public long CompressedFileSize => m_FileExists ? m_CompFileSize : 0;

    /// <summary>Gets or sets the creation time.</summary>
    public DateTime CreationTime
    {
        get => m_FileExists ? m_tmCreation : DateTime.MinValue;
        set
        {
            if (SetTime(value, FileTimes.CreationTime))
                Refresh();
        }
    }

    /// <summary>Gets or sets the last access time.</summary>
    public DateTime LastAccessTime
    {
        get => m_FileExists ? m_tmAccess : DateTime.MinValue;
        set
        {
            if (SetTime(value, FileTimes.LastAccessTime))
                Refresh();
        }
    }

    /// <summary>Gets or sets the last write/modify time.</summary>
    public DateTime ModifyTime
    {
        get => m_FileExists ? m_tmWrite : DateTime.MinValue;
        set
        {
            if (SetTime(value, FileTimes.LastWriteTime))
                Refresh();
        }
    }

    /// <summary>Gets or sets the entire set of attribute flags.</summary>
    public FileAttributes Attributes
    {
        get => m_FileExists ? m_Attributes : 0;
        set
        {
            if (value != m_Attributes)
            {
                if (SetAttr(value))
                    Refresh();
            }
        }
    }

    /// <summary>Gets or sets the ReadOnly attribute.</summary>
    public bool AttrReadOnly
    {
        get => m_FileExists && m_Attributes.HasFlag(FileAttributes.ReadOnly);
        set
        {
            var newAttr = value
                ? m_Attributes | FileAttributes.ReadOnly
                : m_Attributes & ~FileAttributes.ReadOnly;
            Attributes = newAttr;
        }
    }

    /// <summary>Gets or sets the Hidden attribute.</summary>
    public bool AttrHidden
    {
        get => m_FileExists && m_Attributes.HasFlag(FileAttributes.Hidden);
        set
        {
            var newAttr = value
                ? m_Attributes | FileAttributes.Hidden
                : m_Attributes & ~FileAttributes.Hidden;
            Attributes = newAttr;
        }
    }

    /// <summary>Gets or sets the System attribute.</summary>
    public bool AttrSystem
    {
        get => m_FileExists && m_Attributes.HasFlag(FileAttributes.System);
        set
        {
            var newAttr = value
                ? m_Attributes | FileAttributes.System
                : m_Attributes & ~FileAttributes.System;
            Attributes = newAttr;
        }
    }

    /// <summary>Gets or sets the Archive attribute.</summary>
    public bool AttrArchive
    {
        get => m_FileExists && m_Attributes.HasFlag(FileAttributes.Archive);
        set
        {
            var newAttr = value
                ? m_Attributes | FileAttributes.Archive
                : m_Attributes & ~FileAttributes.Archive;
            Attributes = newAttr;
        }
    }

    /// <summary>Gets the Temporary attribute (read-only; cannot be changed with normal methods).</summary>
    public bool AttrTemporary => m_FileExists && m_Attributes.HasFlag(FileAttributes.Temporary);

    /// <summary>Gets the Compressed attribute (read-only; cannot be changed with normal methods).</summary>
    public bool AttrCompressed => m_FileExists && m_Attributes.HasFlag(FileAttributes.Compressed);

    // ── Public Methods ───────────────────────────────────────────────────

    /// <summary>
    /// Refreshes all file information from the file system.
    /// </summary>
    public void Refresh()
    {
        try
        {
            if (string.IsNullOrEmpty(m_PathName))
            {
                m_FileExists = false;
                return;
            }

            var fileInfo = new System.IO.FileInfo(m_PathName);

            if (fileInfo.Exists)
            {
                m_FileExists = true;
                m_PathExists = true;
                m_FileSize = fileInfo.Length;
                m_CompFileSize = fileInfo.Length; // .NET doesn't expose compressed size directly
                m_Attributes = fileInfo.Attributes;
                m_tmCreation = fileInfo.CreationTime;
                m_tmAccess = fileInfo.LastAccessTime;
                m_tmWrite = fileInfo.LastWriteTime;

                // Assign file/path data
                m_Name = fileInfo.Name;
                m_Path = fileInfo.DirectoryName ?? "";
                if (!string.IsNullOrEmpty(m_Path) && !m_Path.EndsWith(System.IO.Path.DirectorySeparatorChar.ToString()))
                    m_Path += System.IO.Path.DirectorySeparatorChar;
                m_PathName = fileInfo.FullName;

                // Extract extension (without dot)
                m_Extension = fileInfo.Extension.TrimStart('.');

                // Short name: .NET doesn't have a direct cross-platform equivalent.
                // On Windows, we could P/Invoke, but for portability we just uppercase the name.
                m_NameShort = m_Name.ToUpperInvariant();
                m_PathNameShort = m_PathName;
                m_PathShort = m_Path;

                // Display name and type name
                m_DisplayName = System.IO.Path.GetFileNameWithoutExtension(m_Name);
                if (!string.IsNullOrWhiteSpace(m_Extension))
                    m_TypeName = m_Extension.ToUpperInvariant() + " File";
                else
                    m_TypeName = "File";
            }
            else
            {
                // Check if it's a directory
                var dirInfo = new System.IO.DirectoryInfo(m_PathName);
                if (dirInfo.Exists)
                {
                    m_FileExists = false; // It's a directory, not a file
                    m_PathExists = true;
                    m_Attributes = dirInfo.Attributes;
                    m_tmCreation = dirInfo.CreationTime;
                    m_tmAccess = dirInfo.LastAccessTime;
                    m_tmWrite = dirInfo.LastWriteTime;
                    m_Name = dirInfo.Name;
                    m_Path = dirInfo.FullName;
                }
                else
                {
                    m_FileExists = false;
                    m_PathExists = false;
                }
            }
        }
        catch
        {
            m_FileExists = false;
        }
    }

    /// <summary>
    /// Formats a DateTime as a general date string.
    /// </summary>
    public static string FormatFileDate(DateTime dt)
    {
        return dt.ToString("G");
    }

    /// <summary>
    /// Formats a file size in a human-readable format (bytes, KB, MB, GB).
    /// </summary>
    public static string FormatFileSize(long size)
    {
        const long KB = 1024;
        const long MB = KB * KB;
        const long GB = MB * KB;

        if (size < KB)
            return $"{size:#,##0} bytes";

        var sizeInKB = size / (double)KB;

        if (sizeInKB < 1000)
            return $"{sizeInKB:0} KB";

        var sizeInMB = size / (double)MB;

        if (sizeInMB < 10)
            return $"{sizeInMB:0.00} MB";
        if (sizeInMB < 100)
            return $"{sizeInMB:0.0} MB";
        if (sizeInMB < 1000)
            return $"{sizeInMB:0} MB";

        var sizeInGB = size / (double)GB;

        if (sizeInGB < 10)
            return $"{sizeInGB:0.00} GB";
        if (sizeInGB < 100)
            return $"{sizeInGB:0.0} GB";

        return $"{sizeInGB:0} GB";
    }

    // ── Private Methods ──────────────────────────────────────────────────

    /// <summary>
    /// Attempts to set new file attributes.
    /// </summary>
    private bool SetAttr(FileAttributes newAttr)
    {
        if (!m_FileExists) return false;
        try
        {
            System.IO.File.SetAttributes(m_PathName, newAttr);
            return true;
        }
        catch
        {
            return false;
        }
    }

    /// <summary>
    /// Attempts to set a file timestamp.
    /// </summary>
    private bool SetTime(DateTime newTime, FileTimes whichTime)
    {
        if (!m_FileExists) return false;
        try
        {
            switch (whichTime)
            {
                case FileTimes.CreationTime:
                    System.IO.File.SetCreationTime(m_PathName, newTime);
                    break;
                case FileTimes.LastAccessTime:
                    System.IO.File.SetLastAccessTime(m_PathName, newTime);
                    break;
                case FileTimes.LastWriteTime:
                    System.IO.File.SetLastWriteTime(m_PathName, newTime);
                    break;
                default:
                    return false;
            }
            return true;
        }
        catch
        {
            return false;
        }
    }
}
