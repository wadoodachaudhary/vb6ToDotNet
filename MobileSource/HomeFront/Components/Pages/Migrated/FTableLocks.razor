@page "/table-locks"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using System.Reflection
@using System.Text
@using HomeFront.Data
@using HomeFront.Models
@using HomeFront.Components.Pages.Migrated
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FTableLocks> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db

<PageTitle>Table Locks</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Table Locks...</div>
    </div>
}

<div class="table-locks-container" @onkeydown="OnKeyDown">

    <!-- Toolbar -->
    <div class="toolbar-cntr">
        <button class="tbar-btn btn-success" disabled="@(!mDirty)" @onclick="() => SaveData(false)">
            <span>💾</span>
            <span class="tool-label">Save</span>
        </button>
        <div class="toolbar-sep"></div>
        <button class="tbar-btn" @onclick="OnCloseClick">
            <span>✖</span>
            <span class="tool-label">Close</span>
        </button>
    </div>

    <h4 class="page-title">Table Locks</h4>

    <!-- Main Data Grid -->
    <div class="grid-container">
        <GridControl @ref="LockGrid"
                TValue="TableLockRow"
                DataSource="@LockData"
                AllowSorting="true"
                AllowResizing="true"
                AllowSelection="true"
                EnableHover="true"
                Height="100%"
                SelectionSettingsRef="@selectionSettings"
                EditSettingsRef="@editSettings"
                EventsRef="@gridEvents">
            <GridColumnsBase @key="gLockLayoutVersion">
                <GridColumn Field="@nameof(TableLockRow.RowState)" Visible="false" />
                @if (HasGridLayout)
                {
                    foreach (var entry in GetOrderedGridLayout())
                    {
                        var layout = entry.Layout;
                        var fieldName = entry.Field;
                        var columnType = entry.ColumnType;
                        var textAlign = entry.TextAlign;
                        var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                        var width = layout.Width.HasValue && layout.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;
                        var allowEdit = IsFieldEditable(fieldName);

                        <GridColumn Field="@fieldName"
                                      HeaderText="@headerText"
                                      Width="@width"
                                      Type="@columnType"
                                      TextAlign="@textAlign"
                                      AllowEditing="@allowEdit"
                                      IsPrimaryKey="@(fieldName == "Tablename")"
                                      ClipMode="ClipMode.Ellipsis" />
                    }
                }
                else
                {
                    <GridColumn Field="@nameof(TableLockRow.Locked)" HeaderText="Locked" Width="80px"
                                  Type="ColumnType.CheckBox" AllowEditing="true" TextAlign="TextAlign.Center" />
                    <GridColumn Field="@nameof(TableLockRow.Tablename)" HeaderText="Tablename" Width="200px"
                                  AllowEditing="false" IsPrimaryKey="true" />
                    <GridColumn Field="@nameof(TableLockRow.Key)" HeaderText="Key" Width="200px"
                                  AllowEditing="false" />
                    <GridColumn Field="@nameof(TableLockRow.LockDate)" HeaderText="LockDate" Width="160px"
                                  AllowEditing="false" Format="g" />
                    <GridColumn Field="@nameof(TableLockRow.User)" HeaderText="User" Width="150px"
                                  AllowEditing="false" />
                    <GridColumn Field="@nameof(TableLockRow.Workstation)" HeaderText="Workstation" Width="200px"
                                  AllowEditing="false" />
                }
            </GridColumnsBase>
        </GridControl>
    </div>

    <!-- Status bar -->
    <div class="status-bar">
        @StatusMessage
    </div>
</div>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    private const string SRCFILE = "FTableLocks::";

    // === Database ===
// === UI State ===
    private bool IsLoading = false;
    private bool mDirty = false;
    private string StatusMessage = "Ready";
    private GridControl<TableLockRow>? LockGrid;

    // === Data ===
    private List<TableLockRow> LockData = new();

    // === Grid Settings ===
    private SelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    private EditSettings editSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        ShowConfirmDialog = false
    };

    private GridControlEvents<TableLockRow> gridEvents = new();

    // === Grid layout via the shared GridLayoutPresenter ===
    // The load/resolve/order/width boilerplate lives in GridLayoutPresenter<TRow>;
    // only the VB6 form/grid name strings stay here (fidelity). gLockLayout /
    // HasGridLayout / gLockLayoutVersion below are thin delegations, so the markup is
    // unchanged. The keyed("(0)")-then-unkeyed two-call fallback that
    // LoadGridLayoutAsync used is now expressed via the ctor's instanceKey.
    //
    // DRIFT (preserved, NOT delegated): this form's GetColumnTypeForField maps bool
    // → ColumnType.CheckBox (the canonical presenter maps bool → ColumnType.Boolean),
    // and the editable "Locked" column is a real bool — delegating ColumnTypeFor /
    // GetOrdered would turn its checkbox into a plain Boolean cell. So
    // GetColumnTypeForField + GetOrderedGridLayout (and the propmap they need) stay
    // local; only Layout/Has/Version, ResolveGridField and the width converter are
    // delegated (this form's ConvertLayoutWidthToPx matches WidthPx's +16 exactly).
    private readonly GridLayoutPresenter<TableLockRow> _lockGrid =
        new("FTableLocks", "LockGrid", instanceKey: "(0)");

    private Dictionary<string, GridLayoutColumn> gLockLayout => _lockGrid.Layout;
    private bool HasGridLayout => _lockGrid.Has;
    private int gLockLayoutVersion => _lockGrid.Version;

    // === Property Map for Field Resolution (used by the local GetColumnTypeForField) ===
    private static readonly Dictionary<string, PropertyInfo> _lockRowPropMap =
        typeof(TableLockRow)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .GroupBy(p => NormalizeGridKey(p.Name))
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<TableLockRow>>(this, OnCellSaved);
        await LoadGridLayoutAsync();
        await LoadData();
    }

    // === Load Grid Layout ===
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            // The keyed/unkeyed fallback + Version bump live in the presenter
            // (its ctor was given the "FTableLocks"/"LockGrid" names + instanceKey "(0)").
            await _lockGrid.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");

        }
    }

    // === Keyboard Handler (Ctrl+S to save, Escape to close) ===
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "s" && e.CtrlKey)
        {
            await SaveData(false);
        }
        else if (e.Key == "Escape")
        {
            await OnCloseClick();
        }
    }

    // === Load Data ===
    private async Task LoadData()
    {
        IsLoading = true;
        StatusMessage = "Loading table locks...";
        StateHasChanged();

        try
        {
            LockData.Clear();

            var sql = "SELECT * FROM tablelog WHERE recordlocked = 1";
            var rows = await db.QueryAsync(sql);

            foreach (var row in rows)
            {
                LockData.Add(new TableLockRow
                {
                    Locked = true,
                    Tablename = row["tablename"]?.ToString() ?? "",
                    Key = row["keyrecord"]?.ToString() ?? "",
                    LockDate = row["lockdate"]?.ToString() ?? "",
                    User = row["user_id"]?.ToString() ?? "",
                    Workstation = row["workstation_name"]?.ToString() ?? "",
                    RowState = "CLEAN"
                });
            }

            mDirty = false;
            StatusMessage = $"Loaded {LockData.Count} locked record(s)";
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error loading data: {ex.Message}";
            Logger.LogError(ex, "[{SRCFILE}LoadData]");

        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Save Data ===
    private async Task<bool> SaveData(bool prompt)
    {
        if (!mDirty)
            return true;

        if (prompt)
        {
            var result = await Dialogs.ConfirmAsync(
                "This data has changed.\n\nDo you want to save the changes?");
            if (!result)
                return true; // User chose not to save, but allow close
        }

        IsLoading = true;
        StatusMessage = "Saving changes...";
        StateHasChanged();

        try
        {
            // Process rows in reverse order (to handle removals safely)
            var rowsToRemove = new List<TableLockRow>();

            foreach (var row in LockData)
            {
                if (row.RowState == "DIRTY" && !row.Locked)
                {
                    // Unlock: update the database record
                    var sql = @"UPDATE tablelog
                                SET recordlocked = 0
                                WHERE tablename = @Tablename
                                  AND keyrecord = @Key";
                    await db.ExecuteAsync(sql, new { row.Tablename, row.Key });

                    rowsToRemove.Add(row);
                }
            }

            // Remove unlocked rows from the grid
            foreach (var row in rowsToRemove)
            {
                LockData.Remove(row);
            }

            mDirty = false;
            StatusMessage = $"Saved. {rowsToRemove.Count} lock(s) released. {LockData.Count} lock(s) remaining.";

            if (LockGrid != null)
                await LockGrid.Refresh();

            return true;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error saving: {ex.Message}";
            Logger.LogError(ex, "[{SRCFILE}SaveData]");

            Notifications.Error($"Error saving data: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Cell Save Event (when user toggles the Locked checkbox) ===
    private void OnCellSaved(CellSaveArgs<TableLockRow> args)
    {
        if (args.Data != null && args.ColumnName == nameof(TableLockRow.Locked))
        {
            args.Data.RowState = "DIRTY";
            mDirty = true;
        }
    }

    // === Close / Unload ===
    private async Task OnCloseClick()
    {
        if (mDirty)
        {
            var saved = await SaveData(true);
            if (!saved)
                return; // User cancelled
        }

        ClosePage();
    }

    // === Grid Layout Helpers ===
    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedGridLayout()
    {
        if (!HasGridLayout) yield break;

        var ordered = gLockLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = ResolveGridField(layout.Field);
            var columnType = GetColumnTypeForField(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    private string ResolveGridField(string layoutField)
        => _lockGrid.ResolveField(layoutField);

    // DRIFT (preserved): maps bool → ColumnType.CheckBox (canonical presenter uses
    // ColumnType.Boolean). The "Locked" column is an editable checkbox, so this must
    // stay local — see the note on the presenter field above.
    private static ColumnType GetColumnTypeForField(string field)
    {
        if (string.IsNullOrWhiteSpace(field)) return ColumnType.Text;
        if (_lockRowPropMap.TryGetValue(NormalizeGridKey(field), out var prop))
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool)) return ColumnType.CheckBox;
            if (type == typeof(int) || type == typeof(long) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
        }
        return ColumnType.Text;
    }

    private static bool IsFieldEditable(string field)
    {
        return field switch
        {
            "Locked" => true,
            "RowState" => false,
            _ => false
        };
    }

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // Still used by _lockRowPropMap + the local GetColumnTypeForField.
    private static string NormalizeGridKey(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var sb = new StringBuilder(value.Length);
        foreach (var ch in value)
        {
            if (char.IsLetterOrDigit(ch))
                sb.Append(char.ToLowerInvariant(ch));
        }
        return sb.ToString();
    }

    // === Model ===
    public class TableLockRow
    {
        public bool Locked { get; set; }
        public string Tablename { get; set; } = "";
        public string Key { get; set; } = "";
        public string LockDate { get; set; } = "";
        public string User { get; set; } = "";
        public string Workstation { get; set; } = "";
        public string RowState { get; set; } = "CLEAN";
    }
}
