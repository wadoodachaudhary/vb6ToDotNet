    // ── Edit-button dispatch (STANDARD FlexKit pattern) ─────────────────
    // The grid's OnEditButtonClick fires when the user clicks a cell's edit button;
    // route by ColumnName to the same FPickList openers the old per-cell "…" buttons
    // called. args.Data is the clicked row.
    private async Task OnPayPointEditButtonClick(CellEditButtonArgs<VendorPayPoint> args)
    {
        if (args.Data == null) return;
        if (args.ColumnName.Equals("POIndex", StringComparison.OrdinalIgnoreCase))
            await OnPickPayPointPOIndex(args.Data);
