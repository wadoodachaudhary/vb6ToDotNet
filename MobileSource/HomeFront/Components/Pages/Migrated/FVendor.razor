    // ── Insurance field resolution (layout colkey "required" → Req etc.) ─
    // NOT delegated to GridLayoutPresenter.ResolveField: this is a bespoke literal
    // if-chain (no exact-property / normalized-prop-map fallback), so its behavior
    // diverges from the presenter's resolver. Left as-is to preserve FVendor semantics.
    private static string ResolveInsuranceField(string field)
    {
        if (string.IsNullOrWhiteSpace(field)) return "";
        var n = field.Trim();
        if (n.Equals("required", StringComparison.OrdinalIgnoreCase) || n.Equals("req", StringComparison.OrdinalIgnoreCase))
            return nameof(InsuranceRequirement.Req);
        if (n.Equals("name", StringComparison.OrdinalIgnoreCase))
            return nameof(InsuranceRequirement.Name);
        if (n.Equals("expirydate", StringComparison.OrdinalIgnoreCase) || n.Equals("expiry date", StringComparison.OrdinalIgnoreCase))
            return nameof(InsuranceRequirement.ExpiryDate);
        if (n.Equals("company", StringComparison.OrdinalIgnoreCase))
            return nameof(InsuranceRequirement.Company);
        if (n.Equals("policynumber", StringComparison.OrdinalIgnoreCase) || n.Equals("policy number", StringComparison.OrdinalIgnoreCase))
            return nameof(InsuranceRequirement.PolicyNumber);
        return n;
    }

    // ── Contacts field resolution (layout colkeys → props) ─
    // Canonical exact→normalized→alias→literal resolution; delegated to the gContacts
    // presenter (its ctor was given the VendorContact alias map). The prop-map,
    // alias dict and key-normalizer that used to live here are now absorbed by the
    // presenter.
    private string ResolveContactField(string field)
        => _contactsGrid.ResolveField(field);

    private static bool IsContactCheckboxField(string field)
    {
        return field.Equals(nameof(VendorContact.PONotice), StringComparison.OrdinalIgnoreCase)
            || field.Equals(nameof(VendorContact.FPONotice), StringComparison.OrdinalIgnoreCase)
            || field.Equals(nameof(VendorContact.SchedNotice), StringComparison.OrdinalIgnoreCase)
            || field.Equals(nameof(VendorContact.ServiceNotice), StringComparison.OrdinalIgnoreCase);
    }

    private static bool ToBool(object? value)
    {
        if (value == null || value == DBNull.Value) return false;
        if (value is bool b) return b;
        var s = value.ToString()?.Trim();
        if (string.IsNullOrEmpty(s)) return false;
        if (s.Equals("true", StringComparison.OrdinalIgnoreCase) ||
            s.Equals("yes", StringComparison.OrdinalIgnoreCase) ||
            s.Equals("y", StringComparison.OrdinalIgnoreCase) ||
            s == "1" || s == "-1") return true;
        if (int.TryParse(s, out var i)) return i != 0;
        return false;
    }

    private static string GetRowString(IDictionary<string, object> row, string key)
    {
        if (row.TryGetValue(key, out var v)) return v?.ToString() ?? "";
        foreach (var kvp in row)
            if (string.Equals(kvp.Key, key, StringComparison.OrdinalIgnoreCase))
                return kvp.Value?.ToString() ?? "";
        return "";
    }

    // ═══════════════════════════════════════════════════════════════════
    // ── LoadData (VB6 LoadData) ─────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════
    private async Task LoadDataAsync()
    {
        if (string.IsNullOrEmpty(mVendor))
        {
            ClearForm();
            return;
        }

        var sql = @"
            SELECT wp.walletid AS WalletPayeeID, v.*
            FROM tblVendors v
            JOIN divisions d ON v.divisionid = d.divisionid
            LEFT JOIN datasources ds ON d.bookofaccount = ds.bookofaccount
            LEFT JOIN wallet_payees wp ON wp.datasourceid = ds.datasourceid
                                      AND wp.payeeid = v.vendor_id
            WHERE v.Vendor_ID = @VendorId
              AND v.divisionid = @DivisionId";
        var parameters = new { VendorId = mVendor, DivisionId = SessionState.DivisionID };
        var results = await db.QueryAsync(sql, parameters);
        if (!results.Any())
        {
            ClearForm();
            return;
        }
        var row = results.First();
        IsReadOnly = false;

        VendorId = row["Vendor_ID"]?.ToString() ?? "";
        Description = row["Vendor_Name"]?.ToString() ?? "";
        VendorDesc = $"{Description} ({VendorId})";
        // VB6: txtAddress = Addr1 & vbCrLf & Addr2 — but the UI splits into two
        // single-line boxes; keep Address=Addr1, Address2=Addr2 for the save.
        Address = row["Addr1"]?.ToString() ?? "";
        Address2 = row["Addr2"]?.ToString() ?? "";
        City = row["city"]?.ToString() ?? "";
        Province = row["state"]?.ToString() ?? "";
        Postal = row["zip"]?.ToString() ?? "";
        Phone = row["phone"]?.ToString() ?? "";
        Fax = row["fax"]?.ToString() ?? "";
        // bit columns come back as actual bool; ToBool also tolerates "true"/null.
        IsTBD = ToBool(row["isTBD"]);
        IsBuildPro = ToBool(row["BuildProEnabled"]);
        WebUID = row["WebUID"]?.ToString() ?? "";
        WebPWD = row["password"]?.ToString() ?? "";
        WalletPayeeID = row["WalletPayeeID"]?.ToString() ?? "";
        TaxID = row["TaxID"]?.ToString() ?? "";
        Status = ToBool(row["Inactive"]) ? "Inactive" : "Active";
        TradeType = row["VendorGroupID"]?.ToString() ?? "";
        if (!string.IsNullOrEmpty(TradeType) && !TradeTypes.Contains(TradeType))
            TradeTypes.Add(TradeType);
        POFormat = row["POFormat"]?.ToString() ?? "";
        if (!string.IsNullOrEmpty(POFormat) && !POFormats.Contains(POFormat))
            POFormats.Add(POFormat);
        HoldbackPercent = (int)Math.Round(Convert.ToDouble(row["HoldbackPercentage"] ?? 0));

        // Insurance (4 fixed rows: General / Workers / Umbrella / Automobile)
        InsuranceData = new List<InsuranceRequirement>
        {
            new() { Name = "General Liability", Req = ToBool(row["glinsrequired"]),
                ExpiryDate = row["glinsexpdate"] as DateTime?,
                Company = row["GLInsCompany"]?.ToString(),
                PolicyNumber = row["GLInsPolicyNumber"]?.ToString() },
            new() { Name = "Workers Comp", Req = ToBool(row["wcinsrequired"]),
                ExpiryDate = row["wcinsexpdate"] as DateTime?,
                Company = row["WCInsCompany"]?.ToString(),
                PolicyNumber = row["WCInsPolicyNumber"]?.ToString() },
            new() { Name = "Umbrella", Req = ToBool(row["umbinsrequired"]),
                ExpiryDate = row["umbinsexpdate"] as DateTime?,
                Company = row["UmbInsCompany"]?.ToString(),
                PolicyNumber = row["UmbInsPolicyNumber"]?.ToString() },
            new() { Name = "Automobile", Req = ToBool(row["autoinsrequired"]),
                ExpiryDate = row["autoinsexpdate"] as DateTime?,
                Company = row["AutoInsCompany"]?.ToString(),
                PolicyNumber = row["AutoInsPolicyNumber"]?.ToString() }
        };

        // Tax Groups: row 1 = "-- vendor defaults --" (from tblVendors cols),
        // then per-community rows, then a trailing blank "new" row.
        TaxGroupsData.Clear();
        TaxGroupsData.Add(new TaxGroupRow
        {
            IsDefaultsRow = true,
            Community = "",
            CommunityDescription = " -- vendor defaults --",
            Labour = row["LabourTaxGroup"]?.ToString(),
            Material = row["MaterialTaxGroup"]?.ToString(),
            SubContract = row["SubContractTaxGroup"]?.ToString(),
            Equipment = row["EquipmentTaxGroup"]?.ToString(),
            Overhead = row["OverheadTaxGroup"]?.ToString(),
            Other = row["OtherTaxGroup"]?.ToString()
        });

        var taxSql = @"
            SELECT t.community, c.description,
                   t.MaterialTaxGroup, t.LabourTaxGroup,
                   t.SubContractTaxGroup, t.EquipmentTaxGroup,
                   t.OverheadTaxGroup, t.OtherTaxGroup
            FROM vendortaxgroups t
            JOIN tbllocality c ON t.Community = c.area
            WHERE t.vendor = @Vendor";
        var taxResults = await db.QueryAsync(taxSql, new { Vendor = mVendor });
        foreach (var taxRow in taxResults)
        {
            TaxGroupsData.Add(new TaxGroupRow
            {
                Community = taxRow["community"]?.ToString(),
                CommunityDescription = taxRow["description"]?.ToString(),
                Material = taxRow["MaterialTaxGroup"]?.ToString(),
                Labour = taxRow["LabourTaxGroup"]?.ToString(),
                SubContract = taxRow["SubContractTaxGroup"]?.ToString(),
                Equipment = taxRow["EquipmentTaxGroup"]?.ToString(),
                Overhead = taxRow["OverheadTaxGroup"]?.ToString(),
                Other = taxRow["OtherTaxGroup"]?.ToString()
            });
        }
        TaxGroupsData.Add(new TaxGroupRow { IsNewRow = true });

        await LoadPayPointsAsync();
        await LoadContactsAsync();
        mDirty = false;
        StateHasChanged();
    }

    private async Task LoadPayPointsAsync()
    {
        var sql = @"SELECT * FROM VendorPaymentPoints
                    WHERE DivisionID = @DivisionID AND Vendor = @Vendor
                    ORDER BY POIndex";
        var results = await db.QueryAsync(sql, new { SessionState.DivisionID, Vendor = mVendor });
        PayPoints = new();
        foreach (var row in results)
        {
            PayPoints.Add(new VendorPayPoint
            {
                POIndex = row["POIndex"]?.ToString() ?? "",
                PayPoint1Percent = Convert.ToDouble(row["PayPoint1Percent"] ?? 0),
                PayPoint2Percent = Convert.ToDouble(row["PayPoint2Percent"] ?? 0),
                PayPoint3Percent = Convert.ToDouble(row["PayPoint3Percent"] ?? 0),
                PayPoint4Percent = Convert.ToDouble(row["PayPoint4Percent"] ?? 0),
                PayPoint5Percent = Convert.ToDouble(row["PayPoint5Percent"] ?? 0)
            });
        }
    }

    private async Task LoadContactsAsync()
    {
        var sql = @"SELECT * FROM contacts
                    WHERE DivisionID = @DivisionID AND contacttypeid=99
                    AND vendorcode = @Vendor
                    ORDER BY firstname";
        var results = await db.QueryAsync(sql, new { SessionState.DivisionID, Vendor = mVendor });
        Contacts = new();
        foreach (var row in results)
        {
            Contacts.Add(new VendorContact
            {
                ContactID = row["ContactID"]?.ToString() ?? "",
                Role = row["Role"]?.ToString() ?? "",
                Name = row["FirstName"]?.ToString() ?? "",
                Phone = row["WorkPhone"]?.ToString() ?? "",
                Cell = row["CellPhone"]?.ToString() ?? "",
                Fax = row["Fax"]?.ToString() ?? "",
                Email = row["Email"]?.ToString() ?? "",
                SendVia = Convert.ToInt32(row["CommModeID"] ?? 0),
                SmsAddress = row["SMSAddress"]?.ToString() ?? "",
                PONotice = ToBool(row["PONotice"]),
                FPONotice = ToBool(row["FPONotice"]),
                SchedNotice = ToBool(row["SchedNotice"]),
                ServiceNotice = ToBool(row["ServiceNotice"])
            });
        }
    }

    private void ClearForm()
    {
        IsReadOnly = true;
        VendorId = "";
        Description = "";
        Address = "";
        Address2 = "";
        City = "";
        Province = "";
        Postal = "";
        Phone = "";
        Fax = "";
        IsTBD = false;
        IsBuildPro = true;   // VB6: chkBuildPro.Value = vbChecked on empty
        WebUID = "";
        WebPWD = "";
        WalletPayeeID = "";
        TaxID = "";
        Status = "Active";
        TradeType = "";
