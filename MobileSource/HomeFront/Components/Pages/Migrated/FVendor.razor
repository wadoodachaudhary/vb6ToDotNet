@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - Initial port from VB6
     - 2026-06-11 Audit + fidelity pass against FVendor.frm:
         • raw HTML inputs → FlexKit controls (TextBoxControl /
           TextAreaControl / DropDownListControl / CheckBoxControl /
           NumericTextBoxControl)
         • gContacts / gInsurance / gPayPoints grids made editable
           (EditSettings + SelectionSettings + OnCellSave), columns
           still built dynamically from AppGridLayout (IniGetGrid)
         • in-cell "…" pickers wired (gPayPoints.POIndex,
           gTaxGroups.Community + tax-group columns) via FPickList
         • full SaveData ported (tblVendors UPDATE incl. insurance ×16
           + tax-group defaults ×6, vendortaxgroups rewrite,
           SavePayPoints, SaveContacts) — all parameterized
         • mDirty tracking + holdback clamp + cmdNav Prev/Next save
   ───────────────────────────────────────────────────────────────── *@
@page "/vendor"

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Dynamic
@using System.Globalization
@using System.Collections.Generic
@using System.IO
@using System.Linq
@using Microsoft.AspNetCore.Hosting
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using HomeFront.Data

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<FVendor> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject IWebHostEnvironment Env
@using HomeFront.Models
@inject DbWrapperSqlServer db
@layout HFComponent
<PageTitle>Vendor</PageTitle>

<div class="vendor-page">
@* ── Toolbar (VB6 Toolbar_ButtonClick — Open / Save / ExcelImport / ExcelExport) ── *@
<div class="toolbar-cntr">
    <button class="tbar-btn" @onclick="OnOpenClick" title="Open Vendor (Ctrl+O)">
        <img src="images/32/open.ico" class="tbar-icon" onerror="this.style.display='none'" />
        <span class="tool-label">Open</span>
    </button>
    <button class="tbar-btn" @onclick="OnSaveClick" title="Save (Ctrl+S)" disabled="@(!mDirty)">
        <img src="images/32/save.ico" class="tbar-icon" onerror="this.style.display='none'" />
        <span class="tool-label">Save</span>
    </button>
    <button class="tbar-btn" @onclick="OnImportClick" title="Import Vendors from Excel">
        <img src="images/32/excelimport.ico" class="tbar-icon" onerror="this.style.display='none'" />
        <span class="tool-label">Import</span>
    </button>
    <button class="tbar-btn" @onclick="OnExportClick" title="Export Vendors to Excel">
        <img src="images/32/excelexport.ico" class="tbar-icon" onerror="this.style.display='none'" />
        <span class="tool-label">Export</span>
    </button>
</div>

@if (!string.IsNullOrEmpty(_layoutFallbackMsg))
{
    <div class="fx-vendor-fallback">@_layoutFallbackMsg</div>
}

@* VB6 FVendor.Form_Load immediately pops the vendor picklist on entry (auto-opened below in
   OnAfterRenderAsync). If the user picks nothing, mVendor stays empty and this layout just
   renders blank — an empty Vendor page. (The old "load vendors" placeholder was removed.) *@
<div class="vendor-layout fx-vendor">
    <!-- Left Panel: Vendor Details -->
    <div class="vendor-left">
        <div class="form-row">
            <label class="bold">Vendor</label>
            <TextBoxControl Value="@VendorId" Enabled="false" CssClass="field-input" />
        </div>
        <div class="form-row">
            <label>Company Name</label>
            <TextBoxControl Value="@Description" ValueChanged="OnDescriptionChanged" Enabled="@(!_detailsLocked)" MaxLength="60" CssClass="field-input" />
        </div>

        <div class="form-row">
            <label></label>
            <div style="display: flex; align-items: center; min-height: 20px;">
                <CheckBoxControl Checked="@IsTBD" CheckedChanged="OnIsTBDChanged" Disabled="@IsReadOnly" Label="TBD - budget planning only" />
            </div>
        </div>
        <div class="form-row">
            <label></label>
            <div style="display: flex; align-items: center; min-height: 20px;">
                <CheckBoxControl Checked="@IsBuildPro" CheckedChanged="OnIsBuildProChanged" Disabled="@IsReadOnly" Label="BuildPro Vendor" />
            </div>
        </div>

        <div class="form-row" style="margin-top: 6px;">
            <label class="bold">Address</label>
            <TextBoxControl Value="@Address" ValueChanged="OnAddressChanged" Enabled="@(!_detailsLocked)" CssClass="field-input" />
        </div>
        <div class="form-row">
            <label></label>
            <TextBoxControl Value="@Address2" ValueChanged="OnAddress2Changed" Enabled="@(!_detailsLocked)" CssClass="field-input" />
        </div>
        <div class="form-row">
            <label>City</label>
            <TextBoxControl Value="@City" ValueChanged="OnCityChanged" Enabled="@(!_detailsLocked)" MaxLength="50" CssClass="field-input" />
        </div>
        <div class="form-row">
            <label>State/Province</label>
            <TextBoxControl Value="@Province" ValueChanged="OnProvinceChanged" Enabled="@(!_detailsLocked)" MaxLength="20" CssClass="field-input" />
        </div>
        <div class="form-row">
            <label>Postal</label>
            <TextBoxControl Value="@Postal" ValueChanged="OnPostalChanged" Enabled="@(!_detailsLocked)" MaxLength="10" CssClass="field-input field-short" />
        </div>
        <div class="form-row">
            <label>Phone</label>
            <TextBoxControl Value="@Phone" ValueChanged="OnPhoneChanged" Enabled="@(!_detailsLocked)" MaxLength="25" CssClass="field-input field-short" />
        </div>
        <div class="form-row">
            <label>Fax</label>
            <TextBoxControl Value="@Fax" ValueChanged="OnFaxChanged" Enabled="@(!_detailsLocked)" MaxLength="25" CssClass="field-input field-short" />
        </div>
        <div class="form-row">
            <label>Status</label>
            <DropDownListControl TValue="string" TItem="string"
                                 DataSource="@StatusItems"
                                 Value="@Status"
                                 ValueChanged="OnStatusChanged"
                                 Enabled="@(!IsReadOnly)"
                                 CssClass="field-input field-med" Width="120px" />
        </div>
        <div class="form-row" style="margin-bottom: 24px;">
            <label>Retainage %</label>
            <NumericTextBoxControl TValue="int"
                                   Value="@HoldbackPercent"
                                   ValueChanged="OnHoldbackChanged"
                                   Min="0" Max="100" Step="1"
                                   Enabled="@(!IsReadOnly)"
                                   CssClass="field-input field-short" Width="70px" />
        </div>
        @if (!string.IsNullOrEmpty(WalletPayeeID))
        {
            @* VB6 LoadData: txtWalletPayeeID/lblWalletPayeeID visible only when set *@
            <div class="form-row">
                <label>Payee ID</label>
                <TextBoxControl Value="@WalletPayeeID" Enabled="false" CssClass="field-input" />
            </div>
        }
        <div class="form-row">
            <label>Tax ID</label>
            <TextBoxControl Value="@TaxID" Enabled="false" CssClass="field-input field-short" />
        </div>
        <div class="form-row">
            <label>Trade Type</label>
            <DropDownListControl TValue="string" TItem="string"
                                 DataSource="@TradeTypes"
                                 Value="@TradeType"
                                 ValueChanged="OnTradeTypeChanged"
                                 AllowFiltering="true"
                                 Enabled="@(!IsReadOnly)"
                                 CssClass="field-input" Width="100%" />
        </div>
        <div class="form-row">
            <label>PO Format</label>
            <DropDownListControl TValue="string" TItem="string"
                                 DataSource="@POFormats"
                                 Value="@POFormat"
                                 ValueChanged="OnPOFormatChanged"
                                 Enabled="@(!IsReadOnly)"
                                 CssClass="field-input" Width="100%" />
        </div>

        <h4 class="section-title" style="margin-top: 24px;">Web Portal</h4>
        <div class="form-row">
            <label>Login ID</label>
            <TextBoxControl Value="@WebUID" ValueChanged="OnWebUIDChanged" Enabled="@(!IsReadOnly)" MaxLength="40" CssClass="field-input field-short" />
        </div>
        <div class="form-row">
            <label>Password</label>
            <TextBoxControl Value="@WebPWD" ValueChanged="OnWebPWDChanged" Enabled="@(!IsReadOnly)" MaxLength="20" CssClass="field-input field-short" />
        </div>
    </div>

    <!-- Right Panel: Grids -->
    <div class="vendor-right">
        <h4 class="section-title">Contacts</h4>
        <div class="contacts-grid">
            <GridControl @ref="gContacts" TValue="VendorContact" DataSource="@Contacts"
                         AllowSorting="true" AllowResizing="true" EnableHover="true" Height="220px" RowHeight="20"
                         SelectionSettingsRef="@_contactsSelection"
                         EditSettingsRef="@_contactsEdit"
                         NewItemFactory="CreateContactRow"
                         EnsureTrailingNewRow="true"
                         IsTrailingNewRow="IsContactEmpty"
                         AddNewRowOnLastCellExit="true"
                         CanAddNewRowOnLastCellExit="CanAppendContactRowAfter"
                         EventsRef="@_contactsEvents"
                         OnLayoutChanged="@OnContactsLayoutChangedAsync">
                <GridColumnsBase @key="gContactsLayoutVersion" DebugTag="FVendor-gContacts">
                @if (HasContactsLayout)
                {
                    foreach (var col in GetOrderedLayout(gContactsLayout))
                    {
                        var headerText = string.IsNullOrWhiteSpace(col.Caption) ? col.Field : col.Caption;
                        var width = col.Width.HasValue && col.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(col.Width.Value)}px" : "120px";
                        var resolvedField = ResolveContactField(col.Field);
                        var isCheckbox = IsContactCheckboxField(resolvedField);
                        if (isCheckbox)
                        {
                            <GridColumn Field="@resolvedField" HeaderText="@headerText" Width="@width"
                                          Type="ColumnType.CheckBox" AllowEditing="@(!IsReadOnly)" />
                        }
                        else if (string.Equals(resolvedField, nameof(VendorContact.SendVia), StringComparison.OrdinalIgnoreCase))
                        {
                            @* HHM-475: Send Via shows the NAME and edits via a Print/Email/Fax
                               dropdown (VB6 ColComboList "#1;Print|#3;Email|#4;Fax"); the code
                               round-trips through VendorContact.SendViaText. *@
                            <GridColumn Field="@nameof(VendorContact.SendViaText)" HeaderText="@headerText" Width="@width"
                                          AllowEditing="@(!IsReadOnly)" EditOptions="@SendViaOptions" />
                        }
                        else if (string.Equals(resolvedField, nameof(VendorContact.SmsAddress), StringComparison.OrdinalIgnoreCase))
                        {
                            <GridColumn Field="@nameof(VendorContact.SmsAddress)" HeaderText="@headerText" Width="@width"
                                          AllowEditing="@(!IsReadOnly)"
                                          EditOptions="@SmsCarrierOptions" />
                        }
                        else
                        {
                            <GridColumn Field="@resolvedField" HeaderText="@headerText" Width="@width"
                                          AllowEditing="@(!IsReadOnly)" />
                        }
                    }
                }
                else
                {
                    <GridColumn Field="@nameof(VendorContact.Role)" HeaderText="Role" Width="100px" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="@nameof(VendorContact.Name)" HeaderText="Name" Width="140px" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="@nameof(VendorContact.Phone)" HeaderText="Phone" Width="120px" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="@nameof(VendorContact.Cell)" HeaderText="Mobile" Width="120px" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="@nameof(VendorContact.Email)" HeaderText="Email" Width="180px" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="@nameof(VendorContact.PONotice)" HeaderText="Purchasing" Width="90px" Type="ColumnType.CheckBox" />
                    <GridColumn Field="@nameof(VendorContact.FPONotice)" HeaderText="Field PO" Width="90px" Type="ColumnType.CheckBox" />
                    <GridColumn Field="@nameof(VendorContact.SchedNotice)" HeaderText="Scheduling" Width="100px" Type="ColumnType.CheckBox" />
                    <GridColumn Field="@nameof(VendorContact.ServiceNotice)" HeaderText="Service" Width="100px" Type="ColumnType.CheckBox" />
                    @* HHM-14/HHM-475: show the Send-Via NAME and edit via a Print/Email/Fax
                       dropdown; SendViaText round-trips the CommModeID code. *@
                    <GridColumn Field="@nameof(VendorContact.SendViaText)" HeaderText="Send Via" Width="80px"
                                AllowEditing="@(!IsReadOnly)" EditOptions="@SendViaOptions" />
                    <GridColumn Field="@nameof(VendorContact.Fax)" HeaderText="Fax" Width="120px" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="@nameof(VendorContact.SmsAddress)" HeaderText="SMS Provider" Width="140px"
                                AllowEditing="@(!IsReadOnly)" EditOptions="@SmsCarrierOptions" />
                }
                </GridColumnsBase>
            </GridControl>
        </div>

        <h4 class="section-title">Contract Payment Points</h4>
        <GridControl @ref="gPayPoints" TValue="VendorPayPoint" DataSource="@PayPoints"
                     AllowSorting="true" AllowResizing="true" EnableHover="true" Height="90px" RowHeight="20"
                     SelectionSettingsRef="@_payPointsSelection"
                     EditSettingsRef="@_payPointsEdit"
                     NewItemFactory="CreatePayPointRow"
                     EnsureTrailingNewRow="true"
                     IsTrailingNewRow="IsPayPointEmpty"
                     AddNewRowOnLastCellExit="true"
                     CanAddNewRowOnLastCellExit="CanAppendPayPointRowAfter"
                     EventsRef="@_payPointsEvents"
                     OnLayoutChanged="@OnPayPointsLayoutChangedAsync">
            <GridColumnsBase @key="gPayPointsLayoutVersion" DebugTag="FVendor-gPayPoints">
                @if (HasPayPointsLayout)
                {
                    foreach (var col in GetOrderedLayout(gPayPointsLayout))
                    {
                        var headerText = string.IsNullOrWhiteSpace(col.Caption) ? col.Field : col.Caption;
                        var width = col.Width.HasValue && col.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(col.Width.Value)}px" : "110px";
                        var isPoIndex = col.Field.Equals("POIndex", StringComparison.OrdinalIgnoreCase);
                        if (isPoIndex)
                        {
                            @* VB6 gPayPoints_CellButtonClick / BeforeEdit: POIndex column
                               has ComboList = "..." → opens FPickList over tblpoindex.
                               STANDARD FlexKit edit button (AlwaysShowEditButton) replaces the
                               hand-rolled span+… template; the cell shows row.POIndex (the same
                               raw property Field binds) and OnGridEditButtonClick → OnPickPayPointPOIndex,
                               which no-ops when read-only (VB6 disabled-button parity). *@
                            <GridColumn Field="@col.Field" HeaderText="@headerText" Width="@width"
                                          AllowEditing="false"
                                          ShowEditButton="true" AlwaysShowEditButton="true"
                                          ClipMode="ClipMode.Ellipsis" />
                        }
                        else
                        {
                            <GridColumn Field="@col.Field" HeaderText="@headerText" Width="@width"
                                          Type="ColumnType.Number" TextAlign="TextAlign.Right"
                                          AllowEditing="@(!IsReadOnly)" />
                        }
                    }
                }
                else
                {
                    <GridColumn Field="@nameof(VendorPayPoint.POIndex)" HeaderText="POIndex" Width="180px"
                                  AllowEditing="false"
                                  ShowEditButton="true" AlwaysShowEditButton="true"
                                  ClipMode="ClipMode.Ellipsis" />
                    <GridColumn Field="@nameof(VendorPayPoint.PayPoint1Percent)" HeaderText="Pmt 1" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="@nameof(VendorPayPoint.PayPoint2Percent)" HeaderText="Pmt 2" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="@nameof(VendorPayPoint.PayPoint3Percent)" HeaderText="Pmt 3" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="@nameof(VendorPayPoint.PayPoint4Percent)" HeaderText="Pmt 4" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="@nameof(VendorPayPoint.PayPoint5Percent)" HeaderText="Pmt 5" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="@(!IsReadOnly)" />
                }
            </GridColumnsBase>
        </GridControl>

        @* VB6 gTaxGroups is NOT IniGetGrid — columns are design-time hardcoded
           (Community / CommunityDescription + 6 tax-group cells). The
           CommunityDescription cell and each tax-group cell open FPickList. *@
        <h4 class="section-title">Tax Groups</h4>
        <GridControl @ref="TaxGroupsGrid" TValue="TaxGroupRow" DataSource="@TaxGroupsData"
                     AllowSorting="false" AllowResizing="true" EnableHover="true" Height="95px" RowHeight="20"
                     SelectionSettingsRef="@_taxGroupsSelection"
                     EditSettingsRef="@_taxGroupsEdit"
                     EventsRef="@_taxGroupsEvents">
            <GridColumnsBase>
                <GridColumn Field="Community" HeaderText="Community" Width="110px" AllowEditing="false" />
                @* VB6 gTaxGroups_CellButtonClick Community case: STANDARD FlexKit edit button
                   replaces the hand-rolled span+… template. The cell shows row.CommunityDescription
                   (the same raw property Field binds); the button is gated per-row to mirror the
                   VB6 render condition (visible when !ReadOnly && not the "vendor defaults" row —
                   i.e. picker rows + the trailing new row), routed via OnGridEditButtonClick →
                   OnPickTaxGroupCommunity. *@
                <GridColumn Field="CommunityDescription" HeaderText="Description" Width="220px"
                              AllowEditing="false"
                              ShowEditButton="true" AlwaysShowEditButton="true"
                              ShowEditButtonPredicate="@(o => !IsReadOnly && !((TaxGroupRow)o).IsDefaultsRow)"
                              ClipMode="ClipMode.Ellipsis" />
                @foreach (var fld in TaxGroupCostFields)
                {
                    var f = fld;
                    @* VB6 gTaxGroups_CellButtonClick Else case: STANDARD FlexKit edit button per
                       cost column. The cell shows the bound property (GetTaxGroupCell returns the
                       same row.<f> value Field binds); per-row gate matches VB6 (visible when
                       !ReadOnly && not the trailing new row). OnGridEditButtonClick routes by
                       args.ColumnName (= f) to OnPickTaxGroupValue(row, f). *@
                    <GridColumn Field="@f" HeaderText="@f" Width="110px"
                                  AllowEditing="false"
                                  ShowEditButton="true" AlwaysShowEditButton="true"
                                  ShowEditButtonPredicate="@(o => !IsReadOnly && !((TaxGroupRow)o).IsNewRow)"
                                  ClipMode="ClipMode.Ellipsis" />
                }
            </GridColumnsBase>
        </GridControl>

        <h4 class="section-title">Insurance</h4>
        <GridControl @ref="gInsurance" TValue="InsuranceRequirement" DataSource="@InsuranceData"
                     AllowSorting="false" AllowResizing="true" EnableHover="true" Height="115px" RowHeight="20"
                     SelectionSettingsRef="@_insuranceSelection"
                     EditSettingsRef="@_insuranceEdit"
                     EventsRef="@_insuranceEvents"
                     OnLayoutChanged="@OnInsuranceLayoutChangedAsync">
            <GridColumnsBase @key="gInsuranceLayoutVersion" DebugTag="FVendor-gInsurance">
                @if (HasInsuranceLayout)
                {
                    foreach (var col in GetOrderedLayout(gInsuranceLayout))
                    {
                        var headerText = string.IsNullOrWhiteSpace(col.Caption) ? col.Field : col.Caption;
                        var width = col.Width.HasValue && col.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(col.Width.Value)}px" : "140px";
                        var resolved = ResolveInsuranceField(col.Field);
                        var isCheckbox = resolved.Equals(nameof(InsuranceRequirement.Req), StringComparison.OrdinalIgnoreCase);
                        var isName = resolved.Equals(nameof(InsuranceRequirement.Name), StringComparison.OrdinalIgnoreCase);
                        var isExpiryDate = resolved.Equals(nameof(InsuranceRequirement.ExpiryDate), StringComparison.OrdinalIgnoreCase);
                        if (isCheckbox)
                        {
                            <GridColumn Field="@resolved" HeaderText="@headerText" Width="@width"
                                          Type="ColumnType.CheckBox" AllowEditing="@(!IsReadOnly)" />
                        }
                        else if (isExpiryDate)
                        {
                            <GridColumn Field="@resolved" HeaderText="@headerText" Width="@width"
                                          Type="ColumnType.Date" Format="MM/dd/yyyy"
                                          OpenDateCalendarOnDoubleClick="true"
                                          AllowEditing="@(!IsReadOnly)" />
                        }
                        else
                        {
                            @* VB6 gInsurance_BeforeEdit: Cancel = Col=0 (Name column read-only). *@
                            <GridColumn Field="@resolved" HeaderText="@headerText" Width="@width"
                                          AllowEditing="@(!IsReadOnly && !isName)" />
                        }
                    }
                }
                else
                {
                    <GridColumn Field="Name" HeaderText="Name" Width="140px" AllowEditing="false" />
                    <GridColumn Field="Req" HeaderText="Req" Width="60px" Type="ColumnType.CheckBox" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="ExpiryDate" HeaderText="Expiry Date" Type="ColumnType.Date" Format="MM/dd/yyyy" Width="120px"
                                OpenDateCalendarOnDoubleClick="true" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="Company" HeaderText="Company" Width="160px" AllowEditing="@(!IsReadOnly)" />
                    <GridColumn Field="PolicyNumber" HeaderText="Policy Number" Width="160px" AllowEditing="@(!IsReadOnly)" />
                }
            </GridColumnsBase>
        </GridControl>

        <div class="nav-buttons">
            <ButtonControl BareStyle="true" OnClick="PreviousClick">&lt;&lt; Previous</ButtonControl>
            <ButtonControl BareStyle="true" OnClick="NextClick">Next &gt;&gt;</ButtonControl>
        </div>
    </div>
</div>

@* FPickList lives at the component root so the Open handler can launch
   it regardless of whether a vendor is currently loaded. The same
   instance is reused for every pick (Open vendor list, POIndex,
   Community, Tax Group) — _pickContext routes the callback. *@
<FPickList @ref="vendorPickList" OnSelected="OnVendorPickListSelected" />

@* VB6 SaveData(prompt:=True) → MsgBox(..., vbYesNoCancel). Mirrors FPOIndex's
   cancel-with-changes prompt. Reused for every exit path (Open / Save / Prev /
   Next) that calls SaveDataAsync(prompt: true). *@
<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />
</div>

@code {
    [Parameter] public string? VendorIdParam { get; set; }
    private string mVendor = "";
    // HHM-433: VB6 FVendor.frm:1244 Form_Load sets ReadOnly=True — the blank form
    // starts read-only until a vendor loads (LoadDataAsync clears it). Cancelling the
    // initial picker leaves a disabled blank form, matching VB6 (Unload commented out).
    private bool IsReadOnly = true;
    // VB6 ReadOnly Let: txtDescription/Address/City/... are also Locked when
    // an accounting system is configured. AccountingSystem support isn't
    // migrated yet, so _detailsLocked mirrors only the ReadOnly half (no
    // accounting lock) — equals IsReadOnly today.
    private bool _detailsLocked => IsReadOnly;
    private bool mDirty = false;

    // === IniGetGrid constants and layout state ===
    // The load + Version bump live in the shared GridLayoutPresenter<TRow>; the VB6
    // form/grid name strings + the gContacts alias map stay here for fidelity, and
    // gXxxLayout / HasXxxLayout / gXxxLayoutVersion below are thin delegations so the
    // markup is unchanged. NOTE: GetOrderedLayout(dict) and ResolveInsuranceField are
    // deliberately NOT delegated — GetOrderedLayout returns a raw IEnumerable<GridLayoutColumn>
    // (a different shape than the presenter's tuple GetOrdered) and is shared by all
    // three grids from markup; ResolveInsuranceField is a bespoke if-chain with no
    // exact-property/normalized-map fallback. Left as-is to preserve FVendor semantics.
    private const string FormName = "FVendor";
    private string _layoutFallbackMsg = "";

    private readonly GridLayoutPresenter<VendorContact> _contactsGrid =
        new(FormName, "gContacts", grouped: true,
            aliases: new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["purchasing"] = nameof(VendorContact.PONotice),
                ["fieldpo"] = nameof(VendorContact.FPONotice),
                ["fieldponotice"] = nameof(VendorContact.FPONotice),
                ["scheduling"] = nameof(VendorContact.SchedNotice),
                ["service"] = nameof(VendorContact.ServiceNotice),
                ["smsprovider"] = nameof(VendorContact.SmsAddress),
                ["smsaddress"] = nameof(VendorContact.SmsAddress)
            });
    private readonly GridLayoutPresenter<InsuranceRequirement> _insuranceGrid =
        new(FormName, "gInsurance");
    private readonly GridLayoutPresenter<VendorPayPoint> _payPointsGrid =
        new(FormName, "gPayPoints");

    private Dictionary<string, GridLayoutColumn> gContactsLayout => _contactsGrid.Layout;
    private int gContactsLayoutVersion => _contactsGrid.Version;
    private bool HasContactsLayout => _contactsGrid.Has;

    private Dictionary<string, GridLayoutColumn> gInsuranceLayout => _insuranceGrid.Layout;
    private int gInsuranceLayoutVersion => _insuranceGrid.Version;
    private bool HasInsuranceLayout => _insuranceGrid.Has;

    private Dictionary<string, GridLayoutColumn> gPayPointsLayout => _payPointsGrid.Layout;
    private int gPayPointsLayoutVersion => _payPointsGrid.Version;
    private bool HasPayPointsLayout => _payPointsGrid.Has;

    private string VendorId = "";
    private string Description = "";
    private string Address = "";
    private string Address2 = "";
    private string City = "";
    private string Province = "";
    private string Postal = "";
    private string Phone = "";
    private string Fax = "";
    private bool IsTBD;
    private string WebUID = "";
    private string WebPWD = "";
    private string WalletPayeeID = "";
    private string TaxID = "";
    private bool IsBuildPro;
    private string VendorDesc = "";

    private List<VendorPayPoint> PayPoints = new();
    private List<VendorContact> Contacts = new();
    private GridControl<VendorPayPoint>? gPayPoints;
    private GridControl<VendorContact>? gContacts;
    private GridControl<TaxGroupRow>? TaxGroupsGrid;
    private GridControl<InsuranceRequirement>? gInsurance;

    // VB6 cboStatus: "Active" / "Inactive". We bind the string directly so
    // the save can compare cboStatus.Text = "Inactive" verbatim.
    private string Status = "Active";
    private readonly List<string> StatusItems = new() { "Active", "Inactive" };

    private string TradeType = "";
    private string POFormat = "";
    private readonly List<string> TradeTypes = new();
    private readonly List<string> POFormats = new();
    private List<string> SmsCarrierOptions = new();
    private int HoldbackPercent;

    private List<InsuranceRequirement> InsuranceData = new();
