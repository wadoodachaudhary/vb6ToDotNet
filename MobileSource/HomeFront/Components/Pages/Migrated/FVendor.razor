    // The Send Via column binds SendViaText, so the snapshot reports that name
    // rather than the SendVia the layout resolver returns.
    private string ResolveContactsSnapshotField(string field)
    {
        var resolved = ResolveContactField(field);
        return resolved.Equals(nameof(VendorContact.SendVia), StringComparison.OrdinalIgnoreCase)
            ? nameof(VendorContact.SendViaText)
            : resolved;
    }

    private async Task PersistGridLayoutAsync<T>(string gridName,
        IDictionary<string, GridLayoutColumn> layout, GridSettings snapshot,
        GridLayoutPresenter<T> presenter, Func<string, string>? layoutFieldResolver)
    {
        if (snapshot == null || layout.Count == 0) return;
        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, FormName, gridName, instanceKey: null,
                layout, snapshot, layoutFieldResolver, staticNames: false);

            presenter.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FVendor {Grid} layout", gridName);
        }
    }

