    private static bool IsContactEmpty(VendorContact c)
    {
        if (c == null) return true;
        return string.IsNullOrWhiteSpace(c.ContactID)
            && string.IsNullOrWhiteSpace(c.Role)
            && string.IsNullOrWhiteSpace(c.Name)
            && string.IsNullOrWhiteSpace(c.Phone)
            && string.IsNullOrWhiteSpace(c.Cell)
            && string.IsNullOrWhiteSpace(c.Fax)
            && string.IsNullOrWhiteSpace(c.Email)
            && string.IsNullOrWhiteSpace(c.SmsAddress)
            && c.SendVia == 0
            && !c.PONotice && !c.FPONotice && !c.SchedNotice && !c.ServiceNotice;
    }

