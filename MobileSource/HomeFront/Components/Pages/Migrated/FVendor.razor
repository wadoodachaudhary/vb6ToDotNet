    private async Task OnOpenClick()
    {
        if (vendorPickList == null) return;
        // VB6 line 1490: If Not SaveData(True) Then Exit Sub
        if (!await SaveDataAsync(prompt: true)) return;

        // Two views — exact column set from VB6 lines 1493-1494.
        var divisionId = SessionState.DivisionID;
        var queries =
            $"Active Vendors;SELECT Vendor_Name Company, Vendor_ID Vendor, City, Phone, VendorGroupID Trade FROM tblVendors WHERE DivisionID = {divisionId} AND ISNULL(Inactive,0) = 0 ORDER BY Vendor_Name"
            + "|"
            + $"Inactive Vendors;SELECT Vendor_Name Company, Vendor_ID Vendor, City, Phone, VendorGroupID Trade FROM tblVendors WHERE DivisionID = {divisionId} AND Inactive = 1 ORDER BY Vendor_Name";

        _pickContext = "OpenVendor";
        await vendorPickList.Open(
            title: "Vendor",
            queries: queries,
            hideColumns: null,
            multiSelect: false);
    }

    /// <summary>FPickList OnSelected callback — routes by _pickContext.</summary>
    private async Task OnVendorPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        var ctx = _pickContext;
        _pickContext = "";

        if (ctx == "OpenVendor")
        {
            if (selectedRows.Count == 0) return;
            var pick = selectedRows[0];
            var vendorId = GetRowString(pick, "Vendor");
            if (string.IsNullOrEmpty(vendorId)) return;
            mVendor = vendorId;
            VendorId = vendorId;
            await LoadDataAsync();
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (ctx == "POIndex")
        {
            // VB6 gPayPoints_CellButtonClick: set POIndex; new blank row is grid-managed.
            if (_payPointPickRow != null && selectedRows.Count > 0)
            {
                var poindex = GetRowString(selectedRows[0], "POIndex");
                var wasNewRow = PayPoints.Count > 0 && ReferenceEquals(PayPoints[^1], _payPointPickRow);
                _payPointPickRow.POIndex = poindex;
                mDirty = true;
                if (wasNewRow)
                {
                    if (_payPointPickRow.PayPoint1Percent == 0) _payPointPickRow.PayPoint1Percent = 100;
                }
                _resumePayPointsAfterRender = true;
            }
            _payPointPickRow = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (ctx == "Community")
        {
            // VB6 gTaxGroups_CellButtonClick Community case: set Community +
            // Description; append a fresh blank if this was the new row.
            if (_taxGroupPickRow != null && selectedRows.Count > 0)
            {
                var community = GetRowString(selectedRows[0], "Community");
                var desc = GetRowString(selectedRows[0], "Description");
                var wasNewRow = _taxGroupPickRow.IsNewRow;
                _taxGroupPickRow.Community = community;
                _taxGroupPickRow.CommunityDescription = desc;
                _taxGroupPickRow.IsNewRow = false;
                mDirty = true;
                if (wasNewRow)
                    TaxGroupsData.Add(new TaxGroupRow { IsNewRow = true });
                if (TaxGroupsGrid != null) await TaxGroupsGrid.Refresh();
            }
            _taxGroupPickRow = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (ctx == "TaxGroup")
        {
            // VB6 gTaxGroups_CellButtonClick Else case: set the chosen
            // tax-group cell to the picked TaxGroup code.
            if (_taxGroupPickRow != null && !string.IsNullOrEmpty(_taxGroupPickField) && selectedRows.Count > 0)
            {
                var taxGroup = GetRowString(selectedRows[0], "TaxGroup");
                SetTaxGroupCell(_taxGroupPickRow, _taxGroupPickField, taxGroup);
                mDirty = true;
                if (TaxGroupsGrid != null) await TaxGroupsGrid.Refresh();
            }
            _taxGroupPickRow = null;
            _taxGroupPickField = "";
            await InvokeAsync(StateHasChanged);
            return;
        }
    }

