    // ── Grid layout persistence (VB6: IniPutGrid) ───────────────────────
    // The new widths live on the snapshot, not in the presenter's layout dict,
    // so they must be merged in before the save.
    private Task OnContactsLayoutChangedAsync(GridSettings snapshot) =>
        PersistGridLayoutAsync("gContacts", gContactsLayout, snapshot, _contactsGrid, ResolveContactsSnapshotField);

    private Task OnPayPointsLayoutChangedAsync(GridSettings snapshot) =>
        PersistGridLayoutAsync("gPayPoints", gPayPointsLayout, snapshot, _payPointsGrid, null);

