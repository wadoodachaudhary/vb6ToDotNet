    // ── Grid cell-save handlers (VB6 *_ValidateEdit → mDirty + format) ──
    //   Checkbox columns (gContacts notices, gInsurance Req) are now native
    //   FlexKit Type="ColumnType.CheckBox" cells: the toggle sets the bound
    //   bool via SetPropertyObjectValue, then fires OnCellSave below (dirty +
    //   trailing-row), matching VB6 *_ValidateEdit → mDirty = True.
    private Task OnContactCellSave(CellSaveArgs<VendorContact> args)
    {
        if (IsReadOnly) return Task.CompletedTask;
        var row = args.Data;
        var field = args.ColumnName ?? "";
        // VB6 gContacts_ValidateEdit: phone/cell/fax → FormatPhone.
        if (field.Equals("Phone", StringComparison.OrdinalIgnoreCase)) row.Phone = FormatPhone(row.Phone ?? "");
        else if (field.Equals("Cell", StringComparison.OrdinalIgnoreCase)) row.Cell = FormatPhone(row.Cell ?? "");
        else if (field.Equals("Fax", StringComparison.OrdinalIgnoreCase)) row.Fax = FormatPhone(row.Fax ?? "");
        else if (field.Equals("SendVia", StringComparison.OrdinalIgnoreCase))
        {
            // SendVia is numeric (CommModeID). Coerce.
            row.SendVia = int.TryParse(Convert.ToString(args.Value, CultureInfo.InvariantCulture), out var sv) ? sv : row.SendVia;
        }
        row.Dirty = true;
        mDirty = true;
        return Task.CompletedTask;
    }

