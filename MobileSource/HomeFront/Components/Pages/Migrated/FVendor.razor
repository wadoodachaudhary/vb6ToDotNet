    // Commit any pending single-cell (Batch) edit on the editable grids so the
    // edit flows through OnCellSave (-> mDirty) and the editor buffer is cleared
    // before the DataSource is swapped for another vendor. EndEditAsync only
    // raises OnCellSave when the editor was actually touched, so untouched cells
    // won't produce a false prompt.
    private async Task FlushPendingGridEditsAsync()
    {
        if (gContacts != null) await gContacts.EndEditAsync();
        if (gPayPoints != null) await gPayPoints.EndEditAsync();
        if (gInsurance != null) await gInsurance.EndEditAsync();
        if (TaxGroupsGrid != null) await TaxGroupsGrid.EndEditAsync();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ── SaveData (VB6 SaveData) — full port, parameterized ──────────────
    // ═══════════════════════════════════════════════════════════════════
    private async Task<bool> SaveDataAsync(bool prompt)
    {
        // Flush any in-flight in-cell edit before checking mDirty — mirrors VB6
        // ValidateEdit committing on focus loss. This both marks the form dirty
        // (so the vbYesNoCancel prompt fires) and tears down the editor buffer
        // so it can't survive the DataSource swap into the next vendor.
        await FlushPendingGridEditsAsync();

        // VB6: If Not mDirty Then SaveData=True : Exit Function
        if (!mDirty) return true;
        if (string.IsNullOrEmpty(mVendor)) return true;

        // VB6 SaveData(prompt:=True):
        //   Select Case MsgBox(Caption & " has changed..." , vbYesNoCancel)
        //       Case vbNo     -> SaveData = True  (continue WITHOUT saving)
        //       Case vbCancel -> SaveData = False (stay — caller aborts)
        //   (vbYes falls through to the save below.)
        // FlexKit MessageBoxControl gives us the same async Yes/No/Cancel modal
        // (FPOIndex parity).
        if (prompt && _messageBox != null)
        {
            var rc = await _messageBox.ShowAsync(
                "Vendor has changed.\n\nDo you want to save these changes?",
                title: "Vendor",
                buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel);

            if (rc == Fx.ControlKit.Dialogs.MessageBoxResult.Cancel)
                return false;   // stay on the current vendor — caller aborts
            if (rc == Fx.ControlKit.Dialogs.MessageBoxResult.No)
            {
                // Discard: leave mDirty alone (VB6 returns True without saving;
                // LoadData resets mDirty when the next vendor loads).
                return true;
            }
            // Yes → fall through and save.
        }

        try
        {
            var ins = InsuranceData;
            InsuranceRequirement InsRow(string name) =>
                ins.FirstOrDefault(r => r.Name.StartsWith(name, StringComparison.OrdinalIgnoreCase)) ?? new InsuranceRequirement();
            var gl = InsRow("General");
            var wc = InsRow("Workers");
            var umb = InsRow("Umbrella");
            var auto = InsRow("Automobile");

            // VB6 tax-group defaults come from row index 1 (the "vendor defaults" row).
            var defaults = TaxGroupsData.FirstOrDefault(r => r.IsDefaultsRow) ?? new TaxGroupRow();

            var updateSql = @"
UPDATE tblVendors
SET Inactive = @Inactive,
    POFormat = @POFormat,
    HoldbackPercentage = @Holdback,
    Vendor_Name = @VendorName,
    Addr1 = @Addr1,
    Addr2 = @Addr2,
    City = @City,
    State = @State,
    Zip = @Zip,
    Phone = @Phone,
    Fax = @Fax,
    isTBD = @IsTBD,
    BuildProEnabled = @BuildPro,
    webuid = @WebUID,
    password = @WebPWD,
    VendorGroupID = @VendorGroupID,
    wcinsrequired = @WcReq, glinsrequired = @GlReq, umbinsrequired = @UmbReq, autoinsrequired = @AutoReq,
    wcinsexpdate = @WcExp, glinsexpdate = @GlExp, umbinsexpdate = @UmbExp, autoinsexpdate = @AutoExp,
    wcinsCompany = @WcCo, glinsCompany = @GlCo, umbinsCompany = @UmbCo, autoinsCompany = @AutoCo,
    wcinspolicynumber = @WcPol, glinspolicynumber = @GlPol, umbinspolicynumber = @UmbPol, autoinspolicynumber = @AutoPol,
    LabourTaxGroup = @TgLabour, MaterialTaxGroup = @TgMaterial, SubContractTaxGroup = @TgSub,
    EquipmentTaxGroup = @TgEquip, OverheadTaxGroup = @TgOverhead, OtherTaxGroup = @TgOther
WHERE Vendor_ID = @VendorId AND divisionid = @DivisionId";

            var p = new Dictionary<string, object?>
            {
                ["Inactive"] = Status == "Inactive",
                ["POFormat"] = POFormat ?? "",
                ["Holdback"] = HoldbackPercent,
                ["VendorName"] = Description ?? "",
                ["Addr1"] = Address ?? "",
                ["Addr2"] = Address2 ?? "",
                ["City"] = City ?? "",
                ["State"] = Province ?? "",
                ["Zip"] = Postal ?? "",
                ["Phone"] = Phone ?? "",
                ["Fax"] = Fax ?? "",
                ["IsTBD"] = IsTBD,
                ["BuildPro"] = IsBuildPro,
                ["WebUID"] = WebUID ?? "",
                ["WebPWD"] = WebPWD ?? "",
                ["VendorGroupID"] = TradeType ?? "",
                ["WcReq"] = wc.Req, ["GlReq"] = gl.Req, ["UmbReq"] = umb.Req, ["AutoReq"] = auto.Req,
                ["WcExp"] = (object?)wc.ExpiryDate ?? DBNull.Value,
                ["GlExp"] = (object?)gl.ExpiryDate ?? DBNull.Value,
                ["UmbExp"] = (object?)umb.ExpiryDate ?? DBNull.Value,
                ["AutoExp"] = (object?)auto.ExpiryDate ?? DBNull.Value,
                ["WcCo"] = wc.Company ?? "", ["GlCo"] = gl.Company ?? "", ["UmbCo"] = umb.Company ?? "", ["AutoCo"] = auto.Company ?? "",
                ["WcPol"] = wc.PolicyNumber ?? "", ["GlPol"] = gl.PolicyNumber ?? "", ["UmbPol"] = umb.PolicyNumber ?? "", ["AutoPol"] = auto.PolicyNumber ?? "",
                ["TgLabour"] = defaults.Labour ?? "", ["TgMaterial"] = defaults.Material ?? "", ["TgSub"] = defaults.SubContract ?? "",
                ["TgEquip"] = defaults.Equipment ?? "", ["TgOverhead"] = defaults.Overhead ?? "", ["TgOther"] = defaults.Other ?? "",
                ["VendorId"] = mVendor,
                ["DivisionId"] = SessionState.DivisionID
            };
            await db.ExecuteAsync(updateSql, p);

            // ── Rewrite vendortaxgroups (community-specific rows only) ──
            // VB6: delete all for vendor, then insert rows 2..Rows-2 (skips the
            // defaults row at index 1 and the trailing blank "new" row).
            await db.ExecuteAsync(
                "DELETE FROM vendortaxgroups WHERE vendor = @Vendor",
                new { Vendor = mVendor });

            foreach (var tg in TaxGroupsData)
            {
                if (tg.IsDefaultsRow || tg.IsNewRow) continue;
                if (string.IsNullOrWhiteSpace(tg.Community)) continue;
                await db.ExecuteAsync(@"
INSERT INTO vendortaxgroups(vendor, community, Labourtaxgroup, materialtaxgroup, subcontracttaxgroup, equipmenttaxgroup, overheadtaxgroup, othertaxgroup)
VALUES(@Vendor, @Community, @Labour, @Material, @Sub, @Equip, @Overhead, @Other)",
                    new
                    {
                        Vendor = mVendor,
                        Community = tg.Community ?? "",
                        Labour = tg.Labour ?? "",
                        Material = tg.Material ?? "",
                        Sub = tg.SubContract ?? "",
                        Equip = tg.Equipment ?? "",
                        Overhead = tg.Overhead ?? "",
                        Other = tg.Other ?? ""
                    });
            }

            await SavePayPointsAsync();
            await SaveContactsAsync();

            // ── FLAG-AS-BLOCKED: Timberline / APM accounting sync ───────────
            // VB6 SaveData lines 1631-1669: when the secondary "accounting"
            // database is open (HFApp.Databases(dbAccounting).State = adStateOpen)
            // AND HFApp.Options(AccountingSystem) = asTimberline, VB6 pushes the
            // vendor's insurance flags / company / policy-number / expiry fields
            // into the Timberline APM_MASTER__VENDOR table:
            //     UPDATE APM_MASTER__VENDOR
            //        SET gen_liab_ins_proof_req=..., work_comp_ins_proof_req=...,
            //            gl_ins_company=..., gl_ins_policy_number=...,
            //            gl_ins_expiration_dt=..., (etc. for WC/Umbrella/Auto)
            //      WHERE Vendor=<vendor>
            // This requires a LIVE connection to the external Sage 100 Contractor
            // (Timberline) / APM accounting system — a separate ADO data source
            // (dbAccounting) plus the AccountingSystem option set to asTimberline.
            // That integration is NOT connected to this Blazor app (there is no
            // dbAccounting connection, no AccountingSystem option surfaced, and no
            // APM_MASTER__VENDOR table in HomeFrontSQL). Until the external
            // accounting-system integration is wired up, this sync cannot run.
            // Per product decision this is flagged, not stubbed-as-implemented.
            if (_accountingSystemIsTimberline)
            {
                Notifications.Warning(
                    "Vendor saved to HomeFront, but the Timberline/Sage 100 (APM) " +
                    "accounting sync was skipped: the external accounting-system " +
                    "integration (a live dbAccounting connection writing to " +
                    "APM_MASTER__VENDOR) is not connected to this application. " +
                    "VB6 FVendor.SaveData lines 1631-1669.");
            }

            mDirty = false;
            Notifications.Info("Vendor saved.");
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[FVendor] SaveData failed");
            Notifications.Error($"Save failed: {ex.Message}");
            return false;
        }
    }

    // VB6 SavePayPoints — insert+update each non-blank row; delete hidden.
    private async Task SavePayPointsAsync()
    {
        foreach (var pp in PayPoints.ToList())
        {
            if (string.IsNullOrWhiteSpace(pp.POIndex)) continue;  // trailing blank row
            // VB6 inserts the key, then updates the percent columns. Duplicate
            // inserts are swallowed (On Error Resume Next "duplicate"). We use a
            // MERGE-style guard: insert if absent.
            try
            {
                await db.ExecuteAsync(@"
IF NOT EXISTS (SELECT 1 FROM VendorPaymentPoints WHERE DivisionID = @DivisionID AND Vendor = @Vendor AND POIndex = @POIndex)
    INSERT INTO VendorPaymentPoints(DivisionID, Vendor, POIndex) VALUES(@DivisionID, @Vendor, @POIndex);
UPDATE VendorPaymentPoints
SET PayPoint1Percent = @P1, PayPoint2Percent = @P2, PayPoint3Percent = @P3,
    PayPoint4Percent = @P4, PayPoint5Percent = @P5
WHERE DivisionID = @DivisionID AND Vendor = @Vendor AND POIndex = @POIndex",
                    new
                    {
                        SessionState.DivisionID,
                        Vendor = mVendor,
                        pp.POIndex,
                        P1 = pp.PayPoint1Percent,
                        P2 = pp.PayPoint2Percent,
                        P3 = pp.PayPoint3Percent,
                        P4 = pp.PayPoint4Percent,
                        P5 = pp.PayPoint5Percent
                    });
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[FVendor] SavePayPoints row failed for POIndex {POIndex}", pp.POIndex);
            }
        }
    }

    // VB6 SaveContacts — insert/update each dirty non-blank row, then push
    // PO-delivery defaults onto unsent POs.
    private async Task SaveContactsAsync()
    {
        foreach (var contact in Contacts.ToList())
        {
            if (IsContactEmpty(contact)) continue;

            var common = new
            {
                Role = contact.Role ?? "",
                Name = contact.Name ?? "",
                Phone = contact.Phone ?? "",
                Cell = contact.Cell ?? "",
                Fax = contact.Fax ?? "",
                Email = contact.Email ?? "",
                SendVia = contact.SendVia,
                SmsAddress = contact.SmsAddress ?? "",
                contact.PONotice,
                contact.FPONotice,
                contact.SchedNotice,
                contact.ServiceNotice,
                CompanyName = Description ?? "",
                CompanyAddr1 = Address ?? "",
                CompanyAddr2 = Address2 ?? "",
                CompanyCity = City ?? "",
                CompanyProv = Province ?? "",
                CompanyPostal = Postal ?? ""
            };

            if (string.IsNullOrWhiteSpace(contact.ContactID))
            {
                var insertSql = @"
INSERT INTO Contacts(
    DivisionID, ContactTypeID, UserID, VendorCode,
    Role, FirstName, DisplayName, WorkPhone, CellPhone, Fax, Email, CommModeID, SMSAddress,
    PONotice, FPONotice, SchedNotice, ServiceNotice,
    CompanyName, CompanyAddr1, CompanyAddr2, CompanyCity, CompanyProv, CompanyPostal
)
OUTPUT INSERTED.ContactID
VALUES(
    @DivisionID, 99, @UserID, @Vendor,
    @Role, @Name, @Name, @Phone, @Cell, @Fax, @Email, @SendVia, @SmsAddress,
    @PONotice, @FPONotice, @SchedNotice, @ServiceNotice,
    @CompanyName, @CompanyAddr1, @CompanyAddr2, @CompanyCity, @CompanyProv, @CompanyPostal
)";
                var newId = await db.ExecuteScalarAsync<long>(insertSql, new
                {
                    SessionState.DivisionID,
                    UserID = Guid.NewGuid().ToString(),
                    Vendor = mVendor,
                    common.Role, common.Name, common.Phone, common.Cell, common.Fax, common.Email,
                    common.SendVia, common.SmsAddress,
                    common.PONotice, common.FPONotice, common.SchedNotice, common.ServiceNotice,
                    common.CompanyName, common.CompanyAddr1, common.CompanyAddr2, common.CompanyCity,
                    common.CompanyProv, common.CompanyPostal
                });
                if (newId != 0) contact.ContactID = newId.ToString();
            }
            else
            {
                var updateSql = @"
UPDATE Contacts
SET Role = @Role, FirstName = @Name, DisplayName = @Name,
    WorkPhone = @Phone, CellPhone = @Cell, Fax = @Fax, Email = @Email,
    CommModeID = @SendVia, SMSAddress = @SmsAddress,
    PONotice = @PONotice, FPONotice = @FPONotice, SchedNotice = @SchedNotice, ServiceNotice = @ServiceNotice,
    CompanyName = @CompanyName, CompanyAddr1 = @CompanyAddr1, CompanyAddr2 = @CompanyAddr2,
    CompanyCity = @CompanyCity, CompanyProv = @CompanyProv, CompanyPostal = @CompanyPostal
WHERE ContactID = @ContactID";
                var contactIdParam = long.TryParse(contact.ContactID, out var idVal) ? (object)idVal : (object)(contact.ContactID ?? "");
                await db.ExecuteAsync(updateSql, new
                {
                    common.Role, common.Name, common.Phone, common.Cell, common.Fax, common.Email,
                    common.SendVia, common.SmsAddress,
                    common.PONotice, common.FPONotice, common.SchedNotice, common.ServiceNotice,
                    common.CompanyName, common.CompanyAddr1, common.CompanyAddr2, common.CompanyCity,
                    common.CompanyProv, common.CompanyPostal,
                    ContactID = contactIdParam
                });
            }
        }

        // VB6: update unsent POs with the vendor's purchasing-delivery defaults.
        var updatePoSql = @"
UPDATE p
SET DeliveryMethod    = v.PurchDelMethod,
    DeliveryRecipient = v.PurchContact,
    DeliveryAddress   = CASE v.PurchDelMethod WHEN 1 THEN v.PurchEmail ELSE '' END
FROM tblvendors v
JOIN pomaster p
  ON v.vendor_id = p.vendor
 AND p.divisionid = v.divisionid
 AND p.deliverydate IS NULL
WHERE v.vendor_id = @VendorId";
        await db.ExecuteAsync(updatePoSql, new { VendorId = mVendor });
    }

    // VB6 cmdNav_Click — Save first, then jump to the next/previous vendor.
    private async Task NextClick()
    {
        if (!await SaveDataAsync(prompt: true)) return;
        if (vendors.Count == 0) return;
        var idx = vendors.IndexOf(mVendor);
        if (idx < 0 || idx >= vendors.Count - 1) return;
        mVendor = vendors[idx + 1];
        VendorId = mVendor;
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PreviousClick()
    {
        if (!await SaveDataAsync(prompt: true)) return;
        if (vendors.Count == 0) return;
        var idx = vendors.IndexOf(mVendor);
        if (idx <= 0) return;
        mVendor = vendors[idx - 1];
        VendorId = mVendor;
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

