        if (!HasInsuranceLayout) missing.Add("gInsurance");

        await _payPointsGrid.LoadAsync(GridLayoutSvc);
        if (!HasPayPointsLayout) missing.Add("gPayPoints");

        _layoutFallbackMsg = missing.Count > 0
            ? $"[{string.Join(", ", missing.Select(m => m + " FALLBACK"))}] grid layout(s) missing from AppGridLayout — using default columns."
            : "";
    }

    private IEnumerable<GridLayoutColumn> GetOrderedLayout(Dictionary<string, GridLayoutColumn> layoutDict)
    {
        return layoutDict.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase);
