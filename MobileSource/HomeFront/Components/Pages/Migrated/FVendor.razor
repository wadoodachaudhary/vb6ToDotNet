    protected override async Task OnInitializedAsync()
    {
        await LoadGridLayouts();
        await LoadAppOptionsAsync();
        await LoadComboListsAsync();
        var vendorData = await db.QueryAsync(
            "SELECT Vendor_ID FROM tblVendors WHERE DivisionID = @DivisionID ORDER BY Vendor_ID",
            new { SessionState.DivisionID });
        vendors = vendorData
            .Select(r => r["Vendor_ID"]?.ToString() ?? "")
            .Where(v => !string.IsNullOrEmpty(v))
            .ToList();

        // Wire grid edit callbacks.
        _contactsEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<VendorContact>>(this, OnContactCellSave);
        _payPointsEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<VendorPayPoint>>(this, OnPayPointCellSave);
        _insuranceEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<InsuranceRequirement>>(this, OnInsuranceCellSave);

        // STANDARD FlexKit edit-button dispatch (replaces the hand-rolled "…" buttons in
        // the gPayPoints.POIndex and gTaxGroups.Description/cost cells). The grid raises
        // OnEditButtonClick with the row + ColumnName; we route to the same FPickList
        // openers the native buttons called (VB6 *_CellButtonClick parity).
        _payPointsEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<VendorPayPoint>>(this, OnPayPointEditButtonClick);
        _taxGroupsEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<TaxGroupRow>>(this, OnTaxGroupEditButtonClick);
        // No auto-load of a hardcoded vendor — VB6 doesn't either. mVendor
        // stays empty; the empty-state placeholder shows until the user
        // picks via Open.
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_resumePayPointsAfterRender)
        {
            _resumePayPointsAfterRender = false;
            if (gPayPoints != null)
                await gPayPoints.ResumeKeyboardNavigationAsync();
        }

        // VB6 Form_Load auto-popped the Open dialog when mVendor was empty.
        // Defer to the first render so the FPickList @ref is wired before
        // we try to call vendorPickList.Open().
        if (firstRender && _autoOpenOnFirstRender && string.IsNullOrEmpty(mVendor))
        {
            _autoOpenOnFirstRender = false;
            await OnOpenClick();
        }
    }

    // ── Combo list population (VB6 Form_Load) ───────────────────────────
    private async Task LoadComboListsAsync()
    {
        // VB6: LoadComboBox(cboTradeType, "select distinct isnull(VendorGroupID,''),'',0 from tblvendors where divisionid=N order by 1")
        try
        {
            var rows = await db.QueryAsync(
                "SELECT DISTINCT ISNULL(VendorGroupID,'') vg FROM tblVendors WHERE DivisionID = @DivisionID ORDER BY 1",
                new { SessionState.DivisionID });
            TradeTypes.Clear();
            TradeTypes.Add("");
            foreach (var r in rows)
            {
                var v = r["vg"]?.ToString() ?? "";
                if (!string.IsNullOrEmpty(v) && !TradeTypes.Contains(v))
                    TradeTypes.Add(v);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[FVendor] LoadComboLists trade types failed");
        }

        // VB6 Form_Load:
        //   s = Dir(PathAppend(HFApp.SystemFolder, "Estimating\PO Formats", "*.rpt"))
        //   While s <> "" : cboPOFormat.AddItem StripExtension(s) : s = Dir : Wend
        // The SystemFolder maps to the app's wwwroot/resources tree, so the PO
        // Formats live at wwwroot/resources/Estimating/PO Formats/*.rpt. List the
        // file names without extension (StripExtension), sorted, as the options.
        // The currently-saved POFormat value is still added in LoadData so an
        // existing selection displays even if its template file is missing.
        POFormats.Clear();
        POFormats.Add("");   // VB6 cboPOFormat allows an empty (no-format) selection
        try
        {
            var poFormatsDir = Path.Combine(
                Env.WebRootPath, "resources", "Estimating", "PO Formats");
            if (Directory.Exists(poFormatsDir))
            {
                var names = Directory.GetFiles(poFormatsDir, "*.rpt")
                    .Select(Path.GetFileNameWithoutExtension)
                    .Where(n => !string.IsNullOrWhiteSpace(n))
                    .Select(n => n!)
                    .OrderBy(n => n, StringComparer.OrdinalIgnoreCase);
                foreach (var n in names)
                    if (!POFormats.Contains(n))
                        POFormats.Add(n);
            }
            else
            {
                Logger.LogWarning("[FVendor] PO Formats folder not found at {Dir}", poFormatsDir);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[FVendor] LoadComboLists PO formats failed");
        }

        try
        {
            var carriers = await db.QueryAsync("SELECT address, name FROM smscarriers ORDER BY name");
            SmsCarrierOptions = carriers
                .Select(r => $"#{r["address"]?.ToString() ?? ""};{r["name"]?.ToString() ?? ""}")
                .ToList();
        }
        catch (Exception ex)
        {
            SmsCarrierOptions = new();
            Logger.LogError(ex, "[FVendor] LoadComboLists SMS carriers failed");
        }
    }

    // VB6 Form_Load reads HFApp.Options(ZeroRateOnChangeVendor). AppOptions are
    // division-scoped with a global (DivisionID=0) fallback — IN(0,@Div) ordered
    // by DivisionID so the division-specific row wins (FCustomQuote parity).
    private async Task LoadAppOptionsAsync()
    {
        try
        {
            var opts = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            var dt = db.SqlExec(
                "SELECT OptionName, OptionValue FROM AppOptions WHERE DivisionID IN (0, @DivisionID) ORDER BY DivisionID",
                new { SessionState.DivisionID });
            foreach (DataRow r in dt.Rows)
                opts[r["OptionName"]?.ToString() ?? ""] = r["OptionValue"]?.ToString() ?? "";

            string Opt(string name, string fallback) =>
                opts.TryGetValue(name, out var v) && !string.IsNullOrEmpty(v) ? v : fallback;

            // VB6 default = False (Options.cls).
            _zeroRateOnChangeVendor = OptBool(Opt("ZeroRateOnChangeVendor", "False"));
            // FVendor's own flow never branches on this (see field comment) — the
            // authoritative value lives in the Estimating/Quote item grids. Trace
            // it so the loaded option is observable and the field is genuinely
            // consumed here.
            Logger.LogDebug("[FVendor] ZeroRateOnChangeVendor = {Value}", _zeroRateOnChangeVendor);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[FVendor] LoadAppOptions failed");
        }
    }

    // VB6 boolean option parsing (FCustomQuote.OptBool parity): "1" or "True".
    private static bool OptBool(string v) =>
        v == "1" || v.Equals("True", StringComparison.OrdinalIgnoreCase);

