    public class VendorContact
    {
        public string? ContactID { get; set; }
        public string? Role { get; set; }
        public string? Name { get; set; }
        public string? Phone { get; set; }
        public string? Cell { get; set; }
        public string? Fax { get; set; }
        public string? Email { get; set; }
        public int SendVia { get; set; }
        // HHM-475: the grid binds SendViaText so the cell shows and edits the
        // Send-Via NAME while the CommModeID code stays in SendVia for the DB
        // (VB6 FVendor.frm:1256 ColComboList "#1;Print|#3;Email|#4;Fax").
        public string SendViaText
        {
            get => SendVia switch { 1 => "Print", 3 => "Email", 4 => "Fax", _ => "" };
            set => SendVia = (value ?? "").Trim().ToLowerInvariant() switch
            {
                "print" => 1,
                "email" => 3,
                "fax" => 4,
                "" => 0,
                _ => int.TryParse(value, out var sv) ? sv : SendVia
            };
        }
        public string? SmsAddress { get; set; }
        public bool PONotice { get; set; }
        public bool FPONotice { get; set; }
        public bool SchedNotice { get; set; }
        public bool ServiceNotice { get; set; }
        public bool Dirty { get; set; }
    }
