    public bool VBChooseColor(ref int color, bool anyColor, bool fullOpen, bool disableFullOpen, IntPtr owner, ref int flags)
    {
        EnsureCustomColors();
        var chclr = new TCHOOSECOLOR
        {
            lStructSize = Marshal.SizeOf<TCHOOSECOLOR>(),
            hwndOwner = owner,
            rgbResult = color
        };

        var mask = ~(int)(EChooseColor.CC_ENABLEHOOK | EChooseColor.CC_ENABLETEMPLATE);
        chclr.flags = (int)(EChooseColor.CC_RGBInit |
                            (anyColor ? EChooseColor.CC_AnyColor : EChooseColor.CC_SolidColor) |
                            (fullOpen ? EChooseColor.CC_FullOpen : 0) |
                            (disableFullOpen ? EChooseColor.CC_PreventFullOpen : 0));

        chclr.flags &= mask;

        var handle = GCHandle.Alloc(_customColors, GCHandleType.Pinned);
        try
        {
            chclr.lpCustColors = handle.AddrOfPinnedObject();
            var result = ChooseColor(ref chclr);
            _apiReturn = result ? 1 : 0;

            if (result)
            {
                color = chclr.rgbResult;
                return true;
            }

            _extendedError = CommDlgExtendedError();
            color = -1;
            return false;
        }
        finally
        {
            handle.Free();
        }
    }

    public bool VBChooseFont(FontInfo curFont, IntPtr printerDc, IntPtr owner, ref int color,
        int minSize, int maxSize, ref int flags)
    {
        _apiReturn = 0;
        _extendedError = 0;

        const int unsupportedFlags = (int)(EChooseFont.CF_Apply | EChooseFont.CF_EnableHook | EChooseFont.CF_EnableTemplate);

        if (printerDc != IntPtr.Zero)
            flags |= (int)EChooseFont.CF_PrinterFonts;

        if ((flags & (int)EChooseFont.CF_PrinterFonts) == 0)
            flags |= (int)EChooseFont.CF_ScreenFonts;

        if (color != 0)
            flags |= (int)EChooseFont.CF_EFFECTS;

        if (minSize > 0 || maxSize > 0)
            flags |= (int)EChooseFont.CF_LimitSize;

        flags = (flags | (int)EChooseFont.CF_InitToLogFontStruct) & ~unsupportedFlags;

        var logfont = new LOGFONT
        {
            lfHeight = -(int)Math.Round(curFont.Size * 96f / 72f),
            lfWeight = curFont.Weight > 0 ? curFont.Weight : 400,
            lfItalic = (byte)(curFont.Italic ? 1 : 0),
            lfUnderline = (byte)(curFont.Underline ? 1 : 0),
            lfStrikeOut = (byte)(curFont.Strikethrough ? 1 : 0),
            lfFaceName = curFont.Name ?? string.Empty
        };

        var logFontPtr = Marshal.AllocHGlobal(Marshal.SizeOf<LOGFONT>());
        try
        {
            Marshal.StructureToPtr(logfont, logFontPtr, false);

            var cf = new TCHOOSEFONT
            {
                lStructSize = Marshal.SizeOf<TCHOOSEFONT>(),
                hwndOwner = owner,
                hDC = printerDc,
                lpLogFont = logFontPtr,
                iPointSize = (int)(curFont.Size * 10),
                flags = flags,
                rgbColors = color,
                nSizeMin = minSize,
                nSizeMax = maxSize
            };

            var result = ChooseFont(ref cf);
            _apiReturn = result ? 1 : 0;

            if (result)
            {
                logfont = Marshal.PtrToStructure<LOGFONT>(logFontPtr);
                flags = cf.flags;
                color = cf.rgbColors;
                curFont.Weight = logfont.lfWeight;
                curFont.Italic = logfont.lfItalic != 0;
                curFont.Strikethrough = logfont.lfStrikeOut != 0;
                curFont.Underline = logfont.lfUnderline != 0;
                curFont.Size = cf.iPointSize / 10f;
                curFont.Name = TrimNull(logfont.lfFaceName ?? curFont.Name);
                return true;
            }

            _extendedError = CommDlgExtendedError();
            return false;
        }
        finally
        {
            Marshal.FreeHGlobal(logFontPtr);
        }
    }

    public bool VBPrintDlg(ref IntPtr hdc, ref EPrintRange printRange, bool disablePageNumbers,
        ref short fromPage, ref short toPage, bool disableSelection, ref short copies,
        bool showPrintToFile, bool disablePrintToFile, ref bool printToFile, ref bool collate,
        bool preventWarning, IntPtr ownerHwnd, ref int flags, ref string printerName)
    {
        _apiReturn = 0;
        _extendedError = 0;

        var afFlags = 0;
        if (disablePageNumbers) afFlags |= (int)EPrintDialog.PD_NOPAGENUMS;
        if (disablePrintToFile) afFlags |= (int)EPrintDialog.PD_DISABLEPRINTTOFILE;
        if (disableSelection) afFlags |= (int)EPrintDialog.PD_NOSELECTION;
        if (printToFile) afFlags |= (int)EPrintDialog.PD_PRINTTOFILE;
        if (!showPrintToFile) afFlags |= (int)EPrintDialog.PD_HIDEPRINTTOFILE;
        if (preventWarning) afFlags |= (int)EPrintDialog.PD_NOWARNING;
        if (collate) afFlags |= (int)EPrintDialog.PD_COLLATE;
        afFlags |= (int)EPrintDialog.PD_USEDEVMODECOPIESANDCOLLATE | (int)EPrintDialog.PD_RETURNDC;

        if (printRange == EPrintRange.eprPageNumbers)
            afFlags |= (int)EPrintDialog.PD_PAGENUMS;
        else if (printRange == EPrintRange.eprSelection)
            afFlags |= (int)EPrintDialog.PD_SELECTION;

        var afMask = ~(int)(EPrintDialog.PD_ENABLEPRINTHOOK | EPrintDialog.PD_ENABLEPRINTTEMPLATE |
                            EPrintDialog.PD_ENABLESETUPHOOK | EPrintDialog.PD_ENABLESETUPTEMPLATE);

        var pd = new TPRINTDLG
        {
            lStructSize = Marshal.SizeOf<TPRINTDLG>(),
            hwndOwner = ownerHwnd,
            flags = afFlags & afMask,
            nFromPage = fromPage,
            nToPage = toPage,
            nMinPage = 1,
            nMaxPage = short.MaxValue
        };

        var result = PrintDlg(ref pd);
        _apiReturn = result ? 1 : 0;

        if (result)
        {
            hdc = pd.hDC;

            if ((pd.flags & (int)EPrintDialog.PD_PAGENUMS) != 0)
                printRange = EPrintRange.eprPageNumbers;
            else if ((pd.flags & (int)EPrintDialog.PD_SELECTION) != 0)
                printRange = EPrintRange.eprSelection;
            else
                printRange = EPrintRange.eprAll;

            fromPage = pd.nFromPage;
            toPage = pd.nToPage;
            printToFile = (pd.flags & (int)EPrintDialog.PD_PRINTTOFILE) != 0;

            var pDevMode = GlobalLock(pd.hDevMode);
            if (pDevMode != IntPtr.Zero)
            {
                _devMode = Marshal.PtrToStructure<DevMode>(pDevMode);
                GlobalUnlock(pd.hDevMode);
                printerName = TrimNull(_devMode.dmDeviceName);
                copies = _devMode.dmCopies;
                collate = _devMode.dmCollate == DMCOLLATE_TRUE;
            }
            return true;
        }

        _extendedError = CommDlgExtendedError();
        return false;
    }

    public bool VBPageSetupDlg(ref IntPtr owner, bool disableMargins, bool disableOrientation,
        bool disablePaper, bool disablePrinter, ref int leftMargin, ref int minLeftMargin,
        ref int rightMargin, ref int minRightMargin, ref int topMargin, ref int minTopMargin,
        ref int bottomMargin, ref int minBottomMargin, ref EPaperSize paperSize,
        ref EOrientation orientation, ref EPrintQuality printQuality, EPageSetupUnits units,
        object? printer, ref int flags)
    {
        _apiReturn = 0;
        _extendedError = 0;

        var afMask = ~(int)(EPageSetup.PSD_EnablePagePaintHook | EPageSetup.PSD_EnablePageSetupHook | EPageSetup.PSD_EnablePageSetupTemplate);
        var afFlags = (disableMargins ? (int)EPageSetup.PSD_DISABLEMARGINS : 0)
                      | (disableOrientation ? (int)EPageSetup.PSD_DISABLEORIENTATION : 0)
                      | (disablePaper ? (int)EPageSetup.PSD_DISABLEPAPER : 0)
                      | (disablePrinter ? (int)EPageSetup.PSD_DISABLEPRINTER : 0)
                      | (int)(EPageSetup.PSD_MARGINS | EPageSetup.PSD_MINMARGINS);

        int unitsFactor;
        if (units == EPageSetupUnits.epsuInches)
        {
            afFlags |= (int)EPageSetup.PSD_INTHOUSANDTHSOFINCHES;
            unitsFactor = 1000;
        }
        else
        {
            afFlags |= (int)EPageSetup.PSD_INHUNDREDTHSOFMILLIMETERS;
            unitsFactor = 100;
        }

        var psd = new TPAGESETUPDLG
        {
            lStructSize = Marshal.SizeOf<TPAGESETUPDLG>(),
            hwndOwner = owner,
            rtMargin = new RECT
            {
                Top = topMargin * unitsFactor,
                Left = leftMargin * unitsFactor,
                Bottom = bottomMargin * unitsFactor,
                Right = rightMargin * unitsFactor
            },
            rtMinMargin = new RECT
            {
                Top = minTopMargin * unitsFactor,
                Left = minLeftMargin * unitsFactor,
                Bottom = minBottomMargin * unitsFactor,
                Right = minRightMargin * unitsFactor
            },
            flags = afFlags & afMask
        };

        if (!PageSetupDlg(ref psd))
            return false;

        topMargin = psd.rtMargin.Top / unitsFactor;
        leftMargin = psd.rtMargin.Left / unitsFactor;
        bottomMargin = psd.rtMargin.Bottom / unitsFactor;
        rightMargin = psd.rtMargin.Right / unitsFactor;

        minTopMargin = psd.rtMinMargin.Top / unitsFactor;
        minLeftMargin = psd.rtMinMargin.Left / unitsFactor;
        minBottomMargin = psd.rtMinMargin.Bottom / unitsFactor;
        minRightMargin = psd.rtMinMargin.Right / unitsFactor;

        var pDevMode = GlobalLock(psd.hDevMode);
        if (pDevMode != IntPtr.Zero)
        {
            var dv = Marshal.PtrToStructure<DevMode>(pDevMode);
            GlobalUnlock(psd.hDevMode);

            paperSize = (EPaperSize)dv.dmPaperSize;
            orientation = (EOrientation)dv.dmOrientation;
            printQuality = (EPrintQuality)dv.dmPrintQuality;

            if (printer != null)
            {
                try
                {
                    var type = printer.GetType();
                    type.GetProperty("Copies")?.SetValue(printer, dv.dmCopies);
                    type.GetProperty("Orientation")?.SetValue(printer, dv.dmOrientation);
                    type.GetProperty("PaperSize")?.SetValue(printer, dv.dmPaperSize);
                    type.GetProperty("PrintQuality")?.SetValue(printer, dv.dmPrintQuality);
                }
                catch
                {
                    // ignore
                }
            }
        }

        return true;
    }

    private static string StrZToStr(string s)
    {
        var idx = s.IndexOf('\0');
        return idx >= 0 ? s[..idx] : s;
    }

    private static string FilterLookup(string filters, int index)
    {
        if (string.IsNullOrEmpty(filters) || index <= 0)
            return string.Empty;

        var parts = filters.Split('\0', StringSplitOptions.RemoveEmptyEntries);
        var pos = (index - 1) * 2;
        if (pos + 1 >= parts.Length)
            return string.Empty;

        return $"{parts[pos]}\0{parts[pos + 1]}";
    }

    private static string BuildFilter(string filter)
    {
        if (string.IsNullOrEmpty(filter))
            return "\0\0";

        var normalized = filter.Replace("|", "\0").Replace(":", "\0");
        return normalized + "\0\0";
    }

    private static void EnsureCustomColors()
    {
        if (_customColorsInitialized)
            return;

        for (var i = 0; i < _customColors.Length; i++)
            _customColors[i] = GetSysColor(i);

        _customColorsInitialized = true;
    }

    private static void StrToBytes(ref byte[] buffer, string value)
    {
        var bytes = Encoding.Default.GetBytes(value ?? string.Empty);
        if (buffer == null || buffer.Length == 0)
        {
            buffer = bytes;
            return;
        }

        var count = Math.Min(buffer.Length, bytes.Length);
        Array.Copy(bytes, buffer, count);
        if (count < buffer.Length)
            Array.Clear(buffer, count, buffer.Length - count);
    }

    private static string BytesToStr(byte[] buffer)
    {
        if (buffer == null || buffer.Length == 0)
            return string.Empty;
        return Encoding.Default.GetString(buffer).TrimEnd('\0');
    }

    private static int COMError(int e) => e | unchecked((int)0x800A0000);

    private static bool IsArrayEmpty(Array? arr) => arr == null || arr.Length == 0;

