    public int APIReturn => _apiReturn;
    public int ExtendedError => _extendedError;

    public int GetCustomColor(int index)
    {
        EnsureCustomColors();
        return index is >= 0 and <= 15 ? _customColors[index] : -1;
    }

    public void SetCustomColor(int index, int value)
    {
        EnsureCustomColors();
        if (index is >= 0 and <= 15)
            _customColors[index] = value;
    }

    public string GetFolderPath(CSIDL_VALUES csidl)
    {
        var buffer = new StringBuilder(MAX_LENGTH);
        if (SHGetFolderPath(GetDesktopWindow(), (int)csidl, new IntPtr(-1), 0, buffer) == S_OK)
            return TrimNull(buffer.ToString());
        return string.Empty;
    }

    public bool VBChooseFolder(int csidl, int flags, ref string folder, string title = "Select Folder",
        IntPtr hwnd = default, object? initialSelection = null)
    {
        if (SHGetSpecialFolderLocation(hwnd, csidl, out var rootIdl) != 0)
            return false;

        _bffInitialSelection = initialSelection ?? CSIDL_VALUES.CSIDL_DESKTop;
        _browseCallback ??= CallBackFunction;
        var callbackPtr = Marshal.GetFunctionPointerForDelegate(_browseCallback);

        var bi = new BROWSEINFO
        {
            hwndOwner = hwnd,
            pidlRoot = rootIdl,
            pszDisplayName = new StringBuilder(conMaxPath),
            lpszTitle = title ?? string.Empty,
            ulFlags = flags,
            lpfn = callbackPtr,
            lParam = IntPtr.Zero
        };

        var idl = SHBrowseForFolder(ref bi);
        if (idl == IntPtr.Zero)
            return false;

        var path = new StringBuilder(conMaxPath);
        if (SHGetPathFromIDList(idl, path))
            folder = TrimNull(path.ToString());
        else
            folder = TrimNull(bi.pszDisplayName.ToString());

        GlobalFree(idl);
        return true;
    }

    private static string TrimNull(string value)
    {
        var pos = value.IndexOf('\0');
        return pos switch
        {
            > 0 => value[..pos],
            0 => string.Empty,
            _ => value
        };
    }

    private static int CallBackFunction(IntPtr hwnd, int msg, IntPtr lParam, IntPtr lpData)
    {
        switch (msg)
        {
            case BFFM_INITIALIZED:
                EnableOK(hwnd, false);
                SetSelection(hwnd, _bffInitialSelection);
                break;
            case BFFM_SELCHANGED:
                var path = new StringBuilder(conMaxPath);
                if (SHGetPathFromIDList(lParam, path))
                {
                    SetStatus(hwnd, TrimNull(path.ToString()));
                    EnableOK(hwnd, true);
                }
                else
                {
                    SetStatus(hwnd, string.Empty);
                    EnableOK(hwnd, false);
                }
                break;
        }
        return 0;
    }

    private static void SetStatus(IntPtr hwnd, string text) =>
        SendMessage(hwnd, BFFM_SETSTATUSTEXT, IntPtr.Zero, text ?? string.Empty);

    private static void EnableOK(IntPtr hwnd, bool enable) =>
        SendMessage(hwnd, BFFM_ENABLEOK, IntPtr.Zero, enable ? new IntPtr(1) : IntPtr.Zero);

    private static void SetSelection(IntPtr hwnd, object? selection)
    {
        if (selection == null)
            return;

        if (selection is int i)
            SendMessage(hwnd, BFFM_SETSELECTION, IntPtr.Zero, new IntPtr(i));
        else if (selection is long l)
            SendMessage(hwnd, BFFM_SETSELECTION, IntPtr.Zero, new IntPtr(l));
        else if (selection is IntPtr ptr)
            SendMessage(hwnd, BFFM_SETSELECTION, IntPtr.Zero, ptr);
        else
            SendMessage(hwnd, BFFM_SETSELECTION, new IntPtr(1), selection.ToString() ?? string.Empty);
    }

    public bool VBGetOpenFileName(ref string fileName, ref string fileTitle, bool fileMustExist,
        bool multiSelect, ref bool readOnly, bool hideReadOnly, ref string filter,
        ref int filterIndex, string? initDir, string? dlgTitle, string? defaultExt,
        IntPtr owner, ref int flags)
    {
        _apiReturn = 0;
        _extendedError = 0;

        var ofn = new OpenFileName
        {
            lStructSize = Marshal.SizeOf<OpenFileName>(),
            hwndOwner = owner,
            lpstrInitialDir = initDir ?? string.Empty,
            lpstrDefExt = defaultExt ?? string.Empty,
            lpstrTitle = dlgTitle ?? string.Empty,
            lpstrFilter = BuildFilter(filter),
            nFilterIndex = filterIndex,
            lpstrFile = new StringBuilder(MAX_PATH),
            nMaxFile = MAX_PATH,
            lpstrFileTitle = new StringBuilder(MAX_FILE),
            nMaxFileTitle = MAX_FILE
        };

        ofn.lpstrFile.Append(fileName ?? string.Empty);
        ofn.lpstrFileTitle.Append(fileTitle ?? string.Empty);

        var mask = ~(int)(EOpenFile.OFN_ENABLEHOOK | EOpenFile.OFN_ENABLETEMPLATE);
        ofn.flags = (fileMustExist ? (int)EOpenFile.OFN_FILEMUSTEXIST : 0)
                    | (multiSelect ? (int)EOpenFile.OFN_ALLOWMULTISELECT : 0)
                    | (readOnly ? (int)EOpenFile.OFN_READONLY : 0)
                    | (hideReadOnly ? (int)EOpenFile.OFN_HIDEREADONLY : 0)
                    | (flags & mask);

        var result = GetOpenFileName(ref ofn);
        _apiReturn = result ? 1 : 0;

        if (result)
        {
            fileName = StrZToStr(ofn.lpstrFile.ToString());
            fileTitle = StrZToStr(ofn.lpstrFileTitle.ToString());
            flags = ofn.flags;
            filterIndex = ofn.nFilterIndex;
            filter = FilterLookup(ofn.lpstrFilter, filterIndex);
            readOnly = (ofn.flags & (int)EOpenFile.OFN_READONLY) != 0;
            return true;
        }

        _extendedError = CommDlgExtendedError();
        fileName = string.Empty;
        fileTitle = string.Empty;
        flags = 0;
        filterIndex = -1;
        filter = string.Empty;
        return false;
    }

