@page "/cost-forecast"
@rendermode InteractiveServer
@namespace HomeFront.Components.Pages
@layout HFComponent

@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data
@using System.Data
@using System.Text
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject ILogger<FCostForecast> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>Cost Forecasting - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-box">Processing...</div>
    </div>
}

<div class="cost-forecast-container">
    <div class="header-row">
        <h3>Cost Forecasting</h3>

        @* View toggle — Grid (the editable table) vs. Chart (per-row bar
           charts of Forecast1..12). Mirrors VB6 frame-tab semantics with a
           pair of radio buttons. *@
        <div class="cf-view-toggle" role="radiogroup" aria-label="View">
            <RadioControl TValue="ForecastViewMode" Name="cf-view" Value="ForecastViewMode.Grid" @bind-SelectedValue="_viewMode" Label="Grid" CssClass="cf-radio" />
            <RadioControl TValue="ForecastViewMode" Name="cf-view" Value="ForecastViewMode.Chart" @bind-SelectedValue="_viewMode" Label="Chart" CssClass="cf-radio" />
        </div>

        <ButtonControl CssClass="btn btn-primary" Disabled="@(!mDirty)" OnClick="() => SaveDataAsync(true)">Save Changes</ButtonControl>
    </div>

    <div class="grid-section">
        <GridControl @ref="ForecastGrid"
                TValue="ForecastRow"
                DataSource="@ForecastData"
                AllowSorting="true"
                AllowResizing="true"
                AllowSelection="true"
                Height="520px"
                ShowAsChart="@(_viewMode == ForecastViewMode.Chart)"
                ChartLabelField="@nameof(ForecastRow.POIndexDisplay)"
                ChartValueFields="@_forecastFieldNames"
                ChartValueLabels="@ForecastNames"
                ChartBarColor="#2563eb"
                ChartShowValues="false"
                EditSettingsRef="@editSettings"
                EventsRef="@gridEvents">
            <GridColumnsBase>
                <GridColumn Field="@nameof(ForecastRow.POIndexDisplay)" HeaderText="PO Index" Width="260px" AllowEditing="false" />
                @for (int fi = 1; fi <= 12; fi++)
                {
                    var idx = fi;
                    <GridColumn Field="@($"Forecast{idx}")" HeaderText="@GetForecastHeader(idx)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right">
                        <HeaderTemplate>
                            <span @ondblclick="() => RenameColumn(idx)" title="Double-click to rename" style="cursor:pointer">@GetForecastHeader(idx)</span>
                        </HeaderTemplate>
                    </GridColumn>
                }
            </GridColumnsBase>
        </GridControl>
    </div>

    <div class="forecast-panel">
        <div class="checkbox-row">
            <CheckBoxControl @bind-Checked="CalcPrices" Label="Calculate new vendor price forecasts" />
        </div>

        <div class="form-row">
            <label class="@(CalcPrices ? "label-enabled" : "label-disabled")">Calculate</label>
            <DropDownListControl TValue="int" TItem="IndexedOption" DataSource="@ForecastOptions"
                                 ValueFieldName="Value" TextFieldName="Text"
                                 @bind-Value="ForecastStartIndex" Enabled="@CalcPrices" Width="180px" />
            <span class="@(CalcPrices ? "label-enabled" : "label-disabled")">thru</span>
            <DropDownListControl TValue="int" TItem="IndexedOption" DataSource="@ForecastOptions"
                                 ValueFieldName="Value" TextFieldName="Text"
                                 @bind-Value="ForecastEndIndex" Enabled="@CalcPrices" Width="180px" />
        </div>

        <div class="form-row">
            <label class="@(CalcPrices ? "label-enabled" : "label-disabled")">Cost Basis</label>
            <DropDownListControl TValue="int" TItem="IndexedOption" DataSource="@CostBasisOptions"
                                 ValueFieldName="Value" TextFieldName="Text"
                                 @bind-Value="CostBasisIndex" Enabled="@CalcPrices" Width="180px" />
        </div>

        <div class="form-row">
            @if (CalcPrices)
            {
                <ButtonControl CssClass="btn btn-warning" OnClick="UpdateForecastsAsync">Update Forecasted Prices</ButtonControl>
            }
        </div>
    </div>
</div>

@code {
private GridControl<ForecastRow>? ForecastGrid;

    private bool IsLoading;
    private bool mDirty;
    private bool CalcPrices;

    // ── View toggle (Grid / Chart) ────────────────────────────────────
    private enum ForecastViewMode { Grid, Chart }
    private ForecastViewMode _viewMode = ForecastViewMode.Grid;

    // Forecast1..Forecast12 field names — fed to GridControl.ChartValueFields
    // so each row is rendered as a 12-bar mini chart in chart mode.
    private static readonly List<string> _forecastFieldNames =
        Enumerable.Range(1, 12).Select(i => $"Forecast{i}").ToList();

    private List<ForecastRow> ForecastData = new();
    private List<string> ForecastNames = new();
    private List<string> CostBasisItems = new();

    private int _forecastStartIndex;
    private int _forecastEndIndex;
    private int ForecastStartIndex
    {
        get => _forecastStartIndex;
        set
        {
            _forecastStartIndex = value;
            if (_forecastEndIndex < _forecastStartIndex) _forecastEndIndex = _forecastStartIndex;
        }
    }
    private int ForecastEndIndex
    {
        get => _forecastEndIndex;
        set
        {
            _forecastEndIndex = value;
            if (_forecastEndIndex < _forecastStartIndex) _forecastStartIndex = _forecastEndIndex;
        }
    }
    private int CostBasisIndex;

    // Selectable-option projections for the DropDownListControls. The lists they
    // project (ForecastNames / CostBasisItems) can change at runtime (e.g. after
    // a column rename), so these are computed properties rather than cached lists.
    private sealed record IndexedOption(int Value, string Text);

    private List<IndexedOption> ForecastOptions =>
        ForecastNames.Select((name, i) => new IndexedOption(i, name)).ToList();

    private List<IndexedOption> CostBasisOptions =>
        CostBasisItems.Select((name, i) => new IndexedOption(i, name)).ToList();

    private readonly EditSettings editSettings = new()
    {
        AllowAdding = false,
        AllowEditing = true,
        AllowDeleting = false,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };

    private readonly GridControlEvents<ForecastRow> gridEvents = new();

    protected override async Task OnInitializedAsync()
    {
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<ForecastRow>>(this, OnCellSaved);
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            await LoadCostTypesAsync();
            ForecastData.Clear();

            var sql = @"
                SELECT POIndex, Description,
                       ForecastPercent1, ForecastPercent2, ForecastPercent3, ForecastPercent4,
                       ForecastPercent5, ForecastPercent6, ForecastPercent7, ForecastPercent8,
                       ForecastPercent9, ForecastPercent10, ForecastPercent11, ForecastPercent12
                FROM tblPOIndex
                WHERE DivisionID = @DivisionID
                ORDER BY POIndex";
            var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });

            foreach (var row in rows)
            {
                var poIndex = row["POIndex"]?.ToString() ?? "";
                var desc = row["Description"]?.ToString() ?? "";
                var display = poIndex;
                if (!string.IsNullOrWhiteSpace(desc) && !string.Equals(poIndex, desc, StringComparison.OrdinalIgnoreCase))
                    display = $"{poIndex} {desc}";

                ForecastData.Add(new ForecastRow
                {
                    POIndex = poIndex,
                    POIndexDisplay = display,
                    Forecast1 = ToNullableDecimal(row["ForecastPercent1"]),
                    Forecast2 = ToNullableDecimal(row["ForecastPercent2"]),
                    Forecast3 = ToNullableDecimal(row["ForecastPercent3"]),
                    Forecast4 = ToNullableDecimal(row["ForecastPercent4"]),
                    Forecast5 = ToNullableDecimal(row["ForecastPercent5"]),
                    Forecast6 = ToNullableDecimal(row["ForecastPercent6"]),
                    Forecast7 = ToNullableDecimal(row["ForecastPercent7"]),
                    Forecast8 = ToNullableDecimal(row["ForecastPercent8"]),
                    Forecast9 = ToNullableDecimal(row["ForecastPercent9"]),
                    Forecast10 = ToNullableDecimal(row["ForecastPercent10"]),
                    Forecast11 = ToNullableDecimal(row["ForecastPercent11"]),
                    Forecast12 = ToNullableDecimal(row["ForecastPercent12"])
                });
            }

            ForecastStartIndex = 0;
            ForecastEndIndex = 0;
            CostBasisIndex = 0;
            mDirty = false;
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error loading data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCostTypesAsync()
    {
        ForecastNames = Enumerable.Range(1, 12).Select(i => $"Forecast {i}").ToList();

        var rows = await db.QueryAsync(@"
            SELECT Item, ISNULL(NULLIF(Custom_Description,''), Item) AS Description
            FROM CustomDescriptions
            WHERE Item LIKE 'Forecast%'
            ORDER BY Item");

        foreach (var row in rows)
        {
            var item = row["Item"]?.ToString() ?? "";
            var desc = row["Description"]?.ToString() ?? "";
            if (item.StartsWith("Forecast", StringComparison.OrdinalIgnoreCase)
                && int.TryParse(item.Replace("Forecast", ""), out var idx)
                && idx >= 1 && idx <= 12)
            {
                ForecastNames[idx - 1] = string.IsNullOrWhiteSpace(desc) ? $"Forecast {idx}" : desc;
            }
        }

        CostBasisItems = new List<string>
        {
            "Current Cost",
            "Next Cost 1",
            "Next Cost 2",
            "Last Cost 1",
            "Last Cost 2",
            "Last Cost 3"
        };
        CostBasisItems.AddRange(ForecastNames);
    }

    private string GetForecastHeader(int index) =>
        ForecastNames.Count >= index ? ForecastNames[index - 1] : $"Forecast {index}";

    private async Task<bool> SaveDataAsync(bool prompt)
    {
        if (!mDirty) return true;

        if (prompt)
        {
            var confirm = await Dialogs.ConfirmAsync(
                "This data has changed.\n\nDo you want to save the changes?");
            if (!confirm) return true;
        }

        IsLoading = true;
        StateHasChanged();

        try
        {
            const string sql = @"
                UPDATE tblPOIndex
                SET ForecastPercent1=@F1,
                    ForecastPercent2=@F2,
                    ForecastPercent3=@F3,
                    ForecastPercent4=@F4,
                    ForecastPercent5=@F5,
                    ForecastPercent6=@F6,
                    ForecastPercent7=@F7,
                    ForecastPercent8=@F8,
                    ForecastPercent9=@F9,
                    ForecastPercent10=@F10,
                    ForecastPercent11=@F11,
                    ForecastPercent12=@F12
                WHERE DivisionID IN (0,@DivisionID) AND POIndex=@POIndex";

            foreach (var row in ForecastData)
            {
                await db.ExecuteAsync(sql, new
                {
                    SessionState.DivisionID,
                    row.POIndex,
                    F1 = row.Forecast1,
                    F2 = row.Forecast2,
                    F3 = row.Forecast3,
                    F4 = row.Forecast4,
                    F5 = row.Forecast5,
                    F6 = row.Forecast6,
                    F7 = row.Forecast7,
                    F8 = row.Forecast8,
                    F9 = row.Forecast9,
                    F10 = row.Forecast10,
                    F11 = row.Forecast11,
                    F12 = row.Forecast12
                });
            }

            mDirty = false;
            return true;
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error saving: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void OnCellSaved(CellSaveArgs<ForecastRow> args)
    {
        if (args.Data != null)
            mDirty = true;
    }

    private async Task UpdateForecastsAsync()
    {
        var start = Math.Min(ForecastStartIndex, ForecastEndIndex) + 1;
        var end = Math.Max(ForecastStartIndex, ForecastEndIndex) + 1;

        if (start < 1 || end < 1 || start > 12 || end > 12) return;

        var lines = new List<string>();
        for (var i = start; i <= end; i++)
            lines.Add($"   • {GetForecastHeader(i)}");

        var message =
            "This will update your forecasted cost database.\n" +
            "It will re-calculate the following forecast indexes\n" +
            "for all vendors. Are you sure this is what you want\n" +
            "to do?\n\n" +
            string.Join("\n", lines);

        if (!await Dialogs.ConfirmAsync(message)) return;
        if (!await SaveDataAsync(false)) return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            var fcstBasis = GetCostBasisField();
            var updates = new System.Text.StringBuilder();
            for (var i = start; i <= end; i++)
                updates.AppendLine($", Forecast{i} = {fcstBasis} + ({fcstBasis} * ForecastPercent{i} / 100)");

            if (updates.Length == 0) return;

            var setClause = "SET " + updates.ToString().TrimStart(' ', ',', '\r', '\n');

            await db.ExecuteAsync("ALTER TABLE tblVendorCost DISABLE TRIGGER ALL");

            var updateSql = $@"
                UPDATE t1
                {setClause}
                FROM tblVendorCost t1
                INNER JOIN tblPhaseItem t2
                    ON t1.DivisionID = t2.DivisionID AND t1.Phase = t2.Phase AND t1.Item = t2.Item
                INNER JOIN tblPOIndex p
                    ON p.DivisionID = t2.DivisionID AND p.POIndex = t2.POIndex
                WHERE t1.DivisionID = @DivisionID";
            await db.ExecuteAsync(updateSql, new { SessionState.DivisionID });

            await db.ExecuteAsync("ALTER TABLE tblVendorCost ENABLE TRIGGER ALL");
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error updating forecasts: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private string GetCostBasisField()
    {
        return CostBasisIndex switch
        {
            0 => "Current_Cost",
            1 => "Next_Cost1",
            2 => "Next_Cost2",
            3 => "Last_Cost1",
            4 => "Last_Cost2",
            5 => "Last_Cost3",
            _ => $"Forecast{Math.Max(1, CostBasisIndex - 5)}"
        };
    }

    // ── Rename Forecast Column (from VB6 RenameColumn / RenameForecast) ──
    private async Task RenameColumn(int forecastIndex)
    {
        if (forecastIndex < 1 || forecastIndex > 12) return;
        var currentName = ForecastNames[forecastIndex - 1];
        var newName = await Dialogs.PromptAsync(
            $"Enter a new description for Forecast{forecastIndex}.", "", currentName);
        if (string.IsNullOrWhiteSpace(newName)) return;
        newName = newName.Trim();
        if (newName.Length > 30) newName = newName.Substring(0, 30);

        ForecastNames[forecastIndex - 1] = newName;
        // Update CostBasisItems entry (index forecastIndex + 5)
        if (forecastIndex + 5 < CostBasisItems.Count)
            CostBasisItems[forecastIndex + 5] = newName;

        await db.ExecuteAsync(@"
            UPDATE CustomDescriptions
            SET Custom_Description=@NewName
            WHERE Item=@ItemKey",
            new { NewName = newName, ItemKey = $"Forecast{forecastIndex}" });

        StateHasChanged();
    }

    private static decimal? ToNullableDecimal(object? val)
    {
        if (val == null || val == DBNull.Value) return null;
        var s = val.ToString();
        return string.IsNullOrWhiteSpace(s) ? null : Convert.ToDecimal(val);
    }

    public class ForecastRow
    {
        public string POIndex { get; set; } = "";
        public string POIndexDisplay { get; set; } = "";

        public decimal? Forecast1 { get; set; }
        public decimal? Forecast2 { get; set; }
        public decimal? Forecast3 { get; set; }
        public decimal? Forecast4 { get; set; }
        public decimal? Forecast5 { get; set; }
        public decimal? Forecast6 { get; set; }
        public decimal? Forecast7 { get; set; }
        public decimal? Forecast8 { get; set; }
        public decimal? Forecast9 { get; set; }
        public decimal? Forecast10 { get; set; }
        public decimal? Forecast11 { get; set; }
        public decimal? Forecast12 { get; set; }
    }
}
