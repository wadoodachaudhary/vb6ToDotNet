```razor
@page "/cost-forecast"
@rendermode InteractiveServer

@using HomeFront.Data
@using System.Data
@inject IJSRuntime JSRuntime

<PageTitle>Cost Forecasting - HomeFront</PageTitle>

<style>
    .cost-forecast-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 16px;
        font-family: Arial, Helvetica, sans-serif;
    }
    .header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .header-row h3 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: #333;
    }
    .grid-section {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        overflow: hidden;
        background: #fff;
    }
    .forecast-panel {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 12px;
        background: #f8f9fa;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
    }
    .form-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .form-row label {
        min-width: 90px;
        text-align: right;
        font-size: 13px;
        font-weight: 600;
    }
    .label-disabled { color: #9aa0a6; }
    .label-enabled { color: #212529; }
    .form-row select {
        min-width: 180px;
        padding: 4px 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 13px;
        background: #fff;
    }
    .btn {
        padding: 6px 12px;
        border-radius: 4px;
        border: 1px solid #ced4da;
        background: #fff;
        font-size: 13px;
        cursor: pointer;
    }
    .btn:hover { background: #e9ecef; }
    .btn-primary { background: #0d6efd; color: #fff; border-color: #0d6efd; }
    .btn-warning { background: #ffc107; border-color: #ffc107; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .loading-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }
    .loading-box {
        background: #fff;
        padding: 16px 24px;
        border-radius: 6px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.2);
        font-size: 14px;
        font-weight: 500;
    }
</style>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-box">Processing...</div>
    </div>
}

<div class="cost-forecast-container">
    <div class="header-row">
        <h3>Cost Forecasting</h3>
        <button class="btn btn-primary" disabled="@(!mDirty)" @onclick="() => SaveDataAsync(true)">Save Changes</button>
    </div>

    <div class="grid-section">
        <HfGrid @ref="ForecastGrid"
                TValue="ForecastRow"
                DataSource="@ForecastData"
                AllowSorting="true"
                AllowResizing="true"
                AllowSelection="true"
                Height="520px"
                EditSettingsRef="@editSettings"
                EventsRef="@gridEvents">
            <HfGridColumnsBase>
                <HfGridColumn Field="@nameof(ForecastRow.POIndexDisplay)" HeaderText="PO Index" Width="260px" AllowEditing="false" />
                <HfGridColumn Field="@nameof(ForecastRow.Forecast1)" HeaderText="@GetForecastHeader(1)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                <HfGridColumn Field="@nameof(ForecastRow.Forecast2)" HeaderText="@GetForecastHeader(2)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                <HfGridColumn Field="@nameof(ForecastRow.Forecast3)" HeaderText="@GetForecastHeader(3)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                <HfGridColumn Field="@nameof(ForecastRow.Forecast4)" HeaderText="@GetForecastHeader(4)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                <HfGridColumn Field="@nameof(ForecastRow.Forecast5)" HeaderText="@GetForecastHeader(5)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                <HfGridColumn Field="@nameof(ForecastRow.Forecast6)" HeaderText="@GetForecastHeader(6)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                <HfGridColumn Field="@nameof(ForecastRow.Forecast7)" HeaderText="@GetForecastHeader(7)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                <HfGridColumn Field="@nameof(ForecastRow.Forecast8)" HeaderText="@GetForecastHeader(8)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                <HfGridColumn Field="@nameof(ForecastRow.Forecast9)" HeaderText="@GetForecastHeader(9)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                <HfGridColumn Field="@nameof(ForecastRow.Forecast10)" HeaderText="@GetForecastHeader(10)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                <HfGridColumn Field="@nameof(ForecastRow.Forecast11)" HeaderText="@GetForecastHeader(11)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                <HfGridColumn Field="@nameof(ForecastRow.Forecast12)" HeaderText="@GetForecastHeader(12)" Width="100px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
            </HfGridColumnsBase>
        </HfGrid>
    </div>

    <div class="forecast-panel">
        <div class="checkbox-row">
            <input type="checkbox" id="chkCalc" @bind="CalcPrices" />
            <label for="chkCalc">Calculate new vendor price forecasts</label>
        </div>

        <div class="form-row">
            <label class="@(CalcPrices ? "label-enabled" : "label-disabled")">Calculate</label>
            <select @bind="ForecastStartIndex" disabled="@(!CalcPrices)">
                @for (int i = 0; i < ForecastNames.Count; i++)
                {
                    <option value="@i">@ForecastNames[i]</option>
                }
            </select>
            <span class="@(CalcPrices ? "label-enabled" : "label-disabled")">thru</span>
            <select @bind="ForecastEndIndex" disabled="@(!CalcPrices)">
                @for (int i = 0; i < ForecastNames.Count; i++)
                {
                    <option value="@i">@ForecastNames[i]</option>
                }
            </select>
        </div>

        <div class="form-row">
            <label class="@(CalcPrices ? "label-enabled" : "label-disabled")">Cost Basis</label>
            <select @bind="CostBasisIndex" disabled="@(!CalcPrices)">
                @for (int i = 0; i < CostBasisItems.Count; i++)
                {
                    <option value="@i">@CostBasisItems[i]</option>
                }
            </select>
        </div>

        <div class="form-row">
            @if (CalcPrices)
            {
                <button class="btn btn-warning" @onclick="UpdateForecastsAsync">Update Forecasted Prices</button>
            }
        </div>
    </div>
</div>

@code {
    private readonly DbWrapperSqlServer db = new();
    private HfGrid<ForecastRow>? ForecastGrid;

    private bool IsLoading;
    private bool mDirty;
    private bool CalcPrices;

    private List<ForecastRow> ForecastData = new();
    private List<string> ForecastNames = new();
    private List<string> CostBasisItems = new();

    private int _forecastStartIndex;
    private int _forecastEndIndex;
    private int ForecastStartIndex
    {
        get => _forecastStartIndex;
        set
        {
            _forecastStartIndex = value;
            if (_forecastEndIndex < _forecastStartIndex) _forecastEndIndex = _forecastStartIndex;
        }
    }
    private int ForecastEndIndex
    {
        get => _forecastEndIndex;
        set
        {
            _forecastEndIndex = value;
            if (_forecastEndIndex < _forecastStartIndex) _forecastStartIndex = _forecastEndIndex;
        }
    }
    private int CostBasisIndex;

    private readonly HfEditSettings editSettings = new()
    {
        AllowAdding = false,
        AllowEditing = true,
        AllowDeleting = false,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };

    private readonly HfGridEvents<ForecastRow> gridEvents = new();

    private int DivisionID => 1;

    protected override async Task OnInitializedAsync()
    {
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<ForecastRow>>(this, OnCellSaved);
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            await LoadCostTypesAsync();
            ForecastData.Clear();

            var sql = @"
                SELECT POIndex, Description,
                       ForecastPercent1, ForecastPercent2, ForecastPercent3, ForecastPercent4,
                       ForecastPercent5, ForecastPercent6, ForecastPercent7, ForecastPercent8,
                       ForecastPercent9, ForecastPercent10, ForecastPercent11, ForecastPercent12
                FROM tblPOIndex
                WHERE DivisionID = @DivisionID
                ORDER BY POIndex";
            var rows = await db.QueryAsync(sql, new { DivisionID });

            foreach (var row in rows)
            {
                var poIndex = row["POIndex"]?.ToString() ?? "";
                var desc = row["Description"]?.ToString() ?? "";
                var display = poIndex;
                if (!string.IsNullOrWhiteSpace(desc) && !string.Equals(poIndex, desc, StringComparison.OrdinalIgnoreCase))
                    display = $"{poIndex} {desc}";

                ForecastData.Add(new ForecastRow
                {
                    POIndex = poIndex,
                    POIndexDisplay = display,
                    Forecast1 = ToNullableDecimal(row["ForecastPercent1"]),
                    Forecast2 = ToNullableDecimal(row["ForecastPercent2"]),
                    Forecast3 = ToNullableDecimal(row["ForecastPercent3"]),
                    Forecast4 = ToNullableDecimal(row["ForecastPercent4"]),
                    Forecast5 = ToNullableDecimal(row["ForecastPercent5"]),
                    Forecast6 = ToNullableDecimal(row["ForecastPercent6"]),
                    Forecast7 = ToNullableDecimal(row["ForecastPercent7"]),
                    Forecast8 = ToNullableDecimal(row["ForecastPercent8"]),
                    Forecast9 = ToNullableDecimal(row["ForecastPercent9"]),
                    Forecast10 = ToNullableDecimal(row["ForecastPercent10"]),
                    Forecast11 = ToNullableDecimal(row["ForecastPercent11"]),
                    Forecast12 = ToNullableDecimal(row["ForecastPercent12"])
                });
            }

            ForecastStartIndex = 0;
            ForecastEndIndex = 0;
            CostBasisIndex = 0;
            mDirty = false;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCostTypesAsync()
    {
        ForecastNames = Enumerable.Range(1, 12).Select(i => $"Forecast {i}").ToList();

        var rows = await db.QueryAsync(@"
            SELECT Item, ISNULL(NULLIF(Custom_Description,''), Item) AS Description
            FROM CustomDescriptions
            WHERE Item LIKE 'Forecast%'
            ORDER BY Item");

        foreach (var row in rows)
        {
            var item = row["Item"]?.ToString() ?? "";
            var desc = row["Description"]?.ToString() ?? "";
            if (item.StartsWith("Forecast", StringComparison.OrdinalIgnoreCase)
                && int.TryParse(item.Replace("Forecast", ""), out var idx)
                && idx >= 1 && idx <= 12)
            {
                ForecastNames[idx - 1] = string.IsNullOrWhiteSpace(desc) ? $"Forecast {idx}" : desc;
            }
        }

        CostBasisItems = new List<string>
        {
            "Current Cost",
            "Next Cost 1",
            "Next Cost 2",
            "Last Cost 1",
            "Last Cost 2",
            "Last Cost 3"
        };
        CostBasisItems.AddRange(ForecastNames);
    }

    private string GetForecastHeader(int index) =>
        ForecastNames.Count >= index ? ForecastNames[index - 1] : $"Forecast {index}";

    private async Task<bool> SaveDataAsync(bool prompt)
    {
        if (!mDirty) return true;

        if (prompt)
        {
            var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
                "This data has changed.\n\nDo you want to save the changes?");
            if (!confirm) return true;
        }

        IsLoading = true;
        StateHasChanged();

        try
        {
            const string sql = @"
                UPDATE tblPOIndex
                SET ForecastPercent1=@F1,
                    ForecastPercent2=@F2,
                    ForecastPercent3=@F3,
                    ForecastPercent4=@F4,
                    ForecastPercent5=@F5,
                    ForecastPercent6=@F6,
                    ForecastPercent7=@F7,
                    ForecastPercent8=@F8,
                    ForecastPercent9=@F9,
                    ForecastPercent10=@F10,
                    ForecastPercent11=@F11,
                    ForecastPercent12=@F12
                WHERE DivisionID IN (0,@DivisionID) AND POIndex=@POIndex";

            foreach (var row in ForecastData)
            {
                await db.ExecuteAsync(sql, new
                {
                    DivisionID,
                    row.POIndex,
                    F1 = row.Forecast1,
                    F2 = row.Forecast2,
                    F3 = row.Forecast3,
                    F4 = row.Forecast4,
                    F5 = row.Forecast5,
                    F6 = row.Forecast6,
                    F7 = row.Forecast7,
                    F8 = row.Forecast8,
                    F9 = row.Forecast9,
                    F10 = row.Forecast10,
                    F11 = row.Forecast11,
                    F12 = row.Forecast12
                });
            }

            mDirty = false;
            return true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void OnCellSaved(CellSaveArgs<ForecastRow> args)
    {
        if (args.Data != null)
            mDirty = true;
    }

    private async Task UpdateForecastsAsync()
    {
        var start = Math.Min(ForecastStartIndex, ForecastEndIndex) + 1;
        var end = Math.Max(ForecastStartIndex, ForecastEndIndex) + 1;

        if (start < 1 || end < 1 || start > 12 || end > 12) return;

        var lines = new List<string>();
        for (var i = start; i <= end; i++)
            lines.Add($"   • {GetForecastHeader(i)}");

        var message =
            "This will update your forecasted cost database.\n" +
            "It will re-calculate the following forecast indexes\n" +
            "for all vendors. Are you sure this is what you want\n" +
            "to do?\n\n" +
            string.Join("\n", lines);

        if (!await JSRuntime.InvokeAsync<bool>("confirm", message)) return;
        if (!await SaveDataAsync(false)) return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            var fcstBasis = GetCostBasisField();
            var updates = new System.Text.StringBuilder();
            for (var i = start; i <= end; i++)
                updates.AppendLine($", Forecast{i} = {fcstBasis} + ({fcstBasis} * ForecastPercent{i} / 100)");

            if (updates.Length == 0) return;

            var setClause = "SET " + updates.ToString().TrimStart(' ', ',', '\r', '\n');

            await db.ExecuteAsync("ALTER TABLE tblVendorCost DISABLE TRIGGER ALL");

            var updateSql = $@"
                UPDATE t1
                {setClause}
                FROM tblVendorCost t1
                INNER JOIN tblPhaseItem t2
                    ON t1.DivisionID = t2.DivisionID AND t1.Phase = t2.Phase AND t1.Item = t2.Item
                INNER JOIN tblPOIndex p
                    ON p.DivisionID = t2.DivisionID AND p.POIndex = t2.POIndex
                WHERE t1.DivisionID = @DivisionID";
            await db.ExecuteAsync(updateSql, new { DivisionID });

            await db.ExecuteAsync("ALTER TABLE tblVendorCost ENABLE TRIGGER ALL");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error updating forecasts: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private string GetCostBasisField()
    {
        return CostBasisIndex switch
        {
            0 => "Current_Cost",
            1 => "Next_Cost1",
            2 => "Next_Cost2",
            3 => "Last_Cost1",
            4 => "Last_Cost2",
            5 => "Last_Cost3",
            _ => $"Forecast{Math.Max(1, CostBasisIndex - 5)}"
        };
    }

    private static decimal? ToNullableDecimal(object? val)
    {
        if (val == null || val == DBNull.Value) return null;
        var s = val.ToString();
        return string.IsNullOrWhiteSpace(s) ? null : Convert.ToDecimal(val);
    }

    public class ForecastRow
    {
        public string POIndex { get; set; } = "";
        public string POIndexDisplay { get; set; } = "";

        public decimal? Forecast1 { get; set; }
        public decimal? Forecast2 { get; set; }
        public decimal? Forecast3 { get; set; }
        public decimal? Forecast4 { get; set; }
        public decimal? Forecast5 { get; set; }
        public decimal? Forecast6 { get; set; }
        public decimal? Forecast7 { get; set; }
        public decimal? Forecast8 { get; set; }
        public decimal? Forecast9 { get; set; }
        public decimal? Forecast10 { get; set; }
        public decimal? Forecast11 { get; set; }
        public decimal? Forecast12 { get; set; }
    }
}
```