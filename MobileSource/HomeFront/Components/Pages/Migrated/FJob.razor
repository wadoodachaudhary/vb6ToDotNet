    private async Task LoadCommunities()
    {
        try
        {
            var dt = db.SqlExec(
                "SELECT c.Description, c.Area FROM tblLocality c JOIN DivisionCommunities d ON c.Area=d.Community WHERE d.DivisionID=@DivisionID ORDER BY c.Description",
                new { SessionState.DivisionID });
            // HHM-392 (reopen): rows with a blank Description rendered as empty dropdown
            // items. VB6 LoadComboBox (MMisc.bas:3356) trims the display text; surface the
            // Area key as the fallback display and drop rows with neither, so the list never
            // shows blank entries.
            CommunityItems = dt.AsEnumerable()
                .Select(r => new
                {
                    Desc = (r["Description"]?.ToString() ?? "").Trim(),
                    Area = r["Area"]?.ToString() ?? ""   // key stays untrimmed (VB6 tag key is raw rs(1))
                })
                .Select(x => new ComboItem
                {
                    Text = x.Desc.Length > 0 ? x.Desc : x.Area.Trim(),
                    Value = x.Area
                })
                .Where(i => i.Text.Length > 0)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadCommunities error");

        }
    }

