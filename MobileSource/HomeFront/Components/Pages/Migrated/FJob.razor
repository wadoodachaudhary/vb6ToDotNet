    // ── Load Properties ──────────────────────────────────────────────────
    private async Task LoadProperties()
    {
        PropertiesData = new();
        _propIdSeq = 0;
        _curCategoryId = 0;
        int r = 0;

        try
        {
            DataTable? rs = null;
            if (!string.IsNullOrEmpty(mJob) && mJob != "\x01")
            {
                rs = db.SqlExec(
                    @"SELECT j.shellscheduletemplate, j.scheduletemplate, j.permitnumber, j.permitreceiveddate,
                             j.start_date, j.preconScheduleTemplate, j.preconStartDate,
                             j.LabourTaxGroup, j.MaterialTaxGroup, j.SubcontractTaxGroup,
                             j.EquipmentTaxGroup, j.OverheadTaxGroup, j.OtherTaxGroup, j.ARTaxGroup,
                             j.IntacctDepartment, j.TarionEnrollmentNumber,
                             ISNULL(ISNULL(p.TarionBuilderNumber,c.TarionBuilderNumber),j.TarionBuilderNumber) TarionBuilderNumber,
                             CASE WHEN ISNULL(p.TarionBuilderNumber,'')<>'' THEN 1
                                  WHEN ISNULL(c.TarionBuilderNumber,'')<>'' THEN 1
                                  ELSE 0 END TarionBuilderReadOnly
                      FROM tblJobs j
                      LEFT JOIN tbllocality c ON c.area=j.community
                      LEFT JOIN CommunityPhase p ON p.community=j.community AND p.communityphase=j.communityphase
                      WHERE j.DivisionID=@DivisionID AND j.job_no=@Job",
                    new { SessionState.DivisionID, Job = mJob });
            }

            string GetVal(string col)
            {
                if (rs == null || rs.Rows.Count == 0) return "";
                return rs.Rows[0][col]?.ToString() ?? "";
            }

            // Load tax groups for picklist
            var taxGroups = "";
            try
            {
                var tgDt = db.SqlExec("SELECT taxgroup, description FROM TaxGroups WHERE DivisionID IN (0, @DivisionID) ORDER BY 1",
                    new { SessionState.DivisionID });
                taxGroups = string.Join("|", tgDt.AsEnumerable().Select(row => $"{row[0]}\t{row[1]}"));
            }
            catch { /* non-critical */ }

            // Schedule-templates picklist (VB6: HFApp.Options.ValueByName("ScheduleTemplates"))
            var scheduleTemplates = await GetOptionValue("ScheduleTemplates");

            // Tarion fields are option-gated (VB6: HFApp.Options.ValueByName("EnableTarionFields")="true")
            var enableTarion = mEnableTarion;

            // Intacct departments picklist (VB6: select id,name from IntacctDepartments ...)
            var intacctDepartments = "";
            if (AccountingSystem == "Intacct")
            {
                try
                {
                    var idDt = db.SqlExec("SELECT id, name FROM IntacctDepartments WHERE DivisionID=@DivisionID ORDER BY 1",
                        new { SessionState.DivisionID });
                    intacctDepartments = string.Join("|", idDt.AsEnumerable().Select(row => $"{row[0]}\t{row[1]}"));
                }
                catch { /* non-critical */ }
            }

            // Scheduling  (mprop_* = the index the NEXT AddProperty will occupy → r + 1)
            AddPropertyCategory(ref r, "Scheduling");
            mprop_PermitNumber = r + 1;
            AddProperty(ref r, "Scheduling", "Permit Number", GetVal("PermitNumber"), "Str");
            mprop_PermitDate = r + 1;
            AddProperty(ref r, "Scheduling", "Permit Received Date", GetVal("PermitReceivedDate"), "DateTime");

            // Precon Template + Precon Start Date — VB6: gated on EnablePreconJobs="true"
            if (mEnablePreconJobs)
            {
                mprop_PreconTemplate = r + 1;
                AddProperty(ref r, "Scheduling", "Precon Template", GetVal("PreconScheduleTemplate"), "Str", scheduleTemplates);
                mprop_PreconStart = r + 1;
                AddProperty(ref r, "Scheduling", "Precon Start Date", GetVal("PreconStartDate"), "DateTime");
            }

            if (mIsMultifamily)
            {
                mprop_ShellTemplate = r + 1;
                AddProperty(ref r, "Scheduling", "Shell Template", GetVal("ShellScheduleTemplate"), "Str", scheduleTemplates);
            }

            mprop_UnitTemplate = r + 1;
            AddProperty(ref r, "Scheduling", mIsMultifamily ? "Unit Template" : "Const Template",
                GetVal("ScheduleTemplate"), "Str", scheduleTemplates);

            mprop_ConstStart = r + 1;
            AddProperty(ref r, "Scheduling", "Const Start Date", GetVal("Start_Date"), "DateTime");

            // Tarion (VB6: built-in property category, gated on EnableTarionFields="true")
            if (enableTarion)
            {
                AddPropertyCategory(ref r, "Tarion");
                mprop_TarionBuilderNumber = r + 1;
                // Builder No is READONLY when supplied by the community/phase (TarionBuilderReadOnly=1)
                var tarionBuilderReadOnly = GetVal("TarionBuilderReadOnly") == "1";
                AddProperty(ref r, "Tarion", "Builder No", GetVal("TarionBuilderNumber"),
                    tarionBuilderReadOnly ? "READONLY" : "Str");
                mprop_TarionEnrollmentNumber = r + 1;
                AddProperty(ref r, "Tarion", "Job Enrollment No", GetVal("TarionEnrollmentNumber"), "Str");
            }

            // Intacct (VB6: built-in property category when accounting system is Intacct)
            if (AccountingSystem == "Intacct")
            {
                AddPropertyCategory(ref r, "Intacct");
                mprop_IntacctDepartment = r + 1;
                AddProperty(ref r, "Intacct", "Department", GetVal("IntacctDepartment"), "Str", intacctDepartments);
            }

            // Tax Groups
            AddPropertyCategory(ref r, "Tax Groups");
            mprop_LabTax = r + 1;
            AddProperty(ref r, "Tax Groups", "Labour", GetVal("LabourTaxGroup"), "Str", taxGroups);
            mprop_MatTax = r + 1;
            AddProperty(ref r, "Tax Groups", "Material", GetVal("MaterialTaxGroup"), "Str", taxGroups);
            mprop_SubTax = r + 1;
            AddProperty(ref r, "Tax Groups", "Subcontract", GetVal("SubContractTaxGroup"), "Str", taxGroups);
            mprop_EquTax = r + 1;
            AddProperty(ref r, "Tax Groups", "Equipment", GetVal("EquipmentTaxGroup"), "Str", taxGroups);
            mprop_OvrTax = r + 1;
            AddProperty(ref r, "Tax Groups", "Overhead", GetVal("OverheadTaxGroup"), "Str", taxGroups);
            mprop_OthTax = r + 1;
            AddProperty(ref r, "Tax Groups", "Other", GetVal("OtherTaxGroup"), "Str", taxGroups);
            mprop_ARTax = r + 1;
            AddProperty(ref r, "Tax Groups", "Accounts Receivable", GetVal("ARTaxGroup"), "Str", taxGroups);

            mprop_UserFlds = r + 1;

            // Load user-defined fields
            try
            {
                var fieldsDt = db.SqlExec("SELECT * FROM JobCustomFieldDefs ORDER BY Category, Name");
                DataTable? dataDt = null;
                if (!string.IsNullOrEmpty(mJob) && mJob != "\x01")
                {
                    dataDt = db.SqlExec("SELECT * FROM JobCustomFields WHERE divisionid=@DivisionID AND Job_No=@Job",
                        new { SessionState.DivisionID, Job = mJob });
                }

                string currentCategory = "";
                foreach (DataRow field in fieldsDt.Rows)
                {
                    var cat = field["category"]?.ToString() ?? "";
                    if (cat != currentCategory)
                    {
                        currentCategory = cat;
                        AddPropertyCategory(ref r, string.IsNullOrEmpty(cat) ? "unclassified" : cat);
                    }

                    var fieldName = field["Name"]?.ToString() ?? "";
                    var pickList = field["PickList"]?.ToString() ?? "";
                    var val = "";
                    if (dataDt != null && dataDt.Rows.Count > 0 && dataDt.Columns.Contains(fieldName))
                    {
                        val = dataDt.Rows[0][fieldName]?.ToString() ?? "";
                    }
                    AddProperty(ref r, currentCategory, fieldName, val, ResolvePropertyDataType(dataDt, fieldName), pickList);
                }
            }
            catch { /* non-critical */ }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadProperties error");

        }

        _collapsePropertiesTreeAfterRender = true;
    }

    private int _propIdSeq;       // running TreeGrid node id
    private int _curCategoryId;   // id of the category folder currently being filled

    private void AddPropertyCategory(ref int r, string category)
    {
        _curCategoryId = ++_propIdSeq;
        PropertiesData.Add(new PropertyRow
        {
            Id = _curCategoryId,
            ParentId = null,          // category folders are tree roots
            Category = category,
            Name = category,
            Value = "",
            DataType = "",
            PickList = "",
            IsCategory = true
        });
        r = PropertiesData.Count - 1;
    }

    private void AddProperty(ref int r, string category, string name, string value, string dataType, string pickList = "")
    {
        PropertiesData.Add(new PropertyRow
        {
            Id = ++_propIdSeq,
            ParentId = _curCategoryId, // leaf under the current category folder
            Category = category,
            Name = name,
            Value = value,
            DataType = dataType,
            PickList = pickList,
            IsCategory = false
        });
        r = PropertiesData.Count - 1;
    }

    // ── Load Contacts ────────────────────────────────────────────────────
    private async Task LoadContacts()
    {
        ContactsData = new();
        // HHM-406: run the UNION ALL for new jobs too — its LEFT JOINs return the three
        // ContactType rows with blank values exactly like VB6 (no empty-grid placeholder).
        try
        {
            var dt = db.SqlExec(
                @"SELECT 'PM' ContactType, p.*
                  FROM system_setup s
                  LEFT OUTER JOIN tblJobs j ON j.Job_No=@Job AND j.divisionid=s.id
                  LEFT OUTER JOIN tblProjectManager p ON j.PM=p.PM
                  WHERE s.id=@DivisionID
                  UNION ALL
                  SELECT 'Estimator', p.*
                  FROM system_setup s
                  LEFT OUTER JOIN tblJobs j ON j.Job_No=@Job AND j.divisionid=s.id
                  LEFT JOIN tblProjectManager p ON j.Estimator=p.PM
                  WHERE s.id=@DivisionID
                  UNION ALL
                  SELECT 'Purchaser', p.*
                  FROM system_setup s
                  LEFT OUTER JOIN tblJobs j ON j.Job_No=@Job AND j.divisionid=s.id
                  LEFT JOIN tblProjectManager p ON j.Purchaser=p.PM
                  WHERE s.id=@DivisionID",
                new { SessionState.DivisionID, Job = mJob });

            foreach (DataRow row in dt.Rows)
            {
                ContactsData.Add(new ContactRow
                {
                    ContactType = row["ContactType"]?.ToString() ?? "",
                    PM = row["PM"]?.ToString() ?? "",
                    PMName = row["PMName"]?.ToString() ?? "",
                    Phone = row["Phone"]?.ToString() ?? "",
                    Cell = row["Cell"]?.ToString() ?? "",
                    Fax = row["Fax"]?.ToString() ?? "",
                    Email = row["Email"]?.ToString() ?? "",
                    RowState = "CLEAN"
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadContacts error");

        }
    }

    // ── Load Job Contacts ────────────────────────────────────────────────
    private async Task LoadJobContacts()
    {
        JobContactsData = new();
        if (string.IsNullOrEmpty(mJob) || mJob == "\x01") return;
        try
        {
            // Load roles
            var roles = await GetOptionValue("JobContactRoles");
            if (!string.IsNullOrEmpty(roles))
            {
                foreach (var role in roles.Split('|', StringSplitOptions.RemoveEmptyEntries))
                {
                    if (!string.IsNullOrWhiteSpace(role))
                    {
                        JobContactsData.Add(new JobContactRow { Role = role.Trim() });
                    }
                }
            }

            // Load assigned contacts
            var dt = db.SqlExec(
                @"SELECT j.Role AS JobRole, c.*
                  FROM jobContacts j
                  JOIN contacts c ON j.contactid=c.contactid
                  WHERE j.divisionid=@DivisionID AND j.job=@Job",
                new { SessionState.DivisionID, Job = mJob });

            foreach (DataRow row in dt.Rows)
            {
                var jobRole = row["JobRole"]?.ToString() ?? "";
                var existing = JobContactsData.FirstOrDefault(r => r.Role == jobRole);
                if (existing == null)
                {
                    existing = new JobContactRow { Role = jobRole };
                    JobContactsData.Add(existing);
                }
                existing.ContactID = row["ContactID"]?.ToString() ?? "";
                existing.Company = row["CompanyName"]?.ToString() ?? "";
                existing.Name = row["FirstName"]?.ToString() ?? "";
                existing.Phone = row["WorkPhone"]?.ToString() ?? "";
                existing.Cell = row["CellPhone"]?.ToString() ?? "";
                existing.Fax = row["Fax"]?.ToString() ?? "";
                existing.Email = row["Email"]?.ToString() ?? "";
                existing.SendVia = row["CommModeID"]?.ToString() ?? "";
                existing.SmsAddress = row["SmsAddress"]?.ToString() ?? "";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadJobContacts error");

        }
    }

    // ── Load POs ─────────────────────────────────────────────────────────
    private async Task LoadPOs()
    {
        POsData = new();
        if (string.IsNullOrEmpty(mJob) || mJob == "\x01") return;
        try
        {
            var dt = db.SqlExec(
                @"SELECT p.PONumber, p.PODate, p.POIndex, p.description,
                         p.Vendor, v.vendor_name,
                         SUM(d.pretax) Pretax, SUM(d.jctax + d.njctax) Tax,
                         p.status, p.approvedby, p.approveddate,
                         p.postingbatch, p.cancelled, p.cancelledBy, p.cancelleddate, p.cancelledNotes,
                         c.postingbatch CancelPostingBatch
                  FROM pomaster p
                  LEFT OUTER JOIN tblvendors v ON p.vendor=v.vendor_id AND v.DivisionID=p.DivisionID
                  LEFT OUTER JOIN poitems d ON p.ponumber=d.ponumber AND p.DivisionID=d.DivisionID
                  LEFT OUTER JOIN pochangeorders c ON p.ponumber=c.ponumber AND p.DivisionID=d.DivisionID
                  WHERE p.DivisionID=@DivisionID AND p.job=@Job
                  GROUP BY p.PODate, p.PONumber, p.POIndex, p.description, p.Vendor, v.vendor_name, p.postingbatch,
                           p.cancelled, p.cancelledBy, c.postingbatch, p.cancelleddate, p.cancellednotes,
                           p.status, p.approvedby, p.approveddate
                  ORDER BY p.ponumber",
                new { SessionState.DivisionID, Job = mJob });

            foreach (DataRow row in dt.Rows)
            {
                var pretax = SafeDecimal(row["Pretax"]);
                var tax = SafeDecimal(row["Tax"]);
                var cancelled = row["Cancelled"]?.ToString() == "True";
                var status = row["status"]?.ToString() ?? "";

                var approval = "";
                if (cancelled)
                    approval = "Cancelled";
                else if (status == "Pending")
                    approval = "Approval Required";
                else
                    approval = $"{row["approvedby"]}: {(row["approveddate"] != DBNull.Value ? Convert.ToDateTime(row["approveddate"]).ToString("MMM d, yyyy") : "")}";

                POsData.Add(new PORow
                {
                    PODate = row["PODate"] != DBNull.Value ? Convert.ToDateTime(row["PODate"]).ToString("d") : "",
                    PONumber = row["PONumber"]?.ToString() ?? "",
                    POIndex = row["POIndex"]?.ToString() ?? "",
                    Description = row["description"]?.ToString() ?? "",
                    Vendor = row["Vendor"]?.ToString() ?? "",
                    VendorName = row["vendor_name"]?.ToString() ?? "",
                    Pretax = pretax,
                    Tax = tax,
                    Total = pretax + tax,
                    Approval = approval,
                    PostingBatch = row["postingbatch"]?.ToString() ?? "",
                    CancelledBy = row["cancelledBy"]?.ToString() ?? "",
                    CancelledDate = row["cancelleddate"] != DBNull.Value ? Convert.ToDateTime(row["cancelleddate"]).ToString("d") : "",
                    CancelledNotes = row["cancelledNotes"]?.ToString() ?? "",
                    Status = status,
                    IsCancelled = cancelled
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadPOs error");

        }
    }

    // ── Save Data ────────────────────────────────────────────────────────
    private async Task<bool> SaveData(bool prompt)
    {
        if (!mDirty) return true;

        if (prompt)
        {
            var result = await Dialogs.ConfirmAsync(
                "Job Setup has changed.\n\nDo you want to save these changes?");
            if (!result) return true;
        }

        if (string.IsNullOrWhiteSpace(txtJob))
        {
            Notifications.Info("A job number is required.");
            return false;
        }

        IsLoading = true;
        StateHasChanged();

        try
        {
            var community = cboCommunity;
            var communityPhase = cboPhase;
            var glPrefix = ShowGLPrefixCombo ? cboGLPrefix : txtGLPrefix;
            var model = cboModel.Contains(" - ") ? cboModel.Split(" - ")[0] : cboModel;
            var isNewJob = mJob == "\x01";

            // Gather property values for the UPDATE
            string GetPropVal(int index)
            {
                if (index >= 0 && index < PropertiesData.Count)
                    return PropertiesData[index].Value ?? "";
                return "";
            }

            if (isNewJob)
            {
                // Validate job number does not already exist
                var existsCheck = await db.ExecuteScalarAsync<int>(
                    "SELECT COUNT(*) FROM tblJobs WHERE DivisionID =@DivisionID AND Job_No=@Job",
                    new { SessionState.DivisionID, Job = txtJob.Trim() });
                if (existsCheck > 0)
                {
                    Notifications.Info($"Unable to save this job. \"{txtJob.Trim()}\" has already been used.\n\nPlease enter a different job number.");

                    return false;
                }

                // Insert into tblcustomers (trigger creates tbljobs)
                await db.ExecuteAsync(
                    @"INSERT INTO tblcustomers (home_selection, presale_selection, DivisionID, Customer_No, Job_no,
                        ar_customer_deposit, Description, bal_sheet_Prefix, community, phase,
                        address1, city, province, zip, phone, fax, purchased, approved, contract_assigned,
                        cancelled, inactive, lot, block, lotplan, model, sale_posted)
                      VALUES('Spec Home','Spec Home', @DivisionID, @Job, @Job, @ARCustomer, @Description,
                        @GLPrefix, @Community, @Phase, @Address, @City, @Province, @Postal, @Phone, @Fax,
                        1, 1, 1, 0, 0, @Lot, @Block, @LotPlan, @Model, 1)",
                    new
                    {
                        SessionState.DivisionID, Job = txtJob.Trim(), ARCustomer = txtARCustomer,
                        Description = txtDescription, GLPrefix = glPrefix, Community = community,
                        Phase = communityPhase, Address = txtAddress, City = txtCity,
                        Province = cboProvince, Postal = txtPostal, Phone = txtPhone, Fax = txtFax,
                        Lot = txtLot, Block = txtBlock, LotPlan = txtLotPlan, Model = model
                    });

                // Update tbljobs with additional fields including properties
                await db.ExecuteAsync(
                    @"UPDATE tblJobs SET isquote=0, ExternalJobID=@ExternalID, Description=@Description,
                        Notes=@Notes, GL_Prefix=@GLPrefix, Community=@Community, CommunityPhase=@Phase,
                        municipal_address=@Address, city=@City, province=@Province, zip=@Postal,
                        sitephone=@Phone, sitefax=@Fax, Inactive=@Inactive, arcustomer=@ARCustomer,
                        Lot=@Lot, Block=@Block, LotPlan=@LotPlan, Model=@Model,
                        PermitNumber=@PermitNumber, PermitReceivedDate=@PermitDate,
                        ScheduleTemplate=@ScheduleTemplate, Start_Date=@StartDate,
                        LabourTaxGroup=@LabTax, MaterialTaxGroup=@MatTax, SubContractTaxGroup=@SubTax,
                        EquipmentTaxGroup=@EquTax, OverheadTaxGroup=@OvrTax, OtherTaxGroup=@OthTax,
                        ARTaxGroup=@ARTax
                      WHERE DivisionID =@DivisionID AND job_no=@Job",
                    new
                    {
                        SessionState.DivisionID, Job = txtJob.Trim(), ExternalID = txtExternalID,
                        Description = txtDescription, Notes = txtNotes, GLPrefix = glPrefix,
                        Community = community, Phase = communityPhase, Address = txtAddress,
                        City = txtCity, Province = cboProvince, Postal = txtPostal,
                        Phone = txtPhone, Fax = txtFax, Inactive = cboStatus == "1",
                        ARCustomer = txtARCustomer, Lot = txtLot, Block = txtBlock,
                        LotPlan = txtLotPlan, Model = model,
                        PermitNumber = GetPropVal(mprop_PermitNumber),
                        PermitDate = string.IsNullOrEmpty(GetPropVal(mprop_PermitDate)) ? (DateTime?)null
                            : DateTime.TryParse(GetPropVal(mprop_PermitDate), out var pd) ? pd : (DateTime?)null,
                        ScheduleTemplate = GetPropVal(mprop_UnitTemplate),
                        StartDate = string.IsNullOrEmpty(GetPropVal(mprop_ConstStart)) ? (DateTime?)null
                            : DateTime.TryParse(GetPropVal(mprop_ConstStart), out var sd) ? sd : (DateTime?)null,
                        LabTax = GetPropVal(mprop_LabTax), MatTax = GetPropVal(mprop_MatTax),
                        SubTax = GetPropVal(mprop_SubTax), EquTax = GetPropVal(mprop_EquTax),
                        OvrTax = GetPropVal(mprop_OvrTax), OthTax = GetPropVal(mprop_OthTax),
                        ARTax = GetPropVal(mprop_ARTax)
                    });

                // Save ShellScheduleTemplate for multifamily
                if (mIsMultifamily)
                {
                    await db.ExecuteAsync(
                        "UPDATE tblJobs SET ShellScheduleTemplate=@Val WHERE DivisionID =@DivisionID AND job_no=@Job",
                        new { Val = GetPropVal(mprop_ShellTemplate), SessionState.DivisionID, Job = txtJob.Trim() });
                }

                // Save Tarion fields when EnableTarionFields (VB6: TarionEnrollmentNumber / TarionBuilderNumber)
                if (mEnableTarion)
                {
                    await db.ExecuteAsync(
                        "UPDATE tblJobs SET TarionEnrollmentNumber=@Enroll, TarionBuilderNumber=@Builder WHERE DivisionID =@DivisionID AND job_no=@Job",
                        new
                        {
                            Enroll = GetPropVal(mprop_TarionEnrollmentNumber),
                            Builder = GetPropVal(mprop_TarionBuilderNumber),
                            SessionState.DivisionID, Job = txtJob.Trim()
                        });
                }

                // Save Precon fields when EnablePreconJobs (VB6: preconScheduleTemplate / PreconStartDate)
                if (mEnablePreconJobs)
                {
                    await db.ExecuteAsync(
                        "UPDATE tblJobs SET preconScheduleTemplate=@PreconTemplate, PreconStartDate=@PreconStart WHERE DivisionID =@DivisionID AND job_no=@Job",
                        new
                        {
                            PreconTemplate = GetPropVal(mprop_PreconTemplate),
                            PreconStart = string.IsNullOrEmpty(GetPropVal(mprop_PreconStart)) ? (object?)DBNull.Value
                                : DateTime.TryParse(GetPropVal(mprop_PreconStart), out var pcd) ? pcd : (object?)DBNull.Value,
                            SessionState.DivisionID, Job = txtJob.Trim()
                        });
                }

                // Save IntacctDepartment if Intacct
                if (AccountingSystem == "Intacct")
                {
                    await db.ExecuteAsync(
                        "UPDATE tblJobs SET IntacctDepartment=@Val WHERE DivisionID =@DivisionID AND job_no=@Job",
                        new { Val = GetPropVal(mprop_IntacctDepartment), SessionState.DivisionID, Job = txtJob.Trim() });
                }

                mJob = txtJob.Trim();
                JobEditable = false;
                ShowJobBrowse = false;

                // Read back ExternalJobID (may have been set by WriteJobToAccounting trigger)
                try
                {
                    var extDt = db.SqlExec(
                        "SELECT ExternalJobID FROM tblJobs WHERE job_no=@Job AND DivisionID =@DivisionID",
                        new { Job = mJob, SessionState.DivisionID });
                    if (extDt.Rows.Count > 0)
                        txtExternalID = extDt.Rows[0][0]?.ToString() ?? "";
                }
                catch { /* non-critical */ }

                // Insert manual estimates assembly
                try
                {
                    await db.ExecuteAsync(
                        @"INSERT INTO EstimateAssemblies(job, Customer_no, EstimateIndex, HFDescription, AssemblyType, OptionType, DivisionID, salesqty)
                          VALUES(@Job, @Job, 0, 'Manual Estimates', -1, -1, @DivisionID, 1)",
                        new { Job = mJob, SessionState.DivisionID });
                }
                catch { /* non-critical */ }
            }
            else
            {
                // Build dynamic SET clauses for properties and optional fields
                var extraSets = new StringBuilder();
                var extraParams = new Dictionary<string, object?>();

                // Properties
                extraParams["PermitNumber"] = GetPropVal(mprop_PermitNumber);
                extraSets.Append(", PermitNumber=@PermitNumber");

                extraParams["PermitDate"] = string.IsNullOrEmpty(GetPropVal(mprop_PermitDate)) ? (object?)DBNull.Value
                    : DateTime.TryParse(GetPropVal(mprop_PermitDate), out var pdt) ? pdt : (object?)DBNull.Value;
                extraSets.Append(", PermitReceivedDate=@PermitDate");

                extraParams["ScheduleTemplate"] = GetPropVal(mprop_UnitTemplate);
                extraSets.Append(", ScheduleTemplate=@ScheduleTemplate");

                extraParams["StartDate"] = string.IsNullOrEmpty(GetPropVal(mprop_ConstStart)) ? (object?)DBNull.Value
                    : DateTime.TryParse(GetPropVal(mprop_ConstStart), out var sdt) ? sdt : (object?)DBNull.Value;
                extraSets.Append(", Start_Date=@StartDate");

                if (mIsMultifamily)
                {
                    extraParams["ShellTemplate"] = GetPropVal(mprop_ShellTemplate);
                    extraSets.Append(", ShellScheduleTemplate=@ShellTemplate");
                }

                if (AccountingSystem == "Intacct")
                {
                    extraParams["IntacctDept"] = GetPropVal(mprop_IntacctDepartment);
                    extraSets.Append(", IntacctDepartment=@IntacctDept");
                }

                // Tarion fields when EnableTarionFields (VB6: TarionEnrollmentNumber / TarionBuilderNumber)
                if (mEnableTarion)
                {
                    extraParams["TarionEnroll"] = GetPropVal(mprop_TarionEnrollmentNumber);
                    extraSets.Append(", TarionEnrollmentNumber=@TarionEnroll");
                    extraParams["TarionBuilder"] = GetPropVal(mprop_TarionBuilderNumber);
                    extraSets.Append(", TarionBuilderNumber=@TarionBuilder");
                }

                // Precon fields when EnablePreconJobs (VB6: preconScheduleTemplate / PreconStartDate)
                if (mEnablePreconJobs)
                {
                    extraParams["PreconTemplate"] = GetPropVal(mprop_PreconTemplate);
                    extraSets.Append(", preconScheduleTemplate=@PreconTemplate");
                    extraParams["PreconStart"] = string.IsNullOrEmpty(GetPropVal(mprop_PreconStart)) ? (object?)DBNull.Value
                        : DateTime.TryParse(GetPropVal(mprop_PreconStart), out var pcd) ? pcd : (object?)DBNull.Value;
                    extraSets.Append(", PreconStartDate=@PreconStart");
                }

                // Tax groups
                extraParams["LabTax"] = GetPropVal(mprop_LabTax);
                extraParams["MatTax"] = GetPropVal(mprop_MatTax);
                extraParams["SubTax"] = GetPropVal(mprop_SubTax);
                extraParams["EquTax"] = GetPropVal(mprop_EquTax);
                extraParams["OvrTax"] = GetPropVal(mprop_OvrTax);
                extraParams["OthTax"] = GetPropVal(mprop_OthTax);
                extraParams["ARTax"] = GetPropVal(mprop_ARTax);
                extraSets.Append(", LabourTaxGroup=@LabTax, MaterialTaxGroup=@MatTax, SubContractTaxGroup=@SubTax");
                extraSets.Append(", EquipmentTaxGroup=@EquTax, OverheadTaxGroup=@OvrTax, OtherTaxGroup=@OthTax, ARTaxGroup=@ARTax");

                // ExternalJobID for QuickBooks / Simply / MYOB
                if (!string.IsNullOrEmpty(txtExternalID) &&
                    (AccountingSystem == "Simply" || AccountingSystem == "MYOB"))
                {
                    extraParams["ExtJobID"] = txtExternalID;
                    extraSets.Append(", ExternalJobID=@ExtJobID");
                }
                else if ((!string.IsNullOrEmpty(txtARCustomer) || !string.IsNullOrEmpty(txtExternalID)) &&
                         (AccountingSystem == "QuickBooks" || AccountingSystem == "QuickbooksOnline"))
                {
                    extraParams["ExtJobID"] = !string.IsNullOrEmpty(txtExternalID) ? txtExternalID : txtARCustomer;
                    extraSets.Append(", ExternalJobID=@ExtJobID");
                }

                // AR Customer for non-multifamily
                if (!mIsMultifamily)
                {
                    extraSets.Append(", arcustomer=@ARCustomer2");
                    extraParams["ARCustomer2"] = txtARCustomer;
                }

                // Static columns. Add them to extraParams so ONE bag carries both these and the dynamic
                // SET clauses appended to extraSets above. (VB6 FJob.frm: the existing-job UPDATE sets
                // arcustomer ONLY for non-multifamily — handled by the @ARCustomer2 clause above — so it
                // must NOT also appear unconditionally here; that produced a duplicate SET column.)
                extraParams["DivisionID"] = SessionState.DivisionID;
                extraParams["Job"] = mJob;
                extraParams["Description"] = txtDescription;
                extraParams["Notes"] = txtNotes;
                extraParams["GLPrefix"] = glPrefix;
                extraParams["Community"] = community;
                extraParams["Phase"] = communityPhase;
                extraParams["Address"] = txtAddress;
                extraParams["City"] = txtCity;
                extraParams["Province"] = cboProvince;
                extraParams["Postal"] = txtPostal;
                extraParams["Phone"] = txtPhone;
                extraParams["Fax"] = txtFax;
                extraParams["Inactive"] = cboStatus == "1";
                extraParams["Lot"] = txtLot;
                extraParams["Block"] = txtBlock;
                extraParams["LotPlan"] = txtLotPlan;
                extraParams["Model"] = model;

                // Update existing job. Pass extraParams (NOT an anonymous object) — it carries every
                // @placeholder used by the SQL incl. those from extraSets (PermitNumber, tax groups, …);
                // the old anonymous object dropped them → "Must declare the scalar variable @PermitNumber".
                await db.ExecuteAsync(
                    $@"UPDATE tblJobs SET Description=@Description, Notes=@Notes, GL_Prefix=@GLPrefix,
                        Community=@Community, CommunityPhase=@Phase, Municipal_Address=@Address,
                        City=@City, Province=@Province, Zip=@Postal, SitePhone=@Phone, SiteFax=@Fax,
                        Inactive=@Inactive, Lot=@Lot, Block=@Block, LotPlan=@LotPlan, Model=@Model
                        {extraSets}
                      WHERE Job_No=@Job AND DivisionID =@DivisionID",
                    extraParams);

                // Update tblcustomers ar_customer_deposit for non-multifamily
                if (!mIsMultifamily)
                {
                    await db.ExecuteAsync(
                        "UPDATE tblcustomers SET ar_customer_deposit=@ARCustomer WHERE Job_No=@Job AND DivisionID =@DivisionID",
                        new { ARCustomer = txtARCustomer, Job = mJob, SessionState.DivisionID });
                }

                // Update tblcustomers if no sales system
                if (SalesSystem == "None" || SalesSystem == "")
                {
                    await db.ExecuteAsync(
                        @"UPDATE tblcustomers SET ar_customer_deposit=@ARCustomer, Description=@Description,
                            bal_sheet_Prefix=@GLPrefix, Community=@Community, Phase=@Phase,
                            Address1=@Address, City=@City, Province=@Province, Zip=@Postal,
                            Phone=@Phone, Fax=@Fax, Lot=@Lot, Block=@Block, LotPlan=@LotPlan, Model=@Model
                          WHERE Customer_No=@Job AND DivisionID =@DivisionID",
                        new
                        {
                            SessionState.DivisionID, Job = mJob, ARCustomer = txtARCustomer,
                            Description = txtDescription, GLPrefix = glPrefix,
                            Community = community, Phase = communityPhase,
                            Address = txtAddress, City = txtCity, Province = cboProvince,
                            Postal = txtPostal, Phone = txtPhone, Fax = txtFax,
                            Lot = txtLot, Block = txtBlock, LotPlan = txtLotPlan, Model = model
                        });
                }
            }

            // Save user-defined custom fields from properties grid
            await SaveCustomFieldsAsync();

            // Save contacts
            foreach (var contact in ContactsData.Where(c => c.RowState == "DIRTY"))
            {
                await db.ExecuteAsync(
                    $"UPDATE tblJobs SET {contact.ContactType}=@PM WHERE divisionid=@DivisionID AND Job_No=@Job",
                    new { contact.PM, SessionState.DivisionID, Job = mJob });
                contact.RowState = "CLEAN";
            }

            // Save job contacts
            await SaveJobContactsAsync();

            mDirty = false;
            return true;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
            {
                Notifications.Error($"Unable to save this job. \"{txtJob.Trim()}\" has already been used.\n\nPlease enter a different job number.");

            }
            else
            {
                Logger.LogError(ex, "SaveData error");

            }
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveCustomFieldsAsync()
    {
        try
        {
            // Collect user-defined fields (everything from mprop_UserFlds onward)
            var setClauses = new List<string>();
            var setParams = new Dictionary<string, object?>();
            int paramIdx = 0;

            for (int i = mprop_UserFlds; i < PropertiesData.Count; i++)
            {
                var prop = PropertiesData[i];
                if (prop.IsCategory || string.IsNullOrEmpty(prop.DataType)) continue;

                var pName = $"@cf{paramIdx}";
                setClauses.Add($"[{prop.Name}]={pName}");
                setParams[pName.TrimStart('@')] = prop.Value ?? "";
                paramIdx++;
            }

            if (setClauses.Count == 0) return;

            // Ensure the row exists
            try
            {
                await db.ExecuteAsync(
                    "INSERT INTO JobCustomFields(Job_No, divisionid) VALUES(@Job, @DivisionID)",
                    new { Job = mJob, SessionState.DivisionID });
            }
            catch { /* non-critical */ }

            var updateSql = $"UPDATE JobCustomFields SET {string.Join(",", setClauses)} WHERE divisionid=@DivisionID AND Job_No=@Job";
            await db.ExecuteAsync(updateSql, new { SessionState.DivisionID, Job = mJob });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SaveCustomFieldsAsync error");

        }
    }

    private async Task SaveJobContactsAsync()
    {
        try
        {
            foreach (var jc in JobContactsData.Where(c => c.RowState == "DIRTY"))
            {
                if (string.IsNullOrEmpty(jc.ContactID))
                {
                    // Remove existing assignment for this role
                    await db.ExecuteAsync(
                        "DELETE FROM jobContacts WHERE divisionid=@DivisionID AND job=@Job AND Role=@Role",
                        new { SessionState.DivisionID, Job = mJob, jc.Role });
                }
                else
                {
                    // Upsert: delete then insert
                    await db.ExecuteAsync(
                        "DELETE FROM jobContacts WHERE divisionid=@DivisionID AND job=@Job AND Role=@Role",
                        new { SessionState.DivisionID, Job = mJob, jc.Role });
                    await db.ExecuteAsync(
                        "INSERT INTO jobContacts(divisionid, job, Role, ContactID) VALUES(@DivisionID, @Job, @Role, @ContactID)",
                        new { SessionState.DivisionID, Job = mJob, jc.Role, jc.ContactID });
                }
                jc.RowState = "CLEAN";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SaveJobContactsAsync error");

        }
    }

