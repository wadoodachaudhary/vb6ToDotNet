    // ── Load Data ────────────────────────────────────────────────────────
    private async Task LoadData()
    {
        if (string.IsNullOrEmpty(mJob)) return;
        IsLoading = true;
        StateHasChanged();
        try
        {
            var isNewJob = mJob == "\x01";

            if (isNewJob)
            {
                JobEditable = true;
                FieldsEnabled = true;
                StatusEnabled = true;
                FormCaption = "Job Setup";
                ClearFields();
            }
            else
            {
                JobEditable = false;
                var dt = db.SqlExec(
                    @"SELECT j.*, c.ar_customer_deposit
                      FROM tbljobs j
                      LEFT OUTER JOIN tblcustomers c ON j.job_no=c.job_no
                      WHERE j.DivisionID=@DivisionID AND j.job_no=@Job",
                    new { DivisionID, Job = mJob });

                if (dt.Rows.Count == 0)
                {
                    FieldsEnabled = false;
                    ClearFields();
                }
                else
                {
                    FieldsEnabled = true;
                    StatusEnabled = true;
                    var row = dt.Rows[0];

                    txtJob = row["Job_No"]?.ToString() ?? "";
                    txtExternalID = row["ExternalJobID"]?.ToString() ?? "";
                    FormCaption = $"Job Setup - {txtJob}";
                    txtDescription = row["Description"]?.ToString() ?? "";
                    txtNotes = row["Notes"]?.ToString() ?? "";

                    if (!mIsMultifamily)
                        txtARCustomer = row["ar_customer_deposit"]?.ToString() ?? "";
                    else
                        txtARCustomer = row["ARCustomer"]?.ToString() ?? "";

                    cboGLPrefix = row["gl_prefix"]?.ToString() ?? "";
                    txtGLPrefix = row["gl_prefix"]?.ToString() ?? "";
                    txtAddress = row["municipal_address"]?.ToString() ?? "";
                    txtCity = row["city"]?.ToString() ?? "";
                    cboProvince = row["province"]?.ToString() ?? "";
                    txtPostal = row["zip"]?.ToString() ?? "";
                    txtPhone = row["sitephone"]?.ToString() ?? "";
                    txtFax = row["sitefax"]?.ToString() ?? "";
                    txtLot = row["Lot"]?.ToString() ?? "";
                    txtBlock = row["Block"]?.ToString() ?? "";
                    txtLotPlan = row["LotPlan"]?.ToString() ?? "";
                    txtHoldback = row["HoldbackRate"]?.ToString() ?? "";
                    if (decimal.TryParse(txtHoldback, out var hb) && hb == 0) txtHoldback = "";

                    cboStatus = (row["inactive"]?.ToString() ?? "") == "True" ? "1" : "0";
                    cboCommunity = row["Community"]?.ToString() ?? "";
                    cboPhase = row["CommunityPhase"]?.ToString() ?? "";

                    // Load model display
                    var modelCode = row["model"]?.ToString() ?? "";
                    if (!string.IsNullOrEmpty(modelCode))
                    {
                        var mdt = db.SqlExec(
                            @"SELECT ISNULL(model,'') + ISNULL(' - ' + description,'') AS Display
                              FROM tblDBAssemblyMaster WHERE assemblytype=0 AND divisionid=@DivisionID AND model=@Model",
                            new { DivisionID, Model = modelCode });
                        cboModel = mdt.Rows.Count > 0 ? mdt.Rows[0][0]?.ToString() ?? "" : "";
                    }

                    await LoadPhases(cboCommunity);

                    // Determine job browse visibility
                    ShowJobBrowse = AccountingSystem switch
                    {
                        "QuickBooks" or "Simply" or "MYOB" or "Spectrum" or "Intacct" or "QuickbooksOnline" => true,
                        "Timberline" or "MasterBuilder" => JobEditable,
                        _ => false
                    };
                }
            }

            await LoadProperties();
            await LoadContacts();
            await LoadJobContacts();
            await LoadPOs();

            mDirty = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadData error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading job: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

