    private async Task OnARCustomerPicked(List<IDictionary<string, object>> rows)
    {
        if (rows == null || rows.Count == 0) return;
        var arCustomer = PickVal(rows[0], "ARCustomer");

        // VB6: single-family + a blank ARCustomer key = the "new customer" sentinel → create the
        // AR customer from this job's tblcustomers row, then read its customer_no back in.
        if (!mIsMultifamily && string.IsNullOrEmpty(arCustomer))
        {
            if (string.IsNullOrEmpty(mJob) || mJob == "\x01") return;
            try
            {
                await db.ExecuteAsync(
                    @"INSERT INTO arcustomers(ARCustomer, Description, Inactive, Contact1, Phone1, Fax1, Email1,
                        Contact2, Phone2, Fax2, Email2, BillAddr1, BillAddr2, BillCity, BillProvince, BillPostalCode,
                        Comments, ExternalID, DivisionID)
                      SELECT c.Customer_No, c.Description, 0,
                        c.customer_lname + ', ' + c.customer_name, c.phone, c.fax, c.email,
                        c.cobuyer_lname + ', ' + c.cobuyer_name, c.c_phone, c.c_fax, c.c_email,
                        c.address1, c.address2, c.city, c.province, c.zip,
                        c.comments, c.customer_no, c.divisionid
                      FROM tblCustomers c
                      LEFT JOIN arcustomers a ON c.customer_no=a.arcustomer AND c.divisionid=a.divisionid
                      WHERE a.arcustomer IS NULL AND c.divisionid=@DivisionID AND c.job_no=@Job;
                      UPDATE tblcustomers SET ar_customer_deposit=customer_no
                      WHERE divisionid=@DivisionID AND job_no=@Job;",
                    new { SessionState.DivisionID, Job = mJob });

                var custNo = await db.ExecuteScalarAsync<string>(
                    "SELECT customer_no FROM tblcustomers WHERE divisionid=@DivisionID AND job_no=@Job",
                    new { SessionState.DivisionID, Job = mJob });
                txtARCustomer = custNo ?? "";
                mDirty = true;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "OnARCustomerPicked create-customer");
                Notifications.Error($"Error creating customer: {ex.Message}");
            }
        }
        else
        {
            // VB6: txtARCustomer = the selected ExternalID
            txtARCustomer = PickVal(rows[0], "ExternalID");
            mDirty = true;
        }
        await InvokeAsync(StateHasChanged);
    }

