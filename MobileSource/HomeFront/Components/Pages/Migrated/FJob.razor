    // VB6 cmdJob_Click (FJob.frm:1654): browse the EXTERNAL accounting system for a job number.
    // Every branch needs a live external integration HomeFront does not ship:
    //   Simply (1687) / Spectrum (1698) → dbAccounting ODBC; Timberline (1709) / MasterBuilder (1717)
    //   → dbAccountingDictionary; QuickBooks (1745) / QBO (1668) / Intacct (1726) → QB / QBO / Intacct
    //   COM wrappers + XML round-trips feeding the QB_Jobs / QBO_Jobs / Intacct_Jobs procs.
    // This is the ONE permitted "blocked" feature — a KNOWN GAP, surfaced clearly to the user via an
    // explanatory modal (and the inline [BLOCKED] note next to the button), never silently swallowed.
    private async Task OnJobBrowseClick()
    {
        // Which external source VB6 would have reached, for an accurate explanation.
        var source = AccountingSystem switch
        {
            "Simply" => "the Simply Accounting ODBC data source",
            "Spectrum" => "the Spectrum (Dexter + Chaney) accounting database",
            "Timberline" => "the Sage Timberline accounting dictionary",
            "MasterBuilder" => "the Sage 100 / Master Builder accounting database",
            "QuickBooks" => "the QuickBooks Desktop company file (via the QB XML connector)",
            "QuickbooksOnline" => "QuickBooks Online (via the QBO web connector)",
            "Intacct" => "Sage Intacct (via the Intacct web-services wrapper)",
            "MYOB" => "the MYOB accounting data source",
            _ => $"the {AccountingSystem} accounting system"
        };

        var message =
            $"This division is configured for the {AccountingSystem} accounting system, so Job Setup " +
            $"would normally let you pick a job directly from {source}.\n\n" +
            "That external accounting integration is not available in this build of HomeFront — it is a " +
            "known gap, not an error. You can still enter the job number manually and save the job here.";

        if (_accountingBlockedBox != null)
        {
            await _accountingBlockedBox.ShowAsync(
                message,
                title: $"{AccountingSystem} integration not available",
                buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.Ok);
        }
        else
        {
            // Fallback so the gap is still surfaced if the modal ref isn't ready.
            Notifications.Warning(
                $"Browsing jobs from {AccountingSystem} is not available in this build (known gap).");
        }
    }

