@page "/job-setup"
@page "/job-setup/{JobNumber}"
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data
@using HomeFront.Models
@using System.Data
@using System.Reflection
@using System.Text

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject ILogger<FJob> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db

<PageTitle>@FormCaption - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Job...</div>
    </div>
}

<div class="job-page">
@* HHM-418: VB6 window control-box — the icon next to the title opens the system
   menu (Restore/Move/Size/Minimize/Maximize/Close). In the docked web MDI only
   Close is actionable; the sizing items are shown disabled for parity, exactly
   as the greyed entries look in the legacy window. *@
<div class="job-titlebar">
    <img class="job-titlebar-icon" src="images/16/Job.ico" alt="" title="System menu"
         onerror="this.style.display='none'"
         @onclick="OpenSysMenu" @oncontextmenu:preventDefault @oncontextmenu="OpenSysMenu" />
    <span class="job-titlebar-text">@FormCaption</span>
</div>
@* ── TOOLBAR ─────────────────────────────────────────── *@
<div class="toolbar-cntr">
    <button class="tbar-btn" @onclick="OnOpenClick">
        <img src="images/32/open.ico" alt="Open" onerror="this.style.display='none'" />
        <span class="tool-label">Open</span>
    </button>
    <button class="tbar-btn" disabled="@(!mDirty)" @onclick="OnSaveClick">
        <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
        <span class="tool-label">Save</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" disabled>
        <img src="images/32/Add.ico" alt="Attachments" onerror="this.style.display='none'" />
        <span class="tool-label">Attachments (Descoped)</span>
    </button>
    <button class="tbar-btn" @onclick="OnCorrespondenceClick">
        <img src="images/32/PricebookSearch.ico" alt="Correspondence" onerror="this.style.display='none'" />
        <span class="tool-label">Correspondence</span>
    </button>
</div>

<div class="job-layout">
    @* ── LEFT PANEL ─────────────────────────────────────── *@
    <div class="job-left">
        <div class="job-fields-area">
            <div class="job-form-section">
                @* Job Number *@
                <div class="form-field">
                    <label class="bold">Job Number</label>
                    <TextBoxControl Value="@txtJob" ValueChanged="@OnJobInput" Enabled="@JobEditable" MaxLength="@JobMaxLength" CssClass="job-field" />
                    @* VB6 cmdJob (FJob.frm:1265, cmdJob_Click:1654): browse a job from the EXTERNAL accounting
                       package. Every branch needs a live integration HomeFront doesn't ship, so it's BLOCKED —
                       but VISIBLY so (disabled look + inline note + explanatory modal on click), gated on the
                       AccountingSystem AppOption exactly like VB6 (asNone → button never shows). *@
                    @if (ShowJobBrowse)
                    {
                        <button class="browse-btn browse-btn-blocked" @onclick="OnJobBrowseClick"
                                title="@($"Browsing jobs from {AccountingSystem} is not available in this build")">...</button>
                        <span class="accounting-blocked-note">[BLOCKED: requires @AccountingSystem integration]</span>
                    }
                </div>

                @* Description *@
                <div class="form-field">
                    <label>Description</label>
                    <TextBoxControl Value="@txtDescription" ValueChanged="@OnDescriptionInput" Enabled="@FieldsEnabled" MaxLength="50" CssClass="job-field" />
                </div>

                @* External ID *@
                @if (ShowExternalID)
                {
                    <div class="form-field">
                        <label>@ExternalIDLabel</label>
                        <TextBoxControl Value="@txtExternalID" Enabled="false" MaxLength="50" CssClass="job-field" />
                    </div>
                }

                @* GL Prefix *@
                @if (ShowGLPrefixCombo)
                {
                    <div class="form-field">
                        <label>@GLPrefixLabel</label>
                        <DropDownListControl TValue="string" TItem="ComboItem"
                                             DataSource="@GLPrefixItems" TextFieldName="Text" ValueFieldName="Value"
                                             Value="@cboGLPrefix" ValueChanged="@OnGLPrefixSelected"
                                             Placeholder="-- Select --" Enabled="@FieldsEnabled" Width="100%" />
                    </div>
                }
                else if (ShowGLPrefixText)
                {
                    <div class="form-field">
                        <label>@GLPrefixLabel</label>
                        <TextBoxControl Value="@txtGLPrefix" ValueChanged="@OnGLPrefixTextInput" Enabled="@FieldsEnabled" MaxLength="10" CssClass="job-field" />
                    </div>
                }
            </div>

            <div class="job-form-section-spacer"></div>

            <div class="job-form-section">
                @* AR Customer *@
                @if (ShowARCustomer)
                {
                    <div class="form-field">
                        <label class="link" @onclick="OnARCustomerLinkClick">AR Customer</label>
                        @* HHM-391: VB6 txtARCustomer is Locked=True but Enabled (FJob.frm:621-630) — readonly,
                           normal colors, focus/copy allowed; not the greyed disabled state. *@
                        <TextBoxControl Value="@txtARCustomer" MaxLength="50" CssClass="job-field" HtmlAttributes="@ReadOnlyAttrs" />
                        <button class="browse-btn" @onclick="OnARCustomerBrowseClick" title="Browse Customers">...</button>
                    </div>
                }

                @* Community *@
                <div class="form-field">
                    <label>@CommunityLabel</label>
                    @* HHM-392: VB6 never disables cboCommunity (absent from FJob.frm LoadData
                       disable block) — always enabled so the list is usable without a job loaded. *@
                    <DropDownListControl TValue="string" TItem="ComboItem"
                                         DataSource="@CommunityItems" TextFieldName="Text" ValueFieldName="Value"
                                         Value="@cboCommunity" ValueChanged="@OnCommunitySelected"
                                         Placeholder="-- Select --" Width="100%" />
                </div>

                @* Phase *@
                <div class="form-field">
                    <label>Phase</label>
                    @* HHM-392: VB6 cboPhase is reloaded regardless of job state, never disabled. *@
                    <DropDownListControl TValue="string" TItem="ComboItem"
                                         DataSource="@PhaseItems" TextFieldName="Text" ValueFieldName="Value"
                                         Value="@cboPhase" ValueChanged="@OnPhaseSelected"
                                         Placeholder="-- Select --" Width="120px" />
                </div>

                @* Model *@
                <div class="form-field">
                    <label>Model</label>
                    <DropDownListControl TValue="string" TItem="ComboItem"
                                         DataSource="@ModelItems" TextFieldName="Text" ValueFieldName="Text"
                                         Value="@cboModel" ValueChanged="@OnModelSelected"
                                         Placeholder="-- Select --" Enabled="@FieldsEnabled" Width="100%" />
                </div>

                @* Lot/Block/Plan *@
                <div class="form-field">
                    <label>Lot/Block/Plan</label>
                    <div class="inline-fields">
                        <TextBoxControl Value="@txtLot" ValueChanged="@OnLotInput" Enabled="@FieldsEnabled" MaxLength="10" Placeholder="Lot" CssClass="job-field" />
                        <TextBoxControl Value="@txtBlock" ValueChanged="@OnBlockInput" Enabled="@FieldsEnabled" MaxLength="10" Placeholder="Block" CssClass="job-field" />
                        <TextBoxControl Value="@txtLotPlan" ValueChanged="@OnLotPlanInput" Enabled="@FieldsEnabled" MaxLength="10" Placeholder="Plan" CssClass="job-field" />
                    </div>
                </div>

                @* Status *@
                <div class="form-field">
                    <label>Status</label>
                    <DropDownListControl TValue="string" TItem="ComboItem"
                                         DataSource="@StatusItems" TextFieldName="Text" ValueFieldName="Value"
                                         Value="@cboStatus" ValueChanged="@OnStatusSelected"
                                         Enabled="@StatusEnabled" Width="150px" />
                </div>
            </div>

            <div class="job-form-section-spacer"></div>

            <div class="job-form-section">
                @* Address *@
                <div class="form-field form-field-address">
                    <label class="bold">Address</label>
                    <TextAreaControl Value="@txtAddress" ValueChanged="@OnAddressInput" Rows="2" Enabled="@FieldsEnabled" MaxLength="75" CssClass="job-field-area" />
                </div>
                <div class="form-field">
                    <label>City/Prov</label>
                    <div class="inline-fields">
                        <TextBoxControl Value="@txtCity" ValueChanged="@OnCityInput" Enabled="@FieldsEnabled" MaxLength="30" Placeholder="City" CssClass="job-field" />
                        <DropDownListControl TValue="string" TItem="string"
                                             DataSource="@ProvinceItems"
                                             Value="@cboProvince" ValueChanged="@OnProvinceSelected"
                                             Placeholder="--" Enabled="@FieldsEnabled" Width="80px" />
                    </div>
                </div>
                <div class="form-field">
                    <label>Postal</label>
                    <TextBoxControl Value="@txtPostal" ValueChanged="@OnPostalInput" Enabled="@FieldsEnabled" MaxLength="7" CssClass="job-field job-field-sm" />
                </div>
                <div class="form-field">
                    <label>Phone</label>
                    <TextBoxControl Value="@txtPhone" ValueChanged="@OnPhoneInput" Enabled="@FieldsEnabled" MaxLength="25" CssClass="job-field" />
                </div>
                <div class="form-field">
                    <label>Fax</label>
                    <TextBoxControl Value="@txtFax" ValueChanged="@OnFaxInput" Enabled="@FieldsEnabled" MaxLength="25" CssClass="job-field" />
                </div>
            </div>
        </div>

        @* Properties — VB6 gProperties: an outline tree (category folders + name/value leaves) *@
        <div class="job-properties-area">
            <div class="job-section-title">Properties</div>
            <div class="properties-tree">
                <TreeGridControl @ref="PropertiesTree"
                        TValue="PropertyRow"
                        DataSource="@PropertiesData"
                        IdMapping="Id"
                        ParentIdMapping="ParentId"
                        TreeColumnIndex="0"
                        CssClass="fx-treegrid-compact fx-treegrid-yellow-folder fx-treegrid-dotted-lines fx-treegrid-popup-overflow hf-job-properties-treegrid"
                        AllowSelection="true"
                        RowSelected="@OnPropertyRowSelected"
                        EnableHover="false"
                        ToggleOnRowClick="false"
                        ShowColumnHeaders="false"
                        EnableCollapseAll="true"
                        IndentPerLevel="8"
                        ShowLeafNodeIcons="false"
                        Height="100%">
                    <TreeGridColumn Field="@nameof(PropertyRow.Name)" HeaderText="Name" Width="150px" />
                    <TreeGridColumn Field="@nameof(PropertyRow.Value)" HeaderText="Value" Width="110px">
                        <Template>
                            @{ var p = (PropertyRow)context; }
                            @if (!p.IsCategory)
                            {
                                var editing = IsPropertyValueEditing(p);
                                <div class="@GetPropertyValueCellCss(p)"
                                     @onclick="() => BeginPropertyValueEdit(p)"
                                     @ondblclick="() => BeginPropertyValueEdit(p)"
                                     @onclick:stopPropagation="true"
                                     @onmousedown:stopPropagation="true">
                                    @if (!editing || p.DataType == "READONLY")
                                    {
                                        <span class="job-prop-display @(p.DataType == "READONLY" ? "prop-readonly" : "")">@GetPropertyDisplayValue(p)</span>
                                    }
                                    else if (p.DataType == "Bit")
                                    {
                                        <CheckBoxControl Checked="@IsPropChecked(p)"
                                                         CheckedChanged="@(b => OnPropBoolChanged(p, b))"
                                                         Enabled="@FieldsEnabled"
                                                         StopClickPropagation="true"
                                                         StopMouseDownPropagation="true"
                                                         StopKeyDownPropagation="true" />
                                    }
                                    else if (p.Category == "Tax Groups" || !string.IsNullOrEmpty(p.PickList))
                                    {
                                        <DropDownListControl TValue="string" TItem="ComboItem"
                                                             DataSource="@ParsePickList(p.PickList)"
                                                             TextFieldName="Text" ValueFieldName="Value"
                                                             Value="@p.Value"
                                                             ValueChanged="@(v => OnPropValueChanged(p, v))"
                                                             Enabled="@FieldsEnabled"
                                                             CssClass="job-prop-editor"
                                                             Width="100%" />
                                    }
                                    else if (p.DataType == "DateTime" || p.Category == "Loan Information")
                                    {
                                        <DatePickerControl Value="@ParsePropDate(p.Value)"
                                                           ValueChanged="@(v => OnPropDateChanged(p, v))"
                                                           Enabled="@FieldsEnabled"
                                                           Format="dd-MMM-yy"
                                                           Placeholder=""
                                                           CssClass="job-prop-editor job-prop-date fx-datepicker-align-right"
                                                           Style="width:100%;" />
                                    }
                                    else
                                    {
                                        <TextBoxControl Value="@p.Value"
                                                        ValueChanged="@(v => OnPropValueChanged(p, v))"
                                                        Enabled="@FieldsEnabled"
                                                        CssClass="job-prop-editor"
                                                        Width="100%" />
                                    }
                                </div>
                            }
                        </Template>
                    </TreeGridColumn>
                </TreeGridControl>
            </div>
        </div>
    </div>

    @* ── RIGHT PANEL ────────────────────────────────────── *@
    <div class="job-right">
        @* Notes — VB6 txtNotes (compact multi-line) *@
        <div class="job-section-title">Notes</div>
        <div class="panel-card">
            <TextAreaControl Value="@txtNotes" Rows="2" ValueChanged="@OnNotesChanged" UpdateOnInput="true" />
        </div>

        @* Personnel — VB6 gContacts (PM / Estimator / Purchaser from tblProjectManager).
           Columns come dynamically from AppGridLayout "FJob.gContacts" (IniGetGrid). *@
        <div class="job-section-title">Personnel</div>
        <div class="panel-card">
            <GridControl @ref="ContactsGrid"
                         EnableHeaderContextMenu="false"
                         GridLines="GridLines.None"
                    TValue="ContactRow"
                    DataSource="@ContactsData"
                    AllowSelection="true"
                    AllowResizing="true"
                    AllowRowDragSelection="false"
                    SelectedRowBackground="#316ac5"
                    SelectedRowForeground="#fff"
                    SelectedRowHoverBackground="#316ac5"
                    Width="100%"
                    Height="90px"
                    EditSettingsRef="@contactsEditSettings"
                    EventsRef="@contactsGridEvents"
                    OnLayoutChanged="@OnContactsLayoutChangedAsync">
                <GridColumnsBase @key="gContactsLayoutVersion">
                    @if (HasContactsGridLayout)
                    {
                        foreach (var entry in OrderedLayout(gContactsLayout, _contactRowPropMap))
                        {
                            var width = entry.Layout.Width.HasValue && entry.Layout.Width.Value > 0
                                ? $"{ConvertLayoutWidthToPx(entry.Layout.Width.Value)}px" : "120px";
                            var header = string.IsNullOrWhiteSpace(entry.Layout.Caption) ? entry.Layout.Field : entry.Layout.Caption;
                            if (entry.Field == nameof(ContactRow.PMName))
                            {
                                <GridColumn Field="@entry.Field" HeaderText="@header" Width="@width"
                                              AllowEditing="false" ShowEditButton="true" ClipMode="ClipMode.Ellipsis" />
                            }
                            else if (string.Equals(entry.Field, nameof(ContactRow.ContactType), StringComparison.OrdinalIgnoreCase))
                            {
                                <GridColumn Field="@entry.Field" HeaderText="@header" Width="@width"
                                              Type="@entry.ColumnType" TextAlign="@entry.TextAlign"
                                              AllowEditing="false" ClipMode="ClipMode.Ellipsis">
                                    <Template>
                                        @{ var rr = (ContactRow)context; }
                                        <span class="fx-personnel-row">
                                            <img src="images/16/contact2.ico" alt="" class="fx-personnel-icon" onerror="this.style.display='none'" />
                                            <span>@rr.ContactType</span>
                                        </span>
                                    </Template>
                                </GridColumn>
                            }
                            else
                            {
                                <GridColumn Field="@entry.Field" HeaderText="@header" Width="@width"
                                              Type="@entry.ColumnType" TextAlign="@entry.TextAlign"
                                              AllowEditing="false" ClipMode="ClipMode.Ellipsis" />
                            }
                        }
                    }
                    else
                    {
                        <GridColumn Field="@nameof(ContactRow.ContactType)" HeaderText="Title" Width="120px" AllowEditing="false">
                            <Template>
                                @{ var rr = (ContactRow)context; }
                                <span class="fx-personnel-row">
                                    <img src="images/16/contact2.ico" alt="" class="fx-personnel-icon" onerror="this.style.display='none'" />
                                    <span>@rr.ContactType</span>
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ContactRow.PMName)" HeaderText="Name" Width="160px"
                                    AllowEditing="false" ShowEditButton="true" />
                        <GridColumn Field="@nameof(ContactRow.Phone)" HeaderText="Phone" Width="120px" AllowEditing="false" />
                        <GridColumn Field="@nameof(ContactRow.Cell)" HeaderText="Mobile" Width="120px" AllowEditing="false" />
                        <GridColumn Field="@nameof(ContactRow.Email)" HeaderText="Email" Width="180px" AllowEditing="false" />
                    }
                </GridColumnsBase>
            </GridControl>
        </div>

        @* Contacts — VB6 gJobContacts (roles from JobContactRoles option + contacts table).
           Columns come dynamically from AppGridLayout "FJob.gJobContacts". *@
        <div class="job-section-title">Contacts</div>
        <div class="panel-card">
            <GridControl @ref="JobContactsGrid"
                         EnableHeaderContextMenu="false"
                         GridLines="GridLines.None"
                    TValue="JobContactRow"
                    DataSource="@JobContactsData"
                    AllowSelection="true"
                    AllowResizing="true"
                    Width="100%"
                    Height="120px"
                    EditSettingsRef="@jobContactsEditSettings"
                    EventsRef="@jobContactsGridEvents"
                    OnLayoutChanged="@OnJobContactsLayoutChangedAsync">
                <GridColumnsBase @key="gJobContactsLayoutVersion">
                    @if (HasJobContactsGridLayout)
                    {
                        foreach (var entry in OrderedLayout(gJobContactsLayout, _jobContactRowPropMap))
                        {
                            var width = entry.Layout.Width.HasValue && entry.Layout.Width.Value > 0
                                ? $"{ConvertLayoutWidthToPx(entry.Layout.Width.Value)}px" : "120px";
                            var header = string.IsNullOrWhiteSpace(entry.Layout.Caption) ? entry.Layout.Field : entry.Layout.Caption;
                            var editable = entry.Field is nameof(JobContactRow.Phone) or nameof(JobContactRow.Cell)
                                or nameof(JobContactRow.Fax) or nameof(JobContactRow.Email)
                                or nameof(JobContactRow.SendVia) or nameof(JobContactRow.SmsAddress);
                            if (entry.Field == nameof(JobContactRow.Name))
                            {
                                <GridColumn Field="@entry.Field" HeaderText="@header" Width="@width"
                                              AllowEditing="true" ShowEditButton="true" ClipMode="ClipMode.Ellipsis" />
                            }
                            else
                            {
                                <GridColumn Field="@entry.Field" HeaderText="@header" Width="@width"
                                              Type="@entry.ColumnType" TextAlign="@entry.TextAlign"
                                              AllowEditing="@editable" ClipMode="ClipMode.Ellipsis" />
                            }
                        }
                    }
                    else
                    {
                        <GridColumn Field="@nameof(JobContactRow.Role)" HeaderText="Role" Width="200px" AllowEditing="false" />
                        <GridColumn Field="@nameof(JobContactRow.Company)" HeaderText="Company" Width="120px" AllowEditing="false" />
                        <GridColumn Field="@nameof(JobContactRow.Name)" HeaderText="Name" Width="140px" ShowEditButton="true" />
                        <GridColumn Field="@nameof(JobContactRow.Phone)" HeaderText="Phone" Width="130px" />
                        <GridColumn Field="@nameof(JobContactRow.Cell)" HeaderText="Mobile" Width="120px" />
                        <GridColumn Field="@nameof(JobContactRow.Email)" HeaderText="Email" Width="150px" />
                        <GridColumn Field="@nameof(JobContactRow.SendVia)" HeaderText="Send Via" Width="90px" />
                        <GridColumn Field="@nameof(JobContactRow.Fax)" HeaderText="Fax" Width="100px" />
                        <GridColumn Field="@nameof(JobContactRow.SmsAddress)" HeaderText="SMS Provider" Width="120px" />
                    }
                </GridColumnsBase>
            </GridControl>
        </div>

        @* Purchase Orders *@
        <div class="job-section-title">Purchase Orders</div>
        <div class="panel-card">
            <GridControl @ref="POsGrid"
                         EnableHeaderContextMenu="false"
                         GridLines="GridLines.None"
                    TValue="PORow"
                    DataSource="@POsData"
                    AllowSelection="true"
                    AllowSorting="true"
                    AllowResizing="true"
                    Height="180px"
                    SelectionSettingsRef="@poSelectionSettings"
                    OnLayoutChanged="@OnPOsLayoutChangedAsync">
                <GridColumnsBase @key="gPOsLayoutVersion">
                    @if (HasPOsGridLayout)
                    {
                        foreach (var entry in GetOrderedPOsGridLayout())
                        {
                            var layout = entry.Layout;
                            var fieldName = entry.Field;
                            var columnType = entry.ColumnType;
                            var textAlign = entry.TextAlign;
                            var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                            var width = layout.Width.HasValue && layout.Width.Value > 0
                                ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;
                            var format = (columnType == ColumnType.Number) ? "C2" : null;

                            <GridColumn Field="@fieldName"
                                          HeaderText="@headerText"
                                          Width="@width"
                                          Type="@columnType"
                                          TextAlign="@textAlign"
                                          Format="@format"
                                          ClipMode="ClipMode.Ellipsis" />
                        }
                    }
                    else
                    {
                        <GridColumn Field="@nameof(PORow.PODate)" HeaderText="Date" Width="100px" Format="d" />
                        <GridColumn Field="@nameof(PORow.PONumber)" HeaderText="PO Number" Width="100px" />
                        <GridColumn Field="@nameof(PORow.POIndex)" HeaderText="PO Index" Width="80px" />
                        <GridColumn Field="@nameof(PORow.Description)" HeaderText="Description" Width="200px" />
                        <GridColumn Field="@nameof(PORow.Vendor)" HeaderText="Vendor" Width="80px" />
                        <GridColumn Field="@nameof(PORow.VendorName)" HeaderText="Vendor Name" Width="180px" />
                        <GridColumn Field="@nameof(PORow.Pretax)" HeaderText="Pretax" Width="100px" Format="C2" TextAlign="TextAlign.Right" Type="ColumnType.Number" />
                        <GridColumn Field="@nameof(PORow.Tax)" HeaderText="Tax" Width="80px" Format="C2" TextAlign="TextAlign.Right" Type="ColumnType.Number" />
                        <GridColumn Field="@nameof(PORow.Total)" HeaderText="Total" Width="100px" Format="C2" TextAlign="TextAlign.Right" Type="ColumnType.Number" />
                        <GridColumn Field="@nameof(PORow.Approval)" HeaderText="Approval" Width="200px" />
                        <GridColumn Field="@nameof(PORow.PostingBatch)" HeaderText="Batch" Width="80px" />
                        <GridColumn Field="@nameof(PORow.CancelledBy)" HeaderText="Cancelled By" Width="100px" Visible="false" />
                        <GridColumn Field="@nameof(PORow.CancelledDate)" HeaderText="Cancelled Date" Width="100px" Visible="false" />
                        <GridColumn Field="@nameof(PORow.CancelledNotes)" HeaderText="Cancel Notes" Width="150px" Visible="false" />
                    }
                </GridColumnsBase>
            </GridControl>
        </div>
    </div>
</div>

</div>

@* Job pick list — VB6 Open button opens this inline; selecting a job reloads the form. *@
<FPickList @ref="_jobPickList" OnSelected="OnJobPicked" OnCancel="OnJobPickCancelled" />

@* Personnel picker (VB6 gContacts_CellButtonClick → tblProjectManager) *@
<FPickList @ref="_personnelPickList" OnSelected="OnPersonnelPicked" />

@* Contacts picker (VB6 gJobContacts_CellButtonClick → contacts) *@
<FPickList @ref="_contactPickList" OnSelected="OnContactPicked" />

@* AR Customer picker (VB6 cmdBrowse_Click Index=10 → arcustomers) *@
<FPickList @ref="_arCustomerPickList" OnSelected="OnARCustomerPicked" />

@if (_showProjectManagersModal)
{
    <FProjectManagers IsModal="true" OnClose="OnProjectManagersModalClosed" />
}

@* VB6 cmdJob external-accounting job browse is BLOCKED in this build — this modal makes the gap visible. *@
<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_accountingBlockedBox" />
@* HHM-437: VB6 Toolbar "Attachments" (FJob.frm:1991) → EditAttachments task; same
   FAttachments modal host FItems/FAssembly use. *@
<FAttachments @ref="jobAttachmentsDialog" />

@* HHM-418: window control-box system menu (see .job-titlebar above). *@
<ContextMenuControl Visible="@_showSysMenu" X="@_sysMenuX" Y="@_sysMenuY" MinWidth="140" OnClose="CloseSysMenu">
    <ContextMenuItemControl Text="Restore" Disabled="true" />
    <ContextMenuItemControl Text="Move" Disabled="true" />
    <ContextMenuItemControl Text="Size" Disabled="true" />
    <ContextMenuItemControl Text="Minimize" Disabled="true" />
    <ContextMenuItemControl Text="Maximize" Disabled="true" />
    <ContextMenuSeparatorControl />
    <ContextMenuItemControl Text="Close" OnClick="CloseWindowFromSysMenu" />
</ContextMenuControl>

@code {
    [Parameter] public string? JobNumber { get; set; }

    // HHM-389: push the VB6 caption (FJob.frm:2465/2490 "Job Setup - <JobNo>") to the
    // MDI tab. Seeded once on first render; updated wherever FormCaption changes.
    [CascadingParameter(Name = "SetPageTitle")] private Action<string?>? SetPageTitle { get; set; }
    private void UpdatePageTitle() => SetPageTitle?.Invoke(FormCaption);

    // Database
// UI State
    private bool IsLoading = false;
    private bool mDirty = false;
    private string mJob = "";
    private bool mIsCanadian = false;
    private bool mIsAustralia = false;
    private bool mIsMultifamily = false;
    private bool mEnablePreconJobs = false;
    private bool mEnableTarion = false;
    private string FormCaption = "Job Setup";
    private string AccountingSystem = "None";
    private string SalesSystem = "None";
    private readonly Dictionary<string, bool> _systemSetupColumnCache = new(StringComparer.OrdinalIgnoreCase);

    // Field visibility/state
    private bool FieldsEnabled = false;
    private bool JobEditable = false;
    private bool StatusEnabled = false;
    private bool ShowExternalID = false;
    private bool ShowARCustomer = true;
    private bool ShowGLPrefixCombo = false;
    private bool ShowGLPrefixText = false;
    private bool ShowJobBrowse = false;
