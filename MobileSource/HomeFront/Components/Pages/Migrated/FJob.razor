    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        contactsGridEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<ContactRow>>(this, OnContactsEditButton);
        contactsGridEvents.OnRecordDoubleClick = EventCallback.Factory.Create<CellClickEventArgs<ContactRow>>(this, OnContactsRecordDoubleClick);
        jobContactsGridEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<JobContactRow>>(this, OnJobContactsEditButton);

        await LoadGridLayoutAsync();
        await LoadAppSettings();
        LoadProvinces();
        await LoadCommunities();
        await LoadModels();
        await LoadGLPrefixes();

        // VB6 FJob loads the current job directly (FMain.CurrentJob, set from the workflow home).
        // Priority: explicit route param → the session-wide current job → the first job in the list.
        var job = !string.IsNullOrEmpty(JobNumber) ? JobNumber : SessionState.JobNumber;
        if (string.IsNullOrEmpty(job))
            job = await GetFirstJobAsync();
        if (!string.IsNullOrEmpty(job))
        {
            mJob = job;
            await LoadData();
        }
        else
        {
            // No job anywhere → present the job picklist (VB6 FJob.Form_Load opens it when empty).
            mDirty = false;
            _autoOpenJobPicker = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) UpdatePageTitle();   // HHM-389: seed the MDI tab caption
        if (_collapsePropertiesTreeAfterRender && PropertiesTree != null)
        {
            _collapsePropertiesTreeAfterRender = false;
            await PropertiesTree.CollapseAllAsync();
        }
        if (firstRender && _autoOpenJobPicker)
        {
            _autoOpenJobPicker = false;
            await OnOpenClick();   // VB6 FJob: pop the job picklist when no job was supplied
        }
    }

    // ── App Settings ─────────────────────────────────────────────────────
    private async Task LoadAppSettings()
    {
        try
        {
            var dt = db.SqlExec("SELECT TOP 1 * FROM system_setup WHERE id=@Id", new { Id = SessionState.DivisionID });
            if (dt.Rows.Count > 0)
            {
                var row = dt.Rows[0];
                // VB6: mIsCanadian = HFApp.Options(Country)="CA" — Country is an Options key that
                // falls back to the system_setup.Country column (Options.cls ValueByName), so this read is correct.
                var country = row["Country"]?.ToString() ?? "US";
                mIsCanadian = country == "CA";
                mIsAustralia = country == "AU";
            }

            // VB6: HFApp.Options(AccountingSystem) / Options(SalesSystem) — these are NOT system_setup
            // columns; they live in AppOptions as the NUMERIC AccountingSystems / SalesSystems enum value
            // (e.g. asQuickBooks=3), keyed by optionname + DivisionID with IN(0,@Div) ORDER BY divisionid DESC
            // so the division-specific row overrides the global (divisionid=0) default (Options.cls:811).
            AccountingSystem = MapAccountingSystem(await GetAppOptionNumber("AccountingSystem"));
            // SalesSystem default = asHomeFront (1) when no row exists (Options.cls:1031).
            SalesSystem = MapSalesSystem(await GetAppOptionNumber("SalesSystem", defaultValue: (int)Application.SalesSystems.asHomeFront));

            // VB6 Options.cls lists MultiFamily under _SystemSettings, loaded from system_setup.
            // EnablePreconJobs/EnableTarionFields are ValueByName-only options, so they follow
            // VB6's system_setup probe with AppOptions fallback.
            mIsMultifamily = IsOptionTrue(GetSystemSetupOptionValue("MultiFamily"));
            mEnablePreconJobs = IsOptionTrue(await GetOptionValue("EnablePreconJobs"));
            mEnableTarion = IsOptionTrue(await GetOptionValue("EnableTarionFields"));
            CommunityLabel = await GetCustomDesc("Community");

            // Configure based on accounting system
            switch (AccountingSystem)
            {
                case "QuickBooks":
                    ExternalIDLabel = "Quickbooks ID";
                    ShowExternalID = true;
                    ShowJobBrowse = true;
                    break;
                case "Simply":
                    ExternalIDLabel = "Simply ID";
                    ShowExternalID = true;
                    ShowJobBrowse = true;
                    break;
                case "MasterBuilder":
                    ShowExternalID = false;
                    ShowARCustomer = false;
                    ShowJobBrowse = true;
                    break;
                case "Timberline":
                    ShowJobBrowse = true;
                    ShowExternalID = false;
                    break;
                case "Intacct":
                    GLPrefixLabel = "Location";
                    ShowJobBrowse = true;
                    ShowExternalID = false;
                    break;
                default:
                    ShowExternalID = false;
                    ShowJobBrowse = false;
                    break;
            }

            if (mIsMultifamily)
            {
                ShowARCustomer = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadAppSettings error");

        }
    }

    // VB6 HFApp.Options.ValueByName for names NOT declared in OptionsEnum (Options.cls:796-815):
    // try the system_setup column first under On Error Resume Next, then fall back to AppOptions.
    // The column-existence check preserves that result without turning VB6's swallowed probe error
    // into a .NET runtime log entry.
    private async Task<string> GetOptionValue(string optionName)
    {
        // option names are compile-time literals from this form, never user input; guard anyway.
        if (!System.Text.RegularExpressions.Regex.IsMatch(optionName, "^[A-Za-z0-9_]+$"))
            return "";

        if (SystemSetupHasColumn(optionName))
        {
            var s = GetSystemSetupOptionValue(optionName);
            if (!string.IsNullOrEmpty(s)) return s;
        }

        return await GetAppOptionValue(optionName);
    }

    private string GetSystemSetupOptionValue(string optionName)
    {
        if (!System.Text.RegularExpressions.Regex.IsMatch(optionName, "^[A-Za-z0-9_]+$"))
            return "";

        try
        {
            var val = db.SqlExec($"SELECT TOP 1 [{optionName}] FROM system_setup WHERE id=@Id",
                new { Id = SessionState.DivisionID });
            return val.Rows.Count > 0 ? val.Rows[0][0]?.ToString() ?? "" : "";
        }
        catch { return ""; }
    }

    private async Task<string> GetAppOptionValue(string optionName)
    {
        try
        {
            var val = db.SqlExec(
                @"SELECT TOP 1 optionvalue FROM appoptions
                   WHERE ISNULL(divisionid,0) IN (0, @DivisionID) AND optionname=@OptionName
                   ORDER BY divisionid DESC",
                new { DivisionID = SessionState.DivisionID, OptionName = optionName });
            if (val.Rows.Count > 0) return val.Rows[0][0]?.ToString() ?? "";
        }
        catch { /* non-critical */ }
        return "";
    }

    private bool SystemSetupHasColumn(string optionName)
    {
        if (_systemSetupColumnCache.TryGetValue(optionName, out var hasColumn))
            return hasColumn;

        try
        {
            var result = db.SqlExec(
                @"SELECT 1
                    FROM INFORMATION_SCHEMA.COLUMNS
                   WHERE TABLE_NAME = 'system_setup'
                     AND COLUMN_NAME = @ColumnName",
                new { ColumnName = optionName });
            hasColumn = result.Rows.Count > 0;
        }
        catch
        {
            hasColumn = false;
        }

        _systemSetupColumnCache[optionName] = hasColumn;
        return hasColumn;
    }

    // VB6 boolean option semantics (Option Compare Text): "true"/"True"/"1" → true; everything else false.
    private static bool IsOptionTrue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        var v = value.Trim();
        return v == "1" || string.Equals(v, "true", StringComparison.OrdinalIgnoreCase);
    }

    // VB6 HFApp.Options(AccountingSystem) / Options(SalesSystem): both are declared before
    // _SystemSettings in Options.cls, so Options.Read loads them from AppOptions, not system_setup.
    private async Task<int> GetAppOptionNumber(string optionName, int defaultValue = 0)
    {
        var raw = await GetAppOptionValue(optionName);
        return int.TryParse(raw, out var n) ? n : defaultValue;
    }

    // Map the numeric AccountingSystems enum (AppOptions) to the string tokens the rest of this form
    // already switches on (LoadAppSettings / LoadData / LoadProperties / SaveData). VB6 Form_Load:1828.
    private static string MapAccountingSystem(int value) => value switch
    {
        (int)Application.AccountingSystems.asTimberline => "Timberline",
        (int)Application.AccountingSystems.asMasterBuilder => "MasterBuilder",
        (int)Application.AccountingSystems.asQuickBooks => "QuickBooks",
        (int)Application.AccountingSystems.asSimply => "Simply",
        (int)Application.AccountingSystems.asMYOB => "MYOB",
        (int)Application.AccountingSystems.asPeachtree => "Peachtree",
        (int)Application.AccountingSystems.asXero => "Xero",
        (int)Application.AccountingSystems.asSpectrum => "Spectrum",
        (int)Application.AccountingSystems.asIntacct => "Intacct",
        (int)Application.AccountingSystems.asQuickbooksOnline => "QuickbooksOnline",
        (int)Application.AccountingSystems.asD365_ABN => "D365",
        _ => "None"
    };

    private static string MapSalesSystem(int value) => value switch
    {
        (int)Application.SalesSystems.asHomeFront => "HomeFront",
