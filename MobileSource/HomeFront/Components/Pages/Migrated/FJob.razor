    private static decimal SafeDecimal(object? val, decimal def = 0) =>
        val != null && val != DBNull.Value && !string.IsNullOrEmpty(val.ToString())
            ? Convert.ToDecimal(val)
            : def;

    // ── Load Grid Layout ──────────────────────────────────────
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            // Load/Version bump handled by each presenter (ctors set the
            // "FJob"/"gPOs|gContacts|gJobContacts" names).
            await _posGrid.LoadAsync(GridLayoutSvc);
            await _contactsGrid.LoadAsync(GridLayoutSvc);
            await _jobContactsGrid.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");

        }
    }

    // GridControl raises OnLayoutChanged when a resize/reorder/hide/rename finishes.
    // The new widths live on the snapshot, not in the presenter's layout dict, so
    // they must be merged in before the save.
    private Task OnPOsLayoutChangedAsync(GridSettings snapshot) =>
        PersistGridLayoutAsync("gPOs", gPOsLayout, snapshot, _posGrid, ResolvePOGridField);

    private Task OnContactsLayoutChangedAsync(GridSettings snapshot) =>
        PersistGridLayoutAsync("gContacts", gContactsLayout, snapshot, _contactsGrid,
            f => ResolveLayoutField(f, _contactRowPropMap));

    private Task OnJobContactsLayoutChangedAsync(GridSettings snapshot) =>
        PersistGridLayoutAsync("gJobContacts", gJobContactsLayout, snapshot, _jobContactsGrid,
            f => ResolveLayoutField(f, _jobContactRowPropMap));

    private async Task PersistGridLayoutAsync<T>(string gridName,
        IDictionary<string, GridLayoutColumn> layout, GridSettings snapshot,
        GridLayoutPresenter<T> presenter, Func<string, string>? layoutFieldResolver)
    {
        if (snapshot == null || layout.Count == 0) return;
        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FJob", gridName, instanceKey: null,
                layout, snapshot, layoutFieldResolver);

            presenter.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FJob {Grid} layout", gridName);
        }
    }

    // ── Generic dynamic-column helper (used by Personnel + Contacts grids) ──
    private static IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)>
        OrderedLayout(Dictionary<string, GridLayoutColumn> layout, Dictionary<string, PropertyInfo> propMap)
    {
        var ordered = layout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var col in ordered)
        {
            var field = ResolveLayoutField(col.Field, propMap);
            var ct = ResolveColumnType(field, propMap);
            var ta = ct == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (col, field, ct, ta);
        }
    }

    private static string ResolveLayoutField(string layoutField, Dictionary<string, PropertyInfo> propMap)
    {
        if (string.IsNullOrWhiteSpace(layoutField)) return "";
        var trimmed = layoutField.Trim();
        if (propMap.TryGetValue(NormalizeGridKey(trimmed), out var prop)) return prop.Name;
        return trimmed;
    }

    private static ColumnType ResolveColumnType(string field, Dictionary<string, PropertyInfo> propMap)
    {
        if (propMap.TryGetValue(NormalizeGridKey(field), out var prop))
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool)) return ColumnType.CheckBox;
            if (type == typeof(int) || type == typeof(long) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
        }
        return ColumnType.Text;
    }

    // PickList format "id<tab>desc|id<tab>desc" (VB6 ColComboList) → ComboItems.
    private static List<ComboItem> ParsePickList(string pickList)
    {
        var list = new List<ComboItem>();
        if (string.IsNullOrEmpty(pickList)) return list;
        foreach (var part in pickList.Split('|', StringSplitOptions.RemoveEmptyEntries))
        {
            var tab = part.IndexOf('\t');
            if (tab >= 0)
                // HHM-399: VSFlexGrid renders every ComboList column in the drop list
                // ("GST|GST" for "GST<tab>GST") — show both columns like the legacy grid.
                list.Add(new ComboItem { Value = part.Substring(0, tab), Text = part.Replace('\t', '|') });
            else
                list.Add(new ComboItem { Value = part, Text = part });
        }
        return list;
    }

    private static string ResolvePropertyDataType(DataTable? dataTable, string fieldName)
    {
        if (dataTable == null || string.IsNullOrWhiteSpace(fieldName))
            return fieldName.Contains("Date", StringComparison.OrdinalIgnoreCase) ? "DateTime" : "Str";

        var column = dataTable.Columns[fieldName];
        if (column == null)
            return fieldName.Contains("Date", StringComparison.OrdinalIgnoreCase) ? "DateTime" : "Str";

        var type = Nullable.GetUnderlyingType(column.DataType) ?? column.DataType;
        if (type == typeof(bool)) return "Bit";
        if (type == typeof(DateTime)) return "DateTime";
        if (type == typeof(byte) || type == typeof(short) || type == typeof(int) || type == typeof(long)) return "NumInt";
        if (type == typeof(float) || type == typeof(double) || type == typeof(decimal)) return "Num";
        return "Str";
    }

    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedPOsGridLayout()
    {
        if (!HasPOsGridLayout) yield break;

        var ordered = gPOsLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = ResolvePOGridField(layout.Field);
            var columnType = GetPOColumnTypeForField(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    private static string ResolvePOGridField(string layoutField)
    {
        if (string.IsNullOrWhiteSpace(layoutField)) return "";
        var trimmed = layoutField.Trim();

        var exact = typeof(PORow).GetProperty(trimmed, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
        if (exact != null) return exact.Name;

        var normalized = NormalizeGridKey(trimmed);
        if (_poRowPropMap.TryGetValue(normalized, out var prop))
            return prop.Name;

        return trimmed switch
        {
            "PO_Date" => "PODate",
            "PO_Number" or "PONo" => "PONumber",
            "PO_Index" => "POIndex",
            "Vendor_Name" => "VendorName",
            "PostingBatchID" => "PostingBatch",
            _ => trimmed
        };
    }

    private static ColumnType GetPOColumnTypeForField(string field)
    {
        if (string.IsNullOrWhiteSpace(field)) return ColumnType.Text;
        if (_poRowPropMap.TryGetValue(NormalizeGridKey(field), out var prop))
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool)) return ColumnType.CheckBox;
            if (type == typeof(int) || type == typeof(long) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
        }
        return ColumnType.Text;
    }

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    private static string NormalizeGridKey(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var sb = new StringBuilder(value.Length);
        foreach (var ch in value)
        {
            if (char.IsLetterOrDigit(ch))
                sb.Append(char.ToLowerInvariant(ch));
        }
        return sb.ToString();
    }

