@using System.Data
@using System.Data.Common
@using System.Globalization
@using System.Text
@using System.Text.RegularExpressions
@using Microsoft.Win32
@using HomeFront.Data

@code {
    public const string SQLTIMEFORMAT = "HH:mm:ss";
    public const string SQLDATEFORMAT = "yyyy-MM-dd";
    public const string SQLDATETIMEFORMAT = "yyyy-MM-dd HH:mm:ss";

    public enum SqlErrors
    {
        NODSN = -2147467259,
        DUPKEY = -2147467259,
        DUPKEY1 = -2147217900,
        MISCERR = -2147217900,
        NOTNULL = -2147217900,
        TYPECONV = -2147217913
    }

    public enum DbDataTypes
    {
        Date = 1,
        Time,
        Str,
        Num,
        NumInt,
        DateTime,
        Cur,
        Bit,
        Xml
    }

    public enum RoundDirections
    {
        rdNone,
        rdUpTo,
        rdDownTo,
        rdClosest
    }

    public enum RegistryHiveConstants
    {
        HKEY_CLASSES_ROOT = unchecked((int)0x80000000),
        HKEY_CURRENT_USER = unchecked((int)0x80000001),
        HKEY_LOCAL_MACHINE = unchecked((int)0x80000002),
        HKEY_USERS = unchecked((int)0x80000003),
        HKEY_PERFORMANCE_DATA = unchecked((int)0x80000004),
        HKEY_CURRENT_CONFIG = unchecked((int)0x80000005),
        HKEY_DYN_DATA = unchecked((int)0x80000006)
    }

    private readonly DbWrapperSqlServer _db = new();

    [Parameter] public int DivisionId { get; set; } = 1;

    public void SetLastUpdate(string item, DateTime value)
    {
        try
        {
            var optionName = $"LastUpdate{item}";
            _db.ExecuteNonQuery(
                "INSERT INTO appoptions(DivisionID,uid,optionvalue,optionname) VALUES(@DivisionID,'',@OptionValue,@OptionName)",
                new { DivisionID = DivisionId, OptionValue = DateTime.Now, OptionName = optionName });
            _db.ExecuteNonQuery(
                "UPDATE appoptions SET optionvalue=@OptionValue WHERE DivisionID=@DivisionID and uid='' and optionname=@OptionName",
                new { DivisionID = DivisionId, OptionValue = DateTime.Now, OptionName = optionName });
        }
        catch
        {
        }
    }

    public DateTime GetLastUpdate(string item)
    {
        var fallback = new DateTime(1950, 1, 1);
        try
        {
            var optionName = $"LastUpdate{item}";
            var dt = _db.SqlExec(
                "select optionvalue from appoptions where DivisionID=@DivisionID and uid='' and optionname=@OptionName",
                new { DivisionID = DivisionId, OptionName = optionName });
            if (dt.Rows.Count == 0)
            {
                return fallback;
            }

            var value = dt.Rows[0][0];
            if (value == null || value == DBNull.Value)
            {
                return fallback;
            }

            if (DateTime.TryParse(value.ToString(), out var parsed))
            {
                return parsed;
            }
        }
        catch
        {
        }

        return fallback;
    }

    public static string DbQuote(DbDataTypes dtype, object? value, bool nullable = false, bool trimStr = false, long length = 0)
    {
        switch (dtype)
        {
            case DbDataTypes.Bit:
                return QuoteBit(value);
            case DbDataTypes.Date:
                return QuoteDate(value, SQLDATEFORMAT);
            case DbDataTypes.DateTime:
                return QuoteDate(value, SQLDATETIMEFORMAT);
            case DbDataTypes.Time:
                return QuoteDate(value, SQLTIMEFORMAT);
            case DbDataTypes.Str:
                return QuoteString(value, nullable, trimStr, length);
            case DbDataTypes.Xml:
                return QuoteXml(value, nullable, trimStr, length);
            case DbDataTypes.Num:
            case DbDataTypes.NumInt:
                return QuoteNumeric(value, nullable);
            case DbDataTypes.Cur:
                return QuoteCurrency(value, nullable);
            default:
                return "NULL";
        }
    }

    public static string DbCompare(DbDataTypes dtype, object? value, bool nullStr = false)
    {
        switch (dtype)
        {
            case DbDataTypes.Date:
                return CompareDate(value, SQLDATEFORMAT);
            case DbDataTypes.Time:
                return CompareDate(value, SQLTIMEFORMAT);
            case DbDataTypes.Str:
                var s = $"'{EscapeQuotes(value)}'";
                return s == "''" && !nullStr ? " IS NULL" : "=" + s;
            case DbDataTypes.Num:
                return "=" + NormalizeNumeric(value);
            default:
                return "=" + NormalizeNumeric(value);
        }
    }

    public static string LoadDSNs(ICollection<string>? comboBox = null, string initialDsn = "", string driver = "")
    {
        var list = new List<string>();
        if (RegEnumKeys(RegistryHiveConstants.HKEY_LOCAL_MACHINE,
                @"SOFTWARE\ODBC\ODBC.INI\ODBC Data Sources", out var keys))
        {
            foreach (var key in keys)
            {
                if (string.IsNullOrWhiteSpace(key)) continue;
                var buff = RegGetKey(RegistryHiveConstants.HKEY_LOCAL_MACHINE,
                    @"SOFTWARE\ODBC\ODBC.INI\ODBC Data Sources", key);
                if (!string.IsNullOrWhiteSpace(driver) &&
                    (buff == null || !buff.Contains(driver, StringComparison.OrdinalIgnoreCase)))
                {
                    continue;
                }

                list.Add(key);
                comboBox?.Add(key);
            }
        }

        return string.Join("|", list);
    }

    public static string ShowConnectionProperties(DbConnection? connection, string title)
    {
        var sb = new StringBuilder();
        if (connection?.State == ConnectionState.Open)
        {
            sb.AppendLine($"Connection: {title}");
            sb.AppendLine();
            sb.AppendLine($"Data Source: {connection.DataSource}");
            sb.AppendLine($"Database: {connection.Database}");
            sb.AppendLine($"Server Version: {connection.ServerVersion}");
            sb.AppendLine($"Connection String: {connection.ConnectionString}");
        }
        else
        {
            sb.AppendLine($"Connection: {title}");
            sb.AppendLine();
            sb.AppendLine("DSN: (no connection)");
            sb.AppendLine("DBMS:");
            sb.AppendLine("Driver:");
            sb.AppendLine("Provider:");
        }

        var message = sb.ToString();
        Console.WriteLine(message);
        return message;
    }

    public static string GetDrivers()
    {
        var drivers = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (RegEnumKeys(RegistryHiveConstants.HKEY_LOCAL_MACHINE,
                @"SOFTWARE\ODBC\ODBC.INI\ODBC Data Sources", out var keys))
        {
            foreach (var key in keys)
            {
                var d = RegGetKey(RegistryHiveConstants.HKEY_LOCAL_MACHINE,
                    @"SOFTWARE\ODBC\ODBC.INI\ODBC Data Sources", key);

                if (string.IsNullOrWhiteSpace(d)) continue;

                if (d == "Pervasive ODBC Engine Interface") d = "Pervasive Engine";
                if (d == "Pervasive ODBC Client Interface") d = "Pervasive Client";

                drivers.Add(d);
            }
        }

        return string.Join('\x01', drivers);
    }

    public static string GetDSNs(string driver = "")
    {
        if (driver == "Pervasive Engine") driver = "Pervasive ODBC Engine Interface";
        if (driver == "Pervasive Client") driver = "Pervasive ODBC Client Interface";

        var entries = new List<string>();
        if (RegEnumKeys(RegistryHiveConstants.HKEY_LOCAL_MACHINE,
                @"SOFTWARE\ODBC\ODBC.INI\ODBC Data Sources", out var keys))
        {
            foreach (var key in keys)
            {
                var d = RegGetKey(RegistryHiveConstants.HKEY_LOCAL_MACHINE,
                    @"SOFTWARE\ODBC\ODBC.INI\ODBC Data Sources", key);
                if (string.IsNullOrWhiteSpace(d)) continue;
                if (d.Equals(driver, StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(driver))
                {
                    entries.Add($"{key}\x02dsn={key}");
                }
            }
        }

        return string.Join('\x01', entries);
    }

    public static string ConnectionString(string dsn, string user = "", string pswd = "")
    {
        return $"dsn={dsn};uid={user};pwd={pswd};";
    }

    public static double Round(double number, int decimalPlaces = 0)
    {
        return Math.Round(number, decimalPlaces, MidpointRounding.AwayFromZero);
    }

    public static int DecimalPlaces(decimal number)
    {
        number -= Math.Truncate(number);
        if (number == 0) return 0;
        var s = number.ToString(CultureInfo.InvariantCulture);
        var idx = s.IndexOf('.');
        return idx >= 0 ? s.Length - idx - 1 : 0;
    }

    public static decimal RoundToPrice(double number, double significance)
    {
        if (number == 0 || significance == 0) return (decimal)number;

        var sigKey = significance.ToString("0.################", CultureInfo.InvariantCulture)
            .Replace("0", "")
            .Replace(".", "");

        if (IsIn(sigKey, 1, 5, 25))
        {
            return (decimal)RoundTo(number, significance, RoundDirections.rdUpTo);
        }

        if (significance < 1)
        {
            var baseInt = Math.Floor(number);
            var value = baseInt + significance;
            if (value < number) value = baseInt + 1 + significance;
            return (decimal)value;
        }

        var sigInt = (long)Math.Round(significance);
        var sigStr = sigInt.ToString(CultureInfo.InvariantCulture);
        var numberInt = (long)Math.Floor(number);
        var numStr = Math.Abs(numberInt).ToString(CultureInfo.InvariantCulture);
        var prefixLen = Math.Max(0, numStr.Length - sigStr.Length);
        var prefix = prefixLen > 0 ? numStr[..prefixLen] : "0";
        var prefixVal = long.TryParse(prefix, out var p) ? p : 0;
        var candidate = prefixVal * (long)Math.Pow(10, sigStr.Length) + sigInt;
        if (candidate < numberInt)
        {
            candidate = (prefixVal + 1) * (long)Math.Pow(10, sigStr.Length) + sigInt;
        }

        return candidate;
    }

    public static double RoundTo(double number, double significance, RoundDirections direction = RoundDirections.rdUpTo)
    {
        if (significance == 0 || number == significance) return number;

        var quotient = number / significance;
        if (Math.Abs(quotient - Math.Round(quotient)) < 1e-12) return number;

        return direction switch
        {
            RoundDirections.rdNone => number,
            RoundDirections.rdDownTo => Math.Floor(quotient) * significance,
            RoundDirections.rdUpTo => Math.Ceiling(quotient) * significance,
            RoundDirections.rdClosest => Math.Round(quotient, MidpointRounding.AwayFromZero) * significance,
            _ => number
        };
    }

    public static string ConvertSql(string sql, string dbmsName)
    {
        if (string.IsNullOrWhiteSpace(sql) ||
            !string.Equals(dbmsName, "Microsoft SQL Server", StringComparison.OrdinalIgnoreCase))
        {
            return sql;
        }

        var pieces = sql.Split('\'');
        for (var i = 0; i < pieces.Length; i += 2)
        {
            var s = pieces[i];
            s = ReplaceIgnoreCase(s, "IFNULL", "ISNULL");
            s = ReplaceIgnoreCase(s, "CURDATE", "GETDATE");
            s = ReplaceIgnoreCase(s, "NOW()", "GETDATE()");
            s = ReplaceIgnoreCase(s, "LONGVARCHAR", "VARCHAR(8000)");
            s = ReplaceIgnoreCase(s, "DOUBLE", "DECIMAL");
            s = ReplaceIgnoreCase(s, " IDENTITY", " INTEGER IDENTITY");
            s = ReplaceIgnoreCase(s, " DATE", " DATETIME");
            s = ReplaceIgnoreCase(s, " DATETIMETIME", " DATETIME");
            s = ReplaceIgnoreCase(s, " TIMESTAMP", " DATETIME");
            s = ReplaceIgnoreCase(s, " TIME", " DATETIME");
            s = ReplaceIgnoreCase(s, "UCASE(", "UPPER(");
            s = ReplaceIgnoreCase(s, "LCASE(", "LOWER(");
            s = ReplaceIgnoreCase(s, "CURTIME(", "GETDATE(");
            s = ReplaceIgnoreCase(s, "CONVERT(", "CAST(");
            s = ReplaceIgnoreCase(s, ", SQL_VARCHAR)", " AS VARCHAR)");
            s = ReplaceIgnoreCase(s, ",SQL_VARCHAR)", " AS VARCHAR)");
            s = ReplaceIgnoreCase(s, ", SQL_INTEGER)", " AS INTEGER)");
            s = ReplaceIgnoreCase(s, ",SQL_INTEGER)", " AS INTEGER)");
            s = ReplaceIgnoreCase(s, " MODIFY ", " ALTER COLUMN ");
            s = ReplaceIgnoreCase(s, "CAST(VARCHAR", "CONVERT(VARCHAR");
            pieces[i] = s;
        }

        return string.Join("'", pieces);
    }

    public void DBPutFile(string rowReference, string fieldName, string fileName)
    {
        if (string.IsNullOrWhiteSpace(rowReference) || string.IsNullOrWhiteSpace(fieldName) || string.IsNullOrWhiteSpace(fileName))
        {
            return;
        }

        var (table, whereClause) = SplitRowReference(rowReference);
        if (string.IsNullOrWhiteSpace(table)) return;

        var data = File.ReadAllBytes(fileName);
        var sql = $"UPDATE {table} SET {fieldName}=@data";
        if (!string.IsNullOrWhiteSpace(whereClause))
        {
            sql += $" WHERE {whereClause}";
        }

        _db.ExecuteNonQuery(sql, new { data });
    }

    public void DBGetFile(string fileName, byte[]? data = null, string? rowReference = null, string? fieldName = null)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return;

        if (data == null && !string.IsNullOrWhiteSpace(rowReference) && !string.IsNullOrWhiteSpace(fieldName))
        {
            var (table, whereClause) = SplitRowReference(rowReference);
            if (string.IsNullOrWhiteSpace(table)) return;

            var sql = $"SELECT {fieldName} FROM {table}";
            if (!string.IsNullOrWhiteSpace(whereClause))
            {
                sql += $" WHERE {whereClause}";
            }

            var result = _db.SqlExec(sql);
            if (result.Rows.Count > 0)
            {
                var val = result.Rows[0][0];
                if (val is byte[] bytes)
                {
                    data = bytes;
                }
                else if (val is string s && !string.IsNullOrWhiteSpace(s))
                {
                    try { data = Convert.FromBase64String(s); } catch { }
                }
            }
        }

        if (data != null)
        {
            File.WriteAllBytes(fileName, data);
        }
    }

    public static DbDataTypes DbQuoteType(object? dataType)
    {
        return dataType switch
        {
            DbType.Byte or DbType.Int16 or DbType.Int32 or DbType.Int64 or DbType.SByte or DbType.UInt16 or DbType.UInt32 or DbType.UInt64
                => DbDataTypes.NumInt,
            DbType.Single or DbType.Double or DbType.Decimal or DbType.Currency
                => DbDataTypes.Num,
            DbType.Date
                => DbDataTypes.Date,
            DbType.Time
                => DbDataTypes.Time,
            DbType.DateTime or DbType.DateTime2 or DbType.DateTimeOffset
                => DbDataTypes.DateTime,
            DbType.Boolean
                => DbDataTypes.Bit,
            DbType.String or DbType.AnsiString or DbType.AnsiStringFixedLength or DbType.StringFixedLength
                => DbDataTypes.Str,
            SqlDbType.TinyInt or SqlDbType.SmallInt or SqlDbType.Int or SqlDbType.BigInt
                => DbDataTypes.NumInt,
            SqlDbType.Float or SqlDbType.Real or SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney
                => DbDataTypes.Num,
            SqlDbType.Date
                => DbDataTypes.Date,
            SqlDbType.Time
                => DbDataTypes.Time,
            SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime or SqlDbType.DateTimeOffset
                => DbDataTypes.DateTime,
            SqlDbType.Bit
                => DbDataTypes.Bit,
            SqlDbType.VarChar or SqlDbType.NVarChar or SqlDbType.Char or SqlDbType.NChar or SqlDbType.Text or SqlDbType.NText
                => DbDataTypes.Str,
            Type t when t == typeof(DateTime)
                => DbDataTypes.DateTime,
            Type t when t == typeof(bool)
                => DbDataTypes.Bit,
            Type t when t == typeof(string)
                => DbDataTypes.Str,
            Type t when t == typeof(int) || t == typeof(long) || t == typeof(short) || t == typeof(byte)
                => DbDataTypes.NumInt,
            Type t when t == typeof(decimal) || t == typeof(double) || t == typeof(float)
                => DbDataTypes.Num,
            _ => DbDataTypes.Str
        };
    }

    public static string ColumnDefinitionPretty(object? column)
    {
        return column switch
        {
            DataColumn dc => ColumnDefinitionPretty(dc),
            DbColumn dbc => ColumnDefinitionPretty(dbc),
            _ => ""
        };
    }

    private static string ColumnDefinitionPretty(DataColumn column)
    {
        var type = column.DataType;
        if (IsIntegerType(type)) return "Numeric (integer)";
        if (IsDecimalType(type)) return type == typeof(decimal) ? "Currency" : "Numeric (decimal)";
        if (type == typeof(DateTime)) return "Date & Time";
        if (type == typeof(string))
        {
            var len = column.MaxLength > 0 ? column.MaxLength : 0;
            return $"Text ({len} characters)";
        }

        if (type == typeof(bool)) return "Yes/No";
        return type.Name;
    }

    private static string ColumnDefinitionPretty(DbColumn column)
    {
        var type = column.DataType;
        if (type == null) return "";
        if (IsIntegerType(type)) return "Numeric (integer)";
        if (IsDecimalType(type)) return type == typeof(decimal) ? "Currency" : "Numeric (decimal)";
        if (type == typeof(DateTime)) return "Date & Time";
        if (type == typeof(string))
        {
            var len = column.ColumnSize ?? 0;
            return $"Text ({len} characters)";
        }

        if (type == typeof(bool)) return "Yes/No";
        return type.Name;
    }

    private static bool RegEnumKeys(RegistryHiveConstants hive, string subKey, out string[] keys)
    {
        keys = Array.Empty<string>();
        try
        {
            using var key = OpenRegistryKey(hive, subKey);
            if (key == null) return false;
            keys = key.GetValueNames();
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static string? RegGetKey(RegistryHiveConstants hive, string subKey, string valueName)
    {
        try
        {
            using var key = OpenRegistryKey(hive, subKey);
            return key?.GetValue(valueName)?.ToString();
        }
        catch
        {
            return null;
        }
    }

    private static RegistryKey? OpenRegistryKey(RegistryHiveConstants hive, string subKey)
    {
        RegistryKey? root = hive switch
        {
            RegistryHiveConstants.HKEY_CLASSES_ROOT => Registry.ClassesRoot,
            RegistryHiveConstants.HKEY_CURRENT_USER => Registry.CurrentUser,
            RegistryHiveConstants.HKEY_LOCAL_MACHINE => Registry.LocalMachine,
            RegistryHiveConstants.HKEY_USERS => Registry.Users,
            RegistryHiveConstants.HKEY_CURRENT_CONFIG => Registry.CurrentConfig,
            _ => Registry.LocalMachine
        };

        return root?.OpenSubKey(subKey);
    }

    private static string QuoteBit(object? value)
    {
        var s = Convert.ToString(value, CultureInfo.InvariantCulture)?.Trim() ?? "";
        var u = s.ToUpperInvariant();
        return u switch
        {
            "TRUE" => "1",
            "FALSE" => "0",
            "YES" => "1",
            "NO" => "0",
            "1" => "1",
            "0" => "0",
            "-1" => "1",
            "" => "0",
            _ => TryToBool(value) ? "1" : "0"
        };
    }

    private static string QuoteDate(object? value, string format)
    {
        if (IsNullOrEmpty(value)) return "NULL";
        if (!TryGetDateTime(value, out var dt)) return "NULL";
        return $"'{dt.ToString(format, CultureInfo.InvariantCulture)}'";
    }

    private static string QuoteString(object? value, bool nullable, bool trimStr, long length)
    {
        var s = Convert.ToString(value, CultureInfo.InvariantCulture) ?? "";
        if (trimStr) s = s.Trim();
        if (length > 0 && s.Length > length) s = s[..(int)length];
        s = $"'{s.Replace("'", "''")}'";
        return s == "''" && nullable ? "NULL" : s;
    }

    private static string QuoteXml(object? value, bool nullable, bool trimStr, long length)
    {
        var s = Convert.ToString(value, CultureInfo.InvariantCulture) ?? "";
        s = s.Replace("<?xml version=\"1.0\" encoding=\"UTF-8\"?>", "", StringComparison.OrdinalIgnoreCase);
        if (trimStr) s = s.Trim();
        if (length > 0 && s.Length > length) s = s[..(int)length];
        s = $"'{s.Replace("'", "''")}'";
        return s == "''" && nullable ? "NULL" : s;
    }

    private static string QuoteNumeric(object? value, bool nullable)
    {
        var str = Convert.ToString(value, CultureInfo.InvariantCulture) ?? "";
        if (nullable && string.IsNullOrWhiteSpace(str)) return "NULL";
        return NormalizeNumeric(value);
    }

    private static string QuoteCurrency(object? value, bool nullable)
    {
        var str = Convert.ToString(value, CultureInfo.InvariantCulture) ?? "";
        if (nullable && string.IsNullOrWhiteSpace(str)) return "NULL";
        if (!double.TryParse(str.Replace("%", "").Replace(",", "").Replace("$", ""),
                NumberStyles.Any, CultureInfo.InvariantCulture, out var num))
        {
            num = 0;
        }

        return Math.Round(num, 2, MidpointRounding.AwayFromZero).ToString("0.00", CultureInfo.InvariantCulture);
    }

    private static string CompareDate(object? value, string format)
    {
        if (IsNullOrEmpty(value)) return " IS NULL";
        if (!TryGetDateTime(value, out var dt)) return " IS NULL";
        return "=" + $"'{dt.ToString(format, CultureInfo.InvariantCulture)}'";
    }

    private static bool IsNullOrEmpty(object? value)
    {
        if (value == null || value == DBNull.Value) return true;
        if (value is string s) return string.IsNullOrWhiteSpace(s);
        if (value is int i) return i == 0;
        if (value is long l) return l == 0;
        if (value is double d) return Math.Abs(d) < double.Epsilon;
        if (value is decimal m) return m == 0;
        return false;
    }

    private static bool TryGetDateTime(object? value, out DateTime dt)
    {
        dt = default;
        if (value == null || value == DBNull.Value) return false;
        if (value is DateTime date)
        {
            dt = date;
            return true;
        }

        return DateTime.TryParse(Convert.ToString(value, CultureInfo.InvariantCulture), out dt);
    }

    private static string EscapeQuotes(object? value)
    {
        var s = Convert.ToString(value, CultureInfo.InvariantCulture) ?? "";
        return s.Replace("'", "''");
    }

    private static string NormalizeNumeric(object? value)
    {
        var s = Convert.ToString(value, CultureInfo.InvariantCulture) ?? "";
        s = s.Replace("%", "").Replace(",", "").Replace("$", "");
        if (double.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var num))
        {
            return num.ToString(CultureInfo.InvariantCulture);
        }

        return "0";
    }

    private static bool TryToBool(object? value)
    {
        if (value == null || value == DBNull.Value) return false;
        if (value is bool b) return b;
        if (value is int i) return i != 0;
        if (value is long l) return l != 0;
        if (bool.TryParse(value.ToString(), out var parsed)) return parsed;
        return false;
    }

    private static string ReplaceIgnoreCase(string input, string oldValue, string newValue)
    {
        if (string.IsNullOrEmpty(input) || string.IsNullOrEmpty(oldValue)) return input;
        return Regex.Replace(input, Regex.Escape(oldValue), newValue, RegexOptions.IgnoreCase);
    }

    private static (string Table, string WhereClause) SplitRowReference(string rowReference)
    {
        var parts = Regex.Split(rowReference, @"\s+where\s+", RegexOptions.IgnoreCase);
        if (parts.Length > 1)
        {
            return (parts[0].Trim(), parts[1].Trim());
        }

        return (rowReference.Trim(), "");
    }

    private static bool IsIn(string? value, params int[] options)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        if (!int.TryParse(value, out var parsed)) return false;
        return options.Contains(parsed);
    }

    private static bool IsIntegerType(Type type)
    {
        return type == typeof(byte) || type == typeof(short) || type == typeof(int) || type == typeof(long) ||
               type == typeof(sbyte) || type == typeof(ushort) || type == typeof(uint) || type == typeof(ulong);
    }

    private static bool IsDecimalType(Type type)
    {
        return type == typeof(float) || type == typeof(double) || type == typeof(decimal);
    }
}