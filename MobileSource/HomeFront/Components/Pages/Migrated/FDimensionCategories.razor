@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-06-12
   Source      : HFEst/Source/FDimensionCategories.frm (VB6)
   Changes     :
     - Full re-port to FlexKit GridControl (was raw <table>/<input>/<select>).
     - gCategories columns now driven dynamically by AppGridLayout
       (VB6 IniGetGrid(Me, gCategories)) — never hardcoded.
     - All SQL parameterized.
     - Shift+Delete on UOM grid wired (VB6 gUnits_KeyDown).
     - Confirm / delete dialogs now FlexKit DialogControl.
     - HHM-371: UOM column re-done as VB6 gUnits — trailing blank row hosts an
       EDITABLE combo (pick from list OR type a new UOM, ComboList
       LimitToList:=False), committed rows are read-only, duplicates rejected.
   ───────────────────────────────────────────────────────────────── *@
@page "/dimension-categories"
@using Fx.ControlKit.Mdi
@implements Fx.ControlKit.Mdi.IMdiCloseGuard
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using HomeFront.Models
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using Microsoft.AspNetCore.Components.Web

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FDimensionCategories> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject IUserPreferencesService Prefs
@inject DbWrapperSqlServer db

<PageTitle>Dimension Categories</PageTitle>

<div class="dim-cat-container">
    @* VB6 FDimensionCategories.frm has NO in-form header label — the "Dimension
       Categories" caption lives only in the MDI window title (Form Caption), so
       there is no in-screen <h4> here. *@

    @* Clear All button row (VB6 cmdClear — sits above the Rooms grid) *@
    <div class="toolbar-row">
        @* VB6 cmdClear Caption="Clear &All" (FDimensionCategories.frm:15) — the
           accelerator renders as an underlined mnemonic, not a literal ampersand. *@
        <ButtonControl CssClass="dim-btn-clear" OnClick="OnClearAllClick">Clear <u>A</u>ll</ButtonControl>
    </div>

    @* Main three-panel layout: Categories | UOM | Rooms *@
    <div class="main-panels" @onmousemove="OnSplitterDrag" @onmouseup="EndSplitterDrag" @onmouseleave="EndSplitterDrag">
        @* ── Categories grid (VB6 gCategories — dynamic columns) ── *@
        <div class="panel-categories" style="width:@(CategoriesPanelWidthPx)px;">
            <GridControl @ref="gCategories"
                         TValue="CategoryRow"
                         DataSource="@CategoriesData"
                         AllowSelection="true"
                         AutoSelectFirstRow="true"
                         AllowSorting="true"
                         AllowResizing="true"
                         AllowFiltering="false"
                         EnableHover="true"
                         Height="100%"
                         WidthMode="GridWidthMode.FitColumns"
                         SelectionSettingsRef="@categoriesSelectionSettings"
                         EventsRef="@categoriesGridEvents"
                         OnLayoutChanged="@OnCategoriesLayoutChangedAsync">
                @* VB6 gCategories ExtendLastCol=-1 True (FDimensionCategories.frm:189)
                   → FillAvailable so the table spans the panel and the last column
                   stretches (was FitColumns, which clipped Category with an ellipsis). *@
                <GridColumnsBase @key="CategoriesGridLayoutVersion" DebugTag="FDimensionCategories-gCategories">
                    @* VB6 ExtendLastCol=True: leave the last VISIBLE column width-free so
                       (with table-layout:fixed + FillAvailable) it absorbs the slack and
                       is not clipped. headerText restores the VB6 frx captions
                       ("Group"/"Category") that GridLayoutPresenter staticNames:true blanks. *@
                    @if (CategoriesGridLayout.Count > 0)
                    {
                        @* Pixel widths, so a column drag sticks and widens the panel. A
                           percentage would be recomputed on re-render and snap back. *@
                        var ordered = GetOrderedGridLayout(CategoriesGridLayout).ToList();
                        var lastVisible = ordered.LastOrDefault(c => !c.Hidden);
                        @foreach (var col in ordered)
                        {
                            var field = ResolveCategoryField(col.Field);
                            var headerText = string.IsNullOrWhiteSpace(col.Caption)
                                ? ResolveCategoryHeader(col.Field) : col.Caption;
                            var width = col.Width.HasValue && col.Width.Value > 0
                                ? $"{GridLayoutPresenter.WidthPx(col.Width.Value)}px" : null;
                            @* VB6 ExtendLastCol: the last column runs to the panel edge,
                               so it has no grip of its own. *@
                            var isLast = ReferenceEquals(col, lastVisible);
                            <GridColumn Field="@field" HeaderText="@headerText" Width="@width"
                                           AllowEditing="false" Visible="@(!col.Hidden)"
                                           AllowResizing="@(!isLast)" />
                        }
                    }
                    else
                    {
                        @* Fallback when AppGridLayout has no rows for this grid —
                           surfaced in the page title so a misconfigured grid is visible. *@
                        <GridColumn Field="@nameof(CategoryRow.Category)" HeaderText="Category" Visible="false" AllowEditing="false" />
                        <GridColumn Field="@nameof(CategoryRow.GroupDescription)" HeaderText="Group" Width="35%" AllowEditing="false" />
                        <GridColumn Field="@nameof(CategoryRow.CategoryDescription)" HeaderText="Category" Width="65%" AllowEditing="false" />
                    }
                </GridColumnsBase>
            </GridControl>
        </div>

        @* ── UOM grid (VB6 gUnits — static, free-text combo, last row = new) ── *@
        @* VB6 Slider between gCategories and gUnits. *@
        <div class="dim-splitter @(_dragging == 1 ? "dragging" : "")"
             @onmousedown="@(e => StartSplitterDrag(1, e))" @onmousedown:preventDefault="true"></div>

        <div class="panel-units" style="width:@(_unitsPanelPx)px;" @onkeydown="OnUnitsKeyDown">
            <GridControl @ref="gUnits"
                         TValue="UnitRow"
                         DataSource="@UnitsData"
                         AllowSelection="true"
                         AllowSorting="true"
                         AllowResizing="false"
                         AllowFiltering="false"
                         EnableHover="true"
                         Height="100%"
                         WidthMode="GridWidthMode.FillAvailable"
                         SelectionSettingsRef="@unitsSelectionSettings"
                         EditSettingsRef="@unitsEditSettings"
                         EventsRef="@unitsGridEvents">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(UnitRow.UOM)"
                                HeaderText="UOM"
                                Width="100%"
                                AllowEditing="true"
                                EditOptions="@UomComboList"
                                AllowCustomEditOptionValue="true"
                                OpenEditOptionsOnEdit="true" />
                </GridColumnsBase>
            </GridControl>
        </div>

        @* ── Rooms grid (VB6 gRooms — static, checkbox + room) ── *@
        @* VB6 Slider between gUnits and gRooms. *@
        <div class="dim-splitter @(_dragging == 2 ? "dragging" : "")"
             @onmousedown="@(e => StartSplitterDrag(2, e))" @onmousedown:preventDefault="true"></div>

        <div class="panel-rooms">
            <GridControl @ref="gRooms"
                         TValue="RoomRow"
                         DataSource="@RoomsData"
                         AllowSelection="true"
                         SelectionSettingsRef="@roomsSelectionSettings"
                         AllowSorting="true"
                         AllowResizing="false"
                         AllowFiltering="false"
                         EnableHover="true"
                         Height="100%"
                         WidthMode="GridWidthMode.FillAvailable">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(RoomRow.RoomID)" HeaderText="RoomID" Visible="false" AllowEditing="false" />
                    @* VB6 gRooms is a SINGLE "Room" column (frx (Text)="\tRoom\t") with
                       the checkbox placed IN the cell via .Cell(flexcpChecked, r,
                       .ColIndex("room")) (FDimensionCategories.frm:579) — checkbox
                       immediately followed by the room text, not a separate column. *@
                    <GridColumn Field="@nameof(RoomRow.Room)" HeaderText="Room" Width="100%" AllowEditing="false">
                        <Template>
                            @{
                                var room = (RoomRow)context;
                            }
                            <span class="dim-room-cell">
                                <CheckBoxControl Checked="@room.Selected"
                                                 Disabled="@(!CanEditRooms)"
                                                 CheckedChanged="v => OnRoomCheckedChanged(room, v)"
                                                 StopClickPropagation="true" />
                                @room.Room
                            </span>
                        </Template>
                    </GridColumn>
                </GridColumnsBase>
            </GridControl>
        </div>
    </div>

    @* Footer buttons (VB6 cmdNav) — Captions "&Save"/"&Close"
       (FDimensionCategories.frm:24,33) render as underlined mnemonics. *@
    <div class="footer-row">
        <ButtonControl CssClass="dim-btn-nav" Disabled="@(!mDirty)" OnClick="OnSaveClick"><u>S</u>ave</ButtonControl>
        <ButtonControl CssClass="dim-btn-nav" OnClick="OnCloseClick"><u>C</u>lose</ButtonControl>
    </div>
</div>

@* HHM-373: VB6 MsgBox chrome — shared MessageBoxControl (grey VB6 look, warning /
   question icons, title = App.ProductName "Precision Builder") replaces the two
   hand-built DialogControls. *@
<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />

@code {
    // ── Panel splitters (VB6 Slider between the three grids) ────────────
    // The grids fill their panel (FillAvailable + percentage columns), so moving
    // a splitter resizes the panel and its columns scale with it, with no gap
    // opening between the last column and the divider.
    // VB6 Slider(0).Min = 1800 twips (FDimensionCategories.frm:429) = 120 px.
    private const int DimPanelMinPx = 120;
    private const int DimColumnMinPx = 44;
    private const int DimPanelChromePx = 2;

    // gUnits / gRooms have no AppGridLayout rows (and the layout service never
    // INSERTs), so their panel sizes live in the per-user preferences store.
    private const string PrefsSection = "FDimensionCategories";
    private int _categoriesPanelPx = 560;
    private int _unitsPanelPx = 220;
    private int _dragging;              // 0 none, 1 categories|units, 2 units|rooms
    private double _dragStartX;
    private int _dragStartWidth;

    // The splitter sets the panel's MAXIMUM width; the panel then shrinks to hug its
    // columns so no white space opens between the last column and the divider.
    // Widening a column past the splitter does not push it — the grid scrolls.
    private int CategoriesPanelWidthPx
    {
        get
        {
            var slider = Math.Max(_categoriesPanelPx, DimPanelMinPx);
            var columns = CategoriesColumnsPx;
            if (columns <= 0) return slider;
            return Math.Max(Math.Min(slider, columns + DimPanelChromePx), DimPanelMinPx);
        }
    }

    private int CategoriesColumnsPx => CategoriesGridLayout.Count == 0
        ? 0
        : GetOrderedGridLayout(CategoriesGridLayout)
            .Where(c => !c.Hidden && c.Width.HasValue && c.Width.Value > 0)
            .Sum(c => GridLayoutPresenter.WidthPx(c.Width!.Value));

    private void StartSplitterDrag(int which, MouseEventArgs e)
    {
        _dragging = which;
        _dragStartX = e.ClientX;
        _dragStartWidth = which == 1 ? CategoriesPanelWidthPx : _unitsPanelPx;
    }

    private void OnSplitterDrag(MouseEventArgs e)
    {
        if (_dragging == 0) return;
        if ((e.Buttons & 1) == 0) { EndSplitterDrag(); return; }

        var target = _dragStartWidth + (int)(e.ClientX - _dragStartX);
        if (target < DimPanelMinPx) target = DimPanelMinPx;
        if (_dragging == 1)
        {
            _categoriesPanelPx = target;
            ScaleCategoriesColumnsTo(target - DimPanelChromePx);
        }
        else _unitsPanelPx = target;
    }

    private void ScaleCategoriesColumnsTo(int contentPx)
    {
        var visible = GetOrderedGridLayout(CategoriesGridLayout)
            .Where(c => !c.Hidden && c.Width.HasValue && c.Width.Value > 0).ToList();
        if (visible.Count == 0) return;
        var current = visible.Sum(c => GridLayoutPresenter.WidthPx(c.Width!.Value));
        if (current <= 0) return;
        var floor = visible.Count * DimColumnMinPx;
        if (contentPx < floor) contentPx = floor;
        var factor = (double)contentPx / current;
        if (Math.Abs(factor - 1d) < 0.005) return;
        foreach (var col in visible)
        {
            var px = Math.Max(DimColumnMinPx,
                (int)Math.Round(GridLayoutPresenter.WidthPx(col.Width!.Value) * factor));
            col.Width = GridLayoutPersister.PixelsToLayoutWidth(px);
        }
        _grid.BumpVersion();
    }

    private void EndSplitterDrag()
    {
        if (_dragging == 0) return;
        var wasCategories = _dragging == 1;
        _dragging = 0;
        if (wasCategories)
        {
            Prefs.Put(PrefsSection, "CategoriesPanelPx", _categoriesPanelPx.ToString());
            _ = PersistCategoriesWidthsAsync();
        }
        else Prefs.Put(PrefsSection, "UnitsPanelPx", _unitsPanelPx.ToString());
    }

    private bool LoadPanelPrefs()
    {
        var hasCategories = int.TryParse(Prefs.Get(PrefsSection, "CategoriesPanelPx"), out var cats)
                            && cats >= DimPanelMinPx;
        if (hasCategories) _categoriesPanelPx = cats;
        if (int.TryParse(Prefs.Get(PrefsSection, "UnitsPanelPx"), out var units) && units >= DimPanelMinPx)
            _unitsPanelPx = units;
        return hasCategories;
    }

    private Task PersistCategoriesWidthsAsync() =>
        PersistGridLayoutAsync("gCategories", CategoriesGridLayout, new GridSettings
        {
            Widths = GetOrderedGridLayout(CategoriesGridLayout)
                .Where(c => !c.Hidden && c.Width.HasValue && c.Width.Value > 0)
                .ToDictionary(c => ResolveCategoryField(c.Field),
                              c => (double)GridLayoutPresenter.WidthPx(c.Width!.Value))
        }, _grid);

    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            NavigationManager.NavigateTo("/main");
    }

    // === Constants ===
    private const string SRCFILE = "FDimensionCategories::";

    // === State ===
    private bool mDirty = false;
    private string mCategory = "";
    private string mUOM = "";

    // re-entrancy guards mirroring VB6 Static inHere flags in the
    // BeforeSelChange handlers (prevent recursive save→reselect loops).
    private bool _inCategorySel = false;
    private bool _inUnitSel = false;

    // === Grid refs ===
    private GridControl<CategoryRow>? gCategories;
    private GridControl<UnitRow>? gUnits;
    private GridControl<RoomRow>? gRooms;

    // === Grid layout (VB6 IniGetGrid for gCategories only) ===
    // Load + width conversion delegated to the shared GridLayoutPresenter (the
    // VB6 form/grid names + staticNames flag stay here for fidelity). NOTE: this
    // form keeps its own GetOrderedGridLayout / ResolveCategoryField (they
    // intentionally diverge from the presenter — see the drift notes there).
    private readonly GridLayoutPresenter<CategoryRow> _grid =
        new("FDimensionCategories", "gCategories", staticNames: true);
    private Dictionary<string, GridLayoutColumn> CategoriesGridLayout => _grid.Layout;
    private int CategoriesGridLayoutVersion => _grid.Version;

    // === Selection / edit settings ===
    private SelectionSettings categoriesSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row,
        EnableToggle = false
    };

    private SelectionSettings unitsSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row,
        EnableToggle = false
    };

    // HHM-726: CELL selection, so the Rooms list gets a keyboard cursor without a
    // row highlight. Arrow navigation in GridControl is gated on AllowSelection, so
    // the grid cannot stay AllowSelection="false" and still be arrow-navigable.
    private SelectionSettings roomsSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Cell,
        EnableToggle = false
    };

    private EditSettings unitsEditSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch
    };

    private GridControlEvents<CategoryRow> categoriesGridEvents = new();
    private GridControlEvents<UnitRow> unitsGridEvents = new();

    // === Dialog state ===
    private Fx.ControlKit.Dialogs.MessageBoxControl? _messageBox;
    // HHM-372: deferred UOM row highlight — set by LoadUnits (row 0) and by
    // OnUnitCellSave (the just-committed row), consumed in OnAfterRender
    // AFTER the grid captures the new datasource signature (a synchronous
    // SelectRow would be wiped by ClearSelectionIfDataSourceChanged).
    private int? _pendingUnitSelectIndex;
    // === Data ===
    private List<CategoryRow> CategoriesData = new();
    private List<UnitRow> UnitsData = new();
    private List<RoomRow> RoomsData = new();
    private List<string> UomComboList = new();

    // === Selection indices ===
    private int SelectedCategoryIndex = -1;
    private int SelectedUnitIndex = -1;

    // Rooms checkboxes are editable only when a real (non-blank, non-last) UOM
    // row is selected — VB6 gRooms_BeforeEdit: Cancel = UOM="" Or .Row < 1.
    private bool CanEditRooms =>
        !string.IsNullOrEmpty(mUOM) &&
        SelectedUnitIndex >= 0 &&
        SelectedUnitIndex < UnitsData.Count - 1;

    // === Models ===
    public class CategoryRow
    {
        public string Category { get; set; } = "";
        public string GroupDescription { get; set; } = "";
        public string CategoryDescription { get; set; } = "";
    }

    public class UnitRow
    {
        public string UOM { get; set; } = "";
    }

    public class RoomRow
    {
        public string RoomID { get; set; } = "";
        public string Room { get; set; } = "";
        public bool Selected { get; set; }
    }

    // === Dirty (VB6 Property Let Dirty — also toggles Save button enabled) ===
    private void SetDirty(bool value) => mDirty = value;

    // === Lifecycle ===
    protected override void OnInitialized()
    {
        categoriesGridEvents.RowSelected =
            EventCallback.Factory.Create<RowSelectEventArgs<CategoryRow>>(this, OnCategoryRowSelected);
        unitsGridEvents.RowSelected =
            EventCallback.Factory.Create<RowSelectEventArgs<UnitRow>>(this, OnUnitRowSelected);
        unitsGridEvents.OnCellEdit =
            EventCallback.Factory.Create<CellEditArgs<UnitRow>>(this, OnUnitCellEdit);
        unitsGridEvents.OnCellSave =
            EventCallback.Factory.Create<CellSaveArgs<UnitRow>>(this, OnUnitCellSave);
    }

    protected override async Task OnInitializedAsync()
    {
        var hasPanelPref = LoadPanelPrefs();
        await LoadGridLayout();      // VB6 IniGetGrid(Me, gCategories)

        // First open on this machine: start the panel at the saved column widths so
        // the grid neither leaves a gap nor scrolls until the user moves the splitter.
        if (!hasPanelPref)
        {
            var cols = CategoriesColumnsPx;
            if (cols > 0) _categoriesPanelPx = Math.Max(cols + DimPanelChromePx, DimPanelMinPx);
        }

        await LoadUomComboList();    // gUnits.ComboList
        await LoadCategories();      // VB6 LoadCategories
        await LoadRooms("");         // VB6 LoadRooms("")

        // VB6 Form_Load sets gCategories.Row = 1 → fires BeforeSelChange →
        // LoadUnits for the first category.
        if (CategoriesData.Count > 0)
        {
            SelectedCategoryIndex = 0;
            await LoadUnits(CategoriesData[0].Category);
        }
    }

    // === Grid layout (VB6 IniGetGrid(Me, gCategories)) ===
    private async Task LoadGridLayout()
    {
        try
        {
            // staticNames:true → keep the AppGridLayout colkey as the field name;
            // captions/widths/hidden flags all come from the saved layout.
            await _grid.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{SRCFILE}LoadGridLayout error", SRCFILE);
        }
    }

    // === Grid layout persistence (VB6 IniPutGrid) ===
    // GridControl raises OnLayoutChanged once a resize/reorder/hide/rename finishes.
    // The new widths live on the snapshot, not in the presenter's layout dict, so
    // they have to be merged in before the save. The snapshot keys are the RESOLVED
    // column fields, hence ResolveCategoryField as the resolver.
    private Task OnCategoriesLayoutChangedAsync(GridSettings snapshot) =>
        PersistGridLayoutAsync("gCategories", CategoriesGridLayout, snapshot, _grid);

    private async Task PersistGridLayoutAsync<T>(string gridName,
        IDictionary<string, GridLayoutColumn> layout, GridSettings snapshot,
        GridLayoutPresenter<T> presenter)
    {
        if (snapshot == null || layout.Count == 0) return;
        try
        {
            // staticNames:true matches how the presenter loaded — see the helper
            // for why that matters to the stored captions.
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FDimensionCategories", gridName, instanceKey: null,
                layout, snapshot, layoutFieldResolver: ResolveCategoryField, staticNames: true);

            presenter.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{SRCFILE}Failed to persist {Grid} layout", SRCFILE, gridName);
        }
    }

    // DRIFT (intentional — left un-delegated): unlike the presenter's GetOrdered(),
    // this takes the layout dict as a parameter and does NOT filter Hidden columns —
    // the markup emits every column and sets Visible="@(!col.Hidden)" per column, so
    // hidden columns must still be rendered (invisible). Returns the raw layout
    // columns, not the presenter's 4-tuple.
    private IEnumerable<GridLayoutColumn> GetOrderedGridLayout(Dictionary<string, GridLayoutColumn> layout)
    {
        return layout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field))
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase);
    }

    // DRIFT (intentional — left un-delegated): exact (case-insensitive) match only,
    // then literal. The presenter's ResolveField also tries a normalized-alnum step
    // and aliases; here staticNames:true keeps the colkey as the field name so the
    // exact match is the intended path. Map an AppGridLayout colkey ("category",
    // "GroupDescription", "CategoryDescription") to the CategoryRow property name.
    private static string ResolveCategoryField(string layoutField)
    {
        if (string.IsNullOrWhiteSpace(layoutField)) return "";
        var trimmed = layoutField.Trim();
        var prop = typeof(CategoryRow).GetProperty(trimmed,
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
        return prop?.Name ?? trimmed;
    }

    // VB6 FDimensionCategories.frx gCategories (Text)="\tGroup\tCategory\t":
    // GroupDescription -> "Group", CategoryDescription -> "Category" (the "category"
    // key column is hidden). GridLayoutPresenter staticNames:true forces Caption="",
    // so map the AppGridLayout colkey back to the VB6 frx header text here — this
    // keeps order/width/hidden AppGridLayout-driven while restoring the lost captions.
    private static string ResolveCategoryHeader(string layoutField)
    {
        var trimmed = (layoutField ?? "").Trim();
        return trimmed.ToLowerInvariant() switch
        {
            "groupdescription" => "Group",
            "categorydescription" => "Category",
            _ => trimmed
        };
    }

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // === GetComboList (VB6 GetComboList) ===
    private async Task LoadUomComboList()
    {
        try
        {
            // VB6: SELECT DISTINCT ISNULL(AssemblyUOM,''),'',0 ... LimitToList=False.
            // The 2nd/3rd VB6 columns were combo display/data placeholders; we only
            // need the distinct UOM strings here.
            var sql = @"SELECT DISTINCT LTRIM(RTRIM(ISNULL(AssemblyUOM,''))) AS UOM
                        FROM tblDBAssemblyMaster
                        WHERE ISNULL(AssemblyUOM,'')<>'' AND divisionid=@DivisionID
                        ORDER BY UOM";
            var rows = await db.QueryAsync(sql, new { DivisionID = SessionState.DivisionID });
            UomComboList = rows
                .Select(r => r["UOM"]?.ToString()?.Trim() ?? "")
                .Where(s => !string.IsNullOrEmpty(s))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{SRCFILE}LoadUomComboList error", SRCFILE);
        }
    }

    // === Load Categories (VB6 LoadCategories) ===
    private async Task LoadCategories()
    {
        try
        {
            CategoriesData.Clear();
            var sql = @"select c.Category, g.description GroupDescription, c.Description CategoryDescription
                        from tblMajorGroups g
                        join tblCategories c on g.major_group = c.group_code
                        order by g.description, c.description";
            var rows = await db.QueryAsync(sql);
            foreach (var row in rows)
            {
                CategoriesData.Add(new CategoryRow
                {
                    Category = row["Category"]?.ToString() ?? "",
                    GroupDescription = row["GroupDescription"]?.ToString() ?? "",
                    CategoryDescription = row["CategoryDescription"]?.ToString() ?? ""
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{SRCFILE}LoadCategories error", SRCFILE);
        }
    }

    // === Load Units (VB6 LoadUnits) ===
    private async Task LoadUnits(string category)
    {
        mCategory = category;
        UnitsData.Clear();

        try
        {
            var sql = @"select distinct c.uom
                        from RoomMaster r
                        join RoomMasterSubCategory c on r.roomid = c.roomid and c.subcategory = @Category
                        where isnull(r.inactive, 0) = 0 and r.divisionid = @DivisionID
                        order by c.uom";
            var rows = await db.QueryAsync(sql, new { Category = mCategory ?? "", DivisionID = SessionState.DivisionID });
            foreach (var row in rows)
            {
                UnitsData.Add(new UnitRow { UOM = row["uom"]?.ToString() ?? "" });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{SRCFILE}LoadUnits error", SRCFILE);
        }

        // VB6: If .Rows < 2 And gRooms.Rows > 1 Then uncheck every room.
        if (UnitsData.Count == 0 && RoomsData.Count > 0)
        {
            foreach (var room in RoomsData)
                room.Selected = false;
        }

        // VB6: always append a trailing blank row for new-UOM entry.
        UnitsData.Add(new UnitRow { UOM = "" });

        // VB6: If .Rows > 1 Then .Row = 1 → first real UOM gets selected and its
        // rooms load. Otherwise only the blank row exists (UOM = "").
        if (UnitsData.Count > 1)
        {
            SelectedUnitIndex = 0;
            await LoadRooms(UnitsData[0].UOM);
        }
        else
        {
            SelectedUnitIndex = UnitsData.Count - 1;
            mUOM = "";
            await LoadRooms("");
        }

        // HHM-372: VB6 LoadUOMs highlights row 1 only when a real UOM exists
        // (frm:539 .Rows>1 check runs before the trailing blank AddItem).
        _pendingUnitSelectIndex = UnitsData.Count > 1 ? 0 : null;
        SetDirty(false);
    }

    // === Load Rooms (VB6 LoadRooms) ===
    private async Task LoadRooms(string uom)
    {
        mUOM = uom;
        RoomsData.Clear();

        try
        {
            var sql = @"select r.roomid, r.room,
                          cast(case when c.roomid is null then 0 else 1 end as bit) selected
                        from RoomMaster r
                        left outer join RoomMasterSubCategory c on r.roomid = c.roomid
                                                                and c.subcategory = @Category
                                                                and c.uom = @UOM
                        where isnull(r.inactive, 0) = 0 and r.divisionid = @DivisionID
                        order by r.Room";
            var rows = await db.QueryAsync(sql,
                new { Category = mCategory ?? "", UOM = mUOM ?? "", DivisionID = SessionState.DivisionID });
            foreach (var row in rows)
            {
                RoomsData.Add(new RoomRow
                {
                    RoomID = row["roomid"]?.ToString() ?? "",
                    Room = row["room"]?.ToString() ?? "",
                    Selected = Convert.ToBoolean(row["selected"])
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{SRCFILE}LoadRooms error", SRCFILE);
        }

        SetDirty(false);
    }

    // === Category row selection (VB6 gCategories_BeforeSelChange) ===
    private async Task OnCategoryRowSelected(RowSelectEventArgs<CategoryRow> args)
    {
        if (_inCategorySel) return;
        _inCategorySel = true;
        try
        {
            if (CategoriesData.Count == 0) return;

            // RowIndex is the VIEW index; once a header sort is applied it no longer
            // matches CategoriesData. Every consumer of SelectedCategoryIndex indexes
            // the backing list, so resolve through the row object.
            var newIndex = ResolveDataIndex(CategoriesData, args.Data, args.RowIndex);
            if (newIndex == SelectedCategoryIndex) return;

            // VB6: If OldRowSel > 0 Then Cancel = Not SaveData(False)
            if (SelectedCategoryIndex > 0 && mDirty)
            {
                var ok = await SaveData(false);
                if (!ok)
                {
                    // VB6 cancels the selection change; restore prior selection.
                    if (gCategories != null && SelectedCategoryIndex >= 0 && SelectedCategoryIndex < CategoriesData.Count)
                        gCategories.SelectRow(SelectedCategoryIndex);
                    return;
                }
            }

            SelectedCategoryIndex = newIndex;
            mCategory = "";
            mUOM = "";

            if (newIndex >= 0 && newIndex < CategoriesData.Count)
                await LoadUnits(CategoriesData[newIndex].Category);
        }
        finally
        {
            _inCategorySel = false;
        }
    }

    // === Unit row selection (VB6 gUnits_BeforeSelChange) ===
    private async Task OnUnitRowSelected(RowSelectEventArgs<UnitRow> args)
    {
        if (_inUnitSel) return;
        _inUnitSel = true;
        try
        {
            if (UnitsData.Count == 0) return;

            var newIndex = ResolveDataIndex(UnitsData, args.Data, args.RowIndex);
            if (newIndex == SelectedUnitIndex) return;

            // VB6: If OldRowSel > 0 Then Cancel = Not SaveData(False)
            if (SelectedUnitIndex > 0 && mDirty)
            {
                var ok = await SaveData(false);
                if (!ok)
                {
                    if (gUnits != null && SelectedUnitIndex >= 0 && SelectedUnitIndex < UnitsData.Count)
                        gUnits.SelectRow(SelectedUnitIndex);
                    return;
                }
            }

            SelectedUnitIndex = newIndex;
            if (newIndex >= 0 && newIndex < UnitsData.Count)
                await LoadRooms(UnitsData[newIndex].UOM);
        }
        finally
        {
            _inUnitSel = false;
        }
    }

    // HHM-726 (owner call): the form opens with the Rooms list ready for the
    // keyboard, so Down-arrow walks the rooms straight away. Cell selection only —
    // gRooms deliberately has no row cursor (AllowSelection stays false).
    // Re-applied for a few renders: the Categories grid settles after this one and
    // takes focus back, so a single attempt loses the race.
    private int _roomsFocusAttempts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (gRooms == null || RoomsData.Count == 0 || _roomsFocusAttempts >= 3)
            return;

        _roomsFocusAttempts++;
        try
        {
            await gRooms.SelectCellAsync((0, 0));
            await gRooms.FocusGridAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{SRCFILE}Rooms initial focus", SRCFILE);
        }
    }

    private static int ResolveDataIndex<T>(List<T> data, T? row, int fallback) where T : class
    {
        if (row != null)
        {
            var i = data.IndexOf(row);
            if (i >= 0) return i;
        }
        return fallback;
    }

    // === Unit edit gate (VB6 gUnits_BeforeEdit: only last row editable) ===
    private void OnUnitCellEdit(CellEditArgs<UnitRow> args)
    {
        if (args.Data == null || UnitsData.Count == 0 || !ReferenceEquals(args.Data, UnitsData[^1]))
            args.Cancel = true;
    }

    // === Unit cell save (VB6 gUnits_ValidateEdit + gUnits_AfterEdit) ===
    private async Task OnUnitCellSave(CellSaveArgs<UnitRow> args)
    {
        var newUom = args.Value?.ToString()?.Trim() ?? "";

        // VB6 gUnits_AfterEdit: blank entry on the new row → no-op.
        if (string.IsNullOrEmpty(newUom))
        {
            args.Data.UOM = "";
            return;
        }

        // VB6 gUnits_BeforeSelChange fired when the user moved into the blank
        // row: pending room edits for the previous UOM are saved first
        // (SaveData(False)); a failed save cancels the move — here it cancels
        // the new entry.
        if (mDirty)
        {
            var saved = await SaveData(false);
            if (!saved)
            {
                args.Data.UOM = "";
                return;
            }
        }

        // VB6 gUnits_ValidateEdit: reject a duplicate of an existing UOM
        // (rows 1 .. Rows-2, Option Compare Text → case-insensitive).
        for (int i = 0; i < UnitsData.Count - 1; i++)
        {
            if (string.Equals(UnitsData[i].UOM, newUom, StringComparison.OrdinalIgnoreCase))
            {
                args.Data.UOM = "";
                Notifications.Info("This UOM already exists for this category.");
                return;
            }
        }

        // VB6 gUnits_AfterEdit: commit on the last row → the blank row becomes
        // the new UOM, append a fresh blank row, set mUOM, mark dirty.
        var idx = UnitsData.IndexOf(args.Data);
        if (idx != UnitsData.Count - 1)
            return;

        args.Data.UOM = newUom;
        UnitsData.Add(new UnitRow { UOM = "" });
        SelectedUnitIndex = idx;
        mUOM = newUom;

        // Rooms grid becomes editable for the new UOM (nothing pre-checked —
        // the UOM has no saved rows yet). LoadRooms resets the dirty flag, so
        // set it afterwards — VB6 gUnits_AfterEdit leaves Dirty = True.
        await LoadRooms(newUom);
        SetDirty(true);

        // Highlight the committed row (deferred — see _pendingUnitSelectIndex).
        _pendingUnitSelectIndex = idx;
    }

    // === Room checkbox changed (VB6 gRooms_ValidateEdit → Dirty = True) ===
    private void OnRoomCheckedChanged(RoomRow room, bool value)
    {
        if (!CanEditRooms) return;          // mirror gRooms_BeforeEdit guard
        room.Selected = value;
        SetDirty(true);
    }

    // === Shift+Delete on UOM grid (VB6 gUnits_KeyDown) ===
    private async Task OnUnitsKeyDown(KeyboardEventArgs e)
    {
        // VB6: If Not (KeyCode = vbKeyDelete And Shift <> 0) Then Exit Sub
        if (e.Key != "Delete" || !(e.ShiftKey || e.CtrlKey || e.AltKey)) return;
        if (SelectedUnitIndex < 0 || SelectedUnitIndex >= UnitsData.Count - 1) return; // not a real UOM row
        // HHM-373: VB6 frm:687 MsgBox vbQuestion + vbYesNo, App.ProductName.
        if (_messageBox == null) return;
        var r = await _messageBox.ShowAsync(
            "Are you sure you want to delete this UOM from this category?",
            title: "Precision Builder",
            buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNo,
            icon: "question");
        if (r == Fx.ControlKit.Dialogs.MessageBoxResult.Yes)
            await OnDeleteUomConfirmed();
    }

    private async Task OnDeleteUomConfirmed()
    {

        if (SelectedUnitIndex < 0 || SelectedUnitIndex >= UnitsData.Count - 1) return;

        try
        {
            // VB6: delete RoomMasterSubCategory where Subcategory=mCategory and uom=mUOM
            var sql = "delete RoomMasterSubCategory where Subcategory = @Category and uom = @UOM";
            await db.ExecuteAsync(sql, new { Category = mCategory ?? "", UOM = mUOM ?? "" });

            // VB6: mUOM = "" : .RemoveItem(.Row) : gUnits.Row = 0
            mUOM = "";
            UnitsData.RemoveAt(SelectedUnitIndex);

            SelectedUnitIndex = 0;
            mUOM = "";
            await LoadRooms("");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{SRCFILE}DeleteUom error", SRCFILE);
            Notifications.Error($"Error deleting UOM: {ex.Message}");
        }
    }

    // === Clear All (VB6 cmdClear_Click — uncheck every room, set dirty) ===
    private void OnClearAllClick()
    {
        foreach (var room in RoomsData)
            room.Selected = false;
        SetDirty(true);
    }

    // === Save button (VB6 cmdNav index 0) ===
    private async Task OnSaveClick()
    {
        await SaveData(false);
    }

    // === Close button (VB6 cmdNav index 1 → SaveData(True) then Unload) ===
    private async Task OnCloseClick()
    {
        if (await SaveData(true))
        {
            SetDirty(false);
            ClosePage();
        }
    }

    // === Save Data (VB6 SaveData) ===
    protected override void OnAfterRender(bool firstRender)
    {
        // HHM-372: apply the deferred UOM row highlight (see _pendingUnitSelectIndex).
        if (_pendingUnitSelectIndex is int unitRow && gUnits != null)
        {
            _pendingUnitSelectIndex = null;
            gUnits.SelectRow(unitRow);
        }
    }

    private async Task<bool> SaveData(bool prompt)
    {
        // VB6: If Not mDirty Then SaveData = True : Exit Function
        if (!mDirty) return true;

        if (prompt)
        {
            // VB6 MsgBox vbYesNoCancel
            var dialogResult = await ShowConfirmSaveDialog();
            if (dialogResult == null) return false;   // Cancel
            if (dialogResult == false) return true;    // No → discard, allow close
            // Yes → fall through to save
        }

        try
        {
            // VB6: delete the category/UOM's room rows (scoped to division),
            // then re-insert one row per checked room. Built as a single batch
            // with positional parameters so nothing is interpolated.
            var sb = new System.Text.StringBuilder();
            var prms = new Dictionary<string, object>
            {
                ["Category"] = mCategory ?? "",
                ["UOM"] = mUOM ?? "",
                ["DivisionID"] = SessionState.DivisionID
            };

            sb.AppendLine("delete c from roommastersubcategory c join roommaster r on c.roomid = r.roomid");
            sb.AppendLine("where c.Subcategory = @Category and c.uom = @UOM");
            sb.AppendLine("and r.divisionid = @DivisionID");

            int p = 0;
            foreach (var room in RoomsData)
            {
                // VB6: If .Cell(checked) = flexChecked And mUOM <> "" Then INSERT ...
                if (room.Selected && !string.IsNullOrEmpty(mUOM))
                {
                    var roomParam = "@Room" + p;
                    sb.AppendLine($"insert RoomMasterSubCategory(SubCategory, UOM, RoomID) values(@Category, @UOM, {roomParam})");
                    prms[roomParam.Substring(1)] = int.TryParse(room.RoomID, out var rid) ? rid : (object)DBNull.Value;
                    p++;
                }
            }

            await db.ExecuteAsync(sb.ToString(), prms);
            SetDirty(false);
            return true;
        }
        catch (Exception ex)
        {
            // VB6 eh: ignore "duplicate" key errors (Resume Next), else errHandler.
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
            {
                SetDirty(false);
                return true;
            }
            Logger.LogError(ex, "{SRCFILE}SaveData error", SRCFILE);
            Notifications.Error($"Error saving data: {ex.Message}");
            return false;
        }
    }

    // HHM-373: VB6 SaveData MsgBox — vbExclamation + vbYesNoCancel, title
    // App.ProductName ("Precision Builder"), exact text incl. trailing newline.
    private async Task<bool?> ShowConfirmSaveDialog()
    {
        if (_messageBox == null) return true;
        var r = await _messageBox.ShowAsync(
            "This data has changed.\n\nDo you want to save these changes?\n",
            title: "Precision Builder",
            buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel,
            icon: "warning");
        return r switch
        {
            Fx.ControlKit.Dialogs.MessageBoxResult.Yes => true,
            Fx.ControlKit.Dialogs.MessageBoxResult.No => false,
            _ => null,
        };
    }

    // HHM-373: the MDI window ✕ goes through the page's own VB6-exact prompt
    // instead of FMain's generic one.
    public async Task<bool> CanCloseMdiWindowAsync(MdiCloseContext context) => await SaveData(true);
}
