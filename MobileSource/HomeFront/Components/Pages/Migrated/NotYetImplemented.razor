@* ═══════════════════════════════════════════════════════════════════════
   NotYetImplemented — placeholder rendered by FMain's DynamicComponent
   host when the resolved route maps to a page that hasn't been ported
   into HomeFront yet. FMain's _routeMap keeps every entry from the
   main VB6 app so the menu structure renders identically; the
   missing types just point here instead of crashing the build.

   Pass the original route as a parameter so the user can see exactly
   which page would have opened (and report it back, if needed).
   ═══════════════════════════════════════════════════════════════════════ *@

@namespace HomeFront.Components.Pages
@rendermode InteractiveServer

<div class="nyi-host">
    <div class="nyi-card">
        <div class="nyi-icon">🚧</div>
        <h2 class="nyi-title">Coming Soon</h2>
        <p class="nyi-route"><code>@(string.IsNullOrWhiteSpace(Route) ? "(unknown)" : Route)</code></p>
        <p class="nyi-body">This screen hasn't been ported into HomeFront yet.
            The menu entry that opened it is intentionally kept so the navigation
            structure stays aligned.</p>
    </div>
</div>

@code {
    /// <summary>Route the user clicked to land on this placeholder.</summary>
    [Parameter] public string? Route { get; set; }
}
