@page "/po-mass-cancel"
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FPOMassCancel> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>Purchase Order Cancel Wizard - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading...</div>
    </div>
}

<div class="wizard-container">
    <!-- Wizard Header -->
    <div class="wiz-header">
        <h3>Cancel Purchase Orders</h3>
        <p>The PO cancel wizard will help you cancel purchase orders</p>
    </div>

    <!-- Wizard Body -->
    <div class="wiz-body">
        @if (CurrentFrame == 0)
        {
            <!-- Step 0: Filter Purchase Orders -->
            <div class="step-header">
                <div class="step-icon">✅</div>
                <div>
                    <div class="step-title">Filter Purchase Orders</div>
                    <div class="step-description">
                        Use the filter fields below to narrow down the purchase orders you want to cancel.
                        You may use SQL wildcards (%) in any field. Leave fields blank to include all.
                        Click Next to retrieve matching purchase orders.
                    </div>
                </div>
            </div>

            <div class="filter-form">
                <div class="filter-row">
                    <label>@CommunityLabel</label>
                    <TextBoxControl @bind-Value="txtCommunity" Placeholder="e.g. % for all" CssClass="filter-input" />
                </div>
                <div class="filter-row">
                    <label>Job</label>
                    <TextBoxControl @bind-Value="txtJob" CssClass="filter-input" />
                </div>
                <div class="filter-row">
                    <label>Vendor</label>
                    <TextBoxControl @bind-Value="txtVendor" CssClass="filter-input" />
                </div>
                <div class="filter-row">
                    <label>PO Group</label>
                    <TextBoxControl @bind-Value="txtPOGroup" CssClass="filter-input" />
                </div>
                <div class="filter-row">
                    <label>PO Index</label>
                    <TextBoxControl @bind-Value="txtPOIndex" CssClass="filter-input" />
                </div>
                <div class="filter-row">
                    <label>PO Number</label>
                    <TextBoxControl @bind-Value="txtPONumber" CssClass="filter-input" />
                </div>
            </div>
        }
        else if (CurrentFrame == 1)
        {
            <!-- Step 1: Select POs to Cancel -->
            <div class="step-header">
                <div class="step-icon">✅</div>
                <div>
                    <div class="step-title">Select POs to be cancelled</div>
                    <div class="step-description">
                        Check the "Selected" column for each purchase order you wish to cancel.
                        Only checked purchase orders will be cancelled when you click Commit.
                        Right-click a row to remove it from the list.
                    </div>
                </div>
            </div>

            <div class="grid-container">
                <GridControl @ref="gDataGrid"
                        TValue="POCancelRow"
                        DataSource="@GridData"
                        AllowSorting="true"
                        AllowResizing="true"
                        AllowSelection="true"
                        AllowFiltering="true"
                        EnableHover="true"
                        Height="400px"
                        FilterSettingsRef="@filterSettings"
                        SelectionSettingsRef="@selectionSettings"
                        EditSettingsRef="@editSettings"
                        EventsRef="@gridEvents">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(POCancelRow.Selected)" HeaderText="Selected" Width="80px"
                                      Type="ColumnType.CheckBox" AllowEditing="true" TextAlign="TextAlign.Center" />
                        <GridColumn Field="@nameof(POCancelRow.Community)" HeaderText="@CommunityLabel" Width="100px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(POCancelRow.CommunityDesc)" HeaderText="@(CommunityLabel + " Desc")" Width="150px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(POCancelRow.Job)" HeaderText="Job" Width="80px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(POCancelRow.JobDesc)" HeaderText="Job Desc" Width="150px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(POCancelRow.Vendor)" HeaderText="Vendor" Width="80px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(POCancelRow.VendorDesc)" HeaderText="Vendor Desc" Width="150px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(POCancelRow.POGroup)" HeaderText="PO Group" Width="90px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(POCancelRow.POIndex)" HeaderText="PO Index" Width="90px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(POCancelRow.POIndexDescription)" HeaderText="PO Index Desc" Width="150px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(POCancelRow.PONumber)" HeaderText="PO Number" Width="110px"
                                      AllowEditing="false" IsPrimaryKey="true" />
                        <GridColumn Field="@nameof(POCancelRow.PODate)" HeaderText="PO Date" Width="110px"
                                      AllowEditing="false" Format="d" Type="ColumnType.Date" />
                    </GridColumnsBase>
                </GridControl>
            </div>
        }
    </div>

    <!-- Wizard Footer -->
    <div class="wiz-footer">
        <ButtonControl CssClass="btn-danger" OnClick="OnCancelClick">&amp;Cancel</ButtonControl>
        <ButtonControl Disabled="@(CurrentFrame <= 0)" OnClick="OnBackClick">&lt; &amp;Back</ButtonControl>
        <ButtonControl Disabled="@(CurrentFrame >= MaxFrame)" OnClick="OnNextClick">&amp;Next &gt;</ButtonControl>
        <ButtonControl CssClass="btn-primary" Disabled="@(CurrentFrame < MaxFrame)" OnClick="OnCommitClick">Commi&amp;t</ButtonControl>
    </div>
</div>

@* Context Menu *@
@if (ShowContextMenu)
{
    <div class="context-menu" style="left: @(ContextMenuX)px; top: @(ContextMenuY)px;"
         @onclick:stopPropagation="true">
        <button @onclick="OnContextRemove">Remove</button>
    </div>
    <div style="position: fixed; inset: 0; z-index: 9999;" @onclick="CloseContextMenu"></div>
}

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    private const string SRCFILE = "FPOMassCancel::";

    // Database
// UI State
    private bool IsLoading = false;
    private int CurrentFrame = 0;
    private int MaxFrame = 1;
    private string CommunityLabel = "Community";

    // Filter fields
    private string txtCommunity = "";
    private string txtJob = "";
    private string txtVendor = "";
    private string txtPOGroup = "";
    private string txtPOIndex = "";
    private string txtPONumber = "";

    // Grid
    private GridControl<POCancelRow>? gDataGrid;
    private List<POCancelRow> GridData = new();

    // Grid settings
    private FilterSettings filterSettings = new() { Type = FilterType.FilterBar };
    private SelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };
    private EditSettings editSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        ShowConfirmDialog = false
    };
    private GridControlEvents<POCancelRow> gridEvents = new();

    // Context menu
    private bool ShowContextMenu = false;
    private double ContextMenuX = 0;
    private double ContextMenuY = 0;
    private POCancelRow? ContextMenuRow;

    // Lifecycle
    protected override async Task OnInitializedAsync()
    {
        await LoadCustomDescriptions();
        CurrentFrame = 0;
    }

    private async Task LoadCustomDescriptions()
    {
        try
        {
            var label = await db.ExecuteScalarAsync<string>(
                "SELECT ISNULL(NULLIF(custom_description,''),'Community') FROM customdescriptions WHERE item='Community'");
            if (!string.IsNullOrEmpty(label))
                CommunityLabel = label;
        }
        catch
        {
            CommunityLabel = "Community";
        }
    }

    // Navigation
    private async Task OnCancelClick()
    {
        ClosePage();
    }

    private async Task OnBackClick()
    {
        if (CurrentFrame > 0)
        {
            CurrentFrame--;
            if (CurrentFrame == 0)
            {
                GridData.Clear();
            }
        }
    }

    private async Task OnNextClick()
    {
        if (CurrentFrame < MaxFrame)
        {
            CurrentFrame++;
            await OnFrameChanged();
        }
    }

    private async Task OnCommitClick()
    {
        await ApplyChange();
    }

    private async Task OnFrameChanged()
    {
        switch (CurrentFrame)
        {
            case 0:
                GridData.Clear();
                break;

            case 1:
                await LoadPurchaseOrders();
                break;
        }
    }

    // Load POs
    private async Task LoadPurchaseOrders()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            GridData.Clear();

            var sql = @"
                SELECT Community, CommunityDesc, Job, JobDesc, Vendor, VendorDesc,
                       POGroup, POIndex, POIndexDescription, PONumber,
                       CAST(PODate AS DATE) AS PODate
                FROM purchaseorders
                WHERE Cancelled = 0
                  AND DivisionID = @DivisionID";

            var whereClause = BuildWhereClause();
            if (!string.IsNullOrWhiteSpace(whereClause))
                sql += " " + whereClause;

            sql += @"
                ORDER BY Community, CommunityDesc, Job, JobDesc, Vendor, VendorDesc, POGroup";

            var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });

            foreach (var row in rows)
            {
                GridData.Add(new POCancelRow
                {
                    Selected = false,
                    Community = row["Community"]?.ToString() ?? "",
                    CommunityDesc = row["CommunityDesc"]?.ToString() ?? "",
                    Job = row["Job"]?.ToString() ?? "",
                    JobDesc = row["JobDesc"]?.ToString() ?? "",
                    Vendor = row["Vendor"]?.ToString() ?? "",
                    VendorDesc = row["VendorDesc"]?.ToString() ?? "",
                    POGroup = row["POGroup"]?.ToString() ?? "",
                    POIndex = row["POIndex"]?.ToString() ?? "",
                    POIndexDescription = row["POIndexDescription"]?.ToString() ?? "",
                    PONumber = row["PONumber"]?.ToString() ?? "",
                    PODate = row["PODate"] != null && row["PODate"] != DBNull.Value
                        ? Convert.ToDateTime(row["PODate"])
                        : null
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}LoadPurchaseOrders]");

            Notifications.Error($"Error loading purchase orders: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private string BuildWhereClause()
    {
        var clauses = new List<string>();

        if (!string.IsNullOrWhiteSpace(txtCommunity))
            clauses.Add($"(community LIKE '{EscapeSql(txtCommunity)}' OR communitydesc LIKE '{EscapeSql(txtCommunity)}')");

        if (!string.IsNullOrWhiteSpace(txtJob))
            clauses.Add($"(job LIKE '{EscapeSql(txtJob)}' OR jobdesc LIKE '{EscapeSql(txtJob)}')");

        if (!string.IsNullOrWhiteSpace(txtVendor))
            clauses.Add($"(vendor LIKE '{EscapeSql(txtVendor)}' OR vendordesc LIKE '{EscapeSql(txtVendor)}')");

        if (!string.IsNullOrWhiteSpace(txtPOGroup))
            clauses.Add($"pogroup LIKE '{EscapeSql(txtPOGroup)}'");

        if (!string.IsNullOrWhiteSpace(txtPOIndex))
            clauses.Add($"(poindex LIKE '{EscapeSql(txtPOIndex)}' OR poindexdescription LIKE '{EscapeSql(txtPOIndex)}')");

        if (!string.IsNullOrWhiteSpace(txtPONumber))
            clauses.Add($"ponumber LIKE '{EscapeSql(txtPONumber)}'");

        if (clauses.Count == 0)
            return "";

        return "AND " + string.Join(" AND ", clauses);
    }

    private string EscapeSql(string value)
    {
        return value.Replace("'", "''");
    }

    // Apply cancellation — mirrors VB6 ApplyChange: count selected, prompt Yes/No/Cancel for email,
    // then call FCancelPO.CancelPO for reason, then cancel each selected PO and remove from grid.
    private async Task ApplyChange()
    {
        try
        {
            var selectedPOs = GridData.Where(r => r.Selected).ToList();

            if (selectedPOs.Count == 0)
            {
                Notifications.Info("No purchase orders are selected");
                return;
            }

            // VB6: vbYesNoCancel — use prompt to simulate 3-way: "yes" / "no" / null(cancel)
            var emailAnswer = await Dialogs.PromptAsync(
                $"{selectedPOs.Count} purchase orders will be cancelled.\nWould you like to send emails to the vendors?\n\nType YES or NO (or press Cancel to abort):", "", "yes");

            if (emailAnswer == null)
                return; // user pressed Cancel

            int emailFlag = emailAnswer.Trim().Equals("yes", StringComparison.OrdinalIgnoreCase) ? 1 : 2;

            // VB6: FCancelPO.CancelPO(reason) — prompt for cancellation reason
            var reason = await Dialogs.PromptAsync(
                "Enter a reason for cancellation:", "", "");

            if (reason == null)
                return; // user clicked Cancel on the prompt

            IsLoading = true;
            StateHasChanged();

            // Process cancellations in reverse order (matches VB6 loop direction)
            for (int i = selectedPOs.Count - 1; i >= 0; i--)
            {
                var po = selectedPOs[i];
                var success = await CancelPO(po.PONumber, false, emailFlag, reason);
                if (success)
                {
                    GridData.Remove(po);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}ApplyChange]");

            Notifications.Error($"Error during cancellation: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task<bool> CancelPO(string poNumber, bool prompt, int emailFlag, string reason)
    {
        try
        {
            var sql = @"
                UPDATE purchaseorders
                SET Cancelled = 1,
                    CancelReason = @Reason,
                    CancelDate = GETDATE()
                WHERE PONumber = @PONumber
                  AND DivisionID = @DivisionID";

            await db.ExecuteAsync(sql, new
            {
                PONumber = poNumber,
                Reason = reason,
                SessionState.DivisionID
            });

            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}CancelPO] Error cancelling PO {poNumber}");

            return false;
        }
    }

    // Context menu
    private void OnRowRightClick(POCancelRow row, double x, double y)
    {
        ContextMenuRow = row;
        ContextMenuX = x;
        ContextMenuY = y;
        ShowContextMenu = true;
    }

    private void OnContextRemove()
    {
        if (ContextMenuRow != null)
        {
            GridData.Remove(ContextMenuRow);
            ContextMenuRow = null;
        }
        ShowContextMenu = false;
        StateHasChanged();
    }

    private void CloseContextMenu()
    {
        ShowContextMenu = false;
    }

    // Model
    public class POCancelRow
    {
        public bool Selected { get; set; }
        public string Community { get; set; } = "";
        public string CommunityDesc { get; set; } = "";
        public string Job { get; set; } = "";
        public string JobDesc { get; set; } = "";
        public string Vendor { get; set; } = "";
        public string VendorDesc { get; set; } = "";
        public string POGroup { get; set; } = "";
        public string POIndex { get; set; } = "";
        public string POIndexDescription { get; set; } = "";
        public string PONumber { get; set; } = "";
        public DateTime? PODate { get; set; }
    }
}
