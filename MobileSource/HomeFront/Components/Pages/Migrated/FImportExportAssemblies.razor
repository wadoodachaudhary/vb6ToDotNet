    // (BackToExportColumns / OnExportOpenClick removed — the separate ExportColumns
    //  stage is unreachable since the checklist merged into ExportSave; the enum
    //  member stays for state-machine history.)

    // ──────────────────────────────────────────────────────────────────────
    // File selection / parse
    // owner directive 2026-07-23: server-FS FileBrowserControl /
    // FileSaveLocationPickerControl (VB6-faithful local file dialogs). Import
    // reads the picked file's bytes off the server filesystem (server FS == the
    // user's FS on this local desktop replacement); the browser <InputFile> upload
    // + hfPickFileWithCancel JS were removed.
    // ──────────────────────────────────────────────────────────────────────

    // owner deployment fix 2026-07-27: the ImportPickFile drop-zone <InputFile> →
    // read the browser-uploaded file's bytes into memory (server FS is no longer
    // touched). Both a click-to-browse pick and a drag-drop onto the overlaid
    // transparent input fire OnChange here. 64 MB cap. Page-2 Next > commits the
    // buffered bytes into the parse pipeline.
    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(64 * 1024 * 1024).CopyToAsync(ms); // 64 MB cap
            _importBytes = ms.ToArray();
            _importFileName = file.Name;
            _statusText = "";
        }
        catch (Exception ex)
        {
            _importBytes = null; _importFileName = "";
            _statusText = $"Could not read file: {ex.Message}";
            Logger.LogError(ex, "[{Src}OnImportFileSelected]", SRCFILE);
        }
    }

    // ImportPickFile (page 2) "Next >" — the page-2→3 transition IS the parse
    // trigger (owner import-wizard spec 2026-07-23; it used to fire from the old
    // combined page-1 Next). Enters ImportValidate, reads the bytes from the
    // server path the user picked (File.ReadAllBytes) and dispatches to the
    // unchanged parse + validation cores; the ImportValidate page then shows the
    // outcome (errors panel / success state) under the existing progress overlay.
    // File-read failures surface on the Validate page as a FATAL error (Next
    // stays disabled), not as a status line on page 2. PDF is gated on page 1
    // (Next > disabled), so no read is ever attempted for it.
    private async Task OnImportNextClick()
    {
        if (_importBytes == null || _importFileType == ImportFileType.Pdf) return;

        // Fresh validation slate for this run — re-entry via "< Previous" keeps
        // the prior results in memory, so clear them before re-parsing.
        ErrorRows.Clear();
        ErrorTotal = 0;
        _vendorSkippedRows = 0;
        _statusText = "";
        mFileType = "";
        FileLoaded = false;
        ResetModelsImportState();

        Stage = WizardStage.ImportValidate;
        StateHasChanged();

        byte[] bytes;
        try
        {
            // owner deployment fix 2026-07-27: the bytes were already buffered from
            // the browser upload in OnImportFileSelected (no server filesystem read).
            bytes = _importBytes;
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error reading file: {ex.Message}");
            Logger.LogError(ex, "[{Src}OnImportNextClick]", SRCFILE);
            // owner import-wizard spec 2026-07-23: a FATAL outcome on the
            // ImportValidate page (per-mode error surface so Next stays disabled).
            if (IsModelsImportMode)
            {
                FileName = _importFileName;
                AddMsg(0, $"Error reading file: {ex.Message}");
                ErrorCount = Messages.Count(m => m.Level == 0);
            }
            else
            {
                mFilename = _importFileName;
                ErrorRows.Add(new ErrorRow { RowRef = "file", Error = $"Error reading file: {ex.Message}" });
                ErrorTotal = ErrorRows.Count;
            }
            return;
        }

        var ext = Path.GetExtension(_importFileName).ToLowerInvariant().TrimStart('.');
        var name = _importFileName;

        if (IsModelsImportMode)
            await ParseModelsImportFromBytes(bytes, ext, name);
        else
            await ParseImportFromBytes(bytes, ext, name);

        // owner 2026-07-23 (single-validation-page fix): the Purch_* validate procs
        // used to run only inside the page-4 commit, giving the user a SECOND,
        // contradictory verdict ("No problems found" on step 3, then "Series is
        // required" after Next). Run them HERE, so step 3 shows the COMPLETE
        // verdict — parse checks AND server checks — on ONE page. The staging rows
        // are deleted right after the check; the commit path re-stages and
        // re-validates silently as a safety net (in the normal flow it can no
        // longer surface anything new).
        if (!IsModelsImportMode && FileLoaded && !HasFatalErrors)
        {
            if (Descriptor.ImportKind == ImportEngineKind.Assemblies)
                await ServerValidateStagedAsync(assemblies: true);
            else if (Descriptor.ImportKind == ImportEngineKind.Takeoffs)
                await ServerValidateStagedAsync(assemblies: false);
        }

        // The Validate step now IS the review page (validation + preview merged, owner
        // 2026-07-27) — build the display-capped grid/tab lists here so they're ready when
        // this same page renders (there is no separate Validate→Preview hop anymore).
        BuildImportPreviewDisplayLists();
    }

    // Step-3 server-side validation (single-validation-page fix, owner 2026-07-23).
    // Stages the parsed rows exactly like the commit path, runs the VB6 validate proc
    // (Purch_ImportedAssemblies_Validate / Purch_ImportedAssemblyTakeoffs_Validate),
    // surfaces any rows in the SAME ErrorRows panel as the parse checks, then drops
    // the staging rows — page 4's commit re-stages from the full in-memory set.
    private async Task ServerValidateStagedAsync(bool assemblies)
    {
        IsLoading = true;
        ProgressMessage = "Validating...";
        StateHasChanged();
        var parseWarnings = ErrorRows.Where(e => e.IsWarning).ToList();
        try
        {
            if (assemblies)
            {
                if (string.IsNullOrEmpty(mFileType))
                {
                    // What RunImportAssembliesAsync would have said at commit time.
                    ErrorRows.Add(new ErrorRow { RowRef = "file", Error = "Invalid file format." });
                    ErrorTotal = ErrorRows.Count;
                    return;
                }
                await Engine.StageImportedAssembliesAsync(mSession, ColumnKeys, GridData);
                var errs = Engine.ValidateImportedAssemblies(SessionState.DivisionID, mSession, mFileType);
                if (errs.Rows.Count > 0)
                {
                    BuildErrorRows(errs, rowCol: 0, errorCol: 1);   // replaces the list
                    ErrorRows.AddRange(parseWarnings);              // keep parse warnings visible
                    ErrorTotal += parseWarnings.Count;
                }
            }
            else
            {
                (_takeoffHeadersSaved, _takeoffQtyRowsSaved) = await Engine.StageAssemblyTakeoffsAsync(mSession, SheetRows);
                var errs = Engine.ValidateImportedAssemblyTakeoffs(SessionState.DivisionID, mSession);
                if (errs.Rows.Count > 0)
                {
                    BuildErrorRows(errs, rowCol: -1, errorCol: 1);
                    ErrorRows.AddRange(parseWarnings);
                    ErrorTotal += parseWarnings.Count;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{Src}ServerValidateStagedAsync]", SRCFILE);
            // VB6 treats a takeoff staging failure as a bad file; assemblies get
            // the real message.
            ErrorRows.Add(new ErrorRow
            {
                RowRef = "file",
                Error = assemblies ? $"Validation failed: {ex.Message}" : "Invalid file format."
            });
            ErrorTotal = ErrorRows.Count;
        }
        finally
        {
            try
            {
                if (assemblies)
                    await Engine.DeleteImportedAssembliesStagingAsync(mSession);
                else
                    await Engine.CleanupTakeoffStagingAsync(mSession);
            }
            catch { /* best effort cleanup */ }
            IsLoading = false;
            StateHasChanged();
        }
    }

    // BASE-mode parse core (ImportAssemblies / ImportTakeoffs / ImportVendors).
    // Refactored verbatim from the old OnFileSelected(InputFileChangeEventArgs): the
    // only change is the source — a byte[] read from the server path — instead of
    // IBrowserFile.OpenReadStream(). The ClosedXML/CSV/IIF parsers already accept a
    // stream, so the bytes are fed via a MemoryStream. Extension branching uses the
    // picked file's extension (xls/xlsx vs csv vs iif/txt), same as before.
    private async Task ParseImportFromBytes(byte[] bytes, string ext, string fileName)
    {
        IsLoading = true;
        ProgressMessage = "Reading data...";
        StateHasChanged();

        try
        {
            mFilename = fileName;

            // Read into a flat string grid (header row(s) + data rows).
            // VB6 LoadCSV converts xls/xlsx to CSV via Excel first; we read directly
            // with ClosedXML (xls/xlsx) or split delimited text (csv).
            List<List<string>> sheet;
            using (var stream = new MemoryStream(bytes))
            {
                if (ext == "xls" || ext == "xlsx")
                {
                    // ── HHM-557: VB6 "Export Assemblies" writes a BINARY Excel 97-2003
                    //    (BIFF) .xls via VSFlexGrid SaveGrid(flexFileExcel)
                    //    (MAssemblyImport.bas:161 -> FDataExport.frm:164-168). ClosedXML
                    //    (FilerControl.ReadExcel) opens only OPC .xlsx and dies on BIFF
                    //    with "File contains corrupted data." Sniff the container magic:
                    //    OLE compound (D0 CF 11 E0 A1 B1 1A E1) -> ExcelDataReader legacy
                    //    path; PK zip (real .xlsx) -> existing ClosedXML path. ──
                    try
                    {
                        // ── HHM-595/597/599/603: the takeoff workbook is POSITIONAL —
                        //    a pivoted template (VB6 FAssemblyImport.frm LoadCSV with
                        //    HasColHeadings=False: rows 1-12 = assembly headers, row 13
                        //    = labels, rows 14+ = item data; assemblies = columns F+).
                        //    The header-based ReadExcel path treats ROW 1 as column
                        //    headers, DROPS every blank-header column (B, D, and all
                        //    assembly columns whenever row-1 Community is empty) and
                        //    skips empty rows — so nothing reached staging and every
                        //    takeoff import "succeeded" with 0 records, bypassing the
                        //    Purch_ImportedAssemblyTakeoffs_Validate rules legacy
                        //    enforces. Read takeoff workbooks cell-by-cell instead,
                        //    preserving row/column positions exactly like VB6's grid. ──
                        if (Descriptor.ImportKind == ImportEngineKind.Takeoffs)
                        {
                            sheet = Engine.IsOleCompoundFile(bytes)
                                ? Engine.LegacyXlsToPositionalSheet(bytes)
                                : Engine.XlsxToPositionalSheet(bytes);
                        }
                        else if (Engine.IsOleCompoundFile(bytes))
                        {
                            sheet = Engine.LegacyXlsToSheet(bytes);
                        }
                        else
                        {
                            stream.Position = 0;
                            var dt = Fx.ControlKit.Data.FilerControl.ReadExcel(stream);
                            sheet = Engine.DataTableToSheet(dt);
                        }
                    }
                    catch (Exception ex) when (ex is not OutOfMemoryException)
                    {
                        // HHM-557 (3): any residual workbook-read failure surfaces as a
                        // fatal error row NAMING the detected format (outer catch below
                        // adds it to ErrorRows), not the raw System.IO.Packaging message.
                        throw new InvalidDataException(Engine.DescribeWorkbookReadFailure(bytes, ex), ex);
                    }
                }
                else if (Descriptor.ImportKind == ImportEngineKind.Vendors && (ext == "iif" || ext == "txt"))
                {
                    // ── HHM-440 vendor branch (VB6 FImportVendors.frm ReadText 361-377):
                    //    .iif and .txt are TAB-delimited; IIF files are additionally trimmed
                    //    to the !VEND header … VEND data block and lose the record-type col. ──
                    using var reader = new StreamReader(stream);
                    var content = await reader.ReadToEndAsync();
                    sheet = Engine.DelimitedToSheet(content, '\t');
                    if (ext == "iif")
                        Engine.TrimIifVendorSheet(sheet);
                }
                else
                {
                    using var reader = new StreamReader(stream);
                    var content = await reader.ReadToEndAsync();
                    sheet = Engine.DelimitedToSheet(content, ',');
                }
            }

            // VB6: mSession = CreateGUID()
            mSession = Guid.NewGuid().ToString();

            if (Descriptor.ImportKind == ImportEngineKind.Assemblies)
                LoadAssembliesGrid(sheet);
            else if (Descriptor.ImportKind == ImportEngineKind.Vendors)
                LoadVendorsGrid(sheet);   // HHM-440
            else
                LoadTakeoffsGrid(sheet);

            FileLoaded = true;
            // Parse done (client-side validation problems, if any, are already in
            // ErrorRows) — the wizard is already ON ImportValidate (owner
            // import-wizard spec 2026-07-23), which now shows the outcome.
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error reading file: {ex.Message}");
            Logger.LogError(ex, "[{Src}ParseImportFromBytes]", SRCFILE);
            FileLoaded = false;
            // owner import-wizard spec 2026-07-23: surface as a FATAL outcome on
            // the ImportValidate page (Next stays disabled there).
            ErrorRows.Add(new ErrorRow { RowRef = "file", Error = $"Error reading file: {ex.Message}" });
            ErrorTotal = ErrorRows.Count;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ── Workbook / delimited-text readers (the HHM-557 legacy-BIFF sniffing,
    //    the HHM-595/597/599/603 positional takeoff readers, CSV/IIF splitting)
    //    and the HHM-616 CSV writer moved to Services/AssemblyImportExportService
    //    (the shared non-UI engine, injected above as Engine) — VB6 provenance
    //    comments moved with them. ──

    // ──────────────────────────────────────────────────────────────────────
    // IMPORT ASSEMBLIES  (VB6 ImportAssemblies + LoadCSV + SaveAssemblyData)
    // ──────────────────────────────────────────────────────────────────────
    private void LoadAssembliesGrid(List<List<string>> sheet)
    {
        GridData.Clear();
        GridColumns.Clear();
        ColumnKeys.Clear();
        SheetRows = sheet;

        if (sheet.Count < 1) return;

        var headers = sheet[0];

        // VB6 LoadCSV: ColKey(i) = Replace(TextMatrix(1,i)," ","")  (strip spaces)
        var keys = headers.Select(h => (h ?? "").Replace(" ", "")).ToList();

        // VB6: change CommunityCode heading/key to Community (only if Community absent)
        var idxCommunityCode = IndexOfKey(keys, "CommunityCode");
        if (idxCommunityCode != -1 && IndexOfKey(keys, "Community") == -1)
            keys[idxCommunityCode] = "Community";

        // VB6 mColumnMappings translation ("Option=OptionID")
        foreach (var map in mColumnMappings.Split(',', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = map.Split('=');
            var c1 = parts.Length > 0 ? parts[0].Trim() : "";
            var c2 = parts.Length > 1 ? parts[1].Trim() : "";
            var idx = IndexOfKey(keys, c1);
            if (idx != -1)
            {
                if (c1 != "" && c2 != "") keys[idx] = c2;     // rename
                else if (c2 == "") keys[idx] = "";            // hide / drop
            }
        }

        ColumnKeys = keys;

        // VB6 file-type detection
        //   models  : has model, no optionid
        //   options : has model AND optionid
        //   globals : no model, has optionid
        var hasModel = IndexOfKey(keys, "model") != -1;
        var hasOption = IndexOfKey(keys, "optionid") != -1;
        if (hasModel && !hasOption) mFileType = "models";
        else if (hasModel && hasOption) mFileType = "options";
        else if (!hasModel && hasOption) mFileType = "globals";
        else
        {
            mFileType = "";
            // FATAL (missing required columns) — surfaced in the ImportPreview
            // errors panel, which disables Import (was a Notifications toast).
            ErrorRows.Add(new ErrorRow
            {
                RowRef = "header",
                Error = "Invalid file format. A \"Model\" and/or \"OptionID\" column is required."
            });
            ErrorTotal = ErrorRows.Count;
        }

        // Build the preview columns (only the kept/named columns)
        for (int c = 0; c < keys.Count; c++)
        {
            var key = keys[c];
            if (string.IsNullOrEmpty(key)) continue;
            GridColumns.Add(new GridColumnDef
            {
                Field = $"Col{c}",
                HeaderText = key,
                Width = "150px",
                IsPrimaryKey = GridColumns.Count == 0,
                Visible = true
            });
        }

        // Build preview rows from data rows (sheet[1..])
        for (int r = 1; r < sheet.Count; r++)
        {
            var cells = sheet[r];
            // VB6 skips blank rows (all-whitespace)
            if (cells.All(string.IsNullOrWhiteSpace)) continue;

            var row = new ImportRow { RowIndex = r };
            for (int c = 0; c < keys.Count; c++)
                row.Values[$"Col{c}"] = c < cells.Count ? (cells[c] ?? "").Trim() : "";
            GridData.Add(row);
        }
    }

    // (VB6 SaveAssemblyData — the ImportedAssemblies staging INSERT with its
    //  column allowlist — moved to Engine.StageImportedAssembliesAsync.)

    // ──────────────────────────────────────────────────────────────────────
    // IMPORT TAKEOFFS  (VB6 ImportAssemblyTakeoffs + SaveAssemblyTakeoffData)
    // Pivoted layout: assemblies are columns 6.. (0-based: index 5..),
    // header rows are grid rows 0..12, item/qty data starts at grid row 14.
    // ──────────────────────────────────────────────────────────────────────
    private void LoadTakeoffsGrid(List<List<string>> sheet)
    {
        // VB6 loads takeoffs with HasColHeadings=False: it does NOT strip a header
        // row, and column A=1 maps to sheet column index 0. We keep the raw sheet.
        GridData.Clear();
        GridColumns.Clear();
        ColumnKeys.Clear();
        SheetRows = sheet;
        mFileType = ""; // not applicable for takeoffs

        if (sheet.Count == 0) return;

        int maxCols = sheet.Max(r => r.Count);

        // Preview columns A, B, C ... mirroring the spreadsheet layout
        for (int c = 0; c < maxCols; c++)
        {
            GridColumns.Add(new GridColumnDef
            {
                Field = $"Col{c}",
                HeaderText = Engine.ExcelColRef(c + 1),
                Width = "130px",
                IsPrimaryKey = c == 0,
                Visible = true
            });
        }

        for (int r = 0; r < sheet.Count; r++)
        {
            var cells = sheet[r];
            var row = new ImportRow { RowIndex = r };
            for (int c = 0; c < maxCols; c++)
                row.Values[$"Col{c}"] = c < cells.Count ? (cells[c] ?? "").Trim() : "";
            GridData.Add(row);
        }
    }

    // Counts captured for the ImportResult stage ("{N} records imported"),
    // assigned from Engine.StageAssemblyTakeoffsAsync — the VB6
    // SaveAssemblyTakeoffData staging (with its TextMatrix→sheet row mapping
    // notes) lives in the engine now.
    private int _takeoffHeadersSaved;
    private int _takeoffQtyRowsSaved;

    // ──────────────────────────────────────────────────────────────────────
    // IMPORT — run validate / commit
    // ──────────────────────────────────────────────────────────────────────
    private async Task OnImportClick()
    {
        if (Descriptor.ImportKind == ImportEngineKind.Assemblies)
            await RunImportAssembliesAsync();
        else if (Descriptor.ImportKind == ImportEngineKind.Vendors)
            await RunImportVendorsAsync();   // HHM-440 vendor branch
        else
            await RunImportTakeoffsAsync();
    }

    private async Task RunImportAssembliesAsync()
    {
        if (string.IsNullOrEmpty(mFileType))
        {
            Notifications.Warning("Invalid file format.");
            return;
        }

        IsLoading = true;
        ProgressMessage = "Validating...";
        StateHasChanged();

        try
        {
            // VB6: insert data into tmptable, then validate
            await Engine.StageImportedAssembliesAsync(mSession, ColumnKeys, GridData);

            var errs = Engine.ValidateImportedAssemblies(SessionState.DivisionID, mSession, mFileType);

            if (errs.Rows.Count == 0)
            {
                // VB6: commit, then delete staging
                ProgressMessage = "Saving...";
                StateHasChanged();
                await Engine.CommitImportedAssembliesAsync(SessionState.DivisionID, mSession, mFileType);

                await Engine.DeleteImportedAssembliesStagingAsync(mSession);

                _resultText = $"{GridData.Count} records imported";
                _resultDetail = "";
                Stage = WizardStage.ImportResult;
            }
            else
            {
                // VB6: list errors (col 0 = row, col 1 = error), show first 25, STOP, no commit.
                BuildErrorRows(errs, rowCol: 0, errorCol: 1);
                // VB6 also deletes the staging rows it inserted (eh path / rerun safety)
                await Engine.DeleteImportedAssembliesStagingAsync(mSession);
                // owner import-wizard spec 2026-07-23: the errors panel lives on the
                // ImportValidate outcome page now — return there (fatal → Next disabled).
                Stage = WizardStage.ImportValidate;
            }
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error during import: {ex.Message}");
            Logger.LogError(ex, "[{Src}RunImportAssembliesAsync]", SRCFILE);
            try { await Engine.DeleteImportedAssembliesStagingAsync(mSession); }
            catch { /* best effort cleanup */ }
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task RunImportTakeoffsAsync()
    {
        IsLoading = true;
        ProgressMessage = "Writing...";
        StateHasChanged();

        try
        {
            // VB6 wraps SaveAssemblyTakeoffData in On Error Resume Next and treats
            // any error as "Invalid file format."
            try
            {
                (_takeoffHeadersSaved, _takeoffQtyRowsSaved) = await Engine.StageAssemblyTakeoffsAsync(mSession, SheetRows);
            }
            catch (Exception saveEx)
            {
                Logger.LogError(saveEx, "[{Src}SaveAssemblyTakeoffData]", SRCFILE);
                await Engine.CleanupTakeoffStagingAsync(mSession);
                // FATAL — surfaced in the errors panel (was a toast). owner
                // import-wizard spec 2026-07-23: the panel lives on the
                // ImportValidate outcome page — return there (Next disabled).
                ErrorRows.Add(new ErrorRow { RowRef = "file", Error = "Invalid file format." });
                ErrorTotal = ErrorRows.Count;
                Stage = WizardStage.ImportValidate;
                return;
            }

            ProgressMessage = "Validating...";
            StateHasChanged();

            var errs = Engine.ValidateImportedAssemblyTakeoffs(SessionState.DivisionID, mSession);

            if (errs.Rows.Count == 0)
            {
                ProgressMessage = "Saving...";
                StateHasChanged();
                await Engine.CommitImportedAssemblyTakeoffsAsync(SessionState.DivisionID, mSession);

                _resultText = $"{_takeoffHeadersSaved} records imported";
                _resultDetail = $"{_takeoffQtyRowsSaved} item quantity row(s)";
                Stage = WizardStage.ImportResult;
                // VB6 commit path does NOT delete the takeoff staging tables; the
                // commit proc consumes them. We leave that to the proc, matching VB6.
            }
            else
            {
                // VB6 takeoff errors: show rs(1) only (col index 1). owner
                // import-wizard spec 2026-07-23: the errors panel lives on the
                // ImportValidate outcome page — return there (fatal → Next disabled).
                BuildErrorRows(errs, rowCol: -1, errorCol: 1);
                await Engine.CleanupTakeoffStagingAsync(mSession);
                Stage = WizardStage.ImportValidate;
            }
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error during import: {ex.Message}");
            Logger.LogError(ex, "[{Src}RunImportTakeoffsAsync]", SRCFILE);
            await Engine.CleanupTakeoffStagingAsync(mSession);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ──────────────────────────────────────────────────────────────────────
    // ══ HHM-440 VENDOR MODES — ImportVendors / ExportVendors ══
    //
    // Import = VB6 HFSystem/Source/FImportVendors.frm (the wizard FVendor's
    // "ExcelImport" toolbar button launched): ReadText (355-425) parses the
    // file, translates headings, requires Vendor_ID and drops blank-ID rows;
    // SaveData (468-563) INSERTs the vendor shell (duplicate ignored),
    // UPDATEs the mapped tblVendors columns, then updates ONLY the provided
    // per-contact-type contact fields.
    //
    // Export = VB6 FVendor.frm Toolbar "ExcelExport" →
    //   HFApp.RunTask("ExportData|select * from tblVendors where divisionid=N")
    // — originally a plain full-division dump with no picklist. 2026-07-22
    // owner redesign: now SELECTION-BASED via a vendor multi-select FPickList
    // (see OpenExportPickerAsync + BuildVendorExportTable); the dump path was
    // deliberately removed.
    //
    // NOTE: despite the VB6 form caption "Pricelist Import Wizard",
    // FImportVendors contains NO pricelist logic (SaveData touches only
    // tblVendors + contacts) — nothing further to port.
    //
    // Everything vendor-specific lives in this section plus the small
    // "HHM-440" branches at the shared call sites (ParseImportFromBytes,
    // OnImportClick, OpenExportPickerAsync, BeginExportColumnsAsync). Follow the
    // same pattern to fold in future import/exports.
    // ──────────────────────────────────────────────────────────────────────

    // VB6 FImportVendors.frm ReadText 392-407 — translate file column headings
    // onto tblVendors column names (Option Compare Text → case-insensitive).
    private static readonly Dictionary<string, string> VendorColumnTranslations = new(StringComparer.OrdinalIgnoreCase)
    {
        { "refnum", "Vendor_ID" },
        { "vendor", "Vendor_ID" },
        { "vendorcode", "Vendor_ID" },
        { "id", "Vendor_ID" },
        { "code", "Vendor_ID" },
        { "name", "Vendor_Name" },
        { "prov", "state" },
        { "province", "state" },
        { "postalcode", "zip" },
        { "zipcode", "zip" },
        { "emailaddress", "email" },
        { "phone1", "phone" },
        { "faxnum", "fax" },
        { "cont1", "contact" },
        { "vtype", "tradetype" }
    };

    // VB6 FImportVendors.frm SaveData 503 (IsIn list) — tblVendors columns the
    // bulk UPDATE must never touch.
    private static readonly HashSet<string> VendorExcludedFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "vendor_id", "divisionid", "paymentterms", "SchedContactID", "ServiceContactID",
        "FPOContactID", "PurchContactID", "createddate", "createdby",
        "modifieddate", "modifiedby", "DateSentToBuildPro",
        // HHM-637: AK1_tblVendors is UNIQUE on (DivisionID, WebUID) and the insert
        // trigger derives WebUID from Vendor_ID. An export file copied from an
        // existing vendor carries that vendor's WebUID, so writing it back always
        // collides. VB6 had the same latent bug; the column must never be imported.
        "WebUID"
    };

    // VB6 FImportVendors.frm SaveData 516 — Choose(X, "FPO", "Purch", "Service", "Sched").
    private static readonly string[] VendorContactTypes = { "FPO", "Purch", "Service", "Sched" };

    // The ImportPickFile FileBrowserControl's Accept filter is driven by the
    // file-type radio (owner directive 2026-07-23; replaces the old hidden-InputFile
    // accept). QuickBooks (.iif/.txt — VB6 FImportVendors ShowForm 260) is vendor-only.
    private string ImportFileAccept => _importFileType switch
    {
        ImportFileType.Csv => ".csv",
        ImportFileType.Pdf => ".pdf",
        ImportFileType.QuickBooks => ".iif,.txt",
        _ => ".xls,.xlsx"
    };

    // (VB6 FImportVendors.frm ReadText 364-374 — the IIF !VEND…VEND block trim —
    //  moved to Engine.TrimIifVendorSheet.)

    // ══ HHM-440 ImportVendors — parse/verify (VB6 FImportVendors.frm ReadText 355-425) ══
    // Builds the same verify grid the other import modes show: translated headings as
    // columns, one preview row per data row that has a Vendor_ID.
    private void LoadVendorsGrid(List<List<string>> sheet)
    {
        GridData.Clear();
        GridColumns.Clear();
        ColumnKeys.Clear();
        SheetRows = sheet;
        mFileType = ""; // not applicable for vendors

        if (sheet.Count < 1) return;

        var headers = sheet[0];

        // VB6 ReadText 384-386: ColKey(i) = Replace(TextMatrix(1,i), " ", "") — strip spaces.
        var keys = headers.Select(h => (h ?? "").Replace(" ", "")).ToList();

        // VB6 ReadText 392-407: translate column headings.
        for (int i = 0; i < keys.Count; i++)
            if (VendorColumnTranslations.TryGetValue(keys[i], out var translated))
                keys[i] = translated;

        ColumnKeys = keys;

        // VB6 ReadText 414-415: check that required cols are available. (VB6's raise
        // says "Description" — a source bug; the migrated FImportVendors message is kept.)
        var vendorIdCol = IndexOfKey(keys, "Vendor_ID");
        if (vendorIdCol == -1)
        {
            ErrorRows = new List<ErrorRow>
            {
                new ErrorRow
                {
                    RowRef = "header",
                    Error = "Required column \"Vendor_ID\" (or equivalent: vendor, vendorcode, id, code, refnum) is missing."
                }
            };
            ErrorTotal = 1;
            return;
        }

        // Preview columns (translated headings)
        for (int c = 0; c < keys.Count; c++)
        {
            var key = keys[c];
            if (string.IsNullOrEmpty(key)) continue;
            GridColumns.Add(new GridColumnDef
            {
                Field = $"Col{c}",
                HeaderText = key,
                Width = "140px",
                IsPrimaryKey = GridColumns.Count == 0,
                Visible = true
            });
        }

        // VB6 ReadText 417-420: remove rows that have no vendor id. The staged
        // wizard surfaces each dropped NON-BLANK row as a warning (with its row
        // number) in the ImportPreview errors panel — warnings don't block Import.
        // (Row numbers are file rows; for .iif files they are relative to the
        // trimmed !VEND…VEND block, since the leading rows were removed.)
        _vendorSkippedRows = 0;
        for (int r = 1; r < sheet.Count; r++)
        {
            var cells = sheet[r];
            var vendorId = vendorIdCol < cells.Count ? (cells[vendorIdCol] ?? "").Trim() : "";
            if (string.IsNullOrEmpty(vendorId))
            {
                if (!cells.All(string.IsNullOrWhiteSpace))
                {
                    _vendorSkippedRows++;
                    ErrorRows.Add(new ErrorRow
                    {
                        RowRef = $"row {r + 1}",
                        Error = "Blank Vendor ID — this row will be skipped.",
                        IsWarning = true
                    });
                    ErrorTotal = ErrorRows.Count;
                }
                continue;
            }

            var row = new ImportRow { RowIndex = r };
            for (int c = 0; c < keys.Count; c++)
                row.Values[$"Col{c}"] = c < cells.Count ? (cells[c] ?? "").Trim() : "";
            GridData.Add(row);
        }
    }

    // Non-blank rows dropped for a blank Vendor_ID (reported on ImportResult).
    private int _vendorSkippedRows;

    // ══ HHM-440 ImportVendors — commit (VB6 FImportVendors.frm SaveData 468-563) ══
    // Per row: INSERT the vendor shell (duplicate key ignored — VB6 bIgnoreDupKey /
    // Resume Next), UPDATE every mapped file column that is a real tblVendors column
    // and not excluded, then per contact type update ONLY the fields the file provides.
    // Parameterized SQL throughout; only DB-schema column names and the fixed contact
    // types are ever interpolated (never file text). DivisionID from SessionState.
    private async Task RunImportVendorsAsync()
    {
        IsLoading = true;
        ProgressMessage = "Saving vendors...";
        StateHasChanged();

        try
        {
            // VB6 SaveData 482: tabdef = select * from tblvendors where 1=2 → the set of
            // real tblVendors columns. The canonical DataColumn name (never the file's
            // header text) is what lands in the UPDATE, bracket-escaped as defense in depth.
            var tabDef = db.SqlExec("select * from tblvendors where 1=2");
            var validColumns = new Dictionary<string, DataColumn>(StringComparer.OrdinalIgnoreCase);
            foreach (DataColumn col in tabDef.Columns)
                validColumns[col.ColumnName] = col;

            int vendorIdCol = IndexOfKey(ColumnKeys, "Vendor_ID");
            int total = GridData.Count;
            int done = 0;

            foreach (var row in GridData)
            {
                done++;
                if (done % 10 == 0)
                {
                    ProgressMessage = $"Saving vendors... {done} of {total}";
                    await InvokeAsync(StateHasChanged);
                }

                var vendorId = (vendorIdCol >= 0 ? row.GetValue($"Col{vendorIdCol}") : "").Trim();
                if (string.IsNullOrEmpty(vendorId)) continue;

                // VB6 SaveData 492-495: INSERT the vendor shell; duplicate key ignored.
                try
                {
                    await db.ExecuteAsync(
                        "INSERT INTO tblVendors(DivisionID, webupdated, nodatachanged, Vendor_ID) VALUES (@DivisionID, 0, 0, @VendorID)",
                        new { SessionState.DivisionID, VendorID = vendorId });
                }
                catch (Exception ex)
                {
                    if (!ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                        throw;
                }

                // VB6 SaveData 497-508: UPDATE the mapped columns.
                var setClauses = new List<string>();
                var updateParms = new Dictionary<string, object>
                {
                    ["DivisionID"] = SessionState.DivisionID,
                    ["VendorID"] = vendorId
                };
                for (int c = 0; c < ColumnKeys.Count; c++)
                {
                    var key = ColumnKeys[c];
                    if (string.IsNullOrEmpty(key)) continue;
                    if (VendorExcludedFields.Contains(key)) continue;
                    if (!validColumns.TryGetValue(key, out var col)) continue; // allowlist: real columns only

                    var value = row.GetValue($"Col{c}") ?? "";
                    // VB6 DbQuote(..., d.DefinedSize) clipped over-long values to the column size.
                    if (col.MaxLength > 0 && value.Length > col.MaxLength)
                        value = value.Substring(0, col.MaxLength);

                    var p = $"p{c}";
                    setClauses.Add($"{Engine.BracketId(col.ColumnName)} = @{p}");
                    // VB6 DbQuote(..., Nullable:=True) writes NULL for empty cells — an empty
                    // string would fail SQL conversion on numeric/date columns (HHM-207 class).
                    updateParms[p] = string.IsNullOrEmpty(value) ? (object)DBNull.Value : value;
                }
                if (setClauses.Count > 0)
                {
                    await db.ExecuteAsync(
                        $"UPDATE tblVendors SET {string.Join(", ", setClauses)} WHERE DivisionID = @DivisionID AND Vendor_ID = @VendorID",
                        updateParms);
                }

                // VB6 SaveData 512-546: update each contact field individually so data the
                // file did not provide is never cleared — only provided columns are SET.
                foreach (var ctype in VendorContactTypes)
                {
                    var contactSets = new List<string>();
                    var contactParms = new Dictionary<string, object>
                    {
                        ["DivisionID"] = SessionState.DivisionID,
                        ["VendorID"] = vendorId
                    };

                    void AddContactField(string suffix, string dbField)
                    {
                        int c = IndexOfKey(ColumnKeys, ctype + suffix);
                        if (c == -1) return;
                        var p = $"c_{dbField}";
                        contactSets.Add($"{dbField} = @{p}");
                        contactParms[p] = row.GetValue($"Col{c}") ?? "";
                    }

                    // VB6 SaveData 519-524
                    AddContactField("contact", "firstname");
                    AddContactField("phone", "workphone");
                    AddContactField("email", "email");
                    AddContactField("fax", "fax");
                    AddContactField("smsaddress", "smsaddress");
                    AddContactField("cell", "cellphone");

                    // VB6 SaveData 526-535: DelMethod → CommModeID (print 0→1, email 1→3, fax 2→4).
                    int dm = IndexOfKey(ColumnKeys, ctype + "delmethod");
                    if (dm != -1)
                    {
                        var v = (row.GetValue($"Col{dm}") ?? "").Trim();
                        if (v == "0" || v == "1" || v == "2")
                        {
                            contactSets.Add("CommModeID = @CommMode");
                            contactParms["CommMode"] = v switch { "0" => 1, "1" => 3, _ => 4 };
                        }
                    }

                    if (contactSets.Count > 0)
                    {
                        // VB6 SaveData 537-544. ctype comes from the fixed VendorContactTypes
                        // array (never user input), so the {ctype}contactid join is safe.
                        var contactSql = $@"update contacts set {string.Join(", ", contactSets)}
from contacts c
join tblvendors v on c.contactid = v.{ctype}contactid
where v.DivisionID = @DivisionID and v.Vendor_ID = @VendorID";
                        try
                        {
                            await db.ExecuteAsync(contactSql, contactParms);
                        }
                        catch
                        {
                            // VB6 resumes on contact-update errors (SaveData eh);
                            // the migrated FImportVendors kept the silent-continue.
                        }
                    }
                }
            }

            _resultText = $"{total} records imported";
            _resultDetail = _vendorSkippedRows > 0
                ? $"{_vendorSkippedRows} row(s) skipped (blank Vendor ID)"
                : "";
            Stage = WizardStage.ImportResult;
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error during import: {ex.Message}");
            Logger.LogError(ex, "[{Src}RunImportVendorsAsync]", SRCFILE);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // (HHM-440 ExportVendors — the selection-based SELECT * FROM tblVendors
    //  builder, with its 2026-07-22 owner-redesign provenance — moved to
    //  Engine.BuildVendorExportTable.)

    // ────────────────────────── end HHM-440 vendor section ──────────────────────────

    // Build the error grid from a validate-proc result set.
    // rowCol = column index holding the row reference (-1 if none); errorCol = message column.
    private void BuildErrorRows(DataTable errs, int rowCol, int errorCol)
    {
        ErrorRows = new List<ErrorRow>();
        ErrorTotal = errs.Rows.Count;
        int shown = 0;
        foreach (DataRow dr in errs.Rows)
        {
            if (shown >= 25) break; // VB6 shows first 25 (i < 25)
            shown++;
            var rowRef = rowCol >= 0 && rowCol < errs.Columns.Count ? dr[rowCol]?.ToString() ?? "" : "";
            var msg = errorCol < errs.Columns.Count ? dr[errorCol]?.ToString() ?? "" : "";
            ErrorRows.Add(new ErrorRow { RowRef = rowRef, Error = msg });
        }
    }

    // ── VB6-faithful export selection via FPickList (multi-select) ──────────────
    // VB6 ExportAssemblies: ONE FPickList.Choose with THREE named views
    // (Models / Model Specific Options / Global Options), multi-select, "assemblyid" hidden.
    // View 2 is a two-step pick (choose model(s) → choose that model's assemblies — VB6's
    // second FPickList.Choose). VB6 ExportAssemblyTakeoffs: one flat list. DivisionID is a
    // trusted server-side int, inlined like VB6 (HFApp.DivisionID); the only user-derived
    // values (model names for the view-2 IN-list) are single-quote-escaped.
    private async Task OpenExportPickerAsync()
    {
        if (exportPickList == null) return;
        _statusText = "";
        var div = SessionState.DivisionID;

        // ── HHM-440 vendor branch — NEW vendor multi-select picker (2026-07-22
        //    owner redesign; replaces the whole-division dump). Two views modeled
        //    on FVendor's vendor-list picker (Company/Vendor/City/Phone/Trade),
        //    DivisionID-scoped and parameterized via the FPickList parameters
        //    dictionary. The "Vendor" column carries the Vendor_ID used for the
        //    selection-based export SELECT. ──
        if (CurrentMode == ImportExportMode.ExportVendors)
        {
            var vendorQueries =
                "Active Vendors;SELECT Vendor_Name Company, Vendor_ID Vendor, City, Phone, VendorGroupID Trade FROM tblVendors WHERE DivisionID = @DivisionID AND ISNULL(Inactive,0) = 0 ORDER BY Vendor_Name"
                + "|Inactive Vendors;SELECT Vendor_Name Company, Vendor_ID Vendor, City, Phone, VendorGroupID Trade FROM tblVendors WHERE DivisionID = @DivisionID AND Inactive = 1 ORDER BY Vendor_Name";
            await exportPickList.Open("Vendors", vendorQueries, multiSelect: true,
                parameters: new Dictionary<string, object> { ["DivisionID"] = div });
            return;
        }

        if (CurrentMode == ImportExportMode.ExportAssemblies)
        {
            _exportPickStep = 1;
            var models = $"select a.AssemblyID, c.area Community,c.description CommunityDesc,a.Model,a.Assembly,a.Description,a.Series,a.Style from tbldbassemblymaster a left outer join tbllocality c on(a.community=c.area) where a.DivisionID = {div} and isnull(a.inactive,0)=0 and a.assemblytype=0 order by 1,2,3,4,5,6,7";
            var modelOpts = $"select distinct m.Model,m.Description from tbldbassemblymaster o join DistinctModelsByDivision m on o.divisionid=m.divisionid and m.model=o.model where o.assemblytype=2 and isnull(o.inactive,0)=0 and o.divisionid={div}";
            var globalOpts = $"select a.AssemblyID, ct.Description SubCat,c.area Community,c.description CommunityDesc,a.OptionID [Option],a.Assembly,a.Description from tbldbassemblymaster a left outer join tbllocality c on(a.community=c.area) left outer join tblcategories ct on(a.category=ct.category) where a.DivisionID = {div} and isnull(a.inactive,0)=0 and a.assemblytype=3 order by 2,3,4,5,6,7";
            var queries = $"Models;{models}|Model Specific Options;{modelOpts}|Global Options;{globalOpts}";
            await exportPickList.Open("Assemblies", queries, hideColumns: "assemblyid", multiSelect: true);
        }
        else // ExportTakeoffs — single flat list
        {
            var flat = $"select AssemblyTypeDesc AssemblyType,AssemblyID,Community,Model,OptionID,Assembly,Description from tbldbassemblymaster where divisionid={div} and isnull(AssemblyType,0)<>4 and isnull(isbaseassembly,0)=0";
            await exportPickList.Open("Assemblies", flat, hideColumns: "AssemblyID", multiSelect: true);
        }
    }

    // FPickList.OnSelected — the user confirmed a multi-selection.
    private async Task OnExportPicked(List<IDictionary<string, object>> rows)
    {
        if (rows == null || rows.Count == 0) { OnExportPickCancelled(); return; }

        if (CurrentMode == ImportExportMode.ExportTakeoffs
            || CurrentMode == ImportExportMode.ExportVendors)
        {
            // Flat pickers (takeoffs / HHM-440 vendors) → straight to ExportColumns.
            await BeginExportColumnsAsync(rows);
            return;
        }

        // ExportAssemblies
        if (_exportPickStep == 1)
        {
            // SelectedViewIndex 0/1/2 ↔ VB6 SelectedView 1/2/3 → models / options / globals.
            var view = exportPickList?.SelectedViewIndex ?? 0;
            CurrentExportView = view switch
            {
                1 => ExportView.ModelOptions,
                2 => ExportView.GlobalOptions,
                _ => ExportView.Models
            };

            if (CurrentExportView == ExportView.ModelOptions)
            {
                // VB6 view-2 second pick: list the chosen model(s)' assemblies, multi-select.
                var models = rows.Select(r => PickVal(r, "Model"))
                                 .Where(m => !string.IsNullOrWhiteSpace(m))
                                 .Distinct(StringComparer.OrdinalIgnoreCase)
                                 .ToList();
                if (models.Count == 0) { OnExportPickCancelled(); return; }

                var inList = string.Join(",", models.Select(m => "'" + m.Replace("'", "''") + "'"));
                var div = SessionState.DivisionID;
                var sql = $"select a.AssemblyID,c.area Community,c.description CommunityDesc ,a.Model,dm.description ModelDescription,a.Series,a.OptionID [Option],a.Description, ct.Description Category from tbldbassemblymaster a left outer join tbllocality c on(a.community=c.area) left outer join tblcategories ct on(a.category=ct.category) left outer join distinctmodelsbydivision dm on(a.model=dm.model and a.divisionid=dm.divisionid) where a.DivisionID={div} and isnull(a.inactive,0)=0 and a.assemblytype=2 and a.model in({inList}) order by 2,4,6,7";
                _exportPickStep = 2;
                if (exportPickList != null)
                    await exportPickList.Open("Assemblies", sql, hideColumns: "assemblyid", multiSelect: true);
                return;
            }

            // Models / Global Options → the picked assemblies go to ExportColumns.
            await BeginExportColumnsAsync(rows);
            return;
        }

        // step 2 — the per-model assembly pick (CurrentExportView already = ModelOptions).
        await BeginExportColumnsAsync(rows);
    }

    // Selection committed → build the export data NOW (existing query shapes,
    // engines unchanged), derive the default file name from the selection, and
    // advance to the ExportColumns stage (checklist; Next > advances to the save step).
    private async Task BeginExportColumnsAsync(List<IDictionary<string, object>> rows)
    {
        _exportPickStep = 1;
        _exportPicked = rows.Select(r => new ExportPickRow
        {
            Community   = PickVal(r, "Community"),
            Model       = PickVal(r, "Model"),
            // Assemblies views label it "Option"; the ExportTakeoffs flat list uses "OptionID".
            OptionID    = PickVal(r, "Option") is { Length: > 0 } op ? op : PickVal(r, "OptionID"),
            Assembly    = PickVal(r, "Assembly"),
            Description = PickVal(r, "Description"),
            Company     = PickVal(r, "Company")   // HHM-440 vendor picker
        }).ToList();

        IsLoading = true;
        ProgressMessage = $"Building {ModeNoun.ToLowerInvariant()} export…";
        StateHasChanged();
        try
        {
            _exportTable = null;
            _takeoffBytes = null;
            _exportColumns.Clear();

            if (CurrentMode == ImportExportMode.ExportVendors)
            {
                // HHM-440: selection-based (2026-07-22 redesign; dump path removed).
                var vendorIds = rows.Select(r => PickVal(r, "Vendor"))
                                    .Where(v => !string.IsNullOrWhiteSpace(v))
                                    .Distinct(StringComparer.OrdinalIgnoreCase)
                                    .ToList();
                if (vendorIds.Count == 0) { OnExportPickCancelled(); return; }
                _exportTable = Engine.BuildVendorExportTable(SessionState.DivisionID, vendorIds);
            }
            else
            {
                var ids = Engine.ValidIntIds(rows.Select(r => PickVal(r, "AssemblyID")));
                if (ids.Count == 0) { OnExportPickCancelled(); return; }

                if (CurrentMode == ImportExportMode.ExportAssemblies)
                {
                    _exportTable = Engine.BuildAssembliesExportTable(ids, CurrentExportView);
                }
                else
                {
                    // ExportTakeoffs: the fixed template workbook is pre-built here.
                    // The engine also returns the pivoted quantities relabelled as the
                    // ExportSave preview table so the step is not a blank screen; its
                    // columns are structural, so their header checkboxes render disabled.
                    var takeoff = await Engine.BuildTakeoffExportAsync(
                        SessionState.DivisionID, ids, EstimatingTemplatePath("NewAssmImports.xlsx"));
                    _exportTable = takeoff.PreviewTable;
                    _takeoffBytes = takeoff.Bytes;
                    _takeoffExportQtyRows = takeoff.QtyRowCount;
                }
            }

            // Column checklist over the built table — ALL checked by default.
            if (_exportTable != null)
            {
                foreach (DataColumn c in _exportTable.Columns)
                    _exportColumns.Add(new ExportColumnChoice { Name = c.ColumnName, Included = true });
            }

            _exportFileName = BuildDefaultExportFileName();
            _statusText = "";
            Stage = WizardStage.ExportSave;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{Src}BeginExportColumnsAsync]", SRCFILE);
            _statusText = $"Export failed — {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Internal "OK produced no usable selection" fallback (rare — the panel's OK is
    // a no-op on an empty grid selection, so this only guards malformed rows lacking
    // an AssemblyID / Vendor / Model). owner directive 2026-07-23: re-show the INLINE
    // panel by clearing the one-shot latch, so OnAfterRenderAsync re-opens it — the
    // user stays in the flow (this is NOT the panel's Cancel button, which closes the
    // wizard via OnExportPanelCancel).
    private void OnExportPickCancelled()
    {
        _exportPickStep = 1;
        _statusText = "Nothing usable was selected — choose again.";
        _exportPanelOpened = false;   // OnAfterRenderAsync re-opens the inline panel
        Stage = WizardStage.ExportPick;
        StateHasChanged();
    }

    // The inline ExportPick panel's Cancel button (FPickList OnCancel) — HHM-370
    // "Cancel closes the screen". owner directive 2026-07-23: the panel IS page 1 of
    // the export flow (rendered inline, not a dialog), so cancelling the selection
    // closes the wizard page (there is no earlier pick step to fall back to).
    private void OnExportPanelCancel() => ClosePage();

    // owner deployment fix 2026-07-27: build the export workbook bytes in memory
    // WITHOUT writing to disk. Shared by the plain-download and Save-As paths.
    // Returns null when there's nothing to export (matches the old early returns).
    // Strips the deselected columns from a COPY of the built DataTable (same engine,
    // FilerControl.WriteExcel — or a real CSV writer when the user named the file
    // *.csv, HHM-616), or returns the pre-built takeoff-template bytes.
    private (byte[] Bytes, int RecordCount, string ResultDetail)? BuildExportBytes()
    {
        if (Descriptor.IsTakeoffTemplateExport)
        {
            if (_takeoffBytes == null) return null;
            return (_takeoffBytes, _exportPicked.Count, $"{_takeoffExportQtyRows} item quantity row(s)");
        }
        if (_exportTable == null) return null;
        var copy = _exportTable.Copy();
        foreach (var col in _exportColumns.Where(c => !c.Included))
            if (copy.Columns.Contains(col.Name)) copy.Columns.Remove(col.Name);
        if (copy.Columns.Count == 0) return null;
        if (ExportWantsCsv)
        {
            // HHM-616: a ".csv" file name produces a REAL comma-separated file —
            // VB6 FDataExport.ExportData branched on the chosen extension
            // (Case "csv": SaveGrid flexFileCommaText), so the web export must too.
            return (Engine.BuildCsvBytes(copy), copy.Rows.Count, "");
        }
        var sheetName = Descriptor.ExportSheetName;
        using var ms = new MemoryStream();
        Fx.ControlKit.Data.FilerControl.WriteExcel(ms, copy, sheetName);
        return (ms.ToArray(), copy.Rows.Count, "");
    }

    // HHM-616: true when the user-entered file name asks for CSV. VB6's export save
    // dialog (FDataExport.ExportData) offered "Excel|Text (Tab)|CSV" and picked the
    // writer from the chosen extension, so the typed extension drives the format
    // here too. Takeoff exports are excluded — VB6 ExportAssemblyTakeoffs
    // (MAssemblyExport) offered an xlsx-only filter ("Excel Files (*.xlsx)"), the
    // takeoff template is a fixed multi-sheet workbook.
    private bool ExportWantsCsv =>
        !Descriptor.IsTakeoffTemplateExport
        && !string.IsNullOrWhiteSpace(_exportFileName)
        && _exportFileName.Trim().EndsWith(".csv", StringComparison.OrdinalIgnoreCase);

    // Normalize the user-entered file name: a ".csv" name is kept as typed (real CSV
    // export — HHM-616, no more "Name.csv.xlsx" double extension); anything else
    // normalizes to .xlsx (owner spec: the default export is the Excel workbook).
    private string ResolveExportFileName()
    {
        var n = string.IsNullOrWhiteSpace(_exportFileName) ? "export" : _exportFileName.Trim();
        if (ExportWantsCsv) return n;
        return n.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) ? n : n + ".xlsx";
    }

    // HHM-616: the mime that matches ResolveExportFileName's format decision.
    // (The CSV writer itself is Engine.BuildCsvBytes; the mime constants live
    //  on the engine too.)
    private string ResolveExportMime() => ExportWantsCsv
        ? AssemblyImportExportService.CsvMime
        : AssemblyImportExportService.XlsxMime;

    // ExportSave "Download" (footer Next) — owner deployment fix 2026-07-27: the
    // DEFAULT export stashes the built bytes server-side and triggers a real HTTP
    // attachment download (/export/file/{token}), NOT a SignalR-triggered JS blob
    // (the blob approach was flaky in Blazor Server → "exported but no file").
    // On success → ExportResult; on error stay on ExportSave.
    private async Task OnExportDownloadClick()
    {
        try
        {
            var built = BuildExportBytes();
            if (built == null) return;
            var fileName = ResolveExportFileName();
            var token = ExportStash.Put(built.Value.Bytes, fileName, ResolveExportMime());
            await JS.InvokeVoidAsync("hfTriggerDownload", $"/export/file/{token}");
            _exportFileName = fileName;
            _resultDetail = built.Value.ResultDetail;
            _resultText = $"{built.Value.RecordCount} records exported";
            _statusText = "";
            Stage = WizardStage.ExportResult;
            Notifications.Info($"{_resultText}, {_resultDetail}");

            // After download, close the page (or navigate away) matching the behavior of the legacy application.
            ClosePage();
        }
        catch (Exception ex) { Logger.LogError(ex, "[{Src}OnExportDownloadClick]", SRCFILE); _statusText = $"Export failed — {ex.Message}"; }
    }

    // ExportSave "Save As…" (secondary) — owner deployment fix 2026-07-27: stash the
    // built bytes server-side, then fetch them from the real attachment URL and open
    // the browser's Save-As dialog via hfSaveAsFromUrl (File System Access
    // showSaveFilePicker; falls back to a plain download where unsupported). This
    // avoids sending the file over SignalR as a blob. A "cancelled" result means the
    // user dismissed the dialog — stay on the page.
    private async Task OnExportSaveAsClick()
    {
        try
        {
            var built = BuildExportBytes();
            if (built == null) return;
            var fileName = ResolveExportFileName();
            var mime = ResolveExportMime();
            var token = ExportStash.Put(built.Value.Bytes, fileName, mime);
            var res = await JS.InvokeAsync<string>("hfSaveAsFromUrl", $"/export/file/{token}", fileName, mime);
            if (res == "cancelled") return; // user dismissed Save-As — stay on the page
            _exportFileName = fileName;
            _resultDetail = built.Value.ResultDetail;
            _resultText = $"{built.Value.RecordCount} records exported";
            _statusText = "";
            Stage = WizardStage.ExportResult;
            Notifications.Info($"{_resultText}, {_resultDetail}");

            // After download, close the page (or navigate away) matching the behavior of the legacy application.
            ClosePage();
        }
        catch (Exception ex) { Logger.LogError(ex, "[{Src}OnExportSaveAsClick]", SRCFILE); _statusText = $"Export failed — {ex.Message}"; }
    }

    // Default file name = what the user selected (owner spec): a single
    // selection uses its own name (assembly/model name, or the vendor's
    // company name); multiple selections use the plural noun
    // ("Assemblies.xlsx" / "Takeoffs.xlsx" / "Vendors.xlsx").
    private string BuildDefaultExportFileName()
    {
        string baseName;
        if (_exportPicked.Count == 1)
        {
            var p = _exportPicked[0];
            baseName = CurrentMode == ImportExportMode.ExportVendors
                ? FirstNonEmpty(p.Company, p.Description, p.Assembly)
                : FirstNonEmpty(p.Assembly, p.Model, p.Description);
        }
        else
        {
            baseName = ExportPluralNoun;
        }

        baseName = SanitizeFileName(baseName);
        if (string.IsNullOrWhiteSpace(baseName)) baseName = ExportPluralNoun;
        return baseName + ".xlsx";
    }

    private static string FirstNonEmpty(params string[] values)
        => values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? "";

    // Replace filesystem-invalid characters so the selection's display name is
    // always a legal file name.
    private static string SanitizeFileName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        var invalid = Path.GetInvalidFileNameChars();
        var sb = new StringBuilder(name.Length);
        foreach (var ch in name)
            sb.Append(invalid.Contains(ch) ? '_' : ch);
        return sb.ToString().Trim().TrimEnd('.');
    }

    // FPickList rows come back as dictionaries; pull a column case-insensitively.
    private static string PickVal(IDictionary<string, object> row, string key)
    {
        if (row == null) return "";
        if (row.TryGetValue(key, out var v) && v != null) return v.ToString() ?? "";
        foreach (var kv in row)
            if (string.Equals(kv.Key, key, StringComparison.OrdinalIgnoreCase))
                return kv.Value?.ToString() ?? "";
        return "";
    }

