    // Folded FImportAssemblies parse core (ImportModelsOptions / ImportItems).
    // owner directive 2026-07-23: refactored verbatim from the old
    // OnFileSelectedModelsImport(InputFileChangeEventArgs) — the source is now a
    // byte[] read from the server path (fed through a MemoryStream) rather than
    // IBrowserFile.OpenReadStream(). Extension is the picked file's (".csv" vs
    // workbook), passed in without the leading dot.
    private async Task ParseModelsImportFromBytes(byte[] bytes, string ext, string fileName)
    {
        IsLoadingModelsImport = true;
        StatusMessage = "Loading file...";
        StateHasChanged();

        try
        {
            FileName = fileName;
            Messages.Clear();

            if (ext == "csv")
            {
                // 2026-07-22 redesign: CSV support. Parse the delimited text into
                // the same 1-based matrix shape LoadSheetToMatrix produces for the
                // "Assemblies" worksheet (a CSV carries only that sheet — the
                // Phases/Categories matrices stay empty), then run the identical
                // downstream parse/validate pipeline.
                using var stream = new MemoryStream(bytes);
                using var reader = new StreamReader(stream);
                var content = await reader.ReadToEndAsync();
                var matrix = DelimitedSheetToMatrix(Engine.DelimitedToSheet(content, ','));
                await ParseLoadedMatrices(matrix, new List<List<string>>(), new List<List<string>>());
            }
            else
            {
                // ── HHM-557: sniff the workbook container before handing it to
                //    ClosedXML. A legacy BIFF .xls (OLE compound signature
                //    D0 CF 11 E0 A1 B1 1A E1, the VB6 VSFlexGrid SaveGrid
                //    flexFileExcel output — FDataExport.frm:164-168) is routed
                //    through ExcelDataReader; PK-zip .xlsx keeps the existing
                //    ClosedXML ParseWorkbook path. ──
                try
                {
                    if (Engine.IsOleCompoundFile(bytes))
                    {
                        await ParseLegacyXlsWorkbook(bytes);
                    }
                    else
                    {
                        using var memoryStream = new MemoryStream(bytes);
                        memoryStream.Position = 0;
                        await ParseWorkbook(memoryStream);
                    }
                }
                catch (Exception ex) when (ex is not OutOfMemoryException)
                {
                    // HHM-557 (3): fatal message (outer catch -> AddMsg level 0)
                    // must name the detected workbook format.
                    throw new InvalidDataException(Engine.DescribeWorkbookReadFailure(bytes, ex), ex);
                }
            }

            FileLoaded = true;
            // VB6 Form_Load selects the Assemblies tab after loading; ValidateData()
            // then switches to Messages if any errors are found.
            SelectTabByName("Assemblies");

            await ValidateData();

            // Parse + verify done — the wizard is already ON ImportValidate
            // (owner import-wizard spec 2026-07-23), which shows the header-info
            // counts + message list outcome; Next > advances to the tabbed preview.
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error loading file: {ex.Message}";
            AddMsg(0, $"Error loading file: {ex.Message}");
            // owner import-wizard spec 2026-07-23: a FATAL outcome on the
            // ImportValidate page — recount so the Next > gate (ErrorCount) holds.
            ErrorCount = Messages.Count(m => m.Level == 0);
        }
        finally
        {
            IsLoadingModelsImport = false;
            StateHasChanged();
        }
    }

    // Convert a DelimitedToSheet result (0-based rows/cols) into the 1-based
    // matrix LoadSheetToMatrix builds (row 0 = placeholder, col 0 = placeholder),
    // so the folded FImportAssemblies pipeline runs unchanged over CSV input.
    private static List<List<string>> DelimitedSheetToMatrix(List<List<string>> sheet)
    {
        var matrix = new List<List<string>> { new List<string>() };
        foreach (var cells in sheet)
        {
            var rowList = new List<string>(cells.Count + 1) { "" };
            rowList.AddRange(cells);
            matrix.Add(rowList);
        }
        return matrix;
    }

    private List<List<string>> LoadSheetToMatrix(IXLWorksheet worksheet)
    {
        var matrix = new List<List<string>>();
        
        // Add row 0 (empty headers or placeholders)
        matrix.Add(new List<string>());
        
        var lastRow = worksheet.LastRowUsed()?.RowNumber() ?? 0;
        var lastCol = worksheet.LastColumnUsed()?.ColumnNumber() ?? 0;
        
        for (int r = 1; r <= lastRow; r++)
        {
            var rowList = new List<string>();
            rowList.Add(""); // column 0 is empty (row numbers)
            
            var xlRow = worksheet.Row(r);
            for (int c = 1; c <= lastCol; c++)
            {
                var cell = xlRow.Cell(c);
                rowList.Add(cell.Value.ToString() ?? "");
            }
            matrix.Add(rowList);
        }
        
        return matrix;
    }

    private string GetCellText(List<List<string>> matrix, int row, int col)
    {
        if (row < 0 || row >= matrix.Count) return "";
        var rowData = matrix[row];
        if (col < 0 || col >= rowData.Count) return "";
        return rowData[col]?.Trim() ?? "";
    }
    
    private double GetCellDouble(List<List<string>> matrix, int row, int col)
    {
        var text = GetCellText(matrix, row, col);
        if (double.TryParse(text, out var val)) return val;
        return 0;
    }

