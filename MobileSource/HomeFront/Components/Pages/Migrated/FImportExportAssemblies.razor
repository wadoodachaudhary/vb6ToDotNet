    }

    // Build the DISPLAY-capped lists the merged review page's grids/tabs bind (first 100
    // rows). The full parsed sets stay untouched for the commit engines. Called at the end
    // of OnImportNextClick so the ImportValidate review page shows validation AND preview
    // together (owner directive 2026-07-27 — the former separate ImportPreview step is
    // folded into ImportValidate; there is no longer a Validate→Preview hop).
    private void BuildImportPreviewDisplayLists()
    {
        _gridDataDisplay = GridData.Count > PreviewDisplayCap ? GridData.Take(PreviewDisplayCap).ToList() : GridData;
        _assemblyGridDisplay = AssemblyGridData.Count > PreviewDisplayCap ? AssemblyGridData.Take(PreviewDisplayCap).ToList() : AssemblyGridData;
        _phaseGridDisplay = PhaseGridData.Count > PreviewDisplayCap ? PhaseGridData.Take(PreviewDisplayCap).ToList() : PhaseGridData;
        _categoryGridDisplay = CategoryGridData.Count > PreviewDisplayCap ? CategoryGridData.Take(PreviewDisplayCap).ToList() : CategoryGridData;
        // Errors sort first (Level 0), so the cap never hides an error behind warnings/info.
        _messagesDisplay = Messages.OrderBy(m => m.Level).Take(PreviewDisplayCap).ToList();
    }

