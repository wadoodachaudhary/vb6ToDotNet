    {
        FileName = "";
        TemplateVersion = "";
        Community = "";
        CommunityDesc = "";
        CommunityPhase = "";
        ModelCount = 0;
        ItemCount = 0;
        PhaseCount = 0;
        ErrorCount = 0;
        WarningCount = 0;
        InfoMsgCount = 0;
        SaveCommunity = true;
        Messages.Clear();
        AssemblyGridData.Clear();
        PhaseGridData.Clear();
        CategoryGridData.Clear();
        ItemGridData.Clear();
        AssemblyDetailData.Clear();
        AssemblyMatrix = new();
