            var items = new List<TabStripItem>();
            if (Messages.Any())
                items.Add(new TabStripItem { Text = $"Messages ({Messages.Count})" });
            items.Add(new TabStripItem { Text = "Assemblies" });
            items.Add(new TabStripItem { Text = "Phases" });
            if (AssemblyType != AssemblyTypes.atModel)
                items.Add(new TabStripItem { Text = "Categories" });
            return items;
        }
    }

    // Resolve the active tab's logical name from the (dynamic) tab list.
    private string ActiveTabName
    {
        get
        {
            var items = TabItems;
            if (SelectedTabIndex < 0 || SelectedTabIndex >= items.Count) return "Assemblies";
            var text = items[SelectedTabIndex].Text;
            if (text.StartsWith("Messages")) return "Messages";
            return text;
        }
    }

    private void OnTabSelected(int idx)
    {
        SelectedTabIndex = idx;
    }

    // Select a tab by logical name (mirrors VB6 TabStrip.Tabs(n).Selected = True).
    private void SelectTabByName(string name)
    {
        var items = TabItems;
        for (int i = 0; i < items.Count; i++)
        {
            var t = items[i].Text;
            if ((name == "Messages" && t.StartsWith("Messages")) || t == name)
            {
                SelectedTabIndex = i;
                return;
            }
        }
        SelectedTabIndex = 0;
    }

