    }

    // Page-3 "< Previous" (ImportValidate → ImportPickFile). Pure Stage flip —
    // the picked path is kept (the browser re-opens on its folder with the file
    // still selected); the parse pipeline re-runs from a clean slate on the
    // next page-2 Next > click.
    private void BackToImportPickFile()
