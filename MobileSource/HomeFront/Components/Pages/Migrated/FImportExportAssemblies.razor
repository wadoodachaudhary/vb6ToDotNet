@page "/assembly-import-export"
@page "/assembly-import-export/{Mode}"
@rendermode InteractiveServer
@namespace HomeFront.Components.Pages
@layout HFComponent

@using System
@using System.Data
@using System.Dynamic
@using System.Collections.Generic
@using System.Linq
@using System.IO
@using System.Text
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using HomeFront.Data
@using HomeFront.Services
@using HomeFront.Models
@using Microsoft.Data.SqlClient
@using ClosedXML.Excel

@inject NavigationManager NavigationManager
@inject ILogger<FImportExportAssemblies> Logger
@inject NotificationService Notifications
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject HomeFront.Services.ExportFileStash ExportStash
@inject HomeFront.Services.AssemblyImportExportService Engine

@*
    ──────────────────────────────────────────────────────────────────────────
    UNIFIED Import/Export form. A rename + mode-consolidation of two forms:

      • FAssemblyImport.razor  (BASE) — VB6 HFEst/Source/FAssemblyImport.frm
        (+ MAssemblyImport.bas / "MAssemblyExport"). Stored-proc-based "Data
        Import Wizard" for assemblies + the ClosedXML export writer.
        Modes: ImportAssemblies, ImportTakeoffs, ExportAssemblies, ExportTakeoffs.

      • FImportAssemblies.razor (FOLDED IN, verbatim) — the legacy import
        pipeline (ClosedXML read, AppOptions, CalcPreTax/CalcTax,
        WriteAssemblies/WritePhases/FixGroupPhaseValue, validation parity).
        Its old [Parameter] string ImportMode "Assembly"/"Items" maps onto the
        two new enum modes ImportModelsOptions / ImportItems; the internal
        ImportMode string property re-derives "Assembly"/"Items" so every line
        of folded code runs against its original value.

      • HHM-440 — Vendor modes (FOLDED IN): ImportVendors / ExportVendors.
        Import = VB6 HFSystem FImportVendors.frm (the vendor import wizard
        FVendor's "ExcelImport" toolbar button launched; ReadText 355-425,
        SaveData 468-563). Export = VB6 FVendor "ExcelExport" →
        HFApp.RunTask("ExportData|select * from tblVendors where divisionid=N").
        All vendor-specific rules live in clearly-delimited HHM-440 branches —
        follow the same per-mode pattern to fold in future import/exports.

    All load/parse/validate/save/Excel/recalc/message logic from BOTH forms is
    preserved verbatim. On genuine identifier collisions the folded
    (FImportAssemblies) member is suffixed "ModelsImport"; behavior unchanged:
      • OnFileSelected            -> OnFileSelectedModelsImport
      • IsLoading (overlay)       -> shared; folded code uses IsLoadingModelsImport
    ──────────────────────────────────────────────────────────────────────────
*@

<PageTitle>Data Import / Export Wizard - HomeFront</PageTitle>

@* ── Loading overlay for the BASE modes — brief, during the import read / export build.
   The landing page (with its inconspicuous status line) shows behind it. *@
@if (IsLoading)
{
    <div style="position:fixed; inset:0; z-index:2000; background:rgba(255,255,255,0.6); display:flex; align-items:center; justify-content:center;">
        <div style="background:#fff; border:1px solid #ced4da; border-radius:6px; padding:18px 26px; box-shadow:0 8px 28px rgba(0,0,0,0.18); font-weight:600;">
            @ProgressMessage
        </div>
    </div>
}

@* ── Loading overlay for the FOLDED (FImportAssemblies) modes ─────────────── *@
@if (IsLoadingModelsImport)
{
    <div class="loading-overlay">
        <div class="loading-spinner">@StatusMessage</div>
    </div>
}

@* ══════════════════════════════════════════════════════════════════════════
   WizardStage state machine — 2026-07-22 owner UX redesign, corrected
   2026-07-23 (v2 owner feedback after live testing).

   The wizard is an explicit staged flow that WRAPS the unchanged import/
   export engines (all SQL / parsing / validation / Excel writers preserved):

     ImportPickType  – step 1 of 5: the file-type radio list ONLY (owner
                       import-wizard spec 2026-07-23)
     ImportPickFile  – step 2 of 5: the server-FS file browser, grown to
                       fill the card (export page-1 picklist pattern)
     ImportValidate  – step 3 of 5: parse + validation OUTCOME (the pipeline
                       runs on the page-2 Next >); Next gated on fatal errors
     ImportPreview   – step 4 of 5: parsed preview, display-capped to the
                       first 100 rows; Next > RUNS the import
     ImportResult    – step 5 of 5: "{N} records imported"; Import Again / Close
     ExportPick      – step 1: Select…/Next > opens the selection picker
     ExportColumns   – step 2: column checklist; Next > advances to save
     ExportResult    – final: "{N} records exported"; Export Again / Close

   v2 (2026-07-23): there is NO central landing page. Each mode's flow starts
   and ends on ITS OWN first stage: "Import Again" / "Export Again" reset the
   state and return to the SAME mode's first page — a pure Stage flip on this
   mounted component, with NO route/MDI navigation, no ParentNavigate, no
   ClosePage (the v1 Landing return escaped the page under FMain). A minimal
   mode-chooser renders ONLY for the bare route (no {Mode} param); it is not
   part of any flow and no button returns to it. Chrome follows the app's
   FMassChange wizard idiom (fx-shared wizard-container/-header/-body/-footer,
   VB6 WizHead style) with the button row directly below the content.

   owner import-wizard spec 2026-07-23 (import restaging): the IMPORT side is
   now the FIVE-page staged wizard above, matching the export side's v5
   conventions — NO Cancel buttons anywhere in the flow (the MDI tab close /
   < Previous are the exits; page 1 has no Previous), footer bottom-right via
   .aimp-wiz-footer, and "Import Again" resets in place with no navigation.
   The parse/validate trigger moved from the old page-1 Next to the page-2→3
   transition; the preview grids bind display lists capped at 100 rows while
   the commit engines keep iterating the FULL parsed sets.

   SUPERSEDED earlier (v1) and still removed: the _pendingAutoOpen /
   _pendingExportPickOpen auto-open latches (VB6 Form_Load parity), the
   HHM-369 close-page-on-export-success behavior, and the whole-division
   Export Vendors dump (now selection-based).
   ══════════════════════════════════════════════════════════════════════════ *@
<div class="wizard-container aimp-wiz">

    @* owner directive 2026-07-23: the browser <InputFile> upload (opened via the
       hfPickFileWithCancel JS click) was removed. Import now reads the file the
       user picks in a server-FS FileBrowserControl (VB6-faithful local file open
       dialog); see the ImportPickFile stage below. *@

    @* ── Wizard header band (FMassChange / VB6 WizHead idiom: title + tagline
         left, step indicator right). ── *@
    <div class="wizard-header aimp-wiz-header">
        <div class="aimp-wiz-header-left">
            <h3>Data Import / Export Wizard</h3>
            <p>@WizardDescription</p>
        </div>
        @if (CurrentMode != ImportExportMode.None)
        {
            <div class="aimp-step-indicator">@StepIndicator</div>
        }
    </div>

    <div class="wizard-body aimp-wiz-body">

        @if (CurrentMode == ImportExportMode.None)
        {
            @* ── Bare-route mode-chooser FALLBACK ONLY (no {Mode} in the route —
                 e.g. the legacy alias routes). Deliberately minimal and OUTSIDE
                 the wizard flow: deep-launched modes never see it and no stage
                 button returns here (v2 owner correction — no central landing). *@
            <div class="step-title">Choose an operation</div>
            <div class="step-description">Select the import or export you want to run.</div>
            <div class="aimp-mode-grid">
                <ButtonControl OnClick="@(() => SetMode(ImportExportMode.ImportModelsOptions))">Import models and options</ButtonControl>
                <ButtonControl OnClick="@(() => SetMode(ImportExportMode.ImportItems))">Import items</ButtonControl>
                <ButtonControl OnClick="@(() => SetMode(ImportExportMode.ImportAssemblies))">Import Assemblies</ButtonControl>
                <ButtonControl OnClick="@(() => SetMode(ImportExportMode.ImportTakeoffs))">Import Assembly Takeoffs</ButtonControl>
                <ButtonControl OnClick="@(() => SetMode(ImportExportMode.ExportAssemblies))">Export Assemblies</ButtonControl>
                <ButtonControl OnClick="@(() => SetMode(ImportExportMode.ExportTakeoffs))">Export Assembly Takeoffs</ButtonControl>
                @* HHM-440: vendor modes (VB6 FImportVendors.frm / FVendor "ExcelExport") *@
                <ButtonControl OnClick="@(() => SetMode(ImportExportMode.ImportVendors))">Import Vendors</ButtonControl>
                <ButtonControl OnClick="@(() => SetMode(ImportExportMode.ExportVendors))">Export Vendors</ButtonControl>
            </div>
        }
        else if (Stage == WizardStage.ImportPickType)
        {
            @* ── STEP 1 of 5 (import) — owner import-wizard spec 2026-07-23: the
                 file-TYPE radio list is a page of its OWN (only what THIS mode can
                 read: Excel default + CSV; + QuickBooks for ImportVendors).
                 No file browser here — it moved to page 2.
                 HHM-587: the PDF radio was removed — no legacy import accepts PDF
                 (VB6 FAssemblyImport.frm 142/247 filter is *.xlsx;*.xls;*.csv;
                 FImportAssemblies.frm 845 is *.xls*; FImportVendors.frm 260 is
                 xls/iif/txt/csv), so the wizard no longer offers it. ── *@
            @StepHeader($"Import {ModeNoun}", $"{WizardDescription} Choose the type of file to import, then click Next >.")

            <div class="aimp-radio-row" role="radiogroup" aria-label="File type">
                <RadioControl TValue="ImportFileType" Name="aimpFileType" Label="Excel (.xls, .xlsx)"
                              Value="ImportFileType.Excel" @bind-SelectedValue="_importFileType" />
                <RadioControl TValue="ImportFileType" Name="aimpFileType" Label="CSV (.csv)"
                              Value="ImportFileType.Csv" @bind-SelectedValue="_importFileType" />
                @if (Descriptor.OffersQuickBooks)
                {
                    @* HHM-440: QuickBooks vendor lists (VB6 FImportVendors ShowForm file filter). *@
                    <RadioControl TValue="ImportFileType" Name="aimpFileType" Label="QuickBooks (.iif, .txt)"
                                  Value="ImportFileType.QuickBooks" @bind-SelectedValue="_importFileType" />
                }
            </div>

            @* HHM-587: the PDF "not available" note left with the PDF radio; the
               ImportFileType.Pdf guards below stay as dead-safe defense only. *@
        }
        else if (Stage == WizardStage.ImportPickFile)
        {
            @* ── STEP 2 of 5 (import) — owner import-wizard spec 2026-07-23: the
                 server-FS FileBrowserControl IS the page content, grown to fill
                 the card exactly like the export page-1 picklist (the
                 .aimp-picker-wrap flex pattern via its sibling class
                 .aimp-browser-fill; Height is cleared so the flex fill governs).
                 The Accept filter is driven by the page-1 radio; Next > (footer)
                 is enabled only once a FILE (not a directory) is selected.
                 Server-FS explorer rationale unchanged: this app is a per-user/
                 local VB6 desktop replacement, so the server filesystem IS the
                 user's — the VB6-faithful local file open dialog. ── *@
            @StepHeader($"Import {ModeNoun} — choose file", "Pick the file to import below, then click Next >.")

            <div class="aimp-browser-fill">
                @* owner deployment fix 2026-07-27: the server-FS FileBrowserControl
                   only worked when server==client (local dev). Deployed web users
                   can't reach their own machine, so the file now comes from the
                   browser via a full-panel drag-drop / click-to-browse <InputFile>
                   (a file DROPPED on the overlaid transparent input fires OnChange
                   too). No server browsing. *@
                <div class="aimp-dropzone" id="aimpImportDropzone">
                    <div class="aimp-dropzone-inner">
                        <svg class="aimp-dropzone-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19 15v4H5v-4H3v6h18v-6h-2zM11 3v9.17l-2.59-2.58L7 11l5 5 5-5-1.41-1.41L13 12.17V3h-2z"/></svg>
                        <div class="aimp-dropzone-title">Drag your @ModeNoun file here</div>
                        <div class="aimp-dropzone-sub">or <span class="aimp-dropzone-browse">click to browse</span></div>
                        @if (!string.IsNullOrEmpty(_importFileName))
                        {
                            <div class="aimp-dropzone-file">@_importFileName</div>
                        }
                    </div>
                    @* id lets the JS drop-handler (hfImportDropzone.attach) route a dropped
                       file onto this input and dispatch 'change' so Blazor's OnChange fires. *@
                    <InputFile class="aimp-dropzone-input" id="aimpImportInput" OnChange="OnImportFileSelected" accept="@ImportFileAccept" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_importFileName))
            {
                <p class="aimp-status"><strong>Selected file:</strong> @_importFileName</p>
            }
            @if (!string.IsNullOrEmpty(_statusText))
            {
                <p class="aimp-status">@_statusText</p>
            }
        }
        else if (Stage == WizardStage.ImportValidate && IsModelsImportMode)
        {
            @* ── STEP 3 of 5 (import, FOLDED models/items modes) — owner
                 import-wizard spec 2026-07-23: the validation OUTCOME page. The
                 parse + verify pipeline ran on the page-2 Next click; this page
                 shows the FImportAssemblies header-info counts (Assemblies /
                 Items / Phases / Errors / Warnings) plus the error/warning list,
                 or the success state. Next (footer) is disabled while
                 ErrorCount > 0. ── *@
            <div class="import-container">
                @StepHeader($"Import {ModeNoun} — review")

                <!-- Header Info -->
                <div class="header-panel">
                    <div class="header-left">
                        <div class="field-row">
                            <label>File Name:</label>
                            <span class="field-value">@FileName</span>
                        </div>
                        <div class="field-row">
                            <label>Assemblies:</label>
                            <span class="field-value">@ModelCount</span>
                        </div>
                        <div class="field-row">
                            <label>Items:</label>
                            <span class="field-value">@ItemCount</span>
                        </div>
                        <div class="field-row">
                            <label>Phases:</label>
                            <span class="field-value">@PhaseCount</span>
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        @if (ErrorCount > 0)
                        {
                            <div class="field-row">
                                <label>Errors:</label>
                                <span class="field-value error">@ErrorCount</span>
                            </div>
                        }
                        @if (WarningCount > 0)
                        {
                            <div class="field-row">
                                <label>Warnings:</label>
                                <span class="field-value bold">@WarningCount</span>
                            </div>
                        }
                    </div>

                    <div class="header-right">
                        @* VB6 chkSaveCommunity — only relevant for Assembly import (controls
                           Community on assemblies). Lives on the validation page because
                           toggling it re-runs ValidateData (the duplicate check changes). *@
                        @if (ImportMode == "Assembly")
                        {
                            <div style="margin-top: 8px;">
                                <CheckBoxControl Checked="SaveCommunity" CheckedChanged="OnSaveCommunityChanged"
                                                 Label="Save Community on Assemblies?" />
                            </div>
                        }
                    </div>
                </div>

                <!-- Status -->
                @if (!string.IsNullOrEmpty(StatusMessage))
                {
                    <div class="status-label">@StatusMessage</div>
                }

                <!-- Status icon indicator (VB6 imgIconError / imgIconWarning / imgIconInfo) -->
                <div class="status-icon-row">
                    @if (ErrorCount > 0)
                    {
                        <span class="icon-error">&#9888;</span>
                        <span style="color: red; font-weight: 600;">Errors found - cannot import</span>
                    }
                    else if (WarningCount > 0)
                    {
                        <span class="icon-warning">&#9888;</span>
                        <span style="color: #b8860b; font-weight: 600;">Warnings found - review before importing</span>
                    }
                    else
                    {
                        <span class="icon-info">&#8505;</span>
                        <span style="color: #0078d7;">Ready to import</span>
                    }
                </div>

                @* Preview + validation together (owner directive 2026-07-27): the header /
                   status above is the validation verdict; the tabs below hold the parsed
                   data and the full message list (Messages tab). Each grid binds a DISPLAY
                   list capped at the first 100 rows — the commit engines iterate the FULL
                   parsed sets. (Folded here from the former separate ImportPreview step.) *@
                <TabStripControl Items="@TabItems" SelectedIndex="@SelectedTabIndex" SelectedIndexChanged="OnTabSelected" />

                <div class="tab-content">
                    @if (ActiveTabName == "Messages")
                    {
                        @if (Messages.Count > PreviewDisplayCap)
                        {
                            <div class="aimp-cap-note">Showing first @PreviewDisplayCap of @Messages.Count rows.</div>
                        }
                        <div style="max-height: 400px; overflow-y: auto; padding: 4px;">
                            @foreach (var msg in _messagesDisplay)
                            {
                                <div class="msg-row @(msg.Level == 0 ? "error-msg" : msg.Level == 1 ? "warn-msg" : "info-msg")">
                                    <span class="msg-icon">
                                        @(msg.Level == 0 ? "❌" : msg.Level == 1 ? "⚠️" : "ℹ️")
                                    </span>
                                    <span>@msg.Text</span>
                                </div>
                            }
                            @if (!Messages.Any())
                            {
                                <div style="padding: 20px; text-align: center; color: #999;">No messages</div>
                            }
                        </div>
                    }
                    else if (ActiveTabName == "Assemblies")
                    {
                        @if (AssemblyGridData.Count > PreviewDisplayCap)
                        {
                            <div class="aimp-cap-note">Showing first @PreviewDisplayCap of @AssemblyGridData.Count rows.</div>
                        }
                        <GridControl TValue="AssemblyGridRow"
                                DataSource="@_assemblyGridDisplay"
                                AllowSorting="true"
                                AllowResizing="true"
                                AllowSelection="true"
                                Height="400px">
                            <GridColumnsBase>
                                <GridColumn Field="@nameof(AssemblyGridRow.AssemblyID)" HeaderText="Assembly ID" Width="120px" />
                                <GridColumn Field="@nameof(AssemblyGridRow.Description)" HeaderText="Description" Width="200px" />
                                <GridColumn Field="@nameof(AssemblyGridRow.ModelAssemblyID)" HeaderText="Model" Width="120px" />
                                <GridColumn Field="@nameof(AssemblyGridRow.OptionAssemblyID)" HeaderText="Option" Width="120px" />
                                <GridColumn Field="@nameof(AssemblyGridRow.Series)" HeaderText="Series" Width="100px" />
                                <GridColumn Field="@nameof(AssemblyGridRow.SalesCategory)" HeaderText="Category" Width="100px" />
                                <GridColumn Field="@nameof(AssemblyGridRow.SellingPretax)" HeaderText="Pretax" Format="C2" Width="100px" TextAlign="TextAlign.Right" Type="ColumnType.Number" />
                                <GridColumn Field="@nameof(AssemblyGridRow.SellingTaxIncl)" HeaderText="Tax Incl" Format="C2" Width="100px" TextAlign="TextAlign.Right" Type="ColumnType.Number" />
                                <GridColumn Field="@nameof(AssemblyGridRow.Notes)" HeaderText="Notes" Width="200px" />
                            </GridColumnsBase>
                        </GridControl>
                    }
                    else if (ActiveTabName == "Phases")
                    {
                        @if (PhaseGridData.Count > PreviewDisplayCap)
                        {
                            <div class="aimp-cap-note">Showing first @PreviewDisplayCap of @PhaseGridData.Count rows.</div>
                        }
                        <GridControl TValue="PhaseGridRow"
                                DataSource="@_phaseGridDisplay"
                                AllowSorting="true"
                                AllowResizing="true"
                                AllowSelection="true"
                                Height="400px">
                            <GridColumnsBase>
                                <GridColumn Field="@nameof(PhaseGridRow.Phase)" HeaderText="Phase" Width="120px" />
                                <GridColumn Field="@nameof(PhaseGridRow.GroupPhase)" HeaderText="Group Phase" Width="120px" />
                                <GridColumn Field="@nameof(PhaseGridRow.Description)" HeaderText="Description" Width="300px" />
                            </GridColumnsBase>
                        </GridControl>
                    }
                    else if (ActiveTabName == "Categories")
                    {
                        @if (CategoryGridData.Count > PreviewDisplayCap)
                        {
                            <div class="aimp-cap-note">Showing first @PreviewDisplayCap of @CategoryGridData.Count rows.</div>
                        }
                        <GridControl TValue="CategoryGridRow"
                                DataSource="@_categoryGridDisplay"
                                AllowSorting="true"
                                AllowResizing="true"
                                AllowSelection="true"
                                Height="400px">
                            <GridColumnsBase>
                                <GridColumn Field="@nameof(CategoryGridRow.Category)" HeaderText="Category" Width="120px" />
                                <GridColumn Field="@nameof(CategoryGridRow.Description)" HeaderText="Description" Width="200px" />
                                <GridColumn Field="@nameof(CategoryGridRow.MajorGroup)" HeaderText="Major Group" Width="120px" />
                                <GridColumn Field="@nameof(CategoryGridRow.MajorGroupDesc)" HeaderText="Group Desc" Width="200px" />
                            </GridColumnsBase>
                        </GridControl>
                    }
                </div>

                @if (ProgressValue > 0)
                {
                    <div class="progress-row">
                        <ProgressBarControl Value="@ProgressValue" Status="@StatusMessage" ShowPercent="true" />
                    </div>
                }
            </div>
        }
        else if (Stage == WizardStage.ImportValidate)
        {
            @* ── STEP 3 of 5 (import, BASE modes) — owner import-wizard spec
                 2026-07-23: the validation OUTCOME page. The parse pipeline ran on
                 the page-2 Next click; this page shows the file info line plus the
                 fatal/warning errors panel (fatal ❌ red disables Next; warnings ⚠️
                 amber don't), or the success state. File-read failures surface here
                 as a fatal error too. ── *@
            @StepHeader($"Import {ModeNoun} — review")

            <div class="aimp-file-info">
                <strong>File:</strong> @mFilename
                @if (!string.IsNullOrEmpty(mFileType))
                {
                    <span style="margin-left:14px;"><strong>Detected type:</strong> @mFileType</span>
                }
            </div>

            @if (ErrorRows.Count > 0)
            {
                <div class="aimp-errors-panel">
                    <div class="aimp-errors-title @(HasFatalErrors ? "fatal" : "")">
                        @if (HasFatalErrors)
                        {
                            <text>This file cannot be imported.</text>
                            @if (ErrorTotal > ErrorRows.Count)
                            {
                                <text> Showing the first @ErrorRows.Count of @ErrorTotal problems.</text>
                            }
                        }
                        else
                        {
                            <text>Review these warnings before importing.</text>
                        }
                    </div>
                    @foreach (var err in ErrorRows)
                    {
                        <div class="aimp-error-row @(err.IsWarning ? "warn" : "fatal")">
                            <span class="aimp-error-icon">@(err.IsWarning ? "⚠️" : "❌")</span>
                            @if (!string.IsNullOrEmpty(err.RowRef))
                            {
                                <span class="aimp-error-ref">@err.RowRef</span>
                            }
                            <span>@err.Error</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="aimp-ready">No problems found — @GridData.Count rows ready to import.</div>
            }

            @* Preview grid (owner directive 2026-07-27 — merged with validation, folded
               here from the former separate ImportPreview step). Bound to a DISPLAY list
               capped at the first 100 rows; the import commits the FULL GridData set. *@
            @if (GridData.Count > PreviewDisplayCap)
            {
                <div class="aimp-cap-note">Showing first @PreviewDisplayCap of @GridData.Count rows.</div>
            }
            @if (GridColumns.Count > 0)
            {
                <div class="aimp-grid-wrap">
                    <GridControl @ref="DataGrid"
                            TValue="ImportRow"
                            DataSource="@_gridDataDisplay"
                            AllowSorting="true"
                            AllowResizing="true"
                            AllowSelection="true"
                            EnableHover="true"
                            Height="380px"
                            PageSettingsRef="@pageSettings">
                        <GridColumnsBase>
                            @foreach (var col in GridColumns)
                            {
                                <GridColumn Field="@col.Field" HeaderText="@col.HeaderText"
                                            Width="@col.Width" AllowEditing="false"
                                            IsPrimaryKey="@col.IsPrimaryKey" Visible="@col.Visible" />
                            }
                        </GridColumnsBase>
                    </GridControl>
                </div>
            }
        }
        else if (Stage == WizardStage.ImportResult)
        {
            @* ── STEP 5 of 5 (import) — "{N} records imported" + detail counts;
                 "Import Again" fully resets and returns to THIS mode's
                 ImportPickType (no navigation — owner import-wizard spec
                 2026-07-23). ── *@
            @StepHeader($"Import {ModeNoun} — finished")
            <div class="aimp-result">
                <div class="aimp-result-main">@_resultText</div>
                @if (!string.IsNullOrEmpty(_resultDetail))
                {
                    <div class="aimp-result-detail">@_resultDetail</div>
                }
            </div>
        }
        else if (Stage == WizardStage.ExportPick)
        {
            @* ── STEP 1 (export) — owner directive 2026-07-23: the selection IS the
                 content of this page, rendered INLINE as an FPickList in Panel mode
                 (no dialog popup, no Select…/Open button). OpenExportPickerAsync (called
                 once from OnAfterRenderAsync when this stage first shows) populates the
                 SAME VB6-faithful views — assemblies 3-view/2-step; takeoffs flat list;
                 vendors Company/Vendor multi-select — but the panel renders them inline.
                 The panel's own OK/Cancel drive the flow: OK → OnExportPicked → advance
                 to ExportColumns (the 2-step assembly view re-populates the same inline
                 panel); Cancel → OnExportPanelCancel → ClosePage (HHM-370). ── *@
            @StepHeader($"Export {ModeNoun}", $"{WizardDescription} Choose which {ModeNoun.ToLowerInvariant()} to export below, then click Next.")

            <div class="aimp-picker-wrap">
                @* Owner directive 2026-07-23: the panel's commit button reads "Next"
                   (OkButtonText — FPickList's default "Open" is unchanged elsewhere);
                   panel mode renders no Cancel of its own (wizard footer owns Cancel). *@
                <FPickList @ref="exportPickList"
                           RenderMode="FPickListRenderMode.Panel"
                           PanelStyle="width:100%; height:100%;"
                           OkButtonText="Next"
                           OnSelected="OnExportPicked"
                           OnCancel="OnExportPanelCancel" />
            </div>

            @if (!string.IsNullOrEmpty(_statusText))
            {
                <p class="aimp-status">@_statusText</p>
            }
        }
        else if (Stage == WizardStage.ExportSave)
        {
            @StepHeader($"Export {ModeNoun} — review & download", $"{_exportPicked.Count} selected.")

            @* Preview with a per-column include checkbox IN each header. All columns are
               ticked by default; untick a column header to leave it out of the file. Every
               mode shows this preview — takeoffs included — so Step 2 is never a blank
               screen. Takeoff columns are structural (fixed template), so their header
               checkboxes render ticked-but-disabled. owner directive 2026-07-27. *@
            <div class="step-description">
                @(Descriptor.IsTakeoffTemplateExport
                    ? "Takeoff columns are fixed by the template and can't be removed — preview below."
                    : "All columns are included by default — untick a column header to leave it out of the file.")
            </div>

            @if (_exportTable != null)
            {
                <div class="aimp-preview">
                    <div class="aimp-preview-label">Preview — first @(Math.Min(10, _exportTable.Rows.Count)) of @_exportTable.Rows.Count row(s)</div>
                    <div class="aimp-preview-scroll">
                        <table class="aimp-preview-table">
                            <thead>
                                <tr>
                                    @foreach (var col in _exportColumns)
                                    {
                                        <th class="@(col.Included ? null : "aimp-col-excluded")">
                                            <CheckBoxControl Checked="@col.Included"
                                                             CheckedChanged="@(v => col.Included = v)"
                                                             Disabled="@Descriptor.IsTakeoffTemplateExport"
                                                             Label="@col.Name" />
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _exportTable.Rows.Cast<System.Data.DataRow>().Take(10))
                                {
                                    <tr>
                                        @foreach (var col in _exportColumns)
                                        {
                                            <td class="@(col.Included ? null : "aimp-col-excluded")">@row[col.Name]</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="aimp-export-save">
                <label class="aimp-export-fname-label">File name
                    <input class="aimp-export-fname" @bind="_exportFileName" @bind:event="oninput" />
                </label>
                @* HHM-616: the typed extension picks the format (VB6 FDataExport branched
                   on the save-dialog extension). Takeoffs are template-bound xlsx-only. *@
                @if (!Descriptor.IsTakeoffTemplateExport)
                {
                    <span class="aimp-export-hint">A name ending in <strong>.csv</strong> exports a comma-separated file; anything else exports an Excel workbook (.xlsx).</span>
                }
                <div class="aimp-export-actions">
                    <ButtonControl OnClick="OnExportSaveAsClick">Save As…</ButtonControl>
                    <span class="aimp-export-hint">or click <strong>Download</strong> below</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_statusText))
            {
                <p class="aimp-status">@_statusText</p>
            }
        }
        else if (Stage == WizardStage.ExportResult)
        {
            @* ── FINAL (export) — "{N} records exported" + saved path; "Export Again"
                 resets and returns to THIS mode's ExportPick (no navigation — v2). ── *@
            @StepHeader($"Export {ModeNoun} — finished")
            <div class="aimp-result">
                <div class="aimp-result-main">@_resultText</div>
                @if (!string.IsNullOrEmpty(_resultDetail))
                {
                    <div class="aimp-result-detail">@_resultDetail</div>
                }
                <div class="aimp-result-detail">Downloaded: @_exportFileName</div>
            </div>
        }
    </div>

    @* ── Wizard footer — the button row sits at the BOTTOM-RIGHT of the card
         (.aimp-wiz-footer). owner import-wizard spec 2026-07-23: NO Cancel
         buttons anywhere in the IMPORT flow (matching export v5) — the MDI tab
         close / < Previous are the exits, and page 1 has no Previous either;
         the "…Again" buttons reset and re-enter the SAME mode's first stage in
         place (pure Stage flip, no navigation). ── *@
    @* Owner 2026-07-23 (v5): page 1 of the export flow renders NO footer bar at
       all — no Previous/Cancel there; the inline panel's own "Next" is the single
       control and the picklist grows to fill the freed space. *@
    @if (CurrentMode == ImportExportMode.None || Stage != WizardStage.ExportPick)
    {
    <div class="wizard-footer aimp-wiz-footer">
        @if (CurrentMode == ImportExportMode.None)
        {
            <ButtonControl OnClick="ClosePage">Close</ButtonControl>
        }
        else if (Stage == WizardStage.ImportPickType)
        {
            @* Step 1 of 5: a single "Next >" — no Previous, no Cancel (owner
               import-wizard spec 2026-07-23). Disabled while PDF is selected
               (the inline not-available note shows instead of a popup). *@
            <ButtonControl Disabled="@(_importFileType == ImportFileType.Pdf)"
                           OnClick="OnPickTypeNextClick">Next &gt;</ButtonControl>
        }
        else if (Stage == WizardStage.ImportPickFile)
        {
            @* Step 2 of 5: Next > is enabled only once a FILE (not a directory)
               is selected; it enters ImportValidate and runs the parse pipeline. *@
            <ButtonControl OnClick="BackToImportPickType">&lt; Previous</ButtonControl>
            <ButtonControl Disabled="@(_importBytes == null || _importFileType == ImportFileType.Pdf)"
                           OnClick="OnImportNextClick">Next &gt;</ButtonControl>
        }
        else if (Stage == WizardStage.ImportValidate)
        {
            @* Step 3 of 4 (owner directive 2026-07-27 — validation + preview MERGED into
               one review page): "< Previous" returns to file pick; "Next >" RUNS the import
               (the unchanged OnOkClick / OnImportClick engines), disabled while fatal errors
               exist or a read/commit is in progress. *@
            @if (IsModelsImportMode)
            {
                <ButtonControl Disabled="@(IsLoadingModelsImport || IsSaving)" OnClick="BackToImportPickFile">&lt; Previous</ButtonControl>
                <ButtonControl Disabled="@(ErrorCount > 0 || IsLoadingModelsImport || IsSaving)" OnClick="OnOkClick">Next &gt;</ButtonControl>
            }
            else
            {
                <ButtonControl Disabled="@IsLoading" OnClick="BackToImportPickFile">&lt; Previous</ButtonControl>
                <ButtonControl Disabled="@(HasFatalErrors || IsLoading)" OnClick="OnImportClick">Next &gt;</ButtonControl>
            }
        }
        else if (Stage == WizardStage.ImportResult)
        {
            @* Step 5 of 5: "Import Again" = full reset back to ImportPickType
               (pure Stage flip — owner import-wizard spec 2026-07-23). *@
            <ButtonControl OnClick="ImportAgain">Import Again</ButtonControl>
            <ButtonControl OnClick="ClosePage">Close</ButtonControl>
        }
        else if (Stage == WizardStage.ExportSave)
        {
            @* Step 2 (merged): "Download" streams the workbook to the browser (plain
               download, no popup) and advances to the result page. owner deployment fix
               2026-07-27: replaces the server-FS File.WriteAllBytes save. *@
            <ButtonControl OnClick="BackToExportPick">&lt; Previous</ButtonControl>
            <ButtonControl Disabled="@(string.IsNullOrWhiteSpace(_exportFileName))" OnClick="OnExportDownloadClick">Download</ButtonControl>
        }
        else if (Stage == WizardStage.ExportResult)
        {
            <ButtonControl OnClick="BackToExportPick">Export Again</ButtonControl>
            <ButtonControl OnClick="ClosePage">Close</ButtonControl>
        }
    </div>
    }
</div>

@* owner directive 2026-07-23: the export selection picker is no longer a bottom-of-
   page dialog — it is rendered INLINE, in Panel mode, inside the ExportPick stage
   body (see above). No DialogControl popup remains anywhere in the import/export flow. *@

@* Container/header/body/footer chrome now comes from the shared wizard styles
   (fx-shared.css .wizard-container/-header/-body/-footer — the FMassChange
   idiom); only the small page-specific bits remain here. *@
<style>
    .aimp-file-info { padding:8px 12px; background:#eef4ff; border:1px solid #cfe0ff; border-radius:4px; margin-bottom:10px; font-size:13px; }
    .aimp-grid-wrap { border:1px solid #dee2e6; border-radius:4px; }
    /* Subordinate status line inside a stage (save-location prompt, cancel notes). */
    .aimp-status { font-size:13px; color:#6c757d; margin:10px 0 0; }
    /* v6 (owner 2026-07-23): the picklist must COVER this container — no wrap
       margins/border/radius/padding; the FPickList panel host's own 1px border
       is the only frame. (Was: wrap border + a ::deep host-border reset that a
       global style block can't apply — ::deep only works in scoped CSS —
       giving a double frame with white space between the two.) */
    .aimp-picker-wrap { display: flex; flex-direction: column; margin:0; width:100%; flex:1 1 auto; min-height:320px; }
    .aimp-picker-wrap .picklist-panel-host { width:100%; height:100%; }
    /* owner import-wizard spec 2026-07-23: sibling of .aimp-picker-wrap for the
       import page-2 FileBrowserControl — same flex fill pattern, but no border
       of its own (the fx-filebrowser control brings one). The child rule (this
       block is global, so it reaches into the control) grows the browser to
       fill the card; its Height parameter is cleared in the markup. */
    .aimp-browser-fill { display: flex; flex-direction: column; margin:4px 0 8px; width:100%; flex:1 1 auto; min-height:320px; }
    .aimp-browser-fill .fx-filebrowser { flex:1 1 auto; min-height:0; }
    /* owner import-wizard spec 2026-07-23: ImportPreview 100-row display-cap note. */
    .aimp-cap-note { font-size:13px; font-weight:600; color:#6c757d; margin:0 0 8px; }
    /* owner import-wizard spec 2026-07-23: ImportValidate success state. */
    .aimp-ready { font-size:13px; font-weight:600; color:#2e7d32; background:#f2faf2; border:1px solid #cde8cd; border-radius:4px; padding:8px 12px; margin:0 0 10px; max-width:560px; }
</style>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            NavigationManager.NavigateTo("/");
    }

    // === Constants (FAssemblyImport) ===
    private const string SRCFILE = "FImportExportAssemblies::";

    // VB6: Const mColumnMappings = "Option=OptionID"
    private const string mColumnMappings = "Option=OptionID";

    // === Parameters / Mode ===
    // Standalone routes: /assembly-import-export or /assembly-import-export/{Mode}.
    // Under the FMain MDI shell [SupplyParameterFromQuery] doesn't fire, so the
    // mode buttons above are the primary path; the route param is a convenience
    // for standalone / deep-link use. Accepted Mode values (case-insensitive):
    //   "importassemblies" -> Import Assemblies
    //   "importtakeoffs"   -> Import Assembly Takeoffs
    //   "exportassemblies" -> Export Assemblies
    //   "exporttakeoffs"   -> Export Assembly Takeoffs
    //   "importmodels"     -> Import models and options  (legacy ImportMode "Assembly")
    //   "importitems"      -> Import items               (legacy ImportMode "Items")
    //   "importvendors"    -> Import Vendors             (HHM-440, VB6 FImportVendors.frm)
    //   "exportvendors"    -> Export Vendors             (HHM-440, VB6 FVendor "ExcelExport")
    [Parameter] public string? Mode { get; set; }

    private enum ImportExportMode { None, ImportAssemblies, ImportTakeoffs, ExportAssemblies, ExportTakeoffs, ImportModelsOptions, ImportItems, ImportVendors, ExportVendors /* HHM-440 */ }
    private ImportExportMode CurrentMode = ImportExportMode.None;

    // ── Per-mode descriptor table ─────────────────────────────────────────
    // ONE place for everything that is a pure mode→constant mapping (the noun,
    // icon, wizard tagline, route token, legacy ImportMode string, engine
    // dispatch kind and export-shape flags that used to live in per-member
    // switch statements scattered through this file).
    // Standing rule: new import/exports become MODES of this form, never new
    // standalone forms — adding a future mode is ONE ModeDescriptor entry here
    // plus its engine methods (follow the HHM-440 vendor per-mode pattern).

    // Which parse/commit engine a mode runs (None for the export modes).
    private enum ImportEngineKind { None, Assemblies, Takeoffs, Vendors, ModelsImport }

    private sealed record ModeDescriptor(
        string RouteToken,             // {Mode} route token (ApplyModeFromRoute)
        string Noun,                   // "Import {Noun}" / "Export {Noun}" stage titles + messages
        string ExportPluralNoun,       // multi-selection default export file name (owner spec)
        string Icon,                   // small step-title icon (existing app icons; onerror-hidden)
        string Description,            // wizard-header tagline
        string? LegacyImportMode,      // folded FImportAssemblies "Assembly"/"Items" (null otherwise)
        ImportEngineKind ImportKind,   // parse/commit engine dispatch
        bool IsExport,                 // export-side flow (ExportPick first stage)
        bool OffersQuickBooks,         // page-1 QuickBooks radio (VB6 FImportVendors ShowForm filter)
        bool IsTakeoffTemplateExport,  // fixed-template export: xlsx-only, structural columns
        string ExportSheetName);       // FilerControl.WriteExcel sheet name

    private static readonly Dictionary<ImportExportMode, ModeDescriptor> ModeDescriptors = new()
    {
        [ImportExportMode.None] = new("", "", "Assemblies", "", "Choose an import or export operation.", null, ImportEngineKind.None, false, false, false, "Assemblies"),
        [ImportExportMode.ImportAssemblies] = new("importassemblies", "Assemblies", "Assemblies", "images/32/excelimport.ico", "Import assemblies from an Excel or CSV file.", null, ImportEngineKind.Assemblies, false, false, false, "Assemblies"),
        [ImportExportMode.ImportTakeoffs] = new("importtakeoffs", "Assembly Takeoffs", "Assemblies", "images/32/TakeoffExcel.ico", "Import assembly takeoffs from a pivoted Excel or CSV file.", null, ImportEngineKind.Takeoffs, false, false, false, "Assemblies"),
        [ImportExportMode.ExportAssemblies] = new("exportassemblies", "Assemblies", "Assemblies", "images/32/excelexport.ico", "Export assemblies to an Excel file.", null, ImportEngineKind.None, true, false, false, "Assemblies"),
        [ImportExportMode.ExportTakeoffs] = new("exporttakeoffs", "Assembly Takeoffs", "Takeoffs", "images/32/TakeoffExcel.ico", "Export assembly takeoffs to an Excel file.", null, ImportEngineKind.None, true, false, true, "Assemblies"),
        // legacy FImportAssemblies modes (folded in) — ImportMode "Assembly" / "Items"
        [ImportExportMode.ImportModelsOptions] = new("importmodels", "Models and Options", "Assemblies", "images/32/Models.ico", "Import models and options from an Excel or CSV file.", "Assembly", ImportEngineKind.ModelsImport, false, false, false, "Assemblies"),
        [ImportExportMode.ImportItems] = new("importitems", "Items", "Assemblies", "images/32/itemdb.ico", "Import items from an Excel or CSV file.", "Items", ImportEngineKind.ModelsImport, false, false, false, "Assemblies"),
        // HHM-440 vendor modes (VB6 FImportVendors.frm / FVendor "ExcelExport")
        [ImportExportMode.ImportVendors] = new("importvendors", "Vendors", "Assemblies", "images/32/vendor.ico", "Import vendors from an Excel, CSV, QuickBooks IIF, or text file.", null, ImportEngineKind.Vendors, false, true, false, "Assemblies"),
        [ImportExportMode.ExportVendors] = new("exportvendors", "Vendors", "Vendors", "images/32/Vendor1.ico", "Export selected vendors to an Excel file.", null, ImportEngineKind.None, true, false, false, "Vendors"),
    };

    private ModeDescriptor Descriptor => ModeDescriptors[CurrentMode];

    // ── WizardStage state machine (2026-07-22 owner UX redesign; v2 2026-07-23;
    //    import restaged per the owner import-wizard spec 2026-07-23) ──
    // ImportPickType → ImportPickFile → ImportValidate → ImportPreview → ImportResult
    //                                        (import modes, steps 1-2-3-4-final)
    // ExportPick     → ExportColumns → ExportSave → ExportResult
    //                                        (export modes, steps 1-2-3-final)
    // v2: there is NO central Landing stage. Each mode starts on its own first
    // stage and the "…Again" buttons reset + return to that SAME first stage —
    // a pure Stage flip on this mounted component: no route/MDI navigation, no
    // ParentNavigate, no ClosePage (the v1 Landing return escaped the page under
    // FMain and dropped users onto an unrelated MDI window). The bare-route
    // mode-chooser is rendered off CurrentMode == None only — it is NOT a stage
    // and nothing navigates back to it.
    // owner import-wizard spec 2026-07-23: the import side has NO Cancel buttons
    // (matching export v5) — the MDI tab close / < Previous are the exits. The
    // parse/validate pipeline runs on the page-2→3 transition (OnImportNextClick)
    // and its OUTCOME shows on ImportValidate; ImportPreview binds display lists
    // capped at the first 100 rows while the commit engines keep the FULL sets.
    // The old _pendingAutoOpen / _pendingExportPickOpen one-shot latches that
    // auto-opened the OS file browser / FPickList on mode entry (VB6 Form_Load
    // parity) remain superseded.
    // owner directive 2026-07-23: ExportSave added between ExportColumns and
    // ExportResult — the server-FS FileSaveLocationPickerControl save-location step.
    private enum WizardStage { ImportPickType, ImportPickFile, ImportValidate, ImportPreview, ImportResult, ExportPick, ExportColumns, ExportSave, ExportResult }
    private WizardStage Stage = WizardStage.ImportPickType;   // ignored while CurrentMode == None (chooser)

    // Header step indicator (FMassChange-style wizard chrome). Import is a
    // 5-page wizard (owner import-wizard spec 2026-07-23): PickType → PickFile →
    // Validate → Preview → Result. Export stays a 4-page wizard (Pick → Columns
    // → Save → Result) exactly as before. The result pages are full wizard pages.
    private string StepIndicator => Stage switch
    {
        WizardStage.ImportPickType => "Step 1 of 4",
        WizardStage.ImportPickFile => "Step 2 of 4",
        WizardStage.ImportValidate => "Step 3 of 4",       // validation + preview MERGED (owner 2026-07-27)
        WizardStage.ImportPreview => "Step 3 of 4",         // (now unreachable; folded into ImportValidate)
        WizardStage.ImportResult => "Step 4 of 4",
        WizardStage.ExportPick => "Step 1 of 3",
        WizardStage.ExportColumns => "Step 2 of 3",   // (now unreachable; leave it)
        WizardStage.ExportSave => "Step 2 of 3",
        WizardStage.ExportResult => "Step 3 of 3",
        _ => ""
    };

    // Small step-title icon per mode (existing app icons; onerror-hidden).
    private string ModeIcon => Descriptor.Icon;

    // ── Shared stage header (owner ask: the ~10 wizard stages repeated the same
    //    step-title / step-description block). Emits EXACTLY the markup every
    //    stage used inline — same classes, same onerror fallback — with an
    //    optional description line. ──
    private RenderFragment StepHeader(string title, string? description = null) => __builder =>
    {
        <div class="step-title">
            <img class="step-icon-img" src="@ModeIcon" alt="" onerror="this.style.display='none'" />
            @title
        </div>
        if (description != null)
        {
            <div class="step-description">
                @description
            </div>
        }
    };

    // ── ImportPickType: file-type radio (page 1 of 5 — owner import-wizard spec
    //    2026-07-23; drives the page-2 FileBrowserControl's Accept filter). ──
    //    HHM-587: the PDF radio is GONE (no legacy import accepts PDF — VB6
    //    FAssemblyImport.frm 142/247 filter is *.xlsx;*.xls;*.csv); the Pdf enum
    //    member and its Next>-disabled guards remain as unreachable defense.
    //    QuickBooks (.iif/.txt) appears for ImportVendors only. Changing the
    //    type clears any previously picked file (its extension may no longer
    //    match the new Accept filter).
    private enum ImportFileType { Excel, Csv, Pdf, QuickBooks }
    private ImportFileType _importFileTypeValue = ImportFileType.Excel;
    private ImportFileType _importFileType
    {
        get => _importFileTypeValue;
        set
        {
            if (_importFileTypeValue == value) return;
            _importFileTypeValue = value;
            _importBytes = null; _importFileName = "";   // owner deployment fix 2026-07-27: clear browser-picked file too
        }
    }

    // owner deployment fix 2026-07-27: the import file arrives from the browser
    // via the ImportPickFile drop-zone <InputFile> (no server filesystem read) —
    // the uploaded bytes + original file name are the parse inputs. (The earlier
    // server-FS FileBrowserControl path and its _importPath / start-folder
    // plumbing were removed with it.)
    private byte[]? _importBytes;
    private string _importFileName = "";

    // ── Review-page 100-row display cap (owner import-wizard spec 2026-07-23; the
    //    Validate+Preview merge, owner 2026-07-27). The review grids/tabs bind these
    //    DISPLAY lists, built by BuildImportPreviewDisplayLists() at the end of the
    //    parse (OnImportNextClick) and capped at the first 100 rows.
    //    The commit engines (Engine.StageImportedAssembliesAsync /
    //    Engine.StageAssemblyTakeoffsAsync /
    //    RunImportVendorsAsync / the folded Write* methods) keep iterating the
    //    FULL parsed sets (GridData / SheetRows / AssemblyGridData / ItemGridData /
    //    PhaseGridData / CategoryGridData / AssemblyDetailData) — never these. ──
    private const int PreviewDisplayCap = 100;
    private List<ImportRow> _gridDataDisplay = new();
    private List<AssemblyGridRow> _assemblyGridDisplay = new();
    private List<PhaseGridRow> _phaseGridDisplay = new();
    private List<CategoryGridRow> _categoryGridDisplay = new();
    private List<ImportMessage> _messagesDisplay = new();

    // Export selection is a VB6-faithful FPickList (multi-select), not an inline
    // grid. _exportPickStep tracks the ExportAssemblies view-2 two-step (1 =
    // primary 3-view pick, 2 = the per-model assembly pick — VB6's second
    // FPickList.Choose).
    private FPickList? exportPickList;
    private int _exportPickStep = 1;

    // owner directive 2026-07-23: the ExportPick selection renders INLINE as an
    // FPickList in Panel mode. One-shot latch so OnAfterRenderAsync opens/populates
    // the panel exactly once per ExportPick entry (cleared by ResetState and
    // OnExportPickCancelled so re-entering the stage re-opens it).
    private bool _exportPanelOpened;

    // HHM-440: the vendor modes ride the same staged flows — ImportVendors takes the
    // ImportPickType → ImportPickFile → ImportValidate → ImportPreview → ImportResult
    // path (owner import-wizard spec 2026-07-23); ExportVendors takes the
    // ExportPick → ExportColumns → ExportResult path with its own vendor multi-select
    // picker (see the vendor branch in OpenExportPickerAsync).
    private bool IsImportMode => Descriptor.ImportKind is ImportEngineKind.Assemblies or ImportEngineKind.Takeoffs
        or ImportEngineKind.Vendors;
    private bool IsExportMode => Descriptor.IsExport;

    // The two folded (FImportAssemblies) modes.
    private bool IsModelsImportMode => Descriptor.ImportKind == ImportEngineKind.ModelsImport;

    // (ShowWizardHeader removed — the staged wizard always frames real content,
    //  so the header no longer needs to hide during an auto-open wait.)

    // Map the new enum modes back onto the legacy FImportAssemblies "ImportMode"
    // string ("Assembly" / "Items") so every folded line that branches on
    // ImportMode runs against its original value verbatim.
    private string? ImportMode => Descriptor.LegacyImportMode;

    // === Session / state (FAssemblyImport) ===
    private string mSession = "";        // VB6 mSession = CreateGUID()
    private string mFileType = "";       // VB6 mFileType: models | options | globals
    private string mFilename = "";
    private bool IsLoading = false;
    private string WizardDescription = "Choose an import or export operation.";
    private string ProgressMessage = "Working...";

    // Subordinate status line inside a stage (save-location prompt, cancel notes)
    // and the ImportResult/ExportResult stage texts.
    private string _statusText = "";
    private string _resultText = "";
    private string _resultDetail = "";

    // The confirmed export selection (drives the "N selected" count + the
    // single-selection default file name).
    private List<ExportPickRow> _exportPicked = new();

    // ── ExportColumns stage state ─────────────────────────────────────────────
    // _exportTable is the built export DataTable (assemblies / vendors);
    // _exportColumns is the checklist over its columns (ALL checked by default);
    // _takeoffBytes holds the pre-built fixed-template workbook for
    // ExportTakeoffs (its columns are structural — no checklist, see markup).
    private DataTable? _exportTable;
    private List<ExportColumnChoice> _exportColumns = new();
    private byte[]? _takeoffBytes;
    private int _takeoffExportQtyRows;
    private string _exportFileName = "";

    // owner deployment fix 2026-07-27: the server-FS save path (_exportSavePath) and
    // the FileSaveLocationPickerControl were removed — export is now a pure browser
    // download keyed on _exportFileName alone.

    private sealed class ExportColumnChoice
    {
        public string Name { get; set; } = "";
        public bool Included { get; set; } = true;
    }

    // Noun for stage titles ("Import {noun}" / "Export {noun}") and messages.
    private string ModeNoun => Descriptor.Noun;

    // Plural noun for the multi-selection default export file name (owner spec:
    // "Assemblies.xlsx" / "Takeoffs.xlsx" / "Vendors.xlsx").
    private string ExportPluralNoun => Descriptor.ExportPluralNoun;

    // Read-only row for the confirmed export selection (count + default filename).
    private sealed class ExportPickRow
    {
        public string Community { get; set; } = "";
        public string Model { get; set; } = "";
        public string OptionID { get; set; } = "";
        public string Assembly { get; set; } = "";
        public string Description { get; set; } = "";
        public string Company { get; set; } = "";   // HHM-440 vendor picker (Vendor_Name)
    }

    // === Grids (FAssemblyImport) ===
    private GridControl<ImportRow>? DataGrid;

    private List<ImportRow> GridData = new();
    private List<GridColumnDef> GridColumns = new();
    // ErrorRows feeds the ImportValidate errors panel (owner import-wizard spec
    // 2026-07-23): fatal entries (IsWarning == false — missing required columns,
    // invalid format, file-read failures, validate-proc errors) disable Next;
    // warnings (blank-key rows w/ row numbers) don't.
    private List<ErrorRow> ErrorRows = new();
    private int ErrorTotal = 0;
    private bool HasFatalErrors => ErrorRows.Any(e => !e.IsWarning);

    // ── Export Assemblies output shape (VB6 ExportAssemblies / FPickList.SelectedView 1/2/3).
    //    Set from the export FPickList's SelectedViewIndex in OnExportPicked; drives the export
    //    SELECT shape in Engine.BuildAssembliesExportTable (models / options / globals). The
    //    ExportView enum itself lives with the engine; the selection UI is the FPickList
    //    (multi-select), not an inline grid — see OpenExportPickerAsync. ──
    private ExportView CurrentExportView = ExportView.Models;

    // grid metadata (the parsed sheet, kept for staging)
    private List<string> ColumnKeys = new();           // per-column key after mapping (may be "")
    private List<List<string>> SheetRows = new();       // raw cell text grid: SheetRows[r][c], r=0 is header row(s)

    private PageSettings pageSettings = new() { PageSize = 50 };

    // ──────────────────────────────────────────────────────────────────────
    // Lifecycle
    // ──────────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // Resolve the mode from the route BEFORE the first render. OnInitializedAsync renders
        // once at the await below, so without this the mode-picker (CurrentMode==None) would
        // paint for a frame and then be replaced once OnParametersSet set the mode — the
        // "button screen flashes" the user saw. Setting it here (pre-await) lands directly on
        // the right landing page.
        ApplyModeFromRoute();
        // FImportAssemblies loaded AppOptions on init (needed by the folded modes).
        await LoadAppOptionsAsync();
        _phaseItemJcCostCodeMaxLength = LoadColumnMaxLength("tblPhaseItem", "JCCostCode");
    }

    protected override void OnParametersSet() => ApplyModeFromRoute();

    // owner directive 2026-07-23: the ExportPick selection is an INLINE FPickList in
    // Panel mode. The panel renders its content only after Open(...) has set the
    // picklist visible, and the @ref exists only once the stage body has rendered —
    // so populate it here (post-render), exactly once per ExportPick entry. The
    // _exportPanelOpened latch (set before awaiting so the Open()-driven re-render
    // doesn't re-enter) is cleared by ResetState / OnExportPickCancelled, so
    // re-entering ExportPick — "Export Again", "< Previous", a fresh mode — re-opens.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Stage == WizardStage.ExportPick && !_exportPanelOpened && exportPickList != null)
        {
            _exportPanelOpened = true;
            await OpenExportPickerAsync();
        }

        // Wire the import drop-zone: JS routes a dropped file onto the overlaid <InputFile>
        // and installs a window guard so a stray drop never navigates/downloads (owner fix
        // 2026-07-27). Idempotent per DOM element; the C# fallback is click-to-browse, which
        // works with no JS. See wwwroot/js/fx-report.js → hfImportDropzone.
        if (Stage == WizardStage.ImportPickFile)
        {
            try { await JS.InvokeVoidAsync("hfImportDropzone.attach", "aimpImportDropzone", "aimpImportInput"); }
            catch (Exception ex) { Logger.LogWarning(ex, "[{Src}] import drop-zone wiring skipped", SRCFILE); }
        }
    }

    // Map the {Mode} route token onto CurrentMode (once, while still None). Idempotent.
    // Deep-launch: this lands the wizard directly on ImportPickType / ExportPick
    // (FVendor toolbar buttons, Setup sidebar). v2: CurrentMode never returns to
    // None after this ("…Again" stays inside the mode), so the simple guard is
    // sufficient and the route token can never re-fire mid-session.
    private void ApplyModeFromRoute()
    {
        if (CurrentMode == ImportExportMode.None && !string.IsNullOrWhiteSpace(Mode))
        {
            var token = Mode.Trim().ToLowerInvariant();
            foreach (var (mode, descriptor) in ModeDescriptors)
            {
                if (descriptor.RouteToken.Length > 0 && descriptor.RouteToken == token)
                {
                    SetMode(mode);
                    break;
                }
            }
        }
    }

    private void SetMode(ImportExportMode mode)
    {
        CurrentMode = mode;
        ResetState();

        WizardDescription = ModeDescriptors[mode].Description;

        // 2026-07-22 redesign: no auto-open. Land on the mode's own first stage —
        // deep-launch (route mode) enters ImportPickType for the import modes
        // (owner import-wizard spec 2026-07-23) / ExportPick for the export modes.
        Stage = IsExportMode ? WizardStage.ExportPick : WizardStage.ImportPickType;
    }

    // Reset everything a mode run accumulates (both the BASE and the folded
    // FImportAssemblies state), leaving CurrentMode/Stage to the caller.
    private void ResetState()
    {
        mSession = "";
        mFileType = "";
        mFilename = "";
        FileLoaded = false;
        GridData.Clear();
        GridColumns.Clear();
        ColumnKeys.Clear();
        SheetRows.Clear();
        ErrorRows.Clear();
        ErrorTotal = 0;
        CurrentExportView = ExportView.Models;   // VB6 default view = "Models"
        _exportPickStep = 1;
        _exportPanelOpened = false;              // owner directive 2026-07-23: re-open the inline ExportPick panel on (re)entry
        _importFileType = ImportFileType.Excel;  // radio default = Excel
        _importBytes = null; _importFileName = "";   // owner deployment fix 2026-07-27: clear browser-uploaded file
        _gridDataDisplay = new();                // owner import-wizard spec 2026-07-23: capped preview display lists
        _assemblyGridDisplay = new();
        _phaseGridDisplay = new();
        _categoryGridDisplay = new();
        _messagesDisplay = new();
        _statusText = "";
        _resultText = "";
        _resultDetail = "";
        _exportPicked = new();
        _exportTable = null;
        _exportColumns.Clear();
        _takeoffBytes = null;
        _takeoffExportQtyRows = 0;
        _exportFileName = "";
        _vendorSkippedRows = 0;
        ResetModelsImportState();
    }

    // Folded FImportAssemblies (models/items) parse + verify state.
