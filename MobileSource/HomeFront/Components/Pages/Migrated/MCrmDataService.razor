@* MCrmDataService.razor - Converted from VB6 MCrmDataService.bas *@
@* This is a non-visual service component providing CRM data integration *@

@using System.Data
@using HomeFront.Data

@code {
    // === Private State (mirrors VB6 module-level variables) ===
    private bool _loaded = false;
