    }

    /// <summary>
    /// Resets the loaded state, forcing re-read of CRM settings on next call.
    /// </summary>
    public void ResetConfiguration()
    {
        _loaded = false;
        _crmApiKey = "";
        _crmClientId = "";
        _crmEnvironment = "";
    }

    /// <summary>
    /// Returns whether CRM integration is currently active (for UI binding).
    /// </summary>
    public bool IsIntegrated => Integrated();
}
