@page "/community-accounting"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data
@layout HFComponent

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FCommunityAccounting> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>Accounting - HomeFront</PageTitle>

<div class="accounting-dialog" @onkeydown="OnKeyDown" tabindex="0">
    <h4 style="margin-top: 0; margin-bottom: 16px;">Accounting</h4>

    @* ── GL Accounts Section (non-Intacct) ── *@
    @if (!IsIntacct)
    {
        <div class="section-title">GL Accounts</div>

        <div class="field-row">
            <label>Income Stmt Prefix</label>
            <TextBoxControl @bind-Value="Fields[1]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(1)" />
            <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(1)">…</ButtonControl>
        </div>
        <div class="field-row">
            <label>Balance Sheet Prefix</label>
            <TextBoxControl @bind-Value="Fields[2]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(2)" />
            <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(2)">…</ButtonControl>
        </div>
        <div class="field-row">
            <label>Lot Inventory Debit</label>
            <TextBoxControl @bind-Value="Fields[3]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(3)" />
        </div>
        <div class="field-row">
            <label>Lot Inventory Credit</label>
            <TextBoxControl @bind-Value="Fields[4]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(4)" />
        </div>
    }

    @* ── Organization Section (Intacct) ── *@
    @if (IsIntacct)
    {
        <div class="section-title">Organization</div>

        <div class="field-row">
            <label>Entity</label>
            <TextBoxControl @bind-Value="Fields[11]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(11)" />
            <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(11)">…</ButtonControl>
        </div>
        <div class="field-row">
            <label>Location</label>
            <TextBoxControl @bind-Value="Fields[12]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(12)" />
            <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(12)">…</ButtonControl>
        </div>
        <div class="field-row">
            <label>Parent Job</label>
            <TextBoxControl @bind-Value="Fields[13]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(13)" />
            <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(13)">…</ButtonControl>
        </div>
        <div class="field-row">
            <label>Department</label>
            <TextBoxControl @bind-Value="Fields[14]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(14)" />
            <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(14)">…</ButtonControl>
        </div>
    }

    @* ── Tax Groups Section ── *@
    <div class="section-title">Tax Groups</div>

    <div class="tax-group-grid">
        <div class="field-row">
            <label>Labour</label>
            <TextBoxControl @bind-Value="Fields[5]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(5)" @onblur="() => ValidateTaxGroup(5)" />
            <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(5)">…</ButtonControl>
        </div>
        <div class="field-row">
            <label>Equipment</label>
            <TextBoxControl @bind-Value="Fields[8]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(8)" @onblur="() => ValidateTaxGroup(8)" />
            <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(8)">…</ButtonControl>
        </div>
        <div class="field-row">
            <label>Material</label>
            <TextBoxControl @bind-Value="Fields[6]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(6)" @onblur="() => ValidateTaxGroup(6)" />
            <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(6)">…</ButtonControl>
        </div>
        <div class="field-row">
            <label>Overhead</label>
            <TextBoxControl @bind-Value="Fields[9]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(9)" @onblur="() => ValidateTaxGroup(9)" />
            <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(9)">…</ButtonControl>
        </div>
        <div class="field-row">
            <label>Sub Contracts</label>
            <TextBoxControl @bind-Value="Fields[7]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(7)" @onblur="() => ValidateTaxGroup(7)" />
            <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(7)">…</ButtonControl>
        </div>
        <div class="field-row">
            <label>Other</label>
            <TextBoxControl @bind-Value="Fields[10]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(10)" @onblur="() => ValidateTaxGroup(10)" />
            <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(10)">…</ButtonControl>
        </div>
    </div>

    @* ── Additional Fields ── *@
    <div class="field-row" style="margin-top: 10px;">
        <label>Loan Draw Liability Acct</label>
        <TextBoxControl @bind-Value="Fields[15]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(15)" />
        <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(15)">…</ButtonControl>
    </div>
    <div class="field-row">
        <label>Bank Account</label>
        <TextBoxControl @bind-Value="Fields[16]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(16)" />
        <ButtonControl CssClass="browse-btn" Title="Browse" OnClick="() => OnBrowse(16)">…</ButtonControl>
    </div>

    @* ── Warranty Section ── *@
    <div class="section-title">Warranty</div>

    <div class="field-row">
        <label>Warranty Job</label>
        <TextBoxControl @bind-Value="Fields[0]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(0)" />
    </div>

    @* ── Tarion Section (conditional) ── *@
    @if (ShowTarionFields)
    {
        <div class="field-row">
            <label>Tarion Builder No</label>
            <TextBoxControl @bind-Value="Fields[17]" MaxLength="50" CssClass="ca-field" @onfocus="() => SelectAll(17)" />
        </div>
    }

    @* ── Footer Buttons ── *@
    <div class="dialog-footer">
        <ButtonControl CssClass="btn-primary" OnClick="OnOkClick">OK</ButtonControl>
        <ButtonControl OnClick="OnCancelClick">Cancel</ButtonControl>
    </div>
</div>

@* ── Pick List Dialog ── *@
<DialogControl Visible="@IsPickListVisible"
               Header="@PickListTitle"
               Width="600px"
               IsModal="true"
               ShowCloseIcon="true"
               OnClose="ClosePickList">
    <ChildContent>
        <div class="picklist-body">
            <TextBoxControl Value="@PickListFilter" Placeholder="Filter..."
                            CssClass="picklist-filter" @oninput="OnPickListFilterInput" />
            <table>
                <thead>
                    <tr>
                        @foreach (var col in PickListColumns)
                        {
                            <th>@col</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FilteredPickListData)
                    {
                        <tr class="@(row == SelectedPickListRow ? "selected" : "")"
                            @onclick="() => OnPickListRowClick(row)"
                            @ondblclick="() => OnPickListRowDoubleClick(row)">
                            @foreach (var col in PickListColumns)
                            {
                                <td>@(row.ContainsKey(col) ? row[col]?.ToString() : "")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
</DialogControl>

@code {
    // === Database ===
// === Field data (indexes 0-17 matching VB6 text1 array) ===
    private string[] Fields = new string[18];

    // === Configuration ===
    private bool IsIntacct = false;
    private bool IsTimberline = false;
    private bool ShowTarionFields = false;
    private string IntacctEntity = "";
    private string AccountingSystem = ""; // e.g., "Intacct", "Timberline", etc.

    // === Grid data passed in (simulating the VB6 Grid parameter) ===
    private Dictionary<string, string> GridRowData = new();

    // === Pick List State ===
    private bool IsPickListVisible = false;
    private string PickListTitle = "";
    private string PickListFilter = "";
    private List<string> PickListColumns = new();
    private List<Dictionary<string, object>> PickListData = new();
    private Dictionary<string, object>? SelectedPickListRow;
    private int PickListTargetIndex = -1;
    private string PickListReturnField = "";

    private IEnumerable<Dictionary<string, object>> FilteredPickListData =>
        string.IsNullOrWhiteSpace(PickListFilter)
            ? PickListData
            : PickListData.Where(r => r.Values.Any(v =>
                v?.ToString()?.Contains(PickListFilter, StringComparison.OrdinalIgnoreCase) == true));

    // === Callback for returning data ===
    [Parameter] public EventCallback<Dictionary<string, string>> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        // Initialize fields
        for (int i = 0; i < Fields.Length; i++)
            Fields[i] = "";

        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            // Load accounting system setting
            var optionRows = await db.QueryAsync(
                "SELECT ValueName, Value FROM AppOptions WHERE DivisionID = @DivisionID",
                new { SessionState.DivisionID });

            var options = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var row in optionRows)
            {
                var key = row["ValueName"]?.ToString() ?? "";
                var val = row["Value"]?.ToString() ?? "";
                if (!string.IsNullOrEmpty(key))
                    options[key] = val;
            }

            AccountingSystem = options.GetValueOrDefault("AccountingSystem", "");
            IsIntacct = AccountingSystem.Equals("Intacct", StringComparison.OrdinalIgnoreCase);
            IsTimberline = AccountingSystem.Equals("Timberline", StringComparison.OrdinalIgnoreCase);
            ShowTarionFields = options.GetValueOrDefault("EnableTarionFields", "")
                .Equals("true", StringComparison.OrdinalIgnoreCase);

            IntacctEntity = options.GetValueOrDefault("IntacctEntity", "");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

        }
    }

    /// <summary>
    /// Call this method to populate the form from grid row data, similar to VB6 ShowForm.
    /// </summary>
    public void LoadFromGridRow(Dictionary<string, string> rowData)
    {
        GridRowData = rowData;

        Fields[0] = GetValue("WarrantyJob");
        Fields[1] = GetValue("IncomePrefix");
        Fields[2] = GetValue("BalanceSheet");
        Fields[3] = GetValue("LotInventoryDebit");
        Fields[4] = GetValue("LotInventoryCredit");
        Fields[5] = GetValue("LabourTaxGroup");
        Fields[6] = GetValue("MaterialTaxGroup");
        Fields[7] = GetValue("SubContractTaxGroup");
        Fields[8] = GetValue("EquipmentTaxGroup");
        Fields[9] = GetValue("OverheadTaxGroup");
        Fields[10] = GetValue("OtherTaxGroup");
        Fields[11] = GetValue("IntacctEntity");
        Fields[12] = GetValue("BalanceSheet"); // aka location
        Fields[13] = GetValue("IntacctParentJob");
        Fields[14] = GetValue("IntacctDepartment");
        Fields[15] = GetValue("Mortgage_Credit");
        Fields[16] = GetValue("BankAccount");
        Fields[17] = GetValue("TarionBuilderNumber");

        var entity = GetValue("IntacctEntity");
        IntacctEntity = string.IsNullOrEmpty(entity) ? IntacctEntity : entity;

        StateHasChanged();
    }

    /// <summary>
    /// Returns the field values mapped back to grid column names.
    /// </summary>
    public Dictionary<string, string> GetResultData()
    {
        var result = new Dictionary<string, string>();

        result["WarrantyJob"] = Fields[0];

        if (IsIntacct)
        {
            result["IntacctEntity"] = Fields[11];
            result["IncomePrefix"] = Fields[12]; // location is both prefixes
            result["BalanceSheet"] = Fields[12];
            result["IntacctParentJob"] = Fields[13];
            result["IntacctDepartment"] = Fields[14];
        }
        else
        {
            result["IncomePrefix"] = Fields[1];
            result["BalanceSheet"] = Fields[2];
        }

        result["Mortgage_Credit"] = Fields[15];
        result["BankAccount"] = Fields[16];
        result["TarionBuilderNumber"] = Fields[17];
        result["LotInventoryDebit"] = Fields[3];
        result["LotInventoryCredit"] = Fields[4];
        result["LabourTaxGroup"] = Fields[5];
        result["MaterialTaxGroup"] = Fields[6];
        result["SubContractTaxGroup"] = Fields[7];
        result["EquipmentTaxGroup"] = Fields[8];
        result["OverheadTaxGroup"] = Fields[9];
        result["OtherTaxGroup"] = Fields[10];

        return result;
    }

    // === Event Handlers ===

    // VB6: Form_KeyDown - escape closes the form
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnCancelClick();
        }
    }

    private async Task OnOkClick()
    {
        var result = GetResultData();
        if (OnSave.HasDelegate)
            await OnSave.InvokeAsync(result);
    }

    private async Task OnCancelClick()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();
    }

    private void SelectAll(int index)
    {
        // In Blazor, text selection on focus is handled via JS interop if needed.
        // This is a placeholder for the VB6 SelectAll behavior.
    }

    // === Browse Button Handler ===
    private async Task OnBrowse(int index)
    {
        try
        {
            switch (index)
            {
                case 15: // Loan Draw Liability Acct - GL Account
                    await ShowGLAccountPickList(index);
                    break;

                case 1:
                case 2:
                case 12: // Prefix / Location
                    await ShowPrefixPickList(index);
                    break;

                case 5:
                case 6:
                case 7:
                case 8:
                case 9:
                case 10: // Tax Groups
                    await ShowTaxGroupPickList(index);
                    break;

                case 11: // Intacct Entity
                    await ShowIntacctEntityPickList(index);
                    break;

                case 14: // Intacct Department
                    await ShowDepartmentPickList(index);
                    break;

                case 16: // Bank Account
                    await ShowBankAccountPickList(index);
                    break;

                case 13: // Intacct Parent Job
                    await ShowIntacctJobsPickList(index);
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            Notifications.Error($"Error: {ex.Message}");
        }
    }

    // === Pick List Methods ===
    private async Task ShowGLAccountPickList(int index)
    {
        var sql = "SELECT Account, Description, AccountType FROM glaccounts WHERE divisionid = @DivisionID";
        var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });
        PickListColumns = new List<string> { "Account", "Description", "AccountType" };
        PickListData = rows.ToList();
        PickListTitle = "GL Account";
        PickListTargetIndex = index;
        PickListReturnField = "Account";
        PickListFilter = "";
        SelectedPickListRow = null;
        IsPickListVisible = true;
    }

    private async Task ShowPrefixPickList(int index)
    {
        if (IsIntacct)
        {
            var sql = "SELECT description, gl_prefix AS Location FROM gl_prefix WHERE divisionid = @DivisionID";
            var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });
            PickListColumns = new List<string> { "description", "Location" };
            PickListData = rows.ToList();
            PickListTitle = "Locations";
            PickListReturnField = "Location";
        }
        else if (IsTimberline)
        {
            // VB6: query glm_master__account_format to determine prefix table
            var sqlstmt = "";
            try
            {
                var formatRows = await db.QueryAsync("SELECT * FROM glm_master__account_format");
                var fmt = formatRows.FirstOrDefault();
                if (fmt != null)
                {
                    var abcLen = Convert.ToInt32(fmt.GetValueOrDefault("account_prefix_abc_length", 0) ?? 0);
                    var abLen = Convert.ToInt32(fmt.GetValueOrDefault("account_prefix_ab_length", 0) ?? 0);
                    var aLen = Convert.ToInt32(fmt.GetValueOrDefault("account_prefix_a_length", 0) ?? 0);

                    if (abcLen != 0)
                        sqlstmt = "SELECT account_prefix_abc AS Prefix, Account_Prefix_ABC_Description AS Description FROM glm_master__account_prefix_abc_1";
                    else if (abLen != 0)
                        sqlstmt = "SELECT account_prefix_ab AS Prefix, Account_Prefix_AB_Description AS Description FROM glm_master__account_prefix_ab_1";
                    else if (aLen != 0)
                        sqlstmt = "SELECT account_prefix_a AS Prefix, Account_Prefix_A_Description AS Description FROM glm_master__account_prefix_a_1";
                    else
                        sqlstmt = "SELECT NULL AS Prefix, NULL AS Description FROM glm_master__account_prefix_a_1 WHERE 1=2";
                }
            }
            catch
            {
                sqlstmt = "SELECT account_prefix_a AS Prefix, Account_Prefix_A_Description AS Description FROM glm_master__account_prefix_a_1";
            }

            try
            {
                var rows = await db.QueryAsync(sqlstmt);
                PickListColumns = new List<string> { "Prefix", "Description" };
                PickListData = rows.ToList();
            }
            catch
            {
                PickListColumns = new List<string> { "Prefix", "Description" };
                PickListData = new();
            }
            PickListTitle = "Prefix List";
            PickListReturnField = "Prefix";
        }
        else
        {
            // Generic / other accounting system
            PickListColumns = new List<string> { "Prefix", "Description" };
            PickListData = new();
            PickListTitle = "Prefix List";
            PickListReturnField = "Prefix";
        }

        PickListTargetIndex = index;
        PickListFilter = "";
        SelectedPickListRow = null;
        IsPickListVisible = true;
    }

    private async Task ShowTaxGroupPickList(int index)
    {
        var sql = "SELECT TaxGroup, Description FROM taxgroups WHERE DivisionID = @DivisionID";
        var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });
        PickListColumns = new List<string> { "TaxGroup", "Description" };
        PickListData = rows.ToList();
        PickListTitle = "Tax Group";
        PickListTargetIndex = index;
        PickListReturnField = "TaxGroup";
        PickListFilter = "";
        SelectedPickListRow = null;
        IsPickListVisible = true;
    }

    private async Task ShowIntacctEntityPickList(int index)
    {
        // In VB6 this called Intacct_EntityList; here we query a local table or cached data
        var sql = "SELECT EntityID, Name FROM IntacctEntities WHERE DivisionID = @DivisionID ORDER BY EntityID";
        try
        {
            var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });
            PickListColumns = new List<string> { "EntityID", "Name" };
            PickListData = rows.ToList();
        }
        catch
        {
            PickListColumns = new List<string> { "EntityID", "Name" };
            PickListData = new();
        }
        PickListTitle = "Entity";
        PickListTargetIndex = index;
        PickListReturnField = "EntityID";
        PickListFilter = "";
        SelectedPickListRow = null;
        IsPickListVisible = true;
    }

    private async Task ShowDepartmentPickList(int index)
    {
        var sql = "SELECT id, name FROM IntacctDepartments WHERE DivisionID = @DivisionID ORDER BY id";
        var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });
        PickListColumns = new List<string> { "id", "name" };
        PickListData = rows.ToList();
        PickListTitle = "Department";
        PickListTargetIndex = index;
        PickListReturnField = "id";
        PickListFilter = "";
        SelectedPickListRow = null;
        IsPickListVisible = true;
    }

    private async Task ShowBankAccountPickList(int index)
    {
        var sql = "SELECT BankAccount, Description FROM BankAccounts WHERE DivisionID = @DivisionID ORDER BY BankAccount";
        var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });
        PickListColumns = new List<string> { "BankAccount", "Description" };
        PickListData = rows.ToList();
        PickListTitle = "Bank Account";
        PickListTargetIndex = index;
        PickListReturnField = "BankAccount";
        PickListFilter = "";
        SelectedPickListRow = null;
        IsPickListVisible = true;
    }

    private async Task ShowIntacctJobsPickList(int index)
    {
        // In VB6 this called Intacct API; here we query a local cached table
        var sql = "SELECT Job, Description FROM IntacctJobs WHERE DivisionID = @DivisionID ORDER BY Job";
        try
        {
            var rows = await db.QueryAsync(sql, new { SessionState.DivisionID });
            PickListColumns = new List<string> { "Job", "Description" };
            PickListData = rows.ToList();
        }
        catch
        {
            PickListColumns = new List<string> { "Job", "Description" };
            PickListData = new();
        }
        PickListTitle = "Parent Job";
        PickListTargetIndex = index;
        PickListReturnField = "Job";
        PickListFilter = "";
        SelectedPickListRow = null;
        IsPickListVisible = true;
    }

    // === Pick List Interaction ===
    // Live filter-as-you-type (preserves the original <input @bind:event="oninput">).
    private void OnPickListFilterInput(ChangeEventArgs e)
    {
        PickListFilter = e.Value?.ToString() ?? "";
    }

    private void OnPickListRowClick(Dictionary<string, object> row)
    {
        SelectedPickListRow = row;
    }

    private void OnPickListRowDoubleClick(Dictionary<string, object> row)
    {
        SelectedPickListRow = row;
        AcceptPickListSelection();
    }

    private void AcceptPickListSelection()
    {
        if (SelectedPickListRow != null && PickListTargetIndex >= 0 && !string.IsNullOrEmpty(PickListReturnField))
        {
            if (SelectedPickListRow.ContainsKey(PickListReturnField))
            {
                Fields[PickListTargetIndex] = SelectedPickListRow[PickListReturnField]?.ToString() ?? "";
            }
        }
        ClosePickList();
    }

    private void ClosePickList()
    {
        IsPickListVisible = false;
        PickListFilter = "";
        SelectedPickListRow = null;
    }

    // === Tax Group Validation ===
    private async Task ValidateTaxGroup(int index)
    {
        if (index < 5 || index > 10) return;
        if (string.IsNullOrWhiteSpace(Fields[index])) return;

        try
        {
            var sql = "SELECT TaxGroup FROM taxgroups WHERE DivisionID = @DivisionID AND TaxGroup = @TaxGroup";
            var rows = await db.QueryAsync(sql, new { SessionState.DivisionID, TaxGroup = Fields[index].Trim() });
            if (!rows.Any())
            {
                Notifications.Info("Invalid Tax Group");
                Fields[index] = "";
                StateHasChanged();
            }
            else
            {
                Fields[index] = rows.First()["TaxGroup"]?.ToString() ?? "";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

        }
    }

    // === Helpers ===
    private string GetValue(string key)
    {
        return GridRowData.TryGetValue(key, out var val) ? val ?? "" : "";
    }
}
