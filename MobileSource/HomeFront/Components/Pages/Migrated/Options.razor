    // === ReadData (from VB6 Options.ReadData) ===

    /// <summary>
    /// Reads option values from AppOptions and System_Setup tables.
    /// Call after InitializeOptions to populate with database values.
    /// </summary>
    public void ReadData()
    {
        try
        {
            // Read AppOptions
            var sql = @"SELECT OptionName, OptionValue
                        FROM AppOptions
                        WHERE (ISNULL(UID,'')='' OR UID=@LoginID)
                          AND ISNULL(DivisionId,0) IN (0, @DivisionID)
                        ORDER BY DivisionId";
            var dt = db.SqlExec(sql, new { LoginID, DivisionID = SafeInt(DivisionID) });

            foreach (DataRow dr in dt.Rows)
            {
                var index = ItemIndex(dr["OptionName"]?.ToString() ?? "");
                if (index > -1)
                    mOptions[index].Value = dr["OptionValue"]?.ToString() ?? "";
            }

            // Override SQLDate_Format with constant
            var sqlDateIdx = ItemIndex("SQLDate_Format");
            if (sqlDateIdx > -1)
                mOptions[sqlDateIdx].Value = "'YYYY-MM-DD'";

            // Read System_Setup
            var dtSys = db.SqlExec(
                "SELECT * FROM System_Setup WHERE id=@DivisionID",
                new { DivisionID = SafeInt(DivisionID) });

            if (dtSys.Rows.Count > 0)
            {
                var row = dtSys.Rows[0];
                for (int i = 0; i < dtSys.Columns.Count; i++)
                {
                    var colName = dtSys.Columns[i].ColumnName;
                    var index = ItemIndex(colName);
                    if (index > -1)
                        mOptions[index].Value = row[i]?.ToString() ?? "";
                }

                // Handle misspelled column name in database
                var coIdx = ItemIndex("COEntryPriorToPurchase");
                if (coIdx > -1)
                {
                    try { mOptions[coIdx].Value = row["COEntryPriorToPurch"]?.ToString() ?? ""; }
                    catch { /* non-critical */ }
                }
            }

            // Reset dirty flags
            for (int i = (int)OptionsEnum._AppOptions; i <= (int)OptionsEnum._EndOfOptions; i++)
                mOptions[i].Dirty = false;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Options.ReadData error: {ex.Message}");
        }
    }

    // === SaveData (from VB6 Options.SaveData) ===

    /// <summary>
    /// Saves all dirty options back to their respective tables.
    /// AppOptions go to the AppOptions table; SystemSettings go to System_Setup.
    /// UserOptions are saved per-user in AppOptions.
    /// </summary>
    public void SaveData()
    {
        var appStart = (int)OptionsEnum._AppOptions;
        var sysStart = (int)OptionsEnum._SystemSettings;
        var userStart = (int)OptionsEnum._UserOptions;
        var end = (int)OptionsEnum._EndOfOptions;

        for (int i = 1; i < mOptions.Length; i++)
        {
            if (!mOptions[i].Dirty)
                continue;

            try
            {
                // Handle misspelled column COEntryPriorToPurchase
                if (i == (int)OptionsEnum.COEntryPriorToPurchase)
                {
                    db.ExecuteNonQuery(
                        "UPDATE System_Setup SET COEntryPriorToPurch=@Value WHERE id=@DivisionID",
                        new { Value = mOptions[i].Value, DivisionID = SafeInt(DivisionID) });
                }

                // Boolean system_setup fields
                if (i == (int)OptionsEnum.SendFaxUsingPurchasersInfo
                    || i == (int)OptionsEnum.UsePricingFromEstimating
                    || i == (int)OptionsEnum.RemoveDetailsonSpecConvert
                    || i == (int)OptionsEnum.PromptForSpecOptions
                    || i == (int)OptionsEnum.COEntryPriorToPurchase
                    || i == (int)OptionsEnum.ShowAssignCustOnly)
                {
                    var bitVal = string.Equals(mOptions[i].Value, "True", StringComparison.OrdinalIgnoreCase) ? 1 : 0;
                    db.ExecuteNonQuery(
                        $"UPDATE System_Setup SET {mOptions[i].Name}=@Value WHERE id=@DivisionID",
                        new { Value = bitVal, DivisionID = SafeInt(DivisionID) });
                }
                else if (i > sysStart && i < userStart)
                {
                    // System settings -> system_setup table
                    db.ExecuteNonQuery(
                        $"UPDATE System_Setup SET {mOptions[i].Name}=@Value WHERE id=@DivisionID",
                        new { Value = mOptions[i].Value, DivisionID = SafeInt(DivisionID) });
                }
                else if (GlobalOptionNames.Contains(mOptions[i].Name))
                {
                    // Global AppOptions (DivisionId=0)
                    db.ExecuteNonQuery(
                        @"IF NOT EXISTS (SELECT 1 FROM AppOptions WHERE UID='' AND OptionName=@OptionName AND ISNULL(DivisionId,0)=0)
                          INSERT INTO AppOptions(DivisionId, UID, OptionName, OptionValue, UStmp, TStmp)
                          VALUES(0, '', @OptionName, @Value, @LoginID, GETDATE())
                        ELSE
                          UPDATE AppOptions SET OptionValue=@Value, UStmp=@LoginID, TStmp=GETDATE()
                          WHERE UID='' AND OptionName=@OptionName AND ISNULL(DivisionId,0)=0",
                        new { OptionName = mOptions[i].Name, Value = mOptions[i].Value, LoginID });
                }
                else if (i > appStart && i < sysStart)
                {
                    // Division-specific AppOptions
                    db.ExecuteNonQuery(
                        @"IF NOT EXISTS (SELECT 1 FROM AppOptions WHERE UID='' AND OptionName=@OptionName AND DivisionID=@DivisionID)
                          INSERT INTO AppOptions(UID, OptionName, OptionValue, DivisionID, UStmp, TStmp)
                          VALUES('', @OptionName, @Value, @DivisionID, @LoginID, GETDATE())
                        ELSE
                          UPDATE AppOptions SET OptionValue=@Value, UStmp=@LoginID, TStmp=GETDATE()
                          WHERE UID='' AND DivisionID=@DivisionID AND OptionName=@OptionName",
                        new { OptionName = mOptions[i].Name, Value = mOptions[i].Value, DivisionID = SafeInt(DivisionID), LoginID });
                }
                else if (i > userStart && i < end)
                {
                    // User-specific AppOptions
                    db.ExecuteNonQuery(
                        @"IF NOT EXISTS (SELECT 1 FROM AppOptions WHERE UID=@LoginID AND OptionName=@OptionName)
                          INSERT INTO AppOptions(UID, OptionName, OptionValue, UStmp, TStmp)
                          VALUES(@LoginID, @OptionName, @Value, @LoginID, GETDATE())
                        ELSE
                          UPDATE AppOptions SET OptionValue=@Value, UStmp=@LoginID, TStmp=GETDATE()
                          WHERE UID=@LoginID AND OptionName=@OptionName",
                        new { OptionName = mOptions[i].Name, Value = mOptions[i].Value, LoginID });
                }
            }
            catch
            {
                // VB6 used On Error Resume Next - continue saving remaining options
            }
        }
    }

    private int ItemIndex(string optionName)
    {
        for (int i = 0; i < (int)OptionsEnum._EndOfOptions; i++)
        {
            if (string.Equals(mOptions[i].Name, optionName, StringComparison.OrdinalIgnoreCase))
                return i;
        }
        return -1;
    }

    private static int SafeInt(string? value, int defaultValue = 0)
    {
        if (string.IsNullOrWhiteSpace(value)) return defaultValue;
        return int.TryParse(value.Trim(), out var result) ? result : defaultValue;
    }
