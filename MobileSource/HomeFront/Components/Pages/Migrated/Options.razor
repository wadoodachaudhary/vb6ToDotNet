    // === Option Record ===

    private class OptionRec
    {
        public string Name { get; set; } = "";
        public string Value { get; set; } = "";
        public bool Dirty { get; set; } = false;
    }

    // === State ===

    private OptionRec[] mOptions = Array.Empty<OptionRec>();
// External dependencies (should be set by the hosting component or via DI)
    public string LoginID { get; set; } = "";
    public string DivisionID { get; set; } = "1";
    public string StatusLabel { get; set; } = "";
    public bool Closing { get; set; } = false;

    // === Global option names that go to AppOptions with DivisionId=0 ===
    private static readonly HashSet<string> GlobalOptionNames = new(StringComparer.OrdinalIgnoreCase)
    {
        "FaxServer", "FaxProvider", "FaxBillingCode",
        "Format_QtyRateEQZero_ForeColor", "Format_QtyRateEQZero_BackColor", "Format_QtyRateEQZero_FontStyle",
        "Format_QtyRateLTZero_ForeColor", "Format_QtyRateLTZero_BackColor", "Format_QtyRateLTZero_FontStyle",
        "Format_InvalidData_ForeColor", "Format_InvalidData_BackColor", "Format_InvalidData_FontStyle",
        "Format_NonSysRate_ForeColor", "Format_NonSysRate_BackColor", "Format_NonSysRate_FontStyle",
        "CRMClientID", "CRMApiKey", "CRMEnvironment"
    };

    // === Properties ===

    public int Count => (int)OptionsEnum._EndOfOptions;

    public string GetName(OptionsEnum index) => mOptions[(int)index].Name;

    public string GetValue(OptionsEnum index) => mOptions[(int)index].Value;

    public void SetValue(OptionsEnum index, string value)
    {
        var idx = (int)index;
        if (mOptions[idx].Value != value)
            mOptions[idx].Dirty = true;
        mOptions[idx].Value = value;
    }

    public string GetValueByName(string optionName)
    {
        var index = ItemIndex(optionName);
        if (index != -1)
            return mOptions[index].Value;

        // Fall back to database lookups
        try
        {
            var dt = db.SqlExec(
                $"SELECT {optionName} FROM system_setup WHERE id=@DivisionID",
                new { DivisionID = SafeInt(DivisionID) });
            if (dt.Rows.Count > 0 && dt.Rows[0][0] != DBNull.Value)
                return dt.Rows[0][0]?.ToString() ?? "";
        }
        catch { /* non-critical */ }

        try
        {
            var dt = db.SqlExec(
                @"SELECT optionvalue FROM appoptions
                  WHERE ISNULL(divisionid,0) IN (0, @DivisionID)
                    AND optionname = @OptionName
                  ORDER BY divisionid DESC",
                new { DivisionID = SafeInt(DivisionID), OptionName = optionName });
            if (dt.Rows.Count > 0 && dt.Rows[0][0] != DBNull.Value)
                return dt.Rows[0][0]?.ToString() ?? "";
        }
        catch { /* non-critical */ }

        return "";
    }

    public void SetValueByName(string optionName, string value)
    {
        var index = ItemIndex(optionName);
        if (index != -1)
        {
            if (mOptions[index].Value != value)
                mOptions[index].Dirty = true;
            mOptions[index].Value = value;
        }

        // Save immediately to system_setup
        try
        {
            db.ExecuteNonQuery(
                $"UPDATE system_setup SET {optionName} = @Value WHERE id = @DivisionID",
                new { Value = value, DivisionID = SafeInt(DivisionID) });
        }
        catch { /* non-critical */ }

        // Save to AppOptions
        if (GlobalOptionNames.Contains(optionName))
        {
            // Global appoptions (DivisionId=0)
            try
            {
                db.ExecuteNonQuery(
                    @"IF NOT EXISTS (SELECT 1 FROM AppOptions WHERE UID='' AND OptionName=@OptionName AND ISNULL(DivisionId,0)=0)
                      INSERT INTO AppOptions(DivisionId, UID, OptionName, OptionValue, UStmp, TStmp)
                      VALUES(0, '', @OptionName, @Value, @LoginID, GETDATE())
                    ELSE
                      UPDATE AppOptions SET OptionValue=@Value, UStmp=@LoginID, TStmp=GETDATE()
                      WHERE UID='' AND OptionName=@OptionName AND ISNULL(DivisionId,0)=0",
                    new { OptionName = optionName, Value = value, LoginID });
            }
            catch { /* non-critical */ }
        }
        else
        {
            // Division-specific appoptions
            try
            {
                db.ExecuteNonQuery(
                    @"IF NOT EXISTS (SELECT 1 FROM AppOptions WHERE UID='' AND OptionName=@OptionName AND DivisionID=@DivisionID)
                      INSERT INTO AppOptions(UID, OptionName, OptionValue, DivisionID, UStmp, TStmp)
                      VALUES('', @OptionName, @Value, @DivisionID, @LoginID, GETDATE())
                    ELSE
                      UPDATE AppOptions SET OptionValue=@Value, UStmp=@LoginID, TStmp=GETDATE()
                      WHERE UID='' AND DivisionID=@DivisionID AND OptionName=@OptionName",
                    new { OptionName = optionName, Value = value, DivisionID = SafeInt(DivisionID), LoginID });
            }
            catch { /* non-critical */ }
        }
    }

