@namespace HomeFront.Components.Pages

@using Fx.ControlKit
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject ILogger<FPricingWorksheetLayouts> Logger
@inject NotificationService Notifications

<DialogControl Visible="IsVisible"
               VisibleChanged="OnVisibleChanged"
               Header="Worksheet Layouts"
               Width="544px"
               IsModal="true"
               ShowCloseIcon="true">
    <ChildContent>
        <div class="dialog-body">
            <div class="left-panel" @onfocusin="OnTextAreaFocus">
                <TextAreaControl @bind-Value="LayoutsText"
                                 Rows="12"
                                 Placeholder="Enter layout names..."
                                 CssClass="layouts-textarea" />
            </div>
            <div class="right-panel">
                <p class="info-label">
                    These layout names will appear in the Layout dropdown on the Pricing Worksheet.
                    Each layout saves and restores the column visibility, order, and widths of the worksheet grid.
                </p>
                <p class="info-label">
                    When you select a layout from the dropdown, the worksheet grid will be reconfigured
                    to match the saved column settings for that layout.
                </p>
                <p class="info-label">
                    Enter one layout name per line.
                </p>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="OnOkClick">OK</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnCancelClick">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    /// <summary>
    /// Controls visibility of the dialog.
    /// </summary>
    [Parameter] public bool IsVisible { get; set; }

    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>
    /// The layouts text (one layout name per line).
    /// </summary>
    [Parameter] public string Layouts { get; set; } = "";

    [Parameter] public EventCallback<string> LayoutsChanged { get; set; }

    /// <summary>
    /// Fired when the user clicks OK. Returns true if OK was clicked, false if cancelled.
    /// The updated Layouts value is available via the LayoutsChanged binding.
    /// </summary>
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    private string LayoutsText = "";

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            LayoutsText = Layouts ?? "";
        }
    }

    /// <summary>
    /// Programmatic way to open the dialog (mirrors VB6 ShowForm).
    /// In Blazor, the result comes through the OnClose callback
    /// and the updated Layouts value via LayoutsChanged binding,
    /// since Blazor does not support blocking modal dialogs.
    /// </summary>
    public async Task ShowFormAsync(string layouts)
    {
        LayoutsText = layouts;
        IsVisible = true;
        await IsVisibleChanged.InvokeAsync(true);
        StateHasChanged();
    }

    private async Task OnOkClick()
    {
        Layouts = LayoutsText;
        await LayoutsChanged.InvokeAsync(Layouts);
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnClose.InvokeAsync(true);
    }

    private async Task OnCancelClick()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnClose.InvokeAsync(false);
    }

    // DialogControl's overlay-click / × close icon both route here; treat as Cancel
    // (matches the original hand-rolled dialog where both invoked OnCancelClick).
    private async Task OnVisibleChanged(bool visible)
    {
        if (!visible)
        {
            await OnCancelClick();
        }
        else
        {
            IsVisible = true;
            await IsVisibleChanged.InvokeAsync(true);
        }
    }

    private async Task OnTextAreaFocus()
    {
        // Select all text in the textarea on focus (equivalent to VB6 SelectAll)
        await JSRuntime.InvokeVoidAsync("eval", @"
            setTimeout(() => {
                const ta = document.querySelector('.layouts-textarea');
                if (ta) { ta.select(); }
            }, 50);
        ");
    }
}
