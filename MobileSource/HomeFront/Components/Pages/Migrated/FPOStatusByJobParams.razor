@page "/po-status-by-job-params"
@rendermode InteractiveServer
@namespace HomeFront.Components.Pages
@layout HFComponent

@using System.Data
@using Fx.ControlKit
@using Fx.ControlKit.Notifications
@using HomeFront.Data
@using HomeFront.Services

@inject NavigationManager NavigationManager
@inject ILogger<FPOStatusByJobParams> Logger
@inject NotificationService Notifications
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db
@inject POStatusByJobReportRequestService ReportRequest

<PageTitle>PO Status by Job - Report Parameters</PageTitle>

@*
   PO Status by Job Report — parameter screen.

   Mirrors the VB6 "Enter Parameter Values" dialog for PO Status by Job v1.rpt:
   one multi-value Job picker (the only InUse user-entered parameter) plus the
   auto-injected DivisionID. Built on FxControlKit's MultiSelectDualListControl
   so the UX matches FModelCostsParams / FGlobalOptionCostsParams.
*@

<div class="mcp-container">
    <div class="mcp-header">
        <h3>PO Status by Job — Parameters</h3>
        <span class="mcp-sub">Pick one or more Jobs to include in the report.</span>
    </div>

    @if (_loadError != null)
    {
        <div class="mcp-error">@_loadError</div>
    }

    <div class="mcp-section">
        <div class="mcp-section-title">Jobs</div>
        <MultiSelectDualListControl TItem="ListItem"
                                    Items="@_allJobs"
                                    @bind-SelectedItems="_selectedJobs"
                                    LeftHeader="Available Jobs"
                                    RightHeader="Selected Jobs"
                                    KeySelector="@(i => i.Key)"
                                    LabelSelector="@(i => i.Label)"
                                    VisibleRows="14"
                                    Height="380px" />
    </div>

    <div class="mcp-actions">
        <div class="mcp-summary">
            <span><strong>@_selectedJobs.Count</strong> job(s)</span>
        </div>
        <button class="btn btn-secondary" type="button" @onclick="OnCancel">Cancel</button>
        <button class="btn btn-primary" type="button"
                disabled="@(!CanRun)"
                @onclick="OnRun">
            View Report
        </button>
    </div>
</div>

@code {
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private List<ListItem> _allJobs = new();
    private IList<ListItem> _selectedJobs = new List<ListItem>();
    private string? _loadError;

    private void Navigate(string route)
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke(route);
        else
            NavigationManager.NavigateTo(route);
    }

    private bool CanRun => _selectedJobs.Count > 0;

    protected override void OnInitialized()
    {
        try
        {
            LoadJobs();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FPOStatusByJobParams: failed to load jobs");
            _loadError = "Could not load jobs: " + ex.Message;
        }
    }

    private void LoadJobs()
    {
        // Active jobs for the current division. Mirrors the picklist used by
        // ReportParameterPickListService for the "Job" parameter.
        var divId = SessionState.DivisionID;
        var sql = @"SELECT Job_No, Description
                    FROM tblJobs
                    WHERE DivisionID = @DivisionID
                      AND ISNULL(Inactive, 0) = 0
                      AND ISNULL(Job_No, '') <> ''
                    ORDER BY Job_No";
        var dt = db.SqlExec(sql, new { DivisionID = divId });
        _allJobs = new List<ListItem>(dt.Rows.Count);
        foreach (DataRow r in dt.Rows)
        {
            var job = r["Job_No"]?.ToString() ?? "";
            if (string.IsNullOrEmpty(job)) continue;
            var desc = r["Description"]?.ToString();
            var label = string.IsNullOrWhiteSpace(desc) ? job : $"{job} — {desc}";
            _allJobs.Add(new ListItem(job, label));
        }
    }

    private void OnRun()
    {
        if (!CanRun)
        {
            Notifications.Warning("PO Status by Job", "Please select at least one Job.");
            return;
        }

        ReportRequest.SetSelection(_selectedJobs.Select(j => j.Key));

        var jobKeys = string.Join(",", _selectedJobs.Select(j => Uri.EscapeDataString(j.Key)));
        Navigate($"/po-status-by-job-report?jobs={jobKeys}");
    }

    private void OnCancel() => Navigate("/");

    /// <summary>Generic key/label record used by the dual-list panes.</summary>
    public sealed record ListItem(string Key, string Label);
}
