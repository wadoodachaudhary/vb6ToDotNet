@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - Initial port from VB6
   ───────────────────────────────────────────────────────────────── *@
@page "/workflow-estimating"
@implements IDisposable

@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using HomeFront.Data
@using System.Globalization
@using System.Reflection
@using Fx.ControlKit.Notifications
@using HomeFront.Services
@inject IGridLayoutService GridLayoutSvc
@inject ILogger<WorkflowEstimating> Logger
@inject ISessionStateService SessionState
@inject NavigationManager NavigationManager
@using HomeFront.Models
@inject DbWrapperSqlServer db
@layout HFComponent
<PageTitle>HSMC - Estimating Workflow</PageTitle>

<div class="workflow-estimating-layout">
    <div class="workflow-diagram">
        <DiagramControl Nodes="@_nodes"
                   Connectors="@_connectors"
                   Width="@DiagramWidthPx"
                   Height="@DiagramHeightPx"
                   NodeClicked="OnNodeClicked" />
    </div>
    <div class="financial-col">
        @* VB6 parity (FHome2/WorkflowEstimating right panel): one-line bold
           job header, a tight 2-column [label | right-aligned amount] table,
           a divider before Total Costs, then Contacts/Attachments icons
           inline. No <p> tags, no Bootstrap row/col padding — each line
           sits at line-height: 1.4 so the whole card fits in ~210 px and
           the Current Jobs grid can claim the rest of the column. *@
        <div class="we-summary">
            <div class="we-summary-title">@CurrentJobTitle</div>
            <table class="we-summary-table">
                <tr><td>Original Budget:</td><td>@Estimate.ToString("C")</td></tr>
                <tr><td>Approved Changes:</td><td>@ApprovedChanges.ToString("C")</td></tr>
                <tr><td>Pending Changes:</td><td>@PendingChanges.ToString("C")</td></tr>
                <tr class="we-summary-total"><td>Total Budget:</td><td>@TotalBudget.ToString("C")</td></tr>
                <tr class="we-summary-spacer"><td colspan="2"></td></tr>
                <tr><td>Job to Date Cost:</td><td>@JTDCost.ToString("C") @JTDPercent</td></tr>
                <tr><td>Cost to Complete:</td><td>@CostToComplete.ToString("C")</td></tr>
            </table>
            @* VB6 FHome2 had these as clickable "Contacts" / "Attachments"
               labels in the right-side panel. Both render as inline modal
               dialogs over the workflow page (matching the VB6 screenshot
               where each pops a small floating window). Real .ico files
               live under wwwroot/images/24/. *@
            <div class="we-summary-icons">
                <button type="button" class="we-icon-link" @onclick="OnContactsClick">
                    <img src="images/24/contacts.ico" alt="" onerror="this.style.display='none'" /> Contacts
                </button>
                <button type="button" class="we-icon-link" @onclick="OnAttachmentsClick">
                    <img src="images/24/attachments.ico" alt="" onerror="this.style.display='none'" /> Attachments
                </button>
            </div>
        </div>

        @* FContacts is rendered inline with IsModal=true so it overlays
           the workflow page instead of stealing an MDI tab. _showContactsModal
           flips its visibility; the OnClose callback fires when the user
           dismisses it. VB6 FContacts.ShowForm was modal-blocking — same UX. *@
        @if (_showContactsModal)
        {
            <FContacts IsModal="true" Job="@CurrentJob" OnClose="OnContactsClosed" />
        }

        @* FAttachments is a self-modal dialog (DialogControl IsModal=true)
           rendered inline so it overlays the workflow page. We hold a
           @ref and call ShowForm(caption, (objectId, folder)) from the
           Attachments button — same calling pattern as FEstimateItems. *@
        <FAttachments @ref="attachmentsDialog" />

        @* Current Jobs grid takes whatever vertical space remains in the
           right-side column. Height = 100% lets the MDI pane own viewport
           sizing; using 100vh here would make the browser page scroll. *@
        <div class="jobs-grid">
            <div class="we-jobs-header">Current Jobs</div>
            @* AllowPaging=false: with the grid pinned to calc(100vh - chrome)
               internal scrolling shows every row that fits, and the user can
               scroll to see the rest. Paging artificially capped the visible
               set at the Syncfusion default of 12 — incongruous with a panel
               that's intentionally tall. *@
            <GridControl @ref="gJobs"
                    TValue="Job"
                    DataSource="@JobsData"
                    AllowSorting="true"
                    AllowPaging="false"
                    AllowResizing="true"
                    AllowSelection="true"
                    EnableHover="true"
                    Height="100%"
                    OnLayoutChanged="@OnJobsLayoutChangedAsync"
                    SelectionSettingsRef="@jobsSelection"
                    EventsRef="@jobsEvents">
                                <GridColumnsBase @key="JobsGridLayoutVersion" DebugTag="FHome2-gJobs">
                                    @if (HasJobsGridLayout)
                                    {
                                        @foreach (var entry in GetOrderedJobsGridLayout())
                                        {
                                            var layout = entry.Layout;
                                            var fieldName = entry.Field;
                                            var columnType = entry.ColumnType;
                                            var textAlign = entry.TextAlign;
                                            var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                                            var width = layout.Width.HasValue && layout.Width.Value > 0
                                                ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                                                : null;
                                            <GridColumn Field="@fieldName"
                                                          HeaderText="@headerText"
                                                          Width="@width"
                                                          Type="@columnType"
                                                          TextAlign="@textAlign"
                                                          ClipMode="ClipMode.Ellipsis"
                                                          AllowEditing="false"
                                                          Visible="true" />
                                        }
                                    }
                                    else
                                    {
                                        <GridColumn Field="@nameof(Job.JobNumber)" HeaderText="Job" Width="150px" />
                                        <GridColumn Field="@nameof(Job.JobDescription)" HeaderText="Description" Width="150px" />
                                        <GridColumn Field="@nameof(Job.JobAddress)" HeaderText="Address" Width="120px" Visible="true" />
                                        <GridColumn Field="@nameof(Job.DivisionID)" HeaderText="Division ID" Width="120px" Visible="false" />
                                    }
                                </GridColumnsBase>
                            </GridControl>
                        </div>
                    </div>
    </div>




@code {
    // ── Icon path helper ────────────────────────────────────────────────
    private const string IconBase = "images/workflow";
private const double DiagramScale = 1.04;
    private const double DiagramBaseWidth = 820;
    private const double DiagramBaseHeight = 640;
    private static string DiagramWidthPx => (DiagramBaseWidth * DiagramScale).ToString("0.#", CultureInfo.InvariantCulture);
    private static string DiagramHeightPx => (DiagramBaseHeight * DiagramScale).ToString("0.#", CultureInfo.InvariantCulture);
    private GridControl<Job>? gJobs;
    private readonly List<Job> JobsData = new();
    private int activeTab = 1;
    private FAttachments? attachmentsDialog;
    private bool _showContactsModal;

    // VB6 FHome2 right-panel Contacts/Attachments links — both render as
    // inline modal dialogs over the workflow page (matching the VB6
    // screenshot where each pops a small floating window):
    //   Contacts    → flip _showContactsModal; FContacts(IsModal=true)
    //                 renders in the markup above with OnClose hook.
    //   Attachments → call attachmentsDialog.ShowForm(caption, (id, folder)).
    private void OnContactsClick()
    {
        if (string.IsNullOrWhiteSpace(CurrentJob)) return;
        _showContactsModal = true;
    }

    private void OnContactsClosed(bool _saved)
    {
        // FContacts.OnClose payload is "did the user save?" — we don't
        // need to act on that here (no parent-side state to refresh);
        // just dismiss the modal.
        _showContactsModal = false;
    }

    private async Task OnAttachmentsClick()
    {
        if (attachmentsDialog == null || string.IsNullOrWhiteSpace(CurrentJob))
        {
            return;
        }
        var folder = $"Jobs/{CurrentJob}";
        var caption = "Attachments";
        await attachmentsDialog.ShowForm(caption, (CurrentJob, folder));
    }

    // Grid layout (IniGetGrid pattern matching FHome2.frm gJobs)
    // ── Grid layout via the shared GridLayoutPresenter (standard AppGridLayout
    //    path — same processing as every other migrated grid). VB6: FHome2
    //    IniGetGrid(Me, gJobs). Aliases map the VB6 colkeys → Job properties. ──
    private readonly GridLayoutPresenter<Job> _jobsGrid =
        new("FHome2", "gJobs",
            aliases: new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["job"] = nameof(Job.JobNumber),
                ["description"] = nameof(Job.JobDescription),
                ["address"] = nameof(Job.JobAddress),
            });
    private Dictionary<string, GridLayoutColumn> JobsGridLayout => _jobsGrid.Layout;
    private bool HasJobsGridLayout => _jobsGrid.Has;
    private int JobsGridLayoutVersion => _jobsGrid.Version;

    private readonly SelectionSettings jobsSelection = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single,
        EnableToggle = true
    };

    private readonly GridControlEvents<Job> jobsEvents = new();

    private string CurrentJobTitle = "";
    private decimal Contract = 0;
    private decimal Estimate = 0;
    private decimal ApprovedChanges = 0;
    private decimal PendingChanges = 0;
    private decimal JTDCost = 0;
    private string JTDPercent = "";
    private decimal CostToComplete = 0;
    private decimal TotalBudget = 0;
    private string CurrentJob = "";   // resolved in OnInitializedAsync to the first job in the list
    private string CurrentJobDesc = "";
    private string DivisionId = "1";

    protected override void OnInitialized()
    {
        // Single-click row selection: update the right-panel totals as
        // soon as the user clicks a job row. RowSelected is debounced
        // by the grid (fires once per selection, not on every hover) so
        // it's safe to bind to a DB-hitting handler.
        jobsEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<Job>>(this, JobRowSelectedHandler);

        // The Workflow home stays open across a division change (it is the shell's home
        // pane, not an MDI tab), so it reloads its division-scoped jobs when FMain
        // pushes the new DivisionID into the session.
        SessionState.DivisionChanged += OnSessionDivisionChanged;
    }

    private void OnSessionDivisionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadJobDataAsync();

            // A job carried over from the old division is meaningless here — reset to
            // the first job of the new division, same as the initial-load behavior.
            if (!JobsData.Any(j => string.Equals(j.JobNumber, SessionState.JobNumber, StringComparison.OrdinalIgnoreCase)))
            {
                CurrentJob = JobsData.Count > 0 ? JobsData[0].JobNumber : "";
                SessionState.JobNumber = CurrentJob;
                CurrentJobDesc = JobsData.FirstOrDefault(j => j.JobNumber == CurrentJob)?.JobDescription ?? "";
                await LoadCurrentJobAsync();
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        SessionState.DivisionChanged -= OnSessionDivisionChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // Load the Current Jobs list FIRST so we can auto-select the first row.
        await LoadJobDataAsync();

        // Session-wide current job (VB6 FMain.CurrentJob): keep an existing session job; otherwise
        // auto-select the FIRST job in the list and publish it (VB6 FHome highlighted row 1 on load).
        if (!string.IsNullOrEmpty(SessionState.JobNumber))
        {
            CurrentJob = SessionState.JobNumber;
        }
        else if (JobsData.Count > 0)
        {
            CurrentJob = JobsData[0].JobNumber;
            SessionState.JobNumber = CurrentJob;
        }
        var sel = JobsData.FirstOrDefault(j => j.JobNumber == CurrentJob);
        CurrentJobDesc = sel?.JobDescription ?? "";

        await LoadCurrentJobAsync();
    }

    private async Task LoadCurrentJobAsync()
    {
        try
        {
            string currentJob = CurrentJob;

            string sqlBilling = @"
            SELECT SUM(price)
            FROM billingitems
            WHERE Job = @Job";

            decimal contract = await db.ExecuteScalarAsync<decimal>(sqlBilling, new { Job = currentJob });

            string sqlEstimate = @"
            SELECT 
                SUM(CASE WHEN IsChange=0 AND BudgetDeleted<>1 THEN BudgetPretax + BudgetJCTax ELSE 0 END) AS Budgeted,
                SUM(CASE WHEN IsChange=1 AND ischangerequest=0 AND BudgetDeleted<>1 THEN BudgetPretax + BudgetJCTax ELSE 0 END) AS ApprovedChanges,
                SUM(CASE WHEN IsChange=1 AND ischangerequest=1 AND BudgetDeleted<>1 THEN BudgetPretax + BudgetJCTax ELSE 0 END) AS PendingChanges
            FROM Estimateditems
            WHERE divisionid = @DivisionId
            AND Job_no = @Job";
            var estimateResults = await db.QueryAsync(sqlEstimate, new { DivisionId = DivisionId, Job = currentJob });
            decimal estimate = 0;
            decimal approvedChanges = 0;
            decimal pendingChanges = 0;
            if (estimateResults.Any())
            {
                var row = estimateResults[0];
                estimate = Convert.ToDecimal(row["Budgeted"] ?? 0);
                approvedChanges = Convert.ToDecimal(row["ApprovedChanges"] ?? 0);
                pendingChanges = Convert.ToDecimal(row["PendingChanges"] ?? 0);
            }

            string sqlJTD = @"
            SELECT SUM(pretax + jctax)
            FROM JCTransactions
            WHERE divisionid = @DivisionId
            AND Job = @Job
            AND TransactionType <> 'Estimate' AND TransactionType <> 'Purchaseorder'";
            decimal jtdCost = await db.ExecuteScalarAsync<decimal>(sqlJTD, new { DivisionId = DivisionId, Job = currentJob });

            Contract = contract;
            Estimate = estimate;
            ApprovedChanges = approvedChanges;
            PendingChanges = pendingChanges;
            JTDCost = jtdCost;

            TotalBudget = Estimate + ApprovedChanges;
            JTDPercent = TotalBudget != 0 ? $"({(JTDCost / TotalBudget * 100):0.0}%)" : "";
            CostToComplete = TotalBudget - JTDCost;
            CurrentJobTitle = $"{FormatJob(CurrentJob)}   {CurrentJobDesc}";

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading job data: {ex.Message}");
        }
    }

    private string FormatJob(string job)
    {
        return job;
    }

    private async Task LoadJobDataAsync()
    {
        await LoadJobsGridLayoutAsync();

        string sql = @"
            SELECT wj.*
            FROM workflowjobs wj
            JOIN tbljobs j ON (wj.DivisionID = j.DivisionID AND wj.job = j.job_no)
            LEFT OUTER JOIN DivisionCommunities d ON (d.Community = j.Community)
            WHERE (d.DivisionID IS NULL OR d.DivisionID = @DivisionID)
            AND j.DivisionID = @DivisionID
            ORDER BY wj.job";
        var parameters = new { DivisionID = SessionState.DivisionID };
        var result = await db.QueryAsync(sql, parameters);

        JobsData.Clear();
        foreach (var row in result)
        {
            var item = new Job
            {
                JobNumber = row["Job"]?.ToString() ?? "",
                JobDescription = row["Description"]?.ToString() ?? "",
                JobAddress = row["Address"]?.ToString() ?? ""
            };
            JobsData.Add(item);
        }

        if (gJobs != null)
        {
            await gJobs.RefreshAsync();
        }
    }

    // Fires once when the user clicks a job row in the Current Jobs grid.
    // VB6 FHome2.gJobs_Click loaded the summary immediately on selection
    // (no double-click). We mirror that — the right-panel totals refresh
    // as soon as a row is highlighted.
    public async Task JobRowSelectedHandler(RowSelectEventArgs<Job> args)
    {
        if (args.Data == null) return;
        CurrentJob = args.Data.JobNumber;
        CurrentJobDesc = args.Data.JobDescription;
        SessionState.JobNumber = CurrentJob;   // VB6 FHome2/FHome3: FMain.CurrentJob = picked job
        await LoadCurrentJobAsync();
    }

    public class Job
    {
        public int DivisionID { get; set; }
        public string JobNumber { get; set; } = string.Empty;

        public string JobDescription { get; set; } = string.Empty;
        public string JobAddress { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Community { get; set; } = string.Empty;
        public string Model { get; set; } = string.Empty;
        public string OptionID { get; set; } = string.Empty;

        public DateTime? StartDate { get; set; }
        public DateTime? TargetCompletionDate { get; set; }
        public DateTime? ActualCompletionDate { get; set; }
        public DateTime? CreatedDate { get; set; }
        public DateTime? LastUpdated { get; set; }

        public decimal? ContractAmount { get; set; }
        public decimal? OriginalEstimate { get; set; }
        public decimal? ApprovedChanges { get; set; }
        public decimal? PendingChanges { get; set; }
        public decimal? JobToDateCost { get; set; }

        public string Salesperson { get; set; } = string.Empty;
        public string ProjectManager { get; set; } = string.Empty;
        public string Estimator { get; set; } = string.Empty;

        public string JobType { get; set; } = string.Empty;
        public string Series { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
        public string Notes { get; set; } = string.Empty;

        public string DisplayJob => $"{JobNumber} - {JobDescription}".TrimEnd(" - ".ToCharArray());
        public string DateRangeDisplay
        {
            get
            {
                if (!StartDate.HasValue) return "No start date";
                if (!TargetCompletionDate.HasValue) return StartDate.Value.ToString("MMM dd, yyyy");
                return $"{StartDate.Value:MMM dd, yyyy} – {TargetCompletionDate.Value:MMM dd, yyyy}";
            }
        }

        public string ContractDisplay => ContractAmount?.ToString("C0") ?? "-";
        public string JTDCostDisplay => JobToDateCost?.ToString("C0") ?? "-";
    }

    // ── Grid layout helpers (IniGetGrid pattern) ──────────────────────────
    private async Task LoadJobsGridLayoutAsync()
    {
        // VB6: Call IniGetGrid(Me, gJobs) in FHome2. The keyed/unkeyed +
        // uid=''→char(1)→defaults fallback and Version bump live in the shared
        // presenter/service — identical processing to every other grid.
        await _jobsGrid.LoadAsync(GridLayoutSvc);
    }

    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedJobsGridLayout()
        => _jobsGrid.GetOrdered();

    private Task OnJobsLayoutChangedAsync(GridSettings snapshot) =>
        PersistGridLayoutAsync("gJobs", JobsGridLayout, snapshot, _jobsGrid);

    private async Task PersistGridLayoutAsync<T>(string gridName,
        IDictionary<string, GridLayoutColumn> layout, GridSettings snapshot,
        GridLayoutPresenter<T> presenter)
    {
        if (snapshot == null || layout.Count == 0) return;
        try
        {
            // The layout colkeys ("job", "description", …) differ from the Job
            // property names, so the presenter's resolver maps them for the merge.
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FHome2", gridName, instanceKey: null,
                layout, snapshot, layoutFieldResolver: presenter.ResolveField);
            presenter.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FHome2 {Grid} layout", gridName);
        }
    }

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // ── Shared style: transparent background, icon above label ──────────
    private static double S(double value) => value * DiagramScale;

    private static DiagramNode MakeNode(
        string id, string label, double x, double y,
        string icon, string? navigateUrl = null,
        double w = 32, double h = 32, bool enabled = true) => new()
    {
        Id = id,
        Label = "",
        OffsetX = S(x),
        OffsetY = S(y),
        Width = S(w),
        Height = S(h),
        Shape = DiagramControlShape.Rectangle,
        FillColor = "transparent",
        StrokeColor = "transparent",
        StrokeWidth = 0,
        TextColor = "#3378D4",
        CornerRadius = 0,
        BackgroundImage = $"{IconBase}/{icon}",
        BackgroundImageFit = ImageFit.Contain,
        BackgroundImageOpacity = 1.0,
        BackgroundImagePadding = 0,
        NavigateUrl = navigateUrl,
        Tooltip = label,
        Enabled = enabled
    };

    // ── Connector style ─────────────────────────────────────────────────
    private const string ArrowColor = "#688a99";

    private static DiagramConnector MakeConn(
        string id, string from, string to,
        DiagramPort srcPort = DiagramPort.Auto,
        DiagramPort tgtPort = DiagramPort.Auto,
        ConnectorType type = ConnectorType.Straight,
        bool isBroken = false) => new()
    {
        Id = id,
        SourceId = from,
        TargetId = to,
        Type = type,
        StrokeColor = ArrowColor,
        StrokeWidth = 2,
        ShowArrow = true,
        SourcePort = srcPort,
        TargetPort = tgtPort,
        IsBroken = isBroken
    };

    // ── Nodes ───────────────────────────────────────────────────────────
    //
    //  Layout matching VB6 FestimatingWorkflow:
    //
    //  Row 1 (y=80):                                     Salespricing Worksheets
    //  Row 2 (y=230):   Model & Option Library      Communities
    //  Row 3 (y=400):   Item DB         Default Vendors        Vendor Pricelists
    //  Row 4 (y=550):                   Vendor
    //

    private readonly List<DiagramNode> _nodes = new()
    {
        // ── Row 1 (top right) ──
        MakeNode("salespricing",   "Salespricing\nWorksheets",   650, 80,  "Salespricing worksheets.bmp",  "/pricing-worksheet", w: 70, h: 69, enabled: false),

        // ── Row 2 (middle) ──
        MakeNode("model-library",  "Model & Option\nLibrary",   230, 230, "Model Library.bmp",                  "/edit-model-assembly", w: 77, h: 66),
        MakeNode("communities",    "Communities",                430, 230, "communities.bmp",             "/communities", w: 63, h: 48),

        // ── Row 3 (lower) ──
        MakeNode("itemdb",         "Item DB",                     80, 400, "item db.bmp",                  "/items-db", w: 42, h: 51),
        MakeNode("default-vendors","Default\nVendors",          430, 400, "default vendors.bmp",          "/default-vendor", w: 51, h: 64),
        MakeNode("vendor-prices",  "Vendor\nPricelists",         650, 400, "vendor pricelists.bmp",        "/vendor-pricelist", w: 46, h: 62, enabled: false),

        // ── Row 4 (bottom) ──
        MakeNode("vendor",         "Vendor",                     430, 590, "vendor records.bmp",                  "/vendor", w: 47, h: 58, enabled: false),

        // ── Invisible T-junction node for c9 ──
        MakeNode("junction",       "",                           430, 80,  "",                            null, 0, 0),
    };

    // ── Connectors ──────────────────────────────────────────────────────
    //
    //  Matches VB6 arrows:
    //  - Model & Option Library ↔ Communities (bidirectional horizontal) [removed]
    //  - Communities → Default Vendors (down)
    //  - Item DB → Default Vendors (right)
    //  - Default Vendors → Vendor Pricelists (right)
    //  - Vendor → Default Vendors (up)
    //  - Vendor Pricelists → Salespricing Worksheets (up)
    //  - Item DB → Salespricing Worksheets (removed)
    //  - Model & Option Library → Salespricing Worksheets (orthogonal)
    //  - Communities → Salespricing Worksheets (vertical join to model connector)
    //

    private readonly List<DiagramConnector> _connectors = new()
    {
        // Model & Option Library ↔ Communities (removed)

        // Communities → Default Vendors (down)
        MakeConn("c3", "communities",   "default-vendors", DiagramPort.Bottom, DiagramPort.Top),

        // Item DB → Default Vendors (right)
        MakeConn("c4", "itemdb",        "default-vendors", DiagramPort.Right,  DiagramPort.Left),

        // Default Vendors → Vendor Pricelists (right)
        MakeConn("c5", "default-vendors","vendor-prices",  DiagramPort.Right,  DiagramPort.Left, isBroken: true),

        // Vendor → Default Vendors (up)
        MakeConn("c6", "vendor",        "default-vendors", DiagramPort.Top,    DiagramPort.Bottom, isBroken: true),

        // Vendor Pricelists → Salespricing Worksheets (up)
        MakeConn("c7", "vendor-prices", "salespricing",    DiagramPort.Top,    DiagramPort.Bottom, isBroken: true),

        // Model & Option Library → Salespricing Worksheets (orthogonal: up/right)
        MakeConn("c8", "model-library", "salespricing",    DiagramPort.Top,    DiagramPort.Left,   ConnectorType.Orthogonal, isBroken: true),

        // Communities → Salespricing Worksheets (straight: vertical UP to the horizontal connector line at the T-junction)
        MakeConn("c9", "communities",   "junction",        DiagramPort.Top,    DiagramPort.Bottom, ConnectorType.Straight, isBroken: true),
    };

    // ── Navigation ──────────────────────────────────────────────────────
    // When rendered inside FMain (via DynamicComponent), FMain provides
    // its NavigateToPage delegate as a CascadingValue. We intercept diagram
    // node clicks and route them through this delegate so the page renders
    // inline within FMain's shell (preserving menu bar, task panel, status bar).
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void OnNodeClicked(DiagramNodeClickEventArgs args)
    {
        if (ParentNavigate != null && !string.IsNullOrWhiteSpace(args.Node?.NavigateUrl))
        {
            args.Handled = true; // prevent DiagramControl's default NavigationManager.NavigateTo()
            ParentNavigate.Invoke(args.Node.NavigateUrl);
        }
    }
}
