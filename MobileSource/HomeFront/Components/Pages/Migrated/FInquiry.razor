@page "/inquiry"
@page "/inquiry/{FileName}"
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.IO
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FInquiry> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>@Caption - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Inquiry...</div>
    </div>
}

<div class="inquiry-container">
    @if (IsError)
    {
        <div class="error-display">

Unable to process inquiry.
@ErrorMessage

@SqlText
        </div>
    }
    else if (IsNonSelectResult)
    {
        <div class="success-display">

        @Caption has executed successfully.
        @AffectedRows row(s) were affected.
        </div>
    }
    else
    {
        <div class="inquiry-grid">
            <GridControl @ref="DataGrid"
                    TValue="InquiryRow"
                    DataSource="@GridData"
                    AllowSorting="true"
                    AllowResizing="true"
                    AllowSelection="true"
                    AllowFiltering="true"
                    AllowGrouping="@HasGrouping"
                    EnableHover="true"
                    Height="100%"
                    FilterSettingsRef="@filterSettings"
                    PageSettingsRef="@pageSettings"
                    SelectionSettingsRef="@selectionSettings"
                    GroupColumns="@GroupColumnsList"
                    ShowGroupExpandCollapse="true"
                    AggregateRows="@aggregateRows">
                <GridColumnsBase>
                    @foreach (var col in ColumnDefinitions)
                    {
                        <GridColumn Field="@col.Field"
                                      HeaderText="@col.HeaderText"
                                      Width="@col.Width"
                                      AllowEditing="false"
                                      TextAlign="@col.TextAlign"
                                      Format="@col.Format"
                                      Type="@col.ColumnType" />
                    }
                </GridColumnsBase>
            </GridControl>
        </div>
    }
</div>

@code {
    [Parameter] public string? FileName { get; set; }

    // Database
// UI State
    private bool IsLoading = false;
    private bool IsError = false;
    private bool IsNonSelectResult = false;
    private string Caption = "Inquiry";
    private string ErrorMessage = "";
    private string SqlText = "";
    private int AffectedRows = 0;

    // Grid
    private GridControl<InquiryRow>? DataGrid;
    private List<InquiryRow> GridData = new();
    private List<ColumnDef> ColumnDefinitions = new();
    private bool HasGrouping = false;
    private List<string> GroupColumnsList = new();
    private List<AggregateRow> aggregateRows = new();

    // Grid settings
    private FilterSettings filterSettings = new() { Type = FilterType.FilterBar };
    private PageSettings pageSettings = new() { PageSize = 100, PageSizes = new int[] { 50, 100, 200, 500 } };
    private SelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    // Grouping state parsed from file
    private string opCode = "";
    private int grpCol = -1;
    private int opCol = -1;

    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(FileName))
        {
            // Route parameter arrives URL-encoded from NavigateToPage($"/inquiry/{Uri.EscapeDataString(path)}")
            var decoded = Uri.UnescapeDataString(FileName);
            await ShowInquiry(decoded);
        }
    }

    // ── ShowInquiry ──────────────────────────────────────────────────────
    public async Task ShowInquiry(string sFileName)
    {
        IsLoading = true;
        IsError = false;
        IsNonSelectResult = false;
        GridData = new();
        ColumnDefinitions = new();
        aggregateRows = new();
        GroupColumnsList = new();
        HasGrouping = false;
        StateHasChanged();

        try
        {
            // Set caption from filename (strip path and extension, remove '&')
            Caption = Path.GetFileNameWithoutExtension(sFileName).Replace("&", "");

            // Read query from file
            string sql;
            if (File.Exists(sFileName))
            {
                sql = await File.ReadAllTextAsync(sFileName);
            }
            else
            {
                throw new FileNotFoundException($"Inquiry file not found: {sFileName}");
            }

            // Parse GROUP ON clause
            ParseGroupOn(sql);

            // Remove GROUP ON portion from SQL
            var groupOnIndex = sql.IndexOf("GROUP ON", StringComparison.OrdinalIgnoreCase);
            if (groupOnIndex >= 0)
            {
                sql = sql.Substring(0, groupOnIndex).Trim();
            }

            // Replace {SessionState.DivisionID} placeholder
            sql = sql.Replace("{DivisionID}", SessionState.DivisionID.ToString());
            SqlText = sql;

            // Determine if SELECT or non-SELECT
            if (!sql.TrimStart().StartsWith("SELECT", StringComparison.OrdinalIgnoreCase))
            {
                // Non-select statement (INSERT, UPDATE, DELETE, EXEC, etc.)
                await ExecuteNonSelect(sql);
            }
            else
            {
                // SELECT statement - load into grid
                await ExecuteSelect(sql);
            }
        }
        catch (Exception ex)
        {
            IsError = true;
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ── Parse GROUP ON ───────────────────────────────────────────────────
    private void ParseGroupOn(string sql)
    {
        opCode = "";
        grpCol = -1;
        opCol = -1;

        var groupOnIndex = sql.IndexOf("GROUP ON", StringComparison.OrdinalIgnoreCase);
        if (groupOnIndex < 0) return;

        var groupOnPart = sql.Substring(groupOnIndex + 8).Trim();

        // Clean up control characters
        groupOnPart = groupOnPart.Replace("\0", "").Replace("\r", "").Replace("\n", "").Trim();

        // Parse: <grpCol> <opCode> [<opCol>] [EXPAND]
        var parts = groupOnPart.Split(new[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 1)
        {
            if (int.TryParse(parts[0], out var gc))
                grpCol = gc - 1; // VB6 was 1-based
        }

        if (parts.Length >= 2)
        {
            opCode = parts[1].Trim().ToUpper();
        }

        if (parts.Length >= 3)
        {
            if (int.TryParse(parts[2], out var oc))
                opCol = oc - 1;
        }
    }

    // ── Execute Non-Select ───────────────────────────────────────────────
    private async Task ExecuteNonSelect(string sql)
    {
        var affected = await db.ExecuteAsync(sql);
        IsNonSelectResult = true;
        AffectedRows = affected;
    }

    // ── Execute Select ───────────────────────────────────────────────────
    private async Task ExecuteSelect(string sql)
    {
        var dt = db.SqlExec(sql);

        if (dt == null || dt.Columns.Count == 0)
        {
            IsNonSelectResult = true;
            AffectedRows = 0;
            return;
        }

        // Build column definitions
        ColumnDefinitions = new List<ColumnDef>();
        for (int i = 0; i < dt.Columns.Count; i++)
        {
            var col = dt.Columns[i];
            var colDef = new ColumnDef
            {
                Field = $"Col{i}",
                HeaderText = col.ColumnName,
                Width = "150px",
                TextAlign = TextAlign.Left,
                Format = "",
                ColumnType = ColumnType.Text
            };

            // Detect numeric types for formatting
            if (col.DataType == typeof(decimal) || col.DataType == typeof(double) || col.DataType == typeof(float))
            {
                colDef.TextAlign = TextAlign.Right;
                colDef.Format = "N2";
                colDef.ColumnType = ColumnType.Number;
            }
            else if (col.DataType == typeof(int) || col.DataType == typeof(long) || col.DataType == typeof(short))
            {
                colDef.TextAlign = TextAlign.Right;
                colDef.ColumnType = ColumnType.Number;
            }
            else if (col.DataType == typeof(DateTime))
            {
                colDef.Format = "d";
                colDef.ColumnType = ColumnType.Date;
            }

            ColumnDefinitions.Add(colDef);
        }

        // Build data rows
        GridData = new List<InquiryRow>();
        foreach (DataRow row in dt.Rows)
        {
            var inquiryRow = new InquiryRow();
            for (int i = 0; i < dt.Columns.Count; i++)
            {
                var val = row[i];
                inquiryRow.Values[$"Col{i}"] = val == DBNull.Value ? null : val;
            }
            GridData.Add(inquiryRow);
        }

        // Set up grouping if GROUP ON was specified
        SetupGrouping(dt);
    }

    // ── Setup Grouping ───────────────────────────────────────────────────
    private void SetupGrouping(DataTable dt)
    {
        if (string.IsNullOrEmpty(opCode) || grpCol < 0 || grpCol >= dt.Columns.Count)
            return;

        // Determine aggregate type
        var aggType = opCode switch
        {
            "SUM" => AggregateType.Sum,
            "COUNT" => AggregateType.Count,
            "AVG" => AggregateType.Average,
            "MAX" => AggregateType.Max,
            "MIN" => AggregateType.Min,
            "PERCENT" => AggregateType.Sum, // approximate
            _ => (AggregateType?)null
        };

        // Set group column
        var groupField = $"Col{grpCol}";
        HasGrouping = true;
        GroupColumnsList = new List<string> { groupField };

        // Set up aggregate if we have a valid operation
        if (aggType.HasValue && opCode != "NONE")
        {
            var aggColumns = new List<AggregateColumn>();

            if (opCol >= 0 && opCol < dt.Columns.Count)
            {
                // Aggregate on specific column
                aggColumns.Add(new AggregateColumn
                {
                    Field = $"Col{opCol}",
                    Type = aggType.Value,
                    Format = "N2",
                    GroupFooterTemplate = $"{opCode}: {{value}}",
                    FooterTemplate = $"Total: {{value}}"
                });
            }
            else
            {
                // Aggregate on all numeric columns
                for (int i = 0; i < dt.Columns.Count; i++)
                {
                    if (i == grpCol) continue;
                    var colType = dt.Columns[i].DataType;
                    if (colType == typeof(decimal) || colType == typeof(double) ||
                        colType == typeof(float) || colType == typeof(int) ||
                        colType == typeof(long) || colType == typeof(short))
                    {
                        aggColumns.Add(new AggregateColumn
                        {
                            Field = $"Col{i}",
                            Type = aggType.Value,
                            Format = "N2",
                            GroupFooterTemplate = $"{opCode}: {{value}}",
                            FooterTemplate = $"Total: {{value}}"
                        });
                    }
                }
            }

            if (aggColumns.Count > 0)
            {
                aggregateRows = new List<AggregateRow>
                {
                    new AggregateRow
                    {
                        ShowInGroupFooter = true,
                        ShowInFooter = true,
                        ShowInGroupCaption = true,
                        Columns = aggColumns
                    }
                };
            }
        }
    }

    // ── Models ───────────────────────────────────────────────────────────
    public class InquiryRow
    {
        public Dictionary<string, object?> Values { get; set; } = new();

        // Dynamic property access for grid binding - up to 50 columns
        public object? Col0 { get => GetVal("Col0"); set => SetVal("Col0", value); }
        public object? Col1 { get => GetVal("Col1"); set => SetVal("Col1", value); }
        public object? Col2 { get => GetVal("Col2"); set => SetVal("Col2", value); }
        public object? Col3 { get => GetVal("Col3"); set => SetVal("Col3", value); }
        public object? Col4 { get => GetVal("Col4"); set => SetVal("Col4", value); }
        public object? Col5 { get => GetVal("Col5"); set => SetVal("Col5", value); }
        public object? Col6 { get => GetVal("Col6"); set => SetVal("Col6", value); }
        public object? Col7 { get => GetVal("Col7"); set => SetVal("Col7", value); }
        public object? Col8 { get => GetVal("Col8"); set => SetVal("Col8", value); }
        public object? Col9 { get => GetVal("Col9"); set => SetVal("Col9", value); }
        public object? Col10 { get => GetVal("Col10"); set => SetVal("Col10", value); }
        public object? Col11 { get => GetVal("Col11"); set => SetVal("Col11", value); }
        public object? Col12 { get => GetVal("Col12"); set => SetVal("Col12", value); }
        public object? Col13 { get => GetVal("Col13"); set => SetVal("Col13", value); }
        public object? Col14 { get => GetVal("Col14"); set => SetVal("Col14", value); }
        public object? Col15 { get => GetVal("Col15"); set => SetVal("Col15", value); }
        public object? Col16 { get => GetVal("Col16"); set => SetVal("Col16", value); }
        public object? Col17 { get => GetVal("Col17"); set => SetVal("Col17", value); }
        public object? Col18 { get => GetVal("Col18"); set => SetVal("Col18", value); }
        public object? Col19 { get => GetVal("Col19"); set => SetVal("Col19", value); }
        public object? Col20 { get => GetVal("Col20"); set => SetVal("Col20", value); }
        public object? Col21 { get => GetVal("Col21"); set => SetVal("Col21", value); }
        public object? Col22 { get => GetVal("Col22"); set => SetVal("Col22", value); }
        public object? Col23 { get => GetVal("Col23"); set => SetVal("Col23", value); }
        public object? Col24 { get => GetVal("Col24"); set => SetVal("Col24", value); }
        public object? Col25 { get => GetVal("Col25"); set => SetVal("Col25", value); }
        public object? Col26 { get => GetVal("Col26"); set => SetVal("Col26", value); }
        public object? Col27 { get => GetVal("Col27"); set => SetVal("Col27", value); }
        public object? Col28 { get => GetVal("Col28"); set => SetVal("Col28", value); }
        public object? Col29 { get => GetVal("Col29"); set => SetVal("Col29", value); }
        public object? Col30 { get => GetVal("Col30"); set => SetVal("Col30", value); }
        public object? Col31 { get => GetVal("Col31"); set => SetVal("Col31", value); }
        public object? Col32 { get => GetVal("Col32"); set => SetVal("Col32", value); }
        public object? Col33 { get => GetVal("Col33"); set => SetVal("Col33", value); }
        public object? Col34 { get => GetVal("Col34"); set => SetVal("Col34", value); }
        public object? Col35 { get => GetVal("Col35"); set => SetVal("Col35", value); }
        public object? Col36 { get => GetVal("Col36"); set => SetVal("Col36", value); }
        public object? Col37 { get => GetVal("Col37"); set => SetVal("Col37", value); }
        public object? Col38 { get => GetVal("Col38"); set => SetVal("Col38", value); }
        public object? Col39 { get => GetVal("Col39"); set => SetVal("Col39", value); }
        public object? Col40 { get => GetVal("Col40"); set => SetVal("Col40", value); }
        public object? Col41 { get => GetVal("Col41"); set => SetVal("Col41", value); }
        public object? Col42 { get => GetVal("Col42"); set => SetVal("Col42", value); }
        public object? Col43 { get => GetVal("Col43"); set => SetVal("Col43", value); }
        public object? Col44 { get => GetVal("Col44"); set => SetVal("Col44", value); }
        public object? Col45 { get => GetVal("Col45"); set => SetVal("Col45", value); }
        public object? Col46 { get => GetVal("Col46"); set => SetVal("Col46", value); }
        public object? Col47 { get => GetVal("Col47"); set => SetVal("Col47", value); }
        public object? Col48 { get => GetVal("Col48"); set => SetVal("Col48", value); }
        public object? Col49 { get => GetVal("Col49"); set => SetVal("Col49", value); }

        private object? GetVal(string key) => Values.TryGetValue(key, out var v) ? v : null;
        private void SetVal(string key, object? value) => Values[key] = value;
    }

    public class ColumnDef
    {
        public string Field { get; set; } = "";
        public string HeaderText { get; set; } = "";
        public string Width { get; set; } = "150px";
        public TextAlign TextAlign { get; set; } = TextAlign.Left;
        public string Format { get; set; } = "";
        public ColumnType ColumnType { get; set; } = ColumnType.Text;
    }
}
