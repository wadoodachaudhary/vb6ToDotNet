                Database = "HomeFront",
                FindQry = $"select i.Phase,p.Description PhaseDesc, i.Item, POIndex, i.Description, OrderUOM from tblPhaseItem i join tblestphases p on (p.DivisionID = i.DivisionID and p.phase = i.phase) where i.DivisionID = {SessionState.DivisionID} order by i.Phase,i.item"
            },
            // 11: Items alphabetical
            new ViewDef
            {
                Name = "Items",
                KeyFlds = "left(itemdesc,1)|Phase+'/'+item",
                DisplayFlds = "left(itemdesc,1)|ItemDesc",
                FromWhere = $"FROM EstimatingItems WHERE DivisionID = {SessionState.DivisionID} and 1=1",
                Database = "HomeFront",
                FindQry = $"select i.Phase,p.Description PhaseDesc, i.Item, POIndex, i.Description, OrderUOM from tblPhaseItem i join tblestphases p on (p.DivisionID = i.DivisionID and p.phase = i.phase) where i.DivisionID = {SessionState.DivisionID} order by i.Phase,i.item"
            }
        };
    }

    // ── Load List (Tree) ──────────────────────────────────────
    private async Task LoadListAsync(bool clearTree)
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            if (clearTree)
            {
                ListNodes.Clear();
                node_index_counter = 0;
                // VB6 LoadList (frm:2086): switching views blanks the variables
                // grid + help. The RHS shows nothing until a leaf node is
                // double-clicked. gItems (bottom) is left as-is, as in VB6.
                ShowHFVariables = false;
                ShowTLVariables = false;
                HFVariablesData = new List<HFVariableRow>();
                TLVariablesData = new List<TLVariableRow>();
                HelpText = "";
            }

            if (mViewIndex >= Views.Count || string.IsNullOrEmpty(Views[mViewIndex].FromWhere))
            {
                IsLoading = false;
                StateHasChanged();
                return;
            }

            var view = Views[mViewIndex];
            var keyFields = view.KeyFlds?.Split('|') ?? Array.Empty<string>();
            var displayFields = view.DisplayFlds?.Split('|') ?? Array.Empty<string>();
            var sortFields = view.SortFlds?.Split('|') ?? Array.Empty<string>();

            if (keyFields.Length == 0) return;

            // Load first level
            var keyFld = keyFields[0];
            var displayFld = displayFields.Length > 0 ? displayFields[0] : keyFld;
            var sortFld = sortFields.Length > 0 && !string.IsNullOrEmpty(sortFields[0]) ? sortFields[0] : "2";

            var sql = $"SELECT DISTINCT {keyFld} AS KeyVal, {displayFld} AS DisplayVal, {sortFld} AS SortVal {view.FromWhere} ORDER BY {sortFld}";
            sql = sql.Replace("|", ",");

            var rows = await db.QueryAsync(sql);
            foreach (var row in rows)
            {
                // Parameterized — values containing single-quotes would otherwise
                // break the SQL on subsequent drill-down loads.
                var paramName = $"lvl0_{node_index_counter++}";
                var keyVal = row["KeyVal"] ?? DBNull.Value;
                var node = new ListTreeNode
                {
                    KeyValue = row["KeyVal"]?.ToString() ?? "",
                    DisplayText = (row["DisplayVal"]?.ToString() ?? "").Trim(),
                    KeyFieldName = keyFld,
                    Level = 0,
                    HasChildren = keyFields.Length > 1,
                    WhereClause = $" AND {keyFld} = @{paramName}",
                    WhereParams = new Dictionary<string, object> { [paramName] = keyVal },
                    ViewIndex = mViewIndex
                };
                ListNodes.Add(node);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"LoadListAsync error: ");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ── Render Tree Node ──────────────────────────────────────
    private RenderFragment RenderListNode(ListTreeNode node, int depth) => __builder =>
    {
        <div class="vb6-tree-item @(depth == 0 ? "root" : "") @(node.HasChildren ? "branch" : "leaf") @(node.Expanded ? "expanded" : "collapsed")"
             style="--tree-depth:@depth;">
            <div class="tree-node @(node.IsSelected ? "selected" : "") @(node.IsBold ? "bold" : "")"
                 @ondblclick="() => OnListNodeDblClick(node)"
                 @onclick="() => OnListNodeClick(node)">
                @if (node.HasChildren)
                {
                    <span class="tree-toggle has-children" @onclick="() => ToggleListNode(node)" @onclick:stopPropagation="true">
                        @(node.Expanded ? "-" : "+")
                    </span>
                    <span class="tree-folder-icon @(node.Expanded ? "open" : "closed")" aria-hidden="true"></span>
                }
                else
                {
                    <span class="tree-toggle leaf">&nbsp;</span>
                    <span class="tree-folder-spacer" aria-hidden="true"></span>
                }
                <span class="tree-label">@node.DisplayText</span>
            </div>
            @if (node.Expanded && node.Children != null)
            {
                <div class="tree-children">
                @foreach (var child in node.Children)
                {
                    @RenderListNode(child, depth + 1)
                }
                </div>
            }
        </div>
    };

    private async Task ToggleListNode(ListTreeNode node)
    {
        if (node.Expanded)
        {
            node.Expanded = false;
        }
        else
        {
            if (node.Children == null || node.Children.Count == 0)
            {
                await LoadChildNodes(node);
            }
            node.Expanded = true;
        }
        StateHasChanged();
    }

    private async Task LoadChildNodes(ListTreeNode parentNode)
    {
        try
        {
            var view = Views[parentNode.ViewIndex];
            var keyFields = view.KeyFlds?.Split('|') ?? Array.Empty<string>();
            var displayFields = view.DisplayFlds?.Split('|') ?? Array.Empty<string>();
            var sortFields = view.SortFlds?.Split('|') ?? Array.Empty<string>();

            var nextLevel = parentNode.Level + 1;
            if (nextLevel >= keyFields.Length) return;

            var keyFld = keyFields[nextLevel];
            var displayFld = displayFields.Length > nextLevel ? displayFields[nextLevel] : keyFld;
            var sortFld = sortFields.Length > nextLevel && !string.IsNullOrEmpty(sortFields[nextLevel]) ? sortFields[nextLevel] : "2";

            var sql = $"SELECT DISTINCT {keyFld} AS KeyVal, {displayFld} AS DisplayVal, {sortFld} AS SortVal {view.FromWhere} {parentNode.WhereClause}";

            // VB6 FTakeoff.frm:2135-2137 parity. The OpenJobAndQuoteAssemblies
            // view (used by Quotes + Open Jobs) carries multiple rowtypes —
            // 'Job', 'ChangeOrder', 'Assembly', etc. Without filtering to
            // rowtype='Assembly' at the assembly level (nextLevel == 2),
            // non-Assembly rows leak in with blank `assembly` /
            // `assemblydesc` values and render as empty tree nodes.
            // VB6 only applied this to mViewIndex 4/5 (Quotes/Open Jobs);
            // Custom Options uses a different view (UnApprovedCustomOptions)
            // so we leave it alone.
            if (nextLevel == 2
                && (string.Equals(view.Name, "Quotes", StringComparison.Ordinal)
                    || string.Equals(view.Name, "Open Jobs", StringComparison.Ordinal)))
            {
                sql += " AND rowtype='Assembly'";
            }

            // VB6 FTakeoff.frm:2140: ORDER BY SortFld + ",2" unless SortFld IS the display
            // column — sorting by assemblytype ALONE left same-type assemblies under
            // "Original contract" in arbitrary order (HHM-219); VB6 sub-sorts by display.
            sql += $" ORDER BY {sortFld}" + (sortFld == "2" ? "" : ",2");
            sql = sql.Replace("|", ",");

            var rows = await db.QueryAsync(sql, parentNode.WhereParams);
            parentNode.Children = new List<ListTreeNode>();
            foreach (var row in rows)
            {
                // Parameterized — see LoadListAsync for the rationale.
                var paramName = $"lvl{nextLevel}_{node_index_counter++}";
                var keyVal = row["KeyVal"] ?? DBNull.Value;
                var childParams = new Dictionary<string, object>(parentNode.WhereParams)
                {
                    [paramName] = keyVal
                };
                var child = new ListTreeNode
                {
                    KeyValue = row["KeyVal"]?.ToString() ?? "",
                    DisplayText = (row["DisplayVal"]?.ToString() ?? "").Trim(),
                    KeyFieldName = keyFld,
                    Level = nextLevel,
                    HasChildren = nextLevel + 1 < keyFields.Length,
                    WhereClause = parentNode.WhereClause + $" AND {keyFld} = @{paramName}",
                    WhereParams = childParams,
                    ViewIndex = parentNode.ViewIndex
                };
                parentNode.Children.Add(child);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"LoadChildNodes error: ");
        }
    }

    private void OnListNodeClick(ListTreeNode node)
    {
        ClearListSelection(ListNodes);
        node.IsSelected = true;
        StateHasChanged();
    }

    // VB6 gList keyboard (FTakeoff.frm:1200-1309): Up/Down walk the VISIBLE rows,
    // Enter expands/collapses a branch (or loads a leaf — same as double-click),
    // Left collapses / goes to the parent, Right expands / goes to the first
    // child (HHM-642).
    private void FlattenVisibleListNodes(List<ListTreeNode> nodes, List<ListTreeNode> into)
    {
        foreach (var n in nodes)
        {
            into.Add(n);
            if (n.Expanded && n.Children != null)
                FlattenVisibleListNodes(n.Children, into);
        }
    }

    private ListTreeNode? FindListParent(List<ListTreeNode> nodes, ListTreeNode child)
    {
        foreach (var n in nodes)
        {
            if (n.Children != null)
            {
                if (n.Children.Contains(child)) return n;
                var deeper = FindListParent(n.Children, child);
                if (deeper != null) return deeper;
            }
        }
        return null;
    }

    // HHM-642: give the list tree keyboard focus as soon as it has nodes, so
    // arrow keys and Enter work right when the window opens (VB6 gList gets
    // focus on Form_Load) — without this the user had to click the tree first.
    private ElementReference _listTreeRef;
    private bool _listTreeFocusDone;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_listTreeFocusDone && ListNodes.Count > 0)
        {
            _listTreeFocusDone = true;
            try { await _listTreeRef.FocusAsync(); } catch { /* pane not attached yet */ }
        }
    }

    private async Task OnListTreeKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        var visible = new List<ListTreeNode>();
        FlattenVisibleListNodes(ListNodes, visible);
        if (visible.Count == 0) return;

        var current = visible.FirstOrDefault(n => n.IsSelected) ?? visible[0];
        var idx = visible.IndexOf(current);

        switch (e.Key)
        {
            case "ArrowDown":
                if (idx < visible.Count - 1)
                {
                    ClearListSelection(ListNodes);
                    visible[idx + 1].IsSelected = true;
                    StateHasChanged();
                }
                break;
            case "ArrowUp":
                if (idx > 0)
                {
                    ClearListSelection(ListNodes);
                    visible[idx - 1].IsSelected = true;
                    StateHasChanged();
                }
                break;
            case "Enter":
                await OnListNodeDblClick(current);
                break;
            case "ArrowLeft":
                if (current.HasChildren && current.Expanded)
                {
                    current.Expanded = false;
                    StateHasChanged();
                }
                else
                {
                    var parent = FindListParent(ListNodes, current);
                    if (parent != null)
                    {
                        ClearListSelection(ListNodes);
                        parent.IsSelected = true;
                        StateHasChanged();
                    }
                }
                break;
            case "ArrowRight":
                if (current.HasChildren && !current.Expanded)
                {
                    await ToggleListNode(current);
                }
                else if (current.Expanded && current.Children is { Count: > 0 })
                {
                    ClearListSelection(ListNodes);
                    current.Children[0].IsSelected = true;
                    StateHasChanged();
                }
                break;
        }
    }

    private async Task OnListNodeDblClick(ListTreeNode node)
    {
        var view = Views[node.ViewIndex];
        var keyFields = view.KeyFlds?.Split('|') ?? Array.Empty<string>();
        var levels = keyFields.Length;

        // Branch nodes toggle; leaf nodes always load/add on a simple double-click.
        // Open Jobs keeps the VB6 exception that group nodes can load too.
        if (node.HasChildren && node.Level + 1 < levels && node.ViewIndex != 5)
        {
            await ToggleListNode(node);
            return;
        }

        // HHM-220: bold only in the load branch — VB6 clears/sets
        // flexcpFontBold inside the Else (load) arm of gList_KeyDown
        // (frm:1270-1272), never when merely expanding/collapsing.
        ClearListBold(ListNodes);
        node.IsBold = true;

        // At lowest level - load assembly/item
        SaleQty = 0;
        await LoadAssemblyOrItem(node);
    }

    private void ClearListSelection(List<ListTreeNode> nodes)
    {
        foreach (var n in nodes)
        {
            n.IsSelected = false;
            if (n.Children != null) ClearListSelection(n.Children);
        }
    }

    private void ClearListBold(List<ListTreeNode> nodes)
    {
        foreach (var n in nodes)
        {
            n.IsBold = false;
            if (n.Children != null) ClearListBold(n.Children);
        }
    }

    // ── Load Assembly or Item ─────────────────────────────────
    private async Task LoadAssemblyOrItem(ListTreeNode node)
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            // Determine if this is an HF assembly or item based on view index
            if (mViewIndex >= 0 && mViewIndex <= 3)
            {
                // HF Assembly
                await LoadModelOrOption(node);
            }
            else if (mViewIndex >= 4 && mViewIndex <= 5)
            {
                // Quote/Job
                await LoadQuote(node);
            }
            else if (mViewIndex >= 8 && mViewIndex <= 11)
            {
                // Item
                var parts = node.KeyValue.Split('/');
                if (parts.Length == 2)
                    await AddItem(parts[0], parts[1]);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"LoadAssemblyOrItem error: ");
            Notifications.Error($"Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ── Load Model/Option Assembly ────────────────────────────
    private async Task LoadModelOrOption(ListTreeNode node)
    {
        ShowTLVariables = false;
        ShowHFVariables = true;
        HFVariablesData = new List<HFVariableRow>();
        HelpText = "";
        AddPassEnabled = true;
        OkVisible = true;

        // Use the node's WhereClause as-is — the views feeding this code path
        // (mViewIndex 0..3) already produce keys prefixed with "m." that matches
        // `tbldbassemblymaster m` below. The legacy Replace(" AND ", " AND m.")
        // turned every constraint into "m.m.community = ..." → SQL Server
        // "Invalid column name 'm'." (parser reads m.m.x as alias m → column m
        // → .x), which is the bug the user filed against this page.
        var whereClause = node.WhereClause ?? "";
        var sql = $@"
            SELECT m.assembly, m.description AS assemblydescription, m.assemblytype, m.model, m.optionid,
                   i.phase, i.item, d.itemchart, i.description, d.formula, d.TakeoffQty,
                   i.takeoffuom, i.conversionfactor, i.orderuom,
                   isnull(nullif(i.JCCostCode,''),isnull(p.JCCostCode,'')) jccostcode,
                   i.jccategory, i.altjccostcode, i.altjccategory, i.price,
                   i.roundto, i.rounddir, isnull(nullif(d.POIndex,''),isnull(i.POIndex,'')) poindex,
                   i.wastepercent,
                   isnull(nullif(d.notes,''),i.notes) Notes,
                   isnull(nullif(d.location,''),i.location) Location
            FROM tbldbassemblymaster m
            LEFT OUTER JOIN tbldbassemblydetails d ON(m.DivisionID = d.DivisionID AND m.community=d.community AND m.model=d.model AND m.optionid=d.optionid AND m.assembly=d.assembly)
            LEFT OUTER JOIN tblphaseitem i ON(i.DivisionID = d.DivisionID AND i.phase=d.phase AND i.item=d.item)
            LEFT OUTER JOIN tblPOIndex p ON(p.DivisionID = d.DivisionID AND isnull(nullif(d.POIndex,''),isnull(i.POIndex,''))=p.POIndex)
            WHERE m.DivisionID = @DivisionID {whereClause}";

        var sqlParams = new Dictionary<string, object>(node.WhereParams)
        {
            ["DivisionID"] = SessionState.DivisionID
        };
        // Diagnostic: log the full SQL + parameters so the next failure shows
        // exactly what went to SQL Server (the previous error report only had
        // the first ~600 chars truncated mid-JOIN).
        Logger.LogInformation("FTakeoff.LoadModelOrOption SQL: {Sql} | params: {Params}",
            sql, string.Join(", ", sqlParams.Select(kv => $"@{kv.Key}={kv.Value}")));
        var rows = await db.QueryAsync(sql, sqlParams);
        ItemsData = new List<TakeoffItemRow>();

        foreach (var row in rows)
        {
            if (string.IsNullOrEmpty(mAssembly))
            {
                mAssemblyType = Convert.ToInt32(row["assemblytype"] ?? 0);
                mAssembly = row["assembly"]?.ToString() ?? "";
                mAssemblyDescription = row["assemblydescription"]?.ToString() ?? "";
                mModel = row["model"]?.ToString() ?? "";
                mOptionID = row["optionid"]?.ToString() ?? "";
            }

            var item = new TakeoffItemRow
            {
                Assembly = row["assembly"]?.ToString() ?? "",
                AssemblyDescription = row["assemblydescription"]?.ToString() ?? "",
                Model = row["model"]?.ToString() ?? "",
                Phase = row["phase"]?.ToString() ?? "",
                Item = row["item"]?.ToString() ?? "",
                Description = row["description"]?.ToString() ?? "",
                Job = mJob,
                WastePercent = ToDouble(row["wastepercent"]),
                RawFormula = row["formula"]?.ToString() ?? "",
                TakeoffUOM = row["takeoffuom"]?.ToString() ?? "",
                TakeoffQty = 0,
                OrderQty = 0,
                OrderUOM = row["orderuom"]?.ToString() ?? "",
                ConversionFactor = ToDouble(row["conversionfactor"]),
                JCCostCode = row["jccostcode"]?.ToString() ?? "",
                JCCategory = row["jccategory"]?.ToString() ?? "",
                Price = ToDouble(row["price"]),
                RoundTo = ToDouble(row["roundto"]),
                RoundDir = ToDouble(row["rounddir"]),
                POIndex = row["poindex"]?.ToString() ?? "",
                Notes = row["Notes"]?.ToString() ?? "",
                Location = row["Location"]?.ToString() ?? "",
                P1 = 0, P2 = 0, P3 = 0, P4 = 0, P5 = 0
            };

            // VB6 ResolveFormula expands {formulaName} tokens against the
            // Formulas table. An empty formula defaults to the row's stored
            // TakeoffQty (so an item with no formula still adds its base qty).
            item.ResolvedFormula = await ResolveFormulaAsync(item.RawFormula);
            if (string.IsNullOrEmpty(item.ResolvedFormula))
                item.ResolvedFormula = (row["TakeoffQty"] ?? "0").ToString() ?? "0";

            ItemsData.Add(item);
        }

        // VB6 AddModelOrOption seeds variablelist with "Quantity" then loads it
        // from the variables table (MFormulas.LoadVariables).
        HFVariablesData = new List<HFVariableRow> { await BuildQuantityVariableAsync() };
    }

    // ── Load Quote ────────────────────────────────────────────
    private async Task LoadQuote(ListTreeNode node)
    {
        ShowTLVariables = false;
        ShowHFVariables = true;
        HFVariablesData = new List<HFVariableRow>();
        HelpText = "";
        AddPassEnabled = true;
        OkVisible = true;

        // The tree was built against OpenJobAndQuoteAssemblies (KeyFlds =
        // "job|changeorder|assembly") so node.WhereClause looks like:
        //     AND job = @lvl0_X AND changeorder = @lvl1_Y AND assembly = @lvl2_Z
        // estimateditems uses these columns (VB6 FTakeoff.frm:2548-2561):
        //   • Level 1 → job_no
        //   • Level 2 → changeorder
        //   • Level 3 → estassemblyid (the NUMERIC EstAssemblyID, which is
        //              what OpenJobAndQuoteAssemblies returns in its
        //              `Assembly` column — see VB6 line 2515 `EstAssemblyID
        //              As Long` and findQry `select Assembly ID,…`)
        // VB6 also did `Replace("AND changeorder =", "AND changeorderno =")`
        // at line 2561, but that was for an older DB schema — the modern
        // estimateditems table uses `changeorder` (no `no` suffix), and
        // applying the rename throws "Invalid column name 'changeorderno'".
        // We DROP that rename. Level 3 needs the `assembly → estassemblyid`
        // rewrite though, since the column carrying the assembly's primary
        // key is `estassemblyid`, not `assembly` (which is a string-typed
        // assembly-code column).
        var whereClause = (node.WhereClause ?? "")
            .Replace(" AND job = ", " AND job_no = ", StringComparison.OrdinalIgnoreCase)
            .Replace(" AND assembly = ", " AND estassemblyid = ", StringComparison.OrdinalIgnoreCase);

        var sql = $@"
            SELECT * FROM estimateditems
            WHERE (isnull(BudgetDeleted,0)=0 or isnull(PODeleted,0)=0)
            {whereClause}";

        Logger.LogInformation("FTakeoff.LoadQuote SQL: {Sql} | params: {Params}",
            sql, string.Join(", ", node.WhereParams.Select(kv => $"@{kv.Key}={kv.Value}")));
        var rows = await db.QueryAsync(sql, node.WhereParams);
        ItemsData = new List<TakeoffItemRow>();

        foreach (var row in rows)
        {
            if (string.IsNullOrEmpty(mAssembly))
            {
                mAssemblyType = Convert.ToInt32(row["AssemblyType"] ?? 0);
                mAssembly = row["Assembly"]?.ToString() ?? "";
                mAssemblyDescription = row["AssemblyDescription"]?.ToString() ?? "";
                mModel = row["Model"]?.ToString() ?? "";
                mOptionID = row["OptionID"]?.ToString() ?? "";
            }

            var item = new TakeoffItemRow
            {
                Assembly = row["Assembly"]?.ToString() ?? "",
                AssemblyDescription = row["AssemblyDescription"]?.ToString() ?? "",
                Model = row["Model"]?.ToString() ?? "",
                Phase = row["EstPhase"]?.ToString() ?? "",
                Item = row["EstItem"]?.ToString() ?? "",
                Description = row["ItemDesc"]?.ToString() ?? "",
                RawFormula = row["formula"]?.ToString() ?? "",
                TakeoffUOM = row["TakeoffUOM"]?.ToString() ?? "",
                TakeoffQty = ToDouble(row["TakeoffQty"]),
                OrderQty = ToDouble(row["POQty"]),
                OrderUOM = row["OrderUOM"]?.ToString() ?? "",
                ConversionFactor = ToDouble(row["ConversionFactor"]),
                JCCostCode = row["JCCostCode"]?.ToString() ?? "",
                JCCategory = row["JCCategory"]?.ToString() ?? "",
                Price = ToDouble(row["PORate"]),
                RoundTo = ToDouble(row["RoundTo"]),
                RoundDir = ToDouble(row["RoundDir"]),
                POIndex = row["POIndex"]?.ToString() ?? "",
                Location = row["Location"]?.ToString() ?? "",
                // VB6 FTakeoff.frm:2622/2624 (the Quotes/Open Jobs mapping): the grid's
                // Comments/Notes column reads ItemComments — it was unmapped here, so
                // rows showed blank/mismatched comments (HHM-217).
                Notes = row["ItemComments"]?.ToString() ?? "",
                P1 = 0, P2 = 0, P3 = 0, P4 = 0, P5 = 0
            };
            // VB6 2653: WBS01..WBS40 come across from estimateditems too.
            for (int w = 1; w <= 40; w++)
                item.WBS[w] = row[$"WBS{w:D2}"]?.ToString() ?? "";

            item.ResolvedFormula = await ResolveFormulaAsync(item.RawFormula);
            if (string.IsNullOrEmpty(item.ResolvedFormula))
                item.ResolvedFormula = item.TakeoffQty.ToString(System.Globalization.CultureInfo.InvariantCulture);

            ItemsData.Add(item);
        }
    }

    // ── Add Item ──────────────────────────────────────────────
    private async Task AddItem(string phase, string item)
    {
        ShowTLVariables = false;
        ShowHFVariables = true;
        HelpText = "";
        AddPassEnabled = true;
        OkVisible = true;

        var sql = $@"
            SELECT * FROM EstimatingItems
            WHERE DivisionID = {SessionState.DivisionID}
              AND phase = @Phase AND item = @Item";

        var rows = await db.QueryAsync(sql, new { Phase = phase, Item = item });
        if (!rows.Any()) return;

        var row = rows.First();
        var newItem = new TakeoffItemRow
        {
            Model = mModel,
            Assembly = mAssembly,
            AssemblyDescription = mAssemblyDescription,
            Phase = row["Phase"]?.ToString() ?? "",
            Item = row["Item"]?.ToString() ?? "",
            Description = row["ItemDesc"]?.ToString() ?? "",
            RawFormula = row["Formula"]?.ToString() ?? "",
            TakeoffUOM = row["TakeoffUOM"]?.ToString() ?? "",
            TakeoffQty = 0,
            OrderQty = 0,
            OrderUOM = row["OrderUOM"]?.ToString() ?? "",
            ConversionFactor = ToDouble(row["ConversionFactor"]),
            JCCostCode = row["JCCostCode"]?.ToString() ?? "",
            JCCategory = row["JCCategory"]?.ToString() ?? "",
            Price = ToDouble(row["Price"]),
            WastePercent = (row["WastePercent"] == null || row["WastePercent"] == DBNull.Value)
                ? (double?)null : ToDouble(row["WastePercent"]),
            RoundTo = ToDouble(row["RoundTo"]),
            RoundDir = ToDouble(row["RoundDir"]),
            POIndex = row["POIndex"]?.ToString() ?? "",
            Notes = row["Notes"]?.ToString() ?? "",
            Location = row["Location"]?.ToString() ?? "",
            P1 = 0, P2 = 0, P3 = 0, P4 = 0, P5 = 0
        };

        newItem.ResolvedFormula = await ResolveFormulaAsync(newItem.RawFormula);
        if (string.IsNullOrEmpty(newItem.ResolvedFormula))
            newItem.ResolvedFormula = "1";

        ItemsData.Add(newItem);

        // Ensure Quantity variable exists (from the variables table — VB6 parity)
        if (!HFVariablesData.Any(v => v.Name == "Quantity"))
            HFVariablesData = new List<HFVariableRow> { await BuildQuantityVariableAsync() };
    }

    // ── Add Pass ──────────────────────────────────────────────
    private async Task OnAddPass()
    {
        if (!ShowHFVariables || HFVariablesData.Count == 0) return;

        try
        {
            // VB6 cmdAddPass_Click (FTakeoff.frm:711-795) uses the FIRST
            // variable row's value as the pass multiplier `qty`
            // (gHFVariables.TextMatrix(0, "Value")). For the legacy
            // single-Quantity view that's the Quantity field; for a
            // multi-variable item it's the first variable. We mirror that:
            // take row 0's value, falling back to the named Quantity row.
            var qtyVar = HFVariablesData.Count > 0
                ? HFVariablesData[0]
                : HFVariablesData.FirstOrDefault(v => v.Name == "Quantity");
            double qty = qtyVar != null ? ToDouble(qtyVar.Value) : 1;

            // VB6 evaluates in two passes (FTakeoff.frm:738-786):
            //   Pass 1 — "normal" rows whose resolved formula has NO lookup
            //            functions: PassTakeoffQty = qty × CalcFormula(formula).
            //   Pass 2 — rows whose formula DOES use TotalTakeoffQty / etc.:
            //            PassTakeoffQty = CalcFormula(formula) (NO qty factor —
            //            the lookup already aggregates the per-pass totals
            //            accumulated in pass 1). FormulaHasLookups draws the line.
            // Doing pass 1 first means GetItemTotal sees this pass's
            // PassTakeoffQty values when pass 2 evaluates the lookups.
            string? firstError = null;

            // Pass 1 — non-lookup rows.
            foreach (var item in ItemsData)
            {
                var f = item.ResolvedFormula ?? "";
                if (FormulaHasLookups(f)) continue;

                ShiftPassHistory(item);
                try
                {
                    item.PassTakeoffQty = qty * CalcFormula(f, quiet: true);
                    item.TakeoffQty += item.PassTakeoffQty;
                    RecalculateOrderQty(item);
                }
                catch (Exception ex)
                {
                    // VB6: On Error Resume Next around the eval, then a single
                    // MsgBox naming the offending row + raw formula.
                    firstError ??= $"Row '{item.Description}' formula error: {item.RawFormula} ({ex.Message})";
                }
            }

            // Pass 2 — lookup rows (resolve after pass-1 totals are in place).
            foreach (var item in ItemsData)
            {
                var f = item.ResolvedFormula ?? "";
                if (!FormulaHasLookups(f)) continue;

                ShiftPassHistory(item);
                try
                {
                    item.PassTakeoffQty = CalcFormula(f, quiet: true);
                    item.TakeoffQty += item.PassTakeoffQty;
                    RecalculateOrderQty(item);
                }
                catch (Exception ex)
                {
                    firstError ??= $"Row '{item.Description}' formula error: {item.RawFormula} ({ex.Message})";
                }
            }

            // VB6 accumulates the running sale qty in txtQty.
            SaleQty += qty;

            if (ItemsGrid != null)
                await ItemsGrid.Refresh();

            StateHasChanged();

            if (firstError != null)
                Notifications.Warning(firstError);
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error adding pass: {ex.Message}");
        }
    }

    /// <summary>VB6 cmdAddPass_Click pass-history shift (FTakeoff.frm:743-747
    /// and 769-773): push the current TakeoffQty down the p1..p5 stack so
    /// Undo Pass can pop it back. Done once per row per pass.</summary>
    private static void ShiftPassHistory(TakeoffItemRow item)
    {
        item.P5 = item.P4;
        item.P4 = item.P3;
        item.P3 = item.P2;
        item.P2 = item.P1;
        item.P1 = item.TakeoffQty;
    }

    // ── Single-Quantity Textbox helpers (VB6 parity) ─────────────────
    //
    // The legacy "Items by Groups & Phases" view shows Quantity as a plain
    // label + textbox (top-right of the FTakeoff form) — NOT a grid. The
    // grid only appears when an item has 2+ variables. These helpers
    // detect that single-Quantity case and bridge the simple textbox UI
    // to the underlying HFVariablesData list.
    private bool IsHFQuantityOnly =>
        HFVariablesData.Count == 1
        && string.Equals(HFVariablesData[0].Name, "Quantity", StringComparison.OrdinalIgnoreCase);

    private string HFQuantityValue =>
        HFVariablesData.Count > 0 ? (HFVariablesData[0].Value ?? "") : "";

    private string HFQuantityUOM =>
        HFVariablesData.Count > 0 ? (HFVariablesData[0].UOM ?? "") : "";

    /// <summary>
    /// Passive Quantity-textbox setter. Mirrors VB6 cmdAddPass_Click
    /// semantics: the Quantity field is JUST a multiplier value — it
    /// has no side effect on the items grid until the user clicks the
    /// "+" (Add Pass) button, which is the ONLY place that runs
    /// <c>qty × CalcFormula → PassTakeoffQty</c> and accumulates into
    /// <c>TakeoffQty</c> (FTakeoff.frm lines 723-751).
    ///
    /// Earlier revisions live-propagated the typed value into every
    /// item row on blur to match a "type-and-it-just-works" mental
    /// model, but that overrode the legacy multi-pass behavior — the
    /// user wants strict VB6 parity (Quantity = inert, + = action).
    /// We also reformat the input as <c>0.000</c> (three decimal
    /// places, e.g. "20.000") to match legacy txtQuantity display.
    ///
    /// HHM-232: the field is a NumericTextBoxControl, so non-numeric
    /// characters never reach here (unparseable/empty input becomes 0,
    /// VB6 Val() parity). Range validation mirrors VB6
    /// gHFVariables_ValidateEdit (FTakeoff.frm:2976-2990): a value above
    /// the Quantity variable's Max (variables table; 1e18 fallback when
    /// the row is absent — MFormulas.LoadVariables:123-125) or below its
    /// Min REJECTS the edit — the previous value is kept and the legacy
    /// "too large" / "too small" MsgBox shows (vbInformation,
    /// App.ProductName → "Precision Builder"). No silent clamping.
    /// </summary>
    private async Task OnHFQuantityChanged(double newValue)
    {
        if (!IsHFQuantityOnly) return;
        var row = HFVariablesData[0];

        // VB6: If Val(.EditText) > .ValueMatrix(Row, 5) And .ValueMatrix(Row, 5) > 0
        if (newValue > row.Max && row.Max > 0)
        {
            _qtyInputEpoch++;   // remount the input → shows the kept value again
            StateHasChanged();
            if (_messageBox != null)
                await _messageBox.ShowAsync(
                    $"The maximum value for {row.Name} is '{row.Max:0}'. The number you have entered is too large.",
                    title: "Precision Builder", buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.Ok, icon: "info");
            return;
        }

        // VB6: If Val(.EditText) < .ValueMatrix(Row, 4)
        if (newValue < row.Min)
        {
            _qtyInputEpoch++;
            StateHasChanged();
            if (_messageBox != null)
                await _messageBox.ShowAsync(
                    $"The minimum value for {row.Name} is '{row.Min:0}'. The number you have entered is too small.",
                    title: "Precision Builder", buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.Ok, icon: "info");
            return;
        }

        row.Value =
            newValue.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture);
        StateHasChanged();
    }

    // Bumped whenever an out-of-range Quantity edit is rejected. The bound
    // Value doesn't change on a reject, so without a remount Blazor's diff
    // would leave the user's raw typed text in the DOM input; keying the
    // NumericTextBoxControl on this counter recreates it with the kept value.
    private int _qtyInputEpoch;

    // The committed Quantity text re-parsed for the numeric input's Value.
    private double HFQuantityNumericValue =>
        double.TryParse(HFQuantityValue, System.Globalization.NumberStyles.Any,
                        System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0d;

    // ── Undo Pass ─────────────────────────────────────────────
    private async Task OnUndoPass()
    {
        foreach (var item in ItemsData)
        {
            item.TakeoffQty = item.P1;
            item.P1 = item.P2;
            item.P2 = item.P3;
            item.P3 = item.P4;
            item.P4 = item.P5;
            item.P5 = 0;

            RecalculateOrderQty(item);
        }

        if (ItemsGrid != null)
            await ItemsGrid.Refresh();

        StateHasChanged();
    }

    // ── Inline-Edit Handler (VB6 gItems_AfterEdit parity) ───────────
    //
    // GridControl raises OnCellSave AFTER it has written the typed value
    // back to the row property via reflection — so args.Data already
    // carries the new value when we arrive. We mirror VB6's
    // gItems_AfterEdit Select Case on .ColKey(Col):
    //   • TakeoffQty edited  → recalc OrderQty (waste % + conversion + round)
    //   • OrderQty edited    → back-solve TakeoffQty so the two stay
    //                          consistent (VB6 line 2722-2727)
    //   • ConversionFactor   → recalc OrderQty from the current TakeoffQty
    // Without this handler the typed value lives only in the grid cell
    // and never makes it into ItemsData — SaveData then reports
    // "order quantity of zero" even though the user filled the cell.
    private async Task OnItemsCellSave(CellSaveArgs<TakeoffItemRow> args)
    {
        if (args?.Data == null) return;
        var item = args.Data;
        var field = args.ColumnName;

        switch (field)
        {
            case nameof(TakeoffItemRow.TakeoffQty):
            case nameof(TakeoffItemRow.ConversionFactor):
                // Recalc OrderQty from the (possibly new) TakeoffQty.
                RecalculateOrderQty(item);
                break;

            case nameof(TakeoffItemRow.OrderQty):
                // VB6 reverse path: derive TakeoffQty from edited OrderQty
                // so the row's pair stays in lock-step. ConversionFactor
                // and WastePercent are unchanged from the row record.
                double conversion = item.ConversionFactor;
                if (conversion == 0) conversion = 1;
                double wasteFactor = (100 + (item.WastePercent ?? 0)) / 100.0;
                if (wasteFactor == 0) wasteFactor = 1;
                item.TakeoffQty = Math.Round(item.OrderQty / wasteFactor / conversion, 5);
                break;
        }

        if (ItemsGrid != null)
            await ItemsGrid.Refresh();
        StateHasChanged();
    }

    // ── Multi-select Fan-out (FAssembly parity) ─────────────────────
    //
    // GridControl fires this once per type-ahead Enter when one or
    // more rows are selected. We apply the typed value to every
    // selected row's target field, then run the same
    // gItems_AfterEdit recalc as the single-cell save path so the
    // pair stays consistent (TakeoffQty edit → OrderQty recalc,
    // OrderQty edit → TakeoffQty back-solve).
    //
    // Restricted to the numeric Qty columns by design: ConversionFactor /
    // Price / WastePercent live on the source EstimatingItems record
    // and shouldn't be hand-edited mid-takeoff. Adding more fan-out
    // targets is a one-line case-statement extension below.
    private async Task OnItemsTypeAheadCommit(TypeAheadCommitArgs<TakeoffItemRow> args)
    {
        var field = !string.IsNullOrEmpty(args.ColumnName)
            ? args.ColumnName
            : ItemsTypeAheadTargetField;

        if (field != nameof(TakeoffItemRow.TakeoffQty)
            && field != nameof(TakeoffItemRow.OrderQty))
            return;

        var qty = ParseDouble(args.Value);
        var applied = 0;
        foreach (var item in args.SelectedItems)
        {
            switch (field)
            {
                case nameof(TakeoffItemRow.TakeoffQty):
                    item.TakeoffQty = qty;
                    RecalculateOrderQty(item);
                    break;

                case nameof(TakeoffItemRow.OrderQty):
                    item.OrderQty = qty;
                    double conversion = item.ConversionFactor;
                    if (conversion == 0) conversion = 1;
                    double wasteFactor = (100 + (item.WastePercent ?? 0)) / 100.0;
                    if (wasteFactor == 0) wasteFactor = 1;
                    item.TakeoffQty = Math.Round(item.OrderQty / wasteFactor / conversion, 5);
                    break;
            }
            applied++;
        }
        if (applied == 0) return;

        if (ItemsGrid != null)
            await ItemsGrid.Refresh();
        StateHasChanged();
    }

    // ── Recalculate Order Qty ─────────────────────────────────
    private void RecalculateOrderQty(TakeoffItemRow item)
    {
        double conversion = item.ConversionFactor;
        if (conversion == 0) conversion = 1;
        double waste = item.WastePercent ?? 0;
        double orderQty = item.TakeoffQty * (100 + waste) / 100 * conversion;

        // Apply rounding
        if (item.RoundTo > 0)
        {
            if (item.RoundDir > 0)
                orderQty = Math.Ceiling(orderQty / item.RoundTo) * item.RoundTo;
            else if (item.RoundDir < 0)
                orderQty = Math.Floor(orderQty / item.RoundTo) * item.RoundTo;
            else
                orderQty = Math.Round(orderQty / item.RoundTo) * item.RoundTo;
        }

        item.OrderQty = orderQty;
    }

    // ── Save Data ─────────────────────────────────────────────
    /// <summary>VB6 parity: FTakeoff.frm SaveData (lines 1333-1612). VB6
    /// walked the takeoff grid, dropped zero-qty rows per the
    /// ZeroQtyTakeoffs option (or per-prompt fallback), then called
    /// <c>mParentForm.AddItem(...)</c> for every kept row — the caller form
    /// staged them in memory and its own Save flow persisted them later.
    ///
    /// We do the same: build the kept list, raise <see cref="OnItemsCommitted"/>
    /// with it (the host translates TakeoffItemRow → its own model with
    /// RowStatus="new"), then return true so OnOkClick fires OnClose.
    ///
    /// VB6 also looked up vendor / price / tax-group when the caller wasn't
    /// FAssembly — that branch is intentionally NOT ported here because the
    /// FAssembly-caller code path explicitly skipped it (FTakeoff.frm:1508:
    /// `If mParentForm.Name <> "FAssembly" Then …`). FAssembly's
    /// RefreshVendorPrice on next LoadDataAsync handles the rate lookup from
    /// scratch using Purch_GetItemRate / Purch_GetItemRateQuality.</summary>
    private async Task<bool> SaveData()
    {
        try
        {
            // Zero-qty handling — VB6 lines 1389-1415. Prompt-only branch
            // (ztPrompt); the ztAccept/ztIgnore paths from HFApp.Options
            // would require a user-pref lookup we don't have here yet.
            //
            // Uses MessageBoxControl (in-app dialog) instead of the browser
            // confirm() so the chrome matches the rest of the app. Falls
            // back to JS confirm only if the control reference isn't wired
            // (defensive — shouldn't happen in normal flow).
            var keep = ItemsData;
            if (keep.Any(i => i.OrderQty == 0))
            {
                var prompt = _messageBox != null
                    ? await _messageBox.ShowAsync(
                        "You have items with an order quantity of zero.\n\nDo you want to add these items anyway?",
                        title: "Zero Order Qty",
                        buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNo)
                    : (await Dialogs.ConfirmAsync(
                            "You have items with an order quantity of zero.\nDo you want to add these items anyway?")
                        ? Fx.ControlKit.Dialogs.MessageBoxResult.Yes
                        : Fx.ControlKit.Dialogs.MessageBoxResult.No);

                if (prompt != Fx.ControlKit.Dialogs.MessageBoxResult.Yes)
                {
                    keep = keep.Where(i => i.OrderQty != 0).ToList();
                    ItemsData = keep; // mirror filtered view back to the grid
                }
            }

            if (keep.Count == 0)
            {
                Notifications.Info("Nothing to save — no items have a non-zero Order Qty.");
                return false;
            }

            // VB6 SaveData frm:1418-1420: committing from the Open Jobs / Quotes
            // views ALWAYS asks "Do you want to lookup new pricing on this quote?"
            // (Refresh Costs, default No = keep the quote's pricing) before any
            // write. The gate was missing, so OK saved silently (HHM-231). In the
            // FAssembly-host branch VB6 hands items across without pricing either
            // way (frm:1508) — the answer is recorded for the estimate-target port.
            if (mViewIndex == 4 || mViewIndex == 5)
            {
                var refresh = _messageBox != null
                    ? await _messageBox.ShowAsync(
                        "Do you want to lookup new pricing on this quote?",
                        title: "Refresh Costs",
                        buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNo)
                    : Fx.ControlKit.Dialogs.MessageBoxResult.No;
                mUseQuotePricing = refresh == Fx.ControlKit.Dialogs.MessageBoxResult.No;
            }

            // Emit the kept rows to whoever's listening (FAssembly today;
            // FQuote / FEstimateItems in future ports). The host owns the
            // translation to its own row model and the persistence step.
            if (OnItemsCommitted.HasDelegate)
                await OnItemsCommitted.InvokeAsync(keep.ToList());

            Notifications.Success($"Added {keep.Count} item{(keep.Count == 1 ? "" : "s")} to the assembly.");
            return true;
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error saving: {ex.Message}");
            return false;
        }
    }

    // ── Button Handlers ───────────────────────────────────────
    // VB6 parity (FTakeoff.frm cmdOK_Click / cmdCancel_Click / cmdClose_Click):
    // OK commits the kept rows to the host form (via OnItemsCommitted) and
    // clears the lower grid — the modal stays open so the user can rack up
    // another pass. Cancel discards the staged rows without committing —
    // again, the modal stays open. ONLY Close dismisses the modal.
    private async Task OnOkClick()
    {
        // VB6 cmdOK_Click parity: OK commits whatever is currently
        // staged in ItemsData — it does NOT auto-apply the Quantity
        // field. The user must click "+" (Add Pass) to multiply qty
        // × formula into the TakeoffQty before OK. Items with
        // TakeoffQty=0 fall under SaveData's existing zero-qty
        // prompt path.
        //
        // An earlier revision force-propagated Quantity here as a
        // convenience — removed per user request 2026-05-26 because
        // it diverged from VB6 (which made + the sole trigger).
        if (await SaveData())
        {
            // SaveData already raised OnItemsCommitted — FAssembly has the
            // rows. Reset the lower grid so the user sees an empty staging
            // area, OK/Cancel hide, and Close re-appears. The modal itself
            // stays open per VB6 cmdOK_Click (it only flipped button
            // visibility; closing was reserved for cmdClose_Click).
            //
            // Standalone /takeoff URL has no host form to keep open behind
            // it, so honor returnUrl when present — that's the only path
            // that should leave FTakeoff after OK.
            if (!IsModal && !string.IsNullOrWhiteSpace(returnUrl))
            {
                NavigationManager.NavigateTo(returnUrl);
                return;
            }
            ResetToListMode();
        }
    }

    private void OnCancelClick()
    {
        // VB6 cmdCancel_Click — abandon staged rows, return to empty list
        // state. Modal stays open; user can start a new selection.
        ResetToListMode();
    }

    private async Task OnCloseClick()
    {
        // VB6 cmdClose_Click + the × in the modal header — dismiss the
        // dialog entirely. Modal mode hands control back to the host via
        // OnClose; standalone mode falls back to returnUrl / route.
        if (IsModal && OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
            return;
        }
        if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            NavigationManager.NavigateTo(returnUrl);
            return;
        }
        NavigationManager.NavigateTo("/edit-model-assembly");
    }

    private void ResetToListMode()
    {
        ItemsData = new List<TakeoffItemRow>();
        HFVariablesData = new List<HFVariableRow>();
        TLVariablesData = new List<TLVariableRow>();
        HelpText = "";
        SaleQty = 0;
        OkVisible = false;
        AddPassEnabled = false;
        StateHasChanged();
    }

    private async Task OnBrowseProject()
    {
        // Info, not Error — this is a known stub, not a failure.
        Notifications.Info("Browse OnCenter Project - not implemented");
    }

    // ── Public Methods (for external callers) ─────────────────
    public async Task Takeoff(
        bool isChangeOrder,
        string takeoffMode,
        long onScreenBidID,
        string onScreenProjectName,
        int assemblyType,
        string assemblyDescription,
        string community,
        string communityPhase,
        string model,
        string optionID,
        string assembly,
        string job,
        string vendor = "")
    {
        mTakeoffMode = takeoffMode;
        mAssemblyType = assemblyType;
        mAssemblyDescription = assemblyDescription;
        mCommunity = community;
        mCommunityPhase = communityPhase;
        mAssembly = assembly;
        mModel = model;
        mVendor = vendor;
        mOptionID = optionID;
        mOnScreenBidID = onScreenBidID;
        OnScreenProjectName = onScreenProjectName;
        mIsChangeOrder = isChangeOrder;
        mJob = job;

        switch (mTakeoffMode)
        {
            case "Item":
                mViewIndex = 8;
                break;
            case "Assembly":
                mViewIndex = 0;
                break;

            // "Custom" is the VB6 file-browse import (FTakeoff.frm:1696-1719
            // — VBGetOpenFileName over .pee/.xls/.xlsx/.txt/.csv, then
            // ReadEstimate/ReadText). VB6 Form_Load skips list init entirely
            // in this mode (FTakeoff.frm:903 `If mTakeoffMode = "Custom"
            // Then Exit Sub`), so return here WITHOUT LoadListAsync and
            // WITHOUT closing: mTakeoffMode is already set above, so
            // IsCustomMode flips true and the Custom Takeoff panel (markup
            // top-section) renders. HHM-236: the HOST now runs the file
            // pick BEFORE opening this form (FAssembly's Custom toolbar
            // label opens the browser picker directly, mirroring VB6's
            // immediate VBGetOpenFileName) and hands the choice in via
            // InitialCustomFileName/-Content — import it right away so the
            // panel opens showing the parse result; the in-panel pick
            // control remains for re-picks. No initial file (standalone
            // /takeoff?mode=Custom navigation) keeps the old flow.
            case "Custom":
                if (!string.IsNullOrEmpty(InitialCustomFileName))
                    ProcessCustomTakeoffFile(InitialCustomFileName, InitialCustomFileContent);
                return;

            // VB6 dispatched "OneTime" → FTakeoffOneTime, "PlanSwift" →
            // ReadPlanSwift, and the OnCenter/OnScreen-only binary import
            // paths (FTakeoff.frm:1696-1721). None of those external takeoff
            // integrations are available in this version. Rather than fall
            // through to an empty list (silent no-op), surface a clear
            // message and close gracefully — matching the prompt's "show a
            // message instead of a break" requirement.
            case "OneTime":
            case "PlanSwift":
            case "OnScreen":
                await ShowIntegrationUnavailableAsync(mTakeoffMode);
                return;
        }

        await LoadListAsync(true);
    }

    /// <summary>External takeoff integrations (One-Time, PlanSwift, OnCenter
    /// On-Screen) are out of scope in this version. Show a single explanatory
    /// dialog, then dismiss the form (so the user isn't left staring at an
    /// empty modal). VB6 hosted these in separate forms / COM automations
    /// (Planswift, OnScreen) that don't exist here.</summary>
    private async Task ShowIntegrationUnavailableAsync(string mode)
    {
        var label = mode switch
        {
            "OneTime" => "One-Time takeoff",
            "PlanSwift" => "PlanSwift import",
            "OnScreen" => "OnCenter On-Screen takeoff",
            _ => "This takeoff"
        };
        var message = $"{label} is not available in this version.";

        if (_messageBox != null)
            await _messageBox.ShowAsync(message, title: "Takeoff",
                buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.Ok);
        else
            Notifications.Info(message);

        await OnCloseClick();
    }

