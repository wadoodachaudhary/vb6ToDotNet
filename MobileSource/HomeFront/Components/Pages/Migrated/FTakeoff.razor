    /// <summary>VB6 parity: FTakeoff.frm:1223 — Find… opens FPickList over
    /// the active view's findQry SELECT so the user can search across the
    /// flattened result set instead of drilling through the tree. The
    /// PickList result currently surfaces as an Info notification; future
    /// work can route the selected ID to AddItem like VB6 did when the user
    /// double-clicks a hit.</summary>
    private async Task OnFindClick()
    {
        _showListContextMenu = false;
        _openSubmenu = MenuGroup.None;

        if (mViewIndex < 0 || mViewIndex >= Views.Count) return;
        var view = Views[mViewIndex];
        if (string.IsNullOrWhiteSpace(view.FindQry))
        {
            Notifications.Info($"Find isn't wired up for the '{view.Name}' view yet.");
            return;
        }

        // VB6 Choose(..., HideColumns:="ID", MultiSelect:=True) — the ID column
        // is the lookup key, never shown (FTakeoff.frm:1225).
        if (pickList != null)
        {
            _takeoffPickContext = "Find";
            await pickList.Open(view.Name, view.FindQry, hideColumns: "ID", multiSelect: true);
        }
    }

    /// <summary>Receives the Find… picker's selection. VB6 used the chosen
    /// ID to navigate the tree to that node (FTakeoff.frm:1232 onwards);
    /// for now we surface it as an Info notification so the wiring is
    /// visible end-to-end. Carrying the ID into tree drill-down is a small
    /// follow-up — uses Views[mViewIndex].KeyFlds to descend.</summary>
    private Task OnFindResult(List<IDictionary<string, object>> rows)
    {
        if (rows == null || rows.Count == 0) { _takeoffPickContext = ""; return Task.CompletedTask; }

        // ── Substitute Item (VB6 FTakeoff.frm:2814-2833): overwrite the selected grid
        // rows' item identity + master-data fields with the picked tblPhaseItem row;
        // Assembly/AssemblyDescription clear, OrderQty recomputes = TakeoffQty × ConvFactor. ──
        if (_takeoffPickContext == "SubstituteItem")
        {
            _takeoffPickContext = "";
            var pick = rows[0];
            string S(string k) => pick.TryGetValue(k, out var v) && v != null ? v.ToString() ?? "" : "";
            foreach (var r in _itemsGridMenuSelection)
            {
                r.Assembly = "";
                r.AssemblyDescription = "";
                r.Phase = S("Phase");
                r.Item = S("Item");
                r.Description = S("Description");
                r.TakeoffUOM = S("TakeoffUOM");
                r.ConversionFactor = ToDouble(pick.TryGetValue("ConversionFactor", out var cf) ? cf : 0);
                r.OrderUOM = S("OrderUOM");
                r.POIndex = S("POIndex");
                r.Notes = S("Notes");
                r.JCCostCode = S("CostCode");
                r.JCCategory = S("Category");
                r.OrderQty = r.TakeoffQty * r.ConversionFactor;
            }
            _itemsGridMenuSelection = new();
            StateHasChanged();
            return Task.CompletedTask;
        }

        // ── Find (VB6 FTakeoff.frm:1224-1249, Ctrl+F handler): the pick does NOT
        // drill the tree — it loads the chosen record straight into the RHS via the
        // same per-view dispatch a tree double-click uses (AddModelOrOption /
        // AddQuote level 3 / AddItem), which is also what enables Add Pass / OK
        // (HHM-212). Assembly views key on m.AssemblyID; job views on the numeric
        // EstAssemblyID (LoadQuote rewrites `assembly =` → `estassemblyid =`);
        // item views on Phase/Item.
        _takeoffPickContext = "";
        return LoadFindResultAsync(rows);
    }

    private async Task LoadFindResultAsync(List<IDictionary<string, object>> rows)
    {
        string S(IDictionary<string, object> r, string k) =>
            r.TryGetValue(k, out var v) && v != null ? v.ToString() ?? "" : "";
        string Id(IDictionary<string, object> r) =>
            r.TryGetValue("ID", out var v1) && v1 != null ? v1.ToString() ?? ""
            : r.TryGetValue("id", out var v2) && v2 != null ? v2.ToString() ?? "" : "";

        foreach (var pick in rows)
        {
            ListTreeNode? node = null;
            if (mViewIndex >= 0 && mViewIndex <= 3)
            {
                node = new ListTreeNode
                {
                    WhereClause = " AND m.AssemblyID = @FindID",
                    WhereParams = new Dictionary<string, object> { ["FindID"] = Id(pick) }
                };
            }
            else if (mViewIndex >= 4 && mViewIndex <= 5)
            {
                node = new ListTreeNode
                {
                    WhereClause = " AND assembly = @FindID",
                    WhereParams = new Dictionary<string, object> { ["FindID"] = Id(pick) }
                };
            }
            else if (mViewIndex >= 8 && mViewIndex <= 11)
            {
                node = new ListTreeNode { KeyValue = $"{S(pick, "Phase")}/{S(pick, "Item")}" };
            }
            if (node != null)
                await LoadAssemblyOrItem(node);
        }
        StateHasChanged();
    }

    // ── Items-grid context menu (HHM-214/218) ──────────────────────────────────
    // VB6 gItems_BeforeMouseDown: right-click on a data row → FMain.mnuAssemblyItems;
