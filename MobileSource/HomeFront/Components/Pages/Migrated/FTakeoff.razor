    private void OnItemsGridContextMenu(MouseEventArgs e)
    {
        if ((ItemsData?.Count ?? 0) == 0) return;
        _itemsGridMenuX = e.ClientX;
        _itemsGridMenuY = e.ClientY;
        _showItemsGridMenu = true;
