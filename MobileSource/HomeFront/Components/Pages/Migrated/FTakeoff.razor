    // ── GetItemTotal (formula lookup support) ─────────────────
    public double GetItemTotal(string totalType, string poIndex, string costCode, string phase, string item)
    {
        double v = 0;
        string col = totalType switch
        {
            "OrderQty" or "Cost" => "PassOrderQty",
            "TakeoffQty" => "PassTakeoffQty",
            _ => "PassOrderQty"
        };

        foreach (var row in ItemsData)
        {
            if ((string.IsNullOrEmpty(poIndex) || poIndex == row.POIndex) &&
                (string.IsNullOrEmpty(costCode) || costCode == row.JCCostCode) &&
                (string.IsNullOrEmpty(phase) || phase == row.Phase) &&
                (string.IsNullOrEmpty(item) || item == row.Item))
            {
                double val = col == "PassOrderQty" ? row.PassOrderQty : row.PassTakeoffQty;
                v += val;
            }
        }

        return v;
    }

    // ── Formula engine (VB6 MFormulas.bas + clsEquation parity) ──────────
    //
    // VB6 evaluates a takeoff item's quantity in three steps:
    //   1. ResolveFormula  — replace {formulaName} with the Formulas-table
    //                        text (recursive, with a 30-deep circular-ref
    //                        guard).  MFormulas.bas:4.
    //   2. CalcFormula     — replace [VariableName] with the variable's
    //                        numeric value (or quoted string for a
    //                        list-of-values variable), then hand the
    //                        arithmetic string to clsEquation. MFormulas.bas:204.
    //   3. clsEquation     — a full expression solver: + - * / \ ^ %  / mod,
    //                        comparisons (= < > <= >= <>), AND/OR, unary
    //                        minus, implicit multiplication ("2(3)", "2 x"),
    //                        and the function library (abs/round/roundto/min/
    //                        max/avg/sum/int/trunc/floor/ceiling/sqrt/power/
    //                        if(...) plus the totaltakeoffqty/totalorderqty/
    //                        totalcost DB lookups). clsEquation.cls.
    //
    // The previous port collapsed any non-bare-number formula to 1, so a
    // formula like "[Quantity] * 2" or "roundto([SqFt]/100,1,1)" produced
    // PassTakeoffQty = qty × 1 — wrong takeoff quantities. We now run the
    // real pipeline. Lookup functions (FormulaHasLookups) are routed through
    // GetItemTotal, matching clsEquation.cls:413-415.

    /// <summary>VB6 MFormulas.bas:200 — a formula needs the second pass (and
    /// the cross-item totals) when it references one of the aggregate lookup
    /// functions.</summary>
    private static bool FormulaHasLookups(string resolvedFormula) =>
        resolvedFormula.IndexOf("TotalTakeoffQty", StringComparison.Ordinal) >= 0
        || resolvedFormula.IndexOf("TotalOrderQty", StringComparison.Ordinal) >= 0
        || resolvedFormula.IndexOf("TotalCost", StringComparison.Ordinal) >= 0;

    /// <summary>VB6 MFormulas.bas:4 ResolveFormula — replace every
    /// <c>{formulaName}</c> with <c>(text)</c> from the Formulas table,
    /// recursively, guarding against a runaway/circular reference at 30
    /// substitutions (VB6's exact limit). Returns the original on a missing
    /// formula name so the equation solver surfaces the error per-row, just
    /// like VB6 (which MsgBox'd and left the token in place).</summary>
    private async Task<string> ResolveFormulaAsync(string rawFormula)
    {
        if (string.IsNullOrEmpty(rawFormula)) return rawFormula ?? "";

        var s = rawFormula.Replace('\r', ' ').Replace('\n', ' ').Trim();
        int guard = 0;
        int open;
        while ((open = s.IndexOf('{')) >= 0)
        {
            var close = s.IndexOf('}', open + 1);
            if (close < 0) break; // unbalanced — leave as-is for the solver
            var name = s.Substring(open + 1, close - open - 1);

            guard++;
            if (guard > 30)
            {
                Logger.LogWarning("ResolveFormula: circular/over-deep formula reference in '{Formula}'", rawFormula);
                return "";
            }

            string? text = null;
            try
            {
                text = await db.ExecuteScalarAsync<string>(
                    "SELECT text FROM Formulas WHERE name = @Name",
                    new { Name = name });
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "ResolveFormula: lookup failed for formula '{Name}'", name);
            }

            if (text == null)
            {
                // VB6 MsgBox "Unknown formula" then Exit Function leaving the
                // raw token; we do the same so the row's eval fails loudly
                // rather than silently resolving to something else.
                Logger.LogWarning("ResolveFormula: unknown formula '{Name}'", name);
                return s;
            }

            s = s.Replace("{" + name + "}", "(" + text + ")");
        }
        return s;
    }

    /// <summary>VB6 MFormulas.bas:204 CalcFormula — substitute the takeoff
    /// variables into the resolved formula, then evaluate with the equation
    /// solver. <paramref name="quiet"/> mirrors VB6's Quiet flag (errors are
    /// swallowed and 0 returned instead of surfaced) — Add Pass passes
    /// quiet:true and reports a single aggregate error per failing row, as
    /// VB6's cmdAddPass_Click did via <c>On Error Resume Next</c>.</summary>
    private double CalcFormula(string resolvedFormula, bool quiet)
    {
        // VB6: list-of-values variables substitute as a quoted string; plain
        // numeric variables substitute as Val(value). Replace longest names
        // first so "[SqFt]" isn't partially clobbered by a "[Sq]" variable.
        var s = resolvedFormula ?? "";
        foreach (var v in HFVariablesData
                              .Where(v => !string.IsNullOrEmpty(v.Name))
                              .OrderByDescending(v => v.Name.Length))
        {
            var token = "[" + v.Name + "]";
            string replacement = !string.IsNullOrEmpty(v.ListOfValues)
                ? "\"" + (v.Value ?? "") + "\""
                : ToDouble(v.Value).ToString(System.Globalization.CultureInfo.InvariantCulture);
            s = ReplaceCaseInsensitive(s, token, replacement);
        }

        if (string.IsNullOrWhiteSpace(s)) return 0;

        try
        {
            return new FormulaEquation(s, GetItemTotal).Solve();
        }
        catch (Exception ex)
        {
            if (!quiet)
                Notifications.Error($"Error evaluating formula: {ex.Message}");
            throw;
        }
    }

    private static string ReplaceCaseInsensitive(string input, string search, string replacement)
    {
        if (string.IsNullOrEmpty(input) || string.IsNullOrEmpty(search)) return input;
        var sb = new System.Text.StringBuilder();
        int idx = 0;
        while (true)
        {
            int found = input.IndexOf(search, idx, StringComparison.OrdinalIgnoreCase);
            if (found < 0) { sb.Append(input, idx, input.Length - idx); break; }
            sb.Append(input, idx, found - idx);
            sb.Append(replacement);
            idx = found + search.Length;
        }
        return sb.ToString();
    }
    // FormulaEquation (the clsEquation.cls port) now lives in Models/FormulaEquation.cs —
    // extracted so the Formula Editor's Test button (HHM-211) shares the SAME solver.
    // This host passes GetItemTotal for the Total* aggregate functions.

    // ── Helpers ───────────────────────────────────────────────
    private double ToDouble(object? val)
    {
        if (val == null || val is DBNull) return 0;
        if (val is string s) return double.TryParse(s, out var d) ? d : 0;
        try { return Convert.ToDouble(val); }
        catch { return 0; }
    }

