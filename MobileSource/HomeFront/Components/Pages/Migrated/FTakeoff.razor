                FromWhere = $" from tbldbassemblymaster m left outer join tbllocality l on(m.community=l.area) left outer join tblcategories c on(m.category=c.category) where m.DivisionID = {SessionState.DivisionID} and isnull(m.inactive,0)=0 and m.assemblytype=4",
                Database = "HomeFront",
                FindQry = $"select m.assemblyid id,m.Assembly,m.OptionID,m.Series,m.Description,m.Category from tbldbassemblymaster m left outer join tbllocality l on(m.community=l.area) left outer join tblcategories c on(m.category=c.category) where m.DivisionID = {SessionState.DivisionID} and isnull(m.inactive,0)=0 and m.assemblytype=4 order by 2,3,4,5"
            },
            // 4: Quotes
            new ViewDef
            {
                Name = "Quotes",
                KeyFlds = "job|changeorder|assembly",
                DisplayFlds = "job + ' - ' + jobdesc|changeorderdesc|assemblydesc",
                SortFlds = "||assemblytype",
                FromWhere = $" from OpenJobAndQuoteAssemblies where OpenJobAndQuoteAssemblies.DivisionID = {SessionState.DivisionID} and isquote=1",
                Database = "HomeFront",
                FindQry = $"select Assembly ID,Job,JobDesc,ChangeOrderDesc,AssemblyDesc from OpenJobAndQuoteAssemblies where OpenJobAndQuoteAssemblies.DivisionID = {SessionState.DivisionID} and isquote=1 order by 2,3,4,5"
            },
            // 5: Open Jobs
            new ViewDef
            {
                Name = "Open Jobs",
                KeyFlds = "job|changeorder|assembly",
                DisplayFlds = "job + ' - ' + jobdesc|changeorderdesc|assemblydesc",
                SortFlds = "||assemblytype",
                FromWhere = $" from OpenJobAndQuoteAssemblies where OpenJobAndQuoteAssemblies.DivisionID = {SessionState.DivisionID} and isquote=0",
                Database = "HomeFront",
                FindQry = $"select Assembly ID,Job,JobDesc,ChangeOrderDesc,AssemblyDesc from OpenJobAndQuoteAssemblies where DivisionID = {SessionState.DivisionID} and isquote=0 order by 2,3,4,5"
            },
            // 6: Custom Options (VB6 Job_CustomOptions, FTakeoff.frm:1952)
            new ViewDef
            {
                Name = "Custom Options",
                KeyFlds = "job|changeorder|assembly",
                DisplayFlds = "job + ' - ' + jobdesc|changeorderdesc|assemblydesc",
                SortFlds = "||assemblytype",
                FromWhere = $" from dbo.UnApprovedCustomOptions where DivisionID = {SessionState.DivisionID} and isquote=0",
                Database = "HomeFront",
                FindQry = $"select Assembly ID,Job,JobDesc,ChangeOrderDesc,Assembly,AssemblyDesc from dbo.UnApprovedCustomOptions where DivisionID = {SessionState.DivisionID} and isquote=0 order by 2,3,4,5"
            },
            // 7: (reserved — VB6 Estimating Assemblies; left as a placeholder
            //    until the cross-DB Sage100/Timberline path is wired)
            new ViewDef { Name = "Estimating Assemblies", Database = "Estimating" },
            // Shared Find SELECT for the four item views — VB6 uses a single
            // findQry across them (FTakeoff.frm:1965 sets `findQry` once and
            // assigns the same value to mViews(7..10).findQry).
            // 8: Items by Groups & Phases
            new ViewDef
            {
                Name = "Items by Groups & Phases",
                KeyFlds = "GrpPhase|Phase|Phase+'/'+Item",
                SortFlds = "GrpSortOrder|PhaseSortOrder|ItemSortOrder",
