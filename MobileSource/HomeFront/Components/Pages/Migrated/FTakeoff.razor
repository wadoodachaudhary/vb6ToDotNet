    private async Task OnCustomFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        var ext = (Path.GetExtension(file.Name) ?? "").ToLowerInvariant();
        string? content = null;
        try
        {
            if (ext == ".csv" || ext == ".txt")
            {
                const long maxBytes = 8L * 1024 * 1024;
                await using var stream = file.OpenReadStream(maxBytes);
                using var reader = new StreamReader(stream);
                content = await reader.ReadToEndAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Custom takeoff import failed");
            CustomTakeoffSelectedFileName = file.Name;
            CustomTakeoffParsedRowCount = 0;
            CustomTakeoffStatusIsError = true;
            CustomTakeoffStatus = $"Import failed: {ex.Message}";
            StateHasChanged();
            return;
        }

        ProcessCustomTakeoffFile(file.Name, content);
        StateHasChanged();
    }

    /// <summary>Shared import step for BOTH intake paths: the in-panel
    /// InputFile (re-pick) and the host-picked file handed in through
    /// <see cref="InitialCustomFileName"/>/<see cref="InitialCustomFileContent"/>
    /// (HHM-236 — FAssembly's Custom button opens the OS picker directly,
    /// like VB6's VBGetOpenFileName, then opens this form pre-imported).
    /// <paramref name="content"/> is null for binary formats (.pee/.xls/
    /// .xlsx) which keep their "not yet supported" status message.</summary>
    private void ProcessCustomTakeoffFile(string fileName, string? content)
    {
        CustomTakeoffStatus = "";
        CustomTakeoffStatusIsError = false;
        CustomTakeoffParsedRowCount = 0;
        CustomTakeoffSelectedFileName = fileName;

        var ext = (Path.GetExtension(fileName) ?? "").ToLowerInvariant();
        try
        {
            if (ext == ".csv" || ext == ".txt")
            {
                if (content == null)
                {
                    CustomTakeoffStatusIsError = true;
                    CustomTakeoffStatus = "Import failed: the file could not be read.";
                }
                else
                {
                    ParseTextCustomTakeoff(content, ext == ".csv" ? ',' : '\t');
                }
            }
            else if (ext == ".pee")
            {
                CustomTakeoffStatusIsError = true;
                CustomTakeoffStatus = "Timberline (.pee) imports are not yet supported in the web client. " +
                                      "Export to CSV from Timberline and re-import.";
            }
            else if (ext == ".xls" || ext == ".xlsx")
            {
                CustomTakeoffStatusIsError = true;
                CustomTakeoffStatus = "Excel (.xls/.xlsx) imports are not yet supported in the web client. " +
                                      "Save the workbook as CSV and re-import.";
            }
            else
            {
                CustomTakeoffStatusIsError = true;
                CustomTakeoffStatus = $"Unsupported file extension: {ext}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Custom takeoff import failed");
            CustomTakeoffStatusIsError = true;
            CustomTakeoffStatus = $"Import failed: {ex.Message}";
        }
    }

    private void ParseTextCustomTakeoff(string content, char delimiter)
    {
        _customTakeoffCachedContent = content;
        _customTakeoffCachedDelimiter = delimiter;
        _customTakeoffUnmappedHeaders.Clear();
        _customTakeoffPendingMappings.Clear();

        var lines = content.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None)
                           .Where(l => !string.IsNullOrWhiteSpace(l))
                           .ToList();
        if (lines.Count == 0)
        {
            CustomTakeoffStatus = "File is empty.";
            CustomTakeoffStatusIsError = true;
            return;
        }

        var firstRow = SplitDelimited(lines[0], delimiter);
        var hasHeader = firstRow.Any(c => CustomTakeoffHeaderAlias(c) != null);
        var headers = hasHeader
            ? firstRow.Select(c => CustomTakeoffResolveHeader(c)).ToList()
            : DefaultHeaders(firstRow.Count);

        if (hasHeader)
        {
            for (int i = 0; i < firstRow.Count && i < headers.Count; i++)
            {
                var rawHeader = firstRow[i].Trim();
                if (string.IsNullOrEmpty(rawHeader)) continue;
                if (!string.IsNullOrEmpty(headers[i]))
                    UserPrefs.Put("CustomTakeoffMapping", rawHeader, headers[i]);
                else if (!_customTakeoffUnmappedHeaders.Contains(rawHeader))
                    _customTakeoffUnmappedHeaders.Add(rawHeader);
            }
        }

        ItemsData = new List<TakeoffItemRow>();
        var dataStart = hasHeader ? 1 : 0;
        for (int r = dataStart; r < lines.Count; r++)
        {
            var cells = SplitDelimited(lines[r], delimiter);
            var row = new TakeoffItemRow { Job = mJob };
            for (int c = 0; c < headers.Count && c < cells.Count; c++)
            {
                var field = headers[c];
                if (string.IsNullOrEmpty(field)) continue;
                ApplyCustomTakeoffCell(row, field, cells[c].Trim());
            }
            ItemsData.Add(row);
        }
        CustomTakeoffParsedRowCount = ItemsData.Count;
        var unmappedNote = _customTakeoffUnmappedHeaders.Count > 0
            ? $" — {_customTakeoffUnmappedHeaders.Count} unmapped column(s) shown below"
            : "";
        CustomTakeoffStatus = $"Imported {ItemsData.Count} row(s){unmappedNote} — review in the items grid below.";
        CustomTakeoffStatusIsError = false;
        // VB6 ReadText ends with a modal review whose OK hands the rows to
        // the host via mParentForm.AddItem (FTakeoff.frm:1590). Surface the
        // OK button so the imported rows can commit through the existing
        // OnOkClick → SaveData → OnItemsCommitted pipeline; a zero-row
        // parse keeps OK hidden (HHM-236).
        OkVisible = ItemsData.Count > 0;
    }

    private void ApplyCustomTakeoffMapping()
    {
        if (string.IsNullOrEmpty(_customTakeoffCachedContent)) return;
        foreach (var kv in _customTakeoffPendingMappings)
        {
            if (string.IsNullOrEmpty(kv.Key) || string.IsNullOrEmpty(kv.Value)) continue;
            UserPrefs.Put("CustomTakeoffMapping", kv.Key, kv.Value);
        }
        ParseTextCustomTakeoff(_customTakeoffCachedContent!, _customTakeoffCachedDelimiter);
    }

    private static List<string> SplitDelimited(string line, char delimiter)
    {
        var result = new List<string>();
        var sb = new System.Text.StringBuilder();
        bool inQuotes = false;
        foreach (var ch in line)
        {
            if (ch == '"') { inQuotes = !inQuotes; continue; }
            if (ch == delimiter && !inQuotes) { result.Add(sb.ToString()); sb.Clear(); continue; }
            sb.Append(ch);
        }
        result.Add(sb.ToString());
        return result;
    }

    private string? CustomTakeoffHeaderAlias(string raw)
    {
        var key = (raw ?? "").Trim().ToLowerInvariant().Replace(" ", "").Replace("_", "");
        return key switch
        {
            "phase" => "Phase",
            "item" or "partnumber" or "part#" or "partno" => "Item",
            "description" or "desc" or "itemdesc" => "Description",
            "qty" or "quantity" or "takeoffqty" => "TakeoffQty",
            "uom" or "unit" or "takeoffuom" => "TakeoffUOM",
            "orderqty" or "poqty" => "OrderQty",
            "orderuom" or "pouom" => "OrderUOM",
            "costcode" or "jccostcode" => "JCCostCode",
            "category" or "jccategory" => "JCCategory",
            "price" or "rate" or "porate" => "Price",
            "poindex" => "POIndex",
            "vendor" or "povendor" => "Vendor",
            "notes" or "comments" => "Notes",
            "location" => "Location",
            _ => null
        };
    }

    private string CustomTakeoffResolveHeader(string raw)
    {
        var alias = CustomTakeoffHeaderAlias(raw);
        if (alias != null) return alias;
        return UserPrefs.Get("CustomTakeoffMapping", raw.Trim(), "");
    }

    private static List<string> DefaultHeaders(int count)
    {
        var defaults = new[] { "Phase", "Item", "Description", "TakeoffQty", "TakeoffUOM" };
        var headers = new List<string>(count);
        for (int i = 0; i < count; i++)
            headers.Add(i < defaults.Length ? defaults[i] : "");
        return headers;
    }

    private static void ApplyCustomTakeoffCell(TakeoffItemRow row, string field, string value)
    {
        switch (field)
        {
            case "Phase":         row.Phase = value; break;
            case "Item":          row.Item = value; break;
            case "Description":   row.Description = value; break;
            case "TakeoffQty":    row.TakeoffQty = ParseDouble(value); break;
            case "TakeoffUOM":    row.TakeoffUOM = value; break;
            case "OrderQty":      row.OrderQty = ParseDouble(value); break;
            case "OrderUOM":      row.OrderUOM = value; break;
            case "JCCostCode":    row.JCCostCode = value; break;
            case "JCCategory":    row.JCCategory = value; break;
            case "Price":         row.Price = ParseDouble(value); break;
            case "POIndex":       row.POIndex = value; break;
            case "Notes":         row.Notes = value; break;
            case "Location":      row.Location = value; break;
        }
    }

    private static double ParseDouble(string s) =>
        double.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0d;

    // ── Lifecycle ─────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        mSessionID = $"{Environment.MachineName}_{Environment.ProcessId}";

        // Inline-edit persistence + VB6 gItems_AfterEdit cross-recalc.
        // Without this the user's typed TakeoffQty / OrderQty values
        // never make it back to ItemsData and SaveData's zero-qty check
        // wrongly fires.
        itemsGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<TakeoffItemRow>>(this, OnItemsCellSave);

        // FAssembly-parity multi-select fan-out: OnCellEdit tracks which
        // editable column the user is in so type-ahead knows where to
        // commit; OnTypeAheadCommit fans the typed value across every
        // selected row in one shot.
        itemsGridEvents.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<TakeoffItemRow>>(this, args =>
        {
            _activeEditColumn = args.ColumnName;
        });
        itemsGridEvents.OnTypeAheadCommit = EventCallback.Factory.Create<TypeAheadCommitArgs<TakeoffItemRow>>(this, OnItemsTypeAheadCommit);

        // VB6 gHFVariables_BeforeEdit "value" case (frm:2977-2995): non-numeric
        // input is rejected outright; values outside the variable's Min/Max get
        // the legacy "too large"/"too small" message and the edit reverts
        // (HHM-232). OnCellEdit snapshots the pre-edit value for the revert.
        hfVariablesEvents.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<HFVariableRow>>(this, args =>
        {
            _hfVarPrevValue = args.Data?.Value ?? "";
        });
        hfVariablesEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<HFVariableRow>>(this, OnHFVariableCellSave);

        await LoadCategories();
        await LoadWbsDescriptionsAsync();
        await LoadItemsGridLayoutAsync();
        LoadViewDefinitions();
        LoadCustomTakeoffPrefs();

        // If navigated with query params (from FAssembly toolbar), call Takeoff()
        if (!string.IsNullOrEmpty(mode))
        {
            await Takeoff(
                isChangeOrder: isChangeOrder == "true",
                takeoffMode: mode,
                onScreenBidID: 0,
                onScreenProjectName: "",
                assemblyType: int.TryParse(assemblyType, out var at) ? at : 0,
                assemblyDescription: description ?? "",
                community: community ?? "",
                communityPhase: communityPhase ?? "",
                model: model ?? "",
                optionID: optionID ?? "",
                assembly: assembly ?? "",
                job: "");
        }
        else
        {
            await LoadListAsync(true);
        }
    }

    // ── Load Categories ───────────────────────────────────────
    private async Task LoadCategories()
    {
        try
        {
            var rows = await db.QueryAsync(
                $"SELECT ISNULL(Category,'') + ' - ' + ISNULL(Description,'') AS Display, Category FROM StandardCategories WHERE DivisionID = {SessionState.DivisionID} ORDER BY Category");
            CategoryList = rows.Select(r => new ComboItem
            {
                Value = r["Category"]?.ToString() ?? "",
                Text = r["Display"]?.ToString() ?? ""
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"LoadCategories error: ");
        }
    }

    /// <summary>VB6 parity for FTakeoff.frm:3259 <c>LoadWBSDescriptions</c>.
    /// VB6 allocates 40 hidden WBS-N columns at runtime then SELECTs from
    /// <c>customdescriptions</c> for any item like 'WBS__' that has a
    /// non-empty <c>custom_description</c> — each match un-hides its column
    /// and replaces the header caption with the description. We do the
    /// data part: build a sorted slot→label map; the grid markup iterates
    /// the map to render one <see cref="GridColumn"/> per visible slot.
    /// Slots WITHOUT a custom description simply aren't rendered.</summary>
    private async Task LoadWbsDescriptionsAsync()
    {
        try
        {
            // SQL mirrors VB6 verbatim — single-column custom_description
            // table; the LIKE 'WBS__' matches WBS01..WBS40 plus any other
            // 5-char codes starting with WBS. The TryParse below filters
            // strictly to numeric 1..40 to stay safe against stray entries.
            var rows = await db.QueryAsync(
                "SELECT Item, custom_description FROM customdescriptions " +
                "WHERE ISNULL(custom_description,'') <> '' AND item LIKE 'WBS__' " +
                "ORDER BY Item");
            _wbsLabels.Clear();
            foreach (var r in rows)
            {
                var item = r["Item"]?.ToString();
                if (string.IsNullOrEmpty(item) || item.Length != 5) continue;
                if (!int.TryParse(item.AsSpan(3), out var idx)) continue;
                if (idx < 1 || idx > 40) continue;
                var label = r["custom_description"]?.ToString();
                if (string.IsNullOrWhiteSpace(label)) continue;
                _wbsLabels[idx] = label;
            }
        }
        catch (Exception ex)
        {
            // Don't let a customdescriptions lookup failure block the form.
            Logger.LogWarning(ex, "LoadWbsDescriptionsAsync failed; no WBS columns will render.");
        }
    }

    /// <summary>Loads AppGridLayout rows for 'FTakeoff.gItems' so the
    /// markup's IsColVisible(field, default) helper can defer to the
    /// configured visibility. GridLayoutService already does the
    /// per-user → default('') fallback internally, so this is a single
    /// read. Failures are logged and swallowed — we just fall back to
    /// the hardcoded Visible defaults in the markup.</summary>
    private async Task LoadItemsGridLayoutAsync()
    {
        try
        {
            await _itemsGrid.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadItemsGridLayoutAsync failed; columns will use hardcoded defaults.");
        }
    }

