@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - Driven column visibility from AppGridLayout (FTakeoff.gItems); WBS extended to all slots
     - Dynamic WBS columns replicated from VB6 LoadWBSDescriptions
     - VB6-parity SaveData persistence so items land in FAssembly grid
     - Modal mode with dynamic view-name header + VB6-parity right-click menu
     - LoadQuote fix: drop changeorderno rename, use estassemblyid at level 3
   ───────────────────────────────────────────────────────────────── *@
@namespace HomeFront.Components.Pages
@page "/takeoff"

@using HomeFront.Models
@using System.Data
@using Microsoft.Data.SqlClient

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@using Fx.ControlKit.Notifications
@inject ILogger<FTakeoff> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IUserPreferencesService UserPrefs
@inject IGridLayoutService GridLayoutSvc
@using HomeFront.Data
@inject DbWrapperSqlServer db
@layout HFComponent
<PageTitle>Takeoff - HomeFront</PageTitle>


@* When IsModal=true, an overlay div wraps the whole container so the host
   page (FAssembly) stays mounted behind it. The overlay catches clicks on
   the dim backdrop without dismissing — modal must be closed via OK / Close
   / Cancel. The .takeoff-modal class is scoped CSS (added below). *@
@if (IsModal)
{
    <div class="takeoff-modal-backdrop" @onclick:stopPropagation="true"></div>
}
<div class="takeoff-container @(IsModal ? "takeoff-modal" : "")" style="position: relative;">

    @* VB6 parity: Me.Caption = mViews(mViewIndex).Name (FTakeoff.frm:2087).
       Header reflects the current view's display name ("Items by Groups &
       Phases", "Assemblies", "Quotes", "Custom Options", …). Re-renders
       automatically because SetView → LoadListAsync → StateHasChanged. Only
       drawn in modal mode — standalone /takeoff URLs use the browser title
       (set elsewhere via SetPageTitle cascade). *@
    @if (IsModal)
    {
        <div class="takeoff-header" style="display:flex; align-items:center; gap:6px; padding:4px 8px; background:#f0f0f0; color:#000; border-bottom:1px solid #c9c9c9; font-family:'MS Sans Serif', Tahoma, Arial, sans-serif; font-size:11px; font-weight:bold; user-select:none;">
            <img src="/images/32/ItemTakeoff.ico" style="width:16px; height:16px; object-fit:contain; image-rendering:pixelated;" alt="Icon" />
            <span class="takeoff-header-title" style="margin-left:2px; font-size:11px; font-weight:bold;">@CurrentViewName</span>
            <span style="flex:1;"></span>
            <button type="button"
                    title="Close"
                    aria-label="Close"
                    style="background:transparent; border:none; color:#000; font-size:14px; line-height:1; cursor:pointer; padding:2px 6px; font-weight:bold;"
                    @onclick="OnCloseClick">×</button>
        </div>
    }

    @if (IsLoading)
    {
        <div class="loading-overlay">⏳ Loading...</div>
    }

    @* ── OnScreen Project Bar ─────────────────────────────── *@
    @if (ShowOnScreenBar)
    {
        <div class="onscreen-bar">
            <label>OnCenter Project</label>
            <TextBoxControl Value="@OnScreenProjectName" CssClass="onscreen-project-input" readonly="readonly" />
            <ButtonControl CssClass="onscreen-browse-btn" OnClick="OnBrowseProject" Title="Browse OnCenter Project">📂</ButtonControl>
        </div>
    }

    @* ── Top Section: List + Variables ─────────────────────── *@
    <div class="top-section">
        @* Left: Assembly/Item List — replaced with the file-picker panel
           when mTakeoffMode == "Custom" (matches VB6 FTakeoff line 903
           `If mTakeoffMode = "Custom" Then Exit Sub`). *@
        @if (IsCustomMode)
        {
            <div class="list-panel custom-takeoff-panel">
                <h4 class="custom-takeoff-title">Custom Takeoff</h4>
                <div class="custom-takeoff-row">
                    <label>File type:</label>
                    <DropDownListControl TValue="int" TItem="CustomExtensionOption"
                                         Value="@CustomTakeoffExtension"
                                         ValueChanged="OnCustomExtensionDropdownChanged"
                                         DataSource="@CustomTakeoffExtensionOptions"
                                         TextFieldName="Label"
                                         ValueFieldName="Index"
                                         Width="100%" />
                </div>
                <div class="custom-takeoff-row">
                    <label>Pick file:</label>
                    <InputFile OnChange="OnCustomFileSelected" accept="@CustomTakeoffAcceptAttr" />
                </div>
                @if (!string.IsNullOrEmpty(CustomTakeoffSelectedFileName))
                {
                    <div class="custom-takeoff-row custom-takeoff-status">
                        <span><strong>Selected:</strong> @CustomTakeoffSelectedFileName</span>
                        @if (CustomTakeoffParsedRowCount > 0)
                        {
                            <span class="custom-takeoff-rowcount">@CustomTakeoffParsedRowCount row(s) imported</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(CustomTakeoffStatus))
                {
                    <div class="custom-takeoff-row custom-takeoff-msg @(CustomTakeoffStatusIsError ? "err" : "")">
                        @CustomTakeoffStatus
                    </div>
                }
                @if (_customTakeoffUnmappedHeaders.Count > 0)
                {
                    <div class="custom-takeoff-mapping">
                        <div class="custom-takeoff-mapping-title">
                            Map unrecognized columns:
                        </div>
                        @foreach (var raw in _customTakeoffUnmappedHeaders)
                        {
                            var capturedRaw = raw;
                            <div class="custom-takeoff-mapping-row">
                                <span class="custom-takeoff-mapping-raw" title="@capturedRaw">@capturedRaw</span>
                                <span class="custom-takeoff-mapping-arrow">→</span>
                                <DropDownListControl TValue="string" TItem="ComboItem"
                                                     Value="@(_customTakeoffPendingMappings.TryGetValue(capturedRaw, out var sel) ? sel : "")"
                                                     ValueChanged="@(v => _customTakeoffPendingMappings[capturedRaw] = v ?? "")"
                                                     DataSource="@CustomTakeoffMappingOptions"
                                                     TextFieldName="Text"
                                                     ValueFieldName="Value"
                                                     Width="140px" />
                            </div>
                        }
                        <ButtonControl CssClass="custom-takeoff-mapping-apply"
                                       BareStyle="true"
                                       OnClick="ApplyCustomTakeoffMapping">
                            Apply mapping &amp; re-import
                        </ButtonControl>
                    </div>
                }
            </div>
        }
        else
        {
            @* VB6: gList_MouseDown shows mnuTakeoff on right-click (FTakeoff.frm:3191).
               The menu lets the user switch between Assemblies / Specific Extras /
               Global Extras / Design Center / Quotes / Open Jobs views — exactly
               the same set as our Views[] config. We surface it as a simple
               context-menu div positioned at the cursor, hidden until a
               right-click sets _showListContextMenu. *@
            <div class="list-panel vb6-tree fx-treeview-vb6 fx-treeview-no-folder"
                 tabindex="0"
                 @ref="_listTreeRef"
                 @onkeydown="OnListTreeKeyDown"
                 @onkeydown:preventDefault="true"
                 @oncontextmenu="OnListContextMenu"
                 @oncontextmenu:preventDefault="true">
                @foreach (var node in ListNodes)
                {
                    @RenderListNode(node, 0)
                }
            </div>
            @if (_showListContextMenu)
            {
                @* VB6 mnuTakeoff parity (FMain.frm; FTakeoff.frm:3193 calls
                   `PopupMenu FMain.mnuTakeoff`). The user-visible captions
                   for "View Assemblies → Models / Models Specific Options /
                   Global Options / Design Center Options" come from VB6
                   lines 1885-1888 which override the residential builder
                   captions; we just hard-code them since this app only
                   ships in residential mode. View indices map to the
                   Views[] array in this file.

                   Submenu visibility is driven by hovering a parent item
                   (mouseenter sets _openSubmenu). Clicking outside or
                   picking a leaf closes everything. *@
                <div style="position:fixed;inset:0;z-index:999;background:transparent;"
                     @onclick="CloseListContextMenu"
                     @oncontextmenu="CloseListContextMenu"
                     @oncontextmenu:preventDefault="true"></div>
                <div class="context-menu fx-takeoff-menu"
                     style="left:@(_listContextMenuX)px;top:@(_listContextMenuY)px;"
                     @onclick:stopPropagation="true"
                     @onmouseleave="() => _openSubmenu = MenuGroup.None">

                    @* Find…  — opens FPickList with the current view's
                       findQry, mirroring VB6 FTakeoff.frm:1223 path. *@
                    <button class="fx-takeoff-menu-row"
                            @onmouseenter="() => _openSubmenu = MenuGroup.None"
                            @onclick="OnFindClick">
                        <span>Find…</span>
                        <span class="fx-takeoff-menu-shortcut">Ctrl+F</span>
                    </button>
                    <hr />

                    @* View Assemblies → 4 sub-items *@
                    <div class="fx-takeoff-menu-parent @(((int)_openSubmenu) == (int)MenuGroup.Assemblies ? "active" : "")"
                         @onmouseenter="() => _openSubmenu = MenuGroup.Assemblies">
                        <button class="fx-takeoff-menu-row">
                            <span>View Assemblies</span>
                            <span class="fx-takeoff-menu-arrow">▸</span>
                        </button>
                        @if (_openSubmenu == MenuGroup.Assemblies)
                        {
                            <div class="fx-takeoff-submenu">
                                <button @onclick="() => OnListContextSetView(0)">Models</button>
                                <button @onclick="() => OnListContextSetView(1)">Models Specific Options</button>
                                <button @onclick="() => OnListContextSetView(2)">Global Options</button>
                                <button @onclick="() => OnListContextSetView(3)">Design Center Options</button>
                            </div>
                        }
                    </div>

                    @* View Quotes & Jobs → 3 sub-items *@
                    <div class="fx-takeoff-menu-parent @(((int)_openSubmenu) == (int)MenuGroup.QuotesJobs ? "active" : "")"
                         @onmouseenter="() => _openSubmenu = MenuGroup.QuotesJobs">
                        <button class="fx-takeoff-menu-row">
                            <span>View Quotes &amp; Jobs</span>
                            <span class="fx-takeoff-menu-arrow">▸</span>
                        </button>
                        @if (_openSubmenu == MenuGroup.QuotesJobs)
                        {
                            <div class="fx-takeoff-submenu">
                                <button @onclick="() => OnListContextSetView(4)">Quotes</button>
                                <button @onclick="() => OnListContextSetView(5)">Open Jobs</button>
                                <button @onclick="() => OnListContextSetView(6)">Custom Options</button>
                            </div>
                        }
                    </div>

                    @* View Items → 4 sort variants (views 8..11) *@
                    <div class="fx-takeoff-menu-parent @(((int)_openSubmenu) == (int)MenuGroup.Items ? "active" : "")"
                         @onmouseenter="() => _openSubmenu = MenuGroup.Items">
                        <button class="fx-takeoff-menu-row">
                            <span>View Items</span>
                            <span class="fx-takeoff-menu-arrow">▸</span>
                        </button>
                        @if (_openSubmenu == MenuGroup.Items)
                        {
                            <div class="fx-takeoff-submenu">
                                <button @onclick="() => OnListContextSetView(8)">Sort by Group and Phase</button>
                                <button @onclick="() => OnListContextSetView(9)">Sort by Purchase Order</button>
                                <button @onclick="() => OnListContextSetView(10)">Sort by Cost Code</button>
                                <button @onclick="() => OnListContextSetView(11)">Sort by Description</button>
                            </div>
                        }
                    </div>

                    @* View Estimates — disabled. VB6 enabled this only when
                       Sage100 / Timberline DB was connected (FTakeoff.frm:1892
                       `FMain.mnuTakeOffEstimateView(12).Enabled = ...`). We
                       have no such connection wired today, so it stays
                       disabled — the grey label preserves the menu shape so
                       admins know it exists. *@
                    <button class="fx-takeoff-menu-row" disabled
                            @onmouseenter="() => _openSubmenu = MenuGroup.None"
                            title="Requires Sage100 / Timberline Estimating connection">
                        <span style="color:#aaa;">View Estimates</span>
                        <span class="fx-takeoff-menu-arrow" style="color:#aaa;">▸</span>
                    </button>
                </div>
            }
        }

        @* Right: Variables + Help *@
        <div class="variables-panel">
            <div class="variables-grid-area">
                @if (ShowHFVariables && IsHFQuantityOnly)
                {
                    @* VB6 parity: legacy "Items by Groups & Phases" shows
                       Quantity as a single label + textbox at the TOP-RIGHT
                       of the dialog (frame top, far right). The outer
                       flex container right-aligns the widget; the inner
                       .quantity-single-field stays inline-flex so label /
                       input / UOM sit on one row. Value formatted as
                       "0.000" on commit to match legacy txtQuantity.

                       Passive — typing here does NOT mutate the items
                       grid. Only the "+" (Add Pass) button reads Quantity
                       and multiplies it into TakeoffQty (VB6 cmdAddPass_Click). *@
                    <div class="quantity-row">
                        <div class="quantity-single-field">
                            <label>Quantity</label>
                            @* HHM-232: numeric-only input. The browser's number input blocks
                               alphabetic/special characters at the keystroke level; junk/empty
                               parses to 0 on commit, matching VB6 txtQty_Validate's
                               `txtQty.Text = Val(txtQty.Text)` (FTakeoff.frm:3290-3291).
                               Out-of-range values are NOT silently clamped any more (QA bounce):
                               OnHFQuantityChanged range-checks against the Quantity variable's
                               Min/Max (variables table, ±1e18 fallback — MFormulas.LoadVariables)
                               and rejects with the legacy too-large/too-small warning, exactly
                               like VB6 gHFVariables_ValidateEdit (FTakeoff.frm:2976-2990).
                               @key remounts the input after a rejected edit so the kept value
                               is restored in the DOM (the bound Value itself didn't change). *@
                            <NumericTextBoxControl TValue="double"
                                                   @key="_qtyInputEpoch"
                                                   Value="@HFQuantityNumericValue"
                                                   ValueChanged="@((double v) => OnHFQuantityChanged(v))"
                                                   Format="F3"
                                                   CssClass="quantity-input" />
                            <span class="quantity-uom">@HFQuantityUOM</span>
                        </div>
                    </div>
                }
                else if (ShowHFVariables && HFVariablesData.Count > 0)
                {
                    <GridControl @ref="HFVariablesGrid"
                            TValue="HFVariableRow"
                            DataSource="@HFVariablesData"
                            AllowSelection="true"
                            AllowResizing="true"
                            Height="100%"
                            EditSettingsRef="@variableEditSettings"
                            EventsRef="@hfVariablesEvents">
                        <GridColumnsBase>
                            <GridColumn Field="@nameof(HFVariableRow.Name)" HeaderText="Variable" Width="140px" AllowEditing="false" />
                            <GridColumn Field="@nameof(HFVariableRow.Value)" HeaderText="Value" Width="100px" AllowEditing="true" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(HFVariableRow.UOM)" HeaderText="UOM" Width="60px" AllowEditing="true" />
                            <GridColumn Field="@nameof(HFVariableRow.DisplayOrder)" HeaderText="" Width="1px" Visible="false" />
                            <GridColumn Field="@nameof(HFVariableRow.Min)" HeaderText="" Width="1px" Visible="false" />
                            <GridColumn Field="@nameof(HFVariableRow.Max)" HeaderText="" Width="1px" Visible="false" />
                            <GridColumn Field="@nameof(HFVariableRow.Help)" HeaderText="" Width="1px" Visible="false" />
                            <GridColumn Field="@nameof(HFVariableRow.ListOfValues)" HeaderText="" Width="1px" Visible="false" />
                            <GridColumn Field="@nameof(HFVariableRow.ConditionName)" HeaderText="" Width="1px" Visible="false" />
                            <GridColumn Field="@nameof(HFVariableRow.ConditionType)" HeaderText="" Width="1px" Visible="false" />
                            <GridColumn Field="@nameof(HFVariableRow.ConditionUOM)" HeaderText="" Width="1px" Visible="false" />
                        </GridColumnsBase>
                    </GridControl>
                }
                else if (ShowTLVariables && TLVariablesData.Count > 0)
                {
                    <GridControl @ref="TLVariablesGrid"
                            TValue="TLVariableRow"
                            DataSource="@TLVariablesData"
                            AllowSelection="true"
                            AllowResizing="true"
                            Height="100%"
                            EditSettingsRef="@variableEditSettings">
                        <GridColumnsBase>
                            <GridColumn Field="@nameof(TLVariableRow.Name)" HeaderText="Variable" Width="140px" AllowEditing="false" />
                            <GridColumn Field="@nameof(TLVariableRow.Value)" HeaderText="Value" Width="100px" AllowEditing="true" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(TLVariableRow.UOM)" HeaderText="UOM" Width="60px" AllowEditing="false" />
                            <GridColumn Field="@nameof(TLVariableRow.DisplayOrder)" HeaderText="" Width="1px" Visible="false" />
                            <GridColumn Field="@nameof(TLVariableRow.Min)" HeaderText="" Width="1px" Visible="false" />
                            <GridColumn Field="@nameof(TLVariableRow.Max)" HeaderText="" Width="1px" Visible="false" />
                            <GridColumn Field="@nameof(TLVariableRow.Help)" HeaderText="" Width="1px" Visible="false" />
                            <GridColumn Field="@nameof(TLVariableRow.IsYesNo)" HeaderText="" Width="1px" Visible="false" />
                        </GridColumnsBase>
                    </GridControl>
                }
            </div>

            <div class="help-area">
                <TextAreaControl Value="@HelpText" Rows="3" Enabled="false" CssClass="help-text" />
                <div class="pass-buttons">
                    @* HHM-212: legacy cmdUndoPass shows a BLUE curved undo arrow
                       (FTakeoff.frx picture); the old "↩" text glyph rendered
                       black/grey. Inline SVG (no JS, no external asset) so the
                       shape and the blue tone are identical on every platform. *@
                    <ButtonControl BareStyle="true" Disabled="@(!AddPassEnabled)" Title="Undo Pass" OnClick="OnUndoPass">
                        <svg width="14" height="14" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" style="display:block;">
                            <path fill="#2050B3" d="M6.6 1.6 1.4 6.2l5.2 4.6V7.6c3.5 0 6 1.3 7.6 4.1-.4-4.7-3.4-7.5-7.6-7.9V1.6z" />
                        </svg>
                    </ButtonControl>
                    <ButtonControl BareStyle="true" Disabled="@(!AddPassEnabled)" Title="Add Pass" OnClick="OnAddPass">➕</ButtonControl>
                </div>
            </div>
        </div>
    </div>

    @* ── Bottom Section: Items Grid ───────────────────────── *@
    <div class="bottom-section">
        @* VB6 gItems_BeforeMouseDown (FTakeoff.frm:2733): right-click on a data row pops
           FMain.mnuAssemblyItems. FTakeoff's own handler implements Make a Copy /
           Substitute Item… / Remove (frm:2777-2842). Edit Item Chart… and Attachments…
           are now offered too (HHM-547) — wired to the same FItemChart / FAttachments
           host pattern FAssembly uses, so the menu matches VB6's six-entry shared
           mnuAssemblyItems (FMain.frm:1588-1614). *@
        <div class="items-grid-area" @oncontextmenu="OnItemsGridContextMenu" @oncontextmenu:preventDefault="true">
            @* Trimmed-chrome grid (per user spec — no toolbar, no
                       drag-drop, no advanced options). Mirrors FAssembly's
                       multi-select + batch-edit wiring so type-ahead
                       fan-out on TakeoffQty / OrderQty works, but every
                       Show* opt-in is deliberately omitted: the
                       SelectionInfoBar, AdvancedViewToggle, ExpressionFilter,
                       GridOptionsRail, ColumnOptions, Pivot, ThemeToggle,
                       BackButton chrome stays off. AllowFiltering /
                       Grouping / ColumnReorder also left off — this is
                       a transient staging grid, not a persistent view. *@
            <GridControl @ref="ItemsGrid"
                    TValue="TakeoffItemRow"
                    DataSource="@ItemsData"
                    AllowSelection="true"
                    ShowSelectionInfoBar="false"
                    AllowSorting="true"
                    AllowResizing="true"
                    AllowFiltering="false"
                    EnableHover="true"
                    Height="100%"
                    EditSettingsRef="@itemEditSettings"
                    SelectionSettingsRef="@itemSelectionSettings"
                    BatchEditBehavior="GridBatchEditBehavior.SingleCell"
                    AllowSingleCellColumnMassEdit="true"
                    TypeAheadTargetField="@ItemsTypeAheadTargetField"
                    AvailableColumns="@GetTakeoffChooseColumnsSchema()"
                    OnColumnsChosen="@OnTakeoffColumnsChosenAsync"
                    EventsRef="@itemsGridEvents">
                <GridColumnsBase>
                    @* Every GridColumn's Visible attribute now defers to
                       AppGridLayout via IsColVisible(field, default). The
                       "default" mirrors the VB6 seed in MDBUpgrade3.bas:3133-
                       — 9 columns visible by default (Phase, Item, Description,
                       TakeoffQty, OrderQty, JCCostCode, JCCategory, POIndex,
                       WBS01), everything else hidden. A user with a customized
                       layout (per-uid row in AppGridLayout) overrides the
                       defaults; otherwise the GridLayoutService fallback to
                       the shared uid='' row returns the seed values. *@
                    <GridColumn Field="@nameof(TakeoffItemRow.Assembly)" HeaderText="@ColCaption(nameof(TakeoffItemRow.Assembly), "Assembly")" Width="@ColWidth(nameof(TakeoffItemRow.Assembly), "100px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.Assembly), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.AssemblyDescription)" HeaderText="@ColCaption(nameof(TakeoffItemRow.AssemblyDescription), "Asm Desc")" Width="@ColWidth(nameof(TakeoffItemRow.AssemblyDescription), "140px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.AssemblyDescription), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.Model)" HeaderText="@ColCaption(nameof(TakeoffItemRow.Model), "Model")" Width="@ColWidth(nameof(TakeoffItemRow.Model), "80px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.Model), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.Phase)" HeaderText="@ColCaption(nameof(TakeoffItemRow.Phase), "Phase")" Width="@ColWidth(nameof(TakeoffItemRow.Phase), "70px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.Phase), true)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.Item)" HeaderText="@ColCaption(nameof(TakeoffItemRow.Item), "Item")" Width="@ColWidth(nameof(TakeoffItemRow.Item), "70px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.Item), true)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.Description)" HeaderText="@ColCaption(nameof(TakeoffItemRow.Description), "Description")" Width="@ColWidth(nameof(TakeoffItemRow.Description), "200px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.Description), true)" />
                    @* VB6 parity: VSFlexGrid displays Takeoff/Order Qty as
                       whole numbers (no trailing decimals). N0 strips the
                       ".00" so "0" / "1" matches the legacy on-screen
                       look. Underlying value stays a double — fractional
                       takeoffs still round-trip correctly through SaveData. *@
                    <GridColumn Field="@nameof(TakeoffItemRow.TakeoffQty)" HeaderText="@ColCaption(nameof(TakeoffItemRow.TakeoffQty), "Takeoff Qty")" Width="@ColWidth(nameof(TakeoffItemRow.TakeoffQty), "90px")" Format="N0" TextAlign="TextAlign.Right" Type="ColumnType.Number" AllowEditing="true"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.TakeoffQty), true)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.TakeoffUOM)" HeaderText="@ColCaption(nameof(TakeoffItemRow.TakeoffUOM), "Takeoff UOM")" Width="@ColWidth(nameof(TakeoffItemRow.TakeoffUOM), "80px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.TakeoffUOM), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.OrderQty)" HeaderText="@ColCaption(nameof(TakeoffItemRow.OrderQty), "Order Qty")" Width="@ColWidth(nameof(TakeoffItemRow.OrderQty), "90px")" Format="N0" TextAlign="TextAlign.Right" Type="ColumnType.Number" AllowEditing="true"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.OrderQty), true)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.OrderUOM)" HeaderText="@ColCaption(nameof(TakeoffItemRow.OrderUOM), "Order UOM")" Width="@ColWidth(nameof(TakeoffItemRow.OrderUOM), "80px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.OrderUOM), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.ConversionFactor)" HeaderText="@ColCaption(nameof(TakeoffItemRow.ConversionFactor), "Conversion Factor")" Width="@ColWidth(nameof(TakeoffItemRow.ConversionFactor), "90px")" Format="N4" TextAlign="TextAlign.Right" Type="ColumnType.Number" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.ConversionFactor), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.WastePercent)" HeaderText="@ColCaption(nameof(TakeoffItemRow.WastePercent), "Waste Percent")" Width="@ColWidth(nameof(TakeoffItemRow.WastePercent), "70px")" Format="N0" TextAlign="TextAlign.Right" Type="ColumnType.Number" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.WastePercent), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.JCCostCode)" HeaderText="@ColCaption(nameof(TakeoffItemRow.JCCostCode), "Cost Code")" Width="@ColWidth(nameof(TakeoffItemRow.JCCostCode), "90px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.JCCostCode), true)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.JCCategory)" HeaderText="@ColCaption(nameof(TakeoffItemRow.JCCategory), "Category")" Width="@ColWidth(nameof(TakeoffItemRow.JCCategory), "80px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.JCCategory), true)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.Price)" HeaderText="@ColCaption(nameof(TakeoffItemRow.Price), "Price")" Width="@ColWidth(nameof(TakeoffItemRow.Price), "80px")" Format="C2" TextAlign="TextAlign.Right" Type="ColumnType.Number" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.Price), false)" />
                    @* OverridePrice keeps its IsEstimatesView gate AND
                       respects AppGridLayout — both must agree to show. *@
                    <GridColumn Field="@nameof(TakeoffItemRow.OverridePrice)" HeaderText="@ColCaption(nameof(TakeoffItemRow.OverridePrice), "Override Price")" Width="@ColWidth(nameof(TakeoffItemRow.OverridePrice), "100px")" Format="C2" TextAlign="TextAlign.Right" Type="ColumnType.Number" AllowEditing="true"
                                Visible="@(IsEstimatesView && IsColVisible(nameof(TakeoffItemRow.OverridePrice), false))" />
                    <GridColumn Field="@nameof(TakeoffItemRow.POIndex)" HeaderText="@ColCaption(nameof(TakeoffItemRow.POIndex), "POIndex")" Width="@ColWidth(nameof(TakeoffItemRow.POIndex), "80px")" TextAlign="TextAlign.Right" AllowEditing="true"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.POIndex), true)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.Location)" HeaderText="@ColCaption(nameof(TakeoffItemRow.Location), "Location")" Width="@ColWidth(nameof(TakeoffItemRow.Location), "100px")" AllowEditing="true"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.Location), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.Notes)" HeaderText="@ColCaption(nameof(TakeoffItemRow.Notes), "Comments")" Width="@ColWidth(nameof(TakeoffItemRow.Notes), "120px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.Notes), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.RawFormula)" HeaderText="@ColCaption(nameof(TakeoffItemRow.RawFormula), "Formula")" Width="@ColWidth(nameof(TakeoffItemRow.RawFormula), "120px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.RawFormula), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.ResolvedFormula)" HeaderText="Resolved" Width="@ColWidth(nameof(TakeoffItemRow.ResolvedFormula), "120px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.ResolvedFormula), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.Job)" HeaderText="Job" Width="@ColWidth(nameof(TakeoffItemRow.Job), "80px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.Job), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.RoundTo)" HeaderText="@ColCaption(nameof(TakeoffItemRow.RoundTo), "Round To")" Width="@ColWidth(nameof(TakeoffItemRow.RoundTo), "70px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.RoundTo), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.RoundDir)" HeaderText="@ColCaption(nameof(TakeoffItemRow.RoundDir), "Round Dir")" Width="@ColWidth(nameof(TakeoffItemRow.RoundDir), "70px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.RoundDir), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.PassTakeoffQty)" HeaderText="Pass TkOff" Width="@ColWidth(nameof(TakeoffItemRow.PassTakeoffQty), "90px")" Format="N2" TextAlign="TextAlign.Right" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.PassTakeoffQty), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.PassOrderQty)" HeaderText="Pass Order" Width="@ColWidth(nameof(TakeoffItemRow.PassOrderQty), "90px")" Format="N2" TextAlign="TextAlign.Right" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.PassOrderQty), false)" />

                    @* ── Static columns VB6 has that the migration was missing ──
                       Sequence / ItemChart / JCExtra are referenced throughout
                       VB6's gItems (FTakeoff.frm SaveData, AddItem). Per-row
                       data lives on TakeoffItemRow; visibility tracks the
                       AppGridLayout seed (hidden by default). *@
                    <GridColumn Field="@nameof(TakeoffItemRow.ItemChart)" HeaderText="@ColCaption(nameof(TakeoffItemRow.ItemChart), "Item Chart")" Width="@ColWidth(nameof(TakeoffItemRow.ItemChart), "100px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.ItemChart), false)" />
                    <GridColumn Field="@nameof(TakeoffItemRow.JCExtra)" HeaderText="@ColCaption(nameof(TakeoffItemRow.JCExtra), "JCExtra")" Width="@ColWidth(nameof(TakeoffItemRow.JCExtra), "80px")" AllowEditing="false"
                                Visible="@IsColVisible(nameof(TakeoffItemRow.JCExtra), false)" />

                    @* ── WBS columns (VB6 FTakeoff.frm:3259 LoadWBSDescriptions
                       + AppGridLayout combined) ──
                       VB6 renders ALL 40 slots; visibility is the OR of:
                         (a) AppGridLayout's Hidden flag (seed has WBS01 visible,
                             WBS02..40 hidden), AND
                         (b) LoadWBSDescriptions un-hides any slot with a non-
                             empty custom_description AND replaces its header
                             with the description.
                       So _wbsLabels (sourced from customdescriptions) drives
                       BOTH the visible-by-customdesc rule AND the caption.
                       Slots without a custom description fall through to
                       IsColVisible (which consults AppGridLayout). *@
                    @for (int w = 1; w <= 40; w++)
                    {
                        var wbsIdx = w;
                        var wbsField = $"WBS{wbsIdx:D2}";
                        var hasCustomDesc = _wbsLabels.TryGetValue(wbsIdx, out var customLabel);
                        // VB6 LoadWBSDescriptions: a non-empty custom_description
                        // is the sole signal to make the column visible.
                        // Otherwise consult AppGridLayout.
                        var visible = hasCustomDesc || IsColVisible(wbsField, defaultVisible: wbsIdx == 1);
                        var label = hasCustomDesc ? customLabel! : (wbsIdx == 1 ? "Bid Item" : wbsField);
                        <GridColumn HeaderText="@label"
                                    Field="@wbsField"
                                    Width="@ColWidth(wbsField, "100px")"
                                    AllowEditing="false"
                                    Visible="@visible">
                            <Template>
                                @{ var row = (TakeoffItemRow)context; }
                                @(row.WBS != null && row.WBS.TryGetValue(wbsIdx, out var wbsVal) ? wbsVal : "")
                            </Template>
                        </GridColumn>
                    }
                </GridColumnsBase>
            </GridControl>
        </div>

        @* Items-grid context menu (VB6 FMain.mnuAssemblyItems via FTakeoff's own handler). *@
        @if (_showItemsGridMenu)
        {
            <div style="position:fixed;inset:0;z-index:999;background:transparent;"
                 @onclick="@(() => _showItemsGridMenu = false)"
                 @oncontextmenu="@(() => _showItemsGridMenu = false)"
                 @oncontextmenu:preventDefault="true"></div>
            <div class="context-menu" style="left:@(_itemsGridMenuX)px;top:@(_itemsGridMenuY)px;z-index:1000;">
                <button @onclick="CopySelectedItems">Make a Copy</button>
                <button @onclick="SubstituteSelectedItemsAsync">Substitute Item...</button>
                <button @onclick="RemoveSelectedItems">Remove</button>
                <button @onclick="OnEditItemChartClick">Edit Item Chart...</button>
                <hr />
                <button @onclick="OnAttachmentsClick">Attachments...</button>
            </div>
        }

        @* ── Footer Bar ───────────────────────────────────── *@
        <div class="footer-bar">
            <label>Override JC Category</label>
            <DropDownListControl TValue="string" TItem="ComboItem"
                                 @bind-Value="OverrideCategory"
                                 DataSource="@OverrideCategoryOptions"
                                 TextFieldName="Text"
                                 ValueFieldName="Value"
                                 CssClass="override-jc-dropdown fx-dropdown-open-up"
                                 Width="200px" />

            <label style="margin-left: 16px;">Sale Qty</label>
            <NumericTextBoxControl TValue="double" @bind-Value="SaleQty" Width="70px" />

            <span style="flex: 1;"></span>

            @* VB6 parity (FTakeoff.frm: cmdOK / cmdCancel / cmdClose, Visible
               flags toggled in DataGridChanged + SaveData). Initially only
               Close shows. Once the lower grid has rows (Add Pass / Update /
               etc. set OkVisible=true), OK + Cancel show and Close hides.
               OK commits to the host and resets back to empty (modal stays
               open). Cancel discards the staged rows and resets (modal stays
               open). Close dismisses the modal entirely. *@
            @* VB6 cmdOK Caption "&OK" → Alt+O hotkey. HTML equivalent is
               accesskey="O" (browser combo: Alt+O in Chrome/Edge on Windows,
               Ctrl+Alt+O in Safari/Firefox on Mac). The <u>O</u> mirrors
               VB6's underline-the-accelerator visual cue. Kept as a raw
               <button> ONLY because ButtonControl has no accesskey passthrough
               and the Alt+O accelerator is load-bearing VB6 parity — adding the
               param is a FlexKit change (out of scope for this conversion). *@
            <button class="btn btn-primary" style="@(OkVisible ? "" : "display:none")" accesskey="O" @onclick="OnOkClick"><u>O</u>K</button>
            <ButtonControl CssClass="btn" Style="@(OkVisible ? "" : "display:none")" OnClick="OnCancelClick">Cancel</ButtonControl>
            <ButtonControl CssClass="btn" Style="@(OkVisible ? "display:none" : "")" OnClick="OnCloseClick">Close</ButtonControl>
        </div>
    </div>
</div>

@* FPickList rendered at component scope so the Find… menu item can open it.
   VB6 FTakeoff.frm:1225 calls FPickList.Choose with the current view's
   findQry — same lookup surface here. OnSelected lands the chosen ID in
   OnFindResult, which today just notifies; future work can carry the ID
   into AddItem. *@
<FPickList @ref="pickList" OnSelected="OnFindResult" />

@* In-app message box for Save / zero-qty / discard prompts. Matches the
   FAssembly / FItemChart pattern so all dialogs share the same chrome
   instead of falling back to the browser's confirm(). *@
<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />

@* HHM-547: "Edit Item Chart…" context-menu host. VB6 FItemChart was a
   modal-blocking editor; we render it inline with IsModal=true so the
   FTakeoff modal stays put. OnClose flips _showItemChartModal back off.
   Same host pattern as FAssembly. *@
@if (_showItemChartModal)
{
    <FItemChart IsModal="true" ChartName="@_editItemChartName" OnClose="OnItemChartModalClosed" />
}
@* HHM-547: "Attachments…" context-menu host. VB6 mnuAssemblyItemsSub(mcITEM_VIEWFILES)
   → EditAttachments for the selected item (FMain.frm:1610-1612; FAssembly.frm:4137-4141).
   FAttachments is a self-contained modal host — same pattern as FAssembly. *@
<FAttachments @ref="attachmentsDialog" />

@code {
    // ── Query Parameters (from FAssembly toolbar navigation) ─
    // Each parameter accepts BOTH a query-string value (when reached via the
    // /takeoff route) AND an explicit [Parameter] set from a host component
    // (when rendered inline as a modal child of FAssembly). The two intake
    // paths don't conflict — [SupplyParameterFromQuery] only fills the
    // property if the URL contained the named query var; otherwise the
    // [Parameter] value the parent passed wins.
    [Parameter, SupplyParameterFromQuery] public string? mode { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? isChangeOrder { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? assemblyType { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? description { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? community { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? communityPhase { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? model { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? optionID { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? assembly { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? returnUrl { get; set; }

    /// <summary>When true, FTakeoff renders inside a modal overlay so the
    /// host page stays visible behind it. Set by FAssembly when launching
    /// a takeoff so the user keeps the assembly editor visible underneath.
    /// Standalone /takeoff URL navigation leaves this false → full-page
    /// layout.</summary>
    [Parameter] public bool IsModal { get; set; }

    /// <summary>Fires when the modal should be dismissed (OK + save success,
    /// or Close/Cancel). Only used when <see cref="IsModal"/> is true — host
    /// listens and flips its visibility flag. In standalone mode FTakeoff
    /// falls back to NavigationManager.NavigateTo(returnUrl).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Fires after the user clicks OK and SaveData has filtered
    /// zero-qty rows. The host (e.g. FAssembly) receives the kept
    /// <see cref="TakeoffItemRow"/>s and is responsible for translating them
    /// into its own row model (AssemblyItemRow) and appending them to its
    /// items list with RowStatus="new" so the host's existing Save flow
    /// persists them.
    ///
    /// VB6 parity: FTakeoff.frm:1590 — `Call mParentForm.AddItem(...)` —
    /// VB6 invoked a method directly on the caller form per row. We emit a
    /// single batch via this callback instead, which matches Blazor's
    /// idiomatic "parent owns state, child raises events" pattern. Fires
    /// BEFORE <see cref="OnClose"/> so the host can stage rows and the
    /// caller's LoadDataAsync (if any) doesn't race the close.</summary>
    [Parameter] public EventCallback<List<TakeoffItemRow>> OnItemsCommitted { get; set; }

    /// <summary>HHM-236: name of a file the HOST already let the user pick
    /// before opening this modal. VB6's Custom takeoff pops the OS file-open
    /// dialog the instant the toolbar button is clicked (FTakeoff.frm:1706
    /// VBGetOpenFileName) and only then shows the import; the web mirrors
    /// that by putting the file picker ON the FAssembly toolbar (label-for
    /// over a hidden InputFile) and handing the picked file in through
    /// these two parameters so the Custom panel opens already imported.
    /// Empty/null → legacy behavior (panel shows its own pick control).</summary>
    [Parameter] public string? InitialCustomFileName { get; set; }

    /// <summary>Text content of <see cref="InitialCustomFileName"/> (.txt/.csv
    /// only — binary formats pass null and get the existing "not yet
    /// supported" status). Read by the host during its InputFile OnChange
    /// event because the IBrowserFile stream is only valid there.</summary>
    [Parameter] public string? InitialCustomFileContent { get; set; }

    // ── Database ──────────────────────────────────────────────
// ── State ─────────────────────────────────────────────────
    private bool IsLoading = false;
    private bool ShowOnScreenBar = false;
    private bool ShowHFVariables = false;
    private bool ShowTLVariables = false;
    private bool AddPassEnabled = false;
    private bool OkVisible = false;
    private string HelpText = "";
    private double SaleQty = 0;
    private string OverrideCategory = "";

    // ── Takeoff Parameters ────────────────────────────────────
    private string mSessionID = "";
    private string mTakeoffMode = "Assembly"; // Assembly, Item, Custom, OneTime
    private int mAssemblyType = 0;
    private string mAssemblyDescription = "";
    private string mCommunity = "";
    private string mCommunityPhase = "";
    private string mAssembly = "";
    private string mModel = "";
    private string mOptionID = "";
    private string mJob = "";
    private string mVendor = "";
    private bool mIsChangeOrder = false;
    private long mOnScreenBidID = 0;
    private string OnScreenProjectName = "";
    private int mViewIndex = 0;

    // ── Dynamic WBS columns (VB6 LoadWBSDescriptions parity) ──────────────
    // Maps WBS slot index (1..40) to the user-defined custom_description
    // pulled from the customdescriptions table. Only slots WITH a non-empty
    // description appear here — VB6 LoadWBSDescriptions both un-hides AND
    // re-labels these columns regardless of the AppGridLayout Hidden flag.
    // Loaded once per FTakeoff lifetime in OnInitializedAsync; cheap query,
    // small result set (typically ≤ 5 entries). SortedDictionary keeps the
    // columns in WBS01..WBS40 order regardless of how the DB returns them.
    private readonly SortedDictionary<int, string> _wbsLabels = new();

    // ── Items-grid layout (VB6 AppGridLayout 'FTakeoff.gItems' parity) ───
    // The 39 static + 40 WBS column DESIGN set is excessive to show at
    // once; VB6 reads AppGridLayout to learn which columns are visible
    // (Hidden=0) and which are hidden (Hidden=1). Seed default
    // (MDBUpgrade3.bas:3133-) leaves only 9 visible: Phase, Item,
    // Description, TakeoffQty, OrderQty, JCCostCode, JCCategory, POIndex,
    // WBS01. Per-user customizations live in the same table keyed by uid.
    //
    // We load with key ("FTakeoff", "gItems", 0) through the standard
    // GridLayoutService which already falls back from the user's row to
    // the default uid='' row when there's no per-user customization.
    // ── Grid layout via the shared GridLayoutPresenter (standard AppGridLayout
    //    path — same load + uid→uid=''→char(1)→defaults fallback + processing
    //    as every other migrated grid). VB6: IniGetGrid(Me, gItems). The layout
    //    is keyed by raw colkey (== TakeoffItemRow property name for the fields
    //    read by IsColVisible/ColCaption and the WBS loop). Column ORDER stays
    //    fixed in markup here — unlike the persistent views, gItems is a
    //    TRANSIENT staging grid (ColumnReorder off) and must emit EVERY column
    //    so the header column-chooser can re-show hidden ones; the WBS slots
    //    also need custom-description caption/visibility (VB6 LoadWBSDescriptions)
    //    that the standard GetOrdered() can't express. So the presenter drives
    //    the DATA (load/fallback/caption/visibility) and the markup consumes it
    //    via IsColVisible/ColCaption below.
    private readonly GridLayoutPresenter<TakeoffItemRow> _itemsGrid = new("FTakeoff", "gItems");
    private Dictionary<string, GridLayoutColumn> _itemsGridLayout => _itemsGrid.Layout;

    /// <summary>Per-field visibility lookup driven by AppGridLayout. If the
    /// field appears in the layout, its <c>Hidden</c> flag wins; otherwise
    /// the hardcoded <paramref name="defaultVisible"/> stands in. Callers
    /// pass <c>true</c> for fields that VB6 ships visible-by-default and
    /// <c>false</c> for the hidden helpers (RawFormula, ResolvedFormula,
    /// the Pass* shadows, etc.). Keeps the markup tidy and lets a user
    /// who customizes their layout flip any column without code changes.</summary>
    private bool IsColVisible(string field, bool defaultVisible)
    {
        if (_itemsGridLayout.TryGetValue(field, out var col))
            return !col.Hidden;
        return defaultVisible;
    }

    /// <summary>Per-field HEADER caption driven by AppGridLayout (FTakeoff.gItems) —
    /// the same source VB6 uses (DBGetGrid), so headers read "Comments"/"POIndex"/
    /// "Conversion Factor" exactly like legacy instead of the hardcoded
    /// "Notes"/"PO Index"/"Conv Factor" that had drifted from the DB. The layout's
    /// caption wins when present; otherwise the VB6 fallback stands in.</summary>
    private string ColCaption(string field, string defaultCaption)
    {
        if (_itemsGridLayout.TryGetValue(field, out var col)
            && !string.IsNullOrWhiteSpace(col.Caption))
            return col.Caption;
        return defaultCaption;
    }

    /// <summary>Per-field WIDTH driven by AppGridLayout (HHM-210). VB6 DBGetGrid
    /// applies <c>.ColWidth(Col) = rs("width")</c> (twips) for every layout row,
    /// so legacy column proportions come from the saved layout — the migrated
    /// grid had hardcoded pixel widths instead, which made the rendered columns
    /// visibly different from the legacy ones. Twips convert via the canonical
    /// <see cref="GridLayoutPresenter.WidthPx"/> (/15 + 16px padding, clamped);
    /// fields absent from the layout keep their markup default.</summary>
    private string ColWidth(string field, string defaultWidth)
    {
        if (_itemsGridLayout.TryGetValue(field, out var col)
            && col.Width is > 0)
            return $"{GridLayoutPresenter.WidthPx(col.Width.Value)}px";
        return defaultWidth;
    }

    /// <summary>Choose Columns schema (HHM-613.2/3). VB6 FColumns lists only the
    /// CAPTIONED AppGridLayout columns (the presenter filters those), and
    /// LoadWBSDescriptions additionally surfaces — and re-labels — every WBS slot
    /// with a custom description, exactly like the markup's WBS loop. Without this
    /// schema the dialog fell back to every GridColumn child (raw colkeys legacy
    /// never shows).</summary>
    private IEnumerable<ChooseColumnDescriptor>? GetTakeoffChooseColumnsSchema()
    {
        var schema = _itemsGrid.GetChooseColumnsSchema();
        if (schema == null) return null;

        var list = new List<ChooseColumnDescriptor>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var c in schema)
        {
            if (TryGetWbsSlot(c.Field, out var slot) && _wbsLabels.TryGetValue(slot, out var label))
                list.Add(new ChooseColumnDescriptor { Field = c.Field, Header = label, Visible = true });
            else
                list.Add(c);
            seen.Add(c.Field);
        }
        foreach (var (slot, label) in _wbsLabels)
        {
            var field = $"WBS{slot:D2}";
            if (!seen.Contains(field))
                list.Add(new ChooseColumnDescriptor { Field = field, Header = label, Visible = true });
        }
        return list;
    }

    private static bool TryGetWbsSlot(string field, out int slot)
    {
        slot = 0;
        return field is { Length: 5 }
            && field.StartsWith("WBS", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(field.AsSpan(3), out slot);
    }

    /// <summary>Applies Choose Columns picks into the AppGridLayout dictionary so
    /// IsColVisible flips the real GridColumn Visible parameter (HHM-613.2) —
    /// that is also what lets arrow-key navigation reach a newly inserted column,
    /// because the grid's keyboard targets read column.Visible. Column ORDER stays
    /// fixed: this is a transient staging grid (ColumnReorder off), same as VB6.</summary>
    private Task OnTakeoffColumnsChosenAsync(ChooseColumnsResult result)
    {
        if (result?.Columns == null) return Task.CompletedTask;

        foreach (var picked in result.Columns)
        {
            if (_itemsGridLayout.TryGetValue(picked.Field, out var layout))
                layout.Hidden = !picked.Visible;
            else
                _itemsGridLayout[picked.Field] = new GridLayoutColumn { Field = picked.Field, Hidden = !picked.Visible };
        }

        _itemsGrid.BumpVersion();
        StateHasChanged();
        return Task.CompletedTask;
    }

    // ── List-panel right-click menu (VB6 FTakeoff: gList_MouseDown → mnuTakeoff) ──
    // Right-clicking the assembly list pops a menu that switches the current
    // Views[] entry. Tracks visibility + cursor position; handlers below.
    private bool _showListContextMenu;
    private double _listContextMenuX;
    private double _listContextMenuY;

    // ── Grid Refs ─────────────────────────────────────────────
    private GridControl<TakeoffItemRow>? ItemsGrid;
    private GridControl<HFVariableRow>? HFVariablesGrid;
    private GridControl<TLVariableRow>? TLVariablesGrid;

    // GridControl OnCellSave wiring — without this, inline edits to
    // TakeoffQty / OrderQty in the lower grid never reach ItemsData,
    // so SaveData reads OrderQty=0 even though the user typed 20. The
    // handler also mirrors VB6 gItems_AfterEdit: TakeoffQty edit →
    // recalc OrderQty; OrderQty edit → back-solve TakeoffQty.
    private GridControlEvents<TakeoffItemRow> itemsGridEvents = new();

    // In-app message box (replaces JS confirm() for the zero-qty prompt
    // in SaveData and any future prompts). Same FlexKit control as
    // FAssembly / FItemChart so all dialogs share one look-and-feel.
    private Fx.ControlKit.Dialogs.MessageBoxControl? _messageBox;

    // Variables-grid events (HHM-232 validation) + pre-edit snapshot for revert.
    private GridControlEvents<HFVariableRow> hfVariablesEvents = new();
    private string _hfVarPrevValue = "";

    private async Task OnHFVariableCellSave(CellSaveArgs<HFVariableRow> args)
    {
        if (!string.Equals(args.ColumnName, nameof(HFVariableRow.Value), StringComparison.OrdinalIgnoreCase))
            return;
        var row = args.Data;
        if (row == null) return;
        // Rows driven by a ListOfValues translate numeric picks elsewhere — VB6
        // only range-checks plain numeric variables.
        if (!string.IsNullOrEmpty(row.ListOfValues)) return;

        var text = (row.Value ?? "").Trim();
        if (!double.TryParse(text, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var val))
        {
            row.Value = _hfVarPrevValue;   // VB6: Cancel = True (silent reject)
            StateHasChanged();
            return;
        }
        if (row.Max > 0 && val > row.Max)
        {
            row.Value = _hfVarPrevValue;
            StateHasChanged();
            if (_messageBox != null)
                await _messageBox.ShowAsync(
                    $"The maximum value for {row.Name} is '{row.Max:0}'. The number you have entered is too large.",
                    title: "Precision Builder", buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.Ok, icon: "info");
            return;
        }
        if (val < row.Min)
        {
            row.Value = _hfVarPrevValue;
            StateHasChanged();
            if (_messageBox != null)
                await _messageBox.ShowAsync(
                    $"The minimum value for {row.Name} is '{row.Min:0}'. The number you have entered is too small.",
                    title: "Precision Builder", buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.Ok, icon: "info");
            return;
        }
        // VB6 `.EditText = Val(.EditText)` — normalize the accepted value.
        row.Value = val.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    // VB6 MFormulas.LoadVariables (bas:98): the "Quantity" row comes from the
    // `variables` TABLE — Value=DefaultValue, UOM/Min/Max from the record; a
    // missing record leaves UOM empty with ±1e18 bounds. The old hardcoded
    // UOM="each" showed a unit label legacy never displays (HHM-232).
    private async Task<HFVariableRow> BuildQuantityVariableAsync()
    {
        var qty = new HFVariableRow
        {
            Name = "Quantity", Value = "1.000", UOM = "",
            Min = -1e18, Max = 1e18, DisplayOrder = -1
        };
        try
        {
            var rows = await db.QueryAsync("SELECT * FROM variables WHERE name = @Name", new { Name = "Quantity" });
            var rec = rows.FirstOrDefault();
            if (rec != null)
            {
                var lov = (rec["listofvalues"]?.ToString() ?? "").Trim();
                if (lov.Length == 0)
                {
                    var def = ToDouble(rec["defaultvalue"]);
                    qty.Value = def.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    qty.UOM = rec["uom"]?.ToString() ?? "";
                    qty.Min = ToDouble(rec["minimumvalue"]);
                    qty.Max = ToDouble(rec["maximumvalue"]);
                }
                else
                {
                    qty.ListOfValues = " |" + lov;
                }
                qty.Help = rec["help"]?.ToString() ?? "";
            }
        }
        catch { /* variables table missing/unreadable — keep defaults */ }
        return qty;
    }

    // ── Mass-edit target column (FAssembly multi-select fan-out parity) ─
    //
    // When the user types a number with multiple rows selected,
