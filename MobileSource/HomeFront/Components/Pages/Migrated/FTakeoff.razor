    private List<TakeoffItemRow> SelectedItemsOrCurrent()
    {
        var sel = ItemsGrid?.GetSelectedRecords()?.ToList() ?? new List<TakeoffItemRow>();
        if (sel.Count == 0 && ItemsData.Count > 0) sel.Add(ItemsData[0]);
        return sel;
    }

    // VB6 mcITEM_COPY (frm:2786-2793): duplicate each selected row directly below the selection.
    private void CopySelectedItems()
    {
        _showItemsGridMenu = false;
        var sel = SelectedItemsOrCurrent();
        if (sel.Count == 0) return;
        int insertAt = sel.Max(r => ItemsData.IndexOf(r)) + 1;
        foreach (var r in sel)
        {
            var copy = new TakeoffItemRow();
            foreach (var p in typeof(TakeoffItemRow).GetProperties().Where(p => p.CanRead && p.CanWrite))
                p.SetValue(copy, p.GetValue(r));
            copy.WBS = new Dictionary<int, string>(r.WBS);
            ItemsData.Insert(insertAt++, copy);
        }
        StateHasChanged();
    }

    // VB6 mcITEM_REMOVE → the Ctrl+Del path: drop the selected rows from the staging grid.
    private void RemoveSelectedItems()
    {
        _showItemsGridMenu = false;
        foreach (var r in SelectedItemsOrCurrent())
            ItemsData.Remove(r);
        StateHasChanged();
    }

    // VB6 mcITEM_SUBSTITUE (frm:2795-2833): pick a tblPhaseItem row (cost-code/category
    // descriptions resolved), then overwrite the selected rows — handled in OnFindResult.
    private async Task SubstituteSelectedItemsAsync()
    {
        _showItemsGridMenu = false;
        if (pickList == null) return;
        _itemsGridMenuSelection = SelectedItemsOrCurrent();
        if (_itemsGridMenuSelection.Count == 0) return;
        _takeoffPickContext = "SubstituteItem";
        var sql = $@"
SELECT i.Phase, i.Item, i.Description, i.TakeoffUOM, i.ConversionFactor, i.OrderUOM,
       i.POIndex, i.Notes, i.JCCostCode CostCode, cod.description CostCodeDesc,
       i.JCCategory Category, cat.Description CategoryDesc
  FROM tblPhaseItem i
LEFT OUTER JOIN StandardCostCodes cod ON(i.DivisionID = cod.DivisionID and i.jccostcode=cod.costcode)
LEFT OUTER JOIN StandardCategories cat ON(i.DivisionID = cat.DivisionID and i.jccategory=cat.category)
 WHERE i.DivisionID = {SessionState.DivisionID}";
        await pickList.Open(
            title: "Item",
            queries: sql,
            hideColumns: "TakeoffUOM,ConversionFactor,OrderUOM,POIndex,Notes,CostCode,CostCodeDesc,Category,CategoryDesc",
            multiSelect: false);
    }

