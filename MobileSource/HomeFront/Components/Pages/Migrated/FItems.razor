    private async Task OnGridCellSave(CellSaveArgs<ItemRow> args)
    {
        if (args.Data == null) return;
        await ApplyItemsGridCellSaveAsync(args.Data, args.ColumnName);

        if (gItems != null)
            await gItems.Refresh();
    }

    private async Task ApplyItemsGridCellSaveAsync(ItemRow item, string columnName)
    {
        // ── VB6 gItems_ValidateEdit value-sanitizing + AltJC lookup (FItems.frm:720-771) ──
        switch (columnName)
        {
            // FItems.frm:737 — ConversionFactor <= 0 → 1
            case "ConversionFactor":
                if (item.ConversionFactor <= 0) item.ConversionFactor = 1;
                break;
            // FItems.frm:738 — WastePercent = Abs(); >= 100 → 99
            case "WastePercent":
                item.WastePercent = Math.Abs(item.WastePercent);
                if (item.WastePercent >= 100) item.WastePercent = 99;
                break;
            // FItems.frm:739 — RoundTo = Abs()
            case "RoundTo":
                item.RoundTo = Math.Abs(item.RoundTo);
                break;
            // FItems.frm:755-757 — Price < 0 → 0 (price-group fan-out already handled at save)
            case "Price":
                if (item.Price < 0) item.Price = 0;
                break;
            // FItems.frm:734 — AltJCCostCode lookup against StandardCostCodes; sets desc, else clears
            case "AltJCCostCode":
                await ValidateAltJcCostCodeAsync(item);
                break;
            // FItems.frm:735 — AltJCCategory lookup against StandardCategories; sets desc, else clears
            case "AltJCCategory":
                await ValidateAltJcCategoryAsync(item);
                break;
        }

        item.RowState = "DIRTY";
        mDirty = true;
    }

    private async Task OnItemsTypeAheadCommit(TypeAheadCommitArgs<ItemRow> args)
    {
        if (string.IsNullOrWhiteSpace(args.ColumnName))
            return;

        var applied = false;
        foreach (var item in args.SelectedItems.Where(i => i != null).Distinct())
        {
            if (!TryApplyItemsGridCellValue(item, args.ColumnName, args.Value))
                continue;

            await ApplyItemsGridCellSaveAsync(item, args.ColumnName);
            applied = true;
        }

        if (!applied)
            return;

        if (gItems != null)
            await gItems.Refresh();
        StateHasChanged();
    }

    private static bool TryApplyItemsGridCellValue(ItemRow item, string field, string value)
    {
        var prop = typeof(ItemRow).GetProperty(
            field,
            System.Reflection.BindingFlags.Public
            | System.Reflection.BindingFlags.Instance
            | System.Reflection.BindingFlags.IgnoreCase);
        if (prop == null || !prop.CanWrite)
            return false;

        var targetType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
        object converted;
        try
        {
            if (targetType == typeof(string))
                converted = value;
            else if (targetType == typeof(decimal))
                converted = ParseDecimal(value, 0m);
            else if (targetType == typeof(int))
                converted = ParseInt(value, 0);
            else if (targetType == typeof(bool))
                converted = ParseBool(value);
            else
                converted = Convert.ChangeType(value, targetType, System.Globalization.CultureInfo.CurrentCulture);
        }
        catch
        {
            return false;
        }

        prop.SetValue(item, converted);
        return true;
    }

    // VB6 ValidateField for AltJCCostCode (FItems.frm:734): look up the typed code in
    // StandardCostCodes; on hit populate the desc, on miss clear the code (not-found cancel).
    private async Task ValidateAltJcCostCodeAsync(ItemRow item)
    {
        if (string.IsNullOrWhiteSpace(item.AltJCCostCode))
        {
            item.AltJCCostCodeDesc = "";
            return;
        }
        var div = SessionState.DivisionID;
        var rows = await db.QueryAsync(
            $"SELECT Description FROM StandardCostCodes WHERE DivisionID IN (0, {div}) AND CostCode = @Code",
            new { Code = item.AltJCCostCode });
        if (rows.Count > 0)
            item.AltJCCostCodeDesc = rows[0]["Description"]?.ToString() ?? "";
        else
        {
            item.AltJCCostCode = "";
            item.AltJCCostCodeDesc = "";
        }
    }

    // VB6 ValidateField for AltJCCategory (FItems.frm:735): look up the typed category in
    // StandardCategories; on hit populate the desc, on miss clear the category.
    private async Task ValidateAltJcCategoryAsync(ItemRow item)
    {
        if (string.IsNullOrWhiteSpace(item.AltJCCategory))
