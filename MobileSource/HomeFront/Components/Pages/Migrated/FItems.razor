    private async Task OnTextDialogOk()
    {
        if (EditingTextRow != null)
        {
            var targets = ResolveCurrentTextDialogTargets(EditingTextRow);
            foreach (var target in targets)
                ApplyTextDialogValue(target, EditingTextColumn, EditingText);

            if (targets.Count > 0)
                mDirty = true;
