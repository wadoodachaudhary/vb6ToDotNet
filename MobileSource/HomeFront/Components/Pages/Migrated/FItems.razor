    private static void ApplyLookupPickListValue(ItemRow item, IDictionary<string, object> row, string context)
    {
        switch (context)
        {
            case "POIndex":
                item.POIndex = PickValue(row, "POIndex");
                item.POIndexDescription = PickValue(row, "Description");
                break;
            case "JCCostCode":
                item.JCCostCode = PickValue(row, "CostCode");
                item.JCCostCodeDesc = PickValue(row, "Description");
                break;
            case "JCCategory":
                item.JCCategory = PickValue(row, "Category");
                item.JCCategoryDesc = PickValue(row, "Description");
                break;
            case "AltJCCostCode":
                item.AltJCCostCode = PickValue(row, "CostCode");
                item.AltJCCostCodeDesc = PickValue(row, "Description");
                break;
            case "AltJCCategory":
                item.AltJCCategory = PickValue(row, "Category");
                item.AltJCCategoryDesc = PickValue(row, "Description");
                break;
            case "OptionCategory":
                item.OptionCategory = PickValue(row, "Category");
                break;
            case "OrderUOM":
                item.OrderUOM = PickValue(row, "Unit");
                break;
            case "TakeoffUOM":
                item.TakeoffUOM = PickValue(row, "Unit");
                break;
            case "TaxGroup":
                item.TaxGroup = PickValue(row, "TaxGroup");
                break;
        }

        item.RowState = "DIRTY";
        // Caller sets the form dirty flag once the target list has been applied.
    }

