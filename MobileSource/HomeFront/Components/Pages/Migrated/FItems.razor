    };

    private async Task OnPickLookupField(ItemRow row, string field)
    {
        if (pickList == null) return;
        _pickListEditRow = row;
        _pickListEditField = field;
        _pickListEditTargets = ResolveItemsGridEditTargets(row, field);
        var div = SessionState.DivisionID;
        switch (field)
        {
            case "POIndex":
                _pickListContext = "POIndex";
                await pickList.Open("Purchase Order",   // VB6 title "Purchase Order" (FItems.frm:652) — HHM-183
                    $"SELECT POIndex, Description FROM tblPOIndex WHERE DivisionID = {div} ORDER BY POIndex",
                    defaultItem: row.POIndex);
                break;
            case "JCCostCode":
                _pickListContext = "JCCostCode";
                await pickList.Open("Cost Code",
                    $"SELECT CostCode, Description FROM StandardCostCodes WHERE DivisionID IN (0, {div}) ORDER BY CostCode",
                    defaultItem: row.JCCostCode);
                break;
            case "JCCategory":
                _pickListContext = "JCCategory";
                await pickList.Open("Category",
                    $"SELECT Category, Description FROM StandardCategories WHERE DivisionID IN (0, {div}) ORDER BY Category",
                    defaultItem: row.JCCategory);
                break;
            // VB6 FItems.frm:557-562 — AltJCCostCode → StandardCostCodes
            case "AltJCCostCode":
                _pickListContext = "AltJCCostCode";
                await pickList.Open("Cost Code",
                    $"SELECT CostCode, Description FROM StandardCostCodes WHERE DivisionID IN (0, {div}) ORDER BY CostCode",
                    defaultItem: row.AltJCCostCode);
                break;
            // VB6 FItems.frm:571-576 — AltJCCategory → StandardCategories
            case "AltJCCategory":
                _pickListContext = "AltJCCategory";
                await pickList.Open("Category",
                    $"SELECT Category, Description FROM StandardCategories WHERE DivisionID IN (0, {div}) ORDER BY Category",
                    defaultItem: row.AltJCCategory);
                break;
            // VB6 FItems.frm:585-589 — OptionCategory → tblCategories (NO DivisionID filter)
            case "OptionCategory":
                _pickListContext = "OptionCategory";
                await pickList.Open("Category",
                    "SELECT Category, Description FROM tblCategories ORDER BY Category",
                    defaultItem: row.OptionCategory);
                break;
            // VB6 FItems.frm:621-625 — OrderUOM → DISTINCT OrderUOM
            case "OrderUOM":
                _pickListContext = "OrderUOM";
                await pickList.Open("Units",
                    $"SELECT DISTINCT OrderUOM AS Unit FROM tblPhaseItem WHERE DivisionID = {div} AND OrderUOM IS NOT NULL AND OrderUOM <> '' ORDER BY Unit",
                    defaultItem: row.OrderUOM);
                break;
            // VB6 FItems.frm:627-631 — TakeoffUOM → DISTINCT TakeoffUOM
            case "TakeoffUOM":
                _pickListContext = "TakeoffUOM";
                await pickList.Open("Units",
                    $"SELECT DISTINCT TakeoffUOM AS Unit FROM tblPhaseItem WHERE DivisionID = {div} AND TakeoffUOM IS NOT NULL AND TakeoffUOM <> '' ORDER BY Unit",
                    defaultItem: row.TakeoffUOM);
                break;
            case "TaxGroup":
                _pickListContext = "TaxGroup";
                await pickList.Open("Tax Group",
                    $"SELECT TaxGroup, Description FROM TaxGroups WHERE DivisionID IN (0, {div}) ORDER BY TaxGroup",
                    defaultItem: row.TaxGroup,
                    autoSelectFirstRowWhenNoDefault: true);
                break;
            // ── Description columns (VB6 *Desc CellButtonClick cases, FItems.frm:565-620):
            // the SAME picker with the DESCRIPTION column first; the pick fills BOTH the
            // code and the desc via the shared contexts above (HHM-187 PO Index Description,
            // HHM-202 Cost Code Description). ──
            case "POIndexDescription":
                _pickListContext = "POIndex";
                await pickList.Open("Purchase Order",   // VB6 title "Purchase Order" (FItems.frm:652) — HHM-183
                    $"SELECT Description, POIndex FROM tblPOIndex WHERE DivisionID = {div} ORDER BY Description",
                    defaultItem: row.POIndexDescription);
                break;
            case "JCCostCodeDesc":
                _pickListContext = "JCCostCode";
                await pickList.Open("Cost Code",
                    $"SELECT Description, CostCode FROM StandardCostCodes WHERE DivisionID IN (0, {div}) ORDER BY Description",
                    defaultItem: row.JCCostCodeDesc);
                break;
            case "JCCategoryDesc":
                _pickListContext = "JCCategory";
                await pickList.Open("Category",
                    $"SELECT Description, Category FROM StandardCategories WHERE DivisionID IN (0, {div}) ORDER BY Description",
                    defaultItem: row.JCCategoryDesc);
                break;
            case "AltJCCostCodeDesc":
                _pickListContext = "AltJCCostCode";
                await pickList.Open("Cost Code",
                    $"SELECT Description, CostCode FROM StandardCostCodes WHERE DivisionID IN (0, {div}) ORDER BY Description",
                    defaultItem: row.AltJCCostCodeDesc);
                break;
            case "AltJCCategoryDesc":
                _pickListContext = "AltJCCategory";
                await pickList.Open("Category",
                    $"SELECT Description, Category FROM StandardCategories WHERE DivisionID IN (0, {div}) ORDER BY Description",
                    defaultItem: row.AltJCCategoryDesc);
                break;
        }
