@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - Header click sorts (was opening filter)
     - Initial port from VB6
   ───────────────────────────────────────────────────────────────── *@
@namespace HomeFront.Components.Pages
@page "/items-db"

@using HomeFront.Models
@using System.Data
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@using Fx.ControlKit
@using Fx.ControlKit.Notifications
@using Fx.ControlKit.Grid
@using Microsoft.AspNetCore.Components.Web
@inject ILogger<FItems> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@using HomeFront.Data
@inject DbWrapperSqlServer db
@layout HFComponent
<PageTitle>Item Database - HomeFront</PageTitle>


@* HHM-49: legacy shows no "Loading…" text — the overlay flashed briefly on view switches, so it's
   removed to match legacy (the grid simply repaints with the new view's rows). *@

    <div class="tab-content">
            <div class="vb6-banner">
                This is not your live database. It should be used for testing and training only. If this is incorrect please contact Hyphen support to change the status of this database.
            </div>
            @* ── Toolbar ──────────────────────────────────────────── *@
            <div class="toolbar-cntr fitems-toolbar">
                @* HHM-39: legacy keeps Save enabled by default (VB6 FItems has no Save-disable logic);
                   SaveDataAsync() no-ops when nothing is dirty, so an always-enabled Save is safe. *@
                <ToolbarButtonControl CssClass="fitems-tbar-btn"
                                      Vertical="true"
                                      OnClick="OnSaveClick"
                                      IconSrc="images/32/save.ico"
                                      IconAlt="Save"
                                      Title="Save"
                                      Label="Save" />

                <MenuDropDownControl Label="View"
                                     CssClass="fitems-view-menu"
                                     SplitButton="true"
                                     SplitCssClass="fitems-view-split"
                                     PrimaryCssClass="fitems-view-primary"
                                     TriggerCssClass="fitems-view-arrow"
                                     PanelCssClass="fitems-view-menu-panel">
                    <PrimaryContent>
                        <img class="tbar-icon" src="images/32/ViewVilter2.ico" alt="View" />
                        <span class="tool-label">View</span>
                    </PrimaryContent>
                    <ChildContent>
                        @foreach (var viewItem in _viewDropdownItems)
                        {
                            var viewValue = viewItem.Value;
                            var selected = viewValue == CurrentViewIndex.ToString();
                            <MenuActionControl Text="@viewItem.Text"
                                               Icon="@(selected ? "✓" : "")"
                                               CssClass="@(selected ? "is-selected" : "")"
                                               OnClick="@(() => OnViewMenuItemClicked(viewValue))" />
                        }
                    </ChildContent>
                </MenuDropDownControl>

                <span class="tbar-separator"></span>

                @* FlexKit FilePickerControl: a transparent file input overlays the visual
                   ToolbarButtonControl, so clicking "Import Items" opens the OS file dialog
                   directly — no JS, and no leaking native "Choose File" chrome (the control
                   styles the input inline, bypassing the CSS-isolation trap that exposed it). *@
                <FilePickerControl CssClass="fitems-import-pick" Accept=".xls,.xlsx" OnChange="OnImportFileSelected" Title="Import Items" ShowTooltip="false">
                    @* HHM-50: VB6's "Import Items" (ExcelImport) toolbar button has NO ToolTipText
                       (FItems.frm:168-171 — "Import Estimating Item DB" belongs to the separate
                       legacy "Import DB" button, which this toolbar doesn't have). *@
                    <ToolbarButtonControl CssClass="fitems-tbar-btn"
                                          Vertical="true"
                                          IconSrc="images/32/excelimport.ico"
                                          IconAlt="Import Items"
                                          ShowTooltip="false"
                                          Label="Import Items" />
                </FilePickerControl>
                <ToolbarButtonControl CssClass="fitems-tbar-btn"
                                      Vertical="true"
                                      OnClick="OnExcelExport"
                                      IconSrc="images/32/excelexport.ico"
                                      IconAlt="Export Items"
                                      Title="Export items to Excel"
                                      Label="Export Items" />
            </div>

            <h3 class="page-title">Item Database - @CurrentViewName</h3>

            <SplitterControl CssClass="fitems-splitter"
                             Height="auto"
                             Width="100%"
                             Style="flex:1 1 auto;min-width:0;min-height:0;"
                             SplitterSize="6"
                             MinPrimarySize="96"
                             MaxPrimarySize="900"
                             Title="Resize tree and items grid"
                             @bind-PrimarySize="_treePaneWidth">
                <PrimaryContent>
                @* ── Left Panel: Phases Tree ──────────────────────── *@
                <div class="phases-panel"
                     @oncontextmenu="OnTreeContextMenu"
                     @oncontextmenu:preventDefault="true">
                    <div class="phases-tree-host">
                        <TreeGridControl @ref="gPhases"
                                    TValue="ItemsTreeNode"
                                    DataSource="@TreeNodes"
                                    IdMapping="NodeID"
                                    ParentIdMapping="ParentID"
                                    TreeColumnIndex="0"
                                    EnableCollapseAll="true"
                                    AllowSelection="true"
                                    ToggleOnRowClick="false"
                                    Height="100%"
                                    CssClass="fx-treegrid-compact fx-treegrid-yellow-folder fx-treegrid-dotted-lines"
                                    RowCssClassSelector="@GetTreeRowCssClass"
                                    NodeExpandIconStyle="GroupExpandIconStyle.PlusMinus"
                                    GetNodeIcon="GetTreeIcon"
                                    TreatAsParent="ShouldTreatTreeNodeAsParent"
                                    RowDoubleClicked="OnTreeNodeDoubleClicked"
                                    RowActivated="OnTreeNodeActivated"
                                    RowRightClicked="OnTreeNodeRightClicked"
                                    Collapsed="OnNodeCollapsed"
                                    Expanded="OnNodeExpanded">
                            <TreeGridColumn Field="NodeID" HeaderText="" Width="20px" Visible="false" />
                            @* HHM-88 REVERTED (owner regression report 2026-07-29): a page-side cell
                               Template on this column replaced the TreeGridControl's own caption
                               rendering and blanked every tree label (nodes showed only "…"). The
                               tree is rendered by the LIBRARY — do not template this column.
                               Standing rule: the Edit Item Database tree + grids are HANDS-OFF;
                               any change must be deliberate and owner-approved. *@
                            <TreeGridColumn Field="Node"
                                            HeaderText="@CurrentViewName"
                                            Width="300px"
                                            HeaderToolbarItems="@TreeHeaderToolbarItems" />
                        </TreeGridControl>
                    </div>
                </div>
                </PrimaryContent>

                <SecondaryContent>
                @* ── Right Panel: Items Grid ──────────────────────── *@
                <div class="items-panel">
                  <div class="items-grid-host" @oncontextmenu="OnItemsContextMenu" @oncontextmenu:preventDefault="true" @onkeydown="OnItemsGridKeyDown">
                    <GridControl @ref="gItems"
                            TValue="ItemRow"
                            Title="@ItemsGridExportTitle"
                            DataSource="@ItemsData"
                            AllowSorting="true"
                            AllowFiltering="true"
                            AllowResizing="true"
                            AllowSelection="true"
                            AllowGrouping="false"
                            AllowColumnReorder="true"
                            EnableHover="true"
                            Height="100%"
                            GridLines="GridLines.None"
                            FilterSettingsRef="@filterSettings"
                            PageSettingsRef="@pageSettings"
                            SelectionSettingsRef="@selectionSettings"
                            EditSettingsRef="@editSettings"
                            BatchEditBehavior="GridBatchEditBehavior.SingleCell"
                            AllowSingleCellColumnMassEdit="true"
                            TypeAheadTargetField="@ItemsTypeAheadTargetField"
                            CssClass="fitems-items-grid"
                            AvailableColumns="@GetItemsGridChooseColumnsSchema()"
                            DefaultColumns="@GetItemsGridDefaultColumnsSchema()"
                            OnColumnsChosen="@OnItemsColumnsChosenAsync"
                            OnLayoutChanged="@OnItemsLayoutChangedAsync"
                            EventsRef="@gridEvents">
                        <GridColumnsBase @key="ItemsGridLayoutVersion" DebugTag="FItems-gItems">
                            @foreach (var entry in GetOrderedItemsGridLayout())
                            {
                                var layout = entry.Layout;
                                var fieldName = entry.Field;
                                var columnType = entry.ColumnType;
                                var textAlign = entry.TextAlign;
                                var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                                var width = layout.Width.HasValue && layout.Width.Value > 0
                                    ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                                    : null;
                                var allowEdit = IsEditableField(fieldName, layout);
                                var editOptions = GetGridEditOptions(fieldName);
                                var selectAllOnEdit = allowEdit && columnType == ColumnType.Number;
                                var initialVisible = !layout.Hidden;

                                @* ── Long-text fields: display + popup-button ─── *@
                                if (_popupTextFields.Contains(fieldName))
                                {
                                    <GridColumn Field="@fieldName"
                                                HeaderText="@headerText"
                                                Width="@width"
                                                AllowEditing="false"
                                                AllowCellDragSelection="@IsMultiTextPopupField(fieldName)"
                                                ShowEditButton="true"
                                                Visible="@initialVisible">
                                        <Template>
                                            @{ var data = (ItemRow)context; }
                                            <div class="poindex-cell"
                                                 @ondblclick="() => OnEditPopupField(data, fieldName)"
                                                 @ondblclick:stopPropagation="true">
                                                <span class="poindex-text" title="@GetPopupFieldValue(data, fieldName)">@GetPopupFieldValue(data, fieldName)</span>
                                                <button class="poindex-btn fx-grid-popup-btn"
                                                        @onclick="() => OnEditPopupField(data, fieldName)"
                                                        @onclick:stopPropagation="true">…</button>
                                            </div>
                                        </Template>
                                    </GridColumn>
                                }
                                @* ── Lookup fields with … button: POIndex, JCCostCode, JCCategory, TaxGroup ─── *@
                                else if (_lookupPickerFields.Contains(fieldName))
                                {
                                    <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="@allowEdit" AllowCellDragSelection="true" ShowEditButton="true" Visible="@initialVisible">
                                        <Template>
                                            @{ var data = (ItemRow)context; }
                                            <div class="poindex-cell"
                                                 @ondblclick="() => OnPickLookupField(data, fieldName)"
                                                 @ondblclick:stopPropagation="true">
                                                <span class="poindex-text">@GetLookupDisplayValue(data, fieldName)</span>
                                                <button class="poindex-btn fx-grid-popup-btn"
                                                        @onclick="() => OnPickLookupField(data, fieldName)"
                                                        @onclick:stopPropagation="true">…</button>
                                            </div>
                                        </Template>
                                    </GridColumn>
                                }
                                @* ── InverseItemDesc: display + … picker ─── *@
                                else if (fieldName.Equals("InverseItemDesc", StringComparison.OrdinalIgnoreCase))
                                {
                                    <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="false" ShowEditButton="true" Visible="@initialVisible">
                                        <Template>
                                            @{ var data = (ItemRow)context; }
                                            <div class="poindex-cell"
                                                 @ondblclick="() => OnSelectInverseItem(data)"
                                                 @ondblclick:stopPropagation="true">
                                                <span class="poindex-text">@data.InverseItemDesc</span>
                                                <button class="poindex-btn fx-grid-popup-btn"
                                                        @onclick="() => OnSelectInverseItem(data)"
                                                        @onclick:stopPropagation="true">…</button>
                                            </div>
                                        </Template>
                                    </GridColumn>
                                }
                                @* ── PriceLink: read-only with group description ─── *@
                                else if (fieldName.Equals("PriceLink", StringComparison.OrdinalIgnoreCase))
                                {
                                    <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="false" Visible="@initialVisible">
                                        <Template>
                                            @{ var data = (ItemRow)context; }
                                            <span title="@data.PriceGroupDesc">@(!string.IsNullOrWhiteSpace(data.PriceGroupDesc) ? data.PriceGroupDesc : (data.PriceLink != 0 ? data.PriceLink.ToString() : ""))</span>
                                        </Template>
                                    </GridColumn>
                                }
                                @* ── Default: typed column (CheckBox, Number, Text) ─── *@
                                else
                                {
                                    <GridColumn Field="@fieldName"
                                                  HeaderText="@headerText"
                                                  Width="@width"
                                                  Type="@columnType"
                                                  TextAlign="@textAlign"
                                                  AllowEditing="@allowEdit"
                                                  SelectAllOnEdit="@selectAllOnEdit"
                                                  EditOptions="@editOptions"
                                                  Visible="@initialVisible" />
                                }
                            }
                        </GridColumnsBase>
                    </GridControl>
                  </div>
                </div>
                </SecondaryContent>
            </SplitterControl>

    </div>


@* ── Notes / Description Dialog ─────────────────────────────────────
   VB6 FComments = a BARE text popup: no OK/Cancel buttons and no placeholder text —
   closing the window (X) COMMITS the text, Escape cancels (FComments.frm:59-69). Titles
   come from the caller: "Description" / "Comments" (HHM-174). *@
<DialogControl Visible="@IsTextDialogVisible"
               Header="@TextDialogTitle"
               Width="520px"
               IsModal="true"
               ShowCloseIcon="true"
               OnClose="OnTextDialogOk"
               CssClass="fitems-desc-dialog">
    <ChildContent>
        <div class="fitems-dialog-form" @onkeydown="OnTextDialogKeyDown">
            <TextAreaControl @bind-Value="EditingText" UpdateOnInput="true" MaxLength="@_textDialogMaxLength" Rows="10" CssClass="fitems-dialog-textarea" />
        </div>
    </ChildContent>
</DialogControl>

@* ── Formula Editor Dialog ──────────────────────────────────────── *@
@* VB6 FItems.frm:553 — the Formula "…" opens the REAL Formula Editor (FFormulaEditor:
   Variables / Formulas / grouped function library, large editor area, Test button). The
   old plain-textarea stand-in was flagged as HHM-211. *@
<FFormulaEditor @ref="formulaEditor" OnAccepted="OnFormulaAccepted" />

@* ── New Item Dialog ────────────────────────────────────────────── *@
<DialogControl Visible="@IsNewItemDialogVisible"
               Header="Add Item"
               Width="410px"
               IsModal="true"
               ShowCloseIcon="true"
               Resizable="false"
               CssClass="fitems-add-item-dialog"
               OnClose="@(() => IsNewItemDialogVisible = false)">
    <ChildContent>
        <div class="fitems-add-item-container">
            <div class="fitems-add-item-instruction">
                Enter a phase, item number and description for the new item.
            </div>
            <div class="fitems-add-item-main">
                <div class="fitems-add-item-form">
                    <div class="fitems-form-row">
                        <label class="lbl-phase">Phase Number</label>
                        <div class="field-container phase-field-group">
                            <TextBoxControl @bind-Value="NewItemPhase" CssClass="flat-textbox phase-input" />
                            <button type="button" class="classic-browse-btn" @onclick="OpenPhaseListDialog">...</button>
                        </div>
                    </div>
                    <div class="fitems-form-row">
                        <label class="lbl-item">Item Number</label>
                        <div class="field-container">
                            <TextBoxControl @bind-Value="NewItemCode" CssClass="flat-textbox item-input" />
                        </div>
                    </div>
                    <div class="fitems-form-row">
                        <label class="lbl-desc">Description</label>
                        <div class="field-container">
                            <TextBoxControl @bind-Value="NewItemDescription" MaxLength="200" CssClass="flat-textbox desc-input" />
                        </div>
                    </div>
                    <div class="fitems-form-row">
                        <label class="lbl-cost">Cost Type</label>
                        <div class="field-container">
                            <DropDownListControl TValue="string" TItem="ComboBoxItem"
                                                 Value="@NewItemCostCategory"
                                                 ValueChanged="v => NewItemCostCategory = v"
                                                 DataSource="@CostCategoryTypes"
                                                 TextFieldName="Text"
                                                 ValueFieldName="Value"
                                                 CssClass="flat-dropdown cost-input"
                                                 Width="120px" />
                        </div>
                    </div>
                </div>
                <div class="fitems-add-item-buttons">
                    <ButtonControl CssClass="classic-btn" OnClick="OnCreateNewItem"><u>O</u>K</ButtonControl>
                    <ButtonControl CssClass="classic-btn" OnClick="@(() => IsNewItemDialogVisible = false)"><u>C</u>ancel</ButtonControl>
                </div>
            </div>
        </div>
    </ChildContent>
</DialogControl>

@* ── Phase List Dialog ───────────────────────────────────────────── *@
<DialogControl Visible="@IsPhaseListDialogVisible"
               Header="Precision Builder - Phase List"
               Width="460px"
               IsModal="true"
               ShowCloseIcon="true"
               CssClass="fitems-phase-list-dialog"
               OnClose="@(() => IsPhaseListDialogVisible = false)">
    <ChildContent>
        <div class="fitems-phase-list-container">
            <div class="fitems-phase-list-instruction">
                <strong>Choose a Phase.</strong><br />
                Type directly into the list to search for an item.<br />
                Click on a column heading to sort the list on that column.
            </div>

            <div class="fitems-phase-list-search">
                <input type="text"
                       value="@PhaseSearchText"
                       @oninput="OnPhaseSearchInput"
                       class="classic-textbox phase-search-input"
                       placeholder="Type to search phase..."
                       autofocus />
            </div>

            <div class="fitems-phase-list-table-wrapper">
                <table class="classic-table phase-list-table">
                    <thead>
                        <tr>
                            <th @onclick='() => SortPhases("Phase")'>phase</th>
                            <th @onclick='() => SortPhases("Description")'>description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var phase in FilteredPhases)
                        {
                            <tr class="@(SelectedPhaseItem?.Phase == phase.Phase ? "selected-row" : "")"
                                @onclick="() => SelectPhaseItem(phase)"
                                @ondblclick="() => ConfirmSelectPhase(phase)">
                                <td style="width: 100px;">@phase.Phase</td>
                                <td>@phase.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="fitems-phase-list-footer">
                <div class="memory-optimization-checkbox">
                    <label>
                        <input type="checkbox" @bind="MemoryOptimization" /> Memory optimization
                    </label>
                </div>
                <div class="fitems-phase-list-buttons">
                    <button type="button" class="classic-btn" @onclick="ConfirmSelectPhase" disabled="@(SelectedPhaseItem == null)">Open</button>
                    <button type="button" class="classic-btn" @onclick="@(() => IsPhaseListDialogVisible = false)">Cancel</button>
                </div>
            </div>
        </div>
    </ChildContent>
</DialogControl>

@* ── Items Grid Context Menu ────────────────────────────────────── *@
<ContextMenuControl Visible="@_showItemsContextMenu"
                    X="@_contextMenuX"
                    Y="@_contextMenuY"
                    MinWidth="180"
                    OnClose="CloseContextMenus">
    <ContextMenuItemControl Text="Renumber..." Disabled="@(_ctxItem == null)" OnClick="OnCtxRenumberItem" />
    <ContextMenuItemControl Text="New Item..." OnClick="OnCtxNewItem" />
    <ContextMenuItemControl Text="Make a Copy..." Disabled="@(_ctxItem == null)" OnClick="OnCtxDuplicateItem" />
    <ContextMenuSeparatorControl />
    <ContextMenuItemControl Text="Attachments..." Disabled="@(_ctxItem == null)" OnClick="OnCtxAttachments" />
    <ContextMenuSeparatorControl />
    <ContextMenuItemControl Text="Delete" Disabled="@(_ctxItem == null)" OnClick="OnCtxDeleteItem" />
    <ContextMenuSeparatorControl />
    <ContextMenuItemControl Text="Price links" Disabled="@(_ctxItem == null)" CloseOnClick="false">
        <ContextMenuItemControl Text="Make Group" OnClick="OnCtxPriceMakeGroup" />
        <ContextMenuItemControl Text="Join Group..." OnClick="OnCtxPriceJoinGroup" />
        <ContextMenuItemControl Text="Ungroup" OnClick="OnCtxPriceUngroup" />
    </ContextMenuItemControl>
</ContextMenuControl>

@* ── Phases Tree Context Menu ──────────────────────────────────── *@
<ContextMenuControl Visible="@_showTreeContextMenu"
                    X="@_contextMenuX"
                    Y="@_contextMenuY"
                    MinWidth="170"
                    OnClose="CloseContextMenus">
    <ContextMenuItemControl Text="Rename..." Disabled="@(!HasTreeSelection)" OnClick="OnCtxRenamePhase" />
    <ContextMenuItemControl Text="Renumber..." Disabled="@(!HasTreeSelection)" OnClick="OnCtxRenumberPhase" />
    <ContextMenuSeparatorControl />
    <ContextMenuItemControl Text="New Group..." OnClick="OnCtxNewGroup" />
    <ContextMenuItemControl Text="New Phase..." OnClick="OnCtxNewPhase" />
    <ContextMenuSeparatorControl />
    <ContextMenuItemControl Text="Delete" Disabled="@(!HasTreeSelection)" OnClick="OnCtxDeletePhase" />
</ContextMenuControl>

@* ── Renumber Item Dialog ──────────────────────────────────────── *@
<DialogControl Visible="@_showRenumberItemDialog"
               Header="Renumber Item"
               Width="390px"
               Height="160px"
               IsModal="true"
               ShowCloseIcon="true"
               Resizable="false"
               CssClass="fx-dialog-classic"
               OnClose="@(() => _showRenumberItemDialog = false)">
    <ChildContent>
        <div class="fitems-legacy-form fitems-renumber-item-content">
            <div class="fitems-legacy-prompt">Enter a new phase and item number for this item.</div>
            <div class="fitems-legacy-actions">
                <ButtonControl CssClass="fx-button-classic" OnClick="OnRenumberItemOk">OK</ButtonControl>
                <ButtonControl CssClass="fx-button-classic" OnClick="@(() => _showRenumberItemDialog = false)">Cancel</ButtonControl>
            </div>
            <label>Phase Number</label>
            <TextBoxControl @bind-Value="_renumberNewPhase"
                            CssClass="fx-textbox-classic"
                            onkeydown="@EnterAsOk(OnRenumberItemOk)"
                            AutoFocus="true"
                            SelectOnFocus="true"
                            UpdateOnInput="true" />
            <label>Item Number</label>
            <TextBoxControl @bind-Value="_renumberNewItemNumber"
                            CssClass="fx-textbox-classic"
                            onkeydown="@EnterAsOk(OnRenumberItemOk)"
                            SelectOnFocus="true"
                            UpdateOnInput="true" />
        </div>
    </ChildContent>
</DialogControl>

@* ── Renumber Phase Dialog ─────────────────────────────────────── *@
<DialogControl Visible="@_showRenumberPhaseDialog"
               Header="Precision Builder"
               Width="390px"
               Height="120px"
               IsModal="true"
               ShowCloseIcon="true"
               Resizable="false"
               CssClass="fx-dialog-classic"
               OnClose="@(() => _showRenumberPhaseDialog = false)">
    <ChildContent>
        <div class="fitems-legacy-form fitems-renumber-phase-content">
            <div class="fitems-legacy-prompt">Enter a new number for @_renumberPhaseName</div>
            <div class="fitems-legacy-actions">
                <ButtonControl CssClass="fx-button-classic" OnClick="OnRenumberPhaseOk">OK</ButtonControl>
                <ButtonControl CssClass="fx-button-classic" OnClick="@(() => _showRenumberPhaseDialog = false)">Cancel</ButtonControl>
            </div>
            <TextBoxControl @bind-Value="_renumberPhaseNewCode"
                            CssClass="fx-textbox-classic fitems-renumber-phase-input"
                            onkeydown="@EnterAsOk(OnRenumberPhaseOk)"
                            AutoFocus="true"
                            SelectOnFocus="true"
                            UpdateOnInput="true" />
        </div>
    </ChildContent>
</DialogControl>

@* VB6 mcITEM_VIEWFILES → EditAttachments for the selected item (HHM-260).
   Same self-contained FAttachments modal host FAssembly uses. *@
<FAttachments @ref="itemsAttachmentsDialog" />

@* ── Rename Phase Dialog ───────────────────────────────────────── *@
<DialogControl Visible="@_showRenamePhaseDialog"
               Header="Precision Builder"
               Width="390px"
               Height="140px"
               IsModal="true"
               ShowCloseIcon="true"
               Resizable="false"
               CssClass="fx-dialog-classic"
               OnClose="CloseRenamePhaseDialog">
    <ChildContent>
        <div class="fitems-rename-content">
            <div class="fitems-rename-prompt">Enter a new description for @_renamePhaseCode</div>
            <div class="fitems-rename-actions">
                <ButtonControl CssClass="fx-button-classic" OnClick="OnRenamePhaseOk">OK</ButtonControl>
                <ButtonControl CssClass="fx-button-classic" OnClick="@(() => CloseRenamePhaseDialog())">Cancel</ButtonControl>
            </div>
            <div class="fitems-rename-description">
                <TextBoxControl @bind-Value="_renamePhaseNewDesc"
                                CssClass="fx-textbox-classic"
                                onkeydown="@EnterAsOk(OnRenamePhaseOk)"
                                AutoFocus="true"
                                SelectOnFocus="true"
                                UpdateOnInput="true" />
            </div>
        </div>
    </ChildContent>
</DialogControl>

@* ── New Group / Phase Dialog ──────────────────────────────────── *@
<DialogControl Visible="@_showNewGroupPhaseDialog"
               Header="Precision Builder"
               Width="520px"
               Height="164px"
               IsModal="true"
               ShowCloseIcon="true"
               Resizable="false"
               CssClass="fx-dialog-classic"
               OnClose="@(() => _showNewGroupPhaseDialog = false)">
    <ChildContent>
        @* VB6 layout (FItems.frm InputBox): OK/Cancel stacked top-right, prompt to their left, and the
           Number/Description fields full-width on the rows below — not beside the buttons. *@
        <div class="fitems-newphase">
            <div class="fitems-newphase-top">
                <div class="fitems-newphase-prompt">Enter a number and description for the new @(_isNewGroup ? "group" : "phase").</div>
                <div class="fitems-newphase-actions">
                    <ButtonControl CssClass="fx-button-classic" TabIndex="3" OnClick="OnCreateGroupPhase">OK</ButtonControl>
                    <ButtonControl CssClass="fx-button-classic" TabIndex="4" OnClick="@(() => _showNewGroupPhaseDialog = false)">Cancel</ButtonControl>
                </div>
            </div>
            <div class="fitems-newphase-fields">
                <label>Number</label>
                <TextBoxControl @bind-Value="_newGroupPhaseCode"
                                CssClass="fx-textbox-classic"
                                onkeydown="@EnterAsOk(OnCreateGroupPhase)"
                                autocomplete="off"
                                tabindex="1"
                                AutoFocus="true"
                                SelectOnFocus="true"
                                UpdateOnInput="true" />
                <label>Description</label>
                <TextBoxControl @bind-Value="_newGroupPhaseDesc"
                                CssClass="fx-textbox-classic"
                                onkeydown="@EnterAsOk(OnCreateGroupPhase)"
                                autocomplete="off"
                                tabindex="2"
                                SelectOnFocus="true"
