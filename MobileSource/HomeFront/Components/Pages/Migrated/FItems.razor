    // === Load Items for Selected Phase ===
    private async Task LoadItemsAsync()
    {
        if (SelectedNode == null) return;
        if (mDirty && !await SaveDataAsync(true)) return;
        IsLoading = true;
        StateHasChanged();
        try
        {
            var whereClause = SelectedNode.WhereClause;
            var viewDef = ViewDefinitions[CurrentViewIndex];
            var includePriceGroups = viewDef.FromWhere.IndexOf("PriceGroups", StringComparison.OrdinalIgnoreCase) >= 0;
            var groupSelect = includePriceGroups ? ", g.*" : "";
            var sql = $@"
                SELECT
                    x.JCCostCode AS ItemCostCode,
                    y.Description AS ItemCostCodeDesc,
                    v.Phase + '/' + v.Item + ' - ' + ISNULL(v.Description,'') AS InverseItemDesc,
                    i.*{groupSelect}
                {viewDef.FromWhere}
                LEFT JOIN tblPhaseItem x ON i.DivisionID = x.DivisionID AND i.Phase = x.Phase AND i.Item = x.Item
                LEFT JOIN tblPhaseItem v ON x.DivisionID = v.DivisionID AND x.InversePhase = v.Phase AND x.InverseItem = v.Item
                LEFT JOIN StandardCostCodes y ON i.DivisionID = y.DivisionID AND x.JCCostCode = y.CostCode
                WHERE i.DivisionID = {SessionState.DivisionID} {(string.IsNullOrWhiteSpace(whereClause) ? "" : "AND " + whereClause)}
                ORDER BY {viewDef.SortFields}";

            var rows = await db.QueryAsync(sql);
            ItemsData = rows.Select(r =>
            {
                var item = new ItemRow
                {
                    Phase = r["Phase"]?.ToString() ?? "",
                    Item = r["Item"]?.ToString() ?? "",
                    ItemNumber = r.ContainsKey("ItemNumber") ? r["ItemNumber"]?.ToString() ?? "" : "",
                    CostCategory = r["CostCategory"]?.ToString() ?? "",
                    ItemDesc = r.ContainsKey("ItemDesc") ? r["ItemDesc"]?.ToString() ?? "" : r["Description"]?.ToString() ?? "",
                    PhaseDesc = r.ContainsKey("PhaseDesc") ? r["PhaseDesc"]?.ToString() ?? "" : r.ContainsKey("PhaseDescription") ? r["PhaseDescription"]?.ToString() ?? "" : "",
                    Notes = r["Notes"]?.ToString() ?? "",
                    Formula = r["Formula"]?.ToString() ?? "",
                    POIndex = r["POIndex"]?.ToString() ?? "",
                    POIndexDescription = r["POIndexDescription"]?.ToString() ?? "",
                    JCCostCode = r.ContainsKey("ItemCostCode") ? r["ItemCostCode"]?.ToString() ?? "" : r["JCCostCode"]?.ToString() ?? "",
                    JCCostCodeDesc = r.ContainsKey("ItemCostCodeDesc") ? r["ItemCostCodeDesc"]?.ToString() ?? "" : r["JCCostCodeDesc"]?.ToString() ?? "",
                    JCCategory = r["JCCategory"]?.ToString() ?? "",
                    JCCategoryDesc = r["JCCategoryDesc"]?.ToString() ?? "",
                    AltJCCostCode = r["AltJCCostCode"]?.ToString() ?? "",
                    AltJCCostCodeDesc = r["AltJCCostCodeDesc"]?.ToString() ?? "",
                    AltJCCategory = r["AltJCCategory"]?.ToString() ?? "",
                    AltJCCategoryDesc = r["AltJCCategoryDesc"]?.ToString() ?? "",
                    TaxGroup = r["TaxGroup"]?.ToString() ?? "",
                    TakeoffUOM = r["TakeoffUOM"]?.ToString() ?? "",
                    OrderUOM = r["OrderUOM"]?.ToString() ?? "",
                    ConversionFactor = r["ConversionFactor"] != null && r["ConversionFactor"] != DBNull.Value
                        ? Convert.ToDecimal(r["ConversionFactor"]) : 1,
                    Price = r["Price"] != null && r["Price"] != DBNull.Value
                        ? Convert.ToDecimal(r["Price"]) : 0,
                    WastePercent = r["WastePercent"] != null && r["WastePercent"] != DBNull.Value
                        ? Convert.ToInt32(r["WastePercent"]) : 0,
                    RoundDir = r["RoundDir"] != null && r["RoundDir"] != DBNull.Value
                        ? Convert.ToInt32(r["RoundDir"]) : 0,
                    RoundTo = r["RoundTo"] != null && r["RoundTo"] != DBNull.Value
                        ? Convert.ToDecimal(r["RoundTo"]) : 0,
                    PartNumber = r["PartNumber"]?.ToString() ?? "",
                    OptionID = r["OptionID"]?.ToString() ?? "",
                    OptionCategory = r["OptionCategory"]?.ToString() ?? "",
                    Color = r["Color"]?.ToString() ?? "",
                    Location = r["Location"]?.ToString() ?? "",
                    RetailPretax = r["RetailPretax"] != null && r["RetailPretax"] != DBNull.Value
                        ? Convert.ToDecimal(r["RetailPretax"]) : 0,
                    IsQuote = r["IsQuote"]?.ToString() == "True" || r["IsQuote"]?.ToString() == "1",
                    UseInFieldPO = r["UseInFieldPO"]?.ToString() == "True" || r["UseInFieldPO"]?.ToString() == "1",
                    PriceLink = r["PriceLink"] != null && r["PriceLink"] != DBNull.Value
                        ? Convert.ToInt32(r["PriceLink"]) : 0,
                    PriceGroupDesc = r.ContainsKey("PriceGroupDesc") ? r["PriceGroupDesc"]?.ToString() ?? "" : "",
                    InverseItemDesc = r["InverseItemDesc"]?.ToString() ?? "",
                    RowState = "CLEAN"
                };
                for (var i = 1; i <= 40; i++)
                {
                    var key = $"WBS{i:D2}";
                    if (r.ContainsKey(key))
                        item.SetWbs(i, r[key]?.ToString() ?? "");
                }
                return item;
            }).ToList();
            mDirty = false;
            _loadedTreeNodeKey = GetTreeNodeIdentity(SelectedNode);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"LoadItemsAsync error: ");
            Notifications.Error($"Error loading items: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === Save Data ===
    private async Task<bool> SaveDataAsync(bool prompt = false)
    {
        if (!mDirty) return true;
        if (prompt)
        {
            var result = _messageBox != null
                ? await _messageBox.ShowAsync(
                    "Item Database has changed.\n\nDo you want to save these changes?",
                    title: "Save changes?",
                    buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel)
                : (await Dialogs.ConfirmAsync(
                        "Item Database has changed.\n\nDo you want to save these changes?")
                    ? Fx.ControlKit.Dialogs.MessageBoxResult.Yes
                    : Fx.ControlKit.Dialogs.MessageBoxResult.No);

            if (result == Fx.ControlKit.Dialogs.MessageBoxResult.Cancel)
                return false;
            if (result == Fx.ControlKit.Dialogs.MessageBoxResult.No)
                return true;
        }
        IsLoading = true;
        StateHasChanged();
        try
        {
            foreach (var item in ItemsData.Where(i => i.RowState == "Deleted").Concat(_deletedItems))
            {
                await db.ExecuteAsync($@"
                    DELETE FROM tblPhaseItem WHERE DivisionID = {SessionState.DivisionID}
                    AND Phase = @Phase AND Item = @Item",
                    new { item.Phase, item.Item });
                await db.ExecuteAsync($@"
                    DELETE FROM tblDBAssemblyDetails WHERE DivisionID = {SessionState.DivisionID}
                    AND Phase = @Phase AND Item = @Item",
                    new { item.Phase, item.Item });
            }

            foreach (var item in ItemsData.Where(i => i.RowState == "DIRTY" || i.RowState == "DDIRTY"))
            {
                // ── Build WBS01..WBS40 SET fragment + params (VB6 FItems.frm:1459-1461) ──
                var wbsSet = new System.Text.StringBuilder();
                var pars = new Dictionary<string, object>
                {
                    ["Phase"] = item.Phase,
                    ["Item"] = item.Item,
                    ["ItemDesc"] = item.ItemDesc,
                    ["Formula"] = item.Formula,
                    ["Notes"] = item.Notes,
                    ["PartNumber"] = item.PartNumber,
                    ["POIndex"] = item.POIndex,
                    ["JCCostCode"] = item.JCCostCode,
                    ["JCCategory"] = item.JCCategory,
                    ["AltJCCostCode"] = item.AltJCCostCode,
                    ["AltJCCategory"] = item.AltJCCategory,
                    ["OrderUOM"] = item.OrderUOM,
                    ["TakeoffUOM"] = item.TakeoffUOM,
                    ["OptionID"] = item.OptionID,
                    ["OptionCategory"] = item.OptionCategory,
                    ["Color"] = item.Color,
                    ["Location"] = item.Location,
                    ["RetailPretax"] = item.RetailPretax,
                    ["ConversionFactor"] = item.ConversionFactor,
                    ["WastePercent"] = item.WastePercent,
                    ["RoundDir"] = item.RoundDir,
                    ["RoundTo"] = item.RoundTo,
                    ["Price"] = item.Price,
                    ["TaxGroup"] = item.TaxGroup,
                    ["IsQuote"] = item.IsQuote,
                    ["UseInFieldPO"] = item.UseInFieldPO,
                    ["UStmp"] = SessionState.LoginID ?? ""
                };
                for (var w = 1; w <= 40; w++)
                {
                    var col = $"WBS{w:D2}";
                    wbsSet.Append($", {col} = @{col}");
                    pars[col] = item.GetWbs(w);
                }

                var sql = $@"
                    UPDATE tblPhaseItem SET
                        Description = @ItemDesc, Formula = @Formula, Notes = @Notes,
                        PartNumber = @PartNumber, POIndex = @POIndex,
                        JCCostCode = @JCCostCode, JCCategory = @JCCategory,
                        AltJCCostCode = @AltJCCostCode, AltJCCategory = @AltJCCategory,
                        OrderUOM = @OrderUOM, TakeoffUOM = @TakeoffUOM,
                        OptionID = @OptionID, OptionCategory = @OptionCategory,
                        Color = @Color, Location = @Location,
                        RetailPretax = @RetailPretax, ConversionFactor = @ConversionFactor,
                        WastePercent = @WastePercent, RoundDir = @RoundDir, RoundTo = @RoundTo,
                        Price = @Price, TaxGroup = @TaxGroup,
                        IsQuote = @IsQuote, UseInFieldPO = @UseInFieldPO,
                        UStmp = @UStmp, TStmp = GETDATE(){wbsSet}
                    WHERE DivisionID = {SessionState.DivisionID} AND Phase = @Phase AND Item = @Item";
                await db.ExecuteAsync(sql, pars);

                // ── Price-group propagation: fan Price + PartNumber to every item
                //    sharing this PriceLink (VB6 FItems.frm:1465-1472) ──
                if (item.PriceLink != 0)
                {
                    await db.ExecuteAsync(
                        $@"UPDATE tblPhaseItem SET Price = @Price, PartNumber = @PartNumber
                           WHERE DivisionID = {SessionState.DivisionID} AND PriceLink = @PriceLink",
                        new { item.Price, item.PartNumber, item.PriceLink });

                    // mirror into in-grid rows sharing the PriceLink for immediate UI
                    foreach (var other in ItemsData)
                    {
                        if (!ReferenceEquals(other, item) && other.PriceLink == item.PriceLink)
                        {
                            other.Price = item.Price;
                            other.PartNumber = item.PartNumber;
                        }
                    }
                }

                // ── Cascade UOM/conversion into estimates (VB6 FItems.frm:1475 → UpdateItems) ──
                await UpdateItemsCascadeAsync(item.Phase, item.Item);

                item.RowState = "CLEAN";
            }

            ItemsData.RemoveAll(i => i.RowState == "Deleted");
            _deletedItems.Clear();
            mDirty = false;
            Notifications.Info("Data saved successfully.");
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"SaveDataAsync error: ");
            Notifications.Error($"Error saving data: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // === UpdateItems cascade (VB6 FItems.frm:2010-2038) ===
    // Push TakeoffUOM/OrderUOM/ConversionFactor from tblPhaseItem into the
    // un-generated estimate rows (CustomPreEstimateItems where estitemid=0;
    // EstimateItems where budgetgenerated=0 and pogenbatch=0), DivisionID-scoped.
    private async Task UpdateItemsCascadeAsync(string phase, string item)
    {
        var div = SessionState.DivisionID;

        await db.ExecuteAsync(
            $@"UPDATE e SET
                   e.TakeoffUOM = i.TakeoffUOM,
                   e.OrderUOM = i.OrderUOM,
                   e.ConversionFactor = i.ConversionFactor
               FROM CustomPreEstimateItems e
               JOIN tblPhaseItem i ON i.DivisionID = {div} AND e.Phase = i.Phase AND e.Item = i.Item
               WHERE e.EstItemID = 0 AND i.Phase = @Phase AND i.Item = @Item",
            new { Phase = phase, Item = item });

        await db.ExecuteAsync(
            $@"UPDATE e SET
                   e.TakeoffUOM = i.TakeoffUOM,
                   e.OrderUOM = i.OrderUOM,
                   e.ConversionFactor = i.ConversionFactor
               FROM EstimateItems e
               JOIN tblPhaseItem i ON e.DivisionID = i.DivisionID AND e.Phase = i.Phase AND e.Item = i.Item
               WHERE e.BudgetGenerated = 0 AND e.POGenBatch = 0
                 AND i.Phase = @Phase AND i.Item = @Item AND i.DivisionID = {div}",
            new { Phase = phase, Item = item });
    }

