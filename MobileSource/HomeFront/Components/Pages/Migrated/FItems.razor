    private async Task OnRenumberItemOk()
    {
        if (_renumberItem == null) return;
        if (string.IsNullOrWhiteSpace(_renumberNewPhase) || string.IsNullOrWhiteSpace(_renumberNewItemNumber))
        {
            await ShowPrecisionBuilderMessageAsync("Phase and item are both required");
            return;
        }

        var oldPhase = _renumberItem.Phase;
        var oldItem = _renumberItem.Item;
        var oldItemNumber = GetItemNumberOnly(_renumberItem);
        var newPhase = _renumberNewPhase.Trim();
        var newItemNumber = _renumberNewItemNumber.Trim();
        var costCategory = string.IsNullOrWhiteSpace(_renumberCostCategory) ? GetCostCategory(_renumberItem) : _renumberCostCategory;
        var newItem = newItemNumber + costCategory;
        if (newPhase == oldPhase && newItem == oldItem) { _showRenumberItemDialog = false; return; }

        try
        {
            await SaveDataAsync(false);
            var div = SessionState.DivisionID;
            var phaseExists = await db.ExecuteScalarAsync<int>(
                $"SELECT COUNT(*) FROM tblEstPhases WHERE DivisionID = {div} AND Phase = @Phase",
                new { Phase = newPhase });
            if (phaseExists == 0)
            {
                var addPhase = _messageBox != null
                    ? await _messageBox.ShowAsync(
                        $"Phase {newPhase} doesn't exist. Do you want to add it?",
                        title: "Precision Builder",
                        buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.OkCancel,
                        icon: "question")
                    : Fx.ControlKit.Dialogs.MessageBoxResult.Cancel;
                if (addPhase == Fx.ControlKit.Dialogs.MessageBoxResult.Cancel)
                    return;

                await db.ExecuteAsync(
                    $"INSERT INTO tblEstPhases(DivisionID, Phase, Description, GroupPhase, SortOrder) VALUES({div}, @Phase, 'untitled', 0, @SortOrder)",
                    new { Phase = newPhase, SortOrder = newPhase });
                await FixGroupPhaseValueAsync();
            }

            await db.ExecuteAsync(
                $"UPDATE tblPhaseItem SET ItemNumber = @NewItemNumber, Item = @NewItemNumber + ISNULL(CostCategory, ''), Phase = @NewPhase WHERE DivisionID = {div} AND Phase = @OldPhase AND ItemNumber = @OldItemNumber",
                new { NewItemNumber = newItemNumber, NewPhase = newPhase, OldPhase = oldPhase, OldItemNumber = oldItemNumber });
            await db.ExecuteAsync(
                $"UPDATE tblDBAssemblyDetails SET Phase = @NewPhase, Item = @NewItemNumber + RIGHT(Item, 1) WHERE DivisionID = {div} AND Phase = @OldPhase AND Item LIKE @OldItemLike",
                new { NewPhase = newPhase, NewItemNumber = newItemNumber, OldPhase = oldPhase, OldItemLike = oldItemNumber + "_" });
            await db.ExecuteAsync(
                $"UPDATE tblSalesSheetCosts SET Phase = @NewPhase, Item = @NewItemNumber + RIGHT(Item, 1) WHERE Phase = @OldPhase AND Item LIKE @OldItemLike",
                new { NewPhase = newPhase, NewItemNumber = newItemNumber, OldPhase = oldPhase, OldItemLike = oldItemNumber + "_" });
            await db.ExecuteAsync(
                $"UPDATE tblVendorCost SET Phase = @NewPhase, Item = @NewItemNumber + RIGHT(Item, 1) WHERE DivisionID = {div} AND Phase = @OldPhase AND Item LIKE @OldItemLike",
                new { NewPhase = newPhase, NewItemNumber = newItemNumber, OldPhase = oldPhase, OldItemLike = oldItemNumber + "_" });

            _showRenumberItemDialog = false;
            await LoadItemsAsync();
            Notifications.Info($"Item renumbered from {oldPhase}/{oldItem} to {newPhase}/{newItem}.");
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                await ShowPrecisionBuilderMessageAsync(
                    $"Precision Builder already has an item numbered {newPhase}/{newItemNumber}. Please specify a different value.",
                    icon: "info");
            else
                Notifications.Error($"Error renumbering item: {ex.Message}");
        }
    }

