    // === Excel Export (VB6 FItems.frm:852-853 → FDataExport.ExportData) ===
    // Re-run the VB6 SELECT (parameterized on DivisionID), build an .xlsx in
    // memory with ClosedXML via FilerControl.WriteExcel, then ask the browser
    // for a Save As location when the File System Access API is available.
    private async Task OnExcelExport()
    {
        if (mDirty && !await SaveDataAsync(true)) return;
        try
        {
            var dt = db.SqlExec(
                @"SELECT Phase, ItemNumber, CostCategory, PriceLink, Description, Notes,
                         POIndex, JCCostCode, JCCategory, TaxGroup, TakeoffUOM, OrderUOM,
                         ConversionFactor, Price, WastePercent, RoundDir, Roundto, PartNumber,
                         CAST(CASE WHEN IsQuote = 1 THEN 1 ELSE 0 END AS int) AS IsQuote
                  FROM tblPhaseItem
                  WHERE DivisionID = @DivisionID
                  ORDER BY Phase, ItemNumber, CostCategory",
                new { DivisionID = SessionState.DivisionID });

            var result = await BrowserFileExport.SaveExcelAsync(JSRuntime, dt, "Items.xlsx", "Items");
            if (BrowserFileExport.WasCancelled(result))
            {
                Notifications.Info("Export cancelled.");
                return;
            }

            var completion = BrowserFileExport.FormatExportSuccess(dt.Rows.Count, "item", fileName: "Items.xlsx");

            if (_messageBox != null)
            {
                await _messageBox.ShowAsync(
                    completion,
                    title: "Export Complete",
                    buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.Ok,
                    icon: "info");
            }
            else
            {
                Notifications.Info(completion);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FItems Excel export failed");
            Notifications.Error("Export failed: " + ex.Message);
        }
    }

    // === Excel Import (VB6 FItems.frm:831-850 → HFApp.ImportData) ===
    // VB6: HFApp.ImportData("tblPhaseItem","Phase,ItemNumber,CostCategory","DB Items",
    //          "Description,TakeoffUOM,ConversionFactor,OrderUOM",
    //          "Phase_code=phase,Item=,Item_number=ItemNumber,phase_code=Phase")
    // The generic importer (FDataImport.frm SaveData) does, per Excel data row:
    //   (1) INSERT the key columns (swallowing the duplicate-key error → insert-if-new),
    //   (2) UPDATE every mapped non-key column on the matched row.
    // For tblPhaseItem the keys are special-cased: Phase, ItemNumber,
    // Item = ItemNumber + CostCategory, CostCategory, plus DivisionID.
    // The 5th arg is a case-insensitive header-alias map (Excel header = DB column;
    // an empty target hides that header). We trigger the hidden InputFile from the
    // existing Import toolbar button.

    // Header-alias map (VB6 5th ImportData arg), normalized for case-insensitive lookup:
    // Excel-header → DB-column ("" = drop that header so it isn't taken as the DB column).
    private static readonly Dictionary<string, string> _importHeaderAliases =
        new(StringComparer.OrdinalIgnoreCase)
        {
            ["Phase_code"] = "Phase",
            ["Item"] = "",          // hide a stray "Item" header (DB Item is derived)
            ["Item_number"] = "ItemNumber",
            ["phase_code"] = "Phase"
        };

    // Non-key tblPhaseItem columns the importer is allowed to UPDATE. VB6 UPDATEs every
    // mapped header that matches a real table column and isn't a key; we constrain to the
    // documented data set plus the other faithful tblPhaseItem columns the export round-trips.
    private static readonly HashSet<string> _importUpdatableColumns =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "Description", "TakeoffUOM", "ConversionFactor", "OrderUOM",
            "Notes", "POIndex", "JCCostCode", "JCCategory", "TaxGroup",
            "Price", "WastePercent", "RoundDir", "Roundto", "PartNumber", "IsQuote"
        };

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        var ext = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext != ".xls" && ext != ".xlsx")
        {
            Notifications.Error("Please select an Excel file (.xls or .xlsx).");
            return;
        }

        // VB6 prompts to save pending edits before importing; if the user cancels, abort.
        if (mDirty && !await SaveDataAsync(true)) return;

        IsLoading = true;
        StateHasChanged();
        try
        {
            // Read the workbook → DataTable (string columns named after the header row).
            System.Data.DataTable dt;
            using (var stream = file.OpenReadStream(maxAllowedSize: 75 * 1024 * 1024))
            using (var ms = new System.IO.MemoryStream())
            {
                await stream.CopyToAsync(ms);
                ms.Position = 0;
                dt = Fx.ControlKit.Data.FilerControl.ReadExcel(ms);
            }

            // ── Resolve Excel headers → DB columns via the alias map (case-insensitive).
            //    "" target = drop the header (VB6 hides it). Build a header→column lookup. ──
            var headerToColumn = new Dictionary<string, System.Data.DataColumn>(StringComparer.OrdinalIgnoreCase);
            foreach (System.Data.DataColumn col in dt.Columns)
            {
                var raw = col.ColumnName.Replace(" ", "");
                var mapped = _importHeaderAliases.TryGetValue(raw, out var tgt) ? tgt : raw;
                if (string.IsNullOrEmpty(mapped))
                    continue; // hidden header
                headerToColumn[mapped] = col; // later wins, matching VB6 ColKey overwrite
            }

            // Required key/data columns must be present (VB6 raises if missing).
            string[] required = { "Phase", "ItemNumber", "CostCategory" };
            var missing = required.Where(c => !headerToColumn.ContainsKey(c)).ToList();
            if (missing.Count > 0)
            {
                // HHM-445: the common cause is picking the wrong file (e.g. a Model/Assembly
                // export). Say so clearly instead of a bare "columns missing" error.
                Notifications.Error(
                    $"This does not look like an Item Database import file — the required column(s) "
                    + $"{string.Join(", ", missing)} are missing. Please select an item-import spreadsheet "
                    + "(the Item Database export format), not a Model/Assembly export.");
                return;
            }

            // Which non-key DB columns can we UPDATE from this sheet?
            var updateColumns = _importUpdatableColumns
                .Where(c => headerToColumn.ContainsKey(c))
                .ToList();

            int rowsProcessed = 0;
            foreach (System.Data.DataRow dr in dt.Rows)
            {
                string Cell(string dbCol) =>
                    headerToColumn.TryGetValue(dbCol, out var c) ? (dr[c]?.ToString() ?? "").Trim() : "";

                var phase = Cell("Phase");
                var itemNumber = Cell("ItemNumber");
                var costCategory = Cell("CostCategory");
                var item = itemNumber + costCategory; // VB6 tblphaseitem key derivation

                if (string.IsNullOrWhiteSpace(phase) && string.IsNullOrWhiteSpace(itemNumber))
                    continue; // skip blank rows

                // (1) INSERT-if-new: keys + the 4 required data columns. A duplicate-key
                //     collision is swallowed (VB6 "If duplicate Then Resume Next").
                try
                {
                    await db.ExecuteAsync(
                        @"INSERT INTO tblPhaseItem
                            (DivisionID, Phase, ItemNumber, Item, CostCategory,
                             Description, TakeoffUOM, ConversionFactor, OrderUOM)
                          VALUES
                            (@DivisionID, @Phase, @ItemNumber, @Item, @CostCategory,
                             @Description, @TakeoffUOM, @ConversionFactor, @OrderUOM)",
                        new
                        {
                            DivisionID = SessionState.DivisionID,
                            Phase = phase,
                            ItemNumber = itemNumber,
                            Item = item,
                            CostCategory = costCategory,
                            Description = Cell("Description"),
                            TakeoffUOM = Cell("TakeoffUOM"),
                            ConversionFactor = ParseDecimal(Cell("ConversionFactor"), 1m),
                            OrderUOM = Cell("OrderUOM")
                        });
                }
                catch (Exception insEx)
                {
                    // Swallow only duplicate-key collisions (the row already exists);
                    // surface anything else.
                    if (insEx.Message.IndexOf("duplicate", StringComparison.OrdinalIgnoreCase) < 0 &&
                        insEx.Message.IndexOf("PRIMARY KEY", StringComparison.OrdinalIgnoreCase) < 0 &&
                        insEx.Message.IndexOf("UNIQUE", StringComparison.OrdinalIgnoreCase) < 0)
                        throw;
                }

                // (2) UPDATE every mapped non-key column on the matched row
                //     (WHERE DivisionID + Phase + Item, VB6 key = ItemNumber+CostCategory).
                if (updateColumns.Count > 0)
                {
                    var setClauses = new List<string>();
                    var pars = new Dictionary<string, object>
                    {
                        ["DivisionID"] = SessionState.DivisionID,
                        ["Phase"] = phase,
                        ["Item"] = item
                    };
                    foreach (var dbCol in updateColumns)
                    {
                        setClauses.Add($"{dbCol} = @{dbCol}");
                        var txt = Cell(dbCol);
                        pars[dbCol] = dbCol switch
                        {
                            "ConversionFactor" or "Price" or "Roundto" => (object)ParseDecimal(txt, 0m),
                            "WastePercent" or "RoundDir" => (object)ParseInt(txt, 0),
                            "IsQuote" => (object)ParseBool(txt),
                            _ => (object)txt
                        };
                    }
                    await db.ExecuteAsync(
                        $"UPDATE tblPhaseItem SET {string.Join(", ", setClauses)} " +
                        "WHERE DivisionID = @DivisionID AND Phase = @Phase AND Item = @Item",
                        pars);
                }

                rowsProcessed++;
            }

            // ── VB6 follow-up #1: rebuild sort keys (FItems.frm:834-838) ──
            await db.ExecuteAsync(
                @"UPDATE tblPhaseItem
                  SET itemsortorder  = CASE WHEN ISNUMERIC(ItemNumber) = 1 THEN CAST(ItemNumber AS FLOAT) ELSE 0 END,
                      phasesortorder = CASE WHEN ISNUMERIC(Phase)      = 1 THEN CAST(Phase      AS FLOAT) ELSE 0 END
                  WHERE DivisionID = @DivisionID",
                new { DivisionID = SessionState.DivisionID });

            // ── VB6 follow-up #2: create any phases referenced by items but missing
            //    from tblestphases (FItems.frm:840-846) ──
            await db.ExecuteAsync(
                @"INSERT INTO tblEstPhases (DivisionID, Phase, Description, GroupPhase, UStmp, TStmp)
                  SELECT DISTINCT i.DivisionID, i.Phase, i.Phase, 0, 'ME', GETDATE()
                  FROM tblPhaseItem i
                  LEFT OUTER JOIN tblEstPhases p
                       ON i.DivisionID = p.DivisionID AND i.Phase = p.Phase
                  WHERE i.DivisionID = @DivisionID AND p.Phase IS NULL",
                new { DivisionID = SessionState.DivisionID });

            // VB6 follow-up #3 (FixGroupPhaseValue) is the tree-grouping refresh —
            // reloading the tree below performs the equivalent rebuild.
            mDirty = false;
            await LoadTreeAsync(true);
            ItemsData.Clear();
            _loadedTreeNodeKey = "";
            Notifications.Info($"Imported {rowsProcessed} item(s) from {file.Name}.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FItems Excel import failed");
            Notifications.Error("Import failed: " + ex.Message);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ── Tolerant parsers for raw Excel string cells ──
    private static decimal ParseDecimal(string s, decimal fallback) =>
        decimal.TryParse(s, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : fallback;

    private static int ParseInt(string s, int fallback) =>
        int.TryParse(s, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v)
            ? v
            : (decimal.TryParse(s, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var d) ? (int)d : fallback);

    private static bool ParseBool(string s)
    {
        s = (s ?? "").Trim();
        return s.Equals("1") || s.Equals("true", StringComparison.OrdinalIgnoreCase)
            || s.Equals("yes", StringComparison.OrdinalIgnoreCase)
            || s.Equals("y", StringComparison.OrdinalIgnoreCase);
    }

