    private async Task OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        if (selectedRows.Count == 0 || _pickListEditRow == null)
        {
            ClearPickListEditState();
            await ResumeItemsGridKeyboardNavigationAsync();
            return;
        }
        var row = selectedRows[0];
        var item = _pickListEditRow;

        if (IsLookupPickContext(_pickListContext))
        {
            var targets = ResolveCurrentPickListEditTargets(item);
            foreach (var target in targets)
                ApplyLookupPickListValue(target, row, _pickListContext);

            if (targets.Count > 0)
                mDirty = true;
            ClearPickListEditState();
            if (gItems != null)
                await gItems.Refresh();
            StateHasChanged();
            await ResumeItemsGridKeyboardNavigationAsync();
            return;
        }

        switch (_pickListContext)
        {
            case "InverseItem":
                {
                    // VB6 FItems.frm CellButtonClick "InverseItemDesc" (523-543):
                    // write the link DIRECTLY to tblPhaseItem in two UPDATEs.
                    var invPhase = row.ContainsKey("Phase") ? row["Phase"]?.ToString() ?? "" : "";
                    var invItem = row.ContainsKey("Item") ? row["Item"]?.ToString() ?? "" : "";
                    var invDesc = row.ContainsKey("Description") ? row["Description"]?.ToString() ?? "" : "";
                    // VB6 line 520: no self-link
                    if (item.Phase == invPhase && item.Item == invItem)
                        break;

                    var div = SessionState.DivisionID;
                    // forward: this row → target
                    await db.ExecuteAsync(
                        $@"UPDATE tblPhaseItem SET InversePhase = @InvPhase, InverseItem = @InvItem
                           WHERE DivisionID = {div} AND Phase = @Phase AND Item = @Item",
                        new { InvPhase = invPhase, InvItem = invItem, item.Phase, item.Item });
                    // reciprocal back-link on the target (only if it has none yet)
                    await db.ExecuteAsync(
                        $@"UPDATE tblPhaseItem SET InversePhase = @Phase, InverseItem = @Item
                           WHERE DivisionID = {div} AND Phase = @InvPhase AND Item = @InvItem
                             AND ISNULL(InversePhase, '') = '' AND ISNULL(InverseItem, '') = ''",
                        new { item.Phase, item.Item, InvPhase = invPhase, InvItem = invItem });

                    // display: Phase/Item - Description (VB6 line 542)
                    item.InverseItemDesc = $"{invPhase}/{invItem} - {invDesc}";

                    // VB6 UpdateInverseItem (2277-2288): reflect the reciprocal back-link
                    // into the first matching in-grid target row that has no inverse yet.
                    var newValue = $"{item.Phase}/{item.Item} - {item.ItemDesc}";
                    foreach (var other in ItemsData)
                    {
                        if (other.Phase == invPhase && other.Item == invItem
                            && string.IsNullOrEmpty(other.InverseItemDesc))
                        {
                            other.InverseItemDesc = newValue;
                            break;
                        }
                    }
                }
                break;
            case "JoinPriceGroup":
                if (row.ContainsKey("PriceGroup"))
                {
                    var pg = Convert.ToInt32(row["PriceGroup"]);
                    var pgDesc = row.ContainsKey("PriceGroupDesc") ? row["PriceGroupDesc"]?.ToString() ?? "" : "";
                    var div = SessionState.DivisionID;
                    var targets = _selectedItems.Count > 0 ? _selectedItems.ToList() : (item != null ? new List<ItemRow> { item } : new());
                    foreach (var t in targets)
                    {
                        await db.ExecuteAsync(
                            $"UPDATE tblPhaseItem SET PriceLink = @PriceLink WHERE DivisionID = {div} AND Phase = @Phase AND Item = @Item",
                            new { PriceLink = pg, t.Phase, t.Item });
                        t.PriceLink = pg;
                        t.PriceGroupDesc = pgDesc;
                    }
                    Notifications.Info($"Joined price group {pg}.");
                }
                break;
        }

        ClearPickListEditState();
        StateHasChanged();
        await ResumeItemsGridKeyboardNavigationAsync();
    }

