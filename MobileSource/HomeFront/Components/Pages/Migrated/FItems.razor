            item.AltJCCategoryDesc = "";
        }
    }

    // === Context Menu Triggers ===
    private async Task OnItemsContextMenu(MouseEventArgs e)
    {
        await ClearTreeSelectionAsync();
        // VB6 gItems_BeforeMouseDown acts on the grid's current row — a right-click lands on
        // the row under the cursor first (GridControl's per-cell oncontextmenu sets the active
        // cell before this wrapper handler runs), so Renumber/Copy/Delete target the row the
        // user right-clicked, not the last left-clicked one (HHM-88).
        _ctxItem = gItems?.GetCurrentRecord() ?? SelectedItem ?? _selectedItems.LastOrDefault();
        if (_ctxItem != null)
            TrackItemsGridSelection(_ctxItem, extendSelection: true);
        _showItemsContextMenu = true;
        _showTreeContextMenu = false;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
    }

    private void OnTreeContextMenu(MouseEventArgs e)
    {
        // VB6 gPhases_BeforeMouseDown targets Max(.Row, 0) — a header right-click acts on the
        // first row, so every menu entry stays enabled whenever the tree has rows (HHM-73).
        // Row-level targeting (HHM-88) comes from TreeGridControl's RowRightClicked event
        // (owner-authorized additive FlexKit event 2026-07-29 — the library selects the row
        // under the cursor and OnTreeNodeRightClicked records it BEFORE this bubbled handler
        // opens the menu). The fallback below covers header/empty-area right-clicks only.
        if (GetCurrentTreeSelection() == null)
            SelectedNode = TreeNodes.FirstOrDefault();

        // VB6 gPhases_BeforeMouseDown gates the menu on the row's key field:
        // Select Case "i.GrpPhase", "Phase", "" (FItems.frm:794-798). In the
        // Purchase Order (POIndex) and Cost Code (JCCostCode) views no case
        // matches, so legacy shows NO context menu there (HHM-626).
        var menuNode = GetCurrentTreeSelection();
        var menuKeyField = menuNode?.KeyField ?? "";
        if (menuKeyField.Length > 0
            && !menuKeyField.Equals("Phase", StringComparison.OrdinalIgnoreCase)
            && !menuKeyField.Equals("GrpPhase", StringComparison.OrdinalIgnoreCase)
            && !menuKeyField.Equals("i.GrpPhase", StringComparison.OrdinalIgnoreCase))
        {
            CloseContextMenus();
            return;
        }

        _showTreeContextMenu = true;
        _showItemsContextMenu = false;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
    }

    // VB6 FItems.frm gPhases_BeforeMouseDown (.Row = .MouseRow): the library has already
    // selected the row under the cursor; record it so Renumber/Rename/Delete act on the
    // node the user right-clicked (HHM-88).
    private void OnTreeNodeRightClicked(TreeRowSelectEventArgs<ItemsTreeNode> args)
    {
        if (args.Data != null)
            SelectedNode = args.Data;
    }

