@page "/items-db"
@rendermode InteractiveServer

@using HomeFront.Models
@using System.Reflection
@using System.Data
@inject IJSRuntime JSRuntime

<PageTitle>Item Database - HomeFront</PageTitle>

<style>
    .tabs-container { margin: 20px auto; font-family: sans-serif; }
    .task-icon-vb6 { width: 2000px; height: auto; display: block; }
    .tab-buttons { display: flex; border-bottom: 2px solid #ddd; }
    .tab-buttons button {
        padding: 12px 24px; border: none; background: #f0f0f0;
        cursor: pointer; font-size: 16px; transition: background 0.2s;
    }
    .tab-buttons button:hover { background: #e0e0e0; }
    .tab-buttons button.active {
        background: #fff; border-bottom: 2px solid #007bff;
        margin-bottom: -2px; color: #007bff; font-weight: bold;
    }
    .tab-content { padding: 20px; border: 1px solid #ddd; border-top: none; background: #fff; }
    .panel { text-align: center; }
    .panel img { max-width: 100%; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }

    /* VB6 banner */
    .vb6-banner {
        background: #f6c7c7;
        border: 1px solid #c97b7b;
        color: #5b1d1d;
        font-size: 12px;
        padding: 6px 10px;
        margin-bottom: 6px;
    }

    /* Toolbar */
    .toolbar-cntr {
        padding: 6px 8px; display: flex; align-items: center; gap: 6px;
        border-top: 1px solid #c9c9c9; border-bottom: 1px solid #c9c9c9;
        margin-bottom: 10px; background: #f3f3f3; flex-wrap: wrap;
    }
    .tbar-btn {
        padding: 4px 10px; border: 1px solid transparent; border-radius: 3px;
        background: transparent; font-size: 12px; cursor: pointer; display: flex;
        flex-direction: column; align-items: center; gap: 2px;
        transition: background 0.15s, border-color 0.15s;
    }
    .tbar-btn:hover { background: #e9ecef; border-color: #adb5bd; }
    .tbar-btn:disabled { opacity: 0.5; cursor: default; }
    .tbar-btn.danger { color: #dc3545; border-color: #dc3545; }
    .tbar-btn.danger:hover { background: #f8d7da; }
    .tbar-separator { width: 1px; height: 32px; background: #c9c9c9; margin: 0 4px; }
    .tool-label { font-size: 12px; }
    .tbar-icon { width: 20px; height: 20px; }
    .tbar-select { display: flex; flex-direction: column; align-items: center; gap: 4px; }

    /* Split container */
    .split-container { display: flex; height: calc(100vh - 260px); min-height: 500px; }
    .phases-panel {
        width: 380px; min-width: 200px; max-width: 600px;
        border-right: 3px solid #c9c9c9; overflow: auto; resize: horizontal;
    }
    .items-panel { flex: 1; overflow: auto; padding-left: 10px; }

    /* Page title */
    .page-title { font-size: 18px; font-weight: 600; margin-bottom: 8px; color: #333; }

    /* Loading overlay */
    .loading-overlay {
        position: absolute; height: 92%; width: 100%;
        background-color: rgba(1,1,1,0.2); z-index: 10000;
        display: flex; align-items: center; justify-content: center;
    }
    .loading-spinner {
        padding: 20px 40px; background: #fff; border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2); font-size: 16px;
        font-weight: 500; color: #333;
    }

    /* Row state styling */
    .dirty-row { background-color: #fff3cd !important; }
    .delete-row { background-color: #f8d7da !important; text-decoration: line-through; }

    /* Dialog */
    .dialog-overlay {
        position: fixed; inset: 0; z-index: 1000;
        background: rgba(0,0,0,0.3); display: flex;
        align-items: center; justify-content: center;
    }
    .dialog-panel {
        background: #fff; border-radius: 8px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.2);
        min-width: 450px; max-width: 700px; max-height: 80vh;
        display: flex; flex-direction: column; overflow: hidden;
    }
    .dialog-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px 20px; font-weight: 600; font-size: 16px;
        border-bottom: 1px solid #dee2e6;
    }
    .dialog-header button {
        background: none; border: none; font-size: 22px;
        cursor: pointer; color: #6c757d; padding: 0 4px;
    }
    .dialog-header button:hover { color: #212529; }
    .dialog-body { padding: 20px; overflow-y: auto; flex: 1; }
    .dialog-body textarea, .dialog-body input, .dialog-body select {
        width: 100%; padding: 8px 10px; border: 1px solid #ced4da;
        border-radius: 4px; font-size: 14px; box-sizing: border-box;
    }
    .dialog-body textarea:focus, .dialog-body input:focus, .dialog-body select:focus {
        border-color: #86b7fe; outline: 0;
        box-shadow: 0 0 0 2px rgba(13,110,253,0.15);
    }
    .dialog-body label { display: block; font-weight: 500; margin-bottom: 4px; font-size: 13px; color: #495057; }
    .dialog-body .form-group { margin-bottom: 14px; }
    .dialog-footer {
        display: flex; justify-content: flex-end; gap: 8px;
        padding: 12px 20px; border-top: 1px solid #dee2e6; background: #f8f9fa;
    }
    .dialog-footer .btn {
        padding: 6px 20px; border: 1px solid #ced4da; border-radius: 4px;
        background: #fff; cursor: pointer; font-size: 14px;
    }
    .dialog-footer .btn:hover { background: #e9ecef; }
    .dialog-footer .btn-primary { background: #0d6efd; color: #fff; border-color: #0d6efd; }
    .dialog-footer .btn-primary:hover { background: #0b5ed7; }

    /* Edit cell buttons */
    .cell-edit-btn {
        padding: 1px 6px; border: 1px solid #ced4da; border-radius: 3px;
        background: #fff; font-size: 11px; cursor: pointer; margin-left: 4px;
    }
    .cell-edit-btn:hover { background: #e9ecef; }

    /* View dropdown */
    .view-select {
        padding: 6px 10px; border: 1px solid #ced4da; border-radius: 4px;
        font-size: 13px; background: #fff; cursor: pointer;
    }

    /* Phases header */
    .phases-header {
        padding: 10px; background-color: #f5f5f5;
        border-bottom: 1px solid #ddd; font-weight: bold;
        display: flex; align-items: center; gap: 8px;
    }
    .phases-header button {
        padding: 2px 8px; border: 1px solid #ced4da; border-radius: 3px;
        background: #fff; cursor: pointer; font-size: 14px;
    }
    .phases-header button:hover { background: #e9ecef; }

    /* Match VB6 tree look */
    .phases-panel .hf-treegrid-header { display: none; }
    .phases-panel .hf-treegrid { border-radius: 0; }

    /* Grid column borders */
    .items-panel .hf-grid-table { border-collapse: collapse; }
    .items-panel .hf-grid-table .hf-header-cell,
    .items-panel .hf-grid-table .hf-cell {
        border-right: 1px solid #c9c9c9;
    }
    .items-panel .hf-grid-table .hf-header-cell {
        background: #f0f0f0;
        border-bottom: 1px solid #c9c9c9;
    }
    .items-panel .hf-grid-table .hf-cell {
        border-bottom: 1px solid #e2e2e2;
    }
    .items-panel .hf-grid-table th:last-child,
    .items-panel .hf-grid-table td:last-child {
        border-right: none;
    }
</style>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Items...</div>
    </div>
}

<div class="tabs-container">
    <div class="tab-buttons">
        <button class="@(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">.NET</button>
        <button class="@(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">VB6</button>
    </div>

    <div class="tab-content">
        @if (activeTab == 1)
        {
            <div class="vb6-banner">
                This is not your live database. It should be used for testing and training only. If this is incorrect please contact Hyphen support to change the status of this database.
            </div>
            @* ── Toolbar ──────────────────────────────────────────── *@
            <div class="toolbar-cntr">
                <button class="tbar-btn" disabled="@(!mDirty)" @onclick="OnSaveClick">
                    <img class="tbar-icon" src="images/32/save.ico" alt="Save" />
                    <span class="tool-label">Save</span>
                </button>

                <div class="tbar-select">
                    <img class="tbar-icon" src="images/32/ChangeView.ico" alt="View" />
                    <select class="view-select" value="@CurrentViewIndex" @onchange="OnViewChanged">
                        <option value="0">Group and Phase</option>
                        <option value="1">Purchase Order</option>
                        <option value="2">Cost Code</option>
                    </select>
                    <span class="tool-label">View</span>
                </div>

                <span class="tbar-separator"></span>

                <button class="tbar-btn" @onclick="OnNewItemClick">
                    <img class="tbar-icon" src="images/32/Add.ico" alt="New" />
                    <span class="tool-label">New Item</span>
                </button>
                <button class="tbar-btn" disabled="@(SelectedItem == null)" @onclick="OnDuplicateClick">
                    <img class="tbar-icon" src="images/32/copy.ico" alt="Duplicate" />
                    <span class="tool-label">Duplicate</span>
                </button>
                <button class="tbar-btn danger" disabled="@(SelectedItem == null)" @onclick="OnDeleteClick">
                    <img class="tbar-icon" src="images/32/delete.ico" alt="Delete" />
                    <span class="tool-label">Delete</span>
                </button>

                <span class="tbar-separator"></span>

                <button class="tbar-btn" @onclick="OnExcelExport">
                    <img class="tbar-icon" src="images/32/export.ico" alt="Export" />
                    <span class="tool-label">Export Items</span>
                </button>
                <button class="tbar-btn" @onclick="OnExcelImport">
                    <img class="tbar-icon" src="images/32/import.ico" alt="Import" />
                    <span class="tool-label">Import Items</span>
                </button>
                <button class="tbar-btn" @onclick="OnRefreshClick">
                    <img class="tbar-icon" src="images/32/refresh.ico" alt="Refresh" />
                    <span class="tool-label">Refresh</span>
                </button>
            </div>

            <h3 class="page-title">Item Database - @CurrentViewName</h3>

            <div class="split-container">
                @* ── Left Panel: Phases Tree ──────────────────────── *@
                <div class="phases-panel">
                    <div class="phases-header">
                        <span>@CurrentViewName</span>
                    </div>

                    <HfTreeGrid @ref="gPhases"
                                TValue="ItemsTreeNode"
                                DataSource="@TreeNodes"
                                IdMapping="NodeID"
                                ParentIdMapping="ParentID"
                                TreeColumnIndex="0"
                                EnableCollapseAll="true"
                                AllowSelection="true"
                                Height="100%"
                                RowSelected="OnTreeNodeSelected"
                                Collapsed="OnNodeCollapsed"
                                Expanded="OnNodeExpanded">
                        <HfTreeGridColumn Field="NodeID" HeaderText="" Width="20px" Visible="false" />
                        <HfTreeGridColumn Field="Node" HeaderText="Task Name" Width="300px" />
                    </HfTreeGrid>
                </div>

                @* ── Right Panel: Items Grid ──────────────────────── *@
                <div class="items-panel">
                    <HfGrid @ref="gItems"
                            TValue="ItemRow"
                            DataSource="@ItemsData"
                            AllowPaging="true"
                            AllowSorting="true"
                            AllowFiltering="true"
                            AllowResizing="true"
                            AllowSelection="true"
                            AllowGrouping="false"
                            EnableHover="true"
                            Height="100%"
                            FilterSettingsRef="@filterSettings"
                            PageSettingsRef="@pageSettings"
                            SelectionSettingsRef="@selectionSettings"
                            EditSettingsRef="@editSettings"
                            EventsRef="@gridEvents">
                        <HfGridColumnsBase @key="ItemsGridLayoutVersion" DebugTag="FItems-gItems">
                            @foreach (var entry in GetOrderedItemsGridLayout())
                            {
                                var layout = entry.Layout;
                                var fieldName = entry.Field;
                                var columnType = entry.ColumnType;
                                var textAlign = entry.TextAlign;
                                var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                                var width = layout.Width.HasValue && layout.Width.Value > 0
                                    ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                                    : null;
                                var allowEdit = IsEditableField(fieldName, layout);

                                if (fieldName.Equals("ItemDesc", StringComparison.OrdinalIgnoreCase))
                                {
                                    <HfGridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="false">
                                        <Template>
                                            @{ var data = (ItemRow)context; }
                                            <span title="@data.ItemDesc">@TruncateText(data.ItemDesc, 35)</span>
                                            <button class="cell-edit-btn" @onclick="() => OnEditDescription(data)" @onclick:stopPropagation="true">✏️</button>
                                        </Template>
                                    </HfGridColumn>
                                }
                                else if (fieldName.Equals("Notes", StringComparison.OrdinalIgnoreCase))
                                {
                                    <HfGridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="false">
                                        <Template>
                                            @{ var data = (ItemRow)context; }
                                            <span title="@data.Notes">@TruncateText(data.Notes, 20)</span>
                                            <button class="cell-edit-btn" @onclick="() => OnEditNotes(data)" @onclick:stopPropagation="true">✏️</button>
                                        </Template>
                                    </HfGridColumn>
                                }
                                else if (fieldName.Equals("Formula", StringComparison.OrdinalIgnoreCase))
                                {
                                    <HfGridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="false">
                                        <Template>
                                            @{ var data = (ItemRow)context; }
                                            <span title="@data.Formula">@TruncateText(data.Formula, 20)</span>
                                            <button class="cell-edit-btn" @onclick="() => OnEditFormula(data)" @onclick:stopPropagation="true">✏️</button>
                                        </Template>
                                    </HfGridColumn>
                                }
                                else if (fieldName.Equals("POIndex", StringComparison.OrdinalIgnoreCase))
                                {
                                    <HfGridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="true">
                                        <EditTemplate>
                                            @{ var data = (ItemRow)context; }
                                            <select @bind="data.POIndex" @bind:after="() => OnPOIndexChanged(data)">
                                                <option value="">-- Select --</option>
                                                @foreach (var po in POIndexList)
                                                {
                                                    <option value="@po.POIndex">@po.POIndex - @po.Description</option>
                                                }
                                            </select>
                                        </EditTemplate>
                                    </HfGridColumn>
                                }
                                else if (fieldName.Equals("JCCostCode", StringComparison.OrdinalIgnoreCase))
                                {
                                    <HfGridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="true">
                                        <EditTemplate>
                                            @{ var data = (ItemRow)context; }
                                            <select @bind="data.JCCostCode" @bind:after="() => OnCostCodeChanged(data)">
                                                <option value="">-- Select --</option>
                                                @foreach (var cc in CostCodeList)
                                                {
                                                    <option value="@cc.CostCode">@cc.CostCode - @cc.Description</option>
                                                }
                                            </select>
                                        </EditTemplate>
                                    </HfGridColumn>
                                }
                                else if (fieldName.Equals("JCCategory", StringComparison.OrdinalIgnoreCase))
                                {
                                    <HfGridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="true">
                                        <EditTemplate>
                                            @{ var data = (ItemRow)context; }
                                            <select @bind="data.JCCategory" @bind:after="() => OnCategoryChanged(data)">
                                                <option value="">-- Select --</option>
                                                @foreach (var cat in CategoryList)
                                                {
                                                    <option value="@cat.Category">@cat.Category - @cat.Description</option>
                                                }
                                            </select>
                                        </EditTemplate>
                                    </HfGridColumn>
                                }
                                else if (fieldName.Equals("TaxGroup", StringComparison.OrdinalIgnoreCase))
                                {
                                    <HfGridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="true">
                                        <EditTemplate>
                                            @{ var data = (ItemRow)context; }
                                            <select @bind="data.TaxGroup">
                                                <option value="">-- Select --</option>
                                                @foreach (var tg in TaxGroupList)
                                                {
                                                    <option value="@tg.TaxGroup">@tg.TaxGroup - @tg.Description</option>
                                                }
                                            </select>
                                        </EditTemplate>
                                    </HfGridColumn>
                                }
                                else if (fieldName.Equals("InverseItemDesc", StringComparison.OrdinalIgnoreCase))
                                {
                                    <HfGridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="false">
                                        <Template>
                                            @{ var data = (ItemRow)context; }
                                            <span>@data.InverseItemDesc</span>
                                            <button class="cell-edit-btn" @onclick="() => OnSelectInverseItem(data)" @onclick:stopPropagation="true">🔍</button>
                                        </Template>
                                    </HfGridColumn>
                                }
                                else if (fieldName.Equals("PriceLink", StringComparison.OrdinalIgnoreCase))
                                {
                                    <HfGridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="false">
                                        <Template>
                                            @{ var data = (ItemRow)context; }
                                            <span title="@data.PriceGroupDesc">@(!string.IsNullOrWhiteSpace(data.PriceGroupDesc) ? data.PriceGroupDesc : data.PriceLink.ToString())</span>
                                        </Template>
                                    </HfGridColumn>
                                }
                                else
                                {
                                    <HfGridColumn Field="@fieldName"
                                                  HeaderText="@headerText"
                                                  Width="@width"
                                                  Type="@columnType"
                                                  TextAlign="@textAlign"
                                                  AllowEditing="@allowEdit" />
                                }
                            }
                        </HfGridColumnsBase>
                    </HfGrid>
                </div>
            </div>
        }
        else if (activeTab == 2)
        {
            <div class="panel">
                <img src="images/VB6/Screen_IndexItems.png" class="task-icon-vb6" />
            </div>
        }
    </div>
</div>

@* ── Notes / Description Dialog ─────────────────────────────────── *@
@if (IsTextDialogVisible)
{
    <div class="dialog-overlay" @onclick="OnTextDialogCancel">
        <div class="dialog-panel" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <span>@TextDialogTitle</span>
                <button @onclick="OnTextDialogCancel">×</button>
            </div>
            <div class="dialog-body">
                <textarea @bind="EditingText" rows="10" placeholder="Enter text..."></textarea>
            </div>
            <div class="dialog-footer">
                <button class="btn btn-primary" @onclick="OnTextDialogOk">OK</button>
                <button class="btn" @onclick="OnTextDialogCancel">Cancel</button>
            </div>
        </div>
    </div>
}

@* ── Formula Editor Dialog ──────────────────────────────────────── *@
@if (IsFormulaDialogVisible)
{
    <div class="dialog-overlay" @onclick="OnFormulaDialogCancel">
        <div class="dialog-panel" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <span>Formula Editor</span>
                <button @onclick="OnFormulaDialogCancel">×</button>
            </div>
            <div class="dialog-body">
                <div class="form-group">
                    <label>Formula:</label>
                    <textarea @bind="EditingFormula" rows="5" placeholder="Enter formula..."></textarea>
                </div>
                <div style="color: #6c757d; font-size: 12px;">
                    Available functions: AREA, LENGTH, WIDTH, QTY, PITCH, etc.
                </div>
            </div>
            <div class="dialog-footer">
                <button class="btn btn-primary" @onclick="OnFormulaDialogOk">OK</button>
                <button class="btn" @onclick="OnFormulaDialogCancel">Cancel</button>
            </div>
        </div>
    </div>
}

@* ── New Item Dialog ────────────────────────────────────────────── *@
@if (IsNewItemDialogVisible)
{
    <div class="dialog-overlay" @onclick="() => IsNewItemDialogVisible = false">
        <div class="dialog-panel" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <span>New Item</span>
                <button @onclick="() => IsNewItemDialogVisible = false">×</button>
            </div>
            <div class="dialog-body">
                <div class="form-group">
                    <label>Phase:</label>
                    <select @bind="NewItemPhase">
                        <option value="">-- Select Phase --</option>
                        @foreach (var p in PhaseDropdownList)
                        {
                            <option value="@p.Phase">@p.DisplayText</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Item Code:</label>
                    <input @bind="NewItemCode" placeholder="Enter item code" />
                </div>
                <div class="form-group">
                    <label>Description:</label>
                    <input @bind="NewItemDescription" placeholder="Enter description" />
                </div>
                <div class="form-group">
                    <label>Cost Type:</label>
                    <select @bind="NewItemCostCategory">
                        @foreach (var ct in CostCategoryTypes)
                        {
                            <option value="@ct">@ct</option>
                        }
                    </select>
                </div>
            </div>
            <div class="dialog-footer">
                <button class="btn btn-primary" @onclick="OnCreateNewItem">Create</button>
                <button class="btn" @onclick="() => IsNewItemDialogVisible = false">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    // === Database Connection ===
    private HomeFront.Data.DbWrapperSqlServer db = new();
    private int activeTab = 1;

    // === UI State ===
    private const string FormName = "FItems";
    private const string ItemsGridName = "gItems";
    private bool IsLoading = false;
    private bool mDirty = false;
    private HfGrid<ItemRow>? gItems;
    private HfTreeGrid<ItemsTreeNode>? gPhases;

    // === Grid Settings ===
    private HfFilterSettings filterSettings = new() { Type = FilterType.FilterBar };
    private HfPageSettings pageSettings = new() { PageSize = 50, PageSizes = [25, 50, 100, 200] };
    private HfSelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Multiple,
        Mode = SelectionMode.Row,
        EnableToggle = true
    };
    private HfEditSettings editSettings = new()
    {
        AllowEditing = true,
        AllowAdding = true,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = true
    };
    private HfGridEvents<ItemRow> gridEvents = new();

    // === View Management ===
    private int CurrentViewIndex = 0;
    private string CurrentViewName => ViewDefinitions[CurrentViewIndex].Name;
    private List<ViewDefinition> ViewDefinitions = new();
    private Dictionary<string, MMain.GridLayoutColumn> ItemsGridLayout = new(StringComparer.OrdinalIgnoreCase);
    private int ItemsGridLayoutVersion = 0;
    private bool HasItemsGridLayout => ItemsGridLayout.Count > 0;

    // === Data Sources ===
    private List<ItemsTreeNode> TreeNodes = new();
    private List<ItemRow> ItemsData = new();
    private List<POIndexItem> POIndexList = new();
    private List<CostCodeItem> CostCodeList = new();
    private List<CategoryItem> CategoryList = new();
    private List<TaxGroupItem> TaxGroupList = new();
    private List<PhaseDropdownItem> PhaseDropdownList = new();
    private List<string> CostCategoryTypes = new() { "M", "L", "S", "E", "O" };

    // === Selected Items ===
    private ItemRow? SelectedItem;
    private ItemsTreeNode? SelectedNode;

    // === Dialog State ===
    private bool IsTextDialogVisible = false;
    private string TextDialogTitle = "";
    private string EditingText = "";
    private ItemRow? EditingTextRow;
    private string EditingTextColumn = "";
    private bool IsFormulaDialogVisible = false;
    private string EditingFormula = "";
    private ItemRow? EditingFormulaRow;
    private bool IsNewItemDialogVisible = false;
    private string NewItemPhase = "";
    private string NewItemCode = "";
    private string NewItemDescription = "";
    private string NewItemCostCategory = "M";

    // === App State ===
    private int DivisionID = 1;
    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        InitializeViewDefinitions();
        await LoadLookupData();
        await LoadItemsGridLayoutAsync();
        await LoadTreeAsync(true);
    }

    private void InitializeViewDefinitions()
    {
        ViewDefinitions = new List<ViewDefinition>
        {
            new ViewDefinition
            {
                Name = "Group and Phase",
                KeyFields = "GrpPhase, Phase",
                DisplayFields = "GrpPhase + ' - ' + GrpDesc, Phase + ' - ' + PhaseDesc",
                SortFields = "GrpSortOrder, PhaseSortOrder, ItemSortOrder",
                FromWhere = "FROM EstimatingItems i LEFT OUTER JOIN PriceGroups g ON(PriceLink=PriceGroup and i.DivisionID = g.divisionID)",
                IconKeys = "groupphase,phase"
            },
            new ViewDefinition
