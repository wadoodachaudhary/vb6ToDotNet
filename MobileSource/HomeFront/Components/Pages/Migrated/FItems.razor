    private void OnCtxDuplicateItem()
    {
        CloseContextMenus();
        if (_ctxItem == null) return;
        
        _itemsToDuplicate = _selectedItems.Count > 0 ? _selectedItems.ToList() : new List<ItemRow> { _ctxItem };
        
        _duplicateDestPhase = _ctxItem.Phase ?? "";
        _duplicateRenumber = false;
        _duplicateStartNum = "0010";
        _duplicateIncrement = "10";
        _duplicateChangePO = false;
        _duplicatePOIndex = _ctxItem.POIndex ?? (POIndexList.FirstOrDefault()?.POIndex ?? "");

        _poIndexComboItems = POIndexList.Select(p => new ComboBoxItem { 
            Value = p.POIndex, 
            Text = $"{p.POIndex} {p.Description}" 
        }).ToList();
        
        _showDuplicateDialog = true;
    }

    private async Task OnDuplicateItemOk()
    {
        if (!_itemsToDuplicate.Any()) return;
        var destPhase = _duplicateDestPhase;
        if (string.IsNullOrWhiteSpace(destPhase))
        {
            Notifications.Warning("Please select a destination Phase.");
            return;
        }

        try
        {
            await SaveDataAsync(false);
            var div = SessionState.DivisionID;

            double startVal = 0;
            double incrVal = 0;
            string itemFormat = "0000";

            if (_duplicateRenumber)
            {
                if (!double.TryParse(_duplicateStartNum, out startVal))
                {
                    Notifications.Error("Starting number must be numeric.");
                    return;
                }
                if (!double.TryParse(_duplicateIncrement, out incrVal))
                {
                    Notifications.Error("Increment value must be numeric.");
                    return;
                }
                int decimals = Math.Max(GetDecimalLength(_duplicateStartNum), GetDecimalLength(_duplicateIncrement));
                int digits = Math.Max(GetWholeDigitsLength(_duplicateStartNum), GetWholeDigitsLength(_duplicateIncrement));
                itemFormat = new string('0', digits) + (decimals > 0 ? "." + new string('0', decimals) : "");
            }

            int i = 0;
            var sortedItems = _itemsToDuplicate.OrderBy(x => x.Item).ToList();

            foreach (var itemRow in sortedItems)
            {
                string newItemCode = itemRow.Item ?? "";
                string newItemNumber = itemRow.ItemNumber ?? "";

                if (_duplicateRenumber)
                {
                    var calcVal = startVal + i * incrVal;
                    newItemNumber = calcVal.ToString(itemFormat, System.Globalization.CultureInfo.InvariantCulture);
                    newItemCode = newItemNumber + (itemRow.CostCategory ?? "");
                }

                // Check if item already exists in target phase
                var exists = await db.ExecuteScalarAsync<int>(
                    $"SELECT COUNT(*) FROM tblPhaseItem WHERE DivisionID = {div} AND Phase = @Phase AND Item = @Item",
                    new { Phase = destPhase, Item = newItemCode });
                if (exists > 0)
                {
                    await ShowPrecisionBuilderMessageAsync(
                        $"Precision Builder already has an item numbered {destPhase}/{newItemCode}. Please specify a different value.",
                        icon: "info");
                    return;
                }

                string targetPOIndex = _duplicateChangePO ? _duplicatePOIndex : (itemRow.POIndex ?? "");

                // Insert the duplicated row
                await db.ExecuteAsync($@"
                    INSERT INTO tblPhaseItem (
                        DivisionID, Phase, Item, ItemNumber, CostCategory, Description,
                        Formula, Notes, PartNumber, POIndex, JCCostCode, JCCategory,
                        AltJCCostCode, AltJCCategory, OrderUOM, TakeoffUOM, ConversionFactor,
                        WastePercent, RoundDir, RoundTo, Price, TaxGroup, IsQuote, UseInFieldPO,
                        OptionID, OptionCategory, Color, Location, RetailPretax, PriceLink
                    )
                    SELECT 
                        {div}, @DestPhase, @NewItemCode, @NewItemNumber, CostCategory, Description,
                        Formula, Notes, PartNumber, @POIndex, JCCostCode, JCCategory,
                        AltJCCostCode, AltJCCategory, OrderUOM, TakeoffUOM, ConversionFactor,
                        WastePercent, RoundDir, RoundTo, Price, TaxGroup, IsQuote, UseInFieldPO,
                        OptionID, OptionCategory, Color, Location, RetailPretax, PriceLink
                    FROM tblPhaseItem
                    WHERE DivisionID = {div} AND Phase = @OldPhase AND Item = @OldItem",
                    new {
                        DestPhase = destPhase,
                        NewItemCode = newItemCode,
                        NewItemNumber = newItemNumber,
                        POIndex = targetPOIndex,
                        OldPhase = itemRow.Phase,
                        OldItem = itemRow.Item
                    });

                i++;
            }

            if (gPhases != null)
            {
                var destNode = TreeNodes.FirstOrDefault(n => n.KeyValue == destPhase);
                if (destNode != null)
                {
                    if (destNode.ParentID != null)
                    {
                        var parentNode = TreeNodes.FirstOrDefault(n => n.NodeID == destNode.ParentID);
                        if (parentNode != null)
                        {
                            await gPhases.SetExpandedAsync(parentNode, true);
                        }
                    }
                    await gPhases.SelectRecordAsync(destNode);
                    SelectedNode = destNode;
                    _loadedTreeNodeKey = GetTreeNodeIdentity(destNode);
                }
            }

            _showDuplicateDialog = false;
            await LoadItemsAsync();
            Notifications.Info($"Successfully copied {i} items to phase {destPhase}.");
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error copying items: {ex.Message}");
        }
    }

    private int GetDecimalLength(string numStr)
    {
        int dotIdx = numStr.IndexOf('.');
        if (dotIdx < 0) return 0;
        return numStr.Length - dotIdx - 1;
    }
    
    private int GetWholeDigitsLength(string numStr)
    {
        int dotIdx = numStr.IndexOf('.');
        if (dotIdx < 0) return numStr.Length;
        return dotIdx;
    }

