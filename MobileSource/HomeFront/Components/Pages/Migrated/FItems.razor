        IsTextDialogVisible = false;
        StateHasChanged();
        await ResumeItemsGridKeyboardNavigationAsync();
    }

    // VB6 FComments key handling (frm:68-69): Escape = CANCEL (discard the edit),
    // Ctrl+Enter = commit + close. The dialog's X commits (OnClose → OnTextDialogOk),
    // so Escape is caught HERE before it could be treated as a close.
    private async Task OnTextDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await OnTextDialogCancel();
        else if (e.Key == "Enter" && e.CtrlKey) await OnTextDialogOk();
    }

