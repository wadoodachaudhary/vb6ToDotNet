    private string? GetTreeIcon(ItemsTreeNode node, bool isExpanded)
    {
        if (CurrentViewIndex == 0) // Group and Phase
        {
            if (node.ParentID == null) // Group (Level 0)
            {
                // VB6 (FItems.frm) uses a single static "groupphase" icon per node — it does NOT swap to
                // an "open folder" icon on expand. Keep one icon regardless of expand state.
                return "images/16/Group.ico";
            }
            else // Phase (Level 1)
            {
                return "images/16/Phase.ico";
            }
        }
        else if (CurrentViewIndex == 1) // Purchase Order
        {
            return "images/16/purchaseorder.ico";
        }
        else if (CurrentViewIndex == 2) // Cost Code
        {
            return "images/16/costcode.ico";
        }
        return null;
    }

    private bool ShouldTreatTreeNodeAsParent(ItemsTreeNode node)
        => CurrentViewIndex == 0 && node.ParentID == null;

    private void OnNodeExpanded(TreeNodeEventArgs<ItemsTreeNode> args)
