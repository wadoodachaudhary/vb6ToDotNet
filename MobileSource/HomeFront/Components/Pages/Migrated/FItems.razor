    // === Load Phases Tree ===
    private async Task LoadTreeAsync(bool clearTree)
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var nodes = new List<ItemsTreeNode>();
            if (clearTree)
            {
                SelectedNode = null;
                _loadedTreeNodeKey = "";
            }

            var view = ViewDefinitions[CurrentViewIndex];
            var keyFields = ParseViewList(view.KeyFields);
            var displayFields = ParseViewList(view.DisplayFields);
            var sortFields = ParseViewList(view.SortFields);

            if (keyFields.Count == 0 || displayFields.Count == 0)
                return;

            var nodeId = 1;
            if (CurrentViewIndex == 0 && keyFields.Count >= 2 && displayFields.Count >= 2)
            {
                var groups = await QueryTreeLevel(view, keyFields[0], displayFields[0], sortFields.ElementAtOrDefault(0));
                foreach (var g in groups)
                {
                    var key = g.KeyValue;
                    if (string.IsNullOrWhiteSpace(key))
                        continue;
                    var safeKey = SqlSafe(key);
                    var groupNode = new GroupPhaseTreeNode
                    {
                        NodeID = nodeId++,
                        ParentID = null,
                        Node = g.DisplayValue,
                        KeyValue = key,
                        KeyField = keyFields[0],
                        WhereClause = $"i.{keyFields[0]} = '{safeKey}'"
                    };
                    nodes.Add(groupNode);

                    var phases = await QueryTreeLevel(view, keyFields[1], displayFields[1], sortFields.ElementAtOrDefault(1),
                        $"i.{keyFields[0]} = '{safeKey}'");
                    foreach (var p in phases)
                    {
                        var phaseKey = p.KeyValue;
                        if (string.IsNullOrWhiteSpace(phaseKey))
                            continue;
                        var safePhase = SqlSafe(phaseKey);
                        nodes.Add(new GroupPhaseTreeNode
                        {
                            NodeID = nodeId++,
                            ParentID = groupNode.NodeID,
                            Node = p.DisplayValue,
                            KeyValue = phaseKey,
                            KeyField = keyFields[1],
                            WhereClause = $"i.{keyFields[1]} = '{safePhase}'"
                        });
                    }
                }
            }
            else
            {
                var results = await QueryTreeLevel(view, keyFields[0], displayFields[0], sortFields.ElementAtOrDefault(0));
                foreach (var r in results)
                {
                    var key = r.KeyValue;
                    if (string.IsNullOrWhiteSpace(key))
                        continue;
                    var safeKey = SqlSafe(key);
                    ItemsTreeNode node = CurrentViewIndex == 1
                        ? new PurchaseOrderTreeNode()
                        : new CostCodeTreeNode();
                    node.NodeID = nodeId++;
                    node.ParentID = null;
                    node.Node = r.DisplayValue;
                    node.KeyValue = key;
                    node.KeyField = keyFields[0];
                    node.WhereClause = $"i.{keyFields[0]} = '{safeKey}'";
                    nodes.Add(node);
                }
            }
            TreeNodes = nodes;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"LoadTreeAsync error: ");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

