    <ChildContent>
        <div class="duplicate-dialog-body" style="font-family: Tahoma, 'MS Sans Serif', Arial, sans-serif; font-size: 11px; color: #000; padding: 10px;">
            
            <!-- Top Section with Icon and Text -->
            <div style="display: flex; align-items: center; margin-bottom: 15px; margin-left: 10px;">
                <svg width="32" height="32" viewBox="0 0 32 32" style="margin-right: 12px; flex-shrink: 0;">
                    <ellipse cx="16" cy="14" rx="13" ry="11" fill="#e8f0fe" stroke="#1a73e8" stroke-width="1.5" />
                    <path d="M10 20 L13 17" stroke="#1a73e8" stroke-width="1.5" stroke-linecap="round" />
                    <text x="16" y="20" font-family="Arial, Helvetica, sans-serif" font-size="16" font-weight="bold" fill="#1a73e8" text-anchor="middle">?</text>
                </svg>
                <span style="font-size: 11px; font-weight: normal; color: #000;">Make a copy of these items.</span>
            </div>

            <!-- Phase Dropdown -->
            <div style="display: flex; align-items: center; margin-bottom: 12px;">
                <label style="width: 100px; text-align: right; margin-right: 10px; font-weight: normal; margin-bottom: 0;">Phase</label>
                <div style="flex: 1; max-width: 320px;">
                    <DropDownListControl TValue="string" TItem="ComboBoxItem"
                                         Value="@_duplicateDestPhase"
                                         ValueChanged="v => _duplicateDestPhase = v"
                                         DataSource="@_phaseComboItems"
                                         TextFieldName="Text"
                                         ValueFieldName="Value"
                                         CssClass="flat-dropdown"
                                         Width="100%" />
                </div>
            </div>

            <!-- Renumbering Section -->
            <div style="margin-left: 110px; margin-bottom: 15px;">
                <CheckBoxControl Checked="@_duplicateRenumber"
                                 CheckedChanged="v => _duplicateRenumber = v"
                                 Label="Re-number the new items." />
                
                <!-- Renumber Inputs -->
                <div style="margin-top: 6px; display: grid; grid-template-columns: 120px 80px; row-gap: 6px; align-items: center; opacity: @(_duplicateRenumber ? "1" : "0.5"); pointer-events: @(_duplicateRenumber ? "auto" : "none");">
                    <label style="font-weight: normal; margin-bottom: 0;">Starting number</label>
                    <TextBoxControl @bind-Value="_duplicateStartNum" Enabled="@_duplicateRenumber" onkeydown="@EnterAsOk(OnDuplicateItemOk)" style="text-align: right; height: 21px; padding: 2px 5px;" />
                    
                    <label style="font-weight: normal; margin-bottom: 0;">Increment By</label>
                    <TextBoxControl @bind-Value="_duplicateIncrement" Enabled="@_duplicateRenumber" onkeydown="@EnterAsOk(OnDuplicateItemOk)" style="text-align: right; height: 21px; padding: 2px 5px;" />
                </div>
            </div>

            <!-- PO Index Section -->
            <div style="margin-left: 110px; margin-bottom: 15px;">
                <CheckBoxControl Checked="@_duplicateChangePO"
                                 CheckedChanged="v => _duplicateChangePO = v"
