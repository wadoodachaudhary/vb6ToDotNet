            IsPhaseListDialogVisible = false;
        }
    }

    private IEnumerable<PhaseItem> FilteredPhases
    {
        get
        {
            var filtered = AllPhases.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(PhaseSearchText))
            {
                filtered = filtered.Where(p =>
                    p.Phase.Contains(PhaseSearchText, StringComparison.OrdinalIgnoreCase) ||
                    p.Description.Contains(PhaseSearchText, StringComparison.OrdinalIgnoreCase)
                );
            }

            if (_sortColumn == "Phase")
            {
                filtered = _sortAscending ? filtered.OrderBy(p => p.Phase) : filtered.OrderByDescending(p => p.Phase);
            }
            else
            {
                filtered = _sortAscending ? filtered.OrderBy(p => p.Description) : filtered.OrderByDescending(p => p.Description);
            }

            return filtered;
        }
    }

    private void SortPhases(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private async Task OnCreateNewItem()
    {
        if (string.IsNullOrWhiteSpace(NewItemPhase) || string.IsNullOrWhiteSpace(NewItemCode))
        {
            Notifications.Error("Phase and Item Code are required.");
            return;
        }
        try
        {
            var exists = await db.ExecuteScalarAsync<int>($@"
                SELECT COUNT(*) FROM tblPhaseItem
                WHERE DivisionID = {SessionState.DivisionID} AND Phase = @Phase AND Item = @Item",
                new { Phase = NewItemPhase, Item = NewItemCode });
            if (exists > 0)
            {
                Notifications.Error("This item already exists.");
                return;
            }
            await db.ExecuteAsync($@"
                INSERT INTO tblPhaseItem (DivisionID, Phase, Item, CostCategory, Description, ConversionFactor)
                VALUES ({SessionState.DivisionID}, @Phase, @Item, @CostCategory, @Description, 1)",
                new
                {
                    Phase = NewItemPhase, Item = NewItemCode,
                    CostCategory = NewItemCostCategory, Description = NewItemDescription
                });
            IsNewItemDialogVisible = false;
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error creating item: {ex.Message}");
        }
    }

