    private void OnCtxRenumberPhase()
    {
        CloseContextMenus();
        var selectedNode = GetCurrentTreeSelection();
        if (selectedNode == null) return;
        _renumberPhaseOldCode = selectedNode.KeyValue;
        _renumberPhaseNewCode = selectedNode.KeyValue;
        var dashIdx = selectedNode.Node.IndexOf(" - ");
        _renumberPhaseName = dashIdx >= 0 ? selectedNode.Node.Substring(dashIdx + 3) : selectedNode.Node;
        _showRenumberPhaseDialog = true;
    }

    private async Task OnRenumberPhaseOk()
    {
        if (string.IsNullOrWhiteSpace(_renumberPhaseNewCode))
        {
            // Owner directive 2026-07-29: say so instead of silently ignoring OK/Enter
            // (VB6 treated an empty InputBox as cancel; the web dialog must respond).
            await ShowPrecisionBuilderMessageAsync("A new number is required");
            return;
        }
        var oldCode = _renumberPhaseOldCode;
        var newCode = _renumberPhaseNewCode.Trim();
        if (newCode == oldCode) { _showRenumberPhaseDialog = false; return; }

        try
        {
            await SaveDataAsync(false);
            var div = SessionState.DivisionID;
            await db.ExecuteAsync(
                $"UPDATE tblEstPhases SET Phase = @NewCode WHERE DivisionID = {div} AND Phase = @OldCode",
                new { NewCode = newCode, OldCode = oldCode });
            await db.ExecuteAsync(
                $"UPDATE tblPhaseItem SET Phase = @NewCode WHERE DivisionID = {div} AND Phase = @OldCode",
                new { NewCode = newCode, OldCode = oldCode });
            await db.ExecuteAsync(
                $"UPDATE tblDBAssemblyDetails SET Phase = @NewCode WHERE DivisionID = {div} AND Phase = @OldCode",
                new { NewCode = newCode, OldCode = oldCode });
            await db.ExecuteAsync(
                $"UPDATE tblSalesSheetCosts SET Phase = @NewCode WHERE Phase = @OldCode",
                new { NewCode = newCode, OldCode = oldCode });
            await db.ExecuteAsync(
                $"UPDATE tblVendorCost SET Phase = @NewCode WHERE DivisionID = {div} AND Phase = @OldCode",
                new { NewCode = newCode, OldCode = oldCode });

            await FixGroupPhaseValueAsync();

            _showRenumberPhaseDialog = false;
            // HHM-264: capture the selection shape BEFORE the reload — LoadTreeAsync(true) nulls
            // SelectedNode and rebuilds every node, so mutating the old node object here was dead code.
            var wasGroup = GetCurrentTreeSelection()?.ParentID == null;
            // Rebuild the tree so the renumbered phase/group re-sorts to its correct position (VB6 reloads
            // the tree on renumber). Without this, the folder stayed in its old slot (HHM-86).
            await LoadTreeAsync(true);
            // HHM-264: after the rebuild the renumbered node came back unselected under a collapsed
            // group and looked deleted. Restore selection/expansion/items like VB6 FItems.frm
            // 2087-2110 (mcPHASE_RENUMBER keeps the row current, rewrites its RowData in place, and
            // calls LoadItems for phase-level rows only).
            await RestoreRenumberedPhaseTreeContextAsync(newCode, wasGroup);
            Notifications.Info($"Phase renumbered from {oldCode} to {newCode}.");
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                await ShowPrecisionBuilderMessageAsync($"{newCode} already exists. Please specify a different value.", icon: "info");
            else
                Notifications.Error($"Error renumbering phase: {ex.Message}");
        }
    }

    // HHM-264: after the tree rebuild that renumbering forces, re-locate the renumbered node by its
    // new code and restore tree context (same pattern as RestoreNewGroupPhaseTreeContextAsync).
    // VB6 FItems.frm 2102-2109 keeps the renumbered row selected in place and reloads the items
    // pane only for phase-level rows (RowOutlineLevel <> 0); group rows keep their loaded items.
    private async Task RestoreRenumberedPhaseTreeContextAsync(string newCode, bool wasGroup)
    {
        if (gPhases != null)
            await gPhases.ClearSelectionAsync();

        var node = wasGroup
            ? TreeNodes.FirstOrDefault(n => n.ParentID == null
                && string.Equals(n.KeyValue, newCode, StringComparison.OrdinalIgnoreCase))
            : TreeNodes.FirstOrDefault(n => n.ParentID != null
                && string.Equals(n.KeyValue, newCode, StringComparison.OrdinalIgnoreCase));
        // FixGroupPhaseValueAsync may have re-parented the phase (e.g. its group vanished or its
        // GroupPhaseValue was corrected), so fall back to a match anywhere in the tree.
        node ??= TreeNodes.FirstOrDefault(n =>
            string.Equals(n.KeyValue, newCode, StringComparison.OrdinalIgnoreCase));
        if (node == null)
            return;

        SelectedNode = node;
        _loadedTreeNodeKey = GetTreeNodeIdentity(node);

        if (node.ParentID != null)
        {
            // Expand the (possibly different) parent group so the renumbered phase is visible.
            var parentGroup = TreeNodes.FirstOrDefault(n => n.NodeID == node.ParentID);
            if (parentGroup != null && gPhases != null)
            {
                StateHasChanged();
                await Task.Yield();
                await gPhases.SetExpandedAsync(parentGroup, true);
            }
            // VB6 FItems.frm 2106: LoadItems runs in the phase branch only.
            await LoadItemsAsync();
        }
    }

    private void OnCtxNewGroup()
    {
        CloseContextMenus();
        _isNewGroup = true;
        _newPhaseGroupCode = "";
        _newGroupPhaseCode = "";
        _newGroupPhaseDesc = "";
        _showNewGroupPhaseDialog = true;
    }

    private void OnCtxNewPhase()
    {
        CloseContextMenus();
        _isNewGroup = false;
        _newPhaseGroupCode = ResolveGroupCodeForNewPhase();
        _newGroupPhaseCode = "";
        _newGroupPhaseDesc = "";
        _showNewGroupPhaseDialog = true;
    }

    private async Task OnCreateGroupPhase()
    {
        if (string.IsNullOrWhiteSpace(_newGroupPhaseCode) || string.IsNullOrWhiteSpace(_newGroupPhaseDesc))
        {
            // VB6 FPhase.frm SaveData: MsgBox "Number and description are both required", vbExclamation.
            // HHM-140: shown in the movable side popup so the New Phase dialog stays visible.
            ShowNewPhaseMessage("Number and description are both required");
            return;
        }
        var code = _newGroupPhaseCode.Trim();
        var desc = _newGroupPhaseDesc.Trim();
        var groupCode = _isNewGroup ? code : _newPhaseGroupCode;
        try
        {
            if (!await SaveDataAsync(false))
                return;

            var div = SessionState.DivisionID;
            await db.ExecuteAsync($@"
                INSERT INTO tblEstPhases (DivisionID, Phase, Description, GroupPhase, UpdateEstimating)
                VALUES ({div}, @Phase, @Desc, @IsGroup, 0)",
                new { Phase = code, Desc = desc, IsGroup = _isNewGroup ? 1 : 0 });

            // HHM-122: the NUMBER decides the owning group, never the tree selection.
            // VB6 (FItems.frm mcPHASE_NEWPHASE) only inserts, calls FixGroupPhaseValue
            // and reloads the view: FixGroupPhaseValue derives GroupPhaseValue from
            // SortOrder (the group with the greatest SortOrder below the phase's), so
            // 07710 files under 07000 even when 09000 was selected. We used to overwrite
            // that with the selected node's group, which parked every new phase at the
            // selection point instead of in numeric order.
            await FixGroupPhaseValueAsync();
            if (!_isNewGroup)
                groupCode = await GetAssignedGroupCodeAsync(code);

            _showNewGroupPhaseDialog = false;
            await LoadTreeAsync(false);
            await RestoreNewGroupPhaseTreeContextAsync(groupCode, _isNewGroup ? "" : code);
            Notifications.Info($"{(_isNewGroup ? "Group" : "Phase")} {code} created.");
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                // VB6 FPhase.frm SaveData duplicate handler (vbInformation). HHM-140: movable
                // side popup — the New Phase dialog is still open and must stay visible.
                ShowNewPhaseMessage($"Phase \"{code}\" has already been entered. Please specify a different value.", icon: "info");
            else
                Notifications.Error($"Error creating: {ex.Message}");
        }
    }

    private string ResolveGroupCodeForNewPhase()
    {
        if (CurrentViewIndex != 0)
            return "";

        var selectedNode = GetCurrentTreeSelection();
        if (selectedNode == null)
            return "";

        if (selectedNode.ParentID == null)
            return selectedNode.KeyValue;

        var parent = TreeNodes.FirstOrDefault(n => n.NodeID == selectedNode.ParentID);
        return parent?.KeyValue ?? "";
    }

    /// <summary>
    /// HHM-122: read back the group FixGroupPhaseValue assigned from the phase NUMBER,
    /// so the reloaded tree can be expanded/selected on the phase's real parent instead
    /// of wherever the cursor happened to be. Read-only — never writes GroupPhaseValue.
    /// </summary>
    private async Task<string> GetAssignedGroupCodeAsync(string phaseCode)
    {
        try
        {
            var div = SessionState.DivisionID;
            var group = await db.ExecuteScalarAsync<string>(
                $"SELECT GroupPhaseValue FROM tblEstPhases WHERE DivisionID = {div} AND Phase = @PhaseCode AND GroupPhase = 0",
                new { PhaseCode = phaseCode });
            return (group ?? "").Trim();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "GetAssignedGroupCode error");
            return "";
        }
    }

    private async Task RestoreNewGroupPhaseTreeContextAsync(string groupCode, string phaseCode)
    {
        if (gPhases != null)
            await gPhases.ClearSelectionAsync();

        ItemsTreeNode? groupNode = null;
        ItemsTreeNode? phaseNode = null;
        if (CurrentViewIndex == 0 && !string.IsNullOrWhiteSpace(groupCode))
        {
            groupNode = TreeNodes.FirstOrDefault(n =>
                n.ParentID == null
                && string.Equals(n.KeyValue, groupCode, StringComparison.OrdinalIgnoreCase));
            if (groupNode != null && !string.IsNullOrWhiteSpace(phaseCode))
            {
                phaseNode = TreeNodes.FirstOrDefault(n =>
                    n.ParentID == groupNode.NodeID
                    && string.Equals(n.KeyValue, phaseCode, StringComparison.OrdinalIgnoreCase));
            }
        }

        SelectedNode = phaseNode ?? groupNode ?? TreeNodes.FirstOrDefault(n =>
            string.Equals(n.KeyValue, string.IsNullOrWhiteSpace(phaseCode) ? groupCode : phaseCode, StringComparison.OrdinalIgnoreCase));
        _loadedTreeNodeKey = SelectedNode == null ? "" : GetTreeNodeIdentity(SelectedNode);

        // HHM-101: only expand when a NEW PHASE was created inside the group (to
        // reveal it). A newly created empty GROUP stays collapsed showing "+" like
        // VB6 LoadPhases(True), which resets every node to Expanded=False.
        if (groupNode != null && phaseNode != null && gPhases != null)
        {
            StateHasChanged();
            await Task.Yield();
            await gPhases.SetExpandedAsync(groupNode, true);
        }
    }

    private async Task OnCtxDeletePhase()
    {
        CloseContextMenus();
        var selectedNode = GetCurrentTreeSelection();
        if (selectedNode == null) return;
        var code = selectedNode.KeyValue;
        var isGroup = selectedNode.KeyField?.Equals("GrpPhase", StringComparison.OrdinalIgnoreCase) == true
                   || selectedNode.KeyField?.Equals("i.GrpPhase", StringComparison.OrdinalIgnoreCase) == true;

        string msg = isGroup
            ? "Do you want to delete the underlying phases and items?"
            : "This will delete the underlying items.\n\nAre you sure you want to continue?";

        if (_messageBox != null)
        {
            var r = await _messageBox.ShowAsync(msg, title: "Confirm Delete",
                buttons: isGroup ? Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel
                                 : Fx.ControlKit.Dialogs.MessageBoxButtons.OkCancel,
                icon: "warning");
            if (isGroup && r != Fx.ControlKit.Dialogs.MessageBoxResult.Yes) return;
            if (!isGroup && r != Fx.ControlKit.Dialogs.MessageBoxResult.Ok) return;
        }

        if (isGroup)
        {
            if (_messageBox != null)
            {
                var r2 = await _messageBox.ShowAsync(
                    "This action could affect your model and option library. If you click\nOK, these phases and items will be permanently deleted and\nremoved from your database and all your model and option\nassemblies.\n\nAre you sure this is what you want to do?",
                    title: "Warning",
                    buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.OkCancel,
                    icon: "warning",
                    requiredConfirmationText: "I understand and wish to proceed");
                if (r2 != Fx.ControlKit.Dialogs.MessageBoxResult.Ok) return;
            }
        }

        try
        {
            await SaveDataAsync(false);
            var div = SessionState.DivisionID;
            var phaseCsv = "'" + code.Replace("'", "''") + "'";
            if (isGroup)
            {
                var childRows = await db.QueryAsync(
                    $"SELECT Phase FROM tblEstPhases WHERE DivisionID = {div} AND GroupPhaseValue = @Code",
                    new { Code = code });
                foreach (var r in childRows)
                    phaseCsv += ",'" + (r["Phase"]?.ToString() ?? "").Replace("'", "''") + "'";
            }

            await db.ExecuteAsync(
                $"DELETE FROM tblEstPhases WHERE DivisionID = {div} AND Phase IN ({phaseCsv})");
            await FixGroupPhaseValueAsync();

            await db.ExecuteAsync($"DELETE FROM tblPhaseItem WHERE DivisionID = {div} AND Phase IN ({phaseCsv})");
            await db.ExecuteAsync($"DELETE FROM tblDBAssemblyDetails WHERE DivisionID = {div} AND Phase IN ({phaseCsv})");
            await db.ExecuteAsync($"DELETE FROM tblSalesSheetCosts WHERE Phase IN ({phaseCsv})");
            await db.ExecuteAsync($"DELETE FROM tblVendorCost WHERE DivisionID = {div} AND Phase IN ({phaseCsv})");

            ItemsData.Clear();
            SelectedNode = null;
            _loadedTreeNodeKey = "";
            await LoadTreeAsync(false);
            Notifications.Info($"Phase {code} deleted.");
        }
        catch (Exception ex) { Notifications.Error($"Error deleting phase: {ex.Message}"); }
    }

    private async Task FixGroupPhaseValueAsync()
    {
        var div = SessionState.DivisionID;
        var sql = $@"
            UPDATE pp
            SET GroupPhaseValue = gg.Phase
            FROM (
                SELECT p.DivisionID, MAX(g.SortOrder) AS GroupSort, p.Phase
                FROM tblEstPhases p
                JOIN EstGroups g ON g.DivisionID = p.DivisionID AND g.SortOrder < p.SortOrder
                WHERE p.GroupPhase = 0
                GROUP BY p.DivisionID, p.SortOrder, p.Phase
            ) x
            JOIN tblEstPhases pp ON pp.DivisionID = x.DivisionID AND pp.Phase = x.Phase
            JOIN EstGroups gg ON gg.DivisionID = x.DivisionID AND gg.SortOrder = x.GroupSort
            WHERE x.DivisionID = {div};

            UPDATE tblEstPhases
            SET GroupPhaseValue = Phase
            WHERE DivisionID = {div} AND GroupPhase = 1;

            UPDATE tblEstPhases
            SET GroupPhaseValue = (SELECT MIN(Phase) FROM tblEstPhases WHERE DivisionID = {div} AND GroupPhase = 1)
            WHERE GroupPhaseValue IS NULL AND DivisionID = {div};";
        try { await db.ExecuteAsync(sql); }
        catch (Exception ex) { Logger.LogError(ex, "FixGroupPhaseValue error"); }
    }

    // === Helper Methods ===
    private static string GetCostCategory(ItemRow item)
    {
        if (!string.IsNullOrWhiteSpace(item.CostCategory))
            return item.CostCategory.Trim();

        return string.IsNullOrEmpty(item.Item) ? "" : item.Item[^1..];
    }

    private static string GetItemNumberOnly(ItemRow item)
    {
        if (!string.IsNullOrWhiteSpace(item.ItemNumber))
            return item.ItemNumber.Trim();

        var costCategory = GetCostCategory(item);
        if (!string.IsNullOrEmpty(costCategory)
            && item.Item.EndsWith(costCategory, StringComparison.Ordinal)
            && item.Item.Length > costCategory.Length)
        {
            return item.Item[..^costCategory.Length];
        }

        return item.Item.Length > 1 ? item.Item[..^1] : item.Item;
    }

    private static string SqlSafe(string? value)
    {
        return (value ?? "").Replace("'", "''");
    }

    private static List<string> ParseViewList(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return new List<string>();
        return raw.Split(',')
            .Select(s => s.Trim())
            .Where(s => s.Length > 0)
            .ToList();
    }

    private sealed class TreeQueryRow
    {
        public string KeyValue { get; set; } = "";
        public string DisplayValue { get; set; } = "";
    }

    private async Task<List<TreeQueryRow>> QueryTreeLevel(ViewDefinition view, string keyField, string displayField, string? sortField, string? whereClause = null)
    {
        var sort = string.IsNullOrWhiteSpace(sortField) ? keyField : sortField;
        var sql = new System.Text.StringBuilder();
        sql.Append("SELECT DISTINCT ").Append(keyField).Append(" AS KeyValue, ").Append(displayField).Append(" AS DisplayValue");
        if (!string.Equals(sort, keyField, StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(sort, displayField, StringComparison.OrdinalIgnoreCase))
        {
            sql.Append(", ").Append(sort).Append(" AS SortValue");
        }
        sql.AppendLine();
        sql.Append(view.FromWhere);
        sql.Append(" WHERE i.DivisionID = ").Append(SessionState.DivisionID);
        if (!string.IsNullOrWhiteSpace(whereClause))
            sql.Append(" AND ").Append(whereClause);
        if (CurrentViewIndex == 0)
            sql.Append(" AND GrpPhase<>Phase");
        sql.Append(" ORDER BY ").Append(sort);

        var rows = await db.QueryAsync(sql.ToString());
        return rows.Select(r => new TreeQueryRow
        {
            KeyValue = r["KeyValue"]?.ToString() ?? "",
            DisplayValue = r["DisplayValue"]?.ToString() ?? r["KeyValue"]?.ToString() ?? ""
        }).ToList();
    }

    private async Task LoadItemsGridLayoutAsync()
    {
        // Runtime-dynamic gridname with the VB6 3-call fallback, now via the
        // presenter's candidate-list overload (tries each in order until one
        // returns rows). The (grid, instanceKey) pairs below reproduce the EXACT
        // three gridTags the prior three GetGridLayoutAsync calls produced:
        //   1. ("gItems.{view}", null)  → tag "FItems.gItems.{view}"
        //   2. ("gItems", "({view})")   → tag "FItems.gItems.({view})"
        //   3. ("gItems", null)         → tag "FItems.gItems"
        // NB candidate 2's original call passed gridIndex=CurrentViewIndex, which
        // GetGridLayoutAsync renders as the ".({view})" suffix; the candidate
        // overload fixes gridIndex at the ctor value (0), so that suffix is carried
        // through the instanceKey slot instead — same final tag, byte-for-byte.
        // (grid, gridIndex, instanceKey) reproduce the EXACT three gridTags the prior
        // three GetGridLayoutAsync calls produced — including call #2's gridIndex=view
        // (a .(view) subscript only when view≠0), which a fixed-gridIndex overload can't express.
        await _itemsGrid.LoadAsync(GridLayoutSvc,
            ($"{ItemsGridName}.{CurrentViewIndex}", 0, (string?)null),
            (ItemsGridName, CurrentViewIndex, (string?)null),
            (ItemsGridName, 0, (string?)null));

        // Factory-default (char(1)) template for the SAME grid+view — drives the
        // Choose Columns "Restore Default Layout" button. Mirror the lookup order
        // above so it aligns with whichever gridTag the user layout resolved to.
        ItemsDefaultLayout = await GridLayoutSvc.GetDefaultLayoutAsync(FormName, $"{ItemsGridName}.{CurrentViewIndex}", 0, grouped: false);
        if (ItemsDefaultLayout.Count == 0)
            ItemsDefaultLayout = await GridLayoutSvc.GetDefaultLayoutAsync(FormName, ItemsGridName, CurrentViewIndex, grouped: false);
        if (ItemsDefaultLayout.Count == 0)
            ItemsDefaultLayout = await GridLayoutSvc.GetDefaultLayoutAsync(FormName, ItemsGridName, 0, grouped: false);

        // DIAGNOSTIC: confirms the per-view subscript reaches BOTH the user layout
        // and the char(1) default. Watch the console after opening/switching views —
        // on view 0 defaultVisible should read 15, on view 2 it should read 19.
        var dbgTag = $"{FormName}.{ItemsGridName}.{CurrentViewIndex}";
        Logger.LogInformation(
            "FItems gItems view={ViewIndex} tag='{Tag}'  userVisible={UserVis}/{UserTot}  defaultVisible={DefVis}/{DefTot}",
            CurrentViewIndex, dbgTag,
            ItemsGridLayout.Values.Count(c => !c.Hidden), ItemsGridLayout.Count,
            ItemsDefaultLayout.Values.Count(c => !c.Hidden), ItemsDefaultLayout.Count);

        // LoadAsync already bumped Version; bump again so the <GridColumnsBase @key>
        // also reflects the parallel ItemsDefaultLayout reload that followed it.
        _itemsGrid.BumpVersion();
    }

    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedItemsGridLayout()
    {
        if (!HasItemsGridLayout)
            yield break;

        var ordered = ItemsGridLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)   // visible-only, like FAssembly/VB6 IniGetGrid (hidden cols are NOT rendered)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = ResolveItemsGridField(layout.Field);
            var columnType = GetColumnTypeForField(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    /// <summary>Full Choose Columns universe for the dialog — every captioned
    /// column (visible + hidden), so the dialog can re-show columns the grid
    /// isn't currently rendering. Caption filter mirrors VB6 FColumns.LoadColumns
    /// (<c>ColKey&lt;&gt;"" And TextMatrix(0,i)&lt;&gt;""</c>).</summary>
    private IEnumerable<ChooseColumnDescriptor>? GetItemsGridChooseColumnsSchema()
    {
        if (!HasItemsGridLayout) return null;
        return ItemsGridLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !string.IsNullOrWhiteSpace(c.Caption))
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .Select(c => new ChooseColumnDescriptor
            {
                Field = ResolveItemsGridField(c.Field),
                Header = c.Caption,
                Visible = !c.Hidden
            })
            .ToList();
    }

    /// <summary>The char(1) factory-default layout as a Choose Columns schema —
    /// feeds the dialog's "Restore Default Layout" button (VB6 RestoreDefaultLayout,
    /// <c>where uid = char(1)</c>). Null when no default template exists.</summary>
    private IEnumerable<ChooseColumnDescriptor>? GetItemsGridDefaultColumnsSchema()
    {
        if (ItemsDefaultLayout.Count == 0) return null;
        // Full char(1) template (NOT caption-filtered) so EVERY dialog column finds
        // its default verdict on Restore — VB6 RestoreDefaultLayout applies the whole
        // template. Filtering would leave some columns unreset (fuzzy count).
        return ItemsDefaultLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field))
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .Select(c => new ChooseColumnDescriptor
            {
                Field = ResolveItemsGridField(c.Field),
                Header = string.IsNullOrWhiteSpace(c.Caption) ? c.Field : c.Caption,
                Visible = !c.Hidden
            })
            .ToList();
    }

    /// <summary>Applies the user's Choose Columns picks to the saved layout
    /// (visibility and dialog order) and persists to AppGridLayout under the
    /// current user. Mirrors FAssembly.OnItemsColumnsChosenAsync (FItems has no
    /// Total column, so no right-edge pin).</summary>
    private async Task OnItemsColumnsChosenAsync(ChooseColumnsResult result)
    {
        if (!HasItemsGridLayout || result?.Columns == null) return;
        var layoutByField = ItemsGridLayout.Values
            .GroupBy(c => ResolveItemsGridField(c.Field), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        // Apply the user's chosen VISIBILITY *and* ORDER. ChooseColumnsResult.Columns
        // is in the user's chosen order (per the dialog), so assign ColIndex
        // sequentially — GetOrderedItemsGridLayout() renders by ColIndex. Previously
        // only Hidden was set, so reordering in the Insert/Choose Columns dialog was
        // silently ignored (FItems, unlike FAssembly, has no fixed canonical order to
        // preserve, so the dialog order should win).
        var order = 0;
        foreach (var picked in result.Columns)
        {
            if (!layoutByField.TryGetValue(picked.Field, out var layout)) continue;
            layout.Hidden = !picked.Visible;
            layout.ColIndex = order++;
        }

        _itemsGrid.BumpVersion();
        StateHasChanged();
        await PersistItemsGridLayoutAsync();
    }

    // Resize / reorder / hide / group / header-rename done directly on the grid.
    // Saves under the same per-view gridname the layout was loaded and is saved with.
    private async Task OnItemsLayoutChangedAsync(GridSettings snapshot)
    {
        if (snapshot == null || !HasItemsGridLayout) return;
        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, FormName, $"{ItemsGridName}.{CurrentViewIndex}", instanceKey: null,
                ItemsGridLayout, snapshot, ResolveItemsGridField, staticNames: false);
            _itemsGrid.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FItems gItems layout");
        }
    }

    private async Task PersistItemsGridLayoutAsync()
    {
        try
        {
            var ordered = ItemsGridLayout.Values
                .OrderBy(c => c.ColIndex ?? int.MaxValue)
                .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
                .ToList();
            await GridLayoutSvc.SaveGridLayoutAsync(FormName, $"{ItemsGridName}.{CurrentViewIndex}", null, ordered);
            await GridLayoutSvc.FlushPendingGridLayoutsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FItems gItems layout");
        }
    }

    // Field resolution (exact → normalized → alias → literal) is the presenter's
    // job now — the per-form reflection propmap + NormalizeGridKey were duplicates
    // of GridLayoutPresenter.NormalizeKey / ResolveField and have been removed.
    private string ResolveItemsGridField(string layoutField)
        => _itemsGrid.ResolveField(layoutField);

    // KEPT form-specific (NOT delegated to the presenter's ColumnTypeFor): the
    // VB6 IniGetGrid for FItems.gItems sets column data type by COLUMN NAME, not
    // by the ItemRow CLR type. IsQuote/UseInFieldPO are bool → CheckBox (matches
    // the presenter), but the _numericFields set also forces Number on columns
    // whose ItemRow property is a STRING (e.g. PriceLink) — so a pure type-based
    // mapping would mis-type them. The type-based branch below is only the
    // fallback after the two name-driven hashsets, and reuses the presenter's
    // shared normalized property lookup (PropFor) rather than a re-copied propmap.
    private static ColumnType GetColumnTypeForField(string field)
    {
        if (string.IsNullOrWhiteSpace(field))
            return ColumnType.Text;
        if (_checkboxFields.Contains(field))
            return ColumnType.CheckBox;
        if (_numericFields.Contains(field))
            return ColumnType.Number;

        var prop = GridLayoutPresenter<ItemRow>.PropFor(field);
        if (prop != null)
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool))
                return ColumnType.CheckBox;
            if (type == typeof(DateTime))
                return ColumnType.Date;
            if (type == typeof(byte) || type == typeof(short) || type == typeof(int) || type == typeof(long) ||
                type == typeof(float) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
        }

        return ColumnType.Text;
    }

    private static bool IsEditableField(string field, GridLayoutColumn layout)
    {
        if (layout.IsEditable)
            return true;

        return !_readOnlyFields.Contains(field);
    }

