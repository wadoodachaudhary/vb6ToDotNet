    // VB6 gItems Ctrl+Delete deletes the selected rows (mcITEM_DELETE). FlexKit's
    // grid keyboard handler has no Ctrl+Delete branch, so wire it host-side off the
    // grid-host wrapper's @onkeydown. The cell-selection callbacks mirror touched
    // rows into _selectedItems, so OnCtxDeleteItem() targets the same item set.
    private void OnItemsGridKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && (e.Key == "Delete" || e.Key == "Del"))
        {
            OnCtxDeleteItem();
        }
    }

    private void OnCtxDeleteItem()
    {
        CloseContextMenus();
        var targets = _selectedItems.Count > 0 ? _selectedItems.ToList() : (_ctxItem != null ? new List<ItemRow> { _ctxItem } : new List<ItemRow>());
        if (targets.Count == 0) return;

        // VB6 mcITEM_DELETE hides the rows (RowHidden=True, RowData="Deleted") so
        // they vanish immediately and the DELETE runs on Save. Marking RowState
        // alone left the rows visible — "Delete does nothing" (HHM-259). Move them
        // out of the grid into _deletedItems; SaveDataAsync deletes from there.
        foreach (var item in targets)
        {
            item.RowState = "Deleted";
            ItemsData.Remove(item);
            _deletedItems.Add(item);
        }
        mDirty = true;
        _selectedItems.Clear();
        SelectedItem = null;
        StateHasChanged();
    }

