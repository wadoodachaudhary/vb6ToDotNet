```razor
@page "/create-contract"
@rendermode InteractiveServer

@using HomeFront.Components.Grid
@using HomeFront.Data
@using System.Data
@using System.Globalization

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Add To Contract</PageTitle>

<style>
    .create-contract-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 40px);
        font-family: Arial, Helvetica, sans-serif;
    }
    .header-row {
        display: grid;
        grid-template-columns: 1fr 260px 1fr;
        gap: 12px;
        margin-bottom: 8px;
    }
    .section-title {
        font-weight: 700;
        color: #4a4a4a;
        padding-left: 4px;
    }
    .content-row {
        display: grid;
        grid-template-columns: 1fr 260px 1fr;
        gap: 12px;
        flex: 1;
        min-height: 0;
    }
    .panel {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
        padding: 8px;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }
    .view-select {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
        font-size: 13px;
    }
    .view-select select {
        padding: 4px 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 13px;
    }
    .addon-panel {
        margin-top: 12px;
        border-top: 1px solid #dee2e6;
        padding-top: 10px;
        font-size: 13px;
    }
    .addon-title {
        font-weight: 700;
        color: #4a4a4a;
        margin-bottom: 6px;
    }
    .addon-panel label {
        display: block;
        margin-bottom: 4px;
    }
    .footer {
        border-top: 1px solid #dee2e6;
        padding-top: 8px;
        margin-top: 8px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }
    .footer textarea {
        flex: 1;
        min-height: 70px;
        padding: 6px 10px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 13px;
    }
    .footer .buttons {
        display: flex;
        gap: 8px;
        margin-left: auto;
    }
    .footer .buttons button {
        padding: 6px 14px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #f8f9fa;
        cursor: pointer;
        font-size: 13px;
    }
    .footer .buttons button.primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }
</style>

<div class="create-contract-container">
    <div class="header-row">
        <div class="section-title">Unassigned Costs</div>
        <div class="section-title">Billing Level</div>
        <div class="section-title">Billing Items Preview</div>
    </div>

    <div class="content-row">
        <div class="panel">
            <div class="view-select">
                <label>View:</label>
                <select @onchange="OnViewChanged" value="@mViewIndex" disabled="@mChangeOrder">
                    @for (int i = 0; i < mViews.Count; i++)
                    {
                        <option value="@i">@mViews[i].Name</option>
                    }
                </select>
            </div>
            <HfTreeGrid @ref="AssembliesTree"
                        TValue="AssemblyNode"
                        DataSource="@AssemblyNodes"
                        IdMapping="NodeId"
                        ParentIdMapping="ParentId"
                        TreeColumnIndex="1"
                        AllowSelection="true"
                        Height="100%"
                        RowSelected="OnAssemblySelected">
                <HfTreeGridColumn Field="SelectedIcon" HeaderText="" Width="40px" />
                <HfTreeGridColumn Field="Node" HeaderText="Assembly" Width="260px" />
                <HfTreeGridColumn Field="Budgeted" HeaderText="Budgeted" Width="90px" Format="N2" TextAlign="TextAlign.Right" />
                <HfTreeGridColumn Field="Changes" HeaderText="Changes" Width="90px" Format="N2" TextAlign="TextAlign.Right" />
                <HfTreeGridColumn Field="Commited" HeaderText="Committed" Width="90px" Format="N2" TextAlign="TextAlign.Right" />
            </HfTreeGrid>
        </div>

        <div class="panel">
            <HfGrid TValue="GroupingItem"
                    DataSource="@GroupingItems"
                    AllowPaging="false"
                    AllowSorting="false"
                    AllowFiltering="false"
                    AllowSelection="false"
                    Height="260px"
                    EditSettingsRef="@groupingEditSettings"
                    EventsRef="@groupingEvents">
                <HfGridColumnsBase>
                    <HfGridColumn Field="Selected" HeaderText="" Width="40px" Type="ColumnType.CheckBox" />
                    <HfGridColumn Field="Description" HeaderText="Group By" Width="180px" />
                </HfGridColumnsBase>
            </HfGrid>

            <div class="addon-panel">
                <div class="addon-title">Addons</div>
                <label>
                    <input type="radio" name="addonMode" value="prorated"
                           checked="@IsAddonProrated" @onchange="OnAddonChanged" />
                    Prorated (hidden)
                </label>
                <label>
                    <input type="radio" name="addonMode" value="individual"
                           checked="@IsAddonIndividual" @onchange="OnAddonChanged" />
                    Billed individually
                </label>
            </div>
        </div>

        <div class="panel">
            <HfGrid @ref="BillingGrid"
                    TValue="BillingItemRow"
                    DataSource="@BillingItems"
                    AllowPaging="false"
                    AllowSorting="false"
                    AllowFiltering="false"
                    AllowSelection="false"
                    Height="100%">
                <HfGridColumnsBase>
                    <HfGridColumn Field="Description" HeaderText="Description" Width="240px" />
                    <HfGridColumn Field="Price" HeaderText="Price" Width="90px" Format="N2" TextAlign="TextAlign.Right" />
                    <HfGridColumn Field="TaxGroup" HeaderText="Tax Group" Width="80px" />
                    <HfGridColumn Field="RevenueAccount" HeaderText="Revenue Acct" Width="110px" />
                    <HfGridColumn Field="HoldbackRate" HeaderText="Holdback %" Width="90px" Format="N2" TextAlign="TextAlign.Right" />
                    <HfGridColumn Field="WhereClause" Visible="false" />
                </HfGridColumnsBase>
            </HfGrid>
        </div>
    </div>

    <div class="footer">
        @if (mChangeOrder)
        {
            <div style="flex:1;">
                <label style="font-size:13px; font-weight:600;">Change Order Comments</label>
                <textarea @bind="ChangeOrderComments"></textarea>
            </div>
        }
        <div class="buttons">
            <button class="primary" disabled="@(!CanSave)" @onclick="OnOkClick">OK</button>
            <button @onclick="OnCancelClick">Cancel</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Job { get; set; } = "";
    [Parameter] public bool ChangeOrder { get; set; }

    private readonly DbWrapperSqlServer db = new();

    private HfTreeGrid<AssemblyNode>? AssembliesTree;
    private HfGrid<BillingItemRow>? BillingGrid;

    private List<ViewDef> mViews = new();
    private List<AssemblyNode> AssemblyNodes = new();
    private List<BillingItemRow> BillingItems = new();
    private List<GroupingItem> GroupingItems = new();

    private readonly HfEditSettings groupingEditSettings = new() { AllowEditing = true, ShowConfirmDialog = false };
    private readonly HfGridEvents<GroupingItem> groupingEvents = new();

    private int mViewIndex;
    private string mViewQuery = "";
    private bool mChangeOrder;
    private string mJob = "";
    private string AddonMode = "individual";
    private string ChangeOrderComments = "";

    private Dictionary<int?, List<AssemblyNode>> childrenLookup = new();
    private int nodeIdCounter = 1;

    private const int DivisionId = 1;
    private bool UseQuickbooks = false;

    private bool CanSave => BillingItems.Count > 0;
    private bool IsAddonProrated => AddonMode == "prorated";
    private bool IsAddonIndividual => AddonMode == "individual";

    protected override async Task OnInitializedAsync()
    {
        groupingEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<GroupingItem>>(this, OnGroupingCellSave);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (mJob == Job && mChangeOrder == ChangeOrder) return;
        mJob = Job ?? "";
        mChangeOrder = ChangeOrder;
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        if (string.IsNullOrWhiteSpace(mJob)) return;
        LoadViews();
        await LoadFieldsAsync();
        await LoadAssembliesAsync();
        await LoadItemsAsync();
    }

    private void LoadViews()
    {
        mViews.Clear();
        if (mChangeOrder)
        {
            mViews.Add(new ViewDef
            {
                Name = "Change Requests",
                KeyFlds = "CORSort,EstAssemblyID",
                DisplayFlds = "CORNumber,HFDescription",
                SortFlds = "CORSort,EstAssemblyID",
                IconKeys = "option,assembly"
            });
        }
        else
        {
            mViews.Add(new ViewDef
            {
                Name = "Customer",
                KeyFlds = "Customer_No,CORSort,EstAssemblyID",
                DisplayFlds = "CustomerDesc,CORNumber,HFDescription",
                SortFlds = "Customer_No,CORSort,EstAssemblyID",
                IconKeys = "customer,option,assembly"
            });
            mViews.Add(new ViewDef
            {
                Name = "PO Group",
                KeyFlds = "POGroup,POIndex,PONumberVendor",
                DisplayFlds = "POGroup,case when POIndex=POIndexDescription then POIndex else POIndex + ' ' + POIndexDescription end,PONumber + ' - ' + POVendorName",
                SortFlds = "POGroup,POIndex,PONumberVendor",
                IconKeys = "folder,purchaseorder,sendpos"
            });
            mViews.Add(new ViewDef
            {
                Name = "PO Index",
                KeyFlds = "POIndex,PONumberVendor",
                DisplayFlds = "case when POIndex=POIndexDescription then POIndex else POIndex + ' ' + POIndexDescription end,PONumber + ' - ' + POVendorName",
                SortFlds = "POIndex,PONumberVendor",
                IconKeys = "purchaseorder,sendpos"
            });
            mViews.Add(new ViewDef
            {
                Name = "Purchase Orders",
                KeyFlds = "PONumber",
                DisplayFlds = "PONumber + CASE PONumber WHEN '' THEN '' ELSE ' -- ' + POVendorName END",
                SortFlds = "PONumber",
                IconKeys = "sendpos"
            });
            mViews.Add(new ViewDef
            {
                Name = "Vendor",
                KeyFlds = "POVendor,PONumber",
                DisplayFlds = "POVendorName,PONUmber + ' - ' + case when POIndex=POIndexDescription then POIndex else POIndex + ' ' + POIndexDescription end",
                SortFlds = "POVendor,PONumber",
                IconKeys = "vendor,sendpos"
            });
            mViews.Add(new ViewDef
            {
                Name = "Cost Code",
                KeyFlds = "JCExtra,JCCostCode,JCCategory",
                DisplayFlds = UseQuickbooks
                    ? "JCExtra,JCCostCodeDesc,JCCategoryDesc"
                    : "JCExtra,JCCostCode+' - '+JCCostCodeDesc,JCCategoryDesc",
                SortFlds = "JCExtra,JCCostCode,JCCategory",
                IconKeys = "folder,folder,folder"
            });
        }
        mViewIndex = 0;
    }

    private async Task LoadFieldsAsync()
    {
        GroupingItems.Clear();
        var dt = db.SqlExec("select * from tbljobs where DivisionID = @DivisionID and job_no = @Job",
            new { DivisionID = DivisionId, Job = mJob });
        if (dt.Rows.Count == 0) return;

        var row = dt.Rows[0];
        for (int i = 1; i <= 40; i++)
        {
            var desc = row[$"WBSdesc{i:00}"]?.ToString() ?? "";
            if (!string.IsNullOrWhiteSpace(desc))
            {
                GroupingItems.Add(new GroupingItem
                {
                    Description = desc.Trim(),
                    FieldName = $"wbs{i:00}",
                    Selected = false
                });
            }
        }
        if (GroupingItems.Count > 0)
            GroupingItems[0].Selected = true;
    }

    private async Task LoadAssembliesAsync()
    {
        AssemblyNodes.Clear();
        nodeIdCounter = 1;
        var view = mViews.Count > 0 ? mViews[mViewIndex] : null;
        if (view == null) return;

        string baseRowData = $"Job_No={QuoteValue(mJob, false)}";
        await AddAssemblyLevel(null, baseRowData, 0);

        BuildChildrenLookup();
        StateHasChanged();
    }

    private async Task AddAssemblyLevel(int? parentId, string parentRowData, int level)
    {
        var view = mViews[mViewIndex];
        int levels = GetLevels(view.DisplayFlds);
        if (level >= levels) return;

        string keyFld = GetField(view.KeyFlds, level);
        string displayFld = GetField(view.DisplayFlds, level);
        string sortFld = GetField(view.SortFlds, level);

        string sql = BuildAssemblyQuery(keyFld, displayFld, sortFld, parentRowData);
        var dt = db.SqlExec(sql);

        foreach (DataRow row in dt.Rows)
        {
            string keyValue = row[0]?.ToString() ?? "";
            string displayValue = (row[1]?.ToString() ?? "").Trim();
            if (string.IsNullOrWhiteSpace(displayValue)) displayValue = " -- ";

            var node = new AssemblyNode
            {
                NodeId = nodeIdCounter++,
                ParentId = parentId,
                Node = displayValue,
                KeyValue = keyValue,
                KeyField = keyFld,
                DisplayField = displayFld,
                Budgeted = ToDecimal(row["Budgeted"]),
                Changes = ToDecimal(row["Changes"]),
                Commited = ToDecimal(row["Commited"]),
                BudgetsLocked = ToInt(row["BudgetsLocked"]) != 0,
                IsChangeRequest = ToInt(row["IsChangeRequest"]) != 0,
                SelectedState = TriState.None,
                WhereClause = BuildNodeWhereClause(parentRowData, keyFld, keyValue)
            };

            AssemblyNodes.Add(node);

            if (level + 1 < levels)
                await AddAssemblyLevel(node.NodeId, node.WhereClause, level + 1);
        }
    }

    private void BuildChildrenLookup()
    {
        childrenLookup = AssemblyNodes.GroupBy(n => n.ParentId)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private async Task LoadItemsAsync()
    {
        BillingItems.Clear();

        var selectedFields = GroupingItems.Where(g => g.Selected).Select(g => g.FieldName).ToList();
        if (selectedFields.Count == 0)
        {
            StateHasChanged();
            return;
        }

        var whereClause = BuildSelectedWhereClause();
        if (whereClause == "1=2")
        {
            StateHasChanged();
            return;
        }

        var (descriptionExpr, groupExpr) = BuildGroupExpressions(selectedFields);

        string s = "";
        s += $"select artaxgroup,holdbackrate,{descriptionExpr}\n";
        s += "      ,sum(isnull(popretax,0)+isnull(pojctax,0)),revenueaccount\n";
        s += "  from estimateditems\n";
        if (mViewIndex == 0)
        {
            if (mChangeOrder)
                s += $" where ischangerequest=1 and {whereClause}\n";
            else
                s += $" where (ischangerequest=0 or ischange=0) and {whereClause}\n";
        }
        else
        {
            s += $" where ischange=0 and {whereClause}\n";
        }
        s += "   and billingitemid=0\n";
        s += $"group by revenueaccount,artaxgroup,holdbackrate,{groupExpr}\n";

        if (IsAddonIndividual)
        {
            s += "union all\n";
            s += $"select distinct artaxgroup,holdbackrate,a.title,a.amount,revenueaccount\n";
            s += "  from estimateditems i join addons a on a.assemblyid=i.estassemblyid\n";
            if (mChangeOrder)
                s += $" where i.ischangerequest=1 and {BuildSelectedWhereClause("i")}\n";
            else
                s += $" where i.ischangerequest=0 and {BuildSelectedWhereClause("i")}\n";
            s += "   and i.billingitemid=0\n";
            s += "   and a.Basis<>'Cost' and a.Basis<>'SubTotal'\n";
            s += "   and a.amount<>0\n";
            s += "union all\n";
            s += $"select distinct artaxgroup,holdbackrate,a.title,a.amount,revenueaccount\n";
            s += "  from estimateditems i join addons a on a.job=i.job_no\n";
            s += $" where i.ischangerequest=0 and {BuildSelectedWhereClause("i")}\n";
            s += "   and i.billingitemid=0\n";
            s += $"   and a.Job={QuoteValue(mJob, false)}\n";
            s += "   and a.assemblyid=0\n";
            s += "   and a.Basis<>'Cost' and a.Basis<>'SubTotal'\n";
            s += "   and a.amount<>0\n";
        }

        s += "order by 3";

        var dt = db.SqlExec(s);
        decimal total = 0;

        foreach (DataRow row in dt.Rows)
        {
            var desc = row[2]?.ToString() ?? "";
            var price = ToDecimal(row[3]);
            total += price;

            var itemWhere = mChangeOrder
                ? $"{whereClause} and ischangerequest=1 and {descriptionExpr} = {QuoteValue(desc, false)}"
                : $"{whereClause} and {descriptionExpr} = {QuoteValue(desc, false)}";

            BillingItems.Add(new BillingItemRow
            {
                TaxGroup = row[0]?.ToString() ?? "",
                HoldbackRate = ToDecimal(row[1]),
                Description = desc,
                Price = price,
                RevenueAccount = row[4]?.ToString() ?? "",
                WhereClause = itemWhere
            });
        }

        if (total != 0 && !mChangeOrder && IsAddonProrated)
        {
            var addonTotal = await GetAddonTotalAsync(BuildSelectedWhereClause("i"), false);
            if (addonTotal != 0)
                ApplyProration(addonTotal, total);
        }
        else if (total != 0 && mChangeOrder && IsAddonProrated)
        {
            var addonTotal = await GetChangeOrderAddonTotalAsync();
            if (addonTotal != 0)
                ApplyProration(addonTotal, total);
        }

        StateHasChanged();
    }

    private void ApplyProration(decimal addonTotal, decimal total)
    {
        decimal applied = 0;
        for (int i = 0; i < BillingItems.Count; i++)
        {
            var add = Math.Round((BillingItems[i].Price / total) * addonTotal, 2);
            applied += add;
            BillingItems[i].Price += add;
        }
        if (BillingItems.Count > 0)
        {
            BillingItems[^1].Price += addonTotal - applied;
        }
    }

    private async Task<decimal> GetAddonTotalAsync(string whereClauseAlias, bool changeOrder)
    {
        string s = "";
        s += "select\n";
        s += "isnull((select sum(distinct a.amount)\n";
        s += "  from estimateditems i join addons a on a.assemblyid=i.estassemblyid\n";
        s += $"  where i.ischangerequest=0 and {whereClauseAlias}\n";
        s += "   and i.billingitemid=0\n";
        s += "   and a.Basis<>'Cost' and a.Basis<>'SubTotal'\n";
        s += "   and a.amount<>0),0)\n";
        s += "+\n";
        s += "isnull((select sum(distinct a.amount)\n";
        s += "  from estimateditems i join addons a on a.job=i.job_no\n";
        s += $"  where i.ischangerequest=0 and {whereClauseAlias}\n";
        s += "   and i.billingitemid=0\n";
        s += $"   and a.Job={QuoteValue(mJob, false)}\n";
        s += "   and a.assemblyid=0\n";
        s += "   and a.Basis<>'Cost' and a.Basis<>'SubTotal'\n";
        s += "   and a.amount<>0),0)\n";

        var val = await db.ExecuteScalarAsync<decimal>(s);
        return val;
    }

    private async Task<decimal> GetChangeOrderAddonTotalAsync()
    {
        string s = "";
        s += "select sum(amount)\n";
        s += "  from addons\n";
        s += " where Basis<>'Cost' and Basis<>'SubTotal' and isnull(title,'')<>''\n";
        s += "   and amount<>0\n";
        s += "   and assemblyid in(select distinct estassemblyid\n";
        s += "                       from estimateditems\n";
        s += $"                      where ischangerequest=1 and billingitemid=0 and {BuildSelectedWhereClause()}\n";
        s += "                    )\n";

        var val = await db.ExecuteScalarAsync<decimal>(s);
        return val;
    }

    private async Task SaveDataAsync()
    {
        if (BillingItems.Count == 0) return;

        string co = "";
        if (mChangeOrder)
        {
            await db.ExecuteAsync("update tblcustomers set last_co=isnull(cast(last_co as integer),0)+1 where job_no=@Job",
                new { Job = mJob });
            await db.ExecuteAsync(
                "insert into changeordermaster(customer_no,change_order_no,purchasingco,usealtjccodes,Comments) " +
                "select customer_no,'CO '+cast(last_co as varchar(10)),1,1,@Comments from tblcustomers where job_no=@Job",
                new { Job = mJob, Comments = ChangeOrderComments });
            co = await db.ExecuteScalarAsync<string>(
                "select 'CO '+cast(last_co as varchar(10)) from tblcustomers where job_no=@Job", new { Job = mJob }) ?? "";
        }

        foreach (var item in BillingItems)
        {
            var existingId = await db.ExecuteScalarAsync<int?>(
                "select billingitemid from billingitems where job=@Job and description=@Desc",
                new { Job = mJob, Desc = item.Description });

            int id;
            if (existingId.HasValue && existingId.Value > 0)
            {
                id = existingId.Value;
            }
            else
            {
                var insertSql = @"
insert into billingitems(job,description,price,amtbilled,sortorder,taxgroup,revenueaccount,holdbackrate)
output inserted.billingitemid
values(@Job,@Desc,0,0,99999,@TaxGroup,@RevenueAccount,@HoldbackRate)";
                id = await db.ExecuteScalarAsync<int>(insertSql, new
                {
                    Job = mJob,
                    Desc = item.Description,
                    TaxGroup = item.TaxGroup,
                    RevenueAccount = item.RevenueAccount,
                    HoldbackRate = item.HoldbackRate
                });
                await db.ExecuteAsync("update billingitems set sortorder=billingitemid where billingitemid=@Id",
                    new { Id = id });
            }

            await db.ExecuteAsync("update billingitems set Price=Price+@Price where billingitemid=@Id",
                new { Price = item.Price, Id = id });

            await db.ExecuteAsync(
                $"update estimateitems set billingitemid=@Id where estitemid in(select estitemid from estimateditems where billingitemid=0 and {item.WhereClause})",
                new { Id = id });

            if (mChangeOrder)
            {
                await db.ExecuteAsync(
                    $"update estimateassemblies set changerequeststatus='', changeorder=@Co where estassemblyid in(select distinct estassemblyid from estimateditems where {item.WhereClause})",
                    new { Co = co });
            }
        }

        await JSRuntime.InvokeVoidAsync("alert", "Contract items saved.");
    }

    private async Task OnOkClick() => await SaveDataAsync();

    private void OnCancelClick() => NavigationManager.NavigateTo("/");

    private async Task OnViewChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx))
            mViewIndex = idx;
        await LoadAssembliesAsync();
        await LoadItemsAsync();
    }

    private async Task OnAddonChanged(ChangeEventArgs e)
    {
        AddonMode = e.Value?.ToString() ?? "individual";
        await LoadItemsAsync();
    }

    private async Task OnGroupingCellSave(CellSaveArgs<GroupingItem> args)
    {
        await LoadItemsAsync();
    }

    private async Task OnAssemblySelected(TreeRowSelectEventArgs<AssemblyNode> args)
    {
        if (args.Data == null) return;
        ToggleSelection(args.Data);
        await LoadItemsAsync();
    }

    private void ToggleSelection(AssemblyNode node)
    {
        node.SelectedState = node.SelectedState == TriState.All ? TriState.None : TriState.All;
        SetChildrenState(node, node.SelectedState);
        UpdateParentState(node.ParentId);
        StateHasChanged();
    }

    private void SetChildrenState(AssemblyNode node, TriState state)
    {
        if (!childrenLookup.TryGetValue(node.NodeId, out var children)) return;
        foreach (var child in children)
        {
            child.SelectedState = state;
            SetChildrenState(child, state);
        }
    }

    private void UpdateParentState(int? parentId)
    {
        if (parentId == null) return;
        var parent = AssemblyNodes.FirstOrDefault(n => n.NodeId == parentId);
        if (parent == null) return;

        if (!childrenLookup.TryGetValue(parent.NodeId, out var children) || children.Count == 0) return;

        if (children.All(c => c.SelectedState == TriState.All))
            parent.SelectedState = TriState.All;
        else if (children.All(c => c.SelectedState == TriState.None))
            parent.SelectedState = TriState.None;
        else
            parent.SelectedState = TriState.Some;

        UpdateParentState(parent.ParentId);
    }

    private (string DescriptionExpr, string GroupExpr) BuildGroupExpressions(List<string> fields)
    {
        var desc = string.Join(" + ', ' + ", fields.Select(f => $"isnull({f},'')"));
        var grp = string.Join(",", fields.Select(f => $"isnull({f},'')"));
        return (desc, grp);
    }

    private string BuildSelectedWhereClause(string prefix = "")
    {
        var clauses = new List<string>();
        foreach (var root in AssemblyNodes.Where(n => n.ParentId == null))
            CollectSelected(root, false, clauses);

        if (clauses.Count == 0) return "1=2";

        var parts = clauses.Select(c => "(" + ApplyPrefixToClause(c, prefix) + ")");
        return "(" + string.Join(" OR ", parts) + ")";
    }

    private void CollectSelected(AssemblyNode node, bool ancestorSelected, List<string> clauses)
    {
        bool selected = node.SelectedState == TriState.All;
        if (selected && !ancestorSelected && !string.IsNullOrWhiteSpace(node.WhereClause))
            clauses.Add(node.WhereClause);

        if (childrenLookup.TryGetValue(node.NodeId, out var children))
        {
            foreach (var child in children)
                CollectSelected(child, ancestorSelected || selected, clauses);
        }
    }

    private string ApplyPrefixToClause(string clause, string prefix)
    {
        if (string.IsNullOrWhiteSpace(prefix)) return clause;
        var parts = clause.Split(new[] { " AND " }, StringSplitOptions.None);
        var updated = parts.Select(p => PrefixPart(p, prefix));
        return string.Join(" AND ", updated);
    }

    private string PrefixPart(string part, string prefix)
    {
        var trimmed = part.Trim();
        if (string.IsNullOrWhiteSpace(trimmed)) return trimmed;
        int idx = trimmed.IndexOfAny(new[] { '=', '>', '<' });
        if (idx <= 0) return trimmed;
        var field = trimmed.Substring(0, idx).Trim();
        if (field.Contains(".") || field.Contains("(")) return trimmed;
        return $"{prefix}.{trimmed}";
    }

    private string BuildAssemblyQuery(string keyFld, string displayFld, string sortFld, string parentWhere)
    {
        string changeClause;
        if (mViewIndex == 0)
            changeClause = mChangeOrder
                ? "isnull(IsChangeRequest,0)=1"
                : "(isnull(IsChangeRequest,0)=1 or isnull(IsChange,0)=0)";
        else
            changeClause = "isnull(ischange,0)=0";

        string where = $"{changeClause} and isnull(billingitemid,0)=0";
        if (string.IsNullOrWhiteSpace(parentWhere))
            where += $" and Job_No={QuoteValue(mJob, false)}";
        else
            where += $" and {parentWhere}";

        string sql = "";
        sql += $"SELECT {keyFld},{displayFld}\n";
        sql += "      ,COUNT(*) TotalItems\n";
        sql += "      ,SUM(CASE WHEN IsChangeRequest=0 and BudgetDeleted<>1 THEN BudgetPretax + BudgetJCTax ELSE 0 END) Budgeted\n";
        sql += "      ,SUM(CASE WHEN IsChangeRequest=1 and BudgetDeleted<>1 THEN BudgetPretax + BudgetJCTax ELSE 0 END) Changes\n";
        sql += "      ,SUM(CASE WHEN POGenBatch=0 or poDeleted=1 THEN 0 ELSE POPretax+POJCTax END) Commited\n";
        sql += "      ,MIN(CAST(BudgetsLocked AS INT)) BudgetsLocked\n";
        sql += "      ,MIN(HFLocation) HFLocation\n";
        sql += "      ,MIN(IsChangeRequest) IsChangeRequest\n";
        sql += "  FROM Estimateditems\n";
        sql += $" WHERE {where}\n";

        if (!string.IsNullOrWhiteSpace(keyFld))
        {
            if (keyFld.Equals("EstAssemblyID", StringComparison.OrdinalIgnoreCase))
                sql += $"GROUP BY {keyFld},{displayFld},seq\n";
            else if (keyFld.Equals("ChangeOrder", StringComparison.OrdinalIgnoreCase))
                sql += $"GROUP BY {keyFld}\n";
            else if (keyFld.Equals("POIndex", StringComparison.OrdinalIgnoreCase))
                sql += "GROUP BY POIndex,POIndexDescription\n";
            else
                sql += $"GROUP BY {keyFld},{displayFld}\n";
        }

        if (sortFld.Equals("ChangeOrder", StringComparison.OrdinalIgnoreCase) ||
            sortFld.Equals("CORSort", StringComparison.OrdinalIgnoreCase))
            sql += "ORDER BY 1";
        else if (sortFld.Equals("Seq", StringComparison.OrdinalIgnoreCase))
            sql += "ORDER BY seq";
        else
            sql += "ORDER BY 2";

        mViewQuery = sql;
        return sql;
    }

    private string BuildNodeWhereClause(string parentWhere, string keyFld, string keyValue)
    {
        if (string.IsNullOrWhiteSpace(keyFld)) return parentWhere;
        var clause = string.IsNullOrWhiteSpace(parentWhere) ? "" : parentWhere + " AND ";
        clause += $"{keyFld} = {QuoteValue(keyValue, IsNumericKey(keyFld))}";
        return clause;
    }

    private bool IsNumericKey(string keyFld) =>
        keyFld.Equals("EstAssemblyID", StringComparison.OrdinalIgnoreCase) ||
        keyFld.Equals("EstimateIndex", StringComparison.OrdinalIgnoreCase) ||
        keyFld.Equals("POGroup", StringComparison.OrdinalIgnoreCase);

    private string QuoteValue(string value, bool numeric)
    {
        if (numeric) return string.IsNullOrWhiteSpace(value) ? "0" : value;
        return $"'{value.Replace("'", "''")}'";
    }

    private int GetLevels(string list) =>
        list.Split(',', StringSplitOptions.RemoveEmptyEntries).Length;

    private string GetField(string list, int index)
    {
        var parts = list.Split(',', StringSplitOptions.RemoveEmptyEntries);
        if (index < 0 || index >= parts.Length) return "";
        return parts[index].Trim();
    }

    private decimal ToDecimal(object? val) =>
        val == null || val == DBNull.Value ? 0 : Convert.ToDecimal(val, CultureInfo.InvariantCulture);

    private int ToInt(object? val) =>
        val == null || val == DBNull.Value ? 0 : Convert.ToInt32(val);

