```razor
@page "/create-hb-invoice/{Job?}"
@rendermode InteractiveServer

@using HomeFront.Components.Grid
@using HomeFront.Data
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>@FormTitle - HomeFront</PageTitle>

<style>
    .invoice-page {
        padding: 16px;
        font-family: Arial, Helvetica, sans-serif;
    }
    .header-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 12px;
    }
    .panel {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 12px;
        background: #fff;
    }
    .form-field {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 10px;
    }
    .form-field label {
        min-width: 110px;
        text-align: right;
        font-weight: 600;
        font-size: 13px;
        padding-top: 6px;
    }
    .form-input {
        flex: 1;
        padding: 5px 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 13px;
    }
    textarea.form-input {
        resize: vertical;
    }
    .grid-panel {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 8px;
        background: #fff;
        margin-bottom: 12px;
    }
    .button-row {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }
    .btn {
        padding: 6px 16px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 13px;
    }
    .btn-primary { background: #0d6efd; color: #fff; border-color: #0d6efd; }
    .btn-secondary { background: #6c757d; color: #fff; border-color: #6c757d; }
    .btn-success { background: #198754; color: #fff; border-color: #198754; }

    .grid-input, .grid-select {
        width: 100%;
        padding: 2px 6px;
        border: 1px solid #ced4da;
        border-radius: 3px;
        font-size: 12px;
    }

    .loading-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }
    .loading-box {
        background: #fff;
        padding: 16px 24px;
        border-radius: 6px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.2);
        font-size: 14px;
        font-weight: 600;
    }
</style>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-box">Loading Invoice Data...</div>
    </div>
}

<div class="invoice-page">
    <h3>@FormTitle</h3>

    <div class="header-grid">
        <div class="panel">
            <div class="form-field">
                <label>Invoice Date</label>
                <InputDate @bind-Value="InvoiceDate" class="form-input" />
            </div>
            <div class="form-field">
                <label>Description</label>
                <input class="form-input" maxlength="50" @bind="Description" />
            </div>
            <div class="form-field">
                <label>Due Date</label>
                <InputDate @bind-Value="DueDate" class="form-input" />
            </div>
            <div class="form-field">
                <label>Draw</label>
                <InputNumber @bind-Value="DrawAmount" class="form-input" step="0.01" />
            </div>
            <div class="form-field">
                <label>Terms</label>
                <textarea class="form-input" rows="3" maxlength="50" @bind="Terms"></textarea>
            </div>
        </div>
        <div class="panel">
            <div class="form-field">
                <label>Notes</label>
                <textarea class="form-input" rows="3" maxlength="50" @bind="Notes"></textarea>
            </div>
            <div class="form-field">
                <label>Scope of work</label>
                <textarea class="form-input" rows="3" maxlength="50" @bind="ScopeOfWork"></textarea>
            </div>
        </div>
    </div>

    <div class="grid-panel">
        <HfGrid @ref="ContractGrid"
                TValue="ContractRow"
                DataSource="@ContractData"
                AllowSorting="true"
                AllowResizing="true"
                AllowSelection="true"
                Height="380px">
            <HfGridColumnsBase>
                <HfGridColumn Field="@nameof(ContractRow.Invoice)" HeaderText="Invoice" Width="90px" AllowEditing="false" />
                <HfGridColumn Field="@nameof(ContractRow.BillingItemID)" HeaderText="BillingItemID" Visible="false" />
                <HfGridColumn Field="@nameof(ContractRow.Description)" HeaderText="Description" Width="280px" AllowEditing="false" />
                <HfGridColumn Field="@nameof(ContractRow.HoldBackAmount)" HeaderText="Holdback" Width="120px" TextAlign="TextAlign.Right">
                    <Template>
                        @{
                            var row = (ContractRow)context;
                        }
                        <InputNumber @bind-Value="row.HoldBackAmount" class="grid-input" step="0.01"
                                     @bind-Value:after="() => OnHoldBackAmountChanged(row)" />
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(ContractRow.TaxGroup)" HeaderText="Tax Group" Width="120px">
                    <Template>
                        @{
                            var row = (ContractRow)context;
                        }
                        <select class="grid-select" @bind="row.TaxGroup" @bind:after="() => OnTaxGroupChanged(row)">
                            <option value=""></option>
                            @foreach (var tg in TaxGroups)
                            {
                                <option value="@tg.TaxGroup">@tg.TaxGroup - @tg.Description</option>
                            }
                        </select>
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(ContractRow.TaxRate)" HeaderText="Tax Rate" Width="90px" TextAlign="TextAlign.Right">
                    <Template>
                        @{
                            var row = (ContractRow)context;
                        }
                        <InputNumber @bind-Value="row.TaxRate" class="grid-input" step="0.01"
                                     @bind-Value:after="() => OnTaxRateChanged(row)" />
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(ContractRow.Tax)" HeaderText="Tax" Width="90px" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                <HfGridColumn Field="@nameof(ContractRow.RevenueAccount)" HeaderText="Revenue Account" Width="140px">
                    <Template>
                        @{
                            var row = (ContractRow)context;
                        }
                        <select class="grid-select" @bind="row.RevenueAccount" @bind:after="() => OnRevenueAccountChanged(row)">
                            <option value=""></option>
                            @foreach (var acct in Accounts)
                            {
                                <option value="@acct.Account">@acct.Account - @acct.Description</option>
                            }
                        </select>
                    </Template>
                </HfGridColumn>
                <HfGridColumn Field="@nameof(ContractRow.RevenueAccountDesc)" HeaderText="Account Desc" Width="220px" AllowEditing="false" />
            </HfGridColumnsBase>
        </HfGrid>
    </div>

    <div class="button-row">
        <button class="btn btn-primary" @onclick="OnOkClick">OK</button>
        <button class="btn btn-secondary" @onclick="OnCancelClick">Cancel</button>
        <button class="btn btn-success" @onclick="OnSavePrintClick">Save &amp; Print</button>
    </div>
</div>

@code {
    [Parameter] public string? Job { get; set; }

    private readonly DbWrapperSqlServer db = new();
    private HfGrid<ContractRow>? ContractGrid;

    private const int DivisionID = 1;

    private string HoldbackDescription = "Holdback";
    private string FormTitle => $"Create {HoldbackDescription} Invoice";

    private bool IsLoading;
    private bool _loaded;

    private string mJob = "";
    private string mCustomer = "";
    private long mInvoice;

    private DateTime? InvoiceDate = DateTime.Today;
    private DateTime? DueDate;
    private decimal DrawAmount;
    private string Description = "";
    private string Terms = "";
    private string Notes = "";
    private string ScopeOfWork = "";

    private List<ContractRow> ContractData = new();
    private List<TaxGroupItem> TaxGroups = new();
    private List<AccountItem> Accounts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Job)) return;
        if (_loaded && Job == mJob) return;
        mJob = Job ?? "";
        await LoadDataAsync();
        _loaded = true;
    }

    private async Task LoadLookupsAsync()
    {
        var tgRows = await db.QueryAsync(
            "SELECT TaxGroup, Description, GroupRate FROM TaxGroups WHERE DivisionID=@DivisionID ORDER BY TaxGroup",
            new { DivisionID });
        TaxGroups = tgRows.Select(r => new TaxGroupItem
        {
            TaxGroup = r["TaxGroup"]?.ToString() ?? "",
            Description = r["Description"]?.ToString() ?? "",
            GroupRate = ToDecimal(r["GroupRate"])
        }).ToList();

        var acctRows = await db.QueryAsync(
            "SELECT Account, Description FROM GLAccounts WHERE DivisionID=@DivisionID ORDER BY Account",
            new { DivisionID });
        Accounts = acctRows.Select(r => new AccountItem
        {
            Account = r["Account"]?.ToString() ?? "",
            Description = r["Description"]?.ToString() ?? ""
        }).ToList();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            HoldbackDescription = await LoadHoldbackDescriptionAsync();
            Description = $"Bill {HoldbackDescription}";

            var custRows = await db.QueryAsync(
                "SELECT ar_customer_deposit FROM tblcustomers WHERE job_no=@Job",
                new { Job = mJob });
            mCustomer = custRows.FirstOrDefault()?["ar_customer_deposit"]?.ToString() ?? "";

            var sql = @"
                SELECT m.Job, i.billingitemid, m.ARCustomer, i.Invoice,
                       'Invoice '+CAST(i.Invoice AS varchar) AS Description,
                       SUM(i.HoldBackAmount-ISNULL(i.HoldBackBilled,0)) AS HoldBackAmount,
                       MIN(i.TaxRate) AS TaxRate, i.TaxGroup,
                       SUM(ROUND((i.HoldBackAmount-ISNULL(i.HoldBackBilled,0))*i.TaxRate/100,2)) AS Tax,
                       i.RevenueAccount, a.Description AS AccountDesc
                FROM arinvoiceitems i
                JOIN ArInvoices m ON i.invoice = m.invoice
                JOIN tbljobs j ON (m.job=j.job_no AND j.DivisionID = m.divisionID)
                LEFT OUTER JOIN glaccounts a ON (a.DivisionID = i.DivisionID AND a.account = ISNULL(NULLIF(i.revenueaccount,''),j.revenueaccount))
                WHERE i.DivisionID = @DivisionID
                  AND ROUND(ISNULL(i.HoldbackAmount,0)-ISNULL(i.HoldbackBilled,0),2)<>0
                  AND ISNULL(m.RetainageInvoice,0)=0
                  AND m.job=@Job
                GROUP BY m.Job, i.billingitemid, m.ARCustomer, i.Invoice,
                         'Invoice '+CAST(i.Invoice AS varchar), i.TaxGroup, i.RevenueAccount, a.Description
                ORDER BY i.Invoice";

            var rows = await db.QueryAsync(sql, new { DivisionID, Job = mJob });

            ContractData = rows.Select(r => new ContractRow
            {
                Invoice = ToLong(r["Invoice"]),
                BillingItemID = ToLong(r["BillingItemID"]),
                Description = r["Description"]?.ToString() ?? "",
                HoldBackAmount = ToDecimal(r["HoldBackAmount"]),
                TaxGroup = r["TaxGroup"]?.ToString() ?? "",
                TaxRate = ToDecimal(r["TaxRate"]),
                Tax = ToDecimal(r["Tax"]),
                RevenueAccount = r["RevenueAccount"]?.ToString() ?? "",
                RevenueAccountDesc = r["AccountDesc"]?.ToString() ?? ""
            }).ToList();

            InvoiceDate = DateTime.Today;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task<string> LoadHoldbackDescriptionAsync()
    {
        try
        {
            var value = await db.ExecuteScalarAsync<string>(
                "SELECT TOP 1 Value FROM SystemOptions WHERE Name='HoldbackDescription'");
            return string.IsNullOrWhiteSpace(value) ? "Holdback" : value.Trim();
        }
        catch
        {
            return "Holdback";
        }
    }

    private void OnHoldBackAmountChanged(ContractRow row)
    {
        row.HoldBackAmount = Math.Round(row.HoldBackAmount, 2);
        RecalcTax(row);
    }

    private void OnTaxRateChanged(ContractRow row)
    {
        row.TaxRate = Math.Round(row.TaxRate, 2);
        RecalcTax(row);
    }

    private void OnTaxGroupChanged(ContractRow row)
    {
        var tg = TaxGroups.FirstOrDefault(t => t.TaxGroup == row.TaxGroup);
        if (tg != null)
            row.TaxRate = tg.GroupRate;
        RecalcTax(row);
    }

    private void OnRevenueAccountChanged(ContractRow row)
    {
        var acct = Accounts.FirstOrDefault(a => a.Account == row.RevenueAccount);
        row.RevenueAccountDesc = acct?.Description ?? "";
    }

    private void RecalcTax(ContractRow row)
    {
        row.Tax = Math.Round(row.HoldBackAmount * row.TaxRate / 100m, 2);
    }

    private async Task OnOkClick()
    {
        if (await SaveDataAsync())
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Invoice {mInvoice} saved.");
            NavigateBack();
        }
    }

    private async Task OnSavePrintClick()
    {
        if (await SaveDataAsync())
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Invoice {mInvoice} saved. Print preview not implemented.");
            NavigateBack();
        }
    }

    private void OnCancelClick() => NavigateBack();

    private void NavigateBack() => NavigationManager.NavigateTo("/");

    private async Task<bool> SaveDataAsync()
    {
        if (InvoiceDate == null || string.IsNullOrWhiteSpace(Description))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Description and invoice date are required.");
            return false;
        }

        try
        {
            var insertInvoice = @"
                INSERT INTO arinvoices
                (DivisionID, invoicedate, description, Job, arcustomer, terms, scopeofwork, draw, DueDate, notes, RetainageInvoice)
                VALUES
                (@DivisionID, @InvoiceDate, @Description, @Job, @Customer, @Terms, @ScopeOfWork, @Draw, @DueDate, @Notes, 1);
                SELECT CAST(SCOPE_IDENTITY() AS bigint);";

            mInvoice = await db.ExecuteScalarAsync<long>(insertInvoice, new
            {
                DivisionID,
                InvoiceDate,
                Description,
                Job = mJob,
                Customer = mCustomer,
                Terms,
                ScopeOfWork,
                Draw = DrawAmount,
                DueDate,
                Notes
            });

            foreach (var row in ContractData.Where(r => r.HoldBackAmount != 0))
            {
                RecalcTax(row);

                var insertItem = @"
                    INSERT INTO arinvoiceitems
                    (DivisionID, invoice, OriginalInvoice, billingitemid, description, holdbackamount,
                     taxgroup, taxrate, RevenueAccount, tax, HoldBackBilled)
                    VALUES
                    (@DivisionID, @Invoice, @OriginalInvoice, @BillingItemID, @Description,
                     @HoldBackAmount, @TaxGroup, @TaxRate, @RevenueAccount, @Tax, @HoldBackBilled)";
                await db.ExecuteAsync(insertItem, new
                {
                    DivisionID,
                    Invoice = mInvoice,
                    OriginalInvoice = row.Invoice,
                    BillingItemID = row.BillingItemID,
                    Description = row.Description,
                    HoldBackAmount = -row.HoldBackAmount,
                    TaxGroup = row.TaxGroup ?? "",
                    TaxRate = row.TaxRate,
                    RevenueAccount = row.RevenueAccount ?? "",
                    Tax = row.Tax,
                    HoldBackBilled = row.HoldBackAmount
                });

                var updateBilling = @"
                    UPDATE billingitems
                    SET HoldbackTotalHeld = HoldbackTotalHeld - @HoldBackAmount
                    WHERE billingitemid = @BillingItemID";
                await db.ExecuteAsync(updateBilling, new
                {
                    HoldBackAmount = row.HoldBackAmount,
                    BillingItemID = row.BillingItemID
                });
            }

            return true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving invoice: {ex.Message}");
            return false;
        }
    }

    private static decimal ToDecimal(object? val)
    {
        if (val == null || val == DBNull.Value) return 0;
        return Convert.ToDecimal(val, CultureInfo.InvariantCulture);
    }

    private static long ToLong(object? val)
    {
        if (val == null || val == DBNull.Value) return 0;
        return Convert.ToInt64(val, CultureInfo.InvariantCulture);
    }

    private class ContractRow
    {
        public long Invoice { get; set; }
        public long BillingItemID { get; set; }
        public string Description { get; set; } = "";
        public decimal HoldBackAmount { get; set; }
        public string TaxGroup { get; set; } = "";
        public decimal TaxRate { get; set; }
        public decimal Tax { get; set; }
        public string RevenueAccount { get; set; } = "";
        public string RevenueAccountDesc { get; set; } = "";
    }

    private class TaxGroupItem
    {
        public string TaxGroup { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal GroupRate { get; set; }
    }

    private class AccountItem
    {
        public string Account { get; set; } = "";
        public string Description { get; set; } = "";
    }
}
```