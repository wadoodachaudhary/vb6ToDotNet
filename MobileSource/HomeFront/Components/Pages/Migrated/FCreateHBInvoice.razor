@page "/create-hb-invoice/{Job?}"
@namespace HomeFront.Components.Pages
@using HomeFront.Data
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using Fx.ControlKit.Notifications
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FCreateHBInvoice> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db
@layout HFComponent

<PageTitle>@FormTitle - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-box">Loading Invoice Data...</div>
    </div>
}

<div class="invoice-page">
    <h3>@FormTitle</h3>

    <div class="header-grid">
        <div class="panel">
            <div class="form-field">
                <label>Invoice Date</label>
                <InputDate @bind-Value="InvoiceDate" class="form-input" />
            </div>
            <div class="form-field">
                <label>Description</label>
                <TextBoxControl class="form-input" MaxLength="50" @bind-Value="Description" />
            </div>
            <div class="form-field">
                <label>Due Date</label>
                <InputDate @bind-Value="DueDate" class="form-input" />
            </div>
            <div class="form-field">
                <label>Draw</label>
                <NumericTextBoxControl TValue="decimal" @bind-Value="DrawAmount" CssClass="form-input" Step="0.01m" />
            </div>
            <div class="form-field">
                <label>Terms</label>
                <TextAreaControl CssClass="form-input" Rows="3" MaxLength="50" @bind-Value="Terms" />
            </div>
        </div>
        <div class="panel">
            <div class="form-field">
                <label>Notes</label>
                <TextAreaControl CssClass="form-input" Rows="3" MaxLength="50" @bind-Value="Notes" />
            </div>
            <div class="form-field">
                <label>Scope of work</label>
                <TextAreaControl CssClass="form-input" Rows="3" MaxLength="50" @bind-Value="ScopeOfWork" />
            </div>
        </div>
    </div>

    <div class="grid-panel">
        <GridControl @ref="ContractGrid"
                TValue="ContractRow"
                DataSource="@ContractData"
                AllowSorting="true"
                AllowResizing="true"
                AllowSelection="true"
                Height="380px">
            <GridColumnsBase>
                <GridColumn Field="@nameof(ContractRow.Invoice)" HeaderText="Invoice" Width="90px" AllowEditing="false" />
                <GridColumn Field="@nameof(ContractRow.BillingItemID)" HeaderText="BillingItemID" Visible="false" />
                <GridColumn Field="@nameof(ContractRow.Description)" HeaderText="Description" Width="280px" AllowEditing="false" />
                <GridColumn Field="@nameof(ContractRow.HoldBackAmount)" HeaderText="Holdback" Width="120px" TextAlign="TextAlign.Right">
                    <Template>
                        @{
                            var row = (ContractRow)context;
                        }
                        <NumericTextBoxControl TValue="decimal" Value="row.HoldBackAmount"
                                               ValueChanged="v => { row.HoldBackAmount = v; OnHoldBackAmountChanged(row); }"
                                               CssClass="grid-input" Step="0.01m" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ContractRow.TaxGroup)" HeaderText="Tax Group" Width="120px">
                    <Template>
                        @{
                            var row = (ContractRow)context;
                        }
                        <DropDownListControl TValue="string" TItem="TaxGroupOption"
                                             DataSource="TaxGroupOptions"
                                             TextFieldName="Display" ValueFieldName="TaxGroup"
                                             Value="row.TaxGroup"
                                             ValueChanged="v => { row.TaxGroup = v ?? string.Empty; OnTaxGroupChanged(row); }"
                                             CssClass="grid-select" Width="100%" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ContractRow.TaxRate)" HeaderText="Tax Rate" Width="90px" TextAlign="TextAlign.Right">
                    <Template>
                        @{
                            var row = (ContractRow)context;
                        }
                        <NumericTextBoxControl TValue="decimal" Value="row.TaxRate"
                                               ValueChanged="v => { row.TaxRate = v; OnTaxRateChanged(row); }"
                                               CssClass="grid-input" Step="0.01m" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ContractRow.Tax)" HeaderText="Tax" Width="90px" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                <GridColumn Field="@nameof(ContractRow.RevenueAccount)" HeaderText="Revenue Account" Width="140px">
                    <Template>
                        @{
                            var row = (ContractRow)context;
                        }
                        <DropDownListControl TValue="string" TItem="AccountOption"
                                             DataSource="AccountOptions"
                                             TextFieldName="Display" ValueFieldName="Account"
                                             Value="row.RevenueAccount"
                                             ValueChanged="v => { row.RevenueAccount = v ?? string.Empty; OnRevenueAccountChanged(row); }"
                                             CssClass="grid-select" Width="100%" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ContractRow.RevenueAccountDesc)" HeaderText="Account Desc" Width="220px" AllowEditing="false" />
            </GridColumnsBase>
        </GridControl>
    </div>

    @if (!string.IsNullOrWhiteSpace(ValidationMessage))
    {
        <div class="validation-message">@ValidationMessage</div>
    }

    <div class="button-row">
        <ButtonControl CssClass="btn btn-primary" OnClick="OnOkClick">OK</ButtonControl>
        <ButtonControl CssClass="btn btn-secondary" OnClick="OnCancelClick">Cancel</ButtonControl>
        <ButtonControl CssClass="btn btn-success" OnClick="OnSavePrintClick">Save &amp; Print</ButtonControl>
    </div>
</div>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    [Parameter] public string? Job { get; set; }
private GridControl<ContractRow>? ContractGrid;

    private string HoldbackDescription = "Holdback";
    private string FormTitle => $"Create {HoldbackDescription} Invoice";

    private bool IsLoading;
    private bool _loaded;
    private string ValidationMessage = "";

    private string mJob = "";
    private string mCustomer = "";
    private long mInvoice;

    private DateTime? InvoiceDate = DateTime.Today;
    private DateTime? DueDate;
    private decimal DrawAmount;
    private string Description = "";
    private string Terms = "";
    private string Notes = "";
    private string ScopeOfWork = "";

    private List<ContractRow> ContractData = new();
    private List<TaxGroupItem> TaxGroups = new();
    private List<AccountItem> Accounts = new();

    // Pre-projected option lists for the in-grid DropDownListControls. Each list
    // leads with a blank entry to preserve the original <option value=""></option>,
    // and carries a pre-formatted Display string identical to the old <option> text.
    private List<TaxGroupOption> TaxGroupOptions = new();
    private List<AccountOption> AccountOptions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Job)) return;
        if (_loaded && Job == mJob) return;
        mJob = Job ?? "";
        await LoadDataAsync();
        _loaded = true;
    }

    private async Task LoadLookupsAsync()
    {
        var tgRows = await db.QueryAsync(
            "SELECT TaxGroup, Description, GroupRate FROM TaxGroups WHERE DivisionID =@DivisionID ORDER BY TaxGroup",
            new { SessionState.DivisionID });
        TaxGroups = tgRows.Select(r => new TaxGroupItem
        {
            TaxGroup = r["TaxGroup"]?.ToString() ?? "",
            Description = r["Description"]?.ToString() ?? "",
            GroupRate = ToDecimal(r["GroupRate"])
        }).ToList();

        var acctRows = await db.QueryAsync(
            "SELECT Account, Description FROM GLAccounts WHERE DivisionID =@DivisionID ORDER BY Account",
            new { SessionState.DivisionID });
        Accounts = acctRows.Select(r => new AccountItem
        {
            Account = r["Account"]?.ToString() ?? "",
            Description = r["Description"]?.ToString() ?? ""
        }).ToList();

        // Projected option lists (blank entry first), display text matching the
        // former <option> markup: "<code> - <description>".
        TaxGroupOptions = new List<TaxGroupOption> { new() { TaxGroup = "", Display = "" } };
        TaxGroupOptions.AddRange(TaxGroups.Select(tg => new TaxGroupOption
        {
            TaxGroup = tg.TaxGroup,
            Display = $"{tg.TaxGroup} - {tg.Description}"
        }));

        AccountOptions = new List<AccountOption> { new() { Account = "", Display = "" } };
        AccountOptions.AddRange(Accounts.Select(acct => new AccountOption
        {
            Account = acct.Account,
            Display = $"{acct.Account} - {acct.Description}"
        }));
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            HoldbackDescription = await LoadHoldbackDescriptionAsync();
            Description = $"Bill {HoldbackDescription}";

            var custRows = await db.QueryAsync(
                "SELECT ar_customer_deposit FROM tblcustomers WHERE job_no=@Job",
                new { Job = mJob });
            mCustomer = custRows.FirstOrDefault()?["ar_customer_deposit"]?.ToString() ?? "";

            var sql = @"
                SELECT m.Job, i.billingitemid, m.ARCustomer, i.Invoice,
                       'Invoice '+CAST(i.Invoice AS varchar) AS Description,
                       SUM(i.HoldBackAmount-ISNULL(i.HoldBackBilled,0)) AS HoldBackAmount,
                       MIN(i.TaxRate) AS TaxRate, i.TaxGroup,
                       SUM(ROUND((i.HoldBackAmount-ISNULL(i.HoldBackBilled,0))*i.TaxRate/100,2)) AS Tax,
                       i.RevenueAccount, a.Description AS AccountDesc
                FROM arinvoiceitems i
                JOIN ArInvoices m ON i.invoice = m.invoice
                JOIN tbljobs j ON (m.job=j.job_no AND j.DivisionID = m.divisionID)
                LEFT OUTER JOIN glaccounts a ON (a.DivisionID = i.DivisionID AND a.account = ISNULL(NULLIF(i.revenueaccount,''),j.revenueaccount))
                WHERE i.DivisionID = @DivisionID
                  AND ROUND(ISNULL(i.HoldbackAmount,0)-ISNULL(i.HoldbackBilled,0),2)<>0
                  AND ISNULL(m.RetainageInvoice,0)=0
                  AND m.job=@Job
                GROUP BY m.Job, i.billingitemid, m.ARCustomer, i.Invoice,
                         'Invoice '+CAST(i.Invoice AS varchar), i.TaxGroup, i.RevenueAccount, a.Description
                ORDER BY i.Invoice";

            var rows = await db.QueryAsync(sql, new { SessionState.DivisionID, Job = mJob });

            ContractData = rows.Select(r => new ContractRow
            {
                Invoice = ToLong(r["Invoice"]),
                BillingItemID = ToLong(r["BillingItemID"]),
                Description = r["Description"]?.ToString() ?? "",
                HoldBackAmount = ToDecimal(r["HoldBackAmount"]),
                TaxGroup = r["TaxGroup"]?.ToString() ?? "",
                TaxRate = ToDecimal(r["TaxRate"]),
                Tax = ToDecimal(r["Tax"]),
                RevenueAccount = r["RevenueAccount"]?.ToString() ?? "",
                RevenueAccountDesc = r["AccountDesc"]?.ToString() ?? ""
            }).ToList();

            InvoiceDate = DateTime.Today;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task<string> LoadHoldbackDescriptionAsync()
    {
        try
        {
            var value = await db.ExecuteScalarAsync<string>(
                "SELECT TOP 1 Value FROM SystemOptions WHERE Name='HoldbackDescription'");
            return string.IsNullOrWhiteSpace(value) ? "Holdback" : value.Trim();
        }
        catch
        {
            return "Holdback";
        }
    }

    private void OnHoldBackAmountChanged(ContractRow row)
    {
        row.HoldBackAmount = Math.Round(row.HoldBackAmount, 2);
        RecalcTax(row);
    }

    private void OnTaxRateChanged(ContractRow row)
    {
        row.TaxRate = Math.Round(row.TaxRate, 2);
        RecalcTax(row);
    }

    private void OnTaxGroupChanged(ContractRow row)
    {
        var tg = TaxGroups.FirstOrDefault(t => t.TaxGroup == row.TaxGroup);
        if (tg != null)
            row.TaxRate = tg.GroupRate;
        RecalcTax(row);
    }

    private void OnRevenueAccountChanged(ContractRow row)
    {
        var acct = Accounts.FirstOrDefault(a => a.Account == row.RevenueAccount);
        row.RevenueAccountDesc = acct?.Description ?? "";
    }

    private void RecalcTax(ContractRow row)
    {
        row.Tax = Math.Round(row.HoldBackAmount * row.TaxRate / 100m, 2);
    }

    private async Task OnOkClick()
    {
        if (await SaveDataAsync())
        {
            NavigateBack();
        }
    }

    private async Task OnSavePrintClick()
    {
        if (await SaveDataAsync())
        {
            // VB6 printed via Crystal Reports (ARInvoice.rpt) with SessionState.DivisionID and Invoice parameters.
            // Crystal Reports printing is not available in Blazor; report integration is pending.
            NavigateBack();
        }
    }

    private void OnCancelClick() => NavigateBack();

    private void NavigateBack() => ClosePage();

    private async Task<bool> SaveDataAsync()
    {
        ValidationMessage = "";
        if (InvoiceDate == null || string.IsNullOrWhiteSpace(Description))
        {
            ValidationMessage = "Description and invoice date are required.";
            return false;
        }

        try
        {
            var insertInvoice = @"
                INSERT INTO arinvoices
                (DivisionID, invoicedate, description, Job, arcustomer, terms, scopeofwork, draw, DueDate, notes, RetainageInvoice)
                VALUES
                (@DivisionID, @InvoiceDate, @Description, @Job, @Customer, @Terms, @ScopeOfWork, @Draw, @DueDate, @Notes, 1);
                SELECT CAST(SCOPE_IDENTITY() AS bigint);";

            mInvoice = await db.ExecuteScalarAsync<long>(insertInvoice, new
            {
                SessionState.DivisionID,
                InvoiceDate,
                Description,
                Job = mJob,
                Customer = mCustomer,
                Terms,
                ScopeOfWork,
                Draw = DrawAmount,
                DueDate,
                Notes
            });

            foreach (var row in ContractData.Where(r => r.HoldBackAmount != 0))
            {
                RecalcTax(row);

                var insertItem = @"
                    INSERT INTO arinvoiceitems
                    (DivisionID, invoice, OriginalInvoice, billingitemid, description, holdbackamount,
                     taxgroup, taxrate, RevenueAccount, tax, HoldBackBilled)
                    VALUES
                    (@DivisionID, @Invoice, @OriginalInvoice, @BillingItemID, @Description,
                     @HoldBackAmount, @TaxGroup, @TaxRate, @RevenueAccount, @Tax, @HoldBackBilled)";
                await db.ExecuteAsync(insertItem, new
                {
                    SessionState.DivisionID,
                    Invoice = mInvoice,
                    OriginalInvoice = row.Invoice,
                    BillingItemID = row.BillingItemID,
                    Description = row.Description,
                    HoldBackAmount = -row.HoldBackAmount,
                    TaxGroup = row.TaxGroup ?? "",
                    TaxRate = row.TaxRate,
                    RevenueAccount = row.RevenueAccount ?? "",
                    Tax = row.Tax,
                    HoldBackBilled = row.HoldBackAmount
                });

                var updateBilling = @"
                    UPDATE billingitems
                    SET HoldbackTotalHeld = HoldbackTotalHeld - @HoldBackAmount
                    WHERE billingitemid = @BillingItemID";
                await db.ExecuteAsync(updateBilling, new
                {
                    HoldBackAmount = row.HoldBackAmount,
                    BillingItemID = row.BillingItemID
                });
            }

            return true;
        }
        catch (Exception ex)
        {
            ValidationMessage = $"Error saving invoice: {ex.Message}";
            return false;
        }
    }

    private static decimal ToDecimal(object? val)
    {
        if (val == null || val == DBNull.Value) return 0;
        return Convert.ToDecimal(val, CultureInfo.InvariantCulture);
    }

    private static long ToLong(object? val)
    {
        if (val == null || val == DBNull.Value) return 0;
        return Convert.ToInt64(val, CultureInfo.InvariantCulture);
    }

    private class ContractRow
    {
        public long Invoice { get; set; }
        public long BillingItemID { get; set; }
        public string Description { get; set; } = "";
        public decimal HoldBackAmount { get; set; }
        public string TaxGroup { get; set; } = "";
        public decimal TaxRate { get; set; }
        public decimal Tax { get; set; }
        public string RevenueAccount { get; set; } = "";
        public string RevenueAccountDesc { get; set; } = "";
    }

    private class TaxGroupItem
    {
        public string TaxGroup { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal GroupRate { get; set; }
    }

    private class AccountItem
    {
        public string Account { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private class TaxGroupOption
    {
        public string TaxGroup { get; set; } = "";
        public string Display { get; set; } = "";
    }

    private class AccountOption
    {
        public string Account { get; set; } = "";
        public string Display { get; set; } = "";
    }
}
