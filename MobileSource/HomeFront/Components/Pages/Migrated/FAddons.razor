@namespace HomeFront.Components.Pages
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data
@using System.Globalization
@using System.Text
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject ILogger<FAddons> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer _db

<div class="addons-container">
    <div class="addons-header">
        <h3>@HeaderTitle</h3>
        @if (!string.IsNullOrWhiteSpace(SubTitle))
        {
            <div class="addons-subtitle">@SubTitle</div>
        }
    </div>

    <div class="addons-toolbar">
        <ButtonControl CssClass="tbar-btn" OnClick="AddAddon">Add Addon</ButtonControl>
        <ButtonControl CssClass="tbar-btn" OnClick="InsertSubTotal">Insert Subtotal</ButtonControl>
        <ButtonControl CssClass="tbar-btn" Disabled="@(!CanDeleteSelected)" OnClick="DeleteSelected">Delete</ButtonControl>
        <ButtonControl CssClass="tbar-btn" Disabled="@(!_dirty)" OnClick="SaveClick">Save</ButtonControl>
    </div>

    <GridControl @ref="GridRef"
            TValue="AddonRow"
            DataSource="@Rows"
            AllowSelection="true"
            AllowSorting="true"
            AllowFiltering="false"
            AllowResizing="true"
            Height="600px"
            RowHeight="30"
            SelectionSettingsRef="@SelectionSettings"
            EventsRef="@GridEvents">
        <GridColumnsBase>
            <GridColumn Field="@nameof(AddonRow.Title)" HeaderText="Title" Width="220px">
                <Template>
                    @{
                        var row = (AddonRow)context;
                    }
                    <TextBoxControl Value="@row.Title"
                                    ValueChanged="v => OnTitleChanged(row, v)"
                                    Enabled="@(!IsTitleReadOnly(row))"
                                    CssClass="@($"grid-input {RowCss(row)}")" />
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(AddonRow.Basis)" HeaderText="Basis" Width="110px" AllowEditing="false">
                <Template>
                    @{
                        var row = (AddonRow)context;
                    }
                    <span class="@RowCss(row)">@row.Basis</span>
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(AddonRow.RateDisplay)" HeaderText="Rate" Width="110px">
                <Template>
                    @{
                        var row = (AddonRow)context;
                    }
                    <TextBoxControl Value="@row.RateDisplay"
                                    ValueChanged="v => OnRateChanged(row, v)"
                                    Enabled="@(!IsRateReadOnly(row))"
                                    CssClass="@($"grid-input {RowCss(row)}")" />
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(AddonRow.Amount)" HeaderText="Amount" Width="110px" TextAlign="TextAlign.Right">
                <Template>
                    @{
                        var row = (AddonRow)context;
                    }
                    <NumericTextBoxControl TValue="double"
                                           Value="@row.Amount"
                                           ValueChanged="v => OnAmountChanged(row, v)"
                                           Step="0.01m"
                                           Format="0.##"
                                           Enabled="@(!IsAmountReadOnly(row))"
                                           CssClass="@($"grid-input {RowCss(row)}")" />
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(AddonRow.Total)" HeaderText="Total" Width="110px" TextAlign="TextAlign.Right">
                <Template>
                    @{
                        var row = (AddonRow)context;
                    }
                    <span class="@RowCss(row)">@row.Total.ToString("N2")</span>
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(AddonRow.PercentOfTotal)" HeaderText="% of Total" Width="90px" TextAlign="TextAlign.Right">
                <Template>
                    @{
                        var row = (AddonRow)context;
                    }
                    <span class="@RowCss(row)">@row.PercentOfTotal.ToString("P1")</span>
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(AddonRow.Mat)" HeaderText="Mat" Width="60px" TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var row = (AddonRow)context;
                    }
                    <CheckBoxControl Checked="@row.Mat"
                                     CheckedChanged="v => { row.Mat = v; OnCostFlagsChanged(row); }"
                                     Disabled="@IsCostFlagReadOnly(row)"
                                     StopClickPropagation="true"
                                     StopMouseDownPropagation="true" />
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(AddonRow.Lab)" HeaderText="Lab" Width="60px" TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var row = (AddonRow)context;
                    }
                    <CheckBoxControl Checked="@row.Lab"
                                     CheckedChanged="v => { row.Lab = v; OnCostFlagsChanged(row); }"
                                     Disabled="@IsCostFlagReadOnly(row)"
                                     StopClickPropagation="true"
                                     StopMouseDownPropagation="true" />
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(AddonRow.Sub)" HeaderText="Sub" Width="60px" TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var row = (AddonRow)context;
                    }
                    <CheckBoxControl Checked="@row.Sub"
                                     CheckedChanged="v => { row.Sub = v; OnCostFlagsChanged(row); }"
                                     Disabled="@IsCostFlagReadOnly(row)"
                                     StopClickPropagation="true"
                                     StopMouseDownPropagation="true" />
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(AddonRow.Oth)" HeaderText="Oth" Width="60px" TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var row = (AddonRow)context;
                    }
                    <CheckBoxControl Checked="@row.Oth"
                                     CheckedChanged="v => { row.Oth = v; OnCostFlagsChanged(row); }"
                                     Disabled="@IsCostFlagReadOnly(row)"
                                     StopClickPropagation="true"
                                     StopMouseDownPropagation="true" />
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(AddonRow.Eq)" HeaderText="Eq" Width="60px" TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var row = (AddonRow)context;
                    }
                    <CheckBoxControl Checked="@row.Eq"
                                     CheckedChanged="v => { row.Eq = v; OnCostFlagsChanged(row); }"
                                     Disabled="@IsCostFlagReadOnly(row)"
                                     StopClickPropagation="true"
                                     StopMouseDownPropagation="true" />
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(AddonRow.AddonID)" Visible="false" />
            <GridColumn Field="@nameof(AddonRow.RateType)" Visible="false" />
            <GridColumn Field="@nameof(AddonRow.Percentage)" Visible="false" />
            <GridColumn Field="@nameof(AddonRow.Rate1)" Visible="false" />
            <GridColumn Field="@nameof(AddonRow.Rate2)" Visible="false" />
            <GridColumn Field="@nameof(AddonRow.LumpSumAmt)" Visible="false" />
            <GridColumn Field="@nameof(AddonRow.BaseAmount)" Visible="false" />
        </GridColumnsBase>
    </GridControl>
</div>

@code {
    [Parameter] public string Job { get; set; } = "";
    [Parameter] public long AssemblyId { get; set; }
    [Parameter] public int DivisionId { get; set; } = 1;

    private string HeaderTitle = "Addons";
    private string SubTitle = "";
    private bool _dirty;
    private string _lastJob = "";
    private long _lastAssemblyId;

    private double mMat;
    private double mLab;
    private double mSub;
    private double mOth;
    private double mEq;

    private GridControl<AddonRow>? GridRef;
    private readonly SelectionSettings SelectionSettings = new() { Mode = SelectionMode.Row, Type = SelectionType.Single };
    private readonly GridControlEvents<AddonRow> GridEvents = new();

    private List<AddonRow> Rows { get; set; } = new();
    private AddonRow? SelectedRow;

    protected override void OnInitialized()
    {
        GridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<AddonRow>>(this, OnRowSelected);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_lastJob, Job, StringComparison.OrdinalIgnoreCase) || _lastAssemblyId != AssemblyId)
        {
            _lastJob = Job ?? "";
            _lastAssemblyId = AssemblyId;
            await LoadContextAsync();
        }
    }

    private async Task LoadContextAsync()
    {
        if (string.IsNullOrWhiteSpace(Job))
        {
            Rows.Clear();
            return;
        }

        await LoadAssemblyTitleAsync();
        await LoadCostBasesAsync();
        await LoadDataAsync();
    }

    private async Task LoadAssemblyTitleAsync()
    {
        if (AssemblyId != 0)
        {
            var rows = await _db.QueryAsync(
                "SELECT hfdescription FROM estimateassemblies WHERE estassemblyid=@AssemblyId",
                new { AssemblyId });
            HeaderTitle = rows.FirstOrDefault()?["hfdescription"]?.ToString() ?? "Addons";
            SubTitle = $"Assembly {AssemblyId}";
        }
        else
        {
            HeaderTitle = "Addons";
            SubTitle = "Job";
        }
    }

    private async Task LoadCostBasesAsync()
    {
        mMat = mLab = mSub = mOth = mEq = 0;

        var sql = new StringBuilder();
        sql.AppendLine("select sum(e.budgetpretax+e.budgetjctax) pretax");
        sql.AppendLine("      ,isnull(nullif(i.costcategory,''),case c.costtype when 1 then 'L' when 2 then 'M' when 3 then 'S' when 4 then 'E' else 'O' end) CostType");
        sql.AppendLine("from estimateditems e");
        sql.AppendLine("     left outer join tblphaseitem i on(e.DivisionID = i.DivisionID and e.estphase=i.phase and e.estitem=i.item)");
        sql.AppendLine("     left outer join standardcategories c on(e.DivisionID = c.DivisionID and e.jccategory=c.category)");
        sql.AppendLine("where e.DivisionID = @DivisionID and isnull(e.Budgetdeleted,0) = 0 and e.job_no=@Job");
        if (AssemblyId == 0)
        {
            sql.AppendLine("  and e.isChangeRequest=0");
        }
        else
        {
            sql.AppendLine("  and e.estassemblyid=@AssemblyId");
        }
        sql.AppendLine("group by isnull(nullif(i.costcategory,''),case c.costtype when 1 then 'L' when 2 then 'M' when 3 then 'S' when 4 then 'E' else 'O' end)");

        var rows = await _db.QueryAsync(sql.ToString(), new { DivisionID = DivisionId, Job, AssemblyId });
        foreach (var row in rows)
        {
            var costType = row["CostType"]?.ToString() ?? "";
            var pretax = ToDouble(row["pretax"]);
            switch (costType)
            {
                case "M": mMat += pretax; break;
                case "L": mLab += pretax; break;
                case "E": mEq += pretax; break;
                case "S": mSub += pretax; break;
                default: mOth += pretax; break;
            }
        }
    }

    private async Task LoadDataAsync()
    {
        Rows.Clear();

        var rows = await _db.QueryAsync(
            "select * from addons where job=@Job and assemblyid=@AssemblyId order by sequence",
            new { Job, AssemblyId });

        foreach (var row in rows)
        {
            if (string.Equals(row["Basis"]?.ToString(), "Total", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            Rows.Add(new AddonRow
            {
                AddonID = ToLong(row["AddonID"]),
                Title = row["Title"]?.ToString() ?? "",
                Basis = row["Basis"]?.ToString() ?? "",
                RateType = ToInt(row["RateType"], 0),
                Percentage = ToDouble(row["Percentage"]),
                Rate1 = ToDouble(row["AmountPer1"]),
                Rate2 = ToDouble(row["AmountPer2"]),
                LumpSumAmt = ToDouble(row["LumpSumAmt"]),
                Mat = ToBool(row["Mat"]),
                Lab = ToBool(row["Lab"]),
                Sub = ToBool(row["Sub"]),
                Oth = ToBool(row["Oth"]),
                Eq = ToBool(row["Eq"])
            });
        }

        if (Rows.Count == 0)
        {
            Rows.Add(new AddonRow { Basis = "Cost", Lab = true, Title = "Labour", RateType = -1 });
            Rows.Add(new AddonRow { Basis = "Cost", Mat = true, Title = "Material", RateType = -1 });
            Rows.Add(new AddonRow { Basis = "Cost", Sub = true, Title = "Subcontract", RateType = -1 });
            Rows.Add(new AddonRow { Basis = "Cost", Eq = true, Title = "Equipment", RateType = -1 });
            Rows.Add(new AddonRow { Basis = "Cost", Oth = true, Title = "Other", RateType = -1 });
        }

        EnsureTotalRow();
        ReCalc();
        _dirty = false;
    }

    private async Task SaveClick()
    {
        await SaveDataAsync(false);
    }

    public async Task<bool> SaveDataAsync(bool prompt)
    {
        if (!_dirty && !prompt) return true;

        if (prompt)
        {
            var confirm = await Dialogs.ConfirmAsync("This data has changed. Do you want to save these changes?");
            if (!confirm) return false;
        }

        await _db.ExecuteAsync(
            "delete from addons where job=@Job and assemblyid=@AssemblyId",
            new { Job, AssemblyId });

        for (var i = 0; i < Rows.Count; i++)
        {
            var row = Rows[i];
            await _db.ExecuteAsync(@"
                insert into addons(Job, AssemblyID, Sequence, Title, Basis, RateType, Percentage, AmountPer1, AmountPer2, LumpSumAmt, Mat, Eq, Lab, Sub, Oth, amount, totalamount, PercentOfTotal)
                values(@Job, @AssemblyId, @Sequence, @Title, @Basis, @RateType, @Percentage, @Rate1, @Rate2, @LumpSumAmt, @Mat, @Eq, @Lab, @Sub, @Oth, @Amount, @TotalAmount, @PercentOfTotal)",
                new
                {
                    Job,
                    AssemblyId,
                    Sequence = i + 1,
                    Title = row.Title ?? "",
                    Basis = row.Basis ?? "",
                    RateType = row.RateType,
                    Percentage = row.Percentage,
                    Rate1 = row.Rate1,
                    Rate2 = row.Rate2,
                    LumpSumAmt = row.LumpSumAmt,
                    Mat = row.Mat ? 1 : 0,
                    Eq = row.Eq ? 1 : 0,
                    Lab = row.Lab ? 1 : 0,
                    Sub = row.Sub ? 1 : 0,
                    Oth = row.Oth ? 1 : 0,
                    Amount = row.Amount,
                    TotalAmount = row.Total,
                    PercentOfTotal = row.PercentOfTotal
                });
        }

        _dirty = false;
        return true;
    }

    private void AddAddon()
    {
        var row = new AddonRow
        {
            Title = "New Addon",
            Basis = "Category",
            RateType = 0,
            Percentage = 0,
            Mat = true,
            Lab = true,
            Sub = true,
            Oth = true,
            Eq = true
        };
        InsertBeforeTotal(row);
        ReCalc();
        MarkDirty();
    }

    private void InsertSubTotal()
    {
        var row = new AddonRow { Basis = "SubTotal", RateType = -1 };
        var index = GetInsertIndex();
        Rows.Insert(index, row);
        EnsureTotalRow();
        ReCalc();
        MarkDirty();
    }

    private void DeleteSelected()
    {
        if (SelectedRow == null) return;
        if (!CanDelete(SelectedRow)) return;
        Rows.Remove(SelectedRow);
        EnsureTotalRow();
        ReCalc();
        MarkDirty();
    }

    private void OnRowSelected(RowSelectEventArgs<AddonRow> args)
    {
        SelectedRow = args.Data;
    }

    private bool CanDelete(AddonRow row)
    {
        if (row.Basis.Equals("Cost", StringComparison.OrdinalIgnoreCase)) return false;
        if (row.Basis.Equals("Total", StringComparison.OrdinalIgnoreCase)) return false;
        return true;
    }

    private bool CanDeleteSelected => SelectedRow != null && CanDelete(SelectedRow);

    private int GetInsertIndex()
    {
        var totalIndex = Rows.FindIndex(r => r.Basis.Equals("Total", StringComparison.OrdinalIgnoreCase));
        if (totalIndex < 0) totalIndex = Rows.Count;

        if (SelectedRow == null) return totalIndex;
        var index = Rows.IndexOf(SelectedRow);
        if (index < 0 || index >= totalIndex) return totalIndex;
        return index;
    }

    private void InsertBeforeTotal(AddonRow row)
    {
        var totalIndex = Rows.FindIndex(r => r.Basis.Equals("Total", StringComparison.OrdinalIgnoreCase));
        if (totalIndex < 0)
        {
            Rows.Add(row);
            EnsureTotalRow();
            return;
        }

        Rows.Insert(totalIndex, row);
        EnsureTotalRow();
    }

    private void EnsureTotalRow()
    {
        var totalRows = Rows.Where(r => r.Basis.Equals("Total", StringComparison.OrdinalIgnoreCase)).ToList();
        foreach (var row in totalRows.Skip(1))
        {
            Rows.Remove(row);
        }

        if (!Rows.Any(r => r.Basis.Equals("Total", StringComparison.OrdinalIgnoreCase)))
        {
            Rows.Add(new AddonRow { AddonID = -1, Basis = "Total", RateType = -1 });
        }
        else
        {
            var total = Rows.Last(r => r.Basis.Equals("Total", StringComparison.OrdinalIgnoreCase));
            total.AddonID = -1;
        }
    }

    private void OnTitleChanged(AddonRow row, string? value)
    {
        row.Title = value ?? "";
        ReCalc();
        MarkDirty();
    }

    private void OnRateChanged(AddonRow row, string? value)
    {
        var input = (value ?? "").Trim();
        if (input.Contains("/", StringComparison.Ordinal))
        {
            var parts = input.Split('/', 2, StringSplitOptions.TrimEntries);
            row.Rate1 = ParseDouble(parts.ElementAtOrDefault(0));
            row.Rate2 = ParseDouble(parts.ElementAtOrDefault(1));
            row.RateType = 1;
        }
        else
        {
            var percText = input.Replace("%", "").Trim();
            row.Percentage = ParseDouble(percText);
            if (row.RateType != 0 && row.RateType != 3)
            {
                row.RateType = 0;
            }
        }

        ReCalc();
        MarkDirty();
    }

    private void OnAmountChanged(AddonRow row, object? value)
    {
        row.LumpSumAmt = ParseDouble(value);
        row.RateType = 2;
        row.Basis = "LumpSum";
        ReCalc();
        MarkDirty();
    }

    private void OnCostFlagsChanged(AddonRow row)
    {
        ReCalc();
        MarkDirty();
    }

    private void MarkDirty()
    {
        _dirty = true;
    }

    private void ReCalc()
    {
        var lastSubTotal = 0.0;
        var currentTotal = 0.0;
        var runningTotal = 0.0;

        foreach (var row in Rows)
        {
            row.IsBold = false;
            row.BaseAmount = 0;
            row.Amount = 0;
            row.Total = 0;
            row.PercentOfTotal = 0;

            row.RateDisplay = row.RateType switch
            {
                0 or 3 => $"{row.Percentage:0.##}%",
                1 => $"{row.Rate1:0.##} / {row.Rate2:0.##}",
                _ => ""
            };

            if (row.Basis.Equals("Cost", StringComparison.OrdinalIgnoreCase))
            {
                row.RateType = -1;
                row.RateDisplay = "";
            }
            else if (row.Basis.Equals("Subtotal", StringComparison.OrdinalIgnoreCase))
            {
                row.Title = "";
                row.RateDisplay = "";
            }
            else if (row.Basis.Equals("Total", StringComparison.OrdinalIgnoreCase))
            {
                row.Title = "Total";
                row.RateDisplay = "";
            }

            switch (row.Basis)
            {
                case "Category":
                case "Cost":
                    row.BaseAmount = 0;
                    if (row.Mat) row.BaseAmount += mMat;
                    if (row.Lab) row.BaseAmount += mLab;
                    if (row.Sub) row.BaseAmount += mSub;
                    if (row.Oth) row.BaseAmount += mOth;
                    if (row.Eq) row.BaseAmount += mEq;
                    ApplyMarkUp(row);
                    runningTotal += row.Amount;
                    currentTotal += row.Amount;
                    break;

                case "LumpSum":
                    row.BaseAmount = row.LumpSumAmt;
                    ApplyMarkUp(row);
                    runningTotal += row.Amount;
                    currentTotal += row.Amount;
                    break;

                case "RunningTotal":
                    row.BaseAmount = currentTotal;
                    ApplyMarkUp(row);
                    runningTotal += row.Amount;
                    currentTotal += row.Amount;
                    break;

                case "LastSubTotal":
                    row.BaseAmount = lastSubTotal;
                    ApplyMarkUp(row);
                    runningTotal += row.Amount;
                    currentTotal += row.Amount;
                    break;

                case "SubTotal":
                    row.Amount = runningTotal;
                    row.Total = currentTotal;
                    row.IsBold = true;
                    lastSubTotal = runningTotal;
                    runningTotal = 0;
                    break;

                case "Total":
                    row.Total = currentTotal;
                    row.IsBold = true;
                    break;
            }
        }

        for (var i = 0; i < Rows.Count; i++)
        {
            var row = Rows[i];
            if (row.Basis.Equals("Total", StringComparison.OrdinalIgnoreCase)) continue;
            row.PercentOfTotal = currentTotal == 0 ? 0 : row.Amount / currentTotal;
        }

        StateHasChanged();
    }

    private void ApplyMarkUp(AddonRow row)
    {
        var cost = row.BaseAmount;
        var rate = row.Percentage / 100;

        switch (row.RateType)
        {
            case -1:
                row.Amount = cost;
                break;
            case 1:
                row.Amount = row.Rate2 == 0 ? 0 : Math.Round(cost * row.Rate1 / row.Rate2, 2);
                break;
            case 2:
                row.Amount = cost;
                break;
            case 0:
                row.Amount = Math.Round(cost * rate, 2);
                break;
            case 3:
                if (Math.Abs(rate - 1) < 0.000001) rate = 0;
                row.Amount = (cost / (1 - rate)) - cost;
                break;
        }
    }

    private bool IsTitleReadOnly(AddonRow row) =>
        row.Basis.Equals("Cost", StringComparison.OrdinalIgnoreCase) ||
        row.Basis.Equals("SubTotal", StringComparison.OrdinalIgnoreCase) ||
        row.Basis.Equals("Total", StringComparison.OrdinalIgnoreCase);

    private bool IsRateReadOnly(AddonRow row) =>
        row.Basis.Equals("Cost", StringComparison.OrdinalIgnoreCase) ||
        row.Basis.Equals("SubTotal", StringComparison.OrdinalIgnoreCase) ||
        row.Basis.Equals("Total", StringComparison.OrdinalIgnoreCase) ||
        row.Basis.Equals("LumpSum", StringComparison.OrdinalIgnoreCase);

    private bool IsAmountReadOnly(AddonRow row) =>
        row.Basis.Equals("Cost", StringComparison.OrdinalIgnoreCase) ||
        row.Basis.Equals("SubTotal", StringComparison.OrdinalIgnoreCase) ||
        row.Basis.Equals("Total", StringComparison.OrdinalIgnoreCase);

    private bool IsCostFlagReadOnly(AddonRow row) =>
        !(row.Basis.Equals("Category", StringComparison.OrdinalIgnoreCase) ||
          row.Basis.Equals("Cost", StringComparison.OrdinalIgnoreCase));

    private string RowCss(AddonRow row) => row.IsBold ? "addon-bold" : "";

    private static double ToDouble(object? value)
    {
        if (value == null || value == DBNull.Value) return 0;
        double.TryParse(value.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var result);
        return result;
    }

    private static double ParseDouble(object? value)
    {
        if (value == null) return 0;
        double.TryParse(value.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var result);
        return result;
    }

    private static int ToInt(object? value, int defaultValue = 0)
    {
        if (value == null || value == DBNull.Value) return defaultValue;
        return int.TryParse(value.ToString(), out var result) ? result : defaultValue;
    }

    private static long ToLong(object? value)
    {
        if (value == null || value == DBNull.Value) return 0;
        return long.TryParse(value.ToString(), out var result) ? result : 0;
    }

    private static bool ToBool(object? value)
    {
        if (value == null || value == DBNull.Value) return false;
        if (value is bool b) return b;
        if (bool.TryParse(value.ToString(), out var parsed)) return parsed;
        if (int.TryParse(value.ToString(), out var i)) return i != 0;
        return false;
    }

    public class AddonRow
    {
        public long AddonID { get; set; }
        public string Title { get; set; } = "";
        public string Basis { get; set; } = "";
        public int RateType { get; set; }
        public double Percentage { get; set; }
        public double Rate1 { get; set; }
        public double Rate2 { get; set; }
        public double LumpSumAmt { get; set; }
        public bool Mat { get; set; }
        public bool Lab { get; set; }
        public bool Sub { get; set; }
        public bool Oth { get; set; }
        public bool Eq { get; set; }
        public double BaseAmount { get; set; }
        public double Amount { get; set; }
        public double Total { get; set; }
        public double PercentOfTotal { get; set; }
        public string RateDisplay { get; set; } = "";
        public bool IsBold { get; set; }
    }
}