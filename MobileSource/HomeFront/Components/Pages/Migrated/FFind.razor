```razor
@namespace HomeFront.Components.Pages
@rendermode InteractiveServer

@inject IJSRuntime JSRuntime

<style>
    .find-dialog-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .find-dialog {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        width: 440px;
        padding: 16px;
        font-family: sans-serif;
        font-size: 13px;
    }

    .find-dialog-title {
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 12px;
    }

    .find-row {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        gap: 8px;
    }

    .find-row label {
        min-width: 75px;
        text-align: right;
        font-size: 13px;
    }

    .find-row input[type="text"] {
        flex: 1;
        padding: 4px 8px;
        border: 1px solid #ced4da;
        border-radius: 3px;
        font-size: 13px;
    }

    .find-row input[type="text"]:focus {
        border-color: #86b7fe;
        outline: 0;
        box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.15);
    }

    .find-options-row {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 10px;
    }

    .find-checkboxes {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .find-checkboxes label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        cursor: pointer;
    }

    .find-checkboxes input[type="checkbox"] {
        width: 15px;
        height: 15px;
    }

    .find-direction {
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 8px 12px;
    }

    .find-direction-title {
        font-size: 12px;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 6px;
    }

    .find-direction label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        cursor: pointer;
        margin-bottom: 4px;
    }

    .find-direction input[type="radio"] {
        width: 15px;
        height: 15px;
    }

    .find-buttons {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-left: auto;
    }

    .find-buttons button {
        padding: 6px 20px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 13px;
        min-width: 90px;
    }

    .find-buttons button:hover:not(:disabled) {
        background: #e9ecef;
    }

    .find-buttons button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .find-buttons button.btn-primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }

    .find-buttons button.btn-primary:hover:not(:disabled) {
        background: #0b5ed7;
    }

    .find-not-found {
        color: #dc3545;
        font-size: 12px;
        margin-top: 6px;
        min-height: 18px;
    }
</style>

@if (Visible)
{
    <div class="find-dialog-overlay" @onclick="OnCancel" @onclick:stopPropagation="false">
        <div class="find-dialog" @onclick:stopPropagation="true">
            <div class="find-dialog-title">Find</div>

            <div class="find-row">
                <label for="txtFind">Find &amp;what:</label>
                <input id="txtFind" type="text" @bind="FindText" @bind:event="oninput"
                       @onkeydown="OnKeyDown" @ref="findTextInput" />
            </div>

            <div class="find-options-row">
                <div style="display: flex; flex-direction: column; gap: 8px; flex: 1;">
                    <div class="find-checkboxes">
                        <label>
                            <input type="checkbox" @bind="MatchWholeWord" disabled="@true" />
                            Match whole word only
                        </label>
                        <label>
                            <input type="checkbox" @bind="MatchCase" />
                            Match case
                        </label>
                    </div>

                    <div class="find-direction">
                        <div class="find-direction-title">Direction</div>
                        <label>
                            <input type="radio" name="direction" value="up"
                                   checked="@(!SearchDown)"
                                   @onchange="() => SearchDown = false" />
                            Up
                        </label>
                        <label>
                            <input type="radio" name="direction" value="down"
                                   checked="@SearchDown"
                                   @onchange="() => SearchDown = true" />
                            Down
                        </label>
                    </div>
                </div>

                <div class="find-buttons">
                    <button class="btn-primary" disabled="@(string.IsNullOrWhiteSpace(FindText))"
                            @onclick="OnFindNext">
                        Find Next
                    </button>
                    <button @onclick="OnCancel">Cancel</button>
                </div>
            </div>

            <div class="find-not-found">@NotFoundMessage</div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Whether the Find dialog is visible.
    /// </summary>
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>
    /// The data rows to search through. Each row is a list of cell strings.
    /// </summary>
    [Parameter]
    public List<List<string>> GridData { get; set; } = new();

    /// <summary>
    /// If true, search is performed only on column 0 (hierarchy/grouped mode).
    /// </summary>
    [Parameter]
    public bool IsGrouped { get; set; }

    /// <summary>
    /// The current column index to search when not grouped.
    /// </summary>
    [Parameter]
    public int CurrentColumn { get; set; }

    /// <summary>
    /// The current row index (search starts from the next/previous row relative to this).
    /// </summary>
    [Parameter]
    public int CurrentRow { get; set; }

    /// <summary>
    /// The number of fixed (header) rows to skip.
    /// </summary>
    [Parameter]
    public int FixedRows { get; set; } = 1;

    /// <summary>
    /// Fired when a match is found. Provides (rowIndex, colIndex).
    /// </summary>
    [Parameter]
    public EventCallback<FindResultEventArgs> OnFound { get; set; }

    /// <summary>
    /// Fired when the dialog is closed.
    /// </summary>
    [Parameter]
    public EventCallback OnClosed { get; set; }

    // Internal state
    private string FindText { get; set; } = "";
    private bool MatchWholeWord { get; set; } = false;
    private bool MatchCase { get; set; } = false;
    private bool SearchDown { get; set; } = true;
    private string NotFoundMessage { get; set; } = "";
    private ElementReference findTextInput;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible)
        {
            try
            {
                await findTextInput.FocusAsync();
            }
            catch
            {
                // Element may not be rendered yet
            }
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(FindText))
        {
            await OnFindNext();
        }
        else if (e.Key == "Escape")
        {
            await OnCancel();
        }
    }

    private async Task OnFindNext()
    {
        NotFoundMessage = "";

        if (string.IsNullOrWhiteSpace(FindText) || GridData == null || GridData.Count == 0)
            return;

        if (IsGrouped)
        {
            await FindNextHierarchy();
        }
        else
        {
            await FindNextSimple();
        }
    }

    private async Task FindNextSimple()
    {
        var searchText = MatchWholeWord ? FindText : $"*{FindText}*";
        var totalRows = GridData.Count;
        var col = CurrentColumn;

        if (totalRows == 0) return;

        int startRow = SearchDown
            ? Math.Min(Math.Max(FixedRows, CurrentRow + 1), totalRows - 1)
            : Math.Max(FixedRows, Math.Min(CurrentRow - 1, totalRows - 1));

        int endRow = SearchDown ? totalRows - 1 : FixedRows;
        int step = SearchDown ? 1 : -1;

        for (int r = startRow; SearchDown ? r <= endRow : r >= endRow; r += step)
        {
            if (r < 0 || r >= totalRows) break;
            var row = GridData[r];
            if (col < 0 || col >= row.Count) continue;

            var cellText = row[col] ?? "";
            if (IsMatch(cellText, searchText))
            {
                await RaiseFound(r, col);
                return;
            }
        }

        NotFoundMessage = $"Cannot find \"{FindText}\"";
        StateHasChanged();
    }

    private async Task FindNextHierarchy()
    {
        var searchText = MatchWholeWord ? FindText : $"*{FindText}*";
        var totalRows = GridData.Count;

        if (totalRows == 0) return;

        if (SearchDown)
        {
            for (int r = CurrentRow + 1; r < totalRows; r++)
            {
                var row = GridData[r];
                if (row.Count == 0) continue;
                var cellText = row[0] ?? "";
                if (IsMatch(cellText, searchText))
                {
                    await RaiseFound(r, 0);
                    return;
                }
            }
        }
        else
        {
            for (int r = CurrentRow - 1; r >= 0; r--)
            {
                var row = GridData[r];
                if (row.Count == 0) continue;
                var cellText = row[0] ?? "";
                if (IsMatch(cellText, searchText))
                {
                    await RaiseFound(r, 0);
                    return;
                }
            }
        }

        NotFoundMessage = $"Cannot find \"{FindText}\"";
        StateHasChanged();
    }

    private bool IsMatch(string cellText, string pattern)
    {
        // Pad with spaces to allow partial matching at boundaries (mirrors VB6 behavior)
        var padded = " " + cellText + " ";

        if (MatchCase)
        {
            return WildcardMatch(padded, pattern);
        }
        else
        {
            return WildcardMatch(padded.ToUpperInvariant(), pattern.ToUpperInvariant());
        }
    }

    /// <summary>
    /// Simple wildcard matching supporting * (any chars) and ? (single char),
    /// similar to VB6's Like operator for basic patterns.
    /// </summary>
    private static bool WildcardMatch(string text, string pattern)
    {
        int tIdx = 0, pIdx = 0;
        int tStar = -1, pStar = -1;

        while (tIdx < text.Length)
        {
            if (pIdx < pattern.Length && (pattern[pIdx] == '?' || pattern[pIdx] == text[tIdx]))
            {
                tIdx++;
                pIdx++;
            }
            else if (pIdx < pattern.Length && pattern[pIdx] == '*')
            {
                pStar = pIdx++;
                tStar = tIdx;
            }
            else if (pStar >= 0)
            {
                pIdx = pStar + 1;
                tIdx = ++tStar;
            }
            else
            {
                return false;
            }
        }

        while (pIdx < pattern.Length && pattern[pIdx] == '*')
            pIdx++;

        return pIdx == pattern.Length;
    }

    private async Task RaiseFound(int rowIndex, int colIndex)
    {
        NotFoundMessage = "";
        CurrentRow = rowIndex;

        if (OnFound.HasDelegate)
        {
            await OnFound.InvokeAsync(new FindResultEventArgs
            {
                RowIndex = rowIndex,
                ColIndex = colIndex
            });
        }
    }

    private async Task OnCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);

        if (OnClosed.HasDelegate)
        {
            await OnClosed.InvokeAsync();
        }
    }

    /// <summary>
    /// Event args returned when a match is found.
    /// </summary>
    public class FindResultEventArgs
    {
        public int RowIndex { get; set; }
        public int ColIndex { get; set; }
    }
}
