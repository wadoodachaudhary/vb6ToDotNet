@namespace HomeFront.Components.Pages

@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject ILogger<FFind> Logger
@inject NotificationService Notifications

@if (Visible)
{
    <DialogControl Visible="true" Header="Find" Width="440px" IsModal="true"
                   CssClass="find-dialog-host" OnClose="OnCancel">
        <ChildContent>
            <div class="find-row">
                @* TextBoxControl commits on @onchange (blur); the original input used
                   @bind:event="oninput" so the Find Next button enables as-you-type.
                   Drive live updates via the pass-through @oninput handler (TextBoxControl
                   tolerates unmatched attributes), and keep id="txtFind" + @onkeydown so
                   focus/select-all and Enter/Escape behave exactly as before. *@
                <label for="txtFind">Find &amp;what:</label>
                <TextBoxControl Value="@FindText" CssClass="find-text"
                                id="txtFind" @oninput="OnFindTextInput"
                                @onkeydown="OnKeyDown" />
            </div>

            <div class="find-options-row">
                <div class="find-options-left">
                    <div class="find-checkboxes">
                        <CheckBoxControl @bind-Checked="MatchWholeWord"
                                         Disabled="true" Label="Match whole word only" />
                        <CheckBoxControl @bind-Checked="MatchCase" Label="Match case" />
                    </div>

                    <div class="find-direction">
                        <div class="find-direction-title">Direction</div>
                        <RadioControl TValue="bool" Name="direction" Value="false"
                                      @bind-SelectedValue="SearchDown" Label="Up" />
                        <RadioControl TValue="bool" Name="direction" Value="true"
                                      @bind-SelectedValue="SearchDown" Label="Down" />
                    </div>
                </div>
            </div>

            <div class="find-not-found">@NotFoundMessage</div>
        </ChildContent>
        <FooterContent>
            @* Primary-action accent (was .btn-primary blue). ButtonControl renders its own
               <button>, which FFind's scoped CSS can't reach across the dialog-footer
               boundary, so the accent goes through the safe Style parameter (a real
               ButtonControl param, NOT an unmatched attribute). *@
            <ButtonControl CssClass="btn-primary" Disabled="@(string.IsNullOrWhiteSpace(FindText))"
                           Style="@(string.IsNullOrWhiteSpace(FindText) ? "" : "background:#0d6efd;color:#fff;border-color:#0d6efd;")"
                           OnClick="OnFindNext">
                Find Next
            </ButtonControl>
            <ButtonControl OnClick="OnCancel">Cancel</ButtonControl>
        </FooterContent>
    </DialogControl>
}

@code {
    /// <summary>
    /// Whether the Find dialog is visible.
    /// </summary>
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>
    /// The data rows to search through. Each row is a list of cell strings.
    /// </summary>
    [Parameter]
    public List<List<string>> GridData { get; set; } = new();

    /// <summary>
    /// If true, search is performed only on column 0 (hierarchy/grouped mode).
    /// </summary>
    [Parameter]
    public bool IsGrouped { get; set; }

    /// <summary>
    /// The current column index to search when not grouped.
    /// </summary>
    [Parameter]
    public int CurrentColumn { get; set; }

    /// <summary>
    /// The current row index (search starts from the next/previous row relative to this).
    /// </summary>
    [Parameter]
    public int CurrentRow { get; set; }

    /// <summary>
    /// The number of fixed (header) rows to skip.
    /// </summary>
    [Parameter]
    public int FixedRows { get; set; } = 1;

    /// <summary>
    /// Fired when a match is found. Provides (rowIndex, colIndex).
    /// </summary>
    [Parameter]
    public EventCallback<FindResultEventArgs> OnFound { get; set; }

    /// <summary>
    /// Fired when the dialog is closed.
    /// </summary>
    [Parameter]
    public EventCallback OnClosed { get; set; }

    // Internal state
    private string FindText { get; set; } = "";
    private bool MatchWholeWord { get; set; } = false;
    private bool MatchCase { get; set; } = false;
    private bool SearchDown { get; set; } = true;
    private string NotFoundMessage { get; set; } = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible)
        {
            try
            {
                // The find text box is now a FlexKit TextBoxControl, so its @ref is the
                // component (not a focusable ElementReference). Focus + select-all the
                // inner <input id="txtFind"> via JS, mirroring the VB6 SelectAll on GotFocus.
                await JSRuntime.InvokeVoidAsync("eval",
                    "(function(){var e=document.getElementById('txtFind');if(e){e.focus();e.select();}})()");
            }
            catch
            {
                // Element may not be rendered yet
            }
        }
    }

    // Live as-you-type binding for the find text (pass-through @oninput on TextBoxControl,
    // replacing the original <input @bind:event="oninput">). Keeps the Find Next button's
    // disabled state in sync with the typed text without waiting for blur.
    private void OnFindTextInput(ChangeEventArgs e)
    {
        FindText = e.Value?.ToString() ?? "";
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(FindText))
        {
            await OnFindNext();
        }
        else if (e.Key == "Escape")
        {
            await OnCancel();
        }
    }

    private async Task OnFindNext()
    {
        NotFoundMessage = "";

        if (string.IsNullOrWhiteSpace(FindText) || GridData == null || GridData.Count == 0)
            return;

        if (IsGrouped)
        {
            await FindNextHierarchy();
        }
        else
        {
            await FindNextSimple();
        }
    }

    private async Task FindNextSimple()
    {
        var searchText = MatchWholeWord ? FindText : $"*{FindText}*";
        var totalRows = GridData.Count;
        var col = CurrentColumn;

        if (totalRows == 0) return;

        int startRow = SearchDown
            ? Math.Min(Math.Max(FixedRows, CurrentRow + 1), totalRows - 1)
            : Math.Max(FixedRows, Math.Min(CurrentRow - 1, totalRows - 1));

        int endRow = SearchDown ? totalRows - 1 : FixedRows;
        int step = SearchDown ? 1 : -1;

        for (int r = startRow; SearchDown ? r <= endRow : r >= endRow; r += step)
        {
            if (r < 0 || r >= totalRows) break;
            var row = GridData[r];
            if (col < 0 || col >= row.Count) continue;

            var cellText = row[col] ?? "";
            if (IsMatch(cellText, searchText))
            {
                await RaiseFound(r, col);
                return;
            }
        }

        NotFoundMessage = $"Cannot find \"{FindText}\"";
        StateHasChanged();
    }

    private async Task FindNextHierarchy()
    {
        var searchText = MatchWholeWord ? FindText : $"*{FindText}*";
        var totalRows = GridData.Count;

        if (totalRows == 0) return;

        if (SearchDown)
        {
            for (int r = CurrentRow + 1; r < totalRows; r++)
            {
                var row = GridData[r];
                if (row.Count == 0) continue;
                var cellText = row[0] ?? "";
                if (IsMatch(cellText, searchText))
                {
                    await RaiseFound(r, 0);
                    return;
                }
            }
        }
        else
        {
            for (int r = CurrentRow - 1; r >= 0; r--)
            {
                var row = GridData[r];
                if (row.Count == 0) continue;
                var cellText = row[0] ?? "";
                if (IsMatch(cellText, searchText))
                {
                    await RaiseFound(r, 0);
                    return;
                }
            }
        }

        NotFoundMessage = $"Cannot find \"{FindText}\"";
        StateHasChanged();
    }

    private bool IsMatch(string cellText, string pattern)
    {
        // Pad with spaces to allow partial matching at boundaries (mirrors VB6 behavior)
        var padded = " " + cellText + " ";

        if (MatchCase)
        {
            return WildcardMatch(padded, pattern);
        }
        else
        {
            return WildcardMatch(padded.ToUpperInvariant(), pattern.ToUpperInvariant());
        }
    }

    /// <summary>
    /// Simple wildcard matching supporting * (any chars) and ? (single char),
    /// similar to VB6's Like operator for basic patterns.
    /// </summary>
    private static bool WildcardMatch(string text, string pattern)
    {
        int tIdx = 0, pIdx = 0;
        int tStar = -1, pStar = -1;

        while (tIdx < text.Length)
        {
            if (pIdx < pattern.Length && (pattern[pIdx] == '?' || pattern[pIdx] == text[tIdx]))
            {
                tIdx++;
                pIdx++;
            }
            else if (pIdx < pattern.Length && pattern[pIdx] == '*')
            {
                pStar = pIdx++;
                tStar = tIdx;
            }
            else if (pStar >= 0)
            {
                pIdx = pStar + 1;
                tIdx = ++tStar;
            }
            else
            {
                return false;
            }
        }

        while (pIdx < pattern.Length && pattern[pIdx] == '*')
            pIdx++;

        return pIdx == pattern.Length;
    }

    private async Task RaiseFound(int rowIndex, int colIndex)
    {
        NotFoundMessage = "";
        CurrentRow = rowIndex;

        if (OnFound.HasDelegate)
        {
            await OnFound.InvokeAsync(new FindResultEventArgs
            {
                RowIndex = rowIndex,
                ColIndex = colIndex
            });
        }
    }

    private async Task OnCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);

        if (OnClosed.HasDelegate)
        {
            await OnClosed.InvokeAsync();
        }
    }

    /// <summary>
    /// Event args returned when a match is found.
    /// </summary>
    public class FindResultEventArgs
    {
        public int RowIndex { get; set; }
        public int ColIndex { get; set; }
    }
}
