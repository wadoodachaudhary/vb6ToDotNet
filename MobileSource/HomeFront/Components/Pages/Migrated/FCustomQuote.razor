    // ── ColorizeItems (VB6 FCustomQuote.frm:1395) ─────────────
    // Detects per-row warnings + sets the ⚠ marker. The actual fore/back/bold/
    // italic styling is applied via GetItemRowCss → the scoped .cq-* classes.
    private void ColorizeItem(CustomQuoteItem row)
    {
        row.WarningMessage = RowHasWarnings(row) ? "⚠" : "";
    }

    private void ColorizeAllItems()
    {
        foreach (var item in ItemsData) ColorizeItem(item);
    }

    // VB6:1456-1460 — the five "not specified" checks that drive the ⚠ + invalid colour.
    private static bool RowHasWarnings(CustomQuoteItem row)
    {
        if (string.IsNullOrWhiteSpace(row.POIndex)) return true;
        if (string.IsNullOrWhiteSpace(row.JCCostCode)) return true;
        if (string.IsNullOrWhiteSpace(row.JCCategory)) return true;
        if (string.IsNullOrWhiteSpace(row.BudgetVendor)) return true;
        if (string.IsNullOrWhiteSpace(row.BudgetTaxGroup)) return true;
        return false;
    }

    // VB6 ColorizeItems precedence: LTZero → EQZero → NonSysRate(overridden) →
    // InvalidData (warnings, applied last so it wins). Returns the matching .cq-*
    // class names; the scoped CSS reads the DB-derived colours via var().
    private string? GetItemRowCss(CustomQuoteItem row, int index)
    {
        var classes = new List<string>();

        // less than zero — rate or qty < 0
        if (row.BudgetRate < 0 || row.BudgetQty < 0)
        {
            classes.Add("cq-ltzero");
            if (_fmtLtZeroBold) classes.Add("cq-ltzero-b");
            if (_fmtLtZeroItalic) classes.Add("cq-ltzero-i");
        }

        // equal to zero — pretax = 0
        if (row.BudgetPretax == 0)
        {
            classes.Add("cq-eqzero");
            if (_fmtEqZeroBold) classes.Add("cq-eqzero-b");
            if (_fmtEqZeroItalic) classes.Add("cq-eqzero-i");
        }

        // overridden (non-system) rate
        if (row.BudgetOverridden == "True")
        {
            classes.Add("cq-nonsys");
            if (_fmtNonSysBold) classes.Add("cq-nonsys-b");
            if (_fmtNonSysItalic) classes.Add("cq-nonsys-i");
        }

        // invalid data (warnings) — wins last in VB6
        if (RowHasWarnings(row))
        {
            classes.Add("cq-invalid");
            if (_fmtInvalidBold) classes.Add("cq-invalid-b");
            if (_fmtInvalidItalic) classes.Add("cq-invalid-i");
        }

        return classes.Count > 0 ? string.Join(" ", classes) : null;
    }

    // VB6 HFApp.Options(Format_*) — division-specific value wins via ORDER BY
    // DivisionID; missing rows fall back to VB6 design-time defaults.
    private async Task LoadAppOptionsAsync()
    {
        try
        {
            var opts = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            var dt = db.SqlExec(
                "SELECT OptionName, OptionValue FROM AppOptions WHERE DivisionID IN (0, @DivisionID) ORDER BY DivisionID",
                new { SessionState.DivisionID });
            foreach (DataRow r in dt.Rows)
                opts[r["OptionName"]?.ToString() ?? ""] = r["OptionValue"]?.ToString() ?? "";

            string Opt(string name, string fallback) =>
                opts.TryGetValue(name, out var v) && !string.IsNullOrEmpty(v) ? v : fallback;

            (_fmtLtZeroFg, _fmtLtZeroBg, _fmtLtZeroBold, _fmtLtZeroItalic) = ReadFormat(
                Opt("Format_QtyRateLTZero_ForeColor", "0"),
                Opt("Format_QtyRateLTZero_BackColor", "12640511"),
                Opt("Format_QtyRateLTZero_FontStyle", "Regular"));

            (_fmtEqZeroFg, _fmtEqZeroBg, _fmtEqZeroBold, _fmtEqZeroItalic) = ReadFormat(
                Opt("Format_QtyRateEQZero_ForeColor", "0"),
                Opt("Format_QtyRateEQZero_BackColor", "16773869"),
                Opt("Format_QtyRateEQZero_FontStyle", "Regular"));

            (_fmtNonSysFg, _fmtNonSysBg, _fmtNonSysBold, _fmtNonSysItalic) = ReadFormat(
                Opt("Format_NonSysRate_ForeColor", "8404992"),
                Opt("Format_NonSysRate_BackColor", "16777215"),
                Opt("Format_NonSysRate_FontStyle", "Bold Italic"));

            (_fmtInvalidFg, _fmtInvalidBg, _fmtInvalidBold, _fmtInvalidItalic) = ReadFormat(
                Opt("Format_InvalidData_ForeColor", "255"),
                Opt("Format_InvalidData_BackColor", "16777215"),
                Opt("Format_InvalidData_FontStyle", "Bold"));

            _optZeroRateOnChangeVendor = OptBool(Opt("ZeroRateOnChangeVendor", "False"));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadAppOptions error");
        }
    }

    private static bool OptBool(string v) =>
        v == "1" || v.Equals("True", StringComparison.OrdinalIgnoreCase);

    private static (string fore, string back, bool bold, bool italic) ReadFormat(
        string foreColor, string backColor, string fontStyle)
    {
        var bold = fontStyle.IndexOf("Bold", StringComparison.OrdinalIgnoreCase) >= 0;
        var italic = fontStyle.IndexOf("Italic", StringComparison.OrdinalIgnoreCase) >= 0;
        return (BgrToHex(foreColor), BgrToHex(backColor), bold, italic);
    }

    // VB6 OLE_COLOR is a BGR long (&H00BBGGRR — low byte is Red).
    private static string BgrToHex(string bgrValue)
    {
        if (!long.TryParse(bgrValue, NumberStyles.Any, CultureInfo.InvariantCulture, out var bgr))
            return "transparent";
        var r = (int)(bgr & 0xFF);
        var g = (int)((bgr >> 8) & 0xFF);
        var b = (int)((bgr >> 16) & 0xFF);
        return $"#{r:X2}{g:X2}{b:X2}";
    }

    // ═══ In-grid cell pickers (VB6 gItems_CellButtonClick:1066) ═══════════
    private static readonly HashSet<string> _lookupPickerFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "JCExtra", "JCCostCode", "JCCostCodeDesc", "JCCategory", "JCCategoryDesc",
        "OrderUOM", "BudgetVendor", "BudgetVendorName", "BudgetTaxGroup", "POIndex"
    };

    private static readonly HashSet<string> _popupTextFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "ItemDesc", "ItemComments"
    };

    private CustomQuoteItem? _gridPickRow;
    private string _gridPickField = "";
    private string _pickListContext = "";

    // ── Popup text editor (VB6 FComments.Edit) ────────────────
    private bool ShowTextEditor = false;
    private string TextEditorTitle = "";
    private string TextEditorValue = "";
    private int TextEditorMaxLength = 2000;
    private CustomQuoteItem? _textEditorRow;
    private string _textEditorField = "";

    // Standard FlexKit edit-button dispatch (replaces the old per-cell native "…"
    // buttons). Routes by column to the SAME handler the native button called:
    // popup-text fields → OnEditPopupField (FComments.Edit), every other field →
    // OnPickLookupField (gItems_CellButtonClick). args.Data is the clicked row.
    // mReadOnly is still enforced inside both handlers, exactly as the native
    // buttons' disabled="@mReadOnly" did.
    private async Task OnGridEditButtonClick(CellEditButtonArgs<CustomQuoteItem> args)
    {
        if (args.Data == null) return;
        var field = args.ColumnName ?? "";
        if (_popupTextFields.Contains(field))
            OnEditPopupField(args.Data, field);
        else
            await OnPickLookupField(args.Data, field);
    }

    private void OnEditPopupField(CustomQuoteItem row, string field)
    {
        if (mReadOnly) return;
        _textEditorRow = row;
        _textEditorField = field;
        switch (field)
        {
            case "ItemDesc":
                TextEditorTitle = "Description";
                TextEditorValue = row.ItemDesc;
                TextEditorMaxLength = 200;     // VB6: FComments.Edit(s, gItems, , "Description", 200)
                break;
            case "ItemComments":
                TextEditorTitle = "Comments";
                TextEditorValue = row.ItemComments;
                TextEditorMaxLength = 2000;    // VB6: FComments.Edit(s, gItems, , , 2000)
                break;
        }
        ShowTextEditor = true;
        StateHasChanged();
    }

    private void OnTextEditorOk()
    {
        if (_textEditorRow != null)
        {
            switch (_textEditorField)
            {
                case "ItemDesc": _textEditorRow.ItemDesc = TextEditorValue; break;
                case "ItemComments": _textEditorRow.ItemComments = TextEditorValue; break;
            }
            // VB6 calls gItems_AfterEdit after the popup edit; ItemDesc/ItemComments have no recalc.
            mDirty = true;
            if (_textEditorRow.RowState != "NEW") _textEditorRow.RowState = "DIRTY";
            ColorizeItem(_textEditorRow);
        }
        ShowTextEditor = false;
        _textEditorRow = null;
        StateHasChanged();
    }

    private void OnTextEditorCancel()
    {
        ShowTextEditor = false;
        _textEditorRow = null;
    }

    // VB6 gItems_CellButtonClick — open FPickList for the clicked field.
    private async Task OnPickLookupField(CustomQuoteItem row, string field)
    {
        if (pickList == null || mReadOnly) return;
        _gridPickRow = row;
        _gridPickField = field;
        _pickListContext = "GridCell";

        switch (field)
        {
            case "JCExtra":
                // VB6: select Extra,Description from jcm_master__extra where job=FormatJob(Job_No)
                await pickList.Open("Extra",
                    "SELECT Extra, Description FROM jcm_master__extra WHERE job = @Job",
                    defaultItem: row.JCExtra,
                    parameters: new Dictionary<string, object> { ["Job"] = FormatJob(string.IsNullOrWhiteSpace(row.Job_No) ? mJob : row.Job_No) });
                break;

            case "JCCostCode":
                await pickList.Open("Cost Code",
                    "SELECT CostCode, Description FROM StandardCostCodes WHERE DivisionID=@DivisionID",
                    defaultItem: row.JCCostCode,
                    parameters: DivParam());
                break;
            case "JCCostCodeDesc":
                await pickList.Open("Cost Code",
                    "SELECT Description, CostCode FROM StandardCostCodes WHERE DivisionID=@DivisionID",
                    defaultItem: row.JCCostCodeDesc,
                    parameters: DivParam());
                break;

            case "JCCategory":
                await pickList.Open("Category",
                    "SELECT Category, Description FROM StandardCategories WHERE DivisionID=@DivisionID",
                    defaultItem: row.JCCategory,
                    parameters: DivParam());
                break;
            case "JCCategoryDesc":
                await pickList.Open("Category",
                    "SELECT Description, Category FROM StandardCategories WHERE DivisionID=@DivisionID",
                    defaultItem: row.JCCategoryDesc,
                    parameters: DivParam());
                break;

            case "OrderUOM":
                await pickList.Open("Units",
                    "SELECT DISTINCT OrderUOM Unit FROM tblPhaseItem WHERE DivisionID=@DivisionID",
                    defaultItem: row.OrderUOM,
                    parameters: DivParam());
                break;

            case "BudgetVendor":
                await pickList.Open("Vendor", BuildVendorViews(companyFirst: false),
                    defaultItem: row.BudgetVendor,
                    parameters: BuildVendorParams(row));
                break;
            case "BudgetVendorName":
                await pickList.Open("Vendor", BuildVendorViews(companyFirst: true),
                    defaultItem: row.BudgetVendorName,
                    parameters: BuildVendorParams(row));
                break;

            case "BudgetTaxGroup":
                await pickList.Open("Tax Groups",
                    "SELECT TaxGroup, Description FROM TaxGroups WHERE DivisionID=@DivisionID",
                    defaultItem: row.BudgetTaxGroup,
                    parameters: DivParam());
                break;

            case "POIndex":
                await pickList.Open("PO Index",
                    "SELECT POIndex FROM tblPOIndex WHERE DivisionID=@DivisionID",
                    defaultItem: row.POIndex,
                    parameters: DivParam());
                break;
        }
    }

    private Dictionary<string, object> DivParam() => new() { ["DivisionID"] = SessionState.DivisionID };

    // VB6 vendor picker is two views joined by Chr(0); FPickList uses '|' between
    // views and ';' between name and SQL. companyFirst swaps the first SELECT
    // column so the grid's first column matches the field that was clicked.
    private string BuildVendorViews(bool companyFirst)
    {
        var approvedCols = companyFirst
            ? "v.Vendor_Name Company, v.Vendor_ID Vendor, v.City, v.Phone"
            : "v.Vendor_ID Vendor, v.Vendor_Name Company, v.City, v.Phone";
        var allCols = companyFirst
            ? "Vendor_Name Company, Vendor_ID Vendor, City, Phone"
            : "Vendor_ID Vendor, Vendor_Name Company, City, Phone";

        var approved =
            $"SELECT DISTINCT {approvedCols} FROM tblVendors v " +
            "JOIN tblVendorCost c ON (v.Vendor_ID = c.Vendor and v.DivisionID = c.DivisionID) " +
            "WHERE v.DivisionID = @DivisionID " +
            "AND (ISNULL(Community,'') = '' OR Community = @Community) " +
            "AND (ISNULL(Assembly,'') = '' OR Assembly = @Assembly) " +
            "AND Phase = @EstPhase AND Item = @EstItem";
        var all = $"SELECT {allCols} FROM tblVendors WHERE DivisionID = @DivisionID";

        return $"Approved Vendors;{approved}|All Vendors;{all}";
    }

