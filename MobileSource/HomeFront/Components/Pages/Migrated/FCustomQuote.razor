    // VB6 gItems_SelChange (FCustomQuote.frm:1266): when more than one row is selected
    // (.Row <> .RowSel), sum BudgetPretax and BudgetJCTax across the selected range and
    // surface Pretax / Tax / Total. VB6 shows it as a floating tooltip; the no-JS
    // equivalent is the live status line rendered above the bottom panel.
    private void OnGridSelectionChanged(int count)
    {
        if (ItemsGrid == null) { _selCount = 0; return; }
        var selected = ItemsGrid.GetSelectedRecords().ToList();
        _selCount = selected.Count;
        if (_selCount > 1)
        {
            _selPretax = selected.Sum(i => i.BudgetPretax);
            _selTax = selected.Sum(i => i.BudgetJCTax);
        }
        else
        {
            _selPretax = 0;
            _selTax = 0;
        }
        StateHasChanged();
    }

