    private async Task ApplyGridCellPick(IDictionary<string, object> picked)
    {
        if (_gridPickRow == null) return;
        var item = _gridPickRow;
        string ColV(string name) => picked.ContainsKey(name) ? picked[name]?.ToString() ?? "" : "";

        switch (_gridPickField)
        {
            case "JCExtra":
                item.JCExtra = ColV("Extra");
                break;
            case "JCCostCode":
            case "JCCostCodeDesc":
                item.JCCostCode = ColV("CostCode");
                item.JCCostCodeDesc = ColV("Description");
                break;
            case "JCCategory":
            case "JCCategoryDesc":
                item.JCCategory = ColV("Category");
                item.JCCategoryDesc = ColV("Description");
                break;
            case "OrderUOM":
                item.OrderUOM = ColV("OrderUOM");
                if (string.IsNullOrEmpty(item.OrderUOM)) item.OrderUOM = ColV("Unit");
                break;
            case "BudgetVendor":
            case "BudgetVendorName":
                item.BudgetVendor = ColV("Vendor");
                item.BudgetVendorName = ColV("Company");
                break;
            case "BudgetTaxGroup":
                item.BudgetTaxGroup = ColV("TaxGroup");
                break;
            case "POIndex":
                item.POIndex = ColV("POIndex");
                break;
        }

        // VB6 calls gItems_AfterEdit(Row, col) after every CellButtonClick → run the recalc.
        await RecalculateAfterEdit(item, _gridPickField);

        mDirty = true;
        if (item.RowState != "NEW") item.RowState = "DIRTY";
        ColorizeItem(item);
        CalcTotals();
    }

