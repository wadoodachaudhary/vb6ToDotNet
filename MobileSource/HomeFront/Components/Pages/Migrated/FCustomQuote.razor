    // VB6 Toolbar "Preview" (FCustomQuote.frm:736): loads CustomPreEstimate.rpt and sets
    // params DivisionID / vCustomer / Seq, then PrintPreview. Migrated to the same Crystal-XML
    // report-viewer host FQuote uses: seed the record-selection params and navigate to
    // /report-viewer/<xml>. The report's XML (CustomPreEstimate.xml) record-selection formula
    // is {CustomPreEstimateItems.CustomerNO}={?vcustomer} and {CustomPreEstimateItems.Seq}={?Seq};
    // DivisionID is auto-injected by ReportWriterControl. ReportSeeds is one-shot (FRptViewer
    // consumes + clears in OnAfterRenderAsync). VB6 doesn't gate Preview on save, but a dirty
    // quote must be flushed first so the report reads committed CustomPreEstimateItems rows.
    private async Task OnPreviewClick()
    {
        if (mDirty && !await SaveDataAsync(true)) return;

        var xmlPath = System.IO.Path.Combine(
            WebHost.WebRootPath ?? "wwwroot",
            "resources", "Estimating", "Reports", "xml",
            "CustomPreEstimate.xml");

        // Seed the record-selection keys so the viewer's parameter dialog skips them
        // (matched case-insensitively against the report's {?vcustomer} / {?Seq} params).
        ReportSeeds.Set("vCustomer", mCustomer);
        ReportSeeds.Set("Seq", mSeq.ToString(CultureInfo.InvariantCulture));

        var route = $"/report-viewer/{Uri.EscapeDataString(xmlPath)}";
        if (ParentNavigate != null)
            ParentNavigate.Invoke(route);          // stays inside FMain shell
        else
            NavigationManager.NavigateTo(route);   // standalone fallback
    }

