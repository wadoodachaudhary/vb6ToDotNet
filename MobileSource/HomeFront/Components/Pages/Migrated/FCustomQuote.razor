    // VB6 AddItem (FCustomQuote.frm:635): adds a takeoff-sourced row.
    public void AddItem(string assembly, string assemblyDescription, string model, string phase, string item, long sequence, string description,
                        double orderQty, string orderUom, double takeoffQty, string takeoffUom, double conversionFactor,
                        double roundTo, long roundDir, long wastePercent, string jcExtra, string jcCostCode,
                        string jcCostCodeDesc, string jcCategory, string jcCategoryDesc, string vendor,
                        string vendorName, double price, string taxGroup, string taxGroupName, double jcTaxRate,
                        double njcTaxRate, string poIndex, string comments, string formula, double salesQty,
                        string location, string[] wbs, string? job = null)
    {
        var row = new CustomQuoteItem
        {
            RowState = "NEW",
            Selected = false,
            Customer_No = mCustomer,
            Seq = mSeq,
            Location = mLocation,
            Assembly = assembly,
            HFDescription = mAssemblyDesc,
            Model = model,
            Job_No = mJob,
            JCExtra = mExtra,
            EstPhase = phase,
            EstItem = item,
            ItemDesc = description,
            ConversionFactor = (decimal)conversionFactor,
            JCCostCode = jcCostCode,
            JCCostCodeDesc = jcCostCodeDesc,
            JCCategory = jcCategory,
            JCCategoryDesc = jcCategoryDesc,
            POIndex = poIndex,
            RoundTo = (decimal)roundTo,
            RoundDir = (int)roundDir,
            WastePercent = (decimal)wastePercent,
            ItemComments = comments,
            TakeoffQty = (decimal)takeoffQty,
            TakeoffUOM = takeoffUom,
            OrderUOM = orderUom,
            OptionID = mOptionID,
            BudgetQty = (decimal)orderQty,
            BudgetVendor = vendor,
            BudgetVendorName = vendorName,
            BudgetRate = (decimal)price,
            BudgetPretax = Math.Round((decimal)orderQty * (decimal)price, 2),
            BudgetTaxGroup = taxGroup,
            BudgetJCTaxRate = (decimal)jcTaxRate,
            BudgetNJCTaxRate = (decimal)njcTaxRate,
            RoomLocation = location
        };
        row.BudgetJCTax = Math.Round(row.BudgetPretax * row.BudgetJCTaxRate / 100, 2);
        row.BudgetNJCTax = Math.Round(row.BudgetPretax * row.BudgetNJCTaxRate / 100, 2);
        row.BudgetTax = row.BudgetJCTax + row.BudgetNJCTax;

        for (var i = 1; i <= 40 && i <= wbs.Length; i++)
            row.SetWbs(i, wbs[i - 1]);

        ColorizeItem(row);
        ItemsData.Add(row);
        mDirty = true;
        CalcTotals();
    }

    private static decimal ToDecimal(object? value) => value == null || value == DBNull.Value ? 0 : Convert.ToDecimal(value);
    private static int ToInt(object? value) => value == null || value == DBNull.Value ? 0 : Convert.ToInt32(value);
    private static double ToDouble(object? value)
    {
        if (value == null || value == DBNull.Value) return 0;
        if (value is double d) return d;
        if (value is float f) return f;
        if (value is decimal dec) return (double)dec;
        return double.TryParse(value.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var result) ? result : 0;
    }

    // VB6 RoundTo(value, roundTo, roundDir) — round up / down / nearest to a multiple.
    private static double RoundToValue(double value, double roundTo, int roundDir)
    {
        if (roundTo <= 0) return value;
        var quotient = value / roundTo;
        if (Math.Abs(quotient - Math.Round(quotient)) < 1e-12) return value;
        if (roundDir > 0) return Math.Ceiling(quotient) * roundTo;
        if (roundDir < 0) return Math.Floor(quotient) * roundTo;
        return Math.Round(quotient) * roundTo;
    }

