@page "/custom-quote"
@rendermode InteractiveServer

@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using HomeFront.Components.Pages
@using HomeFront.Data
@using System.Data
@using System.Globalization
@using System.Linq
@using System.Reflection
@using HomeFront.Services
@using HomeFront.Models

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FCustomQuote> Logger
@inject NotificationService Notifications
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db
@inject IReportSeedParameters ReportSeeds
@inject IWebHostEnvironment WebHost

<PageTitle>Custom Option Quote</PageTitle>

<div class="toolbar-cntr">
    <button class="tbar-btn" disabled="@(!CanSave)" @onclick="OnSaveClick">
        <span>💾</span>
        <span class="tool-label">Save</span>
    </button>
    <button class="tbar-btn" @onclick="OnPreviewClick">
        <span>🖨</span>
        <span class="tool-label">Preview</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" disabled="@mReadOnly" @onclick='() => OnTakeoffClick("OneTime")'>
        <span class="tool-label">One Time</span>
    </button>
    <button class="tbar-btn" disabled="@mReadOnly" @onclick='() => OnTakeoffClick("Item")'>
        <span class="tool-label">Item</span>
    </button>
    <button class="tbar-btn" disabled="@mReadOnly" @onclick='() => OnTakeoffClick("Assembly")'>
        <span class="tool-label">Assembly</span>
    </button>
    <button class="tbar-btn" disabled="@mReadOnly" @onclick='() => OnTakeoffClick("Custom")'>
        <span class="tool-label">Custom</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" @onclick="OnAttachmentsClick">
        <span class="tool-label">Attachments</span>
    </button>
</div>

<div class="content-layout">
    @* ── ITEMS GRID ────────────────────────────────────────────
       VB6 ColorizeItems (FCustomQuote.frm:1395) sets per-row fore/back/bold/italic
       from the AppOptions Format_* values. RowCssClassSelector returns class names;
       the DB-derived colours are surfaced as CSS custom properties on the host and
       the scoped .cq-* classes (FCustomQuote.razor.css) consume them via var() — so
       the colours stay DB-driven, never hardcoded. *@
    <div class="grid-panel cq-items-host" style="@ItemsHostStyle"
         @oncontextmenu="OnItemsContextMenu" @oncontextmenu:preventDefault="true">
        <GridControl @ref="ItemsGrid"
                TValue="CustomQuoteItem"
                DataSource="@ItemsData"
                AllowSelection="true"
                AllowSorting="true"
                AllowFiltering="false"
                AllowGrouping="false"
                AllowResizing="true"
                EnableHover="true"
                Height="100%"
                RowHeight="34"
                RowCssClassSelector="@GetItemRowCss"
                SelectionSettingsRef="@selectionSettings"
                EditSettingsRef="@editSettings"
                EventsRef="@gridEvents">
            <GridColumnsBase @key="gItemsLayoutVersion">
                <GridColumn Field="@nameof(CustomQuoteItem.RowState)" Visible="false" />
                @if (HasGridLayout)
                {
                    foreach (var entry in GetOrderedGridLayout())
                    {
                        var layout = entry.Layout;
                        var fieldName = entry.Field;
                        var columnType = entry.ColumnType;
                        var textAlign = entry.TextAlign;
                        var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                        var width = layout.Width.HasValue && layout.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                            : null;
                        var format = GetFormatForField(fieldName, columnType);
                        var allowEdit = IsFieldEditable(fieldName);

                        @* ── Long-text fields: display + popup-button (VB6 FComments.Edit) ──
                           Standard FlexKit edit-button pattern: templateless, AllowEditing=false +
                           AlwaysShowEditButton; the "…" routes through gridEvents.OnEditButtonClick →
                           OnGridEditButtonClick → OnEditPopupField. ClipMode.Ellipsis replaces the old
                           truncate+title; the displayed value is the raw Field property, unchanged. *@
                        if (_popupTextFields.Contains(fieldName))
                        {
                            <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width"
                                          AllowEditing="false"
                                          ShowEditButton="true"
                                          AlwaysShowEditButton="true"
                                          ClipMode="ClipMode.Ellipsis"
                                          Visible="true" />
                        }
                        @* ── Lookup fields with … button (VB6 gItems_CellButtonClick) ──
                           Standard FlexKit edit-button pattern; "…" routes through
                           gridEvents.OnEditButtonClick → OnGridEditButtonClick → OnPickLookupField.
                           Displayed value is the raw Field property, so it is unchanged. *@
                        else if (_lookupPickerFields.Contains(fieldName))
                        {
                            <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width"
                                          AllowEditing="false"
                                          ShowEditButton="true"
                                          AlwaysShowEditButton="true"
                                          ClipMode="ClipMode.Ellipsis"
                                          Visible="true" />
                        }
                        else
                        {
                            <GridColumn Field="@fieldName"
                                          HeaderText="@headerText"
                                          Width="@width"
                                          Type="@columnType"
                                          TextAlign="@textAlign"
                                          Format="@format"
                                          AllowEditing="@allowEdit"
                                          ClipMode="ClipMode.Ellipsis"
                                          Visible="true" />
                        }
                    }
                }
                else
                {
                    @* Fallback: hardcoded columns when no AppGridLayout exists *@
                    <GridColumn Field="@nameof(CustomQuoteItem.POIndex)" HeaderText="PO Index [gItems FALLBACK]" Width="80px"
                                  AllowEditing="false"
                                  ShowEditButton="true"
                                  AlwaysShowEditButton="true"
                                  ClipMode="ClipMode.Ellipsis" />
                    <GridColumn Field="@nameof(CustomQuoteItem.EstPhase)" HeaderText="Phase" Width="70px" AllowEditing="false" />
                    <GridColumn Field="@nameof(CustomQuoteItem.EstItem)" HeaderText="Item" Width="70px" AllowEditing="false" />
                    <GridColumn Field="@nameof(CustomQuoteItem.ItemDesc)" HeaderText="Description" Width="260px"
                                  AllowEditing="false"
                                  ShowEditButton="true"
                                  AlwaysShowEditButton="true"
                                  ClipMode="ClipMode.Ellipsis" />
                    <GridColumn Field="@nameof(CustomQuoteItem.TakeoffQty)" HeaderText="Takeoff Qty" Width="90px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(CustomQuoteItem.TakeoffUOM)" HeaderText="Takeoff UOM" Width="80px" />
                    <GridColumn Field="@nameof(CustomQuoteItem.OrderUOM)" HeaderText="Order UOM" Width="80px" />
                    <GridColumn Field="@nameof(CustomQuoteItem.BudgetQty)" HeaderText="Budget Qty" Width="90px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(CustomQuoteItem.BudgetRate)" HeaderText="Rate" Width="90px" Type="ColumnType.Number" Format="N4" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(CustomQuoteItem.BudgetPretax)" HeaderText="Pretax" Width="95px" Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(CustomQuoteItem.BudgetTax)" HeaderText="Tax" Width="80px" Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(CustomQuoteItem.BudgetVendorName)" HeaderText="Vendor" Width="200px"
                                  AllowEditing="false"
                                  ShowEditButton="true"
                                  AlwaysShowEditButton="true"
                                  ClipMode="ClipMode.Ellipsis" />
                    <GridColumn Field="@nameof(CustomQuoteItem.JCCostCode)" HeaderText="Cost Code" Width="90px"
                                  AllowEditing="false"
                                  ShowEditButton="true"
                                  AlwaysShowEditButton="true"
                                  ClipMode="ClipMode.Ellipsis" />
                    <GridColumn Field="@nameof(CustomQuoteItem.JCCategory)" HeaderText="Category" Width="90px"
                                  AllowEditing="false"
                                  ShowEditButton="true"
                                  AlwaysShowEditButton="true"
                                  ClipMode="ClipMode.Ellipsis" />
                    <GridColumn Field="@nameof(CustomQuoteItem.BudgetTaxGroup)" HeaderText="Tax Group" Width="90px"
                                  AllowEditing="false"
                                  ShowEditButton="true"
                                  AlwaysShowEditButton="true"
                                  ClipMode="ClipMode.Ellipsis" />
                    <GridColumn Field="@nameof(CustomQuoteItem.RoomLocation)" HeaderText="Room" Width="120px" />
                    <GridColumn Field="@nameof(CustomQuoteItem.WarningMessage)" HeaderText="⚠" Width="40px" AllowEditing="false" />
                }
                @* WBS columns — only visible ones with custom descriptions *@
                @foreach (var wbs in WbsColumns)
                {
                    <GridColumn Field="@wbs.Field" HeaderText="@wbs.Caption" Width="120px" Visible="true" />
                }
                <GridColumn Field="@nameof(CustomQuoteItem.BudgetJCTaxRate)" Visible="false" />
                <GridColumn Field="@nameof(CustomQuoteItem.BudgetNJCTaxRate)" Visible="false" />
            </GridColumnsBase>
        </GridControl>
    </div>

    @* ── Selected-totals readout (VB6 gItems_SelChange + ShowTip, FCustomQuote.frm:1266) ──
       VB6 sums BudgetPretax + BudgetJCTax across the selected row range and shows a
       floating tooltip (Pretax / Tax / Total) whenever >1 row is selected (.Row<>.RowSel).
       The faithful, no-JS equivalent is a live status line that appears only when a
       multi-row selection exists; it updates off the grid's SelectionChanged event. *@
    @if (_selCount > 1)
    {
        <div class="cq-seltotals" role="status" aria-live="polite">
            <span class="cq-seltotals-count">@_selCount selected</span>
            <span class="cq-seltotals-item"><span class="cq-seltotals-lbl">Pretax:</span> <span class="cq-seltotals-val">@_selPretax.ToString("#,##0.00")</span></span>
            <span class="cq-seltotals-item"><span class="cq-seltotals-lbl">Tax:</span> <span class="cq-seltotals-val">@_selTax.ToString("#,##0.00")</span></span>
            <span class="cq-seltotals-item cq-seltotals-total"><span class="cq-seltotals-lbl">Total:</span> <span class="cq-seltotals-val">@((_selPretax + _selTax).ToString("#,##0.00"))</span></span>
        </div>
    }

    <div class="bottom-panel">
        <div class="info-panel">
            <div class="panel-title">Info</div>
            <table class="info-table">
                <tr><th>Community</th><td>@InfoCommunity</td></tr>
                <tr><th>Customer</th><td>@InfoCustomer</td></tr>
                <tr><th>Model</th><td>@InfoModel</td></tr>
                <tr><th>Series</th><td>@InfoSeries</td></tr>
                <tr><th>Assembly</th><td>@InfoAssembly</td></tr>
            </table>
        </div>

        <div class="price-panel">
            <div class="panel-title">Custom Request</div>
            <div class="desc">@mAssemblyDesc</div>

            <div class="field-row">
                <label>Cost</label>
                <NumericTextBoxControl TValue="decimal" @bind-Value="mCost" Format="N2" Width="120px"
                                  Enabled="@(!mReadOnly)" ValueChange="OnCostChanged" />
            </div>
            <div class="field-row">
                <label>Markup</label>
                <NumericTextBoxControl TValue="decimal" @bind-Value="mMarkup" Format="N2" Width="120px"
                                  Enabled="@(!mReadOnly)" ValueChange="OnMarkupChanged" />
            </div>
            <div class="field-row">
                <label>Margin</label>
                <NumericTextBoxControl TValue="decimal" @bind-Value="mMargin" Format="N2" Width="120px"
                                  Enabled="@(!mReadOnly)" ValueChange="OnMarginChanged" />
            </div>
            <div class="field-row">
                <label>Sell</label>
                <NumericTextBoxControl TValue="decimal" @bind-Value="mSell" Format="N2" Width="120px"
                                  Enabled="@(!mReadOnly)" ValueChange="OnSellChanged" />
            </div>
            <div class="field-row">
                <label>Sell Qty</label>
                <div class="inline">
                    <NumericTextBoxControl TValue="decimal" @bind-Value="mSalesQty" Format="N2" Width="90px"
                                      Enabled="@(!mReadOnly)" ValueChange="OnSalesQtyChanged" />
                    <DropDownListControl TValue="string" TItem="ComboBoxItem"
                                    DataSource="@UomItems"
                                    @bind-Value="mSalesUOM"
                                    TextFieldName="Text" ValueFieldName="Value"
                                    Width="90px"
                                    Enabled="@(!mReadOnly)"
                                    ValueChange="OnUomChanged" />
                </div>
            </div>
            <div class="price-label">@PriceLabel</div>
        </div>
    </div>
</div>

@* ── Items Grid Context Menu (VB6 FCustomQuote.gItems_BeforeMouseDown:1016) ──
   VB6 disables every action except Remove + View Files on this grid. *@
@if (_showItemsContextMenu)
{
    <div class="context-menu-backdrop"
         @onclick="CloseContextMenu"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"></div>
    <div class="context-menu" style="left:@(_contextMenuX)px;top:@(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <button class="context-menu-close" type="button"
                title="Close" aria-label="Close menu"
                @onclick="CloseContextMenu">×</button>
        @* mcITEM_REMOVEITEMS (VB6 enables only this + View Files) *@
        <button @onclick="OnCtxRemoveItems" disabled="@(_ctxRow == null || mReadOnly)">Remove Item(s)</button>
        @* mcITEM_VIEWFILES *@
        <button @onclick="OnCtxViewFiles" disabled="@(_ctxRow == null)">View Files...</button>
    </div>
}

@* ── In-grid popup text editor (VB6 FComments.Edit) ──── *@
@if (ShowTextEditor)
{
    <div class="cq-modal-backdrop">
        <div class="cq-modal">
            <h5>@TextEditorTitle</h5>
            <TextAreaControl @bind-Value="TextEditorValue" Rows="10" MaxLength="@TextEditorMaxLength" CssClass="cq-textarea" />
            <div class="cq-modal-buttons">
                <ButtonControl OnClick="OnTextEditorOk">OK</ButtonControl>
                <ButtonControl OnClick="OnTextEditorCancel">Cancel</ButtonControl>
            </div>
        </div>
    </div>
}

@* ── Pick List Modal (VB6 FPickList.Choose) ──────────── *@
@namespace HomeFront.Components.Pages
<FPickList @ref="pickList" OnSelected="OnPickListSelected" />

@* ── Attachments dialog (VB6 EditAttachments / View Files) ─ *@
<FAttachments @ref="attachmentsDialog" />

@code {
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string AttachmentID { get; set; } = "";
    [Parameter] public string Location { get; set; } = "ADDENDUM";
    [Parameter] public string Model { get; set; } = "";
    [Parameter] public string Opt { get; set; } = "";
    [Parameter] public string Job { get; set; } = "";
    [Parameter] public string Customer { get; set; } = "";
    [Parameter] public string Community { get; set; } = "";
    [Parameter] public string CommunityPhase { get; set; } = "";
    [Parameter] public string Extra { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public long Seq { get; set; }
    [Parameter] public string Category { get; set; } = "";
    [Parameter] public decimal CostAmount { get; set; }
    [Parameter] public decimal SellAmount { get; set; }
    [Parameter] public decimal SalesQty { get; set; } = 1;
    [Parameter] public string SalesUOM { get; set; } = "";

    // When hosted under the FMain MDI shell, navigate via ParentNavigate so the report
    // viewer stays inside the shell; falls back to NavigationManager when standalone.
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private GridControl<CustomQuoteItem>? ItemsGrid;
    private readonly SelectionSettings selectionSettings = new() { Mode = SelectionMode.Row, Type = SelectionType.Multiple, EnableToggle = true };
    private EditSettings editSettings = new() { AllowAdding = true, AllowEditing = true, AllowDeleting = true, ShowConfirmDialog = false };
    private readonly GridControlEvents<CustomQuoteItem> gridEvents = new();

    private FPickList? pickList;
    private FAttachments? attachmentsDialog;

    private bool mReadOnly;
    private bool mSaved;
    private bool mDirty;
    private bool _editLock;

    private string mAttachmentID = "";
    private string mCommunity = "";
    private string mCommunityPhase = "";
    private string mAssemblyDesc = "";
    private decimal mSalesQty = 1;
    private string mSalesUOM = "";
    private long mSeq;
    private string mJob = "";
    private string mExtra = "";
    private string mCustomer = "";
    private int mLocation;
    private string mModel = "";
    private string mOptionID = "";

    private decimal mCost;
    private decimal mSell;
    private decimal mMarkup;
    private decimal mMargin;

    private List<CustomQuoteItem> ItemsData = new();
    private List<ComboBoxItem> UomItems = new();

    // ── Grid Layout (dynamic from AppGridLayout) ──────────────
    // Load/resolve/width boilerplate lives in the shared GridLayoutPresenter
    // (Services/GridLayoutPresenter.cs); only the VB6 form/grid names stay here.
    // gItemsLayout / HasGridLayout / gItemsLayoutVersion are thin delegations so
    // the markup is unchanged. The keyed-then-unkeyed fallback is captured by
    // instanceKey:"(0)"; the VB6 column aliases (Description→ItemDesc etc.) by
    // aliases:. NOTE: GetColumnTypeForField + ConvertLayoutWidthToPx below are
    // NOT delegated — both diverge from the presenter (see their drift flags).
    private readonly GridLayoutPresenter<CustomQuoteItem> _itemsGrid =
        new("FCustomQuote", "gItems", instanceKey: "(0)",
            aliases: new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["description"] = nameof(CustomQuoteItem.ItemDesc),
                ["comments"] = nameof(CustomQuoteItem.ItemComments),
                ["phase"] = nameof(CustomQuoteItem.EstPhase),
                ["item"] = nameof(CustomQuoteItem.EstItem),
                ["warningmessages"] = nameof(CustomQuoteItem.WarningMessage)
            });

    private Dictionary<string, GridLayoutColumn> gItemsLayout => _itemsGrid.Layout;
    private bool HasGridLayout => _itemsGrid.Has;
    private int gItemsLayoutVersion => _itemsGrid.Version;

    // ── WBS Columns (loaded from customDescriptions) ──────────
    private List<WbsColumnDef> WbsColumns = new();

    private string InfoCommunity = "";
    private string InfoCustomer = "";
    private string InfoModel = "";
    private string InfoSeries = "";
    private string InfoAssembly = "";

    private bool _initialized;

    private bool CanSave => !mReadOnly && mDirty;

    private string PriceLabel => $"@ {mSell:0.00} = {(mSalesQty * mSell):$#,##0.00}";

    // ── Right-click context menu (VB6 gItems_BeforeMouseDown) ──
    private bool _showItemsContextMenu;
    private double _contextMenuX, _contextMenuY;
    private CustomQuoteItem? _ctxRow;

    // ── Selected-totals readout (VB6 gItems_SelChange:1266) ──
    // VB6 sums BudgetPretax + BudgetJCTax over the selected range when >1 row is selected.
    private int _selCount;
    private decimal _selPretax;
    private decimal _selTax;

    // ── AppOptions Format colours (VB6 ColorizeItems → HFApp.Options) ──
    private string _fmtLtZeroFg = "#000000", _fmtLtZeroBg = "transparent";
    private string _fmtEqZeroFg = "#000000", _fmtEqZeroBg = "transparent";
    private string _fmtNonSysFg = "#000000", _fmtNonSysBg = "transparent";
    private string _fmtInvalidFg = "#000000", _fmtInvalidBg = "transparent";
    private bool _fmtLtZeroBold, _fmtLtZeroItalic;
    private bool _fmtEqZeroBold, _fmtEqZeroItalic;
    private bool _fmtNonSysBold, _fmtNonSysItalic;
    private bool _fmtInvalidBold, _fmtInvalidItalic;
    private bool _optZeroRateOnChangeVendor;

    // CSS custom properties for the items-grid host; the scoped .cq-* rules read them via var().
    private string ItemsHostStyle =>
        $"--cq-ltzero-fg:{_fmtLtZeroFg};--cq-ltzero-bg:{_fmtLtZeroBg};" +
        $"--cq-eqzero-fg:{_fmtEqZeroFg};--cq-eqzero-bg:{_fmtEqZeroBg};" +
        $"--cq-nonsys-fg:{_fmtNonSysFg};--cq-nonsys-bg:{_fmtNonSysBg};" +
        $"--cq-invalid-fg:{_fmtInvalidFg};--cq-invalid-bg:{_fmtInvalidBg};";

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized) return;
        InitializeFromParameters();
        ApplyReadOnly();
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<CustomQuoteItem>>(this, OnCellSaved);
        // Standard FlexKit edit-button dispatch: the templateless "…" buttons on the
        // popup-text + lookup columns raise OnEditButtonClick → OnGridEditButtonClick.
        gridEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<CustomQuoteItem>>(this, OnGridEditButtonClick);
        gridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<CustomQuoteItem>>(this, OnGridRowSelected);
        // VB6 gItems_SelChange fires on selection-extend; SelectionChanged is the grid's
        // documented once-per-extend hook for tracking multi-row selection in real time.
        gridEvents.SelectionChanged = EventCallback.Factory.Create<int>(this, OnGridSelectionChanged);
        await LoadAppOptionsAsync();
        await LoadGridLayoutAsync();
        await LoadWbsDescriptionsAsync();
        await LoadUomAsync();
        await LoadMarkupFromCategoryAsync();
        await LoadInfoPanelAsync();
        await LoadDataAsync();
        CalcTotals();
        _initialized = true;
    }

    private void InitializeFromParameters()
    {
        mReadOnly = ReadOnly;
        mAttachmentID = AttachmentID;
        mCommunity = Community;
        mCommunityPhase = CommunityPhase;
        mAssemblyDesc = Description;
        mSalesQty = SalesQty <= 0 ? 1 : SalesQty;
        mSalesUOM = SalesUOM;
        mSeq = Seq;
        mJob = (Job ?? "").Replace("-", "");
        mExtra = Extra;
        mCustomer = Customer;
        mLocation = MapLocation(Location);
        mModel = Model;
        mOptionID = Opt;
        mCost = CostAmount;
        mSell = SellAmount;

        if (mCost != 0 && mSell != 0)
        {
            mMarkup = Math.Round((mSell - mCost) / mCost * 100, 2);
            mMargin = mSell == 0 ? 0 : Math.Round((mSell - mCost) / mSell * 100, 0);
        }
    }

    private void ApplyReadOnly()
    {
        editSettings = new EditSettings
        {
            AllowAdding = !mReadOnly,
            AllowEditing = !mReadOnly,
            AllowDeleting = !mReadOnly,
            ShowConfirmDialog = false
        };
    }

    private int MapLocation(string location)
    {
        return (location ?? "").ToUpperInvariant() switch
        {
            "ADDENDUM" => (int)QuoteLocation.ScheduleB,
            "CHANGEORDER" => (int)QuoteLocation.ChangeOrder,
            "DESIGNCENTER" => (int)QuoteLocation.DesignCenter,
            _ => (int)QuoteLocation.ScheduleB
        };
    }

    // VB6 BuildQuote (FCustomQuote.frm:515): public entry used when the form is
    // hosted as a modal from a parent. Mirrors InitializeFromParameters + loads.
    public async Task<bool> BuildQuote(bool readOnly, string attachmentId, string location, string model, string opt, string job, string customer, string community, string communityPhase, string extra, string description, long seq, string category, decimal costAmount, decimal sellAmount, decimal salesQty, string salesUom)
    {
        mReadOnly = readOnly;
        mAttachmentID = attachmentId;
        mCommunity = community;
        mCommunityPhase = communityPhase;
        mAssemblyDesc = description;
        mSalesQty = salesQty <= 0 ? 1 : salesQty;
        mSalesUOM = salesUom;
        mSeq = seq;
        mJob = (job ?? "").Replace("-", "");
        mExtra = extra;
        mCustomer = customer;
        mLocation = MapLocation(location);
        mModel = model;
        mOptionID = opt;
        mCost = costAmount;
        mSell = sellAmount;
        mMarkup = mCost == 0 ? 0 : Math.Round((mSell - mCost) / mCost * 100, 2);
        mMargin = mSell == 0 ? 0 : Math.Round((mSell - mCost) / mSell * 100, 0);

        ApplyReadOnly();
        await LoadAppOptionsAsync();
        await LoadGridLayoutAsync();
        await LoadWbsDescriptionsAsync();
        await LoadUomAsync();
        if (!string.IsNullOrWhiteSpace(category))
            await LoadMarkupFromCategoryAsync(category);
        await LoadInfoPanelAsync();
        await LoadDataAsync();
        CalcTotals();
        return mSaved;
    }

    private async Task LoadUomAsync()
    {
        var rows = await db.QueryAsync("SELECT DISTINCT OrderUOM Unit FROM tblPhaseItem WHERE DivisionID =@DivisionID ORDER BY 1", new { SessionState.DivisionID });
        UomItems = rows.Select(r => new ComboBoxItem
        {
            Text = r["Unit"]?.ToString() ?? "",
            Value = r["Unit"]?.ToString() ?? ""
        }).ToList();
        if (!string.IsNullOrWhiteSpace(mSalesUOM) && UomItems.All(u => u.Value != mSalesUOM))
            UomItems.Insert(0, new ComboBoxItem { Text = mSalesUOM, Value = mSalesUOM });
    }

    // VB6 BuildQuote (FCustomQuote.frm:550): seed Markup from tblcategories.comarkup
    // for the option's Category, used only when there is no Cost/Sell to derive from.
    private async Task LoadMarkupFromCategoryAsync(string? category = null)
    {
        var cat = category ?? Category;
        if (string.IsNullOrWhiteSpace(cat)) return;
        try
        {
            var markup = await db.ExecuteScalarAsync<decimal>(
                "SELECT COMarkup FROM tblcategories WHERE category=@Category", new { Category = cat });
            // VB6: If txtMarkup.Text = "0" Then txtMarkup.Text = "" — only seed when no cost/sell derivation.
            if (mCost == 0 || mSell == 0)
                mMarkup = markup;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadMarkupFromCategory error");
        }
    }

    private async Task LoadInfoPanelAsync()
    {
        var s = @"
select isnull(c.community,'') + isnull('.' + c.phase,'') + ' - ' + isnull(l.description,'') + isnull(' ' + p.description,'') Community,
       isnull(c.customer_no,'** not found **') + isnull(' - ' + c.Description,'') Customer,
       isnull(c.model,'') + isnull(' - ' + m.description,'   ** not found **') Model,
       isnull(c.Series,'') + isnull(' - ' + s.description,'   ** not found **') Series,
       isnull(c.ModelAssembly,'') + isnull(' - ' + a.description,'   ** not found **') Assembly
from tblcustomers c
     LEFT OUTER JOIN tbllocality l on(c.community=l.area)
     LEFT OUTER JOIN communityphase p on(c.community=p.community and c.phase=p.communityphase)
     LEFT OUTER JOIN DistinctDivisionModelSeries m on(c.model=m.model and c.series=m.series and c.divisionid=m.divisionid)
     LEFT OUTER JOIN tblseries s on(m.series=s.series and m.DivisionID = s.DivisionID)
     LEFT OUTER JOIN tblDBAssemblyMaster a on(c.DivisionID = a.DivisionID and c.community=a.community and c.modelassembly=a.assembly and a.model=c.model and a.optionid='')
where c.customer_no=@CustomerNo";
        var rows = await db.QueryAsync(s, new { CustomerNo = mCustomer });
        if (rows.Count > 0)
        {
            var r = rows[0];
            InfoCommunity = r["Community"]?.ToString() ?? "";
            InfoCustomer = r["Customer"]?.ToString() ?? "";
            InfoModel = r["Model"]?.ToString() ?? "";
            InfoSeries = r["Series"]?.ToString() ?? "";
            InfoAssembly = r["Assembly"]?.ToString() ?? "";
        }
    }

    private async Task LoadDataAsync()
    {
        var s = @"
select cc.Description JCCostCodeDesc, cat.Description JCCategoryDesc, v.Vendor_Name BudgetVendorName, pi.roundto, pi.rounddir, pi.wastepercent, i.*
  from CustomPreEstimateItems i
  left outer join tblphaseitem pi ON(pi.DivisionID = @DivisionID and i.phase=pi.phase and i.item=pi.item)
  left outer join tblVendors v   ON(i.BudgetVendor=v.Vendor_ID and v.DivisionID = @DivisionID)
  left outer join StandardCostCodes cc   ON(cc.DivisionID=@DivisionID and i.JCCostCode=cc.CostCode)
  left outer join StandardCategories cat ON(cat.DivisionID=@DivisionID and i.JCCategory=cat.Category)
 where i.customerno=@CustomerNo
   and i.location=@Location
   and i.seq=@Seq";
        var dt = db.SqlExec(s, new { SessionState.DivisionID, CustomerNo = mCustomer, Location = mLocation, Seq = mSeq });
        ItemsData = new List<CustomQuoteItem>();
        foreach (DataRow row in dt.Rows)
        {
            var item = new CustomQuoteItem
            {
                Customer_No = mCustomer,
                Location = mLocation,
                OptionID = mOptionID,
                HFDescription = mAssemblyDesc,
                Model = mModel,
                POIndex = Col(row, "POIndex"),
                RoundTo = ToDecimal(Get(row, "RoundTo")),
                RoundDir = ToInt(Get(row, "RoundDir")),
                WastePercent = ToDecimal(Get(row, "WastePercent")),
                ConversionFactor = ToDecimal(Get(row, "ConversionFactor")),
                EstPhase = Col(row, "Phase"),
                EstItem = Col(row, "Item"),
                ItemDesc = Col(row, "Description"),
                ItemComments = Col(row, "Comments"),
                TakeoffQty = ToDecimal(Get(row, "TakeoffQty")),
                TakeoffUOM = Col(row, "TakeoffUOM"),
                OrderUOM = Col(row, "OrderUOM"),
                Job_No = mJob,
                JCExtra = mExtra,
                JCCostCode = Col(row, "JCCostCode"),
                JCCategory = Col(row, "JCCategory"),
                BudgetVendor = Col(row, "BudgetVendor"),
                BudgetQty = ToDecimal(Get(row, "BudgetQty")),
                BudgetRate = ToDecimal(Get(row, "BudgetRate")),
                BudgetPretax = ToDecimal(Get(row, "BudgetPretax")),
                BudgetTaxGroup = Col(row, "BudgetTaxGroup"),
                BudgetJCTax = ToDecimal(Get(row, "BudgetJCTax")),
                BudgetJCTaxRate = ToDecimal(Get(row, "BudgetJCTaxRate")),
                BudgetNJCTax = ToDecimal(Get(row, "BudgetNJCTax")),
                BudgetNJCTaxRate = ToDecimal(Get(row, "BudgetNJCTaxRate")),
                Seq = mSeq,
                Assembly = Col(row, "Assembly"),
                JCCostCodeDesc = Col(row, "JCCostCodeDesc"),
                JCCategoryDesc = Col(row, "JCCategoryDesc"),
                BudgetVendorName = Col(row, "BudgetVendorName"),
                RoomLocation = Col(row, "RoomLocation"),
                RowState = "CLEAN"
            };
            item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
            for (var i = 1; i <= 40; i++)
                item.SetWbs(i, Col(row, $"WBS{i:D2}"));
            ColorizeItem(item);
            ItemsData.Add(item);
        }
        mDirty = false;
    }

    private static object? Get(DataRow row, string col) =>
        row.Table.Columns.Contains(col) ? row[col] : null;
    private static string Col(DataRow row, string col) =>
        row.Table.Columns.Contains(col) ? row[col]?.ToString() ?? "" : "";

    // ── Grid edit committed ───────────────────────────────────
    private async Task OnCellSaved(CellSaveArgs<CustomQuoteItem> args)
    {
        if (args.Data == null) return;
        var field = args.ColumnName ?? "";
        await RecalculateAfterEdit(args.Data, field);
        if (args.Data.RowState != "NEW") args.Data.RowState = "DIRTY";
        mDirty = true;
        ColorizeItem(args.Data);
        CalcTotals();
        StateHasChanged();
    }

    // VB6 gItems_AfterEdit (FCustomQuote.frm:848): per-column recalc cascade.
    private async Task RecalculateAfterEdit(CustomQuoteItem row, string field)
    {
        switch (field)
        {
            case nameof(CustomQuoteItem.JCCategory):
            case nameof(CustomQuoteItem.JCCategoryDesc):
                // VB6:869 — when not budget-generated, default the tax group from
                // dbo.Purch_GetDefaultTaxGroup and re-tax.
                {
                    var (tg, jc, njc) = await GetDefaultTaxGroup(row);
                    if (tg != null)
                    {
                        row.BudgetTaxGroup = tg;
                        row.BudgetJCTaxRate = (decimal)jc;
                        row.BudgetNJCTaxRate = (decimal)njc;
                        ReTax(row);
                    }
                }
                break;

            case nameof(CustomQuoteItem.BudgetVendor):
            case nameof(CustomQuoteItem.BudgetVendorName):
                // VB6:897 — look up the vendor's item rate; clear overridden + re-extend.
                {
                    var (ok, rate) = await GetVendorCost(row, row.BudgetVendor);
                    if (ok)
                    {
                        row.BudgetOverridden = "False";
                        row.BudgetRate = (decimal)rate;
                        row.BudgetPretax = Math.Round(row.BudgetQty * row.BudgetRate, 2);
                        ReTax(row);
                    }
                }
                break;

            case nameof(CustomQuoteItem.TakeoffQty):
                // VB6:908 — BudgetQty = RoundTo(TakeoffQty*(100+Waste)/100*Conv, RoundTo, RoundDir)
                row.BudgetQty = (decimal)RoundToValue(
                    (double)row.TakeoffQty * (100 + (double)row.WastePercent) / 100 * (double)row.ConversionFactor,
                    (double)row.RoundTo, row.RoundDir);
                row.BudgetPretax = Math.Round(row.BudgetQty * row.BudgetRate, 2);
                ReTax(row);
                break;

            case nameof(CustomQuoteItem.BudgetQty):
                // VB6:916 — TakeoffQty = BudgetQty / Conv; re-extend.
                if (row.ConversionFactor != 0)
                    row.TakeoffQty = row.BudgetQty / row.ConversionFactor;
                row.BudgetPretax = Math.Round(row.BudgetQty * row.BudgetRate, 2);
                ReTax(row);
                break;

            case nameof(CustomQuoteItem.BudgetRate):
                // VB6:923 — mark overridden; re-extend.
                row.BudgetOverridden = "True";
                row.BudgetPretax = Math.Round(row.BudgetQty * row.BudgetRate, 2);
                ReTax(row);
                break;

            case nameof(CustomQuoteItem.BudgetPretax):
                // VB6:930 — back-solve rate from pretax/qty; mark overridden.
                if (row.BudgetQty == 0) row.BudgetQty = 1;
                row.BudgetRate = Math.Round(row.BudgetPretax / row.BudgetQty, 4);
                row.BudgetOverridden = "True";
                ReTax(row);
                break;

            case nameof(CustomQuoteItem.BudgetTaxGroup):
                // VB6:938 — pull JC/NJC rates for the chosen group; re-tax.
                {
                    var (jc, njc) = await GetTaxGroupRates(row.BudgetTaxGroup);
                    row.BudgetJCTaxRate = (decimal)jc;
                    row.BudgetNJCTaxRate = (decimal)njc;
                    ReTax(row);
                }
                break;

            case nameof(CustomQuoteItem.BudgetJCTax):
            case nameof(CustomQuoteItem.BudgetNJCTax):
                // VB6:947 / :950 — total tax = JC + NJC.
                row.BudgetTax = row.BudgetJCTax + row.BudgetNJCTax;
                break;
        }
    }

    // Re-extend the two tax amounts + total from pretax * rate (VB6 inline pattern).
    private static void ReTax(CustomQuoteItem row)
    {
        row.BudgetJCTax = Math.Round(row.BudgetPretax * row.BudgetJCTaxRate / 100, 2);
        row.BudgetNJCTax = Math.Round(row.BudgetPretax * row.BudgetNJCTaxRate / 100, 2);
        row.BudgetTax = row.BudgetJCTax + row.BudgetNJCTax;
    }

    // VB6 GetVendorCost (FCustomQuote.frm:1360): Purch_GetItemRate(0,0,Community,
    //   CommunityPhase,Assembly,Model,OptionID,EstPhase,EstItem,Seq,Vendor,GETDATE(),DivID).
    //   ⚠ live DB takes a trailing @DivisionID (13 args). Returns (true,rate) when
    //   rate<>0 OR the ZeroRateOnChangeVendor option is on.
    private async Task<(bool ok, double rate)> GetVendorCost(CustomQuoteItem row, string vendor)
    {
        if (string.IsNullOrWhiteSpace(vendor)) return (false, 0);
        try
        {
            var rate = await db.ExecuteScalarAsync<double>(
                @"SELECT dbo.Purch_GetItemRate(0, 0, @Community, @CommunityPhase, @Assembly, @Model,
                         @OptionID, @EstPhase, @EstItem, @Seq, @Vendor, GETDATE(), @DivisionID)",
                new
                {
                    Community = mCommunity ?? "",
                    CommunityPhase = mCommunityPhase ?? "",
                    Assembly = row.Assembly ?? "",
                    Model = row.Model ?? "",
                    OptionID = row.OptionID ?? "",
                    EstPhase = row.EstPhase ?? "",
                    EstItem = row.EstItem ?? "",
                    Seq = (int)row.Seq,
                    Vendor = vendor,
                    DivisionID = SessionState.DivisionID
                });
            if (rate != 0 || _optZeroRateOnChangeVendor)
                return (true, rate);
            return (false, 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "GetVendorCost error");
            return (false, 0);
        }
    }

    // VB6 gItems_AfterEdit JCCategory branch (FCustomQuote.frm:871): SELECT * FROM
    //   TaxGroups WHERE TaxGroup = dbo.Purch_GetDefaultTaxGroup(Job_No,Community,
    //   CommunityPhase,Model,Assembly,EstPhase,EstItem,BudgetVendor,JCCategory,DivID).
    //   ⚠ live DB takes a trailing @DivisionID (10 args).
    private async Task<(string? taxGroup, double jcRate, double njcRate)> GetDefaultTaxGroup(CustomQuoteItem row)
    {
        try
        {
            var dt = db.SqlExec(
                @"SELECT TaxGroup, JCRate, NJCRate FROM TaxGroups WHERE TaxGroup =
                  dbo.Purch_GetDefaultTaxGroup(@Job, @Community, @CommunityPhase, @Model, @Assembly,
                      @EstPhase, @EstItem, @Vendor, @JCCategory, @DivisionID)",
                new
                {
                    Job = string.IsNullOrWhiteSpace(row.Job_No) ? mJob : row.Job_No,
                    Community = mCommunity ?? "",
                    CommunityPhase = mCommunityPhase ?? "",
                    Model = row.Model ?? "",
                    Assembly = row.Assembly ?? "",
                    EstPhase = row.EstPhase ?? "",
                    EstItem = row.EstItem ?? "",
                    Vendor = row.BudgetVendor ?? "",
                    JCCategory = row.JCCategory ?? "",
                    DivisionID = SessionState.DivisionID
                });
            if (dt.Rows.Count > 0)
            {
                var r = dt.Rows[0];
                return (r["TaxGroup"]?.ToString() ?? "", ToDouble(r["JCRate"]), ToDouble(r["NJCRate"]));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "GetDefaultTaxGroup error");
        }
        return (null, 0, 0);
    }

    // VB6 gItems_AfterEdit BudgetTaxGroup branch (FCustomQuote.frm:939):
    //   SELECT JCRate,NJCRate FROM TaxGroups WHERE TaxGroup=<selected>.
    private async Task<(double jcRate, double njcRate)> GetTaxGroupRates(string taxGroup)
    {
        if (string.IsNullOrWhiteSpace(taxGroup)) return (0, 0);
        try
        {
            var rows = await db.QueryAsync(
                "SELECT JCRate, NJCRate FROM TaxGroups WHERE DivisionID=@DivisionID and TaxGroup=@TaxGroup",
                new { SessionState.DivisionID, TaxGroup = taxGroup });
            var r = rows.FirstOrDefault();
            if (r != null)
                return (ToDouble(r["JCRate"]), ToDouble(r["NJCRate"]));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "GetTaxGroupRates error");
        }
        return (0, 0);
    }

    // ── CalcTotals (VB6 FCustomQuote.frm:1737) ────────────────
    private void CalcTotals(bool calcMargin = true, bool calcMarkup = true)
    {
        _editLock = true;
        if (ItemsData.Count > 0)
            mCost = ItemsData.Sum(i => i.BudgetPretax + i.BudgetJCTax);
        if (calcMargin)
            mMargin = mSell == 0 ? 0 : Math.Round((mSell - mCost) / mSell * 100, 0);
        if (calcMarkup)
            mMarkup = mCost == 0 ? 0 : Math.Round((mSell - mCost) / mCost * 100, 0);
        _editLock = false;
    }

    private void OnCostChanged(NumericTextBoxControl<decimal>.NumericChangeEventArgs<decimal> args)
    {
        if (_editLock) return;
        mCost = args.Value;
        CalcTotals();
        mDirty = true;
    }

    private void OnSellChanged(NumericTextBoxControl<decimal>.NumericChangeEventArgs<decimal> args)
    {
        if (_editLock) return;
        mSell = args.Value;
        CalcTotals();
        mDirty = true;
    }

    // VB6 txtMarkup_Change (FCustomQuote.frm:1786): mSell = mCost*(1+markup/100).
    private void OnMarkupChanged(NumericTextBoxControl<decimal>.NumericChangeEventArgs<decimal> args)
    {
        if (_editLock) return;
        _editLock = true;
        mMarkup = args.Value;
        mSell = mCost * (1 + mMarkup / 100);
        CalcTotals(true, false);
        mDirty = true;
        _editLock = false;
    }

    // VB6 txtMargin_Change (FCustomQuote.frm:1771): mSell = 100*mCost/(100-margin).
    private void OnMarginChanged(NumericTextBoxControl<decimal>.NumericChangeEventArgs<decimal> args)
    {
        if (_editLock) return;
        _editLock = true;
        mMargin = args.Value;
        mSell = mMargin >= 100 ? mCost : (100 * mCost / (100 - mMargin));
        CalcTotals(false, true);
        mDirty = true;
        _editLock = false;
    }

    private void OnSalesQtyChanged(NumericTextBoxControl<decimal>.NumericChangeEventArgs<decimal> args)
    {
        mSalesQty = args.Value;
        mDirty = true;
    }

    private void OnUomChanged(DropDownListControl<string, ComboBoxItem>.ChangeEventArgs<string, ComboBoxItem> args)
    {
