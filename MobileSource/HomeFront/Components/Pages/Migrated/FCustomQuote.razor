    // VB6: LoadWBSDescriptions — reads customDescriptions for WBS column headers.
    private async Task LoadWbsDescriptionsAsync()
    {
        WbsColumns = new List<WbsColumnDef>();
        try
        {
            var rows = await db.QueryAsync(
                "SELECT Item, custom_description Description FROM customDescriptions WHERE ISNULL(custom_description,'') <> '' AND item LIKE 'WBS__' ORDER BY item",
                new { });
            foreach (var r in rows)
            {
                var field = r["Item"]?.ToString()?.Trim() ?? "";
                var caption = r["Description"]?.ToString()?.Trim() ?? "";
                if (!string.IsNullOrEmpty(field) && !string.IsNullOrEmpty(caption))
                    WbsColumns.Add(new WbsColumnDef { Field = field, Caption = caption });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadWbsDescriptions error");
        }
    }

    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedGridLayout()
    {
        if (!HasGridLayout)
            yield break;

        var ordered = gItemsLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            // Skip WBS columns — they are handled separately.
            if (layout.Field.StartsWith("WBS", StringComparison.OrdinalIgnoreCase) && layout.Field.Length == 5)
                continue;

            var resolvedField = ResolveGridField(layout.Field);
            var columnType = GetColumnTypeForField(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    // Resolution is delegated to the presenter (ctor supplied the alias map).
    // Behavior is identical to the old exact→switch: the presenter inserts a
    // normalized-propmap step before the aliases, but NO CustomQuoteItem property
    // is named Description/Comments/Phase/Item/WarningMessages, so that step always
    // misses and the alias fires exactly as the old switch did.
    private string ResolveGridField(string layoutField)
        => _itemsGrid.ResolveField(layoutField);

    // DRIFT FLAG: this is a hand-written field-NAME switch — wholly different from
    // the presenter's reflection-based ColumnTypeFor (which would infer Number/
    // Boolean from the property type). The form deliberately marks ONLY the listed
    // fields Number and the "Selected" field CheckBox; everything else Text. Kept
    // verbatim; GetOrderedGridLayout is therefore NOT delegated to
    // _itemsGrid.GetOrdered().
    private static ColumnType GetColumnTypeForField(string field)
    {
        return field switch
        {
            "TakeoffQty" or "BudgetQty" or "BudgetRate" or "BudgetPretax"
                or "BudgetJCTax" or "BudgetNJCTax" or "BudgetTax"
                or "BudgetJCTaxRate" or "BudgetNJCTaxRate"
                or "ConversionFactor" or "RoundTo" or "WastePercent"
                => ColumnType.Number,
            "Selected" => ColumnType.CheckBox,
            _ => ColumnType.Text
        };
    }

    private static string? GetFormatForField(string field, ColumnType colType)
    {
        if (colType != ColumnType.Number) return null;
        return field switch
        {
            "BudgetRate" or "ConversionFactor" => "N4",
            "BudgetPretax" or "BudgetJCTax" or "BudgetNJCTax" or "BudgetTax" => "C2",
            _ => "N2"
        };
    }

    private static bool IsFieldEditable(string field)
    {
        return field switch
        {
            "RowState" or "BudgetTax" or "JCCostCodeDesc" or "JCCategoryDesc"
                or "WarningMessage" or "Assembly" or "EstPhase" or "EstItem" => false,
            _ => true
        };
    }

    // DRIFT FLAG: this width formula DIFFERS from the canonical
    // GridLayoutPresenter.WidthPx — it floors at 30px (not 32), truncates instead
    // of Math.Round, and does NOT add the +16 padding or apply the 2000px ceiling.
    // (GridLayoutPresenter.cs's own docstring calls out exactly this form as the
    // one that "drifted, dropping the +16/clamp".) NOT switched to WidthPx because
    // doing so silently widens every FCustomQuote column by 16px and changes the
    // floor — a visible behavior change that must be a deliberate decision, not a
    // refactor side effect. Left verbatim; flagged for a follow-up fidelity check.
    // Width policy: single canonical twips→px (/15 + 16, clamp) — VB6 applies no width
    // tuning (ColWidth = raw twips), so the prior Math.Max(30, /15) drift is dropped.
    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

