@page "/selected-list"
@page "/selected-list/{LoadType:int}"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FrmSelectedList> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer db

<PageTitle>HomeFront - Item Selection List</PageTitle>

<div class="selection-container">
    <div class="selection-panel">
        <h4 style="margin-bottom: 16px; text-align: center;">HomeFront - Item Selection List</h4>

        <div class="lists-row">
            @* Left List - Available Items *@
            <div style="flex: 1;">
                <div class="list-label">Available</div>
                <ul class="list-box">
                    @foreach (var item in List1Items.OrderBy(x => x))
                    {
                        <li class="@(item == SelectedList1Item ? "selected" : "")"
                            @onclick="() => OnList1Click(item)"
                            @ondblclick="() => OnList1DblClick(item)">
                            @item
                        </li>
                    }
                </ul>
            </div>

            @* Transfer Buttons *@
            <div class="transfer-buttons">
                <button class="transfer-btn" title="Add" disabled="@(SelectedList1Item == null)" @onclick="OnAddClick">
                    &gt;
                </button>
                <button class="transfer-btn" title="Remove" disabled="@(SelectedList2Item == null)" @onclick="OnRemoveClick">
                    &lt;
                </button>
                <button class="transfer-btn" title="Add All" disabled="@(!List1Items.Any())" @onclick="OnAddAllClick">
                    &gt;&gt;
                </button>
                <button class="transfer-btn" title="Remove All" disabled="@(!List2Items.Any())" @onclick="OnRemoveAllClick">
                    &lt;&lt;
                </button>
            </div>

            @* Right List - Selected Items *@
            <div style="flex: 1;">
                <div class="list-label">Selected</div>
                <ul class="list-box">
                    @foreach (var item in List2Items.OrderBy(x => x))
                    {
                        <li class="@(item == SelectedList2Item ? "selected" : "")"
                            @onclick="() => OnList2Click(item)">
                            @item
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Action Buttons *@
        <div class="action-buttons">
            <button class="btn-save" @onclick="OnSaveClick">
                @SaveButtonCaption
            </button>
            <button class="btn-exit" title="Exit" @onclick="OnExitClick">
                Exit
            </button>
        </div>
    </div>
</div>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    [Parameter] public int LoadType { get; set; } = 1;

    /// <summary>
    /// The user ID to assign items to. In VB6 this came from frmuser.txtUserId.Text.
    /// </summary>
    [Parameter] public string UserId { get; set; } = "";

    /// <summary>
    /// Event callback when the dialog is closed, so the parent can restore state.
    /// </summary>
    [Parameter] public EventCallback<int> OnClosed { get; set; }

    // Database
// Configuration driven by LoadType (gcall)
    private string mField1 = "";
    private string mField2 = "";
    private string MyAddFromTableName = "";
    private int gcall = 0;

    // List data
    private List<string> List1Items = new();
    private List<string> List2Items = new();
    private string? SelectedList1Item;
    private string? SelectedList2Item;

    // Recordset data (main list records for add/delete operations)
    private DataTable? MainRecordset;

    private string SaveButtonCaption => gcall == 2
        ? $"Assign Selected Communities to {UserId}"
        : $"Assign Selected Divisions to {UserId}";

    // === Lifecycle ===
    protected override async Task OnInitializedAsync()
    {
        await ShowForm(LoadType);
    }

    public async Task ShowForm(int loadType)
    {
        gcall = loadType;

        if (gcall == 2)
        {
            MyAddFromTableName = "tblLocality";
            mField1 = "Area";
            mField2 = "Description";
        }
        else
        {
            MyAddFromTableName = "Divisions";
            mField1 = "DivisionID";
            mField2 = "DivisionName";
        }

        await LoadMainRecordset();
        await LoadLists();
        RemoveFromList();
    }

    // === Data Loading ===
    private async Task LoadMainRecordset()
    {
        try
        {
            string sql;
            if (gcall == 2)
            {
                sql = "SELECT * FROM tblSalesPersonArea WHERE Sales_Person_ID = @UserId";
            }
            else
            {
                sql = "SELECT * FROM DivisionUsers WHERE userID = @UserId";
            }
            MainRecordset = db.SqlExec(sql, new { UserId });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadMainRecordset error");

            MainRecordset = new DataTable();
        }
    }

    private async Task LoadLists()
    {
        List1Items.Clear();
        List2Items.Clear();

        try
        {
            // Load all available items into List1
            var addFromSql = $"SELECT * FROM {MyAddFromTableName}";
            var addFromDt = db.SqlExec(addFromSql);

            foreach (DataRow row in addFromDt.Rows)
            {
                string displayValue;
                if (gcall == 2)
                    displayValue = row["Description"]?.ToString() ?? "";
                else
                    displayValue = row["DivisionName"]?.ToString() ?? "";

                if (!string.IsNullOrEmpty(displayValue))
                    List1Items.Add(displayValue);
            }

            // Load assigned items into List2
            if (MainRecordset != null)
            {
                foreach (DataRow row in MainRecordset.Rows)
                {
                    string displayValue;
                    if (gcall == 2)
                    {
                        var area = row["Area"]?.ToString() ?? "";
                        displayValue = MyLookUp("tblLocality", "Description", "Area", area);
                    }
                    else
                    {
                        var divisionId = row["DivisionID"]?.ToString() ?? "";
                        displayValue = MyLookUp("Divisions", "DivisionName", "DivisionID", divisionId);
                    }

                    if (!string.IsNullOrEmpty(displayValue))
                        List2Items.Add(displayValue);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadLists error");

        }
    }

    private void RemoveFromList()
    {
        try
        {
            if (MainRecordset == null) return;

            foreach (DataRow row in MainRecordset.Rows)
            {
                string lookupValue;
                if (gcall == 2)
                {
                    var area = row["Area"]?.ToString() ?? "";
                    lookupValue = MyLookUp("tblLocality", "Description", "Area", area);
                }
                else
                {
                    var divisionId = row["DivisionID"]?.ToString() ?? "";
                    lookupValue = MyLookUp("Divisions", "DivisionName", "DivisionID", divisionId);
                }

                if (!string.IsNullOrEmpty(lookupValue))
                {
                    List1Items.Remove(lookupValue);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "RemoveFromList error");

        }
    }

    // === Lookup Helper ===
    /// <summary>
    /// Equivalent to VB6 MyLookUp function. Looks up a value from a table.
    /// </summary>
    private string MyLookUp(string tableName, string returnField, string searchField, string searchValue)
    {
        try
        {
            var sql = $"SELECT TOP 1 [{returnField}] FROM [{tableName}] WHERE [{searchField}] = @SearchValue";
            var dt = db.SqlExec(sql, new { SearchValue = searchValue });
            if (dt.Rows.Count > 0)
                return dt.Rows[0][0]?.ToString() ?? "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "MyLookUp error");

        }
        return "";
    }

    /// <summary>
    /// Reverse lookup: given a display value (mField2), find the key value (mField1).
    /// </summary>
    private string ReverseLookUp(string displayValue)
    {
        return MyLookUp(MyAddFromTableName, mField1, mField2, displayValue);
    }

    // === Transfer Operations ===
    private void OnList1Click(string item)
    {
        SelectedList1Item = item;
        SelectedList2Item = null;
    }

    private void OnList2Click(string item)
    {
        SelectedList2Item = item;
        SelectedList1Item = null;
    }

    private void OnList1DblClick(string item)
    {
        SelectedList1Item = item;
        OnAddClick();
    }

    /// <summary>Command1: Add selected item from List1 to List2</summary>
    private void OnAddClick()
    {
        try
        {
            if (SelectedList1Item == null) return;

            var item = SelectedList1Item;
            var keyValue = ReverseLookUp(item);

            List2Items.Add(item);
            List1Items.Remove(item);
            AddToDatabase(keyValue);

            SelectedList1Item = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnAddClick error");

        }
    }

    /// <summary>Command2: Remove selected item from List2 back to List1</summary>
    private void OnRemoveClick()
    {
        try
        {
            if (SelectedList2Item == null) return;

            var item = SelectedList2Item;
            var keyValue = ReverseLookUp(item);

            List1Items.Add(item);
            List2Items.Remove(item);
            DeleteFromDatabase(keyValue);

            SelectedList2Item = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnRemoveClick error");

        }
    }

    /// <summary>Command3: Add all items from List1 to List2</summary>
    private void OnAddAllClick()
    {
        try
        {
            var items = List1Items.ToList();
            foreach (var item in items)
            {
                var keyValue = ReverseLookUp(item);
                List2Items.Add(item);
                AddToDatabase(keyValue);
            }
            List1Items.Clear();
            SelectedList1Item = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnAddAllClick error");

        }
    }

    /// <summary>Command4: Remove all items from List2 back to List1</summary>
    private void OnRemoveAllClick()
    {
        try
        {
            var items = List2Items.ToList();
            foreach (var item in items)
            {
                var keyValue = ReverseLookUp(item);
                List1Items.Add(item);
                DeleteFromDatabase(keyValue);
            }
            List2Items.Clear();
            SelectedList2Item = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnRemoveAllClick error");

        }
    }

    // === Database Operations ===
    private void AddToDatabase(string keyValue)
    {
        try
        {
            if (string.IsNullOrEmpty(keyValue)) return;

            // Check if record already exists
            string checkSql;
            if (gcall == 2)
            {
                checkSql = "SELECT COUNT(*) FROM tblSalesPersonArea WHERE Area = @KeyValue AND Sales_Person_ID = @UserId";
            }
            else
            {
                checkSql = "SELECT COUNT(*) FROM DivisionUsers WHERE DivisionID = @KeyValue AND UserID = @UserId";
            }

            var checkDt = db.SqlExec(checkSql, new { KeyValue = keyValue, UserId });
            var count = Convert.ToInt32(checkDt.Rows[0][0]);

            if (count == 0)
            {
                string insertSql;
                if (gcall == 2)
                {
                    insertSql = "INSERT INTO tblSalesPersonArea (Area, Sales_Person_ID) VALUES (@KeyValue, @UserId)";
                }
                else
                {
                    insertSql = "INSERT INTO DivisionUsers (DivisionID, UserID) VALUES (@KeyValue, @UserId)";
                }
                db.SqlExec(insertSql, new { KeyValue = keyValue, UserId });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AddToDatabase error");

        }
    }

    private void DeleteFromDatabase(string keyValue)
    {
        try
        {
            if (string.IsNullOrEmpty(keyValue)) return;

            string deleteSql;
            if (gcall == 2)
            {
                deleteSql = "DELETE FROM tblSalesPersonArea WHERE Area = @KeyValue AND Sales_Person_ID = @UserId";
            }
            else
            {
                deleteSql = "DELETE FROM DivisionUsers WHERE DivisionID = @KeyValue AND UserID = @UserId";
            }
            db.SqlExec(deleteSql, new { KeyValue = keyValue, UserId });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "DeleteFromDatabase error");

        }
    }

    /// <summary>Command6: Save - ensures all selected items are persisted</summary>
    private async Task OnSaveClick()
    {
        try
        {
            foreach (var item in List2Items)
            {
                var keyValue = ReverseLookUp(item);
                if (string.IsNullOrEmpty(keyValue)) continue;

                // Check if already exists
                string checkSql;
                if (gcall == 2)
                {
                    checkSql = "SELECT COUNT(*) FROM tblSalesPersonArea WHERE Area = @KeyValue AND Sales_Person_ID = @UserId";
                }
                else
                {
                    checkSql = "SELECT COUNT(*) FROM DivisionUsers WHERE DivisionID = @KeyValue AND UserID = @UserId";
                }

                var checkDt = db.SqlExec(checkSql, new { KeyValue = keyValue, UserId });
                var count = Convert.ToInt32(checkDt.Rows[0][0]);

                if (count == 0)
                {
                    string insertSql;
                    if (gcall == 2)
                    {
                        insertSql = "INSERT INTO tblSalesPersonArea (Area, Sales_Person_ID) VALUES (@KeyValue, @UserId)";
                    }
                    else
                    {
                        insertSql = "INSERT INTO DivisionUsers (DivisionID, UserID) VALUES (@KeyValue, @UserId)";
                    }
                    db.SqlExec(insertSql, new { KeyValue = keyValue, UserId });
                }
            }

            Notifications.Info("Assignments saved successfully.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnSaveClick error");

            Notifications.Error($"Error saving: {ex.Message}");
        }
    }

    /// <summary>Command5: Exit</summary>
    private async Task OnExitClick()
    {
        if (OnClosed.HasDelegate)
        {
            await OnClosed.InvokeAsync(gcall);
        }
        else
        {
            ClosePage();
        }
    }
}
