                values.Add(row["Next_Cost2"]?.ToString() ?? "");
                values.Add(row["Next_Effective2"]?.ToString() ?? "");
            }
        }

        exportRow.Values = values;
        return exportRow;
    }

    private async Task ExportToFile(List<ExportRow> rows, string vendorDesc, bool corpPricing, bool showNextPricing, bool showComments)
    {
        var cleanName = CleanFileName(vendorDesc);
        var fileName = $"{cleanName}.xls";
        var fullPath = Path.Combine(ExportPath, fileName);

        try
        {
            // Ensure export directory exists (VB6: CreatePath)
            var dir = Path.GetDirectoryName(fullPath);
            if (!string.IsNullOrEmpty(dir) && !Directory.Exists(dir))
                Directory.CreateDirectory(dir);

            // Write tab-delimited file (VB6: SaveGrid with flexFileExcel writes tab-delimited .xls)
            using var writer = new StreamWriter(fullPath);
            foreach (var row in rows)
            {
                if (row.IsHeader)
                {
                    await writer.WriteLineAsync(row.HeaderText.Replace("|", "\t"));
                }
                else
                {
                    await writer.WriteLineAsync(string.Join("\t", row.Values));
                }
            }

            Console.WriteLine($"Exported {rows.Count} rows to {fullPath}");

        }
        catch (IOException ex)
        {
            // VB6: Error 70/75 - file access error
            Logger.LogWarning(ex, "Cannot create the {fullPath} file.");

            throw;
        }
    }

    private string CleanFileName(string name)
    {
        if (string.IsNullOrEmpty(name)) return "export";
        var invalid = System.IO.Path.GetInvalidFileNameChars();
        return new string(name.Where(c => !invalid.Contains(c)).ToArray());
    }

    // === Save Options ===
    private async Task SaveOptions()
    {
        try
        {
            await SaveOption("SortPricelistExportByItem", ChkSortByItem.ToString());
            await SaveOption("PricelistExportSingleFile", ChkSingleFile.ToString());
            await SaveOption("ClosePricelistExportDialog", ChkCloseWhenFinished.ToString());
            await SaveOption("PricelistExportNextPrices", ChkExportNextPrices.ToString());
            await SaveOption("PricelistExportComments", ChkExportComments.ToString());
            await SaveOption("PricelistExportPath", ExportPath);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SaveOptions error");

        }
    }

    private async Task SaveOption(string name, string value)
    {
        try
        {
            var exists = await db.ExecuteScalarAsync<int>(
                "SELECT COUNT(*) FROM tblOptions WHERE Name = @Name AND DivisionID = @DivisionID",
                new { Name = name, SessionState.DivisionID });
            if (exists > 0)
            {
                await db.ExecuteAsync(
                    "UPDATE tblOptions SET Value = @Value WHERE Name = @Name AND DivisionID = @DivisionID",
                    new { Value = value, Name = name, SessionState.DivisionID });
            }
            else
            {
                await db.ExecuteAsync(
                    "INSERT INTO tblOptions (Name, Value, DivisionID) VALUES (@Name, @Value, @DivisionID)",
                    new { Name = name, Value = value, SessionState.DivisionID });
            }
        }
        catch { /* non-critical */ }
    }

