            if (showNextPricing)
            {
                values.Add(row["Next_Cost1"]?.ToString() ?? "");
                values.Add(row["Next_Effective1"]?.ToString() ?? "");
                values.Add(row["Next_Cost2"]?.ToString() ?? "");
                values.Add(row["Next_Effective2"]?.ToString() ?? "");
            }
        }
        else
        {
            values.Add(row["Community"]?.ToString() ?? "");
            values.Add(row["CommunityPhase"]?.ToString() ?? "");
            values.Add(row["CommunityDesc"]?.ToString() ?? "");
            values.Add(row["Model"]?.ToString() ?? "");
            values.Add(row["Assembly"]?.ToString() ?? "");
            values.Add(row["AssemblyDesc"]?.ToString() ?? "");
            if (showComments)
            {
                values.Add(row["AssemblyComments"]?.ToString() ?? "");
                values.Add(row["POindex"]?.ToString() ?? "");
            }
            values.Add(row["Phase"]?.ToString() ?? "");
            values.Add(row["Item"]?.ToString() ?? "");
            values.Add(row["ItemDesc"]?.ToString() ?? "");
            values.Add(row["PartNumber"]?.ToString() ?? "");
            values.Add(row["OrderUOM"]?.ToString() ?? "");
            values.Add(row["Current_Cost"]?.ToString() ?? "");
            if (showNextPricing)
            {
