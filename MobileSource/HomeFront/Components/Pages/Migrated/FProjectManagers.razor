@page "/project-managers"
@namespace HomeFront.Components.Pages
@layout HFComponent
@rendermode InteractiveServer

@using HomeFront.Data
@using HomeFront.Models
@using System.Data
@using System.Reflection
@using System.Text
@using Fx.ControlKit
@using Fx.ControlKit.Notifications
@using Fx.ControlKit.Grid

@inject IJSRuntime JSRuntime
@inject ILogger<FProjectManagers> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db

<PageTitle>Project Managers - HomeFront</PageTitle>

<FProjectManagersModalHost IsModal="@IsModal" OnClose="ClosePage">
@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Project Managers...</div>
    </div>
}

<div class="project-managers-page">
    <div class="toolbar-cntr">
        <button class="tbar-btn" title="New" @onclick="OnNewClick">
            <img src="images/32/New.ico" alt="New" onerror="this.style.display='none'" />
            <span class="tool-label">New</span>
        </button>
        @* HHM-417: VB6 FProjectManagers toolbar Save is always enabled; SaveData
           no-ops when clean (.frm:359-366). Supersedes HHM-338's disable-when-clean. *@
        <button class="tbar-btn" title="Save" @onclick="() => SaveData(false)" disabled="@(!mDirty)">
            <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
            <span class="tool-label">Save</span>
        </button>
    </div>

    <div class="grid-host">
        <GridControl @ref="ManagersGrid"
        TValue="ProjectManagerRow"
        DataSource="@ManagersData"
        AllowSorting="true"
        AllowResizing="true"
        AllowSelection="true"
        AllowFiltering="true"
        EnableHover="true"
        Height="100%"
        Width="100%"
        Theme="GridTheme.Vb6Windows"
        WidthMode="GridWidthMode.FitColumns"
        BatchEditBehavior="GridBatchEditBehavior.SingleCell"
        FilterSettingsRef="@filterSettings"
        PageSettingsRef="@pageSettings"
        SelectionSettingsRef="@selectionSettings"
        EditSettingsRef="@editSettings"
        EventsRef="@gridEvents"
        OnLayoutChanged="@OnManagersLayoutChangedAsync">
    <GridColumnsBase @key="gManagersLayoutVersion">
        <GridColumn Field="@nameof(ProjectManagerRow.RowState)" Visible="false" />
        @if (HasGridLayout)
        {
            foreach (var entry in GetOrderedGridLayout())
            {
                var layout = entry.Layout;
                var fieldName = entry.Field;
                var columnType = entry.ColumnType;
                var textAlign = entry.TextAlign;
                var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                var width = GetColumnWidth(layout, fieldName);
                var allowEdit = IsFieldEditable(fieldName);
                var format = (columnType == ColumnType.Number) ? "#.00" : null;

                @if (string.Equals(layout.Field, "Password", StringComparison.OrdinalIgnoreCase) || fieldName == nameof(ProjectManagerRow.PasswordDisplay) || fieldName == "Password")
                {
                    <GridColumn Field="@nameof(ProjectManagerRow.Password)"
                                HeaderText="@headerText"
                                Width="@width"
                                Type="ColumnType.Password"
                                AllowEditing="true"
                                MaxLength="10"
                                SelectAllOnEdit="true"
                                ClipMode="ClipMode.Ellipsis" />
                }
                else if (fieldName == nameof(ProjectManagerRow.PrimaryUserID))
                {
                    <GridColumn Field="@fieldName"
                                HeaderText="@headerText"
                                Width="@width"
                                Type="@columnType"
                                TextAlign="@textAlign"
                                AllowEditing="false"
                                ShowEditButton="true"
                                ClipMode="ClipMode.Ellipsis" />
                }
                else if (fieldName == nameof(ProjectManagerRow.SecondaryUserID))
                {
                    <GridColumn Field="@fieldName"
                                HeaderText="@headerText"
                                Width="@width"
                                Type="@columnType"
                                TextAlign="@textAlign"
                                AllowEditing="false"
                                ShowEditButton="true"
                                ClipMode="ClipMode.Ellipsis" />
                }
                else
                {
                    <GridColumn Field="@fieldName"
                                  HeaderText="@headerText"
                                  Width="@width"
                                  Type="@columnType"
                                  TextAlign="@textAlign"
                                  AllowEditing="@allowEdit"
                                  MaxLength="@GetColumnMaxLength(fieldName)"
                                  Format="@format"
                                  ClipMode="ClipMode.Ellipsis" />
                }
            }
        }
        else
        {
            <GridColumn Field="@nameof(ProjectManagerRow.PM)" HeaderText="PM" Width="80px"
                          AllowEditing="true" MaxLength="10" />
            <GridColumn Field="@nameof(ProjectManagerRow.Password)" HeaderText="Password" Width="100px"
                          Type="ColumnType.Password" AllowEditing="true" MaxLength="10" SelectAllOnEdit="true" />
            <GridColumn Field="@nameof(ProjectManagerRow.PMName)" HeaderText="Name" Width="200px" />
            <GridColumn Field="@nameof(ProjectManagerRow.Phone)" HeaderText="Phone" Width="110px" />
            <GridColumn Field="@nameof(ProjectManagerRow.Cell)" HeaderText="Cell" Width="110px" />
            <GridColumn Field="@nameof(ProjectManagerRow.Fax)" HeaderText="Fax" Width="90px" />
            <GridColumn Field="@nameof(ProjectManagerRow.Email)" HeaderText="Email" Width="200px" />
            <GridColumn Field="@nameof(ProjectManagerRow.POLimit)" HeaderText="PO Limit" Width="100px"
                          Type="ColumnType.Number" Format="#.00" TextAlign="TextAlign.Right" />
            <GridColumn Field="@nameof(ProjectManagerRow.PrimaryUserID)" HeaderText="Primary User ID" Width="170px"
                          AllowEditing="false" ShowEditButton="true" />
            <GridColumn Field="@nameof(ProjectManagerRow.SecondaryUserID)" HeaderText="Secondary User ID" Width="190px"
                          AllowEditing="false" ShowEditButton="true" />
            <GridColumn Field="@nameof(ProjectManagerRow.PrjMgr)" HeaderText="Prj Mgr" Width="90px"
                          Type="ColumnType.CheckBox" />
            <GridColumn Field="@nameof(ProjectManagerRow.Estimator)" HeaderText="Estimator" Width="95px"
                          Type="ColumnType.CheckBox" />
            <GridColumn Field="@nameof(ProjectManagerRow.Purchaser)" HeaderText="Purchaser" Width="100px"
                          Type="ColumnType.CheckBox" />
            <GridColumn Field="@nameof(ProjectManagerRow.Active)" HeaderText="Active" Width="70px"
                          Type="ColumnType.CheckBox" />
        }
        </GridColumnsBase>
    </GridControl>
    </div>
</div>

@* ── Purchaser pick list (VB6 gData_CellButtonClick → FPickList.Choose) ──
   FlexKit FPickList replaces the former hand-rolled <div>/<table> modal.
   Lives at the component root so the in-cell "…" handler can launch it. *@
<FPickList @ref="purchaserPickList" OnSelected="OnPurchaserPickListSelected" />
<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />
</FProjectManagersModalHost>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    [Parameter] public bool IsModal { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task ClosePage()
    {
        if (!await SaveData(true))
            return;

        if (IsModal)
        {
            if (OnClose.HasDelegate)
                await OnClose.InvokeAsync();
        }
        else if (ParentNavigate != null)
        {
            ParentNavigate.Invoke("");
        }
        else
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private const string SRCFILE = "FProjectManagers::";

    // Database
// UI State
    private bool mDirty = false;
    private bool IsLoading = false;
    private GridControl<ProjectManagerRow>? ManagersGrid;
    private Fx.ControlKit.Dialogs.MessageBoxControl? _messageBox;

    // Grid Settings
    private FilterSettings filterSettings = new() { Type = FilterType.FilterBar };
    private PageSettings pageSettings = new() { PageSize = 50 };
    private SelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        // HHM-419: VB6 gData highlights the whole row; the dotted active-cell cue
        // keeps the FocusRect on the edited cell.
        Mode = SelectionMode.Row
    };
    private EditSettings editSettings = new()
    {
        AllowAdding = true,
        AllowEditing = true,
        AllowDeleting = false,
        Mode = EditMode.Batch,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };
    private GridControlEvents<ProjectManagerRow> gridEvents = new();

    // ── Grid layout via the shared GridLayoutPresenter ──────────
    // The load/resolve boilerplate lives in GridLayoutPresenter<TRow>; only the VB6
    // form/grid name strings + the layout-field aliases stay here (fidelity).
    // gManagersLayout / HasGridLayout / gManagersLayoutVersion below are thin
    // delegations, so the markup is unchanged. The keyed("(0)")-then-unkeyed two-call
    // fallback that LoadGridLayoutAsync used is now expressed via the ctor's
    // instanceKey, and the ResolveGridField switch is the ctor's alias map (keyed by
    // the normalized layout field).
    //
    // DRIFT (preserved, NOT delegated): (a) GetColumnTypeForField maps bool →
    // ColumnType.CheckBox where the canonical presenter uses ColumnType.Boolean — and
    // PrjMgr / Estimator / Purchaser / Active are rendered bool columns, so
    // GetOrdered must keep using the local type map; (b) this form's
    // ConvertLayoutWidthToPx has NO +16 padding (the presenter's WidthPx adds +16), so
    // it stays local too. Only Layout / Has / Version and ResolveGridField are delegated.
    private readonly GridLayoutPresenter<ProjectManagerRow> _managersGrid =
        new("FProjectManagers", "gData", instanceKey: "(0)",
            aliases: new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["name"] = nameof(ProjectManagerRow.PMName),
                ["managername"] = nameof(ProjectManagerRow.PMName),
                ["inactive"] = nameof(ProjectManagerRow.Active),
                ["workphone"] = nameof(ProjectManagerRow.Phone),
                ["cellphone"] = nameof(ProjectManagerRow.Cell)
            });

    private Dictionary<string, GridLayoutColumn> gManagersLayout => _managersGrid.Layout;
    private bool HasGridLayout => _managersGrid.Has;
    private int gManagersLayoutVersion => _managersGrid.Version;

    // Used by the local GetColumnTypeForField (kept due to the bool→CheckBox drift).
    private static readonly Dictionary<string, PropertyInfo> _projectManagerRowPropMap =
        typeof(ProjectManagerRow)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .GroupBy(p => NormalizeGridKey(p.Name))
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    // Data
    private List<ProjectManagerRow> ManagersData = new();

    // ── Purchaser pick list (FPickList) ──────────────────────────────
    // Single picker reused for the PrimaryUserID + SecondaryUserID cells;
    // OnSelected routes back via _pickTargetField (FVendor's _pickContext
    // pattern). Replaces VB6 FPickList.Choose(... where purchaser=1).
    private FPickList? purchaserPickList;
    private ProjectManagerRow? PickUserTargetRow;
    private string PickUserTargetField = "";

    // Lifecycle
    protected override async Task OnInitializedAsync()
    {
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<ProjectManagerRow>>(this, OnCellSaved);
        gridEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<ProjectManagerRow>>(this, OnGridEditButtonClick);
        await LoadGridLayoutAsync();
        await LoadData();
    }

    // Handle keyboard shortcuts
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "s" && e.CtrlKey)
        {
            await SaveData(false);
        }
        else if (e.Key == "Escape")
        {
            await ClosePage();
        }
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    // Load Data
    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var sql = "SELECT * FROM tblProjectManager";
            var rows = await db.QueryAsync(sql);

            ManagersData = rows.Select(r => new ProjectManagerRow
            {
                PM = r["PM"]?.ToString() ?? "",
                OriginalPM = r["PM"]?.ToString() ?? "",
                Password = r["Password"]?.ToString() ?? "",
                PasswordDisplay = new string('*', (r["Password"]?.ToString() ?? "").Length),
                PMName = r["PMName"]?.ToString() ?? "",
                Phone = r["Phone"]?.ToString() ?? "",
                Cell = r["Cell"]?.ToString() ?? "",
                Fax = r["Fax"]?.ToString() ?? "",
                Email = r["Email"]?.ToString() ?? "",
                POLimit = SafeDecimal(r.ContainsKey("POLimit") ? r["POLimit"] : null),
                PrimaryUserID = r["PrimaryUserID"]?.ToString() ?? "",
                SecondaryUserID = r["SecondaryUserID"]?.ToString() ?? "",
                PrjMgr = r["PrjMgr"]?.ToString() == "True" || r["PrjMgr"]?.ToString() == "1",
                Estimator = r["Estimator"]?.ToString() == "True" || r["Estimator"]?.ToString() == "1",
                Purchaser = r["Purchaser"]?.ToString() == "True" || r["Purchaser"]?.ToString() == "1",
                Active = !(r["InActive"]?.ToString() == "True" || r["InActive"]?.ToString() == "1"),
                RowState = "CLEAN"
            }).ToList();

            mDirty = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}LoadData]");

            Notifications.Error($"Error loading data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Save Data
    private async Task<bool> SaveData(bool prompt)
    {
        if (!mDirty)
            return true;

        if (prompt)
        {
            // HHM-421: VB6 SaveData MsgBox — vbExclamation + vbYesNoCancel, title = Me.Caption
            // "Project Managers". Yes = save, No = discard, Cancel = abort navigation.
            if (_messageBox == null) return false;
            var rc = await _messageBox.ShowAsync(
                "This data has changed.\n\nDo you want to save the changes?",
                title: "Project Managers",
                buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel,
                icon: "warning");
            if (rc == Fx.ControlKit.Dialogs.MessageBoxResult.Cancel) return false;
            if (rc == Fx.ControlKit.Dialogs.MessageBoxResult.No) { mDirty = false; return true; }
        }

        IsLoading = true;
        StateHasChanged();
        try
        {
            foreach (var row in ManagersData.Where(r => r.RowState == "DIRTY"))
            {
                if (string.IsNullOrWhiteSpace(row.PM))
                {
                    IsLoading = false;
                    StateHasChanged();
                    Notifications.Info("The ID field cannot be blank");
                    return false;
                }

                if (string.IsNullOrEmpty(row.OriginalPM))
                {
                    // INSERT
                    var insertSql = @"
                        INSERT INTO tblProjectManager(PM, Password, PMName, Phone, Cell, Fax, Email, POLimit,
                            PrimaryUserID, SecondaryUserID, PrjMgr, Estimator, Purchaser, InActive)
                        VALUES(@PM, @Password, @PMName, @Phone, @Cell, @Fax, @Email, @POLimit,
                            @PrimaryUserID, @SecondaryUserID, @PrjMgr, @Estimator, @Purchaser, @InActive)";
                    await db.ExecuteAsync(insertSql, new
                    {
                        row.PM,
                        row.Password,
                        row.PMName,
                        row.Phone,
                        row.Cell,
                        row.Fax,
                        row.Email,
                        row.POLimit,
                        row.PrimaryUserID,
                        row.SecondaryUserID,
                        row.PrjMgr,
                        row.Estimator,
                        row.Purchaser,
                        InActive = !row.Active
                    });

                    // Mark the row persisted so a follow-up edit + Save takes the
                    // UPDATE branch. VB6 stores the original id only on the rename
                    // path (.frm:451); a freshly inserted row kept flexcpData=""
                    // and a second Save re-INSERTed, hitting the duplicate-ID error.
                    row.OriginalPM = row.PM;
                }
                else
                {
                    // UPDATE
                    var updateSql = @"
                        UPDATE tblProjectManager SET
                            PM = @PM,
                            Password = @Password,
                            PMName = @PMName,
                            Phone = @Phone,
                            Cell = @Cell,
                            Fax = @Fax,
                            Email = @Email,
                            POLimit = @POLimit,
                            PrimaryUserID = @PrimaryUserID,
                            SecondaryUserID = @SecondaryUserID,
                            PrjMgr = @PrjMgr,
                            Estimator = @Estimator,
                            Purchaser = @Purchaser,
                            InActive = @InActive
                        WHERE PM = @OriginalPM";
                    await db.ExecuteAsync(updateSql, new
                    {
                        row.PM,
                        row.Password,
                        row.PMName,
                        row.Phone,
                        row.Cell,
                        row.Fax,
                        row.Email,
                        row.POLimit,
                        row.PrimaryUserID,
                        row.SecondaryUserID,
                        row.PrjMgr,
                        row.Estimator,
                        row.Purchaser,
                        InActive = !row.Active,
                        row.OriginalPM
                    });
                }

                // Update user_manager
                var nameParts = (row.PMName ?? "").Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
                var firstName = nameParts.Length > 0 ? nameParts[0] : "";
                var lastName = nameParts.Length > 1 ? nameParts[1] : "";

                var userManagerSql = @"
                    UPDATE user_manager
                    SET email = p.email,
                        firstname = @FirstName,
                        lastname = @LastName
                    FROM tblprojectmanager p
                    JOIN user_manager u ON u.user_id = p.pm AND u.pmuser = 1
                    WHERE p.pm = @OriginalPM";
                await db.ExecuteAsync(userManagerSql, new
                {
                    FirstName = firstName,
                    LastName = lastName,
                    OriginalPM = string.IsNullOrEmpty(row.OriginalPM) ? row.PM : row.OriginalPM
                });

                // If PM ID changed, update references in tblJobs
                if (!string.IsNullOrEmpty(row.OriginalPM) && row.OriginalPM != row.PM)
                {
                    await db.ExecuteAsync(
                        "UPDATE tblJobs SET PM = @NewPM WHERE PM = @OldPM",
                        new { NewPM = row.PM, OldPM = row.OriginalPM });
                    await db.ExecuteAsync(
                        "UPDATE tblJobs SET Estimator = @NewPM WHERE Estimator = @OldPM",
                        new { NewPM = row.PM, OldPM = row.OriginalPM });
                    await db.ExecuteAsync(
                        "UPDATE tblJobs SET Purchaser = @NewPM WHERE Purchaser = @OldPM",
                        new { NewPM = row.PM, OldPM = row.OriginalPM });

                    row.OriginalPM = row.PM;
                }

                row.RowState = "CLEAN";
            }

            mDirty = false;
            // HHM-420: VB6 SaveData walks the current cell over every row, so the
            // highlight never lingers on the edited column after Save.
            if (ManagersGrid != null) await ManagersGrid.ClearActiveCellAsync();
            // HHM-420: VB6 SaveData's ".Row = r" walk (FProjectManagers.frm:381-384) leaves the
            // CURRENT row on the LAST row after Save, with the whole row highlighted
            // (SelectionMode=3, HighLight=1) - so select the last row to match.
            if (ManagersGrid != null && ManagersData.Count > 0) ManagersGrid.SelectRow(ManagersData.Count - 1);
            StateHasChanged();
            return true;
        }
        catch (Exception ex)
        {
            if (ex.Message.IndexOf("duplicate", StringComparison.OrdinalIgnoreCase) >= 0)
            {
                Notifications.Error("This ID is taken. Please choose something else.");
            }
            else
            {
                Logger.LogError(ex, "[{SRCFILE}SaveData]");

                Notifications.Error($"Error saving data: {ex.Message}");
            }
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // VB6 gData_BeforeEdit .EditMaxLength per column (FProjectManagers.frm:529-544):
    // PM/ID=10, Password=10, Name=50, Phone/Mobile/Fax=25, Email=150.
    private static int? GetColumnMaxLength(string field) => field switch
    {
        nameof(ProjectManagerRow.PM) => 10,
        nameof(ProjectManagerRow.Password) => 10,
        nameof(ProjectManagerRow.PMName) => 50,
        nameof(ProjectManagerRow.Phone) or nameof(ProjectManagerRow.Cell) or nameof(ProjectManagerRow.Fax) => 25,
        nameof(ProjectManagerRow.Email) => 150,
        _ => (int?)null
    };

    // New button
    private void OnNewClick()
    {
        var newRow = new ProjectManagerRow
        {
            PM = "",
            OriginalPM = "",
            Password = "",
            PasswordDisplay = "",
            PMName = "(new manager)",
            Phone = "",
            Cell = "",
            Fax = "",
            Email = "",
            POLimit = 0,
            PrimaryUserID = "",
            SecondaryUserID = "",
            PrjMgr = true,
            Estimator = false,
            Purchaser = false,
            Active = true,
            RowState = "DIRTY"
        };
        ManagersData.Add(newRow);
        mDirty = true;
        StateHasChanged();
    }

    // Cell saved event
    private void OnCellSaved(CellSaveArgs<ProjectManagerRow> args)
    {
        if (args.Data != null)
        {
            args.Data.RowState = "DIRTY";
            mDirty = true;
        }
    }

    private async Task OnGridEditButtonClick(CellEditButtonArgs<ProjectManagerRow> args)
    {
        if (args.Data == null)
            return;

        if (string.Equals(args.ColumnName, nameof(ProjectManagerRow.PrimaryUserID), StringComparison.OrdinalIgnoreCase))
        {
            await OnPickPrimaryUser(args.Data);
        }
        else if (string.Equals(args.ColumnName, nameof(ProjectManagerRow.SecondaryUserID), StringComparison.OrdinalIgnoreCase))
        {
            await OnPickSecondaryUser(args.Data);
        }
    }

    // Pick Primary User (VB6 gData_CellButtonClick "PrimaryUserID")
    private async Task OnPickPrimaryUser(ProjectManagerRow row)
    {
        PickUserTargetRow = row;
        PickUserTargetField = "PrimaryUserID";
        await OpenPurchaserPickList();
    }

    // Pick Secondary User (VB6 gData_CellButtonClick "SecondaryUserID")
    private async Task OnPickSecondaryUser(ProjectManagerRow row)
    {
        PickUserTargetRow = row;
        PickUserTargetField = "SecondaryUserID";
        await OpenPurchaserPickList();
    }

    // Launch the FlexKit picker over purchasers (VB6 line 551:
    // FPickList.Choose(..., "Purchasers",
    //   "select pm ID,pmname Name from tblprojectmanager where purchaser=1")).
    // No DivisionID filter — tblprojectmanager has no DivisionID column.
    private async Task OpenPurchaserPickList()
    {
        if (purchaserPickList == null) return;
        await purchaserPickList.Open(
            title: "Purchasers",
            queries: "SELECT pm ID, pmname Name FROM tblprojectmanager WHERE purchaser = 1",
            hideColumns: null,
            multiSelect: false);
    }

    // FPickList OnSelected callback — sets the targeted user-id cell.
    private async Task OnPurchaserPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        if (PickUserTargetRow != null && selectedRows.Count > 0)
        {
            var id = GetRowString(selectedRows[0], "ID");
            if (PickUserTargetField == "PrimaryUserID")
                PickUserTargetRow.PrimaryUserID = id;
            else if (PickUserTargetField == "SecondaryUserID")
                PickUserTargetRow.SecondaryUserID = id;

            PickUserTargetRow.RowState = "DIRTY";
            mDirty = true;
        }
        PickUserTargetRow = null;
        PickUserTargetField = "";
        await InvokeAsync(StateHasChanged);
    }

    private static string GetRowString(IDictionary<string, object> row, string key)
    {
        if (row.TryGetValue(key, out var v)) return v?.ToString() ?? "";
        foreach (var kvp in row)
            if (string.Equals(kvp.Key, key, StringComparison.OrdinalIgnoreCase))
                return kvp.Value?.ToString() ?? "";
        return "";
    }

    // Helpers
    private decimal SafeDecimal(object? val, decimal def = 0) =>
        val != null && val != DBNull.Value && !string.IsNullOrEmpty(val.ToString())
            ? Convert.ToDecimal(val) : def;

    // ── Load Grid Layout ──────────────────────────────────────
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            // The keyed/unkeyed fallback + Version bump live in the presenter
            // (its ctor was given the "FProjectManagers"/"gData" names + instanceKey "(0)").
            await _managersGrid.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");

        }
    }

    // GridControl raises OnLayoutChanged when a resize/reorder/hide/group/rename
    // finishes; the new state is on the snapshot, not in the layout dict, so it
    // has to be merged in before the write.
    private Task OnManagersLayoutChangedAsync(GridSettings snapshot) =>
        PersistGridLayoutAsync("gData", gManagersLayout, snapshot, _managersGrid);

    private async Task PersistGridLayoutAsync<T>(string gridName,
        IDictionary<string, GridLayoutColumn> layout, GridSettings snapshot,
        GridLayoutPresenter<T> presenter)
    {
        if (snapshot == null || layout.Count == 0) return;
        try
        {
            // instanceKey stays null: the load's keyed "(0)" probe finds nothing
            // and falls back to the plain "FProjectManagers.gData" tag, which is
            // where the rows the snapshot describes actually live.
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FProjectManagers", gridName, instanceKey: null,
                layout, snapshot, ResolveGridField, staticNames: false);

            presenter.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FProjectManagers {Grid} layout", gridName);
        }
    }

    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedGridLayout()
    {
        if (!HasGridLayout) yield break;

        var ordered = gManagersLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = ResolveGridField(layout.Field);
            var columnType = GetColumnTypeForField(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    // Delegated: the alias switch moved verbatim to the presenter ctor's alias map.
    private string ResolveGridField(string layoutField)
        => _managersGrid.ResolveField(layoutField);

    // DRIFT (preserved): maps bool → ColumnType.CheckBox (canonical presenter uses
    // ColumnType.Boolean). PrjMgr / Estimator / Purchaser / Active render as
    // checkboxes, so this stays local — see the note on the presenter field above.
    private static ColumnType GetColumnTypeForField(string field)
    {
        if (string.IsNullOrWhiteSpace(field)) return ColumnType.Text;
        if (string.Equals(field, nameof(ProjectManagerRow.Password), StringComparison.OrdinalIgnoreCase))
            return ColumnType.Password;
        if (_projectManagerRowPropMap.TryGetValue(NormalizeGridKey(field), out var prop))
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool)) return ColumnType.CheckBox;
            if (type == typeof(int) || type == typeof(long) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
        }
        return ColumnType.Text;
    }

    private static bool IsFieldEditable(string field)
    {
        return field switch
        {
            "RowState" or "OriginalPM"
                or nameof(ProjectManagerRow.PrimaryUserID)
                or nameof(ProjectManagerRow.SecondaryUserID) => false,
            _ => true
        };
    }

    private static string? GetColumnWidth(GridLayoutColumn layout, string fieldName)
    {
        var width = layout.Width.HasValue && layout.Width.Value > 0
            ? ConvertLayoutWidthToPx(layout.Width.Value)
            : 0;
        var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
        width = Math.Max(width, EstimateHeaderWidthPx(headerText));
        width = Math.Max(width, GetMinimumColumnWidthPx(fieldName));
        return width > 0 ? $"{width}px" : null;
    }

    private static int GetMinimumColumnWidthPx(string fieldName) =>
        fieldName switch
        {
            nameof(ProjectManagerRow.PM) => 80,
            nameof(ProjectManagerRow.Password) or nameof(ProjectManagerRow.PasswordDisplay) => 100,
            nameof(ProjectManagerRow.PMName) => 200,
            nameof(ProjectManagerRow.Phone) => 110,
            nameof(ProjectManagerRow.Cell) => 110,
            nameof(ProjectManagerRow.Fax) => 90,
            nameof(ProjectManagerRow.Email) => 200,
            nameof(ProjectManagerRow.POLimit) => 100,
            nameof(ProjectManagerRow.PrimaryUserID) => 170,
            nameof(ProjectManagerRow.SecondaryUserID) => 190,
            nameof(ProjectManagerRow.PrjMgr) => 90,
            nameof(ProjectManagerRow.Estimator) => 95,
            nameof(ProjectManagerRow.Purchaser) => 100,
            nameof(ProjectManagerRow.Active) => 70,
            _ => 0
        };

    private static int EstimateHeaderWidthPx(string? headerText)
    {
        if (string.IsNullOrWhiteSpace(headerText))
            return 0;

        return Math.Min(260, Math.Max(48, headerText.Trim().Length * 7 + 24));
    }

    // Width policy: single canonical twips→px (/15 + 16, clamp). The prior body
    // omitted the +16 padding — drift removed; all forms use GridLayoutPresenter.WidthPx.
    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    private static string NormalizeGridKey(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var sb = new StringBuilder(value.Length);
        foreach (var ch in value)
        {
            if (char.IsLetterOrDigit(ch))
                sb.Append(char.ToLowerInvariant(ch));
        }
        return sb.ToString();
    }

    // Models
    public class ProjectManagerRow
    {
        public string PM { get; set; } = "";
        public string OriginalPM { get; set; } = "";
        public string Password { get; set; } = "";
        public string PasswordDisplay { get; set; } = "";
        public string PMName { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Cell { get; set; } = "";
        public string Fax { get; set; } = "";
        public string Email { get; set; } = "";
        public decimal POLimit { get; set; }
        public string PrimaryUserID { get; set; } = "";
        public string SecondaryUserID { get; set; } = "";
        public bool PrjMgr { get; set; }
        public bool Estimator { get; set; }
        public bool Purchaser { get; set; }
        public bool Active { get; set; } = true;
        public string RowState { get; set; } = "CLEAN";
    }
}
