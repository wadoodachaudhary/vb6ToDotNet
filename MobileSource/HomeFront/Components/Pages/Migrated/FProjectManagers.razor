```razor
@page "/project-managers"
@rendermode InteractiveServer

@using HomeFront.Components.Grid
@using HomeFront.Data
@using System.Data

@inject IJSRuntime JSRuntime

<PageTitle>Project Managers - HomeFront</PageTitle>

<style>
    .toolbar-cntr {
        padding: 8px 12px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .tbar-btn {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        padding: 6px 12px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 11px;
        transition: background 0.15s;
        min-width: 60px;
    }

    .tbar-btn:hover:not(:disabled) { background: #e9ecef; }
    .tbar-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .tbar-btn img { height: 24px; width: 24px; margin-bottom: 4px; }
    .tbar-separator { width: 1px; height: 36px; background: #ced4da; margin: 0 4px; }
    .tool-label { font-size: 11px; }

    .loading-overlay {
        position: absolute; height: 92%; width: 100%;
        background-color: rgba(1,1,1,0.2); z-index: 10000;
        display: flex; align-items: center; justify-content: center;
    }

    .loading-spinner {
        padding: 20px 40px; background: #fff; border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2); font-size: 16px;
        font-weight: 500; color: #333;
    }

    .dirty-row { background-color: #fff3cd !important; }

    .password-cell {
        letter-spacing: 2px;
    }

    .dialog-overlay {
        position: fixed; inset: 0; z-index: 1000;
        background: rgba(0,0,0,0.3); display: flex;
        align-items: center; justify-content: center;
    }

    .dialog-panel {
        background: #fff; border-radius: 8px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.2);
        min-width: 400px; max-width: 600px; max-height: 80vh;
        display: flex; flex-direction: column; overflow: hidden;
    }

    .dialog-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px 20px; font-weight: 600; font-size: 16px;
        border-bottom: 1px solid #dee2e6;
    }

    .dialog-header button {
        background: none; border: none; font-size: 22px;
        cursor: pointer; color: #6c757d; padding: 0 4px;
    }

    .dialog-header button:hover { color: #212529; }

    .dialog-body { padding: 20px; overflow-y: auto; flex: 1; }

    .dialog-body label {
        display: block; font-weight: 500; margin-bottom: 4px;
        font-size: 13px; color: #495057;
    }

    .dialog-body .form-group { margin-bottom: 14px; }

    .dialog-body input, .dialog-body select {
        width: 100%; padding: 8px 10px; border: 1px solid #ced4da;
        border-radius: 4px; font-size: 14px; box-sizing: border-box;
    }

    .dialog-body input:focus, .dialog-body select:focus {
        border-color: #86b7fe; outline: 0;
        box-shadow: 0 0 0 2px rgba(13,110,253,0.15);
    }

    .dialog-footer {
        display: flex; justify-content: flex-end; gap: 8px;
        padding: 12px 20px; border-top: 1px solid #dee2e6; background: #f8f9fa;
    }

    .dialog-footer .btn {
        padding: 6px 20px; border: 1px solid #ced4da; border-radius: 4px;
        background: #fff; cursor: pointer; font-size: 14px;
    }

    .dialog-footer .btn:hover { background: #e9ecef; }
    .dialog-footer .btn-primary { background: #0d6efd; color: #fff; border-color: #0d6efd; }
    .dialog-footer .btn-primary:hover { background: #0b5ed7; }
</style>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Project Managers...</div>
    </div>
}

<div class="toolbar-cntr">
    <button class="tbar-btn" @onclick="OnNewClick">
        <img src="images/32/New.ico" alt="New" onerror="this.style.display='none'" />
        <span class="tool-label">New</span>
    </button>
    <button class="tbar-btn" disabled="@(!mDirty)" @onclick="() => SaveData(false)">
        <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
        <span class="tool-label">Save</span>
    </button>
</div>

<h3 style="margin-bottom: 16px;">Project Managers</h3>

<HfGrid @ref="ManagersGrid"
        TValue="ProjectManagerRow"
        DataSource="@ManagersData"
        AllowSorting="true"
        AllowResizing="true"
        AllowSelection="true"
        AllowFiltering="true"
        EnableHover="true"
        Height="calc(100vh - 220px)"
        FilterSettingsRef="@filterSettings"
        PageSettingsRef="@pageSettings"
        SelectionSettingsRef="@selectionSettings"
        EditSettingsRef="@editSettings"
        EventsRef="@gridEvents">
    <HfGridColumnsBase>
        <HfGridColumn Field="@nameof(ProjectManagerRow.PM)" HeaderText="PM" Width="100px"
                      IsPrimaryKey="true" />
        <HfGridColumn Field="@nameof(ProjectManagerRow.PasswordDisplay)" HeaderText="Password" Width="100px">
            <Template>
                @{
                    var row = (ProjectManagerRow)context;
                    <span class="password-cell">@row.PasswordDisplay</span>
                }
            </Template>
            <EditTemplate>
                @{
                    var row = (ProjectManagerRow)context;
                    <input type="password" maxlength="10" value="@row.Password"
                           @onchange="e => OnPasswordChanged(row, e)" />
                }
            </EditTemplate>
        </HfGridColumn>
        <HfGridColumn Field="@nameof(ProjectManagerRow.PMName)" HeaderText="Name" Width="200px" />
        <HfGridColumn Field="@nameof(ProjectManagerRow.Phone)" HeaderText="Phone" Width="130px" />
        <HfGridColumn Field="@nameof(ProjectManagerRow.Cell)" HeaderText="Cell" Width="130px" />
        <HfGridColumn Field="@nameof(ProjectManagerRow.Fax)" HeaderText="Fax" Width="130px" />
        <HfGridColumn Field="@nameof(ProjectManagerRow.Email)" HeaderText="Email" Width="200px" />
        <HfGridColumn Field="@nameof(ProjectManagerRow.POLimit)" HeaderText="PO Limit" Width="100px"
                      Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" />
        <HfGridColumn Field="@nameof(ProjectManagerRow.PrimaryUserID)" HeaderText="Primary User ID" Width="130px">
            <Template>
                @{
                    var row = (ProjectManagerRow)context;
                    <span>@row.PrimaryUserID</span>
                    <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                            @onclick="() => OnPickPrimaryUser(row)" @onclick:stopPropagation="true">🔍</button>
                }
            </Template>
        </HfGridColumn>
        <HfGridColumn Field="@nameof(ProjectManagerRow.SecondaryUserID)" HeaderText="Secondary User ID" Width="130px">
            <Template>
                @{
                    var row = (ProjectManagerRow)context;
                    <span>@row.SecondaryUserID</span>
                    <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                            @onclick="() => OnPickSecondaryUser(row)" @onclick:stopPropagation="true">🔍</button>
                }
            </Template>
        </HfGridColumn>
        <HfGridColumn Field="@nameof(ProjectManagerRow.PrjMgr)" HeaderText="Prj Mgr" Width="80px"
                      Type="ColumnType.CheckBox" />
        <HfGridColumn Field="@nameof(ProjectManagerRow.Estimator)" HeaderText="Estimator" Width="80px"
                      Type="ColumnType.CheckBox" />
        <HfGridColumn Field="@nameof(ProjectManagerRow.Purchaser)" HeaderText="Purchaser" Width="80px"
                      Type="ColumnType.CheckBox" />
        <HfGridColumn Field="@nameof(ProjectManagerRow.Active)" HeaderText="Active" Width="80px"
                      Type="ColumnType.CheckBox" />
        <HfGridColumn Field="@nameof(ProjectManagerRow.RowState)" Visible="false" />
    </HfGridColumnsBase>
</HfGrid>

@* ── Pick User Dialog ──────────────────────────────────────────── *@
@if (IsPickUserDialogVisible)
{
    <div class="dialog-overlay" @onclick="() => IsPickUserDialogVisible = false">
        <div class="dialog-panel" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <span>Select Purchaser</span>
                <button @onclick="() => IsPickUserDialogVisible = false">×</button>
            </div>
            <div class="dialog-body">
                @if (PurchaserList.Any())
                {
                    <table style="width:100%; border-collapse:collapse;">
                        <thead>
                            <tr style="background:#f0f0f0;">
                                <th style="padding:6px 10px; text-align:left; border-bottom:1px solid #dee2e6;">ID</th>
                                <th style="padding:6px 10px; text-align:left; border-bottom:1px solid #dee2e6;">Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in PurchaserList)
                            {
                                <tr style="cursor:pointer;" @onclick="() => OnPurchaserSelected(p.ID)"
                                    class="@(p.ID == SelectedPickUserId ? "table-active" : "")">
                                    <td style="padding:6px 10px; border-bottom:1px solid #eee;">@p.ID</td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #eee;">@p.Name</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No purchasers found.</p>
                }
            </div>
            <div class="dialog-footer">
                <button class="btn" @onclick="() => IsPickUserDialogVisible = false">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private const string SRCFILE = "FProjectManagers::";

    // Database
    private DbWrapperSqlServer db = new();

    // UI State
    private bool mDirty = false;
    private bool IsLoading = false;
    private HfGrid<ProjectManagerRow>? ManagersGrid;

    // Grid Settings
    private HfFilterSettings filterSettings = new() { Type = FilterType.FilterBar };
    private HfPageSettings pageSettings = new() { PageSize = 50 };
    private HfSelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };
    private HfEditSettings editSettings = new()
    {
        AllowAdding = true,
        AllowEditing = true,
        AllowDeleting = false,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };
    private HfGridEvents<ProjectManagerRow> gridEvents = new();

    // Data
    private List<ProjectManagerRow> ManagersData = new();

    // Pick User Dialog
    private bool IsPickUserDialogVisible = false;
    private ProjectManagerRow? PickUserTargetRow;
    private string PickUserTargetField = "";
    private string SelectedPickUserId = "";
    private List<PurchaserItem> PurchaserList = new();

    // Lifecycle
    protected override async Task OnInitializedAsync()
    {
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<ProjectManagerRow>>(this, OnCellSaved);
        await LoadData();
    }

    // Handle keyboard shortcuts
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "s" && e.CtrlKey)
        {
            await SaveData(false);
        }
        else if (e.Key == "Escape")
        {
            if (mDirty)
            {
                if (!await SaveData(true))
                    return;
            }
            NavigationManager.NavigateTo("/");
        }
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    // Load Data
    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var sql = "SELECT * FROM tblProjectManager";
            var rows = await db.QueryAsync(sql);

            ManagersData = rows.Select(r => new ProjectManagerRow
            {
                PM = r["PM"]?.ToString() ?? "",
                OriginalPM = r["PM"]?.ToString() ?? "",
                Password = r["Password"]?.ToString() ?? "",
                PasswordDisplay = new string('*', (r["Password"]?.ToString() ?? "").Length),
                PMName = r["PMName"]?.ToString() ?? "",
                Phone = r["Phone"]?.ToString() ?? "",
                Cell = r["Cell"]?.ToString() ?? "",
                Fax = r["Fax"]?.ToString() ?? "",
                Email = r["Email"]?.ToString() ?? "",
                POLimit = SafeDecimal(r.ContainsKey("POLimit") ? r["POLimit"] : null),
                PrimaryUserID = r["PrimaryUserID"]?.ToString() ?? "",
                SecondaryUserID = r["SecondaryUserID"]?.ToString() ?? "",
                PrjMgr = r["PrjMgr"]?.ToString() == "True" || r["PrjMgr"]?.ToString() == "1",
                Estimator = r["Estimator"]?.ToString() == "True" || r["Estimator"]?.ToString() == "1",
                Purchaser = r["Purchaser"]?.ToString() == "True" || r["Purchaser"]?.ToString() == "1",
                Active = !(r["InActive"]?.ToString() == "True" || r["InActive"]?.ToString() == "1"),
                RowState = "CLEAN"
            }).ToList();

            mDirty = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[{SRCFILE}LoadData] Error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Save Data
    private async Task<bool> SaveData(bool prompt)
    {
        if (!mDirty)
            return true;

        if (prompt)
        {
            var result = await JSRuntime.InvokeAsync<string>("eval",
                "confirm('This data has changed.\\n\\nDo you want to save the changes?') ? 'yes' : 'no'");
            if (result == "no")
                return true;
        }

        IsLoading = true;
        StateHasChanged();
        try
        {
            foreach (var row in ManagersData.Where(r => r.RowState == "DIRTY"))
            {
                if (string.IsNullOrWhiteSpace(row.PM))
                {
                    IsLoading = false;
                    StateHasChanged();
                    await JSRuntime.InvokeVoidAsync("alert", "The ID field cannot be blank");
                    return false;
                }

                if (string.IsNullOrEmpty(row.OriginalPM))
                {
                    // INSERT
                    var insertSql = @"
                        INSERT INTO tblProjectManager(PM, Password, PMName, Phone, Cell, Fax, Email, POLimit,
                            PrimaryUserID, SecondaryUserID, PrjMgr, Estimator, Purchaser, InActive)
                        VALUES(@PM, @Password, @PMName, @Phone, @Cell, @Fax, @Email, @POLimit,
                            @PrimaryUserID, @SecondaryUserID, @PrjMgr, @Estimator, @Purchaser, @InActive)";
                    await db.ExecuteAsync(insertSql, new
                    {
                        row.PM,
                        row.Password,
                        row.PMName,
                        row.Phone,
                        row.Cell,
                        row.Fax,
                        row.Email,
                        row.POLimit,
                        row.PrimaryUserID,
                        row.SecondaryUserID,
                        row.PrjMgr,
                        row.Estimator,
                        row.Purchaser,
                        InActive = !row.Active
                    });
                }
                else
                {
                    // UPDATE
                    var updateSql = @"
                        UPDATE tblProjectManager SET
                            PM = @PM,
                            Password = @Password,
                            PMName = @PMName,
                            Phone = @Phone,
                            Cell = @Cell,
                            Fax = @Fax,
                            Email = @Email,
                            POLimit = @POLimit,
                            PrimaryUserID = @PrimaryUserID,
                            SecondaryUserID = @SecondaryUserID,
                            PrjMgr = @PrjMgr,
                            Estimator = @Estimator,
                            Purchaser = @Purchaser,
                            InActive = @InActive
                        WHERE PM = @OriginalPM";
                    await db.ExecuteAsync(updateSql, new
                    {
                        row.PM,
                        row.Password,
                        row.PMName,
                        row.Phone,
                        row.Cell,
                        row.Fax,
                        row.Email,
                        row.POLimit,
                        row.PrimaryUserID,
                        row.SecondaryUserID,
                        row.PrjMgr,
                        row.Estimator,
                        row.Purchaser,
                        InActive = !row.Active,
                        row.OriginalPM
                    });
                }

                // Update user_manager
                var nameParts = (row.PMName ?? "").Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
                var firstName = nameParts.Length > 0 ? nameParts[0] : "";
                var lastName = nameParts.Length > 1 ? nameParts[1] : "";

                var userManagerSql = @"
                    UPDATE user_manager
                    SET email = p.email,
                        firstname = @FirstName,
                        lastname = @LastName
                    FROM tblprojectmanager p
                    JOIN user_manager u ON u.user_id = p.pm AND u.pmuser = 1
                    WHERE p.pm = @OriginalPM";
                await db.ExecuteAsync(userManagerSql, new
                {
                    FirstName = firstName,
                    LastName = lastName,
                    OriginalPM = string.IsNullOrEmpty(row.OriginalPM) ? row.PM : row.OriginalPM
                });

                // If PM ID changed, update references in tblJobs
                if (!string.IsNullOrEmpty(row.OriginalPM) && row.OriginalPM != row.PM)
                {
                    await db.ExecuteAsync(
                        "UPDATE tblJobs SET PM = @NewPM WHERE PM = @OldPM",
                        new { NewPM = row.PM, OldPM = row.OriginalPM });
                    await db.ExecuteAsync(
                        "UPDATE tblJobs SET Estimator = @NewPM WHERE Estimator = @OldPM",
                        new { NewPM = row.PM, OldPM = row.OriginalPM });
                    await db.ExecuteAsync(
                        "UPDATE tblJobs SET Purchaser = @NewPM WHERE Purchaser = @OldPM",
                        new { NewPM = row.PM, OldPM = row.OriginalPM });

                    row.OriginalPM = row.PM;
                }

                row.RowState = "CLEAN";
            }

            mDirty = false;
            StateHasChanged();
            return true;
        }
        catch (Exception ex)
        {
            if (ex.Message.IndexOf("duplicate", StringComparison.OrdinalIgnoreCase) >= 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "This ID is taken. Please choose something else.");
            }
            else
            {
                Console.WriteLine($"[{SRCFILE}SaveData] Error: {ex.Message}");
                await JSRuntime.InvokeVoidAsync("alert", $"Error saving data: {ex.Message}");
            }
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // New button
    private void OnNewClick()
    {
        var newRow = new ProjectManagerRow
        {
            PM = "",
            OriginalPM = "",
            Password = "",
            PasswordDisplay = "",
            PMName = "(new manager)",
            Phone = "",
            Cell = "",
            Fax = "",
            Email = "",
            POLimit = 0,
            PrimaryUserID = "",
            SecondaryUserID = "",
            PrjMgr = true,
            Estimator = false,
            Purchaser = false,
            Active = true,
            RowState = "DIRTY"
        };
        ManagersData.Add(newRow);
        mDirty = true;
        StateHasChanged();
    }

    // Cell saved event
    private void OnCellSaved(CellSaveArgs<ProjectManagerRow> args)
    {
        if (args.Data != null)
        {
            args.Data.RowState = "DIRTY";
            mDirty = true;
        }
    }

    // Password changed
    private void OnPasswordChanged(ProjectManagerRow row, ChangeEventArgs e)
    {
        row.Password = e.Value?.ToString() ?? "";
        row.PasswordDisplay = new string('*', row.Password.Length);
        row.RowState = "DIRTY";
        mDirty = true;
        StateHasChanged();
    }

    // Pick Primary User
    private async Task OnPickPrimaryUser(ProjectManagerRow row)
    {
        PickUserTargetRow = row;
        PickUserTargetField = "PrimaryUserID";
        await LoadPurchaserList();
        IsPickUserDialogVisible = true;
        StateHasChanged();
    }

    // Pick Secondary User
    private async Task OnPickSecondaryUser(ProjectManagerRow row)
    {
        PickUserTargetRow = row;
        PickUserTargetField = "SecondaryUserID";
        await LoadPurchaserList();
        IsPickUserDialogVisible = true;
        StateHasChanged();
    }

    // Load purchaser list for pick dialog
    private async Task LoadPurchaserList()
    {
        try
        {
            var sql = "SELECT pm AS ID, pmname AS Name FROM tblprojectmanager WHERE purchaser = 1 ORDER BY pm";
            var rows = await db.QueryAsync(sql);
            PurchaserList = rows.Select(r => new PurchaserItem
            {
                ID = r["ID"]?.ToString() ?? "",
                Name = r["Name"]?.ToString() ?? ""
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[{SRCFILE}LoadPurchaserList] Error: {ex.Message}");
            PurchaserList = new();
        }
    }

    // Purchaser selected from dialog
    private void OnPurchaserSelected(string id)
    {
        if (PickUserTargetRow != null)
        {
            if (PickUserTargetField == "PrimaryUserID")
                PickUserTargetRow.PrimaryUserID = id;
            else if (PickUserTargetField == "SecondaryUserID")
                PickUserTargetRow.SecondaryUserID = id;

            PickUserTargetRow.RowState = "DIRTY";
            mDirty = true;
        }
        IsPickUserDialogVisible = false;
        StateHasChanged();
    }

    // Helpers
    private decimal SafeDecimal(object? val, decimal def = 0) =>
        val != null && val != DBNull.Value && !string.IsNullOrEmpty(val.ToString())
            ? Convert.ToDecimal(val) : def;

    // Models
    public class ProjectManagerRow
    {
        public string PM { get; set; } = "";
        public string OriginalPM { get; set; } = "";
        public string Password { get; set; } = "";
        public string PasswordDisplay { get; set; } = "";
        public string PMName { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Cell { get; set; } = "";
        public string Fax { get; set; } = "";
        public string Email { get; set; } = "";
        public decimal POLimit { get; set; }
        public string PrimaryUserID { get; set; } = "";
        public string SecondaryUserID { get; set; } = "";
        public bool PrjMgr { get; set; }
        public bool Estimator { get; set; }
        public bool Purchaser { get; set; }
        public bool Active { get; set; } = true;
        public string RowState { get; set; } = "CLEAN";
    }

    public class PurchaserItem
    {
        public string ID { get; set; } = "";
        public string Name { get; set; } = "";
    }
}
```