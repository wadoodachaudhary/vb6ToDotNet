            {
                Description      = PoHeaderDescription,
                StandardText     = PoStandardText,
                ShipVia          = PoShipVia,
                FOB              = PoFob,
                Terms            = PoTerms,
                OrderedBy        = PoOrderedBy,
                HidePrice        = PoHideePrice ? 1 : 0,
