    // ── View Definitions (VB6 FEstimateItems.frm:9362-9801) ───────────────────
    // Mirrors VB6 LoadViews()'s 6-way switch (FEstimateItems.frm:9362):
    //   (mMode, ProjectBased, ProjectPhaseBased) → one of:
    //     • LoadViews_JobBudget               (single-job quote/budget)
    //     • LoadViews_JobPO                   (single-job PO/contract/billing/bids)
    //     • LoadViews_CommunityProjectBudget  (community-wide quote/budget)
    //     • LoadViews_PhaseProjectBudget      (community + phase quote/budget)
    //     • LoadViews_CommunityProjectPO      (community-wide PO)
    //     • LoadViews_PhaseProjectPO          (community + phase PO)
    private void LoadViews()
    {
        var isBudgetMode = ModeValue == FCEMode.fceQuote || ModeValue == FCEMode.fceBudget;
        mViews = (isBudgetMode, ProjectBased, ProjectPhaseBased) switch
        {
            (true, true, true)   => BuildViews_PhaseProjectBudget(),
            (true, true, false)  => BuildViews_CommunityProjectBudget(),
            (true, false, _)     => BuildViews_JobBudget(),
            (false, true, true)  => BuildViews_PhaseProjectPO(),
            (false, true, false) => BuildViews_CommunityProjectPO(),
            (false, false, _)    => BuildViews_JobPO()
        };

        // Default view = first entry, mirroring VB6 (FEstimateItems.frm:9384
        // `mViewIndex = 0` after LoadViews_*). For Issue Budgets / Quote that's
        // the Customer view; for PO it's also Customer first. User can switch.
        mViewIndex = 0;
    }

