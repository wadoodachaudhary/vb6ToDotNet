        //   .Cell(flexcpData, r, 0)  → DisplayFld field expression
        //   .Cell(flexcpText, r, 1)  → KeyValue (the literal)
        //   .Cell(flexcpData, r, 1)  → KeyField name
        //   .RowData(r)              → accumulated WhereClause (always begins " AND ")
