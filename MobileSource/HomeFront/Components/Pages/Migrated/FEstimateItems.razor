@page "/estimate-items"
@page "/estimate-items/{Mode}"
@page "/estimate-items/{Mode}/{Job}"

@rendermode InteractiveServer

@using HomeFront.Models
@using HomeFront.Components.Pages
@using System.Data
@using System.Globalization
@using System.Reflection
@using System.Text
@using Microsoft.Data.SqlClient
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FEstimateItems> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject IGridLayoutService GridLayoutSvc
@inject ISessionStateService Session
@using HomeFront.Data
@inject DbWrapperSqlServer db

<PageTitle>@FormCaption - HomeFront</PageTitle>

@if (!string.IsNullOrEmpty(_lastError))
{
    <div style="background:#fff3cd;border:1px solid #ffc107;border-radius:4px;padding:8px 12px;margin-bottom:4px;font-size:12px;color:#856404;">
        <strong>Error:</strong> @_lastError
        <button style="float:right;border:none;background:none;cursor:pointer;font-weight:bold;" @onclick="() => _lastError = string.Empty">X</button>
    </div>
}

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">Loading...</div>
    </div>
}

@* Page-root flex column: toolbar + job-panel sit at natural height and the
   split-container fills whatever vertical space is left from the form host. *@
<div class="festimateitems-root">

@* ── TOOLBAR (VB6 order: Open, Save, Delete, View, separator, SaveAs, OneTime, Item, Assembly, Custom, Localities, WorkCosts) ─── *@
<div class="toolbar-cntr">
    @* Open — split button: clicking the icon opens the Job picker (default),
       clicking the ▾ chevron drops a menu offering Open Job / Open Project
       (VB6 FEstimateItems.frm:5751-5762: Toolbar.ButtonMenuClick "OpenJob" /
       "OpenProject"). Open Project is hidden in Quote mode (per-job only). *@
    <div class="tbar-split" @onclick:stopPropagation="true">
        <button class="tbar-btn" @onclick="OnOpenClick" title="Open a single Job">
            <img src="images/32/open.ico" alt="Open" onerror="this.style.display='none'" />
            <span class="tool-label">Open</span>
        </button>
        @if (ModeValue != FCEMode.fceQuote)
        {
            <button class="tbar-split-arrow"
                    type="button"
                    title="Open menu"
                    @onclick="ToggleOpenMenu">▾</button>
            @if (_openMenuOpen)
            {
                <div class="tbar-split-menu">
                    <div class="tbar-split-menu-item" @onclick="OnOpenJobMenuClick">
                        <img src="images/32/open.ico" alt="" onerror="this.style.display='none'" />
                        Open Job…
                    </div>
                    <div class="tbar-split-menu-item" @onclick="OnOpenProjectMenuClick">
                        <img src="images/32/Localities.ico" alt="" onerror="this.style.display='none'" />
                        Open Project / Community…
                    </div>
                </div>
            }
        }
    </div>
    <button class="tbar-btn" @onclick="OnSaveClick">
        <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
        <span class="tool-label">Save</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingJob)" @onclick="OnDeleteClick">
        <img src="images/32/delete.ico" alt="Delete" onerror="this.style.display='none'" />
        <span class="tool-label">Delete</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingJob)" @onclick="OnViewToggleClick">
        <img src="images/32/Preview.ico" alt="View" onerror="this.style.display='none'" />
        <span class="tool-label">View</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" disabled="@(!IsExistingJob)" @onclick="OnSaveAsClick">
        <img src="images/32/saveas.ico" alt="Save As" onerror="this.style.display='none'" />
        <span class="tool-label">Save As</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" disabled="@(!IsExistingJob)" @onclick="OnTakeoffOneTimeClick">
        <img src="images/32/TakeoffOneTime.ico" alt="One Time" onerror="this.style.display='none'" />
        <span class="tool-label">OneTime</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingJob)" @onclick="OnTakeoffItemClick">
        <img src="images/32/TakeoffItem.ico" alt="Item" onerror="this.style.display='none'" />
        <span class="tool-label">Item</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingJob)" @onclick="OnTakeoffAssemblyClick">
        <img src="images/32/TakeoffAssembly.ico" alt="Assembly" onerror="this.style.display='none'" />
        <span class="tool-label">Assembly</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingJob)" @onclick="OnTakeoffCustomClick">
        <img src="images/32/TakeoffCustom.ico" alt="Custom" onerror="this.style.display='none'" />
        <span class="tool-label">Custom</span>
    </button>
    <div class="tbar-separator"></div>
    @* VB6 toolbar labels: "Loc/wbs" and "Rfrsh Costs" (FEstimateItems.frm
       Toolbar.Buttons declarations). *@
    <button class="tbar-btn" disabled="@(!IsExistingJob)" @onclick="OnLocalitiesClick" title="Localities / WBS">
        <img src="images/32/Localities.ico" alt="Loc/wbs" onerror="this.style.display='none'" />
        <span class="tool-label">Loc/wbs</span>
    </button>
    <button class="tbar-btn" disabled="@(!IsExistingJob)" @onclick="OnRePriceClick" title="Refresh / re-price work costs">
        <img src="images/32/RePrice.ico" alt="Rfrsh Costs" onerror="this.style.display='none'" />
        <span class="tool-label">Rfrsh Costs</span>
    </button>
    @if (ModeValue == FCEMode.fceBudget)
    {
        <button class="tbar-btn" disabled="@(!IsExistingJob)" @onclick="OnGenerateClick">
            <img src="images/32/Generate.ico" alt="Generate" onerror="this.style.display='none'" />
            <span class="tool-label">Generate</span>
        </button>
    }
    <div class="tbar-separator"></div>
    @if (ModeValue != FCEMode.fcePO)
    {
        <button class="tbar-btn" disabled="@(!IsExistingJob)" @onclick="OnViewPOsClick">
            <span class="tool-label">PO's</span>
        </button>
    }
    @if (ModeValue == FCEMode.fcePO)
    {
        <button class="tbar-btn" disabled="@(!IsExistingJob)" @onclick="OnViewBudgetsClick">
            <span class="tool-label">Budgets</span>
        </button>
    }
    <div class="tbar-separator"></div>
    @* View popup — mirrors VB6 mnuEstimateItemViews (FEstimateItems.frm:5015,
       4884). Button shows the active view name; click drops a menu with each
       column-grouping view, a ✓ on the active one, then a separator and the
       Addons / Contract pseudo-views. *@
    <div class="tbar-view-popup" @onclick:stopPropagation="true">
        <div class="tbar-view-label">View</div>
        <button class="tbar-view-btn" type="button"
                disabled="@(!HasSubject)"
                @onclick="ToggleViewMenu">
            <span class="tbar-view-btn-text">@(CurrentView.Name)</span>
            <span class="tbar-view-btn-arrow">▾</span>
        </button>
        @if (_viewMenuOpen)
        {
            <div class="tbar-view-menu">
                @for (var i = 0; i < mViews.Count; i++)
                {
                    var idx = i;
                    <div class="tbar-view-menu-item @(idx == mViewIndex ? "active" : "")"
                         @onclick="() => SelectView(idx)">
                        <span class="tbar-view-menu-check">@(idx == mViewIndex ? "✓" : "")</span>
                        <span class="tbar-view-menu-name">@mViews[idx].Name</span>
                    </div>
                }
                @* Pseudo-views — VB6 line 4889 (Addons) / 4894 (Contract).
                   Backing subforms are not yet migrated; stub for now. *@
                <div class="tbar-view-menu-sep"></div>
                <div class="tbar-view-menu-item"
                     @onclick="@(() => SelectPseudoView("Addons"))">
                    <span class="tbar-view-menu-check"></span>
                    <span class="tbar-view-menu-name">Addons</span>
                </div>
                <div class="tbar-view-menu-item"
                     @onclick="@(() => SelectPseudoView("Contract"))">
                    <span class="tbar-view-menu-check"></span>
                    <span class="tbar-view-menu-name">Contract</span>
                </div>
            </div>
        }
    </div>
    <div class="tbar-separator"></div>
    <CheckBoxControl @bind-Checked="HideCancelledItems" @bind-Checked:after="OnHideCancelledChanged"
                     Label="Hide Cancelled" CssClass="chk-label" />
    @* Visible indicator: when EITHER the items grid OR the assembly tree is
       using the page's hard-coded fallback columns (no matching AppGridLayout
       row), surface that here so testers can spot it instantly. The tooltip
       and console log both spell out which key is missing — search the F12
       console for `[FEstimateItems]` for the full report. *@
    @if (AnyFallbackLayoutInUse)
    {
        <div class="tbar-separator"></div>
        <span class="tbar-fallback-badge"
              title="@($"One or more grids fell back to hard-coded columns because no AppGridLayout row was found.\n\n{LayoutSourceSummary}\n\nSee the F12 console for the full lookup details.")">
            ⚠ Fallback columns
            @if (_gItemsLayoutSource == GridLayoutSource.Fallback) { <span class="tbar-fallback-tag">Items</span> }
            @if (_gAssembliesLayoutSource == GridLayoutSource.Fallback) { <span class="tbar-fallback-tag">Tree</span> }
        </span>
    }
</div>

@* ── JOB HEADER (VB6 layout: Description + checkboxes row, Community/Phase/Model/TaxExport row) ── *@
<div class="job-panel">
    <div class="job-panel-grid">
        <div class="job-field">
            <label>Description</label>
            <TextBoxControl @bind-Value="JobDescription" @bind-Value:after="OnFieldChanged"
                            Enabled="@FieldsEnabled" CssClass="job-text" />
        </div>
        <div class="job-checks">
            <CheckBoxControl @bind-Checked="ChkScheduling" @bind-Checked:after="OnFieldChanged" Disabled="@(!FieldsEnabled)" Label="Scheduling" CssClass="chk-label" />
            <CheckBoxControl @bind-Checked="ChkFixGroups" @bind-Checked:after="OnFieldChanged" Disabled="@(!FieldsEnabled)" Label="Fix Groups" CssClass="chk-label" />
            <CheckBoxControl @bind-Checked="ChkColdInfo" @bind-Checked:after="OnFieldChanged" Disabled="@(!FieldsEnabled)" Label="Cold Info" CssClass="chk-label" />
            <CheckBoxControl @bind-Checked="ChkCash" @bind-Checked:after="OnFieldChanged" Disabled="@(!FieldsEnabled)" Label="Cash" CssClass="chk-label" />
        </div>
        <div class="job-field">
            <label>Community</label>
            <DropDownListControl TValue="string" TItem="ComboItem"
                                 Value="@JobCommunity"
                                 ValueChanged="@(async v => { JobCommunity = v ?? ""; await OnCommunityChanged(); })"
                                 DataSource="@CommunityItems"
                                 TextFieldName="Text" ValueFieldName="Value"
                                 Enabled="@FieldsEnabled" Width="100%" />
        </div>
        <div class="job-field">
            <label>Model</label>
            <DropDownListControl TValue="string" TItem="ComboItem"
                                 Value="@JobModel"
                                 ValueChanged="@(v => { JobModel = v ?? ""; OnFieldChanged(); })"
                                 DataSource="@ModelItems"
                                 TextFieldName="Text" ValueFieldName="Value"
                                 Enabled="@FieldsEnabled" Width="100%" />
        </div>
        <div class="job-field">
            <label>Tax Export</label>
            <DropDownListControl TValue="string" TItem="ComboItem"
                                 Value="@TaxExport"
                                 ValueChanged="@(v => { TaxExport = v ?? ""; OnFieldChanged(); })"
                                 DataSource="@(new List<ComboItem>())"
                                 TextFieldName="Text" ValueFieldName="Value"
                                 Enabled="@FieldsEnabled" Width="100%" />
        </div>
    </div>
</div>

@* ── MAIN CONTENT: Assembly Tree + Items Grid ─────────── *@
@namespace HomeFront.Components.Pages
<div class="split-container" style="grid-template-columns:@($"{TreePanelWidthPx}px") 6px 1fr;">
    @* LEFT: Assembly Tree *@
    <div class="tree-panel">
        <TreeGridControl @ref="gAssemblies"
                     TValue="AssemblyNode"
                     DataSource="@AssemblyTreeData"
                     IdMapping="NodeID"
                     ParentIdMapping="ParentID"
                     TreeColumnIndex="0"
                     AllowSelection="true"
                     EnableCollapseAll="true"
                     Height="100%"
                     CssClass="fx-treegrid-compact"
                     RowSelected="OnAssemblySelected">
            @if (HasAssemblyGridLayout)
            {
                var _firstColEmitted = false;
                foreach (var entry in GetOrderedAssemblyGridLayout())
                {
                    var layout = entry.Layout;
                    var fieldName = entry.Field;
                    @* Tree's FIRST visible column always carries the active view's
                       name as header (Customer / PO Index / Cost Code / etc.) —
                       overrides whatever caption the saved AppGridLayout has.
                       Mirrors VB6 FEstimateItems.frm:9119 where every view-switch
                       sets `TextMatrix(0,0) = mViews(mViewIndex).Name`. *@
                    string headerText;
                    if (!_firstColEmitted)
                    {
                        headerText = TreeNodeColumnHeader;
                        _firstColEmitted = true;
                    }
                    else
                    {
                        headerText = FriendlyAssemblyHeader(layout.Caption, fieldName);
                    }
                    var width = layout.Width.HasValue && layout.Width.Value > 0
                        ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;
                    var format = GetAssemblyColumnFormat(fieldName);
                    var textAlign = IsAssemblyNumericField(fieldName) ? TextAlign.Right : TextAlign.Left;

                    <TreeGridColumn Field="@fieldName"
                                      HeaderText="@headerText"
                                      Width="@width"
                                      Format="@format"
                                      TextAlign="@textAlign" />
                }
                <TreeGridColumn Field="EstAssemblyID" Visible="false" />
            }
            else
            {
                @* Fallback: hardcoded columns. The Node column's header reflects
                   the active view name (Customer, PO Index, Cost Code, …) — VB6
                   does the same at FEstimateItems.frm:9119 (`.TextMatrix(0,0) =
                   mViews(mViewIndex).Name`). *@
                <TreeGridColumn Field="Node" HeaderText="@TreeNodeColumnHeader" Width="200px" />
                <TreeGridColumn Field="Budgeted" HeaderText="Budgeted" Width="80px" Format="C2" TextAlign="TextAlign.Right" />
                <TreeGridColumn Field="Changes" HeaderText="Changes" Width="80px" Format="C2" TextAlign="TextAlign.Right" />
                <TreeGridColumn Field="Committed" HeaderText="Committed" Width="80px" Format="C2" TextAlign="TextAlign.Right" />
                <TreeGridColumn Field="EstAssemblyID" Visible="false" />
            }
        </TreeGridControl>
    </div>

    @* Resizable splitter handle — drag to adjust tree/grid widths.
       Pointer-driven. While dragging, a transparent fullscreen overlay is
       rendered on top of everything to capture pointermove/up events even when
       the cursor moves outside the small handle (no JS interop needed). *@
    <div class="split-handle"
         title="Drag to resize"
         @onpointerdown="OnSplitPointerDown"
         @onpointerdown:preventDefault="true">
        <div class="split-handle-grip"></div>
    </div>

    @* RIGHT: Selection-Detail Panel + Items Grid *@
    <div class="grid-panel">
        @* The detail panel mirrors VB6 LoadItems (FEstimateItems.frm:6890) which
           shows different sub-frames depending on what KIND of node is selected
           in the tree:
             • EstAssemblyID → frmAssembly (rich Asmbly/Extra editor)
             • POIndex / BudgetVendor / POVendor / PONumber → frmPOIndex (PO header)
             • Cost Code view → no detail panel
             • CORSort / ChangeOrder → frmChangeOrder (CO detail)
           The dispatcher below picks the right sub-panel from
           SelectionDetailKind. *@
        @switch (DetailKindForSelection)
        {
            case SelectionDetailKind.Assembly:
                @RenderAssemblyDetailPanel()
                break;
            case SelectionDetailKind.PoHeader:
                @RenderPoHeaderPanel()
                break;
            case SelectionDetailKind.ChangeOrder:
                @RenderChangeOrderPanel()
                break;
            case SelectionDetailKind.None:
            default:
                // No detail panel — items grid takes the full right-pane height.
                break;
        }

        @* Items Grid *@
        @* AllowGrouping exposes the drag-to-group bar at the top — the user can
           drop any column header onto it to group rows (mirrors the visual
           grouping in the VB6 screenshot where rows are headed by codes like
           "BFW Building", "BFI Cement Boards"). The default GroupColumns set
           pre-populates a sensible grouping for each view (e.g. by POIndex when
           the tree is in PO Index view). *@
        @* FxControlKit is brand-neutral; consumers wire their app's accent
           color explicitly. #2563eb is the HomeFront grouped-value blue
           (the POIndex / vendor values that VB6 also painted blue). *@
        <GridControl @ref="gItems"
                TValue="EstimateItemRow"
                DataSource="@ItemsView"
                AllowSelection="true"
                AllowSorting="true"
                AllowFiltering="true"
                AllowResizing="true"
                AllowGrouping="true"
                GroupColumns="@DefaultItemGroupColumns"
                ShowGroupExpandCollapse="true"
                HideGroupedColumns="true"
                DefaultGroupsCollapsed="true"
                GroupedColumnColor="#2563eb"
                EnableHover="true"
                Height="100%"
                RowHeight="22"
                FilterSettingsRef="@filterSettings"
                PageSettingsRef="@pageSettings"
                SelectionSettingsRef="@selectionSettings"
                EditSettingsRef="@editSettings"
                EventsRef="@gridEvents">
            <GridColumnsBase @key="gItemsLayoutVersion">
                <GridColumn Field="EstItemID" HeaderText="ID" Width="1px" Visible="false" IsPrimaryKey="true" AllowEditing="false" />
                <GridColumn Field="RowState" HeaderText="" Width="1px" Visible="false" AllowEditing="false" />
                @if (HasGridLayout)
                {
                    foreach (var entry in GetOrderedGridLayout())
                    {
                        var layout = entry.Layout;
                        var fieldName = entry.Field;
                        var columnType = entry.ColumnType;
                        var textAlign = entry.TextAlign;
                        var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                        var width = layout.Width.HasValue && layout.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                            : null;
                        var format = GetFormatForField(fieldName, columnType);
                        var allowEdit = IsFieldEditable(fieldName);

                        // Hide budget columns in PO mode, hide PO columns in Quote mode
                        var visible = IsColumnVisibleForMode(fieldName);

                        <GridColumn Field="@fieldName"
                                      HeaderText="@headerText"
                                      Width="@width"
                                      Type="@columnType"
                                      TextAlign="@textAlign"
                                      Format="@format"
                                      AllowEditing="@allowEdit"
                                      ClipMode="ClipMode.Ellipsis"
                                      Visible="@visible" />
                    }
                }
                else
                {
                    @* Fallback when no AppGridLayout exists for this (mode,view).
                       The visible-column set varies per active view — Customer
                       view leads with Vendor + Description, Cost Code view leads
                       with JCExtra + Cost Code, Vendor view leads with Vendor,
                       Purchase Orders view leads with PONumber, etc. Mirrors
                       VB6 IniGetGrid behaviour where each view has its own
                       persisted column layout. *@
                    @foreach (var col in GetFallbackItemColumns())
                    {
                        <GridColumn Field="@col.Field"
                                      HeaderText="@col.Header"
                                      Width="@col.Width"
                                      Type="@col.Type"
                                      Format="@col.Format"
                                      TextAlign="@col.TextAlign"
                                      AllowEditing="@col.AllowEditing" />
                    }
                }
            </GridColumnsBase>
        </GridControl>
    </div>
</div>

@* Splitter drag overlay — only rendered while the user is actively dragging the
   handle. Covers the whole viewport so pointer moves anywhere on the page
   continue updating TreePanelWidthPx, even if the cursor leaves the handle. *@
@if (_splitDragging)
{
    <div class="split-drag-overlay"
         @onpointermove="OnSplitPointerMove"
         @onpointerup="OnSplitPointerUp"
         @onpointercancel="OnSplitPointerUp"></div>
}

@* Click-outside catcher — closes the View popup menu when the user clicks
   anywhere except on the menu itself (the menu's container has @onclick:stopPropagation). *@
@if (_viewMenuOpen)
{
    <div class="tbar-view-menu-backdrop" @onclick="CloseViewMenu"></div>
}
@* Same pattern for the Open split-button menu. *@
@if (_openMenuOpen)
{
    <div class="tbar-view-menu-backdrop" @onclick="CloseOpenMenu"></div>
}

</div> @* /festimateitems-root *@

@* ── CONFIRM SAVE DIALOG ────────────────────────────── *@
<DialogControl Visible="ShowSavePrompt" Header="@($"{FormCaption} has changed.")" Width="400px" ShowCloseIcon="false">
    <ChildContent>
        <p>Do you want to save these changes?</p>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="btn btn-primary" OnClick="OnSavePromptYes">Yes</ButtonControl>
        <ButtonControl CssClass="btn btn-secondary" OnClick="OnSavePromptNo">No</ButtonControl>
        <ButtonControl CssClass="btn btn-outline-secondary" OnClick="OnSavePromptCancel">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@* ── Pick List Modal ────────────────────────────────── *@
<FPickList @ref="pickList" OnSelected="OnPickListSelected" />

@* ── Comments / multi-line editor for PO header textareas.
   VB6 cmdBrowse(3/4/5) → FComments.Edit(text, ..., title, maxLength). We
   route the OK back to the right PO field via _poCommentsTarget. *@
<FComments @bind-Visible="_poCommentsVisible"
           @bind-Value="_poCommentsBuffer"
           Title="@_poCommentsTitle"
           MaxLength="_poCommentsMaxLength"
           OnSave="OnPoCommentsSaved" />

@* ── Attachments dialog for the active EstAssemblyID.
   VB6 frmAssembly opens FAttachments via `mTimerTask = "ShowAttachments"`. *@
<FAttachments @ref="attachmentsDialog" />

@* ── Addons modal — frmJobAddons substitute (Addons pseudo-view in the
   View popup). Hosted inline because FAddons is a component, not a page. *@
@if (_addonsModalVisible)
{
    <div class="fest-modal-backdrop" @onclick="CloseAddonsModal">
        <div class="fest-modal" @onclick:stopPropagation="true">
            <div class="fest-modal-header">
                <span>Job Addons — @mJob</span>
                <button class="fest-modal-close" @onclick="CloseAddonsModal" title="Close">×</button>
            </div>
            <div class="fest-modal-body">
                <FAddons Job="@mJob" AssemblyId="@SelectedAssemblyId" DivisionId="@Session.DivisionID" />
            </div>
        </div>
    </div>
}

@* ── Contract / Billing modal — frmBilling substitute (Contract pseudo-view).
   Hosts FBilling in the same modal frame as Addons. *@
@if (_billingModalVisible)
{
    <div class="fest-modal-backdrop" @onclick="CloseBillingModal">
        <div class="fest-modal" @onclick:stopPropagation="true">
            <div class="fest-modal-header">
                <span>Contract &amp; Billing — @mJob</span>
                <button class="fest-modal-close" @onclick="CloseBillingModal" title="Close">×</button>
            </div>
            <div class="fest-modal-body">
                <FBilling Job="@mJob" DivisionId="@Session.DivisionID" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Mode { get; set; }
    [Parameter] public string? Job { get; set; }

    // ── Database ──────────────────────────────────────────────
// ── Constants ─────────────────────────────────────────────
    private const string SrcFile = "FEstimateItems::";

    // ── State ─────────────────────────────────────────────────
    private bool IsLoading = false;
    private bool mDirty = false;
    private bool HideCancelledItems = false;
    private FCEMode ModeValue = FCEMode.fceBudget;

    // ── Error display ────────────────────────────────────────
    private string _lastError = "";

    // ── Job Fields ────────────────────────────────────────────
    private string mJob = "";
    private string JobNumber = "";
    private string JobDescription = "";
    private string JobAddress = "";
    private string JobCommunity = "";
    private string JobPhase = "";
    private string JobModel = "";
    private string JobNotes = "";
    private string TaxExport = "";

    // ── VB6 Checkboxes ────────────────────────────────────────
    private bool ChkScheduling = false;
    private bool ChkFixGroups = false;
    private bool ChkColdInfo = false;
    private bool ChkCash = false;

    // ── UI Flags ──────────────────────────────────────────────
    private bool FieldsEnabled = false;
    private bool IsExistingJob => !string.IsNullOrWhiteSpace(mJob);
    // Subject of the loaded form: a Project (community-wide) takes precedence over
    // a single Job in the title bar.
    private string FormSubject => ProjectBased
        ? (string.IsNullOrEmpty(mCommunityDesc) ? mCommunity : $"{mCommunityDesc} (Project)")
        : mJob;
    private bool HasSubject => ProjectBased
        ? !string.IsNullOrWhiteSpace(mCommunity)
        : IsExistingJob;
    private string FormCaption => ModeValue switch
    {
        FCEMode.fceQuote => HasSubject ? $"Prepare Quote - {FormSubject}" : "Prepare Quote",
        FCEMode.fcePO => HasSubject ? $"Issue PO's - {FormSubject}" : "Issue PO's",
        FCEMode.fceBids => HasSubject ? $"Bids & Tenders - {FormSubject}" : "Bids & Tenders",
        FCEMode.fceContract => HasSubject ? $"Contracts - {FormSubject}" : "Contracts",
        FCEMode.fceBilling => HasSubject ? $"Billing - {FormSubject}" : "Billing",
        _ => HasSubject ? $"Issue Budgets - {FormSubject}" : "Issue Budgets"
    };

    // VB6 (FEstimateItems.frm:6760-6766) shows ONE pricing set per mode:
