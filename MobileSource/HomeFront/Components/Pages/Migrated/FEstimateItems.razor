    private void OnCoDateApprovedChanged(DateTime? v)
    {
        if (CoLocked) return;
        CoDateApproved = v?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "";
        OnFieldChanged();
    }

