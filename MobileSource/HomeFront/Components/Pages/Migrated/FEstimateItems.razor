    // VB6 frmChangeOrder save: UPDATE changeordermaster keyed by
    // (customer_no, change_order_no). Skipped when the CO is read-only
    // (PurchasingCO != True).
    private async Task SaveChangeOrderDetail()
    {
        if (CoLocked) return;
        if (string.IsNullOrWhiteSpace(mCustomerNo) || string.IsNullOrWhiteSpace(mChangeOrder)) return;
        try
        {
            const string sql = @"
                UPDATE changeordermaster
                   SET change_date         = @ChangeDate,
                       bldr_approved_date  = @ApprovedDate,
                       bldr_approved_by    = @ApprovedBy,
                       Comments            = @Comments
                 WHERE customer_no       = @CustomerNo
                   AND change_order_no    = @ChangeOrder";
            DateTime.TryParse(CoDate, out var changeDate);
            DateTime.TryParse(CoDateApproved, out var approvedDate);
            await db.ExecuteAsync(sql, new
            {
                ChangeDate   = changeDate == default ? (DateTime?)null : changeDate,
                ApprovedDate = approvedDate == default ? (DateTime?)null : approvedDate,
                ApprovedBy   = CoApprovedBy,
                Comments     = CoComments,
                CustomerNo   = mCustomerNo,
                ChangeOrder  = mChangeOrder
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SaveChangeOrderDetail error");
            Notifications.Warning($"Couldn't save Change Order: {ex.Message}");
        }
    }

    // ── Save Prompt ───────────────────────────────────────────
    private async Task<int> PromptSave()
    {
        _savePromptTcs = new TaskCompletionSource<int>();
        ShowSavePrompt = true;
        StateHasChanged();
        var result = await _savePromptTcs.Task;
        ShowSavePrompt = false;
        StateHasChanged();
        return result;
    }
    private void OnSavePromptYes() => _savePromptTcs?.SetResult(1);
    private void OnSavePromptNo() => _savePromptTcs?.SetResult(2);
    private void OnSavePromptCancel() => _savePromptTcs?.SetResult(0);

    // ── Toolbar Handlers ──────────────────────────────────────
    private async Task OnOpenClick()
    {
        if (!await SaveData(true)) return;

        _pickListContext = "OpenJob";
        if (pickList != null)
        {
            // Mirror VB6 (FEstimateItems.frm:11253–11295): the Open dialog lists jobs in
            // the user's DivisionID. Quote mode uses a different filter (isquote=1).
            // Inactive jobs are excluded for the main picker; VB6 actually has TWO panels
            // ("Open Jobs" / "Closed Jobs") but a single SELECT covers the common case.
            string sql;
            if (ModeValue == FCEMode.fceQuote)
            {
                sql = $@"SELECT j.Job_No Quote, j.Description,
                                c.Description Community, j.CommunityPhase Phase,
                                j.Municipal_Address Address,
                                j.PM, j.Purchaser, j.Estimator
                         FROM tblJobs j
                         LEFT OUTER JOIN tblLocality c ON (j.community = c.area)
                         WHERE j.DivisionID = {Session.DivisionID}
                           AND ISNULL(j.Inactive,0) = 0
                           AND j.isQuote = 1
                         ORDER BY j.Job_No";
            }
            else
            {
                sql = $@"SELECT j.Job_No, j.Description,
                                c.Description Community, j.CommunityPhase Phase,
                                j.Municipal_Address Address
                         FROM tblJobs j
                         LEFT OUTER JOIN tblLocality c ON (j.community = c.area)
                         WHERE j.DivisionID = {Session.DivisionID}
                           AND ISNULL(j.Inactive,0) = 0
                           AND ISNULL(j.isQuote,0) = 0
                         ORDER BY j.Job_No";
            }

            await pickList.Open(
                title: ModeValue == FCEMode.fceQuote ? "Quote" : "Job",
                queries: sql,
                defaultItem: IsExistingJob ? mJob : null,
                showNew: ModeValue == FCEMode.fceQuote);
        }
    }

    // VB6 (FEstimateItems.frm:5758-5762, "OpenProject" toolbar action) — switch
    // the form into ProjectBased mode. The picker lists every Community/Project
    // that has at least one Job in the user's Division. After a Community is
    // chosen, ProjectPhaseBased is auto-detected from CommunityPhase rows.
    private async Task OnOpenProjectClick()
    {
        if (!await SaveData(true)) return;
        // ProjectBased mode is invalid for fceQuote (quotes are per-job).
        if (ModeValue == FCEMode.fceQuote)
        {
            Notifications.Info("Project view is not available in Quote mode.");
            return;
        }

        _pickListContext = "OpenProject";
        if (pickList != null)
        {
            // VB6 SQL (FEstimateItems.frm:11239-11244): distinct communities
            // joined to jobs in this division.
            var sql = $@"SELECT DISTINCT c.Area Project, c.Description
                          FROM tblLocality c
                          JOIN tblJobs j ON c.Area = j.Community
                         WHERE j.DivisionID = {Session.DivisionID}
                         ORDER BY c.Area";

            await pickList.Open(
                title: "Project",
                queries: sql,
                defaultItem: ProjectBased ? mCommunity : null,
                showNew: false);
        }
    }

    private async Task OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        if (_pickListContext == "OpenJob")
        {
            if (selectedRows.Count == 0)
            {
                // "New" selected
                mJob = "";
                SetFieldsForNew();
                mDirty = false;
                StateHasChanged();
                return;
            }

            var firstRow = selectedRows[0];
            var keyCol = ModeValue == FCEMode.fceQuote ? "Quote" : "Job_No";
            var jobNo = firstRow.ContainsKey(keyCol) ? firstRow[keyCol]?.ToString()?.Trim() ?? "" : "";

            if (string.IsNullOrWhiteSpace(jobNo))
            {
                mJob = "";
                SetFieldsForNew();
                mDirty = false;
            }
            else
            {
                // Switching back to a single job exits ProjectBased mode.
                if (ProjectBased)
                {
                    ProjectBased = false;
                    ProjectPhaseBased = false;
                    mCommunity = "";
                    mCommunityDesc = "";
                    LoadViews();
                    await LoadGridLayoutAsync();
                }
                mJob = jobNo;
                JobNumber = jobNo;
                await LoadJob();
            }
            StateHasChanged();
        }
        else if (_pickListContext == "OpenProject")
        {
            if (selectedRows.Count == 0)
            {
                _pickListContext = "";
                return;
            }
            var row = selectedRows[0];
            // tblLocality columns surfaced by the picker SQL above: Project / Description.
            var community = row.ContainsKey("Project") ? row["Project"]?.ToString()?.Trim() ?? "" : "";
            var desc = row.ContainsKey("Description") ? row["Description"]?.ToString()?.Trim() ?? "" : "";
            if (!string.IsNullOrWhiteSpace(community))
            {
                await LoadProject(community, desc);
            }
        }
        else if (_pickListContext == "PoVendor")
        {
            if (selectedRows.Count == 0)
            {
                _pickListContext = "";
                return;
            }
            var row = selectedRows[0];
            var vendorName = row.ContainsKey("Vendor Name") ? row["Vendor Name"]?.ToString()?.Trim() ?? ""
                           : row.ContainsKey("vendor_name") ? row["vendor_name"]?.ToString()?.Trim() ?? "" : "";
            if (!string.IsNullOrWhiteSpace(vendorName))
            {
                PoHeaderVendorName = vendorName;
                mDirty = true;
                StateHasChanged();
            }
        }
        _pickListContext = "";
    }

    // ── Load a Project (community-wide) ───────────────────────────────────
    // Mirrors VB6 OnOpenProject (FEstimateItems.frm:5758-5762 + 11237-11250):
    //   • flips ProjectBased = true
    //   • auto-detects ProjectPhaseBased by counting CommunityPhase rows
    //   • rebuilds mViews via LoadViews() (now picks the community/phase variant)
    //   • clears single-Job state and loads the assemblies tree filtered by Community
    private async Task LoadProject(string community, string description)
    {
        try
        {
            ProjectBased = true;
            mCommunity = community;
            mCommunityDesc = description;
            mJob = "";
            JobNumber = "";

            // Auto-detect phase mode from the CommunityPhase table
            // (VB6 line 11248).
            try
            {
                var phaseDt = db.SqlExec(
                    "SELECT COUNT(*) FROM CommunityPhase WHERE Community = @Community",
                    new { Community = community });
                ProjectPhaseBased = phaseDt.Rows.Count > 0 &&
                                    Convert.ToInt32(phaseDt.Rows[0][0]) > 0;
            }
            catch
            {
                // CommunityPhase view/table missing on some DBs — fall back to community-only.
                ProjectPhaseBased = false;
            }

            LoadViews();                 // pick the right ViewDefinition set
            await LoadGridLayoutAsync(); // re-fetch AppGridLayout for new (mode, view)
            FieldsEnabled = false;

            await LoadAssemblies();
        }
        catch (Exception ex)
        {
            _lastError = $"LoadProject error: {ex.Message}";
            Console.WriteLine(_lastError);
        }
        finally
        {
            StateHasChanged();
        }
    }

