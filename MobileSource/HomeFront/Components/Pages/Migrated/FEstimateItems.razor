    // VB6 line 5099+: opens FAttachments to manage files attached to the
    // selected EstAssemblyID. FAttachments.ShowForm takes (caption, params (objectId, folder)[]).
    // Folder convention from VB6: "Assemblies/<EstAssemblyID>".
    private async Task OnAttachmentsClick()
    {
        if (SelectedAssemblyId <= 0)
        {
            Notifications.Info("Select an assembly to view attachments.");
            return;
        }
        if (attachmentsDialog == null) return;
        var objectId = SelectedAssemblyId.ToString(CultureInfo.InvariantCulture);
        var folder   = $"Assemblies/{objectId}";
        await attachmentsDialog.ShowForm(
            $"Attachments — {AssemblyOption} ({AssemblyDescription})",
            (objectId, folder));
    }

    // VB6 line 8290+: opens FPickList against tblVendors filtered by community.
    //   SELECT vendor_id, vendor_name FROM tblVendors WHERE active=1 ORDER BY vendor_name
    // We use the existing FPickList @ref already on the page.
    private async Task OnVendorPickClick()
    {
        if (pickList == null) return;
        _pickListContext = "PoVendor";
        var sql = @"SELECT vendor_id Vendor, vendor_name ""Vendor Name""
                      FROM tblVendors
                     WHERE ISNULL(active,1) = 1
                     ORDER BY vendor_name";
        await pickList.Open(
            title: "Vendor",
            queries: sql,
            defaultItem: PoHeaderVendorName,
            showNew: false);
    }

    // VB6 line 8434+: passes selected POIndex/PONumber to FReports running
    // the PO History report. We navigate to /report-viewer/PO_History with
    // the relevant parameters; FRptViewer picks them up via its route.
    private void OnPoHistoryReportClick()
    {
        if (string.IsNullOrEmpty(_poHeaderSourcePoNumber) && string.IsNullOrEmpty(PoHeaderPoIndexLabel))
        {
            Notifications.Info("Select a PO row to open the history report.");
            return;
        }
        var query = new List<string>();
        if (!string.IsNullOrEmpty(_poHeaderSourcePoNumber))
            query.Add($"PONumber={Uri.EscapeDataString(_poHeaderSourcePoNumber)}");
        if (!string.IsNullOrEmpty(PoHeaderPoIndexLabel))
            query.Add($"POIndex={Uri.EscapeDataString(PoHeaderPoIndexLabel)}");
        if (!string.IsNullOrEmpty(mJob))
            query.Add($"JobNo={Uri.EscapeDataString(mJob)}");
        var url = "/report-viewer/PO_History" + (query.Count > 0 ? "?" + string.Join("&", query) : "");
        NavigationManager.NavigateTo(url);
    }

    // VB6 frmPOIndex cmdBrowse(3-5) → FComments.Edit(value, ..., title, maxLen).
    // FComments is a modal multi-line editor with OK/Cancel. We route the
    // current PO field into the dialog, then OnPoCommentsSaved writes back.
    private enum PoCommentsTarget { Description, StandardText, Terms }
    private PoCommentsTarget _poCommentsTarget = PoCommentsTarget.Description;

    private void OnPoDescriptionBrowse()    => OpenPoComments(PoCommentsTarget.Description, PoHeaderDescription, "Description", 100);
    private void OnPoStandardTextBrowse()   => OpenPoComments(PoCommentsTarget.StandardText, PoStandardText,    "Standard Text", 2000);
    private void OnPoTermsBrowse()          => OpenPoComments(PoCommentsTarget.Terms,        PoTerms,            "Terms", 2000);

    private void OpenPoComments(PoCommentsTarget target, string current, string title, int maxLen)
    {
        _poCommentsTarget   = target;
        _poCommentsBuffer   = current ?? "";
        _poCommentsTitle    = title;
        _poCommentsMaxLength = maxLen;
        _poCommentsVisible  = true;
    }

    private void OnPoCommentsSaved()
    {
        var v = _poCommentsBuffer ?? "";
        switch (_poCommentsTarget)
        {
            case PoCommentsTarget.Description:  PoHeaderDescription = v; break;
            case PoCommentsTarget.StandardText: PoStandardText      = v; break;
            case PoCommentsTarget.Terms:        PoTerms             = v; break;
        }
        mDirty = true;
    }

    // VB6 frmChangeOrder cmdBrowse(0/1) date pickers → FlexKit DatePickerControl
    // (the inline calendar popup replaces the old hand-rolled DCalendar modal +
    // browse buttons). CoDate/CoDateApproved stay strings (loaded via
    // FormatDateMedium, saved via DateTime.TryParse), so parse on the way in and
    // format "MMM d, yyyy" on the way out.
    private static DateTime? ParseCoDate(string s)
        => DateTime.TryParse(s, out var d) ? d : (DateTime?)null;

    private void OnCoDateChanged(DateTime? v)
    {
        if (CoLocked) return;
        CoDate = v?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "";
        OnFieldChanged();
