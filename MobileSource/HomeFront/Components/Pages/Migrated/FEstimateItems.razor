    private string BuildTakeoffUrl(string takeoffMode)
    {
        var qs = new Dictionary<string, string?>
        {
            ["mode"] = takeoffMode,
            ["isChangeOrder"] = "false",
            ["job"] = mJob,
            ["community"] = string.IsNullOrWhiteSpace(JobCommunity) ? null : JobCommunity,
            ["phase"] = string.IsNullOrWhiteSpace(JobPhase) ? null : JobPhase
        };
        var queryString = string.Join("&",
            qs.Where(kv => kv.Value != null)
                .Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value!)}"));
        return $"/takeoff?{queryString}";
    }

