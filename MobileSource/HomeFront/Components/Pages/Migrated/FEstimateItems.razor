    // Mirrors VB6's `Private Type ViewDefs` (FEstimateItems.frm:2817-2820).
    // Each view is N parallel comma-separated lists describing a hierarchical
    // grouping path through the Estimateditems view.
    private class ViewDefinition
    {
        public string Name { get; set; } = "";
        public string KeyFlds { get; set; } = "";
        public string DisplayFlds { get; set; } = "";
        public string SortFlds { get; set; } = "";
        public List<string> Keys => Split(KeyFlds);
        public List<string> Displays => Split(DisplayFlds);
        public List<string> Sorts => Split(SortFlds);
        public int Levels => Displays.Count;
        private static List<string> Split(string s) =>
            string.IsNullOrWhiteSpace(s)
                ? new List<string>()
                : s.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).ToList();
    }

