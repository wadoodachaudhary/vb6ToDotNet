    // ── Grid layout via the shared GridLayoutPresenter ───────────────────────
    // The load/resolve/order/width boilerplate lives in GridLayoutPresenter<TRow>;
    // only the VB6 form/grid name strings stay here (fidelity). The members named
    // gItemsLayout / HasGridLayout / gItemsLayoutVersion (and the gAssemblies*
    // equivalents) below are thin delegations, so the markup is unchanged.
    //   • gItems is mode/view-keyed (runtime-dynamic instanceKey `<mode><view>`)
    //     and aliased (Description→ItemDesc, Vendor→BudgetVendor, …) — the alias
    //     map goes to the ctor; the exact→normalized→alias→literal resolver,
    //     bool→CheckBox / numeric→Number type map, ordered-columns and twips→px
    //     are all canonical, so they are delegated to the presenter.
    //   • gAssemblies' GetOrdered / ResolveAssemblyField / column-type / header /
    //     fallback-badge are CUSTOMIZED (KeyFld filter, dedup, SQL-caption sanitiser)
    //     and stay form-specific, operating on the presenter's Layout.
    // VB6 (FEstimateItems.frm) IniGetGrid maps the gItems column data type by the
    // EstimateItemRow CLR type (bool→CheckBox, numeric→Number) with no name-driven
    // overrides or string-as-number columns — i.e. exactly GridLayoutPresenter's
    // canonical ColumnTypeFor — so gItems' GetOrdered IS delegated.
    private readonly GridLayoutPresenter<EstimateItemRow> _gItems =
        new("FEstimateItems", "gItems", aliases: _gItemsAliases);
    private Dictionary<string, GridLayoutColumn> gItemsLayout => _gItems.Layout;
    private bool HasGridLayout => _gItems.Has;
    private int gItemsLayoutVersion => _gItems.Version;

    // VB6 → EstimateItemRow field aliases (normalized keys — the presenter
