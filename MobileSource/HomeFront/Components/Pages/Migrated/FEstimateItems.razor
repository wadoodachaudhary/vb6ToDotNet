    private void OnCellSaved(CellSaveArgs<EstimateItemRow> args)
    {
        if (args.Data == null) return;
        var item = args.Data;
        var colName = args.ColumnName ?? "";

        RecalculateAfterEdit(item, colName);

        if (colName != "Selected")
        {
            mDirty = true;
            if (item.RowState != "NEW")
                item.RowState = "DIRTY";
        }
        StateHasChanged();
    }

    private void RecalculateAfterEdit(EstimateItemRow item, string colName)
    {
        var rowBudgeted = item.BudgetGenerated;
        var rowPOed = !string.IsNullOrWhiteSpace(item.PONumber);

        switch (colName)
        {
            case "TakeoffQty":
                if (ShowBudgetColumns)
                {
                    item.BudgetQty = RoundToValue(item.TakeoffQty * (100 + item.WastePercent) / 100 * item.ConversionFactor, item.RoundTo, item.RoundDir);
                    item.BudgetPretax = Math.Round(item.BudgetQty * item.BudgetRate, 2);
                    item.BudgetJCTax = Math.Round(item.BudgetPretax * item.BudgetJCTaxRate / 100, 2);
                    item.BudgetNJCTax = Math.Round(item.BudgetPretax * item.BudgetNJCTaxRate / 100, 2);
                    item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                    if (!rowPOed)
                    {
                        item.POQty = item.BudgetQty;
                        item.POPretax = item.BudgetPretax;
                        item.POJCTax = item.BudgetJCTax;
                        item.PONJCTax = item.BudgetNJCTax;
                        item.POTax = item.BudgetTax;
                    }
                }
                break;
            case "BudgetQty":
                item.BudgetPretax = Math.Round(item.BudgetQty * item.BudgetRate, 2);
                item.BudgetJCTax = Math.Round(item.BudgetPretax * item.BudgetJCTaxRate / 100, 2);
                item.BudgetNJCTax = Math.Round(item.BudgetPretax * item.BudgetNJCTaxRate / 100, 2);
                item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                if (!rowPOed) { item.POQty = item.BudgetQty; item.POPretax = item.BudgetPretax; }
                break;
            case "BudgetRate":
                item.BudgetOverridden = true;
                item.BudgetPretax = Math.Round(item.BudgetQty * item.BudgetRate, 2);
                item.BudgetJCTax = Math.Round(item.BudgetPretax * item.BudgetJCTaxRate / 100, 2);
                item.BudgetNJCTax = Math.Round(item.BudgetPretax * item.BudgetNJCTaxRate / 100, 2);
                item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                if (!rowPOed) { item.PORate = item.BudgetRate; item.POPretax = item.BudgetPretax; item.POOverridden = true; }
                break;
            case "POQty":
                item.POPretax = Math.Round(item.POQty * item.PORate, 2);
                item.POJCTax = Math.Round(item.POPretax * item.POJCTaxRate / 100, 2);
                item.PONJCTax = Math.Round(item.POPretax * item.PONJCTaxRate / 100, 2);
                item.POTax = item.POJCTax + item.PONJCTax;
                if (!rowBudgeted) { item.BudgetQty = item.POQty; item.BudgetPretax = item.POPretax; }
                break;
            case "PORate":
                item.POOverridden = true;
                item.POPretax = Math.Round(item.POQty * item.PORate, 2);
                item.POJCTax = Math.Round(item.POPretax * item.POJCTaxRate / 100, 2);
                item.PONJCTax = Math.Round(item.POPretax * item.PONJCTaxRate / 100, 2);
                item.POTax = item.POJCTax + item.PONJCTax;
                if (!rowBudgeted) { item.BudgetRate = item.PORate; item.BudgetPretax = item.POPretax; item.BudgetOverridden = true; }
                break;
            case "BudgetVendor":
                if (!rowPOed) { item.POVendor = item.BudgetVendor; item.POVendorName = item.BudgetVendorName; }
                break;
            case "POVendor":
                if (!rowBudgeted) { item.BudgetVendor = item.POVendor; item.BudgetVendorName = item.POVendorName; }
                break;
        }
    }

    // ── Assembly Grid Layout Helpers ─────────────────────────
    // Properties that actually exist on AssemblyNode and can be rendered as
    // tree columns. Anything else (Customer_No, POIndex, JCCostCode etc.) is
    // a SQL-side KeyFld used in the WHERE clause — there's no per-node value
    // to display, so the column would render empty with a confusing caption
    // (often the raw `case when ...` SQL the user saved as a layout caption).
    private static readonly HashSet<string> _renderableAssemblyFields = new(StringComparer.OrdinalIgnoreCase)
    { "Node", "Budgeted", "Changes", "Committed" };

    private IEnumerable<(GridLayoutColumn Layout, string Field)> GetOrderedAssemblyGridLayout()
    {
        if (!HasAssemblyGridLayout) yield break;

        var ordered = gAssembliesLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Dedupe by resolved field — VB6 layouts sometimes have multiple
        // aliases pointing at the same AssemblyNode column (e.g. "Bdgted"
        // and "Budgeted" both → Budgeted). Render each property once.
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var layout in ordered)
        {
            var resolvedField = ResolveAssemblyField(layout.Field);
            if (string.IsNullOrWhiteSpace(resolvedField)) continue;
            // Skip any KeyFld-only column — we can't render it (no per-node value).
            if (!_renderableAssemblyFields.Contains(resolvedField)) continue;
            if (!seen.Add(resolvedField)) continue;
            yield return (layout, resolvedField);
        }
    }

    private static string ResolveAssemblyField(string layoutField)
    {
        if (string.IsNullOrWhiteSpace(layoutField)) return layoutField ?? "";
        var trimmed = layoutField.Trim();
        var exact = typeof(AssemblyNode).GetProperty(trimmed, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
        if (exact != null) return exact.Name;
        // Common VB6 aliases
        return trimmed switch
        {
            "Assemblies" or "Description" or "HFDescription" or "CustomerDesc" or "CORNumber" => "Node",
            "Commited" => "Committed",  // VB6 typo
            _ => trimmed
        };
    }

    // Sanitise a tree column caption so SQL fragments (case when / select / etc.)
    // never leak into the column header. If the layout caption looks like SQL
    // (or is missing), fall back to a friendly name derived from the field.
    private static string FriendlyAssemblyHeader(string? caption, string field)
    {
        var c = (caption ?? "").Trim();
        var looksLikeSql = !string.IsNullOrEmpty(c) &&
            (c.Contains("case when", StringComparison.OrdinalIgnoreCase) ||
             c.Contains("when ", StringComparison.OrdinalIgnoreCase) && c.Contains("then ", StringComparison.OrdinalIgnoreCase) ||
             c.Contains("select ", StringComparison.OrdinalIgnoreCase) ||
             c.Contains("'+'", StringComparison.OrdinalIgnoreCase));
        if (string.IsNullOrEmpty(c) || looksLikeSql)
        {
            return field switch
            {
                "Node" => "Assemblies",
                "Budgeted" => "Budgeted",
                "Changes" => "Changes",
                "Committed" => "Committed",
                _ => field
            };
        }
        return c;
    }

    private static string? GetAssemblyColumnFormat(string field)
    {
        return field switch
        {
            "Budgeted" or "Changes" or "Committed" => "C2",
            _ => null
        };
    }

    private static bool IsAssemblyNumericField(string field)
    {
        return field is "Budgeted" or "Changes" or "Committed";
    }

    // ── Items Grid Layout Helpers ─────────────────────────────
    // gItems' ordered-columns + field-resolution + column-type are CANONICAL
    // (exact→normalized→alias→literal resolve with the ctor alias map; bool→CheckBox
    // / DateTime→Date / numeric→Number type map — no name overrides, no string-as-
    // number columns), so they delegate straight to the presenter. The old
    // GetOrderedGridLayout body, ResolveGridField switch and GetColumnTypeForField
    // reflection map were byte-for-byte the presenter's GetOrdered / ResolveField /
    // ColumnTypeFor and have been removed (their NormalizeGridKey + _itemRowPropMap
    // duplicates are gone too).
    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedGridLayout()
        => _gItems.GetOrdered();

    private static string? GetFormatForField(string field, ColumnType colType)
    {
        if (colType != ColumnType.Number) return null;
        return field switch
        {
            "BudgetRate" or "PORate" => "N4",
            "BudgetPretax" or "POPretax" or "BudgetJCTax" or "BudgetNJCTax" or "BudgetTax"
                or "POJCTax" or "PONJCTax" or "POTax" => "C2",
            "ConversionFactor" => "N4",
            _ => "N2"
        };
    }

    private static bool IsFieldEditable(string field)
    {
        return field switch
        {
            "EstItemID" or "RowState" or "Assembly" or "AssemblyDescription"
                or "EstPhase" or "EstItem" or "JCCostCodeDesc" or "JCCategoryDesc"
                or "VarianceJCCategoryDesc" or "BudgetVendorName" or "POVendorName"
                or "BudgetTax" or "POTax" or "BudgetGenerated" or "BudgetOverridden"
                or "POOverridden" or "PONumber" or "POStatus" or "OptionDesc"
                or "POIndexDescription" or "EstPhaseDesc" or "ChangeOrder" => false,
            _ => true
        };
    }

    private bool IsColumnVisibleForMode(string field)
    {
        // VB6 (FEstimateItems.frm:6760-6766): each mode displays only its own
        // pricing set — Budget* in budget/quote, PO* in PO/contract/billing/bids.
        // POIndex/POIndexDescription/POGroup are display-only grouping columns
        // and stay visible in all modes.
        if (ModeValue == FCEMode.fcePO || ModeValue == FCEMode.fceContract ||
            ModeValue == FCEMode.fceBilling || ModeValue == FCEMode.fceBids)
        {
            if (field.StartsWith("Budget", StringComparison.OrdinalIgnoreCase) && field != "BudgetGenerated")
                return false;
        }
        else
        {
            if (field.StartsWith("PO", StringComparison.OrdinalIgnoreCase) &&
                field != "POIndex" && field != "POIndexDescription" && field != "POGroup")
                return false;
        }
        return true;
    }

    // ── Per-view fallback columns for the items grid ─────────────────────
    // Used only when no AppGridLayout entries exist for the current
    // (mode, view) combo. VB6 persists each view's layout separately
    // (IniGetGrid with key `mMode & mViewIndex` — line 4825/4909); this
    // method provides a sensible default per view that emphasises the
    // columns most relevant to that grouping.
    private record struct FallbackColumn(
        string Field, string Header, string Width,
        ColumnType Type = ColumnType.Text,
        string? Format = null,
        TextAlign TextAlign = TextAlign.Left,
        bool AllowEditing = true);

    private IEnumerable<FallbackColumn> GetFallbackItemColumns()
    {
        var bp = ShowBudgetColumns;       // Budget* vs PO* pricing block
        var qtyField    = bp ? "BudgetQty"    : "POQty";
        var rateField   = bp ? "BudgetRate"   : "PORate";
        var pretaxField = bp ? "BudgetPretax" : "POPretax";
        var taxField    = bp ? "BudgetJCTax"  : "POJCTax";
        var totalField  = bp ? "BudgetTax"    : "POTax";
        var vendorField = bp ? "BudgetVendorName" : "POVendorName";

        // Common selection checkbox at the head of every view.
        var sel = new FallbackColumn("Selected", "✓", "36px", Type: ColumnType.CheckBox);
        var desc = new FallbackColumn("ItemDesc", "Description", "220px");

        var qty    = new FallbackColumn(qtyField,    "Qty",       "60px",  Type: ColumnType.Number, Format: "N2", TextAlign: TextAlign.Right);
        var uom    = new FallbackColumn("OrderUOM",  "UOM",       "50px",  AllowEditing: false);
        var rate   = new FallbackColumn(rateField,   "Unit Cost", "80px",  Type: ColumnType.Number, Format: "C4", TextAlign: TextAlign.Right);
        var pretax = new FallbackColumn(pretaxField, "Pretax",    "100px", Type: ColumnType.Number, Format: "C2", TextAlign: TextAlign.Right, AllowEditing: false);
        var tax    = new FallbackColumn(taxField,    "Tax",       "80px",  Type: ColumnType.Number, Format: "C2", TextAlign: TextAlign.Right, AllowEditing: false);
        var total  = new FallbackColumn(totalField,  "Total",     "100px", Type: ColumnType.Number, Format: "C2", TextAlign: TextAlign.Right, AllowEditing: false);

        // Pricing block — same trailing columns regardless of view.
        IEnumerable<FallbackColumn> Pricing() => new[] { qty, uom, rate, pretax, tax, total };

        // Tighter pricing block for per-view variants that match the VB6
        // screenshots more precisely (Qty / UOM / Unit Cost / Pretax — no
        // Tax / Total in those grids).
        IEnumerable<FallbackColumn> ShortPricing() => new[] { qty, uom, rate, pretax };

        switch (CurrentView.Name)
        {
            case "Cost Code":
                // Cost Code screenshot (top-down):
                //   Cost Code | JC Category | POIndex | Description | Vendor Name | Comments | Qty | UOM | Unit Cost | Pretax | Exclude | Row Type
                yield return new("JCCostCode",      "Cost Code",     "80px",  AllowEditing: false);
                yield return new("JCCategory",      "JC Category",   "80px");
                yield return new("POIndex",         "POIndex",       "90px",  AllowEditing: false);
                yield return desc;
                yield return new(vendorField,       "Vendor Name",   "150px", AllowEditing: false);
                yield return new("ItemComments",    "Comments",      "120px");
                foreach (var c in ShortPricing()) yield return c;
                yield return new("ExcludeFromPO",   "Exclude",       "60px",  Type: ColumnType.CheckBox);
                yield return new("ChangeOrder",     "Row Type",      "70px",  AllowEditing: false);
                break;

            case "Vendor":
                // Vendor screenshot (top-down):
                //   ☐ | POIndex | Job | Option Desc | Description | Comments | PO Number | Vendor Name | Qty | UOM | Unit Cost | Pretax | Exclude | Row Type
                yield return sel;
                yield return new("POIndex",       "POIndex",      "90px",  AllowEditing: false);
                yield return new("Job_No",        "Job",          "70px",  AllowEditing: false);
                yield return new("OptionDesc",    "Option Desc",  "120px", AllowEditing: false);
                yield return desc;
                yield return new("ItemComments",  "Comments",     "120px");
                yield return new("PONumber",      "PO Number",    "80px",  AllowEditing: false);
                yield return new(vendorField,     "Vendor Name",  "180px", AllowEditing: false);
                foreach (var c in ShortPricing()) yield return c;
                yield return new("ExcludeFromPO", "Exclude",      "60px",  Type: ColumnType.CheckBox);
                yield return new("ChangeOrder",   "Row Type",     "70px",  AllowEditing: false);
                break;

            case "PO Group":
                // PO Group screenshot:
                //   ☐ | Vendor Name | Job | POIndex | Option Desc | Phase | Item | Description | Comments | Qty | UOM | Unit Cost | Pretax | Exclude | Row Type
                yield return sel;
                yield return new(vendorField,     "Vendor Name",  "180px", AllowEditing: false);
                yield return new("Job_No",        "Job",          "70px",  AllowEditing: false);
                yield return new("POIndex",       "POIndex",      "90px",  AllowEditing: false);
                yield return new("OptionDesc",    "Option Desc",  "120px", AllowEditing: false);
                yield return new("EstPhase",      "Phase",        "70px",  AllowEditing: false);
                yield return new("EstItem",       "Item",         "60px",  AllowEditing: false);
                yield return desc;
                yield return new("ItemComments",  "Comments",     "120px");
                foreach (var c in ShortPricing()) yield return c;
                yield return new("ExcludeFromPO", "Exclude",      "60px",  Type: ColumnType.CheckBox);
                yield return new("ChangeOrder",   "Row Type",     "70px",  AllowEditing: false);
                break;

            case "PO Index":
                // PO Index screenshot:
                //   ☐ | Job | Vendor Name | Option Desc | POIndex | Description | JC Category | Cost Code | Cost Code Desc | Qty | UOM | Unit Cost | Pretax | Costed Tax
                yield return sel;
                yield return new("Job_No",         "Job",            "70px",  AllowEditing: false);
                yield return new(vendorField,      "Vendor Name",    "160px", AllowEditing: false);
                yield return new("OptionDesc",     "Option Desc",    "120px", AllowEditing: false);
                yield return new("POIndex",        "POIndex",        "90px",  AllowEditing: false);
                yield return desc;
                yield return new("JCCategory",     "JC Category",    "80px");
                yield return new("JCCostCode",     "Cost Code",      "80px");
                yield return new("JCCostCodeDesc", "Cost Code Desc", "150px", AllowEditing: false);
                foreach (var c in ShortPricing()) yield return c;
                yield return tax;
                break;

            case "Purchase Orders":
                // PO mode-only view — lead with PO number, status, vendor.
                yield return sel;
                yield return new("PONumber",      "PO #",        "90px",  AllowEditing: false);
                yield return new("POStatus",      "Status",      "80px",  AllowEditing: false);
                yield return new("POVendorName",  "Vendor Name", "180px", AllowEditing: false);
                yield return new("POIndex",       "POIndex",     "90px",  AllowEditing: false);
                yield return desc;
                yield return new("JCCostCode",    "Cost Code",   "80px");
                foreach (var c in ShortPricing()) yield return c;
                yield return tax;
                break;

            case "Customer":
            default:
                // Customer screenshot (Asmbly/Extra panel above):
                //   ☐ | POIndex | Vendor Name | Job | Option Desc | Description | JC Category | Cost Code | Cost Code Desc
                yield return sel;
                yield return new("POIndex",        "POIndex",        "90px",  AllowEditing: false);
                yield return new(vendorField,      "Vendor Name",    "160px", AllowEditing: false);
                yield return new("Job_No",         "Job",            "70px",  AllowEditing: false);
                yield return new("OptionDesc",     "Option Desc",    "120px", AllowEditing: false);
                yield return desc;
                yield return new("JCCategory",     "JC Category",    "80px");
                yield return new("JCCostCode",     "Cost Code",      "80px");
                yield return new("JCCostCodeDesc", "Cost Code Desc", "160px", AllowEditing: false);
                foreach (var c in Pricing()) yield return c;
                break;
        }
    }

    // twips → px is the single canonical GridLayoutPresenter.WidthPx now
    // (formerly a hand-copied duplicate of /15 + 16, clamp [32..2000]). Kept as a
    // thin delegation so the markup's ConvertLayoutWidthToPx(...) calls are unchanged.
    // (The NormalizeGridKey duplicate of GridLayoutPresenter.NormalizeKey was removed
    // with the reflection prop-map — nothing references it now.)
    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // ── Utility Functions ─────────────────────────────────────
    private static double ToDouble(object? value)
    {
        if (value == null || value == DBNull.Value) return 0;
        if (value is double d) return d;
        if (value is float f) return f;
        if (value is decimal dec) return (double)dec;
        return double.TryParse(value.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var result) ? result : 0;
    }

    private static int ToInt(object? value, int defaultValue = 0)
    {
        if (value == null || value == DBNull.Value) return defaultValue;
        if (value is int i) return i;
        if (int.TryParse(value.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var result)) return result;
        return defaultValue;
    }

    private static long ToLong(object? value)
    {
        if (value == null || value == DBNull.Value) return 0;
        if (value is long l) return l;
        if (value is int i) return i;
        return long.TryParse(value.ToString(), out var result) ? result : 0;
    }

    private static bool ToBool(DataRow row, string col)
    {
        if (!row.Table.Columns.Contains(col)) return false;
        var value = row[col];
        if (value == null || value == DBNull.Value) return false;
        var s = value.ToString() ?? "";
        return s.Equals("True", StringComparison.OrdinalIgnoreCase) || s == "1";
    }

    private static double RoundToValue(double value, double roundTo, int roundDir)
    {
        if (roundTo <= 0) return value;
        var quotient = value / roundTo;
        if (Math.Abs(quotient - Math.Round(quotient)) < 1e-12) return value;
        if (roundDir > 0) return Math.Ceiling(quotient) * roundTo;
        if (roundDir < 0) return Math.Floor(quotient) * roundTo;
        return Math.Round(quotient) * roundTo;
    }

