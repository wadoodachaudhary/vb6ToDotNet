    // ── Load Assembly Detail Header ───────────────────────────
    // Now populates the full Asmbly/Extra panel state (Color, Location, Style,
    // Other, EstimatorNotes) — VB6 frmAssembly does the same at line 6936-6975.
    private async Task LoadAssemblyDetail(long estAssemblyId)
    {
        try
        {
            var sql = @"
                SELECT a.Assembly, a.HFDescription, a.HFCategory, a.HFComments,
                       a.SalesQty, a.AssemblyUOM, a.EstimatorNotes,
                       a.Color, a.Location, a.Style, a.Other,
                       c.Description AS HFCatDesc
                FROM EstimateAssemblies a
                LEFT OUTER JOIN tblcategories c ON a.hfcategory = c.category
                WHERE a.EstAssemblyID = @Id";
            var dt = db.SqlExec(sql, new { Id = estAssemblyId });
            if (dt.Rows.Count > 0)
            {
                var row = dt.Rows[0];
                AssemblyOption          = row["Assembly"]?.ToString() ?? "";
                AssemblyCategory        = row["HFCatDesc"]?.ToString() ?? "";
                AssemblyDescription     = row["HFDescription"]?.ToString() ?? "";
                AssemblyQuantity        = $"{row["SalesQty"]} {row["AssemblyUOM"]}".Trim();
                AssemblyComments        = row["HFComments"]?.ToString() ?? "";
                AssemblyEstimatorNotes  = SafeRowString(row, "EstimatorNotes");
                AssemblyColor           = SafeRowString(row, "Color");
                AssemblyLocation        = SafeRowString(row, "Location");
                AssemblyStyle           = SafeRowString(row, "Style");
                AssemblyOther           = SafeRowString(row, "Other");
            }
        }
        catch (Exception ex)
        {
            _lastError = $"LoadAssemblyDetail error: {ex.Message}";
            Console.WriteLine(_lastError);
        }
    }

    // ── Load PO Header Detail ─────────────────────────────────────────────
    // Populates the PO Header panel from the selected tree node. Mirrors VB6
    // frmPOIndex LoadEstItems block (FEstimateItems.frm:7060-7115). For now
    // the description / standard-text / ship-via etc. are pulled from the
    // PurchaseOrders table by PONumber when available; otherwise we display
    // what we know from the tree node alone.
    private async Task LoadPoHeaderDetail(AssemblyNode node)
    {
        // Sensible defaults from the node itself.
        PoHeaderVendorName   = "";
        PoHeaderPoIndexLabel = "";
        PoHeaderDescription  = "";
        PoStandardText       = "";
        PoShipVia            = "";
        PoFob                = "";
        PoTerms              = "";
        PoOrderedBy          = "";
        PoRetainagePercent   = "0";
        PoHideePrice = PoHideQty = PoTotalOnly = false;

        // Walk back up the parent chain to discover POIndex + Vendor when the
        // selected node only carries one of them (e.g. Vendor view leaf has
        // KeyField=POIndex but the parent is the vendor name).
        var poIndex = "";
        var vendor  = "";
        var poNumber = "";
        for (var n = node; n != null; n = AssemblyTreeData.FirstOrDefault(x => x.NodeID == n.ParentID))
        {
            switch (n.KeyField)
            {
                case "POIndex":         if (string.IsNullOrEmpty(poIndex)) poIndex = n.KeyValue; break;
                case "BudgetVendor":
                case "POVendor":        if (string.IsNullOrEmpty(vendor)) vendor = n.Node; break;
                case "PONumber":        if (string.IsNullOrEmpty(poNumber)) poNumber = n.KeyValue; break;
                case "PONumberVendor":  if (string.IsNullOrEmpty(poNumber)) poNumber = (n.KeyValue ?? "").Split('|', '~').FirstOrDefault() ?? ""; break;
            }
            if (n.Level <= 0) break;
        }

        PoHeaderVendorName        = vendor;
        PoHeaderPoIndexLabel      = string.IsNullOrEmpty(poIndex) ? node.Node : poIndex;
        _poHeaderSourcePoNumber   = poNumber;

        // If we have a PONumber, pull header details from the PurchaseOrders table.
        if (!string.IsNullOrWhiteSpace(poNumber))
        {
            try
            {
                var sql = @"
                    SELECT TOP 1 Description, StandardText, ShipVia, FOB, Terms,
                                 OrderedBy, HideQty, HidePrice, TotalOnly, RetainagePercent
                      FROM PurchaseOrders
                     WHERE PONumber = @PoNumber AND DivisionID = @DivisionID";
                var dt = db.SqlExec(sql, new { PoNumber = poNumber, DivisionID = Session.DivisionID });
                if (dt.Rows.Count > 0)
                {
                    var r = dt.Rows[0];
                    PoHeaderDescription = SafeRowString(r, "Description");
                    PoStandardText      = SafeRowString(r, "StandardText");
                    PoShipVia           = SafeRowString(r, "ShipVia");
                    PoFob               = SafeRowString(r, "FOB");
                    PoTerms             = SafeRowString(r, "Terms");
                    PoOrderedBy         = SafeRowString(r, "OrderedBy");
                    PoHideePrice        = ToBool(r, "HidePrice");
                    PoHideQty           = ToBool(r, "HideQty");
                    PoTotalOnly         = ToBool(r, "TotalOnly");
                    PoRetainagePercent  = SafeRowString(r, "RetainagePercent");
                    if (string.IsNullOrEmpty(PoRetainagePercent)) PoRetainagePercent = "0";
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"LoadPoHeaderDetail: {ex.Message}");
            }
        }
        await Task.CompletedTask;
    }

    // ── Load Change Order Detail ──────────────────────────────────────────
    // Mirrors VB6 frmChangeOrder load (FEstimateItems.frm:6906-6932). Walks
    // up the parent chain to find Customer_No (parent of CORSort node) and
    // CORSort/ChangeOrder value, then queries changeordermaster.
    // Locked unless changeordermaster.PurchasingCO = True.
    private async Task LoadChangeOrderDetail(AssemblyNode node)
    {
        CoNumber = CoDate = CoApprovedBy = CoDateApproved = CoComments = "";
        CoLocked = true;
        mCustomerNo = "";
        mChangeOrder = node.KeyValue ?? "";

        // VB6 strips a sentinel "ZZZZZ" prefix used to sort blank COs to the bottom.
        if (mChangeOrder.StartsWith("ZZZZZ", StringComparison.OrdinalIgnoreCase))
            mChangeOrder = "";

        // Walk up to find the Customer_No (the parent of a CORSort node).
        for (var n = node; n != null; n = AssemblyTreeData.FirstOrDefault(x => x.NodeID == n.ParentID))
        {
            if (string.Equals(n.KeyField, "Customer_No", StringComparison.OrdinalIgnoreCase))
            {
                mCustomerNo = n.KeyValue ?? "";
                break;
            }
            if (n.Level <= 0) break;
        }

        if (string.IsNullOrWhiteSpace(mCustomerNo) || string.IsNullOrWhiteSpace(mChangeOrder))
            return;

        try
        {
            var sql = @"
                SELECT TOP 1 change_order_no, change_date, bldr_approved_date,
                             bldr_approved_by, Comments, PurchasingCO
                  FROM changeordermaster
                 WHERE customer_no    = @CustomerNo
                   AND change_order_no = @ChangeOrder";
            var dt = db.SqlExec(sql, new { CustomerNo = mCustomerNo, ChangeOrder = mChangeOrder });
            if (dt.Rows.Count > 0)
            {
                var r = dt.Rows[0];
                CoNumber       = SafeRowString(r, "change_order_no");
                CoDate         = FormatDateMedium(r, "change_date");
                CoDateApproved = FormatDateMedium(r, "bldr_approved_date");
                CoApprovedBy   = SafeRowString(r, "bldr_approved_by");
                CoComments     = SafeRowString(r, "Comments");
                // VB6 line 6923: b = "" & rs("PurchasingCO") <> "True"; locked when b is true
                CoLocked       = !string.Equals(SafeRowString(r, "PurchasingCO"), "True", StringComparison.OrdinalIgnoreCase);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadChangeOrderDetail: {ex.Message}");
        }
        await Task.CompletedTask;
    }

    // Defensive date formatter — returns "" when missing/null/invalid.
    private static string FormatDateMedium(DataRow row, string col)
    {
        try
        {
            if (!row.Table.Columns.Contains(col)) return "";
            var v = row[col];
            if (v == null || v == DBNull.Value) return "";
            if (v is DateTime dt) return dt.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
            if (DateTime.TryParse(v.ToString(), out var parsed))
                return parsed.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
            return v.ToString() ?? "";
        }
        catch { return ""; }
    }

    // Defensive row reader — returns "" when the column isn't present (e.g.
    // older DB schemas missing the optional columns referenced by these panels).
    private static string SafeRowString(DataRow row, string col)
    {
        try { return row.Table.Columns.Contains(col) ? (row[col]?.ToString() ?? "") : ""; }
        catch { return ""; }
    }

    // ── Load Items for Selected Assembly (back-compat overload) ───────────
    // Older call-sites pass an EstAssemblyID directly. We forward to the
    // generic where-clause version so all loads share the same code path.
    private Task LoadItems(long estAssemblyId)
    {
        var divId = Session.DivisionID.ToString(CultureInfo.InvariantCulture);
        var where = $"AND i.DivisionID = {divId} AND EstAssemblyID = {estAssemblyId.ToString(CultureInfo.InvariantCulture)}";
        return LoadItemsByWhere(where);
    }

    // ── Load Items by accumulated WhereClause (multi-level tree click) ────
    // Mirrors VB6 LoadEstItems (FEstimateItems.frm:7118-7136) — items pulled
    // from the Estimateditems VIEW with the clicked tree node's RowData
    // (everything from " AND i.DivisionID = X AND Job_No='J'" down to whichever
    // KeyFld leaves the user has expanded).
    private async Task LoadItemsByWhere(string whereClause)
    {
        ItemsData = new();
        if (string.IsNullOrWhiteSpace(whereClause))
        {
            StateHasChanged();
            return;
        }

        try
        {
            // The whereClause always starts with " AND ..." — strip the leading
            // " AND " so it can sit after our own WHERE. (Mirrors VB6's
            // `Mid(WhereClause, 6)` slicing at FEstimateItems.frm:9186.)
            var trimmed = whereClause.TrimStart();
            if (trimmed.StartsWith("AND ", StringComparison.OrdinalIgnoreCase))
                trimmed = trimmed.Substring(4);

            DataTable dt;
            try
            {
                var sql = $@"SELECT * FROM Estimateditems i
                              WHERE (NOT i.EstItemID IS NULL)
                                AND {trimmed}";
                dt = db.SqlExec(sql);
            }
            catch (Exception viewEx)
            {
                Console.WriteLine($"LoadItemsByWhere (Estimateditems view failed: {viewEx.Message}); falling back to EstimateItems base table.");
                var sql = $@"SELECT * FROM EstimateItems i
                              WHERE (NOT i.EstItemID IS NULL)
                                AND {trimmed.Replace("Job_No", "Job_no")}";
                dt = db.SqlExec(sql);
            }

            foreach (DataRow row in dt.Rows)
            {
                // VB6: ignore deleted items based on mode
                var budgetDeleted = ToBool(row, "BudgetDeleted");
                var poDeleted = ToBool(row, "PODeleted");
                if ((ModeValue == FCEMode.fceQuote || ModeValue == FCEMode.fceBudget) && budgetDeleted) continue;
                if (ModeValue == FCEMode.fcePO && poDeleted) continue;

                var convFactor = ToDouble(row["ConversionFactor"]);
                var budgetQty = ToDouble(row["BudgetQty"]);
                var takeoffQty = convFactor != 0 ? budgetQty / convFactor : budgetQty;

                var item = new EstimateItemRow
                {
                    EstItemID = ToLong(row["EstItemID"]),
                    EstAssemblyID = ToLong(row["EstAssemblyID"]),
                    Job_No = row["Job_No"]?.ToString() ?? "",
                    Customer_No = row["Customer_No"]?.ToString() ?? "",
                    Assembly = row["Assembly"]?.ToString() ?? "",
                    AssemblyDescription = row["AssemblyDescription"]?.ToString() ?? "",
                    EstPhase = row["EstPhase"]?.ToString() ?? "",
                    EstItem = row["EstItem"]?.ToString() ?? "",
                    ItemDesc = row["ItemDesc"]?.ToString() ?? "",
                    ItemComments = row["ItemComments"]?.ToString() ?? "",
                    JCExtra = row["JCExtra"]?.ToString() ?? "",
                    JCCostCode = row["JCCostCode"]?.ToString() ?? "",
                    JCCostCodeDesc = row["JCCostCodeDesc"]?.ToString() ?? "",
                    JCCategory = row["JCCategory"]?.ToString() ?? "",
                    JCCategoryDesc = row["JCCategoryDesc"]?.ToString() ?? "",
                    //OriginalJCCategory = row["OriginalJCCategory"]?.ToString() ?? "",
                    VarianceJCCategory = row["VarianceJCCategory"]?.ToString() ?? "",
                    VarianceJCCategoryDesc = row["VarianceJCCategoryDesc"]?.ToString() ?? "",
                    TakeoffQty = takeoffQty,
                    TakeoffUOM = row["TakeoffUOM"]?.ToString() ?? "",
                    OrderUOM = row["OrderUOM"]?.ToString() ?? "",
                    ConversionFactor = convFactor,
                    RoundTo = ToDouble(row["RoundTo"]),
                    RoundDir = ToInt(row["RoundDir"]),
                    WastePercent = ToDouble(row["WastePercent"]),
                    Model = row["Model"]?.ToString() ?? "",
                    OptionID = row["OptionID"]?.ToString() ?? "",
                    //OptionDesc = row["OptionDesc"]?.ToString() ?? "",
                    POIndex = row["POIndex"]?.ToString() ?? "",
                    POIndexDescription = row["POIndexDescription"]?.ToString() ?? "",
                    POGroup = row["POGroup"]?.ToString() ?? "",
                    PONumber = row["PONumber"]?.ToString() ?? "",
                    POStatus = row["POStatus"]?.ToString() ?? "",
                    BudgetVendor = row["BudgetVendor"]?.ToString() ?? "",
                    BudgetVendorName = row["BudgetVendorName"]?.ToString() ?? "",
                    BudgetQty = ToDouble(row["BudgetQty"]),
                    BudgetRate = ToDouble(row["BudgetRate"]),
                    BudgetPretax = ToDouble(row["BudgetPretax"]),
                    BudgetTaxGroup = row["BudgetTaxGroup"]?.ToString() ?? "",
                    BudgetJCTax = ToDouble(row["BudgetJCTax"]),
                    BudgetJCTaxRate = ToDouble(row["BudgetJCTaxRate"]),
                    BudgetNJCTax = ToDouble(row["BudgetNJCTax"]),
                    BudgetNJCTaxRate = ToDouble(row["BudgetNJCTaxRate"]),
                    BudgetOverridden = ToBool(row, "BudgetOverridden"),
                    BudgetGenerated = ToBool(row, "BudgetGenerated"),
                    BudgetDeleted = budgetDeleted,
                    POVendor = row["POVendor"]?.ToString() ?? "",
                    POVendorName = row["POVendorName"]?.ToString() ?? "",
                    POQty = ToDouble(row["POQty"]),
                    PORate = ToDouble(row["PORate"]),
                    POPretax = ToDouble(row["POPretax"]),
                    POTaxGroup = row["POTaxGroup"]?.ToString() ?? "",
                    POJCTax = ToDouble(row["POJCTax"]),
                    POJCTaxRate = ToDouble(row["POJCTaxRate"]),
                    PONJCTax = ToDouble(row["PONJCTax"]),
                    PONJCTaxRate = ToDouble(row["PONJCTaxRate"]),
                    POOverridden = ToBool(row, "POOverridden"),
                    POGenBatch = ToInt(row["POGenBatch"]),
                    PODeleted = poDeleted,
                    ExcludeFromPO = ToBool(row, "ExcludeFromPO"),
                    SortOrder = ToInt(row["SortOrder"]),
                    Seq = ToInt(row["Seq"]),
                    ChangeOrder = row["ChangeOrder"]?.ToString() ?? "",
                    IsChange = ToBool(row, "IsChange"),
                    RowState = ""
                };

                item.BudgetTax = item.BudgetJCTax + item.BudgetNJCTax;
                item.POTax = item.POJCTax + item.PONJCTax;

                ItemsData.Add(item);
            }
        }
        catch (Exception ex)
        {
            _lastError = $"LoadItems error: {ex.Message}";
            Console.WriteLine(_lastError);
        }
    }

    // ── Save Data ─────────────────────────────────────────────
    private async Task<bool> SaveData(bool prompt)
    {
        if (!mDirty) return true;

        if (prompt)
        {
            var result = await PromptSave();
            if (result == 0) return false; // Cancel
            if (result == 2) return true;  // No (discard)
        }

        if (string.IsNullOrWhiteSpace(JobNumber))
        {
            Notifications.Info("A job/quote number is required.");
            return false;
        }

        IsLoading = true;
        StateHasChanged();

        try
        {
            if (!IsExistingJob)
            {
                // INSERT new job (quote mode)
                var insertSql = @"
                    INSERT INTO tblJobs(isquote, Job_No, Description, Notes, Community, CommunityPhase,
                                        Municipal_Address, Model, Inactive)
                    VALUES(@IsQuote, @JobNo, @Description, @Notes, @Community, @Phase,
                           @Address, @Model, 0)";
                await db.ExecuteAsync(insertSql, new
                {
                    IsQuote = ModeValue == FCEMode.fceQuote,
                    JobNo = JobNumber.Trim(),
                    Description = JobDescription,
                    Notes = JobNotes,
                    Community = JobCommunity,
                    Phase = JobPhase,
                    Address = JobAddress,
                    Model = JobModel
                });
                mJob = JobNumber.Trim();

                // Insert customer record
                var custSql = @"
                    INSERT INTO tblcustomers (Customer_No, Job_no, Description, purchased, approved,
                                              contract_assigned, cancelled, inactive, sale_posted)
                    VALUES(@CustNo, @JobNo, @Description, 1, 1, 1, 0, 0, 1)";
                await db.ExecuteAsync(custSql, new
                {
                    CustNo = JobNumber.Trim(),
                    JobNo = JobNumber.Trim(),
                    Description = JobDescription
                });

                // Insert first assembly
                var asmSql = @"
                    INSERT INTO EstimateAssemblies(job, Customer_no, EstimateIndex, HFDescription, AssemblyType, OptionType, salesqty)
                    VALUES(@Job, @CustNo, 0, @Desc, -1, -1, 1)";
                await db.ExecuteAsync(asmSql, new
                {
                    Job = JobNumber.Trim(),
                    CustNo = JobNumber.Trim(),
                    Desc = ModeValue == FCEMode.fceQuote ? "Quoted Items" : "Manual Estimates"
                });

                var idDt = db.SqlExec("SELECT IDENT_CURRENT('EstimateAssemblies')");
                if (idDt.Rows.Count > 0)
                    mEstAssemblyID = Convert.ToInt64(idDt.Rows[0][0]);

                await LoadAssemblies();
            }
            else
            {
                // UPDATE existing job
                var updateSql = @"
                    UPDATE tblJobs
                    SET Description = @Description,
                        Notes = @Notes,
                        Community = @Community,
                        CommunityPhase = @Phase,
                        Municipal_Address = @Address,
                        Model = @Model
                    WHERE Job_No = @JobNo";
                await db.ExecuteAsync(updateSql, new
                {
                    Description = JobDescription,
                    Notes = JobNotes,
                    Community = JobCommunity,
                    Phase = JobPhase,
                    Address = JobAddress,
                    Model = JobModel,
                    JobNo = mJob
                });
            }

            // Save dirty items
            await SaveItems();

            // Save the active detail panel's edits (Assembly / PO Header /
            // Change Order). Only one of these has unsaved data at a time —
            // the dispatcher tells us which.
            await SaveDetailPanel();

            mDirty = false;
            return true;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                Notifications.Error($"'{JobNumber}' already exists. Please use a different number.");
            else
                Notifications.Warning($"Error saving: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveItems()
    {
        foreach (var item in ItemsData.Where(i => i.RowState == "DIRTY"))
        {
            try
            {
                var sql = @"
                    UPDATE EstimateItems SET
                        POIndex=@POIndex, JCCostCode=@JCCostCode, JCCategory=@JCCategory,
                        Description=@Description, Comments=@Comments, OrderUOM=@OrderUOM,
                        BudgetVendor=@BudgetVendor, BudgetQty=@BudgetQty, BudgetRate=@BudgetRate,
                        BudgetPretax=@BudgetPretax, BudgetTaxGroup=@BudgetTaxGroup,
                        BudgetJCTax=@BudgetJCTax, BudgetJCTaxRate=@BudgetJCTaxRate,
                        BudgetNJCTax=@BudgetNJCTax, BudgetNJCTaxRate=@BudgetNJCTaxRate,
                        POVendor=@POVendor, POQty=@POQty, PORate=@PORate,
                        POPretax=@POPretax, POTaxGroup=@POTaxGroup,
                        POJCTax=@POJCTax, POJCTaxRate=@POJCTaxRate,
                        PONJCTax=@PONJCTax, PONJCTaxRate=@PONJCTaxRate,
                        ExcludeFromPO=@ExcludeFromPO,
                        BudgetOverridden=@BudgetOverridden, POOverridden=@POOverridden
                    WHERE EstItemID=@EstItemID";
                await db.ExecuteAsync(sql, new
                {
                    item.POIndex, item.JCCostCode, item.JCCategory,
                    Description = item.ItemDesc, Comments = item.ItemComments, item.OrderUOM,
                    item.BudgetVendor, item.BudgetQty, item.BudgetRate, item.BudgetPretax, item.BudgetTaxGroup,
                    item.BudgetJCTax, item.BudgetJCTaxRate, item.BudgetNJCTax, item.BudgetNJCTaxRate,
                    item.POVendor, item.POQty, item.PORate, item.POPretax, item.POTaxGroup,
                    item.POJCTax, item.POJCTaxRate, item.PONJCTax, item.PONJCTaxRate,
                    ExcludeFromPO = item.ExcludeFromPO ? 1 : 0,
                    BudgetOverridden = item.BudgetOverridden,
                    POOverridden = item.POOverridden,
                    item.EstItemID
                });
                item.RowState = "";
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "SaveItem {item.EstItemID} error");

            }
        }
    }

    // ── Save the active detail panel ──────────────────────────────────────
    // Routes to the right UPDATE based on which panel is currently visible.
    // VB6 SaveData (FEstimateItems.frm:11500+) writes to EstimateAssemblies,
    // PurchaseOrders, and changeordermaster in the same transaction. Each
    // UPDATE is best-effort here — a missing column on an older schema
    // shouldn't take down the whole save.
    private async Task SaveDetailPanel()
    {
        switch (DetailKindForSelection)
        {
            case SelectionDetailKind.Assembly:
                await SaveAssemblyDetail();
                break;
            case SelectionDetailKind.PoHeader:
                await SavePoHeaderDetail();
                break;
            case SelectionDetailKind.ChangeOrder:
                await SaveChangeOrderDetail();
                break;
        }
    }

    // VB6 frmAssembly save: UPDATE EstimateAssemblies for the editable fields
    // in the Asmbly/Extra panel. Locked fields (read-only displays like
    // Quantity / Selling Price / Approved By) aren't part of the UPDATE.
    private async Task SaveAssemblyDetail()
    {
        if (SelectedAssemblyId <= 0) return;
        try
        {
            const string sql = @"
                UPDATE EstimateAssemblies
                   SET HFDescription  = @Description,
                       HFComments     = @Comments,
                       EstimatorNotes = @EstimatorNotes,
                       Color          = @Color,
                       Location       = @Location,
                       Style          = @Style,
                       Other          = @Other
                 WHERE EstAssemblyID = @Id";
            await db.ExecuteAsync(sql, new
            {
                Description    = AssemblyDescription,
                Comments       = AssemblyComments,
                EstimatorNotes = AssemblyEstimatorNotes,
                Color          = AssemblyColor,
                Location       = AssemblyLocation,
                Style          = AssemblyStyle,
                Other          = AssemblyOther,
                Id             = SelectedAssemblyId
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SaveAssemblyDetail error");
            Notifications.Warning($"Couldn't save assembly detail: {ex.Message}");
        }
    }

    // VB6 frmPOIndex save: UPDATE PurchaseOrders for the visible PO header
    // fields. Only fires when a real PONumber is bound to the panel — POIndex
    // parents (no PONumber yet generated) have nothing to UPDATE.
    private async Task SavePoHeaderDetail()
    {
