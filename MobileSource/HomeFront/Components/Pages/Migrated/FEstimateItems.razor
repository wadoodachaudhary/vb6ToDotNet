    private async Task OnRePriceClick()
    {
        if (!await SaveData(true)) return;

        // VB6: Check for refreshable items
        var countDt = db.SqlExec(
            "SELECT COUNT(*) FROM EstimatedItems WHERE BudgetGenerated=0 AND Job_no=@JobNo",
            new { JobNo = mJob });
        var count = countDt.Rows.Count > 0 ? Convert.ToInt32(countDt.Rows[0][0]) : 0;
        if (count == 0)
        {
            await Dialogs.AlertAsync(
                "You have nothing selected that can be refreshed.\n" +
                "Use the check boxes to select some assemblies or items that have not already been generated.");
            return;
        }

        var confirm = await Dialogs.ConfirmAsync("Refresh costs for selected items?");
        if (!confirm) return;

        try
        {
            // VB6: 3 UPDATE statements for RePrice
            var updateRateSql = @"
                UPDATE EstimateItems
                SET BudgetOverridden = 0,
                    BudgetRate = CASE
                        WHEN ISNULL(dbo.Purch_GetItemRate(0,0,v.Community,v.CommunityPhase,v.Assembly,
                             CASE WHEN v.assemblytype=0 OR v.assemblytype=2 THEN v.model ELSE '' END,
                             '',v.EstPhase,v.EstItem,0,v.BudgetVendor,GETDATE(),@DivisionID),0) <> 0
                        THEN ISNULL(dbo.Purch_GetItemRate(0,0,v.Community,v.CommunityPhase,v.Assembly,
                             CASE WHEN v.assemblytype=0 OR v.assemblytype=2 THEN v.model ELSE '' END,
                             '',v.EstPhase,v.EstItem,0,v.BudgetVendor,GETDATE(),@DivisionID),0)
                        ELSE i.BudgetRate END
                FROM EstimateItems i
                JOIN EstimatedItems v ON (i.EstItemID = v.EstItemID)
                WHERE v.BudgetDeleted = 0
                  AND v.BudgetGenerated = 0
                  AND v.Job_no = @JobNo";
            await db.ExecuteAsync(updateRateSql, new { JobNo = mJob, DivisionID = Session.DivisionID });

            var extendSql = @"
                UPDATE EstimateItems
                SET BudgetPretax = i.BudgetRate * i.BudgetQty,
                    BudgetJCTax = i.BudgetRate * i.BudgetQty * i.BudgetJCTaxRate / 100,
                    BudgetNJCTax = i.BudgetRate * i.BudgetQty * i.BudgetNJCTaxRate / 100
                FROM EstimateItems i
                JOIN EstimatedItems v ON (i.EstItemID = v.EstItemID)
                WHERE v.BudgetDeleted = 0
                  AND v.BudgetGenerated = 0
                  AND v.Job_no = @JobNo";
            await db.ExecuteAsync(extendSql, new { JobNo = mJob });

            var syncPoSql = @"
                UPDATE EstimateItems
                SET PORate = v.BudgetRate,
                    POPretax = v.BudgetPretax,
                    POJCTax = v.BudgetJCTax,
                    PONJCTax = v.BudgetNJCTax,
                    POOverridden = 0
                FROM EstimateItems i
                JOIN EstimatedItems v ON (i.EstItemID = v.EstItemID)
                WHERE v.BudgetRate IS NOT NULL
                  AND v.BudgetDeleted = 0
                  AND v.BudgetGenerated = 0
                  AND v.POGenBatch = 0
                  AND v.Job_no = @JobNo";
            await db.ExecuteAsync(syncPoSql, new { JobNo = mJob });

            // Reload
            if (SelectedAssemblyId > 0)
                await LoadItems(SelectedAssemblyId);
            await LoadAssemblies();
            StateHasChanged();
            Notifications.Info("Costs have been successfully refreshed.");
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error refreshing costs: {ex.Message}");
        }
    }

