    /// <summary>
    /// VB6 (FEstimateItems.frm:11211): if the form opens with an empty Job, LoadJob("")
    /// pops the FPickList immediately so the user can pick a job. Mirror that here —
    /// fires after the first render so the picker can mount.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender
            && string.IsNullOrWhiteSpace(Job)
            && ModeValue != FCEMode.fceQuote   // Quote mode allows starting with no job (new quote)
            && pickList != null
            && _pickListContext == null)
        {
            await OnOpenClick();
        }
    }

    private FCEMode ParseMode(string? mode)
    {
        if (string.IsNullOrWhiteSpace(mode)) return FCEMode.fceBudget;
        return mode.Trim().ToLower() switch
        {
            "quote" => FCEMode.fceQuote,
            "budget" => FCEMode.fceBudget,
            "po" => FCEMode.fcePO,
            "contract" => FCEMode.fceContract,
            "bids" => FCEMode.fceBids,
            "billing" => FCEMode.fceBilling,
            _ => FCEMode.fceBudget
        };
    }

    // ── Load Grid Layout ──────────────────────────────────────
    // VB6 uses `mMode & mViewIndex` (string concatenation of two 0-based integers)
    // as the instance key — so each (mode, view) pair has its own saved layout.
    // Our FCEMode enum starts at 1; subtract 1 to match VB6's 0-based mode numbering.
    private string CurrentGridInstanceKey => $"{(int)ModeValue - 1}{mViewIndex}";

    // Tracks where each grid's column layout came from. Drives both the
    // console log and the visible "fallback" badge in the toolbar so devs
    // can spot missing AppGridLayout entries at a glance.
    //   None       → no layout fetched (initial state)
    //   Instance   → AppGridLayout row keyed `FEstimateItems.gItems.<mode><view>`
    //   Bare       → AppGridLayout row keyed `FEstimateItems.gItems`
    //   Fallback   → no row found; using the page's hard-coded GetFallbackItemColumns()
    private enum GridLayoutSource { None, Instance, Bare, Fallback }
    private GridLayoutSource _gItemsLayoutSource = GridLayoutSource.None;
    private GridLayoutSource _gAssembliesLayoutSource = GridLayoutSource.None;

    private async Task LoadGridLayoutAsync()
    {
        // ── Items grid (gItems) ──
        // VB6: Call IniGetGrid(Me, gItems, , , mMode & mViewIndex, True)
        // Runtime-dynamic instance key with the VB6 Instance→Bare probe, now via
        // the presenter's candidate-list LoadAsync (tries each tuple in order
        // until one returns rows). The two (grid, gridIndex, instanceKey) tuples
        // reproduce the EXACT two gridTags the prior two GetGridLayoutAsync calls
        // produced (gridIndex 0 ⇒ no ".(n)" subscript; the service appends
        // ".{instanceKey}" only when the key is non-blank):
        //   1. ("gItems", 0, itemsInstanceKey) → tag "FEstimateItems.gItems.<key>"  (Instance)
        //   2. ("gItems", 0, null)             → tag "FEstimateItems.gItems"        (Bare)
        // When BOTH miss, _gItems.Has is false and the markup renders the page's
        // hard-coded GetFallbackItemColumns() (the 3rd, host-side Fallback state).
        var itemsInstanceKey = CurrentGridInstanceKey;
        await _gItems.LoadAsync(GridLayoutSvc,
            ("gItems", 0, itemsInstanceKey),
            ("gItems", 0, (string?)null));

        // Classify the source for the diagnostic badge + console log (KEEP — the
        // 3-state GridLayoutSource split is form-specific). The candidate loader
        // doesn't surface WHICH tuple matched, so reproduce the exact Instance vs
        // Bare distinction with one keyed re-check, taken only when something
        // actually loaded (so the no-layout path issues no extra query and the
        // console text is byte-for-byte what the page emitted before).
        if (!_gItems.Has)
        {
            _gItemsLayoutSource = GridLayoutSource.Fallback;
            Console.WriteLine($"[FEstimateItems] gItems layout: NO AppGridLayout rows found for `FEstimateItems.gItems` (instance `{itemsInstanceKey}` or bare). Using hard-coded fallback columns from GetFallbackItemColumns(). Add an AppGridLayout row to override.");
        }
        else if ((await GridLayoutSvc.GetGridLayoutAsync("FEstimateItems", "gItems", 0, instanceKey: itemsInstanceKey)).Count > 0)
        {
            _gItemsLayoutSource = GridLayoutSource.Instance;
            Console.WriteLine($"[FEstimateItems] gItems layout: loaded {gItemsLayout.Count} columns from AppGridLayout `FEstimateItems.gItems.{itemsInstanceKey}` (mode={ModeValue}, view={CurrentView.Name}).");
        }
        else
        {
            _gItemsLayoutSource = GridLayoutSource.Bare;
            Console.WriteLine($"[FEstimateItems] gItems layout: instance key `{itemsInstanceKey}` not found in AppGridLayout — falling back to bare key `FEstimateItems.gItems` ({gItemsLayout.Count} columns). To customise this view, save a layout for the current (mode, view) combo.");
        }
        _gItems.BumpVersion();

        // ── Assembly tree (gAssemblies) ──
        // VB6: Call IniGetGrid(Me, gAssemblies). Single bare-key call → one
        // candidate tuple reproducing tag "FEstimateItems.gAssemblies".
        await _gAssemblies.LoadAsync(GridLayoutSvc, ("gAssemblies", 0, (string?)null));
        if (_gAssemblies.Has)
        {
            _gAssembliesLayoutSource = GridLayoutSource.Bare;
            Console.WriteLine($"[FEstimateItems] gAssemblies layout: loaded {gAssembliesLayout.Count} columns from AppGridLayout `FEstimateItems.gAssemblies`.");
        }
        else
        {
            _gAssembliesLayoutSource = GridLayoutSource.Fallback;
            Console.WriteLine($"[FEstimateItems] gAssemblies layout: NO AppGridLayout rows found for `FEstimateItems.gAssemblies`. Using hard-coded fallback columns (Node + Budgeted + Changes + Committed). Add an AppGridLayout row to override.");
        }
        _gAssemblies.BumpVersion();
    }

    // True when EITHER grid is using the page's hard-coded fallback set
    // (no AppGridLayout row found for any of the keys we tried). Drives the
    // visible toolbar badge.
    private bool AnyFallbackLayoutInUse =>
        _gItemsLayoutSource == GridLayoutSource.Fallback ||
        _gAssembliesLayoutSource == GridLayoutSource.Fallback;

    // Compact human-readable description of what each grid is using right now —
    // shown in the visible badge tooltip and useful when copy-pasting from
    // bug reports.
    private string LayoutSourceSummary =>
        $"gItems: {_gItemsLayoutSource} (key: FEstimateItems.gItems.{CurrentGridInstanceKey}); " +
        $"gAssemblies: {_gAssembliesLayoutSource} (key: FEstimateItems.gAssemblies)";

    // ── Load Combos ───────────────────────────────────────────
    private async Task LoadCommunities()
    {
        try
        {
            // VB6 (FEstimateItems.frm:4846):
            //   SELECT c.Description,c.Area,0 FROM tblLocality c
            //   join divisioncommunities d on c.Area = d.Community
            //   where d.DivisionID = X ORDER BY 1
            var dt = db.SqlExec(
                "SELECT c.Description, c.Area FROM tblLocality c " +
                "JOIN divisioncommunities d ON c.Area = d.Community " +
                "WHERE d.DivisionID = @DivisionID ORDER BY 1",
                new { DivisionID = Session.DivisionID });
            CommunityItems = new();
            foreach (DataRow row in dt.Rows)
            {
                CommunityItems.Add(new ComboItem
                {
                    Text = row["Description"]?.ToString() ?? "",
                    Value = row["Area"]?.ToString() ?? ""
                });
            }
        }
        catch (Exception ex) { _lastError = $"LoadCommunities error: {ex.Message}"; Console.WriteLine(_lastError); }
    }

    private async Task LoadPhases()
    {
        PhaseItems = new();
        if (string.IsNullOrWhiteSpace(JobCommunity)) return;
        try
        {
            var dt = db.SqlExec(
                "SELECT DISTINCT communityphase FROM tblJobs " +
                "WHERE DivisionID = @DivisionID AND community = @Community " +
                "AND ISNULL(communityphase,'') <> '' ORDER BY 1",
                new { DivisionID = Session.DivisionID, Community = JobCommunity });
            foreach (DataRow row in dt.Rows)
            {
                var phase = row["communityphase"]?.ToString() ?? "";
                PhaseItems.Add(new ComboItem { Text = phase, Value = phase });
            }
        }
        catch (Exception ex) { _lastError = $"LoadPhases error: {ex.Message}"; Console.WriteLine(_lastError); }
    }

    private async Task LoadModels()
    {
        try
        {
            // VB6 (frmJob.frx via DistinctModelsByDivision view):
            //   select distinct isnull(model,''),'',0 from tbldbassemblymaster
            //   where DivisionID = X and assemblytype=0
            var dt = db.SqlExec(
                "SELECT DISTINCT ISNULL(model,'') AS model FROM tbldbassemblymaster " +
                "WHERE DivisionID = @DivisionID AND ISNULL(inactive,0)=0 AND assemblytype=0 ORDER BY 1",
                new { DivisionID = Session.DivisionID });
            ModelItems = new();
            foreach (DataRow row in dt.Rows)
            {
                var model = row["model"]?.ToString() ?? "";
                if (!string.IsNullOrEmpty(model))
                    ModelItems.Add(new ComboItem { Text = model, Value = model });
            }
        }
        catch (Exception ex) { _lastError = $"LoadModels error: {ex.Message}"; Console.WriteLine(_lastError); }
    }

    // ── Load Job ──────────────────────────────────────────────
    private async Task LoadJob()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(mJob))
            {
                SetFieldsForNew();
                return;
            }

            // VB6: SELECT j.*, c.ar_customer_deposit ARCustomer, m.Description ModelDesc
            //      FROM tblJobs j
            //      LEFT OUTER JOIN tblCustomers c ON j.Job_No = c.Job_No AND j.DivisionID = c.DivisionID
            //      LEFT OUTER JOIN DistinctModelsByDivision m ON m.Model = j.Model AND m.DivisionID = j.DivisionID
            //      WHERE j.DivisionID = @DivisionID AND j.Job_No = @JobNo
            // (DivisionID filter is REQUIRED — same job number can exist across divisions.)
            var sql = @"
                SELECT j.job_no, j.Notes, j.description, j.gl_prefix,
                       j.community, j.communityphase, j.model, j.lot, j.block, j.lotplan,
                       j.inactive, j.municipal_address, j.city, j.province, j.zip,
                       j.sitephone, j.sitefax
                FROM tblJobs j
                WHERE j.DivisionID = @DivisionID AND j.Job_No = @JobNo";
            var dt = db.SqlExec(sql, new { DivisionID = Session.DivisionID, JobNo = mJob });

            if (dt.Rows.Count > 0)
            {
                var row = dt.Rows[0];
                JobNumber = row["Job_No"]?.ToString() ?? "";
                JobDescription = row["Description"]?.ToString() ?? "";
                JobAddress = row["municipal_address"]?.ToString() ?? "";
                JobCommunity = row["community"]?.ToString() ?? "";
                JobPhase = row["communityphase"]?.ToString() ?? "";
                JobModel = row["model"]?.ToString() ?? "";
                JobNotes = row["Notes"]?.ToString() ?? "";

                FieldsEnabled = true;

                await LoadPhases();
            }
            else
            {
                FieldsEnabled = false;
            }

            // VB6 (FEstimateItems.frm:11421-11427): if a Job has zero EstimateAssemblies
            // we INSERT a placeholder "Manual Estimates" row so the tree always has at
            // least one node — gives the user something to click on instead of an
            // empty pane. Idempotent: the LEFT JOIN guard fires it only once per Job.
            await EnsureManualEstimatesPlaceholder();

            await LoadAssemblies();
            mDirty = false;
        }
        catch (Exception ex)
        {
            _lastError = $"LoadJob error: {ex.Message}";
            Console.WriteLine(_lastError);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void SetFieldsForNew()
    {
        FieldsEnabled = true;
        JobNumber = "";
        JobDescription = "";
        JobAddress = "";
        JobCommunity = "";
        JobPhase = "";
        JobModel = "";
        JobNotes = "";
        AssemblyTreeData = new();
        ItemsData = new();
        SelectedAssemblyId = 0;
        AssemblyOption = "";
        AssemblyCategory = "";
        AssemblyDescription = "";
        AssemblyQuantity = "";
        AssemblyComments = "";
    }

    // ── Manual Estimates placeholder ──────────────────────────────────────
    // VB6 (FEstimateItems.frm:11421-11427) — when a Job has no EstimateAssemblies,
    // create a single placeholder "Manual Estimates" assembly so the Customer-view
    // tree always has at least one node. The LEFT JOIN guard `WHERE a.EstAssemblyID
    // IS NULL` makes this idempotent: it inserts at most one row per (Division,
    // Customer, Job) combination. AssemblyType=-1 is the VB6 magic value for
    // a manual/standalone assembly.
    private async Task EnsureManualEstimatesPlaceholder()
    {
        if (string.IsNullOrWhiteSpace(mJob)) return;

        try
        {
            const string sql = @"
                INSERT INTO EstimateAssemblies(Customer_No, Job, HFDescription, AssemblyType, DivisionID)
                SELECT TOP 1 c.Customer_No, c.Job_No, 'Manual Estimates', -1, c.DivisionID
                  FROM tblCustomers c
                  LEFT OUTER JOIN EstimateAssemblies a
                    ON c.DivisionID = a.DivisionID AND c.Job_No = a.Job
                 WHERE a.EstAssemblyID IS NULL
                   AND c.Job_No     = @JobNo
                   AND c.DivisionID = @DivisionID";
            await db.ExecuteAsync(sql, new { JobNo = mJob, DivisionID = Session.DivisionID });
        }
        catch (Exception ex)
        {
            // Non-fatal — the tree just shows whatever (potentially nothing).
            Console.WriteLine($"EnsureManualEstimatesPlaceholder: {ex.Message}");
        }
    }

    // ── Load Assemblies Tree (multi-level, mirrors VB6 FEstimateItems.frm:9087) ──
    // Replaces the previous flat single-level loader. For each level of
    // CurrentView, runs the VB6 grouping query against the Estimateditems view,
    // building a parent→child hierarchy. Each AssemblyNode carries its
    // accumulated WhereClause so OnAssemblySelected can populate the right
    // grid at ANY level (matches FPriceList's drill behavior).
    private async Task LoadAssemblies()
    {
        AssemblyTreeData = new();
        SelectedAssemblyNode = null;
        // Need EITHER a Job (single-job mode) OR a Community (project-based mode)
        // before we can load anything.
        var hasScope = ProjectBased
            ? !string.IsNullOrWhiteSpace(mCommunity)
            : !string.IsNullOrWhiteSpace(mJob);
        if (!hasScope || mViews.Count == 0)
        {
            StateHasChanged();
            return;
        }

        try
        {
            var view = CurrentView;
            if (view.Levels == 0) return;

            int nextId = 1;
            var rootNode = new AssemblyNode
            {
                NodeID = nextId++,
                ParentID = null,
                Node = ProjectBased
                    ? (string.IsNullOrEmpty(mCommunityDesc) ? mCommunity : mCommunityDesc)
                    : mJob,
                Level = -1,
                EstAssemblyID = 0,
                WhereClause = ""
            };
            AssemblyTreeData.Add(rootNode);

            double rootBudgeted = 0, rootChanges = 0, rootCommitted = 0;

            // Recurse through each level, accumulating WHERE filters.
            await BuildLevel(view, level: 0, parent: rootNode, ctr: () => nextId++, setId: v => nextId = v,
                tally: (b, c, m) => { rootBudgeted += b; rootChanges += c; rootCommitted += m; });

            rootNode.Budgeted = rootBudgeted;
            rootNode.Changes = rootChanges;
            rootNode.Committed = rootCommitted;

            Console.WriteLine($"LoadAssemblies[{view.Name}]: loaded {AssemblyTreeData.Count - 1} nodes for {(ProjectBased ? $"project {mCommunity}" : $"job {mJob}")}");
        }
        catch (Exception ex)
        {
            _lastError = $"LoadAssemblies error: {ex.Message}";
            Console.WriteLine(_lastError);
        }
        finally
        {
            StateHasChanged();
        }
    }

    // Recursive level builder. Mirrors the VB6 inner block of LoadAssemblies
    // (FEstimateItems.frm:9147-9356) — KeyFld/DisplayFld/SortFld are taken
    // from CurrentView, the SELECT aggregates Budgeted/Changes/Committed, and
    // each child node carries " AND <prev> AND KeyFld = '<value>'" in WhereClause.
    private async Task BuildLevel(
        ViewDefinition view, int level, AssemblyNode parent,
        Func<int> ctr, Action<int> setId,
        Action<double, double, double>? tally = null)
    {
        if (level >= view.Levels) return;

        var keyFld = view.Keys.ElementAtOrDefault(level) ?? "";
        var displayFld = view.Displays.ElementAtOrDefault(level) ?? "";
        if (string.IsNullOrWhiteSpace(keyFld) || string.IsNullOrWhiteSpace(displayFld)) return;

        // Build SELECT (mirrors VB6 FEstimateItems.frm:9154-9166 — only the columns
        // we actually consume on the Blazor tree).
        var groupBy = keyFld switch
        {
            "EstAssemblyID" => $"{keyFld},{displayFld},seq",
            "ChangeOrder" => keyFld,
            "POIndex" => "POIndex,POIndexDescription",
            _ => $"{keyFld},{displayFld}"
        };

        // Sort: VB6 honors SortJobAssemblybySeq option; we always sort by display (col 2).
        var orderBy = view.Sorts.ElementAtOrDefault(level) switch
        {
            "ChangeOrder" or "CORSort" => "1",
            "Seq" => "seq",
            _ => "2"
        };

        // Build WHERE — mirrors VB6 LoadAssemblies (FEstimateItems.frm:9175-9187):
        //   ProjectBased   → filter by Community + isquote=0 (every job in the
        //                    chosen Community/Project)
        //   Customer view  → filter by AssemblyJob_No (parent assembly's home job,
        //                    keeps change-orders attached to the original job)
        //   default        → filter by Job_No
        // Levels >0 inherit parent.WhereClause unchanged.
        string whereCore;
        if (string.IsNullOrEmpty(parent.WhereClause))
        {
            if (ProjectBased)
            {
                whereCore = $" AND i.DivisionID = @DivisionID AND isquote = 0 AND Community = @Community";
            }
            else if (CurrentView.Name == "Customer")
            {
                whereCore = $" AND i.DivisionID = @DivisionID AND AssemblyJob_No = @JobNo";
            }
            else
            {
                whereCore = $" AND i.DivisionID = @DivisionID AND Job_No = @JobNo";
            }
        }
        else
        {
            whereCore = $" {parent.WhereClause}";
        }

        var sql = $@"
            SELECT {keyFld} AS KeyValue, {displayFld} AS DisplayValue,
                   SUM(CASE WHEN ISNULL(IsChange,0)=0 AND ISNULL(BudgetDeleted,0)<>1
                            THEN ISNULL(BudgetPretax,0)+ISNULL(BudgetJCTax,0) ELSE 0 END) AS Budgeted,
                   SUM(CASE WHEN ISNULL(IsChange,0)=1 AND ISNULL(BudgetDeleted,0)<>1
                            THEN ISNULL(BudgetPretax,0)+ISNULL(BudgetJCTax,0) ELSE 0 END) AS Changes,
                   SUM(CASE WHEN ISNULL(POGenBatch,0)=0 OR ISNULL(PODeleted,0)=1
                            THEN 0 ELSE ISNULL(POPretax,0)+ISNULL(POJCTax,0) END) AS Committed
              FROM Estimateditems i
             WHERE 1=1{whereCore}
               AND (ISNULL(BudgetDeleted,0)<>1 OR ISNULL(PODeleted,0)<>1)
             GROUP BY {groupBy}
             ORDER BY {orderBy}";

        DataTable dt;
        try
        {
            dt = db.SqlExec(sql, new { DivisionID = Session.DivisionID, JobNo = mJob, Community = mCommunity });
        }
        catch (Exception ex)
        {
            // Most likely cause: a column referenced by KeyFlds/DisplayFlds doesn't
            // exist on this DB's Estimateditems view (e.g. older schema). Skip the
            // level rather than blowing up the whole tree.
            Console.WriteLine($"BuildLevel[{view.Name}/{level}/{keyFld}] failed: {ex.Message}");
            return;
        }

        foreach (DataRow row in dt.Rows)
        {
            var keyValueObj = row["KeyValue"];
            var keyValue = keyValueObj == DBNull.Value ? "" : Convert.ToString(keyValueObj) ?? "";
            var displayRaw = row["DisplayValue"]?.ToString() ?? "";
            var display = string.IsNullOrWhiteSpace(displayRaw) ? " -- " : displayRaw.Trim();

            var budgeted = ToDouble(row["Budgeted"]);
            var changes = ToDouble(row["Changes"]);
            var committed = ToDouble(row["Committed"]);
            tally?.Invoke(budgeted, changes, committed);

            // Accumulate WhereClause for this node (always begins " AND ...").
            // Inlined values (rather than parameters) because the items grid loader
            // re-uses this string as raw SQL with no parameter scope. Every value
            // is SQL-escaped via QuoteForSql / SqlString.
            var quotedValue = QuoteForSql(keyFld, keyValue);
            string thisWhere;
            if (string.IsNullOrEmpty(parent.WhereClause))
            {
                var divIdSql = Session.DivisionID.ToString(CultureInfo.InvariantCulture);
                string scopePredicate;
                if (ProjectBased)
                {
                    scopePredicate = $"AND i.DivisionID = {divIdSql} AND isquote = 0 AND Community = {SqlString(mCommunity)}";
                }
                else if (CurrentView.Name == "Customer")
                {
                    scopePredicate = $"AND i.DivisionID = {divIdSql} AND AssemblyJob_No = {SqlString(mJob)}";
                }
                else
                {
                    scopePredicate = $"AND i.DivisionID = {divIdSql} AND Job_No = {SqlString(mJob)}";
                }
                thisWhere = $"{scopePredicate} AND {keyFld} = {quotedValue}";
            }
            else
            {
                thisWhere = $"{parent.WhereClause} AND {keyFld} = {quotedValue}";
            }

            var node = new AssemblyNode
            {
                NodeID = ctr(),
                ParentID = parent.NodeID,
                Level = level,
                Node = display,
                KeyField = keyFld,
                KeyValue = keyValue,
                DisplayField = displayFld,
                WhereClause = thisWhere,
                Budgeted = budgeted,
                Changes = changes,
                Committed = committed,
                EstAssemblyID = (keyFld == "EstAssemblyID" && long.TryParse(keyValue, out var eid)) ? eid : 0
            };
            AssemblyTreeData.Add(node);

            // Recurse — children inherit parent.WhereClause via thisWhere.
            await BuildLevel(view, level + 1, node, ctr, setId);
        }
    }

    // SQL-escape helper. KeyFld names that VB6 treats numerically
    // (FEstimateItems.frm:9332) get unquoted numeric form; everything else is
    // string-quoted with apostrophe doubling. Booleans/ints fall back to "0" if blank.
    private static string QuoteForSql(string keyFld, string value)
    {
        if (string.Equals(keyFld, "EstAssemblyID", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(keyFld, "EstimateIndex", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(keyFld, "POGroup", StringComparison.OrdinalIgnoreCase))
        {
            // Numeric in VB6's DbQuote(Num, ...). Empty → 0.
            if (string.IsNullOrWhiteSpace(value)) return "0";
            if (long.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var n))
                return n.ToString(CultureInfo.InvariantCulture);
            return SqlString(value);
        }
        return SqlString(value);
    }

    private static string SqlString(string s) => "'" + (s ?? "").Replace("'", "''") + "'";

    // ── Assembly Selection Handler ────────────────────────────
    // VB6 LoadEstItems (FEstimateItems.frm:6877): when ANY tree node is clicked,
    // the right grid is loaded using that node's RowData (the accumulated
    // WhereClause). So clicking a parent-level node populates the grid with all
    // descendants' items — exactly what the user requested.
    private async Task OnAssemblySelected(TreeRowSelectEventArgs<AssemblyNode> args)
    {
        SelectedAssemblyNode = args.Data;
        if (args.Data == null)
        {
            SelectedAssemblyId = 0;
            ClearDetailPanels();
            ItemsData = new();
            StateHasChanged();
            return;
        }

        // Reset every panel's state, then populate the one that matches the
        // selection kind. This avoids stale fields lingering from a previous
        // selection of a different kind.
        ClearDetailPanels();

        // EstAssemblyID leaf — load the rich Asmbly/Extra panel.
        if (args.Data.EstAssemblyID > 0)
        {
            SelectedAssemblyId = args.Data.EstAssemblyID;
            mEstAssemblyID = SelectedAssemblyId;
            await LoadAssemblyDetail(SelectedAssemblyId);
        }
        else
        {
            SelectedAssemblyId = 0;
        }

        // Vendor / PO context — load the PO Header panel.
        if (DetailKindForSelection == SelectionDetailKind.PoHeader)
        {
            await LoadPoHeaderDetail(args.Data);
        }

        // Change Order context (Customer view middle level).
        if (DetailKindForSelection == SelectionDetailKind.ChangeOrder)
        {
            await LoadChangeOrderDetail(args.Data);
        }

        await LoadItemsByWhere(args.Data.WhereClause);
        StateHasChanged();
    }

    // Reset every detail-panel state field to its default. Called whenever the
    // selection changes so a previous EstAssemblyID's Comments / a previous
    // PO's Description / etc. don't leak into the next selection's panel.
    private void ClearDetailPanels()
    {
        AssemblyOption = AssemblyCategory = AssemblyDescription = "";
        AssemblyQuantity = AssemblyComments = AssemblyEstimatorNotes = "";
        AssemblyColor = AssemblyLocation = AssemblyStyle = AssemblyOther = "";
        AssemblyRequestedBy = AssemblyApprovedBy = "";
        AssemblyDateRequested = AssemblyDateApproved = "";
        AssemblySellingPrice = AssemblyBudgetsFinalized = "";

        PoHeaderVendorName = PoHeaderPoIndexLabel = "";
        PoHeaderDescription = PoStandardText = PoShipVia = PoFob = "";
        PoTerms = PoOrderedBy = "";
        PoRetainagePercent = "0";
        PoHideePrice = PoHideQty = PoTotalOnly = false;
        _poHeaderSourcePoNumber = "";

        CoNumber = CoDate = CoApprovedBy = CoDateApproved = CoComments = "";
        mCustomerNo = mChangeOrder = "";
        CoLocked = true;
    }

    // ── View popup state + handlers ───────────────────────────────────────
    // VB6 uses a PopupMenu attached to the View toolbar button (FEstimateItems.frm:5015).
    // We emulate with a button + drop-down panel + click-outside backdrop.
    private bool _viewMenuOpen = false;
    private bool _openMenuOpen = false;

    private void ToggleViewMenu() => _viewMenuOpen = !_viewMenuOpen;
    private void CloseViewMenu() => _viewMenuOpen = false;

    private void ToggleOpenMenu() => _openMenuOpen = !_openMenuOpen;
    private void CloseOpenMenu() => _openMenuOpen = false;

    // Open split-button menu items — VB6 Toolbar.ButtonMenuClick (FEstimateItems.frm:5751).
    private async Task OnOpenJobMenuClick()
    {
        _openMenuOpen = false;
        // VB6 line 5754 — switch back to single-job mode if we were in ProjectBased.
        ProjectBased = false;
        ProjectPhaseBased = false;
        await OnOpenClick();
    }

    private async Task OnOpenProjectMenuClick()
    {
        _openMenuOpen = false;
        await OnOpenProjectClick();
    }

    private async Task SelectView(int idx)
    {
        _viewMenuOpen = false;
        if (idx < 0 || idx >= mViews.Count) return;
        if (idx == mViewIndex) return;
        if (!await SaveData(true)) return;   // VB6 line 4885

        mViewIndex = idx;
        SelectedAssemblyNode = null;
        SelectedAssemblyId = 0;
        ItemsData = new();

        // Bump column-layout versions so GridColumnsBase / TreeGridColumns
        // rebuild their column lists. Without this, the existing column
        // instances retain stale fields/headers across views. (Two version
        // ints bumped together — preserved as the presenters' lockstep bumps.)
        _gItems.BumpVersion();
        _gAssemblies.BumpVersion();

        // Each (mode, view) has its own saved AppGridLayout — reload for the new view.
        await LoadGridLayoutAsync();
        await LoadAssemblies();

        // VB6 (FEstimateItems.frm:4920 LoadAssemblies(True) collapses the tree
        // back to the root on every view switch). Mirror that — tree opens
        // showing only the top-level group nodes.
        if (gAssemblies != null)
            await gAssemblies.CollapseAllAsync();
    }

    // Pseudo-views (Addons / Contract).
    //   "Addons"   → VB6 line 4889 fires `mTimerTask = "ShowJobAddons"` which
    //                opens FJobAddons. We host the migrated FAddons component
    //                in a modal here.
    //   "Contract" → VB6 line 4894 swaps the right pane to frmBilling.
    //                frmBilling has not been migrated yet; show a notification.
    private void SelectPseudoView(string name)
    {
        _viewMenuOpen = false;
        switch (name)
        {
            case "Addons":
                OpenAddonsModal();
                break;
            case "Contract":
                OpenBillingModal();
                break;
            default:
                Notifications.Info($"View '{name}' is not yet implemented in the migrated form.");
                break;
        }
    }

    // Default GroupColumns for the items grid, keyed off the active tree view.
    // Mirrors VB6's visual grouping (the bold "BFW Building" / "BFI Cement
    // Boards" headers in the screenshot are POIndex group headers). For the
    // Customer view we still pre-group by POIndex because that's what the
    // VB6 right pane shows by default — POIndex is the natural visual
    // grouping for items even when the tree is doing the higher-level
    // Customer/CORSort hierarchy. The user can drag column headers to change.
    private List<string> DefaultItemGroupColumns
    {
        get
        {
            if (mViews.Count == 0 || mViewIndex < 0 || mViewIndex >= mViews.Count)
                return new List<string> { "POIndex" };
            var name = mViews[mViewIndex].Name;
            return name switch
            {
                "PO Index" => new List<string> { "POIndex" },
                "PO Group" => new List<string> { "POGroup", "POIndex" },
                // VB6 Cost Code view groups by JCCostCode then JCExtra (the "S"
                // sub-grouping seen in the screenshot — Subcontract, Material, etc.)
                "Cost Code" => new List<string> { "JCCostCode", "JCExtra" },
                // Vendor view groups items by POIndex (vendor is already the tree
                // selection, so the right-pane breaks down by what was ordered).
                "Vendor" => new List<string> { "POIndex" },
                "Customer" => new List<string> { "POIndex" },        // VB6 right pane groups items by POIndex even in Customer view
                "Purchase Orders" => new List<string> { "PONumber" },
                _ => new List<string> { "POIndex" }
            };
        }
    }

    // ── Splitter handlers ─────────────────────────────────────
    // While dragging, a fullscreen overlay (.split-drag-overlay) is rendered
    // and receives pointer events — that's how we keep updating the width even
    // when the cursor leaves the small handle's bounding box.
    private void OnSplitPointerDown(PointerEventArgs e)
    {
        _splitDragging = true;
        _splitStartX = e.ClientX;
        _splitStartWidth = TreePanelWidthPx;
        _splitPointerId = e.PointerId;
    }

    private void OnSplitPointerMove(PointerEventArgs e)
    {
        if (!_splitDragging) return;
        var dx = e.ClientX - _splitStartX;
        var newWidth = _splitStartWidth + dx;
        if (newWidth < MinTreePanelPx) newWidth = MinTreePanelPx;
        if (newWidth > MaxTreePanelPx) newWidth = MaxTreePanelPx;
        TreePanelWidthPx = newWidth;
    }

    private void OnSplitPointerUp(PointerEventArgs e)
    {
        _splitDragging = false;
        _splitPointerId = -1;
    }

    // ── Selection-Detail Dispatcher ───────────────────────────────────────
    // Mirrors VB6 LoadItems (FEstimateItems.frm:6890) where the form's right-side
    // sub-frames toggle visibility based on the selected tree node's KeyField:
    //   frmAssembly  ← KeyField == "EstAssemblyID"
    //   frmPOIndex   ← KeyField in {POIndex, BudgetVendor, POVendor, PONumber, PONumberVendor}
    //   frmChangeOrder ← KeyField in {CORSort, ChangeOrder}
    //   (Cost Code view shows none — the form area is empty.)
    private enum SelectionDetailKind { None, Assembly, PoHeader, ChangeOrder }

    private SelectionDetailKind DetailKindForSelection
    {
        get
        {
            if (SelectedAssemblyNode is null || SelectedAssemblyNode.Level < 0)
                return SelectionDetailKind.None;

            // Cost-code-style views never show a form panel.
            if (string.Equals(CurrentView.Name, "Cost Code", StringComparison.OrdinalIgnoreCase))
                return SelectionDetailKind.None;

            var keyField = SelectedAssemblyNode.KeyField ?? "";

            if (string.Equals(keyField, "EstAssemblyID", StringComparison.OrdinalIgnoreCase))
                return SelectionDetailKind.Assembly;

            if (string.Equals(keyField, "CORSort", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(keyField, "ChangeOrder", StringComparison.OrdinalIgnoreCase))
                return SelectionDetailKind.ChangeOrder;

            // Any vendor / PO-context selection gets the PO Header panel.
            // Same panel shown by VB6 frmPOIndex (FEstimateItems.frm:6691) which
            // becomes visible whenever PONumber or POIndex is non-empty —
            // regardless of how deep the user has drilled. Notably this fires
            // even when the user clicks a POIndex *parent* in PO Group view
            // (before drilling to a vendor below).
            if (keyField.Equals("BudgetVendor",   StringComparison.OrdinalIgnoreCase) ||
                keyField.Equals("POVendor",       StringComparison.OrdinalIgnoreCase) ||
                keyField.Equals("PONumber",       StringComparison.OrdinalIgnoreCase) ||
                keyField.Equals("PONumberVendor", StringComparison.OrdinalIgnoreCase) ||
                keyField.Equals("POIndex",        StringComparison.OrdinalIgnoreCase) ||
                keyField.Equals("POGroup",        StringComparison.OrdinalIgnoreCase))
                return SelectionDetailKind.PoHeader;

            return SelectionDetailKind.None;
        }
    }

