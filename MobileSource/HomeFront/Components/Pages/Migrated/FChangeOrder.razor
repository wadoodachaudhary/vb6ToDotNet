@namespace HomeFront.Components.Pages
@using HomeFront.Data
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@inject DbWrapperSqlServer _db

<DialogControl Visible="@IsVisible"
          Header="Change Order"
          Width="900px"
          Height="520px"
          IsModal="true"
          ShowCloseIcon="true"
          OnClose="Close">
    <ChildContent>
        <div class="co-form">
            <div class="co-row">
                <label>Change Number</label>
                <TextBoxControl @bind-Value="ChangeNumber" Enabled="false" CssClass="co-input" />
                <label>Approved By</label>
                <TextBoxControl @bind-Value="ApprovedBy" Enabled="false" CssClass="co-input" />
            </div>

            <div class="co-row">
                <label>Change Date</label>
                <div class="co-inline">
                    <TextBoxControl @bind-Value="ChangeDate" Enabled="false" CssClass="co-input" />
                    <ButtonControl CssClass="co-browse" Disabled="true">...</ButtonControl>
                </div>
                <label>Approved Date</label>
                <div class="co-inline">
                    <TextBoxControl @bind-Value="ApprovedDate" Enabled="false" CssClass="co-input" />
                    <ButtonControl CssClass="co-browse" Disabled="true">...</ButtonControl>
                </div>
            </div>

            <div class="co-row">
                <label>Comments</label>
                <TextBoxControl @bind-Value="Comments"
                           Multiline="true"
                           Rows="10"
                           Enabled="false"
                           CssClass="co-input co-comments" />
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="Close">Close</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    private bool IsVisible;
    private string mCustomer = "";
    private string mChangeOrder = "";

    private string ChangeNumber = "";
    private string ChangeDate = "";
    private string ApprovedBy = "";
    private string ApprovedDate = "";
    private string Comments = "";

    public async Task Edit(string customer, string changeOrder)
    {
        mCustomer = customer;
        mChangeOrder = changeOrder;
        await LoadData();
        IsVisible = true;
        await InvokeAsync(StateHasChanged);
    }

    public Task<bool> SaveData(bool prompt)
    {
        return Task.FromResult(true);
    }

    private async Task LoadData()
    {
        var sql = @"
            SELECT *
            FROM changeordermaster
            WHERE customer_no = @Customer
              AND change_order_no = @ChangeOrder";

        var rows = await _db.QueryAsync(sql, new { Customer = mCustomer, ChangeOrder = mChangeOrder });
        if (!rows.Any())
        {
            ChangeNumber = "";
            ChangeDate = DateTime.Now.ToString("MMM d, yyyy");
            ApprovedBy = "";
            ApprovedDate = "";
            Comments = "";
        }
        else
        {
            var row = rows[0];
            ChangeNumber = row["change_order_no"]?.ToString() ?? "";
            ChangeDate = FormatDate(row["change_date"]);
            ApprovedBy = row["bldr_approved_by"]?.ToString() ?? "";
            ApprovedDate = FormatDate(row["bldr_approved_date"]);
            Comments = row["comments"]?.ToString() ?? "";
        }
    }

    private static string FormatDate(object? value)
    {
        if (value == null || value == DBNull.Value) return "";
        if (value is DateTime dt) return dt.ToString("MMM d, yyyy");
        if (DateTime.TryParse(value.ToString(), out var parsed)) return parsed.ToString("MMM d, yyyy");
        return value.ToString() ?? "";
    }

    private async Task Close()
    {
        IsVisible = false;
        await InvokeAsync(StateHasChanged);
    }
}