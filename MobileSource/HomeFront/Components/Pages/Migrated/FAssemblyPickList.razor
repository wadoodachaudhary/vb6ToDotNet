```razor
@namespace HomeFront.Components.Pages

@using HomeFront.Components.Grid
@using HomeFront.Data
@using System.Data

@inject IJSRuntime JSRuntime

<style>
    .assembly-picklist-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(0,0,0,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .assembly-picklist-dialog {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.2);
        width: 830px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        font-weight: 600;
        font-size: 16px;
        border-bottom: 1px solid #dee2e6;
        background: #f8f9fa;
    }

    .dialog-header button {
        background: none;
        border: none;
        font-size: 22px;
        cursor: pointer;
        color: #6c757d;
        padding: 0 4px;
    }

    .dialog-header button:hover {
        color: #212529;
    }

    .dialog-body {
        display: flex;
        flex: 1;
        overflow: hidden;
        min-height: 400px;
    }

    .sidebar-panel {
        width: 160px;
        min-width: 140px;
        border-right: 1px solid #dee2e6;
        display: flex;
        flex-direction: column;
        background: #f8f9fa;
        overflow-y: auto;
    }

    .sidebar-panel select {
        margin: 8px;
        padding: 4px 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 12px;
    }

    .sidebar-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 12px 8px;
        border: none;
        background: transparent;
        cursor: pointer;
        font-size: 12px;
        transition: background 0.15s;
        border-bottom: 1px solid #e9ecef;
    }

    .sidebar-btn:hover {
        background: #e9ecef;
    }

    .sidebar-btn.active {
        background: #cce5ff;
        font-weight: 600;
        color: #0d6efd;
    }

    .sidebar-btn img {
        width: 32px;
        height: 32px;
        margin-bottom: 4px;
    }

    .tree-panel {
        flex: 1;
        overflow: auto;
        padding: 4px;
    }

    .dialog-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 12px 20px;
        border-top: 1px solid #dee2e6;
        background: #f8f9fa;
    }

    .dialog-footer .btn {
        padding: 6px 20px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 14px;
    }

    .dialog-footer .btn:hover {
        background: #e9ecef;
    }

    .dialog-footer .btn-primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }

    .dialog-footer .btn-primary:hover {
        background: #0b5ed7;
    }

    .debug-label {
        font-size: 11px;
        color: #6c757d;
        padding: 4px 8px;
        cursor: pointer;
    }

    /* Tree styling */
    .pick-tree ul {
        list-style: none;
        padding-left: 18px;
        margin: 0;
    }

    .pick-tree > ul {
        padding-left: 0;
    }

    .pick-tree li {
        padding: 1px 0;
    }

    .pick-tree .tree-node {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        padding: 3px 6px;
        border-radius: 3px;
        font-size: 13px;
        user-select: none;
    }

    .pick-tree .tree-node:hover {
        background-color: #e8f0fe;
    }

    .pick-tree .tree-node.selected {
        background-color: #cce5ff;
        font-weight: 600;
    }

    .pick-tree .tree-toggle {
        width: 16px;
        text-align: center;
        font-size: 10px;
        color: #666;
        cursor: pointer;
    }

    .pick-tree .tree-icon {
        width: 16px;
        height: 16px;
    }
</style>

@if (IsVisible)
{
    <div class="assembly-picklist-overlay" @onclick="OnCancelClick">
        <div class="assembly-picklist-dialog" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <span>@DialogCaption</span>
                <button @onclick="OnCancelClick">×</button>
            </div>

            <div class="dialog-body">
                <!-- Sidebar -->
                <div class="sidebar-panel">
                    @if (DataSourceEnabled)
                    {
                        <select @bind="SelectedDataSourceIndex" @bind:after="OnDataSourceChanged">
                            @for (int i = 0; i < DataSources.Count; i++)
                            {
                                <option value="@i">@DataSources[i]</option>
                            }
                        </select>
                    }

                    @foreach (var view in AvailableViews)
                    {
                        <button class="sidebar-btn @(view.Index == SelectedViewIndex ? "active" : "")"
                                @onclick="() => OnViewClick(view.Index)">
                            <img src="@view.IconPath" alt="@view.Name" onerror="this.style.display='none'" />
                            <span>@view.Name</span>
                        </button>
                    }
                </div>

                <!-- Tree / Grid area -->
                <div class="tree-panel">
                    <div class="pick-tree">
                        <ul>
                            @foreach (var node in TreeNodes)
                            {
                                @RenderTreeNode(node)
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <div class="dialog-footer">
                @if (ShowDebug)
                {
                    <span class="debug-label" @onclick="OnDebugClick">Debug</span>
                }
                <button class="btn btn-primary" @onclick="OnOpenClick">Open</button>
                <button class="btn" @onclick="OnCancelClick">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    // === Parameters ===
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public string DialogCaption { get; set; } = "Add Items";
    [Parameter] public bool MultiSelect { get; set; } = true;
    [Parameter] public bool GlobalOptions { get; set; } = false;
    [Parameter] public bool ModelsAndOptions { get; set; } = true;
    [Parameter] public bool DCOptions { get; set; } = false;
    [Parameter] public bool DataSourceEnabled { get; set; } = false;
    [Parameter] public int Status { get; set; } = 1; // AssemblyStatuses
    [Parameter] public EventCallback<List<SelectedAssemblyItem>> OnItemsSelected { get; set; }

    // === Enums ===
    public enum AssemblyTypes { atModel = 0, atOption = 1, atGlobal = 2, atDesignCenter = 3 }

    // === Database ===
    private DbWrapperSqlServer db = new();
    private int DivisionID = 1;

    // === State ===
    private bool ShowDebug = false;
    private int SelectedDataSourceIndex = 0;
    private int SelectedViewIndex = -1;
    private List<string> DataSources = new() { "Estimating", "Sales Items" };
    private List<ViewDef> AllViews = new();
    private List<ViewDef> AvailableViews = new();
    private List<PickTreeNode> TreeNodes = new();
    private List<PickTreeNode> SelectedNodes = new();

    // === App Options (simplified — in production these come from HFApp.Options) ===
    private bool ModelByArea = false;
    private bool ModelsByArea_Phase = false;
    private bool OptionByArea = false;
    private bool OptionByAreaPhase = false;
    private bool GlobalOptionByArea = false;
    private bool GlobalOptionByAreaPhase = false;
    private bool DCOptionByArea = false;
    private bool DCOptionByAreaPhase = false;
    private bool UseMajorGroup = false;

    // === Models ===
    public class SelectedAssemblyItem
    {
        public string Community { get; set; } = "";
        public string CommunityPhase { get; set; } = "";
        public string Assembly { get; set; } = "";
        public string Model { get; set; } = "";
        public string OptionID { get; set; } = "";
        public AssemblyTypes AssemblyType { get; set; }
        public int DataSource { get; set; }
    }

    public class ViewDef
    {
        public int Index { get; set; }
        public string Name { get; set; } = "";
        public string IconPath { get; set; } = "";
        public string KeyFields { get; set; } = "";
        public string DisplayFields { get; set; } = "";
        public string LevelIcons { get; set; } = "";
        public string FilterClause { get; set; } = "";
        public AssemblyTypes AssemblyType { get; set; }
    }

    public class PickTreeNode
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string DisplayText { get; set; } = "";
        public string KeyFieldName { get; set; } = "";
        public string KeyValue { get; set; } = "";
        public string WhereClause { get; set; } = "";
        public string IconPath { get; set; } = "";
        public int Level { get; set; }
        public bool Expanded { get; set; }
        public bool IsLoaded { get; set; }
        public bool IsSelected { get; set; }
        public bool IsDummy { get; set; }
        public List<PickTreeNode> Children { get; set; } = new();

        // Data carried for selection
        public string Assembly { get; set; } = "";
        public string Model { get; set; } = "";
        public string OptionID { get; set; } = "";
        public string Community { get; set; } = "";
        public string CommunityPhase { get; set; } = "";
        public string AssemblyTypeValue { get; set; } = "";
    }

    // === Lifecycle ===
    protected override void OnParametersSet()
    {
        if (IsVisible && AllViews.Count == 0)
        {
            LoadViews();
        }
    }

    // === Render tree node recursively ===
    private RenderFragment RenderTreeNode(PickTreeNode node) => __builder =>
    {
        if (node.IsDummy) return;

        <li>
            <span class="tree-node @(node.IsSelected ? "selected" : "")"
                  @onclick="() => OnNodeClick(node)"
                  @ondblclick="() => OnNodeDoubleClick(node)">
                @if (node.Children.Any(c => !c.IsDummy) || (!node.IsLoaded && node.Level < GetMaxLevels()))
                {
                    <span class="tree-toggle" @onclick="() => ToggleNode(node)" @onclick:stopPropagation="true">
                        @(node.Expanded ? "▼" : "▶")
                    </span>
                }
                else
                {
                    <span class="tree-toggle">&nbsp;</span>
                }
                @if (!string.IsNullOrEmpty(node.IconPath))
                {
                    <img class="tree-icon" src="@node.IconPath" alt="" onerror="this.style.display='none'" />
                }
                @node.DisplayText
            </span>
            @if (node.Expanded && node.Children.Any(c => !c.IsDummy))
            {
                <ul>
                    @foreach (var child in node.Children.Where(c => !c.IsDummy))
                    {
                        @RenderTreeNode(child)
                    }
                </ul>
            }
        </li>
    };

    // === View Setup ===
    private void LoadViews()
    {
        AllViews.Clear();
        AvailableViews.Clear();
        int idx = 0;

        // Models and Options view
        var moView = new ViewDef
        {
            Index = idx,
            Name = "Models and Options",
            IconPath = "images/32/model.ico",
            FilterClause = $"AssemblyType IN({(int)AssemblyTypes.atModel},{(int)AssemblyTypes.atOption})",
            AssemblyType = AssemblyTypes.atOption
        };
        moView.KeyFields = BuildKeyFields(ModelByArea, ModelsByArea_Phase, false, "Model,OptionID");
        moView.DisplayFields = BuildDisplayFields(ModelByArea, ModelsByArea_Phase, false,
            "Assembly + '  --  ' + AssemblyDesc,Assembly + '  --  ' + AssemblyDesc");
        moView.LevelIcons = BuildLevelIcons(ModelByArea, ModelsByArea_Phase, false, "model,option");
        AllViews.Add(moView);
        if (ModelsAndOptions) AvailableViews.Add(moView);
        idx++;

        // Global Options view
        var goView = new ViewDef
        {
            Index = idx,
            Name = "Global Options",
            IconPath = "images/32/global.ico",
            FilterClause = $"AssemblyType={(int)AssemblyTypes.atGlobal}",
            AssemblyType = AssemblyTypes.atGlobal
        };
        var goExtra = UseMajorGroup ? ",MajorGroup" : "";
        var goExtraDisplay = UseMajorGroup ? ",MajorGroupDesc" : "";
        var goExtraIcons = UseMajorGroup ? ",groupphase" : "";
        goView.KeyFields = BuildKeyFields(GlobalOptionByArea, GlobalOptionByAreaPhase, false,
            $"{goExtra.TrimStart(',')},Category,OptionID".TrimStart(','));
        goView.DisplayFields = BuildDisplayFields(GlobalOptionByArea, GlobalOptionByAreaPhase, false,
            $"{goExtraDisplay.TrimStart(',')},CategoryDesc,Assembly + '  --  ' + AssemblyDesc".TrimStart(','));
        goView.LevelIcons = BuildLevelIcons(GlobalOptionByArea, GlobalOptionByAreaPhase, false,
            $"{goExtraIcons.TrimStart(',')},phase,option".TrimStart(','));
        AllViews.Add(goView);
        if (GlobalOptions) AvailableViews.Add(goView);
        idx++;

        // Design Center Options view
        var dcView = new ViewDef
        {
            Index = idx,
            Name = "Design Center Options",
            IconPath = "images/32/designcenter.ico",
            FilterClause = $"AssemblyType={(int)AssemblyTypes.atDesignCenter}",
            AssemblyType = AssemblyTypes.atDesignCenter
        };
        var dcExtra = UseMajorGroup ? ",MajorGroup" : "";
        var dcExtraDisplay = UseMajorGroup ? ",MajorGroupDesc" : "";
        var dcExtraIcons = UseMajorGroup ? ",groupphase" : "";
        dcView.KeyFields = BuildKeyFields(DCOptionByArea, DCOptionByAreaPhase, false,
            $"{dcExtra.TrimStart(',')},Category,OptionID".TrimStart(','));
        dcView.DisplayFields = BuildDisplayFields(DCOptionByArea, DCOptionByAreaPhase, false,
            $"{dcExtraDisplay.TrimStart(',')},CategoryDesc,Assembly + '  --  ' + AssemblyDesc".TrimStart(','));
        dcView.LevelIcons = BuildLevelIcons(DCOptionByArea, DCOptionByAreaPhase, false,
            $"{dcExtraIcons.TrimStart(',')},phase,option".TrimStart(','));
        AllViews.Add(dcView);
        if (DCOptions) AvailableViews.Add(dcView);

        // Select first available view
        if (AvailableViews.Count > 0)
        {
            SelectedViewIndex = AvailableViews[0].Index;
            _ = LoadTreeData(true);
        }

        // Restore data source from settings if enabled
        if (!DataSourceEnabled)
            SelectedDataSourceIndex = 0;
    }

    private string BuildKeyFields(bool byArea, bool byAreaPhase, bool dummy, string suffix)
    {
        var parts = new List<string>();
        if (byArea) parts.Add("Community");
        if (byArea && byAreaPhase) parts.Add("CommunityPhase");
        parts.AddRange(suffix.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()));
        return string.Join(",", parts);
    }

    private string BuildDisplayFields(bool byArea, bool byAreaPhase, bool dummy, string suffix)
    {
        var parts = new List<string>();
        if (byArea) parts.Add("Community + '  --  ' + CommunityDesc");
        if (byArea && byAreaPhase) parts.Add("CommunityPhase");
        parts.AddRange(suffix.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()));
        return string.Join(",", parts);
    }

    private string BuildLevelIcons(bool byArea, bool byAreaPhase, bool dummy, string suffix)
    {
        var parts = new List<string>();
        if (byArea) parts.Add("area");
        if (byArea && byAreaPhase) parts.Add("category");
        parts.AddRange(suffix.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()));
        return string.Join(",", parts);
    }

    private ViewDef? GetCurrentView()
    {
        return AllViews.FirstOrDefault(v => v.Index == SelectedViewIndex);
    }

    private int GetMaxLevels()
    {
        var view = GetCurrentView();
        if (view == null) return 0;
        return view.DisplayFields.Split(',').Length;
    }

    private string GetIconPath(string iconName)
    {
        return $"images/16/{iconName}.ico";
    }

    // === Data Loading ===
    private async Task LoadTreeData(bool clearTree)
    {
        var view = GetCurrentView();
        if (view == null) return;

        if (clearTree)
        {
            TreeNodes.Clear();
            SelectedNodes.Clear();
        }

        await LoadChildNodes(null, view, -1, "");
        StateHasChanged();
    }

    private async Task LoadChildNodes(PickTreeNode? parentNode, ViewDef view, int parentLevel, string parentWhereClause)
    {
        var keyFields = view.KeyFields.Split(',').Select(s => s.Trim()).ToArray();
        var displayFields = view.DisplayFields.Split(',').Select(s => s.Trim()).ToArray();
        var levelIcons = view.LevelIcons.Split(',').Select(s => s.Trim()).ToArray();
        var maxLevels = displayFields.Length;
        var level = parentLevel + 1;

        if (level >= maxLevels) return;

        var keyField = keyFields[level];
        var displayField = displayFields[level];
        var iconName = level < levelIcons.Length ? levelIcons[level] : "";

        var tableName = SelectedDataSourceIndex == 0 ? "AssemblyList" : "SalesAssemblyList";
        var whereClause = string.IsNullOrEmpty(parentWhereClause)
            ? view.FilterClause
            : parentWhereClause.TrimStart().StartsWith("AND ", StringComparison.OrdinalIgnoreCase)
                ? parentWhereClause.Substring(4).Trim()
                : parentWhereClause;

        // For Models and Options view, filter by assembly type at model/option level
        var extraFilter = "";
        if (view.Name == "Models and Options")
        {
            if (keyField == "Model") extraFilter = $" AND AssemblyType={(int)AssemblyTypes.atModel}";
            if (keyField == "OptionID") extraFilter = $" AND AssemblyType={(int)AssemblyTypes.atOption}";
        }

        var sql = $@"SELECT DISTINCT {keyField}, {displayField} AS DisplayValue
                     FROM {tableName}
                     WHERE {whereClause}{extraFilter}
                       AND Status <= {Status}
                     ORDER BY 2";

        try
        {
            var rows = await db.QueryAsync(sql);
            var targetList = parentNode?.Children ?? TreeNodes;

            // Remove dummy children if present
            targetList.RemoveAll(c => c.IsDummy);

            foreach (var row in rows)
            {
                var keyValue = row[keyField]?.ToString() ?? "";
                var displayValue = (row["DisplayValue"]?.ToString() ?? "").Trim();

                var node = new PickTreeNode
                {
                    DisplayText = displayValue,
                    KeyFieldName = keyField,
                    KeyValue = keyValue,
                    Level = level,
                    IconPath = GetIconPath(iconName),
                    IsLoaded = level + 1 >= maxLevels // leaf nodes are fully loaded
                };

                // Build where clause for children
                var nodeWhere = string.IsNullOrEmpty(parentWhereClause)
                    ? $" AND {view.FilterClause} AND {keyField} = '{EscapeSql(keyValue)}'"
                    : $"{parentWhereClause} AND {keyField} = '{EscapeSql(keyValue)}'";
                node.WhereClause = nodeWhere;

                // Propagate parent data
                if (parentNode != null)
                {
                    node.Community = parentNode.Community;
                    node.CommunityPhase = parentNode.CommunityPhase;
                    node.Model = parentNode.Model;
                    node.OptionID = parentNode.OptionID;
                    node.Assembly = parentNode.Assembly;
                }

                // Set field-specific data
                switch (keyField)
                {
                    case "Community":
                        node.Community = keyValue;
                        break;
                    case "CommunityPhase":
                        node.CommunityPhase = keyValue;
                        break;
                    case "Model":
                        node.Model = keyValue;
                        node.Assembly = ParseAssemblyFromDisplay(displayValue);
                        node.AssemblyTypeValue = ((int)AssemblyTypes.atModel).ToString();
                        break;
                    case "OptionID":
                        node.OptionID = keyValue;
                        node.Assembly = ParseAssemblyFromDisplay(displayValue);
                        node.AssemblyTypeValue = ((int)view.AssemblyType).ToString();
                        break;
                    case "Category":
                    case "MajorGroup":
                        break;
                }

                // Add dummy child if not a leaf so it can be expanded
                if (level + 1 < maxLevels)
                {
                    node.Children.Add(new PickTreeNode { IsDummy = true });
                }

                targetList.Add(node);
            }

            if (parentNode != null)
                parentNode.IsLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FAssemblyPickList.LoadChildNodes] Error: {ex.Message}");
        }
    }

    private string ParseAssemblyFromDisplay(string displayValue)
    {
        if (string.IsNullOrEmpty(displayValue)) return "";
        var idx = displayValue.IndexOf("  --  ");
        return idx >= 0 ? displayValue.Substring(0, idx).Trim() : displayValue.Trim();
    }

    private string EscapeSql(string value)
    {
        return value.Replace("'", "''");
    }

    // === Tree Interaction ===
    private async Task ToggleNode(PickTreeNode node)
    {
        if (node.Expanded)
        {
            node.Expanded = false;
        }
        else
        {
            if (!node.IsLoaded)
            {
                var view = GetCurrentView();
                if (view != null)
                {
                    await LoadChildNodes(node, view, node.Level, node.WhereClause);
                }
            }
            node.Expanded = true;
        }
        StateHasChanged();
    }

    private void OnNodeClick(PickTreeNode node)
    {
        if (MultiSelect)
        {
            node.IsSelected = !node.IsSelected;
            if (node.IsSelected)
            {
                if (!SelectedNodes.Contains(node))
                    SelectedNodes.Add(node);
            }
            else
            {
                SelectedNodes.Remove(node);
            }
        }
        else
        {
            foreach (var n in SelectedNodes)
                n.IsSelected = false;
            SelectedNodes.Clear();
            node.IsSelected = true;
            SelectedNodes.Add(node);
        }
        StateHasChanged();
    }

    private async Task OnNodeDoubleClick(PickTreeNode node)
    {
        // If it has children, toggle expand
        if (node.Children.Any(c => !c.IsDummy) || !node.IsLoaded)
        {
            await ToggleNode(node);
        }
        else
        {
            // Leaf node — select and confirm
            if (!node.IsSelected)
                OnNodeClick(node);
            await OnOpenClick();
        }
    }

    // === View / DataSource Changes ===
    private async Task OnViewClick(int viewIndex)
    {
        SelectedViewIndex = viewIndex;
        await LoadTreeData(true);
    }

    private async Task OnDataSourceChanged()
    {
        await LoadTreeData(true);
    }

    // === Dialog Actions ===
    private async Task OnOpenClick()
    {
        var view = GetCurrentView();
        if (view == null) return;

        // Collect selected items that have an Assembly value
        var selectedItems = new List<SelectedAssemblyItem>();

        foreach (var node in SelectedNodes)
        {
            if (string.IsNullOrEmpty(node.Assembly)) continue;

            var assemblyType = view.AssemblyType;
            if (!string.IsNullOrEmpty(node.AssemblyTypeValue) &&
                int.TryParse(node.AssemblyTypeValue, out var atVal))
            {
                assemblyType = (AssemblyTypes)atVal;
            }

            // Determine community based on assembly type and options
            var community = "";
            switch (assemblyType)
            {
                case AssemblyTypes.atModel when ModelByArea:
                case AssemblyTypes.atOption when OptionByArea:
                case AssemblyTypes.atGlobal when GlobalOptionByArea:
                case AssemblyTypes.atDesignCenter when DCOptionByArea:
                    community = node.Community;
                    break;
            }

            // Determine phase based on assembly type and options
            var communityPhase = "";
            switch (assemblyType)
            {
                case AssemblyTypes.atModel when ModelByArea && ModelsByArea_Phase:
                case AssemblyTypes.atOption when OptionByArea && OptionByAreaPhase:
                case AssemblyTypes.atGlobal when GlobalOptionByArea && GlobalOptionByAreaPhase:
                case AssemblyTypes.atDesignCenter when DCOptionByArea && DCOptionByAreaPhase:
                    communityPhase = node.CommunityPhase;
                    break;
            }

            selectedItems.Add(new SelectedAssemblyItem
            {
                Community = community,
                CommunityPhase = communityPhase,
                Assembly = node.Assembly,
                Model = node.Model,
                OptionID = node.OptionID,
                AssemblyType = assemblyType,
                DataSource = SelectedDataSourceIndex
            });
        }

        if (selectedItems.Count > 0)
        {
            await OnItemsSelected.InvokeAsync(selectedItems);
            await Close();
        }
    }

    private async Task OnCancelClick()
    {
        await Close();
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private void OnDebugClick()
    {
        // Show all columns / debug info — toggle debug mode
        ShowDebug = !ShowDebug;
        StateHasChanged();
    }

    // === Public API ===

    /// <summary>
    /// Opens the pick list dialog. Returns true if items were selected.
    /// Call this from a parent component, then handle OnItemsSelected callback.
    /// </summary>
    public async Task Open(string caption = "Add Items", bool multiSelect = true,
        bool globalOptions = false, bool modelsAndOptions = true,
        bool dcOptions = false, bool dataSource = false, int status = 1)
    {
        DialogCaption = caption;
        MultiSelect = multiSelect;
        GlobalOptions = globalOptions;
        ModelsAndOptions = modelsAndOptions;
        DCOptions = dcOptions;
        DataSourceEnabled = dataSource;
        Status = status;

        AllViews.Clear();
        AvailableViews.Clear();
        TreeNodes.Clear();
        SelectedNodes.Clear();
        SelectedViewIndex = -1;

        IsVisible = true;
        await IsVisibleChanged.InvokeAsync(true);

        LoadViews();
        StateHasChanged();
    }

    public int SelectedItemCount => SelectedNodes.Count(n => !string.IsNullOrEmpty(n.Assembly));
}
```