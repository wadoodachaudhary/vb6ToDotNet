@namespace HomeFront.Components.Pages

@using Fx.ControlKit.Notifications

@if (IsVisible)
{
    <div class="fprogress-overlay">
        <div class="fprogress-panel">
            <div class="fprogress-title">@Title</div>
            <div class="fprogress-label1">@Caption</div>
            <div class="fprogress-label2">@(Count == 0 ? "" : $"row {Row} of {Count}")</div>
            <div class="fprogress-bar-container">
                <div class="fprogress-bar-fill" style="width: @(ProgressPercent)%;"></div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Whether the progress dialog is visible.
    /// </summary>
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>
    /// The title displayed at the top of the progress dialog.
    /// </summary>
    [Parameter] public string Title { get; set; } = "Processing...";

    /// <summary>
    /// The caption / description label (Label1 in VB6).
    /// </summary>
    [Parameter] public string Caption { get; set; } = "";

    /// <summary>
    /// The current row being processed.
    /// </summary>
    [Parameter] public long Row { get; set; }

    /// <summary>
    /// The total number of rows to process.
    /// </summary>
    [Parameter] public long Count { get; set; }

    /// <summary>
    /// Event callback when visibility changes (two-way binding support).
    /// </summary>
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>
    /// Calculated progress percentage (0–100).
    /// </summary>
    private double ProgressPercent =>
        Count == 0 ? 0 : Math.Min(100, Math.Max(0, (double)Row / Count * 100));

    /// <summary>
    /// Call this method from a parent component to update progress and re-render.
    /// Mirrors the VB6 FProgress.Progress() public sub.
    /// </summary>
    public async Task UpdateProgressAsync(
        string? title = null,
        string? caption = null,
        long? row = null,
        long? count = null)
    {
        if (!string.IsNullOrEmpty(title))
            Title = title;

        if (!string.IsNullOrEmpty(caption))
            Caption = caption;

        if (row.HasValue)
            Row = row.Value;

        if (count.HasValue)
            Count = count.Value;

        if (!IsVisible)
        {
            IsVisible = true;
            if (IsVisibleChanged.HasDelegate)
                await IsVisibleChanged.InvokeAsync(true);
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Hides the progress dialog.
    /// </summary>
    public async Task HideAsync()
    {
        IsVisible = false;
        if (IsVisibleChanged.HasDelegate)
            await IsVisibleChanged.InvokeAsync(false);

        await InvokeAsync(StateHasChanged);
    }
}
