@namespace HomeFront.Components.Pages

@using System
@using System.Collections.Generic
@using System.IO
@using System.Linq
@using System.Security.Cryptography
@using System.Text
@using Fx.ControlKit.Notifications
@using HomeFront.Data
@inject DbWrapperSqlServer db

@code {
    // === Public Properties ===
    public string ClientID { get; set; } = "";
    public string CompanyName { get; set; } = "";
    public bool Leased { get; set; } = false;
    public DateTime LeaseExpiryDate { get; set; } = DateTime.MinValue;

    // === Private Fields ===
    private string mSerialNumber = "";
    private ModuleType[] mModules = new ModuleType[19]; // 1-based indexing, index 0 unused

    // === Module Type ===
    private class ModuleType
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Program { get; set; } = "";
        public long Seats { get; set; } = 0;
        public bool Demo { get; set; } = false;
        public string CountType { get; set; } = "";
        public DateTime DemoExpiry { get; set; } = DateTime.MinValue;
    }

    // === Database ===
// === Constructor / Initialization ===
    protected override void OnInitialized()
    {
        for (int j = 0; j < mModules.Length; j++)
            mModules[j] = new ModuleType();

        int i = 0;

        // Do not change the order of these 6... you will break old license files
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "hfsales";         mModules[i].Name = "Profit Builder    "; mModules[i].Program = "'Sales'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "hfest";           mModules[i].Name = "Precision Builder "; mModules[i].Program = "'Precision Builder'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "hfsched";         mModules[i].Name = "Project Builder   "; mModules[i].Program = "'Project Editor'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "hfwarranty";      mModules[i].Name = "Quality Builder   "; mModules[i].Program = "'Quality Builder'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "hfpayables";      mModules[i].Name = "Payables Desk     "; mModules[i].Program = "'HomeFront Payables'";
        i++; mModules[i].CountType = "loginame";    mModules[i].Code = "JobSimplicity";   mModules[i].Name = "Job Simplicity    "; mModules[i].Program = "'Sales','Precision Builder','Project Editor','Quality Builder','Payables Desk'";

        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "hfsalesmgmt";     mModules[i].Name = "Sales Management  "; mModules[i].Program = "'Sales Management'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "hfstaging";       mModules[i].Name = "Data Staging      "; mModules[i].Program = "'HomeFront Data Staging'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "hfdataconnector"; mModules[i].Name = "Data Connector    "; mModules[i].Program = "'HomeFront Data Connector'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "workflowbuilder"; mModules[i].Name = "Workflow Builder  "; mModules[i].Program = "'AutoNotice'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "CommandCenter";   mModules[i].Name = "Command Center    "; mModules[i].Program = "'Command Center'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "Workticket";      mModules[i].Name = "Workticket        "; mModules[i].Program = "'Workticket'";

        // Web apps
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "FieldPO";         mModules[i].Name = "Field Purchasing  "; mModules[i].Program = "'zyberNothing'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "FieldSched";      mModules[i].Name = "Field Scheduling  "; mModules[i].Program = "'zyberNothing'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "CustomPortal";    mModules[i].Name = "Customer Portal   "; mModules[i].Program = "'zyberNothing'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "VendorPortal";    mModules[i].Name = "Vendor Portal     "; mModules[i].Program = "'zyberNothing'";
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "CRM";             mModules[i].Name = "Homefront CRM     "; mModules[i].Program = "'zyberNothing'";

        // Utility apps
        i++; mModules[i].CountType = "hostprocess"; mModules[i].Code = "UNSECUREDAPP";    mModules[i].Name = "Unsecured App     "; mModules[i].Program = "'zyberNothing'";
    }

    // === Properties ===
    public int Modules => mModules.Length - 1; // 18 (1-based)

    public int GetModuleIndex(string code)
    {
        for (int i = 1; i <= Modules; i++)
        {
            if (string.Equals(code, mModules[i].Code, StringComparison.OrdinalIgnoreCase))
                return i;
        }
        return 0;
    }

    public string GetModuleCode(int index) => mModules[index].Code;
    public void SetModuleCode(int index, string value) => mModules[index].Code = value;

    public string GetModuleName(int index) => mModules[index].Name;
    public void SetModuleName(int index, string value) => mModules[index].Name = value;

    public bool GetModuleDemo(int index) => mModules[index].Demo;
    public void SetModuleDemo(int index, bool value) => mModules[index].Demo = value;

    public DateTime GetModuleDemoExpiry(int index) => mModules[index].DemoExpiry;
    public void SetModuleDemoExpiry(int index, DateTime value) => mModules[index].DemoExpiry = value;

    public long GetModuleSeats(int index) => mModules[index].Seats;
    public void SetModuleSeats(int index, long value) => mModules[index].Seats = value;

    public long GetModuleSeatsInUse(int index, ref string errors)
    {
        try
        {
            var s = "SELECT has_perms_by_name(null,null,'view server state')";
            var dt = db.SqlExec(s);
            var val = dt.Rows.Count > 0 ? Convert.ToInt32(dt.Rows[0][0]) : 0;

            if (val != 1)
            {
                // User doesn't have view server state so they can't see sysprocesses
                errors = "nsf";
                return GetModuleSeats(index);
            }

            switch (mModules[index].CountType)
            {
                case "hostprocess":
                    s = "SELECT COUNT(DISTINCT hostprocess)\r\n" +
                        "  FROM master.dbo.sysprocesses\r\n" +
                        " WHERE hostprocess<>host_id()\r\n" +
                        $"   AND program_name IN({mModules[index].Program})";
                    break;
                default: // "loginame" - Job Simplicity license
                    s = "SELECT COUNT(DISTINCT ISNULL(loginame,''))\r\n" +
                        "  FROM master.dbo.sysprocesses\r\n" +
                        " WHERE loginame<>SYSTEM_USER\r\n" +
                        $"   AND program_name IN({mModules[index].Program})";
                    break;
            }

            var resultDt = db.SqlExec(s);
            return resultDt.Rows.Count > 0 ? Convert.ToInt64(resultDt.Rows[0][0]) : 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ModuleSeatsInUse error: {ex.Message}");

            return 0;
        }
    }

    public string SerialNumber => mSerialNumber;

    public string LicenseText
    {
        get
        {
            var sb = new StringBuilder();
            sb.AppendLine("[Licensed To]");
            sb.AppendLine($"  Client ID     = {ClientID}");
            sb.AppendLine($"  Company       = {CompanyName}");
            if (Leased)
                sb.AppendLine($"  Lease Expiry  = {LeaseExpiryDate:MMM d, yyyy}");
            sb.AppendLine($"  Serial Number = {CreateSerialNumber()}");
            sb.AppendLine();
            sb.AppendLine("[Licensed Modules]");
            for (int i = 1; i <= Modules; i++)
            {
                if (mModules[i].Demo)
                    sb.AppendLine($"  {mModules[i].Name} = Evaluation period expires {mModules[i].DemoExpiry:MMM d, yyyy}");
                else if (mModules[i].Seats > 0)
                    sb.AppendLine($"  {mModules[i].Name} = {mModules[i].Seats}");
            }
            return sb.ToString();
        }
    }

    private string UsageMode => Leased ? "Leased" : "Licensed";

    // === Serial Number Generation ===
    private string CreateSerialNumber()
    {
        var sb = new StringBuilder();
        sb.Append(ClientID);
        sb.Append('\x01');
        sb.Append(CompanyName);
        sb.Append('\x01');
        sb.Append(UsageMode);
        sb.Append('\x01');
        sb.Append(LeaseExpiryDate.ToString("MMM d, yyyy"));
        sb.Append('\x01');

        for (int i = 1; i <= Modules; i++)
        {
            if (mModules[i].Code != "UNSECUREDAPP")
            {
                if (mModules[i].Demo)
                {
                    sb.Append($"Evaluation period expires {mModules[i].DemoExpiry:MMM d, yyyy}\r\n");
                }
                else
                {
                    if (mModules[i].Seats > 0 || i < 6)
                    {
                        sb.Append(mModules[i].Seats);
                        sb.Append('\x01');
                    }
                }
            }
        }

        var hash = CreateHash(sb.ToString().ToUpper());
        return FormatAsGuid(hash);
    }

    private string CreateHash(string input)
    {
        using var md5 = MD5.Create();
        var bytes = Encoding.UTF8.GetBytes(input);
        var hashBytes = md5.ComputeHash(bytes);
        return BitConverter.ToString(hashBytes).Replace("-", "");
    }

    private string FormatAsGuid(string hash)
    {
        // Pad or truncate to 32 characters
        hash = hash.PadRight(32, '0');
        if (hash.Length > 32) hash = hash[..32];
        return $"{hash[..8]}-{hash[8..12]}-{hash[12..16]}-{hash[16..20]}-{hash[20..32]}";
    }

    // === License File I/O ===
    public void WriteLicense(string filename)
    {
        File.WriteAllText(filename, LicenseText);
    }

    public bool ReadLicense(string filename)
    {
        try
        {
            ClientID = IniGet(filename, "Licensed To", "Client ID");
            CompanyName = IniGet(filename, "Licensed To", "Company");
            mSerialNumber = IniGet(filename, "Licensed To", "Serial Number");
            var s = IniGet(filename, "Licensed To", "Lease Expiry");

            if (string.IsNullOrEmpty(s))
            {
                Leased = false;
                LeaseExpiryDate = DateTime.MinValue;
            }
            else
            {
                Leased = true;
                LeaseExpiryDate = DateTime.Parse(s);
            }

            for (int i = 1; i <= Modules; i++)
            {
                s = IniGet(filename, "Licensed Modules", mModules[i].Name);

                if (!string.IsNullOrEmpty(s) && s.Length >= 10 && s[..10] == "Evaluation")
                {
                    mModules[i].Seats = 999999999;
                    mModules[i].Demo = true;
                    mModules[i].DemoExpiry = DateTime.Parse(s[26..]);
                }
                else if (!string.IsNullOrEmpty(s) && double.TryParse(s, out var numVal))
                {
                    mModules[i].Seats = (long)numVal;
                    mModules[i].Demo = false;
                    mModules[i].DemoExpiry = DateTime.MinValue;
                }
                else if (mModules[i].Code == "UNSECUREDAPP")
                {
                    mModules[i].Seats = 999999999;
                    mModules[i].Demo = false;
                    mModules[i].DemoExpiry = DateTime.MinValue;
                }
                else
                {
                    mModules[i].Seats = 0;
                    mModules[i].Demo = false;
                    mModules[i].DemoExpiry = DateTime.MinValue;
                }
            }

            if (mSerialNumber == CreateSerialNumber())
            {
                return true;
            }
            else
            {
                // Invalid serial — clear everything
                ClientID = "";
                CompanyName = "";
                mSerialNumber = "";
                Leased = false;
                for (int i = 1; i <= Modules; i++)
                {
                    mModules[i].Seats = 0;
                    mModules[i].Demo = false;
                    mModules[i].DemoExpiry = DateTime.MinValue;
                }
                return false;
            }
        }
        catch
        {
            return false;
        }
    }

    // === INI File Reader ===
    /// <summary>
    /// Reads a value from an INI-style text file.
    /// </summary>
    private string IniGet(string filename, string section, string key)
    {
        if (!File.Exists(filename))
            return "";

        var lines = File.ReadAllLines(filename);
        bool inSection = false;
        var sectionHeader = $"[{section}]";
        var trimmedKey = key.Trim();

        foreach (var rawLine in lines)
        {
            var line = rawLine.Trim();

            if (line.StartsWith("[") && line.EndsWith("]"))
            {
                inSection = string.Equals(line, sectionHeader, StringComparison.OrdinalIgnoreCase);
                continue;
            }

            if (inSection)
            {
                var eqIndex = line.IndexOf('=');
                if (eqIndex > 0)
                {
                    var lineKey = line[..eqIndex].Trim();
                    var lineValue = line[(eqIndex + 1)..].Trim();

                    if (string.Equals(lineKey, trimmedKey, StringComparison.OrdinalIgnoreCase))
                        return lineValue;
                }
            }
        }

        return "";
    }
}
