@page "/takeoff-settings"
@page "/takeoff-settings/{Job}"
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FTakeoffSettings> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>Takeoff Settings - HomeFront</PageTitle>

<div class="takeoff-settings-container">
    <h4 style="margin-bottom: 16px;">Takeoff Settings</h4>

    <div class="grid-container" @onkeydown="OnGridKeyDown" tabindex="0">
        <GridControl @ref="SettingsGrid"
                TValue="TakeoffSettingRow"
                DataSource="@GridData"
                AllowSelection="true"
                AllowResizing="true"
                EnableHover="true"
                Height="400px"
                EditSettingsRef="@editSettings"
                SelectionSettingsRef="@selectionSettings">
            <GridColumnsBase>
                <GridColumn Field="@nameof(TakeoffSettingRow.RowIndex)" HeaderText="" Width="1px" Visible="false" IsPrimaryKey="true" />
                <GridColumn Field="@nameof(TakeoffSettingRow.Label)" HeaderText="Setting" Width="200px" AllowEditing="false" />
                <GridColumn Field="@nameof(TakeoffSettingRow.Value)" HeaderText="Value" Width="250px" AllowEditing="true">
                    <EditTemplate>
                        @{
                            var data = (TakeoffSettingRow)context;
                            var comboItems = GetComboSelectListForRow(data.RowIndex);
                            if (comboItems != null && comboItems.Count > 0)
                            {
                                <DropDownListControl TValue="string" TItem="string"
                                                     @bind-Value="data.Value"
                                                     DataSource="@comboItems"
                                                     Placeholder="-- Select --"
                                                     Width="100%"
                                                     CssClass="ts-edit-control" />
                            }
                            else
                            {
                                <TextBoxControl @bind-Value="data.Value"
                                                MaxLength="50"
                                                CssClass="ts-edit-control" />
                            }
                        }
                    </EditTemplate>
                </GridColumn>
            </GridColumnsBase>
        </GridControl>
    </div>

    <div class="button-row">
        <ButtonControl BareStyle="true" CssClass="btn-action primary" OnClick="OnOkClick">OK</ButtonControl>
        <ButtonControl BareStyle="true" CssClass="btn-action" OnClick="OnCancelClick">Cancel</ButtonControl>
    </div>
</div>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    [Parameter] public string? Job { get; set; }

    // Database
// Grid
    private GridControl<TakeoffSettingRow>? SettingsGrid;
    private List<TakeoffSettingRow> GridData = new();

    // Grid settings
    private SelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };
    private EditSettings editSettings = new()
    {
        AllowEditing = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };

    // State
    private string mJob = "";
    private string mSettings = "";
    private string mResultSettings = "";
    private List<string> WBSDescriptions = new();
    private Dictionary<int, List<string>> ComboListCache = new();

    // Callback for modal-like behavior
    [Parameter] public string? InitialSettings { get; set; }
    [Parameter] public EventCallback<string?> OnSettingsResult { get; set; }

    protected override async Task OnInitializedAsync()
    {
        mJob = Job ?? "";
        mSettings = InitialSettings ?? "";
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        GridData.Clear();
        WBSDescriptions.Clear();
        ComboListCache.Clear();

        // Load WBS descriptions from tbljobs
        try
        {
            var sql = "SELECT * FROM tbljobs WHERE DivisionID = @DivisionID AND job_no = @Job";
            var dt = db.SqlExec(sql, new { SessionState.DivisionID, Job = mJob });

            if (dt.Rows.Count > 0)
            {
                var row = dt.Rows[0];
                for (int i = 1; i <= 40; i++)
                {
                    var colName = $"WBSDesc{i:D2}";
                    var desc = "";
                    if (dt.Columns.Contains(colName))
                        desc = row[colName]?.ToString() ?? "";
                    WBSDescriptions.Add(desc);
                }
            }
            else
            {
                for (int i = 1; i <= 40; i++)
                    WBSDescriptions.Add("");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadDataAsync error loading WBS");

            for (int i = 1; i <= 40; i++)
                WBSDescriptions.Add("");
        }

        // Row 1 = Location
        var locationLabel = "Location";
        var locationValue = ParseField(mSettings, 1);
        GridData.Add(new TakeoffSettingRow
        {
            RowIndex = 1,
            Label = locationLabel,
            Value = locationValue,
            IsVisible = true
        });

        // Rows 2-41 = WBS01 through WBS40
        for (int i = 1; i <= 40; i++)
        {
            var wbsDesc = WBSDescriptions[i - 1];
            var isVisible = !string.IsNullOrWhiteSpace(wbsDesc);
            var value = ParseField(mSettings, i + 1);

            GridData.Add(new TakeoffSettingRow
            {
                RowIndex = i + 1,
                Label = wbsDesc,
                Value = value,
                IsVisible = isVisible
            });
        }

        // Filter to only visible rows
        GridData = GridData.Where(r => r.IsVisible).ToList();

        // Pre-load combo lists
        await PreloadComboListsAsync();
    }

    private async Task PreloadComboListsAsync()
    {
        try
        {
            // Location combo list (row index 1)
            var locationList = await LoadComboListFromDbAsync("Location");
            ComboListCache[1] = locationList;

            // WBS combo lists (row index 2-41)
            for (int i = 1; i <= 40; i++)
            {
                var fieldName = $"WBS{i:D2}";
                var list = await LoadComboListFromDbAsync(fieldName);
                ComboListCache[i + 1] = list;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PreloadComboListsAsync error");

        }
    }

    private async Task<List<string>> LoadComboListFromDbAsync(string fieldName)
    {
        var result = new List<string>();
        try
        {
            var sql = $"SELECT DISTINCT [{fieldName}] FROM estimateitems WHERE job = @Job ORDER BY 1";
            var rows = await db.QueryAsync(sql, new { Job = mJob });

            foreach (var row in rows)
            {
                var val = row.Values.FirstOrDefault()?.ToString()?.Trim() ?? "";
                if (!string.IsNullOrWhiteSpace(val))
                    result.Add(val);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "GetComboList error for {fieldName}");

        }
        return result;
    }

    private List<string> GetComboListForRow(int rowIndex)
    {
        if (ComboListCache.TryGetValue(rowIndex, out var list))
            return list;
        return new List<string>();
    }

    // DropDownListControl variant of GetComboListForRow: when the row has combo
    // values, prepend a blank entry so the user can re-select "blank" from the
    // list (the old <select> had an explicit <option value="">-- Select --</option>;
    // DropDownListControl shows "-- Select --" as a placeholder for the blank value).
    // Returns the list only when there are real options, so the EditTemplate's
    // "comboItems.Count > 0" gate (combo vs. text box) behaves exactly as before.
    private List<string> GetComboSelectListForRow(int rowIndex)
    {
        var list = GetComboListForRow(rowIndex);
        if (list == null || list.Count == 0)
            return new List<string>();

        var withBlank = new List<string> { "" };
        withBlank.AddRange(list);
        return withBlank;
    }

    // VB6: gData_KeyDown — Delete key clears the selected cell value
    private void OnGridKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Delete" && SettingsGrid != null)
        {
            var selected = SettingsGrid.GetSelectedRecords();
            if (selected != null)
            {
                foreach (var row in selected)
                {
                    row.Value = "";
                }
                StateHasChanged();
            }
        }
    }

    private async Task OnOkClick()
    {
        SaveData();
        if (OnSettingsResult.HasDelegate)
            await OnSettingsResult.InvokeAsync(mResultSettings);
        else
            ClosePage();
    }

    private async Task OnCancelClick()
    {
        mResultSettings = "";
        if (OnSettingsResult.HasDelegate)
            await OnSettingsResult.InvokeAsync(null);
        else
            ClosePage();
    }

    private void SaveData()
    {
        // Rebuild the settings string from all 41 rows (including hidden ones)
        var allValues = new string[41];
        for (int i = 0; i < 41; i++)
            allValues[i] = "";

        foreach (var row in GridData)
        {
            if (row.RowIndex >= 1 && row.RowIndex <= 41)
                allValues[row.RowIndex - 1] = row.Value ?? "";
        }

        mResultSettings = string.Join("\x01", allValues);

        // If all empty, return empty string
        var cleaned = mResultSettings.Replace("\x01", "").Trim();
        if (string.IsNullOrWhiteSpace(cleaned))
            mResultSettings = "";
    }

    /// <summary>
    /// Parses a Chr(1)-delimited string and returns the field at the given 1-based index.
    /// Equivalent to VB6: Parse(mSettings, i, Chr(1))
    /// </summary>
    private string ParseField(string settings, int index)
    {
        if (string.IsNullOrEmpty(settings))
            return "";

        var parts = settings.Split('\x01');
        if (index >= 1 && index <= parts.Length)
            return parts[index - 1];

        return "";
    }

    // === Public method for programmatic use (mirrors VB6 GetSettings) ===
    public async Task<string> GetSettingsAsync(string job, string settings)
    {
        mJob = job;
        mSettings = settings;
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
        // In Blazor, modal behavior is handled differently.
        // The caller should await OnSettingsResult callback.
        return mResultSettings;
    }

    // === Model ===
    public class TakeoffSettingRow
    {
        public int RowIndex { get; set; }
        public string Label { get; set; } = "";
        public string Value { get; set; } = "";
        public bool IsVisible { get; set; } = true;
    }
}
