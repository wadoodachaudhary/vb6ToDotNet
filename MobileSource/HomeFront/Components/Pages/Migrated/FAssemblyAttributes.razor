```razor
@namespace HomeFront.Components.Pages

@using System.Data
@using HomeFront.Data

@inject IJSRuntime JSRuntime

<style>
    .attributes-dialog {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 16px;
        background: #fff;
        box-shadow: 0 2px 12px rgba(0,0,0,0.15);
        max-width: 520px;
        font-family: 'MS Sans Serif', Arial, sans-serif;
        font-size: 13px;
    }
    .attributes-dialog h4 {
        margin: 0 0 12px 0;
        font-size: 14px;
        font-weight: 700;
    }
    .attr-header {
        display: grid;
        grid-template-columns: 60px 1fr 30px 1fr;
        gap: 6px;
        align-items: center;
        margin-bottom: 6px;
    }
    .attr-header span {
        font-weight: 700;
        font-size: 12px;
    }
    .attr-row {
        display: grid;
        grid-template-columns: 60px 1fr 30px 1fr;
        gap: 6px;
        align-items: center;
        margin-bottom: 4px;
    }
    .attr-row label {
        text-align: right;
        font-size: 12px;
        padding-right: 4px;
    }
    .attr-row select, .attr-row input {
        width: 100%;
        padding: 3px 6px;
        border: 1px solid #ced4da;
        border-radius: 3px;
        font-size: 12px;
        box-sizing: border-box;
    }
    .attr-row select:focus, .attr-row input:focus {
        border-color: #86b7fe;
        outline: 0;
        box-shadow: 0 0 0 2px rgba(13,110,253,0.15);
    }
    .attr-list-btn {
        width: 24px;
        height: 24px;
        padding: 0;
        border: 1px solid #ced4da;
        border-radius: 3px;
        background: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }
    .attr-list-btn:hover {
        background: #e9ecef;
    }
    .attr-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 14px;
        padding-top: 10px;
        border-top: 1px solid #dee2e6;
    }
    .attr-footer button {
        padding: 5px 18px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 13px;
    }
    .attr-footer button:hover {
        background: #e9ecef;
    }
    .attr-footer button.btn-primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }
    .attr-footer button.btn-primary:hover {
        background: #0b5ed7;
    }
    .dialog-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(0,0,0,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@if (IsVisible)
{
    <div class="dialog-overlay" @onclick="OnCancel">
        <div class="attributes-dialog" @onclick:stopPropagation="true">
            <h4>Attributes</h4>

            <!-- Header Row -->
            <div class="attr-header">
                <span></span>
                <span>Attribute List</span>
                <span></span>
                <span>Default Value</span>
            </div>

            <!-- Color Row -->
            <div class="attr-row">
                <label>@ColorLabel</label>
                <select @bind="SelectedListId_0" @bind:after="() => OnListChanged(0)">
                    <option value="-1">-- Select --</option>
                    @foreach (var item in AttributeLists)
                    {
                        <option value="@item.ListId">@item.Name</option>
                    }
                </select>
                <button class="attr-list-btn" @onclick="() => OnEditListClick(0)" title="Edit Attribute Lists">📋</button>
                <select @bind="SelectedValue_0">
                    <option value="">-- Select --</option>
                    @foreach (var val in ValueList_0)
                    {
                        <option value="@val">@val</option>
                    }
                </select>
            </div>

            <!-- Style Row -->
            <div class="attr-row">
                <label>Style</label>
                <select @bind="SelectedListId_1" @bind:after="() => OnListChanged(1)">
                    <option value="-1">-- Select --</option>
                    @foreach (var item in AttributeLists)
                    {
                        <option value="@item.ListId">@item.Name</option>
                    }
                </select>
                <button class="attr-list-btn" @onclick="() => OnEditListClick(1)" title="Edit Attribute Lists">📋</button>
                <select @bind="SelectedValue_1">
                    <option value="">-- Select --</option>
                    @foreach (var val in ValueList_1)
                    {
                        <option value="@val">@val</option>
                    }
                </select>
            </div>

            <!-- Finish Row -->
            <div class="attr-row">
                <label>Finish</label>
                <select @bind="SelectedListId_2" @bind:after="() => OnListChanged(2)">
                    <option value="-1">-- Select --</option>
                    @foreach (var item in AttributeLists)
                    {
                        <option value="@item.ListId">@item.Name</option>
                    }
                </select>
                <button class="attr-list-btn" @onclick="() => OnEditListClick(2)" title="Edit Attribute Lists">📋</button>
                <select @bind="SelectedValue_2">
                    <option value="">-- Select --</option>
                    @foreach (var val in ValueList_2)
                    {
                        <option value="@val">@val</option>
                    }
                </select>
            </div>

            <!-- Other Row -->
            <div class="attr-row">
                <label>Other</label>
                <select @bind="SelectedListId_3" @bind:after="() => OnListChanged(3)">
                    <option value="-1">-- Select --</option>
                    @foreach (var item in AttributeLists)
                    {
                        <option value="@item.ListId">@item.Name</option>
                    }
                </select>
                <button class="attr-list-btn" @onclick="() => OnEditListClick(3)" title="Edit Attribute Lists">📋</button>
                <select @bind="SelectedValue_3">
                    <option value="">-- Select --</option>
                    @foreach (var val in ValueList_3)
                    {
                        <option value="@val">@val</option>
                    }
                </select>
            </div>

            <!-- Footer -->
            <div class="attr-footer">
                <button class="btn-primary" @onclick="OnOk">OK</button>
                <button @onclick="OnCancel">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    // === Parameters ===
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>Attribute list IDs for Color, Style, Finish, Other (indices 0–3)</summary>
    [Parameter] public long[] ListIds { get; set; } = new long[] { -1, -1, -1, -1 };

    /// <summary>Attribute values for Color, Style, Finish, Other (indices 0–3)</summary>
    [Parameter] public string[] AttributeValues { get; set; } = new string[] { "", "", "", "" };

    /// <summary>Fired when the user clicks OK, returning the updated ListIds and AttributeValues.</summary>
    [Parameter] public EventCallback<AssemblyAttributesResult> OnAttributesSaved { get; set; }

    /// <summary>Custom label for the Color row (loaded from custom descriptions).</summary>
    [Parameter] public string ColorLabel { get; set; } = "Color";

    // === Database ===
    private DbWrapperSqlServer db = new();

    // === Data ===
    private List<AttributeListItem> AttributeLists = new();

    // Per-row selected list IDs
    private long SelectedListId_0 { get; set; } = -1;
    private long SelectedListId_1 { get; set; } = -1;
    private long SelectedListId_2 { get; set; } = -1;
    private long SelectedListId_3 { get; set; } = -1;

    // Per-row selected values
    private string SelectedValue_0 { get; set; } = "";
    private string SelectedValue_1 { get; set; } = "";
    private string SelectedValue_2 { get; set; } = "";
    private string SelectedValue_3 { get; set; } = "";

    // Per-row value lists
    private List<string> ValueList_0 = new();
    private List<string> ValueList_1 = new();
    private List<string> ValueList_2 = new();
    private List<string> ValueList_3 = new();

    // === Lifecycle ===
    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            await LoadAttributeLists();
            await LoadCustomDescriptions();

            // Initialize selected list IDs from parameters
            SelectedListId_0 = ListIds.Length > 0 ? ListIds[0] : -1;
            SelectedListId_1 = ListIds.Length > 1 ? ListIds[1] : -1;
            SelectedListId_2 = ListIds.Length > 2 ? ListIds[2] : -1;
            SelectedListId_3 = ListIds.Length > 3 ? ListIds[3] : -1;

            // Load value lists for each selected attribute list
            await OnListChanged(0);
            await OnListChanged(1);
            await OnListChanged(2);
            await OnListChanged(3);

            // Set initial values from parameters
            SelectedValue_0 = AttributeValues.Length > 0 ? AttributeValues[0] : "";
            SelectedValue_1 = AttributeValues.Length > 1 ? AttributeValues[1] : "";
            SelectedValue_2 = AttributeValues.Length > 2 ? AttributeValues[2] : "";
            SelectedValue_3 = AttributeValues.Length > 3 ? AttributeValues[3] : "";
        }
    }

    // === Data Loading ===
    private async Task LoadAttributeLists()
    {
        try
        {
            var sql = "SELECT name, listid FROM attributelists WHERE ISNULL(inactive, 0) = 0 ORDER BY name";
            var rows = await db.QueryAsync(sql);
            AttributeLists = rows.Select(r => new AttributeListItem
            {
                Name = r["name"]?.ToString() ?? "",
                ListId = Convert.ToInt64(r["listid"] ?? -1)
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadAttributeLists error: {ex.Message}");
            AttributeLists = new();
        }
    }

    private async Task LoadValueList(int index, long listId)
    {
        var values = new List<string>();
        if (listId > 0)
        {
            try
            {
                var sql = "SELECT value FROM attributelistvalues WHERE listid = @ListId ORDER BY sortorder";
                var rows = await db.QueryAsync(sql, new { ListId = listId });
                values = rows.Select(r => r["value"]?.ToString() ?? "").ToList();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"LoadValueList error for index {index}: {ex.Message}");
            }
        }

        switch (index)
        {
            case 0: ValueList_0 = values; break;
            case 1: ValueList_1 = values; break;
            case 2: ValueList_2 = values; break;
            case 3: ValueList_3 = values; break;
        }
    }

    private async Task LoadCustomDescriptions()
    {
        try
        {
            var label = await db.ExecuteScalarAsync<string>(
                "SELECT ISNULL(NULLIF(custom_description,''),'Color') FROM customdescriptions WHERE item='Color'");
            if (!string.IsNullOrEmpty(label))
                ColorLabel = label;
        }
        catch
        {
            // Use default
        }
    }

    // === Event Handlers ===
    private async Task OnListChanged(int index)
    {
        var listId = index switch
        {
            0 => SelectedListId_0,
            1 => SelectedListId_1,
            2 => SelectedListId_2,
            3 => SelectedListId_3,
            _ => -1L
        };

        await LoadValueList(index, listId);

        // Clear the value when the list changes
        switch (index)
        {
            case 0: SelectedValue_0 = ""; break;
            case 1: SelectedValue_1 = ""; break;
            case 2: SelectedValue_2 = ""; break;
            case 3: SelectedValue_3 = ""; break;
        }
    }

    private async Task OnEditListClick(int index)
    {
        var listId = index switch
        {
            0 => SelectedListId_0,
            1 => SelectedListId_1,
            2 => SelectedListId_2,
            3 => SelectedListId_3,
            _ => -1L
        };

        await JSRuntime.InvokeVoidAsync("alert", $"Edit Attribute Lists (ListId: {listId}) - not yet implemented");

        // Reload all attribute lists and value lists after editing
        await LoadAttributeLists();
        for (int i = 0; i < 4; i++)
        {
            var currentListId = i switch
            {
                0 => SelectedListId_0,
                1 => SelectedListId_1,
                2 => SelectedListId_2,
                3 => SelectedListId_3,
                _ => -1L
            };
            await LoadValueList(i, currentListId);
        }
    }

    private async Task OnOk()
    {
        var result = new AssemblyAttributesResult
        {
            ListIds = new long[] { SelectedListId_0, SelectedListId_1, SelectedListId_2, SelectedListId_3 },
            AttributeValues = new string[] { SelectedValue_0, SelectedValue_1, SelectedValue_2, SelectedValue_3 }
        };

        if (OnAttributesSaved.HasDelegate)
            await OnAttributesSaved.InvokeAsync(result);

        IsVisible = false;
        if (IsVisibleChanged.HasDelegate)
            await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task OnCancel()
    {
        IsVisible = false;
        if (IsVisibleChanged.HasDelegate)
            await IsVisibleChanged.InvokeAsync(false);
    }

    // === Models ===
    public class AttributeListItem
    {
        public string Name { get; set; } = "";
        public long ListId { get; set; }
    }

    public class AssemblyAttributesResult
    {
        /// <summary>List IDs for Color, Style, Finish, Other</summary>
        public long[] ListIds { get; set; } = new long[4];

        /// <summary>Selected values for Color, Style, Finish, Other</summary>
        public string[] AttributeValues { get; set; } = new string[4];
    }
}
