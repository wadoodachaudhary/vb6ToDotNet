@namespace HomeFront.Components.Pages

@using System.Data
@using HomeFront.Data
@using Fx.ControlKit
@using Fx.ControlKit.Notifications

@inject IJSRuntime JSRuntime
@inject ILogger<FAssemblyAttributes> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer db

<DialogControl Visible="@IsVisible"
               Header="Attributes"
               Width="520px"
               IsModal="true"
               ShowCloseIcon="true"
               OnClose="OnCancel">
    <ChildContent>
        <div class="attributes-dialog">
            <!-- Header Row -->
            <div class="attr-header">
                <span></span>
                <span>Attribute List</span>
                <span></span>
                <span>Default Value</span>
            </div>

            <!-- Color Row -->
            <div class="attr-row">
                <label>@ColorLabel</label>
                <DropDownListControl TValue="long" TItem="AttributeListItem"
                                     DataSource="@ListOptions"
                                     ValueFieldName="ListId" TextFieldName="Name"
                                     @bind-Value="SelectedListId_0"
                                     @bind-Value:after="() => OnListChanged(0)"
                                     Width="100%" CssClass="attr-select" />
                <ButtonControl CssClass="attr-list-btn" Title="Edit Attribute Lists" OnClick="() => OnEditListClick(0)">📋</ButtonControl>
                <DropDownListControl TValue="string" TItem="ValueOption"
                                     DataSource="@GetValueOptions(0)"
                                     ValueFieldName="Value" TextFieldName="Text"
                                     @bind-Value="SelectedValue_0"
                                     Width="100%" CssClass="attr-select" />
            </div>

            <!-- Style Row -->
            <div class="attr-row">
                <label>Style</label>
                <DropDownListControl TValue="long" TItem="AttributeListItem"
                                     DataSource="@ListOptions"
                                     ValueFieldName="ListId" TextFieldName="Name"
                                     @bind-Value="SelectedListId_1"
                                     @bind-Value:after="() => OnListChanged(1)"
                                     Width="100%" CssClass="attr-select" />
                <ButtonControl CssClass="attr-list-btn" Title="Edit Attribute Lists" OnClick="() => OnEditListClick(1)">📋</ButtonControl>
                <DropDownListControl TValue="string" TItem="ValueOption"
                                     DataSource="@GetValueOptions(1)"
                                     ValueFieldName="Value" TextFieldName="Text"
                                     @bind-Value="SelectedValue_1"
                                     Width="100%" CssClass="attr-select" />
            </div>

            <!-- Finish Row -->
            <div class="attr-row">
                <label>Finish</label>
                <DropDownListControl TValue="long" TItem="AttributeListItem"
                                     DataSource="@ListOptions"
                                     ValueFieldName="ListId" TextFieldName="Name"
                                     @bind-Value="SelectedListId_2"
                                     @bind-Value:after="() => OnListChanged(2)"
                                     Width="100%" CssClass="attr-select" />
                <ButtonControl CssClass="attr-list-btn" Title="Edit Attribute Lists" OnClick="() => OnEditListClick(2)">📋</ButtonControl>
                <DropDownListControl TValue="string" TItem="ValueOption"
                                     DataSource="@GetValueOptions(2)"
                                     ValueFieldName="Value" TextFieldName="Text"
                                     @bind-Value="SelectedValue_2"
                                     Width="100%" CssClass="attr-select" />
            </div>

            <!-- Other Row -->
            <div class="attr-row">
                <label>Other</label>
                <DropDownListControl TValue="long" TItem="AttributeListItem"
                                     DataSource="@ListOptions"
                                     ValueFieldName="ListId" TextFieldName="Name"
                                     @bind-Value="SelectedListId_3"
                                     @bind-Value:after="() => OnListChanged(3)"
                                     Width="100%" CssClass="attr-select" />
                <ButtonControl CssClass="attr-list-btn" Title="Edit Attribute Lists" OnClick="() => OnEditListClick(3)">📋</ButtonControl>
                <DropDownListControl TValue="string" TItem="ValueOption"
                                     DataSource="@GetValueOptions(3)"
                                     ValueFieldName="Value" TextFieldName="Text"
                                     @bind-Value="SelectedValue_3"
                                     Width="100%" CssClass="attr-select" />
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="OnOk">OK</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnCancel">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@* VB6 cmdList_Click → HFApp.RunTask("EditAttributeLists|" & X) opens
   FAttributeLists modally over FAssemblyAttributes. We render that
   editor as an inline child component; flipping _showEditor on/off
   replaces the navigation step. After save, ReloadAllListsAfterEdit
   re-pulls attribute lists + values just like VB6 lines 295-302. *@
<FAttributeLists IsVisible="_showEditor"
                 IsVisibleChanged="@((bool v) => { _showEditor = v; StateHasChanged(); })"
                 InitialListId="_editorInitialListId"
                 Embedded="true"
                 OnSaved="ReloadAllListsAfterEdit" />

@code {
    // === Parameters ===
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>Attribute list IDs for Color, Style, Finish, Other (indices 0–3)</summary>
    [Parameter] public long[] ListIds { get; set; } = new long[] { -1, -1, -1, -1 };

    /// <summary>Attribute values for Color, Style, Finish, Other (indices 0–3)</summary>
    [Parameter] public string[] AttributeValues { get; set; } = new string[] { "", "", "", "" };

    /// <summary>Fired when the user clicks OK, returning the updated ListIds and AttributeValues.</summary>
    [Parameter] public EventCallback<AssemblyAttributesResult> OnAttributesSaved { get; set; }

    /// <summary>Custom label for the Color row (loaded from custom descriptions).</summary>
    [Parameter] public string ColorLabel { get; set; } = "Color";

    // === Database ===
// === Data ===
    private List<AttributeListItem> AttributeLists = new();

    // Per-row selected list IDs
    private long SelectedListId_0 { get; set; } = -1;
    private long SelectedListId_1 { get; set; } = -1;
    private long SelectedListId_2 { get; set; } = -1;
    private long SelectedListId_3 { get; set; } = -1;

    // Per-row selected values
    private string SelectedValue_0 { get; set; } = "";
    private string SelectedValue_1 { get; set; } = "";
    private string SelectedValue_2 { get; set; } = "";
    private string SelectedValue_3 { get; set; } = "";

    // Per-row value lists
    private List<string> ValueList_0 = new();
    private List<string> ValueList_1 = new();
    private List<string> ValueList_2 = new();
    private List<string> ValueList_3 = new();

    // === Dropdown data shaping (FlexKit DropDownListControl needs a DataSource
    //     incl. the "-- Select --" sentinel that the old <option> markup hard-coded) ===

    /// <summary>Attribute-list options for the list selectors, with the
    /// VB6 "-- Select --" sentinel (ListId = -1) prepended.</summary>
    private IEnumerable<AttributeListItem> ListOptions =>
        new[] { new AttributeListItem { Name = "-- Select --", ListId = -1 } }
            .Concat(AttributeLists);

    /// <summary>Value options for a given row's default-value selector, with the
    /// "-- Select --" sentinel (empty string) prepended.</summary>
    private IEnumerable<ValueOption> GetValueOptions(int index)
    {
        var values = index switch
        {
            0 => ValueList_0,
            1 => ValueList_1,
            2 => ValueList_2,
            3 => ValueList_3,
            _ => new List<string>()
        };
        yield return new ValueOption { Value = "", Text = "-- Select --" };
        foreach (var v in values)
            yield return new ValueOption { Value = v, Text = v };
    }

    // === Lifecycle ===
    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            await LoadAttributeLists();
            await LoadCustomDescriptions();

            // Initialize selected list IDs from parameters
            SelectedListId_0 = ListIds.Length > 0 ? ListIds[0] : -1;
            SelectedListId_1 = ListIds.Length > 1 ? ListIds[1] : -1;
            SelectedListId_2 = ListIds.Length > 2 ? ListIds[2] : -1;
            SelectedListId_3 = ListIds.Length > 3 ? ListIds[3] : -1;

            // Load value lists for each selected attribute list
            await OnListChanged(0);
            await OnListChanged(1);
            await OnListChanged(2);
            await OnListChanged(3);

            // Set initial values from parameters
            SelectedValue_0 = AttributeValues.Length > 0 ? AttributeValues[0] : "";
            SelectedValue_1 = AttributeValues.Length > 1 ? AttributeValues[1] : "";
            SelectedValue_2 = AttributeValues.Length > 2 ? AttributeValues[2] : "";
            SelectedValue_3 = AttributeValues.Length > 3 ? AttributeValues[3] : "";
        }
    }

    // === Data Loading ===
    private async Task LoadAttributeLists()
    {
        try
        {
            var sql = "SELECT name, listid FROM attributelists WHERE ISNULL(inactive, 0) = 0 ORDER BY name";
            var rows = await db.QueryAsync(sql);
            AttributeLists = rows.Select(r => new AttributeListItem
            {
                Name = r["name"]?.ToString() ?? "",
                ListId = Convert.ToInt64(r["listid"] ?? -1)
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadAttributeLists error");

            AttributeLists = new();
        }
    }

    private async Task LoadValueList(int index, long listId)
    {
        var values = new List<string>();
        if (listId > 0)
        {
            try
            {
                var sql = "SELECT value FROM attributelistvalues WHERE listid = @ListId AND ISNULL(inactive,0)=0 ORDER BY sortorder";
                var rows = await db.QueryAsync(sql, new { ListId = listId });
                values = rows.Select(r => r["value"]?.ToString() ?? "").ToList();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "LoadValueList error for index {index}");

            }
        }

        switch (index)
        {
            case 0: ValueList_0 = values; break;
            case 1: ValueList_1 = values; break;
            case 2: ValueList_2 = values; break;
            case 3: ValueList_3 = values; break;
        }
    }

    private async Task LoadCustomDescriptions()
    {
        try
        {
            var label = await db.ExecuteScalarAsync<string>(
                "SELECT ISNULL(NULLIF(custom_description,''),'Color') FROM customdescriptions WHERE item='Color'");
            if (!string.IsNullOrEmpty(label))
                ColorLabel = label;
        }
        catch
        {
            // Use default
        }
    }

    // === Event Handlers ===
    private async Task OnListChanged(int index)
    {
        var listId = index switch
        {
            0 => SelectedListId_0,
            1 => SelectedListId_1,
            2 => SelectedListId_2,
            3 => SelectedListId_3,
            _ => -1L
        };

        await LoadValueList(index, listId);

        // Clear the value when the list changes
        switch (index)
        {
            case 0: SelectedValue_0 = ""; break;
            case 1: SelectedValue_1 = ""; break;
            case 2: SelectedValue_2 = ""; break;
            case 3: SelectedValue_3 = ""; break;
        }
    }

    // ── Attribute-list editor (FAttributeLists) ─────────────────────
    // VB6 cmdList_Click in FAssemblyAttributes.frm:285 packages the
    // currently-selected list ID and dispatches RunTask("EditAttributeLists|X").
    // We show the FAttributeLists modal inline instead, pass the same
    // list id so it scrolls to the right row, and reload our combo
    // boxes when it raises OnSaved.
    private bool _showEditor;
    private long _editorInitialListId = -1;

    private void OnEditListClick(int index)
    {
        _editorInitialListId = index switch
        {
            0 => SelectedListId_0,
            1 => SelectedListId_1,
            2 => SelectedListId_2,
            3 => SelectedListId_3,
            _ => -1L
        };
        _showEditor = true;
    }

    private async Task ReloadAllListsAfterEdit()
    {
        // VB6 lines 295-302 — after RunTask returns, refresh each combo
        // box from attributelists, restore the previously-selected list
        // id, then re-run cboList_Click to repopulate the value list.
        // The currently-displayed value text is preserved unless the
        // list itself was deleted.
        await LoadAttributeLists();
        for (int i = 0; i < 4; i++)
        {
            var currentListId = i switch
            {
                0 => SelectedListId_0,
                1 => SelectedListId_1,
                2 => SelectedListId_2,
                3 => SelectedListId_3,
                _ => -1L
            };
            await LoadValueList(i, currentListId);
        }
        StateHasChanged();
    }

    private async Task OnOk()
    {
        var result = new AssemblyAttributesResult
        {
            ListIds = new long[] { SelectedListId_0, SelectedListId_1, SelectedListId_2, SelectedListId_3 },
            AttributeValues = new string[] { SelectedValue_0, SelectedValue_1, SelectedValue_2, SelectedValue_3 }
        };

        if (OnAttributesSaved.HasDelegate)
            await OnAttributesSaved.InvokeAsync(result);

        IsVisible = false;
        if (IsVisibleChanged.HasDelegate)
            await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task OnCancel()
    {
        IsVisible = false;
        if (IsVisibleChanged.HasDelegate)
            await IsVisibleChanged.InvokeAsync(false);
    }

    // === Models ===
    public class AttributeListItem
    {
        public string Name { get; set; } = "";
        public long ListId { get; set; }
    }

    public class ValueOption
    {
        public string Value { get; set; } = "";
        public string Text { get; set; } = "";
    }

    public class AssemblyAttributesResult
    {
        /// <summary>List IDs for Color, Style, Finish, Other</summary>
        public long[] ListIds { get; set; } = new long[4];

        /// <summary>Selected values for Color, Style, Finish, Other</summary>
        public string[] AttributeValues { get; set; } = new string[4];
    }
}
