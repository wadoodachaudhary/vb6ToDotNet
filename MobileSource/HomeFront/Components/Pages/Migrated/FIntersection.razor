@page "/option-intersections"
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using HomeFront.Models
@using HomeFront.Data
@using System.Data
@using Microsoft.Data.SqlClient
@using Fx.ControlKit.Notifications

@inject NavigationManager NavigationManager
@inject IDialogService Dialogs
@inject ILogger<FIntersection> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject IUserPreferencesService Prefs
@inject DbWrapperSqlServer db

<PageTitle>Option Intersections - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading...</div>
    </div>
}

@* ── TOOLBAR ─────────────────────────────────────────── *@
<div class="toolbar-cntr">
    <button class="tbar-btn" disabled="@(!mDirty)" @onclick="OnSaveClick">
        <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
        <span class="tool-label">Save</span>
    </button>
    <button class="tbar-btn" disabled="@(!CanDelete)" @onclick="OnDeleteClick">
        <img src="images/32/delete.ico" alt="Delete" onerror="this.style.display='none'" />
        <span class="tool-label">Delete</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" disabled="@(mIntersectID == 0)" @onclick="OnAddAssemblyClick">
        <img src="images/32/Add.ico" alt="Add" onerror="this.style.display='none'" />
        <span class="tool-label">Add</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" disabled="@(mAssemblyID == 0)" @onclick="OnTakeoffItemClick">
        <img src="images/32/TakeoffItem.ico" alt="Item" onerror="this.style.display='none'" />
        <span class="tool-label">Item</span>
    </button>
    <button class="tbar-btn" disabled="@(mAssemblyID == 0)" @onclick="OnTakeoffAssemblyClick">
        <img src="images/32/TakeoffAssembly.ico" alt="Assembly" onerror="this.style.display='none'" />
        <span class="tool-label">Assembly</span>
    </button>
</div>


@* ── MAIN LAYOUT ─────────────────────────────────────── *@
<div class="main-layout" @onmousemove="OnSplitterDrag" @onmouseup="EndSplitterDrag" @onmouseleave="EndSplitterDrag">
    @* ── LEFT PANEL: Intersections List ──────────────── *@
    <div class="left-panel" style="width:@(LeftPanelWidthPx)px;">
        @* Standard FlexKit GridControl for VB6 gIntersections. The grid owns the
           editable cell and trailing blank-row behavior; the wrapper only catches
           Delete/Ctrl+Delete like the old list did. *@
        <div class="intersections-grid-wrap" tabindex="0"
             @onkeydown="OnIntersectionsKeyDown"
             @oncontextmenu:preventDefault="true">
            <GridControl @ref="IntersectionsGrid"
                         TValue="IntersectionItem"
                         DataSource="@IntersectionsList"
                         AllowSorting="true"
                         AllowResizing="true"
                         AllowSelection="true"
                         EnableHover="true"
                         Height="100%"
                         WidthMode="GridWidthMode.FillAvailable"
                         RowHeight="22"
                         MinRowHeight="22"
                         HighlightSelectedRows="false"
                         AvailableColumns="@IntersectionsChooseColumns"
                         SelectionSettingsRef="@intersectionSelectionSettings"
                         EditSettingsRef="@intersectionEditSettings"
                         NewItemFactory="CreateIntersectionRowFromGrid"
                         EnsureTrailingNewRow="true"
                         IsTrailingNewRow="IsIntersectionTrailingNewRow"
                         AddNewRowOnLastCellExit="true"
                         CanAddNewRowOnLastCellExit="CanAppendIntersectionNewRowAfter"
                         BatchEditBehavior="GridBatchEditBehavior.SingleCell"
                         EventsRef="@intersectionGridEvents">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(IntersectionItem.IntersectID)" Visible="false" IsPrimaryKey="true" AllowEditing="false" />
                    <GridColumn Field="@nameof(IntersectionItem.IsNewRow)" Visible="false" AllowEditing="false" />
                    <GridColumn Field="@nameof(IntersectionItem.Description)"
                                HeaderText="Intersection Description"
                                Width="100%"
                                AllowEditing="true"
                                ClipMode="ClipMode.Ellipsis" />
                </GridColumnsBase>
            </GridControl>
        </div>
    </div>

    @* ── VERTICAL SPLITTER (between Left and Right Panels) ── *@
    <div class="v-splitter @(_vSplitterDragging ? "dragging" : "")"
         @onmousedown="StartVSplitterDrag" @onmousedown:preventDefault="true"></div>

    @* ── RIGHT PANEL ─────────────────────────────────── *@
    <div class="right-panel">
        @* ── ASSEMBLIES GRID ─────────────────────────── *@
        @* HHM-580: keydown bubbles from the focused grid cell to this wrapper
           (FItems/FDimensionCategories pattern) — VB6 gAssemblies_KeyDown
           (FIntersection.frm:493) deletes the selected assembly on
           Delete + any modifier.
           REOPEN: unlike the editable Items grid, this read-only grid never
           mounts an in-cell editor, so nothing inside it reliably holds focus
           when the keystroke arrives. tabindex makes the panel itself
           focusable (a click on any child focuses it) so Ctrl+Delete always
           reaches OnAssembliesGridKeyDown. *@
        <div class="assemblies-panel" tabindex="0" @onkeydown="OnAssembliesGridKeyDown" style="height:@(AssembliesPanelHeightPx)px; flex: 0 0 auto;">
            <div class="section-header">Assemblies</div>
            <GridControl @ref="AssembliesGrid"
                    TValue="AssemblyRow"
                    DataSource="@VisibleAssembliesData"
                    AllowSorting="true"
                    AllowResizing="true"
                    AllowSelection="true"
                    EnableHover="true"
                    Height="100%"
                    RowHeight="20"
                    MinRowHeight="20"
                    AvailableColumns="@GetAssembliesChooseColumnsSchema()"
                    OnColumnsChosen="@OnAssembliesColumnsChosenAsync"
                    OnLayoutChanged="@OnAssembliesLayoutChangedAsync"
                    SelectionSettingsRef="@assemblySelectionSettings"
                    EventsRef="@assemblyGridEvents">
                <GridColumnsBase @key="gAssembliesLayoutVersion">
                    <GridColumn Field="@nameof(AssemblyRow.AssemblyID)" Visible="false" IsPrimaryKey="true" />
                    <GridColumn Field="@nameof(AssemblyRow.RowState)" Visible="false" />
                    @if (HasAssembliesGridLayout)
                    {
                        foreach (var entry in GetOrderedAssembliesGridLayout())
                        {
                            var layout = entry.Layout;
                            var fieldName = entry.Field;
                            var columnType = entry.ColumnType;
                            var textAlign = entry.TextAlign;
                            var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                            var width = layout.Width.HasValue && layout.Width.Value > 0
                                ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;

                            <GridColumn Field="@fieldName"
                                          HeaderText="@headerText"
                                          Width="@width"
                                          Type="@columnType"
                                          TextAlign="@textAlign"
                                          AllowEditing="false"
                                          ClipMode="ClipMode.Ellipsis" />
                        }
                    }
                    else
                    {
                        <GridColumn Field="@nameof(AssemblyRow.AssemblyType)" HeaderText="Type" Width="100px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(AssemblyRow.Community)" HeaderText="Community" Width="100px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(AssemblyRow.Assembly)" HeaderText="Assembly" Width="120px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(AssemblyRow.Model)" HeaderText="Model" Width="100px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(AssemblyRow.Option)" HeaderText="Option" Width="100px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(AssemblyRow.Description)" HeaderText="Description" Width="250px"
                                      AllowEditing="false" />
                    }
                </GridColumnsBase>
            </GridControl>
        </div>

        @* ── HORIZONTAL SPLITTER (between Assemblies and Items Grids) ── *@
        <div class="h-splitter @(_hSplitterDragging ? "dragging" : "")"
             @onmousedown="StartHSplitterDrag" @onmousedown:preventDefault="true"></div>

        @* ── ITEMS GRID ──────────────────────────────── *@
        @* HHM-641: no body-row context menu here — VB6 gItems_BeforeMouseDown
           (FIntersection.frm:551) only pops the header COLUMN menu; the HHM-573
           Edit Item Chart/Attachments menu was removed to match legacy. *@
        @* HHM-580: @onkeydown — VB6 gItems_KeyDown (FIntersection.frm:579) marks the
           current item row "delete" on Delete + any modifier. *@
        <div class="items-panel"
             @onkeydown="OnItemsGridKeyDown">
            <div class="section-header">Items</div>
            <GridControl @ref="ItemsGrid"
                    TValue="IntersectItemRow"
                    DataSource="@VisibleItemsData"
                    AllowSorting="true"
                    AllowResizing="true"
                    AllowSelection="true"
                    EnableHover="true"
                    Height="100%"
                    RowHeight="20"
                    MinRowHeight="20"
                    AvailableColumns="@GetItemsChooseColumnsSchema()"
                    OnColumnsChosen="@OnItemsColumnsChosenAsync"
                    OnLayoutChanged="@OnItemsLayoutChangedAsync"
                    SelectionSettingsRef="@itemSelectionSettings"
                    EditSettingsRef="@itemEditSettings"
                    BatchEditBehavior="GridBatchEditBehavior.SingleCell"
                    AllowSingleCellColumnMassEdit="true"
                    EventsRef="@itemGridEvents">
                <GridColumnsBase @key="gItemsLayoutVersion">
                    <GridColumn Field="@nameof(IntersectItemRow.ItemID)" Visible="false" IsPrimaryKey="true" />
                    <GridColumn Field="@nameof(IntersectItemRow.AssemblyID)" Visible="false" />
                    <GridColumn Field="@nameof(IntersectItemRow.RowState)" Visible="false" />
                    @if (HasItemsGridLayout)
                    {
                        foreach (var entry in GetOrderedItemsGridLayout())
                        {
                            var layout = entry.Layout;
                            var fieldName = entry.Field;
                            var columnType = entry.ColumnType;
                            var textAlign = entry.TextAlign;
                            var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                            var width = layout.Width.HasValue && layout.Width.Value > 0
                                ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;
                            var allowEdit = IsItemFieldEditable(fieldName);

                            if (fieldName == "POIndex")
                            {
                                @* VB6 gItems_CellButtonClick "PO Index": the STANDARD FlexKit edit
                                   button (AlwaysShowEditButton) opens FPickList via OnEditButtonClick
                                   → OnPickPOIndex. Replaces the hand-rolled span+… template; the cell
                                   shows the raw POIndex value (same Field binding), Ellipsis-clipped. *@
                                <GridColumn Field="POIndex" HeaderText="@headerText" Width="@(width ?? "90px")"
                                              AllowEditing="false"
                                              ShowEditButton="true"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                            else
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              AllowEditing="@allowEdit"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                        }
                    }
                    else
                    {
                        <GridColumn Field="@nameof(IntersectItemRow.AssemblyDesc)" HeaderText="Assembly" Width="180px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(IntersectItemRow.Phase)" HeaderText="Phase" Width="80px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(IntersectItemRow.Item)" HeaderText="Item" Width="100px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(IntersectItemRow.ItemDesc)" HeaderText="Description" Width="200px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(IntersectItemRow.TakeoffQty)" HeaderText="Takeoff Qty" Width="100px"
                                      Format="N2" Type="ColumnType.Number" TextAlign="TextAlign.Right"
                                      AllowEditing="true" />
                        <GridColumn Field="@nameof(IntersectItemRow.ConversionFactor)" HeaderText="Conv Factor" Width="100px"
                                      Format="N4" Type="ColumnType.Number" TextAlign="TextAlign.Right"
                                      AllowEditing="true" />
                        <GridColumn Field="@nameof(IntersectItemRow.OrderQty)" HeaderText="Order Qty" Width="100px"
                                      Format="N2" Type="ColumnType.Number" TextAlign="TextAlign.Right"
                                      AllowEditing="true" />
                        <GridColumn Field="@nameof(IntersectItemRow.TakeoffUOM)" HeaderText="Takeoff UOM" Width="80px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(IntersectItemRow.OrderUOM)" HeaderText="Order UOM" Width="80px"
                                      AllowEditing="false" />
                        @* VB6 gItems_CellButtonClick "PO Index" — STANDARD FlexKit edit button
                           opens FPickList via OnEditButtonClick → OnPickPOIndex. *@
                        <GridColumn Field="@nameof(IntersectItemRow.POIndex)" HeaderText="PO Index" Width="90px"
                                      AllowEditing="false"
                                      ShowEditButton="true"
                                      ClipMode="ClipMode.Ellipsis" />
                        <GridColumn Field="@nameof(IntersectItemRow.Notes)" HeaderText="Notes" Width="150px"
                                      AllowEditing="true" />
                        <GridColumn Field="@nameof(IntersectItemRow.WastePercent)" HeaderText="Waste %" Width="70px"
                                      Visible="false" />
                        <GridColumn Field="@nameof(IntersectItemRow.RoundDir)" HeaderText="Round Dir" Width="70px"
                                      Visible="false" />
                        <GridColumn Field="@nameof(IntersectItemRow.RoundTo)" HeaderText="Round To" Width="70px"
                                      Visible="false" />
                    }
                </GridColumnsBase>
            </GridControl>
        </div>
    </div>
</div>

@* ── ADD ASSEMBLY PICKER (VB6 AddAssembly → FPickList.Choose "Assembly", multiSelect) ──
   FIntersection.frm:718. The four assembly-type views (Models / Model Options /
   Global Options / Design Center Options) are presented as picklist views; the
   user switches between them with the picklist's own View dropdown. ── *@
<FPickList @ref="pickList" OnSelected="OnPickListSelected" OnCancel="OnPickListCancelled" />

@* VB6 FTakeoff.Takeoff(Me, …) opens FTakeoff MODALLY over FIntersection.
   Rendered inline with IsModal=true so the FMain MDI shell stays mounted
   (fixes "Item by Group and Phase opens outside the application"). *@
@if (_showTakeoffModal)
{
    <FTakeoff IsModal="true"
              mode="@_takeoffMode"
              isChangeOrder="false"
              assemblyType="option"
              description="@mAssemblyDesc"
              OnClose="OnTakeoffModalClosed"
              OnItemsCommitted="OnTakeoffItemsCommitted" />
}


@code {
    private const string SRCFILE = "FIntersection::";

    // Database
// UI State
    private bool IsLoading = false;
    private bool mDirty = false;
    private long mIntersectID = 0;
    private long mAssemblyID = 0;
    private string mAssemblyDesc = "";

    // FTakeoff modal state (VB6 opens FTakeoff modally over the current form).
    private bool _showTakeoffModal;
    private string _takeoffMode = "Item";

    // Intersections list
    private List<IntersectionItem> IntersectionsList = new();
    private int SelectedIntersectionIndex = -1;

    // Grids
    private GridControl<IntersectionItem>? IntersectionsGrid;
    private GridControl<AssemblyRow>? AssembliesGrid;
    private GridControl<IntersectItemRow>? ItemsGrid;
    private List<AssemblyRow> AssembliesData = new();
    private List<IntersectItemRow> ItemsData = new();

    // Pick list (VB6 FPickList) — shared between the Add-Assembly picker and the
    // in-cell PO Index picker. _pickContext routes OnPickListSelected.
    private FPickList? pickList;
    private string _pickContext = "";
    private IntersectItemRow? _poPickRow;   // the row a PO Index pick targets

    // Computed
    private bool CanDelete => mIntersectID != 0 || SelectedAssemblyRow != null || SelectedItemRow != null;
    private AssemblyRow? SelectedAssemblyRow;
    private IntersectItemRow? SelectedItemRow;
    private string? ActiveGridName;

    // Grid Settings
    private SelectionSettings assemblySelectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single
    };
    private SelectionSettings intersectionSelectionSettings = new()
    {
        Mode = SelectionMode.Cell,
        Type = SelectionType.Single
    };
    private EditSettings intersectionEditSettings = new()
    {
        AllowAdding = true,
        AllowEditing = true,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch,
        NewRowPosition = NewRowPosition.Bottom
    };
    private SelectionSettings itemSelectionSettings = new()
    {
        Mode = SelectionMode.Cell,
        Type = SelectionType.Multiple,
        EnableToggle = true
    };
    private EditSettings itemEditSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch
    };
    private GridControlEvents<IntersectionItem> intersectionGridEvents = new();
    private GridControlEvents<AssemblyRow> assemblyGridEvents = new();
    private GridControlEvents<IntersectItemRow> itemGridEvents = new();

    // === Grid layout via the shared GridLayoutPresenter ===
    // The load/resolve/order/width boilerplate lives in GridLayoutPresenter<TRow>;
    // only the VB6 form/grid name strings stay here (fidelity). The members named
    // gAssembliesLayout / HasAssembliesGridLayout / …Version below are thin
    // delegations, so the markup and the rest of this file are unchanged.
    // HHM-528: the AppGridLayout tags are the VB6 grid NAMES — IniPutGrid
    // (FIntersection.frm Form_Load/Unload) stores "FIntersection.gAssemblies" /
    // "FIntersection.gItems". The presenters were constructed with invented
    // names ("AssembliesGrid"/"ItemsGrid") that match no AppGridLayout row, so
    // the layout never loaded, the grids ran on hardcoded fallback columns and
    // the Insert-a-Column dialog listed the rendered utility columns
    // (RowState/ItemID/AssemblyID) instead of the legacy column set.
    private readonly GridLayoutPresenter<AssemblyRow> _assembliesGrid =
        new("FIntersection", "gAssemblies", instanceKey: "(0)");
    private readonly GridLayoutPresenter<IntersectItemRow> _itemsGrid =
        new("FIntersection", "gItems", instanceKey: "(0)");

    private Dictionary<string, GridLayoutColumn> gAssembliesLayout => _assembliesGrid.Layout;
    private bool HasAssembliesGridLayout => _assembliesGrid.Has;
    private int gAssembliesLayoutVersion => _assembliesGrid.Version;

    private Dictionary<string, GridLayoutColumn> gItemsLayout => _itemsGrid.Layout;
    private bool HasItemsGridLayout => _itemsGrid.Has;
    private int gItemsLayoutVersion => _itemsGrid.Version;

    // Dirty property
    private bool Dirty
    {
        get => mDirty;
        set => mDirty = value;
    }

    // ── Splitter / Slider Dragging ─────────────────────────────────────
    private const string PrefsSection = "FIntersection";
    private const int LeftPanelMinPx = 180;
    private const int AssembliesPanelMinPx = 120;

    private bool _vSplitterDragging;
    private bool _hSplitterDragging;
    private double _dragStartX;
    private double _dragStartY;
    private int _dragStartWidth;
    private int _dragStartHeight;

    private int _leftPanelWidthPx = 320;
    private int _assembliesPanelHeightPx = 280;

    private int LeftPanelWidthPx => Math.Max(_leftPanelWidthPx, LeftPanelMinPx);
    private int AssembliesPanelHeightPx => Math.Max(_assembliesPanelHeightPx, AssembliesPanelMinPx);

    private void InitSplitterPrefs()
    {
        if (int.TryParse(Prefs.Get(PrefsSection, "LeftPanelWidthPx"), out var savedLeft) && savedLeft >= LeftPanelMinPx)
            _leftPanelWidthPx = savedLeft;

        if (int.TryParse(Prefs.Get(PrefsSection, "AssembliesPanelHeightPx"), out var savedTop) && savedTop >= AssembliesPanelMinPx)
            _assembliesPanelHeightPx = savedTop;
    }

    private void StartVSplitterDrag(MouseEventArgs e)
    {
        _vSplitterDragging = true;
        _dragStartX = e.ClientX;
        _dragStartWidth = LeftPanelWidthPx;
    }

    private void StartHSplitterDrag(MouseEventArgs e)
    {
        _hSplitterDragging = true;
        _dragStartY = e.ClientY;
        _dragStartHeight = AssembliesPanelHeightPx;
    }

    private void OnSplitterDrag(MouseEventArgs e)
    {
        if (!_vSplitterDragging && !_hSplitterDragging) return;
        if ((e.Buttons & 1) == 0) { EndSplitterDrag(); return; }

        if (_vSplitterDragging)
        {
            var target = _dragStartWidth + (int)(e.ClientX - _dragStartX);
            _leftPanelWidthPx = Math.Max(target, LeftPanelMinPx);
        }
        else if (_hSplitterDragging)
        {
            var target = _dragStartHeight + (int)(e.ClientY - _dragStartY);
            _assembliesPanelHeightPx = Math.Max(target, AssembliesPanelMinPx);
        }
    }

    private void EndSplitterDrag()
    {
        if (!_vSplitterDragging && !_hSplitterDragging) return;

        if (_vSplitterDragging)
        {
            _vSplitterDragging = false;
            Prefs.Put(PrefsSection, "LeftPanelWidthPx", _leftPanelWidthPx.ToString());
        }

        if (_hSplitterDragging)
        {
            _hSplitterDragging = false;
            Prefs.Put(PrefsSection, "AssembliesPanelHeightPx", _assembliesPanelHeightPx.ToString());
        }
    }

    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        InitSplitterPrefs();
        intersectionGridEvents.CellSelected = EventCallback.Factory.Create<CellSelectEventArgs<IntersectionItem>>(this, OnIntersectionCellSelected);
        intersectionGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<IntersectionItem>>(this, OnIntersectionCellSaved);
        assemblyGridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<AssemblyRow>>(this, OnAssemblyRowSelected);
        assemblyGridEvents.RowDeselected = EventCallback.Factory.Create<RowSelectEventArgs<AssemblyRow>>(this, OnAssemblyRowDeselected);
        itemGridEvents.CellSelected = EventCallback.Factory.Create<CellSelectEventArgs<IntersectItemRow>>(this, OnItemCellSelected);
        itemGridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<IntersectItemRow>>(this, OnItemRowSelected);
        itemGridEvents.RowDeselected = EventCallback.Factory.Create<RowSelectEventArgs<IntersectItemRow>>(this, OnItemRowDeselected);
        itemGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<IntersectItemRow>>(this, OnItemCellSaved);
        itemGridEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<IntersectItemRow>>(this, OnItemEditButtonClick);

        await LoadGridLayoutAsync();
        await LoadIntersections();
    }

    // ── Load Grid Layout ────────────────────────────────────────────────
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            // The keyed/unkeyed "(0)" fallback + Version bump live in the presenter
            // (its ctor was given the form/grid names and instanceKey "(0)").
            await _assembliesGrid.LoadAsync(GridLayoutSvc);
            await _itemsGrid.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");

        }
    }

    // ── Load Intersections ───────────────────────────────────────────────
    private async Task LoadIntersections()
    {
        try
        {
            IntersectionsList.Clear();
            var sql = $"SELECT IntersectID, Description FROM tblDBAssemblyIntersections WHERE DivisionID = {SessionState.DivisionID} ORDER BY Description";
            var rows = await db.QueryAsync(sql);
            foreach (var row in rows)
            {
                IntersectionsList.Add(new IntersectionItem
                {
                    IntersectID = Convert.ToInt64(row["IntersectID"]),
                    Description = row["Description"]?.ToString() ?? "",
                    IsNewRow = false
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadIntersections error");

        }
    }

    private IntersectionItem CreateIntersectionRowFromGrid() => new() { IsNewRow = true };

    private static bool IsIntersectionTrailingNewRow(IntersectionItem row) => row.IsNewRow;

    private static bool CanAppendIntersectionNewRowAfter(IntersectionItem row) =>
        !row.IsNewRow || !string.IsNullOrWhiteSpace(row.Description);

    // ── Intersection selection/editing ───────────────────────────────────
    private async Task OnIntersectionCellSelected(CellSelectEventArgs<IntersectionItem> args)
    {
        if (args.Data == null)
            return;

        ActiveGridName = "Intersections";
        SelectedIntersectionIndex = args.RowIndex;

        var item = args.Data;
        if (mDirty && (item.IsNewRow || mIntersectID != item.IntersectID))
        {
            var saved = await SaveData(true);
            if (!saved) return;
        }

        if (item.IsNewRow || mIntersectID == item.IntersectID)
            return;

        await LoadIntersect(item.IntersectID);
    }

    private async Task OnIntersectionCellSaved(CellSaveArgs<IntersectionItem> args)
    {
        if (args.Data == null
            || !string.Equals(args.ColumnName, nameof(IntersectionItem.Description), StringComparison.OrdinalIgnoreCase))
            return;

        var row = args.Data;
        var text = (args.Value?.ToString() ?? row.Description ?? "").Trim();
        row.Description = text;

        if (string.IsNullOrWhiteSpace(text))
        {
            if (!row.IsNewRow && row.IntersectID != 0)
                await RestoreIntersectionDescriptionAsync(row);
            return;
        }

        if (row.IsNewRow || row.IntersectID == 0)
        {
            await InsertIntersectionRowAsync(row, text);
            return;
        }

        await UpdateIntersectionRowAsync(row, text);
    }

    private async Task RestoreIntersectionDescriptionAsync(IntersectionItem row)
    {
        try
        {
            row.Description = await db.ExecuteScalarAsync<string>(
                "SELECT Description FROM tblDBAssemblyIntersections WHERE IntersectID = @IntersectID",
                new { row.IntersectID }) ?? "";
            if (IntersectionsGrid != null) await IntersectionsGrid.Refresh();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "RestoreIntersectionDescription error");
        }
    }

    private async Task UpdateIntersectionRowAsync(IntersectionItem row, string text)
    {
        try
        {
            // VB6: update tbldbassemblyintersections set description=... where intersectid=...
            await db.ExecuteAsync(
                "UPDATE tblDBAssemblyIntersections SET Description = @Description WHERE IntersectID = @IntersectID",
                new { Description = text, row.IntersectID });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "UpdateIntersectionRow error");

        }
    }

    private async Task InsertIntersectionRowAsync(IntersectionItem row, string text)
    {
        try
        {
            // HHM-561: SCOPE_IDENTITY() is batch/connection-scoped and the db wrapper
            // opens a fresh connection per call, so a separate "SELECT SCOPE_IDENTITY()"
            // always returned NULL → newId=0, leaving the Add/Delete toolbar buttons
            // disabled (they gate on mIntersectID != 0, mirroring VB6 FIntersection.frm:
            // 851-852). Fold the identity select into the SAME batch as the INSERT —
            // VB6 fetches the identity immediately after its insert too (frm:605-607,
            // HFApp.SqlIdentity). DivisionID is also parameterized (was interpolated).
            var newId = await db.ExecuteScalarAsync<long>(
                "INSERT INTO tblDBAssemblyIntersections (DivisionID, Description) VALUES (@DivisionID, @Description); " +
                "SELECT CAST(SCOPE_IDENTITY() AS bigint);",
                new { DivisionID = SessionState.DivisionID, Description = text });

            row.IntersectID = newId;
            row.Description = text;
            row.IsNewRow = false;
            SelectedIntersectionIndex = IntersectionsList.IndexOf(row);
            await LoadIntersect(newId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{SRCFILE}InsertIntersectionRow error");

            await Dialogs.ConfirmAsync($"Error creating intersection: {ex.Message}");
        }
    }

    // ── Load Intersect Detail ────────────────────────────────────────────
    private async Task LoadIntersect(long intersectID)
    {
        mIntersectID = intersectID;
        mAssemblyID = 0;
        mAssemblyDesc = "";
        SelectedAssemblyRow = null;
        SelectedItemRow = null;

        IsLoading = true;
        StateHasChanged();

        try
        {
            // Load assemblies
            var assemblySql = @"
                SELECT m.AssemblyID, m.Community, m.Assembly, m.Model, m.OptionID, m.Description, m.AssemblyTypeDesc
                FROM tblDBAssemblyIntersectAssemblies xa
                JOIN tblDBAssemblyMaster m ON xa.AssemblyID = m.AssemblyID
                WHERE xa.IntersectID = @IntersectID
                ORDER BY m.Description";
            var assemblyRows = await db.QueryAsync(assemblySql, new { IntersectID = intersectID });
            AssembliesData = assemblyRows.Select(r => new AssemblyRow
            {
                AssemblyID = Convert.ToInt64(r["AssemblyID"]),
                Community = r["Community"]?.ToString() ?? "",
                AssemblyType = r["AssemblyTypeDesc"]?.ToString() ?? "",
                Assembly = r["Assembly"]?.ToString() ?? "",
                Model = r["Model"]?.ToString() ?? "",
                Option = r["OptionID"]?.ToString() ?? "",
                Description = r["Description"]?.ToString() ?? "",
                RowState = "CLEAN"
            }).ToList();

            // Load items
            // HHM-573: d.ItemChart feeds the Edit Item Chart… context-menu entry.
            // tblDBAssemblyIntersectItems has no ItemChart column (VB6
            // FIntersection.frm:915 insert list), so it comes from the assembly's
            // detail row in tblDBAssemblyDetails — the same source FTakeoff reads
            // (d.itemchart, FTakeoff LoadModelOrOption). OUTER APPLY TOP 1 instead
            // of LEFT JOIN because the detail table keys on Sequence and can hold
            // the same Phase+Item more than once per assembly — a join would
            // duplicate intersect item rows.
            var itemsSql = @"
                SELECT m.Description AS AssemblyDesc, i.ItemDesc, i.WastePercent, i.RoundDir, i.RoundTo, d.ItemChart, xi.*
                FROM tblDBAssemblyIntersections x
                JOIN tblDBAssemblyIntersectItems xi ON x.IntersectID = xi.IntersectID
                JOIN tblDBAssemblyMaster m ON xi.AssemblyID = m.AssemblyID
                JOIN EstimatingItems i ON i.DivisionID = x.DivisionID AND i.Phase = xi.Phase AND i.Item = xi.Item
                OUTER APPLY (SELECT TOP 1 dd.ItemChart
                             FROM tblDBAssemblyDetails dd
                             WHERE dd.DivisionID = x.DivisionID AND dd.Community = m.Community
                               AND dd.Model = m.Model AND dd.OptionID = m.OptionID
                               AND dd.Assembly = m.Assembly AND dd.Phase = xi.Phase AND dd.Item = xi.Item
                             ORDER BY dd.Sequence) d
                WHERE x.IntersectID = @IntersectID
                ORDER BY xi.ItemID";
            var itemRows = await db.QueryAsync(itemsSql, new { IntersectID = intersectID });
            ItemsData = itemRows.Select(r => new IntersectItemRow
            {
                ItemID = Convert.ToInt64(r["ItemID"]),
                AssemblyID = Convert.ToInt64(r["AssemblyID"]),
                AssemblyDesc = r["AssemblyDesc"]?.ToString() ?? "",
                Phase = r["Phase"]?.ToString() ?? "",
                Item = r["Item"]?.ToString() ?? "",
                ItemDesc = r["ItemDesc"]?.ToString() ?? "",
                TakeoffQty = SafeDouble(r["TakeoffQty"]),
                OrderQty = SafeDouble(r["OrderQty"]),
                ConversionFactor = SafeDouble(r["ConversionFactor"]),
                WastePercent = SafeDouble(r["WastePercent"]),
                RoundDir = SafeInt(r["RoundDir"]),
                RoundTo = SafeDouble(r["RoundTo"]),
                TakeoffUOM = r["TakeoffUOM"]?.ToString() ?? "",
                OrderUOM = r["OrderUOM"]?.ToString() ?? "",
                POIndex = r["POIndex"]?.ToString() ?? "",
                Notes = r["Notes"]?.ToString() ?? "",
                ItemChart = r["ItemChart"]?.ToString() ?? "", // HHM-573
                RowState = "CLEAN"
            }).ToList();

            Dirty = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{SRCFILE}LoadIntersect error");

        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

