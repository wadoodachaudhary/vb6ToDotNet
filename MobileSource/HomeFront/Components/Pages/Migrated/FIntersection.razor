        _showTakeoffModal = false;
    }

    // VB6 parity: FTakeoff.frm:1590 — Call mParentForm.AddItem(...). FTakeoff has
    // already filtered zero-qty rows and hands us the kept set; stage each one via
    // the existing public AddItem so the next user-driven Save INSERTs them.
    private void OnTakeoffItemsCommitted(List<FTakeoff.TakeoffItemRow> rows)
    {
        if (rows == null || rows.Count == 0) return;
        foreach (var r in rows)
        {
            AddItem(r.Assembly, r.AssemblyDescription, r.Model,
                r.Phase, r.Item, 0, r.Description,
                r.OrderQty, r.OrderUOM, r.TakeoffQty, r.TakeoffUOM,
                r.ConversionFactor, r.RoundTo, (int)r.RoundDir, (int)r.WastePercent,
                r.POIndex, r.Notes);
        }
    }

    // ── AddItem (called from takeoff) ────────────────────────────────────
    public void AddItem(string assembly, string assemblyDescription, string model,
        string phase, string item, long sequence, string description,
        double orderQty, string orderUOM, double takeoffQty, string takeoffUOM,
        double conversionFactor, double roundTo, int roundDir, int wastePercent,
        string poIndex, string notes)
    {
        var newRow = new IntersectItemRow
        {
            ItemID = 0,
            AssemblyID = mAssemblyID,
            AssemblyDesc = mAssemblyDesc,
            Phase = phase,
            Item = item,
            ItemDesc = description,
            TakeoffQty = takeoffQty,
            ConversionFactor = conversionFactor,
            OrderQty = orderQty,
            TakeoffUOM = takeoffUOM,
            OrderUOM = orderUOM,
            POIndex = poIndex,
            Notes = "",
            WastePercent = wastePercent,
            RoundDir = roundDir,
            RoundTo = roundTo,
            RowState = "new"
        };
        ItemsData.Add(newRow);
        Dirty = true;
        StateHasChanged();
    }

    // ── Items-grid context menu: Edit Item Chart / Attachments (HHM-573) ────
    // Port of FTakeoff's HHM-547 items-grid menu (FTakeoff.razor
    // OnItemsGridContextMenu / OnEditItemChartClick / OnAttachmentsClick).
    // VB6 FIntersection.frm:551 (gItems_BeforeMouseDown) popped only the header
    // column menu with Attachments:=False, but HHM-547 established the product
    // pattern of offering FMain.mnuAssemblyItemsSub's Edit Item Chart
    // (mcITEM_EDITITEMCHART) and Attachments (mcITEM_VIEWFILES) on items grids.
    private bool _showItemsGridMenu;
    private double _itemsGridMenuX, _itemsGridMenuY;
    // FItemChart modal visibility flag; ChartName preload comes from the row.
    private bool _showItemChartModal;
    private string? _editItemChartName;
    // FAttachments host for the "Attachments…" entry.
    private FAttachments? attachmentsDialog;

    private void OnItemsGridContextMenu(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        // Suppressed while the grid is empty, matching FTakeoff's convention.
        if (VisibleItemsData.Count == 0) return;
        _itemsGridMenuX = e.ClientX;
        _itemsGridMenuY = e.ClientY;
        _showItemsGridMenu = true;
    }

    // FTakeoff SelectedItemsOrCurrent() adapted to FIntersection's row model:
    // grid multi-selection first, then the tracked SelectedItemRow, then the
    // first visible row — never a "delete"-marked row.
    private List<IntersectItemRow> SelectedItemsOrCurrent()
    {
        var sel = ItemsGrid?.GetSelectedRecords()?.Where(r => r.RowState != "delete").ToList()
                  ?? new List<IntersectItemRow>();
        if (sel.Count == 0)
        {
            if (SelectedItemRow != null && SelectedItemRow.RowState != "delete")
                sel.Add(SelectedItemRow);
            else if (VisibleItemsData.Count > 0)
                sel.Add(VisibleItemsData[0]);
        }
        return sel;
    }

    private void OnItemChartModalClosed()
    {
        _showItemChartModal = false;
        _editItemChartName = null;
    }

    /// <summary>VB6 mnuAssemblyItemsSub(mcITEM_EDITITEMCHART) — FItemChart.Edit(row
    /// ItemChart). Opens the FItemChart modal preloaded with the selected item's
    /// item-chart name (HHM-573, same host pattern as FTakeoff HHM-547).</summary>
    private void OnEditItemChartClick()
    {
        _showItemsGridMenu = false;
        var selected = SelectedItemsOrCurrent().FirstOrDefault();
        if (selected == null)
        {
            Notifications.Info("Select an item row first.");
            return;
        }
        _editItemChartName = selected.ItemChart ?? "";
        _showItemChartModal = true;
        StateHasChanged();
    }

    /// <summary>VB6 mnuAssemblyItemsSub(mcITEM_VIEWFILES) — EditAttachments for the
    /// selected item. VB6 (FAssembly.frm:4139) uses the item-level object id
    /// "ITM~{phase}~{item}" against the "Item Database" folder; we build the same
    /// shape and open the shared FAttachments host (HHM-573).</summary>
    private async Task OnAttachmentsClick()
    {
        _showItemsGridMenu = false;
        var selected = SelectedItemsOrCurrent().FirstOrDefault();
        if (selected == null)
        {
            Notifications.Info("Select an item row first.");
            return;
        }
        if (attachmentsDialog == null) return;

        var objectId = $"ITM~{selected.Phase}~{selected.Item}";
        await attachmentsDialog.ShowForm(
            "Item Database",
            (objectId, objectId));
    }

    // ── Helpers ──────────────────────────────────────────────────────────
    private double RoundTo(double value, double roundTo, int roundDir)
    {
        if (roundTo <= 0) return value;
        return roundDir switch
        {
            1 => Math.Ceiling(value / roundTo) * roundTo,   // Round up
            -1 => Math.Floor(value / roundTo) * roundTo,    // Round down
            _ => Math.Round(value / roundTo) * roundTo       // Normal rounding
        };
    }

    private double SafeDouble(object? val) =>
        val != null && val != DBNull.Value ? Convert.ToDouble(val) : 0;

    private int SafeInt(object? val) =>
        val != null && val != DBNull.Value ? Convert.ToInt32(val) : 0;

