        => _itemsGrid.GetChooseColumnsSchema();

    // HHM-528: the description list offers only its single legacy column —
    // VB6 gIntersections holds just Description plus a caption-less
    // intersectid key column that FColumns.frm:367 filters out. Without this
    // schema the dialog would fall back to the rendered children and list the
    // IntersectID / IsNewRow utility columns.
    private static readonly ChooseColumnDescriptor[] IntersectionsChooseColumns =
    {
        new() { Field = nameof(IntersectionItem.Description), Header = "Intersection Description", Visible = true }
    };

    private static bool IsItemFieldEditable(string field)
    {
        return field switch
        {
            "ItemID" or "AssemblyID" or "RowState" or "AssemblyDesc" or "Phase" or "Item" or "ItemDesc"
                or "TakeoffUOM" or "OrderUOM" => false,
            "TakeoffQty" or "ConversionFactor" or "OrderQty" or "POIndex" or "Notes" => true,
            // VB6 gItems_BeforeEdit (FIntersection.frm:540-549) cancels the
            // edit for every column other than TakeoffQty / OrderQty /
            // ConversionFactor / Notes / POIndex — so the layout-driven
            // WastePercent / RoundTo / RoundDir columns stay read-only.
            _ => false
        };
    }

