    // ── Item Cell Saved (AfterEdit) ──────────────────────────────────────
    private void OnItemCellSaved(CellSaveArgs<IntersectItemRow> args)
    {
        if (args.Data == null) return;
        var row = args.Data;

        if (row.RowState == "CLEAN") row.RowState = "dirty";
        Dirty = true;

        var colName = args.ColumnName ?? "";
        switch (colName)
        {
            case nameof(IntersectItemRow.TakeoffQty):
            case nameof(IntersectItemRow.ConversionFactor):
                row.OrderQty = RoundTo(
                    row.TakeoffQty * (100 + row.WastePercent) / 100 * row.ConversionFactor,
                    row.RoundTo, row.RoundDir);
                break;
            case nameof(IntersectItemRow.OrderQty):
                if (row.ConversionFactor != 0)
                    row.TakeoffQty = row.OrderQty / row.ConversionFactor;
                break;
        }
    }

    // ── Toolbar: Save ────────────────────────────────────────────────────
    private async Task OnSaveClick()
    {
        await SaveData(false);
    }

    private async Task<bool> SaveData(bool prompt)
    {
        if (!mDirty) return true;

        if (prompt)
        {
            // VB6 used Yes/No/Cancel: Yes=save, No=discard, Cancel=abort
            var answer = await Dialogs.ConfirmCancelAsync(
                "This data has changed.\n\nDo you want to save these changes?");
            if (answer == MessageBoxResult.Cancel) return false;
            if (answer == MessageBoxResult.No)
            {
                Dirty = false;
                return true;
            }
        }

        IsLoading = true;
        StateHasChanged();

        try
        {
            // Process assembly deletes
            for (int r = AssembliesData.Count - 1; r >= 0; r--)
            {
                if (AssembliesData[r].RowState == "delete")
                {
                    await db.ExecuteAsync(
                        "DELETE FROM tblDBAssemblyIntersectAssemblies WHERE IntersectID = @IntersectID AND AssemblyID = @AssemblyID",
                        new { IntersectID = mIntersectID, AssemblyID = AssembliesData[r].AssemblyID });
                    await db.ExecuteAsync(
                        "DELETE FROM tblDBAssemblyIntersectItems WHERE IntersectID = @IntersectID AND AssemblyID = @AssemblyID",
                        new { IntersectID = mIntersectID, AssemblyID = AssembliesData[r].AssemblyID });
                    AssembliesData.RemoveAt(r);
                }
            }

            // Process assembly inserts
            foreach (var row in AssembliesData.Where(a => a.RowState == "new"))
            {
                await db.ExecuteAsync(
                    "INSERT INTO tblDBAssemblyIntersectAssemblies (IntersectID, AssemblyID) VALUES (@IntersectID, @AssemblyID)",
                    new { IntersectID = mIntersectID, AssemblyID = row.AssemblyID });
                row.RowState = "CLEAN";
            }

            // Process item deletes
            for (int r = ItemsData.Count - 1; r >= 0; r--)
            {
                if (ItemsData[r].RowState == "delete")
                {
                    await db.ExecuteAsync(
                        "DELETE FROM tblDBAssemblyIntersectItems WHERE ItemID = @ItemID",
                        new { ItemID = ItemsData[r].ItemID });
                    ItemsData.RemoveAt(r);
                }
            }

            // Process item inserts and updates
            foreach (var row in ItemsData)
            {
                switch (row.RowState)
                {
                    case "new":
                        // HHM-561: identity select folded into the SAME batch as the
                        // INSERT — a standalone "SELECT SCOPE_IDENTITY()" ran on a new
                        // connection and always returned NULL → ItemID=0, silently
                        // breaking later updates/deletes of takeoff-added rows. VB6
                        // reads the identity right after the insert (FIntersection.frm:
                        // 915-929, HFApp.SqlIdentity("tbldbassemblyintersectitems")).
                        var newId = await db.ExecuteScalarAsync<long>(@"
                            INSERT INTO tblDBAssemblyIntersectItems
                                (IntersectID, AssemblyID, Phase, Item, TakeoffQty, TakeoffUOM,
                                 ConversionFactor, OrderQty, OrderUOM, POIndex, Notes)
                            VALUES
                                (@IntersectID, @AssemblyID, @Phase, @Item, @TakeoffQty, @TakeoffUOM,
                                 @ConversionFactor, @OrderQty, @OrderUOM, @POIndex, @Notes);
                            SELECT CAST(SCOPE_IDENTITY() AS bigint);",
                            new
                            {
                                IntersectID = mIntersectID,
                                row.AssemblyID, row.Phase, row.Item,
                                row.TakeoffQty, row.TakeoffUOM,
                                row.ConversionFactor, row.OrderQty, row.OrderUOM,
                                row.POIndex, row.Notes
                            });
                        row.ItemID = newId;
                        row.RowState = "CLEAN";
                        break;

                    case "dirty":
                        await db.ExecuteAsync(@"
                            UPDATE tblDBAssemblyIntersectItems SET
                                TakeoffQty = @TakeoffQty,
                                ConversionFactor = @ConversionFactor,
                                OrderQty = @OrderQty,
                                POIndex = @POIndex,
                                Notes = @Notes
                            WHERE ItemID = @ItemID",
                            new
                            {
                                row.TakeoffQty, row.ConversionFactor,
                                row.OrderQty, row.POIndex, row.Notes,
                                row.ItemID
                            });
                        row.RowState = "CLEAN";
                        break;
                }
            }

            Dirty = false;
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{SRCFILE}SaveData error");

            await Dialogs.ConfirmAsync($"Error saving: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ── Toolbar: Delete ──────────────────────────────────────────────────
    // Filtered views that hide "delete"-marked rows from the grids
    private List<AssemblyRow> VisibleAssembliesData => AssembliesData.Where(a => a.RowState != "delete").ToList();
    private List<IntersectItemRow> VisibleItemsData => ItemsData.Where(i => i.RowState != "delete").ToList();

    private async Task OnDeleteClick()
    {
        // VB6 toolbar Delete (FIntersection.frm:652-655) routes to the focused
        // grid's KeyDown handler (Screen.ActiveControl Is gIntersections /
        // gAssemblies / gItems); ActiveGridName is our ActiveControl equivalent.
        if (ActiveGridName == "Items" && SelectedItemRow != null)
        {
            DeleteSelectedItemRow();
        }
        else if (ActiveGridName == "Assemblies" && SelectedAssemblyRow != null)
        {
            DeleteSelectedAssemblyRow();
        }
        else if (mIntersectID != 0 && SelectedIntersectionIndex >= 0)
        {
            await DeleteCurrentIntersectionAsync();
        }
    }

    // VB6 gItems_KeyDown (FIntersection.frm:579-590): mark the current item row
    // "delete" and hide it; Save processes the delete later.
    private void DeleteSelectedItemRow()
    {
        if (SelectedItemRow == null) return;
        SelectedItemRow.RowState = "delete";
        Dirty = true;
        SelectedItemRow = null;
        StateHasChanged();
    }

    // VB6 gAssemblies_KeyDown (FIntersection.frm:493-516): mark the selected
    // assembly "delete" plus every gItems row with the matching AssemblyID.
    private void DeleteSelectedAssemblyRow()
    {
        if (SelectedAssemblyRow == null) return;
        var assemblyId = SelectedAssemblyRow.AssemblyID;
        // Mark assembly's items for delete too (VB6: gItems rows with matching AssemblyID)
        foreach (var item in ItemsData.Where(i => i.AssemblyID == assemblyId && i.RowState != "delete"))
        {
            item.RowState = "delete";
        }
        SelectedAssemblyRow.RowState = "delete";
        Dirty = true;
        SelectedAssemblyRow = null;
        // VB6 :510 moves the current row to the next visible one — either way
        // the deleted assembly must stop being the "current assembly" the
        // Item/Assembly toolbar buttons act on (HHM-580 REOPEN).
        if (mAssemblyID == assemblyId)
        {
            mAssemblyID = 0;
            mAssemblyDesc = "";
        }
        StateHasChanged();
    }

    // VB6 gIntersections_KeyDown (FIntersection.frm:473-491): confirm, then
    // delete the intersection's assemblies, items and header row immediately.
    private async Task DeleteCurrentIntersectionAsync()
    {
        if (mIntersectID == 0 || SelectedIntersectionIndex < 0) return;

        var confirm = await Dialogs.ConfirmAsync(
            "Are you sure you want to delete this option intersection?");
        if (!confirm) return;

        try
        {
            await db.ExecuteAsync(
                "DELETE FROM tblDBAssemblyIntersectAssemblies WHERE IntersectID = @IntersectID",
                new { IntersectID = mIntersectID });
            await db.ExecuteAsync(
                "DELETE FROM tblDBAssemblyIntersectItems WHERE IntersectID = @IntersectID",
                new { IntersectID = mIntersectID });
            await db.ExecuteAsync(
                "DELETE FROM tblDBAssemblyIntersections WHERE IntersectID = @IntersectID",
                new { IntersectID = mIntersectID });

            IntersectionsList.RemoveAt(SelectedIntersectionIndex);
            mIntersectID = 0;
            AssembliesData.Clear();
            ItemsData.Clear();
            SelectedIntersectionIndex = -1;
            Dirty = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{SRCFILE}DeleteIntersection error");

        }
    }

    // ── HHM-580: keyboard Delete wiring (VB6 FIntersection.frm KeyDown) ──────
    // VB6 fires each grid's KeyDown on vbKeyDelete with ANY modifier held
    // ("If KeyCode = vbKeyDelete And Shift <> 0" — gIntersections :473,
    // gAssemblies :493, gItems :579), so Ctrl+Delete, Shift+Delete and
    // Alt+Delete all delete. FlexKit GridControl doesn't consume Delete, so the
    // wrapper-div keydown catches it (FItems / FDimensionCategories pattern).
    // Each handler calls ITS OWN delete method — never the toolbar cascade —
    // because a stale SelectedItemRow/SelectedAssemblyRow from a prior grid
    // click would misroute; VB6 routes strictly by the focused control.
    private void OnAssembliesGridKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Delete" || !(e.CtrlKey || e.ShiftKey || e.AltKey)) return;
        // HHM-580 REOPEN: fall back to the grid's OWN selection when the
        // RowSelected callback hasn't tracked the row — the grid's internal
        // selection is authoritative for the highlighted row, exactly like
        // VB6 reads .Row off gAssemblies itself (:501 ValueMatrix(.Row, …)).
        SelectedAssemblyRow ??= AssembliesGrid?.GetSelectedRecords()?
            .FirstOrDefault(r => r.RowState != "delete");
        if (SelectedAssemblyRow == null) return; // VB6 :497 If .Row < 1 Then Exit Sub
        DeleteSelectedAssemblyRow();
    }

    private void OnItemsGridKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Delete" || !(e.CtrlKey || e.ShiftKey || e.AltKey)) return;
        if (SelectedItemRow == null) return; // VB6 :582 If .Row < 1 Then Exit Sub
        DeleteSelectedItemRow();
    }

    private async Task OnIntersectionsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Delete" || !(e.CtrlKey || e.ShiftKey || e.AltKey)) return;
        // VB6 :476 skips the new-row placeholder ("If .Row = .Rows - 1 Or .Row < 1").
        if (mIntersectID == 0 || SelectedIntersectionIndex < 0) return;
        if (SelectedIntersectionIndex >= IntersectionsList.Count
            || IntersectionsList[SelectedIntersectionIndex].IsNewRow) return;
        await DeleteCurrentIntersectionAsync();
    }

    // ── Toolbar: Add Assembly (VB6 AddAssembly, FIntersection.frm:676) ────
    // VB6 opens FPickList.Choose("Assembly", <multi-view SQL>, multiSelect:=True)
    // hiding the AssemblyID + assemblytypedesc columns. The four views (Models /
    // Model Options / Global Options / Design Center Options) are switched with
    // the picklist's View dropdown. Models view is only offered when no model has
    // been chosen yet; Model Options is filtered to that model once one exists.
    private async Task OnAddAssemblyClick()
    {
        if (mIntersectID == 0 || pickList == null) return;

        // VB6: scan gAssemblies for a non-hidden model row to constrain Model Options.
        var model = AssembliesData
            .Where(a => !string.IsNullOrEmpty(a.Model) && a.RowState != "delete")
            .Select(a => a.Model)
            .LastOrDefault() ?? "";

        // Each view SELECTs the same named columns the VB6 insert loop reads
        // (AssemblyID, AssemblyTypeDesc, Community, Assembly, Model, OptionID,
        // Description). DivisionID / Model are bound, never interpolated.
        var views = new List<string>();
        if (string.IsNullOrEmpty(model))
        {
            views.Add("Models;" + AssemblyViewSql(assemblyType: 0, filterModel: false));
        }
        views.Add("Model Options;" + AssemblyViewSql(assemblyType: 2, filterModel: !string.IsNullOrEmpty(model)));
        views.Add("Global Options;" + AssemblyViewSql(assemblyType: 3, filterModel: false));
        views.Add("Design Center Options;" + AssemblyViewSql(assemblyType: 4, filterModel: false));

        _pickContext = "AddAssembly";
        await pickList.Open(
            "Assembly",
            string.Join("|", views),
            hideColumns: "AssemblyID,AssemblyTypeDesc",
            multiSelect: true,
            parameters: new Dictionary<string, object>
            {
                ["DivisionID"] = SessionState.DivisionID,
                ["Model"] = model
            });
    }

    // VB6 AddAssembly per-view query (FIntersection.frm:690-716). Each view has a
    // DIFFERENT column list in VB6: Models omits Category/OptionID; Model Options
    // adds Category (+ keeps Model/OptionID); Global/Design Center add Category and
    // omit Model. AssemblyID + AssemblyTypeDesc stay in every view (hidden via
    // hideColumns) so the insert loop can read them.
    private static string AssemblyViewSql(int assemblyType, bool filterModel)
    {
        var columns = assemblyType switch
        {
            0 => "a.AssemblyID, a.AssemblyTypeDesc, a.Community, a.Assembly, a.Model, a.Description",
            2 => "a.AssemblyID, a.AssemblyTypeDesc, a.Category, a.Community, a.Assembly, a.Model, a.OptionID, a.Description",
            3 => "a.AssemblyID, a.AssemblyTypeDesc, a.Category, a.Community, a.Assembly, a.OptionID, a.Description",
            4 => "a.AssemblyID, a.AssemblyTypeDesc, a.Category, a.Community, a.Assembly, a.OptionID, a.Description",
            _ => "a.AssemblyID, a.AssemblyTypeDesc, a.Community, a.Assembly, a.Model, a.OptionID, a.Description"
        };

        var sql =
            $"SELECT {columns} " +
            "FROM tblDBAssemblyMaster a " +
            "WHERE a.DivisionID = @DivisionID AND ISNULL(a.Inactive,0) = 0 " +
            $"AND a.AssemblyType = {assemblyType}";
        if (filterModel) sql += " AND a.Model = @Model";
        return sql;
    }

    // ── Items grid edit-button dispatch (VB6 gItems_CellButtonClick) ──────
    // The STANDARD FlexKit edit button raises OnEditButtonClick; route by
    // column to the same handler the old in-cell "…" button called. args.Data
    // is the clicked row.
    private async Task OnItemEditButtonClick(CellEditButtonArgs<IntersectItemRow> args)
    {
        if (args.Data == null) return;
        switch (args.ColumnName)
        {
            case nameof(IntersectItemRow.POIndex):
                await OnPickPOIndex(args.Data);
                break;
        }
    }

    // ── In-cell PO Index picker (VB6 gItems_CellButtonClick, FIntersection.frm:561) ──
    // Opens FPickList for "PO Index" and fans the chosen value out to every
    // selected item row (VB6 loops Min(.Row,.RowSel)..Max(.Row,.RowSel)).
    private async Task ResumeItemsGridKeyboardNavigationAsync()
    {
        if (ItemsGrid == null) return;
        await InvokeAsync(StateHasChanged);
        await ItemsGrid.ResumeKeyboardNavigationAsync();
    }

    private async Task OnPickPOIndex(IntersectItemRow row)
    {
        if (pickList == null) return;
        _poPickRow = row;
        _pickContext = "POIndex";
        await pickList.Open(
            "PO Index",
            "SELECT POIndex, case when poindex=description then '' else Description end Description " +
            "FROM tblPOIndex WHERE DivisionID = @DivisionID",
            defaultItem: row.POIndex,
            parameters: new Dictionary<string, object> { ["DivisionID"] = SessionState.DivisionID });
    }

    // Unified picklist callback (VB6 FPickList.SelectedItem loops).
    private async Task OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        var ctx = _pickContext;
        _pickContext = "";

        if (ctx == "AddAssembly")
        {
            // VB6 AddAssembly loop (FIntersection.frm:719-742).
            AssemblyRow? lastAdded = null;
            foreach (var picked in selectedRows)
            {
                string Col(string name) => picked.TryGetValue(name, out var v) ? v?.ToString() ?? "" : "";
                var assemblyId = long.TryParse(Col("AssemblyID"), out var id) ? id : 0;
                if (assemblyId == 0) continue;

                if (AssembliesData.Any(a => a.AssemblyID == assemblyId && a.RowState != "delete"))
                {
                    Notifications.Info($"\"{Col("Description")}\" has already been added.");
                    continue;
                }

                var assemblyTypeDesc = Col("AssemblyTypeDesc");
                var added = new AssemblyRow
                {
                    AssemblyID = assemblyId,
                    AssemblyType = assemblyTypeDesc,
                    Community = Col("Community"),
                    Assembly = Col("Assembly"),
                    Model = Col("Model"),
                    Option = Col("OptionID"),
                    Description = Col("Description"),
                    RowState = "new"
                };
                AssembliesData.Add(added);
                if (assemblyTypeDesc != "Model") lastAdded = added;
                Dirty = true;

                // VB6: "cant prevent user from selecting 3 models at once, so only
                // accept the first." — stop after the first Model row.
                if (assemblyTypeDesc == "Model") break;
            }
            // VB6 AddAssembly sets .Row = r on each added non-Model row
            // (FIntersection.frm:740), which fires gAssemblies_BeforeSelChange and
            // re-enables the Item/Assembly toolbar buttons (frm:445-451). Mirror
            // that: the last added assembly becomes the current one (HHM-638).
            if (lastAdded != null)
            {
                SelectedAssemblyRow = lastAdded;
                mAssemblyID = lastAdded.AssemblyID;
                mAssemblyDesc = lastAdded.Description;
                ActiveGridName = "Assemblies";
            }
            StateHasChanged();
            return;
        }

        if (ctx == "POIndex")
        {
            if (selectedRows.Count > 0)
            {
                string Col(string name) => selectedRows[0].TryGetValue(name, out var v) ? v?.ToString() ?? "" : "";
                var poIndex = Col("POIndex");

                // VB6 fans the pick out to all selected item rows; fall back to the
                // clicked row when the grid has no multi-row selection.
                var targets = ItemsGrid?.GetSelectedRecords()?.Where(r => r.RowState != "delete").ToList()
                              ?? new List<IntersectItemRow>();
                if (_poPickRow != null && !targets.Contains(_poPickRow))
                    targets.Add(_poPickRow);
                if (targets.Count == 0 && _poPickRow != null)
                    targets.Add(_poPickRow);

                foreach (var t in targets)
                {
                    t.POIndex = poIndex;
                    if (t.RowState == "CLEAN") t.RowState = "dirty";
                }
                Dirty = true;
            }
            _poPickRow = null;
            StateHasChanged();
            await ResumeItemsGridKeyboardNavigationAsync();
        }
    }

    private async Task OnPickListCancelled()
    {
        _pickContext = "";
        _poPickRow = null;
        await ResumeItemsGridKeyboardNavigationAsync();
    }

