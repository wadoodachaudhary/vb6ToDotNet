    // ── HHM-528: Insert-a-Column lists ONLY legacy-captioned columns ─────
    // VB6's Choose Columns dialog (FColumns.frm:367,
    // `If .ColKey(i) <> "" And .TextMatrix(0, i) <> ""`) lists a column only when it has a
    // caption, so the caption-less utility key columns (AssemblyID / ItemID) never appear.
    // That rule now lives in GridLayoutPresenter.GetChooseColumnsSchema() for every grid —
    // this page's local copy of the filter was removed as redundant.
    private IEnumerable<ChooseColumnDescriptor>? GetAssembliesChooseColumnsSchema()
        => _assembliesGrid.GetChooseColumnsSchema();

