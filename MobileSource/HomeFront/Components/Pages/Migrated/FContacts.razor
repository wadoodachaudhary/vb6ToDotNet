@page "/contacts"
@page "/contacts/{Job}"
@rendermode InteractiveServer
@namespace HomeFront.Components.Pages
@layout HFComponent

@using System.Data
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data
@using HomeFront.Models

@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FContacts> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db

<PageTitle>Contacts - HomeFront</PageTitle>

@* IsModal: when WorkflowEstimating (or any other caller) hosts
   FContacts inline, wrap the page in a backdrop + frame so the
   caller stays visible behind it. VB6 FContacts.ShowForm was
   modal-blocking; this preserves that UX without stealing an MDI
   tab. Standalone /contacts/{Job} route navigation leaves IsModal
   false → full-page layout. Mirrors the FDBGrid/FTakeoff/FItemChart
   pattern. *@
@if (IsModal)
{
    <div class="fx-contacts-modal-backdrop"></div>
}
<div class="@(IsModal ? "fx-contacts-modal" : "")">
@if (IsModal)
{
    <div class="fx-contacts-modal-header">
        <img src="images/24/contacts.ico" class="fx-contacts-modal-icon" />
        <span class="fx-contacts-modal-title">Contacts</span>
        <button type="button" class="fx-contacts-modal-close" title="Close"
                aria-label="Close" @onclick="OnCloseClick">×</button>
    </div>
}

<div class="contacts-container @(IsModal ? "fx-contacts-modal-body" : "")">
    <div class="header-row">
        <div class="title">Contacts</div>
        <div class="job-label">Job: @Job</div>
    </div>

    <div class="section">
        <div class="section-title">Personnel</div>
        <div class="grid-block">
            <GridControl @ref="ContactsGrid"
                    TValue="ContactRow"
                    DataSource="@ContactsData"
                    AllowPaging="false"
                    AllowSorting="true"
                    AllowFiltering="false"
                    AllowResizing="true"
                    AllowSelection="true"
                    Height="220px"
                    RowHeight="22"
                    MinRowHeight="22"
                    EditSettingsRef="@contactsEditSettings"
                    SelectionSettingsRef="@selectionSettings"
                    AvailableColumns="@GetContactsChooseColumnsSchema()"
                    OnColumnsChosen="@OnContactsColumnsChosenAsync"
                    OnLayoutChanged="@OnContactsLayoutChangedAsync"
                    OnHeaderAttachmentsRequested="@OnHeaderAttachmentsRequested"
                    EventsRef="@contactsEvents">
                <GridColumnsBase @key="gContactsLayoutVersion">
                    @if (HasContactsGridLayout)
                    {
                        foreach (var entry in GetOrderedContactsGridLayout())
                        {
                            var layout = entry.Layout;
                            var fieldName = entry.Field;
                            var columnType = entry.ColumnType;
                            var textAlign = entry.TextAlign;
                            var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                            var width = layout.Width.HasValue && layout.Width.Value > 0
                                ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;
                            var allowEdit = IsContactFieldEditable(fieldName);
                            var isPickerField = IsContactPickerField(fieldName);

                            @* VB6 gContacts shows a small blue user-card glyph
                               next to the Title/Type cell (Project Manager,
                               Estimator, Purchaser). When the column is the
                               Type column, prepend the contact1.ico from
                               wwwroot/images/16/ so the rendered row matches
                               the VB6 screenshot. *@
                            if (string.Equals(fieldName, nameof(ContactRow.ContactType), StringComparison.OrdinalIgnoreCase))
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              AllowEditing="false"
                                              PrintCellIcon="GridPrintCellIcon.IdentityCard"
                                              ClipMode="ClipMode.Ellipsis">
                                    <Template>
                                        @{ var rr = (ContactRow)context; }
                                        <span class="fx-personnel-row">
                                            <img src="images/16/contact1.ico" alt="" class="fx-personnel-icon" onerror="this.style.display='none'" />
                                            <span>@rr.ContactType</span>
                                        </span>
                                    </Template>
                                </GridColumn>
                            }
                            else if (isPickerField)
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              AllowEditing="false"
                                              ShowEditButton="true"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                            else
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              AllowEditing="@allowEdit"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                        }
                    }
                    else
                    {
                        <GridColumn Field="@nameof(ContactRow.ContactType)" HeaderText="Type" Width="@ScaledColumnWidth(160)" AllowEditing="false"
                                    PrintCellIcon="GridPrintCellIcon.IdentityCard">
                            <Template>
                                @{ var rr = (ContactRow)context; }
                                <span class="fx-personnel-row">
                                    <img src="images/16/contact1.ico" alt="" class="fx-personnel-icon" onerror="this.style.display='none'" />
                                    <span>@rr.ContactType</span>
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ContactRow.ID)" HeaderText="ID" Width="@ScaledColumnWidth(70)" AllowEditing="false" ShowEditButton="true" />
                        <GridColumn Field="@nameof(ContactRow.Name)" HeaderText="Name" Width="@ScaledColumnWidth(220)" AllowEditing="false" ShowEditButton="true" />
                        <GridColumn Field="@nameof(ContactRow.Phone)" HeaderText="Phone" Width="@ScaledColumnWidth(120)" AllowEditing="false" />
                        <GridColumn Field="@nameof(ContactRow.Cell)" HeaderText="Mobile" Width="@ScaledColumnWidth(120)" AllowEditing="false" />
                        <GridColumn Field="@nameof(ContactRow.Fax)" HeaderText="Fax" Width="@ScaledColumnWidth(120)" AllowEditing="false" />
                        <GridColumn Field="@nameof(ContactRow.Email)" HeaderText="Email" Width="@ScaledColumnWidth(220)" AllowEditing="false" />
                    }
                </GridColumnsBase>
            </GridControl>
        </div>
    </div>

    <div class="section">
        <div class="section-title">Contacts</div>
        <div class="grid-block">
            <GridControl @ref="JobContactsGrid"
                    TValue="JobContactRow"
                    DataSource="@JobContactsData"
                    AllowPaging="false"
                    AllowSorting="false"
                    AllowFiltering="false"
                    AllowResizing="true"
                    AllowSelection="true"
                    Height="320px"
                    RowHeight="22"
                    MinRowHeight="22"
                    EditSettingsRef="@jobContactsEditSettings"
                    SelectionSettingsRef="@selectionSettings"
                    AvailableColumns="@GetJobContactsChooseColumnsSchema()"
                    OnColumnsChosen="@OnJobContactsColumnsChosenAsync"
                    OnLayoutChanged="@OnJobContactsLayoutChangedAsync"
                    OnHeaderAttachmentsRequested="@OnHeaderAttachmentsRequested"
                    EventsRef="@jobContactsEvents">
                <GridColumnsBase @key="gJobContactsLayoutVersion">
                    @if (HasJobContactsGridLayout)
                    {
                        foreach (var entry in GetOrderedJobContactsGridLayout())
                        {
                            var layout = entry.Layout;
                            var fieldName = entry.Field;
                            var columnType = entry.ColumnType;
                            var textAlign = entry.TextAlign;
                            var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                            var width = layout.Width.HasValue && layout.Width.Value > 0
                                ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;
                            var allowEdit = IsJobContactFieldEditable(fieldName);

                            if (IsJobContactPickerField(fieldName))
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              AllowEditing="false"
                                              ShowEditButton="true"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                            else if (string.Equals(fieldName, nameof(JobContactRow.SendVia), StringComparison.OrdinalIgnoreCase))
                            {
                                <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="@allowEdit">
                                    <Template>
                                        @{ var row = (JobContactRow)context; }
                                        <span>@GetSendViaLabel(row.SendVia)</span>
                                    </Template>
                                    <EditTemplate>
                                        @{ var row = (JobContactRow)context; }
                                        <DropDownListControl TValue="int" TItem="SendViaOption"
                                                             DataSource="@SendViaOptions"
                                                             Value="@row.SendVia"
                                                             ValueChanged="@(v => { row.SendVia = v; MarkJobContactDirty(row); })"
                                                             TextFieldName="@nameof(SendViaOption.Text)"
                                                             ValueFieldName="@nameof(SendViaOption.Value)"
                                                             OpenOnArrowClickOnly="true"
                                                             Width="100%"
                                                             CssClass="contacts-grid-edit" />
                                    </EditTemplate>
                                </GridColumn>
                            }
                            else if (string.Equals(fieldName, nameof(JobContactRow.SmsAddress), StringComparison.OrdinalIgnoreCase))
                            {
                                <GridColumn Field="@fieldName" HeaderText="@headerText" Width="@width" AllowEditing="@allowEdit">
                                    <Template>
                                        @{ var row = (JobContactRow)context; }
                                        <span>@GetSmsCarrierLabel(row.SmsAddress)</span>
                                    </Template>
                                    <EditTemplate>
                                        @{ var row = (JobContactRow)context; }
                                        <DropDownListControl TValue="string" TItem="SmsCarrier"
                                                             DataSource="@SmsCarriers"
                                                             Value="@row.SmsAddress"
                                                             ValueChanged="@(v => { row.SmsAddress = v ?? ""; MarkJobContactDirty(row); })"
                                                             TextFieldName="@nameof(SmsCarrier.Name)"
                                                             ValueFieldName="@nameof(SmsCarrier.Address)"
                                                             AllowFiltering="true"
                                                             OpenOnArrowClickOnly="true"
                                                             Width="100%"
                                                             CssClass="contacts-grid-edit" />
                                    </EditTemplate>
                                </GridColumn>
                            }
                            else
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              AllowEditing="@allowEdit"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                        }
                    }
                    else
                    {
                        <GridColumn Field="@nameof(JobContactRow.Role)" HeaderText="Role" Width="@ScaledColumnWidth(120)" AllowEditing="false" />
                        <GridColumn Field="@nameof(JobContactRow.ContactID)" HeaderText="Contact ID" Width="@ScaledColumnWidth(90)" AllowEditing="false" />
                        <GridColumn Field="@nameof(JobContactRow.Company)" HeaderText="Company" Width="@ScaledColumnWidth(180)" AllowEditing="false" />
                        <GridColumn Field="@nameof(JobContactRow.Name)" HeaderText="Name" Width="@ScaledColumnWidth(180)" AllowEditing="false" ShowEditButton="true" />
                        <GridColumn Field="@nameof(JobContactRow.Phone)" HeaderText="Phone" Width="@ScaledColumnWidth(120)" />
                        <GridColumn Field="@nameof(JobContactRow.Cell)" HeaderText="Mobile" Width="@ScaledColumnWidth(120)" />
                        <GridColumn Field="@nameof(JobContactRow.Fax)" HeaderText="Fax" Width="@ScaledColumnWidth(120)" />
                        <GridColumn Field="@nameof(JobContactRow.Email)" HeaderText="Email" Width="@ScaledColumnWidth(200)" />
                        <GridColumn Field="@nameof(JobContactRow.SendVia)" HeaderText="Send Via" Width="@ScaledColumnWidth(100)" AllowEditing="true">
                            <Template>
                                @{
                                    var row = (JobContactRow)context;
                                }
                                <span>@GetSendViaLabel(row.SendVia)</span>
                            </Template>
                            <EditTemplate>
                                @{
                                    var row = (JobContactRow)context;
                                }
                                <DropDownListControl TValue="int" TItem="SendViaOption"
                                                     DataSource="@SendViaOptions"
                                                     Value="@row.SendVia"
                                                     ValueChanged="@(v => { row.SendVia = v; MarkJobContactDirty(row); })"
                                                     TextFieldName="@nameof(SendViaOption.Text)"
                                                     ValueFieldName="@nameof(SendViaOption.Value)"
                                                     OpenOnArrowClickOnly="true"
                                                     Width="100%"
                                                     CssClass="contacts-grid-edit" />
                            </EditTemplate>
                        </GridColumn>
                        <GridColumn Field="@nameof(JobContactRow.SmsAddress)" HeaderText="SMS Provider" Width="@ScaledColumnWidth(160)" AllowEditing="true">
                            <Template>
                                @{
                                    var row = (JobContactRow)context;
                                }
                                <span>@GetSmsCarrierLabel(row.SmsAddress)</span>
                            </Template>
                            <EditTemplate>
                                @{
                                    var row = (JobContactRow)context;
                                }
                                <DropDownListControl TValue="string" TItem="SmsCarrier"
                                                     DataSource="@SmsCarriers"
                                                     Value="@row.SmsAddress"
                                                     ValueChanged="@(v => { row.SmsAddress = v ?? ""; MarkJobContactDirty(row); })"
                                                     TextFieldName="@nameof(SmsCarrier.Name)"
                                                     ValueFieldName="@nameof(SmsCarrier.Address)"
                                                     AllowFiltering="true"
                                                     OpenOnArrowClickOnly="true"
                                                     Width="100%"
                                                     CssClass="contacts-grid-edit" />
                            </EditTemplate>
                        </GridColumn>
                    }
                </GridColumnsBase>
            </GridControl>
        </div>
    </div>

    <div class="footer-bar">
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnOk">OK</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnCancel">Cancel</ButtonControl>
    </div>
</div>

@if (ShowPickDialog)
{
    <DialogControl @bind-Visible="ShowPickDialog" Width="800px" Header="@PickDialogTitle"
              IsModal="true" ShowCloseIcon="true" CloseOnEscape="true">
        <ChildContent>
            <GridControl @ref="PickGrid"
                    TValue="PickRow"
                    DataSource="@PickData"
                    AllowPaging="true"
                    AllowSorting="true"
                    AllowSelection="true"
                    Height="300px"
                    SelectionSettingsRef="@pickSelectionSettings"
                    EventsRef="@pickEvents">
                <GridColumnsBase>
                    @* VB6 FContacts.frm:457 hides PM, Phone, fax, email and cell on the
                       personnel pick, leaving only Name. *@
                    <GridColumn Field="@nameof(PickRow.Id)" HeaderText="ID" Width="90px" Visible="@(!PickIsPersonnel)" />
                    <GridColumn Field="@nameof(PickRow.Company)" HeaderText="Company" Width="200px" Visible="@(!PickIsPersonnel)" />
                    <GridColumn Field="@nameof(PickRow.Name)" HeaderText="Name" Width="160px" />
                    <GridColumn Field="@nameof(PickRow.Phone)" HeaderText="Phone" Width="120px" Visible="@(!PickIsPersonnel)" />
                    <GridColumn Field="@nameof(PickRow.Cell)" HeaderText="Cell" Width="120px" Visible="@(!PickIsPersonnel)" />
                    <GridColumn Field="@nameof(PickRow.Email)" HeaderText="Email" Width="200px" Visible="@(!PickIsPersonnel)" />
                </GridColumnsBase>
            </GridControl>
        </ChildContent>
        <FooterContent>
            <ButtonControl CssClass="fx-dialog-btn" OnClick="OnPickConfirm">OK</ButtonControl>
            <ButtonControl CssClass="fx-dialog-btn" OnClick="() => ShowPickDialog = false">Cancel</ButtonControl>
        </FooterContent>
    </DialogControl>
}
</div> @* close .fx-contacts-modal / non-modal wrapper *@

<FAttachments @ref="_attachmentsDialog" />

@code {
    [Parameter] public string? Job { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    /// <summary>When true, FContacts renders inside a backdrop+frame so
    /// the host page (e.g. WorkflowEstimating) stays visible behind it.
    /// VB6 FContacts.ShowForm was modal-blocking; this preserves that
    /// UX without stealing an MDI tab. Standalone /contacts/{Job} route
    /// navigation leaves IsModal=false → full-page layout.</summary>
    [Parameter] public bool IsModal { get; set; }

    /// <summary>Modal × header handler — same effect as Cancel
    /// (CloseAsync routes through OnClose / history.back). Save-prompt
    /// path runs first in case the user edited anything.</summary>
    private async Task OnCloseClick()
    {
        if (await SaveDataAsync(true))
            await CloseAsync();
    }
    private GridControl<ContactRow>? ContactsGrid;
    private GridControl<JobContactRow>? JobContactsGrid;
    private GridControl<PickRow>? PickGrid;
    private FAttachments? _attachmentsDialog;

    private List<ContactRow> ContactsData = new();
    private List<JobContactRow> JobContactsData = new();
    private List<SmsCarrier> SmsCarriers = new();

    private readonly List<SendViaOption> SendViaOptions = new()
    {
        new SendViaOption(1, "Print"),
        new SendViaOption(3, "Email"),
        new SendViaOption(4, "Fax")
    };

    private bool Dirty;
    private bool mIsQuote;
    private string? _loadedJob;

    private bool ShowPickDialog;
    private string PickDialogTitle = "";
    private List<PickRow> PickData = new();
    private PickRow? SelectedPick;
    private ContactRow? _pendingContactRow;
    private JobContactRow? _pendingJobContactRow;
    private bool PickIsPersonnel;

    // No Personnel column is inline-editable (IsContactFieldEditable is always false) —
    // the ellipsis picker is the only edit path, so a double-click must not swap the row
    // for an edit row, which drops the Title icon and the selection highlight.
    private readonly EditSettings contactsEditSettings = new() { AllowEditing = true, AllowAdding = false, AllowDeleting = false, ShowConfirmDialog = false, AllowEditOnDblClick = false };
    private readonly EditSettings jobContactsEditSettings = new() { AllowEditing = true, AllowAdding = false, AllowDeleting = false, ShowConfirmDialog = false };
    private readonly SelectionSettings selectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single,
        EnableToggle = true
    };
    private readonly SelectionSettings pickSelectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single,
        EnableToggle = true
    };

    private readonly GridControlEvents<ContactRow> contactsEvents = new();
    private readonly GridControlEvents<JobContactRow> jobContactsEvents = new();
    private readonly GridControlEvents<PickRow> pickEvents = new();

    // ── Grid layout via the shared GridLayoutPresenter ────────
    // The load/resolve/order/width boilerplate lives in GridLayoutPresenter<TRow>;
    // only the VB6 form/grid name strings + per-grid alias maps stay here (fidelity).
    // The members named gContactsLayout / HasContactsGridLayout / …Version below are
    // thin delegations, so the markup and the rest of this file are unchanged.
    private readonly GridLayoutPresenter<ContactRow> _contactsGrid =
        new("FContacts", "gContacts", instanceKey: "(0)",
            aliases: new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["pmname"] = nameof(ContactRow.Name),
                ["contactname"] = nameof(ContactRow.Name),
                ["workphone"] = nameof(ContactRow.Phone),
                ["cellphone"] = nameof(ContactRow.Cell)
            });
    private readonly GridLayoutPresenter<JobContactRow> _jobContactsGrid =
        new("FContacts", "gJobContacts", instanceKey: "(0)",
            aliases: new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["firstname"] = nameof(JobContactRow.Name),
                ["contactname"] = nameof(JobContactRow.Name),
                ["workphone"] = nameof(JobContactRow.Phone),
                ["cellphone"] = nameof(JobContactRow.Cell),
                ["companyname"] = nameof(JobContactRow.Company),
                ["commmodeid"] = nameof(JobContactRow.SendVia),
                ["commmode"] = nameof(JobContactRow.SendVia)
            });

    private Dictionary<string, GridLayoutColumn> gContactsLayout => _contactsGrid.Layout;
    private bool HasContactsGridLayout => _contactsGrid.Has;
    private int gContactsLayoutVersion => _contactsGrid.Version;

    private Dictionary<string, GridLayoutColumn> gJobContactsLayout => _jobContactsGrid.Layout;
    private bool HasJobContactsGridLayout => _jobContactsGrid.Has;
    private int gJobContactsLayoutVersion => _jobContactsGrid.Version;

    protected override async Task OnInitializedAsync()
    {
        contactsEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<ContactRow>>(this, OnContactsEditButton);
        contactsEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<ContactRow>>(this, OnContactsCellSave);
        jobContactsEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<JobContactRow>>(this, OnJobContactsEditButton);
        jobContactsEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<JobContactRow>>(this, OnJobContactsCellSave);
        pickEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<PickRow>>(this, OnPickRowSelected);
        await LoadGridLayoutAsync();
        await LoadSmsCarriersAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Job) && Job != _loadedJob)
        {
            _loadedJob = Job;
            await LoadDataAsync();
        }
    }

    private async Task LoadSmsCarriersAsync()
    {
        var rows = await db.QueryAsync("select address,name from smscarriers order by 2");
        SmsCarriers = rows.Select(r => new SmsCarrier
            {
                Address = r["address"]?.ToString() ?? "",
                Name = r["name"]?.ToString() ?? ""
            }).ToList();
    }

    private async Task LoadDataAsync()
    {
        if (string.IsNullOrWhiteSpace(Job)) return;

        await LoadQuoteFlagAsync();
        await LoadContactsAsync();
        await LoadJobContactsAsync();

        Dirty = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnHeaderAttachmentsRequested(string _)
    {
        if (_attachmentsDialog == null || string.IsNullOrWhiteSpace(Job))
            return;

        await _attachmentsDialog.ShowForm("Attachments", ($"J~{Job}", "Job Documents"));
    }

    private async Task LoadQuoteFlagAsync()
    {
        var rows = await db.QueryAsync(
            "select isQuote,Quote_No from tblJobs where DivisionID =@DivisionID and job_no=@Job",
            new { SessionState.DivisionID, Job });

        var first = rows.FirstOrDefault();
        if (first != null)
        {
            var quoteNo = first["Quote_No"]?.ToString() ?? "";
            var isQuote = first["IsQuote"]?.ToString() ?? "";
            mIsQuote = !string.IsNullOrEmpty(quoteNo) || isQuote.Equals("True", StringComparison.OrdinalIgnoreCase);
        }
        else
        {
            mIsQuote = false;
        }
    }

    private async Task LoadContactsAsync()
    {
        ContactsData.Clear();
        var sql = @"
SELECT 'vendor' icon,'Project Manager' ContactType,p.pm ID,p.pmname Name,p.phone,p.cell,p.fax,p.email
  FROM system_setup s
       left outer join tblJobs j on(s.id = j.DivisionID and Job_No=@Job)
       left outer JOIN tblProjectManager p ON(j.PM=p.PM)
 where s.id = @DivisionID
UNION ALL
SELECT 'vendor' icon,'Estimator' ContactType,p.pm ID,p.pmname Name,p.phone,p.cell,p.fax,p.email
  FROM system_setup s
       left outer join tblJobs j on(s.ID = j.DivisionID and Job_No=@Job)
       LEFT JOIN tblProjectManager p ON(j.Estimator=p.PM)
 where s.id = @DivisionID
UNION ALL
SELECT 'vendor' icon,'Purchaser' ContactType,p.pm ID,p.pmname Name,p.phone,p.cell,p.fax,p.email
  FROM system_setup s
       left outer join tblJobs j on(s.ID = j.DivisionID and Job_No=@Job)
       LEFT JOIN tblProjectManager p ON(j.Purchaser=p.PM)
 where s.id = @DivisionID";

        var rows = await db.QueryAsync(sql, new { SessionState.DivisionID, Job });
        foreach (var row in rows)
        {
            ContactsData.Add(new ContactRow
            {
                ContactType = row["ContactType"]?.ToString() ?? "",
                ID = row["ID"]?.ToString() ?? "",
                Name = row["Name"]?.ToString() ?? "",
                Phone = row["Phone"]?.ToString() ?? "",
                Cell = row["Cell"]?.ToString() ?? "",
                Fax = row["Fax"]?.ToString() ?? "",
                Email = row["Email"]?.ToString() ?? ""
            });
        }
    }

    private async Task LoadJobContactsAsync()
    {
        JobContactsData.Clear();

        var roles = await GetJobContactRolesAsync();
        foreach (var role in roles)
        {
            JobContactsData.Add(new JobContactRow { Role = role });
        }

        var sql = @"
select j.Role JobRole,c.*
  from jobContacts j
  join contacts c on(j.contactid=c.contactid)
 where j.Contactid<>0 and j.job=@Job";

        var dbRows = await db.QueryAsync(sql, new { Job });
        foreach (var row in dbRows)
        {
            var role = row["JobRole"]?.ToString() ?? "";
            var match = JobContactsData.FirstOrDefault(r => r.Role.Equals(role, StringComparison.OrdinalIgnoreCase));
            if (match == null)
            {
                match = new JobContactRow { Role = role };
                JobContactsData.Add(match);
            }
            match.ContactID = row["ContactID"]?.ToString() ?? "";
            match.Company = row["CompanyName"]?.ToString() ?? "";
            match.Name = row["FirstName"]?.ToString() ?? "";
            match.Phone = row["WorkPhone"]?.ToString() ?? "";
            match.Cell = row["CellPhone"]?.ToString() ?? "";
            match.Fax = row["Fax"]?.ToString() ?? "";
            match.Email = row["Email"]?.ToString() ?? "";
            match.SendVia = ToInt(row["CommModeID"]);
            match.SmsAddress = row["SmsAddress"]?.ToString() ?? "";
        }
    }

    private async Task<List<string>> GetJobContactRolesAsync()
    {
        string? roles = null;
        try
        {
            // VB6 FContacts.frm:672 — HFApp.Options.ValueByName("JobContactRoles"):
            // AppOptions uses OptionName/OptionValue columns (the old Name/Value names
            // don't exist → the query always threw → it silently fell back to a
            // FABRICATED default). The division-specific row (IN(0,@Div) ORDER BY
            // divisionid DESC) overrides the global default. VB6 has NO hardcoded
            // fallback — an empty option simply yields no roles, so we don't invent one.
            roles = await db.ExecuteScalarAsync<string>(
                @"SELECT TOP 1 OptionValue FROM AppOptions
                   WHERE OptionName='JobContactRoles' AND ISNULL(divisionid,0) IN (0,@DivisionID)
                   ORDER BY divisionid DESC",
                new { SessionState.DivisionID });
        }
        catch { /* non-critical */ }

        return (roles ?? "").Split('|', StringSplitOptions.RemoveEmptyEntries)
                    .Select(r => r.Trim())
                    .Where(r => !string.IsNullOrEmpty(r))
                    .ToList();
    }

