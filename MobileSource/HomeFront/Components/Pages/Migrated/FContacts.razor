    // ── Persist Grid Layout ──────────────────────────────────
    private Task OnContactsLayoutChangedAsync(GridSettings snapshot) =>
        PersistGridLayoutAsync("gContacts", gContactsLayout, snapshot, _contactsGrid, ResolveContactsGridField);

    private Task OnJobContactsLayoutChangedAsync(GridSettings snapshot) =>
        PersistGridLayoutAsync("gJobContacts", gJobContactsLayout, snapshot, _jobContactsGrid, ResolveJobContactsGridField);

    private async Task PersistGridLayoutAsync<TRow>(string gridName,
        IDictionary<string, GridLayoutColumn> layout, GridSettings snapshot,
        GridLayoutPresenter<TRow> presenter, Func<string, string> resolver)
    {
        if (snapshot == null || layout.Count == 0) return;
        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FContacts", gridName, instanceKey: null,
                layout, UnscaleSnapshotWidths(snapshot), resolver, staticNames: false);
            presenter.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FContacts {Grid} layout", gridName);
        }
    }

    // Columns render at ContactsColumnWidthScale times the stored layout width, so a
    // dragged pixel width has to be divided back out before it is converted and saved.
    private static GridSettings UnscaleSnapshotWidths(GridSettings snapshot)
    {
        if (snapshot.Widths == null || snapshot.Widths.Count == 0)
            return snapshot;

        return new GridSettings
        {
            ColumnOrder = snapshot.ColumnOrder,
            Visibility = snapshot.Visibility,
            HeaderOverrides = snapshot.HeaderOverrides,
            GroupColumns = snapshot.GroupColumns,
            Widths = snapshot.Widths.ToDictionary(kv => kv.Key, kv => kv.Value / ContactsColumnWidthScale)
        };
    }

    // VB6 FColumns.frm:365-374 lists every captioned column, hidden ones merely
    // unchecked. Without AvailableColumns the dialog can only offer the columns
    // already rendered, so a hidden column can never be brought back.
    private IEnumerable<ChooseColumnDescriptor>? GetContactsChooseColumnsSchema()
        => _contactsGrid.GetChooseColumnsSchema();

    private IEnumerable<ChooseColumnDescriptor>? GetJobContactsChooseColumnsSchema()
        => _jobContactsGrid.GetChooseColumnsSchema();

    private Task OnContactsColumnsChosenAsync(ChooseColumnsResult result)
        => ApplyChosenColumnsAsync("gContacts", gContactsLayout, result, _contactsGrid, ResolveContactsGridField);

    private Task OnJobContactsColumnsChosenAsync(ChooseColumnsResult result)
        => ApplyChosenColumnsAsync("gJobContacts", gJobContactsLayout, result, _jobContactsGrid, ResolveJobContactsGridField);

    private async Task ApplyChosenColumnsAsync<TRow>(string gridName,
        IDictionary<string, GridLayoutColumn> layout, ChooseColumnsResult result,
        GridLayoutPresenter<TRow> presenter, Func<string, string> resolver)
    {
        if (layout.Count == 0 || result?.Columns == null) return;
        try
        {
            await GridLayoutPersister.MergeAndSaveChooseColumnsAsync(
                GridLayoutSvc, "FContacts", gridName, instanceKey: null,
                layout, result, resolver);
            await GridLayoutSvc.FlushPendingGridLayoutsAsync();
            presenter.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to apply FContacts {Grid} column choices", gridName);
        }
    }

