    // ── Shared Grid Layout Helpers ───────────────────────────
    private const double ContactsColumnWidthScale = 1.5;

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => ScaleColumnWidth(GridLayoutPresenter.WidthPx(layoutWidth));

    private static string ScaledColumnWidth(int widthPx)
        => $"{ScaleColumnWidth(widthPx)}px";

    private static int ScaleColumnWidth(int widthPx)
        => Math.Max(1, (int)Math.Round(widthPx * ContactsColumnWidthScale));

