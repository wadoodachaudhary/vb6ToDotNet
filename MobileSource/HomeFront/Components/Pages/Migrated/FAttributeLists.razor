@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-06-12
   Source      : HFSystem/Source/FAttributeLists.frm (VB6)
   Changes     :
     - Full re-port to FlexKit (was a raw <div> overlay modal with
       hand-rolled <table>/<input>/<select>/<button>/<checkbox>).
       Now: DialogControl shell, two GridControls (gData + gValues),
       CheckBoxControl x3, ButtonControl toolbar/footer.
     - gData / gValues are STATIC design-time grids in VB6 (FormatString
       from .frx, NOT IniGetGrid/AppGridLayout) — so columns are faithfully
       hardcoded, mirroring the .frx FormatString colkeys.
     - VB6 LoadData / LoadAttributeList / SaveAttributeList / SaveData
       reproduced 1:1, incl. soft-delete (inactive=1) + insert/update of
       attributelists & attributelistvalues. All SQL parameterized.
     - gValues: trailing blank "new" row auto-grows (VB6 ValidateEdit),
       upcharge coerced to a number, Other-List combo populated from every
       list incl self (VB6 ColComboList(4) = "|#listid;name").
     - Shift+Delete / Ctrl+Del on gValues deletes the selected value row
       (VB6 gValues_KeyDown CTRL+X / CTRL+DEL block).
     - Close (X / Cancel) prompts "save changes?" Yes/No/Cancel via
       DialogControl (VB6 Form_Unload → SaveData(True)).
   ───────────────────────────────────────────────────────────────── *@
@page "/attribute-lists"
@rendermode InteractiveServer
@layout HFComponent

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Data
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using Microsoft.AspNetCore.Components.Web

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FAttributeLists> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer db

@*
    VB6 parity: HFSystem/Source/FAttributeLists.frm — "Option Attribute Lists".
    Launched either standalone (FMain "Option Attributes" → RunTask
    "EditAttributeLists", SelectedListID = 0) or modally over
    FAssemblyAttributes (RunTask "EditAttributeLists|<listid>" — scrolls the
    grid to that list). Master/detail:
      - left  : gData — list of attribute lists (only the Name column shows)
      - right : the selected list's properties (Mandatory / Restricted /
                Deferred) + gValues (Description / Upcharge / Other List).
*@

@if (IsVisible && Embedded)
{
    @* Embedded in FAssemblyAttributes (VB6 fixed-border dialog) → modal editor. *@
    <DialogControl Visible="true"
                   Header="Option Attribute Lists"
                   Width="760px"
                   Height="530px"
                   IsModal="false"
                   ShowCloseIcon="true"
                   OnClose="OnCancelClick">
        <ChildContent>@EditorBody</ChildContent>
    </DialogControl>
}
else if (IsVisible)
{
    @* Standalone Setup route ("Option Attributes") → a normal MDI window, NOT a floating
       dialog (user: should not launch as a modal in HF). Same body; OK = save + close. *@
    <div class="attrlists-page">
        <div class="attrlists-page-titlebar">Option Attribute Lists</div>
        @EditorBody
    </div>
}

@code {
    // Editor body + footer shared by both hosts (modal when Embedded, page when standalone).
    private RenderFragment EditorBody =>@<div class="attrlists-body">
                @* ── Left: attribute-lists picker (VB6 gData) ── *@
                <div class="attrlists-left">
                    <div class="attrlists-section-hdr">
                        <span>Attribute Lists</span>
                        <span class="attrlists-toolbtns">
                            <ButtonControl CssClass="attrlists-toolbtn" BareStyle="true"
                                           Title="New Attribute List" OnClick="OnNewList">
                                <img src="images/32/open.ico" alt="New" onerror="this.style.display='none'" />
                            </ButtonControl>
                            <ButtonControl CssClass="attrlists-toolbtn" BareStyle="true"
                                           Title="Delete Attribute List"
                                           Disabled="@(_selected == null)"
                                           OnClick="OnDeleteList">
                                <img src="images/16/Delete.ico" alt="Delete" onerror="this.style.display='none'" />
                            </ButtonControl>
                        </span>
                    </div>
                    <div class="attrlists-listwrap">
                        <GridControl @ref="gData"
                                     TValue="AttrListEditor"
                                     DataSource="@VisibleLists"
                                     AllowSelection="true"
                                     AllowSorting="false"
                                     AllowResizing="false"
                                     AllowFiltering="false"
                                     AutoSelectFirstRow="true"
                                     EnableHover="true"
                                     Height="100%"
                                     CssClass="attrlists-grid attrlists-left-grid"
                                     WidthMode="GridWidthMode.FitColumns"
                                     SelectionSettingsRef="@listSelectionSettings"
                                     EditSettingsRef="@listEditSettings"
                                     EventsRef="@listGridEvents">
                            <GridColumnsBase @key="_gridVersion">
                                @* VB6 gData FormatString: only "name" is visible
                                   (width 960); ListID/Required/Strict/deferred/List/Dirty
                                   are width-0 hidden helper columns. *@
                                <GridColumn Field="@nameof(AttrListEditor.Name)" HeaderText="Name"
                                            AllowEditing="true" AllowSorting="false" />
                            </GridColumnsBase>
                        </GridControl>
                    </div>
                </div>

                @* ── Right: properties + values ── *@
                <div class="attrlists-right">
                    <div class="attrlists-section-hdr"><span>List Properties</span></div>
                    <div class="attrlists-props">
                        @* VB6 chkRequired / chkStrict / chkDeferred — disabled until a list is selected. *@
                        <CheckBoxControl Checked="@(_selected?.Required ?? false)"
                                         Disabled="@(_selected == null)"
                                         CheckedChanged="OnRequiredChanged"
                                         Label="Mandatory - Sales agent must enter a value when the option is selected." />
                        <CheckBoxControl Checked="@(_selected?.Strict ?? false)"
                                         Disabled="@(_selected == null)"
                                         CheckedChanged="OnStrictChanged"
                                         Label="Restricted - The agent must select from this list of values. No other values will be allowed." />
                        <CheckBoxControl Checked="@(_selected?.Deferred ?? false)"
                                         Disabled="@(_selected == null)"
                                         CheckedChanged="OnDeferredChanged"
                                         Label="Deferred - Value selection does not have to happen immediately." />
                    </div>

                    <div class="attrlists-section-hdr"><span>Attribute Values</span></div>
                    <div class="attrlists-valueswrap" @onkeydown="OnValuesKeyDown">
                        <GridControl @ref="gValues"
                                     TValue="AttrValueEditor"
                                     DataSource="@CurrentValues"
                                     AllowSelection="true"
                                     AllowSorting="false"
                                     AllowResizing="true"
                                     AllowFiltering="false"
                                     EnableHover="true"
                                     Height="100%"
                                     CssClass="attrlists-grid attrlists-values-grid"
                                     WidthMode="GridWidthMode.FitColumns"
                                     ShowRowSelectorHandle="true"
                                     AllowRowReorder="@_valuesEnabled"
                                     RowReorderPredicate="CanReorderValueRow"
                                     RowSelectorHandleEmphasisPredicate="IsBlankValueRow"
                                     HighlightSelectedRows="false"
                                     BatchEditBehavior="GridBatchEditBehavior.SingleCell"
                                     SelectionSettingsRef="@valuesSelectionSettings"
                                     EditSettingsRef="@valuesEditSettings"
                                     EventsRef="@valuesGridEvents">
                            <GridColumnsBase @key="_valuesVersion">
                                @* VB6 gValues FormatString colkeys:
                                   ValueID(hidden) | description | upcharge(#,###.##) | OtherListID(combo). *@
                                <GridColumn Field="@nameof(AttrValueEditor.Value)" HeaderText="Description"
                                            Width="300px" AllowEditing="@_valuesEnabled" AllowSorting="false" />
                                @* HHM-553: zero must render ".00" (VB6), not blank — 3-section format forces it. *@
                                <GridColumn Field="@nameof(AttrValueEditor.UpCharge)" HeaderText="Upcharge"
                                            Width="120px" Type="ColumnType.Number" Format="#,###.##;-#,###.##;.00"
                                            TextAlign="TextAlign.Right" SelectAllOnEdit="true"
                                            AllowEditing="@_valuesEnabled" AllowSorting="false" />
                                <GridColumn Field="@nameof(AttrValueEditor.OtherListName)" HeaderText="Other List"
                                            Width="260px" EditOptions="@OtherListOptions"
                                            AllowEditing="@_valuesEnabled" AllowSorting="false" />
                            </GridColumnsBase>
                        </GridControl>
                    </div>
                    <div class="attrlists-values-footer">@EditorFooter</div>
                </div>
            </div>;

    private RenderFragment EditorFooter =>@<text>
        <ButtonControl CssClass="attrlists-nav-btn attrlists-nav-ok" OnClick="OnOkClick">OK</ButtonControl>
        <ButtonControl CssClass="attrlists-nav-btn" OnClick="OnCancelClick">Cancel</ButtonControl>
    </text>;
}

@* ── Save-prompt dialog (VB6 Form_Unload → MsgBox Yes/No/Cancel) ── *@
<DialogControl @bind-Visible="ShowSavePrompt" Header="HomeFront" Width="420px" IsModal="true" ShowCloseIcon="false">
    <ChildContent>
        <p style="margin:0 0 8px 0;">This data has changed.</p>
        <p style="margin:0;">Do you want to save these changes?</p>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="attrlists-nav-btn" OnClick="@(() => OnSavePromptResponse(true))">Yes</ButtonControl>
        <ButtonControl CssClass="attrlists-nav-btn" OnClick="@(() => OnSavePromptResponse(false))">No</ButtonControl>
        <ButtonControl CssClass="attrlists-nav-btn" OnClick="@(() => OnSavePromptResponse(null))">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    // ── Parameters (kept for the FAssemblyAttributes caller) ─────────
    [Parameter] public bool IsVisible { get; set; } = true;
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>True when hosted as a modal inside FAssemblyAttributes (VB6 fixed-border
    /// dialog). False (default) when launched standalone from the Setup menu
    /// ("Option Attributes") — standalone renders as a normal MDI page (NOT a floating
    /// dialog), and closing navigates the MDI window shut rather than only hiding.</summary>
    [Parameter] public bool Embedded { get; set; }

    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    /// <summary>VB6 ShowForm(SelectedListID) — the list to scroll to on open.
    /// 0 / -1 / unknown id means "open with no selection".</summary>
    [Parameter] public long InitialListId { get; set; } = -1;

    /// <summary>Raised after a successful save so the parent
    /// (FAssemblyAttributes) can refresh its combo boxes — VB6
    /// FAssemblyAttributes.frm:295-302 does the same reload loop.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    // ── Constants ────────────────────────────────────────────────────
    private const string SRCFILE = "FAttributeLists::";

    // ── State ────────────────────────────────────────────────────────
    private List<AttrListEditor> _lists = new();
    private AttrListEditor? _selected;
    private bool _isVisiblePrev;
    private bool _pendingListVisualSelect;
    private bool mDirty;            // VB6 mDirty
    private bool mLoading;          // VB6 mLoading (suppresses SaveAttributeList during load)

    // VB6 gValues.Enabled / chk*.Enabled — false until a real list row is selected.
    private bool _valuesEnabled;

    // @key bumps to force grid re-render after a structural change.
    private int _gridVersion;
    private int _valuesVersion;

    // ── Grid refs ────────────────────────────────────────────────────
    private GridControl<AttrListEditor>? gData;
    private GridControl<AttrValueEditor>? gValues;

    // ── Selection / edit settings ────────────────────────────────────
    private SelectionSettings listSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row,
        EnableToggle = false
    };

    // gData: editable Name column, in-cell batch edit (VB6 EditCell on the name).
    private EditSettings listEditSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch
    };

    private SelectionSettings valuesSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Cell,
        EnableToggle = false
    };

    // gValues: editable, batch (in-cell). VB6 auto-appends a blank trailing row.
    private EditSettings valuesEditSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch
    };

    private GridControlEvents<AttrListEditor> listGridEvents = new();
    private GridControlEvents<AttrValueEditor> valuesGridEvents = new();

    // ── Save-prompt dialog plumbing ──────────────────────────────────
    private bool ShowSavePrompt;
    private TaskCompletionSource<bool?>? _savePromptTcs;

    // ── Derived views bound to the grids ─────────────────────────────
    // Keep stable list instances like FDBGrid's GridData. Returning a fresh
    // List<T> from a property on every render makes GridControl interpret the
    // render as a data-source swap and clear active selection/edit state.
    private readonly List<AttrListEditor> _visibleLists = new();
    private List<AttrValueEditor> _currentValues = new();

    private List<AttrListEditor> VisibleLists => _visibleLists;

    // gValues' DataSource — the selected list's non-deleted values. The list
    // always carries a trailing blank "new" row (VB6 keeps one empty row at
    // the bottom — see EnsureTrailingBlank), so it surfaces here too.
    private List<AttrValueEditor> CurrentValues => _currentValues;

    private void RefreshVisibleLists()
    {
        _visibleLists.Clear();
        _visibleLists.AddRange(_lists.Where(l => !l.IsDeleted));
    }

    private void RefreshCurrentValues()
    {
        _currentValues = _selected == null
            ? new List<AttrValueEditor>()
            : _selected.Values.Where(v => !v.IsDeleted).ToList();
    }

    private void QueueCurrentListVisualSelect()
    {
        _pendingListVisualSelect = true;
        SelectCurrentListRowIfReady();
    }

    private void SelectCurrentListRowIfReady()
    {
        if (_selected == null || gData == null)
            return;

        var idx = VisibleLists.IndexOf(_selected);
        if (idx < 0)
            return;

        gData.SelectRow(idx);
        _pendingListVisualSelect = false;
    }

    // VB6 always shows a trailing empty row in gValues so the user can type a
    // new value. Append one when the last non-deleted row already has content
    // (or the list has no values at all).
    private static void EnsureTrailingBlank(AttrListEditor lst)
    {
        var last = lst.Values.LastOrDefault(v => !v.IsDeleted);
        if (last == null ||
            !string.IsNullOrWhiteSpace(last.Value) || last.UpCharge != 0m || last.OtherListId != 0L)
        {
            lst.Values.Add(new AttrValueEditor());
        }
    }

    private static bool IsBlankValueRow(AttrValueEditor row) =>
        row.ValueId == 0
        && string.IsNullOrWhiteSpace(row.Value)
        && row.UpCharge == 0m
        && row.OtherListId == 0L
        && string.IsNullOrWhiteSpace(row.OtherListName);

    // VB6 ColComboList(4) = "|#listid;name" — every list (including self) is a
    // candidate "Other List". Display by name; "" = none.
    private List<string> OtherListOptions =>
        new List<string> { "" }
            .Concat(VisibleLists.Select(l => l.Name))
            .ToList();

    // ── Lifecycle ────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        listGridEvents.RowSelected =
            EventCallback.Factory.Create<RowSelectEventArgs<AttrListEditor>>(this, OnListRowSelected);
        listGridEvents.OnCellSave =
            EventCallback.Factory.Create<CellSaveArgs<AttrListEditor>>(this, OnListNameSaved);

        valuesGridEvents.RowSelected =
            EventCallback.Factory.Create<RowSelectEventArgs<AttrValueEditor>>(this, OnValueRowSelected);
        valuesGridEvents.CellSelected =
            EventCallback.Factory.Create<CellSelectEventArgs<AttrValueEditor>>(this, OnValueCellSelected);
        valuesGridEvents.OnCellSave =
            EventCallback.Factory.Create<CellSaveArgs<AttrValueEditor>>(this, OnValueCellSaved);
        valuesGridEvents.RowReordering =
            EventCallback.Factory.Create<RowReorderEventArgs<AttrValueEditor>>(this, OnValueRowReordering);
        valuesGridEvents.RowReordered =
            EventCallback.Factory.Create<RowReorderEventArgs<AttrValueEditor>>(this, OnValueRowReordered);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Only (re)load on the transition false → true so user edits aren't
        // discarded when the parent re-renders for unrelated reasons.
        if (IsVisible && !_isVisiblePrev)
        {
            await LoadData();
        }
        _isVisiblePrev = IsVisible;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingListVisualSelect)
            SelectCurrentListRowIfReady();

        return Task.CompletedTask;
    }

    // ── LoadData (VB6 FAttributeLists.frm:393-439) ───────────────────
    private async Task LoadData()
    {
        mLoading = true;
        try
        {
            // VB6: single LEFT JOIN query groups attribute lists and their
            // values; sorted by name then sortorder so the visible order is
            // stable. NOTE: VB6 has both IsNull(l.inactive,0)=0 AND
            // IsNull(v.inactive,0)=0 in the WHERE — kept verbatim. (Because
            // that turns the LEFT JOIN into a near-inner join, a list with no
            // active values still appears via the leading-row logic below.)
            const string sql = @"
                select l.listid, l.name, l.required, l.strictlist strict,
                       isnull(l.deferred,0) deferred,
                       v.valueid, v.value, v.upcharge, v.otherlistid
                from attributelists l
                left outer join attributelistvalues v on l.listid = v.listid
                where IsNull(l.inactive, 0) = 0
                and IsNull(v.inactive, 0) = 0
                order by l.name, l.listid, v.sortorder";

            var rows = await db.QueryAsync(sql);

            _lists = new List<AttrListEditor>();
            AttrListEditor? current = null;
            long currentId = -999;

            foreach (var r in rows)
            {
                var lid = Convert.ToInt64(r["listid"] ?? 0L);
                if (lid != currentId)
                {
                    current = new AttrListEditor
                    {
                        ListId = lid,
                        Name = r["name"]?.ToString() ?? "",
                        Required = ToBool(r["required"]),
                        Strict = ToBool(r["strict"]),
                        Deferred = ToBool(r["deferred"])
                    };
                    _lists.Add(current);
                    currentId = lid;
                }

                // Values may all be NULL for a list with no values (the LEFT
                // JOIN row); skip those.
                if (r["valueid"] != null && r["valueid"] != DBNull.Value)
                {
                    current!.Values.Add(new AttrValueEditor
                    {
                        ValueId = Convert.ToInt64(r["valueid"] ?? 0L),
                        Value = r["value"]?.ToString() ?? "",
                        UpCharge = r["upcharge"] is null || r["upcharge"] == DBNull.Value
                            ? 0m
                            : Convert.ToDecimal(r["upcharge"]),
                        OtherListId = r["otherlistid"] is null || r["otherlistid"] == DBNull.Value
                            ? 0L
                            : Convert.ToInt64(r["otherlistid"])
                    });
                }
            }

            // Every list keeps a trailing blank value row (VB6 invariant).
            foreach (var lst in _lists)
                EnsureTrailingBlank(lst);

            // VB6 selectedrow is a Long initialized to 0. If mInitialListID is
            // absent/default, .Select(selectedrow, name) selects the first list
            // and enables gValues via RowColChange/LoadAttributeList.
            _selected = _lists.FirstOrDefault(l => l.ListId == InitialListId)
                ?? _lists.FirstOrDefault();

            // VB6 LoadData ends with mDirty = False, then LoadAttributeList
            // runs (via gData_RowColChange) to hydrate the right pane.
            mDirty = false;
            SyncSelectedNames();
            RefreshVisibleLists();
            RefreshCurrentValues();
            RefreshValuesEnabled();
            _gridVersion++;
            _valuesVersion++;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{SRCFILE}LoadData error", SRCFILE);
            Notifications.Error($"Error loading attribute lists: {ex.Message}");
            _lists = new();
            RefreshVisibleLists();
            RefreshCurrentValues();
        }
        finally
        {
            mLoading = false;
        }

        QueueCurrentListVisualSelect();
    }

    private static bool ToBool(object? v)
    {
        if (v == null || v == DBNull.Value) return false;
        if (v is bool b) return b;
        var s = v.ToString();
        if (string.IsNullOrEmpty(s)) return false;
        if (bool.TryParse(s, out var b2)) return b2;
        if (int.TryParse(s, out var i)) return i != 0;
        return false;
    }

    // ── LoadAttributeList (VB6 gData_RowColChange → LoadAttributeList) ──
    // Selecting a list hydrates the values grid + the 3 checkboxes, and
    // enables/disables them based on whether a real row is selected.
    private void RefreshValuesEnabled()
    {
        _valuesEnabled = _selected != null;
    }

    // Populate each value row's OtherListName (display) from its OtherListId.
    private void SyncSelectedNames()
    {
        foreach (var lst in _lists)
        {
            foreach (var v in lst.Values)
            {
                v.OtherListName = v.OtherListId <= 0
                    ? ""
                    : _lists.FirstOrDefault(l => l.ListId == v.OtherListId)?.Name ?? "";
            }
        }
    }

    // ── List row selection (VB6 gData_RowColChange) ──────────────────
    private void OnListRowSelected(RowSelectEventArgs<AttrListEditor> args)
    {
        // VB6 RowColChange → LoadAttributeList. No save-on-change in VB6 here
        // (SaveAttributeList runs on every edit, so the in-memory model is
        // already current); just swap the visible detail.
        _selected = args.Data;
        if (_selected != null) EnsureTrailingBlank(_selected);
        _selectedValueIndex = -1;
        RefreshCurrentValues();
        RefreshValuesEnabled();
        _valuesVersion++;
    }

    // ── New list (VB6 cmdNew_Click) ──────────────────────────────────
    private void OnNewList()
    {
        var fresh = new AttrListEditor
        {
            ListId = 0,
            Name = "New Attribute List",
            Required = false,
            Strict = false,
            Deferred = false,
            IsDirty = true
        };
        EnsureTrailingBlank(fresh);
        _lists.Add(fresh);
        _selected = fresh;
        mDirty = true;
        RefreshVisibleLists();
        RefreshCurrentValues();
        RefreshValuesEnabled();
        QueueCurrentListVisualSelect();
        _gridVersion++;
        _valuesVersion++;
    }

    // ── Delete list (VB6 cmdDelete_Click) ────────────────────────────
    private void OnDeleteList()
    {
        if (_selected == null) return;
        // VB6: hide the row, mark dirty, advance to the next visible row; if
        // none remains, disable the right pane. The DB UPDATE inactive=1
        // happens in SaveData.
        _selected.IsDeleted = true;
        _selected.IsDirty = true;
        mDirty = true;
        RefreshVisibleLists();
        _selected = VisibleLists.FirstOrDefault();
        if (_selected != null) EnsureTrailingBlank(_selected);
        _selectedValueIndex = -1;
        RefreshCurrentValues();
        RefreshValuesEnabled();
        QueueCurrentListVisualSelect();
        _gridVersion++;
        _valuesVersion++;
    }

    // ── List Name edited (VB6 gData_ValidateEdit → Dirty="True") ─────
    private void OnListNameSaved(CellSaveArgs<AttrListEditor> args)
    {
        if (args.Data == null) return;
        args.Data.Name = args.Value?.ToString() ?? "";
        args.Data.IsDirty = true;
        mDirty = true;
        // Names feed the Other-List combo — refresh both grids.
        _valuesVersion++;
    }

    // ── List Property checkboxes (VB6 chk*_Click → SaveAttributeList) ──
    private void OnRequiredChanged(bool value)
    {
        if (_selected == null || mLoading) return;
        _selected.Required = value;
        _selected.IsDirty = true;
        mDirty = true;
    }

    private void OnStrictChanged(bool value)
    {
        if (_selected == null || mLoading) return;
        _selected.Strict = value;
        _selected.IsDirty = true;
        mDirty = true;
    }

    private void OnDeferredChanged(bool value)
    {
        if (_selected == null || mLoading) return;
        _selected.Deferred = value;
        _selected.IsDirty = true;
        mDirty = true;
    }

    // ── Value row selection ──────────────────────────────────────────
    private int _selectedValueIndex = -1;

    private void OnValueRowSelected(RowSelectEventArgs<AttrValueEditor> args)
    {
        // Track the selected index for the Ctrl/Shift+Delete handler (VB6
        // gValues_KeyDown). No other VB6 behaviour on value row-change.
        _selectedValueIndex = args.RowIndex;
    }

    private void OnValueCellSelected(CellSelectEventArgs<AttrValueEditor> args)
    {
        // gValues uses cell selection for VB6-style active-cell editing; keep
        // the row index for the Ctrl/Shift+Delete handler.
        _selectedValueIndex = args.RowIndex;
    }

    private bool CanReorderValueRow(AttrValueEditor row) =>
        _valuesEnabled && !IsBlankValueRow(row);

    private void OnValueRowReordering(RowReorderEventArgs<AttrValueEditor> args)
    {
        if (_selected == null
            || !_valuesEnabled
            || args.Data == null
            || IsBlankValueRow(args.Data))
        {
            args.Cancel = true;
        }
    }

    private void OnValueRowReordered(RowReorderEventArgs<AttrValueEditor> args)
    {
        if (_selected == null || args.Data == null)
            return;

        var deleted = _selected.Values.Where(v => v.IsDeleted).ToList();
        var reorderedVisible = _currentValues
            .Where(v => !v.IsDeleted)
            .ToList();

        var realRows = reorderedVisible.Where(v => !IsBlankValueRow(v)).ToList();
        var blankRows = reorderedVisible.Where(IsBlankValueRow).Take(1).ToList();

        _selected.Values = realRows.Concat(blankRows).Concat(deleted).ToList();
        EnsureTrailingBlank(_selected);
        RefreshCurrentValues();

        _selectedValueIndex = Math.Clamp(args.NewIndex, 0, Math.Max(0, _currentValues.Count - 1));
        _selected.IsDirty = true;
        mDirty = true;
    }

    // ── Value cell saved (VB6 gValues_AfterEdit + ValidateEdit) ──────
    private void OnValueCellSaved(CellSaveArgs<AttrValueEditor> args)
    {
        if (_selected == null || args.Data == null) return;
        var row = args.Data;
        var raw = args.Value?.ToString() ?? "";

        switch (args.ColumnName)
        {
            case nameof(AttrValueEditor.Value):
                row.Value = raw;
                break;

            case nameof(AttrValueEditor.UpCharge):
                // VB6 gValues_ValidateEdit "upcharge": .EditText = Val(.EditText)
                row.UpCharge = ParseVal(raw);
                break;

            case nameof(AttrValueEditor.OtherListName):
                // Combo shows a list name; map back to its ListId (VB6 stored
                // the combo's #data = listid). "" → none (0).
                row.OtherListName = raw;
                var match = _lists.FirstOrDefault(l =>
                    !l.IsDeleted &&
                    string.Equals(l.Name, raw, StringComparison.OrdinalIgnoreCase));
                row.OtherListId = match?.ListId ?? 0L;
                break;
        }

        _selected.IsDirty = true;
        mDirty = true;

        // VB6 gValues_ValidateEdit: If Row = .Rows - 1 Then .AddItem "" — once
        // the trailing blank row gains content, grow a fresh blank row.
        var before = _selected.Values.Count;
        EnsureTrailingBlank(_selected);
        if (_selected.Values.Count != before)
        {
            RefreshCurrentValues();
            _valuesVersion++;
        }
    }

    // ── gValues key handling (VB6 gValues_KeyDown) ───────────────────
    private void OnValuesKeyDown(KeyboardEventArgs e)
    {
        if (_selected == null) return;

        // VB6: CTRL+X or CTRL+DEL → delete the selected value row(s).
        var isDelete = e.Key == "Delete" || (e.CtrlKey && (e.Key == "x" || e.Key == "X"));
        if (!isDelete || !(e.CtrlKey || e.ShiftKey)) return;

        var idx = _selectedValueIndex;
        var vals = CurrentValues;
        // VB6 guards i > 0 And i < .Rows - 1 → never the leading or the
        // trailing blank row; here that maps to a real (non-last) row.
        if (idx < 0 || idx >= vals.Count - 1) return;

        var target = vals[idx];
        OnDeleteValue(target);
    }

    private void OnDeleteValue(AttrValueEditor v)
    {
        if (_selected == null) return;
        if (v.ValueId == 0)
        {
            _selected.Values.Remove(v);   // never persisted — just drop it
        }
        else
        {
            v.IsDeleted = true;           // soft-delete handled in SaveData
        }
        _selected.IsDirty = true;
        mDirty = true;
        RefreshCurrentValues();
        _valuesVersion++;
    }

    // ── OK (VB6 cmdNav index 0: If SaveData(False) Then Unload Me) ───
    private async Task OnOkClick()
    {
        if (await SaveData(false))
        {
            await CloseDialog();
        }
    }

    // ── Cancel / X (VB6 cmdNav index 1: Unload Me → Form_Unload) ─────
    private async Task OnCancelClick()
    {
        // VB6 cmdNav(1)=Unload Me → Form_Unload calls SaveData(True), which
        // prompts "save changes?" when dirty. Cancel of that prompt aborts
        // the close.
        if (await SaveData(true))
        {
            await CloseDialog();
        }
    }

    // ── SaveData (VB6 FAttributeLists.frm:449-573) ───────────────────
    private async Task<bool> SaveData(bool prompt)
    {
        // VB6: If Not mDirty Then SaveData = True : Exit Function
        if (!mDirty) return true;

        if (prompt)
        {
            // VB6 MsgBox vbYesNoCancel.
            var resp = await ShowSavePromptDialog();
            if (resp == null) return false;   // Cancel → abort close
            if (resp == false) return true;   // No → discard, allow close
            // Yes → fall through to save
        }

        try
        {
            // 1. VB6: For each hidden (deleted) row with a real ListID →
            //    UPDATE attributelists SET inactive=1.
            foreach (var lst in _lists.Where(l => l.IsDeleted && l.ListId > 0))
            {
                await db.ExecuteAsync(
                    "update attributelists set inactive=1 where listid=@ListId",
                    new { ListId = lst.ListId });
            }

            // 2. VB6: For each Dirty row → INSERT/UPDATE the list, then
            //    soft-delete all its values and re-INSERT/UPDATE the visible
            //    ones (sortorder = position, 1-based).
            foreach (var lst in _lists.Where(l => !l.IsDeleted && l.IsDirty))
            {
                if (lst.ListId == 0)
                {
                    var newId = await db.ExecuteScalarAsync<decimal>(
                        @"insert into AttributeLists(name, required, strictlist, deferred)
                          values(@Name, @Required, @Strict, @Deferred);
                          select SCOPE_IDENTITY();",
                        new
                        {
                            Name = lst.Name ?? "",
                            Required = lst.Required,
                            Strict = lst.Strict,
                            Deferred = lst.Deferred
                        });
                    lst.ListId = (long)newId;
                }
                else
                {
                    await db.ExecuteAsync(
                        @"update AttributeLists
                          set name=@Name, required=@Required, strictlist=@Strict,
                              deferred=@Deferred, inactive=0
                          where listid=@ListId",
                        new
                        {
                            Name = lst.Name ?? "",
                            Required = lst.Required,
                            Strict = lst.Strict,
                            Deferred = lst.Deferred,
                            ListId = lst.ListId
                        });
                }

                await db.ExecuteAsync(
                    "update attributelistvalues set inactive=1 where listid=@ListId",
                    new { ListId = lst.ListId });

                int sortOrder = 1;
                foreach (var v in lst.Values)
                {
                    if (v.IsDeleted) continue;

                    // VB6: If Description <> "" Or UpCharge <> "" Then ...
                    if (string.IsNullOrWhiteSpace(v.Value) && v.UpCharge == 0m)
                        continue;

                    if (v.ValueId == 0)
                    {
                        var newVid = await db.ExecuteScalarAsync<decimal>(
                            @"insert into attributelistvalues(listid, value, upcharge, otherlistid, sortorder)
                              values(@ListId, @Value, @UpCharge, @OtherListId, @SortOrder);
                              select SCOPE_IDENTITY();",
                            new
                            {
                                ListId = lst.ListId,
                                Value = v.Value ?? "",
                                UpCharge = v.UpCharge,
                                OtherListId = v.OtherListId,
                                SortOrder = sortOrder
                            });
                        v.ValueId = (long)newVid;
                    }
                    else
                    {
                        await db.ExecuteAsync(
                            @"update attributelistvalues
                              set inactive=0, value=@Value, upcharge=@UpCharge,
                                  otherlistid=@OtherListId, sortorder=@SortOrder
                              where valueid=@ValueId",
                            new
                            {
                                ValueId = v.ValueId,
                                Value = v.Value ?? "",
                                UpCharge = v.UpCharge,
                                OtherListId = v.OtherListId,
                                SortOrder = sortOrder
                            });
                    }
                    sortOrder++;
                }

                lst.IsDirty = false;
            }

            if (OnSaved.HasDelegate) await OnSaved.InvokeAsync();
            mDirty = false;
            Notifications.Success("Attribute lists saved.");
            return true;
        }
        catch (Exception ex)
        {
            // VB6 eh: a "duplicate" name error reselects + reopens the editor
            // with a message; any other error → errHandler.
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
            {
                Notifications.Warning(
                    "You already have a list with that name. Please use a different name.");
                return false;
            }
            Logger.LogError(ex, "{SRCFILE}SaveData error", SRCFILE);
            Notifications.Error($"Save failed: {ex.Message}");
            return false;
        }
    }

    // ── Save-prompt dialog plumbing ──────────────────────────────────
    private async Task<bool?> ShowSavePromptDialog()
    {
        ShowSavePrompt = true;
        _savePromptTcs = new TaskCompletionSource<bool?>();
        StateHasChanged();
        var result = await _savePromptTcs.Task;
        ShowSavePrompt = false;
        StateHasChanged();
        return result;
    }

    private void OnSavePromptResponse(bool? response)
    {
        _savePromptTcs?.TrySetResult(response);
    }

    private async Task CloseDialog()
    {
        IsVisible = false;
        _isVisiblePrev = false;
        _selected = null;
        _lists = new();
        if (IsVisibleChanged.HasDelegate)
            await IsVisibleChanged.InvokeAsync(false);
        // Standalone launch (FMain route) → close this MDI window. When embedded in
        // FAssemblyAttributes, hiding via IsVisibleChanged above is enough — don't
        // ParentNavigate or we'd close the parent's window too.
        if (!Embedded && ParentNavigate != null)
            ParentNavigate.Invoke("");
    }

    // VB6 Val() — leading-numeric parse, returns 0 on a non-numeric string.
    private static decimal ParseVal(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return 0m;
        s = s.Trim();
        int i = 0;
        bool dot = false;
        var sb = new System.Text.StringBuilder();
        if (i < s.Length && (s[i] == '-' || s[i] == '+')) { sb.Append(s[i]); i++; }
        for (; i < s.Length; i++)
        {
            var c = s[i];
            if (char.IsDigit(c)) sb.Append(c);
            else if (c == '.' && !dot) { dot = true; sb.Append(c); }
            else break;
        }
        return decimal.TryParse(sb.ToString(), out var d) ? d : 0m;
    }

    // ── Models ───────────────────────────────────────────────────────
    public class AttrListEditor
    {
        public long ListId { get; set; }       // 0 = new (un-INSERTed)
        public string Name { get; set; } = "";
        public bool Required { get; set; }
        public bool Strict { get; set; }
        public bool Deferred { get; set; }
        public List<AttrValueEditor> Values { get; set; } = new();
        public bool IsDirty { get; set; }
        public bool IsDeleted { get; set; }
    }

    public class AttrValueEditor
    {
        public long ValueId { get; set; }      // 0 = new
        public string Value { get; set; } = "";
        public decimal UpCharge { get; set; }
        public long OtherListId { get; set; }
        public string OtherListName { get; set; } = "";   // grid combo display
        public bool IsDeleted { get; set; }
    }
}
