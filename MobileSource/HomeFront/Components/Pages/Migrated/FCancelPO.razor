@namespace HomeFront.Components.Pages
@using Fx.ControlKit
@using Fx.ControlKit.Grid

<DialogControl Visible="@_visible"
          Header="Cancel Purchase Order"
          Width="550px"
          IsModal="true"
          ShowCloseIcon="true"
          CloseOnEscape="true"
          OnClose="HandleCancel">
    <ChildContent>
        <div class="cancel-po-body">
            <div class="cancel-po-header">
                <img src="images/32/warning.ico" alt="Warning" class="cancel-po-icon" />
                <span class="cancel-po-label">What is the reason for cancelling the purchase order?</span>
            </div>
            <TextBoxControl @bind-Value="_reason"
                       Multiline="true"
                       Rows="6"
                       CssClass="cancel-po-text"
                       Placeholder="Enter reason..." />
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="HandleOk">OK</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="HandleCancel">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    private bool _visible;
    private string _reason = "";
    private TaskCompletionSource<bool>? _tcs;

    public string Reason => _reason;

    public Task<bool> ShowAsync(string reason)
    {
        _reason = reason ?? "";
        _visible = true;
        _tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _tcs.Task;
    }

    private Task HandleOk()
    {
        _visible = false;
        _tcs?.TrySetResult(true);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task HandleCancel()
    {
        _visible = false;
        _tcs?.TrySetResult(false);
        StateHasChanged();
        return Task.CompletedTask;
    }
}

