```razor
@using HomeFront.Components.Hf

<HfDialog Visible="@_visible"
          Header="Cancel Purchase Order"
          Width="550px"
          IsModal="true"
          ShowCloseIcon="true"
          CloseOnEscape="true"
          OnClose="HandleCancel">
    <ChildContent>
        <div class="cancel-po-body">
            <div class="cancel-po-header">
                <img src="images/32/warning.ico" alt="Warning" class="cancel-po-icon" />
                <span class="cancel-po-label">What is the reason for cancelling the purchase order?</span>
            </div>
            <HfTextBox @bind-Value="_reason"
                       Multiline="true"
                       Rows="6"
                       CssClass="cancel-po-text"
                       Placeholder="Enter reason..." />
        </div>
    </ChildContent>
    <FooterContent>
        <HfButton CssClass="hf-dialog-btn hf-primary" OnClick="HandleOk">OK</HfButton>
        <HfButton CssClass="hf-dialog-btn" OnClick="HandleCancel">Cancel</HfButton>
    </FooterContent>
</HfDialog>

@code {
    private bool _visible;
    private string _reason = "";
    private TaskCompletionSource<bool>? _tcs;

    public string Reason => _reason;

    public Task<bool> ShowAsync(string reason)
    {
        _reason = reason ?? "";
        _visible = true;
        _tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _tcs.Task;
    }

    private Task HandleOk()
    {
        _visible = false;
        _tcs?.TrySetResult(true);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task HandleCancel()
    {
        _visible = false;
        _tcs?.TrySetResult(false);
        StateHasChanged();
        return Task.CompletedTask;
    }
}

<style>
    .cancel-po-body {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .cancel-po-header {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
    }

    .cancel-po-icon {
        width: 32px;
        height: 32px;
    }

    .cancel-po-text {
        width: 100%;
    }
</style>
