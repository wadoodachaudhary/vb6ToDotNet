@namespace HomeFront.Components.Pages
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using HomeFront.Data
@using System.Globalization
@inject ILogger<FBilling> Logger
@inject NotificationService Notifications
@inject NavigationManager Nav
@inject DbWrapperSqlServer db

@*
    FBilling — Contract / Schedule-of-Values + Invoices view.

    VB6 frmBilling (FEstimateItems.frm:411-770) is shown when the user picks
    the "Contract" pseudo-view from the View menu. Layout:

        ┌───────────────────────────────┬──────────────────────┐
        │  Contract / Schedule-of-Values │  Contract & Billing  │
        │  grid (gContract)             │  Tasks panel         │
        │                               │  (frmBillingTasks)   │
        ├───────────────────────────────┤                      │
        │  Invoices grid (gInvoices)    │                      │
        └───────────────────────────────┴──────────────────────┘

    Hosted as a component (no @page route) so FEstimateItems can drop it
    into the same fest-modal frame used for the Addons pseudo-view.
*@

<div class="fbilling-root">
    <div class="fbilling-main">
        <div class="fbilling-section">
            <div class="fbilling-section-header">Schedule of Values</div>
            @if (_sovStatus == FBillingLoadStatus.Error)
            {
                <div class="fbilling-empty-banner fbilling-error-banner">
                    Failed to load SOV: @_sovError
                </div>
            }
            else if (_sovStatus == FBillingLoadStatus.Empty)
            {
                <div class="fbilling-empty-banner">
                    No schedule-of-values items for this job yet. Click
                    <strong>"Add items to the schedule of values"</strong>
                    in the tasks panel to populate it.
                </div>
            }
            <GridControl TValue="ContractRow"
                         DataSource="@ContractRows"
                         AllowSelection="true"
                         AllowSorting="true"
                         AllowResizing="true"
                         AllowFiltering="false"
                         Height="280px"
                         RowHeight="22"
                         SelectionSettingsRef="@_contractSelection"
                         EventsRef="@_contractEvents">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(ContractRow.Description)"  HeaderText="Description"  Width="240px" AllowEditing="false" />
                    <GridColumn Field="@nameof(ContractRow.CostCode)"     HeaderText="Cost Code"    Width="90px"  AllowEditing="false" />
                    <GridColumn Field="@nameof(ContractRow.Category)"     HeaderText="Category"     Width="80px"  AllowEditing="false" />
                    <GridColumn Field="@nameof(ContractRow.Budget)"       HeaderText="Budget"       Width="100px" Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(ContractRow.Changes)"      HeaderText="Changes"      Width="100px" Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(ContractRow.Committed)"    HeaderText="Committed"    Width="100px" Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(ContractRow.Price)"        HeaderText="Price"        Width="100px" Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(ContractRow.Billed)"       HeaderText="Billed"       Width="100px" Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(ContractRow.PercentComplete)" HeaderText="% Complete" Width="80px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(ContractRow.Remaining)"    HeaderText="Remaining"    Width="100px" Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(ContractRow.HoldbackRate)" HeaderText="HB Rate %"    Width="80px"  Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(ContractRow.TaxGroup)"     HeaderText="Tax Group"    Width="80px"  AllowEditing="false" />
                    <GridColumn Field="@nameof(ContractRow.RevenueAccount)" HeaderText="Revenue Acct" Width="100px" AllowEditing="false" />
                </GridColumnsBase>
            </GridControl>
        </div>

        <div class="fbilling-section">
            <div class="fbilling-section-header">Invoices</div>
            <GridControl TValue="InvoiceRow"
                         DataSource="@InvoiceRows"
                         AllowSelection="true"
                         AllowSorting="true"
                         AllowResizing="true"
                         AllowFiltering="false"
                         Height="220px"
                         RowHeight="22"
                         SelectionSettingsRef="@_invoiceSelection"
                         EventsRef="@_invoiceEvents">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(InvoiceRow.InvoiceNumber)" HeaderText="Invoice #"   Width="90px"  AllowEditing="false" />
                    <GridColumn Field="@nameof(InvoiceRow.InvoiceDate)"   HeaderText="Date"        Width="100px" Format="d" AllowEditing="false" />
                    <GridColumn Field="@nameof(InvoiceRow.Description)"   HeaderText="Description" Width="240px" AllowEditing="false" />
                    <GridColumn Field="@nameof(InvoiceRow.Status)"        HeaderText="Status"      Width="90px"  AllowEditing="false" />
                    <GridColumn Field="@nameof(InvoiceRow.IsRetainage)"   HeaderText="Retainage?"  Width="90px"  Type="ColumnType.CheckBox" AllowEditing="false" />
                    <GridColumn Field="@nameof(InvoiceRow.Draw)"          HeaderText="Draw #"      Width="70px"  Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(InvoiceRow.Amount)"        HeaderText="Amount"      Width="100px" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(InvoiceRow.Holdback)"      HeaderText="Holdback"    Width="90px"  Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                    <GridColumn Field="@nameof(InvoiceRow.PostedDate)"    HeaderText="Posted"      Width="100px" Format="d" AllowEditing="false" />
                    <GridColumn Field="@nameof(InvoiceRow.PostedBy)"      HeaderText="Posted By"   Width="100px" AllowEditing="false" />
                </GridColumnsBase>
            </GridControl>
        </div>
    </div>

    @* Right-side tasks panel — mirrors VB6 frmBillingTasks (line 527).
       Each row is a clickable link with an icon glyph. Stub handlers
       surface as notifications for now since the underlying VB6 dialogs
       (FCreateContract, FCreateInvoice, etc.) aren't migrated yet. *@
    <div class="fbilling-tasks">
        <div class="fbilling-tasks-header">Contract and Billing Tasks:</div>
        <div class="fbilling-task" @onclick="OnEditAddons">
            <span class="fbilling-task-icon">📝</span>
            <span class="fbilling-task-link">Edit the job addons</span>
        </div>
        <div class="fbilling-task" @onclick="OnAddSovItems">
            <span class="fbilling-task-icon">➕</span>
            <span class="fbilling-task-link">Add items to the schedule of values</span>
        </div>
        <div class="fbilling-task" @onclick="OnApproveChangeRequests">
            <span class="fbilling-task-icon">✅</span>
            <span class="fbilling-task-link">Approve requests and create a change orders</span>
        </div>
        <div class="fbilling-task" @onclick="OnGenerateInvoice">
            <span class="fbilling-task-icon">🧾</span>
            <span class="fbilling-task-link">Generate a new invoice</span>
        </div>
        <div class="fbilling-task" @onclick="OnPreviewInvoice">
            <span class="fbilling-task-icon">👁</span>
            <span class="fbilling-task-link">Preview the selected invoice</span>
        </div>
        <div class="fbilling-task" @onclick="OnPostInvoice">
            <span class="fbilling-task-icon">📤</span>
            <span class="fbilling-task-link">Post the selected invoice to accounting</span>
        </div>
        <div class="fbilling-task" @onclick="OnCreateRetainageInvoice">
            <span class="fbilling-task-icon">💰</span>
            <span class="fbilling-task-link">Create Retainage/Holdback Invoice</span>
        </div>

        @if (SelectedInvoice != null)
        {
            <div class="fbilling-tasks-footer">
                <div><strong>Selected:</strong> @SelectedInvoice.InvoiceNumber</div>
                <div>@SelectedInvoice.Status — @SelectedInvoice.Amount.ToString("C2", CultureInfo.CurrentCulture)</div>
                @if (SelectedInvoice.IsRetainage)
                {
                    <div style="color:#1d4ed8;">Retainage / Holdback invoice</div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Job { get; set; } = "";
    [Parameter] public int DivisionId { get; set; } = 1;

    private List<ContractRow> ContractRows = new();
    private List<InvoiceRow> InvoiceRows = new();
    private InvoiceRow? SelectedInvoice;
    private string _lastJob = "";

    private readonly SelectionSettings _contractSelection = new() { Mode = SelectionMode.Row, Type = SelectionType.Single };
    private readonly SelectionSettings _invoiceSelection  = new() { Mode = SelectionMode.Row, Type = SelectionType.Single };
    private readonly GridControlEvents<ContractRow> _contractEvents = new();
    private readonly GridControlEvents<InvoiceRow>  _invoiceEvents  = new();

    protected override void OnInitialized()
    {
        _invoiceEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<InvoiceRow>>(this, OnInvoiceSelected);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_lastJob, Job, StringComparison.OrdinalIgnoreCase))
        {
            _lastJob = Job ?? "";
            await LoadDataAsync();
        }
    }

    // VB6 LoadContract (FEstimateItems.frm:12920+) and LoadInvoiceHistory
    // (FEstimateItems.frm:12988+). Real table names are `billingitems`
    // (Schedule of Values) and `arinvoices`/`arinvoiceitems` (Invoice
    // history). The VB6 query joins the SOV row to estimateditems +
    // glaccounts so the grid shows budgeted/changes/committed/account on
    // the same row — we mirror that here.
    // Tracks where each grid landed so the UI / console can tell the
    // difference between "table empty for this job", "SQL failed", and
    // "rows loaded successfully".
    private enum FBillingLoadStatus { NotLoaded, Empty, Error, Loaded }
    private FBillingLoadStatus _sovStatus = FBillingLoadStatus.NotLoaded;
    private FBillingLoadStatus _invStatus = FBillingLoadStatus.NotLoaded;
    private string? _sovError;
    private string? _invError;

    private async Task LoadDataAsync()
    {
        ContractRows.Clear();
        InvoiceRows.Clear();
        SelectedInvoice = null;
        _sovStatus = FBillingLoadStatus.NotLoaded;
        _invStatus = FBillingLoadStatus.NotLoaded;
        _sovError  = null;
        _invError  = null;

        if (string.IsNullOrWhiteSpace(Job)) return;

        // Sentinel COUNT against the raw table — distinguishes
        // "table really has 0 rows for this job" from "the JOIN/GROUP BY
        // dropped everything". Logged so devs can see the truth at a glance.
        try
        {
            const string countSql = "SELECT COUNT(*) FROM billingitems WHERE job = @Job";
            Console.WriteLine($"[FBilling][SOV-Probe] {InlineSql(countSql, new() { ["@Job"] = Job })}");
            var rawCount = await db.ExecuteScalarAsync<int>(countSql, new { Job });
            Console.WriteLine($"[FBilling][SOV-Probe] billingitems raw count for job '{Job}' = {rawCount}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FBilling][SOV-Probe] FAILED: {ex.Message}");
        }

        try
        {
            // Mirrors VB6 FEstimateItems.frm:12920-12947.
            var contractSql = @"
                SELECT  b.BillingItemID,
                        b.Description,
                        b.CostCode,
                        b.Category,
                        SUM(CASE WHEN ISNULL(i.IsChange,0)=0 AND ISNULL(i.BudgetDeleted,0)<>1
                                 THEN ISNULL(i.BudgetPretax,0) + ISNULL(i.BudgetJCTax,0) ELSE 0 END) AS Budget,
                        SUM(CASE WHEN ISNULL(i.IsChange,0)=1 AND ISNULL(i.BudgetDeleted,0)<>1
                                 THEN ISNULL(i.BudgetPretax,0) + ISNULL(i.BudgetJCTax,0) ELSE 0 END) AS Changes,
                        SUM(CASE WHEN ISNULL(i.POGenBatch,0)=0 OR ISNULL(i.PODeleted,0)=1
                                 THEN 0 ELSE ISNULL(i.POPretax,0) + ISNULL(i.POJCTax,0) END) AS Commited,
                        b.Price,
                        ISNULL(b.amtbilled,0) AS Billed,
                        ISNULL(b.HoldbackRate,0) AS HoldbackRate,
                        ISNULL(b.HoldbackTotalHeld,0) AS HoldbackTotalHeld,
                        b.TaxGroup,
                        a.account     AS RevenueAccount,
                        a.description AS RevenueAccountDesc
                   FROM billingitems b
                   LEFT OUTER JOIN estimateditems i ON b.BillingItemID = i.BillingItemID
                   LEFT OUTER JOIN glaccounts a     ON a.DivisionID    = @DivisionID
                                                  AND b.revenueaccount = a.account
                  WHERE b.job = @Job
                  GROUP BY b.BillingItemID, b.Description, b.CostCode, b.Category, b.Price,
                           b.SortOrder, b.amtbilled, b.HoldbackRate, b.HoldbackTotalHeld,
                           b.TaxGroup, a.Account, a.description
                  ORDER BY b.SortOrder, b.Description";
            // Print the executable SQL (with literal params substituted) so it
            // can be copied straight into SSMS. Helps verify whether the same
            // DB really returns the rows VB6 sees.
            Console.WriteLine($"[FBilling][SOV] {InlineSql(contractSql, new() { ["@DivisionID"] = DivisionId, ["@Job"] = Job })}");
            var contractDt = await db.QueryAsync(contractSql, new { DivisionID = DivisionId, Job });
            Console.WriteLine($"[FBilling][SOV] returned {contractDt.Count} row(s)");
            foreach (var row in contractDt)
            {
                ContractRows.Add(new ContractRow
                {
                    BillingItemID  = row["BillingItemID"]?.ToString() ?? "",
                    Description    = row["Description"]?.ToString() ?? "",
                    CostCode       = row["CostCode"]?.ToString() ?? "",
                    Category       = row["Category"]?.ToString() ?? "",
                    Budget         = ToDouble(row["Budget"]),
                    Changes        = ToDouble(row["Changes"]),
                    Committed      = ToDouble(row["Commited"]),
                    Price          = ToDouble(row["Price"]),
                    Billed         = ToDouble(row["Billed"]),
                    HoldbackRate   = ToDouble(row["HoldbackRate"]),
                    HoldbackHeld   = ToDouble(row["HoldbackTotalHeld"]),
                    TaxGroup       = row["TaxGroup"]?.ToString() ?? "",
                    RevenueAccount = row["RevenueAccount"]?.ToString() ?? "",
                    RevenueAccountDesc = row["RevenueAccountDesc"]?.ToString() ?? ""
                });
            }
            _sovStatus = ContractRows.Count > 0 ? FBillingLoadStatus.Loaded : FBillingLoadStatus.Empty;
        }
        catch (Exception ex)
        {
            _sovStatus = FBillingLoadStatus.Error;
            _sovError  = ex.Message;
            Console.WriteLine($"[FBilling][SOV] ERROR: {ex.Message}");
            Logger.LogWarning(ex, "FBilling: billingitems query failed for {Job}", Job);
        }

        try
        {
            // Mirrors VB6 FEstimateItems.frm:12988-13003 (LoadInvoiceHistory).
            var invoiceSql = @"
                SELECT  m.invoice,
                        m.invoicedate,
                        m.description,
                        ISNULL(m.RetainageInvoice,0) AS RetainageInvoice,
                        ISNULL(m.draw,0) AS Draw,
                        m.PostedDate,
                        ISNULL(m.PostedBy,'') AS PostedBy,
                        ISNULL(m.Cancelled,0) AS Cancelled,
                        SUM(ISNULL(d.amtthisperiod,0)) AS Amount,
                        SUM(ISNULL(d.holdbackamount,0)) AS Holdback,
                        SUM(CASE WHEN ISNULL(m.RetainageInvoice,0)=1
                                 THEN ISNULL(d.holdbackamount,0) ELSE 0 END) AS HoldbackBilled
                   FROM arinvoices m
                   JOIN arinvoiceitems d ON m.invoice = d.invoice
                  WHERE m.DivisionID = @DivisionID
                    AND m.job        = @Job
                  GROUP BY m.invoice, m.invoicedate, m.description,
                           m.RetainageInvoice, m.draw, m.PostedDate, m.PostedBy, m.Cancelled
                  ORDER BY m.Invoice DESC";
            Console.WriteLine($"[FBilling][INV] {InlineSql(invoiceSql, new() { ["@DivisionID"] = DivisionId, ["@Job"] = Job })}");
            var invoiceDt = await db.QueryAsync(invoiceSql, new { DivisionID = DivisionId, Job });
            Console.WriteLine($"[FBilling][INV] returned {invoiceDt.Count} row(s)");
            foreach (var row in invoiceDt)
            {
                var cancelled = ToBool(row["Cancelled"]);
                var posted    = row["PostedDate"] is DateTime;
                InvoiceRows.Add(new InvoiceRow
                {
                    InvoiceNumber = row["invoice"]?.ToString() ?? "",
                    InvoiceDate   = row["invoicedate"] as DateTime?,
                    Description   = row["description"]?.ToString() ?? "",
                    Draw          = ToDouble(row["Draw"]),
                    Amount        = ToDouble(row["Amount"]),
                    Holdback      = ToDouble(row["Holdback"]),
                    HoldbackBilled = ToDouble(row["HoldbackBilled"]),
                    IsRetainage   = ToBool(row["RetainageInvoice"]),
                    Status        = cancelled ? "Cancelled" : posted ? "Posted" : "Open",
                    PostedDate    = row["PostedDate"] as DateTime?,
                    PostedBy      = row["PostedBy"]?.ToString() ?? ""
                });
            }
            _invStatus = InvoiceRows.Count > 0 ? FBillingLoadStatus.Loaded : FBillingLoadStatus.Empty;
        }
        catch (Exception ex)
        {
            _invStatus = FBillingLoadStatus.Error;
            _invError  = ex.Message;
            Console.WriteLine($"[FBilling][INV] ERROR: {ex.Message}");
            Logger.LogWarning(ex, "FBilling: arinvoices query failed for {Job}", Job);
        }
    }

    // Renders a SQL string with @-prefixed params replaced by literal values
    // (with strings quoted, single-quotes escaped). Strictly for console
    // diagnostics — never feed the result back to the database.
    private static string InlineSql(string sql, Dictionary<string, object?> parameters)
    {
        var s = sql;
        // Substitute longer names first so @JobNo isn't truncated to @Job + "No".
        foreach (var kv in parameters.OrderByDescending(p => p.Key.Length))
        {
            string literal;
            if (kv.Value == null || kv.Value == DBNull.Value)
                literal = "NULL";
            else if (kv.Value is string ss)
                literal = "'" + ss.Replace("'", "''") + "'";
            else if (kv.Value is bool bb)
                literal = bb ? "1" : "0";
            else if (kv.Value is DateTime dt)
                literal = "'" + dt.ToString("yyyy-MM-dd HH:mm:ss") + "'";
            else
                literal = Convert.ToString(kv.Value, CultureInfo.InvariantCulture) ?? "NULL";
            s = s.Replace(kv.Key, literal);
        }
        // Collapse leading whitespace per line so the console output stays narrow.
        return string.Join(" ",
            s.Split('\n').Select(l => l.Trim()).Where(l => l.Length > 0));
    }

    private static bool ToBool(object? o)
    {
        if (o == null || o == DBNull.Value) return false;
        if (o is bool b) return b;
        if (o is int i) return i != 0;
        if (bool.TryParse(o.ToString(), out var bv)) return bv;
        if (int.TryParse(o.ToString(), out var iv)) return iv != 0;
        return false;
    }

    private void OnInvoiceSelected(RowSelectEventArgs<InvoiceRow> args)
    {
        SelectedInvoice = args.Data;
    }

    // VB6 lblTask click handlers (FEstimateItems.frm:4205-4229). Each task
    // in VB6 calls a sub-form; we route to the migrated equivalents:
    //   Task 0 (Add SOV)        → FCreateContract.Edit(False, mJob)
    //   Task 1 (Approve CRs)    → FCreateContract.Edit(True, mJob)
    //   Task 2 (Generate inv.)  → FCreateInvoice.Edit(mJob)
    //   Task 3 (Edit addons)    → FAddons (Addons view in FEstimateItems)
    //   Task 4 (Preview inv.)   → mnuInvoicesSub_Click(mcINV_PREVIEW)
    //   Task 5 (Post inv.)      → mnuInvoicesSub_Click(mcINV_POST)
    //   Task 6 (Retainage inv.) → FCreateHBInvoice.Edit(mJob)
    private bool RequireJob()
    {
        if (string.IsNullOrWhiteSpace(Job))
        {
            Notifications.Warning("Open a Job first.");
            return false;
        }
        return true;
    }

    private void OnEditAddons() =>
        Notifications.Info("Switch to the Addons view from the View menu in Issue Jobs.");

    private void OnAddSovItems()
    {
        if (!RequireJob()) return;
        Nav.NavigateTo($"/create-contract?job={Uri.EscapeDataString(Job)}&changeOrder=false");
    }

    private void OnApproveChangeRequests()
    {
        if (!RequireJob()) return;
        Nav.NavigateTo($"/create-contract?job={Uri.EscapeDataString(Job)}&changeOrder=true");
    }

    private void OnGenerateInvoice()
    {
        if (!RequireJob()) return;
        Nav.NavigateTo($"/create-invoice/{Uri.EscapeDataString(Job)}");
    }

    private void OnPreviewInvoice()
    {
        if (SelectedInvoice == null) { Notifications.Info("Select an invoice first."); return; }
        // Crystal report viewer — passes Invoice + Job through query string;
        // FRptViewer picks them up via the report's ParameterValue pass-through.
        Nav.NavigateTo($"/report-viewer/Invoice?Invoice={Uri.EscapeDataString(SelectedInvoice.InvoiceNumber)}&Job={Uri.EscapeDataString(Job)}");
    }

    private void OnPostInvoice()
    {
        if (SelectedInvoice == null) { Notifications.Info("Select an invoice first."); return; }
        // VB6 mcINV_POST flips arinvoices.PostingBatch to a new batch number
        // and writes to the accounting system. The accounting bridge isn't
        // migrated yet — leave as a notification so the link is discoverable.
        Notifications.Info($"Post invoice {SelectedInvoice.InvoiceNumber} — accounting integration pending.");
    }

    private void OnCreateRetainageInvoice()
    {
        if (!RequireJob()) return;
        // VB6 line 4225-4227: FCreateHBInvoice.Edit(mJob). Page route already
        // accepts {Job} as a path parameter.
        Nav.NavigateTo($"/create-hb-invoice/{Uri.EscapeDataString(Job)}");
    }

    private static double ToDouble(object? o)
    {
        if (o == null || o == DBNull.Value) return 0;
        return Convert.ToDouble(o, CultureInfo.InvariantCulture);
    }

    public class ContractRow
    {
        public string BillingItemID { get; set; } = "";
        public string Description { get; set; } = "";
        public string CostCode { get; set; } = "";
        public string Category { get; set; } = "";
        public double Budget { get; set; }
        public double Changes { get; set; }
        public double Committed { get; set; }
        public double Price { get; set; }
        public double Billed { get; set; }
        public double HoldbackRate { get; set; }
        public double HoldbackHeld { get; set; }
        public string TaxGroup { get; set; } = "";
        public string RevenueAccount { get; set; } = "";
        public string RevenueAccountDesc { get; set; } = "";
        public double Remaining => Price - Billed;
        public double PercentComplete => Price == 0 ? 0 : Math.Round(Billed / Price * 100, 2);
    }

    public class InvoiceRow
    {
        public string InvoiceNumber { get; set; } = "";
        public DateTime? InvoiceDate { get; set; }
        public string Description { get; set; } = "";
        public double Draw { get; set; }
        public double Amount { get; set; }
        public double Holdback { get; set; }
        public double HoldbackBilled { get; set; }
        public bool IsRetainage { get; set; }
        public string Status { get; set; } = "";
        public DateTime? PostedDate { get; set; }
        public string PostedBy { get; set; } = "";
        // Convenience for older bindings.
        public double Total => Amount;
    }
}
