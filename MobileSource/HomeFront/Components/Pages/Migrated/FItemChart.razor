    // ── Dimension-column helpers (HHM-237) ──────────────────────────────
    // VB6 ConfigDimensions recomputes ColHidden + the header caption of the
    // D1/D2/D3 columns from the assigned variables on every load/variable
    // change (FItemChart.frm:733-764) — the saved grid layout never wins for
    // them. These map a resolved field name to that runtime state so the
    // layout-driven column loop can apply the same override.
    private static int DimensionIndexOf(string field)
    {
        if (string.Equals(field, nameof(ItemChartDetailRow.D1), StringComparison.OrdinalIgnoreCase)) return 1;
        if (string.Equals(field, nameof(ItemChartDetailRow.D2), StringComparison.OrdinalIgnoreCase)) return 2;
        if (string.Equals(field, nameof(ItemChartDetailRow.D3), StringComparison.OrdinalIgnoreCase)) return 3;
        return 0;
    }

    private bool GetDimensionVisible(int index) => index switch
    {
        1 => D1Visible,
        2 => D2Visible,
        3 => D3Visible,
        _ => true
    };

    private string GetDimensionHeader(int index) => index switch
    {
        1 => D1Header,
        2 => D2Header,
        3 => D3Header,
        _ => ""
    };

    // ── Load Data ────────────────────────────────────────────────────────
    private async Task LoadData()
    {
        try
        {
            // Load master
            var masterRows = await db.QueryAsync(
                "SELECT * FROM itemcharts WHERE name=@Name",
                new { Name = mChart });

            if (!masterRows.Any())
            {
                txtName = "";
                txtFormula = "";
                Variable1 = "";
                Variable2 = "";
                Variable3 = "";
            }
            else
            {
                var m = masterRows.First();
                txtName = m["Name"]?.ToString() ?? "";
                txtFormula = m["Formula"]?.ToString() ?? "";
                Variable1 = m["Variable1"]?.ToString() ?? "";
                Variable2 = m["Variable2"]?.ToString() ?? "";
                Variable3 = m["Variable3"]?.ToString() ?? "";
            }

            ConfigDimensions();

            // Load details
            GridData.Clear();
            var detailSql = @"
                SELECT i.*, d.description
                FROM itemchartdetails i
                JOIN tblphaseitem d ON (d.DivisionID = @DivisionID AND i.phase = d.phase AND i.item = d.item)
                WHERE name = @Name";
            var detailRows = await db.QueryAsync(detailSql, new { SessionState.DivisionID, Name = mChart });

            int idx = 0;
            foreach (var r in detailRows)
            {
                GridData.Add(new ItemChartDetailRow
                {
                    RowIndex = idx++,
                    D1 = r["Dimension1"]?.ToString() ?? "",
                    D2 = r["Dimension2"]?.ToString() ?? "",
                    D3 = r["Dimension3"]?.ToString() ?? "",
                    Phase = r["Phase"]?.ToString() ?? "",
                    Item = r["Item"]?.ToString() ?? "",
                    Description = r["Description"]?.ToString() ?? ""
                });
            }

            EnsureEmptyRow();
            mDirty = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadData error");

        }
    }

    // ── Save Data ────────────────────────────────────────────────────────
    private async Task<bool> SaveData(bool prompt)
    {
        if (!mDirty) return true;

        if (prompt)
        {
            // In-app MessageBox (Yes/No/Cancel) replaces the browser dialog
            // so Save flows match FAssembly's UX. Falls back to confirm() only
            // if _messageBox isn't wired (defensive — shouldn't happen).
            var result = _messageBox != null
                ? await _messageBox.ShowAsync(
                    "Item Chart has changed.\n\nDo you want to save these changes?",
                    title: "Save changes?",
                    buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel)
                : (await Dialogs.ConfirmAsync(
                        "Item Chart has changed.\n\nDo you want to save these changes?")
                    ? Fx.ControlKit.Dialogs.MessageBoxResult.Yes
                    : Fx.ControlKit.Dialogs.MessageBoxResult.No);

            if (result == Fx.ControlKit.Dialogs.MessageBoxResult.Cancel) return false;
            if (result == Fx.ControlKit.Dialogs.MessageBoxResult.No) return true;
            // Yes → fall through to the save logic below.
        }

        // Validate
        txtName = txtName.Trim();
        if (string.IsNullOrWhiteSpace(txtName))
        {
            Notifications.Info("Chart name is required.");
            return false;
        }
        if (string.IsNullOrWhiteSpace(Variable1))
        {
            Notifications.Warning("At least one variable must be specified.");
            return false;
        }

        // Validate rows (all except last empty row)
        var dataRows = GridData.Where(r => !IsEmptyRow(r)).ToList();
        foreach (var row in dataRows)
        {
            if (string.IsNullOrEmpty(row.Phase) || string.IsNullOrEmpty(row.Item))
            {
                Notifications.Info("You must specify a phase/item on each line.");
                return false;
            }
        }

        try
        {
            if (string.IsNullOrEmpty(mChart))
            {
                // Insert
                await db.ExecuteAsync(
                    @"INSERT INTO itemcharts(name, formula, variable1, variable2, variable3)
                      VALUES(@Name, @Formula, @Variable1, @Variable2, @Variable3)",
                    new
                    {
                        Name = txtName,
                        Formula = txtFormula,
                        Variable1,
                        Variable2,
                        Variable3
                    });
                mChart = txtName;
            }
            else
            {
                // Update
                await db.ExecuteAsync(
                    @"UPDATE itemcharts
                      SET name=@NewName, formula=@Formula,
                          variable1=@Variable1, variable2=@Variable2, variable3=@Variable3
                      WHERE name=@OldName",
                    new
                    {
                        NewName = txtName,
                        Formula = txtFormula,
                        Variable1,
                        Variable2 = string.IsNullOrEmpty(Variable2) ? (string?)null : Variable2,
                        Variable3 = string.IsNullOrEmpty(Variable3) ? (string?)null : Variable3,
                        OldName = mChart
                    });
                mChart = txtName;
            }

            // Delete existing details
            await db.ExecuteAsync(
                "DELETE FROM itemchartdetails WHERE name=@Name",
                new { Name = txtName });

            // Insert details
            foreach (var row in dataRows)
            {
                await db.ExecuteAsync(
                    @"INSERT INTO itemchartdetails(name, dimension1, dimension2, dimension3, phase, item)
                      VALUES(@Name, @D1, @D2, @D3, @Phase, @Item)",
                    new
                    {
                        Name = mChart,
                        D1 = D1Visible ? row.D1 : "",
                        D2 = D2Visible ? row.D2 : "",
                        D3 = D3Visible ? row.D3 : "",
                        row.Phase,
                        row.Item
                    });
            }

            mDirty = false;
            StateHasChanged();
            return true;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
            {
                Notifications.Error($"Unable to save this chart. \"{txtName}\" has already been used.\n\nPlease enter a different name.");
            }
            else
            {
                Notifications.Warning($"Error saving: {ex.Message}");
            }
            return false;
        }
    }

    // ── Delete Chart ─────────────────────────────────────────────────────
    private async Task DeleteChart()
    {
        if (!string.IsNullOrEmpty(mChart))
        {
            await db.ExecuteAsync("DELETE FROM itemcharts WHERE name=@Name", new { Name = mChart });
            await db.ExecuteAsync("DELETE FROM itemchartdetails WHERE name=@Name", new { Name = mChart });
            await db.ExecuteAsync("DELETE FROM tbldbassemblydetails WHERE itemchart=@Name", new { Name = mChart });
            mChart = "";
        }
        await LoadData();
    }

