    private async Task OnCloseClick()
    {
        if (mDirty)
        {
            // In-app confirm — see SaveData's MessageBoxControl wiring.
            var result = _messageBox != null
                ? await _messageBox.ShowAsync(
                    "Discard unsaved changes and return?",
                    title: "Discard changes?",
                    buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNo)
                : (await Dialogs.ConfirmAsync("Discard unsaved changes and return?")
                    ? Fx.ControlKit.Dialogs.MessageBoxResult.Yes
                    : Fx.ControlKit.Dialogs.MessageBoxResult.No);

            if (result != Fx.ControlKit.Dialogs.MessageBoxResult.Yes) return;
        }

        // Modal mode wins over returnUrl — host expects the callback so it
        // can flip its visibility flag without leaving the current page.
        if (IsModal && OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
            return;
        }

        if (!string.IsNullOrWhiteSpace(returnUrl))
            NavigationManager.NavigateTo(returnUrl);
    }

