    /// <summary>Column resize / reorder / hide / group / header-rename done by the
    /// user; written back under the same form/grid/instance key the load uses.</summary>
    private async Task OnGridLayoutChangedAsync(GridSettings snapshot)
    {
        if (snapshot == null || !HasDataGridLayout) return;

        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FItemChart", "gData", instanceKey: null,
                gDataLayout, snapshot, ResolveChartField);
            _dataGrid.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FItemChart gData layout");
        }
    }

    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedDataGridLayout()
    {
        if (!HasDataGridLayout) yield break;

        // HHM-237: dimension columns (D1/D2/D3) bypass the stored Hidden flag —
        // VB6 ConfigDimensions recomputes their visibility from the assigned
        // variables on every load, so the saved layout state is advisory only
        // for them. Non-dimension columns keep honoring the stored flag.
        var ordered = gDataLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field)
                        && (!c.Hidden || DimensionIndexOf(ResolveChartField(c.Field)) != 0))
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var col in ordered)
        {
            var resolvedField = ResolveChartField(col.Field);
            var colType = GetColumnTypeForField(resolvedField, _chartRowPropMap);
            var textAlign = colType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (col, resolvedField, colType, textAlign);
        }
    }

    // Resolution (exact → normalized propmap → Dimension1..3 alias → literal) is
    // delegated to the presenter (ctor supplied the alias map). Behavior is
    // identical: the alias only fires when the propmap misses (same as the old
    // switch fall-through), and no ItemChartDetailRow property shadows it.
    private string ResolveChartField(string layoutField)
        => _dataGrid.ResolveField(layoutField);

    // DRIFT FLAG: body differs from the presenter's canonical ColumnTypeFor —
    // bool maps to ColumnType.CheckBox (not Boolean) and only int/long/double/
    // decimal are Number (presenter also covers byte/short/float). Kept verbatim
    // to preserve the rendered <GridColumn Type="…">; GetOrderedDataGridLayout is
    // therefore NOT delegated to _dataGrid.GetOrdered().
    private static ColumnType GetColumnTypeForField(string field, Dictionary<string, PropertyInfo> propMap)
    {
        if (string.IsNullOrWhiteSpace(field)) return ColumnType.Text;
        if (propMap.TryGetValue(NormalizeGridKey(field), out var prop))
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool)) return ColumnType.CheckBox;
            if (type == typeof(int) || type == typeof(long) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
        }
        return ColumnType.Text;
    }

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    private static string NormalizeGridKey(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var sb = new StringBuilder(value.Length);
        foreach (var ch in value)
        {
            if (char.IsLetterOrDigit(ch))
                sb.Append(char.ToLowerInvariant(ch));
        }
        return sb.ToString();
    }

