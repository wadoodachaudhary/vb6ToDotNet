    // ── Variable Editor ──────────────────────────────────────────────
    //
    // Migration of VB6 FVariable.frm.EditVariable + SaveData. We don't
    // open a separate page — the FVariable form was modal in VB6 anyway,
    // and an inline dialog keeps FItemChart's grid state intact while
    // the user tweaks Min/Max/UOM or the picklist.
    private async Task OnEditVariable(int index)
    {
        // VB6 cmdVariable_Click: FVariable.EditVariable(cboVariable(i).Text) —
        // an EMPTY slot opens the editor in create-new mode (rs.EOF seeds
        // Min=0 / Max=9999999 / Default=0), it never alerts (HHM-240).
        var varName = GetVariable(index) ?? "";
        _editingVarIsNew = string.IsNullOrWhiteSpace(varName);
        _editingVarSlot = index;

        try
        {
            await LoadVariableForEdit(varName);
            IsVariableEditorVisible = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnEditVariable: load failed");
            Notifications.Error($"Could not load variable '{varName}': {ex.Message}");
        }
    }

    private async Task LoadVariableForEdit(string name)
    {
        EditingVarName = name;

        var rows = await db.QueryAsync(
            @"SELECT variabletype, minimumvalue, maximumvalue, defaultvalue,
                     uom, listofvalues, help,
                     conditionname, conditiontype, conditionuom
              FROM variables WHERE name=@Name",
            new { Name = name });

        var row = rows.FirstOrDefault();
        if (row == null)
        {
            // Defensive — shouldn't happen for a name we just read from
            // the dropdown, but mirror VB6's "row missing → fresh form"
            // behavior so the user can still save something useful.
            EditingVarType = 0;
            EditingVarMin = "0";
            EditingVarMax = "9999999";
            EditingVarDefault = "0";
            EditingVarUOM = "";
            EditingVarListOfValues = "";
            EditingVarHelp = "";
            EditingVarConditionName = "";
            EditingVarConditionType = "";
            EditingVarConditionUOM = "";
            return;
        }

        EditingVarType = (int)ToDouble(row["variabletype"]);
        EditingVarMin = ToDouble(row["minimumvalue"]).ToString();
        EditingVarMax = ToDouble(row["maximumvalue"]).ToString();
        EditingVarDefault = ToDouble(row["defaultvalue"]).ToString();
        EditingVarUOM = (row["uom"]?.ToString() ?? "").Trim();
        // On disk: pipe-separated. On screen: one per line. Mirrors
        // VB6 Replace("|", vbCrLf) round-trip.
        EditingVarListOfValues = (row["listofvalues"]?.ToString() ?? "")
            .Replace("|", "\n");
        EditingVarHelp = row["help"]?.ToString() ?? "";
        EditingVarConditionName = row["conditionname"]?.ToString() ?? "";
        EditingVarConditionType = row["conditiontype"]?.ToString() ?? "";
        EditingVarConditionUOM = row["conditionuom"]?.ToString() ?? "";
    }

    private async Task LoadUomList()
    {
        try
        {
            var rows = await db.QueryAsync("SELECT uom FROM uom ORDER BY 1", new { });
            UomList = rows.Select(r => (r["uom"]?.ToString() ?? "").Trim())
                          .Where(s => !string.IsNullOrEmpty(s))
                          .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadUomList error");
            UomList = new();
        }
    }

    private void OnVariableEditorCancel()
    {
        IsVariableEditorVisible = false;
        StateHasChanged();
    }

    private async Task OnVariableEditorOk()
    {
        // VB6 SaveData: when Type=List, at least one non-blank value is
        // required. Replicate verbatim so existing UI prompts match.
        string values;
        if (EditingVarType == 1)
        {
            values = (EditingVarListOfValues ?? "")
                .Replace("\r\n", "\n")
                .Replace("\n", "|");

            var stripped = values.Replace("|", "").Replace(" ", "").Trim();
            if (string.IsNullOrEmpty(stripped))
            {
                Notifications.Error("You must specify at least one value.");
                return;
            }
        }
        else
        {
            values = "";
        }

        // Tolerant parse — VB6's Val() returns 0 on garbage input rather
        // than rejecting. Keep that behavior so dirty data flowing in
        // from older records doesn't block save.
        double minV = ParseDoubleOrZero(EditingVarMin);
        double maxV = ParseDoubleOrZero(EditingVarMax);
        double defV = ParseDoubleOrZero(EditingVarDefault);

        try
        {
            EditingVarName = (EditingVarName ?? "").Trim();
            if (string.IsNullOrEmpty(EditingVarName))
            {
                Notifications.Info("Variable name is required.");
                return;
            }
            // Create-new mode (VB6 FVariable saves a fresh row when the name
            // wasn't in [variables]): INSERT the shell first, then the shared
            // UPDATE below fills every field.
            if (_editingVarIsNew)
            {
                var exists = await db.ExecuteScalarAsync<int>(
                    "SELECT COUNT(*) FROM variables WHERE Name=@Name", new { Name = EditingVarName });
                if (exists == 0)
                    await db.ExecuteAsync("INSERT INTO variables(Name) VALUES(@Name)", new { Name = EditingVarName });
            }
            await db.ExecuteAsync(
                @"UPDATE variables SET
                    VariableType=@VariableType,
                    MinimumValue=@MinimumValue,
                    MaximumValue=@MaximumValue,
                    DefaultValue=@DefaultValue,
                    ListOfValues=@ListOfValues,
                    UOM=@UOM,
                    Help=@Help,
                    conditionname=@ConditionName,
                    conditiontype=@ConditionType,
                    conditionuom=@ConditionUOM
                  WHERE Name=@Name",
                new
                {
                    Name = EditingVarName,
                    VariableType = EditingVarType,
                    MinimumValue = minV,
                    MaximumValue = maxV,
                    DefaultValue = defV,
                    ListOfValues = values,
                    UOM = EditingVarUOM ?? "",
                    Help = EditingVarHelp ?? "",
                    ConditionName = EditingVarConditionName ?? "",
                    ConditionType = EditingVarConditionType ?? "",
                    ConditionUOM = EditingVarConditionUOM ?? ""
                });

            IsVariableEditorVisible = false;

            // VB6 reloaded the variable list after save so dependent
            // dropdowns (Min/Max ranges, UOM constraints) reflect the
            // new metadata. A newly created variable is also assigned
            // into the slot whose edit button launched the dialog.
            await LoadVariables();
            if (_editingVarIsNew && _editingVarSlot >= 1)
                SetVariable(_editingVarSlot, EditingVarName);
            _editingVarIsNew = false;
            ConfigDimensions();
            StateHasChanged();

            Notifications.Info($"Variable '{EditingVarName}' saved.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnVariableEditorOk: update failed");
            Notifications.Error($"Could not save variable: {ex.Message}");
        }
    }

    private static double ParseDoubleOrZero(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return 0;
        return double.TryParse(s, System.Globalization.NumberStyles.Any,
                               System.Globalization.CultureInfo.InvariantCulture,
                               out var v) ? v : 0;
    }

