@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - Initial port from VB6
     - HHM-609: toolbar Open now uses the shared FPickList window (VB6
       FPickList.Choose "Item Chart") instead of a bespoke list dialog.
   ───────────────────────────────────────────────────────────────── *@
@namespace HomeFront.Components.Pages
@page "/item-chart"
@page "/item-chart/{ChartName}"

@using HomeFront.Data
@using HomeFront.Models
@using System.Data
@using System.Reflection
@using System.Text
@using Fx.ControlKit.Notifications
@layout HFComponent
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject NavigationManager NavigationManager
@inject ILogger<FItemChart> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db
<PageTitle>Item Chart - HomeFront</PageTitle>

@* IsModal: when FAssembly (or any caller) hosts FItemChart inline, wrap
   the page in a backdrop+frame so the caller stays visible behind it.
   VB6 FItemChart.Edit was modal-blocking; this preserves that UX
   without stealing an MDI tab. Non-modal usage (/item-chart route or
   the FMain Setup menu path) renders normally as a full-page form.
   Mirrors the FDBGrid/FTakeoff IsModal pattern. *@
@if (IsModal)
{
    <div class="fx-itemchart-modal-backdrop"></div>
}
<div class="@(IsModal ? "fx-itemchart-modal" : "")">
@if (IsModal)
{
    <div class="fx-itemchart-modal-header">
        @* HHM-237: legacy form icon LEFT of the title — VB6 FItemChart.frm:10
           (Icon = FItemChart.frx). Same 16px vb6form.png face FPickList's
           window icon uses (HHM-288). *@
        <span class="fx-itemchart-modal-icon" aria-hidden="true"></span>
        <span class="fx-itemchart-modal-title">@(string.IsNullOrEmpty(mChart) ? "Item Chart" : $"Item Chart — {mChart}")</span>
        <button type="button" class="fx-itemchart-modal-close" title="Close"
                aria-label="Close" @onclick="OnCloseClick">×</button>
    </div>
}

@* ── TOOLBAR ─────────────────────────────────────────── *@
<div class="toolbar-cntr">
    <button class="tbar-btn" @onclick="OnNewClick">
        <img src="images/32/new.ico" alt="New" onerror="this.style.display='none'" />
        <span class="tool-label">New</span>
    </button>
    <button class="tbar-btn" @onclick="OnOpenClick">
        <img src="images/32/open.ico" alt="Open" onerror="this.style.display='none'" />
        <span class="tool-label">Open</span>
    </button>
    <button class="tbar-btn" disabled="@(!mDirty)" @onclick="OnSaveClick">
        <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
        <span class="tool-label">Save</span>
    </button>
    <button class="tbar-btn" disabled="@(string.IsNullOrEmpty(mChart))" @onclick="OnDeleteClick">
        <img src="images/32/delete.ico" alt="Delete" onerror="this.style.display='none'" />
        <span class="tool-label">Delete</span>
    </button>
    @* Close in the toolbar only for the STANDALONE returnUrl case — VB6's
       toolbar is New/Open/Save/Delete (FItemChart.frm:52-65); the modal is
       dismissed by the header ✕, and the extra toolbar Close read as icon
       clutter (HHM-237). *@
    @if (!IsModal && !string.IsNullOrWhiteSpace(returnUrl))
    {
        <div class="tbar-separator"></div>
        <button class="tbar-btn" @onclick="OnCloseClick">
            <span class="tool-label">Close</span>
        </button>
    }
</div>

@* Page heading only in STANDALONE mode — the modal header already carries
   the title; showing both duplicated it (HHM-237). *@
@if (!IsModal)
{
    <h3 style="margin-bottom: 16px;">Item Chart</h3>
}

@* ── HEADER FIELDS ───────────────────────────────────── *@
<div class="form-row">
    <div class="left-panel">
        <div class="form-field" style="margin-bottom: 8px;">
            <label>Chart Name</label>
            <TextBoxControl Value="@txtName" ValueChanged="OnNameValueChanged"
                            MaxLength="50" CssClass="ic-name-input" />
        </div>
        <div class="form-field">
            <label>Formula</label>
            <TextAreaControl Value="@txtFormula" ValueChanged="OnFormulaValueChanged"
                             CssClass="ic-formula-area" />
            <button class="formula-edit-btn" @onclick="OnFormulaEditClick" title="Edit Formula">✏️</button>
        </div>
    </div>

    <div class="right-panel">
        <div class="form-field" style="margin-bottom: 8px;">
            <label>Variable 1</label>
            <DropDownListControl TValue="string" TItem="string"
                                 Value="@Variable1"
                                 ValueChanged="OnVariable1Changed"
                                 DataSource="@VariableOptionList"
                                 Width="240px" />
            <button class="var-edit-btn" @onclick="() => OnEditVariable(1)" title="Edit Variable">✏️</button>
        </div>
        <div class="form-field" style="margin-bottom: 8px;">
            <label>Variable 2</label>
            <DropDownListControl TValue="string" TItem="string"
                                 Value="@Variable2"
                                 ValueChanged="OnVariable2Changed"
                                 DataSource="@VariableOptionList"
                                 Enabled="@Variable2Enabled"
                                 Width="240px" />
            <button class="var-edit-btn" disabled="@(!Variable2Enabled)"
                    @onclick="() => OnEditVariable(2)" title="Edit Variable">✏️</button>
        </div>
        <div class="form-field">
            <label>Variable 3</label>
            <DropDownListControl TValue="string" TItem="string"
                                 Value="@Variable3"
                                 ValueChanged="OnVariable3Changed"
                                 DataSource="@VariableOptionList"
                                 Enabled="@Variable3Enabled"
                                 Width="240px" />
            <button class="var-edit-btn" disabled="@(!Variable3Enabled)"
                    @onclick="() => OnEditVariable(3)" title="Edit Variable">✏️</button>
        </div>
    </div>
</div>

@* ── DATA GRID ───────────────────────────────────────── *@
<div class="grid-container">
    <GridControl @ref="gData"
            TValue="ItemChartDetailRow"
            DataSource="@GridData"
            AllowSorting="true"
            AllowResizing="true"
            AllowSelection="true"
            EnableHover="true"
            Height="400px"
            EditSettingsRef="@editSettings"
            SelectionSettingsRef="@selectionSettings"
            EventsRef="@gridEvents"
            OnLayoutChanged="@OnGridLayoutChangedAsync">
        <GridColumnsBase @key="gDataLayoutVersion">
            @if (HasDataGridLayout)
            {
                <GridColumn Field="@nameof(ItemChartDetailRow.RowIndex)" HeaderText="" Width="1px"
                              Visible="false" IsPrimaryKey="true" />
                foreach (var entry in GetOrderedDataGridLayout())
                {
                    var layout = entry.Layout;
                    var fieldName = entry.Field;
                    var columnType = entry.ColumnType;
                    var textAlign = entry.TextAlign;
                    // HHM-237: VB6 ConfigDimensions (FItemChart.frm:733-764)
                    // overrides the SAVED layout for the D1/D2/D3 dimension
                    // columns on every load/variable change — the column is
                    // visible IFF its variable is assigned, and its caption is
                    // the variable name. A stale saved layout row (Hidden=0
                    // with an old variable caption) must not leak an extra
                    // column into a chart whose variables don't use it.
                    var dimIndex = DimensionIndexOf(fieldName);
                    var isVisible = dimIndex == 0 || GetDimensionVisible(dimIndex);
                    var headerText = dimIndex != 0
                        ? GetDimensionHeader(dimIndex)
                        : (string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption);
                    var width = layout.Width.HasValue && layout.Width.Value > 0
                        ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;

                    <GridColumn Field="@fieldName"
                                  HeaderText="@headerText"
                                  Width="@width"
                                  Type="@columnType"
                                  TextAlign="@textAlign"
                                  Visible="@isVisible"
                                  AllowEditing="true"
                                  ClipMode="ClipMode.Ellipsis" />
                }
            }
            else
            {
                <GridColumn Field="@nameof(ItemChartDetailRow.RowIndex)" HeaderText="" Width="1px"
                              Visible="false" IsPrimaryKey="true" />
                <GridColumn Field="@nameof(ItemChartDetailRow.D1)" HeaderText="@D1Header"
                              Width="120px" Visible="@D1Visible" AllowEditing="true" />
                <GridColumn Field="@nameof(ItemChartDetailRow.D2)" HeaderText="@D2Header"
                              Width="120px" Visible="@D2Visible" AllowEditing="true" />
                <GridColumn Field="@nameof(ItemChartDetailRow.D3)" HeaderText="@D3Header"
                              Width="120px" Visible="@D3Visible" AllowEditing="true" />
                <GridColumn Field="@nameof(ItemChartDetailRow.Phase)" HeaderText="Phase"
                              Width="100px" AllowEditing="false">
                    <Template>
                        @{
                            var row = (ItemChartDetailRow)context;
                            <span>@row.Phase</span>
                            <button class="var-edit-btn" style="padding:1px 4px; font-size:10px;"
                                    @onclick="() => OnPickItem(row)" @onclick:stopPropagation="true">...</button>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ItemChartDetailRow.Item)" HeaderText="Item"
                              Width="100px" AllowEditing="false">
                    <Template>
                        @{
                            var row = (ItemChartDetailRow)context;
                            <span>@row.Item</span>
                            <button class="var-edit-btn" style="padding:1px 4px; font-size:10px;"
                                    @onclick="() => OnPickItem(row)" @onclick:stopPropagation="true">...</button>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ItemChartDetailRow.Description)" HeaderText="Description"
                              Width="250px" AllowEditing="false">
                    <Template>
                        @{
                            var row = (ItemChartDetailRow)context;
                            <span>@row.Description</span>
                            <button class="var-edit-btn" style="padding:1px 4px; font-size:10px;"
                                    @onclick="() => OnPickItem(row)" @onclick:stopPropagation="true">...</button>
                        }
                    </Template>
                </GridColumn>
            }
        </GridColumnsBase>
    </GridControl>
</div>

@* ── OPEN CHART PICK LIST ─────────────────────────────
   VB6 Toolbar "Open" (FItemChart.frm:529-536) runs
   FPickList.Choose(db, "Item Chart", "SELECT Name from itemcharts",
   mChart) — the STANDARD pick-list window (hints, sortable Name grid,
   type-to-search, Open/Cancel). The first port showed a bespoke bare
   list here, which QA read as an unimplemented window (HHM-609); the
   shared FPickList component (z-index 10000) now stacks above the
   item-chart modal exactly like every other picker. *@
<FPickList @ref="_chartPicker" OnSelected="OnChartPicked" />

@* ── ITEM PICK LIST DIALOG ──────────────────────────── *@
<DialogControl Visible="@IsItemPickDialogVisible"
               Header="Select Item"
               Width="600px"
               IsModal="true"
               ShowCloseIcon="true"
               OnClose="@(() => IsItemPickDialogVisible = false)">
    <ChildContent>
        <div class="dialog-body" style="max-height: 400px; overflow-y: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                <thead>
                    <tr style="background: #f0f0f0; border-bottom: 2px solid #dee2e6;">
                        <th style="padding: 6px 8px; text-align: left;">Phase</th>
                        <th style="padding: 6px 8px; text-align: left;">Item</th>
                        <th style="padding: 6px 8px; text-align: left;">Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pi in PhaseItemPickList)
                    {
                        <tr class="pick-list-item @(pi == SelectedPhaseItem ? "selected" : "")"
                            style="cursor: pointer;"
                            @onclick="() => SelectedPhaseItem = pi">
                            <td style="padding: 4px 8px;">@pi.Phase</td>
                            <td style="padding: 4px 8px;">@pi.Item</td>
                            <td style="padding: 4px 8px;">@pi.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!PhaseItemPickList.Any())
            {
                <p style="color: #6c757d; padding: 12px;">No items found.</p>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn fx-primary"
                       Disabled="@(SelectedPhaseItem == null)"
                       OnClick="OnItemPickConfirm">OK</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="@(() => IsItemPickDialogVisible = false)">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@* ── FORMULA EDITOR ─────────────────────────────────────
   VB6 cmdFormula_Click (FItemChart.frm:339): FFormulaEditor.EditFormula("", s)
   — the standard 3-pane Formula Editor (Variables / Formulas / function
   library), NOT a bare textarea (HHM-239). Same component FItems uses. *@
<FFormulaEditor @ref="formulaEditor" OnAccepted="OnFormulaAccepted" />

@* ── VARIABLE EDITOR DIALOG ──────────────────────────────
   In-place port of VB6 FVariable.frm.EditVariable so users can
   maintain the rows of the [variables] table without leaving
   FItemChart. Numeric variables expose Min/Max/Default/UOM; List
   variables expose a ListOfValues textarea (one value per line on
   screen, pipe-separated on disk). Condition fields are preserved
   round-trip but not editable here — wire FCondition in a follow-up.
   HHM-608 layout parity with FVariable.frm: caption is ALWAYS
   "Variable" (frm:4); Name label sits LEFT of its box (frm:169/236);
   Type radios stack VERTICALLY (frm:186-201); the right-hand
   "Properties" group (frm:145) is a compact 2×2 grid — Min|Default /
   Max|UOM with short labels and ~45px boxes (frm:70-140); the List
   type swaps that panel for a "Values" textarea (frm:216/265); the
   bottom label is "Help Notes" (frm:250) over a full-width box.
   ──────────────────────────────────────────────────────── *@
<DialogControl Visible="@IsVariableEditorVisible"
               Header="Variable"
               Width="360px"
               IsModal="true"
               ShowCloseIcon="true"
               CssClass="ic-variable-dialog"
               OnClose="OnVariableEditorCancel">
    <ChildContent>
        <div class="dialog-body ic-var-body">
            <div class="ic-var-name-row">
                <label class="ic-var-group-label">Name</label>
                @if (_editingVarIsNew)
                {
                    <TextBoxControl @bind-Value="EditingVarName" MaxLength="50" />
                }
                else
                {
                    <TextBoxControl Value="@EditingVarName" readonly="readonly" CssClass="ic-readonly-input" />
                }
            </div>

            <div class="ic-var-columns">
                <div class="ic-var-type-col">
                    <label class="ic-var-group-label">Type</label>
                    <div class="ic-var-radios">
                        <RadioControl TValue="int" Name="varType" Value="0"
                                      @bind-SelectedValue="EditingVarType" Label="Numeric" />
                        <RadioControl TValue="int" Name="varType" Value="1"
                                      @bind-SelectedValue="EditingVarType" Label="List of values" />
                    </div>
                </div>
                @if (EditingVarType == 0)
                {
                    <div class="ic-var-props-col">
                        <label class="ic-var-group-label">Properties</label>
                        <div class="ic-var-props-grid">
                            <label>Min</label>
                            <TextBoxControl @bind-Value="EditingVarMin" />
                            <label>Default</label>
                            <TextBoxControl @bind-Value="EditingVarDefault" />
                            <label>Max</label>
                            <TextBoxControl @bind-Value="EditingVarMax" />
                            <label>UOM</label>
                            @* HHM-240: same width as the Default box above so the
                               UOM combo sits exactly parallel to it — VB6 gives
                               txtDefault and cboUOM identical Left/Width
                               (FVariable.frm:70-88, both Left=1965 Width=675). *@
                            <DropDownListControl TValue="string" TItem="string"
                                                 @bind-Value="EditingVarUOM"
                                                 Width="56px"
                                                 DataSource="@UomOptionList" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="ic-var-props-col">
                        <label class="ic-var-group-label">Values</label>
                        <TextAreaControl @bind-Value="EditingVarListOfValues" Rows="5"
                                         CssClass="ic-monospace-area" />
                    </div>
                }
            </div>

            <div class="ic-var-help">
                <label class="ic-var-group-label">Help Notes</label>
                <TextAreaControl @bind-Value="EditingVarHelp" Rows="4" />
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="fx-dialog-btn fx-primary" OnClick="OnVariableEditorOk">OK</ButtonControl>
        <ButtonControl CssClass="fx-dialog-btn" OnClick="OnVariableEditorCancel">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@* ── IN-APP MESSAGE BOX ─────────────────────────────────
   FlexKit's MessageBoxControl replaces the browser's confirm()/alert()
   dialogs so Save/Discard/Delete prompts have the same look-and-feel as
   the rest of the application (FAssembly uses the same pattern at
   _messageBox; see ShowAsync usage below for Yes/No/Cancel handling).
   ──────────────────────────────────────────────────────── *@
<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />
</div> @* close .fx-itemchart-modal / non-modal wrapper *@

@code {
    [Parameter] public string? ChartName { get; set; }
    [SupplyParameterFromQuery] public string? returnUrl { get; set; }

    /// <summary>When true, render inside a backdrop+frame so the host
    /// page (e.g. FAssembly) stays visible behind. Standalone /item-chart
    /// route navigation leaves this false → full-page layout.</summary>
    [Parameter] public bool IsModal { get; set; }

    /// <summary>Fires when the modal should dismiss (Close button or the
    /// × in the modal header). Only used when <see cref="IsModal"/> is
    /// true — host flips its visibility flag. In standalone mode the
    /// Close button falls back to <c>returnUrl</c> navigation.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    // Database
// State
    private string mChart = "";
    private bool mDirty = false;

    // Form fields
    private string txtName = "";
    private string txtFormula = "";
    private string Variable1 = "";
    private string Variable2 = "";
    private string Variable3 = "";

    // Variable enable state
    private bool Variable2Enabled => !string.IsNullOrEmpty(Variable1);
    private bool Variable3Enabled => !string.IsNullOrEmpty(Variable2);

    // Variable lists
    private List<string> VariableList = new();

    // DropDownListControl renders one option per DataSource item; the VB6
    // <select> had a leading blank <option value=""> so the user could
    // clear a variable. Prepend that blank to keep the same "no variable"
    // choice (clearing Variable1 cascades to Variable2/3 in OnVariableChanged).
    private IEnumerable<string> VariableOptionList =>
        new[] { "" }.Concat(VariableList);

    // Dimension min/max values
    private double[] MinValue = new double[4];
    private double[] MaxValue = new double[4];

    // Dimension combo lists (for validation)
    private string[] DimensionComboList = new string[4];

    // Grid column headers and visibility
    private string D1Header = "D1";
    private string D2Header = "D2";
    private string D3Header = "D3";
    private bool D1Visible = false;
    private bool D2Visible = false;
    private bool D3Visible = false;

    // Grid data
    private List<ItemChartDetailRow> GridData = new();
    private GridControl<ItemChartDetailRow>? gData;
    private int SelectedRowIndex = -1;

    // Grid settings
    private SelectionSettings selectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single
    };
    private EditSettings editSettings = new()
    {
        AllowAdding = true,
        AllowEditing = true,
        AllowDeleting = true,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };
    private GridControlEvents<ItemChartDetailRow> gridEvents = new();

    // ── Grid Layout (dynamic from AppGridLayout) ──────────────
    // Load/resolve/order/width boilerplate lives in the shared GridLayoutPresenter
    // (Services/GridLayoutPresenter.cs); only the VB6 form/grid names stay here.
    // gDataLayout / HasDataGridLayout / gDataLayoutVersion are thin delegations so
    // the markup is unchanged. The keyed-then-unkeyed fallback is captured by
    // instanceKey:"(0)"; the VB6 Dimension1..3 → D1..3 column aliases by aliases:.
    private readonly GridLayoutPresenter<ItemChartDetailRow> _dataGrid =
        new("FItemChart", "gData", instanceKey: "(0)",
            aliases: new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["dimension1"] = nameof(ItemChartDetailRow.D1),
                ["dimension2"] = nameof(ItemChartDetailRow.D2),
                ["dimension3"] = nameof(ItemChartDetailRow.D3)
            });

    private Dictionary<string, GridLayoutColumn> gDataLayout => _dataGrid.Layout;
    private bool HasDataGridLayout => _dataGrid.Has;
    private int gDataLayoutVersion => _dataGrid.Version;

    // NOTE (drift): kept locally because GetColumnTypeForField below maps
    // bool→CheckBox (not the presenter's Boolean) and recognizes a narrower
    // numeric set. See the flag in GetColumnTypeForField.
    private static readonly Dictionary<string, PropertyInfo> _chartRowPropMap =
        typeof(ItemChartDetailRow)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .GroupBy(p => NormalizeGridKey(p.Name))
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    // Open Chart picker — shared FPickList (VB6 FPickList.Choose, HHM-609)
    private FPickList? _chartPicker;

    // Dialog state - Item Pick
    private bool IsItemPickDialogVisible = false;
    private List<PhaseItemPickRow> PhaseItemPickList = new();
    private PhaseItemPickRow? SelectedPhaseItem;
    private ItemChartDetailRow? PickTargetRow;

    // Dialog state - Formula Editor

    // In-app message box (Save/Discard/Delete prompts). Replaces the
    // browser confirm() so the dialog matches the rest of the app's
    // chrome; mirrors the pattern used in FAssembly.
    private Fx.ControlKit.Dialogs.MessageBoxControl? _messageBox;

    // ── Variable Editor state (VB6 FVariable.frm port) ──────────────
    //
    // We treat Name as read-only because OnEditVariable always opens
    // an EXISTING row picked from one of the Variable1/2/3 dropdowns.
    // Renames are intentionally deferred — they would orphan
    // itemcharts.variableN references.
    private bool IsVariableEditorVisible = false;
    private string EditingVarName = "";
    private bool _editingVarIsNew;
    private int _editingVarSlot;
    private int EditingVarType = 0;                  // 0=Numeric, 1=List
    private string EditingVarMin = "0";
    private string EditingVarMax = "9999999";
    private string EditingVarDefault = "0";
    private string EditingVarUOM = "";
    private string EditingVarListOfValues = "";       // newline-separated on screen, pipe on disk
    private string EditingVarHelp = "";
    // Round-trip-only — FCondition is a separate VB6 form not yet ported.
    private string EditingVarConditionName = "";
    private string EditingVarConditionType = "";
    private string EditingVarConditionUOM = "";
    private List<string> UomList = new();

    // Leading blank mirrors the VB6 <select>'s empty <option> so the UOM
    // can be cleared back to "none" in the variable editor.
    private IEnumerable<string> UomOptionList => new[] { "" }.Concat(UomList);

    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        gridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<ItemChartDetailRow>>(this, OnRowSelected);
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<ItemChartDetailRow>>(this, OnCellSaved);

        await LoadGridLayoutAsync();

        mChart = ChartName ?? "";
        await LoadVariables();
        await LoadUomList();
        ConfigDimensions();
        EnsureEmptyRow();

        if (!string.IsNullOrEmpty(mChart))
            await LoadData();

        mDirty = false;
    }

    // ── Load Variables ───────────────────────────────────────────────────
    private async Task LoadVariables()
    {
        try
        {
            var rows = await db.QueryAsync(
                "SELECT name FROM variables ORDER BY 1",
                new { });
            VariableList = rows.Select(r => (r["name"]?.ToString() ?? "").Trim())
                               .Where(s => !string.IsNullOrEmpty(s))
                               .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadVariables error");

            VariableList = new();
        }
    }

    // ── Configure Dimensions ─────────────────────────────────────────────
    private void ConfigDimensions()
    {
        for (int i = 1; i <= 3; i++)
        {
            var varName = GetVariable(i);
            if (string.IsNullOrEmpty(varName))
            {
                SetDimensionVisible(i, false);
            }
            else
            {
                try
                {
                    var rows = db.SqlExec(
                        "SELECT * FROM variables WHERE name=@Name",
                        new { Name = varName });
                    if (rows.Rows.Count > 0)
                    {
                        var row = rows.Rows[0];
                        SetDimensionVisible(i, true);
                        SetDimensionHeader(i, row["name"]?.ToString() ?? $"D{i}");
                        MinValue[i] = ToDouble(row["minimumvalue"]);
                        MaxValue[i] = ToDouble(row["maximumvalue"]);
                        DimensionComboList[i] = row["listofvalues"]?.ToString() ?? "";
                    }
                    else
                    {
                        SetDimensionVisible(i, false);
                    }
                }
                catch
                {
                    SetDimensionVisible(i, false);
                }
            }
        }
    }

    private string GetVariable(int index) => index switch
    {
        1 => Variable1,
        2 => Variable2,
        3 => Variable3,
        _ => ""
    };

    private void SetVariable(int index, string name)
    {
        switch (index)
        {
            case 1: Variable1 = name; OnVariableChanged(1); break;
            case 2: Variable2 = name; OnVariableChanged(2); break;
            case 3: Variable3 = name; OnVariableChanged(3); break;
        }
    }

