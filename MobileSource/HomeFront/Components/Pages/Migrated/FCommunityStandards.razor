@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Migrated from: HFEst/Source/CommunityStandards.frm
   Changes     :
     - Grid columns are now AppGridLayout-driven (VB6 IniGetGrid(Me,gData)
       → gridname "FCommunityStandards.gData"), rendered DYNAMICALLY
       instead of a hardcoded <GridColumn> list (mirrors FAssembly.gItems).
     - Item pick (Phase/Item/ItemDesc cells) uses the canonical FPickList
       component (VB6 gData_CellButtonClick → FPickList.Choose).
     - Notes cell uses the FComments component, MaxLength 4000
       (VB6 FComments.Edit(s, gData, , "Notes", 4000)).
     - Save / Delete prompts use FlexKit MessageBoxControl (no JS confirm).
     - CommunityStandardsArePhaseSpecific read from AppOptions; DivisionID
       read from ISessionStateService (no hardcoded division).
     - Delete-key clears Phase/Item/ItemDesc/Notes (VB6 gData_KeyDown).
   ───────────────────────────────────────────────────────────────── *@
@page "/community-standards"
@namespace HomeFront.Components.Pages
@rendermode InteractiveServer
@layout HFComponent

@using System.Reflection
@using System.Text
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using HomeFront.Data
@using HomeFront.Models
@using HomeFront.Services
@* FComments lives in the folder-derived HomeFront.Components.Pages.Migrated
   namespace (no explicit @namespace); this page sits in
   HomeFront.Components.Pages, so import the Migrated namespace to resolve it
   (FPickList/MessageBoxControl already resolve via their own namespaces). *@
@using HomeFront.Components.Pages.Migrated

@inject IJSRuntime JSRuntime
@inject ILogger<FCommunityStandards> Logger
@inject NotificationService Notifications
@inject DbWrapperSqlServer db
@inject IGridLayoutService GridLayoutSvc
@inject ISessionStateService SessionState

<PageTitle>@($"{CommunityLabel} Standards - HomeFront")@(GridLayoutFallbackUsed ? " [gData FALLBACK]" : "")</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">Loading...</div>
    </div>
}

<div class="community-standards-page">
    @* ── TOOLBAR (VB6 Toolbar: single "Save" button) ─────────────── *@
    <div class="toolbar-cntr">
        <button class="tbar-btn" disabled="@(!mDirty)" @onclick="OnSaveClick">
            <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
            <span class="tool-label">Save</span>
        </button>
    </div>

    <h3 class="page-title">@($"{CommunityLabel} Standards")</h3>

    <div class="grid-container">
        @if (!HasGridLayout)
        {
            <div class="grid-fallback-note">
                Grid layout for <code>FCommunityStandards.gData</code> could not be loaded from AppGridLayout.
            </div>
        }
        <GridControl @ref="gData"
                     TValue="CommunityStandardRow"
                     DataSource="@Standards"
                     AllowPaging="false"
                     AllowSorting="true"
                     AllowFiltering="true"
                     AllowGrouping="true"
                     AllowResizing="true"
                     AllowSelection="true"
                     EnableHover="true"
                     Height="100%"
                     RowHeight="20"
                     GroupColumns="@GroupColumns"
                     ShowGroupExpandCollapse="true"
                     HideGroupedColumns="true"
                     FilterSettingsRef="@filterSettings"
                     PageSettingsRef="@pageSettings"
                     SelectionSettingsRef="@selectionSettings"
                     EditSettingsRef="@editSettings"
                     EventsRef="@gridEvents">
            <GridColumnsBase @key="GridLayoutVersion" DebugTag="FCommunityStandards-gData">
                @foreach (var entry in GetOrderedGridLayout())
                {
                    var layout = entry.Layout;
                    var fieldName = entry.Field;
                    var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                    var width = layout.Width.HasValue && layout.Width.Value > 0
                        ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                        : null;
                    var allowEdit = layout.IsEditable;

                    @* Phase / Item / ItemDesc: picker-only cell + "…" item
                       picker (VB6 gData_BeforeEdit .ComboList="..." +
                       gData_CellButtonClick → FPickList.Choose "Item"). VB6's
                       ComboList is picker-only (no free-text), so AllowEditing
                       is false and all edits flow through the "…" button — the
                       same gesture FAssembly uses for its Vendor/picker columns.
                       The 'allowEdit' layout flag is still honored as the gate
                       that shows/hides the button. *@
                    if (fieldName.Equals(nameof(CommunityStandardRow.Phase), StringComparison.OrdinalIgnoreCase)
                        || fieldName.Equals(nameof(CommunityStandardRow.Item), StringComparison.OrdinalIgnoreCase)
                        || fieldName.Equals(nameof(CommunityStandardRow.ItemDesc), StringComparison.OrdinalIgnoreCase))
                    {
                        <GridColumn Field="@fieldName"
                                    HeaderText="@headerText"
                                    Width="@width"
                                    Type="ColumnType.Text"
                                    TextAlign="TextAlign.Left"
                                    ClipMode="ClipMode.Ellipsis"
                                    AllowEditing="false"
                                    Visible="true">
                            <Template>
                                @{ var row = (CommunityStandardRow)context; }
                                @{ var cellVal = GetCellValue(row, fieldName); }
                                <div class="cs-pick-cell">
                                    <span class="cs-pick-text" title="@cellVal">@cellVal</span>
                                    @if (IsItemRow(row) && allowEdit)
                                    {
                                        <button class="cs-pick-btn fx-grid-popup-btn" title="Pick item"
                                                @onclick="() => OpenItemPick(row)" @onclick:stopPropagation="true">…</button>
                                        @if (fieldName.Equals(nameof(CommunityStandardRow.Item), StringComparison.OrdinalIgnoreCase))
                                        {
                                            <button class="cs-clear-btn fx-grid-popup-btn" title="Clear item (Delete)"
                                                    @onclick="() => ClearItem(row)" @onclick:stopPropagation="true">✕</button>
                                        }
                                    }
                                </div>
                            </Template>
                        </GridColumn>
                    }
                    else if (fieldName.Equals(nameof(CommunityStandardRow.Notes), StringComparison.OrdinalIgnoreCase))
                    {
                        @* Notes: read-only display + the STANDARD FlexKit edit button
                           (AlwaysShowEditButton, gated per-row by IsItemRow && Item<>"")
                           opens FComments via OnEditButtonClick → OpenNotes (VB6
                           gData_BeforeEdit .ComboList="|..." → gData_CellButtonClick).
                           Replaces the hand-rolled div/span/button template; the cell
                           still shows the raw Notes value (Ellipsis-clipped). *@
                        <GridColumn Field="@fieldName"
                                    HeaderText="@headerText"
                                    Width="@width"
                                    Type="ColumnType.Text"
                                    TextAlign="TextAlign.Left"
                                    ClipMode="ClipMode.Ellipsis"
                                    AllowEditing="false"
                                    ShowEditButton="true" AlwaysShowEditButton="true"
                                    ShowEditButtonPredicate="@(o => o is CommunityStandardRow r && IsItemRow(r) && !string.IsNullOrEmpty(r.Item))"
                                    Visible="true" />
                    }
                    else
                    {
                        @* StdItemDesc (outline/group col), StdPhase, StdItem,
                           Community, CommunityPhase — read-only. Hidden ones
                           are filtered out by GetOrderedGridLayout(). *@
                        <GridColumn Field="@fieldName"
                                    HeaderText="@headerText"
                                    Width="@width"
                                    Type="ColumnType.Text"
                                    TextAlign="TextAlign.Left"
                                    ClipMode="ClipMode.Ellipsis"
                                    AllowEditing="false"
                                    Visible="true" />
                    }
                }
            </GridColumnsBase>
        </GridControl>
    </div>
</div>

@* ── Notes editor (VB6 FComments.Edit(s, gData, , "Notes", 4000)) ──── *@
<FComments @bind-Visible="IsNotesDialogVisible"
           @bind-Value="NotesEditText"
           Title="Notes"
           MaxLength="4000"
           Editable="true"
           OnSave="OnNotesCommitted" />

@* ── Item pick list (VB6 FPickList.Choose) ───────────────────────── *@
<FPickList @ref="pickList" OnSelected="OnItemPicked" />

@* ── Unsaved-changes / message prompts (VB6 MsgBox) ──────────────── *@
<MessageBoxControl @ref="messageBox" />

@code {
    private GridControl<CommunityStandardRow>? gData;
    private FPickList? pickList;
    private MessageBoxControl? messageBox;

    private bool IsLoading;
    private bool mDirty;

    private List<CommunityStandardRow> Standards = new();

    private string CommunityLabel = "Community";
    private bool CommunityStandardsArePhaseSpecific;   // VB6 default = False (AppOptions)

    // ── Dynamic grid layout (AppGridLayout: FCommunityStandards.gData) ──
    // Load/resolve/order/width boilerplate delegated to GridLayoutPresenter; the
    // VB6 form/grid name strings stay here for fidelity. Form-specific glue (the
    // editable-column gate and the CommunityDesc group-column fallback) remains.
    private readonly GridLayoutPresenter<CommunityStandardRow> _grid =
        new("FCommunityStandards", "gData");
    private Dictionary<string, GridLayoutColumn> GridLayout => _grid.Layout;
    private int GridLayoutVersion => _grid.Version;
    private bool GridLayoutFallbackUsed => _grid.FallbackUsed;
    private List<string> GroupColumns = new();
    private bool HasGridLayout => _grid.Has;

    private FilterSettings filterSettings = new() { Type = FilterType.Menu };
    private PageSettings pageSettings = new() { PageSize = 1000 };
    private SelectionSettings selectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single,
        EnableToggle = true
    };
    private EditSettings editSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false
    };
    private GridControlEvents<CommunityStandardRow> gridEvents = new();

    // ── Notes / pick dialog state ──────────────────────────────────────
    private bool IsNotesDialogVisible;
    private string NotesEditText = "";
    private CommunityStandardRow? NotesEditingRow;
    private CommunityStandardRow? PickTargetRow;

    protected override async Task OnInitializedAsync()
    {
        gridEvents.OnEditButtonClick = EventCallback.Factory.Create<CellEditButtonArgs<CommunityStandardRow>>(this, OnGridEditButtonClick);

        await LoadCustomDescriptionsAsync();
        await LoadOptionsAsync();
        await LoadGridLayoutAsync();
        await LoadDataAsync();
    }

    // Grid edit-button dispatch (VB6 gData_CellButtonClick): routes the STANDARD
    // FlexKit edit button by column to the same handler the hand-rolled cell
    // button used. args.Data is the clicked row.
    private async Task OnGridEditButtonClick(CellEditButtonArgs<CommunityStandardRow> args)
    {
        if (args.Data == null) return;
        switch (args.ColumnName)
        {
            case nameof(CommunityStandardRow.Notes):
                OpenNotes(args.Data);
                break;
        }
        await Task.CompletedTask;
    }

    // VB6 LoadCustomDescriptions: Me.Caption = FMain.CD_Community & " Standards".
    // FMain.CD_Community = GetCustomDesc("Community").
    private async Task LoadCustomDescriptionsAsync()
    {
        try
        {
            var label = await db.ExecuteScalarAsync<string>(
                "SELECT ISNULL(NULLIF(custom_description,''),@DefaultVal) FROM customdescriptions WHERE item=@Item",
                new { DefaultVal = "Community", Item = "Community" });
            if (!string.IsNullOrWhiteSpace(label))
                CommunityLabel = label.Trim();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Couldn't read Community custom description; defaulting to 'Community'");
            CommunityLabel = "Community";
        }
    }

    // VB6 LoadData: 1 = IIf("True" = HFApp.Options.ValueByName(
    //   "CommunityStandardsArePhaseSpecific"), 1, 2). Resolve the boolean
    //   app-option the canonical way (system_setup col → appoptions fallback,
    //   most-specific division wins). Default is False (= not phase specific).
    private async Task LoadOptionsAsync()
    {
        CommunityStandardsArePhaseSpecific = await ReadBoolOption("CommunityStandardsArePhaseSpecific");
    }

    private async Task<bool> ReadBoolOption(string optionName)
    {
        string? raw = null;
        try
        {
            // system_setup.<col> is a fixed VB6 option identifier (not user data),
            // so it's a bracket-quoted identifier rather than a parameter.
            raw = await db.ExecuteScalarAsync<string>(
                $"SELECT TOP 1 [{optionName}] FROM system_setup WHERE id = @Div",
                new { Div = SessionState.DivisionID });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "system_setup has no '{Option}' column; falling back to appoptions", optionName);
        }
        if (string.IsNullOrEmpty(raw))
        {
            raw = await db.ExecuteScalarAsync<string>(
                @"SELECT TOP 1 optionvalue FROM appoptions
                  WHERE ISNULL(divisionid,0) IN (0, @Div) AND optionname = @Name
                  ORDER BY divisionid DESC",
                new { Div = SessionState.DivisionID, Name = optionName });
        }
        return ToBool(raw);
    }

    private static bool ToBool(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return false;
        var s = raw.Trim();
        if (string.Equals(s, "true", StringComparison.OrdinalIgnoreCase)) return true;
        if (string.Equals(s, "false", StringComparison.OrdinalIgnoreCase)) return false;
        if (decimal.TryParse(s, out var n)) return n != 0;          // 1 / -1 → true, 0 → false
        return true;                                                // non-empty non-zero → true
    }

    // VB6 IniGetGrid(Me, gData) → AppGridLayout key "FCommunityStandards.gData".
    private async Task LoadGridLayoutAsync()
    {
        await _grid.LoadAsync(GridLayoutSvc);

        // VB6 default editable set (gData_BeforeEdit): Phase, Item, ItemDesc,
        // Notes. Everything else (incl. the Std* / Community* columns and the
        // StdItemDesc outline column) is read-only.
        void Flip(string field)
        {
            if (GridLayout.TryGetValue(field, out var col)) col.IsEditable = true;
        }
        Flip(nameof(CommunityStandardRow.Phase));
        Flip(nameof(CommunityStandardRow.Item));
        Flip(nameof(CommunityStandardRow.ItemDesc));
        Flip(nameof(CommunityStandardRow.Notes));

        // VB6 OutlineCol = ColIndex("StdItemDesc") — the community-folder text
        // and the standard description share this column, so we group on it.
        GroupColumns = BuildGroupColumns();

        Logger.LogInformation(
            "FCommunityStandards.gData load: {Count} dict entries, fallback={Fallback}",
            GridLayout.Count, GridLayoutFallbackUsed);
    }

    private List<string> BuildGroupColumns()
    {
        // Explicit grouped flags take priority (matches FAssembly), but the VB6
        // form always groups by the community description (the IsSubtotal level-0
        // rows). The layout itself doesn't store a grouped flag for gData, so
        // fall back to CommunityDesc — the VB6 OutlineCol behavior.
        var grouped = HasGridLayout ? _grid.GroupedFields() : new List<string>();
        return grouped.Count > 0
            ? grouped
            : new List<string> { nameof(CommunityStandardRow.CommunityDesc) };
    }

    private IEnumerable<(GridLayoutColumn Layout, string Field)> GetOrderedGridLayout()
        => _grid.GetOrdered().Select(e => (e.Layout, e.Field));

    private string ResolveGridField(string layoutField)
        => _grid.ResolveField(layoutField);

    // VB6 grid widths are twips (15 twips per pixel at 96 DPI). FAssembly parity.
    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // ═══════════════════════════════════════════════════════════════════
    // ── LoadData (VB6 LoadData) ─────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════
    private async Task LoadDataAsync()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            // Verbatim port of VB6 LoadData two-part UNION. The phase-specific
            // join is gated by 1=@PhaseSpecific (1 when phase-specific, else 2 so
            // CommunityPhase joins nothing). Second arm covers communities with
            // no phase (CommunityPhase = '').
            var sql = @"
                SELECT c.Area Community,
                       p.CommunityPhase,
                       ISNULL(c.Description,'') + ISNULL(' ' + p.Description,'') CommunityDesc,
                       ti.Phase StdPhase,
                       ti.Item StdItem,
                       ti.Description StdItemDesc,
                       si.Phase,
                       si.Item,
                       si.Description ItemDesc,
                       s.Notes
                FROM tblLocality c
                JOIN DivisionCommunities d ON d.Community = c.Area
                LEFT OUTER JOIN CommunityPhase p ON (c.Area = p.Community AND 1=@PhaseSpecific)
                LEFT OUTER JOIN CommunityStandardItems t ON (1=1)
                JOIN tblPhaseItem ti ON (ti.DivisionID = @DivisionID AND t.Phase = ti.Phase AND t.Item = ti.Item)
                LEFT OUTER JOIN CommunityStandards s
                    ON (s.StdPhase=t.Phase AND s.StdItem=t.Item AND s.Community=c.Area AND s.CommunityPhase=ISNULL(p.CommunityPhase,''))
                LEFT OUTER JOIN tblPhaseItem si ON (si.DivisionID = @DivisionID AND s.Phase=si.Phase AND s.Item=si.Item)
                WHERE ISNULL(c.Inactive,0)=0 AND d.DivisionID = @DivisionID
                UNION
                SELECT c.Area Community,
                       NULL CommunityPhase,
                       ISNULL(c.Description,'') CommunityDesc,
                       ti.Phase StdPhase,
                       ti.Item StdItem,
                       ti.Description StdItemDesc,
                       si.Phase,
                       si.Item,
                       si.Description ItemDesc,
                       s.Notes
                FROM tblLocality c
                JOIN DivisionCommunities d ON d.Community = c.Area
                LEFT OUTER JOIN CommunityStandardItems t ON (1=1)
                JOIN tblPhaseItem ti ON (ti.DivisionID = @DivisionID AND t.Phase = ti.Phase AND t.Item = ti.Item)
                LEFT OUTER JOIN CommunityStandards s
                    ON (s.StdPhase=t.Phase AND s.StdItem=t.Item AND s.Community=c.Area AND s.CommunityPhase='')
                LEFT OUTER JOIN tblPhaseItem si ON (si.DivisionID = @DivisionID AND s.Phase=si.Phase AND s.Item=si.Item)
                WHERE ISNULL(c.Inactive,0)=0 AND d.DivisionID = @DivisionID
                ORDER BY 1,2,4,5";

            var rows = await db.QueryAsync(sql, new
            {
                DivisionID = SessionState.DivisionID,
                PhaseSpecific = CommunityStandardsArePhaseSpecific ? 1 : 2
            });

            Standards = rows.Select(r => new CommunityStandardRow
            {
                Community = r["Community"]?.ToString() ?? "",
                CommunityPhase = r["CommunityPhase"]?.ToString() ?? "",
                CommunityDesc = r["CommunityDesc"]?.ToString() ?? "",
                StdPhase = r["StdPhase"]?.ToString() ?? "",
                StdItem = r["StdItem"]?.ToString() ?? "",
                StdItemDesc = r["StdItemDesc"]?.ToString() ?? "",
                Phase = r["Phase"]?.ToString() ?? "",
                // VB6 only copies ItemDesc when Item <> "".
                Item = r["Item"]?.ToString() ?? "",
                ItemDesc = string.IsNullOrEmpty(r["Item"]?.ToString())
                    ? "" : (r["ItemDesc"]?.ToString() ?? ""),
                Notes = r["Notes"]?.ToString() ?? "",
                IsDirty = false
            }).ToList();

            mDirty = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading {Community} standards", CommunityLabel);
            Notifications.Error($"Error loading {CommunityLabel} standards: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════════
    // ── Cell edit / dirty (VB6 gData_AfterEdit) ─────────────────────────
    // ═══════════════════════════════════════════════════════════════════
    private void MarkDirty(CommunityStandardRow row)
    {
        // VB6 marks only level-1 (item) rows dirty; folder rows are never edited.
        if (!IsItemRow(row)) return;
        row.IsDirty = true;
        mDirty = true;
    }

    // A "level-1" item row has a standard (StdItem) attached; folder/group rows
    // are synthesized by the grouping engine, so any real data row qualifies.
    private static bool IsItemRow(CommunityStandardRow row) =>
        row != null && !string.IsNullOrEmpty(row.StdItem);

    private static string GetCellValue(CommunityStandardRow row, string field) => field switch
    {
        nameof(CommunityStandardRow.Phase) => row.Phase,
        nameof(CommunityStandardRow.Item) => row.Item,
        nameof(CommunityStandardRow.ItemDesc) => row.ItemDesc,
        _ => ""
    };

    // VB6 gData_KeyDown vbKeyDelete on Phase/Item/ItemDesc: clears Phase, Item,
    // ItemDesc AND Notes together, then marks dirty (gData_AfterEdit).
    private async Task ClearItem(CommunityStandardRow? row)
    {
        if (row == null || !IsItemRow(row)) return;
        row.Phase = "";
        row.Item = "";
        row.ItemDesc = "";
        row.Notes = "";
        MarkDirty(row);
        if (gData != null) await gData.Refresh();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ── Save (VB6 SaveData) ─────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════
    private async Task OnSaveClick() => await SaveDataAsync(false);

    private async Task<bool> SaveDataAsync(bool prompt)
    {
        // VB6: If Not mDirty Then SaveData = True : Exit Function.
        if (!mDirty) return true;

        if (prompt && messageBox != null)
        {
            // VB6 MsgBox(vbYesNoCancel): Yes=save, No=discard(true), Cancel=abort(false).
            var result = await messageBox.ShowAsync(
                $"{CommunityLabel} Standards have changed.\n\nDo you want to save these changes?\n",
                "HomeFront", MessageBoxButtons.YesNoCancel);
            if (result == MessageBoxResult.No) return true;
            if (result == MessageBoxResult.Cancel) return false;
        }

        IsLoading = true;
        StateHasChanged();

        try
        {
            // VB6 iterates every level-1 row with RowData <> "" (dirty).
            foreach (var row in Standards.Where(r => r.IsDirty && IsItemRow(r)))
            {
                // (1) INSERT — duplicate-key is swallowed (VB6 eh: Resume Next on
                //     "duplicate"), so the row is then UPDATEd whether new or not.
                var insertSql = @"
                    INSERT INTO CommunityStandards(Community,CommunityPhase,StdPhase,StdItem,Phase,Item,Notes)
                    VALUES(@Community,@CommunityPhase,@StdPhase,@StdItem,@Phase,@Item,@Notes)";
                try
                {
                    await db.ExecuteAsync(insertSql, new
                    {
                        row.Community,
                        row.CommunityPhase,
                        row.StdPhase,
                        row.StdItem,
                        row.Phase,
                        row.Item,
                        Notes = row.Notes ?? ""
                    });
                }
                catch (Exception ex)
                {
                    if (!ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                        throw;
                }

                // (2) UPDATE — VB6 blanks Notes when this row's Item is "".
                var notes = string.IsNullOrEmpty(row.Item) ? "" : row.Notes ?? "";
                var updateSql = @"
                    UPDATE CommunityStandards
                       SET Phase=@Phase,
                           Item=@Item,
                           Notes=@Notes
                     WHERE Community=@Community
                       AND CommunityPhase=@CommunityPhase
                       AND StdPhase=@StdPhase
                       AND StdItem=@StdItem";
                await db.ExecuteAsync(updateSql, new
                {
                    row.Community,
                    row.CommunityPhase,
                    row.StdPhase,
                    row.StdItem,
                    row.Phase,
                    row.Item,
                    Notes = notes
                });

                // (3) Prune empty mappings (VB6 runs this per dirty row).
                await db.ExecuteAsync(
                    "DELETE FROM CommunityStandards WHERE ISNULL(Phase,'')='' AND ISNULL(Item,'')='' AND ISNULL(StdPhase,'')<>'' AND ISNULL(Community,'')<>''");

                row.IsDirty = false;   // VB6 RowData(i) = ""
            }

            mDirty = false;
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving {Community} standards", CommunityLabel);
            Notifications.Error($"Error saving: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════════
    // ── Notes editor (VB6 gData_CellButtonClick "Notes" → FComments) ────
    // ═══════════════════════════════════════════════════════════════════
    private void OpenNotes(CommunityStandardRow? row)
    {
        if (row == null || !IsItemRow(row) || string.IsNullOrEmpty(row.Item)) return;
        NotesEditingRow = row;
        NotesEditText = row.Notes ?? "";
        IsNotesDialogVisible = true;
    }

    // FComments OnSave: NotesEditText has already been committed back through
    // @bind-Value. VB6 FComments.Edit returns the new text → write it to the row.
    private async Task OnNotesCommitted()
    {
        if (NotesEditingRow != null)
        {
            NotesEditingRow.Notes = NotesEditText ?? "";
            MarkDirty(NotesEditingRow);
        }
        if (gData != null) await gData.Refresh();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ── Item pick list (VB6 gData_CellButtonClick Phase/Item/ItemDesc) ──
    // ═══════════════════════════════════════════════════════════════════
    private async Task OpenItemPick(CommunityStandardRow? row)
    {
        if (row == null || !IsItemRow(row) || pickList == null) return;
        PickTargetRow = row;
        // VB6: "select phase,item,description,notes from tblphaseitem where DivisionID = " & HFApp.DivisionID
        var sql = "SELECT Phase, Item, Description, Notes FROM tblPhaseItem WHERE DivisionID = @DivisionID";
        await pickList.Open("Item", sql, parameters: new Dictionary<string, object>
        {
            ["DivisionID"] = SessionState.DivisionID
        });
    }

    private async Task OnItemPicked(List<IDictionary<string, object>>? selected)
    {
        if (PickTargetRow == null || selected == null || selected.Count == 0) return;
        var pick = selected[0];

        // VB6 copies Phase, Item, Description→ItemDesc, Notes from the picked row.
        PickTargetRow.Phase = GetPickString(pick, "Phase");
        PickTargetRow.Item = GetPickString(pick, "Item");
        PickTargetRow.ItemDesc = GetPickString(pick, "Description");
        PickTargetRow.Notes = GetPickString(pick, "Notes");
        MarkDirty(PickTargetRow);   // VB6 calls gData_AfterEdit

        if (gData != null) await gData.Refresh();
    }

    private static string GetPickString(IDictionary<string, object> row, string key)
    {
        if (row.TryGetValue(key, out var v) && v != null) return v.ToString() ?? "";
        foreach (var kvp in row)
            if (string.Equals(kvp.Key, key, StringComparison.OrdinalIgnoreCase))
                return kvp.Value?.ToString() ?? "";
        return "";
    }

    // ═══════════════════════════════════════════════════════════════════
    // ── Row model ───────────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════
    public class CommunityStandardRow
    {
        public string Community { get; set; } = "";
        public string CommunityPhase { get; set; } = "";
        public string CommunityDesc { get; set; } = "";
        public string StdPhase { get; set; } = "";
        public string StdItem { get; set; } = "";
        public string StdItemDesc { get; set; } = "";
        public string Phase { get; set; } = "";
        public string Item { get; set; } = "";
        public string ItemDesc { get; set; } = "";
        public string Notes { get; set; } = "";
        public bool IsDirty { get; set; }
    }
