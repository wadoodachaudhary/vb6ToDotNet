@namespace HomeFront.Components.Pages
@page "/option-list-multi-select"
@page "/option-list-multi-select/{Job}"
@rendermode InteractiveServer

@using HomeFront.Models
@using HomeFront.Data
@using System.Data
@using System.Reflection
@using System.Text
@using Fx.ControlKit.Notifications

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<FrmOptionListMultiSelect> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db

<PageTitle>HSMC - Option List</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Options...</div>
    </div>
}

<div class="option-container">
    @* Option Type Frame *@
    <fieldset class="option-type-frame">
        <legend>Option Type</legend>
        <div class="option-type-group">
            <RadioControl TValue="int" Name="optionType" Value="3"
                          @bind-SelectedValue="SelectedOptionType"
                          @bind-SelectedValue:after="ReloadOptionsAsync"
                          Label="All Options Combined" />
            <RadioControl TValue="int" Name="optionType" Value="1"
                          @bind-SelectedValue="SelectedOptionType"
                          @bind-SelectedValue:after="ReloadOptionsAsync"
                          Label="Model Specific Options" />
            <RadioControl TValue="int" Name="optionType" Value="2"
                          @bind-SelectedValue="SelectedOptionType"
                          @bind-SelectedValue:after="ReloadOptionsAsync"
                          Label="Personal Choice Options" />
            @if (ShowCustomerShoppingCart)
            {
                <RadioControl TValue="int" Name="optionType" Value="4"
                              @bind-SelectedValue="SelectedOptionType"
                              @bind-SelectedValue:after="ReloadOptionsAsync"
                              Label="Customer Shopping Cart" />
            }
            @if (UseCORequests)
            {
                <RadioControl TValue="int" Name="optionType" Value="5"
                              @bind-SelectedValue="SelectedOptionType"
                              @bind-SelectedValue:after="ReloadOptionsAsync"
                              Label="Change Requests" />
            }
        </div>
    </fieldset>

    @* Main Content *@
    <div class="main-content">
        @* Grid Panel *@
        <div class="grid-panel">
            <GridControl @ref="ItemsGrid"
                    TValue="OptionItemRow"
                    DataSource="@ItemsData"
                    AllowSelection="true"
                    AllowSorting="true"
                    AllowFiltering="true"
                    AllowResizing="true"
                    EnableHover="true"
                    Height="100%"
                    RowHeight="28"
                    FilterSettingsRef="@filterSettings"
                    PageSettingsRef="@pageSettings"
                    SelectionSettingsRef="@selectionSettings"
                    EditSettingsRef="@editSettings"
                    EventsRef="@gridEvents">
                <GridColumnsBase @key="gItemsGridLayoutVersion">
                    @if (HasGridLayout)
                    {
                        foreach (var entry in GetOrderedGridLayout())
                        {
                            var layout = entry.Layout;
                            var fieldName = entry.Field;
                            var columnType = entry.ColumnType;
                            var textAlign = entry.TextAlign;
                            var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                            var width = layout.Width.HasValue && layout.Width.Value > 0
                                ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;

                            if (fieldName == "Location")
                            {
                                <GridColumn Field="Location" HeaderText="@headerText" Width="@(width ?? "120px")" AllowEditing="true">
                                    <Template>
                                        @{
                                            var data = (OptionItemRow)context;
                                            <span>@data.Location</span>
                                            <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                                    @onclick="() => OnLocationButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                        }
                                    </Template>
                                </GridColumn>
                            }
                            else if (fieldName == "Color")
                            {
                                <GridColumn Field="Color" HeaderText="@headerText" Width="@(width ?? "100px")" AllowEditing="true">
                                    <Template>
                                        @{
                                            var data = (OptionItemRow)context;
                                            <span>@data.Color</span>
                                            @if (data.ColorListID != 0)
                                            {
                                                <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                                        @onclick="() => OnColorButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                            }
                                        }
                                    </Template>
                                </GridColumn>
                            }
                            else if (fieldName == "Style")
                            {
                                <GridColumn Field="Style" HeaderText="@headerText" Width="@(width ?? "100px")" AllowEditing="true">
                                    <Template>
                                        @{
                                            var data = (OptionItemRow)context;
                                            <span>@data.Style</span>
                                            @if (data.StyleListID != 0)
                                            {
                                                <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                                        @onclick="() => OnStyleButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                            }
                                        }
                                    </Template>
                                </GridColumn>
                            }
                            else if (fieldName == "Finish")
                            {
                                <GridColumn Field="Finish" HeaderText="@headerText" Width="@(width ?? "100px")" AllowEditing="true">
                                    <Template>
                                        @{
                                            var data = (OptionItemRow)context;
                                            <span>@data.Finish</span>
                                            @if (data.FinishListID != 0)
                                            {
                                                <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                                        @onclick="() => OnFinishButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                            }
                                        }
                                    </Template>
                                </GridColumn>
                            }
                            else if (fieldName == "Other")
                            {
                                <GridColumn Field="Other" HeaderText="@headerText" Width="@(width ?? "100px")" AllowEditing="true">
                                    <Template>
                                        @{
                                            var data = (OptionItemRow)context;
                                            <span>@data.Other</span>
                                            @if (data.OtherListID != 0)
                                            {
                                                <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                                        @onclick="() => OnOtherButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                            }
                                        }
                                    </Template>
                                </GridColumn>
                            }
                            else if (fieldName == "Comments")
                            {
                                <GridColumn Field="Comments" HeaderText="@headerText" Width="@(width ?? "200px")" AllowEditing="true">
                                    <Template>
                                        @{
                                            var data = (OptionItemRow)context;
                                            <span title="@data.Comments">@TruncateText(data.Comments, 30)</span>
                                            <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                                    @onclick="() => OnCommentsButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                        }
                                    </Template>
                                </GridColumn>
                            }
                            else
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              AllowEditing="true"
                                              ClipMode="ClipMode.Ellipsis" />
                            }
                        }
                        <GridColumn Field="@nameof(OptionItemRow.ColorListID)" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.StyleListID)" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.FinishListID)" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.OtherListID)" Visible="false" />
                    }
                    else
                    {
                        @* Fallback: hardcoded columns matching VB6 ItemsGrid *@
                        <GridColumn Field="@nameof(OptionItemRow.Pick)" HeaderText="Pick" Width="60px"
                                      Type="ColumnType.CheckBox" AllowEditing="true" />
                        <GridColumn Field="@nameof(OptionItemRow.Qty)" HeaderText="Qty" Width="60px"
                                      Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right"
                                      AllowEditing="true" />
                        <GridColumn Field="@nameof(OptionItemRow.UOM)" HeaderText="UOM" Width="60px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(OptionItemRow.Price)" HeaderText="Price" Width="100px"
                                      Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right"
                                      AllowEditing="true" />
                        @if (UseMajorGroup)
                        {
                            <GridColumn Field="@nameof(OptionItemRow.MajDesc)" HeaderText="Group" Width="120px"
                                          AllowEditing="false" />
                        }
                        <GridColumn Field="@nameof(OptionItemRow.CatDesc)" HeaderText="Category" Width="140px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(OptionItemRow.Description)" HeaderText="Description" Width="250px"
                                      AllowEditing="false" />
                        <GridColumn Field="@nameof(OptionItemRow.OPT)" HeaderText="OPT" Width="80px"
                                      AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.Assembly)" HeaderText="Assembly" Width="100px"
                                      AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.Location)" HeaderText="Location" Width="120px"
                                      AllowEditing="true">
                            <Template>
                                @{
                                    var data = (OptionItemRow)context;
                                    <span>@data.Location</span>
                                    <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                            @onclick="() => OnLocationButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(OptionItemRow.Color)" HeaderText="Color" Width="100px"
                                      AllowEditing="true">
                            <Template>
                                @{
                                    var data = (OptionItemRow)context;
                                    <span>@data.Color</span>
                                    @if (data.ColorListID != 0)
                                    {
                                        <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                                @onclick="() => OnColorButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                    }
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(OptionItemRow.Style)" HeaderText="Style" Width="100px"
                                      AllowEditing="true">
                            <Template>
                                @{
                                    var data = (OptionItemRow)context;
                                    <span>@data.Style</span>
                                    @if (data.StyleListID != 0)
                                    {
                                        <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                                @onclick="() => OnStyleButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                    }
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(OptionItemRow.Finish)" HeaderText="Finish" Width="100px"
                                      AllowEditing="true">
                            <Template>
                                @{
                                    var data = (OptionItemRow)context;
                                    <span>@data.Finish</span>
                                    @if (data.FinishListID != 0)
                                    {
                                        <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                                @onclick="() => OnFinishButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                    }
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(OptionItemRow.Other)" HeaderText="Other" Width="100px"
                                      AllowEditing="true">
                            <Template>
                                @{
                                    var data = (OptionItemRow)context;
                                    <span>@data.Other</span>
                                    @if (data.OtherListID != 0)
                                    {
                                        <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                                @onclick="() => OnOtherButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                    }
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(OptionItemRow.Comments)" HeaderText="Comments" Width="200px"
                                      AllowEditing="true">
                            <Template>
                                @{
                                    var data = (OptionItemRow)context;
                                    <span title="@data.Comments">@TruncateText(data.Comments, 30)</span>
                                    <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                            @onclick="() => OnCommentsButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(OptionItemRow.EstimatorNotes)" HeaderText="Estimator Notes"
                                      Width="150px" AllowEditing="false" />
                        <GridColumn Field="@nameof(OptionItemRow.Cost_Amount)" HeaderText="Cost" Width="90px"
                                      Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right"
                                      AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.CO_Price)" HeaderText="CO Price" Width="90px"
                                      Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right"
                                      AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.GrandTotal)" HeaderText="Grand Total" Width="100px"
                                      Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right"
                                      AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.GrandCOTotal)" HeaderText="Grand CO Total" Width="100px"
                                      Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right"
                                      AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.TL_Extra)" HeaderText="TL Extra" Width="80px"
                                      AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.Major_Group)" HeaderText="Major Group" Width="80px"
                                      AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.Category)" HeaderText="Category Code" Width="80px"
                                      AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.Option_Type)" HeaderText="Option Type" Width="80px"
                                      AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.Graphic_Path)" HeaderText="Graphic" Width="80px"
                                      AllowEditing="false" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.NoCharge)" HeaderText="No Charge" Width="70px"
                                      Type="ColumnType.CheckBox" AllowEditing="true" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.ColorListID)" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.StyleListID)" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.FinishListID)" Visible="false" />
                        <GridColumn Field="@nameof(OptionItemRow.OtherListID)" Visible="false" />
                    }
                </GridColumnsBase>
            </GridControl>
        </div>

        @* Side Panel *@
        <div class="side-panel">
            <div class="location-row">
                <label>Location</label>
                <TextBoxControl @bind-Value="LocationText" readonly CssClass="olms-location-input" />
                <ButtonControl OnClick="OnLocationDropdownClick" Title="Select Location" CssClass="olms-picker-btn">...</ButtonControl>
            </div>

            <div class="image-viewer">
                @if (!string.IsNullOrEmpty(CurrentImagePath))
                {
                    <img src="@CurrentImagePath" alt="Option Image" />
                }
                else
                {
                    <span class="no-image">No image available</span>
                }
            </div>

            <div class="button-row">
                <ButtonControl OnClick="OnSaveToCustomerClick" CssClass="olms-btn olms-btn-primary">Save to Customer</ButtonControl>
                <ButtonControl OnClick="OnCancelClick" CssClass="olms-btn">&Cancel</ButtonControl>
            </div>
        </div>
    </div>
</div>

@* Comments Edit Dialog *@
<DialogControl @bind-Visible="IsCommentsDialogVisible" Header="Edit Comments" Width="600px" OnClose="OnCommentsDialogCancel">
    <ChildContent>
        <TextAreaControl @bind-Value="EditingComments" Rows="10" MaxLength="4000" CssClass="olms-comments-textarea" />
    </ChildContent>
    <FooterContent>
        <ButtonControl OnClick="OnCommentsDialogOk" CssClass="olms-btn olms-btn-primary">OK</ButtonControl>
        <ButtonControl OnClick="OnCommentsDialogCancel" CssClass="olms-btn">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@* Pick List Dialog *@
<DialogControl @bind-Visible="IsPickListVisible" Header="@PickListTitle" Width="350px" OnClose="OnPickListCancel">
    <ChildContent>
        <div class="olms-picklist-body">
            @foreach (var item in PickListItems)
            {
                <div class="pick-list-item @(item == SelectedPickListItem ? "selected" : "")"
                     @onclick="() => SelectedPickListItem = item">
                    @item
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <ButtonControl OnClick="OnPickListSelect" Disabled="@(SelectedPickListItem == null)" CssClass="olms-btn olms-btn-primary">Select</ButtonControl>
        <ButtonControl OnClick="OnPickListCancel" CssClass="olms-btn">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

@code {
    // === Navigation (close returns to FMain home screen) ===
    [CascadingParameter(Name = "ParentNavigate")]
    private Action<string>? ParentNavigate { get; set; }

    private void ClosePage()
    {
        if (ParentNavigate != null)
            ParentNavigate.Invoke("");
        else
            ClosePage();
    }

    [Parameter] public string? Job { get; set; }

    // Database
private string LoginID = "";

    // UI State
    private bool IsLoading = false;
    private int SelectedOptionType = 2;
    private string LocationText = "";
    private List<string> LocationItems = new();
    private string CurrentImagePath = "";
    private bool ShowCustomerShoppingCart = false;
    private bool UseCORequests = false;
    private bool UseMajorGroup = false;
    private bool OptionByArea = false;
    private bool OptionByAreaPhase = false;
    private bool GlobalOptionByArea = false;
    private bool GlobalOptionByAreaPhase = false;

    // Customer data
    private string CustomerNo = "";
    private string sJob = "";
    private string Model = "";
    private string Series = "";
    private string Community = "";
    private string Elevation = "";
    private string Phase = "";

    // Grid
    private GridControl<OptionItemRow>? ItemsGrid;
    private List<OptionItemRow> ItemsData = new();

    // Grid settings
    private FilterSettings filterSettings = new() { Type = FilterType.FilterBar };
    private PageSettings pageSettings = new() { PageSize = 100 };
    private SelectionSettings selectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single,
        EnableToggle = true
    };
    private EditSettings editSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        ShowConfirmDialog = false
    };
    private GridControlEvents<OptionItemRow> gridEvents = new();

    // ── Grid Layout (dynamic from AppGridLayout) ──────────────
    // Load/resolve/order/width boilerplate delegated to the shared
    // GridLayoutPresenter. The VB6 grid name carries the explicit ".(0)" instance
    // suffix → instanceKey "(0)" drives the presenter's keyed-then-unkeyed
    // two-call fallback. The column-type stays local (bool → CheckBox, not the
    // presenter's generic Boolean — see drift note on GetColumnTypeForField).
    private readonly GridLayoutPresenter<OptionItemRow> _grid =
        new("FrmOptionListMultiSelect", "ItemsGrid", instanceKey: "(0)");
    private Dictionary<string, GridLayoutColumn> gItemsGridLayout => _grid.Layout;
    private bool HasGridLayout => _grid.Has;
    private int gItemsGridLayoutVersion => _grid.Version;

    // Comments dialog
    private bool IsCommentsDialogVisible = false;
    private string EditingComments = "";
    private OptionItemRow? EditingCommentsRow;

    // Pick list dialog
    private bool IsPickListVisible = false;
    private string PickListTitle = "";
    private List<string> PickListItems = new();
    private string? SelectedPickListItem;
    private Action<string>? PickListCallback;

    protected override async Task OnInitializedAsync()
    {
        gridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<OptionItemRow>>(this, OnRowSelected);
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<OptionItemRow>>(this, OnCellSaved);

        await LoadGridLayoutAsync();

        sJob = Job ?? "";
        await LoadFormAsync();
    }

    private async Task LoadFormAsync()
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            // Load app options
            UseCORequests = await GetAppOptionBool("ChangeRequests");
            UseMajorGroup = await GetAppOptionBool("UseMajorGroup");
            OptionByArea = await GetAppOptionBool("OptionByArea");
            OptionByAreaPhase = await GetAppOptionBool("OptionByAreaPhase");
            GlobalOptionByArea = await GetAppOptionBool("GlobalOptionByArea");
            GlobalOptionByAreaPhase = await GetAppOptionBool("GlobalOptionByAreaPhase");

            // Load customer info
            var custSql = @"SELECT TOP 1 customer_no, ISNULL(Community,'') Community, gst_rate, Item_seq,
                           ISNULL(Elevation,'') Elevation, ISNULL(Phase,'') Phase, Model, ISNULL(Series,'') Series
                           FROM tblcustomers WHERE job_no = @Job AND DivisionID = @DivisionID";
            var custDt = db.SqlExec(custSql, new { Job = sJob, SessionState.DivisionID });
            if (custDt.Rows.Count > 0)
            {
                var row = custDt.Rows[0];
                CustomerNo = row["customer_no"]?.ToString() ?? "";
                Community = row["Community"]?.ToString() ?? "";
                Elevation = row["Elevation"]?.ToString() ?? "";
                Phase = row["Phase"]?.ToString() ?? "";
                Model = row["Model"]?.ToString() ?? "";
                Series = row["Series"]?.ToString() ?? "";
            }

            // Check shopping cart count
            var cartCount = SafeInt(db.SqlExec(
                "SELECT COUNT(customer_no) FROM CustomerShoppingCart WHERE ISNULL(addtoco,0) = 0 AND customer_no = @CustomerNo",
                new { CustomerNo }).Rows[0][0]);
            ShowCustomerShoppingCart = cartCount > 0;

            // Default to Personal Choice Options
            SelectedOptionType = 2;
            await LoadOptionsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadFormAsync error");

            Notifications.Error($"Error loading form: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Radio @bind-SelectedValue already set SelectedOptionType; :after triggers the reload.
    private async Task ReloadOptionsAsync()
    {
        await LoadOptionsAsync();
    }

    private async Task LoadOptionsAsync()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            string sql = SelectedOptionType switch
            {
                1 => BuildModelSpecificQuery(),
                2 => BuildPersonalChoiceQuery(),
                3 => BuildAllCombinedQuery(),
                4 => BuildCustomerShoppingCartQuery(),
                5 => BuildChangeRequestsQuery(),
                _ => BuildPersonalChoiceQuery()
            };

            var dt = db.SqlExec(sql);
            ItemsData = new List<OptionItemRow>();

            foreach (DataRow row in dt.Rows)
            {
                var item = new OptionItemRow
                {
                    Pick = false,
                    OPT = row["OPT"]?.ToString() ?? "",
                    Description = row["Description"]?.ToString() ?? "",
                    Price = SafeDecimal(row["Price"]),
                    BasePrice = SafeDecimal(row.Table.Columns.Contains("BasePrice") ? row["BasePrice"] : row["Price"]),
                    CO_Price = SafeDecimal(row.Table.Columns.Contains("CO_Price") ? row["CO_Price"] : null),
                    Cost_Amount = SafeDecimal(row.Table.Columns.Contains("Cost_Amount") ? row["Cost_Amount"] : null),
                    Category = row["Category"]?.ToString() ?? "",
                    CatDesc = row.Table.Columns.Contains("CatDesc") ? (row["CatDesc"]?.ToString() ?? "") : "",
                    MajDesc = row.Table.Columns.Contains("MajDesc") ? (row["MajDesc"]?.ToString() ?? "") : "",
                    Major_Group = row.Table.Columns.Contains("Major_Group") ? (row["Major_Group"]?.ToString() ?? "") : "",
                    Comments = row["Comments"]?.ToString() ?? "",
                    UOM = row.Table.Columns.Contains("UOM") ? (row["UOM"]?.ToString() ?? "") : "",
                    Qty = SafeInt(row.Table.Columns.Contains("Qty") ? row["Qty"] : null, 1),
                    Option_Type = SafeInt(row.Table.Columns.Contains("Option_Type") ? row["Option_Type"] : null),
                    Assembly = row.Table.Columns.Contains("Assembly") ? (row["Assembly"]?.ToString() ?? "") : "",
                    Location = row.Table.Columns.Contains("Location") ? (row["Location"]?.ToString() ?? "") : "",
                    Color = row.Table.Columns.Contains("Color") ? (row["Color"]?.ToString() ?? "") : "",
                    Style = row.Table.Columns.Contains("Style") ? (row["Style"]?.ToString() ?? "") : "",
                    Finish = row.Table.Columns.Contains("Finish") ? (row["Finish"]?.ToString() ?? "") : "",
                    Other = row.Table.Columns.Contains("Other") ? (row["Other"]?.ToString() ?? "") : "",
                    TL_Extra = row.Table.Columns.Contains("TL_Extra") ? (row["TL_Extra"]?.ToString() ?? "") : "",
                    EstimatorNotes = row.Table.Columns.Contains("EstimatorNotes") ? (row["EstimatorNotes"]?.ToString() ?? "") : "",
                    Graphic_Path = row.Table.Columns.Contains("graphic_path") ? (row["graphic_path"]?.ToString() ?? "") : "",
                    GrandTotal = SafeDecimal(row.Table.Columns.Contains("GrandTotal") ? row["GrandTotal"] : null),
                    GrandCOTotal = SafeDecimal(row.Table.Columns.Contains("GrandCOTotal") ? row["GrandCOTotal"] : null),
                    ColorListID = SafeInt(row.Table.Columns.Contains("ColorListID") ? row["ColorListID"] : null),
                    StyleListID = SafeInt(row.Table.Columns.Contains("StyleListID") ? row["StyleListID"] : null),
                    FinishListID = SafeInt(row.Table.Columns.Contains("FinishListID") ? row["FinishListID"] : null),
                    OtherListID = SafeInt(row.Table.Columns.Contains("OtherListID") ? row["OtherListID"] : null),
                    NoCharge = false
                };
                ItemsData.Add(item);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadOptionsAsync error");

            Notifications.Error($"Error loading options: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

