    private void OnRowSelected(RowSelectEventArgs<OptionItemRow> args)
    {
        if (args.Data != null)
        {
            CurrentImagePath = !string.IsNullOrEmpty(args.Data.Graphic_Path)
                ? args.Data.Graphic_Path : "";
        }
    }

    private void OnCellSaved(CellSaveArgs<OptionItemRow> args)
    {
        if (args.Data == null) return;
        // Recalculate totals if price or qty changed
        var col = args.ColumnName ?? "";
        if (col is nameof(OptionItemRow.Price) or nameof(OptionItemRow.Qty))
        {
            args.Data.GrandTotal = args.Data.Price * (args.Data.Qty == 0 ? 1 : args.Data.Qty);
        }
    }

