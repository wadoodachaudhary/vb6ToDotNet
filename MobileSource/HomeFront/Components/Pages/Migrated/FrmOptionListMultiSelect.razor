    private string BuildAreaFilter(string areaCol, string alias, string tableName)
    {
        var s = "";
        if (OptionByArea || OptionByAreaPhase)
        {
            s += $" AND ({areaCol} = dbo.Sales_GetOptionCommunity(Model,OPT,'{Escape(Community)}','{tableName}') OR {areaCol} = '')";
            if (OptionByAreaPhase)
                s += $" AND ({alias}.communityphase ='{Escape(Phase)}' OR {alias}.communityphase ='' OR {alias}.communityphase IS NULL)";
            else
                s += $" AND ({alias}.communityphase ='' OR {alias}.communityphase IS NULL)";
        }
        else
        {
            s += $" AND ({areaCol}='' OR {areaCol} IS NULL OR {areaCol} = 'ALL AREA' OR {areaCol} = 'ALL AREAS')";
        }
        return s;
    }

    private string BuildGlobalAreaFilter()
    {
        var s = "";
        if (GlobalOptionByArea || GlobalOptionByAreaPhase)
        {
            s += $" AND (t1.community = dbo.Sales_GetOptionCommunity('',OPT,'{Escape(Community)}','tblGlobalOptions'))";
            if (GlobalOptionByAreaPhase)
                s += $" AND (t1.communityphase ='{Escape(Phase)}' OR ISNULL(t1.communityphase,'') ='')";
            else
                s += " AND (t1.communityphase ='' OR t1.communityphase IS NULL)";
        }
        else
        {
            s += " AND (T1.Community='' OR t1.Community IS NULL OR t1.Community = 'ALL AREA')";
        }
        return s;
    }

    private string BuildCombinedAreaFilter()
    {
        var s = "";
        if (OptionByArea || OptionByAreaPhase)
        {
            s += $" AND (Community = dbo.Sales_GetOptionCommunity(Model,OPT,'{Escape(Community)}','CombinedOptionlist'))";
            if (OptionByAreaPhase)
                s += $" AND (communityphase ='{Escape(Phase)}' OR ISNULL(communityphase,'') ='')";
            else
                s += " AND (communityphase ='' OR communityphase IS NULL)";
        }
        else
        {
            s += " AND (Community='' OR Community IS NULL OR Community = 'ALL AREA' OR Community = 'ALL AREAS')";
        }
        return s;
    }

