@page "/option-list-multi-select"
@page "/option-list-multi-select/{Job}"
@rendermode InteractiveServer

@using HomeFront.Data
@using System.Data

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>HSMC - Option List</PageTitle>

<style>
    .option-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 80px);
        padding: 8px;
        font-family: 'MS Sans Serif', Arial, sans-serif;
        font-size: 13px;
    }

    .option-type-frame {
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 8px 12px;
        margin-bottom: 8px;
        background: #f8f9fa;
    }

    .option-type-frame legend {
        font-size: 13px;
        font-weight: 600;
        padding: 0 6px;
    }

    .option-type-group {
        display: flex;
        gap: 16px;
        align-items: center;
        flex-wrap: wrap;
    }

    .option-type-group label {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        font-size: 13px;
    }

    .main-content {
        display: flex;
        flex: 1;
        gap: 8px;
        overflow: hidden;
    }

    .grid-panel {
        flex: 1;
        overflow: hidden;
    }

    .side-panel {
        width: 320px;
        min-width: 280px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .location-row {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .location-row label {
        font-size: 13px;
        min-width: 60px;
    }

    .location-row input {
        flex: 1;
        padding: 4px 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 13px;
        background: #e9ecef;
    }

    .location-row button {
        padding: 4px 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 12px;
    }

    .location-row button:hover {
        background: #e9ecef;
    }

    .image-viewer {
        flex: 1;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        min-height: 200px;
    }

    .image-viewer img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .image-viewer .no-image {
        color: #6c757d;
        font-size: 12px;
    }

    .button-row {
        display: flex;
        gap: 8px;
        justify-content: flex-start;
        padding-top: 4px;
    }

    .button-row button {
        padding: 8px 16px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #f7f7f7;
        cursor: pointer;
        font-size: 13px;
        min-width: 100px;
    }

    .button-row button:hover {
        background: #e8e8e8;
    }

    .button-row button.primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }

    .button-row button.primary:hover {
        background: #0b5ed7;
    }

    .loading-overlay {
        position: absolute;
        height: 100%;
        width: 100%;
        background-color: rgba(1, 1, 1, 0.2);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .loading-spinner {
        padding: 20px 40px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
        font-size: 16px;
        font-weight: 500;
        color: #333;
    }

    /* Pick list dialog */
    .dialog-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dialog-panel {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
        min-width: 400px;
        max-width: 600px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px;
        font-weight: 600;
        font-size: 16px;
        border-bottom: 1px solid #dee2e6;
    }

    .dialog-header button {
        background: none;
        border: none;
        font-size: 22px;
        cursor: pointer;
        color: #6c757d;
        padding: 0 4px;
    }

    .dialog-body {
        padding: 20px;
        overflow-y: auto;
        flex: 1;
    }

    .dialog-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 12px 20px;
        border-top: 1px solid #dee2e6;
        background: #f8f9fa;
    }

    .dialog-footer .btn {
        padding: 6px 20px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 14px;
    }

    .dialog-footer .btn:hover {
        background: #e9ecef;
    }

    .dialog-footer .btn-primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }

    .pick-list-item {
        padding: 6px 10px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
    }

    .pick-list-item:hover {
        background: #e8f0fe;
    }

    .pick-list-item.selected {
        background: #cce5ff;
        font-weight: 600;
    }
</style>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Loading Options...</div>
    </div>
}

<div class="option-container">
    @* Option Type Frame *@
    <fieldset class="option-type-frame">
        <legend>Option Type</legend>
        <div class="option-type-group">
            <label>
                <input type="radio" name="optionType" value="3" checked="@(SelectedOptionType == 3)"
                       @onchange="() => OnOptionTypeChanged(3)" />
                All Options Combined
            </label>
            <label>
                <input type="radio" name="optionType" value="1" checked="@(SelectedOptionType == 1)"
                       @onchange="() => OnOptionTypeChanged(1)" />
                Model Specific Options
            </label>
            <label>
                <input type="radio" name="optionType" value="2" checked="@(SelectedOptionType == 2)"
                       @onchange="() => OnOptionTypeChanged(2)" />
                Personal Choice Options
            </label>
            @if (ShowCustomerShoppingCart)
            {
                <label>
                    <input type="radio" name="optionType" value="4" checked="@(SelectedOptionType == 4)"
                           @onchange="() => OnOptionTypeChanged(4)" />
                    Customer Shopping Cart
                </label>
            }
            @if (UseCORequests)
            {
                <label>
                    <input type="radio" name="optionType" value="5" checked="@(SelectedOptionType == 5)"
                           @onchange="() => OnOptionTypeChanged(5)" />
                    Change Requests
                </label>
            }
        </div>
    </fieldset>

    @* Main Content *@
    <div class="main-content">
        @* Grid Panel *@
        <div class="grid-panel">
            <HfGrid @ref="ItemsGrid"
                    TValue="OptionItemRow"
                    DataSource="@ItemsData"
                    AllowSelection="true"
                    AllowSorting="true"
                    AllowFiltering="true"
                    AllowResizing="true"
                    EnableHover="true"
                    Height="100%"
                    RowHeight="28"
                    FilterSettingsRef="@filterSettings"
                    PageSettingsRef="@pageSettings"
                    SelectionSettingsRef="@selectionSettings"
                    EditSettingsRef="@editSettings"
                    EventsRef="@gridEvents">
                <HfGridColumnsBase>
                    <HfGridColumn Field="@nameof(OptionItemRow.Pick)" HeaderText="Pick" Width="60px"
                                  Type="ColumnType.CheckBox" AllowEditing="true" />
                    <HfGridColumn Field="@nameof(OptionItemRow.Qty)" HeaderText="Qty" Width="60px"
                                  Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right"
                                  AllowEditing="true" />
                    <HfGridColumn Field="@nameof(OptionItemRow.UOM)" HeaderText="UOM" Width="60px"
                                  AllowEditing="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.Price)" HeaderText="Price" Width="100px"
                                  Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right"
                                  AllowEditing="true" />
                    @if (UseMajorGroup)
                    {
                        <HfGridColumn Field="@nameof(OptionItemRow.MajDesc)" HeaderText="Group" Width="120px"
                                      AllowEditing="false" />
                    }
                    <HfGridColumn Field="@nameof(OptionItemRow.CatDesc)" HeaderText="Category" Width="140px"
                                  AllowEditing="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.Description)" HeaderText="Description" Width="250px"
                                  AllowEditing="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.OPT)" HeaderText="OPT" Width="80px"
                                  AllowEditing="false" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.Assembly)" HeaderText="Assembly" Width="100px"
                                  AllowEditing="false" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.Location)" HeaderText="Location" Width="120px"
                                  AllowEditing="true">
                        <Template>
                            @{
                                var data = (OptionItemRow)context;
                                <span>@data.Location</span>
                                <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                        @onclick="() => OnLocationButtonClick(data)" @onclick:stopPropagation="true">...</button>
                            }
                        </Template>
                    </HfGridColumn>
                    <HfGridColumn Field="@nameof(OptionItemRow.Color)" HeaderText="Color" Width="100px"
                                  AllowEditing="true">
                        <Template>
                            @{
                                var data = (OptionItemRow)context;
                                <span>@data.Color</span>
                                @if (data.ColorListID != 0)
                                {
                                    <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                            @onclick="() => OnColorButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                }
                            }
                        </Template>
                    </HfGridColumn>
                    <HfGridColumn Field="@nameof(OptionItemRow.Style)" HeaderText="Style" Width="100px"
                                  AllowEditing="true">
                        <Template>
                            @{
                                var data = (OptionItemRow)context;
                                <span>@data.Style</span>
                                @if (data.StyleListID != 0)
                                {
                                    <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                            @onclick="() => OnStyleButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                }
                            }
                        </Template>
                    </HfGridColumn>
                    <HfGridColumn Field="@nameof(OptionItemRow.Finish)" HeaderText="Finish" Width="100px"
                                  AllowEditing="true">
                        <Template>
                            @{
                                var data = (OptionItemRow)context;
                                <span>@data.Finish</span>
                                @if (data.FinishListID != 0)
                                {
                                    <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                            @onclick="() => OnFinishButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                }
                            }
                        </Template>
                    </HfGridColumn>
                    <HfGridColumn Field="@nameof(OptionItemRow.Other)" HeaderText="Other" Width="100px"
                                  AllowEditing="true">
                        <Template>
                            @{
                                var data = (OptionItemRow)context;
                                <span>@data.Other</span>
                                @if (data.OtherListID != 0)
                                {
                                    <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                            @onclick="() => OnOtherButtonClick(data)" @onclick:stopPropagation="true">...</button>
                                }
                            }
                        </Template>
                    </HfGridColumn>
                    <HfGridColumn Field="@nameof(OptionItemRow.Comments)" HeaderText="Comments" Width="200px"
                                  AllowEditing="true">
                        <Template>
                            @{
                                var data = (OptionItemRow)context;
                                <span title="@data.Comments">@TruncateText(data.Comments, 30)</span>
                                <button style="padding:1px 6px; border:1px solid #ced4da; border-radius:3px; background:#fff; font-size:11px; cursor:pointer; margin-left:4px;"
                                        @onclick="() => OnCommentsButtonClick(data)" @onclick:stopPropagation="true">...</button>
                            }
                        </Template>
                    </HfGridColumn>
                    <HfGridColumn Field="@nameof(OptionItemRow.EstimatorNotes)" HeaderText="Estimator Notes"
                                  Width="150px" AllowEditing="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.Cost_Amount)" HeaderText="Cost" Width="90px"
                                  Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right"
                                  AllowEditing="false" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.CO_Price)" HeaderText="CO Price" Width="90px"
                                  Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right"
                                  AllowEditing="false" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.GrandTotal)" HeaderText="Grand Total" Width="100px"
                                  Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right"
                                  AllowEditing="false" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.GrandCOTotal)" HeaderText="Grand CO Total" Width="100px"
                                  Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right"
                                  AllowEditing="false" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.TL_Extra)" HeaderText="TL Extra" Width="80px"
                                  AllowEditing="false" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.Major_Group)" HeaderText="Major Group" Width="80px"
                                  AllowEditing="false" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.Category)" HeaderText="Category Code" Width="80px"
                                  AllowEditing="false" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.Option_Type)" HeaderText="Option Type" Width="80px"
                                  AllowEditing="false" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.Graphic_Path)" HeaderText="Graphic" Width="80px"
                                  AllowEditing="false" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.NoCharge)" HeaderText="No Charge" Width="70px"
                                  Type="ColumnType.CheckBox" AllowEditing="true" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.ColorListID)" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.StyleListID)" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.FinishListID)" Visible="false" />
                    <HfGridColumn Field="@nameof(OptionItemRow.OtherListID)" Visible="false" />
                </HfGridColumnsBase>
            </HfGrid>
        </div>

        @* Side Panel *@
        <div class="side-panel">
            <div class="location-row">
                <label>Location</label>
                <input type="text" @bind="LocationText" readonly />
                <button @onclick="OnLocationDropdownClick" title="Select Location">...</button>
            </div>

            <div class="image-viewer">
                @if (!string.IsNullOrEmpty(CurrentImagePath))
                {
                    <img src="@CurrentImagePath" alt="Option Image" />
                }
                else
                {
                    <span class="no-image">No image available</span>
                }
            </div>

            <div class="button-row">
                <button class="primary" @onclick="OnSaveToCustomerClick">Save to Customer</button>
                <button @onclick="OnCancelClick">&Cancel</button>
            </div>
        </div>
    </div>
</div>

@* Comments Edit Dialog *@
@if (IsCommentsDialogVisible)
{
    <div class="dialog-overlay" @onclick="OnCommentsDialogCancel">
        <div class="dialog-panel" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <span>Edit Comments</span>
                <button @onclick="OnCommentsDialogCancel">×</button>
            </div>
            <div class="dialog-body">
                <textarea @bind="EditingComments" rows="10" style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px; resize:vertical;" maxlength="4000"></textarea>
            </div>
            <div class="dialog-footer">
                <button class="btn btn-primary" @onclick="OnCommentsDialogOk">OK</button>
                <button class="btn" @onclick="OnCommentsDialogCancel">Cancel</button>
            </div>
        </div>
    </div>
}

@* Pick List Dialog *@
@if (IsPickListVisible)
{
    <div class="dialog-overlay" @onclick="OnPickListCancel">
        <div class="dialog-panel" style="min-width:350px;" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <span>@PickListTitle</span>
                <button @onclick="OnPickListCancel">×</button>
            </div>
            <div class="dialog-body" style="max-height:400px; overflow-y:auto;">
                @foreach (var item in PickListItems)
                {
                    <div class="pick-list-item @(item == SelectedPickListItem ? "selected" : "")"
                         @onclick="() => SelectedPickListItem = item">
                        @item
                    </div>
                }
            </div>
            <div class="dialog-footer">
                <button class="btn btn-primary" @onclick="OnPickListSelect" disabled="@(SelectedPickListItem == null)">Select</button>
                <button class="btn" @onclick="OnPickListCancel">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Job { get; set; }

    // Database
    private DbWrapperSqlServer db = new();
    private int DivisionID = 1;
    private string LoginID = "";

    // UI State
    private bool IsLoading = false;
    private bool gCancel = false;
    private bool itemschecked = false;
    private int SelectedOptionType = 2;
    private string LocationText = "";
    private List<string> LocationItems = new();
    private string CurrentImagePath = "";
    private bool ShowCustomerShoppingCart = false;
    private bool UseCORequests = false;
    private bool UseMajorGroup = false;
    private bool OptionByArea = false;
    private bool OptionByAreaPhase = false;
    private bool GlobalOptionByArea = false;
    private bool GlobalOptionByAreaPhase = false;

    // Customer data
    private string CustomerNo = "";
    private string sJob = "";
    private string Model = "";
    private string Series = "";
    private string Community = "";
    private string Elevation = "";
    private string Phase = "";

    // Grid
    private HfGrid<OptionItemRow>? ItemsGrid;
    private List<OptionItemRow> ItemsData = new();

    // Grid settings
    private HfFilterSettings filterSettings = new() { Type = FilterType.FilterBar };
    private HfPageSettings pageSettings = new() { PageSize = 100 };
    private HfSelectionSettings selectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single,
        EnableToggle = true
    };
    private HfEditSettings editSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        ShowConfirmDialog = false
    };
    private HfGridEvents<OptionItemRow> gridEvents = new();

    // Comments dialog
    private bool IsCommentsDialogVisible = false;
    private string EditingComments = "";
    private OptionItemRow? EditingCommentsRow;

    // Pick list dialog
    private bool IsPickListVisible = false;
    private string PickListTitle = "";
    private List<string> PickListItems = new();
    private string? SelectedPickListItem;
    private Action<string>? PickListCallback;

    // Connection string
    private string ConnectionString = "Server=localhost,1433;Database=HomeFrontDB;User Id=sa;Password=YourPassword;Encrypt=false;TrustServerCertificate=true;";

    protected override async Task OnInitializedAsync()
    {
        gridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<OptionItemRow>>(this, OnRowSelected);
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<OptionItemRow>>(this, OnCellSaved);

        sJob = Job ?? "";
        await LoadFormAsync();
    }

    private async Task LoadFormAsync()
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            // Load app options
            UseCORequests = await GetAppOptionBool("ChangeRequests");
            UseMajorGroup = await GetAppOptionBool("UseMajorGroup");
            OptionByArea = await GetAppOptionBool("OptionByArea");
            OptionByAreaPhase = await GetAppOptionBool("OptionByAreaPhase");
            GlobalOptionByArea = await GetAppOptionBool("GlobalOptionByArea");
            GlobalOptionByAreaPhase = await GetAppOptionBool("GlobalOptionByAreaPhase");

            // Load customer info
            var custSql = @"SELECT TOP 1 customer_no, ISNULL(Community,'') Community, gst_rate, Item_seq,
                           ISNULL(Elevation,'') Elevation, ISNULL(Phase,'') Phase, Model, ISNULL(Series,'') Series
                           FROM tblcustomers WHERE job_no = @Job AND DivisionID = @DivisionID";
            var custDt = db.SqlExec(custSql, new { Job = sJob, DivisionID });
            if (custDt.Rows.Count > 0)
            {
                var row = custDt.Rows[0];
                CustomerNo = row["customer_no"]?.ToString() ?? "";
                Community = row["Community"]?.ToString() ?? "";
                Elevation = row["Elevation"]?.ToString() ?? "";
                Phase = row["Phase"]?.ToString() ?? "";
                Model = row["Model"]?.ToString() ?? "";
                Series = row["Series"]?.ToString() ?? "";
            }

            // Check shopping cart count
            var cartCount = SafeInt(db.SqlExec(
                "SELECT COUNT(customer_no) FROM CustomerShoppingCart WHERE ISNULL(addtoco,0) = 0 AND customer_no = @CustomerNo",
                new { CustomerNo }).Rows[0][0]);
            ShowCustomerShoppingCart = cartCount > 0;

            // Default to Personal Choice Options
            SelectedOptionType = 2;
            await LoadOptionsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadFormAsync error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading form: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnOptionTypeChanged(int optionType)
    {
        SelectedOptionType = optionType;
        await LoadOptionsAsync();
    }

    private async Task LoadOptionsAsync()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            string sql = SelectedOptionType switch
            {
                1 => BuildModelSpecificQuery(),
                2 => BuildPersonalChoiceQuery(),
                3 => BuildAllCombinedQuery(),
                4 => BuildCustomerShoppingCartQuery(),
                5 => BuildChangeRequestsQuery(),
                _ => BuildPersonalChoiceQuery()
            };

            var dt = db.SqlExec(sql);
            ItemsData = new List<OptionItemRow>();

            foreach (DataRow row in dt.Rows)
            {
                var item = new OptionItemRow
                {
                    Pick = false,
                    OPT = row["OPT"]?.ToString() ?? "",
                    Description = row["Description"]?.ToString() ?? "",
                    Price = SafeDecimal(row["Price"]),
                    BasePrice = SafeDecimal(row.Table.Columns.Contains("BasePrice") ? row["BasePrice"] : row["Price"]),
                    CO_Price = SafeDecimal(row.Table.Columns.Contains("CO_Price") ? row["CO_Price"] : null),
                    Cost_Amount = SafeDecimal(row.Table.Columns.Contains("Cost_Amount") ? row["Cost_Amount"] : null),
                    Category = row["Category"]?.ToString() ?? "",
                    CatDesc = row.Table.Columns.Contains("CatDesc") ? (row["CatDesc"]?.ToString() ?? "") : "",
                    MajDesc = row.Table.Columns.Contains("MajDesc") ? (row["MajDesc"]?.ToString() ?? "") : "",
                    Major_Group = row.Table.Columns.Contains("Major_Group") ? (row["Major_Group"]?.ToString() ?? "") : "",
                    Comments = row["Comments"]?.ToString() ?? "",
                    UOM = row.Table.Columns.Contains("UOM") ? (row["UOM"]?.ToString() ?? "") : "",
                    Qty = SafeInt(row.Table.Columns.Contains("Qty") ? row["Qty"] : null, 1),
                    Option_Type = SafeInt(row.Table.Columns.Contains("Option_Type") ? row["Option_Type"] : null),
                    Assembly = row.Table.Columns.Contains("Assembly") ? (row["Assembly"]?.ToString() ?? "") : "",
                    Location = row.Table.Columns.Contains("Location") ? (row["Location"]?.ToString() ?? "") : "",
                    Color = row.Table.Columns.Contains("Color") ? (row["Color"]?.ToString() ?? "") : "",
                    Style = row.Table.Columns.Contains("Style") ? (row["Style"]?.ToString() ?? "") : "",
                    Finish = row.Table.Columns.Contains("Finish") ? (row["Finish"]?.ToString() ?? "") : "",
                    Other = row.Table.Columns.Contains("Other") ? (row["Other"]?.ToString() ?? "") : "",
                    TL_Extra = row.Table.Columns.Contains("TL_Extra") ? (row["TL_Extra"]?.ToString() ?? "") : "",
                    EstimatorNotes = row.Table.Columns.Contains("EstimatorNotes") ? (row["EstimatorNotes"]?.ToString() ?? "") : "",
                    Graphic_Path = row.Table.Columns.Contains("graphic_path") ? (row["graphic_path"]?.ToString() ?? "") : "",
                    GrandTotal = SafeDecimal(row.Table.Columns.Contains("GrandTotal") ? row["GrandTotal"] : null),
                    GrandCOTotal = SafeDecimal(row.Table.Columns.Contains("GrandCOTotal") ? row["GrandCOTotal"] : null),
                    ColorListID = SafeInt(row.Table.Columns.Contains("ColorListID") ? row["ColorListID"] : null),
                    StyleListID = SafeInt(row.Table.Columns.Contains("StyleListID") ? row["StyleListID"] : null),
                    FinishListID = SafeInt(row.Table.Columns.Contains("FinishListID") ? row["FinishListID"] : null),
                    OtherListID = SafeInt(row.Table.Columns.Contains("OtherListID") ? row["OtherListID"] : null),
                    NoCharge = false
                };
                ItemsData.Add(item);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadOptionsAsync error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading options: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

