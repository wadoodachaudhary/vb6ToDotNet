    #region Save to Customer

    private async Task OnSaveToCustomerClick()
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            var checkedItems = ItemsData.Where(i => i.Pick).ToList();
            if (checkedItems.Count == 0)
            {
                Notifications.Info("No items selected.");
                return;
            }

            // Create customer estimate
            var estimateIndexDt = db.SqlExec(
                $"EXEC Purch_CreateCustomerEstimate '{Escape(CustomerNo)}', '{Escape(LoginID)}'");
            var estimateIndex = SafeInt(estimateIndexDt.Rows.Count > 0 ? estimateIndexDt.Rows[0][0] : 0);

            foreach (var item in checkedItems)
            {
                var optionType = SelectedOptionType switch
                {
                    1 => 1,
                    2 => 2,
                    _ => item.Option_Type
                };

                var qty = item.Qty == 0 ? 1 : item.Qty;
                var overridePrice = item.Price * qty;

                var s = $@"INSERT INTO tblScheduleB(Customer_No, Item_Seq, Category, UserID,
                          Cost_Amount, Qty, Option_Type, UOM, OPT, Assembly, Location, Color, Style, Finish, Other,
                          Base_Price, Rate, Override_Price, Description, Comments, EstimatorNotes, TL_Extra,
                          Major_Group, CreationDate, ColorListID, StyleListID, FinishListID, OtherListID) VALUES(
                          '{Escape(CustomerNo)}', {estimateIndex}, '{Escape(item.Category)}', '{Escape(LoginID)}',
                          {item.Cost_Amount}, {qty}, {optionType}, '{Escape(item.UOM)}', '{Escape(item.OPT)}',
                          '{Escape(item.Assembly)}', '{Escape(item.Location)}', '{Escape(item.Color)}',
                          '{Escape(item.Style)}', '{Escape(item.Finish)}', '{Escape(item.Other)}',
                          {item.BasePrice}, {item.Price}, {overridePrice}, '{Escape(item.Description)}',
                          '{Escape(item.Comments)}', '{Escape(item.EstimatorNotes)}', '{Escape(item.TL_Extra)}',
                          '{Escape(item.Major_Group)}', GETDATE(),
                          {item.ColorListID}, {item.StyleListID}, {item.FinishListID}, {item.OtherListID})";
                db.SqlExec(s);
            }

            Notifications.Info($"{checkedItems.Count} item(s); saved to customer estimate.");

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnSaveToCustomerClick error");

            Notifications.Error($"Error saving: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

