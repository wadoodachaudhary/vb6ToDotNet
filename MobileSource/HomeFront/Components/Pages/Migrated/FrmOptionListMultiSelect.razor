    }

    private void LoadPickListForField(int listId, Action<string> callback)
    {
        try
        {
            var dt = db.SqlExec("SELECT Description FROM PickListItems WHERE ListID=@ListID ORDER BY SortOrder, Description",
                new { ListID = listId });
            var items = dt.AsEnumerable().Select(r => r["Description"]?.ToString() ?? "").ToList();
            ShowPickList("Select Value", items, callback);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadPickListForField error");

        }
    }

    private static string TruncateText(string? text, int maxLength = 50)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Length <= maxLength ? text : text[..maxLength] + "...";
    }

    private async Task<bool> GetAppOptionBool(string optionName)
    {
        try
        {
            var dt = db.SqlExec($"SELECT TOP 1 [{optionName}] FROM system_setup WHERE id=@Id", new { Id = SessionState.DivisionID });
            if (dt.Rows.Count > 0)
            {
                var val = dt.Rows[0][0]?.ToString() ?? "";
                return val == "1" || val.Equals("true", StringComparison.OrdinalIgnoreCase);
            }
        }
        catch { /* non-critical */ }
        return false;
    }

    // ── Helper Methods ──────────────────────────────────────────────────
    private static string Escape(string? s) => (s ?? "").Replace("'", "''");

    private static decimal SafeDecimal(object? val, decimal def = 0)
    {
        if (val == null || val == DBNull.Value) return def;
        return decimal.TryParse(val.ToString(), out var d) ? d : def;
    }

    private static int SafeInt(object? val, int def = 0)
    {
        if (val == null || val == DBNull.Value) return def;
        return int.TryParse(val.ToString(), out var i) ? i : def;
    }

