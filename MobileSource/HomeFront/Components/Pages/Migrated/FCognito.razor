@page "/cognito"
@namespace HomeFront.Components.Pages
@layout HFComponent
@rendermode InteractiveServer

@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Auth.Cognito
@using Microsoft.AspNetCore.Components.Authorization

@inject IDialogService Dialogs
@inject ILogger<FCognito> Logger
@inject NotificationService Notifications
@inject ICognitoAuthService CognitoAuth

<PageTitle>Cognito</PageTitle>

@if (IsLoading)
{
    <div class="cg-loading">⏳ Working…</div>
}

<div class="cognito-container">

    <div class="cg-toolbar">
        <button class="cg-btn" @onclick="RefreshAllAsync" title="Reload groups and users from the user pool">↻ Refresh</button>
        <span class="cg-pool">User Pool: <strong>@PoolLabel</strong></span>
        @if (!string.IsNullOrEmpty(_directoryError))
        {
            <span class="cg-error" title="@_directoryError">⚠ @_directoryError</span>
        }
    </div>

    <div class="cg-panes">

        @* ── LEFT: Groups (companies) ─────────────────────────────── *@
        <div class="cg-pane cg-groups">
            <div class="cg-pane-head">
                <span class="cg-pane-title">Groups (Companies)</span>
                <span class="cg-count">@Groups.Count</span>
            </div>

            <div class="cg-grid-host">
                <GridControl TValue="CognitoGroup"
                             DataSource="@Groups"
                             AllowSelection="true"
                             AllowSorting="true"
                             EnableHover="true"
                             Height="100%"
                             WidthMode="GridWidthMode.FillAvailable"
                             EventsRef="@_groupsEvents">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(CognitoGroup.Name)" HeaderText="Group" Width="150px" />
                        <GridColumn Field="@nameof(CognitoGroup.UserCount)" HeaderText="Users" Width="60px"
                                    Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(CognitoGroup.Description)" HeaderText="Description (DB attribute)" Width="220px" />
                        <GridColumn Field="@nameof(CognitoGroup.Precedence)" HeaderText="Prec." Width="60px"
                                    Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                    </GridColumnsBase>
                </GridControl>
            </div>

            @if (SelectedGroup != null)
            {
                <div class="cg-selection-bar">
                    Showing users in <strong>@SelectedGroup.Name</strong>
                    <button class="cg-link" @onclick="ClearGroupFilter">show all users</button>
                    <button class="cg-link cg-danger" @onclick="DeleteSelectedGroupAsync">delete group</button>
                </div>
            }

            @* Create group *@
            <div class="cg-form-box">
                <div class="cg-form-title">➕ Create Group / Company</div>
                <div class="cg-row"><label>Name</label><TextBoxControl @bind-Value="_newGroupName" Placeholder="e.g. company-MELS" /></div>
                <div class="cg-row"><label>Description</label><TextBoxControl @bind-Value="_newGroupDesc" Placeholder="Database attribute e.g. HomeFrontSQL" /></div>
                <div class="cg-row"><label>Precedence</label><TextBoxControl @bind-Value="_newGroupPrec" Placeholder="(optional number)" /></div>
                <button class="cg-btn cg-primary" @onclick="CreateGroupAsync" disabled="@(string.IsNullOrWhiteSpace(_newGroupName))">Create Group</button>
            </div>
        </div>

        @* ── RIGHT: Users ─────────────────────────────────────────── *@
        <div class="cg-pane cg-users">
            <div class="cg-pane-head">
                <span class="cg-pane-title">Users@(SelectedGroup != null ? $" in {SelectedGroup.Name}" : " (all)")</span>
                <span class="cg-count">@Users.Count</span>
            </div>

            <div class="cg-grid-host">
                <GridControl TValue="CognitoUserSummary"
                             DataSource="@Users"
                             AllowSelection="true"
                             AllowSorting="true"
                             EnableHover="true"
                             Height="100%"
                             WidthMode="GridWidthMode.FillAvailable"
                             EventsRef="@_usersEvents">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(CognitoUserSummary.Username)" HeaderText="Username" Width="160px" />
                        <GridColumn Field="@nameof(CognitoUserSummary.Email)" HeaderText="Email" Width="200px" />
                        <GridColumn Field="@nameof(CognitoUserSummary.Status)" HeaderText="Status" Width="120px" />
                        <GridColumn Field="@nameof(CognitoUserSummary.Enabled)" HeaderText="Enabled" Width="70px"
                                    Type="ColumnType.CheckBox" />
                    </GridColumnsBase>
                </GridControl>
            </div>

            @* Add selected user to a group *@
            <div class="cg-form-box">
                <div class="cg-form-title">👥 Add User to Group</div>
                <div class="cg-row">
                    <label>User</label>
                    <span class="cg-picked">@(SelectedUser?.Username ?? "(select a user in the grid)")</span>
                </div>
                <div class="cg-row">
                    <label>Group</label>
                    <DropDownListControl TValue="string" TItem="CognitoGroup"
                                         DataSource="@Groups"
                                         TextFieldName="@nameof(CognitoGroup.Name)"
                                         ValueFieldName="@nameof(CognitoGroup.Name)"
                                         Value="@_addToGroupName"
                                         ValueChanged="@(v => _addToGroupName = v)"
                                         Placeholder="Select group…" Width="200px" />
                </div>
                <button class="cg-btn cg-primary" @onclick="AddUserToGroupAsync"
                        disabled="@(SelectedUser == null || string.IsNullOrWhiteSpace(_addToGroupName))">Add to Group</button>
                @if (SelectedUser != null && SelectedGroup != null)
                {
                    <button class="cg-btn cg-danger" @onclick="RemoveUserFromGroupAsync">Remove from @SelectedGroup.Name</button>
                }
            </div>

            @* Create user *@
            <div class="cg-form-box">
                <div class="cg-form-title">➕ Create User in User Pool</div>
                <div class="cg-row"><label>Username</label><TextBoxControl @bind-Value="_newUserName" Placeholder="Cognito username" /></div>
                <div class="cg-row"><label>Email</label><TextBoxControl @bind-Value="_newUserEmail" Placeholder="user@domain.com" /></div>
                <div class="cg-row"><label>Temp Password</label><TextBoxControl @bind-Value="_newUserTempPw" InputType="password" Placeholder="Temporary password" /></div>
                <button class="cg-btn cg-primary" @onclick="CreateUserAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_newUserName) || string.IsNullOrWhiteSpace(_newUserEmail))">Create User</button>
            </div>

            @* Change/Set user password. HHM-583: relocated from FUserPermissions'
               "Cognito Info" sub-tab — Setup → Cognito is the home for all Cognito
               admin per the 2026-07-14 directive; the User Permissions user page is
               now the plain VB6 field stack (FUserPermissions.frm User frame). *@
            <div class="cg-form-box">
                <div class="cg-form-title">🔑 Change/Set User Password</div>
                <div class="cg-row"><label>Username</label><TextBoxControl @bind-Value="_adminSetPwUsername" Placeholder="Cognito Username" /></div>
                <div class="cg-row"><label>New Password</label><TextBoxControl @bind-Value="_adminSetPwPassword" InputType="password" Placeholder="New Password" /></div>
                <div class="cg-row"><label></label><CheckBoxControl @bind-Checked="_adminSetPwPermanent" Label="Permanent (bypass force change)" /></div>
                <button class="cg-btn cg-primary" @onclick="HandleAdminSetUserPasswordAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_adminSetPwUsername) || string.IsNullOrWhiteSpace(_adminSetPwPassword))">Change Cognito Password</button>
            </div>

            @* Delete user *@
            <div class="cg-form-box cg-danger-box">
                <div class="cg-form-title">⚠️ Delete User from User Pool</div>
                <div class="cg-row">
                    <label>User</label>
                    <span class="cg-picked">@(SelectedUser?.Username ?? "(select a user in the grid)")</span>
                </div>
                <button class="cg-btn cg-danger" @onclick="DeleteUserAsync" disabled="@(SelectedUser == null)">Delete User</button>
            </div>
        </div>
    </div>

    @* HHM-583: active-session token-claims viewer, relocated from FUserPermissions'
       "Cognito Info" sub-tab. *@
    <div class="cg-form-box">
        <div class="cg-form-title">Active Cognito Session Token Claims</div>
        @if (IsCognitoSession && CognitoClaims.Any())
        {
            <div style="max-height: 300px; overflow-y: auto; border: 1px solid #ccc; background: #fff; padding: 10px;">
                <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                    <thead>
                        <tr style="border-bottom: 2px solid #ccc; text-align: left;">
                            <th style="padding: 4px;">Claim Type</th>
                            <th style="padding: 4px;">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in CognitoClaims)
                        {
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 4px; word-break: break-all; font-weight: bold; width: 40%;">@claim.Key</td>
                                <td style="padding: 4px; word-break: break-all;">@claim.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert" style="padding: 12px; background: #eaf2f8; border: 1px solid #bce1f2; color: #31708f; border-radius: 4px;">
                Not authenticated via Amazon Cognito. Log in using the "Login Cognito" option to view active token claims.
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsModal { get; set; }

    // HHM-583: relocated from FUserPermissions' "Cognito Info" sub-tab (password
    // console + token-claims viewer) — Setup → Cognito owns all Cognito admin.
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    private bool IsCognitoSession = false;
    private Dictionary<string, string> CognitoClaims = new();

    private string _adminSetPwUsername = "";
    private string _adminSetPwPassword = "";
    private bool _adminSetPwPermanent = true;

    private bool IsLoading;
    private string? _directoryError;
    private string PoolLabel => "Amazon Cognito";

    private List<CognitoGroup> Groups = new();
    private List<CognitoUserSummary> Users = new();
    private CognitoGroup? SelectedGroup;
    private CognitoUserSummary? SelectedUser;

    private readonly GridControlEvents<CognitoGroup> _groupsEvents = new();
    private readonly GridControlEvents<CognitoUserSummary> _usersEvents = new();

    // Create-group form
    private string _newGroupName = "";
    private string _newGroupDesc = "";
    private string _newGroupPrec = "";

    // Create-user form
    private string _newUserName = "";
    private string _newUserEmail = "";
    private string _newUserTempPw = "";

    // Add-to-group
    private string _addToGroupName = "";

    protected override void OnInitialized()
    {
        _groupsEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<CognitoGroup>>(this, OnGroupSelected);
        _usersEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<CognitoUserSummary>>(this, args => SelectedUser = args.Data);
    }

    protected override async Task OnInitializedAsync()
    {
        // HHM-583: decode the active session's Cognito ID-token claims (moved from
        // FUserPermissions.OnInitializedAsync).
        if (authenticationStateTask != null)
        {
            var authState = await authenticationStateTask;
            var user = authState.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                var idTokenClaim = user.FindFirst("CognitoIdToken")?.Value;
                if (!string.IsNullOrEmpty(idTokenClaim))
                {
                    IsCognitoSession = true;
                    CognitoClaims.Clear();
                    try
                    {
                        var decodedClaims = CognitoTokenDecoder.DecodeIdToken(idTokenClaim);
                        foreach (var claim in decodedClaims)
                        {
                            var key = claim.Key;
                            if (key.Contains("/"))
                            {
                                key = key.Substring(key.LastIndexOf('/') + 1);
                            }
                            CognitoClaims[key] = claim.Value;
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Failed to decode Cognito ID token claims");
                    }
                }
            }
        }

        await RefreshAllAsync();
    }

    // HHM-583: moved from FUserPermissions.HandleAdminSetUserPasswordAsync,
    // reworked onto this page's RunAsync busy/error wrapper.
    private async Task HandleAdminSetUserPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_adminSetPwUsername) || string.IsNullOrWhiteSpace(_adminSetPwPassword))
        {
            Notifications.Error("Username and New Password are required.");
            return;
        }

        await RunAsync(async () =>
        {
            var result = await CognitoAuth.AdminSetUserPasswordAsync(_adminSetPwUsername, _adminSetPwPassword, _adminSetPwPermanent);
            if (result.Success)
            {
                Notifications.Success($"Successfully set password for Cognito user: {_adminSetPwUsername}");
                _adminSetPwUsername = "";
                _adminSetPwPassword = "";
            }
            else
            {
                Notifications.Error(result.ErrorMessage ?? "Failed to set Cognito user password.");
            }
        });
    }

    private async Task RefreshAllAsync()
    {
        IsLoading = true; _directoryError = null; StateHasChanged();
        try
        {
            var g = await CognitoAuth.ListGroupsAsync();
            if (g.Success) Groups = g.Items.ToList();
            else _directoryError = FriendlyError(g.ErrorMessage);

            await LoadUsersAsync();
        }
        finally { IsLoading = false; StateHasChanged(); }
    }

    private async Task LoadUsersAsync()
    {
        var u = SelectedGroup == null
            ? await CognitoAuth.ListUsersAsync()
            : await CognitoAuth.ListUsersInGroupAsync(SelectedGroup.Name);
        if (u.Success) Users = u.Items.ToList();
        else { Users = new(); _directoryError ??= FriendlyError(u.ErrorMessage); }
    }

    // The directory/admin APIs need AWS IAM credentials (not the login token). Turn the
    // raw SDK "failed to resolve credentials" dump into an actionable one-liner.
    private static string FriendlyError(string? raw)
    {
        if (!string.IsNullOrEmpty(raw) &&
            raw.Contains("resolve", StringComparison.OrdinalIgnoreCase) &&
            raw.Contains("credential", StringComparison.OrdinalIgnoreCase))
        {
            return "AWS admin credentials are not configured. Set Cognito:AccessKeyId and "
                 + "Cognito:SecretAccessKey (user-secrets in dev, env vars in prod). Login "
                 + "works without them; listing/creating users needs an IAM key.";
        }
        return raw ?? "Cognito directory request failed.";
    }

    private async Task OnGroupSelected(RowSelectEventArgs<CognitoGroup> args)
    {
        SelectedGroup = args.Data;
        _addToGroupName = args.Data?.Name ?? "";
        IsLoading = true; StateHasChanged();
        try { await LoadUsersAsync(); }
        finally { IsLoading = false; StateHasChanged(); }
    }

    private async Task ClearGroupFilter()
    {
        SelectedGroup = null;
        IsLoading = true; StateHasChanged();
        try { await LoadUsersAsync(); }
        finally { IsLoading = false; StateHasChanged(); }
    }

    private async Task CreateGroupAsync()
    {
        if (string.IsNullOrWhiteSpace(_newGroupName)) return;
        int? prec = int.TryParse(_newGroupPrec, out var p) ? p : (int?)null;
        await RunAsync(async () =>
        {
            var r = await CognitoAuth.CreateGroupAsync(_newGroupName.Trim(),
                string.IsNullOrWhiteSpace(_newGroupDesc) ? null : _newGroupDesc.Trim(), prec);
            if (r.Success)
            {
                Notifications.Success($"Group '{_newGroupName}' created.");
                _newGroupName = _newGroupDesc = _newGroupPrec = "";
                await RefreshAllAsync();
            }
            else Notifications.Error(r.ErrorMessage ?? "Failed to create group.");
        });
    }

    private async Task DeleteSelectedGroupAsync()
    {
        if (SelectedGroup == null) return;
        if (!await Dialogs.ConfirmAsync($"Delete group '{SelectedGroup.Name}'? Members are kept, only their membership is removed."))
            return;
        var name = SelectedGroup.Name;
        await RunAsync(async () =>
        {
            var r = await CognitoAuth.DeleteGroupAsync(name);
            if (r.Success) { Notifications.Success($"Group '{name}' deleted."); SelectedGroup = null; await RefreshAllAsync(); }
            else Notifications.Error(r.ErrorMessage ?? "Failed to delete group.");
        });
    }

    private async Task AddUserToGroupAsync()
    {
        if (SelectedUser == null || string.IsNullOrWhiteSpace(_addToGroupName)) return;
        await RunAsync(async () =>
        {
            var r = await CognitoAuth.AddUserToGroupAsync(SelectedUser.Username, _addToGroupName);
            if (r.Success) { Notifications.Success($"Added {SelectedUser.Username} to {_addToGroupName}."); await RefreshAllAsync(); }
            else Notifications.Error(r.ErrorMessage ?? "Failed to add user to group.");
        });
    }

    private async Task RemoveUserFromGroupAsync()
    {
        if (SelectedUser == null || SelectedGroup == null) return;
        var user = SelectedUser.Username; var group = SelectedGroup.Name;
        await RunAsync(async () =>
        {
            var r = await CognitoAuth.RemoveUserFromGroupAsync(user, group);
            if (r.Success) { Notifications.Success($"Removed {user} from {group}."); await LoadUsersAsync(); }
            else Notifications.Error(r.ErrorMessage ?? "Failed to remove user from group.");
        });
    }

    private async Task CreateUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_newUserName) || string.IsNullOrWhiteSpace(_newUserEmail)) return;
        await RunAsync(async () =>
        {
            var temp = string.IsNullOrWhiteSpace(_newUserTempPw) ? $"Hf!{Guid.NewGuid().ToString("N")[..8]}A1" : _newUserTempPw;
            var r = await CognitoAuth.AdminCreateUserAsync(_newUserName.Trim(), _newUserEmail.Trim(), temp);
            if (r.Success)
            {
                Notifications.Success($"User '{_newUserName}' created in the user pool.");
                _newUserName = _newUserEmail = _newUserTempPw = "";
                await RefreshAllAsync();
            }
            else Notifications.Error(r.ErrorMessage ?? "Failed to create user.");
        });
    }

    private async Task DeleteUserAsync()
    {
        if (SelectedUser == null) return;
        var user = SelectedUser.Username;
        if (!await Dialogs.ConfirmAsync($"Permanently delete Cognito user '{user}' from the user pool?")) return;
        await RunAsync(async () =>
        {
            var r = await CognitoAuth.AdminDeleteUserAsync(user);
            if (r.Success) { Notifications.Success($"User '{user}' deleted."); SelectedUser = null; await RefreshAllAsync(); }
            else Notifications.Error(r.ErrorMessage ?? "Failed to delete user.");
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        IsLoading = true; StateHasChanged();
        try { await action(); }
        catch (Exception ex) { Logger.LogError(ex, "Cognito admin action failed"); Notifications.Error($"Error: {ex.Message}"); }
        finally { IsLoading = false; StateHasChanged(); }
    }
}
