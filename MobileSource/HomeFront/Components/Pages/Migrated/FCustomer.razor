@page "/customer"
@page "/customer/{CustomerId}"
@layout HFComponent
@namespace HomeFront.Components.Pages
@rendermode InteractiveServer

@using HomeFront.Models
@using HomeFront.Data
@using System.Data
@using System.Reflection
@using System.Text
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using Fx.ControlKit.Dialogs

@inject NavigationManager NavigationManager
@inject ILogger<FCustomer> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject IGridLayoutService GridLayoutSvc
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>Customer - HomeFront</PageTitle>

<div class="cust-page">
    @* ── TOOLBAR (VB6: Open, Save only) ──────────────────── *@
    <div class="toolbar-cntr">
        <button class="tbar-btn" @onclick="OnOpenClick">
            <img src="images/32/open.ico" alt="Open" onerror="this.style.display='none'" />
            <span class="tool-label">Open</span>
        </button>
        <button class="tbar-btn" @onclick="OnSaveClick" disabled="@(!mDirty)">
            <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
            <span class="tool-label">Save</span>
        </button>
    </div>

    <div class="cust-content">
        @* ── FORM FIELDS (VB6: Left=Customer info, Right=Billing address) ── *@
        <div class="cust-panel">
            <div class="cust-grid">
                @* ── LEFT COLUMN: Customer, Description, Status, Comments ── *@
                <div>
                    <div class="cust-field">
                        <label class="lbl-blue">Customer</label>
                        @* VB6 txtCustomer (MaxLength none design-time; arcustomer col=40). Enabled only when blank (new). *@
                        <TextBoxControl Value="@Customer" ValueChanged="OnCustomerChanged" Enabled="@CustomerEditable" MaxLength="40" CssClass="cust-input w-customer" />
                    </div>
                    <div class="cust-field" style="margin-top:4px;">
                        <label>Description</label>
                        @* VB6 txtDescription MaxLength=60 *@
                        <TextBoxControl Value="@Description" ValueChanged="@(v => { Description = v ?? ""; MarkDirty(); })" MaxLength="60" CssClass="cust-input w-description" />
                    </div>
                    <div class="cust-field" style="margin-top:4px;">
                        <label>Status</label>
                        @* VB6 cboStatus (Active/Inactive) — display only, never persisted by this form *@
                        <DropDownListControl TValue="string" TItem="string"
                                             DataSource="@StatusOptions"
                                             Value="@Status"
                                             ValueChanged="@(v => { Status = v ?? "Active"; MarkDirty(); })"
                                             Width="85px"
                                             CssClass="cust-input w-status" />
                    </div>
                    <div class="cust-field" style="margin-top:4px; align-items:flex-start;">
                        <label style="padding-top:4px;">Comments</label>
                        @* VB6 txtComments MultiLine MaxLength=4000 *@
                        <TextAreaControl Value="@Comments" ValueChanged="@(v => { Comments = v ?? ""; MarkDirty(); })" Rows="4" MaxLength="4000" CssClass="cust-input w-comments" />
                    </div>
                </div>

                @* ── RIGHT COLUMN: Phone, Fax, Billing Address, City, Province, Postal ── *@
                <div>
                    <div class="cust-field">
                        <label>Phone</label>
                        @* VB6 txtPhone MaxLength=25 *@
                        <TextBoxControl Value="@Phone" ValueChanged="@(v => { Phone = v ?? ""; MarkDirty(); })" MaxLength="25" CssClass="cust-input w-phone" />
                    </div>
                    <div class="cust-field" style="margin-top:4px;">
                        <label>Fax</label>
                        @* VB6 txtFax MaxLength=25 *@
                        <TextBoxControl Value="@Fax" ValueChanged="@(v => { Fax = v ?? ""; MarkDirty(); })" MaxLength="25" CssClass="cust-input w-phone" />
                    </div>
                    <div class="cust-field" style="margin-top:4px; align-items:flex-start;">
                        <label class="lbl-blue lbl-stacked" style="padding-top:4px;">Billing<br />Address</label>
                        @* VB6 txtAddress MultiLine MaxLength=75 (split to BillAddr1/BillAddr2 on save) *@
                        <TextAreaControl Value="@Address" ValueChanged="@(v => { Address = v ?? ""; MarkDirty(); })" Rows="3" MaxLength="75" CssClass="cust-input w-address" />
                    </div>
                    <div class="cust-field" style="margin-top:4px;">
                        <label>City</label>
                        @* VB6 txtCity MaxLength=50 *@
                        <TextBoxControl Value="@City" ValueChanged="@(v => { City = v ?? ""; MarkDirty(); })" MaxLength="50" CssClass="cust-input w-city" />
                    </div>
                    <div class="cust-field" style="margin-top:4px;">
                        <label>State/Province</label>
                        @* VB6 txtProvince MaxLength=20 *@
                        <TextBoxControl Value="@Province" ValueChanged="@(v => { Province = v ?? ""; MarkDirty(); })" MaxLength="20" CssClass="cust-input w-state" />
                    </div>
                    <div class="cust-field" style="margin-top:4px;">
                        <label>Postal</label>
                        @* VB6 txtPostal MaxLength=10 *@
                        <TextBoxControl Value="@Postal" ValueChanged="@(v => { Postal = v ?? ""; MarkDirty(); })" MaxLength="10" CssClass="cust-input w-postal" />
                    </div>
                </div>
            </div>
        </div>

        @* ── CONTACTS GRID (VB6: gContacts at bottom) ─────────── *@
        @* Contacts are managed directly within the inline grid. *@
        <div class="contacts-header">
            <h5 class="lbl-blue">Contacts</h5>
        </div>

        @* VB6 gContacts_KeyDown: Shift+Del hides the current row (never the
           trailing blank); the row is deleted on save. *@
        <div @onkeydown="OnContactsKeyDown">
        <GridControl @ref="ContactsGrid"
                TValue="ContactRow"
                DataSource="@ContactsData"
                AllowSelection="true"
                AllowSorting="true"
                AllowResizing="true"
                Height="280px"
                RowHeight="28"
                SelectionSettingsRef="@contactSelection"
                EditSettingsRef="@contactEditSettings"
                NewItemFactory="CreateContactRow"
                EnsureTrailingNewRow="true"
                IsTrailingNewRow="IsContactEmpty"
                AddNewRowOnLastCellExit="true"
                CanAddNewRowOnLastCellExit="CanAppendContactRowAfter"
                EventsRef="@contactGridEvents"
                OnLayoutChanged="@OnContactsLayoutChangedAsync">
            <GridColumnsBase @key="gContactsLayoutVersion">
                <GridColumn Field="@nameof(ContactRow.ContactID)" Visible="false" IsPrimaryKey="true" AllowEditing="false" />
                <GridColumn Field="@nameof(ContactRow.RowState)" Visible="false" AllowEditing="false" />
                @if (HasGridLayout)
                {
                    foreach (var entry in GetOrderedGridLayout())
                    {
                        var layout = entry.Layout;
                        var fieldName = entry.Field;
                        var columnType = entry.ColumnType;
                        var textAlign = entry.TextAlign;
                        var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                        var width = layout.Width.HasValue && layout.Width.Value > 0
                            ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;
                        var allowEdit = IsFieldEditable(fieldName);

                        if (fieldName == "Role")
                        {
                            @* VB6 gContacts ColComboList(Role) = Options.ValueByName("CustomerContactRoles") *@
                            <GridColumn Field="@nameof(ContactRow.Role)" HeaderText="@headerText" Width="@(width ?? "120px")"
                                        AllowEditing="true" EditOptions="@RoleEditOptions"
                                        MaxLength="@GetContactMaxLength(nameof(ContactRow.Role))" />
                        }
                        else if (fieldName == "SendVia")
                        {
                            @* VB6 gContacts ColComboList(SendVia) = "#1;Print|#3;Email|#4;Fax";
                               the CommModeID code round-trips through SendViaText. *@
                            <GridColumn Field="@nameof(ContactRow.SendViaText)" HeaderText="@headerText" Width="@(width ?? "90px")"
                                        AllowEditing="true" EditOptions="@SendViaEditOptions" />
                        }
                        else if (fieldName == "SmsAddress")
                        {
                            @* VB6 gContacts ColComboList(SMSAddress) built from smscarriers (display=name, value=address) *@
                            <GridColumn Field="@nameof(ContactRow.SmsAddress)" HeaderText="@headerText" Width="@(width ?? "160px")"
                                        AllowEditing="true" EditOptions="@SmsCarrierOptions"
                                        MaxLength="@GetContactMaxLength(nameof(ContactRow.SmsAddress))" />
                        }
                        else
                        {
                            <GridColumn Field="@fieldName"
                                          HeaderText="@headerText"
                                          Width="@width"
                                          Type="@columnType"
                                          TextAlign="@textAlign"
                                          AllowEditing="@allowEdit"
                                          MaxLength="@GetContactMaxLength(fieldName)"
                                          ClipMode="ClipMode.Ellipsis" />
                        }
                    }
                }
                else
                {
                    @* Fallback: hardcoded columns matching VB6 gContacts (only when AppGridLayout has no rows) *@
                    <GridColumn Field="@nameof(ContactRow.Role)" HeaderText="Role" Width="120px"
                                EditOptions="@RoleEditOptions"
                                MaxLength="@GetContactMaxLength(nameof(ContactRow.Role))" />
                    <GridColumn Field="@nameof(ContactRow.Name)" HeaderText="Name" Width="160px"
                                MaxLength="@GetContactMaxLength(nameof(ContactRow.Name))" />
                    <GridColumn Field="@nameof(ContactRow.Phone)" HeaderText="Phone" Width="120px"
                                MaxLength="@GetContactMaxLength(nameof(ContactRow.Phone))" />
                    <GridColumn Field="@nameof(ContactRow.Cell)" HeaderText="Mobile" Width="120px"
                                MaxLength="@GetContactMaxLength(nameof(ContactRow.Cell))" />
                    <GridColumn Field="@nameof(ContactRow.Email)" HeaderText="Email" Width="220px"
                                MaxLength="@GetContactMaxLength(nameof(ContactRow.Email))" />
                    <GridColumn Field="@nameof(ContactRow.SendViaText)" HeaderText="Send Via" Width="90px"
                                EditOptions="@SendViaEditOptions" />
                    <GridColumn Field="@nameof(ContactRow.Fax)" HeaderText="Fax" Width="120px"
                                MaxLength="@GetContactMaxLength(nameof(ContactRow.Fax))" />
                    <GridColumn Field="@nameof(ContactRow.SmsAddress)" HeaderText="SMS Provider" Width="160px"
                                EditOptions="@SmsCarrierOptions"
                                MaxLength="@GetContactMaxLength(nameof(ContactRow.SmsAddress))" />
                }
            </GridColumnsBase>
        </GridControl>
        </div>
    </div>
</div>

<MessageBoxControl @ref="messageBox" />

@* ── Pick List Modal ─────────────────────────────────── *@
<FPickList @ref="pickList" OnSelected="OnPickListSelected" />

@code {
    [Parameter] public string? CustomerId { get; set; }

    // ── Navigation (MDI shell self-host) ──────────────────────
    [CascadingParameter(Name = "ParentNavigate")] private Action<string>? ParentNavigate { get; set; }

    // ── Database ──────────────────────────────────────────────
    private int DivisionId => SessionState.DivisionID;

    // ── State ─────────────────────────────────────────────────
    private bool mDirty = false;
    private string mCustomer = "";
    private bool CustomerEditable = true;

    private MessageBoxControl? messageBox;

    // ── Customer Fields ───────────────────────────────────────
    private string Customer = "";
    private string Description = "";
    private string Comments = "";
    private string Address = "";
    private string City = "";
    private string Province = "";
    private string Postal = "";
    private string Phone = "";
    private string Fax = "";
    private string Status = "Active";
    private readonly List<string> StatusOptions = new() { "Active", "Inactive" };

    // ── Contacts ──────────────────────────────────────────────
    private List<ContactRow> ContactsData = new();
    private ContactRow? SelectedContact;
    private readonly HashSet<long> DeletedContactIds = new();

    // ── Lookups ───────────────────────────────────────────────
    private List<ComboItem> RoleOptions = new();
    private List<ComboItem> SmsCarriers = new();

    // VB6 gContacts ColComboList values in FlexKit EditOptions form; the mapped
    // "#value;text" entries store the code and display the name.
    private static readonly string[] SendViaEditOptions = { "Print", "Email", "Fax" };
    private List<string> RoleEditOptions = new();
    private List<string> SmsCarrierOptions = new();

    // ── PickList ──────────────────────────────────────────────
    private FPickList? pickList;

    // ── Grid ──────────────────────────────────────────────────
    private GridControl<ContactRow>? ContactsGrid;
    private readonly SelectionSettings contactSelection = new() { Type = SelectionType.Single, Mode = SelectionMode.Row, EnableToggle = true };
    private readonly EditSettings contactEditSettings = new()
    {
        AllowEditing = true,
        AllowAdding = true,
        AllowDeleting = false,
        AllowEditOnDblClick = true,
        ShowConfirmDialog = false,
        Mode = EditMode.Batch
    };
    private readonly GridControlEvents<ContactRow> contactGridEvents = new();

    // ── Grid Layout (dynamic from AppGridLayout) ──────────────
    // VB6: IniGetGrid(Me, gContacts, , , , True) → gridname "FCustomer.gContacts",
    // Grouped=True. Load/resolve/order/width boilerplate delegated to the shared
    // GridLayoutPresenter; the VB6 field aliases (FirstName/ContactName→Name, etc.)
    // are passed via the ctor alias map. The presenter resolves exact → normalized
    // → alias → literal, matching the old switch order.
    private readonly GridLayoutPresenter<ContactRow> _grid =
        new("FCustomer", "gContacts", grouped: true,
            aliases: new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["firstname"] = nameof(ContactRow.Name),
                ["contactname"] = nameof(ContactRow.Name),
                ["workphone"] = nameof(ContactRow.Phone),
                ["cellphone"] = nameof(ContactRow.Cell),
                ["commmodeid"] = nameof(ContactRow.SendVia),
                ["commmode"] = nameof(ContactRow.SendVia)
            });
    private Dictionary<string, GridLayoutColumn> gContactsLayout => _grid.Layout;
    private bool HasGridLayout => _grid.Has;
    private int gContactsLayoutVersion => _grid.Version;

    // ── Lifecycle ─────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        contactGridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<ContactRow>>(this, OnContactSelected);
        contactGridEvents.RowDeselected = EventCallback.Factory.Create<RowSelectEventArgs<ContactRow>>(this, OnContactDeselected);
        contactGridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<ContactRow>>(this, OnContactCellSaved);

        await LoadGridLayoutAsync();
        await LoadLookupDataAsync();

        if (!string.IsNullOrWhiteSpace(CustomerId) && CustomerId != "?")
        {
            mCustomer = CustomerId!;
            await LoadDataAsync();
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        return Task.CompletedTask;
    }

    // ── Load Grid Layout ──────────────────────────────────────
    // VB6: IniGetGrid(Me, gContacts, , , , True)  → gridname "FCustomer.gContacts", Grouped=True.
    // Columns are AppGridLayout-driven (DBGetGrid), rendered dynamically — never hardcoded.
    private async Task LoadGridLayoutAsync()
    {
        try
        {
            await _grid.LoadAsync(GridLayoutSvc);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadGridLayout");
        }
    }

    // GridControl raises OnLayoutChanged when a resize/reorder/hide/group/rename
    // finishes. The new state lives on the snapshot, not in the presenter's layout
    // dict, so it has to be merged in before the write.
    private async Task OnContactsLayoutChangedAsync(GridSettings snapshot)
    {
        if (snapshot == null || gContactsLayout.Count == 0) return;
        try
        {
            await GridLayoutPersister.MergeSaveAndFlushAsync(
                GridLayoutSvc, "FCustomer", "gContacts", instanceKey: null,
                gContactsLayout, snapshot, ResolveContactsSnapshotField, staticNames: false);

            _grid.BumpVersion();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FCustomer gContacts layout");
        }
    }

    // The SendVia layout column is rendered as the SendViaText GridColumn, so the
    // snapshot reports it under that name.
    private string ResolveContactsSnapshotField(string layoutField)
    {
        var field = ResolveGridField(layoutField);
        return field == nameof(ContactRow.SendVia) ? nameof(ContactRow.SendViaText) : field;
    }

    // ── Load Lookup Data ──────────────────────────────────────
    private async Task LoadLookupDataAsync()
    {
        // VB6: gContacts.ColComboList(SMSAddress) = BuildComboList(
        //        HFApp.SqlExec("select address,name from smscarriers order by 2"), "*name,address", "address")
        //   → display = name, value = address.
        try
        {
            var carriers = await db.QueryAsync("SELECT address, name FROM smscarriers ORDER BY name");
            SmsCarriers = carriers.Select(r => new ComboItem
            {
                Value = r["address"]?.ToString() ?? "",
                Text = r["name"]?.ToString() ?? ""
            }).ToList();
        }
        catch (Exception ex)
        {
            SmsCarriers = new();
            Logger.LogWarning(ex, "LoadSmsCarriers");
        }
        SmsCarrierOptions = SmsCarriers.Select(c => $"#{c.Value};{c.Text}").ToList();

        // VB6: gContacts.ColComboList(Role) = HFApp.Options.ValueByName("CustomerContactRoles").
        // Options.ValueByName resolves the division-specific row over the global (DivisionID 0) row.
        // Pipe-delimited list of role captions. No hardcoded fallback — match VB6 (empty option = empty combo).
        string roles = "";
        try
        {
            roles = await db.ExecuteScalarAsync<string>(
                @"SELECT TOP 1 OptionValue FROM AppOptions
                  WHERE OptionName='CustomerContactRoles' AND DivisionID IN (0, @DivisionID)
                  ORDER BY DivisionID DESC",
                new { DivisionID = DivisionId }) ?? "";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadCustomerContactRoles");
        }

        RoleOptions = roles.Split('|', StringSplitOptions.RemoveEmptyEntries)
                           .Select(r => r.Trim())
                           .Where(r => !string.IsNullOrWhiteSpace(r))
                           .Select(r => new ComboItem { Value = r, Text = r })
                           .ToList();
        RoleEditOptions = RoleOptions.Select(r => r.Value).ToList();
    }

    // ── Load Customer Data ────────────────────────────────────
    private async Task LoadDataAsync()
    {
        try
        {
            var rows = await db.QueryAsync(
                "SELECT * FROM arcustomers WHERE divisionid=@DivisionID AND arcustomer=@Customer",
                new { DivisionID = DivisionId, Customer = mCustomer });

            if (rows.Count == 0)
            {
                ResetForm();
            }
            else
            {
                var row = rows[0];
                Customer = row["arcustomer"]?.ToString() ?? "";
                mCustomer = Customer;
                Description = row["description"]?.ToString() ?? "";
                Comments = row["comments"]?.ToString() ?? "";
                Address = CombineAddress(row["billaddr1"]?.ToString(), row["billaddr2"]?.ToString());
                City = row["billcity"]?.ToString() ?? "";
                Province = row["billprovince"]?.ToString() ?? "";
                Postal = row["billpostalcode"]?.ToString() ?? "";
                Phone = row["phone1"]?.ToString() ?? "";
                Fax = row["fax1"]?.ToString() ?? "";
                Status = IsTrue(row.ContainsKey("Inactive") ? row["Inactive"] : null) ? "Inactive" : "Active";
                CustomerEditable = false;
                await LoadContactsAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FCustomer LoadData");
            Notifications.Error($"Load error: {ex.Message}");
        }

        mDirty = false;
        DeletedContactIds.Clear();
        StateHasChanged();
    }

    private void ResetForm()
    {
        mCustomer = "";
        Customer = "";
        Description = "";
        Comments = "";
        Address = "";
        City = "";
        Province = "";
        Postal = "";
        Phone = "";
        Fax = "";
        Status = "Active";
        ContactsData = new();
        CustomerEditable = true;
    }

    // ── Load Contacts Grid ────────────────────────────────────
    private async Task LoadContactsAsync()
    {
        ContactsData = new();
        if (string.IsNullOrWhiteSpace(mCustomer)) return;

        try
        {
            var rows = await db.QueryAsync(
                "SELECT * FROM contacts WHERE contacttypeid=99 AND arcustomer=@Customer ORDER BY firstname",
                new { Customer = mCustomer });

            foreach (var r in rows)
            {
                ContactsData.Add(new ContactRow
                {
                    ContactID = SafeLong(r.ContainsKey("ContactID") ? r["ContactID"] : null),
                    Role = r.ContainsKey("Role") ? r["Role"]?.ToString() ?? "" : "",
                    Name = r.ContainsKey("FirstName") ? r["FirstName"]?.ToString() ?? "" : "",
                    Phone = r.ContainsKey("WorkPhone") ? r["WorkPhone"]?.ToString() ?? "" : "",
                    Cell = r.ContainsKey("CellPhone") ? r["CellPhone"]?.ToString() ?? "" : "",
                    Fax = r.ContainsKey("Fax") ? r["Fax"]?.ToString() ?? "" : "",
                    Email = r.ContainsKey("Email") ? r["Email"]?.ToString() ?? "" : "",
                    SendVia = SafeInt(r.ContainsKey("CommModeID") ? r["CommModeID"] : null, 1),
                    SmsAddress = r.ContainsKey("SmsAddress") ? r["SmsAddress"]?.ToString() ?? "" : "",
                    RowState = "CLEAN"
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FCustomer LoadContacts");
            Notifications.Error($"Load contacts error: {ex.Message}");
        }
    }

    // ── Toolbar: Open (FPickList) ─────────────────────────────
    private async Task OnOpenClick()
    {
        // VB6 Toolbar "Open": If Not SaveData(True) Then Exit Sub
        if (!await SaveDataAsync(true)) return;
        await OpenCustomerPickList();
    }

    private async Task OpenCustomerPickList()
    {
        if (pickList == null) return;

        // VB6 FCustomer.frm Toolbar_ButtonClick "Open":
        //   s = "Active Customers"   & Chr(1) & "select * from Picklist_ActiveARCustomers   where divisionid=" & DivisionID & Chr(0)
        //   s = s & "Inactive Customers" & Chr(1) & "select * from Picklist_InActiveARCustomers where divisionid=" & DivisionID
        //   FPickList.Choose(db, "Customer", s, txtCustomer.Text, , True, , "divisionid")
        // Two views over the VB6 picklist VIEWS; divisionid column is hidden.
        var queries =
            "Active Customers;SELECT * FROM Picklist_ActiveARCustomers WHERE divisionid=@DivisionID" +
            "|Inactive Customers;SELECT * FROM Picklist_InActiveARCustomers WHERE divisionid=@DivisionID";

        await pickList.Open(
            title: "Customer",
            queries: queries,
            hideColumns: "divisionid",
            defaultItem: !string.IsNullOrWhiteSpace(mCustomer) ? mCustomer : null,
            showNew: true,
            parameters: new Dictionary<string, object> { ["DivisionID"] = DivisionId });
    }

    private async Task OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        if (selectedRows.Count == 0)
        {
            // "New" selected
            ResetForm();
            mDirty = false;
            StateHasChanged();
            return;
        }

        var firstRow = selectedRows[0];
        var custNo = firstRow.ContainsKey("Customer") ? firstRow["Customer"]?.ToString()?.Trim() ?? "" : "";

        if (string.IsNullOrWhiteSpace(custNo))
        {
            ResetForm();
            mDirty = false;
        }
        else
        {
            mCustomer = custNo;
            Customer = custNo;
            await LoadDataAsync();
        }
        StateHasChanged();
    }

    // ── Toolbar: Save ─────────────────────────────────────────
    private async Task OnSaveClick() => await SaveDataAsync(false);

    // Flush any in-flight in-cell Contacts edit before checking mDirty — mirrors
    // VB6 ValidateEdit committing on focus loss. Writes the pending cell back into
    // the ContactRow (so IsContactEmpty is false and the INSERT runs) and tears
    // down the editor buffer so it can't survive the DataSource swap.
    private async Task FlushPendingGridEditsAsync()
    {
        if (ContactsGrid != null) await ContactsGrid.EndEditAsync();
    }

    private async Task<bool> SaveDataAsync(bool prompt)
    {
        await FlushPendingGridEditsAsync();

        // VB6 SaveData(prompt): if not dirty → return True (nothing to do).
        if (!mDirty) return true;

        // VB6: If prompt Then MsgBox vbYesNoCancel
        //   vbNo     → SaveData = True (discard changes, allow caller to proceed)
        //   vbCancel → SaveData = False (abort the caller's action)
        //   vbYes    → fall through and persist
        if (prompt && messageBox != null)
        {
            var answer = await messageBox.ShowAsync("Customer has changed.\n\nDo you want to save these changes?", "Customer", MessageBoxButtons.YesNoCancel, "question");
            if (answer == MessageBoxResult.No) { mDirty = false; return true; }
            if (answer == MessageBoxResult.Cancel) return false;
        }

        Customer = Customer?.Trim() ?? "";

        var (addr1, addr2) = SplitAddress(Address);
        Phone = FormatPhone(Phone);
        Fax = FormatPhone(Fax);

        try
        {
            // VB6: new record when mCustomer is "" or Chr(1)
            if (string.IsNullOrWhiteSpace(mCustomer) || mCustomer == "")
            {
                // VB6: INSERT arcustomers(...) — Inactive is NOT written by this form
                var insertSql = @"
                    INSERT arcustomers(arcustomer,description,comments,billaddr1,billaddr2,billcity,billprovince,billpostalcode,phone1,fax1,divisionid)
                    VALUES(@Customer,@Description,@Comments,@Addr1,@Addr2,@City,@Province,@Postal,@Phone,@Fax,@DivisionID)";
                await db.ExecuteAsync(insertSql, new
                {
                    Customer,
                    Description,
                    Comments,
                    Addr1 = addr1,
                    Addr2 = addr2,
                    City,
                    Province,
                    Postal,
                    Phone,
                    Fax,
                    DivisionID = DivisionId
                });
                mCustomer = Customer;
                CustomerEditable = false;
            }
            else
            {
                // VB6: UPDATE arcustomers SET ... (Inactive is NOT written by this form)
                var updateSql = @"
                    UPDATE arcustomers SET
                        description=@Description,
                        comments=@Comments,
                        BillAddr1=@Addr1,
                        BillAddr2=@Addr2,
                        BillCity=@City,
                        BillProvince=@Province,
                        BillPostalCode=@Postal,
                        Phone1=@Phone,
                        Fax1=@Fax
                    WHERE ARCustomer=@Customer AND divisionid=@DivisionID";
                await db.ExecuteAsync(updateSql, new
                {
                    Customer = mCustomer,
                    Description,
                    Comments,
                    Addr1 = addr1,
                    Addr2 = addr2,
                    City,
                    Province,
                    Postal,
                    Phone,
                    Fax,
                    DivisionID = DivisionId
                });
            }

            var contactsOk = await SaveContactsAsync();
            mDirty = !contactsOk;
            StateHasChanged();
            return contactsOk;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FCustomer SaveData");
            if (ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase)
                || ex.Message.Contains("PRIMARY KEY", StringComparison.OrdinalIgnoreCase))
                Notifications.Error($"'{Customer}' already exists. Please use a different code.");
            else
                Notifications.Error($"Save error: {ex.Message}");
            return false;
        }
    }

    private async Task<bool> SaveContactsAsync()
    {
        var ok = true;
        var cust = string.IsNullOrWhiteSpace(mCustomer) ? Customer : mCustomer;
        if (string.IsNullOrWhiteSpace(cust)) return true;

        foreach (var id in DeletedContactIds.ToList())
        {
            try { await db.ExecuteAsync("DELETE FROM Contacts WHERE ContactID=@Id", new { Id = id }); }
            catch (Exception ex) { ok = false; Logger.LogWarning(ex, "Delete contact {id}", id); };
        }
        DeletedContactIds.Clear();

        // Snapshot: the grid appends the trailing blank row to ContactsData
        // while this loop awaits.
        foreach (var row in ContactsData.ToList())
        {
            if (row.RowState != "DIRTY") continue;
            // Only an unsaved empty row is dropped. VB6 SaveContacts has no
            // emptiness test, so a saved contact the user blanked is UPDATEd.
            if (row.ContactID == 0 && IsContactEmpty(row)) { row.RowState = "CLEAN"; continue; }

            row.Phone = FormatPhone(row.Phone);
            row.Cell = FormatPhone(row.Cell);
            row.Fax = FormatPhone(row.Fax);

            try
            {
                if (row.ContactID == 0)
                {
                    // VB6: INSERT INTO Contacts(ContactTypeID=99, ...)
                    var insertSql = @"
                        INSERT INTO Contacts(ContactTypeID,UserID,ARCustomer,Role,FirstName,WorkPhone,CellPhone,Fax,Email,CommModeID,SmsAddress)
                        OUTPUT INSERTED.ContactID
                        VALUES(99,@UserID,@ARCustomer,@Role,@FirstName,@WorkPhone,@CellPhone,@Fax,@Email,@CommModeID,@SmsAddress)";
                    var newId = await db.ExecuteScalarAsync<long>(insertSql, new
                    {
                        UserID = cust,
                        ARCustomer = cust,
                        row.Role,
                        FirstName = row.Name,
                        WorkPhone = row.Phone,
                        CellPhone = row.Cell,
                        row.Fax,
                        row.Email,
                        // VB6 gContacts_StartEdit seeds SendVia = 1 (Print).
                        CommModeID = row.SendVia == 0 ? 1 : row.SendVia,
                        SmsAddress = row.SmsAddress
                    });
                    row.ContactID = newId;
                }
                else
                {
                    // VB6: UPDATE Contacts SET ...
                    var updateSql = @"
                        UPDATE Contacts SET
                            Role=@Role,
                            FirstName=@FirstName,
                            WorkPhone=@WorkPhone,
                            CellPhone=@CellPhone,
                            Fax=@Fax,
                            Email=@Email,
                            CommModeID=@CommModeID,
                            SmsAddress=@SmsAddress
                        WHERE ContactID=@ContactID";
                    await db.ExecuteAsync(updateSql, new
                    {
                        row.Role,
                        FirstName = row.Name,
                        WorkPhone = row.Phone,
                        CellPhone = row.Cell,
                        row.Fax,
                        row.Email,
                        CommModeID = row.SendVia,
                        row.SmsAddress,
                        row.ContactID
                    });
                }
                row.RowState = "CLEAN";
            }
            catch (Exception ex)
            {
                ok = false;
                Logger.LogError(ex, "FCustomer SaveContact");
                Notifications.Error($"Save contact error: {ex.Message}");
            }
        }

        return ok;
    }

    // ── Grid Event Handlers ───────────────────────────────────
    private void OnContactSelected(RowSelectEventArgs<ContactRow> args) => SelectedContact = args.Data;
    private void OnContactDeselected(RowSelectEventArgs<ContactRow> args) => SelectedContact = null;

    private void OnContactCellSaved(CellSaveArgs<ContactRow> args)
    {
        if (args.Data == null) return;
        MarkContactDirty(args.Data);
    }

    // ── Dirty Tracking ────────────────────────────────────────
    private void MarkDirty() { mDirty = true; }

    private void OnCustomerChanged(string? v)
    {
        Customer = v ?? "";
        mDirty = true;
    }


    private void MarkContactDirty(ContactRow row)
    {
        if (row == null) return;

        // An unsaved row with nothing in it is the trailing blank row: never
        // dirty, never saved (VB6 SaveContacts skips .Rows - 1).
        if (row.ContactID == 0 && IsContactEmpty(row))
        {
            row.RowState = "CLEAN";
            return;
        }

        row.RowState = "DIRTY";
        mDirty = true;
    }

    // ── Grid Layout Helpers (dynamic columns from AppGridLayout) ──
    // Ordering + field-resolution (incl. the VB6 aliases) delegated to the shared
    // GridLayoutPresenter. The column-type is computed by the form's own
    // GetColumnTypeForField below (kept because FCustomer maps bool → CheckBox,
    // not the presenter's generic Boolean — see drift note).
    private IEnumerable<(GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedGridLayout()
    {
        foreach (var (layout, field, _, _) in _grid.GetOrdered())
        {
            var columnType = GetColumnTypeForField(field);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, field, columnType, textAlign);
        }
    }

    private string ResolveGridField(string layoutField)
        => _grid.ResolveField(layoutField);

    // NOTE: intentionally diverges from GridLayoutPresenter.ColumnTypeFor — FCustomer
    // renders bool columns as ColumnType.CheckBox (the presenter would return Boolean),
    // so the per-row checkbox template fires. Kept local for that reason.
    private static ColumnType GetColumnTypeForField(string field)
    {
        if (string.IsNullOrWhiteSpace(field)) return ColumnType.Text;
        if (_contactRowTypeMap.TryGetValue(GridLayoutPresenter.NormalizeKey(field), out var type))
        {
            if (type == typeof(bool)) return ColumnType.CheckBox;
            if (type == typeof(int) || type == typeof(long) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
        }
        return ColumnType.Text;
    }

    // Minimal normalized field → CLR type map (only what GetColumnTypeForField needs,
    // since the full reflection prop-map moved into the presenter).
    private static readonly Dictionary<string, Type> _contactRowTypeMap =
        typeof(ContactRow)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .GroupBy(p => GridLayoutPresenter.NormalizeKey(p.Name))
            .ToDictionary(
                g => g.Key,
                g => Nullable.GetUnderlyingType(g.First().PropertyType) ?? g.First().PropertyType,
                StringComparer.OrdinalIgnoreCase);

    private static bool IsFieldEditable(string field)
    {
        return field switch
        {
            "ContactID" or "RowState" => false,
            _ => true
        };
    }

    private static int ConvertLayoutWidthToPx(double layoutWidth)
        => GridLayoutPresenter.WidthPx(layoutWidth);

    // ── Utility Functions ─────────────────────────────────────
    private static string CombineAddress(string? addr1, string? addr2)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(addr1)) parts.Add(addr1.Trim());
        if (!string.IsNullOrWhiteSpace(addr2)) parts.Add(addr2.Trim());
        return string.Join("\n", parts);
    }

    private static (string Line1, string Line2) SplitAddress(string? address)
    {
        if (string.IsNullOrWhiteSpace(address)) return ("", "");
        var lines = address.Replace("\r\n", "\n").Split('\n');
        var line1 = lines.Length > 0 ? lines[0].Trim() : "";
        var line2 = lines.Length > 1 ? string.Join("\n", lines.Skip(1)).Trim() : "";
        return (line1, line2);
    }

    private static string FormatPhone(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var digits = new string(value.Where(char.IsDigit).ToArray());
        return digits.Length == 10
            ? $"({digits[..3]}) {digits.Substring(3, 3)}-{digits.Substring(6)}"
            : value.Trim();
    }

    private static bool IsTrue(object? val)
    {
        var s = val?.ToString() ?? "";
        return s.Equals("true", StringComparison.OrdinalIgnoreCase) || s == "1";
    }

    private static long SafeLong(object? val) =>
        val == null || val == DBNull.Value ? 0 : Convert.ToInt64(val);

    private static int SafeInt(object? val, int def = 0) =>
        val == null || val == DBNull.Value || !int.TryParse(val.ToString(), out var i) ? def : i;

    private static bool IsContactEmpty(ContactRow row) =>
        string.IsNullOrWhiteSpace(row.Role) &&
        string.IsNullOrWhiteSpace(row.Name) &&
        string.IsNullOrWhiteSpace(row.Phone) &&
        string.IsNullOrWhiteSpace(row.Cell) &&
        string.IsNullOrWhiteSpace(row.Fax) &&
        string.IsNullOrWhiteSpace(row.Email) &&
        string.IsNullOrWhiteSpace(row.SmsAddress) &&
        row.SendVia == 0;

    // ── Trailing Blank Row ────────────────────────────────────
    // VB6 LoadContacts ends with ".AddItem """ so gContacts always carries one
    // blank row, and gContacts_StartEdit appends the next one.
    private static ContactRow CreateContactRow() => new() { SendVia = 0 };

    private static bool CanAppendContactRowAfter(ContactRow row) => !IsContactEmpty(row);

    // VB6 gContacts_KeyDown: Shift+Del drops the current row, never the
    // trailing blank one; the delete is applied on save.
    private void OnContactsKeyDown(KeyboardEventArgs e)
    {
        if (!e.ShiftKey || e.Key != "Delete") return;

        var row = SelectedContact;
        if (row == null || IsContactEmpty(row)) return;

        if (row.ContactID != 0) DeletedContactIds.Add(row.ContactID);
        ContactsData.Remove(row);
        SelectedContact = null;
        mDirty = true;
    }

    // VB6 gContacts_BeforeEdit .EditMaxLength per column.
    private static readonly Dictionary<string, int> ContactMaxLengths =
        new(StringComparer.OrdinalIgnoreCase)
        {
            [nameof(ContactRow.Name)] = 50,
            [nameof(ContactRow.Role)] = 25,
            [nameof(ContactRow.Phone)] = 35,
            [nameof(ContactRow.Cell)] = 35,
            [nameof(ContactRow.Fax)] = 35,
            [nameof(ContactRow.Email)] = 500,
            [nameof(ContactRow.SmsAddress)] = 50
        };

    private static int? GetContactMaxLength(string field) =>
        !string.IsNullOrWhiteSpace(field) && ContactMaxLengths.TryGetValue(field, out var len) ? len : null;

    // ── Models ────────────────────────────────────────────────
    public class ContactRow
    {
        public long ContactID { get; set; }
        public string Role { get; set; } = "";
        public string Name { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Cell { get; set; } = "";
        public string Fax { get; set; } = "";
        public string Email { get; set; } = "";
        public int SendVia { get; set; } = 1;
        public string SmsAddress { get; set; } = "";
        public string RowState { get; set; } = "CLEAN";

        // VB6 gContacts ColComboList(SendVia) = "#1;Print|#3;Email|#4;Fax".
        public string SendViaText
        {
            get => SendVia switch { 1 => "Print", 3 => "Email", 4 => "Fax", _ => "" };
            set => SendVia = (value ?? "").Trim().ToLowerInvariant() switch
            {
                "print" => 1,
                "email" => 3,
                "fax" => 4,
                "" => 0,
                _ => int.TryParse(value, out var sv) ? sv : SendVia
            };
        }
    }

    public class ComboItem
    {
        public string Value { get; set; } = "";
        public string Text { get; set; } = "";
    }

}
