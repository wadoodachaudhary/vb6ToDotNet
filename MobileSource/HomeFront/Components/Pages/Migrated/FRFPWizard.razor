```razor
@page "/rfq-wizard"
@page "/rfq-wizard/{Job}"
@rendermode InteractiveServer

@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using HomeFront.Components.Hf
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>RFQ Wizard - HomeFront</PageTitle>

<style>
    .wizard-container {
        max-width: 700px;
        margin: 0 auto;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        display: flex;
        flex-direction: column;
        min-height: 500px;
    }

    .wizard-header {
        background: linear-gradient(to right, #f8f9fa, #e9ecef);
        border-bottom: 1px solid #dee2e6;
        padding: 16px 20px;
        border-radius: 8px 8px 0 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .wizard-header-icon {
        width: 48px;
        height: 48px;
        background: #0d6efd;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
    }

    .wizard-header-text h4 {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
        color: #333;
    }

    .wizard-header-text p {
        margin: 2px 0 0;
        font-size: 13px;
        color: #6c757d;
    }

    .wizard-body {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
    }

    .wizard-footer {
        border-top: 1px solid #dee2e6;
        padding: 12px 20px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        background: #f8f9fa;
        border-radius: 0 0 8px 8px;
    }

    .wizard-footer button {
        padding: 6px 20px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 14px;
        min-width: 90px;
    }

    .wizard-footer button:hover:not(:disabled) {
        background: #e9ecef;
    }

    .wizard-footer button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .wizard-footer button.btn-primary {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }

    .wizard-footer button.btn-primary:hover:not(:disabled) {
        background: #0b5ed7;
    }

    .wizard-footer button.btn-success {
        background: #198754;
        color: #fff;
        border-color: #198754;
    }

    .wizard-footer button.btn-success:hover:not(:disabled) {
        background: #157347;
    }

    .step-title {
        font-weight: 700;
        font-size: 15px;
        margin-bottom: 8px;
    }

    .step-description {
        font-size: 13px;
        color: #495057;
        margin-bottom: 12px;
        line-height: 1.5;
    }

    .step-hint {
        font-size: 13px;
        color: #6c757d;
        margin-bottom: 12px;
    }

    .step-icon {
        width: 48px;
        height: 48px;
        margin-bottom: 8px;
    }

    .step-content-row {
        display: flex;
        gap: 16px;
    }

    .step-content-left {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 60px;
    }

    .step-content-right {
        flex: 1;
    }

    .field-checkbox-list {
        border: 1px solid #dee2e6;
        border-radius: 4px;
        max-height: 250px;
        overflow-y: auto;
    }

    .field-checkbox-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-bottom: 1px solid #f0f0f0;
        font-size: 13px;
    }

    .field-checkbox-item:last-child {
        border-bottom: none;
    }

    .field-checkbox-item input[type="checkbox"] {
        width: 16px;
        height: 16px;
    }

    .select-all-row {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 6px;
    }

    .select-all-row label {
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
    }

    .select-all-row input[type="checkbox"] {
        width: 16px;
        height: 16px;
    }

    .loading-overlay {
        position: absolute;
        height: 100%;
        width: 100%;
        background-color: rgba(1,1,1,0.2);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .loading-spinner {
        padding: 20px 40px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        font-size: 16px;
        font-weight: 500;
        color: #333;
    }
</style>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">⏳ Processing...</div>
    </div>
}

<div class="wizard-container">
    @* ── HEADER ─────────────────────────────────────────── *@
    <div class="wizard-header">
        <div class="wizard-header-icon">📋</div>
        <div class="wizard-header-text">
            <h4>Generate RFQ's</h4>
            <p>This wizard will help you create request for quotes.</p>
        </div>
    </div>

    @* ── BODY ───────────────────────────────────────────── *@
    <div class="wizard-body">
        @if (CurrentFrame == 0)
        {
            @* ── STEP 0: Select Group-By Fields ─────────────── *@
            <div class="step-content-row">
                <div class="step-content-left">
                    <span style="font-size: 40px;">📝</span>
                </div>
                <div class="step-content-right">
                    <div class="step-title">How should the RFQ's be created?</div>
                    <div class="step-description">
                        The RFQ wizard will group estimated items by the fields you select below.
                        Each unique combination of the selected fields will become a separate RFQ.
                    </div>
                    <div class="step-hint">
                        Click Next to continue, where you can choose which RFQ's you would like to produce.
                    </div>

                    <div class="field-checkbox-list">
                        @foreach (var field in GroupByFields)
                        {
                            <div class="field-checkbox-item">
                                <input type="checkbox" id="@($"chk_{field.FieldName}")"
                                       checked="@field.IsChecked"
                                       @onchange="e => OnGroupByFieldChanged(field, (bool)(e.Value ?? false))" />
                                <label for="@($"chk_{field.FieldName}")">@field.DisplayName</label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (CurrentFrame == 1)
        {
            @* ── STEP 1: Select RFQ's ──────────────────────── *@
            <div class="step-content-row">
                <div class="step-content-left">
                    <span style="font-size: 40px;">✅</span>
                </div>
                <div class="step-content-right">
                    <div class="step-title">Select RFQ's</div>
                    <div class="step-description">
                        Below is a list of unique RFQ's that can be created based on your grouping selection.
                        Check the ones you would like to create, and optionally assign vendors to each.
                    </div>

                    <div class="select-all-row">
                        <label>
                            <input type="checkbox" checked="@SelectAllChecked"
                                   @onchange="OnSelectAllChanged" />
                            Select All
                        </label>
                    </div>

                    <HfGrid @ref="RfqGrid"
                            TValue="RfqRow"
                            DataSource="@RfqData"
                            AllowSorting="true"
                            AllowResizing="true"
                            AllowSelection="true"
                            Height="300px"
                            EditSettingsRef="@rfqEditSettings"
                            SelectionSettingsRef="@rfqSelectionSettings">
                        <HfGridColumnsBase>
                            <HfGridColumn Field="@nameof(RfqRow.IsSelected)" HeaderText="" Width="50px"
                                          Type="ColumnType.CheckBox" AllowEditing="true" />
                            @foreach (var col in DynamicColumns)
                            {
                                <HfGridColumn Field="@col.Field" HeaderText="@col.HeaderText"
                                              Width="@col.Width" AllowEditing="false" />
                            }
                            <HfGridColumn Field="@nameof(RfqRow.VendorNames)" HeaderText="Vendors" Width="200px">
                                <Template>
                                    @{
                                        var row = (RfqRow)context;
                                        <span>@row.VendorNames</span>
                                        <button class="tbar-btn" style="padding:2px 6px; font-size:11px; margin-left:4px;"
                                                @onclick="() => OnSelectVendors(row)" @onclick:stopPropagation="true">...</button>
                                    }
                                </Template>
                            </HfGridColumn>
                        </HfGridColumnsBase>
                    </HfGrid>
                </div>
            </div>
        }
    </div>

    @* ── FOOTER ─────────────────────────────────────────── *@
    <div class="wizard-footer">
        <button @onclick="OnCancelClick">Cancel</button>
        <button disabled="@(CurrentFrame <= 0)" @onclick="OnBackClick">&lt; Back</button>
        <button disabled="@(CurrentFrame >= MaxFrame)" @onclick="OnNextClick">Next &gt;</button>
        <button class="btn-success" disabled="@(CurrentFrame < MaxFrame)" @onclick="OnFinishClick">Finish</button>
    </div>
</div>

@code {
    [Parameter] public string? Job { get; set; }

    private const string SRCFILE = "FRFPWizard::";

    // State
    private string mJob = "";
    private bool bInHere = false;
    private bool IsLoading = false;
    private int CurrentFrame = 0;
    private int MaxFrame = 1;
    private bool SelectAllChecked = false;

    // Database
    private DbWrapperSqlServer db = new();
    private int DivisionID = 1;

    // Grid refs and settings
    private HfGrid<RfqRow>? RfqGrid;

    private HfEditSettings rfqEditSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        ShowConfirmDialog = false
    };

    private HfSelectionSettings rfqSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    // Step 0: Group-by fields
    private List<GroupByField> GroupByFields = new();

    // Step 1: RFQ rows
    private List<RfqRow> RfqData = new();
    private List<DynamicColumnDef> DynamicColumns = new();

    // Models
    public class GroupByField
    {
        public string FieldName { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public bool IsChecked { get; set; } = false;
    }

    public class RfqRow
    {
        public bool IsSelected { get; set; } = false;
        public string GroupKey { get; set; } = "";
        public string VendorNames { get; set; } = "";
        public string VendorIds { get; set; } = "";
        public Dictionary<string, string> FieldValues { get; set; } = new();

        // Dynamic fields accessed by reflection for grid binding
        public string Field0 { get; set; } = "";
        public string Field1 { get; set; } = "";
        public string Field2 { get; set; } = "";
        public string Field3 { get; set; } = "";
        public string Field4 { get; set; } = "";
        public string Field5 { get; set; } = "";
        public string Field6 { get; set; } = "";
        public string Field7 { get; set; } = "";
        public string Field8 { get; set; } = "";
        public string Field9 { get; set; } = "";
    }

    public class DynamicColumnDef
    {
        public string Field { get; set; } = "";
        public string HeaderText { get; set; } = "";
        public string Width { get; set; } = "150px";
    }

    // Lifecycle
    protected override async Task OnInitializedAsync()
    {
        mJob = Job ?? "";
        await LoadGroupByFields();
    }

    public async Task ShowForm(string job)
    {
        mJob = job;
        bInHere = false;
        CurrentFrame = 0;
        await LoadGroupByFields();
    }

    // Load group-by fields from job definition
    private async Task LoadGroupByFields()
    {
        GroupByFields.Clear();

        // Default fields
        GroupByFields.Add(new GroupByField { FieldName = "POIndex", DisplayName = "PO Index" });
        GroupByFields.Add(new GroupByField { FieldName = "Location", DisplayName = "Location" });
        GroupByFields.Add(new GroupByField { FieldName = "HFDescription", DisplayName = "HF Description" });
        GroupByFields.Add(new GroupByField { FieldName = "JCCostCodeDesc", DisplayName = "JC Cost Code Desc" });

        // Load WBS fields from job
        try
        {
            var sql = "SELECT * FROM tbljobs WHERE DivisionID = @DivisionID AND job_no = @Job";
            var dt = db.SqlExec(sql, new { DivisionID, Job = mJob });
            if (dt.Rows.Count > 0)
            {
                var row = dt.Rows[0];
                for (int i = 1; i <= 40; i++)
                {
                    var colName = $"WBSDesc{i:D2}";
                    if (dt.Columns.Contains(colName))
                    {
                        var val = row[colName]?.ToString() ?? "";
                        if (!string.IsNullOrEmpty(val))
                        {
                            GroupByFields.Add(new GroupByField
                            {
                                FieldName = $"WBS{i:D2}",
                                DisplayName = val
                            });
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RFQWizard.LoadGroupByFields] Error: {ex.Message}");
        }
    }

    // Event handlers
    private void OnGroupByFieldChanged(GroupByField field, bool isChecked)
    {
        field.IsChecked = isChecked;
    }

    private async Task OnSelectAllChanged(ChangeEventArgs e)
    {
        if (bInHere) return;
        bInHere = true;
        SelectAllChecked = (bool)(e.Value ?? false);
        foreach (var row in RfqData)
        {
            row.IsSelected = SelectAllChecked;
        }
        bInHere = false;
        StateHasChanged();
    }

    private string GetGroupByClause(bool named = false)
    {
        var selectedFields = GroupByFields.Where(f => f.IsChecked).Select(f => f.FieldName).ToList();
        return string.Join(",", selectedFields);
    }

    private async Task OnCancelClick()
    {
        NavigationManager.NavigateTo("/");
    }

    private async Task OnBackClick()
    {
        if (CurrentFrame > 0)
        {
            await SetCurrentFrame(CurrentFrame - 1);
        }
    }

    private async Task OnNextClick()
    {
        if (CurrentFrame < MaxFrame)
        {
            await SetCurrentFrame(CurrentFrame + 1);
        }
    }

    private async Task OnFinishClick()
    {
        if (CurrentFrame == MaxFrame)
        {
            if (await CreateRFPs())
            {
                await JSRuntime.InvokeVoidAsync("alert", "RFQ's created successfully.");
                NavigationManager.NavigateTo("/");
            }
        }
    }

    private async Task SetCurrentFrame(int frame)
    {
        if (frame == 1 && string.IsNullOrEmpty(GetGroupByClause(false)))
        {
            await JSRuntime.InvokeVoidAsync("alert", "You have to pick at least one field.");
            frame = 0;
        }

        CurrentFrame = frame;

        if (frame == 1)
        {
            await LoadRfqData();
        }

        StateHasChanged();
    }

    private async Task LoadRfqData()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var groupByClause = GetGroupByClause(false);
            var selectedFields = GroupByFields.Where(f => f.IsChecked).ToList();

            // Build dynamic columns
            DynamicColumns.Clear();
            for (int i = 0; i < selectedFields.Count; i++)
            {
                DynamicColumns.Add(new DynamicColumnDef
                {
                    Field = $"Field{i}",
                    HeaderText = selectedFields[i].DisplayName,
                    Width = "150px"
                });
            }

            // Build the ISNULL chain for the title column
            var isNullParts = selectedFields.Select(f => f.FieldName).ToList();
            var titleExpr = string.Join(",'')+ ', ' + isnull(", isNullParts.Select(f => $"isnull({f}"));
            if (isNullParts.Count == 1)
            {
                titleExpr = $"isnull({isNullParts[0]},'un-named')";
            }
            else
            {
                titleExpr = $"isnull({string.Join(",'')+ ', ' + isnull(", isNullParts)},'un-named')";
            }

            // Build select columns
            var selectCols = string.Join(", ", selectedFields.Select(f => f.FieldName));

            var sql = $@"
                SELECT DISTINCT {titleExpr} AS GroupTitle, '', {selectCols}, '' AS Vendors
                FROM estimateditems
                WHERE ISNULL(RFP,'')=''
                  AND divisionid=@DivisionID
                  AND job_no=@Job
                ORDER BY {groupByClause}";

            var dt = db.SqlExec(sql, new { DivisionID, Job = mJob });

            RfqData.Clear();
            foreach (DataRow row in dt.Rows)
            {
                var rfqRow = new RfqRow
                {
                    IsSelected = false,
                    GroupKey = row["GroupTitle"]?.ToString() ?? "",
                    VendorNames = "",
                    VendorIds = ""
                };

                // Set dynamic field values
                for (int i = 0; i < selectedFields.Count && i < 10; i++)
                {
                    var val = row[selectedFields[i].FieldName]?.ToString() ?? "";
                    rfqRow.FieldValues[selectedFields[i].FieldName] = val;
                    switch (i)
                    {
                        case 0: rfqRow.Field0 = val; break;
                        case 1: rfqRow.Field1 = val; break;
                        case 2: rfqRow.Field2 = val; break;
                        case 3: rfqRow.Field3 = val; break;
                        case 4: rfqRow.Field4 = val; break;
                        case 5: rfqRow.Field5 = val; break;
                        case 6: rfqRow.Field6 = val; break;
                        case 7: rfqRow.Field7 = val; break;
                        case 8: rfqRow.Field8 = val; break;
                        case 9: rfqRow.Field9 = val; break;
                    }
                }

                RfqData.Add(rfqRow);
            }

            SelectAllChecked = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RFQWizard.LoadRfqData] Error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading RFQ data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnSelectVendors(RfqRow row)
    {
        // In VB6 this opened FPickList for vendor selection
        // For now, prompt for vendor selection
        var sql = @"SELECT vendorgroupid AS Type, vendor_id AS Vendor, Vendor_name AS Company
                    FROM tblvendors
                    WHERE inactive=0 AND divisionid=@DivisionID
                    ORDER BY Vendor_name";

        try
        {
            var dt = db.SqlExec(sql, new { DivisionID });
            if (dt.Rows.Count == 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "No vendors found.");
                return;
            }

            // Build a simple vendor list for selection
            var vendorList = new List<string>();
            var vendorIdList = new List<string>();
            foreach (DataRow dr in dt.Rows)
            {
                vendorList.Add(dr["Company"]?.ToString() ?? "");
                vendorIdList.Add(dr["Vendor"]?.ToString() ?? "");
            }

            // Simple prompt - in production this would be a proper pick list dialog
            var input = await JSRuntime.InvokeAsync<string>("prompt",
                $"Enter vendor IDs (comma-separated) from available vendors:\n{string.Join("\n", vendorList.Take(20).Select((v, i) => $"{vendorIdList[i]}: {v}"))}");

            if (!string.IsNullOrWhiteSpace(input))
            {
                var selectedIds = input.Split(',').Select(x => x.Trim()).Where(x => !string.IsNullOrEmpty(x)).ToList();
                var selectedNames = new List<string>();
                var quotedIds = new List<string>();

                foreach (var id in selectedIds)
                {
                    var idx = vendorIdList.IndexOf(id);
                    if (idx >= 0)
                    {
                        selectedNames.Add(vendorList[idx]);
                        quotedIds.Add($"'{id}'");
                    }
                }

                row.VendorNames = string.Join(", ", selectedNames);
                row.VendorIds = string.Join(",", quotedIds);
                row.IsSelected = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading vendors: {ex.Message}");
        }
    }

    private async Task<bool> CreateRFPs()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var selectedFields = GroupByFields.Where(f => f.IsChecked).ToList();

            foreach (var row in RfqData.Where(r => r.IsSelected))
            {
                var vendors = row.VendorIds;

                var sql = "";

                // INSERT RFP
                var title = row.GroupKey.Length > 250 ? row.GroupKey.Substring(0, 250) : row.GroupKey;
                sql += $"INSERT INTO RFPs(divisionid,Job,Title) VALUES({DivisionID},'{EscapeSql(mJob)}','{EscapeSql(title)}')\n\n";

                // UPDATE EstimateItems
                sql += "UPDATE EstimateItems\n";
                sql += "   SET RFP=IDENT_CURRENT('RFPs')\n";
                sql += " WHERE EstItemID IN(SELECT EstItemID\n";
                sql += "                      FROM EstimatedItems\n";
                sql += "                     WHERE ISNULL(RFP,0)=0\n";
                sql += $"                       AND divisionid={DivisionID}\n";
                sql += $"                       AND job_no='{EscapeSql(mJob)}'\n";

                foreach (var field in selectedFields)
                {
                    var val = row.FieldValues.ContainsKey(field.FieldName) ? row.FieldValues[field.FieldName] : "";
                    sql += $"                       AND {field.FieldName}='{EscapeSql(val)}'\n";
                }
                sql += ")\n\n";

                // Insert vendor bids if vendors selected
                if (!string.IsNullOrEmpty(vendors))
                {
                    sql += "INSERT INTO VendorBids(RFP,Vendor,CreatedDate)\n";
                    sql += "SELECT IDENT_CURRENT('RFPs'),vendor_id,getdate()\n";
                    sql += "FROM tblVendors\n";
                    sql += $"WHERE divisionid={DivisionID}\n";
                    sql += $"AND vendor_id IN({vendors})\n\n";

                    sql += "INSERT INTO VendorBidItems(RFP,Vendor,EstItemID)\n";
                    sql += "SELECT rfp,vendor_id,estitemid\n";
                    sql += "FROM tblvendors v\n";
                    sql += "    ,estimateitems e\n";
                    sql += "WHERE e.rfp=IDENT_CURRENT('RFPs')\n";
                    sql += $"  AND v.divisionid={DivisionID}\n";
                    sql += $"  AND v.vendor_id IN({vendors})\n\n";
                }

                db.SqlExec(sql);
            }

            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[{SRCFILE}CreateRFPs] Error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error creating RFQ's: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Helpers
    private string EscapeSql(string value)
    {
        return (value ?? "").Replace("'", "''");
    }
}
```