@namespace HomeFront.Components.Pages

@using System
@using System.Data
@using System.Collections.Generic
@using System.Linq
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject ILogger<FRFPWizard> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

@if (IsVisible)
{
@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">Processing...</div>
    </div>
}

<div class="wizard-container">
    @* ── HEADER ─────────────────────────────────────────── *@
    <div class="wizard-header">
        <div class="wizard-header-icon">📋</div>
        <div class="wizard-header-text">
            <h4>Generate RFQ's</h4>
            <p>This wizard will help you create request for quotes.</p>
        </div>
    </div>

    @* ── BODY ───────────────────────────────────────────── *@
    <div class="wizard-body">
        @if (CurrentFrame == 0)
        {
            @* ── STEP 0: Select Group-By Fields ─────────────── *@
            <div class="step-content-row">
                <div class="step-content-left">
                    <span style="font-size: 40px;">📝</span>
                </div>
                <div class="step-content-right">
                    <div class="step-title">How should the RFQ's be created?</div>
                    <div class="step-description">
                        The RFQ wizard will group estimated items by the fields you select below.
                        Each unique combination of the selected fields will become a separate RFQ.
                    </div>
                    <div class="step-hint">
                        Click Next to continue, where you can choose which RFQ's you would like to produce.
                    </div>

                    @if (!string.IsNullOrEmpty(StatusMessage))
                    {
                        <div style="color: #dc3545; font-size: 13px; margin-bottom: 8px; font-weight: 500;">@StatusMessage</div>
                    }

                    <div class="field-checkbox-list">
                        @foreach (var field in GroupByFields)
                        {
                            <div class="field-checkbox-item">
                                <CheckBoxControl Checked="@field.IsChecked"
                                                 CheckedChanged="@(isChecked => OnGroupByFieldChanged(field, isChecked))"
                                                 Label="@field.DisplayName" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (CurrentFrame == 1)
        {
            @* ── STEP 1: Select RFQ's ──────────────────────── *@
            <div class="step-content-row">
                <div class="step-content-left">
                    <span style="font-size: 40px;">✅</span>
                </div>
                <div class="step-content-right">
                    <div class="step-title">Select RFQ's</div>
                    <div class="step-description">
                        Below is a list of unique RFQ's that can be created based on your grouping selection.
                        Check the ones you would like to create, and optionally assign vendors to each.
                    </div>

                    <div class="select-all-row">
                        <CheckBoxControl Checked="@SelectAllChecked"
                                         CheckedChanged="OnSelectAllCheckedChanged"
                                         Label="Select All" />
                    </div>

                    <GridControl @ref="RfqGrid"
                            TValue="RfqRow"
                            DataSource="@RfqData"
                            AllowSorting="true"
                            AllowResizing="true"
                            AllowSelection="true"
                            Height="300px"
                            EditSettingsRef="@rfqEditSettings"
                            SelectionSettingsRef="@rfqSelectionSettings">
                        <GridColumnsBase>
                            <GridColumn Field="@nameof(RfqRow.IsSelected)" HeaderText="" Width="50px"
                                          Type="ColumnType.CheckBox" AllowEditing="true" />
                            @foreach (var col in DynamicColumns)
                            {
                                <GridColumn Field="@col.Field" HeaderText="@col.HeaderText"
                                              Width="@col.Width" AllowEditing="false" />
                            }
                            <GridColumn Field="@nameof(RfqRow.VendorNames)" HeaderText="Vendors" Width="200px">
                                <Template>
                                    @{
                                        var row = (RfqRow)context;
                                        <span>@row.VendorNames</span>
                                        <button class="tbar-btn" style="padding:2px 6px; font-size:11px; margin-left:4px;"
                                                @onclick="() => OnSelectVendors(row)" @onclick:stopPropagation="true">...</button>
                                        @if (!string.IsNullOrEmpty(row.VendorNames))
                                        {
                                            <button class="tbar-btn" style="padding:2px 6px; font-size:11px; margin-left:2px; color:#dc3545;"
                                                    title="Clear vendors"
                                                    @onclick="() => OnClearVendors(row)" @onclick:stopPropagation="true">x</button>
                                        }
                                    }
                                </Template>
                            </GridColumn>
                        </GridColumnsBase>
                    </GridControl>
                </div>
            </div>
        }
    </div>

    @* ── FOOTER ─────────────────────────────────────────── *@
    <div class="wizard-footer">
        <ButtonControl BareStyle="true" CssClass="wizard-btn" OnClick="OnCancelClick">Cancel</ButtonControl>
        <ButtonControl BareStyle="true" CssClass="wizard-btn" Disabled="@(CurrentFrame <= 0)" OnClick="OnBackClick">&lt; Back</ButtonControl>
        <ButtonControl BareStyle="true" CssClass="wizard-btn" Disabled="@(CurrentFrame >= MaxFrame)" OnClick="OnNextClick">Next &gt;</ButtonControl>
        <ButtonControl BareStyle="true" CssClass="wizard-btn btn-success" Disabled="@(CurrentFrame < MaxFrame)" OnClick="OnFinishClick">Finish</ButtonControl>
    </div>
</div>
}

<FPickList @ref="_vendorPickList"
           OnSelected="OnVendorSelected"
           OnCancel="OnVendorPickListCancelled" />

@code {
    [Parameter] public string? Job { get; set; }

    private const string SRCFILE = "FRFPWizard::";

    // State
    private bool IsVisible = false;
    private string mJob = "";
    private bool bInHere = false;
    private bool IsLoading = false;
    private int CurrentFrame = 0;
    private int MaxFrame = 1;
    private bool SelectAllChecked = false;
    private string StatusMessage = "";

    // Child dialog references
    private FPickList? _vendorPickList;
    private RfqRow? _vendorPickRow;

    // Database
// Grid refs and settings
    private GridControl<RfqRow>? RfqGrid;

    private EditSettings rfqEditSettings = new()
    {
        AllowEditing = true,
        AllowAdding = false,
        AllowDeleting = false,
        ShowConfirmDialog = false
    };

    private SelectionSettings rfqSelectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };

    // Step 0: Group-by fields
    private List<GroupByField> GroupByFields = new();

    // Step 1: RFQ rows
    private List<RfqRow> RfqData = new();
    private List<DynamicColumnDef> DynamicColumns = new();

    // Models
    public class GroupByField
    {
        public string FieldName { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public bool IsChecked { get; set; } = false;
    }

    public class RfqRow
    {
        public bool IsSelected { get; set; } = false;
        public string GroupKey { get; set; } = "";
        public string VendorNames { get; set; } = "";
        public string VendorIds { get; set; } = "";
        public Dictionary<string, string> FieldValues { get; set; } = new();

        // Dynamic fields accessed by reflection for grid binding
        public string Field0 { get; set; } = "";
        public string Field1 { get; set; } = "";
        public string Field2 { get; set; } = "";
        public string Field3 { get; set; } = "";
        public string Field4 { get; set; } = "";
        public string Field5 { get; set; } = "";
        public string Field6 { get; set; } = "";
        public string Field7 { get; set; } = "";
        public string Field8 { get; set; } = "";
        public string Field9 { get; set; } = "";
    }

    public class DynamicColumnDef
    {
        public string Field { get; set; } = "";
        public string HeaderText { get; set; } = "";
        public string Width { get; set; } = "150px";
    }

    // Public API
    public async Task ShowForm(string job)
    {
        mJob = job;
        bInHere = false;
        CurrentFrame = 0;
        IsVisible = true;
        await LoadGroupByFields();
        StateHasChanged();
    }

    public void Close()
    {
        IsVisible = false;
        StateHasChanged();
    }

    // Load group-by fields from job definition
    private async Task LoadGroupByFields()
    {
        GroupByFields.Clear();

        // Default fields
        GroupByFields.Add(new GroupByField { FieldName = "POIndex", DisplayName = "PO Index" });
        GroupByFields.Add(new GroupByField { FieldName = "Location", DisplayName = "Location" });
        GroupByFields.Add(new GroupByField { FieldName = "HFDescription", DisplayName = "HF Description" });
        GroupByFields.Add(new GroupByField { FieldName = "JCCostCodeDesc", DisplayName = "JC Cost Code Desc" });

        // Load WBS fields from job
        try
        {
            var sql = "SELECT * FROM tbljobs WHERE DivisionID = @DivisionID AND job_no = @Job";
            var dt = db.SqlExec(sql, new { SessionState.DivisionID, Job = mJob });
            if (dt.Rows.Count > 0)
            {
                var row = dt.Rows[0];
                for (int i = 1; i <= 40; i++)
                {
                    var colName = $"WBSDesc{i:D2}";
                    if (dt.Columns.Contains(colName))
                    {
                        var val = row[colName]?.ToString() ?? "";
                        if (!string.IsNullOrEmpty(val))
                        {
                            GroupByFields.Add(new GroupByField
                            {
                                FieldName = $"WBS{i:D2}",
                                DisplayName = val
                            });
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

        }
    }

    // Event handlers
    private void OnGroupByFieldChanged(GroupByField field, bool isChecked)
    {
        field.IsChecked = isChecked;
    }

    // Thin bool adapter for CheckBoxControl (CheckedChanged passes bool, not ChangeEventArgs).
    private async Task OnSelectAllCheckedChanged(bool isChecked)
    {
        await OnSelectAllChanged(new ChangeEventArgs { Value = isChecked });
    }

    private async Task OnSelectAllChanged(ChangeEventArgs e)
    {
        if (bInHere) return;
        bInHere = true;
        SelectAllChecked = (bool)(e.Value ?? false);
        foreach (var row in RfqData)
        {
            row.IsSelected = SelectAllChecked;
        }
        bInHere = false;
        StateHasChanged();
    }

    private string GetGroupByClause(bool named = false)
    {
        var selectedFields = GroupByFields.Where(f => f.IsChecked).Select(f => f.FieldName).ToList();
        return string.Join(",", selectedFields);
    }

    private void OnCancelClick()
    {
        Close();
    }

    private async Task OnBackClick()
    {
        if (CurrentFrame > 0)
        {
            await SetCurrentFrame(CurrentFrame - 1);
        }
    }

    private async Task OnNextClick()
    {
        if (CurrentFrame < MaxFrame)
        {
            await SetCurrentFrame(CurrentFrame + 1);
        }
    }

    private async Task OnFinishClick()
    {
        if (CurrentFrame == MaxFrame)
        {
            if (await CreateRFPs())
            {
                Close();
            }
        }
    }

    private async Task SetCurrentFrame(int frame)
    {
        if (frame == 1 && string.IsNullOrEmpty(GetGroupByClause(false)))
        {
            StatusMessage = "You have to pick at least one field.";
            frame = 0;
        }
        else
        {
            StatusMessage = "";
        }

        CurrentFrame = frame;

        if (frame == 1)
        {
            await LoadRfqData();
        }

        StateHasChanged();
    }

    private async Task LoadRfqData()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var groupByClause = GetGroupByClause(false);
            var selectedFields = GroupByFields.Where(f => f.IsChecked).ToList();

            // Build dynamic columns
            DynamicColumns.Clear();
            for (int i = 0; i < selectedFields.Count; i++)
            {
                DynamicColumns.Add(new DynamicColumnDef
                {
                    Field = $"Field{i}",
                    HeaderText = selectedFields[i].DisplayName,
                    Width = "150px"
                });
            }

            // Build the ISNULL chain for the title column
            var isNullParts = selectedFields.Select(f => f.FieldName).ToList();
            var titleExpr = string.Join(",'')+ ', ' + isnull(", isNullParts.Select(f => $"isnull({f}"));
            if (isNullParts.Count == 1)
            {
                titleExpr = $"isnull({isNullParts[0]},'un-named')";
            }
            else
            {
                titleExpr = $"isnull({string.Join(",'')+ ', ' + isnull(", isNullParts)},'un-named')";
            }

            // Build select columns
            var selectCols = string.Join(", ", selectedFields.Select(f => f.FieldName));

            var sql = $@"
                SELECT DISTINCT {titleExpr} AS GroupTitle, '', {selectCols}, '' AS Vendors
                FROM estimateditems
                WHERE ISNULL(RFP,'')=''
                  AND divisionid=@DivisionID
                  AND job_no=@Job
                ORDER BY {groupByClause}";

            var dt = db.SqlExec(sql, new { SessionState.DivisionID, Job = mJob });

            RfqData.Clear();
            foreach (DataRow row in dt.Rows)
            {
                var rfqRow = new RfqRow
                {
                    IsSelected = false,
                    GroupKey = row["GroupTitle"]?.ToString() ?? "",
                    VendorNames = "",
                    VendorIds = ""
                };

                // Set dynamic field values
                for (int i = 0; i < selectedFields.Count && i < 10; i++)
                {
                    var val = row[selectedFields[i].FieldName]?.ToString() ?? "";
                    rfqRow.FieldValues[selectedFields[i].FieldName] = val;
                    switch (i)
                    {
                        case 0: rfqRow.Field0 = val; break;
                        case 1: rfqRow.Field1 = val; break;
                        case 2: rfqRow.Field2 = val; break;
                        case 3: rfqRow.Field3 = val; break;
                        case 4: rfqRow.Field4 = val; break;
                        case 5: rfqRow.Field5 = val; break;
                        case 6: rfqRow.Field6 = val; break;
                        case 7: rfqRow.Field7 = val; break;
                        case 8: rfqRow.Field8 = val; break;
                        case 9: rfqRow.Field9 = val; break;
                    }
                }

                RfqData.Add(rfqRow);
            }

            SelectAllChecked = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            StatusMessage = $"Error loading RFQ data: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Opens FPickList for vendor selection (VB6: gData_CellButtonClick).
    /// </summary>
    private async Task OnSelectVendors(RfqRow row)
    {
        if (_vendorPickList == null) return;
        _vendorPickRow = row;

        var sql = $"SELECT vendorgroupid AS Type, vendor_id AS Vendor, Vendor_name AS Company FROM tblvendors WHERE inactive=0 AND divisionid={SessionState.DivisionID} ORDER BY Vendor_name";
        await _vendorPickList.Open(
            title: "Vendor",
            queries: sql,
            multiSelect: true,
            hideColumns: "Type");
    }

    private void OnVendorSelected(List<IDictionary<string, object>> selectedRows)
    {
        if (_vendorPickRow == null || selectedRows.Count == 0) return;

        var names = new List<string>();
        var quotedIds = new List<string>();
        foreach (var r in selectedRows)
        {
            if (r.TryGetValue("Company", out var company))
                names.Add(company?.ToString() ?? "");
            if (r.TryGetValue("Vendor", out var vendor))
                quotedIds.Add($"'{EscapeSql(vendor?.ToString() ?? "")}'");
        }

        _vendorPickRow.VendorNames = string.Join(", ", names);
        _vendorPickRow.VendorIds = string.Join(",", quotedIds);
        _vendorPickRow.IsSelected = true;
        _vendorPickRow = null;
        StateHasChanged();
    }

    private void OnVendorPickListCancelled()
    {
        _vendorPickRow = null;
    }

    /// <summary>
    /// Clears vendor assignment for a row (VB6: gData_KeyDown delete on vendor column).
    /// </summary>
    private void OnClearVendors(RfqRow row)
    {
        row.VendorNames = "";
        row.VendorIds = "";
        StateHasChanged();
    }

    /// <summary>
    /// Syncs SelectAll checkbox state after individual row check changes (VB6: gData_AfterEdit).
    /// </summary>
    private void OnRowCheckChanged(RfqRow row, bool isChecked)
    {
        if (bInHere) return;
        bInHere = true;
        row.IsSelected = isChecked;

        if (RfqData.Count > 0)
        {
            bool allSame = RfqData.All(r => r.IsSelected == RfqData[0].IsSelected);
            SelectAllChecked = allSame && RfqData[0].IsSelected;
        }

        bInHere = false;
        StateHasChanged();
    }

    private async Task<bool> CreateRFPs()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var selectedFields = GroupByFields.Where(f => f.IsChecked).ToList();

            foreach (var row in RfqData.Where(r => r.IsSelected))
            {
                var vendors = row.VendorIds;

                var sql = "";

                // INSERT RFP
                var title = row.GroupKey.Length > 250 ? row.GroupKey.Substring(0, 250) : row.GroupKey;
                sql += $"INSERT INTO RFPs(divisionid,Job,Title) VALUES({SessionState.DivisionID},'{EscapeSql(mJob)}','{EscapeSql(title)}')\n\n";

                // UPDATE EstimateItems
                sql += "UPDATE EstimateItems\n";
                sql += "   SET RFP=IDENT_CURRENT('RFPs')\n";
                sql += " WHERE EstItemID IN(SELECT EstItemID\n";
                sql += "                      FROM EstimatedItems\n";
                sql += "                     WHERE ISNULL(RFP,0)=0\n";
                sql += $"                       AND divisionid={SessionState.DivisionID}\n";
                sql += $"                       AND job_no='{EscapeSql(mJob)}'\n";

                foreach (var field in selectedFields)
                {
                    var val = row.FieldValues.ContainsKey(field.FieldName) ? row.FieldValues[field.FieldName] : "";
                    sql += $"                       AND {field.FieldName}='{EscapeSql(val)}'\n";
                }
                sql += ")\n\n";

                // Insert vendor bids if vendors selected
                if (!string.IsNullOrEmpty(vendors))
                {
                    sql += "INSERT INTO VendorBids(RFP,Vendor,CreatedDate)\n";
                    sql += "SELECT IDENT_CURRENT('RFPs'),vendor_id,getdate()\n";
                    sql += "FROM tblVendors\n";
                    sql += $"WHERE divisionid={SessionState.DivisionID}\n";
                    sql += $"AND vendor_id IN({vendors})\n\n";

                    sql += "INSERT INTO VendorBidItems(RFP,Vendor,EstItemID)\n";
                    sql += "SELECT rfp,vendor_id,estitemid\n";
                    sql += "FROM tblvendors v\n";
                    sql += "    ,estimateitems e\n";
                    sql += "WHERE e.rfp=IDENT_CURRENT('RFPs')\n";
                    sql += $"  AND v.divisionid={SessionState.DivisionID}\n";
                    sql += $"  AND v.vendor_id IN({vendors})\n\n";
                }

                db.SqlExec(sql);
            }

            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{SRCFILE}CreateRFPs]");

            StatusMessage = $"Error creating RFQ's: {ex.Message}";
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Helpers
    private string EscapeSql(string value)
    {
        return (value ?? "").Replace("'", "''");
    }
}
