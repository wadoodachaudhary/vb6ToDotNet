@namespace HomeFront.Components.Pages
@page "/inbox-custom-quote"
@rendermode InteractiveServer

@using HomeFront.Models
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Notifications
@using HomeFront.Data
@using System.Data
@using System.Reflection
@using System.Text
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FInboxCustomQuote> Logger
@inject NotificationService Notifications
@using HomeFront.Services
@inject ISessionStateService SessionState
@inject IGridLayoutService GridLayoutSvc
@inject DbWrapperSqlServer db

<PageTitle>Custom Requests - HomeFront</PageTitle>

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-panel">Loading requests...</div>
    </div>
}

<div class="inbox-custom-quote-page">
    <div class="wizard-header">
        <h3>Prepare quotes for custom requests</h3>
        <p>Double click on a request to build the quote. Requests can also be declined.</p>
    </div>

    <div class="toolbar">
        <label>View:</label>
        <DropDownListControl TValue="int" TItem="ViewOptionItem"
                             DataSource="@ViewChoices"
                             Value="@CurrentViewIndex"
                             ValueChanged="OnViewChanged"
                             TextFieldName="@nameof(ViewOptionItem.Text)"
                             ValueFieldName="@nameof(ViewOptionItem.Value)"
                             Width="135px"
                             CssClass="customquote-view-dropdown" />
        <span class="spacer"></span>
        @if (mDirty)
        {
            <span class="dirty-indicator">Unsaved changes</span>
        }
    </div>

    <div class="grid-container">
        <GridControl @ref="DataGrid"
            TValue="CustomQuoteRow"
            DataSource="@Rows"
            AllowPaging="true"
            AllowSorting="true"
            AllowFiltering="true"
            AllowResizing="true"
            AllowSelection="true"
            EnableHover="true"
            Height="100%"
            FilterSettingsRef="@filterSettings"
            PageSettingsRef="@pageSettings"
            SelectionSettingsRef="@selectionSettings"
            EditSettingsRef="@editSettings"
            OnLayoutChanged="@OnGridLayoutChangedAsync"
            EventsRef="@gridEvents">
        <GridColumnsBase @key="gDataLayoutVersion">
            @if (HasGridLayout)
            {
                <GridColumn HeaderText="Quote" Width="70px" AllowEditing="false">
                    <Template>
                        @{
                            var row = (CustomQuoteRow)context;
                            <ButtonControl BareStyle="true" CssClass="cell-edit-btn" OnClick="@(_ => OnBuildQuote(row))">Quote</ButtonControl>
                        }
                    </Template>
                </GridColumn>

                foreach (var entry in GetOrderedGridLayout())
                {
                    var layout = entry.Layout;
                    var fieldName = entry.Field;
                    var columnType = entry.ColumnType;
                    var textAlign = entry.TextAlign;
                    var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                    var width = layout.Width.HasValue && layout.Width.Value > 0
                        ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px" : null;

                    if (fieldName == "Description")
                    {
                        <GridColumn Field="Description" HeaderText="@headerText" Width="@(width ?? "260px")" AllowEditing="false">
                            <Template>
                                @{
                                    var row = (CustomQuoteRow)context;
                                    <span title="@row.Description">@Truncate(row.Description, 40)</span>
                                    @if (CanEdit)
                                    {
                                        <ButtonControl BareStyle="true" CssClass="cell-edit-btn" Title="Edit description" OnClick="@(_ => OpenTextDialog(row, nameof(CustomQuoteRow.Description), "Description", 200))">...</ButtonControl>
                                    }
                                }
                            </Template>
                        </GridColumn>
                    }
                    else if (fieldName == "Bldr_Declined_Reason")
                    {
                        <GridColumn Field="Bldr_Declined_Reason" HeaderText="@headerText" Width="@(width ?? "200px")" AllowEditing="false">
                            <Template>
                                @{
                                    var row = (CustomQuoteRow)context;
                                    <span title="@row.Bldr_Declined_Reason">@Truncate(row.Bldr_Declined_Reason, 30)</span>
                                    @if (CanEdit)
                                    {
                                        <ButtonControl BareStyle="true" CssClass="cell-edit-btn" Title="Edit decline reason" OnClick="@(_ => OpenTextDialog(row, nameof(CustomQuoteRow.Bldr_Declined_Reason), "Decline Reason", 500))">...</ButtonControl>
                                    }
                                }
                            </Template>
                        </GridColumn>
                    }
                    else if (fieldName == "CategoryDesc")
                    {
                        <GridColumn Field="CategoryDesc" HeaderText="@headerText" Width="@(width ?? "160px")" AllowEditing="@CanEdit">
                            <EditTemplate>
                                @{
                                    var row = (CustomQuoteRow)context;
                                    <DropDownListControl TValue="string" TItem="CategoryItem"
                                                         DataSource="@CategoryItems"
                                                         Value="@row.CategoryDesc"
                                                         ValueChanged="@(value => OnCategorySelected(row, value))"
                                                         TextFieldName="@nameof(CategoryItem.Description)"
                                                         ValueFieldName="@nameof(CategoryItem.Description)"
                                                         Placeholder="-- Select --"
                                                         Width="100%"
                                                         CssClass="customquote-grid-dropdown" />
                                }
                            </EditTemplate>
                        </GridColumn>
                    }
                    else if (fieldName == "Comments")
                    {
                        <GridColumn Field="Comments" HeaderText="@headerText" Width="@(width ?? "200px")" AllowEditing="false">
                            <Template>
                                @{
                                    var row = (CustomQuoteRow)context;
                                    <span title="@row.Comments">@Truncate(row.Comments, 30)</span>
                                    @if (CanEdit)
                                    {
                                        <ButtonControl BareStyle="true" CssClass="cell-edit-btn" Title="Edit comments" OnClick="@(_ => OpenTextDialog(row, nameof(CustomQuoteRow.Comments), "Comments", 4000))">...</ButtonControl>
                                    }
                                }
                            </Template>
                        </GridColumn>
                    }
                    else if (fieldName == "EstimatorNotes")
                    {
                        <GridColumn Field="EstimatorNotes" HeaderText="@headerText" Width="@(width ?? "200px")" AllowEditing="false">
                            <Template>
                                @{
                                    var row = (CustomQuoteRow)context;
                                    <span title="@row.EstimatorNotes">@Truncate(row.EstimatorNotes, 30)</span>
                                    @if (CanEdit)
                                    {
                                        <ButtonControl BareStyle="true" CssClass="cell-edit-btn" Title="Edit estimator notes" OnClick="@(_ => OpenTextDialog(row, nameof(CustomQuoteRow.EstimatorNotes), "Estimator Notes", 4000))">...</ButtonControl>
                                    }
                                }
                            </Template>
                        </GridColumn>
                    }
                    else
                    {
                        <GridColumn Field="@fieldName"
                                      HeaderText="@headerText"
                                      Width="@width"
                                      Type="@columnType"
                                      TextAlign="@textAlign"
                                      AllowEditing="@CanEdit"
                                      ClipMode="ClipMode.Ellipsis" />
                    }
                }
            }
            else
            {
                @* Fallback: hardcoded columns matching VB6 DataGrid *@
                <GridColumn HeaderText="Quote" Width="70px" AllowEditing="false">
                    <Template>
                        @{
                            var row = (CustomQuoteRow)context;
                            <ButtonControl BareStyle="true" CssClass="cell-edit-btn" OnClick="@(_ => OnBuildQuote(row))">Quote</ButtonControl>
                        }
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomQuoteRow.CreationDate)" HeaderText="Date" Width="110px" Format="d" AllowEditing="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.CommunityDesc)" HeaderText="Community" Width="140px" AllowEditing="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.Customer_No)" HeaderText="Cust #" Width="90px" AllowEditing="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.Customer)" HeaderText="Customer" Width="160px" AllowEditing="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.Job_No)" HeaderText="Job" Width="90px" AllowEditing="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.Model)" HeaderText="Model" Width="90px" AllowEditing="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.ChangeOrderNo)" HeaderText="CO #" Width="90px" AllowEditing="false" />

                <GridColumn Field="@nameof(CustomQuoteRow.Description)" HeaderText="Description" Width="260px" AllowEditing="false">
                    <Template>
                        @{
                            var row = (CustomQuoteRow)context;
                            <span title="@row.Description">@Truncate(row.Description, 40)</span>
                            @if (CanEdit)
                            {
                                <ButtonControl BareStyle="true" CssClass="cell-edit-btn" Title="Edit description" OnClick="@(_ => OpenTextDialog(row, nameof(CustomQuoteRow.Description), "Description", 200))">...</ButtonControl>
                            }
                        }
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomQuoteRow.Qty)" HeaderText="Qty" Width="70px" Format="N2" TextAlign="TextAlign.Right" AllowEditing="@CanEdit" />
                <GridColumn Field="@nameof(CustomQuoteRow.UOM)" HeaderText="UOM" Width="70px" AllowEditing="@CanEdit" />

                <GridColumn Field="@nameof(CustomQuoteRow.Cost)" HeaderText="Cost" Width="90px" Format="C2" TextAlign="TextAlign.Right" AllowEditing="@CanEdit" />
                <GridColumn Field="@nameof(CustomQuoteRow.Price)" HeaderText="Price" Width="90px" Format="C2" TextAlign="TextAlign.Right" AllowEditing="@CanEdit" />

                <GridColumn Field="@nameof(CustomQuoteRow.Status)" HeaderText="Status" Width="90px" AllowEditing="@CanEdit" />
                <GridColumn Field="@nameof(CustomQuoteRow.Bldr_Declined_Reason)" HeaderText="Decline Reason" Width="200px" AllowEditing="false">
                    <Template>
                        @{
                            var row = (CustomQuoteRow)context;
                            <span title="@row.Bldr_Declined_Reason">@Truncate(row.Bldr_Declined_Reason, 30)</span>
                            @if (CanEdit)
                            {
                                <ButtonControl BareStyle="true" CssClass="cell-edit-btn" Title="Edit decline reason" OnClick="@(_ => OpenTextDialog(row, nameof(CustomQuoteRow.Bldr_Declined_Reason), "Decline Reason", 500))">...</ButtonControl>
                            }
                        }
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomQuoteRow.CategoryDesc)" HeaderText="Category" Width="160px" AllowEditing="@CanEdit">
                    <EditTemplate>
                        @{
                            var row = (CustomQuoteRow)context;
                            <DropDownListControl TValue="string" TItem="CategoryItem"
                                                 DataSource="@CategoryItems"
                                                 Value="@row.CategoryDesc"
                                                 ValueChanged="@(value => OnCategorySelected(row, value))"
                                                 TextFieldName="@nameof(CategoryItem.Description)"
                                                 ValueFieldName="@nameof(CategoryItem.Description)"
                                                 Placeholder="-- Select --"
                                                 Width="100%"
                                                 CssClass="customquote-grid-dropdown" />
                        }
                    </EditTemplate>
                </GridColumn>

                <GridColumn Field="@nameof(CustomQuoteRow.Comments)" HeaderText="Comments" Width="200px" AllowEditing="false">
                    <Template>
                        @{
                            var row = (CustomQuoteRow)context;
                            <span title="@row.Comments">@Truncate(row.Comments, 30)</span>
                            @if (CanEdit)
                            {
                                <ButtonControl BareStyle="true" CssClass="cell-edit-btn" Title="Edit comments" OnClick="@(_ => OpenTextDialog(row, nameof(CustomQuoteRow.Comments), "Comments", 4000))">...</ButtonControl>
                            }
                        }
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomQuoteRow.EstimatorNotes)" HeaderText="Estimator Notes" Width="200px" AllowEditing="false">
                    <Template>
                        @{
                            var row = (CustomQuoteRow)context;
                            <span title="@row.EstimatorNotes">@Truncate(row.EstimatorNotes, 30)</span>
                            @if (CanEdit)
                            {
                                <ButtonControl BareStyle="true" CssClass="cell-edit-btn" Title="Edit estimator notes" OnClick="@(_ => OpenTextDialog(row, nameof(CustomQuoteRow.EstimatorNotes), "Estimator Notes", 4000))">...</ButtonControl>
                            }
                        }
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomQuoteRow.Location)" HeaderText="Location" Width="110px" AllowEditing="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.Sales_Person_Name)" HeaderText="Sales Rep" Width="140px" AllowEditing="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.TaxRate)" HeaderText="Tax %" Width="70px" Format="N2" TextAlign="TextAlign.Right" AllowEditing="false" />

                <GridColumn Field="@nameof(CustomQuoteRow.Seq)" HeaderText="Seq" Width="80px" Visible="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.Category)" HeaderText="Category Code" Visible="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.Major_Group)" HeaderText="Major Group" Visible="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.AttachmentID)" HeaderText="AttachmentID" Visible="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.Community)" HeaderText="CommunityCode" Visible="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.OptionID)" HeaderText="OptionID" Visible="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.CommunityPhase)" HeaderText="CommunityPhase" Visible="false" />
                <GridColumn Field="@nameof(CustomQuoteRow.Extra)" HeaderText="Extra" Visible="false" />
            }
        </GridColumnsBase>
        </GridControl>
    </div>
    <div class="btn-bar">
        <ButtonControl CssClass="customquote-nav-btn primary" Disabled="@(!CanEdit)" OnClick="@(_ => OnOkClick())">OK</ButtonControl>
        <ButtonControl CssClass="customquote-nav-btn" OnClick="@(_ => OnCloseClick())">Close</ButtonControl>
    </div>
</div>

<DialogControl @bind-Visible="IsTextDialogVisible" Width="600px" Header="@TextDialogTitle"
          IsModal="true" ShowCloseIcon="true" CloseOnEscape="true">
    <ChildContent>
        <TextAreaControl @bind-Value="EditingText"
                         Rows="8"
                         MaxLength="@EditingMaxLength"
                         CssClass="customquote-textarea" />
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass="customquote-nav-btn primary" OnClick="@(_ => OnTextDialogOk())">OK</ButtonControl>
        <ButtonControl CssClass="customquote-nav-btn" OnClick="@(_ => CloseTextDialog())">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>

<Fx.ControlKit.Dialogs.MessageBoxControl @ref="_messageBox" />

@code {
    private GridControl<CustomQuoteRow>? DataGrid;
    private Fx.ControlKit.Dialogs.MessageBoxControl? _messageBox;

    private bool IsLoading = false;
    private bool mReadOnly = true;
    private bool mDirty = false;

    private int CurrentViewIndex = 0;
    private readonly List<ViewOptionItem> ViewChoices = new()
    {
        new(0, "New requests"),
        new(1, "180 days old"),
        new(2, "1 year old"),
        new(3, "All old requests")
    };

    private List<CustomQuoteRow> Rows = new();
    private List<CategoryItem> CategoryItems = new();

    private FilterSettings filterSettings = new() { Type = FilterType.FilterBar };
    private PageSettings pageSettings = new() { PageSize = 50 };
    private SelectionSettings selectionSettings = new()
    {
        Type = SelectionType.Single,
        Mode = SelectionMode.Row
    };
    private EditSettings editSettings = new()
    {
        AllowAdding = false,
        AllowDeleting = false,
        AllowEditing = true,
        ShowConfirmDialog = false
    };
    private GridControlEvents<CustomQuoteRow> gridEvents = new();

    // ── Grid Layout (dynamic from AppGridLayout) ──────────────
    // Load/resolve/order/width boilerplate lives in the shared GridLayoutPresenter
    // (Services/GridLayoutPresenter.cs); only the VB6 form/grid names stay here.
    // gDataLayout / HasGridLayout / gDataLayoutVersion are thin delegations so the
    // markup is unchanged. The keyed-then-unkeyed fallback is captured by
    // instanceKey:"(0)".
    private readonly GridLayoutPresenter<CustomQuoteRow> _dataGrid =
        new("FInboxCustomQuote", "DataGrid", instanceKey: "(0)");

    private Dictionary<string, GridLayoutColumn> gDataLayout => _dataGrid.Layout;
    private bool HasGridLayout => _dataGrid.Has;
    private int gDataLayoutVersion => _dataGrid.Version;

    // ── Property Map for Field Resolution ─────────────────────
    // NOTE (drift): kept locally because GetColumnTypeForField below maps
    // bool→CheckBox (not the presenter's Boolean) and recognizes a narrower
    // numeric set. See the flag in GetColumnTypeForField.
    private static readonly Dictionary<string, PropertyInfo> _customQuoteRowPropMap =
        typeof(CustomQuoteRow)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .GroupBy(p => NormalizeGridKey(p.Name))
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    private bool CanEdit => CurrentViewIndex == 0;

    // Text dialog
    private bool IsTextDialogVisible = false;
    private string TextDialogTitle = "";
    private string EditingText = "";
    private CustomQuoteRow? EditingRow;
    private string EditingField = "";
    private int EditingMaxLength = 4000;
    // VB6: when the decline-reason prompt is opened because Status was set to "Declined",
    // cancelling it reverts Status to blank (VB6 gData_ValidateEdit Cancel = True).
    private bool _declinePromptFromStatus = false;

    // VB6: HFApp.Options("MaxUnQuotedOptions"), HFApp.Options("IncludeTax")
    private Dictionary<string, string> AppOptions = new(StringComparer.OrdinalIgnoreCase)
    {
        { "MaxUnQuotedOptions", "5500" },
        { "IncludeTax", "True" }
    };

    protected override async Task OnInitializedAsync()
    {
        gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<CustomQuoteRow>>(this, OnCellSaved);
        await LoadAppOptionsAsync();
        await LoadGridLayoutAsync();
        await LoadCategoriesAsync();
        await LoadDataAsync();
    }

    // VB6: Reads app options from AppOptions table
    private async Task LoadAppOptionsAsync()
    {
        try
        {
            var rows = await db.QueryAsync("SELECT OptionName, OptionValue FROM AppOptions WHERE OptionName IN ('MaxUnQuotedOptions','IncludeTax')");
            foreach (var r in rows)
            {
                var name = r["OptionName"]?.ToString() ?? "";
                var val = r["OptionValue"]?.ToString() ?? "";
                if (!string.IsNullOrWhiteSpace(name))
                    AppOptions[name] = val;
            }
        }
        catch
        {
            // Use defaults if table doesn't exist
        }
    }

    private async Task LoadCategoriesAsync()
    {
        var sql = "SELECT Description, category, group_code AS major_group FROM tblcategories ORDER BY 1";
        var rows = await db.QueryAsync(sql);
        CategoryItems = rows.Select(r => new CategoryItem
        {
            Description = r["Description"]?.ToString() ?? "",
            Category = r["category"]?.ToString() ?? "",
            MajorGroup = r["major_group"]?.ToString() ?? ""
        }).ToList();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            mReadOnly = CurrentViewIndex != 0;
            editSettings.AllowEditing = CanEdit;

            var maxRows = GetOptionInt("MaxUnQuotedOptions", 5500);
            var topClause = maxRows > 0 ? $"TOP {maxRows}" : "";
            var statusSelect = CurrentViewIndex == 0 ? "'' AS Status" : "o.Status AS Status";
            var fromTable = CurrentViewIndex == 0 ? "UnQuotedOptions" : "QuotedOptions";

            var extraFilter = CurrentViewIndex switch
            {
                1 => " AND DATEDIFF(day, o.quote_entered_date, GETDATE()) <= 180",
                2 => " AND DATEDIFF(year, o.quote_entered_date, GETDATE()) <= 1",
                _ => ""
            };

            var sql = $@"
                SELECT {topClause}
                    o.CommunityDesc AS CommunityDesc,
                    o.Customer_No AS Customer_No,
                    o.Customer AS Customer,
                    o.creationdate AS CreationDate,
                    o.Model AS Model,
                    o.ModelDesc AS ModelDesc,
                    o.Job_No AS Job_No,
                    o.TaxRate AS TaxRate,
                    o.Address AS Address,
                    o.Location AS Location,
                    o.Sales_Person_Name AS Sales_Person_Name,
                    o.ChangeOrderNo AS ChangeOrderNo,
                    o.Description AS Description,
                    o.Comments AS Comments,
                    o.Category AS Category,
                    o.major_group AS Major_Group,
                    o.CategoryDesc AS CategoryDesc,
                    o.EstimatorNotes AS EstimatorNotes,
                    o.Seq AS Seq,
                    o.Qty AS Qty,
                    o.UOM AS UOM,
                    o.OptionType AS OptionType,
                    o.Cost AS Cost,
                    o.Price AS Price,
                    o.Community AS Community,
                    o.AttachmentID AS AttachmentID,
                    o.saleslocation AS SalesLocation,
                    o.color AS Color,
                    o.style AS Style,
                    o.finish AS Finish,
                    o.other AS Other,
                    o.bldr_declined_reason AS Bldr_Declined_Reason,
                    -- VB6 load (FInboxCustomQuote.frm) does NOT select OptionID/CommunityPhase/Extra:
                    -- UnQuotedOptions/QuotedOptions have no such columns, so re-adding them errors at runtime.
                    {statusSelect}
                FROM {fromTable} o
                WHERE o.divisionid = @DivisionID {extraFilter}
                ORDER BY o.creationdate DESC, o.communitydesc, o.customer_no, o.changeorderno, o.seq";

            var result = await db.QueryAsync(sql, new { SessionState.DivisionID });

            Rows = result.Select(r => new CustomQuoteRow
            {
                CommunityDesc = GetString(r, "CommunityDesc"),
                Customer_No = GetString(r, "Customer_No"),
                Customer = GetString(r, "Customer"),
                CreationDate = GetDate(r, "CreationDate"),
                Model = GetString(r, "Model"),
                ModelDesc = GetString(r, "ModelDesc"),
                Job_No = FormatJob(GetString(r, "Job_No")),
                TaxRate = GetDecimal(r, "TaxRate"),
                Address = GetString(r, "Address"),
                Location = GetString(r, "Location"),
                Sales_Person_Name = GetString(r, "Sales_Person_Name"),
                ChangeOrderNo = GetString(r, "ChangeOrderNo"),
                Description = GetString(r, "Description"),
                Comments = GetString(r, "Comments"),
                Category = GetString(r, "Category"),
                Major_Group = GetString(r, "Major_Group"),
                CategoryDesc = GetString(r, "CategoryDesc"),
                EstimatorNotes = GetString(r, "EstimatorNotes"),
                Seq = GetLong(r, "Seq"),
                Qty = GetDecimal(r, "Qty"),
                UOM = GetString(r, "UOM"),
                OptionType = GetString(r, "OptionType"),
                Cost = GetDecimal(r, "Cost"),
                Price = GetDecimal(r, "Price"),
                Community = GetString(r, "Community"),
                AttachmentID = GetString(r, "AttachmentID"),
                SalesLocation = GetString(r, "SalesLocation"),
                Color = GetString(r, "Color"),
                Style = GetString(r, "Style"),
                Finish = GetString(r, "Finish"),
                Other = GetString(r, "Other"),
                Bldr_Declined_Reason = GetString(r, "Bldr_Declined_Reason"),
                // OptionID/CommunityPhase/Extra: blank design-time grid columns in VB6 (not on the source
                // views), so they stay at the model's default "" — see the load SQL note above.
                Status = GetString(r, "Status")
            }).ToList();

            mDirty = false;
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error loading data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnViewChanged(int value)
    {
        var nextIndex = value;
        if (nextIndex == CurrentViewIndex)
            return;

        if (mDirty && !await SaveDataAsync(true))
        {
            StateHasChanged();
            return;
        }

        CurrentViewIndex = Math.Clamp(nextIndex, 0, ViewChoices.Count - 1);
        await LoadDataAsync();
    }

    private async Task OnOkClick()
    {
        await SaveDataAsync(false);
    }

    // VB6: cmdNav_Click(1) → SaveData(True) then Unload Me
    private async Task OnCloseClick()
    {
        if (await SaveDataAsync(true))
        {
            // Navigate back to main menu (VB6: Unload Me returns to FMain)
            NavigationManager.NavigateTo("/main");
        }
    }

    private async Task<bool> SaveDataAsync(bool prompt)
    {
        if (mReadOnly || !mDirty) return true;

        if (prompt)
        {
            var result = _messageBox is not null
                ? await _messageBox.ShowAsync(
                    "This data has changed.\n\nDo you want to save these changes?",
                    title: "Custom Requests",
                    buttons: Fx.ControlKit.Dialogs.MessageBoxButtons.YesNoCancel)
                : Fx.ControlKit.Dialogs.MessageBoxResult.Yes;

            if (result == Fx.ControlKit.Dialogs.MessageBoxResult.Cancel)
                return false;
            if (result == Fx.ControlKit.Dialogs.MessageBoxResult.No)
                return true;
        }

        IsLoading = true;
        StateHasChanged();
        try
        {
            foreach (var row in Rows.Where(r => r.RowState == "DIRTY"))
            {
                var qty = row.Qty == 0 ? 1 : row.Qty;
                var taxRate = GetOptionBool("IncludeTax", true) ? row.TaxRate / 100m : 0m;

                var amount = row.Price;
                var cost = row.Cost;

                var table = row.Location?.ToUpperInvariant() switch
                {
                    "ADDENDUM" => "tblscheduleb",
                    "CHANGEORDER" => "changeorderdetails",
                    "DESIGNCENTER" => "designcenterdetails",
                    _ => ""
                };
                if (string.IsNullOrEmpty(table))
                    throw new Exception($"invalid option location: {row.Location}");

                var quoteDate = string.IsNullOrWhiteSpace(row.Status) ? (DateTime?)null : DateTime.Now;
                var requireQuote = string.IsNullOrWhiteSpace(row.Status);
                var declined = string.Equals(row.Status, "Declined", StringComparison.OrdinalIgnoreCase);

                var tax = Math.Round(amount * taxRate, 2);
                var total = Math.Round(amount * (1 + taxRate), 2);
                var overrideAmount = qty * amount;
                var netTax = Math.Round(qty * amount * taxRate, 2);
                var grandTotal = Math.Round(qty * amount * (1 + taxRate), 2);

                var overrideColumn = table == "designcenterdetails" ? "amount" : "override_price";

                var sql = $@"
UPDATE {table} SET
    quote_entered_date = @QuoteEnteredDate,
    Require_Quote = @RequireQuote,
    Bldr_Declined = @Declined,
    Bldr_Declined_Reason = @DeclineReason,
    EstimatorNotes = @EstimatorNotes,
    Description = @Description,
    category = @Category,
    major_group = @MajorGroup,
    Comments = @Comments,
    UOM = @UOM,
    Qty = @Qty,
    Rate = @Rate,
    Cost_amount = @CostAmount,
    tax = @Tax,
    totalamount = @TotalAmount,
    {overrideColumn} = @OverrideAmount,
    nettax = @NetTax,
    grandtotal = @GrandTotal
WHERE seq = @Seq";

                await db.ExecuteAsync(sql, new
                {
                    QuoteEnteredDate = quoteDate,
                    RequireQuote = requireQuote,
                    Declined = declined,
                    DeclineReason = row.Bldr_Declined_Reason ?? "",
                    EstimatorNotes = row.EstimatorNotes ?? "",
                    Description = row.Description ?? "",
                    Category = row.Category ?? "",
                    MajorGroup = row.Major_Group ?? "",
                    Comments = row.Comments ?? "",
                    UOM = row.UOM ?? "",
                    Qty = qty,
                    Rate = amount,
                    CostAmount = cost,
                    Tax = tax,
                    TotalAmount = total,
                    OverrideAmount = overrideAmount,
                    NetTax = netTax,
                    GrandTotal = grandTotal,
                    Seq = row.Seq
                });

                var location = row.Location ?? "";
                var customerNo = row.Customer_No ?? "";
                await RecalculateTotalsAsync(location, customerNo);
                await SendSaleRepEmailAsync(location, row.Seq);

                row.RowState = "CLEAN";
            }

            mDirty = false;
            return true;
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error saving data: {ex.Message}");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task RecalculateTotalsAsync(string location, string customer)
    {
        switch (location?.ToUpperInvariant())
        {
            case "ADDENDUM":
                await db.ExecuteAsync("Exec dbo.CalcAddendumTotals @Customer", new { Customer = customer });
                break;
            case "CHANGEORDER":
                await db.ExecuteAsync("Exec dbo.SalesCalcCustCOMaster @Customer", new { Customer = customer });
                await db.ExecuteAsync("Exec dbo.CalcCOMasterTotals @Customer", new { Customer = customer });
                break;
            case "DESIGNCENTER":
                await db.ExecuteAsync("Exec dbo.SalesCalcCustDCMaster @Customer", new { Customer = customer });
                await db.ExecuteAsync("Exec dbo.CalcDCCOMasterTotals @Customer", new { Customer = customer });
                break;
        }
        await db.ExecuteAsync("Exec dbo.CustomerCalcTotals @Customer", new { Customer = customer });
    }

    // VB6: Sub SendSaleRepEmail(Location, seq)
    //   Sends email notification to sales rep when quote is completed or declined
    //   Uses HFApp.SendMail(email, "", subject, body)
    private async Task SendSaleRepEmailAsync(string location, long seq)
    {
        try
        {
            var sql = @"
SELECT
  ISNULL(NULLIF(s.email,''),u.email) Email
 ,c.customer_no, c.Description CustDesc, c.Job_no, c.municipal_address
 ,o.changeorderno
 ,CASE WHEN o.bldr_declined=1 THEN 'declined' ELSE 'completed' END status
 ,o.description
 ,o.bldr_declined_reason reason
FROM alloptions o
 JOIN tblcustomers c ON o.customer_no=c.customer_no
 LEFT JOIN tblsales_persons s ON o.sales_person_id = s.sales_person_id
 LEFT JOIN user_manager u ON o.sales_person_id = u.user_id
WHERE o.require_quote=0
  AND ISNULL(ISNULL(NULLIF(s.email,''),u.email),'') <> ''
  AND o.location=@Location
  AND o.seq=@Seq";

            var rows = await db.QueryAsync(sql, new { Location = location, Seq = seq });
            var row = rows.FirstOrDefault();
            if (row == null) return;

            var email = row["Email"]?.ToString() ?? "";
            if (string.IsNullOrWhiteSpace(email)) return;

            var status = row["status"]?.ToString() ?? "";
            var custDesc = row["CustDesc"]?.ToString() ?? "";
            var jobNo = row["Job_no"]?.ToString() ?? "";
            var address = row["municipal_address"]?.ToString() ?? "";
            var custNo = row["customer_no"]?.ToString() ?? "";
            var changeOrder = row["changeorderno"]?.ToString() ?? "";
            var description = row["description"]?.ToString() ?? "";
            var reason = row["reason"]?.ToString() ?? "";

            // VB6 (FInboxCustomQuote.frm:472): subject = "Custom Option Price Request " & status
            var subject = $"Custom Option Price Request {status}";

            // VB6 (FInboxCustomQuote.frm:464-471): body = "Your price request has been " & status & vbCrLf & ...
            var body = $"Your price request has been {status}\r\n\r\n" +
                       $"Job: {jobNo}  {address}\r\n" +
                       $"Customer: {custNo}  {custDesc}\r\n" +
                       $"ChangeOrder: {changeOrder}\r\n" +
                       $"Description: {description}\r\n\r\n";
            if (status == "declined")
                body += $"Reason: {reason}";

            // VB6: Call HFApp.SendMail(email, "", subject, body)
            // Open mailto: link as a fallback for MAPI-style sending
            var encodedSubject = Uri.EscapeDataString(subject);
            var encodedBody = Uri.EscapeDataString(body);
            var mailtoUrl = $"mailto:{email}?subject={encodedSubject}&body={encodedBody}";
            await JSRuntime.InvokeVoidAsync("open", mailtoUrl, "_blank");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SendSaleRepEmail error");

        }
    }

    // VB6: gData_ValidateEdit + gData_AfterEdit
    // Handles cell-level business rules: Status changes, price/decline logic
    private async Task OnCellSaved(CellSaveArgs<CustomQuoteRow> args)
    {
        if (args.Data == null) return;
        var row = args.Data;
        var field = args.ColumnName ?? "";

        switch (field)
        {
            // VB6 (gData_ValidateEdit): Case "Status"
            //   If .EditText = "Declined" And Bldr_Declined_Reason = "" Then
            //     s = InputBox("Reason:")
            //     If s = "" Then Cancel = True   ' edit reverted
            //     Else Status = "Declined" : Bldr_Declined_Reason = s : Price = ".00"
            case nameof(CustomQuoteRow.Status):
                if (string.Equals(row.Status, "Declined", StringComparison.OrdinalIgnoreCase))
                {
                    if (string.IsNullOrWhiteSpace(row.Bldr_Declined_Reason))
                    {
                        // VB6 prompts InputBox; we use the text dialog. Cancelling it reverts
                        // Status to blank (VB6 Cancel = True), so flag the originating field.
                        _declinePromptFromStatus = true;
                        OpenTextDialog(row, nameof(CustomQuoteRow.Bldr_Declined_Reason), "Reason:", 500);
                        // Price zeroed when decline reason is confirmed (VB6 Price = ".00")
                        row.Price = 0;
                    }
                }
                break;

            // VB6 (gData_ValidateEdit): Case "Bldr_Declined_Reason"
            //   .TextMatrix(Row, "status") = "Declined"   ' unconditional in VB6
            case nameof(CustomQuoteRow.Bldr_Declined_Reason):
                row.Status = "Declined";
                row.Price = 0;
                break;

            // VB6 (gData_ValidateEdit): Case "Price"
            //   .EditText = Val(.EditText)
            //   If Val(.EditText) <> 0 Then Status = "Approved"
            case nameof(CustomQuoteRow.Price):
                if (row.Price != 0)
                    row.Status = "Approved";
                break;

            // VB6 (gData_ValidateEdit): Case "Cost": .EditText = Val(.EditText) — numeric coercion only
            case nameof(CustomQuoteRow.Cost):
                break;
        }

        // VB6's trailing "clear reason unless Declined" rule is applied centrally in MarkDirty,
        // which every edit path calls (mirrors VB6 setting RowData=Dirty right after that rule).
        MarkDirty(row);
    }

    private void OnCategorySelected(CustomQuoteRow row, string? value)
    {
        row.CategoryDesc = value ?? "";
        var cat = CategoryItems.FirstOrDefault(c => c.Description == row.CategoryDesc);
        if (cat != null)
        {
            row.Category = cat.Category;
            row.Major_Group = cat.MajorGroup;
        }
        MarkDirty(row);
    }

    private void OpenTextDialog(CustomQuoteRow row, string field, string title, int maxLength)
    {
        if (!CanEdit) return;
        EditingRow = row;
        EditingField = field;
        EditingMaxLength = maxLength;
        EditingText = field switch
        {
            nameof(CustomQuoteRow.Description) => row.Description ?? "",
            nameof(CustomQuoteRow.Comments) => row.Comments ?? "",
            nameof(CustomQuoteRow.EstimatorNotes) => row.EstimatorNotes ?? "",
            nameof(CustomQuoteRow.Bldr_Declined_Reason) => row.Bldr_Declined_Reason ?? "",
            _ => ""
        };
        TextDialogTitle = title;
        IsTextDialogVisible = true;
    }

    private void OnTextDialogOk()
    {
        if (EditingRow == null)
        {
            IsTextDialogVisible = false;
            return;
        }

        var text = (EditingText ?? "").Trim();
        if (text.Length > EditingMaxLength)
            text = text[..EditingMaxLength];

        switch (EditingField)
        {
            case nameof(CustomQuoteRow.Description):
                EditingRow.Description = text;
                break;
            case nameof(CustomQuoteRow.Comments):
                EditingRow.Comments = text;
                break;
            case nameof(CustomQuoteRow.EstimatorNotes):
                EditingRow.EstimatorNotes = text;
                break;
            case nameof(CustomQuoteRow.Bldr_Declined_Reason):
                // VB6: an empty reason is treated as Cancel (Cancel = True). When the prompt
                // was opened because Status went to "Declined", revert Status to blank. (The
                // trailing "clear reason unless Declined" rule then runs in MarkDirty.)
                if (string.IsNullOrWhiteSpace(text))
                {
                    if (_declinePromptFromStatus)
                        EditingRow.Status = "";
                }
                else
                {
                    EditingRow.Bldr_Declined_Reason = text;
                    EditingRow.Status = "Declined";
                    EditingRow.Price = 0;
                }
                break;
        }

        MarkDirty(EditingRow);
        _declinePromptFromStatus = false;
        IsTextDialogVisible = false;
        StateHasChanged();
    }

    private void CloseTextDialog()
    {
        // VB6: cancelling the decline-reason prompt reverts Status (Cancel = True) when it was
        // opened from setting Status = "Declined" with no existing reason. MarkDirty then clears
        // the (now-blank-Status) reason via the trailing rule.
        if (_declinePromptFromStatus && EditingRow != null)
        {
            EditingRow.Status = "";
            MarkDirty(EditingRow);
        }
        _declinePromptFromStatus = false;
        IsTextDialogVisible = false;
    }

    // VB6 (gData_DblClick / gData_KeyDown vbKeyReturn): builds the quote for the selected row.
    //   FCustomQuote.BuildQuote(ReadOnly:=cboView.ListIndex>0, AttachmentID, Location, Model,
    //     OptionID, Job_No, Customer_No, Community, CommunityPhase, Extra, Description, Seq,
    //     Category, Cost, Price, Qty, UOM)
    // On success VB6 writes Cost=cost*qty, Price, Qty, UOM back into the grid row and marks it
    // Dirty. That return-value write-back is NOT reproduced here: FCustomQuote is a routed page
    // (not a value-returning modal), so it cannot hand cost/price/qty/uom back to this grid. See
    // the `deferred` note — closing that loop needs FCustomQuote modal-hosting support, which lives
    // outside this file.
    private async Task OnBuildQuote(CustomQuoteRow row)
    {
        if (!CanEdit) return;

        // VB6 gData_KeyDown: qty defaults to 1 when zero.
        var qty = row.Qty == 0 ? 1m : row.Qty;

        // Save pending changes before navigating (VB6: SaveData True at form unload / view change).
        if (mDirty && !await SaveDataAsync(true))
            return;

        if (row.Seq <= 0) return;

        // Pass the full VB6 BuildQuote argument list, named to match FCustomQuote's [Parameter]s.
        // OptionID/CommunityPhase/Extra are blank here for the same reason they are blank in VB6 at
        // runtime: the UnQuotedOptions/QuotedOptions views don't surface them (see LoadDataAsync).
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var qs = new (string Key, string Value)[]
        {
            ("readOnly", (CurrentViewIndex > 0).ToString()),
            ("attachmentID", row.AttachmentID ?? ""),
            ("location", row.Location ?? ""),
            ("model", row.Model ?? ""),
            ("opt", row.OptionID ?? ""),
            ("job", row.Job_No ?? ""),
            ("customer", row.Customer_No ?? ""),
            ("community", row.Community ?? ""),
            ("communityPhase", row.CommunityPhase ?? ""),
            ("extra", row.Extra ?? ""),
            ("description", row.Description ?? ""),
            ("seq", row.Seq.ToString(inv)),
            ("category", row.Category ?? ""),
            ("costAmount", row.Cost.ToString(inv)),
            ("sellAmount", row.Price.ToString(inv)),
            ("salesQty", qty.ToString(inv)),
            ("salesUOM", row.UOM ?? "")
        };

        var query = string.Join("&", qs.Select(p =>
            $"{Uri.EscapeDataString(p.Key)}={Uri.EscapeDataString(p.Value)}"));
        NavigationManager.NavigateTo($"/custom-quote?{query}");
    }

    private void MarkDirty(CustomQuoteRow row)
    {
        // VB6 (gData_ValidateEdit, runs for EVERY edited row right before RowData = "Dirty"):
        //   If .TextMatrix(Row, "Status") <> "Declined" Then Bldr_Declined_Reason = ""
        if (!string.Equals(row.Status, "Declined", StringComparison.OrdinalIgnoreCase))
            row.Bldr_Declined_Reason = "";

        row.RowState = "DIRTY";
        mDirty = true;
    }

    private static string Truncate(string? text, int max) =>
        string.IsNullOrEmpty(text) ? "" : (text.Length <= max ? text : text[..max] + "...");

    private static string GetString(Dictionary<string, object> row, string key) =>
        GetValue(row, key)?.ToString() ?? "";

    private static DateTime? GetDate(Dictionary<string, object> row, string key)
    {
        var v = GetValue(row, key);
        return v == null || v == DBNull.Value ? null : Convert.ToDateTime(v);
    }

    private static decimal GetDecimal(Dictionary<string, object> row, string key)
    {
        var v = GetValue(row, key);
        return v == null || v == DBNull.Value ? 0m : Convert.ToDecimal(v);
    }

    private static long GetLong(Dictionary<string, object> row, string key)
    {
        var v = GetValue(row, key);
        return v == null || v == DBNull.Value ? 0L : Convert.ToInt64(v);
    }

    private static object? GetValue(Dictionary<string, object> row, string key)
    {
        if (row.TryGetValue(key, out var v)) return v;
        foreach (var kv in row)
        {
            if (string.Equals(kv.Key, key, StringComparison.OrdinalIgnoreCase))
                return kv.Value;
        }
        return null;
    }

    private static string FormatJob(string job) => job?.Trim() ?? "";

    private int GetOptionInt(string key, int defaultValue)
    {
        return AppOptions.TryGetValue(key, out var val) && int.TryParse(val, out var result) ? result : defaultValue;
    }

    private bool GetOptionBool(string key, bool defaultValue)
    {
        if (!AppOptions.TryGetValue(key, out var val)) return defaultValue;
        return val.Equals("true", StringComparison.OrdinalIgnoreCase) || val == "1";
    }

