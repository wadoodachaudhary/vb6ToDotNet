    private void OnTextDialogOk()
    {
        if (EditingRow == null)
        {
            IsTextDialogVisible = false;
            return;
        }

        var text = (EditingText ?? "").Trim();
        if (text.Length > EditingMaxLength)
            text = text[..EditingMaxLength];

        switch (EditingField)
        {
            case nameof(CustomQuoteRow.Description):
                EditingRow.Description = text;
                break;
            case nameof(CustomQuoteRow.Comments):
                EditingRow.Comments = text;
                break;
            case nameof(CustomQuoteRow.EstimatorNotes):
                EditingRow.EstimatorNotes = text;
                break;
            case nameof(CustomQuoteRow.Bldr_Declined_Reason):
                EditingRow.Bldr_Declined_Reason = text;
                if (!string.IsNullOrWhiteSpace(text))
                    EditingRow.Status = "Declined";
                break;
        }

        MarkDirty(EditingRow);
        IsTextDialogVisible = false;
        StateHasChanged();
    }

