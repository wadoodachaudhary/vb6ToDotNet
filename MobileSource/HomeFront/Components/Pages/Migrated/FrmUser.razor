@page "/user-management"
@rendermode InteractiveServer

@using System.Data
@using HomeFront.Data

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>HomeFront - User Management</PageTitle>

<style>
    .toolbar-cntr {
        padding: 8px 12px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }
    .tbar-btn {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        padding: 6px 12px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-size: 11px;
        transition: background 0.15s;
        min-width: 60px;
    }
    .tbar-btn:hover:not(:disabled) { background: #e9ecef; }
    .tbar-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .tbar-separator { width: 1px; height: 36px; background: #ced4da; margin: 0 4px; }
    .tool-label { font-size: 11px; }

    .tab-buttons { display: flex; border-bottom: 2px solid #ddd; margin-bottom: 0; }
    .tab-buttons button {
        padding: 10px 24px; border: none; background: #f0f0f0;
        cursor: pointer; font-size: 14px; transition: background 0.2s;
    }
    .tab-buttons button:hover { background: #e0e0e0; }
    .tab-buttons button.active {
        background: #fff; border-bottom: 2px solid #0d6efd;
        margin-bottom: -2px; color: #0d6efd; font-weight: bold;
    }
    .tab-content {
        padding: 16px; border: 1px solid #ddd; border-top: none; background: #fff;
    }

    .form-section {
        border: 1px solid #dee2e6; border-radius: 6px; padding: 16px;
        background: #fff; margin-bottom: 16px;
    }
    .form-row { display: flex; align-items: center; margin-bottom: 8px; gap: 8px; }
    .form-row label { min-width: 140px; text-align: right; font-weight: 500; font-size: 13px; }
    .form-row input, .form-row select {
        flex: 1; max-width: 300px; padding: 5px 10px;
        border: 1px solid #ced4da; border-radius: 4px; font-size: 13px;
    }
    .form-row input:focus, .form-row select:focus {
        border-color: #86b7fe; outline: 0; box-shadow: 0 0 0 2px rgba(13,110,253,0.15);
    }

    .user-type-section { margin-top: 12px; }
    .user-type-section label { font-size: 13px; margin-right: 16px; cursor: pointer; }
    .user-type-section input[type="radio"] { margin-right: 4px; }

    .permissions-frame {
        border: 1px solid #dee2e6; border-radius: 4px; padding: 12px;
        background: #fafafa; margin-bottom: 12px;
    }
    .permissions-frame h6 { margin-bottom: 10px; font-weight: 600; color: #495057; }
    .check-grid {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px 16px;
    }
    .check-item { display: flex; align-items: center; gap: 6px; font-size: 12px; }
    .check-item input[type="checkbox"] { width: 15px; height: 15px; }

    .sub-tab-buttons { display: flex; border-bottom: 1px solid #ccc; margin-bottom: 12px; }
    .sub-tab-buttons button {
        padding: 6px 16px; border: none; background: #eee;
        cursor: pointer; font-size: 12px; transition: background 0.15s;
    }
    .sub-tab-buttons button:hover { background: #ddd; }
    .sub-tab-buttons button.active {
        background: #fff; border-bottom: 2px solid #0d6efd;
        margin-bottom: -1px; color: #0d6efd; font-weight: 600;
    }
</style>

<h3 style="margin-bottom: 16px;">HomeFront - User Management</h3>

@* ── TOOLBAR ─────────────────────────────────────────── *@
<div class="toolbar-cntr">
    <button class="tbar-btn" @onclick="OnFirstClick" disabled="@(!ButtonsEnabled)">
        <span>⏮</span><span class="tool-label">First</span>
    </button>
    <button class="tbar-btn" @onclick="OnPreviousClick" disabled="@(!ButtonsEnabled)">
        <span>◀</span><span class="tool-label">Previous</span>
    </button>
    <button class="tbar-btn" @onclick="OnNextClick" disabled="@(!ButtonsEnabled)">
        <span>▶</span><span class="tool-label">Next</span>
    </button>
    <button class="tbar-btn" @onclick="OnLastClick" disabled="@(!ButtonsEnabled)">
        <span>⏭</span><span class="tool-label">Last</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" @onclick="OnAddClick" disabled="@(!ButtonsEnabled)">
        <span>➕</span><span class="tool-label">Add</span>
    </button>
    <button class="tbar-btn" @onclick="OnDeleteClick" disabled="@(!ButtonsEnabled)">
        <span>🗑️</span><span class="tool-label">Delete</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" @onclick="OnSaveClick" disabled="@(ButtonsEnabled)">
        <span>💾</span><span class="tool-label">Save</span>
    </button>
    <button class="tbar-btn" @onclick="OnCancelClick" disabled="@(ButtonsEnabled)">
        <span>↩️</span><span class="tool-label">Undo</span>
    </button>
    <div class="tbar-separator"></div>
    <button class="tbar-btn" @onclick="OnRefreshClick" disabled="@(!ButtonsEnabled)">
        <span>🔄</span><span class="tool-label">Refresh</span>
    </button>
    <button class="tbar-btn" @onclick="OnCloseClick" disabled="@(!ButtonsEnabled)">
        <span>❌</span><span class="tool-label">Close</span>
    </button>
</div>

@* ── MAIN TABS ─────────────────────────────────────────── *@
<div class="tab-buttons">
    <button class="@(MainTab == 0 ? "active" : "")" @onclick="() => MainTab = 0">General Information</button>
    <button class="@(MainTab == 1 ? "active" : "")" @onclick="() => MainTab = 1">Permissions / Privileges</button>
</div>

<div class="tab-content">
    @if (MainTab == 0)
    {
        @* ── GENERAL INFORMATION TAB ─────────────────────────── *@
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-section">
                <div class="form-row">
                    <label>Login</label>
                    <input type="text" @bind="UserId" @bind:event="oninput" maxlength="10"
                           @onkeydown="OnUserIdKeyDown" disabled="@(!FieldsEnabled)" />
                    <button class="tbar-btn" @onclick="OnPickUser" title="Search User">🔍</button>
                </div>
                <div class="form-row">
                    <label>User Name</label>
                    <input type="text" @bind="UserName" @onfocus="OnFieldFocus" disabled="@(!FieldsEnabled)" />
                </div>
                <div class="form-row">
                    <label>Designation</label>
                    <input type="text" @bind="Designation" @onfocus="OnFieldFocus" disabled="@(!FieldsEnabled)" />
                </div>
                <div class="form-row">
                    <label>Office</label>
                    <input type="text" @bind="Office" @onfocus="OnFieldFocus" disabled="@(!FieldsEnabled)" />
                </div>
                <div class="form-row">
                    <label>Password</label>
                    <input type="password" @bind="UserPassword" @onfocus="OnFieldFocus" disabled="@(!FieldsEnabled)" />
                </div>
                <div class="form-row">
                    <label>Home Page Report</label>
                    <input type="text" @bind="HomePage" disabled="@(!FieldsEnabled)" />
                    <button class="tbar-btn" @onclick="OnBrowseHomePage" title="Browse">📂</button>
                </div>
                <div class="form-row">
                    <label>PO Approval Max</label>
                    <input type="text" @bind="MaxPOAmount" disabled="@(!FieldsEnabled)" style="max-width:150px;" />
                </div>

                <div style="margin-top: 12px;">
                    <button class="btn btn-outline-primary btn-sm" @onclick="OnAssignCommunities"
                            style="@(UserAccess == 4 ? "" : "display:none;")">
                        Assign Communities
                    </button>
                    <button class="btn btn-outline-primary btn-sm" @onclick="OnAssignDivisions" style="margin-left:8px;">
                        Assign Divisions
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="OnCopyUserPermissions" style="margin-left:8px;">
                        Copy User Permissions
                    </button>
                </div>
            </div>

            <div class="form-section">
                <h6>User Type:</h6>
                <div class="user-type-section">
                    @for (int i = 1; i <= 7; i++)
                    {
                        var idx = i;
                        <div style="margin-bottom: 4px;">
                            <label>
                                <input type="radio" name="userType" value="@idx"
                                       checked="@(UserAccess == idx)"
                                       @onchange="() => OnUserTypeChanged(idx)" />
                                @GetUserTypeLabel(idx)
                            </label>
                        </div>
                    }
                </div>
                <div style="margin-top: 16px;">
                    <button class="btn btn-outline-info btn-sm" @onclick="OnSetDefaultPermissions">
                        Set Default Permissions/Privileges for Selected HomeFront User Type
                    </button>
                </div>
            </div>
        </div>
    }
    else if (MainTab == 1)
    {
        @* ── PERMISSIONS / PRIVILEGES TAB ─────────────────────── *@
        <div class="sub-tab-buttons">
            <button class="@(PermTab == 0 ? "active" : "")" @onclick="() => PermTab = 0">File Menu</button>
            <button class="@(PermTab == 1 ? "active" : "")" @onclick="() => PermTab = 1">Tasks Menu</button>
            <button class="@(PermTab == 2 ? "active" : "")" @onclick="() => PermTab = 2">Setup Menu</button>
            <button class="@(PermTab == 3 ? "active" : "")" @onclick="() => PermTab = 3">Inquiry Menu</button>
            <button class="@(PermTab == 4 ? "active" : "")" @onclick="() => PermTab = 4">Reports Menu</button>
            <button class="@(PermTab == 5 ? "active" : "")" @onclick="() => PermTab = 5">Tools Menu</button>
            <button class="@(PermTab == 6 ? "active" : "")" @onclick="() => PermTab = 6">Main Menu Bar</button>
            <button class="@(PermTab == 7 ? "active" : "")" @onclick="() => PermTab = 7">Customer Info</button>
            <button class="@(PermTab == 8 ? "active" : "")" @onclick="() => PermTab = 8">Precision Builder</button>
            <button class="@(PermTab == 9 ? "active" : "")" @onclick="() => PermTab = 9">Workticket</button>
        </div>

        @if (PermTab == 0)
        {
            <div class="permissions-frame">
                <h6>File Menu Permissions</h6>
                <div class="check-grid">
                    <CheckItem Label="Open Database" @bind-Value="Check1_FileOpenData" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Database Utilities" @bind-Value="Check1_FileDataUtil" OnChanged="OnCheckChanged" />
                </div>
            </div>
        }
        else if (PermTab == 1)
        {
            <div class="permissions-frame">
                <h6>Tasks Menu Permissions</h6>
                <div class="check-grid">
                    <CheckItem Label="Enter Deposits" @bind-Value="Check1_TaskEntDep" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Enter Mortgage" @bind-Value="Check1_TaskEntMort" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Post Deposits" @bind-Value="Check1_TaskPostDep" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Post Mortgage" @bind-Value="Check1_TaskPostMort" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Process Lot Inventory" @bind-Value="Check1_TaskProcessLot" OnChanged="OnCheckChanged" />
                    <CheckItem Label="View/Update Lot Inventory" @bind-Value="Check1_TaskUpdLot" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Post Lot Inventory" @bind-Value="Check1_TaskPostLot" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Process Sales Closing" @bind-Value="Check1_TaskProcessSales" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Process Commission" @bind-Value="Check1_TaskProcessComm" OnChanged="OnCheckChanged" />
                    <CheckItem Label="View/Update Unposted Commission" @bind-Value="Check1_TaskUpdComm" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Post Commission" @bind-Value="Check1_TaskPostComm" OnChanged="OnCheckChanged" />
                    <CheckItem Label="View/Update Unposted Adjustments" @bind-Value="Check1_TaskUpdAdj" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Post Adjustments" @bind-Value="Check1_TaskPostAdj" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Create Job Quotes" @bind-Value="Check1_TaskEntQuote" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Update Totals to Job Cost" @bind-Value="Check1_TaskUpdTotalJobCost" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Update Address Info to Job Cost" @bind-Value="Check1_TaskUpdAddrJobCost" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Update Date Info to Timberline" @bind-Value="Check1_TaskUpdDatesTL" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Import Timberline Custom Fields" @bind-Value="Check1_TaskImportTLCustom" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Synchronize Customer Date List" @bind-Value="Check1_TaskSyncDate" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Synchronize Color Selection Items" @bind-Value="Check1_TaskSyncGroup" OnChanged="OnCheckChanged" />
                </div>
                <h6 style="margin-top:12px;">Project Builder Settings</h6>
                <div class="check-grid">
                    <CheckItem Label="Allow User to Create Schedules?" @bind-Value="Check0_CreateSchedule" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Allow User to Modify Actual End Dates?" @bind-Value="Check0_EditActualEndDate" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Allow Users to View all Schedules" @bind-Value="Check0_ViewAllSchedules" OnChanged="OnCheckChanged" />
                </div>
            </div>
        }
        else if (PermTab == 2)
        {
            <div class="permissions-frame">
                <h6>Setup Menu Permissions</h6>
                <div class="check-grid">
                    <CheckItem Label="Customer Information" @bind-Value="Check1_SetupCustomer" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Community" @bind-Value="Check1_SetupCommunity" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Model" @bind-Value="Check1_SetupModel" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Series" @bind-Value="Check1_SetupSeries" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Major Groups" @bind-Value="Check1_SetupMajorGroup" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Category" @bind-Value="Check1_SetupCategory" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Model Specific Option" @bind-Value="Check1_SetupModelOptions" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Global Option" @bind-Value="Check1_SetupGlobalOptions" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Design Center Area" @bind-Value="Check1_SetupDCArea" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Design Center Option" @bind-Value="Check1_SetupDCOption" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Jobs" @bind-Value="Check1_SetupJobs" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Construction Cut Off" @bind-Value="Check1_SetupConstStatus" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Project Managers" @bind-Value="Check1_SetupProjectManager" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Sales Persons" @bind-Value="Check1_SetupSalesperson" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Customer Service Person" @bind-Value="Check1_SetupCustSrvPerson" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Law Firms" @bind-Value="Check1_SetupLawFirms" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Lending Companies" @bind-Value="Check1_SetupLendingCompany" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Developers" @bind-Value="Check1_SetupDevelopers" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Lot Inventory" @bind-Value="Check1_SetupLotInventory" OnChanged="OnCheckChanged" />
                    <CheckItem Label="TL Date List" @bind-Value="Check1_SetupTLDateList" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Group Template/Color Sheet" @bind-Value="Check1_SetupGroupTemplate" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Milestone" @bind-Value="Check1_MileStoneMenu" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Parking Stall" @bind-Value="Check1_ParkingStallMenu" OnChanged="OnCheckChanged" />
                </div>
            </div>
        }
        else if (PermTab == 3)
        {
            <div class="permissions-frame">
                <h6>Inquiry Menu Permissions</h6>
                <div class="check-grid">
                    <CheckItem Label="Model/Options" @bind-Value="Check1_InqModelOptions" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Global Options" @bind-Value="Check1_InqGlobalOptions" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Design Center Options" @bind-Value="Check1_InqDCOptions" OnChanged="OnCheckChanged" />
                    <CheckItem Label="New Deposits" @bind-Value="Check1_InqNewDeposits" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Posted Deposits" @bind-Value="Check1_InqPostDeposits" OnChanged="OnCheckChanged" />
                    <CheckItem Label="New Mortgage Advance" @bind-Value="Check1_InqNewMortgage" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Posted Mortgage Advance" @bind-Value="Check1_InqPostMortgage" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Locked Customer" @bind-Value="Check1_InqLockedCustomer" OnChanged="OnCheckChanged" />
                </div>
            </div>
        }
        else if (PermTab == 4)
        {
            <div class="permissions-frame">
                <h6>Reports Menu Permissions</h6>
                <div class="check-grid">
                    <CheckItem Label="Report Manager" @bind-Value="Check1_ReportsRepMan" OnChanged="OnCheckChanged" />
                </div>
            </div>
        }
        else if (PermTab == 5)
        {
            <div class="permissions-frame">
                <h6>Tools Menu Permissions</h6>
                <div class="check-grid">
                    <CheckItem Label="User Administration" @bind-Value="Check1_ToolsUsrAdmin" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Customer Maintenance" @bind-Value="Check1_ToolsCustMaintain" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Administration and Maintenance" @bind-Value="Check1_ToolsAdminMaintain" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Customer's Report Package" @bind-Value="Check1_ToolsCustRepPackage" OnChanged="OnCheckChanged" />
                    <CheckItem Label="System Settings" @bind-Value="Check1_ToolsSystemSetup" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Commission Settings" @bind-Value="Check1_ToolsCommSettings" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Lot Status" @bind-Value="Check1_ToolsLotStatus" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Field Validation" @bind-Value="Check1_ToolsFieldVal" OnChanged="OnCheckChanged" />
                    <CheckItem Label="GST/PST Rebate Settings" @bind-Value="Check1_ToolsGSTPSTRebate" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Custom Descriptions" @bind-Value="Check1_ToolsCustDesc" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Timberline Field Descriptions" @bind-Value="Check1_ToolsTLFieldDesc" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Work In Progress Descriptions" @bind-Value="Check1_ToolsWorkInProgress" OnChanged="OnCheckChanged" />
                </div>
            </div>
        }
        else if (PermTab == 6)
        {
            <div class="permissions-frame">
                <h6>Main Menu Bar Permissions</h6>
                <div class="check-grid">
                    <CheckItem Label="Tasks Menu" @bind-Value="Check1_TasksMenu" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Setup Menu" @bind-Value="Check1_SetupMenu" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Reports Menu" @bind-Value="Check1_ReportsMenu" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Inquiry Menu" @bind-Value="Check1_InquiryMenu" OnChanged="OnCheckChanged" />
                    <CheckItem Label="Tools Menu" @bind-Value="Check1_ToolsMenu" OnChanged="OnCheckChanged" />
                </div>
            </div>
        }
        else if (PermTab == 7)
        {
            @* Customer Information sub-tabs *@
            <div class="sub-tab-buttons">
                <button class="@(CustInfoSubTab == 0 ? "active" : "")" @onclick="() => CustInfoSubTab = 0">General Permissions 1</button>
                <button class="@(CustInfoSubTab == 1 ? "active" : "")" @onclick="() => CustInfoSubTab = 1">General Permissions 2</button>
                <button class="@(CustInfoSubTab == 2 ? "active" : "")" @onclick="() => CustInfoSubTab = 2">Customer Info Tabs</button>
            </div>

            @if (CustInfoSubTab == 0)
            {
                <div class="permissions-frame">
                    <h6>General Permissions 1</h6>
                    <div class="check-grid">
                        <CheckItem Label="Show Change Order?" @bind-Value="Check0_ShowCO" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Show Design Center?" @bind-Value="Check0_ShowDC" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update Spec/Show Home?" @bind-Value="Check0_UpdSpecShow" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update to TL?" @bind-Value="Check0_UpdToTL" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update from TL?" @bind-Value="Check0_UpdFromTL" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update Interior Color Info?" @bind-Value="Check0_UPDCustomerGroups" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Delete Customer?" @bind-Value="Check0_DeleteCustomer" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Create New Customer?" @bind-Value="Check0_CreateNewCustomer" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Allow Addition of Addendums?" @bind-Value="Check0_AddAddendum" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Allow Addition of Change Orders?" @bind-Value="Check0_AddCO" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Change Grid Layout?" @bind-Value="Check0_ChangeGridLayout" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Allow Addition of Customer Dates?" @bind-Value="Check0_AddCustomerDates" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Allow Addition of Design Center?" @bind-Value="Check0_AddDC" OnChanged="OnCheckChanged" />
                        <CheckItem Label="BarCode Entry?" @bind-Value="Check0_BarcodeEntry" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update Contract Summary?" @bind-Value="Check0_UpdContractSummary" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Create Jobs?" @bind-Value="Check0_CreateJob" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Approve Customer on CO?" @bind-Value="Check0_ApproveCustomer" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Purchase?" @bind-Value="Check0_PurchaseCustomer" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update Deleted Items?" @bind-Value="Check0_UpdDeletedItems" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Builder Approve?" @bind-Value="Check0_BldrApproveCustomer" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update TL Job" @bind-Value="Check0_UPDTLJob" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update Customer Dates" @bind-Value="Check0_UPDCustomerDates" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update Addendum" @bind-Value="Check0_UPDAddendum" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update Change Order" @bind-Value="Check0_UPDCO" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update Design Center" @bind-Value="Check0_UPDDC" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update Customer" @bind-Value="Check0_UPDCustomer" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Change Dates" @bind-Value="Check0_ChangeDate" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Copy Customer?" @bind-Value="Check0_CopyCustomer" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Sales Override?" @bind-Value="Check0_SalesOverride" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Custom Pricing?" @bind-Value="Check0_CustomPricing" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Add CO to Locked Change Orders" @bind-Value="Check0_AllowAddCO_LOCKCO" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Allow Deletion of Change Orders?" @bind-Value="Check0_AllowDelCO" OnChanged="OnCheckChanged" />
                    </div>
                </div>
            }
            else if (CustInfoSubTab == 1)
            {
                <div class="permissions-frame">
                    <h6>General Permissions 2</h6>
                    <div class="check-grid">
                        <CheckItem Label="Access to All Menu Items when Customer form is open?" @bind-Value="Check0_AccessMenu" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update Cost Information?" @bind-Value="Check0_UpdateCostInfo" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Update Construction Status?" @bind-Value="Check0_UpdateConstStatus" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Un Approve Change Order?" @bind-Value="Check0_UnApproveCO" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Uncheck Purchased on Customers?" @bind-Value="Check0_UnPurchase" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Sales Managers Default Pick List View is Pending Customers?" @bind-Value="Check0_PendingCustomerPick" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Modify Custom Option Comments after Quote Complete?" @bind-Value="Check0_ModifyCustom" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Prompt for Change Order Approval?" @bind-Value="Check0_PromptforCOApproval" OnChanged="OnCheckChanged" />
                        <CheckItem Label="Reverse Top Tab Order for Dates and Contract Details?" @bind-Value="Check0_ReverseCustDateTab" OnChanged="OnCheckChanged" />
