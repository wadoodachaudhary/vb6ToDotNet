    // ── Navigation ────────────────────────────────────────────
    private void OnFirstClick()
    {
        if (allUsers.Count == 0) return;
        currentRecordIndex = 0;
        LoadCurrentRecord();
    }

    private void OnPreviousClick()
    {
        if (currentRecordIndex > 0)
        {
            currentRecordIndex--;
            LoadCurrentRecord();
        }
    }

    private void OnNextClick()
    {
        if (currentRecordIndex < allUsers.Count - 1)
        {
            currentRecordIndex++;
            LoadCurrentRecord();
        }
    }

    private void OnLastClick()
    {
        if (allUsers.Count == 0) return;
        currentRecordIndex = allUsers.Count - 1;
        LoadCurrentRecord();
    }

    // ── Add ───────────────────────────────────────────────────
    private void OnAddClick()
    {
        myAddNewFlag = true;
        UserId = "";
        UserName = "";
        Designation = "";
        Office = "";
        UserPassword = "";
        HomePage = "";
        MaxPOAmount = "";
        UserAccess = 4;
        ClearAllPermissions();
        Check0_ShowCO = true;
        Check0_ShowDC = true;
        SetButtons(false);
        FieldsEnabled = true;
    }

    // ── Delete ────────────────────────────────────────────────
    private async Task OnDeleteClick()
    {
        if (string.IsNullOrWhiteSpace(UserId)) return;
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Really want to Delete the selected user?");
        if (!confirm) return;

        try
        {
            await db.ExecuteAsync("DELETE FROM User_Manager WHERE User_ID = @UserId", new { UserId });
            await LoadUsersAsync();

            if (allUsers.Count == 0)
            {
                ClearFields();
                currentRecordIndex = 0;
            }
            else
            {
                currentRecordIndex = Math.Min(currentRecordIndex, allUsers.Count - 1);
                LoadCurrentRecord();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Delete failed: {ex.Message}");
        }
    }
