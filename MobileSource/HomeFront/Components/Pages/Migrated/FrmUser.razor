    private void ClearFields()
    {
        UserId = "";
        UserName = "";
        Designation = "";
        Office = "";
        UserPassword = "";
        HomePage = "";
        MaxPOAmount = "";
        UserAccess = 4;
        ClearAllPermissions();
    }

    private void OnCheckChanged()
    {
        myDataChanged = true;
        if (!myEditFlag)
            myEditFlag = true;
        SetButtons(false);
    }

    private async Task OnSaveClick()
    {
        // TODO: persist changes to database.
        myDataChanged = false;
        myEditFlag = false;
        myAddNewFlag = false;
        SetButtons(true);
        FieldsEnabled = false;
        await Task.CompletedTask;
    }

    private void OnCancelClick()
    {
        myDataChanged = false;
        myEditFlag = false;
        myAddNewFlag = false;
        LoadCurrentRecord();
        SetButtons(true);
        FieldsEnabled = false;
    }

    private async Task OnRefreshClick()
    {
        await LoadUsersAsync();
        if (allUsers.Count > 0)
        {
            currentRecordIndex = Math.Min(currentRecordIndex, allUsers.Count - 1);
            LoadCurrentRecord();
        }
        SetButtons(true);
        FieldsEnabled = false;
    }

