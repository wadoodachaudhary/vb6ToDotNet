    private static bool GetBool(Dictionary<string, object> row, string key)
    {
        if (!row.ContainsKey(key) || row[key] == null || row[key] == DBNull.Value)
            return false;
        var val = row[key];
        if (val is bool b) return b;
        if (val is int i) return i != 0;
        if (val is long l) return l != 0;
        if (val is short s) return s != 0;
        if (val is decimal d) return d != 0m;
        var str = val.ToString()?.Trim();
        if (string.IsNullOrEmpty(str)) return false;
        return str == "1" || str.Equals("true", StringComparison.OrdinalIgnoreCase) || str.Equals("yes", StringComparison.OrdinalIgnoreCase);
    }

