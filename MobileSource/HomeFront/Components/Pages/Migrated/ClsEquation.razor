@namespace HomeFront.Components.Pages

@using Fx.ControlKit.Notifications

@code {
    private const string VbQuote = "\"";

    private bool _dirty;
    private bool _parsed;
    private bool _deg;
    private string _equ = "";
    private double _dAnswer;
    private List<object?> _equParsed = new();
    private List<int> _equOrder = new();
    private Dictionary<string, double> _vars = new();

    private static readonly Random _rng = new();

    private enum Priorities
    {
        PRI_None = 0,
        PRI_BOOLEAN = 1,
        PRI_OPERATOR = 2,
        PRI_ADD = 3,
        PRI_MOD = 4,
        PRI_MUL = 5,
        PRI_NEG = 6,
        PRI_EXP = 7,
        PRI_VAR = 8,
        PRI_PAR = 9,
        PRI_LEVEL = 9
    }

    private const int EQ_NONE = 0;
    private const int EQ_STRING = 1;
    private const int EQ_NUMBER = 2;

    private const int ER_NONE = 0;
    private const int ER_VAR = 1;

    private const int EQ_PAREN = 1100;
    private const int EQ_FUNCTION = 1101;
    private const int EQ_VARIABLE = 1102;
    private const int EQ_INVALID = 1103;
    private const int EQ_ARGS = 1104;
    private const int EQ_NAME = 1105;

    private const double PI = 3.14159265358979;
    private const double DEG_TO_RAD = PI / 180.0;
    private const double RAD_TO_DEG = 180.0 / PI;

    /// <summary>
    /// Optional parent form reference for lookup functions like GetItemTotal.
    /// Must implement GetItemTotal(string qtyType, string s1, string s2, string s3, string s4) returning double.
    /// </summary>
    [Parameter] public dynamic? ParentForm { get; set; }

    public bool Degrees
    {
        get => _deg;
        set
        {
            if (value != _deg)
            {
                _deg = value;
                _dirty = true;
            }
        }
    }

    public string Equation
    {
        get => _equ;
        set
        {
            _parsed = false;
            _dirty = true;
            _equ = ("(" + value + ")+0").Replace("\n", " ").Replace("\r", " ");
        }
    }

    public double GetVar(string name)
    {
        return _vars.TryGetValue(name.Trim(), out var val) ? val : 0.0;
    }

    public void SetVar(string name, double num)
    {
        _vars[name.Trim()] = num;
        _dirty = true;
    }

    public void VarClear()
    {
        _vars = new Dictionary<string, double>();
        _dirty = true;
    }

    public void VarRemove(string name)
    {
        _vars.Remove(name);
        _dirty = true;
    }

    public double Solution()
    {
        if (_dirty) Solve();
        return _dAnswer;
    }

    public void Solve()
    {
        object? v = null;
        int eSpace = ER_NONE;

        try
        {
            if (!_parsed) Parse();

            var temp = new object?[_equParsed.Count + 1];
            for (int i = 0; i < _equParsed.Count; i++)
                temp[i + 1] = _equParsed[i];

            eSpace = ER_NONE;

            for (int idx = 0; idx < _equOrder.Count; idx++)
            {
                int m = _equOrder[idx];
                v = temp[m];
                int i1 = GetLeft(m, temp);
                int i2 = GetRight(m, temp);

                object? v1 = null, v2 = null;
                if (i1 > 0 && i1 < temp.Length) v1 = temp[i1];
                if (i2 > 0 && i2 < temp.Length) v2 = temp[i2];

                bool bothNumeric = IsNumeric(v1) && IsNumeric(v2);
                if (bothNumeric)
                {
                    v1 = ToDouble(v1);
                    v2 = ToDouble(v2);
                }

                string vs = v?.ToString() ?? "";

                switch (vs)
                {
                    case "~":
                        temp[m] = (-ToDouble(temp[i2])).ToString();
                        temp[i2] = null;
                        break;
                    case "=":
                        temp[i1] = (Equals2(v1, v2) ? 1 : 0).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "<":
                        temp[i1] = (ToDouble(v1) < ToDouble(v2) ? 1 : 0).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case ">":
                        temp[i1] = (ToDouble(v1) > ToDouble(v2) ? 1 : 0).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "\x02": // <=
                        temp[i1] = (ToDouble(v1) <= ToDouble(v2) ? 1 : 0).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "\x03": // >=
                        temp[i1] = (ToDouble(v1) >= ToDouble(v2) ? 1 : 0).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "\x04": // <>
                        temp[i1] = (!Equals2(v1, v2) ? 1 : 0).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "\x05": // AND
                        temp[i1] = (ToDouble(v1) != 0 && ToDouble(v2) != 0 ? 1 : 0).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "\x06": // OR
                        temp[i1] = (ToDouble(v1) != 0 || ToDouble(v2) != 0 ? 1 : 0).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "+":
                        if (IsNumeric(temp[i1]))
                            temp[i1] = (ToDouble(temp[i1]) + ToDouble(temp[i2])).ToString();
                        else
                            temp[i1] = Quote(UnQuote(temp[i1]?.ToString() ?? "") + UnQuote(temp[i2]?.ToString() ?? ""));
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "*":
                        temp[i1] = (ToDouble(temp[i1]) * ToDouble(temp[i2])).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "/":
                        temp[i1] = (ToDouble(temp[i1]) / ToDouble(temp[i2])).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "\\":
                        temp[i1] = ((long)ToDouble(temp[i1]) / (long)ToDouble(temp[i2])).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "-":
                        temp[i1] = (ToDouble(temp[i1]) - ToDouble(temp[i2])).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "^":
                        temp[i1] = Math.Pow(ToDouble(temp[i1]), ToDouble(temp[i2])).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "%":
                        temp[i1] = (ToDouble(temp[i1]) % ToDouble(temp[i2])).ToString();
                        temp[i2] = null; temp[m] = null;
                        break;
                    case "(":
                        idx++;
                        int n = _equOrder[idx];
                        i2 = GetRight(m, temp);
                        if (i2 >= n)
                        {
                            temp[m] = 0.0;
                            temp[n] = null;
                        }
                        else
                        {
                            temp[m] = temp[i2];
                            temp[i2] = null;
                            temp[n] = null;
                        }
                        break;
                    default:
                        if (vs.EndsWith("("))
                        {
                            idx++;
                            int n2 = _equOrder[idx];

                            int fi1 = GetRight(m, temp);
                            int fi2 = GetRight(fi1, temp);
                            int fi3 = GetRight(fi2, temp);
                            int fi4 = GetRight(fi3, temp);
                            int fi5 = GetRight(fi4, temp);
                            int fi6 = GetLeft(n2, temp);

                            int iParams = 6;
                            if (IsCloseParen(temp, fi6)) iParams = 5;
                            if (IsCloseParen(temp, fi5)) iParams = 4;
                            if (IsCloseParen(temp, fi4)) iParams = 3;
                            if (IsCloseParen(temp, fi3)) iParams = 2;
                            if (IsCloseParen(temp, fi2)) iParams = 1;
                            if (IsCloseParen(temp, fi1)) iParams = 0;

                            double P1 = 0, P2 = 0, P3 = 0, P4 = 0, P5 = 0, P6 = 0;
                            string s1 = "", s2 = "", s3 = "", s4 = "", s5 = "", s6 = "";

                            if (fi1 >= n2) fi1 = 0;
                            P1 = ValStr(temp, fi1); s1 = GetStr(temp, fi1);

                            if (fi2 <= fi1) fi2 = 0;
                            P2 = ValStr(temp, fi2); s2 = GetStr(temp, fi2);

                            if (fi3 > n2) fi3 = 0;
                            P3 = ValStr(temp, fi3); s3 = GetStr(temp, fi3);

                            if (fi4 > n2) fi4 = 0;
                            P4 = ValStr(temp, fi4); s4 = GetStr(temp, fi4);

                            if (fi5 > n2) fi5 = 0;
                            P5 = ValStr(temp, fi5); s5 = GetStr(temp, fi5);

                            if (fi6 > n2) fi6 = 0;
                            P6 = ValStr(temp, fi6); s6 = GetStr(temp, fi6);

                            s1 = UnQuote(s1); s2 = UnQuote(s2); s3 = UnQuote(s3);
                            s4 = UnQuote(s4); s5 = UnQuote(s5); s6 = UnQuote(s6);

                            NullTemp(temp, fi1); NullTemp(temp, fi2); NullTemp(temp, fi3);
                            NullTemp(temp, fi4); NullTemp(temp, fi5); NullTemp(temp, fi6);
                            temp[m] = null;
                            temp[n2] = null;

                            double degMul = Degrees ? DEG_TO_RAD : 1.0;
                            double radMul = Degrees ? RAD_TO_DEG : 1.0;

                            switch (vs.ToLower())
                            {
                                case "abs(": temp[m] = Math.Abs(P1); break;
                                case "arccos(": temp[m] = (Math.Atan(-P1 / Math.Sqrt(-P1 * P1 + 1)) + 2 * Math.Atan(1)) * radMul; break;
                                case "arccosec(": temp[m] = (Math.Atan(P1 / Math.Sqrt(P1 * P1 - 1)) + (Math.Sign(P1) - 1) * (2 * Math.Atan(1))) * radMul; break;
                                case "arccosech(": temp[m] = Math.Log((Math.Sign(P1) * Math.Sqrt(P1 * P1 + 1) + 1) / P1); break;
                                case "arccosh(": temp[m] = Math.Log(P1 + Math.Sqrt(P1 * P1 - 1)); break;
                                case "arccotan(": temp[m] = (Math.Atan(P1 * radMul) + 2 * Math.Atan(1)) * radMul; break;
                                case "arccotanh(": temp[m] = Math.Log((P1 + 1) / (P1 - 1)) / 2; break;
                                case "arcsec(": temp[m] = (Math.Atan(P1 / Math.Sqrt(P1 * P1 - 1)) + (Math.Sign(P1) - 1) * (2 * Math.Atan(1))) * radMul; break;
                                case "arcsech(": temp[m] = Math.Log((Math.Sqrt(-P1 * P1 + 1) + 1) / P1); break;
                                case "arcsin(": temp[m] = Math.Atan(P1 / Math.Sqrt(-P1 * P1 + 1)) * radMul; break;
                                case "arcsinh(": temp[m] = Math.Log(P1 + Math.Sqrt(P1 * P1 + 1)); break;
                                case "arctan(": temp[m] = Math.Atan(P1) * radMul; break;
                                case "arctanh(": temp[m] = Math.Log((1 + P1) / (1 - P1)) / 2; break;
                                case "atn(": temp[m] = Math.Atan(P1) * radMul; break;
                                case "avg(": temp[m] = Avg(P1, P2, P3); break;
                                case "ceiling(": temp[m] = (double)CeilingFunc(P1); break;
                                case "cos(": temp[m] = Math.Cos(P1 * degMul); break;
                                case "cosec(": temp[m] = 1.0 / Math.Sin(P1 * degMul); break;
                                case "cosech(": temp[m] = 2.0 / (Math.Exp(P1) - Math.Exp(-P1)); break;
                                case "cosh(": temp[m] = (Math.Exp(P1) - Math.Exp(-P1)) / (Math.Exp(P1) + Math.Exp(-P1)); break;
                                case "cot(": temp[m] = 1.0 / Math.Tan(P1 * degMul); break;
                                case "cotanh(": temp[m] = (Math.Exp(P1) + Math.Exp(-P1)) / (Math.Exp(P1) - Math.Exp(-P1)); break;
                                case "degrees(": temp[m] = P1 * RAD_TO_DEG; break;
                                case "exp(": temp[m] = Math.Exp(P1); break;
                                case "fix(": temp[m] = (double)(long)P1; break;
                                case "floor(": temp[m] = (double)FloorFunc(P1); break;
                                case "int(": temp[m] = Math.Floor(P1); break;
                                case "ln(": temp[m] = Math.Log(P1); break;
                                case "log(": temp[m] = Math.Log(P1); break;
                                case "log10(": temp[m] = Math.Log(P1) / Math.Log(10); break;
                                case "log2(": temp[m] = Math.Log(P1) / Math.Log(2); break;
                                case "logn(": temp[m] = Math.Log(P1) / Math.Log(P2); break;
                                case "max(": temp[m] = MaxFunc(P1, P2, P3); break;
                                case "min(": temp[m] = MinFunc(P1, P2, P3); break;
                                case "mod(": temp[m] = P1 % P2; break;
                                case "pi(": temp[m] = PI; break;
                                case "power(": temp[m] = Math.Pow(P1, P2); break;
                                case "radians(": temp[m] = P1 * DEG_TO_RAD; break;
                                case "rnd(": temp[m] = _rng.NextDouble(); break;
                                case "rand(": temp[m] = (double)(int)(_rng.NextDouble() * P1); break;
                                case "random(": temp[m] = _rng.NextDouble() * (P2 - P1) + P1; break;
                                case "round(": temp[m] = RoundFunc(P1, P2); break;
                                case "roundto(": temp[m] = RoundTo(P1, P2, P3); break;
                                case "sec(": temp[m] = 1.0 / Math.Cos(P1 * degMul); break;
                                case "sech(": temp[m] = 2.0 / (Math.Exp(P1) + Math.Exp(-P1)); break;
                                case "sgn(": temp[m] = (double)Math.Sign(P1); break;
                                case "sin(": temp[m] = Math.Sin(P1 * degMul); break;
                                case "sinh(": temp[m] = (Math.Exp(P1) - Math.Exp(-P1)) / 2; break;
                                case "sqrt(": temp[m] = Math.Sqrt(P1); break;
                                case "square(": temp[m] = P1 * P1; break;
                                case "sum(": temp[m] = SumFunc(P1, P2, P3); break;
                                case "tan(": temp[m] = Math.Tan(P1 * degMul); break;
                                case "tanh(": temp[m] = (Math.Exp(P1) - Math.Exp(-P1)) / (Math.Exp(P1) + Math.Exp(-P1)); break;
                                case "trunc(": temp[m] = TruncFunc(P1, P2); break;

                                case "totalorderqty(":
                                    CheckArgs(vs, iParams, 4);
                                    temp[m] = ParentForm?.GetItemTotal("OrderQty", s1, s2, s3, s4) ?? 0.0;
                                    break;
                                case "totaltakeoffqty(":
                                    CheckArgs(vs, iParams, 4);
                                    temp[m] = ParentForm?.GetItemTotal("TakeoffQty", s1, s2, s3, s4) ?? 0.0;
                                    break;
                                case "totalcost(":
                                    CheckArgs(vs, iParams, 4);
                                    temp[m] = ParentForm?.GetItemTotal("Cost", s1, s2, s3, s4) ?? 0.0;
                                    break;

                                case "if(":
                                    if (IsNumeric(s2) || IsNumeric(s3))
                                        temp[m] = P1 != 0 ? P2 : P3;
                                    else
                                        temp[m] = Quote(P1 != 0 ? s2 : s3);
                                    break;

                                case "char(": temp[m] = Quote(((char)(int)P1).ToString()); break;
                                case "charindex(": temp[m] = (double)(s1.IndexOf(s2, StringComparison.OrdinalIgnoreCase) + 1); break;
                                case "instr(": temp[m] = (double)(s1.IndexOf(s2, StringComparison.OrdinalIgnoreCase) + 1); break;
                                case "left(": temp[m] = Quote(s1.Length >= (int)P2 ? s1.Substring(0, (int)P2) : s1); break;
                                case "len(": temp[m] = (double)s1.Length; break;
                                case "lower(": temp[m] = Quote(s1.ToLower()); break;
                                case "ltrim(": temp[m] = Quote(s1.TrimStart()); break;
                                case "replace(": temp[m] = Quote(s1.Replace(s2, s3)); break;
                                case "replicate(": temp[m] = Quote(new string(s1.Length > 0 ? s1[0] : ' ', (int)P2)); break;
                                case "right(": temp[m] = Quote(s1.Length >= (int)P2 ? s1.Substring(s1.Length - (int)P2) : s1); break;
                                case "rtrim(": temp[m] = Quote(s1.TrimEnd()); break;
                                case "space(": temp[m] = Quote(new string(' ', (int)P1)); break;
                                case "str(": temp[m] = Quote(P1.ToString()); break;
                                case "substring(": temp[m] = Quote(SafeSubstring(s1, (int)P2, (int)P3)); break;
                                case "upper(": temp[m] = Quote(s1.ToUpper()); break;

                                default:
                                    throw new Exception($"Undefined Function: {vs})");
                            }
                        }
                        else
                        {
                            switch (vs.ToLower())
                            {
                                case "pi": temp[m] = PI; break;
                                case "e": temp[m] = 2.718281828; break;
                                case "rnd": temp[m] = _rng.NextDouble(); break;
                                default:
                                    if (vs.StartsWith("\""))
                                    {
                                        temp[m] = vs;
                                    }
                                    else
                                    {
                                        eSpace = ER_VAR;
                                        if (_vars.TryGetValue(vs, out var varVal))
                                            temp[m] = varVal;
                                        else
                                            throw new Exception($"Undefined variable: {vs}");
                                        eSpace = ER_NONE;
                                    }
                                    break;
                            }
                        }
                        break;
                }
            }

            _dAnswer = ToDouble(temp[GetRight(0, temp)]);
            _dirty = false;
        }
        catch (DivideByZeroException)
        {
            throw;
        }
        catch (OverflowException)
        {
            throw;
        }
        catch (Exception ex)
        {
            if (eSpace == ER_VAR)
                throw new Exception($"Undefined Function: {v}", ex);
            throw new Exception($"Invalid Equation: {ex.Message}", ex);
        }
    }

    private void Parse()
    {
        string s = "";
        int t = EQ_NONE;
        int j = 0;
        int p = 0;
        bool isNeg = false;
        bool isQuote = false;

        var equParsedList = new List<object?>();
        var equPriorityList = new List<int>();
        int maxPriority = (int)Priorities.PRI_LEVEL;

        // Preprocessing
        _equ = _equ.Replace(" mod ", "%", StringComparison.OrdinalIgnoreCase);
        _equ = _equ.Replace("<=", "\x02");
        _equ = _equ.Replace(">=", "\x03");
        _equ = _equ.Replace("<>", "\x04");

        _equ = _equ.Replace(" AND ", "\x05", StringComparison.OrdinalIgnoreCase);
        _equ = _equ.Replace(" AND(", "\x05(", StringComparison.OrdinalIgnoreCase);
        _equ = _equ.Replace(")AND ", ")\x05", StringComparison.OrdinalIgnoreCase);
        _equ = _equ.Replace(")AND(", ")\x05(", StringComparison.OrdinalIgnoreCase);

        _equ = _equ.Replace(" OR ", "\x06", StringComparison.OrdinalIgnoreCase);
        _equ = _equ.Replace(" OR(", "\x06(", StringComparison.OrdinalIgnoreCase);
        _equ = _equ.Replace(")OR ", ")\x06", StringComparison.OrdinalIgnoreCase);
        _equ = _equ.Replace(")OR(", ")\x06(", StringComparison.OrdinalIgnoreCase);

        for (int i = 0; i < _equ.Length; i++)
        {
            char sTmp = _equ[i];

            if ((sTmp >= 'A' && sTmp <= 'Z') || (sTmp >= 'a' && sTmp <= 'z') || sTmp == '_' || sTmp == '"' || (isQuote && sTmp != '"'))
            {
                if (sTmp == '"') isQuote = !isQuote;
                if (t == EQ_NONE)
                {
                    t = EQ_STRING;
                    s = sTmp.ToString();
                }
                else if (t == EQ_NUMBER)
                {
                    t = EQ_STRING;
                    InsertAt(equParsedList, j, s);
                    InsertAt(equPriorityList, j, 0);
                    j++;
                    InsertAt(equParsedList, j, "*");
                    InsertAt(equPriorityList, j, (int)Priorities.PRI_MUL + p);
                    j++;
                    s = sTmp.ToString();
                }
                else
                {
                    s += sTmp;
                }
                isNeg = true;
            }
            else if ((sTmp >= '0' && sTmp <= '9') || sTmp == '.')
            {
                if (t == EQ_NONE)
                {
                    t = EQ_NUMBER;
                    s = sTmp.ToString();
                }
                else
                {
                    s += sTmp;
                }
                isNeg = true;
            }
            else if (sTmp == '(')
            {
                if (t == EQ_STRING)
                {
                    InsertAt(equParsedList, j, s + sTmp);
                    InsertAt(equPriorityList, j, p + (int)Priorities.PRI_PAR);
                    j++;
                    s = "";
                }
                else if (t == EQ_NUMBER)
                {
                    InsertAt(equParsedList, j, s);
                    InsertAt(equPriorityList, j, 0);
                    j++;
                    InsertAt(equParsedList, j, "*");
                    InsertAt(equPriorityList, j, p + (int)Priorities.PRI_MUL);
                    j++;
                    InsertAt(equParsedList, j, sTmp.ToString());
                    InsertAt(equPriorityList, j, p + (int)Priorities.PRI_PAR);
                    j++;
                    s = "";
                }
                else
                {
                    InsertAt(equParsedList, j, sTmp.ToString());
                    InsertAt(equPriorityList, j, p + (int)Priorities.PRI_PAR);
                    j++;
                }
                p += (int)Priorities.PRI_LEVEL;
                t = EQ_NONE;
                if (maxPriority < p + (int)Priorities.PRI_LEVEL)
                    maxPriority = p + (int)Priorities.PRI_LEVEL;
                isNeg = false;
            }
            else if (sTmp == '=' || sTmp == '<' || sTmp == '>' || sTmp == '\x02' || sTmp == '\x03' || sTmp == '\x04')
            {
                if (t != EQ_NONE)
                {
                    InsertAt(equParsedList, j, s);
                    InsertAt(equPriorityList, j, t == EQ_STRING ? p + (int)Priorities.PRI_VAR : 0);
                    j++;
                    s = "";
                }
                InsertAt(equParsedList, j, sTmp.ToString());
                InsertAt(equPriorityList, j, p + (int)Priorities.PRI_OPERATOR);
                j++;
                t = EQ_NONE;
                isNeg = false;
            }
            else if (sTmp == '\x05' || sTmp == '\x06')
            {
                if (t != EQ_NONE)
                {
                    InsertAt(equParsedList, j, s);
                    InsertAt(equPriorityList, j, t == EQ_STRING ? p + (int)Priorities.PRI_VAR : 0);
                    j++;
                    s = "";
                }
                InsertAt(equParsedList, j, sTmp.ToString());
                InsertAt(equPriorityList, j, p + (int)Priorities.PRI_BOOLEAN);
                j++;
                t = EQ_NONE;
                isNeg = false;
            }
            else if (sTmp == '*' || sTmp == '/')
            {
                if (t != EQ_NONE)
                {
                    InsertAt(equParsedList, j, s);
                    InsertAt(equPriorityList, j, t == EQ_STRING ? p + (int)Priorities.PRI_VAR : 0);
                    j++;
                    s = "";
                }
                InsertAt(equParsedList, j, sTmp.ToString());
                InsertAt(equPriorityList, j, p + (int)Priorities.PRI_MUL);
                j++;
                t = EQ_NONE;
                isNeg = false;
            }
            else if (sTmp == '\\')
            {
                if (t != EQ_NONE)
                {
                    InsertAt(equParsedList, j, s);
                    InsertAt(equPriorityList, j, t == EQ_STRING ? p + (int)Priorities.PRI_VAR : 0);
                    j++;
                    s = "";
                }
                InsertAt(equParsedList, j, sTmp.ToString());
                InsertAt(equPriorityList, j, p + (int)Priorities.PRI_MUL);
                j++;
                t = EQ_NONE;
                isNeg = false;
            }
            else if (sTmp == '+')
            {
                if (t != EQ_NONE)
                {
                    InsertAt(equParsedList, j, s);
                    InsertAt(equPriorityList, j, t == EQ_STRING ? p + (int)Priorities.PRI_VAR : 0);
                    j++;
                    s = "";
                }
                InsertAt(equParsedList, j, sTmp.ToString());
                InsertAt(equPriorityList, j, p + (int)Priorities.PRI_ADD);
                j++;
                t = EQ_NONE;
                isNeg = false;
            }
            else if (sTmp == '-')
            {
                if (t != EQ_NONE)
                {
                    InsertAt(equParsedList, j, s);
                    InsertAt(equPriorityList, j, t == EQ_STRING ? p + (int)Priorities.PRI_VAR : 0);
                    j++;
                    s = "";
                }
                if (isNeg)
                {
                    InsertAt(equParsedList, j, sTmp.ToString());
                    InsertAt(equPriorityList, j, p + (int)Priorities.PRI_ADD);
                    j++;
                    t = EQ_NONE;
                }
                else
                {
                    InsertAt(equParsedList, j, "~");
                    InsertAt(equPriorityList, j, p + (int)Priorities.PRI_NEG);
                    j++;
                    t = EQ_NONE;
                }
                isNeg = false;
            }
            else if (sTmp == '^')
            {
                if (t != EQ_NONE)
                {
                    InsertAt(equParsedList, j, s);
                    InsertAt(equPriorityList, j, t == EQ_STRING ? p + (int)Priorities.PRI_VAR : 0);
                    j++;
                    s = "";
                }
                InsertAt(equParsedList, j, sTmp.ToString());
                InsertAt(equPriorityList, j, p + (int)Priorities.PRI_EXP);
                j++;
                t = EQ_NONE;
                isNeg = false;
            }
            else if (sTmp == '%')
            {
                if (t != EQ_NONE)
                {
                    InsertAt(equParsedList, j, s);
                    InsertAt(equPriorityList, j, t == EQ_STRING ? p + (int)Priorities.PRI_VAR : 0);
                    j++;
                    s = "";
                }
                InsertAt(equParsedList, j, sTmp.ToString());
                InsertAt(equPriorityList, j, p + (int)Priorities.PRI_MOD);
                j++;
                t = EQ_NONE;
                isNeg = false;
            }
            else if (sTmp == ',')
            {
                if (t != EQ_NONE)
                {
                    InsertAt(equParsedList, j, s);
                    InsertAt(equPriorityList, j, t == EQ_STRING ? p + (int)Priorities.PRI_VAR : 0);
                    j++;
                    s = "";
                }
                InsertAt(equParsedList, j, null);
                InsertAt(equPriorityList, j, 0);
                j++;
                t = EQ_NONE;
                isNeg = false;
            }
            else if (sTmp == ')')
            {
                if (t != EQ_NONE)
                {
                    InsertAt(equParsedList, j, s);
                    InsertAt(equPriorityList, j, t == EQ_STRING ? p + (int)Priorities.PRI_VAR : 0);
                    j++;
                    s = "";
                }
                InsertAt(equParsedList, j, sTmp.ToString());
                InsertAt(equPriorityList, j, p - ((int)Priorities.PRI_LEVEL - (int)Priorities.PRI_PAR));
                p -= (int)Priorities.PRI_LEVEL;
                j++;
                t = EQ_NONE;
                isNeg = true;
            }
            // else: skip spaces and other chars
        }

        if (s != "")
        {
            InsertAt(equParsedList, j, s);
            InsertAt(equPriorityList, j, t == EQ_STRING ? p + (int)Priorities.PRI_VAR : 0);
        }

        if (p != 0)
            throw new Exception("Unbalanced parenthesis");

        // Build order
        _equOrder = new List<int>();
        for (int pri = 1; pri <= maxPriority; pri++)
        {
            for (int k = equPriorityList.Count - 1; k >= 0; k--)
            {
                if (equPriorityList[k] == pri)
                    _equOrder.Add(k + 1); // 1-based
            }
        }

        _equParsed = equParsedList;
        _parsed = true;
    }

    // Helper: insert at position in list (0-based j maps to list index)
    private void InsertAt<T>(List<T> list, int index, T value)
    {
        while (list.Count <= index) list.Add(default!);
        list[index] = value;
    }

    private int GetRight(int j, object?[] v)
    {
        for (int i = j + 1; i < v.Length; i++)
        {
            if (v[i] != null) return i;
        }
        return 0;
    }

    private int GetLeft(int j, object?[] v)
    {
        for (int i = j - 1; i >= 1; i--)
        {
            if (v[i] != null) return i;
        }
        return 0;
    }

    private bool IsNumeric(object? val)
    {
        if (val == null) return false;
        if (val is double || val is int || val is long || val is float || val is decimal) return true;
        return double.TryParse(val.ToString(), System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out _);
    }

    private double ToDouble(object? val)
    {
        if (val == null) return 0;
        if (val is double d) return d;
        if (val is int i) return i;
        if (val is long l) return l;
        if (double.TryParse(val.ToString(), System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var result))
            return result;
        return 0;
    }

    private bool Equals2(object? a, object? b)
    {
        if (IsNumeric(a) && IsNumeric(b))
            return ToDouble(a) == ToDouble(b);
        return string.Equals(a?.ToString(), b?.ToString(), StringComparison.OrdinalIgnoreCase);
    }

    private bool IsCloseParen(object?[] temp, int idx)
    {
        if (idx <= 0 || idx >= temp.Length) return false;
        return temp[idx]?.ToString() == ")";
    }

    private double ValStr(object?[] temp, int idx)
    {
        if (idx <= 0 || idx >= temp.Length) return 0;
        var s = temp[idx]?.ToString() ?? "";
        if (double.TryParse(s, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var result))
            return result;
        return 0;
    }

    private string GetStr(object?[] temp, int idx)
    {
        if (idx <= 0 || idx >= temp.Length) return "";
        return temp[idx]?.ToString() ?? "";
    }

    private void NullTemp(object?[] temp, int idx)
    {
        if (idx > 0 && idx < temp.Length) temp[idx] = null;
    }

    private string UnQuote(string s)
    {
        if (s.StartsWith(VbQuote)) s = s.Substring(1);
        if (s.EndsWith(VbQuote)) s = s.Substring(0, s.Length - 1);
        return s;
    }

    private string Quote(string s) => VbQuote + s + VbQuote;

    private string SafeSubstring(string s, int start, int length)
    {
        if (start < 1) start = 1;
        int idx = start - 1; // VB Mid is 1-based
        if (idx >= s.Length) return "";
        int len = Math.Min(length, s.Length - idx);
        return s.Substring(idx, len);
    }

    private void CheckArgs(string functionName, int given, int expected)
    {
        if (given != expected)
            throw new Exception($"{functionName.Replace("(", "")} expects {expected} argument(s)");
    }

    // Math helper functions
    private double TruncFunc(double number, double decimalPlaces)
    {
        double dp = -1 * Math.Floor(decimalPlaces);
        return Math.Floor(number / Math.Pow(10, dp)) * Math.Pow(10, dp);
    }

    private double RoundFunc(double number, double decimalPlaces)
    {
        double dp = -1 * Math.Floor(decimalPlaces);
        return Math.Round(Math.Floor(number / Math.Pow(10, dp - 1)) / 10.0) * Math.Pow(10, dp);
    }

    private double RoundTo(double number, double method, double significance)
    {
        if (significance == 0 || number == significance) return number;
        if (number / significance == Math.Floor(number / significance)) return number;

        switch ((int)method)
        {
            case 1: // up
            {
                double tmpVal = number / significance + 0.5;
                double tmpVal2 = tmpVal;
                tmpVal = (int)Math.Round((tmpVal - (long)tmpVal2) * 1.0);
                number = (long)tmpVal2 + tmpVal / 1.0;
                return number * significance;
            }
            case 0: // closest
            {
                double down = RoundTo(number, -1, significance);
                double up = RoundTo(number, 1, significance);
                return Math.Abs(number - down) < Math.Abs(number - up) ? down : up;
            }
            case -1: // down
            {
                double tmpVal = number / significance - 0.5;
                double tmpVal2 = tmpVal;
                tmpVal = (int)Math.Round((tmpVal - (long)tmpVal2) * 1.0);
                number = (long)tmpVal2 + tmpVal / 1.0;
                return number * significance;
            }
            default:
                return number;
        }
    }

    private double MinFunc(params double[] items)
    {
        double v = items[0];
        for (int i = 1; i < items.Length; i++)
            if (items[i] < v) v = items[i];
        return v;
    }

    private double MaxFunc(params double[] items)
    {
        double v = items[0];
        for (int i = 1; i < items.Length; i++)
            if (items[i] > v) v = items[i];
        return v;
    }

    private double SumFunc(params double[] items)
    {
        double v = 0;
        foreach (var item in items) v += item;
        return v;
    }

    private double Avg(params double[] items)
    {
        double v = 0;
        foreach (var item in items) v += item;
        return v / items.Length;
    }

    private long CeilingFunc(double number)
    {
        if (number >= 0)
        {
            if (number == Math.Floor(number)) return (long)number;
            return (long)Math.Floor(number) + 1;
        }
        return (long)Math.Floor(number);
    }

    private long FloorFunc(double number)
    {
        if (number >= 0)
        {
            if (number == Math.Floor(number)) return (long)number;
            return (long)Math.Floor(number);
        }
        return (long)Math.Floor(number) - 1;
    }
}
