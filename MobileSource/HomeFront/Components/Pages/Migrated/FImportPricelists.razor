    // === Helpers ===
    private string GetColValue(string[] row, string colName)
    {
        if (ColIndexMap.TryGetValue(colName, out var idx) && idx < row.Length)
            return row[idx]?.Trim() ?? "";
        return "";
    }

    private decimal ParseDecimal(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return 0;
        val = val.Replace("$", "").Replace(",", "").Trim();
        return decimal.TryParse(val, out var result) ? result : 0;
    }

    private DateTime? ParseNullableDate(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return null;
        return DateTime.TryParse(val, out var result) ? result : null;
    }

    private string SafeSubstring(string s, int start, int length)
    {
        if (string.IsNullOrEmpty(s) || start >= s.Length) return "";
        if (start + length > s.Length) length = s.Length - start;
        return s.Substring(start, length);
    }
