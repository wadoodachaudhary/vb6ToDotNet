    private async Task OnCopyAssembly()
    {
        _newDropdownOpen = false;
        if (mAssemblyID == 0) { await JSRuntime.InvokeVoidAsync("alert", "No assembly is loaded to copy."); return; }
        if (!await SaveData(true)) return;

        // Save copy references (VB6: mCopiedAssembly, etc.)
        mCopiedCommunity = mCommunity;
        mCopiedAssembly = mAssembly;
        mCopiedAssemblyID = mAssemblyID;
        mCopiedModel = mModel;
        mCopiedOption = mOptionID;
        mCopiedKey = mCopiedCommunity + "\x01" + mCopiedAssembly + "\x01" + mCopiedModel + "\x01" + mCopiedOption;

        // Enable editing fields
        _communityEnabled = true;
        _assemblyEnabled = true;
        _modelEnabled = mAssemblyType == AssemblyTypes.atModel || mAssemblyType == AssemblyTypes.atoption;
        _optionEnabled = mAssemblyType != AssemblyTypes.atModel;

        IsIncludedOption = false;
        IsDCSalesOnly = false;
        IsSelectByRoom = false;
        IsDisplayTotalOnly = false;

        // Mark all items as "new" so they get inserted as fresh records
        foreach (var item in ItemsData)
        {
            if (item.RowStatus != "delete") item.RowStatus = "new";
        }

        mDirty = true;
        await InvokeAsync(StateHasChanged);
    }

