    // VB6 FAssembly.frm:3490-3494 — the item INSERT lists WBS01..WBS40 between
    // Invertable and ConversionFactor. They're loaded + round-tripped into
    // AssemblyItemRow.WBS, so they must be written back on Save or every WBS
    // assignment silently vanishes.
    private static readonly string WbsColumnList =
        string.Concat(Enumerable.Range(1, 40).Select(w => $", WBS{w:D2}"));
    private static readonly string WbsValueList =
        string.Concat(Enumerable.Range(1, 40).Select(w => $", @WBS{w:D2}"));
    private static readonly string WbsSetList =
        string.Concat(Enumerable.Range(1, 40).Select(w => $", WBS{w:D2}=@WBS{w:D2}"));

    private string BuildItemInsertSql() => $@"
        INSERT INTO tblDBAssemblyDetails(AssemblyID, DivisionID, Community, Assembly, Model, OptionID,
            Phase, Item, ItemChart, Notes, UStmp, TStmp, Formula, TakeoffQty, OrderQty, POIndex, Location,
            UseModelCost, Invertable{WbsColumnList}, ConversionFactor)
        VALUES(@AssemblyID, @DivisionID, @Community, @Assembly, @Model, @OptionID,
            @Phase, @Item, @ItemChart, @Notes, 'web', GETDATE(), @Formula, @TakeoffQty, @OrderQty, @POIndex, @Location,
            @UseModelCost, @Invertable{WbsValueList}, @ConversionFactor);
        SELECT SCOPE_IDENTITY();";

    private string BuildItemUpdateSql() => $@"
        UPDATE tblDBAssemblyDetails SET
            AssemblyID=@AssemblyID, DivisionID =@DivisionID, Community=@Community, Assembly=@Assembly, Model=@Model, OptionID=@OptionID,
            Phase=@Phase, Item=@Item, ItemChart=@ItemChart, Notes=@Notes, UStmp='web', TStmp=GETDATE(),
            Formula=@Formula, TakeoffQty=@TakeoffQty, OrderQty=@OrderQty, POIndex=@POIndex, Location=@Location,
            UseModelCost=@UseModelCost, Invertable=@Invertable{WbsSetList}, ConversionFactor=@ConversionFactor
        WHERE Sequence=@Sequence";

    private Dictionary<string, object?> BuildItemParams(AssemblyItemRow item, int divisionId)
    {
        var p = new Dictionary<string, object?>
        {
            ["AssemblyID"] = mAssemblyID,
            ["DivisionID"] = divisionId,
            ["Community"] = CommunityValue ?? "",
            ["Assembly"] = AssemblyCode ?? "",
            ["Model"] = ModelValue ?? "",
            ["OptionID"] = OptionValue ?? "",
            ["Phase"] = item.Phase,
            ["Item"] = item.Item,
            ["ItemChart"] = item.ItemChart,
            ["Notes"] = item.Notes,
            ["Formula"] = item.Formula,
            ["TakeoffQty"] = item.TakeoffQty,
            ["OrderQty"] = item.OrderQty,
            ["POIndex"] = item.POIndex,
            ["Location"] = item.Location,
            ["UseModelCost"] = item.UseModelCost,
            ["Invertable"] = item.Invertable,
            ["ConversionFactor"] = item.AssemblyConversionFactor,
            ["Sequence"] = item.Sequence,
        };
        // VB6 wrote each WBS slot with DbQuote(Str, …) — a string column.
        for (int w = 1; w <= 40; w++)
            p[$"WBS{w:D2}"] = (item.WBS != null && item.WBS.TryGetValue(w, out var v)) ? (v ?? "") : "";
        return p;
    }

    // ── UpdateItemPrice / PriceLevelIndex (VB6: FAssembly.frm:4455-4633) ──
    // VB6 SaveData calls UpdateItemPrice(i) for every price-Dirty item, both on
    // the new-row and update-row passes. It deletes the old tblVendorCost row
    // when the level became less specific, then inserts/updates the vendor cost
    // at the new phase/community/global/corporate level. Without this, grid
    // price edits never persist to tblVendorCost.

    private int PriceLevelIndex(string? name)
    {
        // VB6 used FMain.CD_Community for the community word; here CommunityTerm.
        if (name == "Phase Specific") return 1;
        if (name == $"{CommunityTerm} Specific") return 2;
        if (name == $"Global (any {CommunityTerm})") return 3;
        if (name == "Corporate (any Division)") return 4;
        if (name == "Item DB") return 5;
        return 0;
    }

    /// <summary>VB6 UpdateItemPrice(i) — writes the row's vendor cost back to
    /// tblVendorCost at the row's PriceLevel/ItemType. All values are
    /// parameterized. No-op when PricingCommunity is blank (VB6 early-exits).</summary>
    private async Task UpdateItemPrice(AssemblyItemRow item, int divisionId)
    {
        if (string.IsNullOrEmpty(PricingCommunity)) return;

        try
        {
            var oldType = item.OldItemType ?? "";
            var newType = item.ItemType ?? "";
            var oldLevel = PriceLevelIndex(item.OldPriceLevel);
            var newLevel = PriceLevelIndex(item.PriceLevel);
            // pricelevels: 1=phase 2=community 3=global 4=corporate 5=item db

            // ── if new price level is less specific, remove the old one ──
            if (((newLevel > oldLevel) || (oldType == "Quote" && newType != "Quote"))
                && oldLevel != 0 && oldLevel != 4)
            {
                var delSql = new StringBuilder();
                delSql.AppendLine("delete tblvendorcost");
                delSql.AppendLine("from tblphaseitem i");
                delSql.AppendLine("join tblphaseitem x on i.divisionid=x.divisionid and ((i.pricelink<>0 and i.pricelink=x.pricelink) or (i.phase=x.phase and i.item=x.item))");
                delSql.AppendLine("join tblvendorcost c on c.divisionid=x.divisionid and c.phase=x.phase and c.item=x.item");
                delSql.AppendLine("where i.divisionid=@DivisionID");
                delSql.AppendLine("and i.phase=@Phase");
                delSql.AppendLine("and i.item=@Item");
                switch (oldLevel)
                {
                    case 1: // phase
                        delSql.AppendLine("  and isnull(c.community,'')=@PricingCommunity");
                        delSql.AppendLine("  and isnull(c.communityphase,'')=@PricingCommunityPhase");
                        break;
                    case 2: // community
                        delSql.AppendLine("  and isnull(c.community,'')=@PricingCommunity");
                        delSql.AppendLine("  and isnull(c.communityphase,'')=''");
                        break;
                    default: // global
                        delSql.AppendLine("  and isnull(c.community,'')=''");
                        delSql.AppendLine("  and isnull(c.communityphase,'')=''");
                        break;
                }
                if (oldType == "Quote")
                {
                    delSql.AppendLine("  and isnull(c.assembly,'')=@Assembly");
                    delSql.AppendLine("  and isnull(c.model,'')=@Model");
                }
                else
                {
                    delSql.AppendLine("  and isnull(c.assembly,'')=''");
                    delSql.AppendLine("  and isnull(c.model,'')=''");
                }
                await db.ExecuteAsync(delSql.ToString(), new
                {
                    DivisionID = divisionId,
                    Phase = item.Phase ?? "",
                    Item = item.Item ?? "",
                    PricingCommunity = PricingCommunity,
                    PricingCommunityPhase = PricingCommunityPhase,
                    Assembly = AssemblyCode ?? "",
                    Model = ModelValue ?? ""
                });
            }

            // ── now do insert/update ──
            if (newLevel == 5)
            {
                // Item DB — nothing to write to tblVendorCost.
            }
            else if (!string.IsNullOrEmpty(item.Vendor))
            {
                // VB6 uses DivisionID 0 for a corporate (level 4) write.
                int costDivision = newLevel == 4 ? 0 : divisionId;

                // The 13 Current_Cost/Forecast1..12 columns all get the price.
                // SqlCommand needs distinct param names, so expand to @Price1..@Price13.
                var priceCols = "@Price01,@Price02,@Price03,@Price04,@Price05,@Price06,@Price07,@Price08,@Price09,@Price10,@Price11,@Price12,@Price13";

                var insSql = new StringBuilder();
                insSql.AppendLine("insert into tblvendorcost(phase,item,DivisionID,vendor,community,communityphase,assembly,model,Current_Cost,Forecast1,Forecast2,Forecast3,Forecast4,Forecast5,Forecast6,Forecast7,Forecast8,Forecast9,Forecast10,Forecast11,Forecast12)");
                insSql.AppendLine("select x.phase,x.item");
                insSql.AppendLine(" ,@CostDivision");
                insSql.AppendLine(" ,@Vendor");
                switch (newLevel)
                {
                    case 1: // phase
                        insSql.AppendLine(" ,@PricingCommunity");
                        insSql.AppendLine(" ,@PricingCommunityPhase");
                        break;
                    case 2: // community
                        insSql.AppendLine(" ,@PricingCommunity");
                        insSql.AppendLine(" ,''");
                        break;
                    default: // global, corporate
                        insSql.AppendLine(" ,'',''");
                        break;
                }
                if (newType == "Quote")
                {
                    insSql.AppendLine(" ,@Assembly");
                    insSql.AppendLine(" ,@Model");
                }
                else
                {
                    insSql.AppendLine(" ,'',''");
                }
                insSql.AppendLine($" ,{priceCols}");
                insSql.AppendLine("from tblphaseitem i");
                insSql.AppendLine("join tblphaseitem x on i.divisionid=x.divisionid and ((i.pricelink<>0 and i.pricelink=x.pricelink) or (i.phase=x.phase and i.item=x.item))");
                insSql.AppendLine("left outer join tblVendorCost c on c.divisionid=@CostDivision and x.phase=c.phase and x.item=c.item");
                insSql.AppendLine(" and c.vendor=@Vendor");
                switch (newLevel)
                {
                    case 1:
                        insSql.AppendLine(" and c.community=@PricingCommunity");
                        insSql.AppendLine(" and c.communityphase=@PricingCommunityPhase");
                        break;
                    case 2:
                        insSql.AppendLine(" and c.community=@PricingCommunity");
                        insSql.AppendLine(" and c.communityphase=''");
                        break;
                    default:
                        insSql.AppendLine(" and c.community=''");
                        insSql.AppendLine(" and c.communityphase=''");
                        break;
                }
                if (newType == "Quote")
                {
                    insSql.AppendLine(" and c.assembly=@Assembly");
                    insSql.AppendLine(" and c.model=@Model");
                }
                else
                {
                    insSql.AppendLine(" and c.assembly=''");
                    insSql.AppendLine(" and c.model=''");
                }
                insSql.AppendLine("where c.vendor is null");
                insSql.AppendLine("and i.divisionid=@DivisionID");
                insSql.AppendLine("and i.phase=@Phase");
                insSql.AppendLine("and i.item=@Item");

                var priceParams = new Dictionary<string, object?>
                {
                    ["DivisionID"] = divisionId,
                    ["CostDivision"] = costDivision,
                    ["Vendor"] = item.Vendor ?? "",
                    ["PricingCommunity"] = PricingCommunity,
                    ["PricingCommunityPhase"] = PricingCommunityPhase,
                    ["Assembly"] = AssemblyCode ?? "",
                    ["Model"] = ModelValue ?? "",
                    ["Phase"] = item.Phase ?? "",
                    ["Item"] = item.Item ?? "",
                };
                for (int j = 1; j <= 13; j++)
                    priceParams[$"Price{j:D2}"] = item.Price ?? 0;

                await db.ExecuteAsync(insSql.ToString(), priceParams);

                // ── update ──
                var updSql = new StringBuilder();
                updSql.AppendLine("update c set current_cost=@Price01");
                updSql.AppendLine("from tblphaseitem i");
                updSql.AppendLine("join tblphaseitem x on i.divisionid=x.divisionid and ((i.pricelink<>0 and i.pricelink=x.pricelink) or (i.phase=x.phase and i.item=x.item))");
                updSql.AppendLine("join tblVendorCost c on c.divisionid=@CostDivision and x.phase=c.phase and x.item=c.item");
                updSql.AppendLine(" and c.vendor=@Vendor");
                switch (newLevel)
                {
                    case 1:
                        updSql.AppendLine(" and c.community=@PricingCommunity");
                        updSql.AppendLine(" and c.communityphase=@PricingCommunityPhase");
                        break;
                    case 2:
                        updSql.AppendLine(" and c.community=@PricingCommunity");
                        updSql.AppendLine(" and c.communityphase=''");
                        break;
                    default:
                        updSql.AppendLine(" and c.community=''");
                        updSql.AppendLine(" and c.communityphase=''");
                        break;
                }
                if (newType == "Quote")
                {
                    updSql.AppendLine(" and c.assembly=@Assembly");
                    updSql.AppendLine(" and c.model=@Model");
                }
                else
                {
                    updSql.AppendLine(" and c.assembly=''");
                    updSql.AppendLine(" and c.model=''");
                }
                updSql.AppendLine("where i.divisionid=@DivisionID");
                updSql.AppendLine("and i.phase=@Phase");
                updSql.AppendLine("and i.item=@Item");

                await db.ExecuteAsync(updSql.ToString(), priceParams);
            }

            // reset these (VB6 lines 4622-4624)
            item.OldPriceLevel = item.PriceLevel;
            item.OldItemType = item.ItemType;
            item.PriceDirty = false;
        }
        catch (Exception ex)
        {
            // VB6 swallows duplicate-key errors (Resume Next); log the rest.
            if (ex.Message.IndexOf("duplicate", StringComparison.OrdinalIgnoreCase) < 0)
            {
                Logger.LogError(ex, "UpdateItemPrice failed");
                Notifications.Error($"Could not update item price: {ex.Message}");
            }
        }
    }

    /// <summary>VB6 SaveData mDataSource==1 branch (FAssembly.frm:3634-3699):
    /// assign the just-created/edited DB assembly back to the originating sales
    /// row (tblModels / tblOptions / tblDCOptions / tblGlobalOptions) by
    /// AssemblyType, then clear mDataSource. The optional Comments column is only
    /// written when Comments is non-empty (VB6 parity). Mirrors VB6 WHERE keys
    /// exactly (ISNULL(Area,'') / Series / Opt / Community as appropriate).</summary>
    private async Task WriteBackSalesAssemblyAsync(int divisionId)
    {
        try
        {
            var community = CommunityValue ?? "";
            var assembly = AssemblyCode ?? "";
            var description = Description ?? "";
            var model = ModelValue ?? "";
            var series = SeriesValue ?? "";
            var option = OptionValue ?? "";
            var uom = UOMValue ?? "";
            var category = CategoryValue ?? "";
            var jcExtra = JCExtra ?? "";
            var comments = Comments ?? "";
            var style = ShowStyleCombo ? (StyleValue ?? "") : (StyleText ?? "");
            bool hasComments = !string.IsNullOrWhiteSpace(comments);

            var p = new Dictionary<string, object?>
            {
                ["Assembly"] = assembly,
                ["Description"] = description,
                ["Comments"] = comments,
                ["Series"] = series,
                ["Style"] = style,
                ["Bedrooms"] = Bedrooms ?? 0,
                ["Bathrooms"] = Bathrooms ?? 0,
                ["FloorArea"] = FloorArea ?? 0,
                ["UOM"] = uom,
                ["Category"] = category,
                ["TL_Extra"] = jcExtra,
                ["Community"] = community,
                ["Model"] = model,
                ["Opt"] = option,
                ["DivisionID"] = divisionId,
            };

            string sql;
            switch (mAssemblyType)
            {
                case AssemblyTypes.atModel:
                    sql =
                        "UPDATE tblModels SET Assembly=@Assembly, Description=@Description"
                        + (hasComments ? ", Comments=@Comments" : "")
                        + ", Series=@Series, Style=@Style, NoOfBedrooms=@Bedrooms, NoOfBathrooms=@Bathrooms, modelsize=@FloorArea "
                        + "WHERE ISNULL(Area,'')=@Community AND ISNULL(Assembly,'')='' "
                        + "AND ISNULL(Model,'')=@Model AND ISNULL(Series,'')=@Series AND DivisionID=@DivisionID";
                    break;
                case AssemblyTypes.atoption:
                    sql =
                        "UPDATE tblOptions SET Assembly=@Assembly, Description=@Description, UOM=@UOM"
                        + (hasComments ? ", Comments=@Comments" : "")
                        + ", Category=@Category, TL_Extra=@TL_Extra "
                        + "WHERE ISNULL(Area,'')=@Community AND ISNULL(Assembly,'')='' "
                        + "AND Model=@Model AND Series=@Series AND Opt=@Opt AND DivisionID=@DivisionID";
                    break;
                case AssemblyTypes.atDesignCenter:
                    sql =
                        "UPDATE tblDCOptions SET Assembly=@Assembly, Description=@Description, UOM=@UOM"
                        + (hasComments ? ", Comments=@Comments" : "")
                        + ", Category=@Category, TL_Extra=@TL_Extra "
                        + "WHERE ISNULL(Community,'')=@Community AND ISNULL(Assembly,'')='' "
                        + "AND Opt=@Opt AND DivisionID=@DivisionID";
                    break;
                case AssemblyTypes.atGlobal:
                    // VB6: global splits on whether a community is set.
                    sql =
                        "UPDATE tblGlobalOptions SET Assembly=@Assembly, Description=@Description, UOM=@UOM"
                        + (hasComments ? ", Comments=@Comments" : "")
                        + ", Category=@Category, TL_Extra=@TL_Extra ";
                    sql += string.IsNullOrEmpty(community)
                        ? "WHERE ISNULL(Assembly,'')='' AND Opt=@Opt AND DivisionID=@DivisionID"
                        : "WHERE ISNULL(Community,'')=@Community AND ISNULL(Assembly,'')='' AND Opt=@Opt AND DivisionID=@DivisionID";
                    break;
                default:
                    mDataSource = 0;
                    return;
            }

            await db.ExecuteAsync(sql, p);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sales assembly write-back (mDataSource=1) failed");
            Notifications.Warning($"Could not write the assembly back to the sales list: {ex.Message}");
        }
        finally
        {
            mDataSource = 0; // VB6 line 3698
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── Item Management (VB6: mnuAssemblyItemsSub_Click, gItems_KeyDown) ─
    // ═══════════════════════════════════════════════════════════════════════
    private async Task OnRemoveItemClick()
    {
        _showItemsContextMenu = false;
        if (gItems == null || mReadOnly) return;
        var selected = gItems.GetSelectedRecords().ToList();
        if (selected.Count == 0)
        {
            Notifications.Info("Select one or more rows to remove.");
            return;
        }
        // Confirm — same MessageBoxControl-first / browser-confirm-fallback
        // pattern used elsewhere in the form (e.g. OnRemoveComponentClick).
        var confirm = _messageBox != null
            ? await _messageBox.ShowAsync(
                $"Remove {selected.Count} selected item(s)?",
                title: "Remove item?",
                buttons: MessageBoxButtons.YesNo)
            : (await Dialogs.ConfirmAsync($"Remove {selected.Count} selected item(s)?")
                ? MessageBoxResult.Yes
                : MessageBoxResult.No);
        if (confirm != MessageBoxResult.Yes) return;

        // Move existing rows (Sequence > 0) to _deletedItems for DB deletion on save
        // New rows (Sequence == 0) can just be discarded
        foreach (var item in selected)
        {
            item.RowStatus = "delete";
            if (item.Sequence != 0)
                _deletedItems.Add(item);
        }

        // Remove all deleted rows from the visible grid
        ItemsData.RemoveAll(i => selected.Contains(i));

        mDirty = true;
        RecalculateCosts();
        if (gItems != null)
        {
            await gItems.Refresh();
            await gItems.ClearSelectionAsync();
        }
    }

    private async Task OnCopyItemClick()
    {
        _showItemsContextMenu = false;
        if (gItems == null || mReadOnly) return;
        var selected = gItems.GetSelectedRecords().ToList();
        if (selected.Count == 0) { Notifications.Info("Select one or more rows to copy."); return; }
        var currentRowIndex = gItems.GetCurrentRowIndex() ?? (ItemsData.Count - 1);
        if (currentRowIndex < -1) currentRowIndex = -1;
        var ordered = selected
            .Select(item => (item, idx: ItemsData.IndexOf(item)))
            .OrderBy(t => t.idx >= 0 ? t.idx : int.MaxValue)
            .Select(t => t.item)
            .ToList();

        var insertAt = currentRowIndex + 1;
        foreach (var original in ordered)
        {
            var copy = CloneAssemblyItemRow(original);
            copy.Sequence = 0;
            copy.RowStatus = "new";
            ItemsData.Insert(insertAt, copy);
            insertAt++;
        }
        mDirty = true;
        RecalculateCosts();
        if (gItems != null)
        {
            await gItems.Refresh();
            await gItems.ClearSelectionAsync();
        }
    }

    private static AssemblyItemRow CloneAssemblyItemRow(AssemblyItemRow source)
    {
        var clone = new AssemblyItemRow();
        var props = typeof(AssemblyItemRow).GetProperties(BindingFlags.Public | BindingFlags.Instance);
        foreach (var prop in props)
        {
            if (!prop.CanRead || !prop.CanWrite) continue;
            prop.SetValue(clone, prop.GetValue(source));
        }

        if (source.WBS != null)
            clone.WBS = source.WBS.ToDictionary(k => k.Key, v => v.Value);

        return clone;
    }

    private async Task OnSubstituteItemClick()
    {
        _showItemsContextMenu = false;
        if (gItems == null || mReadOnly) return;
        var selected = gItems.GetSelectedRecords().ToList();
        if (selected.Count == 0) { Notifications.Info("Select one or more rows to substitute."); return; }

        // VB6: mcITEM_SUBSTITUE — opens FPickList with item query, then replaces
        //   Phase, Item, Description, TakeoffUOM, ConversionFactor, OrderUOM,
        //   POIndex, POIndexDescription, Notes, CostCode/Desc, Category/Desc
        //   on all selected rows with the chosen item.
        var sql = @"SELECT isnull(phase,'')+char(1)+isnull(item,'') phaseitem
              ,i.Phase
              ,i.Item
              ,i.Description
              ,i.TakeoffUOM
              ,i.ConversionFactor
              ,i.OrderUOM
              ,p.POIndex,i.PartNumber
              ,p.FullDescription POIndexDescription
              ,i.Notes
              ,i.JCCostCode CostCode
              ,cod.description CostCodeDesc
              ,i.JCCategory Category
              ,cat.Description CategoryDesc
          FROM tblPhaseItem i
          LEFT OUTER JOIN StandardCostCodes cod ON(i.DivisionID = cod.DivisionID and i.jccostcode=cod.costcode)
          LEFT OUTER JOIN StandardCategories cat ON(i.DivisionID = cat.DivisionID and i.jccategory=cat.category)
          LEFT OUTER JOIN tblPOIndex p ON(i.DivisionID = p.DivisionID and i.poindex=p.poindex)
          WHERE i.DivisionID = " + SessionState.DivisionID;

        // VB6: defaultItem = Phase + Chr(1) + Item of current row
        var currentRow = selected[0];
        var defaultItem = currentRow.Phase + "\x01" + currentRow.Item;

        _pickListContext = "SubstituteItem";
        if (pickList != null)
        {
            await pickList.Open(
                title: "Item",
                queries: sql,
                defaultItem: defaultItem,
                hideColumns: "phaseitem,TakeoffUOM,ConversionFactor,OrderUOM,POIndex,Notes,CostCodeDesc,CategoryDesc",
                multiSelect: false);
        }
    }

    // ── Components grid: Add / Remove ─────────────────────────────────
    // VB6 backing table: tblDBAssemblyComponents(ParentAssemblyID,
    //   ComponentAssemblyID, Qty) — PK (ParentAssemblyID, ComponentAssemblyID).
    // VB6 surfaced the same "add child assembly" / "remove child" actions
    // through a right-click menu on gComponents (FAssembly.frm:41 —
    // "Support add/remove component rows via context menu with right-click").
    // FPickList is the canonical picker for any assembly-id-returning
    // action in the migrated app, so we use it here too (mirrors
    // OnOpenClick / OnItemChartAdd).

    private async Task OnAddComponentClick()
    {
        _showComponentsContextMenu = false;
        if (mReadOnly) return;
        // HHM-581: VB6 mnuAssemblyComponentsSub_Click / mcCOMP_ADD
        // (FAssembly.frm:2494-2528) opens the Component Assembly picker with
        // NO save-first requirement — a brand-new, never-saved assembly can
        // browse for components right away (mAssemblyID is simply 0 inside
        // the "cant add self" filter). Picks made before the first save are
        // staged in the grid (IsNew) and flushed by SaveData once the master
        // INSERT has produced an AssemblyID — the same deferred-write
        // pattern VB6 used for ALL component edits.
        if (mAssemblyID != 0)
        {
            // Persist any pending edits before launching the picker — matches
            // the SaveData-first pattern used by OnOpenClick / OnCopyAssembly.
            if (!await SaveData(true)) return;
        }
        if (pickList == null) return;

        // VB6 mnuAssemblyComponentsSub_Click mcCOMP_ADD (FAssembly.frm:2504-2528):
        // AssemblyTypeDesc leads the visible columns, division-scoped, inactive
        // excluded, self excluded, the candidate pool narrowed by the CURRENT
        // assembly's type, and assemblies that are themselves parents excluded
        // ("cant add other parents as components" — no nesting). The PK
        // uniqueness constraint catches duplicates at INSERT time; we surface
        // that as a friendly notification rather than letting the SQL error
        // bubble.
        var typeFilter = mAssemblyType switch
        {
            AssemblyTypes.atModel => "AND m.assemblytype IN (0,2,3,4) -- if 0-model can be anything",
            AssemblyTypes.atoption => "AND m.assemblytype IN (2,3,4)   -- if 2-opt can not be model",
            AssemblyTypes.atGlobal or AssemblyTypes.atDesignCenter
                => "AND m.assemblytype IN (3,4)     -- if 3,4-global,dc opt can only be global,dc option",
            _ => ""
        };
        var sql = $@"
            SELECT m.AssemblyTypeDesc AS AssemblyType,
                   m.Community,
                   m.Assembly,
                   m.AssemblyID,
                   m.Model,
                   m.OptionID,
                   m.Description
              FROM tbldbassemblymaster m
              LEFT OUTER JOIN tbldbassemblycomponents c ON m.assemblyid = c.parentassemblyid
             WHERE m.divisionid = @DivisionID
               AND ISNULL(m.inactive, 0) = 0
               AND m.assemblyid <> @Self --cant add self as component
               {typeFilter}
               --cant add other parents as components; NOTE: FPickList appends
               --its default sort (first column ASC) on the SAME line, so this must not end in a comment
               AND c.parentassemblyid IS NULL";

        // FPickList.Open treats the queries string as raw SQL when no '|'
        // is present (single-view shortcut, line 251-254 in FPickList.razor).
        // Passing "ViewName;SQL" here would get glued together as one SQL
        // statement and fail — drop the view-name prefix.
        _pickListContext = "AddComponent";
        await pickList.Open(
            title: "Component Assembly",
            queries: sql,
            hideColumns: "assemblyid",
            multiSelect: true,
            parameters: new Dictionary<string, object>
            {
                ["DivisionID"] = SessionState.DivisionID,
                ["Self"] = mAssemblyID
            });
    }

    private async Task OnRemoveComponentClick()
    {
        _showComponentsContextMenu = false;
        if (mReadOnly) return;
        if (gComponents == null) return;

        var selected = gComponents.GetSelectedRecords().ToList();
        if (selected.Count == 0)
        {
            Notifications.Info("Select one or more component rows first, then choose Remove Component.");
            return;
        }

        // Confirm — same MessageBoxControl pattern used elsewhere in the
        // form for destructive operations.
        var word = selected.Count == 1 ? "component" : $"{selected.Count} components";
        var confirm = _messageBox != null
            ? await _messageBox.ShowAsync(
                $"Remove the selected {word} from this assembly?",
                title: "Remove component?",
                buttons: MessageBoxButtons.YesNo)
            : (await Dialogs.ConfirmAsync($"Remove the selected {word} from this assembly?")
                ? MessageBoxResult.Yes
                : MessageBoxResult.No);
        if (confirm != MessageBoxResult.Yes) return;

        // HHM-581: staged (not-yet-saved) components — the parent assembly
        // has no ID yet, so there's nothing in tblDBAssemblyComponents to
        // DELETE. Drop the picked rows from the in-memory grid, exactly like
        // VB6 hiding a new gComponents row (mcCOMP_REMOVE on a RowData="new"
        // row never reaches SQL).
        if (mAssemblyID == 0)
        {
            int removedStaged = 0;
            foreach (var row in selected)
            {
                // Match by component AssemblyId (unique in the staged list —
                // the add path dedupes on it) so this works even if the grid
                // hands back cloned records rather than the bound instances.
                removedStaged += ComponentsData.RemoveAll(
                    c => ReferenceEquals(c, row) || (row.AssemblyId != 0 && c.AssemblyId == row.AssemblyId));
            }
            RecalculateComponentCost();
            RecalculateCosts();
            if (removedStaged > 0) mDirty = true;
            if (gComponents != null) await gComponents.Refresh();
            await InvokeAsync(StateHasChanged);
            Notifications.Success($"Removed {removedStaged} component{(removedStaged == 1 ? "" : "s")}.");
            return;
        }

        try
        {
            int deleted = 0;
            foreach (var row in selected)
            {
                if (row.AssemblyId == 0) continue;
                deleted += await db.ExecuteAsync(
                    "DELETE FROM tblDBAssemblyComponents WHERE ParentAssemblyID = @Parent AND ComponentAssemblyID = @Child",
                    new { Parent = mAssemblyID, Child = row.AssemblyId });
            }
            await LoadComponentsGridAsync();
            // LoadComponentsGridAsync recomputes ComponentCost from the
            // reloaded rows, but doesn't push the new value into the
            // ComponentCostLabel / TotalCostLabel — that's RecalculateCosts'
            // job. Without this call the totals card stays frozen at the
            // pre-remove value even though the grid no longer shows the
            // deleted rows. Mirrors the AddComponent path above.
            RecalculateCosts();
            // mDirty for the same reason as AddComponent — light up Save
            // so the user sees state changed even though the DELETE was
            // already persisted.
            if (deleted > 0) mDirty = true;
            await InvokeAsync(StateHasChanged);
            Notifications.Success($"Removed {deleted} component{(deleted == 1 ? "" : "s")}.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Remove component failed");
            Notifications.Error($"Remove component failed: {ex.Message}");
        }
    }

