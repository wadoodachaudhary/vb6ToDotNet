        => _itemsGrid.GetOrdered();

    /// <summary>Schema fed to the GridControl's "Choose Columns" dialog so it
    /// can list every column from the saved layout — including the ones marked
    /// Hidden that GetOrderedItemsGridLayout() filters out at render time.
    /// Returning null falls back to the rendered &lt;GridColumn&gt; children.</summary>
    private IEnumerable<ChooseColumnDescriptor>? GetItemsGridChooseColumnsSchema()
        => _itemsGrid.GetChooseColumnsSchema();

    /// <summary>The char(1)/uid='' factory-default layout as a Choose Columns
    /// schema — feeds the dialog's "Restore Default Layout" button (VB6
    /// RestoreDefaultLayout). Full template (NOT caption-filtered) so EVERY
    /// dialog column finds its default verdict on restore. Null when no default
    /// template exists, in which case FlexKit's safety-net restores the full
    /// AvailableColumns set instead of truncating to the visible columns.</summary>
    private IEnumerable<ChooseColumnDescriptor>? GetItemsGridDefaultColumnsSchema()
    {
        if (ItemsDefaultLayout.Count == 0) return null;
        return ItemsDefaultLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field))
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .Select(c => new ChooseColumnDescriptor
            {
                Field = ResolveItemsGridField(c.Field),
                Header = string.IsNullOrWhiteSpace(c.Caption) ? c.Field : c.Caption,
                Visible = !c.Hidden
            })
            .ToList();
    }

    /// <summary>Applies the user's Choose Columns picks to the saved layout
    /// and forces a grid re-render. Two host-specific rules layered on top
    /// of the dialog's plain visibility flip:
    /// <list type="number">
    ///   <item><description>
    ///     <b>Apply the dialog order.</b> The dialog returns columns in the
    ///     user's working order, so assign <c>ColIndex</c> from that sequence.
    ///     Otherwise Move Up / Move Down appears to work inside the dialog but
    ///     the rendered grid falls back to the old AppGridLayout order, and a
    ///     newly-shown column lands at its previous slot.
    ///   </description></item>
    ///   <item><description>
    ///     <b>"Total" column always sits last.</b> Regardless of whatever
    ///     ColIndex was stored or where the dialog placed Total, force it
    ///     to <c>max(ColIndex) + 1</c> so it stays as the rightmost column —
    ///     matches the legacy VB6 FAssembly layout where Total is the final
    ///     row-total readout.
    ///   </description></item>
    /// </list>
    /// </summary>
    private async Task OnItemsColumnsChosenAsync(ChooseColumnsResult result)
    {
        if (!HasItemsGridLayout || result?.Columns == null) return;
        var layoutByField = ItemsGridLayout.Values
            .GroupBy(c => ResolveItemsGridField(c.Field), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        // (1) Apply visibility and order from the dialog snapshot.
        var order = 0;
        foreach (var picked in result.Columns)
        {
            if (!layoutByField.TryGetValue(picked.Field, out var layout)) continue;
            layout.Hidden = !picked.Visible;
            layout.ColIndex = order++;
        }

        // (2) Pin Total to the right edge. Use the current max ColIndex
        //     across ALL layout entries (visible + hidden) +1 so Total
        //     ends up beyond every other column regardless of what the
        //     dialog reordered. Done after (1) so visibility-only changes
        //     have already settled.
        if (layoutByField.TryGetValue("Total", out var totalLayout))
        {
            var maxColIndex = ItemsGridLayout.Values
                .Where(c => !string.IsNullOrEmpty(c.Field) && !string.Equals(c.Field, totalLayout.Field, StringComparison.OrdinalIgnoreCase))
                .Select(c => c.ColIndex ?? 0)
                .DefaultIfEmpty(0)
                .Max();
            totalLayout.ColIndex = maxColIndex + 1;
        }

        _itemsGrid.BumpVersion();
        StateHasChanged();
        await PersistItemsGridLayoutAsync();
    }

    /// <summary>Subscribed to GridControl's <c>OnLayoutChanged</c> — fires for
    /// every user mutation other than Choose Columns (resize, drag-reorder
    /// header, group/ungroup, hide via header menu, rename via header menu).
    /// Delegated to the shared <see cref="GridLayoutPersister"/> so every grid
    /// across the system uses the same merge-and-save path.</summary>
    private async Task OnItemsLayoutChangedAsync(GridSettings snapshot)
    {
        if (!HasItemsGridLayout || snapshot == null) return;

        await GridLayoutPersister.MergeAndSaveAsync(
            GridLayoutSvc, "FAssembly", "gItems", instanceKey: null,
            ItemsGridLayout, snapshot, ResolveItemsGridField);

        _gridLayoutDirty = true;
        _itemsGrid.BumpVersion();
        ItemsGridGroupColumns = BuildItemsGridGroupColumns();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PersistItemsGridLayoutAsync()
    {
        try
        {
            await _itemsGrid.SaveAsync(GridLayoutSvc);
            _gridLayoutDirty = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist FAssembly gItems layout");
        }
    }

    private List<string> BuildItemsGridGroupColumns()
        => HasItemsGridLayout
            ? _itemsGrid.GroupedFields()
            : (GroupedColumns?.ToList() ?? new List<string>());

    private static string ResolveItemsGroupHeaderText(string field, string key, IReadOnlyList<AssemblyItemRow> rows)
    {
        if (!string.Equals(field, nameof(AssemblyItemRow.POIndex), StringComparison.OrdinalIgnoreCase))
            return key;

        if (string.IsNullOrWhiteSpace(key) || string.Equals(key, "(empty)", StringComparison.OrdinalIgnoreCase))
            return key;

        var description = rows.FirstOrDefault(r => string.Equals(r.POIndex, key, StringComparison.OrdinalIgnoreCase))
            ?.POIndexDescription?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(description) || string.Equals(description, key, StringComparison.OrdinalIgnoreCase))
            return key;

        // HHM-189: POIndexDescription is tblPOIndex.FullDescription = "code description" (code-prefixed,
        // MDBUpgrade3.bas:54308), and VB6's SubTotal "%s" caption echoes exactly that grouped cell text
        // (FAssembly.frm:4741) — so return it alone; prefixing the key again rendered "10 10 Lumber".
        return description;
    }

