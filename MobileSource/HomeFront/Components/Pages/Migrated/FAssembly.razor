    private async Task OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        if (selectedRows.Count == 0)
        {
            var context = _pickListContext;
            _poIndexPickRow = null;
            _vendorPickRow = null;
            _vendorPickField = "";
            _pickListContext = "";
            await ResumeItemsGridAfterPickListAsync(context);
            return;
        }

        if (_pickListContext == "POIndex")
        {
            if (_poIndexPickRow != null && selectedRows.Count > 0)
            {
                var picked = selectedRows[0];
                var id = GetRowString(picked, "ID");
                var desc = GetRowString(picked, "POIndex");

                // Fan out across the multi-selection so picking a POIndex for
                // one row applies to every selected row — matches the OrderQty /
                // Vendor / Notes / Formula / Invertable mass-edit pattern. If
                // the user clicked the … button on a row that isn't currently
                // selected, fall back to that single row.
                var targets = (gItems?.GetSelectedRecords().ToList() ?? new List<AssemblyItemRow>());
                if (targets.Count == 0 || !targets.Contains(_poIndexPickRow))
                    targets = new List<AssemblyItemRow> { _poIndexPickRow };

                foreach (var t in targets)
                {
                    t.POIndex = id;
                    t.POIndexDescription = desc;
                    if (t.RowStatus == "") t.RowStatus = "update";
                }
                mDirty = true;
                if (gItems != null) await gItems.Refresh();
            }
            _poIndexPickRow = null;
            _pickListContext = "";
            await ResumeItemsGridKeyboardNavigationAsync();
            return;
        }

        if (_pickListContext == "Vendor")
        {
            // VB6: gItems_CellButtonClick Vendor/VendorDesc cases both set
            // BOTH .Vendor (vendor_id) and .VendorDesc (Vendor_name) across
            // the entire selection range, then call RefreshVendorPrice +
            // gItems_AfterEdit. We replicate the dual-field update; the
            // refresh-price step is a future hook (FRefreshVendorPrice
            // isn't ported yet — calling it here would be a NotifyImplemented).
            if (_vendorPickRow != null && selectedRows.Count > 0)
            {
                var picked = selectedRows[0];
                // Result columns vary by which cell launched the pick:
                //   Vendor cell    → SELECT Vendor_name Company, vendor_id Vendor
                //   VendorDesc cell → SELECT Vendor_name Vendor, vendor_id
                // Normalize so both paths end up with a vendor-id + display.
                string vendorId;
                string vendorDesc;
                if (_vendorPickField.Equals("Vendor", StringComparison.OrdinalIgnoreCase))
                {
                    vendorId = GetRowString(picked, "Vendor");
                    vendorDesc = GetRowString(picked, "Company");
                }
                else
                {
                    vendorId = GetRowString(picked, "vendor_id");
                    vendorDesc = GetRowString(picked, "Vendor");
                }

                var targets = (gItems?.GetSelectedRecords().ToList() ?? new List<AssemblyItemRow>());
                if (targets.Count == 0 || !targets.Contains(_vendorPickRow))
                    targets = new List<AssemblyItemRow> { _vendorPickRow };

                foreach (var t in targets)
                {
                    t.Vendor = vendorId;
                    t.VendorDesc = vendorDesc;
                    if (t.RowStatus == "") t.RowStatus = "update";
                }

                // VB6 next calls RefreshVendorPrice(Row, Col): look up the
                // picked vendor's rate via dbo.Purch_GetItemRate + the rate
                // quality, then write back Price / PriceLevel / ItemType /
                // TaxAmount / PretaxAmount / ExtendedAmount for every row in
                // the selection range. Port follows below.
                await RefreshVendorPriceAsync(targets);

                mDirty = true;
                RecalculateCosts();
                if (gItems != null) await gItems.Refresh();
            }
            _vendorPickRow = null;
            _vendorPickField = "";
            _pickListContext = "";
            await ResumeItemsGridKeyboardNavigationAsync();
            return;
        }

        if (_pickListContext == "ItemChart" && selectedRows.Count > 0)
        {
            // VB6: For i = 1 To FPickList.SelectedItems
            //   .TextMatrix(.Rows-1, .ColIndex("ItemChart")) = FPickList.SelectedItem("name", i)
            //   .TextMatrix(.Rows-1, .ColIndex("formula")) = FPickList.SelectedItem("formula", i)
            //   .TextMatrix(.Rows-1, .ColIndex("ItemConversionFactor")) = 1
            //   .TextMatrix(.Rows-1, .ColIndex("TakeoffQty")) = 1
            //   .TextMatrix(.Rows-1, .ColIndex("OrderQty")) = 1
            mReadOnly = false;
            mDirty = true;

            foreach (var row in selectedRows)
            {
                var chartName = row.ContainsKey("name") ? row["name"]?.ToString() ?? "" : "";
                var formula = row.ContainsKey("formula") ? row["formula"]?.ToString() ?? "" : "";

                ItemsData.Add(new AssemblyItemRow
                {
                    ItemChart = chartName,
                    Formula = formula,
                    ItemConversionFactor = 1,
                    TakeoffQty = 1,
                    OrderQty = 1,
                    RowStatus = "new"
                });
            }

            RecalculateCosts();
            if (gItems != null) await gItems.Refresh();
            _pickListContext = "";
            await ResumeItemsGridKeyboardNavigationAsync();
            return;
        }

        if ((_pickListContext == "OpenAssembly" || _pickListContext == "OpenAssemblyOptions") && selectedRows.Count > 0)
        {
            var row = selectedRows[0];
            var selectedView = (pickList?.SelectedViewIndex ?? 0) + 1;

            ApplyAssemblySelectionFromRow(row, selectedView);

            if (_pickListContext == "OpenAssembly" && selectedView == 2)
            {
                var modelId = GetRowString(row, "modelid");
                if (string.IsNullOrWhiteSpace(modelId))
                    modelId = GetRowString(row, "ModelID");

                if (!string.IsNullOrWhiteSpace(modelId) && pickList != null)
                {
                    _pickListContext = "OpenAssemblyOptions";
                    _openPickListModel = modelId;

                    await pickList.Open(
                        title: BuildAssemblyOpenPickListTitle(),
                        queries: BuildAssemblyOptionsPickListQuery(modelId),
                        hideColumns: BuildAssemblyPickListHideColumns(),
                        multiSelect: false,
                        defaultView: 0,
                        autoSelectFirstRowWhenNoDefault: true);
                    return;
                }
            }

            if (_pickListContext == "OpenAssemblyOptions" && string.IsNullOrWhiteSpace(mModel) && !string.IsNullOrWhiteSpace(_openPickListModel))
                mModel = _openPickListModel;

            // HHM-612: loading another assembly from the Open picklist must
            // FULLY reset any pending Copy-of-current snapshot — the user
            // already declined (or saved) it at the SaveData(true) gate in
            // OnOpenClick. mCopiedOption/mCopiedKey previously lingered.
            mCopiedCommunity = "";
            mCopiedAssembly = "";
            mCopiedModel = "";
            mCopiedOption = "";
            mCopiedKey = "";
            mCopiedAssemblyID = 0;
            await FinalizeOpenSelectionAsync();
            _pickListContext = "";
            return;
        }

        if (_pickListContext == "AddComponent" && selectedRows.Count > 0)
        {
            if (mAssemblyID == 0)
            {
                // HHM-581: the assembly hasn't been saved yet, so there's no
                // ParentAssemblyID to INSERT against. Stage the picks in the
                // grid the way VB6 staged new gComponents rows (RowData="new",
                // FAssembly.frm:2528-2538) and let SaveData flush them once
                // the master INSERT has produced mAssemblyID.
                int stagedCount = 0, alreadyStaged = 0;
                foreach (var pick in selectedRows)
                {
                    if (!long.TryParse(GetRowString(pick, "assemblyid"), out var stagedId)) continue;
                    if (stagedId == 0) continue;
                    if (ComponentsData.Any(c => c.AssemblyId == stagedId)) { alreadyStaged++; continue; }
                    ComponentsData.Add(new AssemblyComponentRow
                    {
                        IsNew = true,
                        AssemblyId = stagedId,
                        Community = GetRowString(pick, "community"),
                        Model = GetRowString(pick, "model"),
                        Option = GetRowString(pick, "optionid"),
                        Assembly = GetRowString(pick, "assembly"),
                        Description = GetRowString(pick, "description"),
                        Qty = 1
                    });
                    stagedCount++;
                }
                if (stagedCount > 0) mDirty = true;
                RecalculateComponentCost();
                RecalculateCosts();
                if (gComponents != null) await gComponents.Refresh();
                await InvokeAsync(StateHasChanged);
                if (stagedCount > 0)
                    Notifications.Success($"Added {stagedCount} component{(stagedCount == 1 ? "" : "s")} — saved with the assembly.");
                else if (alreadyStaged > 0)
                    Notifications.Info($"All {alreadyStaged} selected component{(alreadyStaged == 1 ? " is" : "s are")} already in the list.");
                _pickListContext = "";
                return;
            }

            // Each picked row → one INSERT into tblDBAssemblyComponents.
            // Duplicates (same parent+child already exist) are silently
            // skipped via the WHERE-NOT-EXISTS guard so a multi-select
            // pick that overlaps existing children doesn't blow up on the
            // PK constraint. Qty defaults to 1 (matches VB6 behavior —
            // the user adjusts qty in the grid afterward).
            int inserted = 0;
            int skipped = 0;
            try
            {
                foreach (var pick in selectedRows)
                {
                    // GetRowString: the picklist rows are ExpandoObjects whose
                    // keys are CASE-SENSITIVE, and the VB6-faithful query
                    // selects m.AssemblyID (not lowercase).
                    if (!long.TryParse(GetRowString(pick, "assemblyid"), out var componentId)) continue;
                    if (componentId == 0 || componentId == mAssemblyID) continue;

                    var affected = await db.ExecuteAsync(@"
                        INSERT INTO tblDBAssemblyComponents (ParentAssemblyID, ComponentAssemblyID, Qty)
                        SELECT @Parent, @Child, 1
                         WHERE NOT EXISTS (
                            SELECT 1 FROM tblDBAssemblyComponents
                             WHERE ParentAssemblyID = @Parent
                               AND ComponentAssemblyID = @Child)",
                        new { Parent = mAssemblyID, Child = componentId });
                    if (affected > 0)
                    {
                        inserted++;
                        // VB6 appends the pick at the BOTTOM of gComponents and
                        // leaves it there — Cost blank — until the next full load
                        // (FAssembly.frm:2530-2540; no reload after add or save).
                        // A reload here would re-sort the new row into its
                        // assemblyid position mid-session.
                        if (!ComponentsData.Any(c => c.AssemblyId == componentId))
                            ComponentsData.Add(new AssemblyComponentRow
                            {
                                AssemblyId = componentId,
                                Community = GetRowString(pick, "community"),
                                Model = GetRowString(pick, "model"),
                                Option = GetRowString(pick, "optionid"),
                                Assembly = GetRowString(pick, "assembly"),
                                Description = GetRowString(pick, "description"),
                                Qty = 1
                            });
                    }
                    else skipped++;
                }
                RecalculateComponentCost();
                RecalculateCosts();
                if (gComponents != null) await gComponents.Refresh();
                // mDirty=true even though the INSERT already hit the DB:
                // signals to the user that the form's state changed (Save
                // button lights up) and keeps the close-without-save guard
                // armed in case they have other pending header / Items
                // edits they haven't saved yet. Save's existing components
                // path is a no-op on rows that didn't change, so flipping
                // dirty here is harmless if they click Save right away.
                if (inserted > 0) mDirty = true;
                await InvokeAsync(StateHasChanged);
                if (inserted > 0)
                    Notifications.Success($"Added {inserted} component{(inserted == 1 ? "" : "s")}" +
                                          (skipped > 0 ? $" ({skipped} already present, skipped)." : "."));
                else if (skipped > 0)
                    Notifications.Info($"All {skipped} selected component{(skipped == 1 ? " is" : "s are")} already attached.");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Add component failed");
                Notifications.Error($"Add component failed: {ex.Message}");
            }
            _pickListContext = "";
            return;
        }

        if (_pickListContext == "SubstituteItem" && selectedRows.Count > 0)
        {
            // VB6: mcITEM_SUBSTITUE — replace Phase/Item/Description and related fields
            //   on all selected rows with the chosen item from FPickList
            var pick = selectedRows[0];
            var newPhase = GetRowString(pick, "Phase");
            var newItem = GetRowString(pick, "Item");
            var newDescription = GetRowString(pick, "Description");
            var newTakeoffUOM = GetRowString(pick, "TakeoffUOM");
            var newConvFactor = ToDouble(pick.ContainsKey("ConversionFactor") ? pick["ConversionFactor"] : 0);
            var newOrderUOM = GetRowString(pick, "OrderUOM");
            var newPOIndex = GetRowString(pick, "POIndex");
            var newPOIndexDesc = GetRowString(pick, "POIndexDescription");
            var newNotes = GetRowString(pick, "Notes");
            var newCostCode = GetRowString(pick, "CostCode");
            var newCostCodeDesc = GetRowString(pick, "CostCodeDesc");
            var newCategory = GetRowString(pick, "Category");
            var newCategoryDesc = GetRowString(pick, "CategoryDesc");

            if (gItems != null)
            {
                var selected = gItems.GetSelectedRecords().ToList();
                foreach (var row in selected)
                {
                    row.Phase = newPhase;
                    row.Item = newItem;
                    row.Description = newDescription;
                    row.TakeoffUOM = newTakeoffUOM;
                    row.ItemConversionFactor = newConvFactor;
                    row.OrderUOM = newOrderUOM;
                    row.POIndex = newPOIndex;
                    row.POIndexDescription = newPOIndexDesc;
                    row.Notes = newNotes;
                    row.JCCostCode = newCostCode;
                    row.JCCostCodeDesc = newCostCodeDesc;
                    row.JCCategory = newCategory;
                    row.JCCategoryDesc = newCategoryDesc;
                    if (row.RowStatus == "") row.RowStatus = "update";
                    // VB6: Call gItems_AfterEdit(.Row, .ColIndex("TakeoffQty"))
                    RecalculateAfterEdit(row, "TakeoffQty");
                }
            }

            mDirty = true;
            RecalculateCosts();
            if (gItems != null) await gItems.Refresh();
            _pickListContext = "";
            await ResumeItemsGridKeyboardNavigationAsync();
            return;
        }

        _pickListContext = "";
    }

    private async Task OnPickPOIndex(AssemblyItemRow row)
    {
        if (pickList == null) return;
        _poIndexPickRow = row;
        _pickListContext = "POIndex";
        // FPickList.Open takes raw SQL (no parameter-bag overload). SessionState.DivisionID
        // is an int, so interpolating it carries no string-injection vector.
        var divisionId = SessionState.DivisionID;
        var sql = $"SELECT POIndex ID, FullDescription POIndex FROM tblPOIndex WHERE DivisionID = {divisionId}";
        await pickList.Open(
            title: "Purchase Order",
            queries: sql,
            hideColumns: "ID",
            multiSelect: false);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── gItems edit-button dispatch fallback ───────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    /// <summary>Routes any GridControl standard edit-button click to the same
    /// popup handlers used by the explicit cell templates. Kept as a fallback
    /// for layout/customization paths; the normal FAssembly Notes/Formula/
    /// Vendor cells no longer use AlwaysShowEditButton.</summary>
    private async Task OnGridEditButtonClick(CellEditButtonArgs<AssemblyItemRow> args)
    {
        if (args.Data == null) return;
        var field = args.ColumnName ?? "";
        if (field.Equals("Notes", StringComparison.OrdinalIgnoreCase)
            || field.Equals("Formula", StringComparison.OrdinalIgnoreCase))
        {
            await OnOpenMultiLineEditor(args.Data, field);
        }
        else if (field.Equals("Vendor", StringComparison.OrdinalIgnoreCase)
                 || field.Equals("VendorDesc", StringComparison.OrdinalIgnoreCase))
        {
            await OnPickVendor(args.Data, field);
        }
        else if (field.Equals("POIndex", StringComparison.OrdinalIgnoreCase))
        {
            await OnPickPOIndex(args.Data);
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── Notes / Formula popup editor (VB6: ComboList = "|...") ────────────
    // ═══════════════════════════════════════════════════════════════════════
    /// <summary>"…" button on a Notes / Formula cell opens the multi-line
    /// editor with the row's current value. If the user clicks OK the new
    /// value is fanned out across every multi-selected row (matching the
    /// VB6 .Cell(flexcpText, .Row, Col, .RowSel, Col) = ... behavior in
    /// gItems_CellButtonClick).</summary>
    private async Task OnOpenMultiLineEditor(AssemblyItemRow row, string field)
    {
        // Notes → VB6 FComments popup (bare textarea, X commits, Esc cancels —
        // HHM-152/159/161); commit continues in OnNotesDialogCommit.
        if (field.Equals("Notes", StringComparison.OrdinalIgnoreCase))
        {
            _notesDialogRow = row;
            _notesDialogText = row.Notes ?? "";
            _showNotesDialog = true;
            StateHasChanged();
            return;
        }
        // Formula → VB6 FFormulaEditor (HHM-211) real formula editor, not the
        // bare textarea. OnAccepted fires as a deferred callback, so capture the
        // multi-select fan-out target set at open time.
        _formulaTargets = gItems?.GetSelectedRecords().ToList() ?? new List<AssemblyItemRow>();
        if (_formulaTargets.Count == 0 || !_formulaTargets.Contains(row))
            _formulaTargets = new List<AssemblyItemRow> { row };
        if (_formulaEditor != null)
            await _formulaEditor.Open("", row.Formula ?? "");
    }

    // Deferred callback from FFormulaEditor OK — fan the accepted formula out
    // across the captured multi-selection (matches VB6 Min/Max-row fan-out).
    private async Task OnFormulaAccepted(string text)
    {
        foreach (var t in _formulaTargets)
        {
            t.Formula = text ?? "";
            if (t.RowStatus == "") t.RowStatus = "update";
        }
        mDirty = true;
        RecalculateCosts();
        StateHasChanged();
        if (gItems != null) await gItems.Refresh();
        await ResumeItemsGridKeyboardNavigationAsync();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── Vendor / VendorDesc pick (VB6: FPickList over tblvendors) ─────────
    // ═══════════════════════════════════════════════════════════════════════
    /// <summary>Opens FPickList against tblvendors. Both Vendor and
    /// VendorDesc columns funnel here — the only difference is which
    /// column the user clicked, which we record so the SELECT can list
    /// the relevant column first (cosmetic) and the callback can update
    /// both fields together as VB6 does.</summary>
    private async Task OnPickVendor(AssemblyItemRow row, string field)
    {
        if (mReadOnly || string.IsNullOrEmpty(PricingCommunity)) return;
        if (pickList == null) return;
        _vendorPickRow = row;
        _vendorPickField = field;
        _pickListContext = "Vendor";
        // FPickList.Open takes raw SQL (no parameter-bag overload); SessionState.DivisionID
        // is an int, so interpolating it is injection-safe.
        var sql = field.Equals("Vendor", StringComparison.OrdinalIgnoreCase)
            ? $"SELECT Vendor_name Company, vendor_id Vendor FROM tblvendors WHERE DivisionID = {SessionState.DivisionID} AND ISNULL(inactive,0)=0"
            : $"SELECT Vendor_name Vendor, vendor_id FROM tblvendors WHERE DivisionID = {SessionState.DivisionID} AND ISNULL(inactive,0)=0";
        await pickList.Open(
            title: "Vendor",
            queries: sql,
            hideColumns: field.Equals("Vendor", StringComparison.OrdinalIgnoreCase) ? "" : "vendor_id",
            multiSelect: false);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── PriceLevel inline select ──────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    /// <summary>Builds the VB6 PriceLevel dropdown options for a given row.
    /// Mirrors gItems_BeforeEdit's PriceLevel case logic: the option set
    /// varies by Vendor presence, ItemType (Quote vs Unit Price), and
    /// whether PricingCommunityPhase is set.</summary>
    private IEnumerable<string> GetPriceLevelOptions(AssemblyItemRow row)
    {
        // Vendor blank → only "Item DB" is offered (per VB6 .ComboList = "#4;Item DB"
        // — the "#4" prefix in VSFlexGrid forces the dropdown to a single fixed
        // option). We surface plain "Item DB".
        if (string.IsNullOrWhiteSpace(row.Vendor))
        {
            yield return "Item DB";
            yield break;
        }

        var communityWord = CommunityTerm; // injected from CD_Community (FMain)
        var isQuote = string.Equals(row.ItemType, "Quote", StringComparison.OrdinalIgnoreCase);
        var hasPhase = !string.IsNullOrWhiteSpace(PricingCommunityPhase);

        if (!isQuote)
        {
            yield return "Corporate (any Division)";
        }
        yield return $"Global (any {communityWord})";
        yield return "Item DB";
        yield return $"{communityWord} Specific";
        if (hasPhase)
            yield return "Phase Specific";
    }

    private IEnumerable<string> GetPriceLevelEditOptions(object row) =>
        row is AssemblyItemRow item ? GetPriceLevelOptions(item) : Enumerable.Empty<string>();

    // ═══════════════════════════════════════════════════════════════════════
    // ── Invertable checkbox (per-row gate from VB6) ───────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    /// <summary>Per-row Invertable toggle. VB6 gates this on
    /// HasInverseItem == 1 — when that's false the cell is not even
    /// editable. The template renders a checkbox only for eligible rows;
    /// this handler propagates the new state to every selected row
    /// (mirroring the multi-row fan-out used elsewhere).</summary>
    private async Task OnInvertableChanged(AssemblyItemRow row, ChangeEventArgs e)
    {
        var newVal = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        await OnInvertableChanged(row, newVal);
    }

    private async Task OnInvertableChanged(AssemblyItemRow row, bool newVal)
    {
        var targets = (gItems?.GetSelectedRecords().ToList() ?? new List<AssemblyItemRow>());
        if (targets.Count == 0 || !targets.Contains(row))
            targets = new List<AssemblyItemRow> { row };

        foreach (var t in targets)
        {
            // Only flip on rows that pass the VB6 gate. Eligible rows
            // accept the change; ineligible rows in the multi-selection
            // stay as-is — matches "Cancel = True" per row in VB6.
            if (t.HasInverseItem == 1)
            {
                t.Invertable = newVal;
                if (t.RowStatus == "") t.RowStatus = "update";
            }
        }
        mDirty = true;
        RecalculateCosts();
        if (gItems != null) await gItems.Refresh();
    }

    private (string Title, string Queries, string HideColumns, int DefaultView) BuildAssemblyOpenPickListConfig()
    {
        var title = BuildAssemblyOpenPickListTitle();
        var isCommercial = string.Equals(
            AppOptions.TryGetValue("BuilderType", out var builderType) ? builderType : "",
            "Commercial",
            StringComparison.OrdinalIgnoreCase);

        var views = BuildAssemblyPickListViews(isCommercial);
        var queries = BuildPickListQueries(views);
        var hideColumns = BuildAssemblyPickListHideColumns();
        var defaultView = GetDefaultOpenPickListViewIndex();

        return (title, queries, hideColumns, defaultView);
    }

    private string BuildAssemblyOpenPickListTitle()
    {
        var builderType = AppOptions.TryGetValue("BuilderType", out var val) ? val : "";
        return string.Equals(builderType, "Commercial", StringComparison.OrdinalIgnoreCase) ? "Assemblies" : "Model and Option";
    }

    private static string BuildPickListQueries(IEnumerable<(string Name, string Sql)> views) =>
        string.Join("|", views.Select(v => $"{v.Name};{v.Sql}"));

    private string BuildAssemblyPickListHideColumns()
    {
        var hide = new List<string> { "areaid", "modelid", "optionid", "assemblytype", "Source" };
        if (AppOptions.TryGetValue("HideElevation", out var hideElevation) &&
            string.Equals(hideElevation, "True", StringComparison.OrdinalIgnoreCase))
        {
            hide.Add("Elevation");
        }
        return string.Join(",", hide);
    }

    private int GetDefaultOpenPickListViewIndex()
    {
        var view = mAssemblyType switch
        {
            AssemblyTypes.atModel => 1,
            AssemblyTypes.atoption => 2,
            AssemblyTypes.atGlobal => 4,
            AssemblyTypes.atDesignCenter => 3,
            AssemblyTypes.atCustomOption => 2,
            _ => 1
        };
        return Math.Max(0, view - 1);
    }

