    private async Task OnExportPricelist()
    {
        // VB6 FAssembly.frm:4342 ExportPriceList. This is the hidden
        // gExportData SaveGrid path, not the standalone vendor export wizard.
        if (!await SaveData(false)) return;

        // VB6 goes STRAIGHT to the Save dialog (frm:4351 VBGetSaveFileName) — the
        // Quotes-Only / All-Items choice lived in that dialog's "Save as type"
        // filter, which browser save pickers can't express. The interim Yes/No
        // prompt read as an unmapped workflow (HHM-258); export the ALL-ITEMS
        // superset (quotes included) and open the save picker directly.
        var quotesOnly = false;

        try
        {
            var exportTable = BuildPricelistExportTable(quotesOnly);
            if (exportTable.Rows.Count == 0)
            {
                Notifications.Info("No pricelist rows found to export.");
                return;
            }

            var fileName = BuildPricelistExportFileName(quotesOnly);
            var export = GridExporter.Export(exportTable, GridExportFormat.Xlsx, fileName);
            var result = await GridExporter.SaveAsync(JSRuntime, export);

            if (result == "cancelled")
                Notifications.Info("PriceList export cancelled.");
            else if (result == "unavailable")
                Notifications.Error("PriceList export could not open the file save dialog.");
            else
                Notifications.Success("PriceList exported.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Export PriceList failed");
            Notifications.Error($"Could not export PriceList: {ex.Message}");
        }
    }

    private GridExportTable BuildPricelistExportTable(bool quotesOnly)
    {
        var currentCommunity = (CommunityValue ?? mCommunity).Trim();
        var currentModel = (ModelValue ?? mModel).Trim();
        var currentOption = (OptionValue ?? mOptionID).Trim();
        var currentAssembly = (AssemblyCode ?? mAssembly).Trim();
        var vendorCommunity = !string.IsNullOrWhiteSpace(mPricingCommunity)
            ? mPricingCommunity.Trim()
            : currentCommunity;

        var dt = db.SqlExec(BuildPricelistExportSql(quotesOnly), new
        {
            SessionState.DivisionID,
            Community = currentCommunity,
            Assembly = currentAssembly,
            Model = currentModel,
            OptionID = currentOption,
            VendorCommunity = vendorCommunity
        });

        var table = new GridExportTable
        {
            Title = "PriceList",
            SheetName = "PriceList",
            IncludeHeaderRow = false
        };

        var headers = new[]
        {
            "Community", "Phase", "Community Name", "Model", "Specification",
            "Assembly Description", "Group", "Item", "Item Description",
            "Part Number", "UOM", "Price"
        };

        var widths = new[] { 14d, 8d, 22d, 16d, 16d, 28d, 10d, 10d, 30d, 16d, 9d, 10d };
        for (var i = 0; i < headers.Length; i++)
            table.Columns.Add(new GridExportColumn(headers[i], textAlign: i == 11 ? TextAlign.Right : TextAlign.Left, width: widths[i]));

        // VB6 colors Part Number and Price pale yellow in the hidden export grid.
        table.HighlightColumnIndexes.Add(9);
        table.HighlightColumnIndexes.Add(11);

        var vendor = "\u0001";
        foreach (DataRow row in dt.Rows)
        {
            var rowVendor = GetExportString(row, "Vendor");
            if (!string.Equals(vendor, rowVendor, StringComparison.Ordinal))
            {
                vendor = rowVendor;
                table.Rows.Add(new GridExportRow(Array.Empty<object?>()));
                table.Rows.Add(new GridExportRow(Array.Empty<object?>()));
                table.Rows.Add(new GridExportRow(new object?[] { "Vendor", rowVendor }, isBold: true));
                table.Rows.Add(new GridExportRow(new object?[] { "Company Name", GetExportString(row, "VendorDesc"), GetExportString(row, "POIndex") }, isBold: true));
                table.Rows.Add(new GridExportRow(headers.Cast<object?>(), isBold: true));
            }

            table.Rows.Add(new GridExportRow(new[]
            {
                GetExportString(row, "Community"),
                GetExportString(row, "CommunityPhase"),
                GetExportString(row, "CommunityDesc"),
                GetExportString(row, "Model"),
                GetExportString(row, "Assembly"),
                GetExportString(row, "AssemblyDesc"),
                GetExportString(row, "Phase"),
                GetExportString(row, "Item"),
                GetExportString(row, "ItemDesc"),
                GetExportString(row, "PartNumber"),
                GetExportString(row, "OrderUOM"),
                row.Table.Columns.Contains("Price") && row["Price"] is not DBNull ? row["Price"] : 0
            }));
        }

        return table;
    }

    private static string BuildPricelistExportSql(bool quotesOnly)
    {
        var sql = new StringBuilder();
        sql.AppendLine("select");
        sql.AppendLine(" v.vendor_id Vendor");
        sql.AppendLine(",v.vendor_name VendorDesc");
        sql.AppendLine(",m.Community");
        sql.AppendLine(",'' CommunityPhase");
        sql.AppendLine(",l.Description CommunityDesc");
        sql.AppendLine(",m.Model");
        sql.AppendLine(",m.Assembly");
        sql.AppendLine(",m.Description AssemblyDesc");
        sql.AppendLine(",d.Phase");
        sql.AppendLine(",d.Item");
        sql.AppendLine(",i.POIndex");
        sql.AppendLine(",i.Description ItemDesc");
        sql.AppendLine(",'' PartNumber");
        sql.AppendLine(",i.OrderUOM");
        sql.AppendLine(",0 Price");
        sql.AppendLine("from tbldbassemblymaster m");
        sql.AppendLine("left outer join tbldbassemblydetails d on (m.DivisionID=d.DivisionID and m.assembly=d.assembly and m.community=d.community and m.model=d.model and m.optionid=d.optionid)");
        sql.AppendLine("left outer join tblphaseitem i on (d.DivisionID=i.DivisionID and d.phase=i.phase and d.item=i.item)");
        sql.AppendLine("left outer join tblvendors v on (v.DivisionID=@DivisionID and v.vendor_id=dbo.purch_getcommunityvendor(@VendorCommunity,i.poindex,@DivisionID))");
        sql.AppendLine("left outer join tbllocality l on (m.community=l.area)");
        sql.AppendLine("where m.Community=@Community");
        sql.AppendLine("  and m.Assembly=@Assembly");
        sql.AppendLine("  and m.model=@Model");
        sql.AppendLine("  and m.OptionID=@OptionID");
        sql.AppendLine("  and m.DivisionID=@DivisionID");
        if (quotesOnly)
            sql.AppendLine("  and i.isquote=1");
        sql.AppendLine("order by v.vendor_id,d.phase,d.item");
        return sql.ToString();
    }

    private string BuildPricelistExportFileName(bool quotesOnly)
    {
        var scope = quotesOnly ? "Quotes" : "AllItems";
        var model = (ModelValue ?? mModel ?? "Model").Trim();
        var assembly = (AssemblyCode ?? mAssembly ?? "Assembly").Trim();
        var raw = $"PriceList_{model}_{assembly}_{scope}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
        var invalid = Path.GetInvalidFileNameChars();
        return new string(raw.Select(ch => invalid.Contains(ch) ? '_' : ch).ToArray());
    }

    private static string GetExportString(DataRow row, string column)
    {
        if (!row.Table.Columns.Contains(column) || row[column] is DBNull)
            return "";
        return row[column]?.ToString() ?? "";
    }

