                            }
                            <tr><td class="fx-sumtip-lbl">Pretax:</td><td class="fx-sumtip-val">@_sumTipPretax.ToString("N2")</td></tr>
                            <tr><td class="fx-sumtip-lbl">Tax:</td><td class="fx-sumtip-val">@_sumTipTax.ToString("N2")</td></tr>
                            <tr><td class="fx-sumtip-lbl">Total:</td><td class="fx-sumtip-val">@_sumTipTotal.ToString("N2")</td></tr>
