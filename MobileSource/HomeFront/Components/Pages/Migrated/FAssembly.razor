    /// <summary>
    /// VB6 parity: FAssemblyWithPricing.frm mnuAssemblyNewSub_Click(mcNEW_COPYOF)
    /// at line 2218. Duplicates the currently-loaded assembly: enable the four
    /// key fields so the user can rename, stage every item as a fresh INSERT,
    /// remember the source identifiers for the post-save vendor-cost copy
    /// (SaveData reads mCopied* in the pricelist-clone branch — see VB6
    /// lines 1593-1622), and force mAssemblyID = 0 so SaveData enters its
    /// INSERT-master branch on the next click.
    ///
    /// What's intentionally NOT cleared: Description / Comments / Series /
    /// Style / dimensions / category / JCExtra / IsBaseAssembly /
    /// IncludedOption / DCSalesOnly / SelectByRoom / DisplayTotalOnly /
    /// Items grid — they ARE the things the user wants to duplicate. VB6
    /// keeps them all populated; the user only edits the four keys.
    ///
    /// What VB6 ALSO clears: mCommunity / mAssembly / mModel / mOptionID
    /// (line 2234-2237). The form's text controls keep showing the
    /// original values though — the user must change at least one before
    /// saving (validated in SaveData via mCopiedKey vs current-key
    /// comparison; "When copying an assembly you must change one of …").
    /// </summary>
    private async Task OnCopyAssembly()
    {
        if (mAssemblyID == 0) { Notifications.Info("No assembly is loaded to copy."); return; }
        // VB6 line 2215: If Not SaveData(True) Then Exit Sub
        if (!await SaveData(true)) return;

        // ── Source snapshot ─────────────────────────────────────────
        // Capture identifiers BEFORE clearing the backing fields. SaveData
        // reads these later to clone tblVendorCost rows into the new
        // assembly's key (and to detect "user hasn't actually changed
        // anything" in the validation block).
        mCopiedCommunity = mCommunity;
        mCopiedAssembly = mAssembly;
        mCopiedModel = mModel;
        mCopiedOption = mOptionID;
        // VB6 captures mCopiedAssemblyID = mAssemblyID here so SaveData can clone
        // the source's components + RoomQtyByModel after the new master INSERT.
        mCopiedAssemblyID = mAssemblyID;
        mCopiedKey = mCopiedCommunity + "\x01" + mCopiedAssembly + "\x01" + mCopiedModel + "\x01" + mCopiedOption;

        // ── VB6 line 2234-2237: clear the in-memory keys so SaveData
        //    sees an "empty assembly" and goes through INSERT path.
        //    The form-bound display fields (CommunityValue, AssemblyCode,
        //    ModelValue, OptionValue) keep their text so the user has
        //    something to differentiate from. ─────────────────────────
        mCommunity = "";
        mAssembly = "";
        mModel = "";
        mOptionID = "";
        // CRITICAL: reset the row id so SaveData's `if (mAssemblyID == 0)`
        // gate (line ~2566) fires the master INSERT. Without this, the
        // save path would UPDATE the original master and INSERT new rows
        // pointing at the OLD AssemblyID — silently corrupting both the
        // source and copy.
        mAssemblyID = 0;

        // ── VB6 line 2219-2228: enable the four key fields, then
        //    disable per assembly type. ──────────────────────────────
        _communityEnabled = true;
        _assemblyEnabled = true;
        _modelEnabled = true;
        _optionEnabled = true;
        switch (mAssemblyType)
        {
            case AssemblyTypes.atModel:
                _optionEnabled = false;     // Model has no Option
                break;
            case AssemblyTypes.atGlobal:
            case AssemblyTypes.atDesignCenter:
                _modelEnabled = false;      // Global / DC options have no Model
                break;
            // atOption and atCustomOption keep all four enabled.
        }

        // ── Stage every item as a fresh INSERT ─────────────────────
        // RowStatus="new" routes the row through BuildItemInsertSql in
        // SaveData. Sequence is also zeroed so SCOPE_IDENTITY() lands a
        // clean new identity (BuildItemInsertSql doesn't use Sequence
        // but resetting it keeps the in-memory model consistent — after
        // a successful copy, every item row should look like a brand-new
        // row that just got its DB id back).
        foreach (var item in ItemsData)
        {
            if (item.RowStatus == "delete") continue;
            item.RowStatus = "new";
            item.Sequence = 0;
        }

        // VB6 doesn't surface a separate notification; the user infers
        // from the now-editable key fields that they're in "make a
        // copy" mode. Show a one-shot info so .NET users get the same
        // mental model without having to read the toolbar state.
        Notifications.Info("Editing as a copy — change at least one of Community / Assembly / Model / Option, then Save.");

        mDirty = true;
        await InvokeAsync(StateHasChanged);
    }

