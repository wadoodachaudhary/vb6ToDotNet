    private string BuildTakeoffUrl(string takeoffMode)
    {
        // VB6: Call FTakeoff.Takeoff(Me, False, Mid(Button.Key, 8), 0, "",
        //       mAssemblyType, txtDescription.Text, PricingCommunity,
        //       PricingCommunityPhase, cboModel.Text, "", txtAssembly.Text, "")
        var qs = new Dictionary<string, string?>
        {
            ["mode"] = takeoffMode,
            ["isChangeOrder"] = "false",
            ["assemblyType"] = ((int)mAssemblyType).ToString(),
            ["description"] = Description ?? "",
            ["community"] = PricingCommunity ?? "",
            ["communityPhase"] = PricingCommunityPhase ?? "",
            ["model"] = ModelValue ?? mModel ?? "",
            ["optionID"] = mOptionID ?? "",
            ["assembly"] = AssemblyCode ?? mAssembly ?? ""
        };
        var queryString = string.Join("&", qs
            .Where(kv => kv.Value != null)
            .Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value!)}"));
        return $"/takeoff?{queryString}";
    }

