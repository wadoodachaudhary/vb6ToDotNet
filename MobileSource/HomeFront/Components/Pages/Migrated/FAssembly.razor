@* ─────────────────────────────────────────────────────────────────
   Organization: Hyphen / Innovatix Inc.
   Developer   : Wadood Chaudhary
   Date        : 2026-05-24
   Changes     :
     - VB6-parity Image field: real file picker with bevel/silvery "..." button
     - Header parity with VB6 (only Community/Model/Assembly bold, bottom-align right column)
     - ItemType / PriceLevel use standard FlexKit grid dropdown editing
     - Multi-select fan-out for ItemType, PriceLevel and POIndex changes
     - Choose Columns: pin Total to end and respect stored ColIndex
   ───────────────────────────────────────────────────────────────── *@
@namespace HomeFront.Components.Pages
@page "/edit-model-assembly"
@page "/edit-model-assembly/{Id}"
@layout HFComponent

@using HomeFront.Models
@using Fx.ControlKit
@using System.Data
@using System.Globalization
@using System.Reflection
@using System.Text

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDialogService Dialogs
@inject ILogger<FAssembly> Logger
@inject NotificationService Notifications
@using HomeFront.Data
@using HomeFront.Services
@inject IGridLayoutService GridLayoutSvc
@inject ISessionStateService SessionState
@inject DbWrapperSqlServer db

<PageTitle>Model & Option - HomeFront@(ItemsGridLayoutFallbackUsed ? " [gItems FALLBACK]" : "")</PageTitle>


<div class="tabs-container" @onkeydown="HandleKeyDown" tabindex="0">
    <div class="vb6-banner">
        This is not your live database. It should be used for testing and training only. If this is incorrect please contact Hyphen support to change the status of this database.
    </div>
    <div class="tab-content">
        @* ── TOOLBAR ─────────────────────────────────────────── *@
        <div class="toolbar-cntr">
                @* VB6 mnuAssemblyNew (FAssemblyWithPricing.frm:1349) — the
                   four item captions match the residential-builder wording
                   shown in VB6 ("Model" / "Model Specific Option" / "Global
                   Option" / "Design Center Option"), not the C-style enum names. *@
                <MenuDropDownControl Label="New"
                                     CssClass="fassembly-toolbar-menu fassembly-new-menu"
                                     SplitButton="true"
                                     SplitCssClass="tbar-split-btn"
                                     PrimaryCssClass="tbar-btn fassembly-new-btn-left"
                                     TriggerCssClass="tbar-split-arrow"
                                     PanelCssClass="dropdown-items">
                    <PrimaryContent>
                            <img src="images/32/new.ico" alt="New" onerror="this.style.display='none'" />
                            <span class="tool-label">New</span>
                    </PrimaryContent>
                    <ChildContent>
                        <MenuActionControl Text="Model" OnClick="@(() => OnNewAssembly(AssemblyTypes.atModel))" />
                        <MenuActionControl Text="Model Specific Option" OnClick="@(() => OnNewAssembly(AssemblyTypes.atoption))" />
                        <MenuActionControl Text="Global Option" OnClick="@(() => OnNewAssembly(AssemblyTypes.atGlobal))" />
                        <MenuActionControl Text="Design Center Option" OnClick="@(() => OnNewAssembly(AssemblyTypes.atDesignCenter))" />
                        <MenuSeparatorControl />
                        <MenuActionControl Text="Copy of Current" OnClick="OnCopyAssembly" />
                    </ChildContent>
                </MenuDropDownControl>

                <button class="tbar-btn" @onclick="OnOpenClick">
                    <img src="images/32/open.ico" alt="Open" onerror="this.style.display='none'" />
                    <span class="tool-label">Open</span>
                </button>
                <button class="tbar-btn" disabled="@(!CanSave)" @onclick="OnSaveClick">
                    <img src="images/32/save.ico" alt="Save" onerror="this.style.display='none'" />
                    <span class="tool-label">Save</span>
                </button>
                <div class="tbar-separator"></div>

                @* ── Takeoff Buttons (VB6: TakeoffOneTime, TakeoffItem, etc.) ── *@
                <button class="tbar-btn" disabled @onclick="OnTakeoffOneTime">
                    <img src="images/32/TakeoffOneTime.ico" alt="One Time" onerror="this.style.display='none'" />
                    <span class="tool-label">One Time</span>
                </button>
                <button class="tbar-btn" disabled="@mReadOnly" @onclick="OnTakeoffItem">
                    <img src="images/32/TakeoffItem.ico" alt="Item" onerror="this.style.display='none'" />
                    @* VB6 label was just "Item" — matches the legacy toolbar.
                       Earlier prototype said "Takeoff Item" which got moved to
                       the section-comment a few lines up. *@
                    <span class="tool-label">Item</span>
                </button>
                <button class="tbar-btn" disabled="@mReadOnly" @onclick="OnTakeoffAssembly">
                    <img src="images/32/TakeoffAssembly.ico" alt="Assembly" onerror="this.style.display='none'" />
                    <span class="tool-label">Assembly</span>
                </button>
                @if (ShowPlanSwift)
                {
                    <button class="tbar-btn" disabled="@mReadOnly" @onclick="OnTakeoffPlanSwift">
                        <img src="images/32/TakeoffPlanSwift.ico" alt="PlanSwift" onerror="this.style.display='none'" />
                        <span class="tool-label">PlanSwift</span>
                    </button>
                }
                @* HHM-236: VB6's Custom takeoff pops the OS file-open dialog
                   the moment the button is clicked (FTakeoff.frm:1706
                   VBGetOpenFileName) — the takeoff window only appears after
                   a file is chosen; cancel = nothing happens. A <label for>
                   bound to the hidden InputFile below opens the browser's
                   native file picker in ONE click (no JS interop);
                   OnCustomTakeoffFileSelected then reads the file and opens
                   FTakeoff in Custom mode with the file pre-loaded. @key
                   re-creates the input after each pick so choosing the same
                   file again still fires OnChange. The read-only branch keeps
                   the original disabled <button> so the greyed-out look stays
                   pixel-identical to the other toolbar buttons. *@
                @if (mReadOnly)
                {
                    <button class="tbar-btn" disabled>
                        <img src="images/32/TakeoffCustom.ico" alt="Custom" onerror="this.style.display='none'" />
                        <span class="tool-label">Custom</span>
                    </button>
                }
                else
                {
                    <InputFile @key="_customTakeoffInputKey"
                               id="@_customTakeoffInputId"
                               OnChange="OnCustomTakeoffFileSelected"
                               accept=".pee,.xls,.xlsx,.txt,.csv"
                               style="display:none" />
                    <label for="@_customTakeoffInputId"
                           class="tbar-btn"
                           role="button"
                           title="Custom"
                           style="margin:0; user-select:none;">
                        <img src="images/32/TakeoffCustom.ico" alt="Custom" onerror="this.style.display='none'" />
                        <span class="tool-label">Custom</span>
                    </label>
                }

                @* Item Chart split button (VB6: TakeoffItemChart, Style=5) — the MAIN
                   click runs the Add-Item-Chart picklist directly (frm:2704); the arrow
                   hosts the ONE ButtonMenu entry "Create/Edit Chart" (frm:189-193 +
                   Toolbar_ButtonMenuClick Else → FItemChart.Edit("")). HHM-243. *@
                <MenuDropDownControl Label="Item Chart"
                                     CssClass="fassembly-toolbar-menu"
                                     SplitButton="true"
                                     Disabled="@mReadOnly"
                                     SplitCssClass="tbar-split-btn"
                                     PrimaryCssClass="tbar-btn fassembly-new-btn-left"
                                     TriggerCssClass="tbar-split-arrow"
                                     PanelCssClass="dropdown-items"
                                     PrimaryClick="OnItemChartAdd">
                    <PrimaryContent>
                            <img src="images/32/ItemChart.ico" alt="Item Chart" onerror="this.style.display='none'" />
                            <span class="tool-label">Item Chart</span>
                    </PrimaryContent>
                    <ChildContent>
                        <MenuActionControl Text="Create/Edit Chart" OnClick="OnItemChartCreateEdit" />
                    </ChildContent>
                </MenuDropDownControl>
                <div class="tbar-separator"></div>

                @* Mass Change (VB6: MassChange) — never disabled; VB6 leaves
                   Toolbar.Buttons("MassChange") enabled even in read-only (HHM-97). *@
                <button class="tbar-btn" @onclick="OnMassChange">
                    <img src="images/32/MassChange.ico" alt="Change" onerror="this.style.display='none'" />
                    <span class="tool-label">Change</span>
                </button>
                <div class="tbar-separator"></div>
                @* VB6 FAssembly.frm:3789 Toolbar.Buttons("PricelistExport").Enabled = Not RHS (HHM-97). *@
                <button class="tbar-btn" disabled="@mReadOnly" @onclick="OnExportPricelist">
                    <img src="images/32/PricebookExport.ico" alt="PriceList" onerror="this.style.display='none'" />
                    <span class="tool-label">PriceList</span>
                </button>
                @if (ShowImportButton)
                {
                    <MenuDropDownControl Label="Import"
                                         CssClass="fassembly-toolbar-menu"
                                         SplitButton="true"
                                         SplitCssClass="tbar-split-btn"
                                         PrimaryCssClass="tbar-btn fassembly-new-btn-left"
                                         TriggerCssClass="tbar-split-arrow"
                                         PanelCssClass="dropdown-items">
                        <PrimaryContent>
                            <span class="tool-label">Import</span>
                        </PrimaryContent>
                        <ChildContent>
                            <MenuActionControl Text="Models and Options" OnClick="OnImportModels" />
                            <MenuActionControl Text="Global Options" OnClick="OnImportGlobals" />
                        </ChildContent>
                    </MenuDropDownControl>
                }
            </div>

            @* ── HEADER FIELDS (4-column layout: Assembly info / Model details /
                 Totals card / Checkboxes + Show-pricing) ── *@
            <div style="display: inline-grid; grid-template-columns: auto auto auto auto; gap: 0 12px; margin-bottom: 0; align-items: start;">

                @* ── LEFT COLUMN — Assembly Info ────────────────────── *@
                <div class="panel-section" style="min-width: 280px; max-width: 360px;">
                    @* fx-strong: VB6 FAssembly only bolds these three labels
                       (Community / Model / Assembly). All others stay normal
                       weight. The class flips local CSS in FAssembly.razor.css
                       — see the .form-field.fx-strong label rule. *@
                    <div class="form-field fx-strong">
                        <label>@CommunityTerm</label>
                        <DropDownListControl TValue="string" TItem="ComboBoxItem"
                                             Value="@CommunityValue"
                                             ValueChanged="OnCommunityDropdownChanged"
                                             DataSource="@CommunityItems"
                                             TextFieldName="Text"
                                             ValueFieldName="Value"
                                             Placeholder="@($"Select {CommunityTerm}")"
                                             Enabled="@_communityEnabled" />
                    </div>
                    @if (mAssemblyType == AssemblyTypes.atModel || mAssemblyType == AssemblyTypes.atoption)
                    {
                        <div class="form-field fx-strong">
                            <label>Model</label>
                            @* VB6 cboModel style is per-type (FAssembly.frm:2780-2781): a plain
                               free-text combo (vbComboDropdown) for atModel — a NEW model's code
                               is TYPED here — but forced vbComboDropdownList for atoption, where
                               the option must attach to an existing model picked from the list.
                               HHM-617 / HHM-612: Editable is ALSO gated on _modelEnabled. The
                               editable variant caches its input text and does not re-sync it
                               from Value while the control is disabled, so a model loaded via
                               the Open picklist (which leaves the combo disabled, mDataSource=0)
                               rendered blank — or kept showing the PREVIOUS model after a
                               Copy-of-current was discarded and another model opened. While
                               disabled the user can't type anyway, so rendering the
                               non-editable variant (whose text is computed live from Value)
                               loses nothing and always shows the loaded model. *@
                            <DropDownListControl TValue="string" TItem="ComboBoxItem"
                                                 Value="@ModelValue"
                                                 ValueChanged="OnModelDropdownChanged"
                                                 DataSource="@ModelItems"
                                                 TextFieldName="Text"
                                                 ValueFieldName="Value"
                                                 Editable="@(mAssemblyType == AssemblyTypes.atModel && _modelEnabled)"
                                                 MaxLength="@MasterColLen("Model")"
                                                 OpenOnArrowClickOnly="@(mAssemblyType == AssemblyTypes.atModel)"
                                                 Placeholder="@(mAssemblyType == AssemblyTypes.atModel ? "Model" : "Select Model")"
                                                 Enabled="@_modelEnabled" />
                        </div>
                    }
                    @if (mAssemblyType != AssemblyTypes.atModel)
                    {
                        <div class="form-field">
                            <label>Option</label>
                            <TextBoxControl @bind-Value="OptionValue" @bind-Value:after="OnOptionChanged"
                                            MaxLength="@MasterColLen("OptionID")"
                                            Enabled="@_optionEnabled"
                                            CssClass="hf-asm-field" />
                        </div>
                    }
                    <div class="form-field fx-strong">
                        <label>Assembly</label>
                        <div style="flex: 1; display: flex; align-items: center; gap: 6px; min-width: 0;">
                            <TextBoxControl @bind-Value="AssemblyCode" @bind-Value:after="MarkDirty"
                                            MaxLength="@(MasterColLen("Assembly") ?? 20)"
                                            Enabled="@_assemblyEnabled"
                                            CssClass="hf-asm-field hf-asm-flex-field" />
                            @* HHM-107: box-left order via CheckBoxControl's own Label (VB6 chkActive). *@
                            <CheckBoxControl @bind-Checked="IsActive" @bind-Checked:after="MarkDirty"
                                             Disabled="@mReadOnly" Label="Active"
                                             CssClass="hf-asm-checkbox hf-asm-checkbox-tight" />
                        </div>
                    </div>
                    <div class="form-field">
                        <label>Description</label>
                        <TextBoxControl @bind-Value="Description" @bind-Value:after="MarkDirty"
                                        MaxLength="@(MasterColLen("Description") ?? 200)"
                                        Enabled="@(!mReadOnly)"
                                        CssClass="hf-asm-field" />
                    </div>
                    <div class="form-field">
                        <label>Image</label>
                        <div style="flex: 1; display: flex; align-items: center; gap: 4px; min-width: 0;">
                            <TextBoxControl @bind-Value="GraphicPath" @bind-Value:after="MarkDirty"
                                            Enabled="@(!mReadOnly)"
                                            CssClass="hf-asm-field hf-asm-flex-field" />
                            @* Hidden Blazor InputFile + a <label for=…> styled
                               as a Win95-style silvery bevel button. Clicking
                               the label triggers the OS file picker; OnChange
                               lands in OnImageFileSelected. Browser sandbox
                               only exposes File.Name (not the full local path
                               VB6 stored), so we store the file name in
                               GraphicPath — a future upload-to-server step
                               can wrap the same handler. _imageInputId keeps
                               the for/id pair unique per FAssembly instance
                               (multiple tabs open simultaneously). *@
                            <InputFile id="@_imageInputId"
                                       OnChange="OnImageFileSelected"
                                       style="display:none" />
                            <label for="@_imageInputId"
                                   class="fx-bevel-btn @(mReadOnly ? "is-disabled" : "")"
                                   title="Browse for image…"
                                   aria-label="Browse for image">…</label>
                        </div>
                    </div>
                    <div class="form-field">
                        <label>Comments</label>
                        <TextAreaControl @bind-Value="Comments" @bind-Value:after="MarkDirty"
                                         MaxLength="@MasterColLen("Comments")"
                                         Rows="1"
                                         Enabled="@(!mReadOnly)"
                                         UseClassicContextMenu="true"
                                         CssClass="hf-asm-textarea hf-asm-comments" />
                    </div>
                </div>

                @* ── MIDDLE COLUMN — Model/Option details ────────────
                   For Model (atModel) the column is a single stack capped
                   at 340px. For the Option/Custom/DC branch we widen the
                   cap so the new inner two-column flex (form fields +
                   side-column checkboxes) has room without wrapping. *@
                <div class="panel-section" style="min-width: 260px; max-width: @(mAssemblyType == AssemblyTypes.atModel ? "340px" : "520px");">
                    @if (mAssemblyType == AssemblyTypes.atModel)
                    {
                        <div class="form-field">
                            <label>Series</label>
                            <DropDownListControl TValue="string" TItem="ComboBoxItem"
                                                 Value="@SeriesValue"
                                                 ValueChanged="OnSeriesDropdownChanged"
                                                 DataSource="@SeriesItems"
                                                 TextFieldName="Text"
                                                 ValueFieldName="Value"
                                                 Placeholder="Select Series"
                                                 Enabled="@(!mReadOnly)" />
                        </div>
                        <div class="form-field hf-asm-short-field">
                            <label>Elevation</label>
                            <TextBoxControl @bind-Value="Elevation" @bind-Value:after="MarkDirty"
                                            MaxLength="20"
                                            Enabled="@(!mReadOnly)"
                                            CssClass="hf-asm-field" />
                        </div>
                        <div class="form-field hf-asm-short-field">
                            <label>Style</label>
                            @if (ShowStyleCombo)
                            {
                                <DropDownListControl TValue="string" TItem="ComboBoxItem"
                                                     Value="@StyleValue"
                                                     ValueChanged="OnStyleDropdownChanged"
                                                     DataSource="@StyleItems"
                                                     TextFieldName="Text"
                                                     ValueFieldName="Value"
                                                     Enabled="@(!mReadOnly)" />
                            }
                            else
                            {
                                <TextBoxControl @bind-Value="StyleText" @bind-Value:after="MarkDirty"
                                                MaxLength="30"
                                                Enabled="@(!mReadOnly)"
                                                CssClass="hf-asm-field" />
                            }
                        </div>
                        <div class="form-field">
                            <label>Sched Tmpl</label>
                            <DropDownListControl TValue="string" TItem="string"
                                                 Value="@ScheduleTemplateValue"
                                                 ValueChanged="OnScheduleTemplateDropdownChanged"
                                                 DataSource="@ScheduleTemplateItems"
                                                 Placeholder="Schedule Template"
                                                 Enabled="@(!mReadOnly)" />
                        </div>
                        <div class="form-field">
                            <label>Bds/Bths/SqFt</label>
                            <div class="input-group-inline">
                                @* HHM-111: VB6 txtBedrooms/txtBathrooms/txtFloorArea (and
                                   txtMaxWidth/txtMaxLength below) are plain TextBoxes that
                                   LoadData BLANKS for a new model (FAssembly.frm:2811-2825
                                   txtMaxWidth.Text = "" … txtBedrooms.Text = "") — a NEW
                                   model shows EMPTY fields, not 0. NumericTextBoxControl
                                   (TValue=double) can never render a blank (an unconstrained
                                   TValue? erases to plain double), so these five fields bind
                                   TextBoxControl to Val()-style string wrappers over the
                                   nullable backing fields (null ⇄ ""; junk → 0 like VB6
                                   Val(), see BedroomsText/ParseHeaderNumber). Bathrooms is
                                   fractional (2.5) — DB float, VB6 Val() (frm:2905-2907). *@
                                <TextBoxControl @bind-Value="BedroomsText"
                                                Enabled="@(!mReadOnly)"
                                                CssClass="hf-asm-number" />
                                <TextBoxControl @bind-Value="BathroomsText"
                                                Enabled="@(!mReadOnly)"
                                                CssClass="hf-asm-number" />
                                <TextBoxControl @bind-Value="FloorAreaText"
                                                Enabled="@(!mReadOnly)"
                                                CssClass="hf-asm-number hf-asm-sqft" />
                            </div>
                        </div>
                        <div class="form-field">
                            <label>Width/Length</label>
                            <div class="input-group-inline">
                                <TextBoxControl @bind-Value="MaxWidthText"
                                                Enabled="@(!mReadOnly)"
                                                CssClass="hf-asm-number" />
                                <TextBoxControl @bind-Value="MaxLengthText"
                                                Enabled="@(!mReadOnly)"
                                                CssClass="hf-asm-number" />
                            </div>
                        </div>
                        <div class="form-field">
                            <label>Spec Doc</label>
                            @* VB6 cmdSpecDocBrowse opened CommonDialog (FAssembly.frm).
                               Replicate with a hidden <InputFile> + label-for-styled
                               bevel button, same pattern as the Image row above.
                               Browser sandbox only exposes File.Name; we store that
                               in SpecDocument (no full local path like VB6 had). *@
                            <div style="flex: 1; display: flex; align-items: center; gap: 4px; min-width: 0;">
                                <TextBoxControl @bind-Value="SpecDocument" @bind-Value:after="MarkDirty"
                                                Enabled="@(!mReadOnly)"
                                                CssClass="hf-asm-field hf-asm-flex-field" />
                                <InputFile id="@_specDocInputId"
                                           OnChange="OnSpecDocFileSelected"
                                           style="display:none" />
                                <label for="@_specDocInputId"
                                       class="fx-bevel-btn @(mReadOnly ? "is-disabled" : "")"
                                       title="Browse for spec document…"
                                       aria-label="Browse for spec document">…</label>
                            </div>
                        </div>
                        <div class="form-field" style="display:none;">
                            <label>Const Cutoff</label>
                            <NumericTextBoxControl TValue="double"
                                                   Value="@(ConstCutoff ?? 0.0)"
                                                   ValueChanged="OnConstCutoffChanged"
                                                   Min="@(0m)"
                                                   Width="70px"
                                                   Enabled="@(!mReadOnly)"
                                                   CssClass="hf-asm-number" />
                        </div>
                        <div style="margin-left: 84px; margin-top: 2px;">
                            <a href="javascript:void(0)" @onclick="OnEditDimensionsClick" @onclick:preventDefault="true"
                               style="color: #00009c; text-decoration: underline; font-size: 10px; cursor: pointer;">
                                Edit Dimensions...
                            </a>
                        </div>
                    }
                    else
                    {
                        @* VB6 keeps frmOptionFields two compact rows below the top
                           of the header, level with Assembly. Model-specific options
                           use those rows for Series/Elevation; Global and Design
                           Center options retain the same space. *@
                        @if (mAssemblyType == AssemblyTypes.atoption)
                        {
                            <div class="form-field">
                                <label>Series</label>
                                <DropDownListControl TValue="string" TItem="ComboBoxItem"
                                                     Value="@SeriesValue"
                                                     ValueChanged="OnSeriesDropdownChanged"
                                                     DataSource="@SeriesItems"
                                                     TextFieldName="Text"
                                                     ValueFieldName="Value"
                                                     Placeholder="Select Series"
                                                     Width="220px"
                                                     Enabled="@(!mReadOnly)" />
                            </div>
                            <div class="form-field">
                                <label>Elevation</label>
                                <TextBoxControl @bind-Value="Elevation" @bind-Value:after="MarkDirty"
                                                MaxLength="20"
                                                Enabled="@(!mReadOnly)"
                                                CssClass="hf-asm-field hf-asm-option-elevation" />
                            </div>
                        }
                        else
                        {
                            <div class="hf-asm-option-alignment-spacer" aria-hidden="true"></div>
                        }

                        <div class="hf-asm-option-fields-frame">
                            <div class="hf-asm-option-fields">
                                <div class="form-field">
                                    @* VB6 FAssembly.frm:2458/2448 — Cat / Sub Cat
                                       split into TWO clickable links. lblGroup_Click
                                       ("Cat") opens FDBGrid on OptionCategories;
                                       lblCategory_Click ("Sub Cat") opens FDBGrid on
                                       OptionSubcategories. *@
                                    <label>
                                        <a href="javascript:void(0)" class="fx-fld-link" @onclick='() => OpenLookupPopup("Option Categories")'>Cat</a>
                                        <span> / </span>
                                        <a href="javascript:void(0)" class="fx-fld-link" @onclick='() => OpenLookupPopup("Option Subcategories")'>Sub Cat</a>
                                    </label>
                                    <DropDownListControl TValue="string" TItem="ComboBoxItem"
                                                         Value="@CategoryValue"
                                                         ValueChanged="OnCategoryDropdownChanged"
                                                         DataSource="@CategoryItems"
                                                         TextFieldName="Text"
                                                         ValueFieldName="Value"
                                                         Placeholder="Select Category"
                                                         Width="220px"
                                                         Enabled="@(!mReadOnly)" />
                                </div>
                                <div class="form-field">
                                    <label>JC Extra</label>
                                    <TextBoxControl @bind-Value="JCExtra" @bind-Value:after="MarkDirty"
                                                    Enabled="@(!mReadOnly)"
                                                    CssClass="hf-asm-field hf-asm-jc-extra" />
                                </div>
                                <div class="form-field">
                                    @* HHM-593: VB6 FAssembly.frm:781 has ONE
                                       "Qty/UOM" labelled row — txtQty (frm:642)
                                       and cboUOM (frm:669) sit side by side
                                       after the single combined label. The web
                                       had split them into two rows. *@
                                    <label>Qty/UOM</label>
                                    <div class="input-group-inline">
                                        <NumericTextBoxControl TValue="double"
                                                               Value="@AssemblyQty"
                                                               ValueChanged="OnAssemblyQtyChanged"
                                                               Min="@(0m)"
                                                               Width="50px"
                                                               Enabled="@(!mReadOnly)"
                                                               CssClass="hf-asm-number" />
                                        <DropDownListControl TValue="string" TItem="string"
                                                             Value="@UOMValue"
                                                             ValueChanged="OnUomDropdownChanged"
                                                             DataSource="@UomOptions"
                                                             Placeholder="Select UOM"
                                                             Width="120px"
                                                             Enabled="@(!mReadOnly)" />
                                    </div>
                                </div>
                                <div class="form-field">
                                    <label>Const Cutoff</label>
                                    <NumericTextBoxControl TValue="double"
                                                           Value="@(ConstCutoff ?? 0.0)"
                                                           ValueChanged="OnConstCutoffChanged"
                                                           Min="@(0m)"
                                                           Width="36px"
                                                           Enabled="@(!mReadOnly)"
                                                           CssClass="hf-asm-number hf-asm-const-cutoff" />
                                </div>
                                <div class="form-field">
                                    @* VB6 FAssembly.frm:2463 lblLocation_Click — opens
                                       FDBGrid on tblareas under the "Room Locations" caption. *@
                                    <label>
                                        <a href="javascript:void(0)" class="fx-fld-link" @onclick='() => OpenLookupPopup("Room Locations")'>Location</a>
                                    </label>
                                    <DropDownListControl TValue="string" TItem="ComboBoxItem"
                                                         Value="@LocationValue"
                                                         ValueChanged="OnLocationDropdownChanged"
                                                         DataSource="@LocationItems"
                                                         TextFieldName="Text"
                                                         ValueFieldName="Value"
                                                         Placeholder="Select Location"
                                                         Width="190px"
                                                         Enabled="@(!mReadOnly)" />
                                </div>
                                @* VB6 FAssembly.frm:836 lblMoreAttributes — blue
                                   underlined link under the Cat/UOM/Qty/Location
                                   stack that opens FAssemblyAttributes.EditAttributes. *@
                                <div class="checkbox-row" style="margin-left: 84px; margin-top: 4px;">
                                    <a href="javascript:void(0)" class="fx-fld-link" @onclick="OpenMoreAttributes">More Attributes…</a>
                                </div>
                            </div>

                            @* ── Sub-column B: 4 option checkboxes ─────────────
                               Narrow side column so the middle panel stays the
                               height of its form fields (~7 rows) instead of
                               stretching to ~13. Matches the legacy layout
                               where these four checkboxes sit in their own
                               narrow column to the right of the form fields. *@
                            <div class="hf-asm-option-checkboxes">
                                <div class="checkbox-row">
                                    <CheckBoxControl @bind-Checked="IsIncludedOption" @bind-Checked:after="MarkDirty"
                                                     Label="Included Option"
                                                     Disabled="@mReadOnly"
                                                     CssClass="hf-asm-checkbox" />
                                </div>
                                <div class="checkbox-row">
                                    <CheckBoxControl @bind-Checked="IsDCSalesOnly" @bind-Checked:after="MarkDirty"
                                                     Label="DC Sales Only"
                                                     Disabled="@mReadOnly"
                                                     CssClass="hf-asm-checkbox" />
                                </div>
                                <div class="checkbox-row">
                                    <CheckBoxControl @bind-Checked="IsSelectByRoom" @bind-Checked:after="MarkDirty"
                                                     Label="Select By Room"
                                                     Disabled="@mReadOnly"
                                                     CssClass="hf-asm-checkbox" />
                                </div>
                                <div class="checkbox-row">
                                    <CheckBoxControl @bind-Checked="IsDisplayTotalOnly" @bind-Checked:after="MarkDirty"
                                                     Label="Display Total Only"
                                                     Disabled="@mReadOnly"
                                                     CssClass="hf-asm-checkbox" />
                                </div>
                            </div>
                        </div>
                    }
                    <div class="form-field" style="display:none;">
                        <label>Billing Factor</label>
                        <NumericTextBoxControl TValue="double"
                                               Value="@BillingFactor"
                                               ValueChanged="OnBillingFactorChanged"
                                               Step="@(0.01m)"
                                               Width="70px"
                                               Enabled="@(!mReadOnly)"
                                               CssClass="hf-asm-number" />
                    </div>
                </div>

                @* ── COLUMN 3 — Estimator Notes (top) + checkboxes / pricing
                                  (bottom) ──────────────────────────────────
                   align-self:stretch + flex-column lets the Estimator Notes
                   textarea sit at the top while margin-top:auto on the
                   bottom block keeps the original VB6-parity bottom-aligned
                   pricing/checkbox stack. Notes is bound to the existing
                   assembly-level Notes column (tblDBAssemblyMaster.Notes —
                   already in SELECT / INSERT / UPDATE); the textarea only
                   renders when the form is NOT showing an atModel layout,
                   mirroring VB6 frmEstimatorNotes.Visible behavior. *@
                <div class="panel-section" style="align-self: stretch; padding-left: 4px; display: flex; flex-direction: column; min-width: 240px;">
                    @if (mAssemblyType != AssemblyTypes.atModel)
                    {
                        <div class="form-field hf-asm-estimator-notes">
                            <label>Estimator Notes</label>
                            <TextAreaControl @bind-Value="Notes" @bind-Value:after="MarkDirty"
                                             Rows="4"
                                             Enabled="@(!mReadOnly)"
                                             CssClass="hf-asm-textarea hf-asm-notes" />
                        </div>
                    }
                    <div style="margin-top: auto;">
                    <div class="checkbox-row">
                        <CheckBoxControl @bind-Checked="IsTakeoffRequired" @bind-Checked:after="MarkDirty"
                                         Label="Takeoff is required on every sale."
                                         Disabled="@mReadOnly"
                                         CssClass="hf-asm-checkbox" />
                    </div>
                    <div class="checkbox-row">
                        <CheckBoxControl @bind-Checked="UseNormalSalesQtyFactors" @bind-Checked:after="MarkDirty"
                                         Label="Use normal sales quantity factors."
                                         Disabled="@mReadOnly"
                                         CssClass="hf-asm-checkbox" />
                    </div>
                    <div class="checkbox-row">
                        <CheckBoxControl @bind-Checked="IsBaseAssembly" @bind-Checked:after="MarkDirty"
                                         Label="Base assembly. Not published to sales."
                                         Disabled="@mReadOnly"
                                         CssClass="hf-asm-checkbox" />
                    </div>
                    <div style="margin-top: 2px;">
                        @* VB6 lblAssemblyCost(1): a RED running total next to "Show pricing
                           for" whenever components are OFF (frm:1853-1856 toggles index 1 =
                           Not mComponentsEnabled; index 0 is the Totals-card copy when they
                           are ON). Filled from AssemblyCost = Σ line totals (frm:3068,
                           3081-3082) — here AssemblyCostLabel, kept fresh by LoadData +
                           RecalculateCosts, blank until a pricing community is picked (VB6
                           sets it only inside `If PricingCommunity <> ""`). #C00000 =
                           ForeColor &H000000C0&. Layout per owner 2026-07-28: the label +
                           value sit on their OWN LINE ABOVE the community dropdown (not
                           beside it) — and because this stack is bottom-anchored
                           (margin-top:auto on the wrapper), the extra line lifts the three
                           checkboxes one row higher, reclaiming the old side-by-side row. *@
                        <div style="font-size: 10px; font-weight: 600; margin-bottom: 3px;">
                            <span>Show pricing for</span>
                            @if (!ShowComponentsGrid && !string.IsNullOrEmpty(AssemblyCostLabel))
                            {
                                <span style="color:#C00000; margin-left: 10px;">@AssemblyCostLabel</span>
                            }
                        </div>
                        @* Controlled select bound to the raw encoded option
                             value (Community + (char)2 + Phase). When the C# side
                             resets it to "", the dropdown returns to the blank
                             "Select…" option. *@
                        <DropDownListControl TValue="string" TItem="CommunityItem"
                                             Value="@_pricingCommunitySelectedValue"
                                             ValueChanged="OnPriceCommunityDropdownChanged"
                                             DataSource="@PricingCommunities"
                                             TextFieldName="PricingCommunityPhase"
                                             ValueFieldName="PricingCommunity"
                                             Placeholder="@($"Select {CommunityTerm.ToLower()}")"
                                             Width="280px"
                                             Enabled="@(!mReadOnly)" />
                    </div>
                    </div> @* close bottom-aligned wrapper (margin-top:auto) *@
                </div>

                @* ── COLUMN 4 — Totals card (only when Components grid is visible) *@
                @* Treats the three lines as a group: shown together when
                     ShowComponentsGrid is true, hidden otherwise. Sits in its
                     own column for separation. *@
                <div class="panel-section" style="align-self: start; padding: 4px 8px; min-width: 200px;">
                    @if (ShowComponentsGrid)
                    {
                        <div class="cost-summary">
                            <div class="cost-row">
                                <span class="cost-label">Assembly Cost:</span>
                                <span class="cost-val">@AssemblyCostLabel</span>
                            </div>
                            <div class="cost-row">
                                <span class="cost-label">Component Cost:</span>
                                <span class="cost-val">@ComponentCostLabel</span>
                            </div>
                            <div class="cost-row">
                                <span class="cost-label">Total Cost:</span>
                                <span class="cost-val">@TotalCostLabel</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* ── COMPONENTS GRID (above Items grid, VB6 parity) ───── *@
            @* Hidden by default; shown when the assembly is a top-level
                 model/option that uses components (LoadComponentsGridAsync
                 evaluates !isChildComponent && mUseComponents). *@
            @if (ShowComponentsGrid)
            {
                @* VB6 parity: the Components grid is a narrow strip that
                   doesn't span the full form width — see the FAssembly
                   screenshot. We constrain to ~80% of viewport so the
                   right side of the form (totals card / pricing panel)
                   stays usable. The h5 header and the grid share the
                   same max-width so the heading lines up with the grid. *@
                @* Surface the fallback like the gItems marker in <PageTitle> —
                   hardcoded columns mean the AppGridLayout lookup came back
                   empty, which should be diagnosed, not silently papered over. *@
                <h5 class="assembly-components-heading">Components@(HasComponentsGridLayout ? "" : " [gComponents FALLBACK]")</h5>
                <div class="assembly-components-grid" @oncontextmenu="OnComponentsContextMenu" @oncontextmenu:preventDefault="true">
                    @* Components grid: behaves like the Items grid (multi-
                       select fan-out, batch edit, dirty tracking, cost
                       rollup) WITHOUT the toolbar / advanced-view chrome.
                       Resizing + reordering stay on. EventsRef wires the
                       OnCellSave / OnTypeAheadCommit / OnCellEdit triad
                       so edits actually flow back into ComponentCost +
                       mDirty — see OnComponentsCellSave in @code.
                       Header right-click shows the column menu ONLY while the
                       grid has data rows; on an empty grid the header event
                       falls through to OnComponentsContextMenu (Add.../Remove)
                       — VB6 gComponents_BeforeMouseDown (FAssembly.frm:1890-1902)
                       shows FMain.ShowColumnMenu only when GridLastVisibleRow <> 0,
                       else pops FMain.mnuAssemblyComponents (HHM-192). *@
                    <GridControl @ref="gComponents"
                            RowHeight="14"
                            MinRowHeight="14"
                            TValue="AssemblyComponentRow"
                            Title="@AssemblyComponentsGridExportTitle"
                            DataSource="@ComponentsData"
                            Height="@($"{_componentsGridHeight}px")"
                            AllowSelection="true"
                            ShowSelectionInfoBar="false"
                            AllowColumnReorder="true"
                            AllowSorting="true"
                            AllowResizing="true"
                            EnableTypeSearch="true"
                            ExtendVerticalScrollbarIntoHeader="true"
                            WidthMode="GridWidthMode.FitColumns"
                            EnableHover="true"
                            OnContextMenu="OnComponentsContextMenu"
                            PreventDefaultContextMenu="true"
                            StopContextMenuPropagation="true"
                            EnableHeaderContextMenu="@(ComponentsData.Count > 0)"
                            EditSettingsRef="@componentsEditSettings"
                            SelectionSettingsRef="@componentsSelectionSettings"
                            EventsRef="@gridEventsComponents"
                            OnLayoutChanged="@OnComponentsLayoutChangedAsync">
                        <GridColumnsBase @key="ComponentsGridLayoutVersion" DebugTag="FAssembly-gComponents">
                            @if (HasComponentsGridLayout)
                            {
                                foreach (var entry in GetOrderedComponentsGridLayout())
                                {
                                    var layout = entry.Layout;
                                    var fieldName = entry.Field;
                                    var columnType = entry.ColumnType;
                                    var textAlign = entry.TextAlign;
                                    var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                                    var width = layout.Width.HasValue && layout.Width.Value > 0
                                        ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                                        : null;
                                    var allowEdit = fieldName.Equals(nameof(AssemblyComponentRow.Qty), StringComparison.OrdinalIgnoreCase);
                                    var format = fieldName.Equals(nameof(AssemblyComponentRow.Qty), StringComparison.OrdinalIgnoreCase)
                                        ? "N0"
                                        : fieldName.Equals(nameof(AssemblyComponentRow.Cost), StringComparison.OrdinalIgnoreCase) ? "C2" : null;
                                    // VB6 never hides the Cost COLUMN when no pricing community is
                                    // selected — LoadData just leaves the cell VALUES blank
                                    // (FAssembly.frm:3182 `If PricingCommunity <> "" Then .TextMatrix(...)`).
                                    // Visibility comes solely from the AppGridLayout hidden flag.
                                    // Numeric editable cells preselect the value on edit so a fresh
                                    // keystroke replaces the existing number — same gesture the
                                    // Items grid uses for OrderQty / Price / TakeoffQty. Without
                                    // this the cursor lands inside the existing digits and the
                                    // edit looks like it didn't take.
                                    var selectAllOnEdit = allowEdit;

                                    <GridColumn Field="@fieldName"
                                                  HeaderText="@headerText"
                                                  Width="@width"
                                                  Type="@columnType"
                                                  TextAlign="@textAlign"
                                                  Format="@format"
                                                  AllowEditing="@allowEdit"
                                                  SelectAllOnEdit="@selectAllOnEdit"
                                                  Visible="true" />
                                }
                            }
                            else
                            {
                                <GridColumn Field="Community" HeaderText="@CommunityTerm" AllowEditing="false" />
                                <GridColumn Field="Model" HeaderText="Model" AllowEditing="false" />
                                <GridColumn Field="Option" HeaderText="Option" AllowEditing="false" />
                                <GridColumn Field="Assembly" HeaderText="Assembly" AllowEditing="false" />
                                <GridColumn Field="Description" HeaderText="Description" AllowEditing="false" />
                                @* Explicit AllowEditing="true" + SelectAllOnEdit so the click-to-
                                   edit gesture works the same way it does in the Items grid. The
                                   GridColumn default is true, but staying explicit means a future
                                   reader knows this column is intentionally editable. *@
                                <GridColumn Field="Qty" HeaderText="Qty" Format="N0" Type="ColumnType.Number" TextAlign="TextAlign.Right"
                                            AllowEditing="true" SelectAllOnEdit="true" />
                                @* Cost stays visible even with no pricing community — VB6 only
                                   blanks the VALUES (FAssembly.frm:3182), never hides the column. *@
                                <GridColumn Field="Cost" HeaderText="Cost" Format="C2" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="false" />
                            }
                        </GridColumnsBase>
                    </GridControl>
                </div>

                @* ── ROW RESIZER (between Components and Items grids) ─────
                   Draggable horizontal bar. User drags up to make the
                   Components grid shorter (Items grid taller), or down to
                   give Components more room. Mirrors GridControl's column
                   resize pattern: a thin handle starts the drag; while
                   active a fixed full-screen overlay captures mousemove /
                   mouseup so the drag survives even if the cursor leaves
                   the handle. *@
                @* Resizer width matches the Components grid (80%) so the
                   drag handle lines up under the grid instead of stretching
                   out into the empty right column. *@
                <div class="fx-row-resizer"
                     style="max-width: 80%;"
                     title="Drag to resize"
                     @onmousedown="StartComponentsResize"
                     @onmousedown:preventDefault="true"
                     @onmousedown:stopPropagation="true">
                    <div class="fx-row-resizer-grip"></div>
                </div>
                @if (_isResizingComponentsGrid)
                {
                    <div class="fx-row-resize-overlay"
                         @onmousemove="HandleComponentsResizeMove"
                         @onmouseup="EndComponentsResize"
                         @onmouseleave="EndComponentsResize"></div>
                }
            }

            @* ── ITEMS GRID ─────────────────────────────────────── *@
            <div class="assembly-grid" style="margin-top: 0;" @oncontextmenu="OnItemsContextMenu" @oncontextmenu:preventDefault="true">
                @* Items grid Height is dynamic: when ShowComponentsGrid is
                   true, the Components grid renders directly above this one
                   plus the resizer bar; both contribute height that must be
                   subtracted from the viewport. _componentsChromeOffset
                   captures both pieces (Components grid height + h5 header
                   + resizer bar). When hidden the items grid reclaims that
                   vertical space — without the swap the chrome reservation
                   would leave a ~180-px empty band beneath the items grid.

                   Razor comments belong outside the component's attribute
                   list — Blazor parses comments inside the tag as parameter
                   names and throws at render time. *@
                @* items-grid-wrap: catches clicks that bubble out of the
                   GridControl rows so the multi-select totals pill (rendered
                   below the grid) dismisses on any click. The pill itself
                   uses position:fixed so it floats outside the wrap's flow
                   and pointer-events:none so its presence never blocks the
                   underlying click. *@
                <div class="items-grid-wrap" @onclick="HideSumTip" @onkeydown="HideSumTip">
                <GridControl @ref="gItems"
                        TValue="AssemblyItemRow"
                        Title="@AssemblyGridExportTitle"
                        DataSource="@ItemsData"
                        AllowSelection="true"
                        ShowSelectionInfoBar="false"
                        ShowRowSelectionEditColumnCue="@(!mReadOnly)"
                        AllowColumnReorder="true"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowGrouping="true"
                        AllowResizing="true"
                        EnableTypeSearch="true"
                        EnableHover="true"
                        ExtendVerticalScrollbarIntoHeader="true"
                        OnContextMenu="OnItemsContextMenu"
                        PreventDefaultContextMenu="true"
                        StopContextMenuPropagation="true"
                        Height="@(ShowComponentsGrid ? $"calc(100vh - {ItemsGridViewportChromePx + _componentsChromeOffset}px)" : $"calc(100vh - {ItemsGridViewportChromePx}px)")"
                        RowHeight="14"
                        MinRowHeight="14"
                        GroupItemTextColor="@AssemblyGroupBlue"
                        GroupTotalTextColor="@AssemblyGroupBlue"
                        GroupColumns="@ItemsGridGroupColumns"
                        GroupHeaderTextSelector="ResolveItemsGroupHeaderText"
                        ShowGroupExpandCollapse="true"
                        AggregateRows="@aggregateRows"
                        FilterSettingsRef="@filterSettings"
                        PageSettingsRef="@pageSettings"
                        SelectionSettingsRef="@selectionSettings"
                        EditSettingsRef="@editSettings"
                        EventsRef="@gridEvents"
                        HideGroupedColumns="true"
                        ShowAdvancedViewToggleButton="false"
                        DefaultAdvancedView="false"
                        ShowExpressionFilterButton="false"
                        ShowGridOptionsRail="false"
                        ShowColumnOptionsButton="false"
                        AllowPivoting="false"
                        ShowPivotPanelButton="false"
                        ShowGridThemeToggle="false"
                        ShowGridBackButton="false"
                        AvailableColumns="@GetItemsGridChooseColumnsSchema()"
                        DefaultColumns="@GetItemsGridDefaultColumnsSchema()"
                        OnColumnsChosen="@OnItemsColumnsChosenAsync"
                        OnLayoutChanged="@OnItemsLayoutChangedAsync">
                    <GridColumnsBase @key="ItemsGridLayoutVersion" DebugTag="FAssembly-gItems">
                        @foreach (var entry in GetOrderedItemsGridLayout())
                        {
                            var layout = entry.Layout;
                            var fieldName = entry.Field;
                            var columnType = entry.ColumnType;
                            var textAlign = entry.TextAlign;
                            var headerText = string.IsNullOrWhiteSpace(layout.Caption) ? layout.Field : layout.Caption;
                            var width = layout.Width.HasValue && layout.Width.Value > 0
                                ? $"{ConvertLayoutWidthToPx(layout.Width.Value)}px"
                                : null;
                            // IsEditable on the layout entry is the single source of truth — set
                            // in ApplyVB6EditableColumnGates per the VB6 gItems_BeforeEdit list.
                            var allowEdit = layout.IsEditable;
                            // Numeric editable columns (OrderQty, TakeoffQty, Price,
                            // AssemblyConversionFactor) get SelectAllOnEdit so a fresh
                            // keystroke replaces the existing value instead of inserting
                            // at a caret position. Text columns (Notes, Location, WBSxx)
                            // keep the default caret-placement gesture so partial edits
                            // are easy. Driven off ColumnType so adding a new numeric
                            // column to the editable list automatically opts in.
                            var selectAllOnEdit = allowEdit && columnType == ColumnType.Number;
                            var displayFormat = fieldName.Equals("PretaxAmount", StringComparison.OrdinalIgnoreCase)
                                || fieldName.Equals("TaxAmount", StringComparison.OrdinalIgnoreCase)
                                || fieldName.Equals("ExtendedAmount", StringComparison.OrdinalIgnoreCase)
                                    ? "#,###.00"
                                    : null;
                            if (fieldName.Equals("POIndex", StringComparison.OrdinalIgnoreCase))
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              DisplayField="@nameof(AssemblyItemRow.POIndexDescription)"
                                              ClipMode="ClipMode.Ellipsis"
                                              AllowEditing="false"
                                              AllowCellDragSelection="@allowEdit"
                                              ShowEditButton="true"
                                              Visible="true">
                                    <Template>
                                        @{ var row = (AssemblyItemRow)context; }
                                        @* HHM-189: VB6 gItems stores the CODE in flexcpData but displays
                                           tblPOIndex.FullDescription ("10 Lumber") as the cell TEXT
                                           (FAssembly.frm:3112-3113; picker path frm:4196-4197) — the frx
                                           FormatString has a single "PO Index" column, no separate
                                           description column. HHM-166: the hover tip shows the CODE —
                                           VB6 ShowTip displays flexcpData (frm:4650), not the cell text. *@
                                        @{ var poText = string.IsNullOrWhiteSpace(row.POIndexDescription) ? row.POIndex : row.POIndexDescription; }
                                        <div class="poindex-cell"
                                             @ondblclick="() => OnPickPOIndex(row)"
                                             @ondblclick:stopPropagation="true">
                                            <span class="poindex-text" title="@row.POIndex">@poText</span>
                                            <button class="poindex-btn fx-grid-popup-btn" disabled="@mReadOnly" @onclick="() => OnPickPOIndex(row)" @onclick:stopPropagation="true">…</button>
                                        </div>
                                    </Template>
                                </GridColumn>
                            }
                            else if (fieldName.Equals("ItemType", StringComparison.OrdinalIgnoreCase))
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              ClipMode="ClipMode.Ellipsis"
                                              AllowEditing="@allowEdit"
                                              AllowCellDragSelection="@allowEdit"
                                              EditOptions="@ItemTypeOptions"
                                              Visible="true" />
                            }
                            else if (fieldName.Equals("Notes", StringComparison.OrdinalIgnoreCase)
                                     || fieldName.Equals("Formula", StringComparison.OrdinalIgnoreCase))
                            {
                                @* VB6 gItems_BeforeEdit sets .ComboList = "|..."
                                   for Notes / Formula. Use the same explicit
                                   cell-template shape as POIndex/Vendor: raw
                                   text plus the classic popup button. Avoid
                                   GridControl's generic AlwaysShowEditButton
                                   path here; that flat action button can stick
                                   visually while the cursor/selection moves. *@
                                var popupField = fieldName;
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              ClipMode="ClipMode.Ellipsis"
                                              AllowEditing="false"
                                              AllowCellDragSelection="@allowEdit"
                                              ShowEditButton="true"
                                              Visible="true">
                                    <Template>
                                        @{
                                            var row = (AssemblyItemRow)context;
                                            var popupText = popupField.Equals("Notes", StringComparison.OrdinalIgnoreCase)
                                                ? row.Notes
                                                : row.Formula;
                                        }
                                        <div class="poindex-cell"
                                             @ondblclick="() => OnOpenMultiLineEditor(row, popupField)"
                                             @ondblclick:stopPropagation="true">
                                            <span class="poindex-text" title="@popupText">@popupText</span>
                                            <button class="poindex-btn fx-grid-popup-btn"
                                                    disabled="@mReadOnly"
                                                    @onclick="() => OnOpenMultiLineEditor(row, popupField)"
                                                    @onclick:stopPropagation="true">…</button>
                                        </div>
                                    </Template>
                                </GridColumn>
                            }
                            else if (fieldName.Equals("Vendor", StringComparison.OrdinalIgnoreCase)
                                     || fieldName.Equals("VendorDesc", StringComparison.OrdinalIgnoreCase))
                            {
                                @* Vendor/VendorDesc use the same explicit template
                                   shape as POIndex: raw cell text plus a separate
                                   legacy "..." picker button. Keeping this out of
                                   GridControl's generic action-cell path prevents the
                                   picker text/button from behaving differently during
                                   row selection and drag selection. *@
                                var vendorField = fieldName;
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              ClipMode="ClipMode.Ellipsis"
                                              AllowEditing="false"
                                              AllowCellDragSelection="@allowEdit"
                                              ShowEditButton="true"
                                              Visible="true">
                                    <Template>
                                        @{
                                            var row = (AssemblyItemRow)context;
                                            var vendorText = vendorField.Equals("Vendor", StringComparison.OrdinalIgnoreCase)
                                                ? row.Vendor
                                                : row.VendorDesc;
                                            var vendorPickDisabled = mReadOnly || string.IsNullOrEmpty(PricingCommunity);
                                        }
                                        <div class="poindex-cell"
                                             @ondblclick="() => OnPickVendor(row, vendorField)"
                                             @ondblclick:stopPropagation="true">
                                            <span class="poindex-text" title="@vendorText">@vendorText</span>
                                            <button class="poindex-btn fx-grid-popup-btn"
                                                    disabled="@vendorPickDisabled"
                                                    @onclick="() => OnPickVendor(row, vendorField)"
                                                    @onclick:stopPropagation="true">…</button>
                                        </div>
                                    </Template>
                                </GridColumn>
                            }
                            else if (fieldName.Equals("PriceLevel", StringComparison.OrdinalIgnoreCase))
                            {
                                @* VB6: PriceLevel ComboList is built dynamically from
                                   ItemType + PricingCommunityPhase + Vendor:
                                     Vendor blank  → "Item DB"
                                     Quote, no phase  → Global | Item DB | Community Specific
                                     Quote, phase     → Global | Item DB | Community Specific | Phase Specific
                                     Unit Price, no phase → Corporate | Global | Item DB | Community Specific
                                     Unit Price, phase    → Corporate | Global | Item DB | Community Specific | Phase Specific
                                   Cancel = (PricingCommunity = "")  — page-wide gate (already
                                   handled in ApplyVB6EditableColumnGates). *@
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              ClipMode="ClipMode.Ellipsis"
                                              AllowEditing="@allowEdit"
                                              AllowCellDragSelection="@allowEdit"
                                              EditOptionsProvider="GetPriceLevelEditOptions"
                                              Visible="true" />
                            }
                            else if (fieldName.Equals("Invertable", StringComparison.OrdinalIgnoreCase))
                            {
                                @* VB6 BeforeEdit: Cancel = HasInverseItem <> "1".
                                   At the column level IsEditable is true; the per-row
                                   gate lives here in the template — checkbox only if
                                   the row's HasInverseItem flag is set, else read-only
                                   text. *@
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              ClipMode="ClipMode.Ellipsis"
                                              AllowEditing="false"
                                              Visible="true">
                                    <Template>
                                        @{ var row = (AssemblyItemRow)context; }
                                        @{ var canEdit = !mReadOnly && row.HasInverseItem == 1; }
                                        @if (canEdit)
                                        {
                                            <CheckBoxControl Checked="@row.Invertable"
                                                             CheckedChanged="value => OnInvertableChanged(row, value)"
                                                             StopClickPropagation="true"
                                                             StopMouseDownPropagation="true"
                                                             CssClass="hf-asm-grid-checkbox" />
                                        }
                                        else
                                        {
                                            @* HHM-261: VB6 ALWAYS displays the checkbox (frm:3088) and only gates
                                               editing (frm:2074) — show a disabled box, not a blank cell. *@
                                            <CheckBoxControl Checked="@row.Invertable" Disabled="true" TabIndex="-1" CssClass="hf-asm-grid-checkbox" />
                                        }
                                    </Template>
                                </GridColumn>
                            }
                            else if (fieldName.Equals("Price", StringComparison.OrdinalIgnoreCase))
                            {
                                // VB6 BeforeEdit:
                                //     Cancel = PricingCommunity = ""
                                //              Or ItemType = ""
                                //              Or PriceLevel = ""
                                // Two of those are per-row, so the gate lives here
                                // instead of in ApplyVB6EditableColumnGates. When
                                // the row qualifies we hand off to the default
                                // GridColumn editor; when it doesn't we render a
                                // plain currency string so the rest of the grid
                                // still shows a value (just non-editable).
                                var allowPriceEdit = !mReadOnly
                                    && !string.IsNullOrEmpty(PricingCommunity);
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              ClipMode="ClipMode.Ellipsis"
                                              AllowEditing="@allowPriceEdit"
                                              SelectAllOnEdit="@allowPriceEdit"
                                              Format="C2"
                                              Visible="true">
                                    <Template>
                                        @{ var row = (AssemblyItemRow)context; }
                                        @{
                                            // VB6 gItems_ValidateEdit Price case
                                            // (FAssembly.frm:2424) rejects a Price
                                            // commit when PriceLevel = "Item DB", so
                                            // Item-DB rows must not be Price-editable
                                            // here even though their ItemType /
                                            // PriceLevel are non-empty.
                                            var rowEligible = allowPriceEdit
                                                && !string.IsNullOrEmpty(row.ItemType)
                                                && !string.IsNullOrEmpty(row.PriceLevel)
                                                && row.PriceLevel != "Item DB";
                                        }
                                        @if (rowEligible)
                                        {
                                            @* Eligible row — let the grid's default
                                               editor take over via fallback. The
                                               column-level AllowEditing=true plus
                                               this template returning the formatted
                                               number is enough; GridControl picks up
                                               the inline editor on click. *@
                                            <span>@row.Price?.ToString("C2")</span>
                                        }
                                        else
                                        {
                                            <span style="color:#999;">@row.Price?.ToString("C2")</span>
                                        }
                                    </Template>
                                </GridColumn>
                            }
                            else
                            {
                                <GridColumn Field="@fieldName"
                                              HeaderText="@headerText"
                                              Width="@width"
                                              Type="@columnType"
                                              TextAlign="@textAlign"
                                              ClipMode="ClipMode.Ellipsis"
                                              AllowEditing="@allowEdit"
                                              SelectAllOnEdit="@selectAllOnEdit"
                                              Format="@displayFormat"
                                              Visible="true" />
                            }
                        }
                    </GridColumnsBase>
                </GridControl>
                @* Multi-select totals pill — appears at last-known cursor
                   position when SelectionChanged hits 2+ rows. position:fixed +
                   pointer-events:none means the underlying click that committed
                   the selection still passes through to the grid. CSS is in
                   FAssembly.razor.css (.fx-sumtip*). *@
                @if (_sumTipVisible)
                {
