    private void RecalculateCosts()
    {
        AssemblyCost = ItemsData.Where(i => i.RowStatus != "delete").Sum(i => i.ExtendedAmount);
        AssemblyCostLabel = AssemblyCost.ToString("$#,##0.00");
        if (!string.IsNullOrEmpty(PricingCommunity))
        {
            ComponentCostLabel = ComponentCost.ToString("$#,##0.00");
            TotalCostLabel = (Math.Round(AssemblyCost, 2) + Math.Round(ComponentCost, 2)).ToString("$#,##0.00");
        }
    }

