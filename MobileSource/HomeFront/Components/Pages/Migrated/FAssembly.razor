    private static string HeaderNumberText(double? value)
        => value == null ? "" : value.Value.ToString(CultureInfo.InvariantCulture);

    private static double? ParseHeaderNumber(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null; // blank stays blank (VB6 empty TextBox)
        return double.TryParse(text.Trim(), System.Globalization.NumberStyles.Any,
            CultureInfo.InvariantCulture, out var d)
            ? d
            : 0; // VB6 Val() coerces junk to 0
    }

