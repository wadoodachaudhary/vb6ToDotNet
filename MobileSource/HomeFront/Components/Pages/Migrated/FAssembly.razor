    private string BuildItemsQuery_NoPricing() => @"
        SELECT d.sequence, d.Invertable, CASE WHEN v.phase IS NULL THEN 0 ELSE 1 END AS hasInverseItem,
               d.UseModelCost, i.Description, i.OrderUOM,
               ISNULL(NULLIF(d.POIndex,''), ISNULL(i.POIndex,'')) AS POIndex,
               p.FullDescription AS POIndexDescription, cc.CostCode AS JCCostCode, cc.Description AS JCCostCodeDesc,
               ct.Category AS JCCategory, ct.Description AS JCCategoryDesc,
               i.TakeoffUOM, i.RoundDir, i.RoundTo, d.Phase, d.Item, d.itemchart, i.itemnumber, d.Formula,
               d.TakeoffQty, d.OrderQty, d.notes, i.IsQuote, i.WastePercent, d.Location,
               d.WBS01,d.WBS02,d.WBS03,d.WBS04,d.WBS05,d.WBS06,d.WBS07,d.WBS08,d.WBS09,d.WBS10,
               d.WBS11,d.WBS12,d.WBS13,d.WBS14,d.WBS15,d.WBS16,d.WBS17,d.WBS18,d.WBS19,d.WBS20,
               d.WBS21,d.WBS22,d.WBS23,d.WBS24,d.WBS25,d.WBS26,d.WBS27,d.WBS28,d.WBS29,d.WBS30,
               d.WBS31,d.WBS32,d.WBS33,d.WBS34,d.WBS35,d.WBS36,d.WBS37,d.WBS38,d.WBS39,d.WBS40,
               d.ConversionFactor AS AssemblyConversionFactor, i.ConversionFactor AS ItemConversionFactor
        FROM tblDBAssemblyDetails d
        LEFT OUTER JOIN tblPhaseItem i ON d.DivisionID=i.DivisionID AND d.Phase=i.Phase AND d.Item=i.Item
        LEFT OUTER JOIN tblPhaseItem v ON i.DivisionID=v.DivisionID AND i.inversePhase=v.Phase AND i.inverseItem=v.Item
        LEFT OUTER JOIN tblPOIndex p ON p.DivisionID=d.DivisionID AND ISNULL(NULLIF(d.POIndex,''),ISNULL(i.POIndex,''))=p.POIndex
        LEFT OUTER JOIN appoptions o ON o.optionname='UseAltCostCodesForCO' AND o.DivisionID=d.DivisionID
        LEFT OUTER JOIN StandardCostCodes cc ON cc.DivisionID=i.DivisionID AND cc.costcode=ISNULL(CASE WHEN ISNULL(d.optionid,'')='' OR o.optionvalue='true' THEN i.jccostcode ELSE ISNULL(NULLIF(i.altjccostcode,''),i.jccostcode) END, p.jccostcode)
        LEFT OUTER JOIN StandardCategories ct ON ct.DivisionID=i.DivisionID AND ct.category=ISNULL(CASE WHEN ISNULL(d.optionid,'')='' OR o.optionvalue='true' THEN i.jccategory ELSE ISNULL(NULLIF(i.altjccategory,''),i.jccategory) END, p.jccategory)
        WHERE d.DivisionID=@DivisionID AND ISNULL(d.Community,'')=@Community AND ISNULL(d.Assembly,'')=@Assembly
              AND ISNULL(d.Model,'')=@Model AND ISNULL(d.Optionid,'')=@OptionID
        ORDER BY d.Phase, d.Item, d.itemchart, d.Sequence";

    private string BuildItemsQuery_WithPricing() => @"
        SELECT d.sequence, d.Invertable, CASE WHEN iv.phase IS NULL THEN 0 ELSE 1 END AS hasInverseItem,
               d.UseModelCost, i.Description, i.OrderUOM,
               ISNULL(NULLIF(d.POIndex,''), ISNULL(i.POIndex,'')) AS POIndex,
               p.FullDescription AS POIndexDescription, cc.CostCode AS JCCostCode, cc.Description AS JCCostCodeDesc,
               ct.Category AS JCCategory, ct.Description AS JCCategoryDesc,
               i.TakeoffUOM, i.RoundDir, i.RoundTo, d.Phase, d.Item, d.itemchart, i.itemnumber, d.Formula,
               d.TakeoffQty, d.OrderQty, d.notes, i.IsQuote, i.WastePercent,
               v.vendor_id AS Vendor, v.vendor_name AS VendorDesc,
               dbo.Purch_GetItemRate(0,0,@PricingCommunity,@PricingCommunityPhase,d.Assembly,d.Model,d.OptionID,d.Phase,d.Item,d.Sequence,v.Vendor_id,GETDATE(),@DivisionID) AS Rate,
               dbo.Purch_GetItemRateQuality(0,0,@PricingCommunity,@PricingCommunityPhase,d.Assembly,d.Model,d.OptionID,d.Phase,d.Item,d.Sequence,v.Vendor_id,GETDATE(),@DivisionID) AS RateQuality,
               t.JCRate AS JCTaxRate, d.Location,
               d.WBS01,d.WBS02,d.WBS03,d.WBS04,d.WBS05,d.WBS06,d.WBS07,d.WBS08,d.WBS09,d.WBS10,
               d.WBS11,d.WBS12,d.WBS13,d.WBS14,d.WBS15,d.WBS16,d.WBS17,d.WBS18,d.WBS19,d.WBS20,
               d.WBS21,d.WBS22,d.WBS23,d.WBS24,d.WBS25,d.WBS26,d.WBS27,d.WBS28,d.WBS29,d.WBS30,
               d.WBS31,d.WBS32,d.WBS33,d.WBS34,d.WBS35,d.WBS36,d.WBS37,d.WBS38,d.WBS39,d.WBS40,
               d.ConversionFactor AS AssemblyConversionFactor, i.ConversionFactor AS ItemConversionFactor
        FROM tblDBAssemblyDetails d
        LEFT OUTER JOIN tblPhaseItem i ON d.DivisionID=i.DivisionID AND d.Phase=i.Phase AND d.Item=i.Item
        LEFT OUTER JOIN tblPhaseItem iv ON i.DivisionID=iv.DivisionID AND i.inversePhase=iv.Phase AND i.inverseItem=iv.Item
        LEFT OUTER JOIN tblPOIndex p ON p.DivisionID=@DivisionID AND ISNULL(NULLIF(d.POIndex,''),ISNULL(i.POIndex,''))=p.POIndex
        LEFT OUTER JOIN appoptions o ON o.optionname='UseAltCostCodesForCO' AND o.DivisionID=d.DivisionID
        LEFT OUTER JOIN StandardCostCodes cc ON cc.DivisionID=i.DivisionID AND cc.costcode=ISNULL(CASE WHEN ISNULL(d.optionid,'')='' OR o.optionvalue='true' THEN i.jccostcode ELSE ISNULL(NULLIF(i.altjccostcode,''),i.jccostcode) END, p.jccostcode)
        LEFT OUTER JOIN StandardCategories ct ON ct.DivisionID=i.DivisionID AND ct.category=ISNULL(CASE WHEN ISNULL(d.optionid,'')='' OR o.optionvalue='true' THEN i.jccategory ELSE ISNULL(NULLIF(i.altjccategory,''),i.jccategory) END, p.jccategory)
        LEFT OUTER JOIN tblvendors v ON v.DivisionID=d.DivisionID AND v.vendor_id=dbo.Purch_GetCommunityVendor(@PricingCommunity,p.POIndex,@DivisionID)
        LEFT OUTER JOIN taxGroups t ON t.DivisionID=@DivisionID AND t.TaxGroup=dbo.Purch_GetDefaultTaxGroup('',@PricingCommunity,'',d.Model,d.Assembly,i.phase,i.item,v.Vendor_ID,i.JCCategory,@DivisionID)
        WHERE d.DivisionID=@DivisionID AND ISNULL(d.Community,'')=@Community AND ISNULL(d.Assembly,'')=@Assembly
              AND ISNULL(d.Model,'')=@Model AND ISNULL(d.Optionid,'')=@OptionID
        ORDER BY d.Phase, d.Item, d.itemchart, d.Sequence";

    private string BuildComponentsQuery() => @"
        SELECT m.assemblyid, m.community, m.assembly, m.model, m.optionid, m.description, c.qty,
               ROUND(SUM(
                 ISNULL(dbo.Purch_GetItemRate(0,0,@mPricingCommunity,@mPricingCommunityPhase,d.Assembly,d.Model,d.OptionID,d.Phase,d.Item,d.Sequence,v.Vendor_id,GETDATE(),d.DivisionID),0)
                 *(100+ISNULL(t.JCRate,0))/100
                 *ISNULL(d.OrderQty,0)
               ),2) AS Cost
        FROM tblDBAssemblyComponents c
        JOIN tblDBAssemblyMaster m ON c.componentassemblyid=m.assemblyid
        LEFT OUTER JOIN tblDBAssemblyDetails d ON m.assemblyid=d.assemblyid
        LEFT OUTER JOIN tblPhaseItem i ON d.DivisionID=i.DivisionID AND d.Phase=i.Phase AND d.Item=i.Item
        LEFT OUTER JOIN tblPOIndex p ON p.DivisionID=@DivisionID AND ISNULL(NULLIF(d.POIndex,''),ISNULL(i.POIndex,''))=p.POIndex
        LEFT OUTER JOIN tblvendors v ON v.DivisionID=d.DivisionID AND v.vendor_id=dbo.Purch_GetCommunityVendor(@mPricingCommunity,p.POIndex,@DivisionID)
        LEFT OUTER JOIN taxGroups t ON t.DivisionID=@DivisionID AND t.TaxGroup=dbo.Purch_GetDefaultTaxGroup('',@mPricingCommunity,'',d.Model,d.Assembly,i.phase,i.item,v.Vendor_ID,i.JCCategory,@DivisionID)
        WHERE c.ParentAssemblyid=@ParentAssemblyId
        GROUP BY m.assemblyid, m.community, m.assembly, m.model, m.optionid, m.description, c.qty
        ORDER BY m.assembly";

