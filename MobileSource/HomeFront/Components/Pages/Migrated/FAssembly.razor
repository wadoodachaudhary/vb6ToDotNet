    private string BuildAssemblyOptionsPickListQuery(string modelId)
    {
        // VB6 HFApp.DivisionID. int value → interpolation into FPickList raw SQL is injection-safe.
        var divisionId = SessionState.DivisionID;
        var communityAlias = SqlAlias(CommunityTerm);
        var modelQuoted = SqlQuote(modelId);

        return $@"
select ct.Description Category,c.area AreaID,c.description {communityAlias},a.Model,dm.description ModelDescription,a.Series,a.Model modelid,a.OptionID,a.OptionID [Option],a.Assembly,a.Description,a.assemblytype,0 Source
from tbldbassemblymaster a
left outer join tbllocality c on(a.community=c.area)
left outer join tblcategories ct on(a.category=ct.category)
left outer join distinctmodelsbydivision dm on(a.model=dm.model and a.divisionid=dm.divisionid)
where a.DivisionID = {divisionId}
and isnull(a.inactive,0)=0
and a.assemblytype=2
and a.model = {modelQuoted}
order by 1,2,3,4,5,6,7";
    }

    private void ApplyAssemblySelectionFromRow(IDictionary<string, object> row, int selectedView)
    {
        mCommunity = GetRowString(row, "areaid");
        mAssembly = GetRowString(row, "assembly");
        mModel = GetRowString(row, "modelid");
        if (string.IsNullOrWhiteSpace(mModel))
            mModel = GetRowString(row, "Model");
        mOptionID = GetRowString(row, "optionid");

        if (long.TryParse(GetRowString(row, "Source"), out var source))
            mDataSource = source;
        else
            mDataSource = 0;

        mAssemblyType = ResolveAssemblyType(row, selectedView);
    }

    private AssemblyTypes ResolveAssemblyType(IDictionary<string, object> row, int selectedView)
    {
        var raw = GetRowString(row, "assemblytype");
        if (int.TryParse(raw, out var val))
            return (AssemblyTypes)val;

        return selectedView switch
        {
            1 => AssemblyTypes.atModel,
            2 => AssemblyTypes.atoption,
            3 => AssemblyTypes.atDesignCenter,
            4 => AssemblyTypes.atGlobal,
            _ => AssemblyTypes.atModel
        };
    }

    private static string GetRowString(IDictionary<string, object> row, string key)
    {
        if (row.TryGetValue(key, out var value) && value != null)
            return value.ToString() ?? "";

        foreach (var k in row.Keys)
        {
            if (string.Equals(k, key, StringComparison.OrdinalIgnoreCase))
            {
                var v = row[k];
                return v?.ToString() ?? "";
            }
        }
        return "";
    }

    private static string SqlAlias(string alias)
    {
        if (string.IsNullOrWhiteSpace(alias))
            return "[Community]";
        return $"[{alias.Replace("]", "]]")}]";
    }

    private static string SqlQuote(string value) => $"'{value.Replace("'", "''")}'";

    private bool TryGetStartupAssemblyContext(out (string Community, string Model, string OptionID, string Assembly, string AssemblyDesc, AssemblyTypes AssemblyType) context)
    {
        var assembly = QueryAssembly?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(assembly))
        {
            context = default;
            return false;
        }

        var at = AssemblyTypes.atModel;
        if (!string.IsNullOrWhiteSpace(QueryAssemblyType) && int.TryParse(QueryAssemblyType, out var atInt))
        {
            if (Enum.IsDefined(typeof(AssemblyTypes), atInt))
                at = (AssemblyTypes)atInt;
        }

        context = (
            Community: QueryCommunity?.Trim() ?? "",
            Model: QueryModel?.Trim() ?? "",
            OptionID: QueryOptionID?.Trim() ?? "",
            Assembly: assembly,
            AssemblyDesc: QueryAssemblyDesc?.Trim() ?? "",
            AssemblyType: at);
        return true;
    }

    private void SyncAssemblyRouteState()
    {
        var target = BuildAssemblyStateUrl();

        if (ParentNavigate != null)
        {
            // Hosted inside FMain — update FMain's internal route state
            // without changing the browser URL away from /main.
            ParentNavigate(target);
        }
        else
        {
            // Standalone — update the browser URL directly.
            var current = new Uri(NavigationManager.Uri).PathAndQuery;
            if (!string.Equals(current, target, StringComparison.Ordinal))
                NavigationManager.NavigateTo(target, replace: true);
        }
    }

    /// <summary>
    /// VB6 parity for the clickable Cat / Sub Cat / Location labels above
    /// the corresponding dropdowns (FAssembly.frm:lblGroup_Click /
    /// lblCategory_Click / lblLocation_Click; FAssemblyWithPricing.frm:1230-1241).
    /// VB6 called <c>FDBGrid.ShowForm(sql, caption, …)</c> as a modal
    /// popup. We mirror that by rendering FDBGrid INLINE inside this
    /// page with IsModal=true (markup near the bottom). Navigating to
    /// /db-grid/{caption} as a tab would lose the FAssembly context
    /// AND URL-encode the caption ("Option%20Categories"), which broke
    /// FDBGrid's auto-resolve switch.
    /// </summary>
    private void OpenLookupPopup(string formCaption)
    {
        _lookupCaption = formCaption;
        _showLookupModal = true;
        StateHasChanged();
    }

    private void OnLookupModalClosed()
    {
        _showLookupModal = false;
        if (string.Equals(_lookupCaption, "Option Subcategories", StringComparison.OrdinalIgnoreCase))
            LoadCategoryItems();
        StateHasChanged();
    }

    /// <summary>VB6 parity for FAssembly.frm:836 lblMoreAttributes — opens
    /// the FAssemblyAttributes modal (already a self-contained modal
    /// component in HomeFront). The Cat/Sub Cat/Location popups use
    /// FDBGrid; this one uses its dedicated dialog. Wired to the
    /// "More Attributes…" blue link in the form chrome.</summary>
    private void OpenMoreAttributes()
    {
        if (mReadOnly) return;
        _showAttributesModal = true;
        StateHasChanged();
    }

    /// <summary>VB6 lblMoreAttributes_Click set mDirty=True then opened
    /// FAssemblyAttributes; on OK the modal returns the four attribute values +
    /// list IDs. FAssemblyAttributes doesn't persist them — we capture them here
    /// and the master UPDATE in SaveData writes color/stylevalue/finishvalue/
    /// othervalue + the four *listid columns (FAssembly.frm:3448-3455).</summary>
    private void OnAttributesSaved(FAssemblyAttributes.AssemblyAttributesResult result)
    {
        if (result == null) return;
        for (int i = 0; i < 4; i++)
        {
            _attrValues[i] = (result.AttributeValues != null && i < result.AttributeValues.Length)
                ? (result.AttributeValues[i] ?? "") : "";
            _attrListIds[i] = (result.ListIds != null && i < result.ListIds.Length)
                ? result.ListIds[i] : -1;
        }
        mDirty = true;
        StateHasChanged();
    }

    private string BuildAssemblyStateUrl()
    {
        var assembly = (AssemblyCode ?? mAssembly).Trim();
        var community = (mCommunity).Trim();
        var model = (mModel).Trim();
        var optionId = (mOptionID).Trim();
        var description = (Description ?? mAssemblyDesc ?? "").Trim();

        if (string.IsNullOrWhiteSpace(assembly) &&
            string.IsNullOrWhiteSpace(community) &&
            string.IsNullOrWhiteSpace(model) &&
            string.IsNullOrWhiteSpace(optionId))
        {
            return "/edit-model-assembly";
        }

        var qs = new Dictionary<string, string?>
        {
            ["community"] = community,
            ["model"] = model,
            ["optionID"] = optionId,
            ["assembly"] = assembly,
            ["assemblyDesc"] = description,
            ["assemblyType"] = ((int)mAssemblyType).ToString()
        };

        var queryString = string.Join("&", qs
            .Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
            .Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value!)}"));

        return string.IsNullOrWhiteSpace(queryString)
            ? "/edit-model-assembly"
