    // AppOptions — VB6 HFApp.Options. Loaded per division from the AppOptions
    // table via LoadAppOptionsAsync (called from OnAfterRenderAsync's first-render
    // init, before LoadComboBoxes) so each tenant sees its own values. The load is
    // deferred into the interactive circuit with the rest of the DB work so no
    // query runs during SSR prerender. INSTANCE (not static): a static dictionary
    // would be shared
    // across every Blazor Server circuit, leaking one division's options to
    // another. Values are NOT hardcoded — divisions 1/14/15/16 have divergent
    // EstimatingSystem / UseComponents / ScheduleTemplates / Series, and several
    // options (Series, ReqCategory, HideElevation) have no rows at all (VB6
    // treats those as unset → "").
    private Dictionary<string, string> AppOptions = new(StringComparer.OrdinalIgnoreCase);

    // VB6 HFApp.Options(name) / .ValueByName(name) — reads an app-option by name.
    // Returns "" when the option isn't present (VB6 ValueByName treats an unset
    // option as falsy, e.g. ReqCategory unset → false, EstimatingSystem unset →
    // Val("") = 0 → import button hidden).
    private string GetAppOption(string name)
        => AppOptions.TryGetValue(name, out var v) ? v : "";

    // VB6 HFApp.Options — TWO-TIER lookup, mirroring Options.cls exactly (HHM-207):
    //   1. System_Setup.<column> for the logged-in division (Options.cls:883-888 loads
    //      the whole row by column NAME; ValueByName tries system_setup FIRST, :810).
    //   2. AppOptions rows as the fallback for names System_Setup doesn't answer
    //      (Options.cls:811) — division row (divisionid=@DivisionID) overrides the
    //      global row (divisionid=0) via ORDER BY divisionid.
    // Options like ReqCategory / Series / HideElevation are System_Setup COLUMNS and
    // have no AppOptions rows at all — reading only AppOptions left them permanently
    // falsy, which silently disabled VB6 behaviors (e.g. ValidateData's "Category is
    // required" gate). Must run before anything reads GetAppOption (ShowImportButton,
    // ValidateData ReqCategory, Series / ScheduleTemplate dropdown population).
    private async Task LoadAppOptionsAsync()
    {
        try
        {
            var opts = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            var dt = db.SqlExec(
                "SELECT OptionName, OptionValue FROM AppOptions WHERE ISNULL(divisionid,0) IN (0, @DivisionID) ORDER BY divisionid",
                new { SessionState.DivisionID });
            foreach (DataRow r in dt.Rows)
                opts[r["OptionName"]?.ToString() ?? ""] = r["OptionValue"]?.ToString() ?? "";

            // Tier 1 overlay: the division's System_Setup row wins wherever it has a
            // value. Bit columns stringify as "True"/"False" — same as VB6's
            // `"" & rs(i)` on an ADO boolean — which GetAppOption consumers already
            // parse. NULL/empty columns fall through to whatever AppOptions supplied,
            // matching Options.cls:810-811's `If s = "" Then` chain.
            var setup = db.SqlExec("SELECT * FROM System_Setup WHERE id = @DivisionID",
                                   new { SessionState.DivisionID });
            if (setup.Rows.Count > 0)
            {
                var row = setup.Rows[0];
                foreach (DataColumn col in setup.Columns)
                {
                    var val = row[col] is DBNull ? "" : row[col]?.ToString() ?? "";
                    if (!string.IsNullOrEmpty(val))
                        opts[col.ColumnName] = val;
                }
            }
            AppOptions = opts;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadAppOptions error");
        }
        await Task.CompletedTask;
    }

    // Enums
    // Values MUST match VB6 MMain.bas AssemblyTypes (= the tbldbassemblymaster
    // .assemblytype DB encoding): the value crosses the DB boundary both ways
    // (LoadDataAsync cast, GetMasterParams save) and is handed to FTakeoff as a
    // raw int. A previous translation had atoption=1/atGlobal=2/atDesignCenter=3/
    // atCustomOption=4, which mis-typed every non-Model assembly loaded from
    // the DB (Option rows behaved as Global, etc.).
    public enum AssemblyTypes { atModel = 0, atElevation = 1, atoption = 2, atGlobal = 3, atDesignCenter = 4, atCustomOption = -1 }

