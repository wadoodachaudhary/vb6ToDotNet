    private string BuildItemsQuery_NoPricing() => @"
        SELECT d.sequence, d.Invertable, CASE WHEN v.phase IS NULL THEN 0 ELSE 1 END AS hasInverseItem,
               d.UseModelCost, i.Description, i.OrderUOM,
               ISNULL(NULLIF(d.POIndex,''), ISNULL(i.POIndex,'')) AS POIndex,
               p.FullDescription AS POIndexDescription, cc.CostCode AS JCCostCode, cc.Description AS JCCostCodeDesc,
               ct.Category AS JCCategory, ct.Description AS JCCategoryDesc,
               i.TakeoffUOM, i.RoundDir, i.RoundTo, d.Phase, d.Item, d.itemchart, i.itemnumber, d.Formula,
               d.TakeoffQty, d.OrderQty, d.notes, i.IsQuote, i.WastePercent, d.Location,
               d.WBS01,d.WBS02,d.WBS03,d.WBS04,d.WBS05,d.WBS06,d.WBS07,d.WBS08,d.WBS09,d.WBS10,
               d.WBS11,d.WBS12,d.WBS13,d.WBS14,d.WBS15,d.WBS16,d.WBS17,d.WBS18,d.WBS19,d.WBS20,
               d.WBS21,d.WBS22,d.WBS23,d.WBS24,d.WBS25,d.WBS26,d.WBS27,d.WBS28,d.WBS29,d.WBS30,
               d.WBS31,d.WBS32,d.WBS33,d.WBS34,d.WBS35,d.WBS36,d.WBS37,d.WBS38,d.WBS39,d.WBS40,
               d.ConversionFactor AS AssemblyConversionFactor, i.ConversionFactor AS ItemConversionFactor
        FROM tblDBAssemblyDetails d
        LEFT OUTER JOIN tblPhaseItem i ON d.DivisionID=i.DivisionID AND d.Phase=i.Phase AND d.Item=i.Item
        LEFT OUTER JOIN tblPhaseItem v ON i.DivisionID=v.DivisionID AND i.inversePhase=v.Phase AND i.inverseItem=v.Item
        LEFT OUTER JOIN tblPOIndex p ON p.DivisionID=d.DivisionID AND ISNULL(NULLIF(d.POIndex,''),ISNULL(i.POIndex,''))=p.POIndex
        LEFT OUTER JOIN appoptions o ON o.optionname='UseAltCostCodesForCO' AND o.DivisionID=d.DivisionID
        LEFT OUTER JOIN StandardCostCodes cc ON cc.DivisionID=i.DivisionID AND cc.costcode=ISNULL(CASE WHEN ISNULL(d.optionid,'')='' OR o.optionvalue='true' THEN i.jccostcode ELSE ISNULL(NULLIF(i.altjccostcode,''),i.jccostcode) END, p.jccostcode)
        LEFT OUTER JOIN StandardCategories ct ON ct.DivisionID=i.DivisionID AND ct.category=ISNULL(CASE WHEN ISNULL(d.optionid,'')='' OR o.optionvalue='true' THEN i.jccategory ELSE ISNULL(NULLIF(i.altjccategory,''),i.jccategory) END, p.jccategory)
        WHERE d.DivisionID=@DivisionID AND ISNULL(d.Community,'')=@Community AND ISNULL(d.Assembly,'')=@Assembly
              AND ISNULL(d.Model,'')=@Model AND ISNULL(d.Optionid,'')=@OptionID
        ORDER BY d.Phase, d.Item, d.itemchart, d.Sequence";

    private string BuildItemsQuery_WithPricing() => @"
        SELECT d.sequence, d.Invertable, CASE WHEN iv.phase IS NULL THEN 0 ELSE 1 END AS hasInverseItem,
               d.UseModelCost, i.Description, i.OrderUOM,
               ISNULL(NULLIF(d.POIndex,''), ISNULL(i.POIndex,'')) AS POIndex,
               p.FullDescription AS POIndexDescription, cc.CostCode AS JCCostCode, cc.Description AS JCCostCodeDesc,
               ct.Category AS JCCategory, ct.Description AS JCCategoryDesc,
               i.TakeoffUOM, i.RoundDir, i.RoundTo, d.Phase, d.Item, d.itemchart, i.itemnumber, d.Formula,
               d.TakeoffQty, d.OrderQty, d.notes, i.IsQuote, i.WastePercent,
               v.vendor_id AS Vendor, v.vendor_name AS VendorDesc,
               dbo.Purch_GetItemRate(0,0,@PricingCommunity,@PricingCommunityPhase,d.Assembly,d.Model,d.OptionID,d.Phase,d.Item,d.Sequence,v.Vendor_id,GETDATE(),@DivisionID) AS Rate,
               dbo.Purch_GetItemRateQuality(0,0,@PricingCommunity,@PricingCommunityPhase,d.Assembly,d.Model,d.OptionID,d.Phase,d.Item,d.Sequence,v.Vendor_id,GETDATE(),@DivisionID) AS RateQuality,
               t.JCRate AS JCTaxRate, d.Location,
               d.WBS01,d.WBS02,d.WBS03,d.WBS04,d.WBS05,d.WBS06,d.WBS07,d.WBS08,d.WBS09,d.WBS10,
               d.WBS11,d.WBS12,d.WBS13,d.WBS14,d.WBS15,d.WBS16,d.WBS17,d.WBS18,d.WBS19,d.WBS20,
               d.WBS21,d.WBS22,d.WBS23,d.WBS24,d.WBS25,d.WBS26,d.WBS27,d.WBS28,d.WBS29,d.WBS30,
               d.WBS31,d.WBS32,d.WBS33,d.WBS34,d.WBS35,d.WBS36,d.WBS37,d.WBS38,d.WBS39,d.WBS40,
               d.ConversionFactor AS AssemblyConversionFactor, i.ConversionFactor AS ItemConversionFactor
        FROM tblDBAssemblyDetails d
        LEFT OUTER JOIN tblPhaseItem i ON d.DivisionID=i.DivisionID AND d.Phase=i.Phase AND d.Item=i.Item
        LEFT OUTER JOIN tblPhaseItem iv ON i.DivisionID=iv.DivisionID AND i.inversePhase=iv.Phase AND i.inverseItem=iv.Item
        LEFT OUTER JOIN tblPOIndex p ON p.DivisionID=@DivisionID AND ISNULL(NULLIF(d.POIndex,''),ISNULL(i.POIndex,''))=p.POIndex
        LEFT OUTER JOIN appoptions o ON o.optionname='UseAltCostCodesForCO' AND o.DivisionID=d.DivisionID
        LEFT OUTER JOIN StandardCostCodes cc ON cc.DivisionID=i.DivisionID AND cc.costcode=ISNULL(CASE WHEN ISNULL(d.optionid,'')='' OR o.optionvalue='true' THEN i.jccostcode ELSE ISNULL(NULLIF(i.altjccostcode,''),i.jccostcode) END, p.jccostcode)
        LEFT OUTER JOIN StandardCategories ct ON ct.DivisionID=i.DivisionID AND ct.category=ISNULL(CASE WHEN ISNULL(d.optionid,'')='' OR o.optionvalue='true' THEN i.jccategory ELSE ISNULL(NULLIF(i.altjccategory,''),i.jccategory) END, p.jccategory)
        LEFT OUTER JOIN tblvendors v ON v.DivisionID=d.DivisionID AND v.vendor_id=dbo.Purch_GetCommunityVendor(@PricingCommunity,p.POIndex,@DivisionID)
        LEFT OUTER JOIN taxGroups t ON t.DivisionID=@DivisionID AND t.TaxGroup=dbo.Purch_GetDefaultTaxGroup('',@PricingCommunity,'',d.Model,d.Assembly,i.phase,i.item,v.Vendor_ID,i.JCCategory,@DivisionID)
        WHERE d.DivisionID=@DivisionID AND ISNULL(d.Community,'')=@Community AND ISNULL(d.Assembly,'')=@Assembly
              AND ISNULL(d.Model,'')=@Model AND ISNULL(d.Optionid,'')=@OptionID
        ORDER BY d.Phase, d.Item, d.itemchart, d.Sequence";

    private string BuildComponentsQuery() => @"
        SELECT m.assemblyid, m.community, m.assembly, m.model, m.optionid, m.description, c.qty,
               ROUND(SUM(
                 ISNULL(dbo.Purch_GetItemRate(0,0,@mPricingCommunity,@mPricingCommunityPhase,d.Assembly,d.Model,d.OptionID,d.Phase,d.Item,d.Sequence,v.Vendor_id,GETDATE(),d.DivisionID),0)
                 *(100+ISNULL(t.JCRate,0))/100
                 *ISNULL(d.OrderQty,0)
               ),2) AS Cost
        FROM tblDBAssemblyComponents c
        JOIN tblDBAssemblyMaster m ON c.componentassemblyid=m.assemblyid
        LEFT OUTER JOIN tblDBAssemblyDetails d ON m.assemblyid=d.assemblyid
        LEFT OUTER JOIN tblPhaseItem i ON d.DivisionID=i.DivisionID AND d.Phase=i.Phase AND d.Item=i.Item
        LEFT OUTER JOIN tblPOIndex p ON p.DivisionID=@DivisionID AND ISNULL(NULLIF(d.POIndex,''),ISNULL(i.POIndex,''))=p.POIndex
        LEFT OUTER JOIN tblvendors v ON v.DivisionID=d.DivisionID AND v.vendor_id=dbo.Purch_GetCommunityVendor(@mPricingCommunity,p.POIndex,@DivisionID)
        LEFT OUTER JOIN taxGroups t ON t.DivisionID=@DivisionID AND t.TaxGroup=dbo.Purch_GetDefaultTaxGroup('',@mPricingCommunity,'',d.Model,d.Assembly,i.phase,i.item,v.Vendor_ID,i.JCCategory,@DivisionID)
        WHERE c.ParentAssemblyid=@ParentAssemblyId
        GROUP BY m.assemblyid, m.community, m.assembly, m.model, m.optionid, m.description, c.qty
        ORDER BY m.assemblyid";

    // ═══════════════════════════════════════════════════════════════════════
    // ── Combo Loaders ────────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    private async Task LoadComboBoxes()
    {
        var divisionId = SessionState.DivisionID;
        var communitySql = @"
            SELECT DISTINCT c.Area + ' - ' + c.Description AS Text, c.Area AS Value
            FROM tblLocality c
            LEFT OUTER JOIN DivisionCommunities d ON d.Community = c.Area
            WHERE ISNULL(c.inactive, 0) = 0
              AND (@DivisionID IS NULL OR d.DivisionID = @DivisionID)
            ORDER BY Text";
        var communityDt = db.SqlExec(communitySql, new { DivisionID = divisionId > 0 ? (int?)divisionId : null });
        CommunityItems = communityDt.AsEnumerable()
            .Select(row => new ComboBoxItem
            {
                Text = row["Text"]?.ToString() ?? "",
                Value = row["Value"]?.ToString() ?? ""
            }).ToList();

        // Load locations
        var locDt = db.SqlExec("SELECT Description, Area FROM tblAreas ORDER BY Description");
        LocationItems = locDt.AsEnumerable().Select(row => new ComboBoxItem { Text = row["Description"]?.ToString() ?? "", Value = row["Area"]?.ToString() ?? "" }).ToList();

        LoadCategoryItems();

        // VB6 cboUOM (FAssembly.frm:1666): distinct AssemblyUOM for the division,
        // blank entry included, ordered ascending (HHM-593).
        try
        {
            var uomDt = db.SqlExec(
                "SELECT DISTINCT ISNULL(AssemblyUOM,'') AS UOM FROM tblDBAssemblyMaster WHERE DivisionID=@DivisionID ORDER BY 1",
                new { DivisionID = divisionId });
            UomOptions = uomDt.AsEnumerable().Select(r => r["UOM"]?.ToString() ?? "").ToList();
            if (UomOptions.Count == 0) UomOptions.Add("");
        }
        catch { /* non-critical */ }

        // VB6 LoadSeries (FAssembly.frm:1732-1737) fills cboSeries from tblSeries
        // (display = isnull(description,series), key = series), NOT from an
        // AppOption — a previous translation read HFApp.Options("Series"), which
        // has no DB row, leaving the dropdown permanently empty.
        // cboScheduleTemplate genuinely IS AppOptions-driven
        // (.ValueByName("ScheduleTemplates"), frm:1658) — GetAppOption (not the
        // indexer) because an unset option is "" → empty dropdown in VB6 too.
        LoadSeries();
        LoadScheduleTemplates(GetAppOption("ScheduleTemplates"));
        await LoadPricingCommunitiesAsync();
    }

    private void LoadCategoryItems()
    {
        try
        {
            // VB6 cboCategory (FAssembly.frm:1741): display isnull(description,category),
            // ordered by the DISPLAY text — not by the category code (HHM-593).
            var catDt = db.SqlExec("SELECT Category, ISNULL(Description, Category) AS Description FROM tblCategories WHERE ISNULL(Inactive,0)=0 ORDER BY ISNULL(Description, Category)");
            CategoryItems = catDt.AsEnumerable().Select(row => new ComboBoxItem { Text = row["Description"]?.ToString() ?? "", Value = row["Category"]?.ToString() ?? "" }).ToList();
        }
        catch { /* non-critical */ }
    }

    private void LoadSeries()
    {
        // VB6: LoadComboBox(cboSeries, db, "SELECT isnull(description,series),series,0
        //   FROM tblSeries where divisionid = <div> order by 1")
        var dt = db.SqlExec(
            "SELECT ISNULL(description, series) AS Text, series AS Value FROM tblSeries WHERE divisionid = @DivisionID ORDER BY 1",
            new { SessionState.DivisionID });
        SeriesItems = dt.AsEnumerable()
            .Select(row => new ComboBoxItem { Text = row["Text"]?.ToString() ?? "", Value = row["Value"]?.ToString() ?? "" })
            .ToList();
    }

    private void LoadScheduleTemplates(string templates)
    {
        ScheduleTemplateItems = templates.Split('|', StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).Where(x => !string.IsNullOrEmpty(x)).ToList();
    }

    private async Task LoadPricingCommunitiesAsync()
    {
        var divisionId = SessionState.DivisionID;
        var sql = @"SELECT c.Description, c.area + CHAR(2) AS Value, 0 AS SortOrder
                    FROM tbllocality c LEFT OUTER JOIN DivisionCommunities d ON d.Community=c.Area AND d.DivisionID=@DivisionID
                    WHERE ISNULL(c.inactive,0)=0 AND (@DivisionID IS NULL OR d.DivisionID=@DivisionID)
                    UNION
                    SELECT c.Description + ISNULL(' '+p.description,''), c.area+CHAR(2)+ISNULL(p.communityphase,'') AS Value, 0 AS SortOrder
                    FROM tbllocality c LEFT OUTER JOIN communityphase p ON c.area=p.community
                    LEFT OUTER JOIN DivisionCommunities d ON d.Community=c.Area AND d.DivisionID=@DivisionID
                    WHERE ISNULL(c.inactive,0)=0 AND (@DivisionID IS NULL OR d.DivisionID=@DivisionID)
                    ORDER BY Description";
        var rows = await db.QueryAsync(sql, new { DivisionID = divisionId > 0 ? (int?)divisionId : null });
        // Drop rows whose Description (the display text) is blank. A community with no
        // name — and, via the UNION, each of its phase rows — would otherwise render as
        // extra blank entries in the dropdown (one nameless community can yield 2-3
        // blanks). The ONLY blank entry should be the leading "none" item inserted below.
        PricingCommunities = rows
            .Where(row => !string.IsNullOrWhiteSpace(row["Description"]?.ToString()))
            .Select(row => new CommunityItem
            {
                PricingCommunityPhase = row["Description"]?.ToString() ?? "",
                PricingCommunity = row["Value"]?.ToString() ?? "",
                SortOrder = Convert.ToInt32(row["SortOrder"])
            }).OrderBy(x => x.PricingCommunityPhase).ToList();
        // No leading blank/"(none)" row — the dropdown lists only real communities.
        // The cleared state (no pricing community) is represented by an empty value,
        // which shows the "Select …" placeholder in the closed box.
    }

    private Task LoadModelComboForOptionsOnly()
    {
        var dt = db.SqlExec(@"SELECT DISTINCT model FROM tblDBAssemblyMaster WHERE ISNULL(IsBaseAssembly,0)=0 AND AssemblyType=0 AND DivisionID =@DivisionID ORDER BY model", new { SessionState.DivisionID });
        ModelItems = dt.AsEnumerable().Select(r => new ComboBoxItem { Text = r.Field<string>(0) ?? "", Value = r.Field<string>(0) ?? "" }).ToList();
        return Task.CompletedTask;
    }

    private Task LoadModelComboForAll()
    {
        var dt = db.SqlExec(@"SELECT DISTINCT model FROM tblDBAssemblyMaster WHERE AssemblyType=0 AND DivisionID =@DivisionID ORDER BY model", new { SessionState.DivisionID });
        ModelItems = dt.AsEnumerable().Select(r => new ComboBoxItem { Text = r.Field<string>(0) ?? "", Value = r.Field<string>(0) ?? "" }).ToList();
        return Task.CompletedTask;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── Helpers ──────────────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    public static int ToInt(string? str, int defaultValue = 0) =>
        string.IsNullOrWhiteSpace(str) ? defaultValue : int.TryParse(str.Trim(), out var result) ? result : defaultValue;

    private int ToIntDirect(object val) => val is DBNull || val == null ? 0 : Convert.ToInt32(val);
    private double ToDouble(object val) => val is DBNull || val == null ? 0 : Convert.ToDouble(val);
    private static long ToLongOrDefault(object? val, long defaultValue) =>
        val is DBNull || val == null ? defaultValue
        : long.TryParse(val.ToString(), out var r) ? r : defaultValue;
}
