    /// <summary>Marks the form as dirty whenever the user edits any header
    /// field (Description, Comments, Bedrooms, Style, etc.). Wired to header
    /// FlexKit controls via <c>@bind:after</c> or typed ValueChanged handlers. The Save
    /// toolbar button gates on <c>mDirty</c>, so this is what enables it
    /// after a header-field change — without this, only grid edits (which
    /// already set <c>mDirty</c> in OnGridCellSave / RecalculateAfterEdit /
    /// etc.) would un-grey the button.
    ///
    /// <c>@bind:after</c> only fires on user-driven changes, not on the
    /// initial property assignment LoadData performs, so loading an
    /// assembly does NOT accidentally mark the form dirty.</summary>
    private void MarkDirty()
    {
        mDirty = true;
    }

    private void RecalculateCosts()
    {
        AssemblyCost = ItemsData.Where(i => i.RowStatus != "delete").Sum(i => i.ExtendedAmount ?? 0);
        // Blank (not $0.00) without a pricing community — matches VB6, which only writes
        // the cost captions inside `If PricingCommunity <> ""` (HHM-168).
        AssemblyCostLabel = string.IsNullOrEmpty(PricingCommunity) ? "" : AssemblyCost.ToString("$#,##0.00");
        if (!string.IsNullOrEmpty(PricingCommunity))
        {
            ComponentCostLabel = ComponentCost.ToString("$#,##0.00");
            double total = Math.Round(AssemblyCost, 2) + Math.Round(ComponentCost, 2);
            TotalCostLabel = total == 0 ? "$.00" : total.ToString("$#,##0.00");
        }
        else
        {
            ComponentCostLabel = "";
            TotalCostLabel = "";
        }
    }

    /// <summary>
    /// VB6 parity: when the user edits a Component Qty (or any other cost
    /// driver later), <c>ComponentCost</c> needs to re-roll from the live
    /// grid data — it can't stay frozen at the value <see cref="LoadComponentsGridAsync"/>
    /// computed once at load time. Mirrors the inline sum in
    /// LoadComponentsGridAsync (line ~2263) so the totals card and the
    /// "Pricing (TotalCostLabel)" header chip both reflect the edit.
    /// </summary>
    private void RecalculateComponentCost()
    {
        ComponentCost = ComponentsData?.Sum(c => (c.Cost ?? 0) * c.Qty) ?? 0;
    }

    // ── Components grid event handlers ───────────────────────────────────
    //
    // Mirrors OnGridCellSave / OnTypeAheadCommit / OnCellEdit (Items grid)
    // for AssemblyComponentRow. GridControl writes the edited value into
    // args.Data via reflection BEFORE these fire, so we just need to:
    //   1. Flip mDirty so CanSave + the close-without-save guard activate.
    //   2. Recompute ComponentCost so the totals labels update.
    //   3. Re-render the grid + the totals panel.
    private async Task OnComponentsCellSave(CellSaveArgs<AssemblyComponentRow> args)
    {
        if (args?.Data == null) return;
        // VB6 SaveData (FAssembly.frm:3621-3628) persists a "dirty" component
        // with an UPDATE of qty on tblDBAssemblyComponents. Component add/remove
        // already persist immediately in this form, so we persist the qty edit
        // the same way (immediate UPDATE) keyed on parent+component assembly IDs.
        await PersistComponentQtyAsync(args.Data);
        RecalculateComponentCost();
        mDirty = true;
        RecalculateCosts();
        if (gComponents != null)
            await gComponents.Refresh();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>VB6 parity: UPDATE tblDBAssemblyComponents SET qty=… WHERE
    /// parentassemblyid=mAssemblyID AND componentassemblyid=row.AssemblyId
    /// (FAssembly.frm:3621-3628). No-op for unsaved parents / unresolved
    /// component IDs.</summary>
    private async Task PersistComponentQtyAsync(AssemblyComponentRow row)
    {
        if (row == null || mAssemblyID == 0 || row.AssemblyId == 0) return;
        try
        {
            await db.ExecuteAsync(@"
                UPDATE tblDBAssemblyComponents SET Qty=@Qty
                WHERE ParentAssemblyID=@Parent AND ComponentAssemblyID=@Child",
                new { row.Qty, Parent = mAssemblyID, Child = row.AssemblyId });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Persist component qty failed");
            Notifications.Error($"Could not save component qty: {ex.Message}");
        }
    }

    /// <summary>
    /// VB6 parity for multi-select fan-out (same UX as Items grid): when
    /// the user has multiple Component rows selected and types a value,
    /// GridControl raises OnTypeAheadCommit with the selection + the
    /// typed value. We push the value into every row's targeted field
    /// then run the same cost rollup as a single-cell save.
    /// </summary>
    private async Task OnComponentsTypeAheadCommit(TypeAheadCommitArgs<AssemblyComponentRow> args)
    {
        if (string.IsNullOrWhiteSpace(args.ColumnName))
            return;

        var field = args.ColumnName;

        if (!double.TryParse(args.Value, NumberStyles.Any,
                             CultureInfo.InvariantCulture, out var parsed))
        {
            return; // not a number — ignore (Qty is numeric-only)
        }

        var applied = 0;
        foreach (var record in args.SelectedItems)
        {
            if (string.Equals(field, nameof(AssemblyComponentRow.Qty), StringComparison.OrdinalIgnoreCase))
            {
                record.Qty = parsed;
                // Persist each fanned-out qty change (VB6 FAssembly.frm:3621-3628).
                await PersistComponentQtyAsync(record);
                applied++;
            }
            // Future editable columns land here as additional branches.
        }
        if (applied == 0) return;

        RecalculateComponentCost();
        mDirty = true;
        RecalculateCosts();

        await InvokeAsync(StateHasChanged);
    }

