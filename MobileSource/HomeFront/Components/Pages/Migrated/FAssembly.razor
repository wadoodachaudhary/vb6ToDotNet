    private int _instanceId;

    // Field max length = the DB column, derived at load (HHM-670 rule; FCommunities pattern).
    // Typing stops at the column's CHARACTER_MAXIMUM_LENGTH instead of failing at save with
    // a raw "String or binary data would be truncated" error.
    private readonly Dictionary<string, int> _masterColLen = new(StringComparer.OrdinalIgnoreCase);

    private int? MasterColLen(string column) =>
        _masterColLen.TryGetValue(column, out var len) ? len : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rows = await db.QueryAsync(
                @"SELECT COLUMN_NAME, CHARACTER_MAXIMUM_LENGTH
                  FROM INFORMATION_SCHEMA.COLUMNS
                  WHERE TABLE_NAME = @TableName AND CHARACTER_MAXIMUM_LENGTH > 0",
                new { TableName = "tblDBAssemblyMaster" });
            foreach (var r in rows)
            {
                var col = r.TryGetValue("COLUMN_NAME", out var c) ? c?.ToString() ?? "" : "";
                if (string.IsNullOrEmpty(col)) continue;
                if (!r.TryGetValue("CHARACTER_MAXIMUM_LENGTH", out var raw) || raw == null || raw == DBNull.Value) continue;
                if (int.TryParse(raw.ToString(), out var len) && len > 0) _masterColLen[col] = len;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Load tblDBAssemblyMaster column lengths");
        }
    }

    // Non-IHandleEvent receiver: an EventCallback created on it skips Blazor's
    // automatic post-event re-render of this page.
    private static readonly object _nonRenderingReceiver = new();

    protected override void OnInitialized()
    {
        _instanceId = Interlocked.Increment(ref _instanceCount);
        Console.WriteLine($"Instance #{_instanceId} created — URL: {NavigationManager.Uri}");

        gridEvents.OnCellSave = new EventCallback<CellSaveArgs<AssemblyItemRow>>(this, (Func<CellSaveArgs<AssemblyItemRow>, Task>)OnGridCellSave);
        gridEvents.OnTypeAheadCommit = new EventCallback<TypeAheadCommitArgs<AssemblyItemRow>>(this, (Func<TypeAheadCommitArgs<AssemblyItemRow>, Task>)OnTypeAheadCommit);
        gridEvents.TypeAheadChanged = EventCallback.Factory.Create<string>(this, _ => HideSumTip());
        // Compatibility fallback for any GridControl standard edit-button columns.
        // FAssembly's POIndex, Vendor, Notes, and Formula cells use explicit
        // poindex-cell templates so their popup buttons stay visually/behaviorally
        // identical and avoid the generic action-button hover path.
        gridEvents.OnEditButtonClick = new EventCallback<CellEditButtonArgs<AssemblyItemRow>>(this, (Func<CellEditButtonArgs<AssemblyItemRow>, Task>)OnGridEditButtonClick);

        // ── Components grid event wiring ─────────────────────────────────
        //
        // Same save/type-ahead callbacks as the Items grid, scoped to AssemblyComponentRow.
        // Without this pair, editing a Component Qty cell never reaches
        // the save pipeline: mDirty stays false (Save button greyed) and
        // ComponentCostLabel / TotalCostLabel never reflect the change.
        gridEventsComponents.OnCellSave = new EventCallback<CellSaveArgs<AssemblyComponentRow>>(this, (Func<CellSaveArgs<AssemblyComponentRow>, Task>)OnComponentsCellSave);
        gridEventsComponents.OnTypeAheadCommit = new EventCallback<TypeAheadCommitArgs<AssemblyComponentRow>>(this, (Func<TypeAheadCommitArgs<AssemblyComponentRow>, Task>)OnComponentsTypeAheadCommit);
        gridEventsComponents.TypeAheadChanged = EventCallback.Factory.Create<string>(this, _ => HideSumTip());
        // OnCellEdit fires when GridControl opens an editable cell for input.
        // We use it to dismiss lingering inline dropdowns when another editable
        // cell takes focus. The type-ahead target is now owned by GridControl.
        gridEvents.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<AssemblyItemRow>>(this, args =>
        {
            // VB6 gItems_ValidateEdit Price case (FAssembly.frm:2424-2428):
            // an "Item DB" row's price is not editable — VB6 sets Cancel =
            // True so the cell never accepts input. Mirror that by aborting
            // the edit here and surfacing the same message.
            if (string.Equals(args.ColumnName, "Price", StringComparison.OrdinalIgnoreCase)
                && args.Data.PriceLevel == "Item DB")
            {
                args.Cancel = true;
                _ = ShowItemDbPriceNotEditableAsync();
                return;
            }

            StateHasChanged();
        });
        // SelectionChangedDetailed fires during click, drag-select, Select All,
        // Clear, and Shift+Arrow. Use the source to keep the mouse-position
        // totals pill out of keyboard range selection.
        // Created on a receiver that is NOT a component, so the callback does not
        // trigger the implicit page-wide StateHasChanged — a drag-select fires this
        // once per row crossed, and re-rendering all of FAssembly (header controls +
        // both grids) per step is what made multi-select drag halt. The sum-tip path
        // calls StateHasChanged itself when the pill actually appears or hides.
        gridEvents.SelectionChangedDetailed = EventCallback.Factory.Create<GridSelectionChangedArgs>(_nonRenderingReceiver, async args =>
        {
            if (args.Source == GridSelectionChangeSource.Keyboard)
            {
                HideSumTip();
                return;
            }

            // VB6 gItems_SelChange parity: show a yellow info pill near the
            // cursor with summed OrderQty / Pretax / Tax / Total whenever the
            // selection holds 2+ rows. Debounced 150 ms so drag-select doesn't
            // flicker, auto-hides after 4 s, dismissed on click via the wrap
            // div's @onclick (or when the selection drops below 2).
            await UpdateSumTipForSelectionAsync(args.Count);
        });
        // All heavy work (DB calls, ShowForm) is deferred to OnAfterRenderAsync.
        // OnAfterRenderAsync only runs in the interactive context — never during SSR
        // prerendering — so this prevents phantom DB calls during the login screen.
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // One-time initialization: load combos + show form.
        // This only fires in the interactive circuit (not SSR prerender),
        // so no DB work happens until the user actually navigates here.
        if (!_initialized)
        {
            _initialized = true;
            await RefreshViewportHeightAsync();
            // VB6 HFApp.Options is already populated at login; here we load the
            // per-division AppOptions BEFORE LoadComboBoxes (which reads Series /
            // ScheduleTemplates) and before anything reads GetAppOption
            // (ShowImportButton, ValidateData ReqCategory). Deferred into the
            // interactive circuit with the rest of the DB work so no query runs
            // during SSR prerender.
            await LoadAppOptionsAsync();
            // VB6 FAssembly.frm:1617 — mUseComponents = Options.ValueByName("UseComponents")="true";
            // when false (e.g. division 14) the components grid is hidden (FAssembly.frm:3136).
            // Read AFTER the AppOptions load above (was previously hardcoded true).
            mUseComponents = string.Equals(GetAppOption("UseComponents"), "true", StringComparison.OrdinalIgnoreCase);
            await LoadComboBoxes();
            // Seed the MDI tab title before any data load lands — even an
            // empty FAssembly tab gets a meaningful caption.
            UpdatePageTitle();
            if (TryGetStartupAssemblyContext(out var startup))
            {
                await ShowForm(
                    community: startup.Community,
                    model: startup.Model,
                    optionId: startup.OptionID,
                    assembly: startup.Assembly,
                    assemblyDesc: startup.AssemblyDesc,
                    assemblyType: startup.AssemblyType);
            }
            else
            {
                await ShowForm();
            }
            StateHasChanged();
            return; // ShowForm sets _pendingOpenClick; it will fire on the next render
        }

        // VB6: When ShowForm is called with no parameters, it calls
        //      Toolbar_ButtonClick(Toolbar.Buttons("Open")) after LoadData.
        if (_pendingOpenClick)
        {
            _pendingOpenClick = false;
            await OnOpenClick();
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── ShowForm (VB6: ShowForm) ──────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    public async Task ShowForm(string community = "", string model = "", string optionId = "",
                               string assembly = "", string assemblyDesc = "",
                               AssemblyTypes assemblyType = AssemblyTypes.atModel)
    {
        // HHM-612: clear the FULL copy snapshot (incl. Option + Key) so no
        // stale Copy-of-current state survives into the next loaded assembly.
        mCopiedCommunity = "";
        mCopiedAssembly = "";
        mCopiedModel = "";
        mCopiedOption = "";
        mCopiedKey = "";
        mCopiedAssemblyID = 0;

        // VB6: If community & Model & OptionID & Assembly = "" And Not SaveAs Then
        //        ... Call LoadData : ReadOnly = True : Call Toolbar_ButtonClick(Toolbar.Buttons("Open"))
        if (string.IsNullOrEmpty(community) && string.IsNullOrEmpty(model)
            && string.IsNullOrEmpty(optionId) && string.IsNullOrEmpty(assembly))
        {
            mCommunity = "";
            mModel = "";
            mOptionID = "";
            mAssembly = "";
            mAssemblyDesc = "";
            mAssemblyType = AssemblyTypes.atModel;
            mDataSource = 0;
            // VB6 calls LoadData here to reset the grid, but since we immediately
            // open the picklist (_pendingOpenClick), the real LoadDataAsync runs
            // after the user selects an assembly. Skip it to avoid a redundant DB call.
            mReadOnly = true;
            // HHM-97: VB6's blank ShowForm path still runs LoadData, whose
            // child-component check on mAssemblyID=0 hits EOF and leaves
            // mComponentsEnabled = mUseComponents — so the legacy form paints
            // BOTH grids (an empty Components strip above the Items grid)
            // behind the Open picklist (FAssembly.frm:3132-3138 + 1845-1861).
            // The web skipped LoadDataAsync entirely, leaving only ONE grid
            // visible in the background. Load just the components layout/strip
            // (cheap — no master-row query) so the background matches legacy.
            mAssemblyID = 0;
            await LoadComponentsGridAsync();
            _pendingOpenClick = true; // will call OnOpenClick in OnAfterRenderAsync
        }
        else
        {
            mCommunity = community;
            mModel = model;
            mOptionID = optionId;
            mAssembly = assembly;
            mAssemblyDesc = assemblyDesc;
            mAssemblyType = assemblyType;

            // VB6: if this is a manual takeoff then assume it is a global
            if (mAssemblyType == AssemblyTypes.atCustomOption)
                mAssemblyType = AssemblyTypes.atGlobal;

            // VB6: ignore model if it's not model specific
            if (mAssemblyType == AssemblyTypes.atGlobal || mAssemblyType == AssemblyTypes.atDesignCenter)
                mModel = "";

            await LoadDataAsync();
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── LoadDataAsync (VB6: LoadData) ─────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    private async Task LoadDataAsync()
    {
        try
        {
            mReadOnly = false;
            AssemblyCostLabel = "";
            ComponentCostLabel = "";
            TotalCostLabel = "";

            if (mAssemblyType == AssemblyTypes.atoption)
                await LoadModelComboForOptionsOnly();
            else
                await LoadModelComboForAll();

            var masterQuery = @"
                SELECT AssemblyId, BillingFactor, BillingCode, BillingCategory, Community, AssemblyType, Model, Elevation,
                       OptionID, Assembly, Inactive, Description, Comments, Notes, Series, Style, AssemblyUOM,
                       Bedrooms, Bathrooms, FloorArea, ScheduleTemplate, MaxWidth, MaxLength, ConstCutoff,
                       SpecDocument, GraphicPath, Category, JCExtra, Qty, Location,
                       TakeoffRequired, UseNormalSalesQtyFactors, IsBaseAssembly, IncludedOption,
                       DesignCenterSalesOnly, SelectByRoom, DisplayTotalOnly,
                       Color, StyleValue, FinishValue, OtherValue,
                       ColorListID, StyleListID, FinishListID, OtherListID
                FROM tblDBAssemblyMaster m
                WHERE m.DivisionID = @DivisionID
                  AND ISNULL(m.Community,'') = @Community
                  AND ISNULL(m.Model,'') = @Model
                  AND ISNULL(m.OptionID,'') = @OptionID
                  AND ISNULL(m.Assembly,'') = @Assembly";
            var masterParams = new { SessionState.DivisionID, Community = mCommunity, Model = mModel, OptionID = mOptionID, Assembly = mAssembly };
            var masterDt = db.SqlExec(masterQuery, masterParams);

            if (masterDt.Rows.Count == 0)
            {
                // New assembly
                mAssemblyID = 0;
                CommunityValue = mCommunity;
                ModelValue = mModel;
                OptionValue = mOptionID;
                AssemblyCode = mAssembly;
                Description = mAssemblyDesc;
                IsActive = true;
                BillingFactor = 1.0;
                _billingCode = "";
                _billingCategory = "";
                _attrValues[0] = _attrValues[1] = _attrValues[2] = _attrValues[3] = "";
                _attrListIds[0] = _attrListIds[1] = _attrListIds[2] = _attrListIds[3] = -1;
                // VB6 no-record reset (FAssembly.frm:2807-2843) blanks every header
                // field so nothing leaks from the previously loaded assembly.
                SeriesValue = "";
                Elevation = "";
                StyleText = "";
                StyleValue = "";
                UOMValue = "";
                Bedrooms = null;
                Bathrooms = null;
                FloorArea = null;
                MaxWidth = null;
                MaxLength = null;
                ConstCutoff = null;
                AssemblyQty = 1.0;
                Comments = "";
                Notes = "";
                GraphicPath = "";
                SpecDocument = "";
                CategoryValue = "";
                LocationValue = "";
                ScheduleTemplateValue = "";
                JCExtra = "";
                IsBaseAssembly = false;
                IsIncludedOption = false;
                IsDCSalesOnly = false;
                IsSelectByRoom = false;
                IsDisplayTotalOnly = false;
                IsTakeoffRequired = false;
                // VB6 frm:2841 leaves this one CHECKED.
                UseNormalSalesQtyFactors = true;
                _communityEnabled = true;
                _modelEnabled = mAssemblyType == AssemblyTypes.atModel || mAssemblyType == AssemblyTypes.atoption;
                _optionEnabled = mAssemblyType != AssemblyTypes.atModel;
                _assemblyEnabled = true;
            }
            else
            {
                var row = masterDt.Rows[0];
                mAssemblyID = Convert.ToInt64(row["AssemblyId"]);
                mCommunity = row["Community"]?.ToString() ?? "";
                mAssemblyType = (AssemblyTypes)Convert.ToInt32(row["AssemblyType"]);
                CommunityValue = mCommunity;
                ModelValue = row["Model"]?.ToString();
                OptionValue = row["OptionID"]?.ToString() ?? "";
                ScheduleTemplateValue = row["ScheduleTemplate"]?.ToString() ?? "";
                Elevation = row["Elevation"]?.ToString() ?? "";
                AssemblyCode = row["Assembly"]?.ToString() ?? "";
                IsActive = (row["Inactive"]?.ToString() ?? "False") != "True";
                Description = row["Description"]?.ToString() ?? "";
                Comments = row["Comments"]?.ToString() ?? "";
                Notes = row["Notes"]?.ToString() ?? "";
                MaxWidth = ToDouble(row["MaxWidth"]);
                MaxLength = ToDouble(row["MaxLength"]);
                ConstCutoff = ToDouble(row["ConstCutoff"]);
                Bedrooms = ToDouble(row["Bedrooms"]);
                Bathrooms = ToDouble(row["Bathrooms"]);
                FloorArea = ToDouble(row["FloorArea"]);
                // HHM-173: load Series from the record — VB6 FAssembly.frm:2898
                // SetComboBoxListIndex(cboSeries, , "" & rs("Series")). This was
                // never assigned on load, so the Series dropdown always showed
                // blank and SaveData (Series = SeriesValue ?? "") silently wiped
                // the stored Series on every save of an existing assembly.
                SeriesValue = row["Series"]?.ToString() ?? "";
                StyleText = row["Style"]?.ToString() ?? "";
                UOMValue = row["AssemblyUOM"]?.ToString() ?? "";
                // HHM-593: VB6 SetComboBoxListIndex(cboCategory, , rs("Category"))
                // (FAssembly.frm:2908 → MMain.bas:3311-3349) is a KEY lookup —
                // an empty key skips the lookup and an unmatched key falls
                // through to ListIndex = -1, so legacy shows a BLANK Cat/SubCat.
                // The web dropdown otherwise displays the raw stored key even
                // when it isn't in tblCategories, so blank it here the way VB6
                // did (GetComboBoxListKey then saves '' — same round-trip).
                var loadedCategory = row["Category"]?.ToString() ?? "";
                CategoryValue = string.IsNullOrEmpty(loadedCategory)
                    ? ""
                    : CategoryItems.FirstOrDefault(c => string.Equals(c.Value, loadedCategory, StringComparison.OrdinalIgnoreCase))?.Value ?? "";
                JCExtra = row["JCExtra"]?.ToString() ?? "";
                AssemblyQty = ToDouble(row["Qty"]);
                // HHM-593: VB6 shows Val(Qty) verbatim on load — a stored 0 stays 0.
                // (The new/reset path already defaults Qty to 1 like txtQty.Text = "1".)
                LocationValue = row["Location"]?.ToString() ?? "";
                BillingFactor = ToDouble(row["BillingFactor"]);
                if (BillingFactor == 0) BillingFactor = 1;
                _billingCode = row["BillingCode"]?.ToString() ?? "";
                _billingCategory = row["BillingCategory"]?.ToString() ?? "";
                // VB6 attribute round-trip (load): Color/Style/Finish/Other + list IDs.
                _attrValues[0] = row["Color"]?.ToString() ?? "";
                _attrValues[1] = row["StyleValue"]?.ToString() ?? "";
                _attrValues[2] = row["FinishValue"]?.ToString() ?? "";
                _attrValues[3] = row["OtherValue"]?.ToString() ?? "";
                _attrListIds[0] = ToLongOrDefault(row["ColorListID"], -1);
                _attrListIds[1] = ToLongOrDefault(row["StyleListID"], -1);
                _attrListIds[2] = ToLongOrDefault(row["FinishListID"], -1);
                _attrListIds[3] = ToLongOrDefault(row["OtherListID"], -1);
                SpecDocument = row["SpecDocument"]?.ToString() ?? "";
                GraphicPath = row["GraphicPath"]?.ToString() ?? "";
                IsTakeoffRequired = row["TakeoffRequired"]?.ToString() == "True";
                UseNormalSalesQtyFactors = row["UseNormalSalesQtyFactors"]?.ToString() == "True";
                IsBaseAssembly = row["IsBaseAssembly"]?.ToString() == "True";
                IsIncludedOption = row["IncludedOption"]?.ToString() == "True";
                IsDCSalesOnly = row["DesignCenterSalesOnly"]?.ToString() == "True";
                IsSelectByRoom = row["SelectByRoom"]?.ToString() == "True";
                IsDisplayTotalOnly = row["DisplayTotalOnly"]?.ToString() == "True";
                _communityEnabled = mDataSource == 1;
                _modelEnabled = mDataSource == 1;
                _optionEnabled = mDataSource == 1;
                _assemblyEnabled = mDataSource == 1;
            }

            await LoadItemsGridAsync();
            await LoadComponentsGridAsync();
            SyncAssemblyRouteState();
            // Re-push the caption to MdiHost (HHM-607 owner directive:
            // "Model & Option — <model name>", so it must track the model
            // just loaded; blank-model loads drop the suffix).
            UpdatePageTitle();

            if (!string.IsNullOrEmpty(PricingCommunity))
            {
                ComponentCostLabel = ComponentCost.ToString("$#,##0.00");
                double total = Math.Round(AssemblyCost, 2) + Math.Round(ComponentCost, 2);
                TotalCostLabel = total == 0 ? "$.00" : total.ToString("$#,##0.00");
            }
            else
            {
                TotalCostLabel = "";
            }

            await InvokeAsync(StateHasChanged);
            mDirty = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── LoadItemsGridAsync (VB6: LoadData items portion) ──────────────────
    // ═══════════════════════════════════════════════════════════════════════
    private async Task LoadItemsGridAsync()
    {
        await LoadItemsGridLayoutAsync();

        var itemsQuery = string.IsNullOrEmpty(PricingCommunity)
            ? BuildItemsQuery_NoPricing()
            : BuildItemsQuery_WithPricing();

        var dt = db.SqlExec(itemsQuery, new
        {
            SessionState.DivisionID,
            Community = mCommunity?.Trim() ?? "",
            Model = mModel?.Trim() ?? "",
            OptionID = mOptionID?.Trim() ?? "",
            Assembly = mAssembly?.Trim() ?? "",
            PricingCommunity = mPricingCommunity?.Trim() ?? "",
            PricingCommunityPhase = mPricingCommunityPhase?.Trim() ?? ""
        });

        var items = new List<AssemblyItemRow>();
        AssemblyCost = 0;
        foreach (DataRow row in dt.Rows)
        {
            var isQuote = row["IsQuote"]?.ToString() == "True";
            var item = new AssemblyItemRow
            {
                Sequence = (int)row["sequence"],
                Phase = row["Phase"]?.ToString() ?? "",
                Item = row["Item"]?.ToString() ?? "",
                ItemNumber = row["itemnumber"]?.ToString() ?? "",
                ItemChart = row["itemchart"]?.ToString() ?? "",
                Description = row["Description"]?.ToString() ?? "",
                TakeoffUOM = row["TakeoffUOM"]?.ToString() ?? "",
                OrderUOM = row["OrderUOM"]?.ToString() ?? "",
                Formula = row["Formula"]?.ToString() ?? "",
                TakeoffQty = ToDouble(row["TakeoffQty"]),
                OrderQty = ToDouble(row["OrderQty"]),
                WastePercent = ToDouble(row["WastePercent"]),
                RoundTo = ToDouble(row["RoundTo"]),
                RoundDir = ToIntDirect(row["RoundDir"]),
                Notes = row["notes"]?.ToString() ?? "",
                Location = row["Location"]?.ToString() ?? "",
                IsQuote = isQuote,
                ItemType = isQuote ? "Quote" : "Unit Price",
                OldItemType = isQuote ? "Quote" : "Unit Price",
                HasInverseItem = ToIntDirect(row["hasInverseItem"]),
                Invertable = row["Invertable"]?.ToString() == "True" && ToIntDirect(row["hasInverseItem"]) == 1,
                UseModelCost = row["UseModelCost"]?.ToString() == "True",
                POIndex = row["POIndex"]?.ToString() ?? "",
                POIndexDescription = row["POIndexDescription"]?.ToString() ?? "",
                JCCostCode = row["JCCostCode"]?.ToString() ?? "",
                JCCostCodeDesc = row["JCCostCodeDesc"]?.ToString() ?? "",
                JCCategory = row["JCCategory"]?.ToString() ?? "",
                JCCategoryDesc = row["JCCategoryDesc"]?.ToString() ?? "",
                AssemblyConversionFactor = ToDouble(row["AssemblyConversionFactor"]),
                ItemConversionFactor = ToDouble(row["ItemConversionFactor"]),
                RowStatus = "" // loaded from DB
            };

            for (var i = 1; i <= 40; i++)
                item.WBS[i] = row[$"WBS{i:D2}"]?.ToString() ?? "";

            if (!string.IsNullOrEmpty(PricingCommunity))
            {
                var quality = ToIntDirect(row["RateQuality"]);
                SetPriceLevelFromQuality(item, quality);
                item.Price = ToDouble(row["Rate"]);
                item.TaxRate = ToDouble(row["JCTaxRate"]) / 100;
                item.PretaxAmount = item.Price * item.OrderQty;
                item.TaxAmount = item.PretaxAmount * item.TaxRate;
                item.ExtendedAmount = item.PretaxAmount + item.TaxAmount;
                AssemblyCost += item.ExtendedAmount ?? 0;
                item.Vendor = row["Vendor"]?.ToString() ?? "";
                item.VendorDesc = row["VendorDesc"]?.ToString() ?? "";
                item.OldPriceLevel = item.PriceLevel;
                item.OldItemType = item.ItemType;
            }
            else
            {
                item.ItemType = item.IsQuote ? "Quote" : "Unit Price";
            }
            items.Add(item);
        }
        ItemsData = items;
        _deletedItems.Clear();
        // VB6 sets lblAssemblyCost ONLY inside the `If PricingCommunity <> ""` block
        // (FAssembly.frm:3083) — with no pricing community the label stays BLANK, not
        // "$0.00" (HHM-168: zero and blank mean different things to the estimator).
        AssemblyCostLabel = string.IsNullOrEmpty(PricingCommunity) ? "" : AssemblyCost.ToString("$#,##0.00");
    }

    /// <summary>The VB6 factory-default gItems columns (AppGridLayout uid=char(1),
    /// visible set + twip widths) as a last-resort layout when the DB holds no
    /// usable layout at all. Field names are AssemblyItemRow properties.</summary>
    private static Dictionary<string, GridLayoutColumn> BuildItemsBuiltInDefaultLayout()
    {
        var defs = new (string Field, string Caption, double Width)[]
        {
            ("Phase", "Phase", 1185),
            ("POIndex", "PO Index", 3000),
            ("Item", "Item", 975),
            ("Description", "Description", 2355),
            ("VendorDesc", "Vendor Name", 1710),
            ("TakeoffUOM", "Takeoff UOM", 1125),
            ("TakeoffQty", "Takeoff Qty", 1245),
            ("Price", "Price", 915),
            ("ExtendedAmount", "Ext Amt", 1110),
            ("ItemType", "Item Type", 1035),
            ("PriceLevel", "Price Level", 2400),
            ("PretaxAmount", "Pretax Amt", 960),
            ("TaxAmount", "Tax", 960),
        };
        var layout = new Dictionary<string, GridLayoutColumn>(StringComparer.OrdinalIgnoreCase);
        for (int i = 0; i < defs.Length; i++)
        {
            layout[defs[i].Field] = new GridLayoutColumn
            {
                Field = defs[i].Field,
                Caption = defs[i].Caption,
                Width = defs[i].Width,
                ColIndex = i,
                Hidden = false
            };
        }
        return layout;
    }

    private async Task LoadItemsGridLayoutAsync()
    {
        // Canonical gridname is FAssembly.gItems (no .(0) suffix). The user
        // expects this query to return all rows — fallback should NOT trigger
        // here. If it does, ItemsGridLayoutFallbackUsed surfaces it in the title.
        // The load/resolve/order boilerplate + Version bump live in the presenter
        // (its ctor was given the "FAssembly"/"gItems" names + grouped:true).
        await _itemsGrid.LoadAsync(GridLayoutSvc);
        // Belt-and-braces: gItems renders ONLY layout-driven columns (no markup
        // fallback branch), so an empty layout — e.g. every stored layout
        // corrupted to all-hidden and no usable default — would paint a
        // headerless grid. Inject the VB6 factory-default visible set
        // (AppGridLayout uid=char(1)) so the grid always has columns.
        if (!_itemsGrid.Has)
        {
            Logger.LogWarning("FAssembly.gItems: no usable layout from any source — using built-in default columns");
            _itemsGrid.SetLayout(BuildItemsBuiltInDefaultLayout());
        }
        Logger.LogInformation(
            "FAssembly.gItems load: {RowCount} dict entries, fallback={Fallback}",
            ItemsGridLayout.Count, ItemsGridLayoutFallbackUsed);

        // Factory-default (char(1)/uid='') template for the SAME grid — drives the
        // Choose Columns "Restore Default Layout" button (VB6 RestoreDefaultLayout,
        // where uid = char(1)). Canonical tag is "FAssembly.gItems" (no subscript).
        ItemsDefaultLayout = await GridLayoutSvc.GetDefaultLayoutAsync("FAssembly", "gItems", grouped: true);

        await ApplyVB6ColumnHeadersAsync();
        ApplyVB6EditableColumnGates();

        ItemsGridGroupColumns = BuildItemsGridGroupColumns();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── VB6 column headers (FAssembly.frx gItems FormatString) ─────────────
    // ═══════════════════════════════════════════════════════════════════════
    // In VB6 the gItems header row is part of the FORM: the grid is created with
    // this caption list baked into its FormatString, and AppGridLayout only ever
    // rides on top of it. We had no equivalent, so a caption-less or stale
    // AppGridLayout row was all we had to show — hence "JCCategory" instead of
    // "Category", "JCCategoryDesc" instead of "Category Desc", and a Cost Code
    // Desc column that vanished entirely because its stored caption is blank.
    // Captions below are transcribed from FAssembly.frx verbatim (note VB6's own
    // spelling: "Invertible", and "Total" for the extended amount).
    private static readonly Dictionary<string, string> VB6ItemsGridHeaders = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Phase"] = "Phase",
        ["Item"] = "Item",
        ["Item(chart"] = "Item Chart",
        ["ItemChart"] = "Item Chart",
        ["Description"] = "Description",
        ["Invertable"] = "Invertible",
        ["Formula"] = "Formula",
        ["UseModelCost"] = "Use Model Cost",
        ["TakeoffQty"] = "Takeoff Qty",
        ["TakeoffUOM"] = "Takeoff UOM",
        ["OrderQty"] = "Order Qty",
        ["OrderUOM"] = "Order UOM",
        ["POIndex"] = "PO Index",
        ["JCCostCode"] = "Cost Code",
        ["JCCostCodeDesc"] = "Cost Code Desc",
        ["JCCategory"] = "Category",
        ["JCCategoryDesc"] = "Category Desc",
        ["ItemConversionFactor"] = "Item Conversion Factor",
        ["AssemblyConversionFactor"] = "Conversion Factor",
        ["Vendor"] = "Vendor",
        ["VendorDesc"] = "Vendor Name",
        ["ItemType"] = "Item Type",
        ["PriceLevel"] = "Price Level",
        ["Price"] = "Price",
        ["Location"] = "Location",
        ["PretaxAmount"] = "Pretax",
        ["TaxAmount"] = "Tax",
        ["ExtendedAmount"] = "Total",
        ["ItemNumber"] = "Item Number",
        ["Notes"] = "Notes",
    };

    /// <summary>
    /// Give every gItems column the header VB6's form gives it, and derive the WBS
    /// headers the way VB6 does at runtime.
    ///
    /// VB6 (FAssembly.frm LoadWBSDescriptions) adds WBS01..WBS40 caption-less and
    /// hidden, then names + reveals ONLY the slots that have a row in
    /// customDescriptions. A slot nobody has named has no caption, so the Choose
    /// Columns dialog skips it (FColumns.frm:367) — which is why "Bid Item" (the
    /// stale saved caption for WBS01) shows here but not in legacy.
    /// </summary>
    private Task ApplyVB6ColumnHeadersAsync()
    {
        if (!_itemsGrid.Has) return Task.CompletedTask;

        // WBS captions are live data, not layout state — read them the same way VB6 does.
        var wbsNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        try
        {
            var rows = db.SqlExec(
                "SELECT Item, custom_description FROM customDescriptions " +
                "WHERE Item LIKE 'WBS__' AND ISNULL(custom_description,'') <> ''");
            foreach (System.Data.DataRow r in rows.Rows)
                wbsNames[r["Item"]?.ToString()?.Trim() ?? ""] = r["custom_description"]?.ToString()?.Trim() ?? "";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "FAssembly.gItems: customDescriptions lookup for WBS headers failed");
        }

        foreach (var col in ItemsGridLayout.Values)
        {
            var key = col.Field ?? "";
            if (key.StartsWith("WBS", StringComparison.OrdinalIgnoreCase))
            {
                // Named slot → its custom description; unnamed → no caption (so it is
                // neither shown nor offered), exactly as legacy leaves it.
                col.Caption = wbsNames.TryGetValue(key, out var wbsName) ? wbsName : "";
            }
            else if (VB6ItemsGridHeaders.TryGetValue(key, out var header))
            {
                col.Caption = header;
            }
        }

        return Task.CompletedTask;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── VB6 editable-column list (FAssembly.frm gItems_BeforeEdit) ──────
    // ═══════════════════════════════════════════════════════════════════════
    // The VB6 source uses `Select Case ... Case Else: Cancel = True` —
    // anything not named in a Case arm is read-only. The arms are:
    //
    //  Universally editable: AssemblyConversionFactor, ItemType, OrderQty,
    //    TakeoffQty, Notes, Formula, POIndex, Location, WBS01..WBS40
    //
    //  Conditionally editable (page-wide gate):
    //    Invertable      — VB6 also gates per-row on `HasInverseItem = 1`
    //    Price           — requires PricingCommunity ≠ "" (per-row also
    //                       checks ItemType ≠ "" AND PriceLevel ≠ "")
    //    PriceLevel      — requires PricingCommunity ≠ ""
    //    Vendor          — requires PricingCommunity ≠ ""
    //    VendorDesc      — requires PricingCommunity ≠ ""
    //    UseModelCost    — requires mAssemblyType = atoption
    //
    // Per-row gates are intentionally NOT enforced at the column level
    // (they need per-cell templates / runtime checks — added separately).
    // Here we only flip the column's `IsEditable` bit based on the
    // page-wide state so the cell accepts edits at all. The render path
    // (line ~563) then translates IsEditable → GridColumn.AllowEditing.
    //
    // Called from LoadItemsGridLayoutAsync on initial load AND from
    // OnPriceCommunityChanged whenever the pricing-community selection
    // changes (Price / PriceLevel / Vendor / VendorDesc flip in/out).
    private void ApplyVB6EditableColumnGates()
    {
        var pricingActive = !string.IsNullOrEmpty(PricingCommunity);
        var isOption = mAssemblyType == AssemblyTypes.atoption;

        void Flip(string field, bool editable = true)
        {
            if (ItemsGridLayout.TryGetValue(field, out var col))
                col.IsEditable = editable;
        }

        // ── Unconditional ─────────────────────────────────────────────
        Flip("AssemblyConversionFactor");
        // VB6 gItems_BeforeEdit allows the assembly-level conversion factor
        // to edit. ItemConversionFactor remains read-only because it is the
        // item master-data value from tblPhaseItem.

        Flip("ItemType");
        Flip("OrderQty");
        Flip("TakeoffQty");
        Flip("Notes");
        Flip("Formula");
        Flip("POIndex");
        Flip("Location");
        for (int i = 1; i <= 40; i++)
        {
            // VB6 columns are WBS01..WBS40 (zero-padded). Match that exact
            // casing so the dictionary lookup (case-insensitive) finds the
            // layout entry without ambiguity.
            Flip($"WBS{i:D2}");
        }

        // ── Conditional on page-wide state ───────────────────────────
        Flip("Invertable");                       // VB6 also gates per-row on HasInverseItem == 1
        Flip("Price", pricingActive);
        Flip("PriceLevel", pricingActive);
        Flip("Vendor", pricingActive);
        Flip("VendorDesc", pricingActive);
        Flip("UseModelCost", isOption);
    }

