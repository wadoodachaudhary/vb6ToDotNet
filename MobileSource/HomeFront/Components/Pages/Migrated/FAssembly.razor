    // ── Takeoff modal launch ────────────────────────────────────────
    // VB6: Call FTakeoff.Takeoff(Me, …) opens FTakeoff modally over the
    // assembly editor. POC originally navigated to /takeoff which unmounted
    // FAssembly entirely — now we render FTakeoff as a child component with
    // IsModal=true so FAssembly stays behind. _showTakeoffModal flips the
    // visibility flag; _takeoffMode captures which button was pressed.
    private void OnTakeoffItem()      => OpenTakeoffModal("Item");
    private void OnTakeoffAssembly()  => OpenTakeoffModal("Assembly");
    private void OnTakeoffPlanSwift() => OpenTakeoffModal("PlanSwift");

    private void OpenTakeoffModal(string mode)
    {
        if (mReadOnly) return;
        // Non-Custom entries never carry a pre-picked file; stale values
        // from an earlier Custom import must not leak into this launch.
        _takeoffInitialFileName = null;
        _takeoffInitialFileContent = null;
        _takeoffMode = mode;
        _showTakeoffModal = true;
    }

    // ── Custom takeoff entry (HHM-236) ──────────────────────────────────
    // VB6 FTakeoff.frm:1706: clicking Custom fires VBGetOpenFileName FIRST
    // and only proceeds into the import when the user picks a file (cancel
    // = no-op, no window opens). The web equivalent: the toolbar Custom
    // control is a <label for> over a hidden InputFile, so the click opens
    // the browser's native file picker directly; this OnChange handler is
    // the "user picked a file" continuation. The IBrowserFile stream is
    // only readable while this event is in flight, so the text content is
    // read here and handed to FTakeoff (InitialCustomFile* parameters)
    // which parses it on open — the modal appears with the file already
    // imported instead of showing an in-panel browse control.
    private readonly string _customTakeoffInputId = $"customTakeoff-{Guid.NewGuid():N}";
    private int _customTakeoffInputKey;
    private string? _takeoffInitialFileName;
    private string? _takeoffInitialFileContent;

    private async Task OnCustomTakeoffFileSelected(InputFileChangeEventArgs e)
    {
        if (mReadOnly) return;
        var file = e.File;
        if (file == null) return;

        string? content = null;
        var ext = (Path.GetExtension(file.Name) ?? "").ToLowerInvariant();
        if (ext == ".txt" || ext == ".csv")
        {
            try
            {
                const long maxBytes = 8L * 1024 * 1024; // same cap as FTakeoff
                await using var stream = file.OpenReadStream(maxBytes);
                using var reader = new StreamReader(stream);
                content = await reader.ReadToEndAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Custom takeoff file read failed");
                content = null; // FTakeoff surfaces the read failure in-panel
            }
        }
        // Non-text extensions (.pee/.xls/.xlsx) pass content=null — FTakeoff
        // shows its existing "not yet supported in the web client" status.

        _customTakeoffInputKey++;   // fresh <InputFile> next render so the
                                    // same file can be re-picked later
        _takeoffInitialFileName = file.Name;
        _takeoffInitialFileContent = content;
        _takeoffMode = "Custom";
        _showTakeoffModal = true;
    }

    private void OnTakeoffModalClosed()
    {
        _showTakeoffModal = false;
        // Drop the pre-picked Custom file so a later takeoff launch starts
        // clean (FTakeoff re-instantiates per open via the @if).
        _takeoffInitialFileName = null;
        _takeoffInitialFileContent = null;
        // No LoadDataAsync here any more — that would re-query the DB and
        // wipe the in-memory rows OnTakeoffItemsCommitted just staged with
        // RowStatus="new". The user persists them by clicking Save (which
        // INSERTs via BuildItemInsertSql). RefreshVendorPrice runs against
        // the staged rows when the user has a pricing community set.
    }

    /// <summary>
    /// VB6 parity: FTakeoff.frm:1590 — <c>Call mParentForm.AddItem(...)</c>.
    /// FTakeoff has filtered zero-qty rows and now hands us the kept set;
    /// we translate each <c>TakeoffItemRow</c> into an <c>AssemblyItemRow</c>
    /// with <c>RowStatus="new"</c> so the existing SaveData flow INSERTs
    /// them into tblDBAssemblyDetails via BuildItemInsertSql / BuildItemParams
    /// on the next user-driven Save.
    ///
    /// Pricing fields (Price / Vendor / PriceLevel / ItemType / tax) are
    /// intentionally NOT seeded from the takeoff row — VB6's FAssembly
    /// branch (line 1508 in FTakeoff.frm) also skipped those because the
    /// price reload runs on the next LoadDataAsync via
    /// dbo.Purch_GetItemRate / Purch_GetItemRateQuality from the user's
    /// current PricingCommunity. Until then the rows render with their
    /// structural data (Phase / Item / Notes / Formula / qty / UOM / WBS)
    /// and the price columns blank — matching VB6's "staged but not yet
    /// priced" intermediate state.
    /// </summary>
    private async Task OnTakeoffItemsCommitted(List<FTakeoff.TakeoffItemRow> rows)
    {
        if (rows == null || rows.Count == 0) return;

        var staged = new List<AssemblyItemRow>(rows.Count);
        foreach (var r in rows)
        {
            var item = new AssemblyItemRow
            {
                Sequence = 0, // 0 → INSERT (BuildItemInsertSql) on Save
                Phase = r.Phase ?? "",
                Item = r.Item ?? "",
                ItemNumber = r.ItemNumber ?? "",
                ItemChart = r.ItemChart ?? "",
                Description = r.Description ?? "",
                TakeoffUOM = r.TakeoffUOM ?? "",
                OrderUOM = r.OrderUOM ?? "",
                Formula = r.RawFormula ?? "",
                TakeoffQty = r.TakeoffQty,
                OrderQty = r.OrderQty,
                WastePercent = r.WastePercent ?? 0,
                Notes = r.Notes ?? "",
                Location = r.Location ?? "",
                POIndex = r.POIndex ?? "",
                JCCostCode = r.JCCostCode ?? "",
                JCCostCodeDesc = r.JCCostCodeDesc ?? "",
                JCCategory = r.JCCategory ?? "",
                JCCategoryDesc = r.JCCategoryDesc ?? "",
                // Legacy leaves Item Type blank on a newly staged row. It is
                // derived from IsQuote when the saved row is loaded again.
                ItemType = "",
                // The takeoff value is the assembly-detail conversion override.
                // ItemConversionFactor remains the independent tblPhaseItem value.
                AssemblyConversionFactor = r.ConversionFactor == 0 ? 1 : r.ConversionFactor,
                ItemConversionFactor = r.ItemConversionFactor,
                RoundTo = r.RoundTo,
                RoundDir = (int)r.RoundDir,
                RowStatus = "new",
            };
            // Copy the WBS slots 1..40 across. VB6 carried these one-to-one.
            for (int w = 1; w <= 40; w++)
            {
                if (r.WBS != null && r.WBS.TryGetValue(w, out var val) && !string.IsNullOrEmpty(val))
                    item.WBS[w] = val;
            }
            ItemsData.Add(item);
            staged.Add(item);
        }

        await FillPOIndexDescriptionsAsync(staged);

        mDirty = true;
        RecalculateCosts();

        // If the user has a pricing community selected, refresh the
        // rate/quality lookup for the new rows so Price / PriceLevel /
        // ItemType light up immediately. Otherwise those columns stay
        // blank until pricing is set (matches VB6 deferred-pricing
        // behavior). RefreshVendorPriceAsync skips rows with no Vendor
        // (which all new takeoff rows have), so this is a no-op until the
        // user picks vendors — but cheap to call defensively.
        if (!string.IsNullOrEmpty(PricingCommunity))
            await RefreshVendorPriceAsync(staged);

        if (gItems != null) await gItems.Refresh();
        await InvokeAsync(StateHasChanged);
    }

    // The PO Index cell shows tblPOIndex.FullDescription; a staged row carries
    // only the code, so look the descriptions up the way the load query does.
    private async Task FillPOIndexDescriptionsAsync(List<AssemblyItemRow> rows)
    {
        var codes = rows
            .Where(r => !string.IsNullOrWhiteSpace(r.POIndex) && string.IsNullOrWhiteSpace(r.POIndexDescription))
            .Select(r => r.POIndex!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (codes.Count == 0) return;

        try
        {
            var names = codes.Select((_, i) => $"@p{i}").ToList();
            var ps = new Dictionary<string, object> { ["DivisionID"] = SessionState.DivisionID };
            for (int i = 0; i < codes.Count; i++) ps[$"p{i}"] = codes[i];

            var dt = db.SqlExec(
                $"SELECT POIndex, FullDescription FROM tblPOIndex " +
                $"WHERE DivisionID = @DivisionID AND POIndex IN ({string.Join(",", names)})", ps);

            var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (System.Data.DataRow d in dt.Rows)
                map[d["POIndex"]?.ToString() ?? ""] = d["FullDescription"]?.ToString() ?? "";

            foreach (var r in rows)
                if (!string.IsNullOrWhiteSpace(r.POIndex)
                    && string.IsNullOrWhiteSpace(r.POIndexDescription)
                    && map.TryGetValue(r.POIndex!.Trim(), out var full))
                    r.POIndexDescription = full;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "FillPOIndexDescriptions");
        }
    }

