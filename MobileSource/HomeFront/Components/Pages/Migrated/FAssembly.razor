    // ═══════════════════════════════════════════════════════════════════════
    // ── LoadItemsGridAsync (VB6: LoadData items portion) ──────────────────
    // ═══════════════════════════════════════════════════════════════════════
    private async Task LoadItemsGridAsync()
    {
        await LoadItemsGridLayoutAsync();

        var itemsQuery = string.IsNullOrEmpty(PricingCommunity)
            ? BuildItemsQuery_NoPricing()
            : BuildItemsQuery_WithPricing();

        var dt = db.SqlExec(itemsQuery, new
        {
            DivisionID = AppState_DivisionID,
            Community = mCommunity?.Trim() ?? "",
            Model = mModel?.Trim() ?? "",
            OptionID = mOptionID?.Trim() ?? "",
            Assembly = mAssembly?.Trim() ?? "",
            PricingCommunity = mPricingCommunity?.Trim() ?? "",
            PricingCommunityPhase = mPricingCommunityPhase?.Trim() ?? ""
        });

        var items = new List<AssemblyItemRow>();
        AssemblyCost = 0;
        foreach (DataRow row in dt.Rows)
        {
            var item = new AssemblyItemRow
            {
                Sequence = (int)row["sequence"],
                Phase = row["Phase"]?.ToString() ?? "",
                Item = row["Item"]?.ToString() ?? "",
                ItemNumber = row["itemnumber"]?.ToString() ?? "",
                ItemChart = row["itemchart"]?.ToString() ?? "",
                Description = row["Description"]?.ToString() ?? "",
                TakeoffUOM = row["TakeoffUOM"]?.ToString() ?? "",
                OrderUOM = row["OrderUOM"]?.ToString() ?? "",
                Formula = row["Formula"]?.ToString() ?? "",
                TakeoffQty = ToDouble(row["TakeoffQty"]),
                OrderQty = ToDouble(row["OrderQty"]),
                WastePercent = ToDouble(row["WastePercent"]),
                RoundTo = ToDouble(row["RoundTo"]),
                RoundDir = ToIntDirect(row["RoundDir"]),
                Notes = row["notes"]?.ToString() ?? "",
                Location = row["Location"]?.ToString() ?? "",
                IsQuote = row["IsQuote"]?.ToString() == "True",
                HasInverseItem = ToIntDirect(row["hasInverseItem"]),
                Invertable = row["Invertable"]?.ToString() == "True" && ToIntDirect(row["hasInverseItem"]) == 1,
                UseModelCost = row["UseModelCost"]?.ToString() == "True",
                POIndex = row["POIndex"]?.ToString() ?? "",
                POIndexDescription = row["POIndexDescription"]?.ToString() ?? "",
                JCCostCode = row["JCCostCode"]?.ToString() ?? "",
                JCCategory = row["JCCategory"]?.ToString() ?? "",
                AssemblyConversionFactor = ToDouble(row["AssemblyConversionFactor"]),
                ItemConversionFactor = ToDouble(row["ItemConversionFactor"]),
                RowStatus = "" // loaded from DB
            };

            for (var i = 1; i <= 40; i++)
                item.WBS[i] = row[$"WBS{i:D2}"]?.ToString() ?? "";

            if (!string.IsNullOrEmpty(PricingCommunity))
            {
                var quality = ToIntDirect(row["RateQuality"]);
                SetPriceLevelFromQuality(item, quality);
                item.Price = ToDouble(row["Rate"]);
                item.TaxRate = ToDouble(row["JCTaxRate"]) / 100;
                item.PretaxAmount = item.Price * item.OrderQty;
                item.TaxAmount = item.PretaxAmount * item.TaxRate;
                item.ExtendedAmount = item.PretaxAmount + item.TaxAmount;
                AssemblyCost += item.ExtendedAmount;
                item.Vendor = row["Vendor"]?.ToString() ?? "";
                item.VendorDesc = row["VendorDesc"]?.ToString() ?? "";
                item.OldPriceLevel = item.PriceLevel;
                item.OldItemType = item.ItemType;
            }
            else
            {
                item.ItemType = item.IsQuote ? "Quote" : "Unit Price";
            }
            items.Add(item);
        }
        ItemsData = items;
        _deletedItems.Clear();
        AssemblyCostLabel = AssemblyCost.ToString("$#,##0.00");
    }

    private async Task LoadItemsGridLayoutAsync()
    {
        // VB6 gridname includes the explicit index suffix .(0)
        ItemsGridLayout = await MMain.IniGetGridAsync("FAssembly", "gItems", 0, instanceKey: "(0)", grouped: true);
        if (ItemsGridLayout.Count == 0)
            ItemsGridLayout = await MMain.IniGetGridAsync("FAssembly", "gItems", 0, grouped: true);
        if (ItemsGridLayout.TryGetValue("OrderQty", out var orderQtyCol))
            orderQtyCol.IsEditable = true;
        ItemsGridLayoutVersion++;
        ItemsGridGroupColumns = BuildItemsGridGroupColumns();
        //DebugDumpItemsGridLayout();
    }

    private void DebugDumpItemsGridLayout()
    {
        //Console.WriteLine($"[FAssembly] ItemsGridLayout rows={ItemsGridLayout.Count} ItemsGridLayoutVersion={ItemsGridLayoutVersion}");
        foreach (var kvp in ItemsGridLayout.OrderBy(k => k.Value.ColIndex ?? int.MaxValue).ThenBy(k => k.Key))
        {
            var col = kvp.Value;
            Console.WriteLine($"[FAssembly] Layout colkey='{col.Field}' caption='{col.Caption}' width='{col.Width}' colindex='{col.ColIndex}' grouped='{col.Grouped}' hidden='{col.Hidden}'");
        }
        Console.WriteLine($"[FAssembly] Group columns: {(ItemsGridGroupColumns.Count == 0 ? "(none)" : string.Join(", ", ItemsGridGroupColumns))}");
    }

    private IEnumerable<(MMain.GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedItemsGridLayout()
    {
        if (!HasItemsGridLayout)
            yield break;

        var ordered = ItemsGridLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = ResolveItemsGridField(layout.Field);
            var columnType = GetColumnTypeForField(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    private List<string> BuildItemsGridGroupColumns()
    {
        if (!HasItemsGridLayout)
            return GroupedColumns?.ToList() ?? new List<string>();

        var grouped = ItemsGridLayout.Values
            .Where(c => c.Grouped)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .Select(c => ResolveItemsGridField(c.Field))
            .Where(f => !string.IsNullOrWhiteSpace(f))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return grouped;
    }

    private async Task LoadComponentsGridLayoutAsync()
    {
        // VB6 gridname includes the explicit index suffix .(0)
        ComponentsGridLayout = await MMain.IniGetGridAsync("FAssembly", "gComponents", 0, instanceKey: "(0)", staticNames: true);
        if (ComponentsGridLayout.Count == 0)
            ComponentsGridLayout = await MMain.IniGetGridAsync("FAssembly", "gComponents", 0, staticNames: true);
        ComponentsGridLayoutVersion++;
    }

    private IEnumerable<(MMain.GridLayoutColumn Layout, string Field, ColumnType ColumnType, TextAlign TextAlign)> GetOrderedComponentsGridLayout()
    {
        if (!HasComponentsGridLayout)
            yield break;

        var ordered = ComponentsGridLayout.Values
            .Where(c => !string.IsNullOrWhiteSpace(c.Field) && !c.Hidden)
            .OrderBy(c => c.ColIndex ?? int.MaxValue)
            .ThenBy(c => c.Field, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var layout in ordered)
        {
            var resolvedField = ResolveComponentsGridField(layout.Field);
            var columnType = GetComponentColumnTypeForField(resolvedField);
            var textAlign = columnType == ColumnType.Number ? TextAlign.Right : TextAlign.Left;
            yield return (layout, resolvedField, columnType, textAlign);
        }
    }

    private static string ResolveItemsGridField(string layoutField)
    {
        if (string.IsNullOrWhiteSpace(layoutField))
            return "";

        var trimmed = layoutField.Trim();
        var exact = typeof(AssemblyItemRow).GetProperty(trimmed, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
        if (exact != null)
            return exact.Name;

        var normalized = NormalizeGridKey(trimmed);
        if (_assemblyItemRowPropMap.TryGetValue(normalized, out var prop))
            return prop.Name;

        return trimmed;
    }

    private static string ResolveComponentsGridField(string layoutField)
    {
        if (string.IsNullOrWhiteSpace(layoutField))
            return "";

        var trimmed = layoutField.Trim();
        var exact = typeof(AssemblyComponentRow).GetProperty(trimmed, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
        if (exact != null)
            return exact.Name;

        var normalized = NormalizeGridKey(trimmed);
        if (_assemblyComponentRowPropMap.TryGetValue(normalized, out var prop))
            return prop.Name;

        if (_assemblyComponentFieldAliases.TryGetValue(normalized, out var alias))
            return alias;

        return trimmed;
    }

    private static ColumnType GetColumnTypeForField(string field)
    {
        if (string.IsNullOrWhiteSpace(field))
            return ColumnType.Text;

        if (_assemblyItemRowPropMap.TryGetValue(NormalizeGridKey(field), out var prop))
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool))
                return ColumnType.Boolean;
            if (type == typeof(DateTime))
                return ColumnType.Date;
            if (type == typeof(byte) || type == typeof(short) || type == typeof(int) || type == typeof(long) ||
                type == typeof(float) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
        }

        return ColumnType.Text;
    }

    private static ColumnType GetComponentColumnTypeForField(string field)
    {
        if (string.IsNullOrWhiteSpace(field))
            return ColumnType.Text;

        if (_assemblyComponentRowPropMap.TryGetValue(NormalizeGridKey(field), out var prop))
        {
            var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            if (type == typeof(bool))
                return ColumnType.Boolean;
            if (type == typeof(DateTime))
                return ColumnType.Date;
            if (type == typeof(byte) || type == typeof(short) || type == typeof(int) || type == typeof(long) ||
                type == typeof(float) || type == typeof(double) || type == typeof(decimal))
                return ColumnType.Number;
        }

        return ColumnType.Text;
    }

    private static string NormalizeGridKey(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";

        var sb = new StringBuilder(value.Length);
        foreach (var ch in value)
        {
            if (char.IsLetterOrDigit(ch))
                sb.Append(char.ToLowerInvariant(ch));
        }
        return sb.ToString();
    }

    private static readonly Dictionary<string, PropertyInfo> _assemblyItemRowPropMap =
        typeof(AssemblyItemRow)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .GroupBy(p => NormalizeGridKey(p.Name))
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    private static readonly Dictionary<string, PropertyInfo> _assemblyComponentRowPropMap =
        typeof(AssemblyComponentRow)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .GroupBy(p => NormalizeGridKey(p.Name))
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    private static readonly Dictionary<string, string> _assemblyComponentFieldAliases = new(StringComparer.OrdinalIgnoreCase)
    {
        ["optionid"] = nameof(AssemblyComponentRow.Option),
        ["assemblyid"] = nameof(AssemblyComponentRow.AssemblyId)
    };

    private static int ConvertLayoutWidthToPx(double layoutWidth)
    {
        if (layoutWidth <= 0)
            return 0;

        // VB6 grid widths are commonly stored in twips (15 twips per pixel at 96 DPI).
        var px = (int)Math.Round(layoutWidth / 15.0);
        // add padding allowance to keep text from crowding adjacent columns
        px += 16;
        if (px < 32) px = 32;
        if (px > 2000) px = 2000;
        return px;
    }

    private void SetPriceLevelFromQuality(AssemblyItemRow item, int quality)
    {
        switch (quality)
        {
            case 4: item.PriceLevel = "Phase Specific"; item.ItemType = "Quote"; break;
            case 5: item.PriceLevel = $"{CommunityTerm} Specific"; item.ItemType = "Quote"; break;
            case 6: item.PriceLevel = $"Global (any {CommunityTerm})"; item.ItemType = "Quote"; break;
            case 9: item.PriceLevel = "Phase Specific"; item.ItemType = "Unit Price"; break;
            case 10: item.PriceLevel = $"{CommunityTerm} Specific"; item.ItemType = "Unit Price"; break;
            case 11: item.PriceLevel = $"Global (any {CommunityTerm})"; item.ItemType = "Unit Price"; break;
            case 12: item.PriceLevel = "Corporate (any Division)"; item.ItemType = "Unit Price"; break;
            case 13: item.PriceLevel = "Item DB"; item.ItemType = "Unit Price"; break;
            default: item.ItemType = "Unit Price"; break;
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── LoadComponentsGridAsync ───────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    private async Task LoadComponentsGridAsync()
    {
        await LoadComponentsGridLayoutAsync();

        var checkQuery = "SELECT parentassemblyid FROM tblDBAssemblyComponents WHERE ComponentAssemblyID = @Id";
        var checkDt = db.SqlExec(checkQuery, new { Id = mAssemblyID });
        var isChildComponent = checkDt.Rows.Count > 0;
        ShowComponentsGrid = !isChildComponent && mUseComponents;
        if (!ShowComponentsGrid) { ComponentsData = new(); return; }

        var compQuery = BuildComponentsQuery();
        var compDt = db.SqlExec(compQuery, new { ParentAssemblyId = mAssemblyID, DivisionID = AppState_DivisionID, mPricingCommunity, mPricingCommunityPhase });
        var components = new List<AssemblyComponentRow>();
        ComponentCost = 0;
        foreach (DataRow row in compDt.Rows)
        {
            var comp = new AssemblyComponentRow
            {
                AssemblyId = (long)row["assemblyid"],
                Community = row["community"]?.ToString() ?? "",
                Model = row["model"]?.ToString() ?? "",
                Option = row["optionid"]?.ToString() ?? "",
                Assembly = row["assembly"]?.ToString() ?? "",
                Description = row["description"]?.ToString() ?? "",
                Qty = ToDouble(row["qty"]),
                Cost = !string.IsNullOrEmpty(PricingCommunity) ? ToDouble(row["Cost"]) : 0
            };
            ComponentCost += comp.Cost * comp.Qty;
            components.Add(comp);
        }
        ComponentsData = components;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── AfterEdit Recalculation (VB6: gItems_AfterEdit) ──────────────────
    // ═══════════════════════════════════════════════════════════════════════
    private void RecalculateAfterEdit(AssemblyItemRow item, string field)
    {
        mDirty = true;
        if (item.RowStatus == "") item.RowStatus = "update";

        double conversionFactor = item.AssemblyConversionFactor != 0 ? item.AssemblyConversionFactor
                                : item.ItemConversionFactor != 0 ? item.ItemConversionFactor : 1;
        double wastePct = item.WastePercent / 100.0;

        switch (field)
        {
            case "OrderQty":
                // VB6: Recalculate TakeoffQty from OrderQty
                if (conversionFactor != 0)
                {
                    var takeoff = item.OrderQty / conversionFactor;
                    if (wastePct != 0 && conversionFactor == 1)
                        takeoff = takeoff / (1 + wastePct);
                    item.TakeoffQty = takeoff;
                }
                RecalculateAmounts(item);
                break;

            case "TakeoffQty":
                // VB6: Recalculate OrderQty from TakeoffQty
                var orderQty = item.TakeoffQty * (1 + wastePct) * conversionFactor;
                orderQty = RoundQty(orderQty, item.RoundTo, item.RoundDir);
                item.OrderQty = orderQty;
                RecalculateAmounts(item);
                break;

            case "Price":
                item.PriceDirty = true;
                RecalculateAmounts(item);
                break;

            case "AssemblyConversionFactor":
                // Re-run TakeoffQty → OrderQty conversion with new factor
                RecalculateAfterEdit(item, "TakeoffQty");
                break;

            default:
                // For other fields, just mark dirty
                break;
        }

        RecalculateCosts();
    }

    private void RecalculateAmounts(AssemblyItemRow item)
    {
        item.PretaxAmount = item.Price * item.OrderQty;
        item.TaxAmount = item.PretaxAmount * item.TaxRate;
        item.ExtendedAmount = item.PretaxAmount + item.TaxAmount;
    }

    private double RoundQty(double value, double roundTo, int roundDir)
    {
        if (roundTo <= 0) return value;
        // roundDir: 0 = nearest, 1 = up, 2 = down
        return roundDir switch
        {
            1 => Math.Ceiling(value / roundTo) * roundTo,
            2 => Math.Floor(value / roundTo) * roundTo,
            _ => Math.Round(value / roundTo) * roundTo
        };
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── ValidateData (VB6: ValidateData) ─────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    private async Task<bool> ValidateData()
    {
        var errors = new List<string>();
        if (string.IsNullOrWhiteSpace(AssemblyCode))
            errors.Add("Assembly is required");
        if (string.IsNullOrWhiteSpace(Description))
            errors.Add("Description is required");

        var at = mAssemblyType;
        if (at == AssemblyTypes.atCustomOption)
            at = string.IsNullOrWhiteSpace(ModelValue) ? AssemblyTypes.atGlobal : AssemblyTypes.atoption;

        switch (at)
        {
            case AssemblyTypes.atModel:
                if (string.IsNullOrWhiteSpace(ModelValue)) errors.Add("Model is required");
                break;
            case AssemblyTypes.atoption:
                if (string.IsNullOrWhiteSpace(ModelValue)) errors.Add("Model is required");
                if (string.IsNullOrWhiteSpace(OptionValue)) errors.Add("Option is required");
                break;
            case AssemblyTypes.atGlobal:
            case AssemblyTypes.atDesignCenter:
                if (string.IsNullOrWhiteSpace(OptionValue)) errors.Add("Option is required");
                break;
        }

        // Validate items: one-time items must have Phase/Item or ItemChart
        for (int i = 0; i < ItemsData.Count; i++)
        {
            var item = ItemsData[i];
            if (item.RowStatus == "delete") continue;
            if (string.IsNullOrEmpty(item.Phase) && string.IsNullOrEmpty(item.Item) && string.IsNullOrEmpty(item.ItemChart))
                errors.Add($"Row {i + 1} \"{item.Description}\" is a one time item. It must be replaced with a database item.");
        }

        if (errors.Count > 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Unable to save assembly:\n\n• " + string.Join("\n• ", errors));
            return false;
        }

        mAssemblyType = at;
        return true;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── SaveData (VB6: SaveData) ─────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    private async Task<bool> SaveData(bool prompt)
    {
        if (!mDirty) return true;

        if (prompt)
        {
            var answer = await JSRuntime.InvokeAsync<bool>("confirm", "This data has changed.\n\nDo you want to save these changes?");
            if (!answer) return true; // user chose not to save but can continue
        }

        if (!await ValidateData()) return false;

        try
        {
            var divisionId = Convert.ToInt32(AppState_DivisionID);

            // Check copy scenario
            if (!string.IsNullOrEmpty(mCopiedAssembly))
            {
                var currentKey = (CommunityValue ?? "") + "\x01" + (AssemblyCode ?? "") + "\x01" + (ModelValue ?? "") + "\x01" + (OptionValue ?? "");
                if (currentKey == mCopiedKey)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "When copying an assembly you must change one of Community, Assembly, Model, or Option");
                    return false;
                }

                // Check if assembly already exists
                var existCount = db.ExecuteScalar<int>(
                    "SELECT COUNT(*) FROM tblDBAssemblyMaster WHERE DivisionID=@DivisionID AND Community=@Community AND Model=@Model AND OptionID=@OptionID AND Assembly=@Assembly",
                    new { DivisionID = divisionId, Community = CommunityValue ?? "", Model = ModelValue ?? "", OptionID = OptionValue ?? "", Assembly = AssemblyCode ?? "" });
                if (existCount > 0)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "This assembly already exists. You must specify a unique set of Community, Assembly, Model and/or Option");
                    return false;
                }
            }

            // ── INSERT master (if new) ──
            if (mAssemblyID == 0)
            {
                var insertSql = @"
                    INSERT INTO tblDBAssemblyMaster(DivisionID, UStmp, TStmp, AssemblyType, InActive, Community, Model,
                        ScheduleTemplate, BillingFactor, OptionID, Assembly, AssemblyUOM, Description, GraphicPath,
                        MaxWidth, MaxLength, ConstCutoff, SpecDocument, Comments, Notes, Series, Elevation, Style,
                        Bedrooms, Bathrooms, FloorArea, Category, JCExtra, TakeoffRequired, UseNormalSalesQtyFactors,
                        IsBaseAssembly, Qty, Location, IncludedOption, DesignCenterSalesOnly, SelectByRoom, DisplayTotalOnly)
                    VALUES(@DivisionID, 'web', GETDATE(), @AssemblyType, @Inactive, @Community, @Model,
                        @ScheduleTemplate, @BillingFactor, @OptionID, @Assembly, @UOM, @Description, @GraphicPath,
                        @MaxWidth, @MaxLength, @ConstCutoff, @SpecDocument, @Comments, @Notes, @Series, @Elevation, @Style,
                        @Bedrooms, @Bathrooms, @FloorArea, @Category, @JCExtra, @TakeoffRequired, @UseNormalSalesQtyFactors,
                        @IsBaseAssembly, @Qty, @Location, @IncludedOption, @DCSalesOnly, @SelectByRoom, @DisplayTotalOnly);
                    SELECT SCOPE_IDENTITY();";
                var id = db.ExecuteScalar<decimal>(insertSql, GetMasterParams(divisionId));
                mAssemblyID = (long)(id);
            }

            // ── UPDATE master ──
            var updateSql = @"
                UPDATE tblDBAssemblyMaster SET UStmp='web', TStmp=GETDATE(),
                    Community=@Community, Model=@Model, ScheduleTemplate=@ScheduleTemplate, BillingFactor=@BillingFactor,
                    OptionID=@OptionID, Assembly=@Assembly, AssemblyUOM=@UOM, Description=@Description, GraphicPath=@GraphicPath,
                    MaxWidth=@MaxWidth, MaxLength=@MaxLength, ConstCutoff=@ConstCutoff, SpecDocument=@SpecDocument,
                    Comments=@Comments, Notes=@Notes, InActive=@Inactive, Series=@Series, Elevation=@Elevation, Style=@Style,
                    Bedrooms=@Bedrooms, Bathrooms=@Bathrooms, FloorArea=@FloorArea, Category=@Category, JCExtra=@JCExtra,
                    TakeoffRequired=@TakeoffRequired, UseNormalSalesQtyFactors=@UseNormalSalesQtyFactors, IsBaseAssembly=@IsBaseAssembly,
                    Qty=@Qty, Location=@Location, IncludedOption=@IncludedOption,
                    DesignCenterSalesOnly=@DCSalesOnly, SelectByRoom=@SelectByRoom, DisplayTotalOnly=@DisplayTotalOnly
                WHERE DivisionID=@DivisionID AND Community=@Community AND Model=@Model AND OptionID=@OptionID AND Assembly=@Assembly";
            db.ExecuteNonQuery(updateSql, GetMasterParams(divisionId));

            // ── Save Items: deletes, inserts, updates ──
            foreach (var item in _deletedItems)
            {
                if (item.Sequence != 0)
                    db.ExecuteNonQuery("DELETE tblDBAssemblyDetails WHERE Sequence=@Seq", new { Seq = item.Sequence });
            }
            _deletedItems.Clear();

            foreach (var item in ItemsData.Where(i => i.RowStatus == "new"))
            {
                var seq = db.ExecuteScalar<int>(BuildItemInsertSql(), BuildItemParams(item, divisionId));
                item.Sequence = seq;
                item.RowStatus = "";
            }

            foreach (var item in ItemsData.Where(i => i.RowStatus == "update"))
            {
                db.ExecuteNonQuery(BuildItemUpdateSql(), BuildItemParams(item, divisionId));
                item.RowStatus = "";
            }

            // ── Save Components ──
            foreach (var comp in ComponentsData.ToList())
            {
                // Component save handled via RowStatus if needed
            }

            _communityEnabled = false;
            _modelEnabled = false;
            _optionEnabled = false;
            _assemblyEnabled = false;

            mCopiedCommunity = "";
            mCopiedAssembly = "";
            mCopiedAssemblyID = 0;
            mCopiedModel = "";
            mCopiedKey = "";

            mCommunity = CommunityValue ?? "";
            mAssembly = AssemblyCode ?? "";
            mModel = ModelValue ?? "";
            mOptionID = OptionValue ?? "";

            mDirty = false;
            await InvokeAsync(StateHasChanged);
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FAssembly.SaveData] Error: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving: {ex.Message}");
            return false;
        }
    }

