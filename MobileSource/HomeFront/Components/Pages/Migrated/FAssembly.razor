    private void SetPriceLevelFromQuality(AssemblyItemRow item, int quality)
    {
        switch (quality)
        {
            case 4: item.PriceLevel = "Phase Specific"; item.ItemType = "Quote"; break;
            case 5: item.PriceLevel = $"{CommunityTerm} Specific"; item.ItemType = "Quote"; break;
            case 6: item.PriceLevel = $"Global (any {CommunityTerm})"; item.ItemType = "Quote"; break;
            case 9: item.PriceLevel = "Phase Specific"; item.ItemType = "Unit Price"; break;
            case 10: item.PriceLevel = $"{CommunityTerm} Specific"; item.ItemType = "Unit Price"; break;
            case 11: item.PriceLevel = $"Global (any {CommunityTerm})"; item.ItemType = "Unit Price"; break;
            case 12: item.PriceLevel = "Corporate (any Division)"; item.ItemType = "Unit Price"; break;
            case 13: item.PriceLevel = "Item DB"; item.ItemType = "Unit Price"; break;
            default: item.ItemType = "Unit Price"; break;
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── LoadComponentsGridAsync ───────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    private async Task LoadComponentsGridAsync()
    {
        await LoadComponentsGridLayoutAsync();

        var checkQuery = "SELECT parentassemblyid FROM tblDBAssemblyComponents WHERE ComponentAssemblyID = @Id";
        var checkDt = db.SqlExec(checkQuery, new { Id = mAssemblyID });
        var isChildComponent = checkDt.Rows.Count > 0;
        ShowComponentsGrid = !isChildComponent && mUseComponents;
        if (!ShowComponentsGrid) { ComponentsData = new(); return; }

        var compQuery = BuildComponentsQuery();
        var compDt = db.SqlExec(compQuery, new { ParentAssemblyId = mAssemblyID, SessionState.DivisionID, mPricingCommunity, mPricingCommunityPhase });
        var components = new List<AssemblyComponentRow>();
        ComponentCost = 0;
        foreach (DataRow row in compDt.Rows)
        {
            var comp = new AssemblyComponentRow
            {
                // m.assemblyid is `int` in tblDBAssemblyMaster; the boxed
                // value is Int32 so a direct (long) unboxing cast throws
                // InvalidCastException. Convert.ToInt64 widens cleanly
                // regardless of whether the column comes back as int /
                // bigint / decimal.
                AssemblyId = Convert.ToInt64(row["assemblyid"]),
                Community = row["community"]?.ToString() ?? "",
                Model = row["model"]?.ToString() ?? "",
                Option = row["optionid"]?.ToString() ?? "",
                Assembly = row["assembly"]?.ToString() ?? "",
                Description = row["description"]?.ToString() ?? "",
                Qty = ToDouble(row["qty"]),
                // null (blank cell) when no pricing community — VB6 skips the
                // TextMatrix write entirely (FAssembly.frm:3182).
                Cost = !string.IsNullOrEmpty(PricingCommunity) ? ToDouble(row["Cost"]) : null
            };
            ComponentCost += (comp.Cost ?? 0) * comp.Qty;
            components.Add(comp);
        }
        ComponentsData = components;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── RefreshVendorPrice (VB6: RefreshVendorPrice) ──────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    // After a Vendor pick, look up the picked vendor's rate per row in the
    // selection and write back Price / PriceLevel / ItemType / tax fields.
    // Uses the same SQL functions VB6 does: dbo.Purch_GetItemRate +
    // dbo.Purch_GetItemRateQuality.
    //
    // The rate-quality code (4..12) maps to a (PriceLevel, ItemType) pair:
    //   4  → Phase Specific           , Quote
    //   5  → {Community} Specific     , Quote
    //   6  → Global (any {community}) , Quote
    //   9  → Phase Specific           , Unit Price
    //   10 → {Community} Specific     , Unit Price
    //   11 → Global (any {community}) , Unit Price
    //   12 → Item DB                  , (no ItemType change)
    // Communities-aware: the literal "Community" in PriceLevel labels is
    // replaced with the customer-described term (CD_Community → CommunityTerm).
    //
    // Skips silently if the row has no Vendor (the gate also matches VB6's
    // `If PricingCommunity <> "" And Vendor <> ""` guard).
    private async Task RefreshVendorPriceAsync(IEnumerable<AssemblyItemRow> rows)
    {
        if (string.IsNullOrEmpty(PricingCommunity)) return;

        foreach (var row in rows)
        {
            if (string.IsNullOrWhiteSpace(row.Vendor)) continue;

            // The full VB6 SELECT joins tblDBAssemblyDetails + tblvendors and
            // calls two scalar UDFs. We keep the original shape so the
            // semantics are preserved exactly — Phase/Item/Sequence are
            // pulled from the row, the rest of the lookup keys (community,
            // model, etc.) come from the FAssembly-level state.
            var sql = @"
SELECT ISNULL(dbo.Purch_GetItemRate(0,0,@PricingCommunity,@PricingCommunityPhase,d.Assembly,d.Model,d.OptionID,d.Phase,d.Item,d.Sequence,v.Vendor_id,GETDATE(),@DivisionID),0) AS Rate,
       dbo.Purch_GetItemRateQuality(0,0,@PricingCommunity,@PricingCommunityPhase,d.Assembly,d.Model,d.OptionID,d.Phase,d.Item,d.Sequence,v.Vendor_id,GETDATE(),@DivisionID) AS RateQuality
FROM tblDBAssemblyDetails d
LEFT OUTER JOIN tblvendors v ON v.DivisionID = d.DivisionID AND v.vendor_id = @Vendor
WHERE d.DivisionID = @DivisionID
  AND ISNULL(d.Community,'')  = @Community
  AND ISNULL(d.Model,'')      = @Model
  AND ISNULL(d.Optionid,'')   = @OptionID
  AND ISNULL(d.Assembly,'')   = @Assembly
  AND ISNULL(d.Phase,'')      = @Phase
  AND ISNULL(d.Item,'')       = @Item
ORDER BY d.Phase, d.Item, d.itemchart, d.Sequence";

            try
            {
                var dt = db.SqlExec(sql, new
                {
                    PricingCommunity,
                    PricingCommunityPhase = PricingCommunityPhase,
                    SessionState.DivisionID,
                    row.Vendor,
                    Community = mCommunity,
                    Model = mModel,
                    OptionID = mOptionID,
                    Assembly = mAssembly,
                    Phase = row.Phase ?? "",
                    Item = row.Item ?? ""
                });
                if (dt.Rows.Count == 0) continue;

                var rate = Convert.ToDouble(dt.Rows[0]["Rate"]);
                var quality = Convert.ToInt32(dt.Rows[0]["RateQuality"]);

                switch (quality)
                {
                    case 4:  row.PriceLevel = "Phase Specific";                          row.ItemType = "Quote"; break;
                    case 5:  row.PriceLevel = $"{CommunityTerm} Specific";               row.ItemType = "Quote"; break;
                    case 6:  row.PriceLevel = $"Global (any {CommunityTerm.ToLower()})"; row.ItemType = "Quote"; break;
                    case 9:  row.PriceLevel = "Phase Specific";                          row.ItemType = "Unit Price"; break;
                    case 10: row.PriceLevel = $"{CommunityTerm} Specific";               row.ItemType = "Unit Price"; break;
                    case 11: row.PriceLevel = $"Global (any {CommunityTerm.ToLower()})"; row.ItemType = "Unit Price"; break;
                    case 12: row.PriceLevel = "Item DB"; break;
                    // anything else: leave PriceLevel / ItemType alone (parity with VB6)
                }

                row.Price = rate;
                row.PretaxAmount = rate * row.OrderQty;
                row.TaxAmount = (rate * (row.TaxRate ?? 0)) * row.OrderQty;
                row.ExtendedAmount = (rate * (1 + (row.TaxRate ?? 0))) * row.OrderQty;
                row.PriceDirty = true;

                // VB6 also stashes original values for downstream cost-record
                // cleanup on save.
                row.OldPriceLevel = row.PriceLevel;
                row.OldItemType = row.ItemType;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex,
                    "RefreshVendorPrice failed for vendor='{Vendor}' phase='{Phase}' item='{Item}'",
                    row.Vendor, row.Phase, row.Item);
            }
        }
        await Task.CompletedTask;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── AfterEdit Recalculation (VB6: gItems_AfterEdit) ──────────────────
    // ═══════════════════════════════════════════════════════════════════════
    private void RecalculateAfterEdit(AssemblyItemRow item, string field)
    {
        mDirty = true;
        if (item.RowStatus == "") item.RowStatus = "update";

        double conversionFactor = item.AssemblyConversionFactor != 0 ? item.AssemblyConversionFactor
                                : item.ItemConversionFactor != 0 ? item.ItemConversionFactor : 1;
        double wastePct = item.WastePercent / 100.0;

        switch (field)
        {
            case "OrderQty":
                // VB6 gItems_AfterEdit OrderQty (FAssembly.frm:2006):
                //   TakeoffQty = Round(OrderQty / ((100 + WastePercent) / 100) / Conversion, 5)
                // The waste division is UNCONDITIONAL — it does NOT depend on
                // Conversion being 1. (Conversion already defaults to 1 above
                // when AssemblyConversionFactor / ItemConversionFactor are 0.)
                item.TakeoffQty = Math.Round(item.OrderQty / (1 + wastePct) / conversionFactor, 5);
                RecalculateAmounts(item);
                break;

            case "TakeoffQty":
                // VB6: Recalculate OrderQty from TakeoffQty
                var orderQty = item.TakeoffQty * (1 + wastePct) * conversionFactor;
                orderQty = RoundQty(orderQty, item.RoundTo, item.RoundDir);
                item.OrderQty = orderQty;
                RecalculateAmounts(item);
                break;

            case "Price":
                item.PriceDirty = true;
                RecalculateAmounts(item);
                break;

            case "AssemblyConversionFactor":
                // Re-run TakeoffQty → OrderQty conversion with new factor
                RecalculateAfterEdit(item, "TakeoffQty");
                break;

            // (No default — other fields just mark dirty; RecalculateCosts runs below regardless.)
        }

        RecalculateCosts();
    }

    private void RecalculateAmounts(AssemblyItemRow item)
    {
        item.PretaxAmount = item.Price * item.OrderQty;
        item.TaxAmount = item.PretaxAmount * item.TaxRate;
        item.ExtendedAmount = item.PretaxAmount + item.TaxAmount;
    }

    private double RoundQty(double value, double roundTo, int roundDir)
    {
        if (roundTo <= 0) return value;
        // roundDir: 0 = nearest, 1 = up, 2 = down
        return roundDir switch
        {
            1 => Math.Ceiling(value / roundTo) * roundTo,
            2 => Math.Floor(value / roundTo) * roundTo,
            _ => Math.Round(value / roundTo) * roundTo
        };
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── ValidateData (VB6: ValidateData) ─────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    private async Task<bool> ValidateData()
    {
        var errors = new List<string>();
        if (string.IsNullOrWhiteSpace(AssemblyCode))
            errors.Add("Assembly is required");
        if (string.IsNullOrWhiteSpace(Description))
            errors.Add("Description is required");

        var at = mAssemblyType;
        if (at == AssemblyTypes.atCustomOption)
            at = string.IsNullOrWhiteSpace(ModelValue) ? AssemblyTypes.atGlobal : AssemblyTypes.atoption;

        // VB6 ValidateData (FAssembly.frm:4096/4099): Category is required for
        // option / global / DC options when the ReqCategory app-option is on
        // and no category is selected (cboCategory.ListIndex < 0).
        bool reqCategory = string.Equals(GetAppOption("ReqCategory"), "true", StringComparison.OrdinalIgnoreCase)
                        || GetAppOption("ReqCategory") == "1";
        switch (at)
        {
            case AssemblyTypes.atModel:
                if (string.IsNullOrWhiteSpace(ModelValue)) errors.Add("Model is required");
                break;
            case AssemblyTypes.atoption:
                if (string.IsNullOrWhiteSpace(ModelValue)) errors.Add("Model is required");
                if (string.IsNullOrWhiteSpace(OptionValue)) errors.Add("Option is required");
                if (string.IsNullOrWhiteSpace(CategoryValue) && reqCategory) errors.Add("Category is required");
                break;
            case AssemblyTypes.atGlobal:
            case AssemblyTypes.atDesignCenter:
                if (string.IsNullOrWhiteSpace(OptionValue)) errors.Add("Option is required");
                if (string.IsNullOrWhiteSpace(CategoryValue) && reqCategory) errors.Add("Category is required");
                break;
        }

        // Validate items: one-time items must have Phase/Item or ItemChart
        for (int i = 0; i < ItemsData.Count; i++)
        {
            var item = ItemsData[i];
            if (item.RowStatus == "delete") continue;
            // VB6 ValidateData (FAssembly.frm:4104):
            //   (Phase = "" Or Item = "") And ItemChart = ""
            // i.e. a row missing EITHER Phase OR Item (not both) is still a
            // one-time item unless it carries an ItemChart.
            if ((string.IsNullOrEmpty(item.Phase) || string.IsNullOrEmpty(item.Item)) && string.IsNullOrEmpty(item.ItemChart))
                errors.Add($"Row {i + 1} \"{item.Description}\" is a one time item. It must be replaced with a database item.");
        }

        if (errors.Count > 0)
        {
            // VB6 FAssembly.frm:4109 — MsgBox "Unable to save assembly" &
            // vbCrLf & vbCrLf & s, vbExclamation, App.ProductName. The
            // legacy warning is an application-modal message box whose
            // TITLE is the product name, so the web version must show the
            // same bulleted list in a MessageBoxControl headed "Precision
            // Builder" with the vbExclamation icon (HHM-207) — not a toast.
            var message = "Unable to save assembly\n\n• " + string.Join("\n• ", errors);
            if (_messageBox != null)
                await _messageBox.ShowAsync(message,
                    title: "Precision Builder",
                    buttons: MessageBoxButtons.Ok,
                    icon: "warning");
            else
                Notifications.Error(message); // pre-render race fallback

            return false;
        }

        mAssemblyType = at;
        return true;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── SaveData (VB6: SaveData) ─────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════
    private async Task<bool> FlushGridLayoutChangesAsync()
    {
        if (!GridLayoutSvc.HasPendingGridLayoutChanges)
        {
            _gridLayoutDirty = false;
            return true;
        }

        try
        {
            await GridLayoutSvc.FlushPendingGridLayoutsAsync();
            _gridLayoutDirty = false;
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save pending FAssembly grid layout changes");
            Notifications.Error($"Error saving grid layout: {ex.Message}");
            return false;
        }
    }

    private async Task<bool> SaveData(bool prompt)
    {
        if (!mDirty)
            return await FlushGridLayoutChangesAsync();

        if (prompt)
        {
            // Application-modal Yes/No/Cancel — REPLACES the previous
            // window.confirm() which only had two buttons. Semantics:
            //   Yes    → save the pending changes, then continue with the
            //            caller's requested action (Open, Switch Pricing
            //            Community, etc.). If validation fails the save
            //            aborts and so does the caller (returns false).
            //   No     → discard pending edits and continue. Returns true
            //            with no save performed; mDirty stays true until
            //            the caller's next LoadDataAsync wipes it.
            //   Cancel → abort the caller's action entirely. Returns
            //            false; caller stays on the current view with the
            //            in-flight edits intact.
            //   X / backdrop / Esc → same as Cancel (safe default).
            // Falls back to the browser confirm() only if _messageBox isn't
            // wired yet (race condition during initial render).
            // VB6 FAssembly.frm:3225 — vbExclamation + vbYesNoCancel titled
            // App.ProductName, so the header reads "Precision Builder" like
            // every legacy FAssembly MsgBox (HHM-207 QA flow passes through
            // this prompt right before the validation warning).
            var result = _messageBox != null
                ? await _messageBox.ShowAsync(
                    "This data has changed.\n\nDo you want to save these changes?",
                    title: "Precision Builder",
                    buttons: MessageBoxButtons.YesNoCancel,
                    icon: "warning")
                : (await Dialogs.ConfirmAsync(
                        "This data has changed.\n\nDo you want to save these changes?")
                    ? MessageBoxResult.Yes
                    : MessageBoxResult.No);

            if (result == MessageBoxResult.Cancel)
                return false;          // abort the caller's requested action
            if (result == MessageBoxResult.No)
                return true;           // discard changes, continue
            // result == Yes → fall through into the save path below
        }

        if (!await ValidateData()) return false;

        try
        {
            var divisionId = SessionState.DivisionID;

            // Check copy scenario
            bool isCopyOfCurrent = !string.IsNullOrEmpty(mCopiedAssembly);
            if (isCopyOfCurrent)
            {
                var currentKey = (CommunityValue ?? "") + "\x01" + (AssemblyCode ?? "") + "\x01" + (ModelValue ?? "") + "\x01" + (OptionValue ?? "");
                if (currentKey == mCopiedKey)
                {
                    Notifications.Info("When copying an assembly you must change one of Community, Assembly, Model, or Option");
                    return false;
                }
            }

            // Duplicate key (DivisionID, Community, Assembly, Model, OptionID): a copy must
            // pick a unique key (VB6 FAssembly.frm:3268); a plain save offers to replace the
            // existing assembly (VB6 FAssembly.frm:3713-3718) and then updates that row.
            if (mAssemblyID == 0)
            {
                var keyParams = new { DivisionID = divisionId, Community = CommunityValue ?? "", Model = ModelValue ?? "", OptionID = OptionValue ?? "", Assembly = AssemblyCode ?? "" };
                var existCount = db.ExecuteScalar<int>(
                    "SELECT COUNT(*) FROM tblDBAssemblyMaster WHERE DivisionID=@DivisionID AND Community=@Community AND Model=@Model AND OptionID=@OptionID AND Assembly=@Assembly",
                    keyParams);
                if (existCount > 0)
                {
                    if (isCopyOfCurrent)
                    {
                        Notifications.Info("This assembly already exists. You must specify a unique set of Community, Assembly, Model and/or Option");
                        return false;
                    }

                    var replaceResult = _messageBox != null
                        ? await _messageBox.ShowAsync(
                            "This assembly already exists. Do you want to replace it with this one?",
                            title: "Assembly exists",
                            buttons: MessageBoxButtons.YesNo)
                        : (await Dialogs.ConfirmAsync(
                                "This assembly already exists. Do you want to replace it with this one?")
                            ? MessageBoxResult.Yes
                            : MessageBoxResult.No);
                    if (replaceResult != MessageBoxResult.Yes)
                        return false;

                    mAssemblyID = db.ExecuteScalar<int>(
                        "SELECT AssemblyID FROM tblDBAssemblyMaster WHERE DivisionID=@DivisionID AND Community=@Community AND Model=@Model AND OptionID=@OptionID AND Assembly=@Assembly",
                        keyParams);
                }
            }

            // VB6 FAssemblyWithPricing.frm:1593-1622 — for a Copy of Current,
            // optionally clone the source's vendor cost rows to the new key
            // BEFORE inserting the master. Prompt the user (same wording as
            // VB6 MsgBox). The LEFT-JOIN exclusion in the SELECT means only
            // vendor/phase/item triples that DON'T already exist for the
            // new key are inserted, so re-running the copy is idempotent.
            if (isCopyOfCurrent)
            {
                var promptResult = _messageBox != null
                    ? await _messageBox.ShowAsync(
                        "Do you want to copy the vendor pricelists also?",
                        title: "Copy vendor pricelists?",
                        buttons: MessageBoxButtons.YesNo)
                    : (await Dialogs.ConfirmAsync(
                            "Do you want to copy the vendor pricelists also?")
                        ? MessageBoxResult.Yes
                        : MessageBoxResult.No);

                if (promptResult == MessageBoxResult.Yes)
                {
                    const string vendorCopySql = @"
                        INSERT INTO tblVendorCost(Community, CommunityPhase, Assembly, Model, Phase, Item, Vendor,
                            Current_Cost, Next_Cost1, Next_Cost2, Next_Effective1, Next_Effective2,
                            Last_Cost1, Last_Cost2, Last_Cost3, Last1_Expiry, Last2_Expiry, Last3_Expiry,
                            Forecast1, Forecast2, Forecast3, Forecast4, Forecast5, Forecast6,
                            Forecast7, Forecast8, Forecast9, Forecast10, Forecast11, Forecast12,
                            TaxGroup, PartNumber, PriceLink)
                        SELECT @NewCommunity, old.CommunityPhase, @NewAssembly, @NewModel,
                               old.Phase, old.Item, old.Vendor,
                               old.Current_Cost, old.Next_Cost1, old.Next_Cost2, old.Next_Effective1, old.Next_Effective2,
                               old.Last_Cost1, old.Last_Cost2, old.Last_Cost3, old.Last1_Expiry, old.Last2_Expiry, old.Last3_Expiry,
                               old.Forecast1, old.Forecast2, old.Forecast3, old.Forecast4, old.Forecast5, old.Forecast6,
                               old.Forecast7, old.Forecast8, old.Forecast9, old.Forecast10, old.Forecast11, old.Forecast12,
                               old.TaxGroup, old.PartNumber, old.PriceLink
                          FROM tblVendorCost old
                          LEFT OUTER JOIN tblVendorCost new ON(new.Community = @NewCommunity
                                                           AND new.CommunityPhase = ''
                                                           AND new.Assembly = @NewAssembly
                                                           AND new.Model = @NewModel
                                                           AND new.Phase = old.Phase
                                                           AND new.Item = old.Item
                                                           AND new.Vendor = old.Vendor)
                         WHERE new.Vendor IS NULL
                           AND old.Community = @OldCommunity
                           AND old.Assembly = @OldAssembly
                           AND old.Model = @OldModel";
                    try
                    {
                        await db.ExecuteAsync(vendorCopySql, new
                        {
                            NewCommunity = CommunityValue ?? "",
                            NewAssembly = AssemblyCode ?? "",
                            NewModel = ModelValue ?? "",
                            OldCommunity = mCopiedCommunity ?? "",
                            OldAssembly = mCopiedAssembly ?? "",
                            OldModel = mCopiedModel ?? ""
                        });
                    }
                    catch (Exception vendorEx)
                    {
                        // Don't fail the whole save if the vendor cost copy
                        // chokes — log it and let the user proceed; they can
                        // re-run the vendor maintenance task later.
                        Logger.LogError(vendorEx, "Vendor pricelist copy (Copy of Current) failed");
                        Notifications.Warning("Could not copy vendor pricelists — continuing without them.");
                    }
                }
            }

            // ── INSERT master (if new) ──
            if (mAssemblyID == 0)
            {
                var insertSql = @"
                    INSERT INTO tblDBAssemblyMaster(DivisionID, UStmp, TStmp, AssemblyType, InActive, Community, Model,
                        ScheduleTemplate, BillingFactor, BillingCode, BillingCategory, OptionID, Assembly, AssemblyUOM, Description, GraphicPath,
                        MaxWidth, MaxLength, ConstCutoff, SpecDocument, Comments, Notes, Series, Elevation, Style,
                        Bedrooms, Bathrooms, FloorArea, Category, JCExtra, TakeoffRequired, UseNormalSalesQtyFactors,
                        IsBaseAssembly, Qty, Location, IncludedOption, DesignCenterSalesOnly, SelectByRoom, DisplayTotalOnly)
                    VALUES(@DivisionID, 'web', GETDATE(), @AssemblyType, @Inactive, @Community, @Model,
                        @ScheduleTemplate, @BillingFactor, @BillingCode, @BillingCategory, @OptionID, @Assembly, @UOM, @Description, @GraphicPath,
                        @MaxWidth, @MaxLength, @ConstCutoff, @SpecDocument, @Comments, @Notes, @Series, @Elevation, @Style,
                        @Bedrooms, @Bathrooms, @FloorArea, @Category, @JCExtra, @TakeoffRequired, @UseNormalSalesQtyFactors,
                        @IsBaseAssembly, @Qty, @Location, @IncludedOption, @DCSalesOnly, @SelectByRoom, @DisplayTotalOnly);
                    SELECT SCOPE_IDENTITY();";
                var id = db.ExecuteScalar<decimal>(insertSql, GetMasterParams(divisionId));
                mAssemblyID = (long)(id);

                // VB6 FAssembly.frm:3364-3385 — for a Copy of Current, clone the
                // source assembly's components under the new AssemblyID and clone
                // any RoomQtyByModel rows that the new model doesn't already have.
                if (mCopiedAssemblyID != 0)
                {
                    await db.ExecuteAsync(@"
                        INSERT tblDBAssemblyComponents(ParentAssemblyID, ComponentAssemblyID, Qty)
                        SELECT @NewID, ComponentAssemblyID, Qty
                          FROM tblDBAssemblyComponents
                         WHERE ParentAssemblyID = @SourceID",
                        new { NewID = mAssemblyID, SourceID = mCopiedAssemblyID });

                    // VB6 hard-codes RoomMaster.divisionid=1 in this clone.
                    await db.ExecuteAsync(@"
                        INSERT RoomQtyByModel(Model, RoomID, SubCategory, UOM, Qty, Inactive)
                        SELECT @NewModel, a.RoomID, a.SubCategory, a.UOM, a.Qty, a.Inactive
                          FROM RoomMaster r
                          JOIN RoomQtyByModel a ON r.roomid = a.roomid
                          LEFT JOIN RoomQtyByModel b ON b.model = @NewModel AND a.roomid = b.roomid
                                                    AND a.subcategory = b.subcategory AND a.uom = b.uom
                         WHERE r.divisionid = 1
                           AND a.Model = @SourceModel
                           AND b.model IS NULL",
                        new { NewModel = ModelValue ?? "", SourceModel = mCopiedModel ?? "" });
                }
            }

            // ── UPDATE master ──
            var updateSql = @"
                UPDATE tblDBAssemblyMaster SET UStmp='web', TStmp=GETDATE(),
                    Community=@Community, Model=@Model, ScheduleTemplate=@ScheduleTemplate, BillingFactor=@BillingFactor,
                    BillingCode=@BillingCode, BillingCategory=@BillingCategory,
                    OptionID=@OptionID, Assembly=@Assembly, AssemblyUOM=@UOM, Description=@Description, GraphicPath=@GraphicPath,
                    MaxWidth=@MaxWidth, MaxLength=@MaxLength, ConstCutoff=@ConstCutoff, SpecDocument=@SpecDocument,
                    Comments=@Comments, Notes=@Notes, InActive=@Inactive, Series=@Series, Elevation=@Elevation, Style=@Style,
                    Bedrooms=@Bedrooms, Bathrooms=@Bathrooms, FloorArea=@FloorArea, Category=@Category, JCExtra=@JCExtra,
                    TakeoffRequired=@TakeoffRequired, UseNormalSalesQtyFactors=@UseNormalSalesQtyFactors, IsBaseAssembly=@IsBaseAssembly,
                    Qty=@Qty, Color=@Color, StyleValue=@StyleValue, FinishValue=@FinishValue, OtherValue=@OtherValue,
                    ColorListID=@ColorListID, StyleListID=@StyleListID, FinishListID=@FinishListID, OtherListID=@OtherListID,
                    Location=@Location, IncludedOption=@IncludedOption,
                    DesignCenterSalesOnly=@DCSalesOnly, SelectByRoom=@SelectByRoom, DisplayTotalOnly=@DisplayTotalOnly
                WHERE DivisionID =@DivisionID AND Community=@Community AND Model=@Model AND OptionID=@OptionID AND Assembly=@Assembly";
            db.ExecuteNonQuery(updateSql, GetMasterParams(divisionId));

            // ── Save Items: deletes, inserts, updates ──
            // VB6 (new): skip deleting the source's detail rows during a Copy ("If mCopiedAssembly = ''")
            if (string.IsNullOrEmpty(mCopiedAssembly))
            {
                foreach (var item in _deletedItems)
                {
                    if (item.Sequence != 0)
                        db.ExecuteNonQuery("DELETE tblDBAssemblyDetails WHERE Sequence=@Seq", new { Seq = item.Sequence });
                }
            }
            _deletedItems.Clear();

            foreach (var item in ItemsData.Where(i => i.RowStatus == "new"))
            {
                var seq = db.ExecuteScalar<int>(BuildItemInsertSql(), BuildItemParams(item, divisionId));
                item.Sequence = seq;
                // VB6 FAssembly.frm:3532 — if price changed then update vendor pricelists.
                if (item.PriceDirty)
                    await UpdateItemPrice(item, divisionId);
                item.RowStatus = "";
            }

            foreach (var item in ItemsData.Where(i => i.RowStatus == "update"))
            {
                db.ExecuteNonQuery(BuildItemUpdateSql(), BuildItemParams(item, divisionId));
                // VB6 FAssembly.frm:3585 — if price changed then update vendor pricelists.
                if (item.PriceDirty)
                    await UpdateItemPrice(item, divisionId);
                item.RowStatus = "";
            }

            // ── Save ItemType (IsQuote) edits ────────────────────────────
            // ItemType is NOT a column in tblDBAssemblyDetails — it's
            // derived at load time from the rate-quality stored proc. The
            // user-editable flip persists into tblPhaseItem.IsQuote (bit),
            // per VB6 FAssemblyWithPricing.frm:1720-1725:
            //     UPDATE tblPhaseItem SET IsQuote=<bit>
            //     WHERE Phase=@Phase AND Item=@Item
            // We add a DivisionID guard the VB6 didn't have, since
            // tblPhaseItem is keyed on (DivisionID, Phase, Item) in the
            // modern schema. Only items the user actually changed
            // (ItemTypeDirty=true) get touched; others stay as-is.
            foreach (var item in ItemsData.Where(i => i.ItemTypeDirty
                                                    && i.RowStatus != "delete"
                                                    && !string.IsNullOrEmpty(i.Phase)
                                                    && !string.IsNullOrEmpty(i.Item)))
            {
                var isQuoteBit = string.Equals(item.ItemType, "Quote", StringComparison.OrdinalIgnoreCase) ? 1 : 0;
                db.ExecuteNonQuery(@"
                    UPDATE tblPhaseItem SET IsQuote=@IsQuote
                    WHERE DivisionID=@DivisionID
                      AND ISNULL(Phase,'')=@Phase
                      AND ISNULL(Item,'')=@Item",
                    new
                    {
                        IsQuote = isQuoteBit,
                        DivisionID = divisionId,
                        Phase = item.Phase ?? "",
                        Item = item.Item ?? "",
                    });
                item.ItemTypeDirty = false;
                item.OldItemType = item.ItemType;
            }

            // Components: add / remove / qty-edit on a SAVED assembly are all
            // persisted immediately (OnAddComponentClick / OnRemoveComponentClick
            // / PersistComponentQtyAsync) — VB6 deferred all three to SaveData
            // (FAssembly.frm:3600-3632). The ONE deferred case here is components
            // picked while the assembly was still unsaved (HHM-581: VB6 opens
            // the picker without requiring a save first): those rows sit in
            // ComponentsData with IsNew=true until the master INSERT above has
            // produced mAssemblyID, and are flushed now.
            var stagedComponents = ComponentsData.Where(c => c.IsNew && c.AssemblyId != 0).ToList();
            if (stagedComponents.Count > 0 && mAssemblyID != 0)
            {
                foreach (var comp in stagedComponents)
                {
                    await db.ExecuteAsync(@"
                        INSERT INTO tblDBAssemblyComponents (ParentAssemblyID, ComponentAssemblyID, Qty)
                        SELECT @Parent, @Child, @Qty
                         WHERE NOT EXISTS (
                            SELECT 1 FROM tblDBAssemblyComponents
                             WHERE ParentAssemblyID = @Parent
                               AND ComponentAssemblyID = @Child)",
                        new { Parent = mAssemblyID, Child = comp.AssemblyId, comp.Qty });
                    comp.IsNew = false;
                }
                await LoadComponentsGridAsync();
                RecalculateCosts();
            }

            // ── mDataSource == 1 sales write-back (VB6 FAssembly.frm:3634-3699) ──
            // When the assembly was opened from the sales list (Source=1 in the
            // Open picklist → mDataSource=1, set in ApplyAssemblySelectionFromRow),
            // we just created/edited a DB assembly for an unestimated sales item,
            // so write the new Assembly/Description (+ a few attrs) back to the
            // matching sales row by AssemblyType, then clear mDataSource.
            if (mDataSource == 1)
                await WriteBackSalesAssemblyAsync(divisionId);

            _communityEnabled = false;
            _modelEnabled = false;
            _optionEnabled = false;
            _assemblyEnabled = false;

            mCopiedCommunity = "";
            mCopiedAssembly = "";
            mCopiedModel = "";
            mCopiedOption = "";
            mCopiedKey = "";
            mCopiedAssemblyID = 0;

            mCommunity = CommunityValue ?? "";
            mAssembly = AssemblyCode ?? "";
            mModel = ModelValue ?? "";
            mOptionID = OptionValue ?? "";

            mDirty = false;
            if (!await FlushGridLayoutChangesAsync())
                return false;

            await InvokeAsync(StateHasChanged);
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");

            var sqlEx = ex as Microsoft.Data.SqlClient.SqlException
                        ?? ex.InnerException as Microsoft.Data.SqlClient.SqlException;
            if (sqlEx is { Number: 2601 or 2627 })
            {
                Notifications.Error("This assembly already exists. You must specify a unique set of Community, Assembly, Model and/or Option");
                return false;
            }

            Notifications.Error($"Error saving: {ex.Message}");
            return false;
        }
    }

    private object GetMasterParams(int divisionId) => new
    {
        DivisionID = divisionId,
        AssemblyType = (int)mAssemblyType,
        Inactive = !IsActive,
        Community = CommunityValue ?? "",
        Model = ModelValue ?? "",
        ScheduleTemplate = ScheduleTemplateValue ?? "",
        BillingFactor,
        BillingCode = _billingCode ?? "",
        BillingCategory = _billingCategory ?? "",
        OptionID = OptionValue ?? "",
        Assembly = AssemblyCode ?? "",
        UOM = UOMValue ?? "",
        Description = Description ?? "",
        GraphicPath = GraphicPath ?? "",
        MaxWidth = MaxWidth ?? 0.0,
        MaxLength = MaxLength ?? 0.0,
        ConstCutoff = ConstCutoff ?? 0.0,
        SpecDocument = SpecDocument ?? "",
        Comments = Comments ?? "",
        Notes = Notes ?? "",
        Series = SeriesValue ?? "",
        Elevation = Elevation ?? "",
        Style = ShowStyleCombo ? (StyleValue ?? "") : (StyleText ?? ""),
        Bedrooms = Bedrooms ?? 0,
