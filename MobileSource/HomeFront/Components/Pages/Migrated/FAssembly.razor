        // VB6 attribute columns (UPDATE only): Color/Style/Finish/Other + list IDs.
        Color = _attrValues[0],
        StyleValue = _attrValues[1],
        FinishValue = _attrValues[2],
        OtherValue = _attrValues[3],
        ColorListID = _attrListIds[0],
