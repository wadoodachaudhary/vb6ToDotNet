    private async Task OnPickListSelected(List<IDictionary<string, object>> selectedRows)
    {
        if (_pickListContext == "POIndex")
        {
            if (_poIndexPickRow != null && selectedRows.Count > 0)
            {
                var row = selectedRows[0];
                var id = GetRowString(row, "ID");
                var desc = GetRowString(row, "POIndex");
                _poIndexPickRow.POIndex = id;
                _poIndexPickRow.POIndexDescription = desc;
                if (_poIndexPickRow.RowStatus == "") _poIndexPickRow.RowStatus = "update";
                mDirty = true;
                if (gItems != null) await gItems.Refresh();
            }
            _poIndexPickRow = null;
            _pickListContext = "";
            return;
        }

        if (_pickListContext == "ItemChart" && selectedRows.Count > 0)
        {
            // VB6: For i = 1 To FPickList.SelectedItems
            //   .TextMatrix(.Rows-1, .ColIndex("ItemChart")) = FPickList.SelectedItem("name", i)
            //   .TextMatrix(.Rows-1, .ColIndex("formula")) = FPickList.SelectedItem("formula", i)
            //   .TextMatrix(.Rows-1, .ColIndex("ItemConversionFactor")) = 1
            //   .TextMatrix(.Rows-1, .ColIndex("TakeoffQty")) = 1
            //   .TextMatrix(.Rows-1, .ColIndex("OrderQty")) = 1
            mReadOnly = false;
            mDirty = true;

            foreach (var row in selectedRows)
            {
                var chartName = row.ContainsKey("name") ? row["name"]?.ToString() ?? "" : "";
                var formula = row.ContainsKey("formula") ? row["formula"]?.ToString() ?? "" : "";

                ItemsData.Add(new AssemblyItemRow
                {
                    ItemChart = chartName,
                    Formula = formula,
                    ItemConversionFactor = 1,
                    TakeoffQty = 1,
                    OrderQty = 1,
                    RowStatus = "new"
                });
            }

            RecalculateCosts();
            if (gItems != null) await gItems.Refresh();
            _pickListContext = "";
            return;
        }

        if ((_pickListContext == "OpenAssembly" || _pickListContext == "OpenAssemblyOptions") && selectedRows.Count > 0)
        {
            var row = selectedRows[0];
            var selectedView = (pickList?.SelectedViewIndex ?? 0) + 1;

            ApplyAssemblySelectionFromRow(row, selectedView);

            if (_pickListContext == "OpenAssembly" && selectedView == 2)
            {
                var modelId = GetRowString(row, "modelid");
                if (string.IsNullOrWhiteSpace(modelId))
                    modelId = GetRowString(row, "ModelID");

                if (!string.IsNullOrWhiteSpace(modelId) && pickList != null)
                {
                    _pickListContext = "OpenAssemblyOptions";
                    _openPickListModel = modelId;

                    await pickList.Open(
                        title: BuildAssemblyOpenPickListTitle(),
                        queries: BuildAssemblyOptionsPickListQuery(modelId),
                        hideColumns: BuildAssemblyPickListHideColumns(),
                        multiSelect: false,
                        defaultView: 0);
                    return;
                }
            }

            if (_pickListContext == "OpenAssemblyOptions" && string.IsNullOrWhiteSpace(mModel) && !string.IsNullOrWhiteSpace(_openPickListModel))
                mModel = _openPickListModel;

            mCopiedCommunity = "";
            mCopiedAssembly = "";
            mCopiedAssemblyID = 0;
            mCopiedModel = "";
            await FinalizeOpenSelectionAsync();
            _pickListContext = "";
            return;
        }

        if (_pickListContext == "SubstituteItem" && selectedRows.Count > 0)
        {
            // VB6: mcITEM_SUBSTITUE — replace Phase/Item/Description and related fields
            //   on all selected rows with the chosen item from FPickList
            var pick = selectedRows[0];
            var newPhase = GetRowString(pick, "Phase");
            var newItem = GetRowString(pick, "Item");
            var newDescription = GetRowString(pick, "Description");
            var newTakeoffUOM = GetRowString(pick, "TakeoffUOM");
            var newConvFactor = ToDouble(pick.ContainsKey("ConversionFactor") ? pick["ConversionFactor"] : 0);
            var newOrderUOM = GetRowString(pick, "OrderUOM");
            var newPOIndex = GetRowString(pick, "POIndex");
            var newPOIndexDesc = GetRowString(pick, "POIndexDescription");
            var newNotes = GetRowString(pick, "Notes");
            var newCostCode = GetRowString(pick, "CostCode");
            var newCostCodeDesc = GetRowString(pick, "CostCodeDesc");
            var newCategory = GetRowString(pick, "Category");
            var newCategoryDesc = GetRowString(pick, "CategoryDesc");

            if (gItems != null)
            {
                var selected = gItems.GetSelectedRecords().ToList();
                foreach (var row in selected)
                {
                    row.Phase = newPhase;
                    row.Item = newItem;
                    row.Description = newDescription;
                    row.TakeoffUOM = newTakeoffUOM;
                    row.ItemConversionFactor = newConvFactor;
                    row.OrderUOM = newOrderUOM;
                    row.POIndex = newPOIndex;
                    row.POIndexDescription = newPOIndexDesc;
                    row.Notes = newNotes;
                    row.JCCostCode = newCostCode;
                    row.JCCostCodeDesc = newCostCodeDesc;
                    row.JCCategory = newCategory;
                    row.JCCategoryDesc = newCategoryDesc;
                    if (row.RowStatus == "") row.RowStatus = "update";
                    // VB6: Call gItems_AfterEdit(.Row, .ColIndex("TakeoffQty"))
                    RecalculateAfterEdit(row, "TakeoffQty");
                }
            }

            mDirty = true;
            RecalculateCosts();
            if (gItems != null) await gItems.Refresh();
            _pickListContext = "";
            return;
        }

        _pickListContext = "";
    }

