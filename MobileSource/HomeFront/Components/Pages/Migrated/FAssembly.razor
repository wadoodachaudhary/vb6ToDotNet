    private async Task OnNotesDialogCommit()
    {
        _showNotesDialog = false;
        var row = _notesDialogRow;
        _notesDialogRow = null;
        if (row == null) return;
        // Fan out across the multi-selection — same beat as the old editor path.
        var targets = (gItems?.GetSelectedRecords().ToList() ?? new List<AssemblyItemRow>());
        if (targets.Count == 0 || !targets.Contains(row))
            targets = new List<AssemblyItemRow> { row };
        foreach (var t in targets)
        {
            t.Notes = _notesDialogText;
            if (t.RowStatus == "") t.RowStatus = "update";
        }
        mDirty = true;
        if (gItems != null) await gItems.Refresh();
        StateHasChanged();
        await ResumeItemsGridKeyboardNavigationAsync();
    }

