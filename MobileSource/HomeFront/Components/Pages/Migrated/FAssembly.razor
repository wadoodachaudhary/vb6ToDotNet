    private async Task MassEditSelectedQty()
    {
        if (gItems == null) return;
        var selectedRecords = gItems.GetSelectedRecords().ToList();
        if (selectedRecords.Count == 0) return;

        var input = await JSRuntime.InvokeAsync<string>("prompt", $"Enter new OrderQty for {selectedRecords.Count} selected row(s):", "100");
        if (string.IsNullOrWhiteSpace(input)) return;
        if (!double.TryParse(input, out var newQty)) return;

        foreach (var record in selectedRecords)
        {
            record.OrderQty = newQty;
            RecalculateAfterEdit(record, "OrderQty");
        }
        RecalculateCosts();
        await gItems.Refresh();
    }

    private async Task OnGridCellSave(CellSaveArgs<AssemblyItemRow> args)
    {
        var editedItem = args.Data;
        var field = args.ColumnName;

        // Recalculate the edited row
        RecalculateAfterEdit(editedItem, field);

        // If OrderQty was edited and there are multi-selected rows,
        // propagate the new value to all selected rows
        if (field == "OrderQty" && gItems != null)
        {
            var selectedRecords = gItems.GetSelectedRecords().ToList();
            if (selectedRecords.Count > 1)
            {
                var newQty = editedItem.OrderQty;
                foreach (var record in selectedRecords)
                {
                    if (ReferenceEquals(record, editedItem)) continue;
                    record.OrderQty = newQty;
                    RecalculateAfterEdit(record, "OrderQty");
                }
            }
        }

        RecalculateCosts();

        // Deselect all rows after totals are updated
        if (gItems != null)
        {
            gItems.ClearSelection();
            await gItems.Refresh();
        }
    }

    private async Task OnTypeAheadCommit(TypeAheadCommitArgs<AssemblyItemRow> args)
    {
        if (!double.TryParse(args.Value, out var newQty)) return;

        foreach (var record in args.SelectedItems)
        {
            record.OrderQty = newQty;
            RecalculateAfterEdit(record, "OrderQty");
        }

        RecalculateCosts();

        if (gItems != null)
        {
            gItems.ClearSelection();
            await gItems.Refresh();
        }
    }

