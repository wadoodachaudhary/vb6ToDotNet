    private async Task OnPriceCommunityChanged(ChangeEventArgs e)
    {
        // VB6: cboPriceCommunity_Click → if SaveData(True) … else cancel
        // Switching pricing community reloads the grid from scratch and
        // throws away any in-flight edits, so prompt the user first if
        // they've made changes. SaveData(true) handles the three branches:
        //   - mDirty=false               → returns true, proceed
        //   - user picks Save            → save then return true
        //   - user picks Don't Save / OK → returns true (discard ok)
        //   - validation fails on Save   → returns false, abort
        // If aborted, revert the dropdown value so it doesn't appear to
        // have changed.
        if (mDirty && !await SaveData(true))
        {
            // Restore the visible selection — caller's @bind already set
            // _pricingCommunitySelectedValue to the new value, so push the
            // OLD value back. Re-render so the dropdown reverts.
            var revert = string.IsNullOrEmpty(mPricingCommunity)
                ? ""
                : mPricingCommunity + ((char)2) + (mPricingCommunityPhase);
            _pricingCommunitySelectedValue = revert;
            StateHasChanged();
            return;
        }

        var selectedValue = e.Value?.ToString() ?? "";
        _pricingCommunitySelectedValue = selectedValue;
        if (!string.IsNullOrEmpty(selectedValue))
        {
            var parts = selectedValue.Split((char)2);
            PricingCommunity = parts[0];
            PricingCommunityPhase = parts.Length > 1 ? parts[1] : "";
            mPricingCommunity = PricingCommunity;
            mPricingCommunityPhase = PricingCommunityPhase;
            ShowPricing = true;
        }
        else
        {
            ShowPricing = false;
            PricingCommunity = "";
            PricingCommunityPhase = "";
        }

        // Price / PriceLevel / Vendor / VendorDesc become editable only when
        // a pricing community is selected (VB6: gItems_BeforeEdit). Re-flip
        // the IsEditable bit on those columns and bump the layout version
        // so the grid re-emits the columns with the new AllowEditing.
        ApplyVB6EditableColumnGates();
        _itemsGrid.BumpVersion();

        await LoadDataAsync();
    }

    /// <summary>Coerces <paramref name="stringValue"/> to the
    /// <see cref="AssemblyItemRow"/> property type for <paramref name="field"/>
    /// and writes it. Returns false if the property doesn't exist, isn't
    /// writable, or the value can't be parsed for the target type — caller
    /// can skip / log and move on. Covers the property types that appear in
    /// the VB6 editable list: string, double, int, bool. WBS01..WBS40 are
    /// stored in a <c>Dictionary&lt;int, string&gt;</c> on AssemblyItemRow
    /// and are handled separately.</summary>
    private static readonly PropertyInfo[] _assemblyItemRowProperties =
        typeof(AssemblyItemRow).GetProperties(
            BindingFlags.Public | BindingFlags.Instance);

    private static bool TrySetAssemblyItemField(AssemblyItemRow row, string field, string stringValue)
    {
        // ── WBS01..WBS40 → AssemblyItemRow.WBS dictionary ─────────────
        if (field.Length == 5 && field.StartsWith("WBS", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(field.AsSpan(3), out var wbsIndex)
            && wbsIndex >= 1 && wbsIndex <= 40)
        {
            row.WBS[wbsIndex] = stringValue;
            return true;
        }

        var prop = _assemblyItemRowProperties.FirstOrDefault(p =>
            string.Equals(p.Name, field, StringComparison.OrdinalIgnoreCase));
        if (prop == null || !prop.CanWrite) return false;

        var targetType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
        object? converted;
        if (targetType == typeof(string))
        {
            converted = stringValue;
        }
        else if (targetType == typeof(double))
        {
            if (!double.TryParse(stringValue, NumberStyles.Any,
                CultureInfo.InvariantCulture, out var d)) return false;
            converted = d;
        }
        else if (targetType == typeof(int))
        {
            if (!int.TryParse(stringValue, out var i)) return false;
            converted = i;
        }
        else if (targetType == typeof(bool))
        {
            converted = stringValue.Equals("true", StringComparison.OrdinalIgnoreCase)
                        || stringValue == "1"
                        || stringValue.Equals("yes", StringComparison.OrdinalIgnoreCase);
        }
        else
        {
            return false;
        }
        prop.SetValue(row, converted);
        return true;
    }

    private async Task OnGridCellSave(CellSaveArgs<AssemblyItemRow> args)
    {
        // GridControl.CommitBatchEdit fans out across every multi-selected
        // row before firing this handler — once per row — and clears the
        // selection on its own. We just need to recalculate the row that
        // was modified, flag the form dirty, and refresh totals.
        var editedItem = args.Data;
        var field = args.ColumnName;

        // VB6 gItems_ValidateEdit Price case (FAssembly.frm:2424-2428): an
        // "Item DB" row's price is not editable. OnCellEdit already cancels
        // the interactive open, but the single-cell batch-commit path lands
        // here without an OnCellEdit cancel, so reject it too: restore the
        // DB-authoritative price (CellSaveArgs carries no old value) and warn.
        if (string.Equals(field, "Price", StringComparison.OrdinalIgnoreCase)
            && editedItem.PriceLevel == "Item DB")
        {
            await RefreshVendorPriceAsync(new[] { editedItem });
            await ShowItemDbPriceNotEditableAsync();
            if (gItems != null)
                await gItems.Refresh();
            return;
        }

        if (string.Equals(field, "ItemType", StringComparison.OrdinalIgnoreCase))
        {
            editedItem.IsQuote = string.Equals(editedItem.ItemType, "Quote", StringComparison.OrdinalIgnoreCase);
            editedItem.ItemTypeDirty = true;
        }

        RecalculateAfterEdit(editedItem, field);
        mDirty = true;
        RecalculateCosts();

        if (gItems != null)
            await gItems.Refresh();
    }

    // VB6 gItems_ValidateEdit Price case (FAssembly.frm:2425) message for an
    // attempt to edit an "Item DB" row's price. Shared by OnCellEdit (cancel),
    // OnGridCellSave (batch) and OnTypeAheadCommit (bulk).
    private async Task ShowItemDbPriceNotEditableAsync()
    {
        const string msg = "Item DB prices are not editable. To enter a price here you must first select a vendor then set the pricing level.";
        if (_messageBox != null)
            await _messageBox.ShowAsync(msg, title: "Price not editable",
                buttons: MessageBoxButtons.Ok);
        else
            Notifications.Info(msg);
    }

    private async Task OnTypeAheadCommit(TypeAheadCommitArgs<AssemblyItemRow> args)
    {
        if (string.IsNullOrWhiteSpace(args.ColumnName))
            return;

        var field = args.ColumnName;
        var isPrice = string.Equals(field, "Price", StringComparison.OrdinalIgnoreCase);

        // VB6 forbids editing an "Item DB" row's price (FAssembly.frm:2424).
        // In a bulk type-ahead fan-out, silently skip those rows and warn once
        // if any were skipped, rather than rejecting the whole commit.
        var skippedItemDb = false;
        var applied = 0;
        foreach (var record in args.SelectedItems)
        {
            if (isPrice && record.PriceLevel == "Item DB")
            {
                skippedItemDb = true;
                continue;
            }
            if (TrySetAssemblyItemField(record, field, args.Value))
            {
                RecalculateAfterEdit(record, field);
                applied++;
            }
        }
        if (skippedItemDb)
            await ShowItemDbPriceNotEditableAsync();
        if (applied == 0) return;

        mDirty = true;
        RecalculateCosts();

        await InvokeAsync(StateHasChanged);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ── Multi-select totals pill (VB6 gItems_SelChange / ShowTip parity) ──
    // ═══════════════════════════════════════════════════════════════════════
    /// <summary>Decides whether to show / hide / refresh the multi-select
    /// totals pill in response to a SelectionChanged event from gItems.
    /// Called from gridEvents.SelectionChanged (fires on every selection
    /// transition — click, drag-select-each-row, Select All, Clear).
    ///
    /// Selection &lt; 2: hide immediately (single-row selection is the same
    /// state the user already sees in the cell highlight; no pill needed).
    ///
    /// Selection ≥ 2: debounce SumTipShowDebounceMs so a drag-select that
    /// touches 30 rows in 1 s only paints the pill once. After the debounce
    /// window, ask the JS mouse tracker for the latest cursor X/Y, compute
    /// summed OrderQty / PretaxAmount / TaxAmount / ExtendedAmount, position
    /// the pill, show it, and arm an SumTipAutoHideMs auto-hide timer.
    ///
    /// The auto-hide timer is restarted on every fresh SelectionChanged so
    /// active multi-select gestures keep the pill alive; once the user
    /// pauses, the timer drains and the pill fades.</summary>
    private async Task UpdateSumTipForSelectionAsync(int count)
    {
        _sumTipShowDebounceCts?.Cancel();
        if (count < 2)
        {
            _sumTipHideCts?.Cancel();
            if (_sumTipVisible)
            {
                _sumTipVisible = false;
                StateHasChanged();
            }
            return;
        }

        var cts = new CancellationTokenSource();
        _sumTipShowDebounceCts = cts;
        try
        {
            await Task.Delay(SumTipShowDebounceMs, cts.Token);
        }
        catch (TaskCanceledException)
        {
            // Another SelectionChanged arrived inside the debounce window —
            // the newer call will handle the final state.
            return;
        }

        if (gItems == null) return;
        var sel = gItems.GetSelectedRecords().ToList();
        if (sel.Count < 2)
        {
            // Selection collapsed during debounce; nothing to show.
            return;
        }

        // VB6 shows the quantity line only when the drag/active column is a
        // quantity column (OrderQty or TakeoffQty); dragging PO Index (or any
        // non-qty column) shows only Pretax/Tax/Total.
        var field = gItems.GetCurrentColumnField() ?? "";
        _sumTipShowQty = field.Equals("OrderQty", StringComparison.OrdinalIgnoreCase)
                      || field.Equals("TakeoffQty", StringComparison.OrdinalIgnoreCase);
        _sumTipQtyLabel = field;
        _sumTipQty = field.Equals("TakeoffQty", StringComparison.OrdinalIgnoreCase)
            ? sel.Sum(r => r.TakeoffQty)
            : sel.Sum(r => r.OrderQty);
        _sumTipOrderQty = sel.Sum(r => r.OrderQty);
        _sumTipPretax   = sel.Sum(r => r.PretaxAmount ?? 0);
        _sumTipTax      = sel.Sum(r => r.TaxAmount ?? 0);
        _sumTipTotal    = sel.Sum(r => r.ExtendedAmount ?? 0);

        // Read cached cursor coords from JS. The tracker is installed in
        // fx-mousetrack.js (referenced from App.razor) and just caches the
        // latest document-level mousemove. Defaults to top-left if the
        // tracker hasn't seen a move yet (first selection right after
        // load) — falls back to a reasonable on-screen position.
        try
        {
            var coords = await JSRuntime.InvokeAsync<double[]>("fxMouseTracker.getLast");
            if (coords != null && coords.Length >= 2)
            {
                // 14-px offset down-and-right so the pill doesn't sit
                // directly under the cursor (would obstruct the row).
                _sumTipX = coords[0] + 14;
                _sumTipY = coords[1] + 14;
            }
        }
        catch
        {
            // JS interop fails during prerender or if the script didn't
            // load — fall back to a safe corner instead of throwing.
            _sumTipX = 80;
            _sumTipY = 120;
        }

        _sumTipVisible = true;
        StateHasChanged();

        // Arm (or restart) the auto-hide timer.
        _sumTipHideCts?.Cancel();
        var hideCts = new CancellationTokenSource();
        _sumTipHideCts = hideCts;
        try
        {
            await Task.Delay(SumTipAutoHideMs, hideCts.Token);
            if (_sumTipVisible)
            {
                _sumTipVisible = false;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException)
        {
            // User dismissed the pill (click / new selection) — newer
            // call owns the visibility now.
        }
    }

    /// <summary>Immediate dismiss for the multi-select totals pill.
    /// Bound to the items-grid-wrap div's @onclick so any click that
    /// bubbles out of a row hides the pill — the next interaction the
    /// user makes also re-triggers SelectionChanged, which will rebuild
    /// the pill if the new selection still holds 2+ rows.</summary>
    private void HideSumTip()
    {
        _sumTipShowDebounceCts?.Cancel();
        _sumTipHideCts?.Cancel();
        if (_sumTipVisible)
        {
            _sumTipVisible = false;
            StateHasChanged();
        }
    }

    // ── HHM-111: Val()-style string wrappers for the five plain-TextBox
    //    numeric header fields (Bds/Bths/SqFt + Width/Length). null ⇄ "" so
