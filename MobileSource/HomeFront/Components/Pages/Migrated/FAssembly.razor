    private async Task StartComponentsResize(MouseEventArgs e)
    {
        await RefreshViewportHeightAsync();
        _componentsGridHeight = ClampComponentsGridHeight(_componentsGridHeight);
        _isResizingComponentsGrid = true;
        _resizeStartY = e.ClientY;
        _resizeStartHeight = _componentsGridHeight;
    }

    private void HandleComponentsResizeMove(MouseEventArgs e)
    {
        if (!_isResizingComponentsGrid) return;
        var delta = e.ClientY - _resizeStartY;
        _componentsGridHeight = ClampComponentsGridHeight(_resizeStartHeight + delta);
    }

    private void EndComponentsResize(MouseEventArgs e)
    {
        _isResizingComponentsGrid = false;
    }

    private double ClampComponentsGridHeight(double value)
    {
        var max = EffectiveComponentsGridMaxHeight;
        if (value < ComponentsGridMinHeight) return ComponentsGridMinHeight;
        return value > max ? max : value;
    }

    private async Task RefreshViewportHeightAsync()
    {
        try
        {
            _viewportHeight = await JSRuntime.InvokeAsync<double>("fxViewport.getHeight");
        }
        catch
        {
            _viewportHeight = 0;
        }
    }

