@page "/edit-model-assembly-community-selector"
@rendermode InteractiveServer

@using HomeFront.Components.Pages.Migrated
@using HomeFront.Components.Hf
@inject NavigationManager Navigation

<h1>Model &amp; Option Library</h1>

<HfButton CssClass="hf-btn-primary" OnClick="OpenPickList">Open Model &amp; Option Library</HfButton>

<hr/>

@if (selectedData != null && selectedData.Count > 0){
    <h3>Selected Items:</h3>
    <table class="table">
        <thead>
        <tr>
            @foreach (var key in selectedData[0].Keys){
                <th>@key</th>
            }
        </tr>
        </thead>
        <tbody>
        @foreach (var row in selectedData){
            <tr>
                @foreach (var val in row.Values){
                    <td>@val</td>
                }
            </tr>
        }
        </tbody>
    </table>
}
else if (selectedData != null){
    <p><em>No items selected.</em></p>
}

<FPickListOrig @ref="pickList"
           Title="Model &amp; Option Library"
           Sql="@modelOptionSql"
           Views="All|Active Only|By Community"
           Columns="Category|Area|Community|Model|Option|Assembly|Description"
           KeyColumns="Assembly"
           SortCol="Model"
           AllowMultiple="false"
           AllowNew="true"
           Prompt="Select a model/option assembly from the list below:"
           OnSelected="OnItemsSelected"
           OnCancel="OnPickListCancelled" />

@code {
    private FPickListOrig? pickList;
    private List<IDictionary<string, object>>? selectedData;

    // This is the exact SQL used in the original VB6 FAssembly.frm
    private string modelOptionSql = @"
        select c.area AreaID,c.description as Community,a.Model,a.Model modelid,a.OptionID,a.Assembly,a.Description,a.assemblytype,0 Source,a.Series,a.Style,a.Elevation
        from tbldbassemblymaster a left outer join tbllocality c on(a.community=c.area)
        where a.DivisionID = 1 and isnull(a.inactive,0)=0 and a.assemblytype=0 order by 1,2,3,4,5,6,7";

    private void OpenPickList()
    {
        // FPickList renders inline; navigation or visibility toggle can be added later
    }

    private void OnItemsSelected(List<IDictionary<string, object>> selected)
    {
        selectedData = selected;
        StateHasChanged();
        Console.WriteLine($"Selected {selected.Count} item(s)");
    }

    private void OnPickListCancelled()
    {
        selectedData = new List<IDictionary<string, object>>();
        StateHasChanged();
        Console.WriteLine("PickList cancelled");
    }
}
