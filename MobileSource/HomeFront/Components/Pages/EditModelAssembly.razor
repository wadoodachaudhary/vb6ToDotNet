        if (string.IsNullOrWhiteSpace(Description)) { await JSRuntime.InvokeVoidAsync("alert", "Description is required"); return; }
        await JSRuntime.InvokeVoidAsync("alert", "Save not implemented in demo mode.");
        mDirty = false;
    }

