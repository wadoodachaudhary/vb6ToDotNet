    private void RecalculateCosts()
    {
        AssemblyCost = ItemsData.Sum(i => i.ExtendedAmount);
        AssemblyCostLabel = AssemblyCost.ToString("$#,##0.00");
        if (!string.IsNullOrEmpty(PricingCommunity))
        {
            ComponentCostLabel = ComponentCost.ToString("$#,##0.00");
            TotalCostLabel = (AssemblyCost + ComponentCost).ToString("$#,##0.00");
        }
    }

    private async Task OnNewClick()
    {
        if (!await ConfirmSaveAsync()) return;
        var result = await JSRuntime.InvokeAsync<string>("prompt", "New Assembly Type:\n1=Model\n2=Option\n3=Global\n4=DC Option");
        if (string.IsNullOrWhiteSpace(result)) return;
        mAssemblyType = result.Trim() switch { "1" => AssemblyTypes.atModel, "2" => AssemblyTypes.atoption, "3" => AssemblyTypes.atGlobal, "4" => AssemblyTypes.atDesignCenter, _ => AssemblyTypes.atoption };
        mAssemblyID = 0;
        mCommunity = mModel = mOptionID = mAssembly = "";
        OptionID = AssemblyCode = Description = "";
        IsActive = true;
        mDirty = true;
        await LoadDataAsync();
    }

