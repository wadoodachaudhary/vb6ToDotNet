    // ── Event Handlers ───────────────────────────────────────────────────
    private async Task OnPriceCommunityChanged(ChangeEventArgs e)
    {
        var selectedValue = e.Value?.ToString() ?? "";
        if (!string.IsNullOrEmpty(selectedValue))
        {
            var parts = selectedValue.Split((char)2);
            PricingCommunity = parts[0];
            PricingCommunityPhase = parts.Length > 1 ? parts[1] : "";
            mPricingCommunity = PricingCommunity;
            mPricingCommunityPhase = PricingCommunityPhase;
            ShowPricing = true;
        }
        else
        {
            ShowPricing = false;
            PricingCommunity = "";
            PricingCommunityPhase = "";
        }
        await LoadDataAsync();
    }

    private async Task MassEditSelectedQty()
    {
        if (ItemsGrid == null) return;

        // Try row-based selection first
        var selectedRecords = ItemsGrid.GetSelectedRecords().ToList();
        if (selectedRecords.Count > 0)
        {
            var result = await JSRuntime.InvokeAsync<bool>("confirm", $"Set OrderQty to 100 for {selectedRecords.Count} selected row(s)?");
            if (!result) return;
            foreach (var record in selectedRecords)
            {
                record.OrderQty = 100;
                // Recalculate extended amount
                record.PretaxAmount = record.Price * record.OrderQty;
                record.TaxAmount = record.PretaxAmount * record.TaxRate;
                record.ExtendedAmount = record.PretaxAmount + record.TaxAmount;
            }
            RecalculateCosts();
            await ItemsGrid.Refresh();
            mDirty = true;
            return;
        }

        // Fall back to cell-based selection
        var cells = await ItemsGrid.GetSelectedRowCellIndexesAsync();
        if (cells.Count == 0) return;
        var cellResult = await JSRuntime.InvokeAsync<bool>("confirm", $"Set {cells.Count} selected Qty values to 100?");
        if (!cellResult) return;
        foreach (var cell in cells)
        {
            var columns = ItemsGrid.Columns;
            if (cell.CellIndex < columns.Count && columns[cell.CellIndex].Field == nameof(AssemblyItemRow.OrderQty))
            {
                if (cell.RowIndex < ItemsData.Count)
                {
                    ItemsData[cell.RowIndex].OrderQty = 100;
                    await ItemsGrid.UpdateCellAsync(cell.RowIndex, nameof(AssemblyItemRow.OrderQty), 100.0);
                }
            }
        }
        RecalculateCosts();
        await ItemsGrid.Refresh();
        mDirty = true;
    }

