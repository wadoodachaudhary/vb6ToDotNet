@namespace HomeFront.Components.Grid
@typeparam TValue

<div class="hf-treegrid"
     style="@(string.IsNullOrEmpty(Height) ? "" : $"height:{Height};") @(string.IsNullOrEmpty(Width) ? "" : $"width:{Width};")">

    @* ── Collect column definitions ─────────────────────────────── *@
    <CascadingValue Value="@((IHfTreeGridOwner)this)" IsFixed="true">
        <div style="display:none">
            @ChildContent
        </div>
    </CascadingValue>

    @* ── Tree Table ─────────────────────────────────────────────── *@
    <div class="hf-treegrid-content">
        <table class="hf-treegrid-table">
            <thead class="hf-treegrid-header">
                <tr>
                    @foreach (var col in VisibleColumns)
                    {
                        <th class="hf-treegrid-header-cell"
                            style="@col.GetHeaderStyle()">
                            @col.DisplayHeader
                        </th>
                    }
                </tr>
            </thead>
            <tbody class="hf-treegrid-body">
                @{ var rowIdx = 0; }
                @foreach (var node in VisibleNodes)
                {
                    var currentIdx = rowIdx;
                    var isSelected = AllowSelection && _selectedItem != null && EqualityComparer<TValue>.Default.Equals(node.Data, _selectedItem);

                    <tr class="hf-treegrid-row @(isSelected ? "hf-treegrid-selected" : "") @(EnableHover ? "hf-treegrid-hover" : "")"
                        @onclick="() => HandleRowClick(node, currentIdx)">

                        @{ var colIdx = 0; }
                        @foreach (var col in VisibleColumns)
                        {
                            <td class="hf-treegrid-cell" style="@col.GetCellStyle()">
                                @if (colIdx == ResolvedTreeColumnIndex)
                                {
                                    @* Indent + expand/collapse icon + cell value *@
                                    <span style="display:inline-block; width:@(node.Level * 40)px;"></span>

                                    @if (node.HasChildren)
                                    {
                                        <span class="hf-treegrid-expand-icon @(node.IsExpanded ? "expanded" : "collapsed")"
                                              @onclick="() => ToggleNode(node)"
                                              @onclick:stopPropagation="true">
                                            @(node.IsExpanded ? "📂" : "📁")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="hf-treegrid-expand-icon hf-treegrid-leaf-icon">📄</span>
                                    }

                                    @if (col.Template != null)
                                    {
                                        @col.Template((object)node.Data!)
                                    }
                                    else
                                    {
                                        <span class="hf-treegrid-cell-text @(node.HasChildren ? "hf-treegrid-parent-text" : "")">
                                            @GetCellDisplayValue(node.Data, col)
                                        </span>
                                    }
                                }
                                else
                                {
                                    @if (col.Template != null)
                                    {
                                        @col.Template((object)node.Data!)
                                    }
                                    else
                                    {
                                        @GetCellDisplayValue(node.Data, col)
                                    }
                                }
                            </td>
                            colIdx++;
                        }
                    </tr>
                    rowIdx++;
                }

                @if (!VisibleNodes.Any())
                {
                    <tr>
                        <td colspan="@VisibleColumns.Count" class="hf-treegrid-empty">
                            No records to display
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
