@namespace HomeFront.Components.Grid
@typeparam TValue
@using System.Reflection
@using System.Globalization

<div class="hf-grid @(GridLines == GridLines.None ? "hf-grid-lines-none" : GridLines == GridLines.Horizontal ? "hf-grid-lines-horizontal" : GridLines == GridLines.Vertical ? "hf-grid-lines-vertical" : "")"
     style="@(string.IsNullOrEmpty(Height) ? "" : $"height:{Height};") @(string.IsNullOrEmpty(Width) ? "" : $"width:{Width};")"
     tabindex="0"
     @onkeydown="HandleKeyDown">

    @* ── Toolbar ──────────────────────────────────────────────── *@
    @if (Toolbar is { Count: > 0 } || ShowSearchBar)
    {
        <div class="hf-grid-toolbar">
            @if (Toolbar is { Count: > 0 })
            {
                @foreach (var item in Toolbar)
                {
                    <button class="hf-toolbar-btn" @onclick="() => OnToolbarClick(item)">@item</button>
                }
            }
            @if (ShowSearchBar)
            {
                <div class="hf-toolbar-search">
                    <input type="text" placeholder="Search..."
                           @bind="SearchText" @bind:event="oninput"
                           @bind:after="ApplySearchDebounced" />
                </div>
            }
        </div>
    }

    @* ── Group Drop Area (drag-and-drop grouping) ────────────── *@
    @if (AllowGrouping)
    {
        <div class="hf-group-drop-area @(_dragOverGroupArea ? "hf-group-drop-hover" : "")"
             @ondragover="HandleGroupAreaDragOver"
             @ondragover:preventDefault="true"
             @ondragleave="HandleGroupAreaDragLeave"
             @ondrop="HandleGroupAreaDrop">
            @if (_groupDescriptors.Count == 0)
            {
                <span class="hf-group-drop-hint">Drag a column header here to group by that column</span>
            }
            else
            {
                @if (ShowGroupExpandCollapse)
                {
                    <button class="hf-group-expand-collapse-btn" @onclick="ToggleExpandCollapseAll" @onclick:stopPropagation="true"
                            title="@(_allGroupsCollapsed ? "Expand All Groups" : "Collapse All Groups")">
                        @(_allGroupsCollapsed ? "⊞" : "⊟")
                    </button>
                }
                @foreach (var gd in _groupDescriptors)
                {
                    <span class="hf-group-chip" draggable="true"
                          @ondragstart="() => StartGroupChipDrag(gd.Field)">
                        <span class="hf-group-chip-text">@gd.HeaderText</span>
                        <span class="hf-group-chip-remove" @onclick="() => RemoveGroup(gd.Field)" @onclick:stopPropagation="true">×</span>
                    </span>
                }
            }
        </div>
    }

    @* ── Selection Info Bar ─────────────────────────────────── *@
    @if (AllowSelection && (_selectedItems.Count > 1 || _selectedCells.Count > 0))
    {
        <div class="hf-selection-info-bar">
            @if (_selectedItems.Count > 1)
            {
                <span>@_selectedItems.Count rows selected</span>
            }
            @if (_selectedCells.Count > 0)
            {
                <span>@_selectedCells.Count cells selected</span>
            }
            <button class="hf-selection-clear-btn" @onclick="ClearSelectionAsync">Clear Selection</button>
        </div>
    }

    @* ── Collect column definitions ───────────────────────────── *@
    <CascadingValue Value="@((IHfGridOwner)this)" IsFixed="true">
        <div style="display:none">
            @ChildContent
        </div>
    </CascadingValue>

    @* ── Grid Table ───────────────────────────────────────────── *@
    <div class="hf-grid-content" style="@(string.IsNullOrEmpty(Height) ? "" : "overflow:auto; flex:1;")">
        <table class="hf-grid-table">

            @* Header *@
            <thead class="hf-grid-header">
                <tr>
                    @if (ShowCheckboxColumn)
                    {
                        <th class="hf-header-cell hf-checkbox-cell" style="width:50px;">
                            <input type="checkbox" checked="@AllRowsSelected"
                                   @onchange="ToggleSelectAll" />
                        </th>
                    }
                    @if (AllowGrouping && _groupDescriptors.Count > 0)
                    {
                        @for (int gi = 0; gi < _groupDescriptors.Count; gi++)
                        {
                            <th class="hf-header-cell hf-group-indent" style="width:32px;"></th>
                        }
                    }
                    @foreach (var col in VisibleColumns)
                    {
                        var state = GetColumnState(col.Field);
                        <th class="hf-header-cell @(state.SortDirection.HasValue ? "hf-sorted" : "") @(state.FilterActive ? "hf-filtered" : "") @(AllowResizing && col.AllowResizing ? "hf-resizable" : "")"
                            style="@col.GetHeaderStyle(); position:relative;"
                            @onclick="() => HandleSort(col)"
                            title="@col.DisplayHeader"
                            draggable="@(AllowGrouping && col.AllowGrouping ? "true" : "false")"
                            @ondragstart="() => StartColumnDrag(col.Field)"
                            @ondragend="EndColumnDrag">

                            @if (col.HeaderTemplate != null)
                            {
                                @col.HeaderTemplate
                            }
                            else
                            {
                                <span class="hf-header-text">@col.DisplayHeader</span>
                            }

                            @if (AllowSorting && col.AllowSorting && state.SortDirection.HasValue)
                            {
                                <span class="hf-sort-icon">@(state.SortDirection == SortDirection.Ascending ? "▲" : "▼")</span>
                            }

                            @if (AllowFiltering && col.AllowFiltering)
                            {
                                <span class="hf-filter-icon @(state.FilterActive ? "active" : "")"
                                      @onclick:stopPropagation="true"
                                      @onclick="() => ToggleFilterPopup(col.Field)">⧩</span>
                            }

                            @* ── Resize Handle ────────────────────────── *@
                            @if (AllowResizing && col.AllowResizing)
                            {
                                <span class="hf-resize-handle"
                                      @onmousedown="e => StartResize(col, e)"
                                      @onmousedown:stopPropagation="true"
                                      @onclick:stopPropagation="true"></span>
                            }
                        </th>
                    }
                </tr>

                @* Filter bar row *@
                @if (AllowFiltering && ResolvedFilterType == FilterType.FilterBar)
                {
                    <tr class="hf-filter-row">
                        @if (ShowCheckboxColumn)
                        {
                            <td class="hf-filter-cell"></td>
                        }
                        @if (AllowGrouping && _groupDescriptors.Count > 0)
                        {
                            @for (int gi = 0; gi < _groupDescriptors.Count; gi++)
                            {
                                <td class="hf-filter-cell hf-group-indent"></td>
                            }
                        }
                        @foreach (var col in VisibleColumns)
                        {
                            <td class="hf-filter-cell">
                                @if (col.AllowFiltering)
                                {
                                    <input type="text" class="hf-filter-input"
                                           placeholder="Filter..."
                                           value="@GetColumnState(col.Field).FilterValue"
                                           @onchange="e => ApplyFilter(col.Field, e.Value?.ToString())" />
                                }
                            </td>
                        }
                    </tr>
                }
            </thead>

            @* Body *@
            <tbody class="hf-grid-body">
                @if (_isEditing && EditSettingsRef?.Mode == EditMode.Inline && _editingRowIndex == -1 && EditSettingsRef.NewRowPosition == NewRowPosition.Top)
                {
                    @RenderEditRow()
                }

                @* ── Grouped or flat rendering ─────────────────── *@
                @if (AllowGrouping && _groupDescriptors.Count > 0)
                {
                    @RenderGroupedRows(GroupedData, 0)
                }
                else
                {
                    var rowIdx = 0;
                    @foreach (var item in PagedData)
                    {
                        var currentIdx = rowIdx;
                        var isSelected = _selectedItems.Contains(item);
                        var isEditingThis = _isEditing && EditSettingsRef?.Mode == EditMode.Inline && _editingRowIndex == currentIdx;

                        @if (isEditingThis)
                        {
                            @RenderEditRow()
                        }
                        else
                        {
                            <tr class="hf-row @(rowIdx % 2 == 1 && EnableAltRow ? "hf-alt-row" : "") @(isSelected ? "hf-selected" : "") @(EnableHover ? "hf-hover" : "")"
                                @onclick="(MouseEventArgs e) => HandleRowClick(item, currentIdx, e)"
                                @ondblclick="() => HandleRowDblClick(item, currentIdx)"
                                style="@(RowHeight > 0 ? $"height:{RowHeight}px;" : "")">

                                @if (ShowCheckboxColumn)
                                {
                                    <td class="hf-cell hf-checkbox-cell" style="width:50px;">
                                        <input type="checkbox" checked="@isSelected"
                                               @onclick:stopPropagation="true"
                                               @onchange="() => ToggleRowSelection(item, currentIdx)" />
                                    </td>
                                }

                                @RenderDataCells(item, currentIdx, col => col)
                            </tr>
                        }
                        rowIdx++;
                    }
                }

                @if (_isEditing && EditSettingsRef?.Mode == EditMode.Inline && _editingRowIndex == -1 && EditSettingsRef.NewRowPosition == NewRowPosition.Bottom)
                {
                    @RenderEditRow()
                }

                @if (!HasAnyData)
                {
                    <tr>
                        <td colspan="@TotalColumnCount" class="hf-empty-row">
                            No records to display
                        </td>
                    </tr>
                }
            </tbody>

            @* ── Grid Footer (aggregates across all data) ──────── *@
            @if (AggregateRows is { Count: > 0 })
            {
                var footerRows = AggregateRows.Where(r => r.ShowInFooter).ToList();
                if (footerRows.Count > 0)
                {
                    var allItems = SortedData.ToList();
                    var footerAggs = ComputeAggregates(allItems);
                    <tfoot class="hf-grid-footer">
                        @foreach (var aggRow in footerRows)
                        {
                            <tr class="hf-aggregate-footer-row">
                                @if (ShowCheckboxColumn)
                                {
                                    <td class="hf-cell hf-aggregate-cell"></td>
                                }
                                @if (AllowGrouping && _groupDescriptors.Count > 0)
                                {
                                    @for (int gi = 0; gi < _groupDescriptors.Count; gi++)
                                    {
                                        <td class="hf-cell hf-group-indent"></td>
                                    }
                                }
                                @foreach (var col in VisibleColumns)
                                {
                                    var aggCol = aggRow.Columns.FirstOrDefault(a => a.Field == col.Field);
                                    <td class="hf-cell hf-aggregate-cell" style="@col.GetCellStyle()">
                                        @if (aggCol != null)
                                        {
                                            var key = $"{aggCol.Field}_{aggCol.Type}";
                                            footerAggs.TryGetValue(key, out var val);
                                            <span class="hf-aggregate-value">@FormatAggregateValue(aggCol, val)</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tfoot>
                }
            }
        </table>
    </div>

    @* ── Pager ────────────────────────────────────────────────── *@
    @if (AllowPaging)
    {
        <div class="hf-grid-pager">
            <div class="hf-pager-info">
                @(_pageState.TotalRecords) items
            </div>
            <div class="hf-pager-nav">
                <button class="hf-pager-btn" disabled="@(_pageState.CurrentPage <= 1)" @onclick="() => GoToPage(1)">⟨⟨</button>
                <button class="hf-pager-btn" disabled="@(_pageState.CurrentPage <= 1)" @onclick="() => GoToPage(_pageState.CurrentPage - 1)">⟨</button>

                @foreach (var p in GetPageNumbers())
                {
                    var page = p;
                    <button class="hf-pager-btn @(page == _pageState.CurrentPage ? "hf-pager-active" : "")"
                            @onclick="() => GoToPage(page)">@(page)</button>
                }

                <button class="hf-pager-btn" disabled="@(_pageState.CurrentPage >= _pageState.TotalPages)" @onclick="() => GoToPage(_pageState.CurrentPage + 1)">⟩</button>
                <button class="hf-pager-btn" disabled="@(_pageState.CurrentPage >= _pageState.TotalPages)" @onclick="() => GoToPage(_pageState.TotalPages)">⟩⟩</button>
            </div>
            <div class="hf-pager-size">
                <select @onchange="HandlePageSizeChange">
                    @foreach (var size in ResolvedPageSizes)
                    {
                        <option value="@size" selected="@(size == _pageState.PageSize)">@size / page</option>
                    }
                </select>
            </div>
        </div>
    }

    @* ── Filter Popup (Menu/Checkbox) ─────────────────────────── *@
    @if (_filterPopupField != null)
    {
        var col = VisibleColumns.FirstOrDefault(c => c.Field == _filterPopupField);
        var state = GetColumnState(_filterPopupField);

        <div class="hf-filter-popup-overlay" @onclick="CloseFilterPopup">
            <div class="hf-filter-popup" @onclick:stopPropagation="true">
                <div class="hf-filter-popup-header">Filter: @col?.DisplayHeader</div>

                @if (ResolvedFilterType == FilterType.CheckBox || col?.FilterSettings?.Type == FilterType.CheckBox)
                {
                    <div class="hf-filter-checkbox-list">
                        @foreach (var val in GetDistinctValues(_filterPopupField))
                        {
                            var v = val;
                            <label class="hf-filter-checkbox-item">
                                <input type="checkbox" checked="@state.CheckedFilterValues.Contains(v)"
                                       @onchange="() => ToggleCheckboxFilter(_filterPopupField, v)" />
                                @v
                            </label>
                        }
                    </div>
                }
                else
                {
                    <input type="text" class="hf-filter-popup-input"
                           placeholder="Contains..."
                           value="@state.FilterValue"
                           @onchange="e => ApplyFilter(_filterPopupField, e.Value?.ToString())" />
                }

                <div class="hf-filter-popup-actions">
                    <button class="hf-filter-popup-btn" @onclick="() => ClearFilter(_filterPopupField)">Clear</button>
                    <button class="hf-filter-popup-btn hf-primary" @onclick="CloseFilterPopup">OK</button>
                </div>
            </div>
        </div>
    }

    @* ── Edit Dialog ──────────────────────────────────────────── *@
    @if (_isEditing && EditSettingsRef?.Mode == EditMode.Dialog)
    {
        <div class="hf-dialog-overlay" @onclick="CancelEdit">
            <div class="hf-dialog" @onclick:stopPropagation="true">
                <div class="hf-dialog-header">
                    @(_editingRowIndex >= 0 ? "Edit Record" : "Add New Record")
                    <button class="hf-dialog-close" @onclick="CancelEdit">×</button>
                </div>
                <div class="hf-dialog-body">
                    @foreach (var col in VisibleColumns.Where(c => c.AllowEditing && !string.IsNullOrEmpty(c.Field) && c.Type != ColumnType.CheckBox && c.Commands == null))
                    {
                        <div class="hf-dialog-field">
                            <label>@col.DisplayHeader</label>
                            @if (col.EditTemplate != null && _editItem != null)
                            {
                                @col.EditTemplate((object)_editItem)
                            }
                            else
                            {
                                <input type="@(col.Type == ColumnType.Number ? "number" : col.Type == ColumnType.Date ? "date" : "text")"
                                       value="@GetPropertyValue(_editItem, col.Field)"
                                       disabled="@col.IsPrimaryKey"
                                       @onchange="e => SetPropertyValue(_editItem, col.Field, e.Value?.ToString())" />
                            }
                        </div>
                    }
                </div>
                <div class="hf-dialog-footer">
                    <button class="hf-dialog-btn" @onclick="CancelEdit">Cancel</button>
                    <button class="hf-dialog-btn hf-primary" @onclick="SaveEdit">Save</button>
                </div>
            </div>
        </div>
    }

    @* ── Resize Overlay (captures mousemove/mouseup during resize) ─ *@
    @if (_resizingCol != null)
    {
        <div class="hf-resize-overlay"
             @onmousemove="HandleResizeMove"
             @onmouseup="EndResize"
             @onmouseleave="EndResize"></div>
    }
</div>
