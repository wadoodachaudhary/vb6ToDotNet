@namespace HomeFront.Components.Syncfusion.Navigations

<CascadingValue Value="this" IsFixed="true">
    <div class="hf-tabs @CssClass">
        <div class="hf-tab-headers">
            @for (var i = 0; i < _items.Count; i++)
            {
                <button class="hf-tab-button @(i == SelectedIndex ? "active" : "")"
                        type="button"
                        @onclick="() => SelectTab(i)">
                    @_items[i].HeaderText
                </button>
            }
        </div>
        <div class="hf-tab-content">
            @if (SelectedIndex >= 0 && SelectedIndex < _items.Count)
            {
                @_items[SelectedIndex].RenderContent
            }
        </div>
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly List<SfTabItem> _items = new();

    [Parameter] public int SelectedIndex { get; set; }
    [Parameter] public EventCallback<int> SelectedIndexChanged { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal void Register(SfTabItem item)
    {
        if (!_items.Contains(item))
        {
            _items.Add(item);
            StateHasChanged();
        }
    }

    private async Task SelectTab(int index)
    {
        if (SelectedIndex != index)
        {
            SelectedIndex = index;
            if (SelectedIndexChanged.HasDelegate)
            {
                await SelectedIndexChanged.InvokeAsync(index);
            }
        }
    }
}
