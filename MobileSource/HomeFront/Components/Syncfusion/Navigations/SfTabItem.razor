@namespace HomeFront.Components.Syncfusion.Navigations

@code {
    [CascadingParameter] public SfTab? Parent { get; set; }

    [Parameter] public string HeaderText { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal RenderFragment? RenderContent => Content ?? ChildContent;

    protected override void OnInitialized()
    {
        Parent?.Register(this);
    }
}
