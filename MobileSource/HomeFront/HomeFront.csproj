<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>c186d554-a324-4c14-9167-8da00d6a110b</UserSecretsId>
    <Version>$([System.DateTime]::Now.ToString("yyyy.M"))</Version>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!-- HHM-557: reads legacy BIFF .xls (Excel 97-2003 / OLE compound) files produced by VB6
         Export Assemblies (MAssemblyImport.bas:161 -> FDataExport.frm:164-168, VSFlexGrid
         SaveGrid flexFileExcel) — ClosedXML is .xlsx-only. Reader API only (no DataSet pkg). -->
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="CrystalReports.Engine" Version="13.0.4003" />
    <PackageReference Include="PdfSharp" Version="6.1.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.0" />
    <PackageReference Include="AWSSDK.CognitoIdentityProvider" Version="4.0.101.1" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Development mode: consume FlexKit as an external sibling project so
      shared control changes are picked up without repacking a NuGet snapshot.

      Deployment/customer handoff mode: do not ship the FlexKit source. Switch
      this back to a FlexKit PackageReference and include the packed FlexKit
      nupkg/DLL with the app.
    -->
    <ProjectReference Include="..\..\..\FlexKit\FlexKit.csproj" />
  </ItemGroup>
</Project>
