    s = s & ", TaxGroup, TaxGroupDesc, TaxRate, JCTaxRate, NJCTaxRate, Pretax, Tax, NJCTax, JCTax" & vbCrLf
    s = s & ", Retainage, Description, UStmp, DStmp, tstmp" & vbCrLf
    s = s & ", InvoicedQuantity, InvoicedUnitPrice, RetainageRate, TaxRetainageRate)" & vbCrLf
