    s = s & ",x.UserName" & vbCrLf
    s = s & ",x.DateChgd" & vbCrLf
    s = s & ",x.UserName,getdate(),'Approved'" & vbCrLf
    s = s & "FROM OPENXML (@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_EPO/EPOItem',2) " & vbCrLf
    s = s & "WITH (JobNo     varchar(40)  'LotJob'" & vbCrLf
    s = s & "     ,POIndex   varchar(40)  'CostCode'" & vbCrLf
    s = s & "     ,EPOid     varchar(40)  'BuildProDocument/Document/DocNumber'" & vbCrLf
    s = s & "     ,DocSuffix varchar(40)  'BuildProDocument/Document/DocSuffix'" & vbCrLf
    s = s & "     ,DocType   varchar(40)  'BuildProDocument/Document/DocType'" & vbCrLf
    s = s & "     ,Vendor    varchar(40)  'Vendor/AddressBookEntry/AddressBookNumber'" & vbCrLf
    s = s & "     ,ItemNum   varchar(40)  'SequenceNumber'" & vbCrLf
    s = s & "     ,ItemDesc  varchar(500) 'ItemDescription'" & vbCrLf
