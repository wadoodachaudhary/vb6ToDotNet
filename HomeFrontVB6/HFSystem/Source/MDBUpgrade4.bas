    s = s & "                  ,isnull(nullif(d.WBS06,''),i.WBS06),isnull(nullif(d.WBS07,''),i.WBS07),isnull(nullif(d.WBS08,''),i.WBS08),isnull(nullif(d.WBS09,''),i.WBS09),isnull(nullif(d.WBS10,''),i.WBS10)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS11,''),i.WBS11),isnull(nullif(d.WBS12,''),i.WBS12),isnull(nullif(d.WBS13,''),i.WBS13),isnull(nullif(d.WBS14,''),i.WBS14),isnull(nullif(d.WBS15,''),i.WBS15)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS16,''),i.WBS16),isnull(nullif(d.WBS17,''),i.WBS17),isnull(nullif(d.WBS18,''),i.WBS18),isnull(nullif(d.WBS19,''),i.WBS19),isnull(nullif(d.WBS20,''),i.WBS20)" & vbCrLf
