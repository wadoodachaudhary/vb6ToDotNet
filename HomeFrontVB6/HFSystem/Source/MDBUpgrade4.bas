    s = s & "           SET POVendor = BudgetVendor" & vbCrLf
    s = s & "              ,POQty = BudgetQty" & vbCrLf
    s = s & "              ,PORate = BudgetRate" & vbCrLf
    s = s & "              ,POPretax = BudgetPretax" & vbCrLf
