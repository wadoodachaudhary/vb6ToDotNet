    s = s & "    join AppOptions  o on o.UID='' and o.DivisionID=@DivID and o.OptionName='AutoPayApprovedPOs' and o.OptionValue='True'" & vbCrLf
    s = s & "    join Invoices e ON e.DivisionID = i.DivisionID and i.PONumber+'.5'=e.Invoice and i.Vendor=e.Vendor and e.Source='autoinserting..'" & vbCrLf
    s = s & "    left join AppOptions  o2 on o2.UID='' and o2.DivisionID=@DivID and o2.OptionName='APInvoicesDefaultToBillable'" & vbCrLf
