    s = ""
    s = s & "alter PROCEDURE [dbo].[Purch_PutEstimateAssemblyItems](@EstAssemblyID INTEGER,@JCCategory VARCHAR(40),@DivisionID INTEGER) AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @Community          VARCHAR(10)" & vbCrLf
    s = s & "    DECLARE @CommunityPhase     VARCHAR(10)" & vbCrLf
    s = s & "    DECLARE @Customer_No        VARCHAR(12)" & vbCrLf
