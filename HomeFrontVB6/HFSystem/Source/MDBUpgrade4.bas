c = "Commnity wrap insurance exempt option was inverted"
    s = ""
    s = s & "alter TRIGGER [dbo].[POMaster_CreateInvoice] ON [dbo].[POMaster] AFTER UPDATE AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "declare @InvoiceID as int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- weird performance tweak. cache DivID and using it in joins makes things faster." & vbCrLf
    s = s & "declare @DivID as int" & vbCrLf
    s = s & "select top 1 @DivID=divisionid from inserted" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "IF UPDATE(ApprovedDate) BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    -- move to approved, any held invoices that reference ONLY this po" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "    SET status='Approved',Approver='AutoApproved',DateApproved=getdate()" & vbCrLf
    s = s & "    FROM invoices i" & vbCrLf
    s = s & "    JOIN AppOptions ao1 ON(ao1.OptionName='AutoReleaseHeldPOInvoices' and ao1.OptionValue='True' AND ao1.DivisionID = @DivID)     " & vbCrLf
    s = s & "    JOIN AppOptions ao2 ON(ao2.OptionName='SchedulingUsage' and ao2.OptionValue='3' AND ao2.DivisionID = @DivID)     " & vbCrLf
    s = s & "    WHERE i.status='Hold'" & vbCrLf
    s = s & "    AND invoiceid in(" & vbCrLf
    s = s & "        SELECT dd.invoiceid" & vbCrLf
    s = s & "        FROM invoiceitems dd" & vbCrLf
    s = s & "        WHERE invoiceid in(" & vbCrLf
    s = s & "            SELECT distinct d.invoiceid " & vbCrLf
    s = s & "            FROM InvoiceItems d" & vbCrLf
    s = s & "            JOIN INSERTED p on d.DivisionID=p.DivisionID and d.Vendor=p.Vendor and d.commitment=p.PONumber" & vbCrLf
    s = s & "        )" & vbCrLf
    s = s & "        GROUP BY dd.invoiceid" & vbCrLf
    s = s & "        HAVING COUNT(DISTINCT dd.commitment)=1" & vbCrLf
    s = s & "    )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    -- move to pending, any held invoices that reference something other than just this po" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "    SET status='Pending'" & vbCrLf
    s = s & "    FROM invoices i" & vbCrLf
    s = s & "    JOIN AppOptions ao1 ON(ao1.OptionName='AutoReleaseHeldPOInvoices' and ao1.OptionValue='True' AND ao1.DivisionID = @DivID)     " & vbCrLf
    s = s & "    JOIN AppOptions ao2 ON(ao2.OptionName='SchedulingUsage' and ao2.OptionValue='3' AND ao2.DivisionID = @DivID)     " & vbCrLf
    s = s & "    WHERE i.status='Hold' and i.Approver<>''" & vbCrLf
    s = s & "    AND invoiceid in(" & vbCrLf
    s = s & "        SELECT dd.invoiceid" & vbCrLf
    s = s & "        FROM invoiceitems dd" & vbCrLf
    s = s & "        WHERE invoiceid in(" & vbCrLf
    s = s & "            SELECT distinct d.invoiceid " & vbCrLf
    s = s & "            FROM InvoiceItems d" & vbCrLf
    s = s & "            JOIN INSERTED p on d.DivisionID=p.DivisionID and d.Vendor=p.Vendor and d.commitment=p.PONumber" & vbCrLf
    s = s & "        )" & vbCrLf
    s = s & "        GROUP BY dd.invoiceid" & vbCrLf
    s = s & "        HAVING COUNT(DISTINCT dd.commitment)>1" & vbCrLf
    s = s & "    )" & vbCrLf
    s = s & "END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "IF UPDATE(PayPoint1ApprovedDate) BEGIN" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    -- CREATE INVOICE FOR PAYPOINT1" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    INSERT INTO Invoices(DivisionID,Vendor,Comments,Status,Invoice,InvoiceDate,AccountingDate,Description,VendorName,PreTax,Tax,Discount,DiscountDate,Source,UStmp,TStmp,Approver,DateApproved,MiscDeductionAmt,PaymentDate)" & vbCrLf
    s = s & "    SELECT d.DivisionID,d.Vendor,i.Comments" & vbCrLf
    s = s & "          ,case when isnull(p.RequireLienRelease,0)=1 then 'Lien Hold' else 'SiteApproved' end Status" & vbCrLf
    s = s & "          ,dbo.Purch_GetNextInvoiceNumber(d.po) Invoice" & vbCrLf
    s = s & "          ,i.paypoint1ApprovedDate,i.paypoint1ApprovedDate" & vbCrLf
    s = s & "          ,MIN(case when isnull(xx.OptionValue,'')='True' then left(isnull(nullif(j.municipal_address,''),i.description),100) else LEFT(d.podesc,100) end) Description" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "          ,d.VendorDesc" & vbCrLf
    s = s & "          -- if 1 is last then use remaining else use percent" & vbCrLf
    s = s & "          ,case when isnull(p.paypoint5percent,0)=0 and isnull(isnull(p.paypoint4percent,0),0)=0 and isnull(p.paypoint3percent,0)=0 and isnull(p.paypoint2percent,0)=0 " & vbCrLf
    s = s & "                then SUM(ISNULL(d.lineRemainingPretax,0)) " & vbCrLf
    s = s & "                else SUM(round(ISNULL(d.linePretax,0)*isnull(p.paypoint1percent,0)/100,2)) " & vbCrLf
    s = s & "                end Pretax" & vbCrLf
    s = s & "          ,case when isnull(p.paypoint5percent,0)=0 and isnull(isnull(p.paypoint4percent,0),0)=0 and isnull(p.paypoint3percent,0)=0 and isnull(p.paypoint2percent,0)=0 " & vbCrLf
    s = s & "                then SUM(ISNULL(d.lineRemainingTax,0)) " & vbCrLf
    s = s & "            else SUM(round(ISNULL(d.linetax,0)*isnull(p.paypoint1percent,0)/100,2)) " & vbCrLf
    s = s & "                end Tax" & vbCrLf
    s = s & "          ,round(case when isnull(p.paypoint5percent,0)=0 and isnull(isnull(p.paypoint4percent,0),0)=0 and isnull(p.paypoint3percent,0)=0 and isnull(p.paypoint2percent,0)=0 " & vbCrLf
    s = s & "                then SUM(ISNULL(d.lineRemainingPretax,0)) " & vbCrLf
    s = s & "                else SUM(round(ISNULL(d.linePretax,0)*isnull(p.paypoint1percent,0)/100,2)) " & vbCrLf
    s = s & "                end * isnull(v.PayTermDiscPercent,0)/100,2) Discount" & vbCrLf
    s = s & "          ,getdate()+v.PayTermDiscDays" & vbCrLf
    s = s & "          ,'autoinserting..' Source,d.PayPoint1ApprovedBy UStmp,getdate() TStmp" & vbCrLf
    s = s & "          ,d.PayPoint1ApprovedBy Approver,getdate() DateApproved" & vbCrLf
    s = s & "          ,case when isnull(p.paypoint5percent,0)=0 and isnull(isnull(p.paypoint4percent,0),0)=0 and isnull(p.paypoint3percent,0)=0 and isnull(p.paypoint2percent,0)=0 " & vbCrLf
    s = s & "                then SUM(ISNULL(d.lineRemainingPretax,0) * case when isnull(c.WrapInsuranceExempt,0)=1 then 0 else 1 end * isnull(v.miscdeductionrate,0)/100 ) " & vbCrLf
    s = s & "                else SUM(round(ISNULL(d.linePretax,0)*isnull(p.paypoint1percent,0)/100,2)  * case when isnull(c.WrapInsuranceExempt,0)=1 then 0 else 1 end * isnull(v.miscdeductionrate,0)/100 ) " & vbCrLf
    s = s & "                end   MiscDeductionAmt" & vbCrLf
    s = s & "         ,dbo.CalcInvoicePayDate(@DivID, max(i.paypoint1approveddate), max(v.paytermnettype), max(v.paytermnetdays))" & vbCrLf
    s = s & "    FROM inserted    i" & vbCrLf
    s = s & "    join tblpoindex  p on i.divisionid=p.divisionid and i.poindex=p.poindex " & vbCrLf
    s = s & "    join jcpodetails d on i.DivisionID=d.DivisionID and i.ponumber=d.po" & vbCrLf
    s = s & "    join AppOptions  o on o.UID='' and o.DivisionID=@DivID and o.OptionName='AutoPayApprovedPOs' and o.OptionValue='True'" & vbCrLf
    s = s & "    left outer join Invoices e on i.DivisionID=e.DivisionID and e.Invoice like i.ponumber+'%' and i.Vendor=e.Vendor and e.Source='AutoApproved'" & vbCrLf
    s = s & "    left outer join tblvendors v on i.divisionid=v.divisionid and  i.vendor=v.vendor_id " & vbCrLf
    s = s & "    left join tbljobs j on d.divisionid=j.divisionid and d.linejob=j.job_no" & vbCrLf
    s = s & "    left join tbllocality c on j.community=c.area" & vbCrLf
    s = s & "    left join appoptions xx on xx.divisionid=@DivID and xx.optionname='InvDescDefaultsToJobAddr'" & vbCrLf
    s = s & "    WHERE i.paypoint1approveddate is not null AND isnull(p.paypoint1percent,0)<>0" & vbCrLf
    s = s & "    and isnull(v.istbd,0)=0" & vbCrLf
    s = s & "    and e.invoiceid is null" & vbCrLf
    s = s & "    GROUP BY d.DivisionID,d.Vendor,c.WrapInsuranceExempt,v.miscdeductionrate,i.comments,p.RequireLienRelease,v.paytermdiscpercent,v.paytermdiscdays,d.PO,i.paypoint1ApprovedDate,d.podesc,d.Vendordesc,d.PayPoint1ApprovedBy,isnull(p.paypoint5percent,0),isnull(p.paypoint4percent,0),isnull(p.paypoint3percent,0),isnull(p.paypoint2percent,0),xx.OptionValue,i.description" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    INSERT INTO InvoicePaymentPoints(InvoiceID,PONumber,PayPoint1)" & vbCrLf
    s = s & "    SELECT e.InvoiceID,i.ponumber,1" & vbCrLf
    s = s & "    FROM inserted    i" & vbCrLf
    s = s & "    join Invoices e ON e.DivisionID = i.DivisionID and i.PONumber=e.Invoice and i.Vendor=e.Vendor and e.Source='autoinserting..'" & vbCrLf
    s = s & "    WHERE i.paypoint1approveddate is not null" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    INSERT INTO InvoiceItems(DivisionID,InvoiceID,Vendor,Invoice,Commitment,CommitmentItem,CommitmentDesc,CommitmentVendor,Job,Extra,Phase,PhaseDesc,Category,CategoryDesc,InvoicedQuantity,InvoicedUnitPrice,TaxGroup,TaxGroupDesc,TaxRate,Description,RetainageRate,PreTax,Tax,Retainage,JCTaxRate,NJCTaxRate,WrapInsuranceExempt,debitaccount,billable)" & vbCrLf
    s = s & "    SELECT d.DivisionID,e.InvoiceID,e.Vendor,e.Invoice,d.PO,d.Line,LEFT(d.poDesc,200),d.Vendor,d.lineJob,d.lineExtra,d.lineCostCode,d.linecostcodeDesc,d.lineCategory,d.linecategoryDesc,d.LineRemainingQuantity,d.LineCommittedUnitPrice ,d.lineTaxGroup,d.lineTaxGroupdesc,d.lineTaxrate,left(d.LineDesc,100),d.Retainagerate" & vbCrLf
    s = s & " -- if 1 is last then use remaining else use percent" & vbCrLf
    s = s & "          ,case when isnull(p.paypoint5percent,0)=0 and isnull(p.paypoint4percent,0)=0 and isnull(p.paypoint3percent,0)=0 and isnull(p.paypoint2percent,0)=0 " & vbCrLf
    s = s & "                then d.lineRemainingPretax " & vbCrLf
