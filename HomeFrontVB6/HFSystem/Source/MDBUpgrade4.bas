    s = s & "        dateadd(mm,4,datefromparts(year(@InvDate),month(@InvDate),@TermNetDays))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when  @TermNetType='OnADayOfThe5thMonth' and @TermNetDays<>0 then" & vbCrLf
    s = s & "        dateadd(mm,5,datefromparts(year(@InvDate),month(@InvDate),@TermNetDays))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when  @TermNetType='OnADayOfThe6thMonth' and @TermNetDays<>0 then" & vbCrLf
    s = s & "        dateadd(mm,6,datefromparts(year(@InvDate),month(@InvDate),@TermNetDays))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when  @TermNetType='ExtendingToEOM' and @TermNetDays<>0 then        " & vbCrLf
    s = s & "        eomonth(datefromparts(year(dateadd(dd,@TermNetDays,@InvDate)),  month(dateadd(dd,@TermNetDays,@InvDate)),  day(dateadd(dd,@TermNetDays,@InvDate))))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when @required='true' then" & vbCrLf
