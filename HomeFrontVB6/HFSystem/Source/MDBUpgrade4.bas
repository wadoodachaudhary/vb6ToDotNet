    s = s & "                            AND a.HFDescription = b.Description" & vbCrLf
    s = s & "                        WHERE isnull(c.sold_to_customer, '') <> ''" & vbCrLf
    s = s & "                            AND c.Customer_No = @ClientInventoryHomeID" & vbCrLf
    s = s & "                            AND isnull(b.Other, '') <> ''" & vbCrLf
    s = s & "                            AND isnull(a.Other, '') <> isnull(b.Other, '')" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "                        --SET @sqlStatement = 'Update Style for spec home assemblies'" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "                        UPDATE a" & vbCrLf
    s = s & "                        SET Style = b.Style" & vbCrLf
    s = s & "                        FROM EstimateAssemblies a" & vbCrLf
    s = s & "                        INNER JOIN tblcustomers c ON c.customer_no = a.customer_no" & vbCrLf
    s = s & "                        INNER JOIN tblScheduleB b ON b.Customer_No = c.sold_to_Customer" & vbCrLf
    s = s & "                            AND a.OptionID = b.opt" & vbCrLf
