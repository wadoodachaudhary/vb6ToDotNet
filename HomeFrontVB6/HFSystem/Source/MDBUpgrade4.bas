    sql c, "insert into msgq_schedule(SysName,MsgType,Interval) values('Sales','PutInventoryHomesCODetailsCustoms',5)"


    s = ""
    s = s & "alter proc [dbo].[MsgQ_Sales_GetLotStatusUpdates_Post] @ID integer as" & vbCrLf
    s = s & "    -- Select the responsedata from the MsgQ task." & vbCrLf
    s = s & "    -- xml requests will use xml attributes not elements because payload is 30-40% smaller. " & vbCrLf
    s = s & "    -- Make inserts/updates to the HF tables accordingly." & vbCrLf
    s = s & "    -- use syntax like this to update the audit log if there is anything useful to be said." & vbCrLf
    s = s & "    --   UPDATE MsgQ SET Audit=isnull(Audit,'') + 'your log entry here' + char(13) + char(10) WHERE ID=@ID " & vbCrLf
    s = s & "    -- put errors in the status field" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "     -- select response from queue" & vbCrLf
    s = s & "    DECLARE @xml xml" & vbCrLf
    s = s & "    DECLARE @doc int" & vbCrLf
    s = s & "    SELECT @xml=Response FROM MsgQ WHERE ID=@ID" & vbCrLf
    s = s & "    EXEC sp_xml_preparedocument @doc OUTPUT, @xml" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "       INSERT LotStatus ([Status])" & vbCrLf
    s = s & "           select distinct lsu.status" & vbCrLf
    s = s & "       FROM OPENXML(@doc,'HF/LotStatusUpdates',2)" & vbCrLf
    s = s & "           WITH (Status varchar(30) 'LotStatusDesc') lsu" & vbCrLf
    s = s & "       left join LotStatus ls on lsu.status = ls.Status" & vbCrLf
    s = s & "       where ls.Status is null" & vbCrLf
    s = s & "       and lsu.Status in (" & vbCrLf
    s = s & "       'Inventory'," & vbCrLf
    s = s & "       'Pending Sale'," & vbCrLf
    s = s & "       'Sold'," & vbCrLf
    s = s & "       'Reserved')" & vbCrLf
    s = s & "" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "       -- Update Lot Status that have changed in CRM  " & vbCrLf
    s = s & "        UPDATE crm" & vbCrLf
    s = s & "        SET crm.STATUS = upd.LotStatusDesc" & vbCrLf
    s = s & "        FROM tblLotInventory crm" & vbCrLf
    s = s & "        INNER JOIN (" & vbCrLf
    s = s & "           SELECT LotStatusDesc,LotNo" & vbCrLf
    s = s & "           FROM OPENXML (@doc,'/HF/LotStatusUpdates',2)" & vbCrLf
    s = s & "           WITH (" & vbCrLf
    s = s & "               LotNo nvarchar (50)  'LotNo',LotStatusDesc nvarchar (30)  'LotStatusDesc'" & vbCrLf
    s = s & "           )" & vbCrLf
    s = s & "       ) upd ON crm.Lot_No = upd.LotNo" & vbCrLf
    sql c, s
    
    
