    s = s & "    " & vbCrLf
    s = s & "        END" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "        ------------------------------------------------------------------------" & vbCrLf
    s = s & "        -- lookup tax group then apply rates" & vbCrLf
    s = s & "        ------------------------------------------------------------------------" & vbCrLf
    s = s & "        UPDATE EstimateItems" & vbCrLf
    s = s & "           SET BudgetPretax = round(ISNULL(BudgetQty * BudgetRate,0),2)" & vbCrLf
    s = s & "              ,BudgetTaxGroup = dbo.Purch_GetDefaultTaxGroup(Job, @Community, @model, @CommunityPhase, @Assembly, Phase, Item, BudgetVendor, JCCategory,@DivisionID)" & vbCrLf
