    s = ""
    s = s & "ALTER PROCEDURE [dbo].[Intacct_ConfirmAPPosting] @DivisionID integer, @req xml, @res xml as" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "DECLARE @iReq int" & vbCrLf
    s = s & "DECLARE @iRes int" & vbCrLf
    s = s & "EXEC sp_xml_preparedocument @iReq OUTPUT, @req" & vbCrLf
    s = s & "EXEC sp_xml_preparedocument @iRes OUTPUT, @res" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- Intacct will accept some invoices while rejecting others. Remove failed records from batch" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "update i set" & vbCrLf
    s = s & " status= case when (res.status='success' or errorDesc like '%is already converted%') then 'Posted' else 'Rejected' end" & vbCrLf
    s = s & ",PostingDate=getdate()" & vbCrLf
    s = s & "FROM OPENXML (@ires, '/response/operation/result',2)" & vbCrLf
    s = s & "WITH (" & vbCrLf
    s = s & " controlid   varchar(40) 'controlid'" & vbCrLf
    s = s & ",status      varchar(40) 'status'" & vbCrLf
    s = s & ",errorDesc   varchar(500) 'errormessage/error[1]/description2'" & vbCrLf
    s = s & ") res" & vbCrLf
    s = s & "JOIN OPENXML (@ireq, '/request/operation/content/function',2)" & vbCrLf
    s = s & "WITH (" & vbCrLf
    s = s & " controlid   varchar(40) '@controlid'" & vbCrLf
    s = s & ",vendor      varchar(50) 'create_potransaction/vendorid'" & vbCrLf
    s = s & ",invoice     varchar(50) 'create_potransaction/documentno'" & vbCrLf
    s = s & ") req on res.controlid=req.controlid" & vbCrLf
    s = s & "JOIN Invoices i on i.divisionid=@divisionid and i.vendor=req.vendor and i.invoice=req.invoice" & vbCrLf
    sql c, s
    
    s = ""
    s = s & "ALTER PROCEDURE [dbo].[Intacct_ConfirmPOPosting] @DivisionID integer, @req xml, @res xml as" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "DECLARE @iReq int" & vbCrLf
    s = s & "DECLARE @iRes int" & vbCrLf
    s = s & "EXEC sp_xml_preparedocument @iReq OUTPUT, @req" & vbCrLf
    s = s & "EXEC sp_xml_preparedocument @iRes OUTPUT, @res" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- Intacct will accept some POs while rejecting others. Remove failed records from batch" & vbCrLf
    s = s & "--- ignore when first error is PL01000127 -- Document number XXX is already used" & vbCrLf
    s = s & "update p set PostingBatch=0" & vbCrLf
    s = s & "FROM OPENXML (@ires, '/response/operation/result/errormessage/error[1]',2)" & vbCrLf
    s = s & "WITH (" & vbCrLf
    s = s & " controlid   varchar(40) '../../controlid'" & vbCrLf
    s = s & ",status      varchar(40) '../../status'" & vbCrLf
    s = s & ",errorDesc   varchar(40) 'desription2'" & vbCrLf
    s = s & ") res" & vbCrLf
    s = s & "JOIN OPENXML (@ireq, '/request/operation/content/function',2)" & vbCrLf
    s = s & "WITH (" & vbCrLf
    s = s & " controlid   varchar(40) '@controlid'" & vbCrLf
    s = s & ",ponumber    varchar(50) 'create_potransaction/documentno'" & vbCrLf
    s = s & ") req on res.controlid=req.controlid" & vbCrLf
    s = s & "JOIN pomaster p on p.divisionid=@divisionid and p.PONumber=req.ponumber" & vbCrLf
    s = s & "where res.status='failure' and errorDesc not like '%Document number % is already used%'" & vbCrLf
    sql c, s
    
End Sub



