    s = s & "    EXEC sp_xml_preparedocument @doc OUTPUT, @xml" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   DECLARE @LockOptionsImmediately BIT = 0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    SELECT @LockOptionsImmediately = CASE WHEN OptionValue = 'True' THEN 1 ELSE 0 END" & vbCrLf
    s = s & "    FROM appoptions" & vbCrLf
