    s = s & "" & vbCrLf
    s = s & "    when  @TermNetType='OnADayOfTheMonth' and @TermNetDays<>0 then" & vbCrLf
    s = s & "        @InvDate - DAY(@InvDate ) + @TermNetDays" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when  @TermNetType='OnADayOfThe2ndMonth' and @TermNetDays<>0 then" & vbCrLf
