    s = s & "        , cd.Color" & vbCrLf
    s = s & "        , cd.Location" & vbCrLf
    s = s & "        , cd.Style" & vbCrLf
    s = s & "        , cd.Finish" & vbCrLf
    s = s & "        , cd.Other" & vbCrLf
    s = s & "        , cd.ColorListID" & vbCrLf
    s = s & "        , cd.StyleListID" & vbCrLf
    s = s & "        , cd.FinishListID" & vbCrLf
    s = s & "        , cd.OtherListID" & vbCrLf
    s = s & "        , cd.CRMID EntityID" & vbCrLf
    s = s & "        , cd.seq ClientSeq" & vbCrLf
    s = s & "        , CONVERT(DATETIME, CONVERT(CHAR(19), CD.TSTMP, 126)) AS ModifiedDate" & vbCrLf
    s = s & "       FROM tblCustomers InventoryHomeCODetails" & vbCrLf
    s = s & "       INNER JOIN ChangeOrderMaster cm ON InventoryHomeCODetails.Customer_No = cm.Customer_No" & vbCrLf
    s = s & "       INNER JOIN ChangeOrderDetails cd ON InventoryHomeCODetails.Customer_No = cd.Customer_No" & vbCrLf
    s = s & "           AND cm.Change_Order_No = cd.Change_Order_No" & vbCrLf
    s = s & "       WHERE (" & vbCrLf
    s = s & "               InventoryHomeCODetails.Home_Selection != 'PreSale'" & vbCrLf
    s = s & "               AND InventoryHomeCODetails.PreSale_Selection = 'PreSale'" & vbCrLf
    s = s & "               AND InventoryHomeCODetails.PreSale_Selection != 'Lot Only'" & vbCrLf
    s = s & "               AND (" & vbCrLf
    s = s & "                   InventoryHomeCODetails.Home_Selection = 'Spec Home'" & vbCrLf
    s = s & "                   OR InventoryHomeCODetails.Home_Selection = 'Show Home'" & vbCrLf
    s = s & "                   )" & vbCrLf
    s = s & "               )" & vbCrLf
    s = s & "           AND ISNULL(Sold_To_Customer, '') = ''" & vbCrLf
