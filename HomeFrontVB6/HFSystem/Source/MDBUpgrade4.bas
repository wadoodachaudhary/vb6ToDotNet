    s = s & "        @InvDate" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    else" & vbCrLf
    s = s & "        null" & vbCrLf
    s = s & "    end " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    RETURN( @x )" & vbCrLf
    s = s & "END" & vbCrLf
