    s = s & "    DECLARE @DoPOComplete bit" & vbCrLf
    s = s & "    DECLARE @DoEPO bit" & vbCrLf
    s = s & "    DECLARE @DoMilestone bit" & vbCrLf
    s = s & "    DECLARE @DoTbdVendor bit" & vbCrLf
    s = s & "    DECLARE @DoMPO bit" & vbCrLf
    s = s & "    DECLARE @DoBackCharge bit" & vbCrLf
    s = s & "    DECLARE @DoLienRelease bit" & vbCrLf
    s = s & "    DECLARE @DoUserExport bit" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- parse xml parameters ----------------------------" & vbCrLf
    s = s & "    SELECT @FileName      = x.FileName" & vbCrLf
    s = s & "          ,@DivisionID    = d.DivisionID" & vbCrLf
    s = s & "          ,@DoPOComplete  = case when nullif(x.POComplete,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoEPO         = case when nullif(x.EPO,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoMilestone   = case when nullif(x.Milestone,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoTbdVendor   = case when nullif(x.TbdVendor,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoMPO         = case when nullif(x.MPO,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoBackCharge  = case when nullif(x.BackCharge,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoLienRelease = case when nullif(x.LienRelease,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoUserExport  = case when nullif(x.UserExport,'') is null then 0 else 1 end" & vbCrLf
    s = s & "    FROM OPENXML (@idoc, 'SOAP-ENV:Envelope',2) " & vbCrLf
    s = s & "    WITH (FileName    varchar(1000) 'SOAP-ENV:Header/MH2SoapHeader/Properties/FileName'" & vbCrLf
    s = s & "         ,POComplete  varchar(100)  'SOAP-ENV:Body/JDEOW_LineItemCompletion'" & vbCrLf
    s = s & "         ,EPO         varchar(100)  'SOAP-ENV:Body/JDEOW_EPO'" & vbCrLf
    s = s & "         ,Milestone   varchar(100)  'SOAP-ENV:Body/JDEOW_MilestoneUpdate'" & vbCrLf
    s = s & "         ,TbdVendor   varchar(100)  'SOAP-ENV:Body/JDEOW_VendorOnTheFly'" & vbCrLf
    s = s & "         ,MPO         varchar(100)  'SOAP-ENV:Body/JDEOW_MPOExport'" & vbCrLf
    s = s & "         ,BackCharge  varchar(100)  'SOAP-ENV:Body/JDEOW_BackCharge'" & vbCrLf
    s = s & "         ,LienRelease varchar(100)  'SOAP-ENV:Body/JDEOW_LienExport'" & vbCrLf
    s = s & "         ,UserExport  varchar(100)  'SOAP-ENV:Body/JDEOW_UserExport'" & vbCrLf
    s = s & "         ) x" & vbCrLf
    s = s & "    JOIN Divisions d on d.DivisionCode = parsename(replace(replace(x.FileName,'.xml',''),'_','.'),2)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    if @DivisionID is null begin" & vbCrLf
    s = s & "        " & vbCrLf
    s = s & "        -- log request ----------------------------" & vbCrLf
    s = s & "        insert buildpro_requestlog(Status,DivisionID,UserID,FileName,Data)" & vbCrLf
    s = s & "        values('Error - Division not found',null,@uid,@FileName,cast(@XmlString as varchar(max)))" & vbCrLf
    s = s & "" & vbCrLf
