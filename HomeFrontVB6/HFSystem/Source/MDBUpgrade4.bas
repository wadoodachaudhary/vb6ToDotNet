    s = s & ",0 RetainageRate,0 TaxRetainageRate" & vbCrLf
    s = s & "FROM OPENXML (@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_BackCharge/BackCharge',2) " & vbCrLf
    s = s & "WITH (Job      varchar(40) 'LotJob'" & vbCrLf
    s = s & "     ,POIndex  varchar(40) 'CostCode'" & vbCrLf
    s = s & "     ,RefEPO    varchar(40) --is optional" & vbCrLf
    s = s & "     ,Vendor_ID  varchar(40) 'AddressBookNumber'" & vbCrLf
    s = s & "     ,BackChargeDate  date " & vbCrLf
    s = s & "     ,BackChargeNum  varchar(15)" & vbCrLf
    s = s & "     --,BackChargeSeq  int     --multiple vendors may participate in a single backcharge" & vbCrLf
    s = s & "     ,BackChargeAmount  money  --amount per this vendor" & vbCrLf
    s = s & "     --,BackChargeTotal  money --total amount across all vendors" & vbCrLf
    s = s & "     ,BackChargeDesc  varchar(500) " & vbCrLf
    s = s & "     ,ReasonCode  varchar(40) " & vbCrLf
    s = s & "    ) x" & vbCrLf
    s = s & "left join invoices i on i.DivisionID=@DivisionID and i.Vendor=x.Vendor_ID and i.invoice='BC' + x.BackChargeNum" & vbCrLf
    s = s & "left join tblpoindex px on px.DivisionID=@DivisionID and px.poindex=x.poindex --use costcode/cat for this poindex" & vbCrLf
    s = s & "left join StandardCostCodes scc on scc.DivisionID=@DivisionID and px.JCCostCode=scc.CostCode" & vbCrLf
    s = s & "left join appoptions o on(o.divisionid=@divisionid and o.optionName='EPOReason'+x.ReasonCode)" & vbCrLf
    s = s & "left join StandardCategories sc on sc.DivisionID=@DivisionID and sc.Category=isnull(nullif(o.OptionValue,''),px.JCCategory)" & vbCrLf
    s = s & "left join tblVendors v on v.DivisionID=@DivisionID and x.Vendor_ID=v.Vendor_ID" & vbCrLf
    s = s & "left join tbljobs j on j.DivisionID=@DivisionID and j.job_no=dbo.BuildProSOAP_HFJob(@DivisionID,x.job)" & vbCrLf
    s = s & "left join pomaster m on m.DivisionID=@DivisionID and m.PONumber=x.RefEPO --use taxgroup of EPO. we don't have it stored so have to look it up." & vbCrLf
    s = s & "left join tblpoindex p on p.DivisionID=@DivisionID and x.poindex=p.poindex" & vbCrLf
    s = s & "left join taxgroups t on t.DivisionID=@DivisionID and t.TaxGroup =   dbo.Purch_GetDefaultTaxGroup(j.Job_No,j.Community,j.CommunityPhase,'','','','',m.Vendor,p.JCCategory,@DivisionID)" & vbCrLf
    sql c, s


c = "add EPOid safeguard"
    s = ""
    s = s & "alter proc [dbo].[BuildProSOAP_DoEPO] @idoc int, @DivisionID int, @XmlString xml  AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "declare @EstAssemblyID int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- to prevent duplicates in case of re-export, quick exit if epodocnumber already exists. " & vbCrLf
    s = s & "IF EXISTS (SELECT *" & vbCrLf
    s = s & "           FROM OPENXML (@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_EPO/EPOItem',2) " & vbCrLf
    s = s & "           WITH (EPOid varchar(40) 'BuildProDocument/Document/DocNumber') x" & vbCrLf
    s = s & "           JOIN POMaster m on m.divisionid=@divisionid and m.epodocnumber=x.epoid) return" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- get assembly " & vbCrLf
    s = s & "Select @EstAssemblyID = max(a.EstAssemblyID)" & vbCrLf
    s = s & "from openxml(@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_EPO/EPOItem',2) " & vbCrLf
    s = s & "with(JobNo    varchar(40)  'LotJob') x" & vbCrLf
    s = s & "join EstimateAssemblies a on a.Job= dbo.BuildProSOAP_HFJob(@DivisionID,x.jobNo)" & vbCrLf
    s = s & "join tblcustomers c on a.divisionid=c.divisionid and a.customer_no=c.customer_no and isnull(c.unit_no,'')=isnull(dbo.BuildProSOAP_HFUnit(@DivisionID,x.jobNo),'')" & vbCrLf
    s = s & "and a.DivisionID=@DivisionID AND a.AssemblyType in (0,-1)" & vbCrLf
    s = s & "and isnull(a.customer_no,'')<>''" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- Converted data may not have a model assembly. In that case use the last assembly added" & vbCrLf
    s = s & "if (@EstAssemblyID is null) begin" & vbCrLf
    s = s & "    Select @EstAssemblyID = max(a.EstAssemblyID)" & vbCrLf
    s = s & "    from openxml(@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_EPO/EPOItem',2) " & vbCrLf
    s = s & "    with(JobNo    varchar(40)  'LotJob'" & vbCrLf
    s = s & "    ) x" & vbCrLf
    s = s & "    join EstimateAssemblies a on a.Job= dbo.BuildProSOAP_HFJob(@DivisionID,x.jobNo)" & vbCrLf
    s = s & "    join tblcustomers c on a.divisionid=c.divisionid and a.customer_no=c.customer_no and c.unit_no=dbo.BuildProSOAP_HFUnit(@DivisionID,x.jobNo)" & vbCrLf
    s = s & "    and a.DivisionID=@DivisionID" & vbCrLf
    s = s & "end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- If an epo gets created on a spechome after sale but before it's processed thru the inbox..." & vbCrLf
    s = s & "if (@EstAssemblyID is null) begin" & vbCrLf
    s = s & "    Select @EstAssemblyID = max(a.EstAssemblyID)" & vbCrLf
    s = s & "    from openxml(@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_EPO/EPOItem',2) " & vbCrLf
    s = s & "    with(JobNo    varchar(40)  'LotJob'" & vbCrLf
    s = s & "    ) x" & vbCrLf
    s = s & "    join EstimateAssemblies a on a.Job= dbo.BuildProSOAP_HFJob(@DivisionID,x.jobNo)" & vbCrLf
    s = s & "    and a.DivisionID=@DivisionID" & vbCrLf
    s = s & "end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- pomaster" & vbCrLf
    s = s & "INSERT INTO POMaster(PONumber,DivisionID,EPOid,EPODocType,EPODocSuffix,EPODocNumber,PODate,POIndex,Comments,Job,Vendor,Description,DeliveryMethod,DeliveryAddress,OrderedBy,ApprovedDate,ApprovedBy,tstmp,[Status])" & vbCrLf
    s = s & "SELECT DISTINCT" & vbCrLf
    s = s & " '~~'+x.EPOid PONumber" & vbCrLf
    s = s & ",v.DivisionID" & vbCrLf
    s = s & ",x.EPOid,x.DocType,x.DocSuffix,x.EPOid" & vbCrLf
    s = s & ",x.DateChgd PODate" & vbCrLf
    s = s & ",x.POIndex" & vbCrLf
    s = s & ",x.Comments" & vbCrLf
    s = s & ",dbo.BuildProSOAP_HFJob(@DivisionID,x.jobNo)" & vbCrLf
    s = s & ",x.Vendor" & vbCrLf
    s = s & ",p.description PODescription" & vbCrLf
    s = s & ",v.SchedDelMethod" & vbCrLf
