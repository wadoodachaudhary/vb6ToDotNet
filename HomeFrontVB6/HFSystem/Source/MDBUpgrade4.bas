    s = s & "insert into EstimateItems(DivisionID,EstAssemblyID, PONumber, RequestDetailID , POGenBatch, BudgetDeleted, PODeleted, POIndex" & vbCrLf
    s = s & "                         ,Job, Unit, JCExtra ,JCCostCode ,JCCategory ,Description ,Comments" & vbCrLf
    s = s & "                         ,ConversionFactor, OrderUOM,takeoffuom, POVendor, POQty, TakeoffQty, PORate, POPretax" & vbCrLf
    s = s & "                         ,POTaxGroup, PONJCTaxRate, POJCTaxRate, PONJCTax, POJCTax )" & vbCrLf
    s = s & "select @DivisionID,@EstAssemblyID,'~~'+x.EPOid,x.ItemNum ,-1 POGenBatch,1 BudgetDeleted,0 PODeleted,x.POIndex" & vbCrLf
    s = s & "      ,dbo.BuildProSOAP_HFJob(@DivisionID,x.jobNo)" & vbCrLf
    s = s & "      ,dbo.BuildProSOAP_HFUnit(@DivisionID,x.jobNo)" & vbCrLf
    s = s & "      ,case when s.MultiUnitsAsExtras=1 then dbo.BuildProSOAP_HFUnit(@DivisionID,x.jobNo) else '' end JCExtra" & vbCrLf
    s = s & "      ,p.JCCostCode" & vbCrLf
    s = s & "      ,isnull(nullif(o.OptionValue,''),p.JCCategory)" & vbCrLf
    s = s & "      , x.ItemDesc, x.Notes" & vbCrLf
    s = s & "      ,1,x.UOM,x.UOM, x.Vendor, x.Quantity,x.quantity, x.UnitPrice, x.Pretax" & vbCrLf
    s = s & "      ,isnull(t.TaxGroup, '') TaxGroup" & vbCrLf
    s = s & "      ,isnull(t.njcrate,0)   NJCTaxRate        " & vbCrLf
    s = s & "      ,isnull(t.jcrate,0)    JCTaxRate" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      -- dont use buildpro taxes. they are not set..." & vbCrLf
    s = s & "      --,isnull(round(cast(x.tax*t.njcrate/nullif(t.grouprate,0) as money),2),0) njctax" & vbCrLf
    s = s & "      --,isnull(x.tax - round(x.tax*t.njcrate/nullif(t.grouprate,0),2),0) jctax" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      ,round(x.pretax*isnull(t.njcrate,0)/100,2) njctax" & vbCrLf
    s = s & "      ,round(x.pretax*isnull(t.jcrate,0)/100,2) jctax" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "FROM OPENXML (@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_EPO/EPOItem',2) " & vbCrLf
    s = s & "WITH (JobNo     varchar(40)  'LotJob'" & vbCrLf
    s = s & "     ,POIndex   varchar(40)  'CostCode'" & vbCrLf
    s = s & "     ,EPOid     varchar(40)  'BuildProDocument/Document/DocNumber'" & vbCrLf
    s = s & "     ,POSuffix  varchar(40)  'BuildProDocument/Document/DocSuffix'" & vbCrLf
    s = s & "     ,Vendor    varchar(40)  'Vendor/AddressBookEntry/AddressBookNumber'" & vbCrLf
    s = s & "     ,ItemNum   varchar(40)  'SequenceNumber'" & vbCrLf
    s = s & "     ,ItemDesc  varchar(500) 'ItemDescription'" & vbCrLf
    s = s & "     ,Quantity  float        'Quantity'" & vbCrLf
    s = s & "     ,UOM       varchar(500) 'UnitOfMeasure'" & vbCrLf
    s = s & "     ,UnitPrice float        'UnitPrice'" & vbCrLf
    s = s & "     ,Pretax    money        'ExtendedPrice'" & vbCrLf
    s = s & "     ,Tax       money        'Tax'" & vbCrLf
    s = s & "     ,UserName  varchar(40)  'UserName'" & vbCrLf
    s = s & "     ,DateChgd  date  'DateChanged'" & vbCrLf
    s = s & "     ,Notes     varchar(max) 'EPONote'" & vbCrLf
    s = s & "     ,Reason    varchar(max) 'ReasonCode'" & vbCrLf
    s = s & "     ) x" & vbCrLf
    s = s & "left join tblPOIndex p ON(p.DivisionID=@DivisionID and p.POIndex=x.POIndex)" & vbCrLf
    s = s & "left join tbljobs j on(j.divisionid=@divisionid    and j.job_no=x.jobNo)" & vbCrLf
    s = s & "left join appoptions o on(o.divisionid=@divisionid and o.optionName='EPOReason'+x.Reason)" & vbCrLf
    s = s & "left join TaxGroups t ON(t.DivisionID=@DivisionID  and t.TaxGroup=dbo.Purch_GetDefaultTaxGroup(x.jobNo,j.community,j.communityphase,'','','','',x.vendor,isnull(nullif(o.OptionValue,''),p.JCCategory),@divisionid))" & vbCrLf
    s = s & "left join system_setup s on s.id=@divisionid" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- replace po numbers" & vbCrLf
    s = s & "declare @EPOid    varchar(40)" & vbCrLf
    s = s & "declare @JobNo    varchar(12)" & vbCrLf
    s = s & "declare @POIndex  varchar(20)" & vbCrLf
    s = s & "declare @PONumber varchar(20)" & vbCrLf
    s = s & "declare @t table (PONumber varchar(20))" & vbCrLf
    s = s & "declare c cursor for select PONumber,Job,POIndex from POMaster where PONumber like '~~%'" & vbCrLf
    s = s & "open c" & vbCrLf
    s = s & "fetch next from c into @EPOid, @JobNo, @POIndex" & vbCrLf
    s = s & "while @@FETCH_STATUS = 0 begin" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --- get new po number" & vbCrLf
    s = s & "    delete @t" & vbCrLf
    s = s & "    insert into @t exec dbo.Purch_CreatePONumber @DivisionID, @JobNo, @POIndex" & vbCrLf
    s = s & "    select @PONumber = PONumber FROM @t" & vbCrLf
    s = s & "   " & vbCrLf
    s = s & "   --- update ponumber on these 2 tables" & vbCrLf
    s = s & "   update estimateitems set ponumber=@ponumber where  divisionid=@divisionid and ponumber=@epoid" & vbCrLf
    s = s & "   update pomaster set ponumber=@ponumber where divisionid=@divisionid and ponumber=@epoid" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   --- alter  poitems" & vbCrLf
    s = s & "   insert into POItems(DivisionID,PONumber,LineNumber,LineDescription,Description,Comments,OrderQty,TakeoffQty,rate,pretax,taxgroup,njctaxrate,jctaxrate,njctax,jctax,job,jcextra,jccostcode,jccategory,EstPhase,EstItemID,OrderUOM,takeoffuom)" & vbCrLf
    s = s & "   SELECT i.DivisionID,i.PONumber,i.RequestDetailID,i.Description,i.Description,i.Comments,i.POQty,i.takeoffqty,i.PORate,i.POPretax,i.POTaxGroup,i.PONJCTaxRate,i.POJCTaxRate,i.PONJCTax,i.POJCTax,i.job,i.jcextra,i.JCCostCode,i.JCCategory,'',i.EstItemID,i.OrderUOM,i.takeoffuom" & vbCrLf
    s = s & "   from estimateitems i " & vbCrLf
    s = s & "   where i.divisionid=@DivisionID" & vbCrLf
    s = s & "   and i.PONumber=@PONumber" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    fetch next from c into @EPOid, @JobNo, @POIndex" & vbCrLf
    s = s & "end" & vbCrLf
    s = s & "close c" & vbCrLf
    s = s & "deallocate c" & vbCrLf
    sql c, s



