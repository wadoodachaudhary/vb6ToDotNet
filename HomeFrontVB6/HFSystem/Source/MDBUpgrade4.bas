    s = s & "        return" & vbCrLf
    s = s & "    end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- process request ----------------------------" & vbCrLf
    s = s & "    if @DoPOComplete=1       exec dbo.BuildProSOAP_DoPOComplete       @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    else if @DoEPO=1         exec dbo.BuildProSOAP_DoEPO              @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    else if @DoMilestone=1   exec dbo.BuildProSOAP_DoMilestoneUpdate  @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    else if @DoTbdVendor=1   exec dbo.BuildProSOAP_DoTbdVendor        @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    else if @DoMPO=1         exec dbo.BuildProSOAP_DoMPO              @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    else if @DoBackCharge=1  exec dbo.BuildProSOAP_DoBackCharge       @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    else if @DoLienRelease=1 exec dbo.BuildProSOAP_DoLienRelease      @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    else if @DoUserExport=1  exec dbo.BuildProSOAP_DoUserExport       @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    else begin" & vbCrLf
    s = s & "        " & vbCrLf
    s = s & "        -- log request ----------------------------" & vbCrLf
    s = s & "        insert buildpro_requestlog(Status,DivisionID,UserID,FileName,Data)" & vbCrLf
    s = s & "        values('Error - unknown file type',null,@uid,@FileName,cast(@XmlString as varchar(max)))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        select 200 Status, '** unknown file type **' + char(13) + char(10) + char(13) + char(10) + @FileName Response" & vbCrLf
    s = s & "        return" & vbCrLf
    s = s & "    end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- log request ----------------------------" & vbCrLf
    s = s & "    insert buildpro_requestlog(Status,DivisionID,UserID,FileName,Data)" & vbCrLf
    s = s & "    values('Success',@DivisionID,@uid,@FileName,cast(@XmlString as varchar(max)))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- return status/response" & vbCrLf
    s = s & "    select 200 Status, 'OK' Response" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END TRY" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "BEGIN CATCH" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- log request--" & vbCrLf
    s = s & "    insert buildpro_requestlog(Status,DivisionID,UserID,FileName,Data)" & vbCrLf
    s = s & "    values(isnull(ERROR_PROCEDURE(),'') + ': line ' + cast(isnull(ERROR_LINE(),0) as varchar(max)) + ': ' + isnull(ERROR_MESSAGE(),'') " & vbCrLf
    s = s & "          ,@DivisionID,@uid,@FileName,cast(@XmlString as varchar(max)))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --return status" & vbCrLf
    s = s & "    select 500 Status, isnull(ERROR_PROCEDURE(),'') + ': line ' + cast(isnull(ERROR_LINE(),0) as varchar(max)) + ': ' + isnull(ERROR_MESSAGE(),'') Response" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END CATCH" & vbCrLf
    sql c, s
    
