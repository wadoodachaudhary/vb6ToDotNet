    s = s & "              JOIN tblDBAssemblyDetails d on (m.DivisionID = d.DivisionID and m.Assembly = d.Assembly  AND m.Model = d.Model  AND m.OptionID = d.OptionID  AND m.Community = d.Community)" & vbCrLf
    s = s & "              LEFT OUTER JOIN CommunityStandards cs ON(cs.Community=@Community AND cs.CommunityPhase=dbo.Purch_GetCommunityStandardPhase(@Community,@CommunityPhase,d.phase,d.Item) AND cs.StdPhase=d.Phase AND cs.StdItem=d.Item)" & vbCrLf
