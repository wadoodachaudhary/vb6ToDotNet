    s = s & "" & vbCrLf
    s = s & "    when ((@TermNetType='NumberOfDaysAfterEOM' OR @TermNetType='DayOfMonthAfterEOM' OR @TermNetType='OnADayOfTheNextMonth' OR (@TermNetType='OnADayOfTheMonth' and day(@InvDate)>=@TermNetDays)) and @TermNetDays<>0) then" & vbCrLf
