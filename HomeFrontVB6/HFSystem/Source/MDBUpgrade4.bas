    s = s & "           AND Inactive = 0" & vbCrLf
    s = s & "           --AND NotAvailableforSale = 0" & vbCrLf
    s = s & "           --AND InventoryHomeCODetails.CRMID IS NULL" & vbCrLf
    s = s & "           AND ISNULL(InventoryHomeCODetails.Model, '') != ''" & vbCrLf
    s = s & "           AND ISNULL(InventoryHomeCODetails.Job_No, '') != ''" & vbCrLf
    s = s & "           --Add Custom = 1 and Require Quote = 0 to only grab custom options that have been built and approved in inbox" & vbCrLf
    s = s & "           AND cd.TSTMP >= @CutOffDate" & vbCrLf
    s = s & "   FOR xml path('InventoryHomeCODetailsCustoms'), elements xsinil, root('HF')" & vbCrLf
    s = s & "   )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --save results to request, set status complete when nothing to send" & vbCrLf
    s = s & "    update MsgQ set request=cast(@xml as nvarchar(max)),status=case when @xml is null then 'Completed' else status end where ID=@ID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --expose request for debugging " & vbCrLf
    s = s & "    --select @xml Request" & vbCrLf
    s = s & "END TRY" & vbCrLf
    s = s & "BEGIN CATCH" & vbCrLf
