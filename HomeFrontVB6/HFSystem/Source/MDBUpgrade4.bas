    s = s & ",isnull(t.TaxGroup,'') TaxGroup, isnull(t.Description,'') taxDesc, isnull(t.GroupRate,0) TaxRate, isnull(t.JCRate,0) JCRate, isnull(t.NJCRate,0) NJCRate" & vbCrLf
