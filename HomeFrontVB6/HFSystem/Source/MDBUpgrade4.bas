    s = s & "              ,POJCTax = BudgetJCTax" & vbCrLf
    s = s & "              ,POJCTaxRate = BudgetJCTaxRate" & vbCrLf
    s = s & "              ,PONJCTax = BudgetNJCTax" & vbCrLf
    s = s & "              ,PONJCTaxRate = BudgetNJCTaxRate" & vbCrLf
    s = s & "              ,Unit = @Unit" & vbCrLf
    s = s & "              ,JCExtra = CASE WHEN @UnitsAsExtra=1 THEN @Unit ELSE JCExtra END" & vbCrLf
    s = s & "         WHERE EstAssemblyID = @EstAssemblyID" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "    exec Purch_PutEstimateIntersectItems @EstAssemblyID, @JCCategory" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
    
