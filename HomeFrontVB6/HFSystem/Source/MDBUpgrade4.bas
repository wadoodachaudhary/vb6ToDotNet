    s = s & "and x.estassemblyid is null" & vbCrLf
    s = s & "and" & vbCrLf
    s = s & "((c.purchased=1 and c.cancelled=0 and c.inactive=0 and ((isnull(s.accounting_approve,0)=1 and c.approved=1) or (isnull(s.accounting_approve,0)=0 and c.contract_assigned=1) or isnull(s.PurchasingRequiresSalesApproval,0)=0))" & vbCrLf
    s = s & "  or " & vbCrLf
    s = s & "(c.home_selection <>'PreSale' or c.presale_selection<>'PreSale'))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "--  add newly created estassemblyid to temp table " & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "update x" & vbCrLf
    s = s & "set estassemblyid=a.estassemblyid" & vbCrLf
    s = s & "from ImportedBimJobBom x" & vbCrLf
    s = s & "left outer join EstimateAssemblies a on x.job=a.job and ((a.assemblytype=0 and x.ismodel=1) or (x.ismodel=0 and a.optionid=x.optionid))" & vbCrLf
    s = s & "join tblcustomers c on a.customer_no=c.customer_no and a.divisionid=c.divisionid and isnull(c.job_no,'')<>''" & vbCrLf
    s = s & "join system_setup s on c.divisionid=s.id" & vbCrLf
    s = s & "where" & vbCrLf
    s = s & "((c.purchased=1 and c.cancelled=0 and c.inactive=0 and ((isnull(s.accounting_approve,0)=1 and c.approved=1) or (isnull(s.accounting_approve,0)=0 and c.contract_assigned=1) or isnull(s.PurchasingRequiresSalesApproval,0)=0))" & vbCrLf
    s = s & "  or " & vbCrLf
    s = s & "(c.home_selection <>'PreSale' or c.presale_selection<>'PreSale'))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "--  insert estitems " & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "insert estimateitems(WBS01,WBS02,EstAssemblyID, POIndex, Phase, Item, Job" & vbCrLf
    s = s & ",JCCostCode, JCCategory" & vbCrLf
    s = s & ",Description, Comments, TakeoffQty, TakeoffUOM, ConversionFactor, OrderUOM, BudgetQty, POQty" & vbCrLf
    s = s & ",Model" & vbCrLf
    s = s & ",CreatedDate, CreatedBy, ModifiedDate, ModifiedBy, DivisionID" & vbCrLf
    s = s & ",BudgetVendor, BudgetRate)" & vbCrLf
    s = s & "select @sessionid,case when @IsReimport=1 then @sessionid else null end" & vbCrLf
    s = s & ",x.estassemblyid,x.POIndex,i.phase,i.item,left(x.job,12) job" & vbCrLf
    s = s & ",isnull(nullif(i.jccostcode,''),p.jccostcode) costcode,isnull(nullif(i.jccategory,''),p.jccategory) category" & vbCrLf
    s = s & ",left(x.itemdesc,200)itemdesc, i.Notes, x.qty,left(x.uom,10)uom,1,left(x.uom,10)uom,x.qty,x.qty" & vbCrLf
    s = s & ",case when x.ismodel=1 then c.model else '' end model" & vbCrLf
    s = s & ",getdate(),@UserID,getdate(),@UserID, c.DivisionID" & vbCrLf
    s = s & ",dbo.Purch_GetCommunityVendor(c.Community,p.POIndex,c.DivisionID)  BudgetVendor" & vbCrLf
    s = s & ",ISNULL(dbo.Purch_GetItemRate(0,0,c.Community,c.Phase,'',case when x.ismodel=1 then c.model else '' end,'',i.Phase,i.Item,0,dbo.Purch_GetCommunityVendor(c.Community,p.POIndex,c.DivisionID),GETDATE(),c.DivisionID),0) BudgetRate" & vbCrLf
    s = s & "from ImportedBimJobBom x" & vbCrLf
    s = s & "join tblcustomers c on x.job=c.job_no" & vbCrLf
    s = s & "join system_setup s on c.divisionid=s.id" & vbCrLf
    s = s & "left outer join tblphaseitem i on c.divisionid=i.divisionid and x.partnumber=i.partnumber" & vbCrLf
    s = s & "left outer join tblpoindex p on x.poindex=p.poindex and c.DivisionID = p.DivisionID" & vbCrLf
    s = s & "where x.sessionid=@sessionid" & vbCrLf
    s = s & "and " & vbCrLf
    s = s & "((c.purchased=1 and c.cancelled=0 and c.inactive=0 and ((isnull(s.accounting_approve,0)=1 and c.approved=1) or (isnull(s.accounting_approve,0)=0 and c.contract_assigned=1) or isnull(s.PurchasingRequiresSalesApproval,0)=0))" & vbCrLf
    s = s & "  or " & vbCrLf
    s = s & "(c.home_selection <>'PreSale' or c.presale_selection<>'PreSale'))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "-- if reimporting " & vbCrLf
    s = s & "--     insert new delta items with crazy compare statement orig vs new temporary" & vbCrLf
    s = s & "--     delete temporary items leaving new delta items" & vbCrLf
    s = s & "-- end" & vbCrLf
    s = s & "-- WBS04 = bim orig qty" & vbCrLf
    s = s & "-- WBS05 = bim adjusted qty" & vbCrLf
    s = s & "-- WBS06 = bim CO qty" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "if @IsReimport=1 begin" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    insert estimateitems(WBS01,EstAssemblyID, POIndex, Phase, Item, Job" & vbCrLf
    s = s & "    ,JCCostCode, JCCategory,Description, Comments" & vbCrLf
    s = s & "   ,wbs04,wbs05,wbs06" & vbCrLf
    s = s & "   ,TakeoffQty,BudgetQty,POQty" & vbCrLf
    s = s & "   ,TakeoffUOM, ConversionFactor,OrderUOM" & vbCrLf
    s = s & "    ,Model,CreatedDate, CreatedBy, ModifiedDate, ModifiedBy, DivisionID" & vbCrLf
    s = s & "    ,BudgetVendor, BudgetRate)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    select @sessionid,ei.estassemblyid,max(ei.poindex) poindex,ei.estphase,ei.estitem,max(ei.job_no) job,max(ei.jccostcode) costcode,max(ei.jccategory) category," & vbCrLf
    s = s & "    ei.itemdesc,max(i.notes)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   ,round(sum(case when isnull(ei.wbs01,'')='' then ei.takeoffqty else 0 end),2) bimOrigQty" & vbCrLf
    s = s & "   ,round(sum(case when isnull(ei.wbs01,'')=@sessionid then ei.takeoffqty else 0 end),2) bimAdjustedqty" & vbCrLf
    s = s & "   ,round(sum(case when isnull(ei.wbs01,'')=@sessionid then ei.takeoffqty else 0 end) - sum(case when isnull(ei.wbs01,'')='' then ei.takeoffqty else 0 end),2) bimCOQty" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   ,round(sum(case when isnull(ei.wbs01,'')=@sessionid then ei.takeoffqty else 0 end) - sum(case when isnull(ei.wbs01,'')='' then ei.takeoffqty else 0 end),2) takeoffqty" & vbCrLf
    s = s & "   ,round(sum(case when isnull(ei.wbs01,'')=@sessionid then ei.takeoffqty else 0 end) - sum(case when isnull(ei.wbs01,'')='' then ei.takeoffqty else 0 end),2) budgetqty" & vbCrLf
    s = s & "   ,round(sum(case when isnull(ei.wbs01,'')=@sessionid then ei.takeoffqty else 0 end) - sum(case when isnull(ei.wbs01,'')='' then ei.takeoffqty else 0 end),2) poqty" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "   ,max(ei.takeoffuom) takeoffuom,1 conversionfactor,max(ei.orderuom) orderuom" & vbCrLf
    s = s & "   ,max(ei.model) model,getdate(),@UserID,getdate(),@UserID,ei.DivisionID" & vbCrLf
    s = s & "   ,max(ei.BudgetVendor) BudgetVendor" & vbCrLf
    s = s & "   ,max(ei.BudgetRate) BudgetRate" & vbCrLf
    s = s & "    from estimateditems ei" & vbCrLf
    s = s & "    left join tblphaseitem i on ei.divisionid=i.divisionid and ei.estphase=i.phase and ei.estitem=i.item" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    where job_no=@job" & vbCrLf
    s = s & "   group by ei.estassemblyid,ei.estphase,ei.estitem,ei.itemdesc,ei.DivisionID" & vbCrLf
    s = s & "   having 0<>round(sum(case when isnull(ei.wbs01,'')=@sessionid then ei.takeoffqty else 0 end) - sum(case when isnull(ei.wbs01,'')='' then ei.takeoffqty else 0 end),2) " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    delete estimateitems where WBS02=@sessionid" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "--  lookup tax group and apply rates" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "update i set" & vbCrLf
    s = s & "BudgetPretax = round(ISNULL(BudgetQty * BudgetRate,0),2)" & vbCrLf
    s = s & ",BudgetTaxGroup = " & vbCrLf
    s = s & "dbo.Purch_GetDefaultTaxGroup(j.Job_no, j.Community, j.CommunityPhase, j.model, '', Phase, Item, BudgetVendor, JCCategory,j.DivisionID)" & vbCrLf
    s = s & "from estimateitems i" & vbCrLf
    s = s & "join tbljobs j on i.job=j.job_no and i.DivisionID=j.DivisionID" & vbCrLf
    s = s & "where i.wbs01=@sessionid" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "update EstimateItems set" & vbCrLf
    s = s & "BudgetJCTax = round(ISNULL(BudgetPretax * JCRate,0) / 100,2) " & vbCrLf
    s = s & ",BudgetJCTaxRate = JCRate" & vbCrLf
    s = s & ",BudgetNJCTax = round(ISNULL(BudgetPretax * NJCRate,0) / 100,2)" & vbCrLf
    s = s & ",BudgetNJCTaxRate = NJCRate " & vbCrLf
    s = s & "from EstimateItems" & vbCrLf
    s = s & "join TaxGroups on EstimateItems.DivisionID=TaxGroups.DivisionID and EstimateItems.BudgetTaxGroup=TaxGroups.TaxGroup" & vbCrLf
    s = s & "where wbs01=@sessionid" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "--  default all po values to budget values" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "update EstimateItems set" & vbCrLf
    s = s & "POVendor = BudgetVendor" & vbCrLf
    s = s & ",POQty = BudgetQty" & vbCrLf
    s = s & ",PORate = BudgetRate" & vbCrLf
    s = s & ",POPretax = BudgetPretax" & vbCrLf
    s = s & ",POTaxGroup = BudgetTaxGroup" & vbCrLf
    s = s & ",POJCTax = BudgetJCTax" & vbCrLf
    s = s & ",POJCTaxRate = BudgetJCTaxRate" & vbCrLf
    s = s & ",PONJCTax = BudgetNJCTax" & vbCrLf
    s = s & ",PONJCTaxRate = BudgetNJCTaxRate" & vbCrLf
    s = s & "where wbs01=@sessionid" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "--  clean up" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "update EstimateItems set wbs01='' where wbs01=@sessionid" & vbCrLf
    s = s & "delete ImportedBIMJobBOM where sessionid=@sessionid" & vbCrLf
    sql c, s
    
    
    Call Revisions_2023_4

End Sub


