    s = s & "JOIN wallet_payees v on v.DataSourceID=@DataSourceID and v.PayeeID=a.Payee" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "where a.PaymentState IN('C','V') --voided and posted payments only" & vbCrLf
