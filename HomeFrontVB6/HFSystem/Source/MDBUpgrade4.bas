    s = s & "alter PROCEDURE [dbo].[Intacct_SetPOItemIDs] @DivisionID integer, @xmlString varchar(max) as" & vbCrLf
    s = s & "DECLARE @idoc int" & vbCrLf
    s = s & "EXEC sp_xml_preparedocument @idoc OUTPUT, @xmlString" & vbCrLf
