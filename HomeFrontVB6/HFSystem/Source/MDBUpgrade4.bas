    s = s & "SELECT x.DivisionID,@Community,case when @DoGlobalsOnly=1 then '' else x.PlanNo end,x.OptionNumber,x.OptionNumber,m.AssemblyID,x.hf_phase,x.hf_item,x.TotalQty,x.TotalQty,x.TotalQty,0,1,0,x.hf_phase" & vbCrLf
