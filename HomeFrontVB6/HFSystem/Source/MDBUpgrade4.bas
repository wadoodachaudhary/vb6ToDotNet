    s = s & "                  ,isnull(nullif(d.WBS06,''),i.WBS06),isnull(nullif(d.WBS07,''),i.WBS07),isnull(nullif(d.WBS08,''),i.WBS08),isnull(nullif(d.WBS09,''),i.WBS09),isnull(nullif(d.WBS10,''),i.WBS10)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS11,''),i.WBS11),isnull(nullif(d.WBS12,''),i.WBS12),isnull(nullif(d.WBS13,''),i.WBS13),isnull(nullif(d.WBS14,''),i.WBS14),isnull(nullif(d.WBS15,''),i.WBS15)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS16,''),i.WBS16),isnull(nullif(d.WBS17,''),i.WBS17),isnull(nullif(d.WBS18,''),i.WBS18),isnull(nullif(d.WBS19,''),i.WBS19),isnull(nullif(d.WBS20,''),i.WBS20)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS21,''),i.WBS21),isnull(nullif(d.WBS22,''),i.WBS22),isnull(nullif(d.WBS23,''),i.WBS23),isnull(nullif(d.WBS24,''),i.WBS24),isnull(nullif(d.WBS25,''),i.WBS25)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS26,''),i.WBS26),isnull(nullif(d.WBS27,''),i.WBS27),isnull(nullif(d.WBS28,''),i.WBS28),isnull(nullif(d.WBS29,''),i.WBS29),isnull(nullif(d.WBS30,''),i.WBS30)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS31,''),i.WBS31),isnull(nullif(d.WBS32,''),i.WBS32),isnull(nullif(d.WBS33,''),i.WBS33),isnull(nullif(d.WBS34,''),i.WBS34),isnull(nullif(d.WBS35,''),i.WBS35)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS36,''),i.WBS36),isnull(nullif(d.WBS37,''),i.WBS37),isnull(nullif(d.WBS38,''),i.WBS38),isnull(nullif(d.WBS39,''),i.WBS39),isnull(nullif(d.WBS40,''),i.WBS40)" & vbCrLf
    s = s & "              FROM EstimateAssemblies e" & vbCrLf
    s = s & "              JOIN tblDBAssemblyMaster a on (a.DivisionID = @DivisionID and e.Assembly = a.Assembly  AND a.Community = dbo.Purch_GetAssemblyCommunity(@Assembly,CASE WHEN (e.AssemblyType=3 OR e.AssemblyType=4) THEN '' ELSE e.Model END,@optionid,@Community,@DivisionID)  AND (ISNULL(a.Model,'') = CASE WHEN (e.AssemblyType=3 OR e.AssemblyType=4) THEN '' ELSE e.Model END)  AND e.OptionID = a.OptionID)" & vbCrLf
    s = s & "              JOIN tblDBAssemblyComponents ac on ac.parentAssemblyID=a.assemblyid" & vbCrLf
