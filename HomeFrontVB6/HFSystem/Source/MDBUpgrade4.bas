    s = s & "                  ,e.Job" & vbCrLf
    s = s & "                  ,e.JCExtra" & vbCrLf
    s = s & "                  ,isnull(nullif(case when e.assemblytype=0 or (o.OptionValue='true' and isnull(e.changeorder,'')='') then i.jccostcode else isnull(nullif(i.altjccostcode,''),i.jccostcode) end ,''),p.jccostcode)" & vbCrLf
    s = s & "                  ,isnull(nullif(@jccategory,''),isnull(nullif(case when e.assemblytype=0 or (o.OptionValue='true' and isnull(e.changeorder,'')='') then i.jccategory else isnull(nullif(i.altjccategory,''),i.jccategory) end ,''),p.jccategory))" & vbCrLf
    s = s & "                  ,0 SortOrder" & vbCrLf
    s = s & "                  ,i.Description" & vbCrLf
