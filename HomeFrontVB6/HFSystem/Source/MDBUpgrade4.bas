c = "Intacct custom fields"
    
    sql c, "drop view Intacct_JobCustomFields", True
    s = ""
    s = s & "create view dbo.Intacct_JobCustomFields as" & vbCrLf
    s = s & "select " & vbCrLf
    s = s & " DivisionID,Job_No" & vbCrLf
    s = s & "from tbljobs" & vbCrLf
    sql c, s


    sql c, "drop FUNCTION dbo.Intacct_CustomFieldType", True
    s = ""
    s = s & "create FUNCTION dbo.Intacct_CustomFieldType(@SQLDataType tinyint, @Length int)" & vbCrLf
    s = s & "RETURNS varchar(15) AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- translates sql data types to 1 of the 7 intacct data types" & vbCrLf
    s = s & "    -- used for custom field definitions" & vbCrLf
    s = s & "    -- checkbox, int, float, text, textarea, currency, date" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @x varchar(15)" & vbCrLf
    s = s & "    SELECT @x = case type_name(@SQLDataType)" & vbCrLf
    s = s & "                when 'bit' then 'checkbox'" & vbCrLf
    s = s & "                when 'bigint' then 'int'" & vbCrLf
    s = s & "                when 'numeric' then 'int'" & vbCrLf
    s = s & "                when 'smallint' then 'int'" & vbCrLf
    s = s & "                when 'int' then 'int'" & vbCrLf
    s = s & "                when 'tinyint' then 'int'" & vbCrLf
    s = s & "                when 'decimal' then 'float'" & vbCrLf
    s = s & "                when 'float' then 'float'" & vbCrLf
    s = s & "                when 'real' then 'float'" & vbCrLf
    s = s & "                when 'smallmoney' then 'currency'" & vbCrLf
    s = s & "                when 'money' then 'currency'" & vbCrLf
    s = s & "                when 'date' then 'date'" & vbCrLf
    s = s & "                when 'datetimeoffset' then 'datetime'" & vbCrLf
    s = s & "                when 'datetime2' then 'datetime'" & vbCrLf
    s = s & "                when 'smalldatetime' then 'datetime'" & vbCrLf
    s = s & "                when 'datetime' then 'datetime'" & vbCrLf
    s = s & "                when 'time' then 'time'" & vbCrLf
    s = s & "                when 'char' then  'text'" & vbCrLf
    s = s & "                when 'varchar' then  'text'" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "                when 'nchar' then  'ntext'     -- unicode characters are dbl length. expose as different type " & vbCrLf
    s = s & "                when 'nvarchar' then  'ntext'" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "                when 'text' then 'textarea'" & vbCrLf
    s = s & "                when 'ntext' then 'textarea'" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "                else 'UNSUPPORTED' end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   -- if is text then check the length. convert long fields to textareas" & vbCrLf
    s = s & "   SELECT @x = case when @x='ntext' and (@Length>400 or @length=-1) then 'textarea' else @x end" & vbCrLf
    s = s & "   SELECT @x = case when @x='text' and (@Length>200 or @length=-1) then 'textarea' else @x end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   RETURN( @x )" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s


    sql c, "drop view Intacct_JobCustomFieldsDefinitions ", True
    s = ""
    s = s & "create VIEW dbo.Intacct_JobCustomFieldsDefinitions as" & vbCrLf
    s = s & "select " & vbCrLf
    s = s & " c.name " & vbCrLf
    s = s & ",c.column_id ordinal" & vbCrLf
    s = s & ",'HF_'+replace(c.name,' ','_') as [customFieldId]" & vbCrLf
    s = s & ",case " & vbCrLf
    s = s & "  when dbo.Intacct_CustomFieldType(c.system_type_id,c.max_length)='int' then 'number'" & vbCrLf
    s = s & "  when dbo.Intacct_CustomFieldType(c.system_type_id,c.max_length)='float' then 'number'" & vbCrLf
    s = s & "  when dbo.Intacct_CustomFieldType(c.system_type_id,c.max_length)='datetime' then 'text'" & vbCrLf
    s = s & "  when dbo.Intacct_CustomFieldType(c.system_type_id,c.max_length)='time' then 'text'" & vbCrLf
    s = s & "  when dbo.Intacct_CustomFieldType(c.system_type_id,c.max_length)='ntext' then 'text'" & vbCrLf
    s = s & "  else dbo.Intacct_CustomFieldType(c.system_type_id,c.max_length) end  as [type]" & vbCrLf
    s = s & ",dbo.Intacct_CustomFieldType(c.system_type_id,c.max_length) fullType" & vbCrLf
    s = s & ",'project'  as [ownerObject]" & vbCrLf
    s = s & ",replace(c.name,'_',' ')  as [label]" & vbCrLf
    s = s & ",'HomeFront Job Information'  as [fieldSet]" & vbCrLf
    s = s & ",case dbo.Intacct_CustomFieldType(c.system_type_id,c.max_length)" & vbCrLf
    s = s & "  when 'currency' then 12" & vbCrLf
    s = s & "  when 'float' then 12" & vbCrLf
    s = s & "  when 'int' then 12" & vbCrLf
    s = s & "  else null end  as [leftOfDecimal]" & vbCrLf
    s = s & ",case dbo.Intacct_CustomFieldType(c.system_type_id,c.max_length)" & vbCrLf
    s = s & "  when 'currency' then 2" & vbCrLf
    s = s & "  when 'float' then 4" & vbCrLf
    s = s & "  when 'int' then 0" & vbCrLf
    s = s & "  else null end  as [rightOfDecimal]" & vbCrLf
    s = s & ",case dbo.Intacct_CustomFieldType(c.system_type_id,c.max_length)" & vbCrLf
    s = s & "  when 'ntext' then c.max_length/2  --unicode characters are 2 bytes wide" & vbCrLf
    s = s & "  when 'datetime' then 25" & vbCrLf
    s = s & "  when 'time' then 12" & vbCrLf
    s = s & "  when 'text' then c.max_length" & vbCrLf
    s = s & "  else null end  as [length]" & vbCrLf
    s = s & ",case dbo.Intacct_CustomFieldType(c.system_type_id,c.max_length)" & vbCrLf
    s = s & "  when 'textarea' then 4" & vbCrLf
    s = s & "  else null end  as [rowCount]" & vbCrLf
    s = s & "from sys.columns c " & vbCrLf
    s = s & "where c.object_id=object_id('Intacct_JobCustomFields')" & vbCrLf
    s = s & "and c.name<>'divisionid'" & vbCrLf
    s = s & "and c.name<>'job_no'" & vbCrLf
    sql c, s



