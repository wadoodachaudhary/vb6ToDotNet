    s = s & "    INSERT INTO InvoiceItems(DivisionID,InvoiceID,Vendor,Invoice,Commitment,CommitmentItem,CommitmentDesc,CommitmentVendor,Job,Extra,Phase,PhaseDesc,Category,CategoryDesc,InvoicedQuantity,TaxGroup,TaxGroupDesc,TaxRate,Description,RetainageRate,PreTax,Tax,Retainage,JCTaxRate,NJCTaxRate,Billable)" & vbCrLf
    s = s & "    SELECT d.DivisionID,e.InvoiceID,e.Vendor,e.Invoice,d.PO,d.Line,LEFT(d.poDesc,200),d.Vendor,d.lineJob,d.lineExtra,d.lineCostCode,d.linecostcodeDesc,d.lineCategory,d.linecategoryDesc,0,d.lineTaxGroup,d.lineTaxGroupdesc,d.lineTaxrate,left(d.LineDesc,100),d.Retainagerate" & vbCrLf
    s = s & "          ,d.lineRemainingPretax Pretax" & vbCrLf
    s = s & "          ,d.lineRemainingTax Tax" & vbCrLf
    s = s & "          ,Round(d.lineRemainingPretax*d.Retainagerate/100,2) Retainage          " & vbCrLf
    s = s & "          ,d.LineJCTaxRate,d.LineNJCTaxRate" & vbCrLf
    s = s & "          ,case when isnull(o2.optionvalue,'false')='true' then 1 else 0 end Billable" & vbCrLf
    s = s & "    FROM inserted    i" & vbCrLf
    s = s & "    join tblpoindex  p on i.divisionid=p.divisionid and i.poindex=p.poindex " & vbCrLf
    s = s & "    join jcpodetails d on i.DivisionID=d.DivisionID and i.ponumber=d.po" & vbCrLf
    s = s & "    join AppOptions  o on o.UID='' and o.DivisionID=@DivID and o.OptionName='AutoPayApprovedPOs' and o.OptionValue='True'" & vbCrLf
    s = s & "    join Invoices e ON e.DivisionID = i.DivisionID and i.PONumber+'.5'=e.Invoice and i.Vendor=e.Vendor and e.Source='autoinserting..'" & vbCrLf
    s = s & "    left join AppOptions  o2 on o2.UID='' and o2.DivisionID=@DivID and o2.OptionName='APInvoicesDefaultToBillable'" & vbCrLf
    s = s & "    WHERE i.paypoint5approveddate is not null" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    DECLARE c1 CURSOR FOR" & vbCrLf
    s = s & "      select e.invoiceid" & vbCrLf
    s = s & "      from inserted i" & vbCrLf
    s = s & "      join Invoices e ON(i.DivisionID=e.DivisionID and i.PONumber+'.5'=e.Invoice and i.Vendor=e.Vendor and e.Source='autoinserting..')" & vbCrLf
    s = s & "    OPEN c1" & vbCrLf
    s = s & "    FETCH NEXT FROM c1 INTO @InvoiceID" & vbCrLf
    s = s & "    WHILE @@FETCH_STATUS=0" & vbCrLf
    s = s & "    BEGIN" & vbCrLf
    s = s & "        exec Payables_CreateHBInvoice @InvoiceID" & vbCrLf
    s = s & "        FETCH NEXT FROM c1 INTO @InvoiceID" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "    CLOSE c1" & vbCrLf
    s = s & "    DEALLOCATE c1" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "    SET Source='AutoApproved'" & vbCrLf
    s = s & "    FROM inserted i" & vbCrLf
    s = s & "    join Invoices e ON(i.DivisionID=e.DivisionID and i.PONumber+'.5'=e.Invoice and i.Vendor=e.Vendor and e.Source='autoinserting..')" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
    
    
    
