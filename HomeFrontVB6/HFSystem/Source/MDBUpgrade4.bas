    s = s & ",case when isnull(t.grouprate,0)=0 then 0 else isnull(((x.backchargeamount) - ((x.backchargeamount) / ((100+isnull(t.GroupRate,0))/100))) - round(((x.backchargeamount) - ((x.backchargeamount) / ((100+isnull(t.GroupRate,0))/100)))*t.njcrate/t.grouprate,2),0)  end jctax" & vbCrLf
