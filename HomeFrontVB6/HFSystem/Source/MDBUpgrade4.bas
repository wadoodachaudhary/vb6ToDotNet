    s = s & "FROM ImportedBIMModelBOM x" & vbCrLf
    s = s & "JOIN tblDBAssemblyMaster m on m.divisionid=x.DivisionID and m.Model=case when @DoGlobalsOnly=1 then '' else x.PlanNo end and m.Assembly=x.OptionNumber and m.OptionID=x.OptionNumber and m.Community=@Community" & vbCrLf
