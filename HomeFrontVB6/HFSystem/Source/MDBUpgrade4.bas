    s = s & ",v.Address2 PayeeAddress2" & vbCrLf
    s = s & ",v.City PayeeCity" & vbCrLf
    s = s & ",v.State PayeeState" & vbCrLf
    s = s & ",v.Postal PayeePostal" & vbCrLf
    s = s & ",null PayeeCountry" & vbCrLf
    s = s & ",null CheckNumber" & vbCrLf
    s = s & ",isnull(nullif(a.PaymentNumber,''),a.PaymentID) PaymentNumber" & vbCrLf
    s = s & ",a.PaymentDate" & vbCrLf
    s = s & ",a.PaymentAmount" & vbCrLf
    s = s & ",null PaymentClearedDate" & vbCrLf
    s = s & ",case when a.PaymentState='V' then 1 else 0 end PaymentVoided" & vbCrLf
    s = s & ",a.TransactionID" & vbCrLf
    s = s & ",a.NetAmount" & vbCrLf
    s = s & ",a.InvoiceNumber" & vbCrLf
    s = s & ",a.InvoiceDate" & vbCrLf
    s = s & ",min(b.JobNumber) Job" & vbCrLf
    s = s & ",min(b.JobName) JobAddress1" & vbCrLf
    s = s & ",c.PONumber" & vbCrLf
    s = s & ",null PODate" & vbCrLf
    s = s & ",null POLineNum" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "FROM OPENXML (@adoc, '/response/operation/result/data/APPYMTDETAIL',2)  --first set: pymt, pymtdetail, bill " & vbCrLf
    s = s & "WITH (PaymentID        varchar(40)  'APPYMT.RECORDNO'" & vbCrLf
    s = s & "     ,BankAccount      varchar(50)  'APPYMT.FINANCIALACCOUNTNAME'" & vbCrLf
    s = s & "     ,Payee            varchar(40)  'APPYMT.VENDORID'" & vbCrLf
    s = s & "     ,PaymentNumber    varchar(50)  'APPYMT.DOCNUMBER'" & vbCrLf
    s = s & "     ,PaymentMethod    varchar(30)  'APPYMT.PAYMENTMETHOD' --CASH,ACH,Printed Check" & vbCrLf
    s = s & "     ,PaymentState     varchar(1)   'APPYMT.STATE'    --A,P,C,D,V,S -- Approved,Printed,ConfirmedPosted,Draft,Voided,Subitted" & vbCrLf
    s = s & "     ,PaymentDate      date         'APPYMT.WHENCREATED'" & vbCrLf
    s = s & "     ,PaymentAmount    money        'APPYMT.TRX_TOTALDUE'" & vbCrLf
    s = s & "     ,TransactionID    varchar(40)  'RECORDNO'" & vbCrLf
    s = s & "     ,NetAmount        money        'PAYMENTAMOUNT'" & vbCrLf
    s = s & "     ,InvoiceNumber    varchar(25)  'APBILL.DOCNUMBER'" & vbCrLf
    s = s & "     ,InvoiceDate      varchar(25)  'APBILL.AUWHENCREATED'" & vbCrLf
    s = s & "     ,BILLRECNO        varchar(50)  'APBILL.RECORDNO'" & vbCrLf
    s = s & ") a" & vbCrLf
    s = s & "JOIN OPENXML (@bdoc, '/response/operation/result/data/APBILLITEM',2)  --second set: bill, billitem " & vbCrLf
    s = s & "WITH (BILLRECNO        varchar(50)  'APBILL.RECORDNO'" & vbCrLf
    s = s & "     ,JobNumber        varchar(25)  'PROJECTID'" & vbCrLf
    s = s & "     ,JobName          varchar(25)  'PROJECTNAME'" & vbCrLf
    s = s & ") b on a.billrecno=b.billrecno" & vbCrLf
    s = s & "JOIN OPENXML (@cdoc, '/response/operation/result/data/APBILL',2)  --third set: bill, vendorinvoice" & vbCrLf
    s = s & "WITH (BILLRECNO        varchar(50)  'RECORDNO'" & vbCrLf
    s = s & "     ,PONUmber         varchar(25)  'PODOCUMENT.CREATEDFROM'" & vbCrLf
