    s = ""
    s = s & "alter PROCEDURE [dbo].[CustomerCalcTotals](@CustID Varchar(12)) AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "--Values for Calculation purposes" & vbCrLf
    s = s & "DECLARE @Exempt FLOAT" & vbCrLf
    s = s & "DECLARE @NotExempt FLOAT" & vbCrLf
    s = s & "DECLARE @Incentive FLOAT" & vbCrLf
