    s = s & "        dateadd(mm,3,datefromparts(year(@InvDate),month(@InvDate),@TermNetDays))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when  @TermNetType='OnADayOfThe4thMonth' and @TermNetDays<>0 then" & vbCrLf
    s = s & "        dateadd(mm,4,datefromparts(year(@InvDate),month(@InvDate),@TermNetDays))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when  @TermNetType='OnADayOfThe5thMonth' and @TermNetDays<>0 then" & vbCrLf
