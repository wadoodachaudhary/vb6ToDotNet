    s = s & ",x.BackChargeDate PaymentDate" & vbCrLf
    s = s & ",x.BackChargeDate AccountingDate" & vbCrLf
    s = s & ",x.BackChargeDesc Description" & vbCrLf
    s = s & ",'BuildPro' UStmp" & vbCrLf
    s = s & ",getdate() DStmp" & vbCrLf
    s = s & ",getdate() TStmp" & vbCrLf
