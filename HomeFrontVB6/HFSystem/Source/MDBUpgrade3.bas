    s = ""
    s = s & "alter PROCEDURE dbo.Payables_CreateHBInvoice(@InvoiceID as int) as" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "-- this proc moves retainage amounts from non-timberline invoices to their own holdback" & vbCrLf
    s = s & "-- invoice which can be individually pushed to accounting systems." & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "declare @RetainageID as int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "-- create a HB invoice if accounting sys is not timberline and invoice has amt retained" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "insert into invoices(Vendor,VendorType,VendorName,Invoice,Job,JobDesc" & vbCrLf
    s = s & ",Status,Discount,DiscountDate,ReceivedDate,InvoiceDate" & vbCrLf
    s = s & ",PaymentDate,AccountingDate,Description,UStmp,TStmp,Source" & vbCrLf
    s = s & ",InvoiceCode1,InvoiceCode2,VendorAddr1,VendorAddr2,VendorCity" & vbCrLf
    s = s & ",VendorProv,VendorPostal,RetainageInvoice,DivisionID,DeptID)" & vbCrLf
    s = s & "select distinct" & vbCrLf
    s = s & " i.Vendor,i.VendorType,i.VendorName,i.Invoice + 'HB' Invoice,i.Job,i.JobDesc" & vbCrLf
    s = s & ",'Holdback' Status,i.Discount,i.DiscountDate,i.ReceivedDate,i.InvoiceDate" & vbCrLf
    s = s & ",i.PaymentDate,i.AccountingDate,i.Description,i.UStmp,i.TStmp,i.Source" & vbCrLf
    s = s & ",i.InvoiceCode1,i.InvoiceCode2,i.VendorAddr1,i.VendorAddr2,i.VendorCity" & vbCrLf
    s = s & ",i.VendorProv,i.VendorPostal,1 RetainageInvoice,i.DivisionID,i.DeptID" & vbCrLf
    s = s & "from invoices i" & vbCrLf
    s = s & "join invoiceitems d on i.InvoiceID=d.InvoiceID and d.Retainage<>0" & vbCrLf
    s = s & "join appoptions a on a.DivisionID=i.DivisionID and a.OptionName='AccountingSystem' and a.OptionValue<>'1'" & vbCrLf
    s = s & "where isnull(i.RetainageID,0)=0" & vbCrLf
    s = s & "  and i.InvoiceID=@InvoiceID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "-- no HB invoice created so exit" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "select @RetainageID = SCOPE_IDENTITY()" & vbCrLf
    s = s & "if @RetainageID is null return" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "-- write HB InvoiceID to original invoice" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "update invoices " & vbCrLf
    s = s & "set RetainageID=@RetainageID" & vbCrLf
    s = s & "where InvoiceID=@InvoiceID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "-- create HB invoice items" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "insert into invoiceitems(invoiceid,vendor,invoice,commitment,commitmentdesc,commitmentitem,commitmentvendor,job,jobdesc,extra,extradesc" & vbCrLf
    s = s & ",phase,phasedesc,category,categorydesc,debitaccount,debitaccountdesc,taxgroup,taxgroupdesc,taxrate,description,billable,equipmentcostcode,equipmentcostcodedesc,equipment,divisionid,jctaxrate,njctaxrate" & vbCrLf
    s = s & ",pretax,invoicedquantity,invoicedunitprice,tax,retainage,retainagerate,jctax,njctax)" & vbCrLf
    s = s & "select @RetainageID" & vbCrLf
    s = s & ",vendor,invoice,commitment,commitmentdesc,commitmentitem,commitmentvendor,job,jobdesc,extra,extradesc" & vbCrLf
    s = s & ",phase,phasedesc,category,categorydesc,debitaccount,debitaccountdesc,taxgroup,taxgroupdesc,taxrate,description,billable,equipmentcostcode,equipmentcostcodedesc,equipment,divisionid,jctaxrate,njctaxrate" & vbCrLf
    s = s & ",retainage pretax" & vbCrLf
    s = s & ",InvoicedQuantity * retainagerate/100" & vbCrLf
    s = s & ",invoicedunitprice" & vbCrLf
    s = s & ",round(retainage * taxrate/100,2) tax" & vbCrLf
    s = s & ",0 retainage" & vbCrLf
    s = s & ",0 retainagerate" & vbCrLf
    s = s & ",round(retainage * jctaxrate/100,2) jctax" & vbCrLf
    s = s & ",round(retainage * taxrate/100,2) - round(retainage * jctaxrate/100,2) njctax" & vbCrLf
    s = s & "from invoiceitems" & vbCrLf
    s = s & "where invoiceid=@InvoiceID" & vbCrLf
    s = s & "and retainage<>0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "-- update invoice items change amt to amt-retainage, tax to tax-retainage" & vbCrLf
    s = s & "--   some of these could be rewritten more clearly but then you risk rounding problems " & vbCrLf
    s = s & "--   the only way to avoid rounding issues is to use the same calculations as the HB invoice" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "update invoiceitems set " & vbCrLf
    s = s & " pretax = pretax - retainage" & vbCrLf
    s = s & ",InvoicedQuantity = InvoicedQuantity - InvoicedQuantity * retainagerate/100" & vbCrLf
    s = s & ",tax    = tax    - round(retainage * taxrate/100,2)" & vbCrLf
    s = s & ",jctax  = jctax  - round(retainage * jctaxrate/100,2)" & vbCrLf
    s = s & ",njctax = njctax - round(retainage * taxrate/100,2) - round(retainage * jctaxrate/100,2)" & vbCrLf
    s = s & ",retainage = 0" & vbCrLf
    s = s & ",retainagerate = 0" & vbCrLf
    s = s & "where invoiceid=@InvoiceID" & vbCrLf
    s = s & "and retainage<>0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "-- update totals on invoice and HB invoice" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "update invoices " & vbCrLf
    s = s & "set pretax = (select sum(pretax) from invoiceitems where invoiceid=invoices.invoiceid)" & vbCrLf
    s = s & "   ,tax = (select sum(tax) from invoiceitems where invoiceid=invoices.invoiceid)" & vbCrLf
    s = s & "where invoiceid IN(@InvoiceID, @RetainageID)" & vbCrLf
    sql c, s
    
    
