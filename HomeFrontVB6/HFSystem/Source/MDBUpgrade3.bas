    s = s & "   select c.DivisionID,c.Customer_No,cast(c.LastClaimNumber as varchar),GetDate(),'Pending',t.taxgroup,t.jcrate,t.njcrate,s.sale_credit" & vbCrLf
    s = s & "   from tblCustomers c" & vbCrLf
