    s = s & "          ,d.LineJCTaxRate,d.LineNJCTaxRate" & vbCrLf
    s = s & "    FROM inserted    i" & vbCrLf
    s = s & "    join tblpoindex  p on i.divisionid=p.divisionid and i.poindex=p.poindex " & vbCrLf
    s = s & "    join jcpodetails d on i.DivisionID=d.DivisionID and i.ponumber=d.po" & vbCrLf
    s = s & "    join AppOptions  o on i.DivisionID=o.DivisionID and o.OptionName='AutoPayApprovedPOs' and o.OptionValue='True'" & vbCrLf
    s = s & "    join Invoices e ON e.DivisionID = i.DivisionID and i.PONumber+'.5'=e.Invoice and i.Vendor=e.Vendor and e.Source='autoinserting..'" & vbCrLf
    s = s & "    WHERE i.paypoint5approveddate is not null" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    DECLARE c1 CURSOR FOR" & vbCrLf
    s = s & "      select e.invoiceid" & vbCrLf
    s = s & "      from inserted i" & vbCrLf
    s = s & "      join Invoices e ON(i.DivisionID=e.DivisionID and i.PONumber+'.5'=e.Invoice and i.Vendor=e.Vendor and e.Source='autoinserting..')" & vbCrLf
    s = s & "    OPEN c1" & vbCrLf
