    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- look in tblVendors" & vbCrLf
    s = s & "    IF @vendor<>'' BEGIN" & vbCrLf
    s = s & "        SET @TaxGroup = (SELECT CASE @CostType WHEN 1 THEN LabourTaxGroup WHEN 2 THEN MaterialTaxGroup WHEN 3 THEN SubContractTaxGroup WHEN 4 THEN EquipmentTaxGroup WHEN 5 THEN OverheadTaxGroup WHEN 6 THEN OtherTaxGroup END " & vbCrLf
    s = s & "                           FROM tblVendors" & vbCrLf
    s = s & "                          WHERE Vendor_ID=@vendor and DivisionID = @DivisionID)" & vbCrLf
    s = s & "        IF (ISNULL(@TaxGroup,'')<>'') RETURN(@TaxGroup)" & vbCrLf
