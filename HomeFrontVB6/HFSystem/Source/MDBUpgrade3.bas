    s = s & "  left outer join taxgroups          t   on(i.DivisionID=t.DivisionID and t.taxgroup=case when dbo.getoption_integer(1,'RecalcPOTaxAtCurrentRate')=1 then dbo.getoption_varchar(i.divisionid,'DefaultTaxGroup') else i.taxgroup end)" & vbCrLf
