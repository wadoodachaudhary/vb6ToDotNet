c = "Add AP invoice import"
    s = ""
    s = s & "create proc dbo.AP_ImportFromFile @SessionID varchar(50), @UStmp varchar(10) as" & vbCrLf
    s = s & "-- processes invoices imported into staging table." & vbCrLf
    s = s & "-- returns status string explaining outcomes." & vbCrLf
    s = s & "" & vbCrLf
    s = s & "declare @errors varchar(max)" & vbCrLf
    s = s & "declare @invoiceid integer" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "-- validation" & vbCrLf
    s = s & "------------------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "select @errors=''" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- invoice vendor is valid ------------------------------" & vbCrLf
    s = s & "select @errors=@errors + 'invalid vendor on invoice: ' + i.vendor +', ' + i.invoice + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPInvoices i" & vbCrLf
    s = s & "left outer join tblvendors v on v.divisionid=i.divisionid and v.vendor_id=i.vendor" & vbCrLf
    s = s & "where i.SessionID=@SessionID" & vbCrLf
    s = s & "and v.vendor_id is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- invoices are unique ------------------------------" & vbCrLf
    s = s & "select @errors=@errors + 'invoice is specified more than once: ' + i.vendor +', ' + i.invoice + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPInvoices i" & vbCrLf
    s = s & "where SessionID=@SessionID" & vbCrLf
    s = s & "group by divisionid,vendor,invoice" & vbCrLf
    s = s & "having count(*)>1" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- invoices already exist ------------------------------" & vbCrLf
    s = s & "select @errors=@errors + 'invoice already exists: ' + a.vendor +', ' + a.invoice + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPInvoices a" & vbCrLf
    s = s & "join Invoices b on a.divisionid=b.divisionid and a.vendor=b.vendor and a.invoice=b.invoice" & vbCrLf
    s = s & "where a.SessionID=@SessionID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- invoice department is blank or valid and present if required ------------------------------" & vbCrLf
    s = s & "select distinct @errors=@errors + 'invalid department on invoice: ' + a.vendor +', ' + a.invoice +': ' + a.department + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPInvoices a" & vbCrLf
    s = s & "left outer join departments b on a.divisionid=b.divisionid and a.department=b.name" & vbCrLf
    s = s & "join appoptions o on o.divisionid=a.divisionid and o.optionname='Departmentisrequired' and isnull(ustmp,'')=''" & vbCrLf
    s = s & "where ((a.department<>'' and b.divisionid is null) or (a.department=''  and o.optionvalue='true'))" & vbCrLf
    s = s & "and a.SessionID=@SessionID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- invoice date if required ------------------------------" & vbCrLf
    s = s & "select distinct @errors=@errors + 'invoice date is required: ' + a.vendor +', ' + a.invoice + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPInvoices a" & vbCrLf
    s = s & "join appoptions o on o.divisionid=a.divisionid and o.optionname='invoicedaterequired' and isnull(ustmp,'')=''" & vbCrLf
    s = s & "where (a.invoicedate is null and o.optionvalue='true')" & vbCrLf
    s = s & "and a.SessionID=@SessionID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- payment date if required ------------------------------" & vbCrLf
    s = s & "select distinct @errors=@errors + 'payment date is required: ' + a.vendor +', ' + a.invoice + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPInvoices a" & vbCrLf
    s = s & "join appoptions o on o.divisionid=a.divisionid and o.optionname='paymentdaterequired' and isnull(ustmp,'')=''" & vbCrLf
    s = s & "where (a.paymentdate is null and o.optionvalue='true')" & vbCrLf
    s = s & "and a.SessionID=@SessionID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- received date if required ------------------------------" & vbCrLf
    s = s & "select distinct @errors=@errors + 'received date is required: ' + a.vendor +', ' + a.invoice + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPInvoices a" & vbCrLf
    s = s & "join appoptions o on o.divisionid=a.divisionid and o.optionname='receiveddaterequired' and isnull(ustmp,'')=''" & vbCrLf
    s = s & "where (a.receiveddate is null and o.optionvalue='true')" & vbCrLf
    s = s & "and a.SessionID=@SessionID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- distribution vendor is valid ------------------------------" & vbCrLf
    s = s & "select @errors=@errors + 'invalid vendor on distribution: ' + i.vendor +', ' + i.invoice + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPDistributions i" & vbCrLf
    s = s & "left outer join tblvendors v on v.divisionid=i.divisionid and v.vendor_id=i.vendor" & vbCrLf
    s = s & "where i.SessionID=@SessionID" & vbCrLf
    s = s & "and v.vendor_id is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- distributions all have invoices ------------------------------" & vbCrLf
    s = s & "select @errors=@errors + 'no invoice matching distribution: ' + d.vendor +', ' + d.invoice + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPDistributions d" & vbCrLf
    s = s & "left outer join ImportedAPInvoices i on d.divisionid=i.divisionid and d.vendor=i.vendor and d.invoice=i.invoice and d.SessionID=i.SessionID" & vbCrLf
    s = s & "where d.SessionID=@SessionID" & vbCrLf
    s = s & "and i.invoice is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- PO item is blank or valid ------------------------------" & vbCrLf
    s = s & "select distinct @errors=@errors + 'invalid po/item on distribution: ' + a.vendor +', ' + a.invoice +': ' + a.po +'/' + cast(a.poitem as varchar) + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPDistributions a" & vbCrLf
    s = s & "left outer join poitems b on a.divisionid=b.divisionid and a.po=b.ponumber and a.poitem=b.linenumber" & vbCrLf
    s = s & "where a.po<>'' and a.SessionID=@SessionID" & vbCrLf
    s = s & "and b.divisionid is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- job is blank or valid ------------------------------" & vbCrLf
    s = s & "select distinct @errors=@errors + 'invalid job on distribution: ' + a.vendor +', ' + a.invoice +': ' + a.job + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPDistributions a" & vbCrLf
    s = s & "left outer join tbljobs b on a.divisionid=b.divisionid and a.job=b.job_no" & vbCrLf
    s = s & "where a.job<>'' and a.SessionID=@SessionID" & vbCrLf
    s = s & "and b.divisionid is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- costcode is blank or valid ------------------------------" & vbCrLf
    s = s & "select distinct @errors=@errors + 'invalid costcode on distribution: ' + a.vendor +', ' + a.invoice +': ' + a.costcode + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPDistributions a" & vbCrLf
    s = s & "left outer join standardcostcodes b on a.divisionid=b.divisionid and a.costcode=b.costcode" & vbCrLf
    s = s & "where a.costcode<>'' and a.SessionID=@SessionID" & vbCrLf
    s = s & "and b.divisionid is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- category is blank or valid ------------------------------" & vbCrLf
    s = s & "select distinct @errors=@errors + 'invalid category on distribution: ' + a.vendor +', ' + a.invoice +': ' + a.category + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPDistributions a" & vbCrLf
    s = s & "left outer join standardcategories b on a.divisionid=b.divisionid and a.category=b.category" & vbCrLf
    s = s & "where a.category<>'' and a.SessionID=@SessionID" & vbCrLf
    s = s & "and b.divisionid is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- debitaccount is blank or valid ------------------------------" & vbCrLf
    s = s & "select distinct @errors=@errors + 'invalid account on distribution: ' + a.vendor +', ' + a.invoice +': ' + a.debitaccount + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPDistributions a" & vbCrLf
    s = s & "left outer join glaccounts b on a.divisionid=b.divisionid and a.debitaccount=b.account" & vbCrLf
    s = s & "where a.debitaccount<>'' and a.SessionID=@SessionID" & vbCrLf
    s = s & "and b.divisionid is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- taxgroup is blank or valid ------------------------------" & vbCrLf
    s = s & "select distinct @errors=@errors + 'invalid taxgroup on distribution: ' + a.vendor +', ' + a.invoice +': ' + a.taxgroup + char(13) + char(10)" & vbCrLf
    s = s & "from ImportedAPDistributions a" & vbCrLf
    s = s & "left outer join taxgroups b on a.divisionid=b.divisionid and a.taxgroup=b.taxgroup" & vbCrLf
    s = s & "where a.taxgroup<>'' and a.SessionID=@SessionID" & vbCrLf
    s = s & "and b.divisionid is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "if(@errors<>'') begin" & vbCrLf
    s = s & "  select isnull(@errors,'validation failed (@errors=null)') error" & vbCrLf
    s = s & "  return" & vbCrLf
    s = s & "end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------------------------------------------------------------------" & vbCrLf
