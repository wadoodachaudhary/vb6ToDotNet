    s = s & ",p.Job HFJob" & vbCrLf
    s = s & ",pj.BPJob Job" & vbCrLf
    s = s & ",j.Community " & vbCrLf
    s = s & ",0 CommunityPhase --- not used" & vbCrLf
    s = s & ",poi.LineNumber" & vbCrLf
    s = s & ",i.Description ItemDescription" & vbCrLf
    s = s & ",i.POQty Qty" & vbCrLf
    s = s & ",i.OrderUOM UOM" & vbCrLf
    s = s & ",i.PORate UnitPrice" & vbCrLf
    s = s & ",i.POPretax Pretax" & vbCrLf
    s = s & ",i.PONJCTax+i.POJCTax Tax" & vbCrLf
    s = s & ",i.PONJCTax NJCTax" & vbCrLf
    s = s & ",i.POJCTax JCTax" & vbCrLf
    s = s & ",p.DateSentToBuildPro" & vbCrLf
    s = s & ",p.MPOReceived " & vbCrLf
    s = s & ",0 OptionCost" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & ",case when isnull(EPODocType,'')='' then a.optionid else '' end OptionID" & vbCrLf
    s = s & ",case when isnull(EPODocType,'')='' then a.hfdescription else '' end OptionDesc" & vbCrLf
    s = s & ",case when isnull(EPODocType,'')='' then a.salesqty else '' end OptionQty" & vbCrLf
    s = s & ",case when isnull(EPODocType,'')='' then a.hfcomments else '' end OptionNotes" & vbCrLf
    s = s & "" & vbCrLf
    s = s & ",case when isnull(EPODocType,'')='' then a.Color else '' end AttrColor" & vbCrLf
    s = s & ",case when isnull(EPODocType,'')='' then a.Style else '' end AttrStyle" & vbCrLf
    s = s & ",case when isnull(EPODocType,'')='' then a.Finish else '' end AttrFinish" & vbCrLf
    s = s & ",case when isnull(EPODocType,'')='' then a.Location else '' end AttrLocation" & vbCrLf
    s = s & ",case when isnull(EPODocType,'')='' then a.Other else '' end AttrOther" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "from pomaster p" & vbCrLf
    s = s & "join BuildPro_POs_Job pj on( p.divisionid=pj.divisionid and p.ponumber=pj.ponumber)" & vbCrLf
    s = s & "join system_setup s on( p.divisionid=s.id)" & vbCrLf
    s = s & "join poitems pi on( p.divisionid=pi.divisionid and p.ponumber=pi.ponumber)" & vbCrLf
    s = s & "join BuildPro_POs_Items poi on( pi.itemseq=poi.itemseq)" & vbCrLf
    s = s & "join tblpoindex x on( p.divisionid=x.divisionid and p.poindex=x.poindex and (x.BuildProEnabled=1 or p.epodocnumber<>'') )" & vbCrLf
    s = s & "join tbljobs j on( p.divisionid=j.divisionid and  p.job=j.job_no and ((j.start_date is not null and isnull(j.scheduletemplate,'')<>'') or p.epodocnumber<>'') )" & vbCrLf
    s = s & "join estimateitems i on( pi.estitemid=i.estitemid)" & vbCrLf
    s = s & "join estimateassemblies a on( i.estassemblyid=a.estassemblyid)" & vbCrLf
    s = s & "join divisioncommunities r on( r.divisionid=j.divisionid and r.community=j.community and r.buildproenabled=1)" & vbCrLf
    sql c, s
    
    
    s = ""
    s = s & "alter view [dbo].[BuildPro_POs_Job] as" & vbCrLf
    s = s & "-- find which job a po belongs to" & vbCrLf
    s = s & "select " & vbCrLf
    s = s & " E.DivisionID " & vbCrLf
    s = s & ",e.PONumber" & vbCrLf
    s = s & ",min(e.job) HFJob" & vbCrLf
    s = s & ",case " & vbCrLf
    s = s & "  when s.multifamily=1 and s.buildpromultifamily=1" & vbCrLf
    s = s & "  then min(e.job)+'_'+max(isnull(e.unit,''))" & vbCrLf
    s = s & "  else min(e.job) end BPJob" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "from system_setup s " & vbCrLf
    s = s & "join estimateitems e on (e.divisionid=s.id)" & vbCrLf
    s = s & "left join appoptions o on (o.divisionid=s.id and o.optionname='BuildPRo_SendMultiJobPOsToAllJobs')" & vbCrLf
    s = s & "where isnull(e.ponumber,'')<>''" & vbCrLf
    s = s & "group by e.Divisionid,e.PONumber,e.unit,s.buildpromultifamily,s.multifamily,o.optionvalue" & vbCrLf
    sql c, s
    
    Call Revisions_2021_Q2

End Sub


