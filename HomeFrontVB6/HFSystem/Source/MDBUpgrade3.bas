    s = s & "from ImportedAPInvoices i " & vbCrLf
    s = s & "join Invoices x on i.divisionid=x.divisionid and i.vendor=x.vendor and x.invoice=i.invoice" & vbCrLf
    s = s & "where i.SessionID=@SessionID" & vbCrLf
