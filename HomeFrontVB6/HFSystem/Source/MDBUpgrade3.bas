    s = s & "set ExternalID=x.ExternalID" & vbCrLf
    s = s & "FROM OPENXML (@idoc, '/response/operation/result/data/podocumententry',2)" & vbCrLf
    s = s & "WITH (PONumber   varchar(40)  'DOCHDRID'" & vbCrLf
    s = s & "     ,LineNumber varchar(40)  'LINE_NO'" & vbCrLf
    s = s & "     ,ExternalID varchar(40)  'RECORDNO'" & vbCrLf
    s = s & ") x" & vbCrLf
    s = s & "JOIN POItems i on i.divisionid=@DivisionID and (x.ponumber='Subcontracts-'+i.ponumber or x.ponumber='Purchase Orders-'+i.ponumber) and i.linenumber=x.linenumber+1" & vbCrLf
