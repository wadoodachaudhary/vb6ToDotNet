    s = s & ",JCTax = p.JCTaxRate/100 * Round(x.QtyUsed * p.Rate,2)" & vbCrLf
    s = s & ",NJCTax = p.NJCTaxRate/100 * Round(x.QtyUsed * p.Rate,2)" & vbCrLf
