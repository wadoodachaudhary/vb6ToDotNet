Private Sub Revisions_2020_03()
Dim s As String
Dim c As String

c = "BIM Import proc changes"

    s = ""
    s = s & "ALTER PROCEDURE [dbo].[BIM_ImportJobBOM] @UserID varchar(10), @DivisionID int, @XmlString text as" & vbCrLf
    s = s & "DECLARE @idoc int" & vbCrLf
    s = s & "EXEC sp_xml_preparedocument @idoc OUTPUT, @XmlString" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "DECLARE @SessionID varchar(40)" & vbCrLf
    s = s & "SET @SessionID = NEWID() " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "--  insert data to temp table " & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "insert ImportedBIMJobBOM(SessionID,DivisionID,job,ismodel,estassemblyid,optionid,optiondesc,poindex,partnumber,itemdesc,qty,uom,notes)" & vbCrLf
    s = s & "SELECT" & vbCrLf
    s = s & " @SessionID,@DivisionID" & vbCrLf
    s = s & ",Job" & vbCrLf
    s = s & ",case when optionid=1 then 1 else 0 end IsModel" & vbCrLf
    s = s & ",case when CustomOptionID<>'0' then replace(CustomOptionNumber,'CUSTOM','') else null end EstAssemblyID" & vbCrLf
    s = s & ",case when CustomOptionID<>'0' then 'CUSTOM' else OptionNumber end OptionID" & vbCrLf
    s = s & ",case " & vbCrLf
    s = s & "   when optionid=1 then OptionDesc" & vbCrLf
    s = s & "   when customoptionid<>0 then CustomOptionDesc" & vbCrLf
    s = s & "   when optionid=0 and customoptionid=0 then 'Custom Materials' " & vbCrLf
    s = s & "   else OptionDesc" & vbCrLf
    s = s & "   end OptionDesc" & vbCrLf
    s = s & ",POIndex" & vbCrLf
    s = s & ",case when stylename='BID'" & vbCrLf
    s = s & "   then replace(reverse(left(reverse(productname),charindex('',reverse(productname),charindex('',reverse(productname))+1))),'','')+'-'+itemcode" & vbCrLf
    s = s & "   else phasecode+'-'+itemcode end PartNumber" & vbCrLf
    s = s & ",ItemDesc" & vbCrLf
    s = s & ",Qty" & vbCrLf
    s = s & ",UOM" & vbCrLf
    s = s & ",Notes" & vbCrLf
    s = s & "FROM OPENXML (@idoc, '/ArrayOfJobBOMRecord/JobBOMRecord',2)" & vbCrLf
    s = s & "WITH (Job  varchar(40)          'Jobs_Number'" & vbCrLf
    s = s & "     ,OptionID varchar(800)     'Options_Id'" & vbCrLf
    s = s & "     ,OptionDesc varchar(800)   'Options_Description'" & vbCrLf
    s = s & "    ,CustomOptionID varchar(800) 'CustomOptions_Id'" & vbCrLf
    s = s & "    ,CustomOptionNumber varchar(800) 'CustomOptions_Name'" & vbCrLf
    s = s & "    ,CustomOptionDesc varchar(800) 'CustomOptions_Description'" & vbCrLf
    s = s & "     ,POIndex varchar(800)      'BuildingPhases_Code'" & vbCrLf
    s = s & "     ,ItemDesc varchar(800)     'Products_Description'" & vbCrLf
    s = s & "     ,Notes varchar(800)        'Products_Notes'" & vbCrLf
    s = s & "     ,Qty varchar(800)          'Products_QuantityTotal'" & vbCrLf
    s = s & "     ,UOM varchar(800)          'Products_UnitTypesAbbreviation'" & vbCrLf
    s = s & "     ,OptionNumber varchar(800)  'Options_Number'" & vbCrLf
    s = s & "     ,PhaseCode varchar(800)     'BuildingPhases_Code'" & vbCrLf
    s = s & "     ,ItemCode varchar(800)      'Products_Code'" & vbCrLf
    s = s & "     ,ProductName varchar(800)   'Products_Name'" & vbCrLf
    s = s & "     ,StyleName varchar(800)     'Styles_Name')" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "--  remove ignored poindexes from temp table " & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "delete x" & vbCrLf
    s = s & "from ImportedBimJobBom x " & vbCrLf
    s = s & "join BIMImortIgnoreBuildingPhases y on y.buildingphase=x.poindex" & vbCrLf
    s = s & "where x.sessionid=@sessionid" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "--  increment estimateindex on customer " & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "update c" & vbCrLf
    s = s & "set estimateindex=c.estimateindex+1" & vbCrLf
    s = s & "from tblcustomers c" & vbCrLf
    s = s & "join system_setup s on c.divisionid=s.id" & vbCrLf
    s = s & "where c.job_no=(" & vbCrLf
    s = s & "   select top 1 job from ImportedBimJobBom x" & vbCrLf
    s = s & "   where x.sessionid=@sessionid" & vbCrLf
    s = s & ")" & vbCrLf
    s = s & "and" & vbCrLf
    s = s & "((c.purchased=1 AND c.cancelled=0 AND c.inactive=0 AND ((isnull(s.accounting_approve,0)=1 AND c.approved=1) OR (isnull(s.accounting_approve,0)=0 AND c.contract_assigned=1) OR isnull(s.PurchasingRequiresSalesApproval,0)=0))" & vbCrLf
    s = s & "  OR " & vbCrLf
    s = s & "(c.home_selection <>'PreSale' OR c.presale_selection<>'PreSale'))" & vbCrLf
    s = s & "" & vbCrLf
