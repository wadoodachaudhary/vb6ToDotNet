    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "--  insert data to temp table " & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "insert ImportedBIMJobBOM(SessionID,DivisionID,job,ismodel,optionid,optiondesc,poindex,partnumber,itemdesc,qty,uom,notes)" & vbCrLf
