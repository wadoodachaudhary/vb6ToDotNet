    s = s & "              AND c.Community=d.community" & vbCrLf
    s = s & "              AND c.Phase=d.communityPhase" & vbCrLf
    s = s & "              AND a.assembly=d.assembly" & vbCrLf
    s = s & "              AND a.model=d.model" & vbCrLf
    s = s & "              AND a.optionid=d.optionid" & vbCrLf
    s = s & "      ------------------------------------------------------------------------" & vbCrLf
    s = s & "            -- add the items that come from a SalesWorksheet" & vbCrLf
    s = s & "            ------------------------------------------------------------------------" & vbCrLf
    s = s & "            INSERT INTO EstimateItems(DivisionID,EstAssemblyID, POIndex, Phase, Item, Job, JCExtra, JCCostCode, JCCategory, SortOrder, Description, Comments, TakeoffQty, TakeoffUOM, ConversionFactor, OrderUOM, BudgetVendor, BudgetQty, BudgetRate, ExcludeFromPO,Assembly" & vbCrLf
    s = s & "                                     ,Location,WBS01,WBS02,WBS03,WBS04,WBS05,WBS06,WBS07,WBS08,WBS09,WBS10,WBS11,WBS12,WBS13,WBS14,WBS15,WBS16,WBS17,WBS18,WBS19,WBS20,WBS21,WBS22,WBS23,WBS24,WBS25,WBS26,WBS27,WBS28,WBS29,WBS30,WBS31,WBS32,WBS33,WBS34,WBS35,WBS36,WBS37,WBS38,WBS39,WBS40)" & vbCrLf
    s = s & "            SELECT @DivisionID,e.EstAssemblyID" & vbCrLf
    s = s & "                  ,isnull(nullif(d.POIndex,''),isnull(i.POIndex,''))" & vbCrLf
    s = s & "                  ,i.Phase" & vbCrLf
    s = s & "                  ,i.Item" & vbCrLf
    s = s & "                  ,e.Job" & vbCrLf
    s = s & "                  ,e.JCExtra" & vbCrLf
    s = s & "                  ,isnull(nullif(case when e.assemblytype=0 or o.OptionName<>'true' then i.jccostcode else isnull(nullif(i.altjccostcode,''),i.jccostcode) end ,''),p.jccostcode)" & vbCrLf
    s = s & "                  ,isnull(nullif(@JCCategory,''),i.JCCategory)" & vbCrLf
    s = s & "                  ,d.Sequence SortOrder" & vbCrLf
    s = s & "                  ,i.Description" & vbCrLf
    s = s & "                  ,i.Notes Comments" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "                  ,CASE WHEN ISNULL(f.UseNormalSalesQtyFactors,0)=1 THEN (e.SalesQty * d.TakeoffQty)" & vbCrLf
    s = s & "                        WHEN UPPER(e.AssemblyUOM)=UPPER(i.TakeoffUOM) THEN (e.SalesQty * d.TakeoffQty)" & vbCrLf
    s = s & "                        WHEN UPPER(e.AssemblyUOM)=UPPER(i.OrderUOM) THEN (e.SalesQty * d.OrderQty / i.ConversionFactor)" & vbCrLf
    s = s & "                        WHEN e.SalesQty < 0 THEN d.TakeoffQty * -1" & vbCrLf
    s = s & "                        ELSE d.TakeoffQty END TakeoffQty" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "                  ,i.TakeoffUOM" & vbCrLf
    s = s & "                  ,i.ConversionFactor" & vbCrLf
    s = s & "                  ,i.OrderUOM" & vbCrLf
    s = s & "                  ,d.Vendor BudgetVendor" & vbCrLf
    s = s & "                  ,CASE WHEN ISNULL(f.UseNormalSalesQtyFactors,0)=1 THEN (e.SalesQty * d.OrderQty)" & vbCrLf
    s = s & "                        WHEN UPPER(e.AssemblyUOM)=UPPER(i.OrderUOM) THEN (e.SalesQty * d.OrderQty)" & vbCrLf
    s = s & "                        WHEN UPPER(e.AssemblyUOM)=UPPER(i.TakeoffUOM) THEN (e.SalesQty * d.TakeoffQty * i.ConversionFactor)" & vbCrLf
    s = s & "                        WHEN e.SalesQty < 0 THEN d.OrderQty * -1" & vbCrLf
    s = s & "                        ELSE d.OrderQty END BudgetQty" & vbCrLf
    s = s & "                  ,CASE when e.IncludedInSpec=0 then d.Rate else 0 end  BudgetRate" & vbCrLf
    s = s & "                  ,0 ExcludeFromPO" & vbCrLf
    s = s & "                  ,e.Assembly" & vbCrLf
    s = s & "                  ,isnull(nullif(d.Location,''),i.Location)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS01,''),i.WBS01),isnull(nullif(d.WBS02,''),i.WBS02),isnull(nullif(d.WBS03,''),i.WBS03),isnull(nullif(d.WBS04,''),i.WBS04),isnull(nullif(d.WBS05,''),i.WBS05)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS06,''),i.WBS06),isnull(nullif(d.WBS07,''),i.WBS07),isnull(nullif(d.WBS08,''),i.WBS08),isnull(nullif(d.WBS09,''),i.WBS09),isnull(nullif(d.WBS10,''),i.WBS10)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS11,''),i.WBS11),isnull(nullif(d.WBS12,''),i.WBS12),isnull(nullif(d.WBS13,''),i.WBS13),isnull(nullif(d.WBS14,''),i.WBS14),isnull(nullif(d.WBS15,''),i.WBS15)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS16,''),i.WBS16),isnull(nullif(d.WBS17,''),i.WBS17),isnull(nullif(d.WBS18,''),i.WBS18),isnull(nullif(d.WBS19,''),i.WBS19),isnull(nullif(d.WBS20,''),i.WBS20)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS21,''),i.WBS21),isnull(nullif(d.WBS22,''),i.WBS22),isnull(nullif(d.WBS23,''),i.WBS23),isnull(nullif(d.WBS24,''),i.WBS24),isnull(nullif(d.WBS25,''),i.WBS25)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS26,''),i.WBS26),isnull(nullif(d.WBS27,''),i.WBS27),isnull(nullif(d.WBS28,''),i.WBS28),isnull(nullif(d.WBS29,''),i.WBS29),isnull(nullif(d.WBS30,''),i.WBS30)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS31,''),i.WBS31),isnull(nullif(d.WBS32,''),i.WBS32),isnull(nullif(d.WBS33,''),i.WBS33),isnull(nullif(d.WBS34,''),i.WBS34),isnull(nullif(d.WBS35,''),i.WBS35)" & vbCrLf
    s = s & "  ,isnull(nullif(d.WBS36,''),i.WBS36),isnull(nullif(d.WBS37,''),i.WBS37),isnull(nullif(d.WBS38,''),i.WBS38),isnull(nullif(d.WBS39,''),i.WBS39),isnull(nullif(d.WBS40,''),i.WBS40)" & vbCrLf
    s = s & "              FROM EstimateAssemblies   e" & vbCrLf
    s = s & "                  ,tblSalesSheetDetails f" & vbCrLf
    s = s & "                  ,system_setup         s" & vbCrLf
    s = s & "                  ,tblSalesSheetCosts   d" & vbCrLf
    s = s & "              LEFT OUTER JOIN CommunityStandards cs ON(cs.Community=@Community AND cs.CommunityPhase=dbo.Purch_GetCommunityStandardPhase(@Community,@CommunityPhase,d.phase,d.Item) AND cs.StdPhase=d.Phase AND cs.StdItem=d.Item)" & vbCrLf
    s = s & "              JOIN tblphaseitem i on(i.DivisionID = @DivisionID and i.phase=isnull(cs.phase,d.phase) and i.item=isnull(cs.item,d.item))" & vbCrLf
    s = s & "              LEFT OUTER JOIN tblPOIndex p ON(p.DivisionID = @DivisionID and isnull(nullif(d.POIndex,''),isnull(i.POIndex,''))=p.POIndex)" & vbCrLf
    s = s & "              LEFT OUTER JOIN appoptions o on(o.optionname='UseAltCostCodesForCO' and o.DivisionID = @DivisionID)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "             WHERE s.ID = @DivisionID and e.EstAssemblyID = @EstAssemblyID" & vbCrLf
    s = s & "               AND e.Assembly = d.Assembly" & vbCrLf
    s = s & "               AND (ISNULL(d.Model,'') = CASE WHEN (e.AssemblyType=3 OR e.AssemblyType=4) THEN '' ELSE e.Model END)" & vbCrLf
    s = s & "               AND e.OptionID = d.OptionID" & vbCrLf
    s = s & "               AND d.Community = dbo.Purch_GetAssemblySalesSheetCommunity(e.salesworksheet,e.Assembly,CASE WHEN (e.AssemblyType=3 OR e.AssemblyType=4) THEN '' ELSE e.Model END,e.OptionID,@Community)" & vbCrLf
    s = s & "               AND (d.OrderQty<>0 OR d.TakeoffQty<>0)" & vbCrLf
    s = s & "               AND d.Worksheet = @SalesWorkSheet" & vbCrLf
    s = s & "               AND e.Assembly = f.Assembly" & vbCrLf
    s = s & "               AND (ISNULL(f.Model,'') = CASE WHEN (e.AssemblyType=3 OR e.AssemblyType=4) THEN '' ELSE e.Model END)" & vbCrLf
    s = s & "               AND e.OptionID = f.OptionID" & vbCrLf
    s = s & "               and f.communityphase=d.communityphase" & vbCrLf
    s = s & "               AND f.Communityphase = dbo.Purch_GetAssemblySalesSheetCommunityPhase(e.salesworksheet,e.Assembly,CASE WHEN (e.AssemblyType=3 OR e.AssemblyType=4) THEN '' ELSE e.Model END,e.OptionID,@Community,@communityphase)" & vbCrLf
    s = s & "               AND f.Community = d.Community " & vbCrLf
    s = s & "               AND f.Worksheet = @SalesWorkSheet" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "            IF @@ROWCOUNT<>0 UPDATE EstimateAssemblies SET EstimateComplete=1 WHERE EstAssemblyID=@EstAssemblyID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        END ELSE BEGIN" & vbCrLf
    s = s & "            ------------------------------------------------------------------------" & vbCrLf
    s = s & "            -- add the items that DONT come from a SalesWorksheet" & vbCrLf
    s = s & "            ------------------------------------------------------------------------" & vbCrLf
    s = s & "            INSERT INTO EstimateItems(DivisionID,EstAssemblyID, POIndex, Phase, Item, Sequence, Job, JCExtra, JCCostCode, JCCategory, SortOrder, Description, Comments, TakeoffQty, TakeoffUOM, ConversionFactor, OrderUOM, BudgetVendor, BudgetQty, BudgetRate, ExcludeFromPO,[Model],[Assembly],Location,WBS01,WBS02,WBS03,WBS04,WBS05,WBS06,WBS07,WBS08,WBS09,WBS10,WBS11,WBS12,WBS13,WBS14,WBS15,WBS16,WBS17,WBS18,WBS19,WBS20,WBS21,WBS22,WBS23,WBS24,WBS25,WBS26,WBS27,WBS28,WBS29,WBS30,WBS31,WBS32,WBS33,WBS34,WBS35,WBS36,WBS37,WBS38,WBS39,WBS40)" & vbCrLf
    s = s & "            ------- CUSTOM QUOTE ITEMS ---------------------- ---------------------- ---------------------- ----------------------" & vbCrLf
    s = s & "            SELECT @DivisionID,e.EstAssemblyID" & vbCrLf
