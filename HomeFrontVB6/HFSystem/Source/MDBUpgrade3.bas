    s = s & "      ((s.accounting_approve=1 AND c.approved=1) OR (s.accounting_approve=0 AND c.contract_assigned=1) OR s.PurchasingRequiresSalesApproval=0)" & vbCrLf
    s = s & "      )" & vbCrLf
    s = s & "    OR(" & vbCrLf
    s = s & "      c.home_selection <>'PreSale' AND " & vbCrLf
    s = s & "      isnull(c.sold_to_Customer,'')='' AND" & vbCrLf
    s = s & "      (isnull(x.optionvalue,'')<>'True' OR isnull(c.InventoryHomeApproved,0)=1)" & vbCrLf
    s = s & "      )" & vbCrLf
    s = s & "   )" & vbCrLf
    s = s & "and j.BuildProEnabled=1" & vbCrLf
    s = s & "and isnull(j.community,'')<>''" & vbCrLf
    sql c, s
    
c = "Correction to Profits CO totals"
    s = ""
    s = s & "ALTER PROCEDURE [dbo].[CalcCOMasterTotals](@CustID varchar(12)) AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "DECLARE @TotalTAX FLOAT" & vbCrLf
    s = s & "DECLARE @CONoComm FLOAT" & vbCrLf
    s = s & "DECLARE @IncludeTax BIT" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "DECLARE @DelAPExempt FLOAT" & vbCrLf
    s = s & "DECLARE @DelPDExempt FLOAT" & vbCrLf
    s = s & "DECLARE @ChangeOrderPDPrice FLOAT" & vbCrLf
    s = s & "DECLARE @ChangeOrderAPPrice FLOAT" & vbCrLf
    s = s & "DECLARE @COTotalTAX FLOAT" & vbCrLf
    s = s & "DECLARE @CONotTaxed FLOAT" & vbCrLf
    s = s & "DECLARE @COTotalTaxExempt FLOAT" & vbCrLf
    s = s & "DECLARE @GSTRebateExempt FLOAT" & vbCrLf
    s = s & "DECLARE @ExemptIncentives FLOAT" & vbCrLf
    s = s & "DECLARE @Exempt FLOAT" & vbCrLf
    s = s & "DECLARE @NotExempt FLOAT" & vbCrLf
    s = s & "DECLARE @Incentive FLOAT" & vbCrLf
    s = s & "DECLARE @TotalIncentives FLOAT" & vbCrLf
    s = s & "DECLARE @Show_CDN_GST BIT" & vbCrLf
    s = s & "DECLARE @UsePST BIT" & vbCrLf
    s = s & "DECLARE @TotalExempt FLOAT" & vbCrLf
    s = s & "DECLARE @COAPGSTExempt FLOAT" & vbCrLf
    s = s & "DECLARE @COPDGSTExempt FLOAT" & vbCrLf
    s = s & "DECLARE @GST_Rate FLOAT" & vbCrLf
    s = s & "DECLARE @PST_RATE FLOAT" & vbCrLf
    s = s & "DECLARE @gstonexempt FLOAT" & vbCrLf
    s = s & "DECLARE @pstonexempt FLOAT" & vbCrLf
    s = s & "DECLARE @DivisionID INT" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "SET @DivisionID = (Select DivisionID from tblCustomers where Customer_No = @CustID)" & vbCrLf
    s = s & "DECLARE SystemSettings CURSOR FOR" & vbCrLf
    s = s & "SELECT includetax,Show_CDN_GST,UsePST FROM system_setup where ID = @DivisionID" & vbCrLf
    s = s & "OPEN SystemSettings" & vbCrLf
    s = s & "FETCH FROM SystemSettings INTO @IncludeTax,@Show_CDN_GST,@UsePST" & vbCrLf
    s = s & "CLOSE SystemSettings" & vbCrLf
    s = s & "DEALLOCATE SystemSettings" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "DECLARE CustomerValues CURSOR FOR" & vbCrLf
    s = s & "SELECT isnull(GST_Rate,0),isnull(PST_Rate,0) from tblcustomers where customer_no=@CustID" & vbCrLf
    s = s & "OPEN CustomerValues " & vbCrLf
    s = s & "FETCH FROM CustomerValues INTO @GST_Rate,@PST_Rate" & vbCrLf
    s = s & "CLOSE CustomerValues " & vbCrLf
    s = s & "DEALLOCATE CustomerValues " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "DECLARE ExemptValues CURSOR FOR" & vbCrLf
    s = s & "SELECT isnull(sum(CASE WHEN isnull(ContractExempt,0) = 1 AND isnull( ApplyIncentive,0)=1 THEN isnull(Override_Price,0) else 0 end),0) as Exempt " & vbCrLf
    s = s & ",isnull(sum(case when isnull(ContractExempt,0)= 0 and isnull(ApplyIncentive,0) = 1 then isnull(Override_Price,0) else 0 end),0) as NotExempt" & vbCrLf
    s = s & ",isnull(sum(isnull(IncentiveValue,0)),0) as Incentive  " & vbCrLf
    s = s & "from calcapplyincentives where customer_no =@CustID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "OPEN ExemptValues" & vbCrLf
    s = s & "FETCH FROM ExemptValues INTO @Exempt,@NotExempt,@Incentive" & vbCrLf
    s = s & "CLOSE ExemptValues" & vbCrLf
    s = s & "DEALLOCATE ExemptValues" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "SET @COTotalTAX =0" & vbCrLf
    s = s & "SET @CONotTaxed=0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--If there is a record returned from the above select statement then" & vbCrLf
    s = s & "SET @TotalIncentives = isnull((SELECT isnull(ModelIncentive,0) FROM tblCustomers WHERE Customer_No = @CustID),0)+@Incentive" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "if (@TotalIncentives < @Exempt) " & vbCrLf
    s = s & "   SET @ExemptIncentives = @TotalIncentives " & vbCrLf
    s = s & "else" & vbCrLf
    s = s & "   SET @ExemptIncentives= @Exempt" & vbCrLf
    s = s & "SET @Totalexempt  = isnull((SELECT isnull(COAPEXEMPT,0) + isnull(COPDEXEMPT,0) from tblcustomers where customer_no = @CUSTID),0)" & vbCrLf
    s = s & "SET @TotalExempt = isnull(@TotalExempt,0)-@ExemptIncentives " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "SET @DelAPExempt = isnull((SELECT sum(isnull(ContractExemptValue,0)) from DeletedItemsMaster where Customer_No = @CustID and Bldr_Approved= 1 and Declined= 0),0)" & vbCrLf
    s = s & "SET @DelPDExempt = isnull((SELECT sum(isnull(ContractExemptValue,0)) from DeletedItemsMaster where Customer_No = @CustID and Bldr_Approved= 0 and Declined= 0),0)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "If @IncludeTAX = 1 BEGIN" & vbCrLf
    s = s & "   SET @COTotalTAX= isnull((SELECT sum(isnull(SumOfNetTAX,0)) from ChangeOrderMaster where Customer_No = @CustID and Declined= 0),0)" & vbCrLf
    s = s & "   SET @COTotalTaxExempt = isnull((SELECT sum(isnull(SumOfNetTAX,0)) from ChangeOrderMaster where Customer_No = @CustID and Declined= 0 and ContractExempt=1 ),0)" & vbCrLf
    s = s & "   SET @CONotTaxed = isnull((SELECT sum(isnull(NotTaxedTotal,0)) from ChangeOrderMaster where Customer_No = @CustID and Declined= 0),0)" & vbCrLf
    s = s & "End" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "SET @COAPGSTExempt = isnull((SELECT sum(isnull(total_price,0)+isnull(chargedfee,0)) from ChangeOrderMaster where Customer_No = @CustID and Bldr_Approved = 1 and Declined= 0 and ContractExempt = 1),0)" & vbCrLf
    s = s & "SET @COPDGSTExempt = isnull((SELECT sum(isnull(total_price,0)+isnull(chargedfee,0)) from ChangeOrderMaster where Customer_No = @CustID and Bldr_Approved =0 and Declined= 0 and ContractExempt = 1),0)" & vbCrLf
    s = s & "SET @ChangeOrderAPPrice = isnull((SELECT sum(isnull(total_price,0)+isnull(chargedfee,0)) from ChangeOrderMaster where Customer_No = @CustID and Bldr_Approved = 1 and Declined= 0),0)-  @COAPGSTExempt" & vbCrLf
    s = s & "SET @ChangeOrderPDPrice =  isnull((SELECT sum(isnull(total_price,0)+isnull(chargedfee,0)) from ChangeOrderMaster where Customer_No = @CustID and Bldr_Approved = 0 and Declined= 0),0)- @COPDGSTExempt" & vbCrLf
    s = s & "SET @CONoComm = isnull((SELECT sum(isnull(nocommtotal,0)) from ChangeOrderMaster where Customer_No = @CustID and Declined= 0),0)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "SET @GSTRebateExempt = isnull((SELECT Sum(ISNULL(override_price,0)) as TotalGSTRebateExempt from ChangeOrderDetails where Customer_No=@CUSTID and gstrebate_exempt =1),0)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "IF @Show_CDN_GST = 1 BEGIN" & vbCrLf
    s = s & "       SET @gstonexempt = Round(ISNULL(@totalexempt,0) * isnull(@GST_Rate,0) / 100, 2)" & vbCrLf
    s = s & "        If @UsePST = 1 BEGIN" & vbCrLf
    s = s & "            SET @pstonexempt = Round(isnull(@totalexempt,0) * isnull(@pst_rate,0) / 100, 2)" & vbCrLf
    s = s & "        End " & vbCrLf
    s = s & "END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "UPDATE tblcustomers set CONETTAX=isnull(@COTotalTAX,0) -isnull( @COTotalTaxExempt,0),CO_COMM=@CONoComm ,gstrebate_exempt=@GSTRebateExempt ,CO_PD_Total =@ChangeOrderPDPrice,CO_AP_Total =@ChangeOrderAPPrice,CoNotTaxed=isnull(@CONotTaxed,0)," & vbCrLf
    s = s & "COAPExempt = @COAPGSTExempt+@DelAPExempt,COPDExempt = @COPDGSTExempt+@DelPDExempt,TotalExempt=@COAPGSTExempt + @DelAPExempt+@COPDGSTExempt + @DelPDExempt-@ExemptIncentives where customer_no = @CustID" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s

c = "Add appoption for taxgroup required to invoice validation"
    s = ""
    s = s & "alter view dbo.InvoiceValidationErrors as" & vbCrLf
    s = s & "select " & vbCrLf
    s = s & "   i.divisionid" & vbCrLf
    s = s & "  ,i.invoiceid" & vbCrLf
    s = s & "  ,i.vendor" & vbCrLf
    s = s & "  ,i.vendorname" & vbCrLf
    s = s & "  ,i.invoice" & vbCrLf
    s = s & "  ,d.itemid" & vbCrLf
    s = s & "" & vbCrLf
    s = s & ",cast(case when ((select count(*) from invoiceitems where invoiceid=i.invoiceid)<1) then 1 else 0 end as bit) NoLines" & vbCrLf
    s = s & ",cast(case when ((select round(sum(pretax),2) from invoiceitems where invoiceid=i.invoiceid)<>round(i.pretax,2)) then 1 else 0 end as bit) PretaxDoesntBalance" & vbCrLf
    s = s & ",cast(case when ((select round(sum(tax),2) from invoiceitems where invoiceid=i.invoiceid)<>round(i.tax,2)) then 1 else 0 end as bit) TaxDoesntBalance" & vbCrLf
    s = s & ",cast(case when (isnull(d.job,'')<>'' or isnull(d.debitaccount,'')<>'') then 0 else 1 end as bit) JobOrAcctNeeded" & vbCrLf
    s = s & ",cast(case when (ao.optionvalue='4' and isnull(d.debitaccount,'')='') then 1 else 0 end as bit) AcctNeeded" & vbCrLf
    s = s & ",cast(case when (isnull(d.job,'')<>'' and (isnull(d.phase,'')='' or isnull(d.category,'')='')) then 1 else 0 end as bit) CCAndCatNeeded" & vbCrLf
    s = s & ",cast(case when (isnull(d.commitment,'')<>'' and pi.po is null) then 1 else 0 end as bit) BadPO" & vbCrLf
    s = s & ",cast(case when (isnull(d.job,'')<>'' and j.job_no is null) then 1 else 0 end as bit) BadJob" & vbCrLf
    s = s & ",cast(case when (isnull(d.phase,'')<>'' and cc.costcode is null) then 1 else 0 end as bit) BadCostCode" & vbCrLf
    s = s & ",cast(case when (isnull(d.category,'')<>'' and c.category is null) then 1 else 0 end as bit) BadCategory" & vbCrLf
    s = s & ",cast(case when ((isnull(d.tax,0)<>0 or isnull(d.taxgroup,'')<>'') and g.taxgroup is null and tgr.optionvalue<>'False') then 1 else 0 end as bit) BadTaxgroup" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "from invoices i" & vbCrLf
    s = s & "left outer join invoiceitems d on i.invoiceid=d.invoiceid" & vbCrLf
    s = s & "left outer join tbljobs j on d.divisionid=j.divisionid and d.job=j.job_no" & vbCrLf
    s = s & "left outer join standardcostcodes cc on d.divisionid=cc.divisionid and d.phase=cc.costcode" & vbCrLf
    s = s & "left outer join standardcategories c on d.divisionid=c.divisionid and d.category=c.category" & vbCrLf
    s = s & "left outer join TaxGroups g on d.divisionid=g.divisionid and d.taxgroup=g.taxgroup" & vbCrLf
    s = s & "left outer join jcpodetails pi on d.divisionid=pi.divisionid and d.commitment=pi.po and d.commitmentitem=pi.line" & vbCrLf
    s = s & "left outer join appoptions ao on d.divisionid=ao.divisionid and ao.optionname='AccountingSystem'" & vbCrLf
    s = s & "left outer join appoptions tgr on d.divisionid=tgr.divisionid and tgr.optionname='TaxGroupRequired'" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "where" & vbCrLf
    s = s & "    case when ((select count(*) from invoiceitems where invoiceid=i.invoiceid)<1) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when ((select round(sum(pretax),2) from invoiceitems where invoiceid=i.invoiceid)<>round(i.pretax,2)) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when ((select round(sum(tax),2) from invoiceitems where invoiceid=i.invoiceid)<>round(i.tax,2)) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when (isnull(d.job,'')<>'' or isnull(d.debitaccount,'')<>'') then 0 else 1 end =1" & vbCrLf
    s = s & "or case when (ao.optionvalue='4' and isnull(d.debitaccount,'')='') then 1 else 0 end =1" & vbCrLf
    s = s & "or case when (isnull(d.job,'')<>'' and (isnull(d.phase,'')='' or isnull(d.category,'')='')) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when (isnull(d.commitment,'')<>'' and pi.po is null) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when (isnull(d.job,'')<>'' and j.job_no is null) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when (isnull(d.phase,'')<>'' and cc.costcode is null) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when (isnull(d.category,'')<>'' and c.category is null) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when ((isnull(d.tax,0)<>0 or isnull(d.taxgroup,'')<>'') and g.taxgroup is null) then 1 else 0 end =1" & vbCrLf
    sql c, s


    s = ""
    s = s & "alter PROCEDURE [dbo].[Intacct_SetPOItemIDs] @DivisionID integer, @xmlString varchar(max) as" & vbCrLf
