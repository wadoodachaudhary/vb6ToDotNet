    s = s & "                  ,i.[Assembly]" & vbCrLf
    s = s & "                  ,i.RoomLocation,i.WBS01,i.WBS02,i.WBS03,i.WBS04,i.WBS05,i.WBS06,i.WBS07,i.WBS08,i.WBS09,i.WBS10,i.WBS11,i.WBS12,i.WBS13,i.WBS14,i.WBS15,i.WBS16,i.WBS17,i.WBS18,i.WBS19,i.WBS20" & vbCrLf
    s = s & "                  ,i.WBS21,i.WBS22,i.WBS23,i.WBS24,i.WBS25,i.WBS26,i.WBS27,i.WBS28,i.WBS29,i.WBS30,i.WBS31,i.WBS32,i.WBS33,i.WBS34,i.WBS35,i.WBS36,i.WBS37,i.WBS38,i.WBS39,i.WBS40" & vbCrLf
    s = s & "              FROM estimateassemblies e" & vbCrLf
    s = s & "                   JOIN CustomPreEstimateItems i ON(e.customer_no=i.customerNo AND e.hflocation=i.location AND e.seq=i.seq)" & vbCrLf
    s = s & "                 " & vbCrLf
    s = s & "             WHERE e.Customer_No = @Customer_No" & vbCrLf
    s = s & "               AND e.EstAssemblyID = @EstAssemblyID" & vbCrLf
    s = s & "            UNION ALL" & vbCrLf
    s = s & "            ------- ASSEMBLY ITEMS ---------------------- ---------------------- ---------------------- ----------------------" & vbCrLf
    s = s & "            SELECT @DivisionID,e.EstAssemblyID" & vbCrLf
    s = s & "                  ,isnull(nullif(d.POIndex,''),isnull(i.POIndex,''))" & vbCrLf
    s = s & "                  ,i.Phase" & vbCrLf
    s = s & "                  ,i.Item" & vbCrLf
    s = s & "                  ,d.sequence" & vbCrLf
    s = s & "                  ,e.Job" & vbCrLf
    s = s & "                  ,e.JCExtra" & vbCrLf
    s = s & "                  ,isnull(nullif(case when e.assemblytype=0 or o.OptionName<>'true' then i.jccostcode else isnull(nullif(i.altjccostcode,''),i.jccostcode) end ,''),p.jccostcode)" & vbCrLf
    s = s & "                  ,isnull(nullif(@jccategory,''),isnull(nullif(case when e.assemblytype=0 or o.OptionName<>'true' then i.jccategory else isnull(nullif(i.altjccategory,''),i.jccategory) end ,''),p.jccategory))" & vbCrLf
    s = s & "                  ,d.Sequence SortOrder" & vbCrLf
    s = s & "                  ,i.Description" & vbCrLf
    s = s & "                  ,isnull(nullif(d.notes,''),i.notes) Comments" & vbCrLf
    s = s & "                  ,CASE WHEN ISNULL(a.UseNormalSalesQtyFactors,0)=1 THEN (e.SalesQty * d.TakeoffQty) WHEN UPPER(e.AssemblyUOM)=UPPER(i.TakeoffUOM) THEN (e.SalesQty * d.TakeoffQty) WHEN UPPER(e.AssemblyUOM)=UPPER(i.OrderUOM) THEN (e.SalesQty * d.OrderQty / isnull(nullif(d.conversionfactor,0),i.ConversionFactor)) WHEN e.SalesQty < 0 THEN d.TakeoffQty * -1 ELSE d.TakeoffQty END TakeoffQty" & vbCrLf
    s = s & "                  ,i.TakeoffUOM" & vbCrLf
    s = s & "                  ,isnull(nullif(d.conversionfactor,0),i.ConversionFactor)" & vbCrLf
    s = s & "                  ,i.OrderUOM" & vbCrLf
    s = s & "                  ,dbo.Purch_GetCommunityVendor(@Community,p.POIndex,@DivisionID)  BudgetVendor" & vbCrLf
    s = s & "                  ,CASE WHEN ISNULL(a.UseNormalSalesQtyFactors,0)=1 THEN (e.SalesQty * d.OrderQty) WHEN UPPER(e.AssemblyUOM)=UPPER(i.OrderUOM) THEN (e.SalesQty * d.OrderQty) WHEN UPPER(e.AssemblyUOM)=UPPER(i.TakeoffUOM) THEN (e.SalesQty * d.TakeoffQty * isnull(nullif(d.conversionfactor,0),i.ConversionFactor)) WHEN e.SalesQty < 0 THEN d.OrderQty * -1 ELSE d.OrderQty END BudgetQty" & vbCrLf
    s = s & "                  ,ISNULL(dbo.Purch_GetItemRate(0,0,@Community,@CommunityPhase,d.Assembly,d.Model,d.OptionID,i.Phase,i.Item,d.sequence,dbo.Purch_GetCommunityVendor(@Community,p.POIndex,@DivisionID),GETDATE(),@DivisionID),0)" & vbCrLf
    s = s & "                  ,0 ExcludeFromPO" & vbCrLf
    s = s & "                 ,e.[Model]" & vbCrLf
    s = s & "                  ,e.Assembly" & vbCrLf
    s = s & "                  ,isnull(nullif(d.Location,''),i.Location)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS01,''),i.WBS01),isnull(nullif(d.WBS02,''),i.WBS02),isnull(nullif(d.WBS03,''),i.WBS03),isnull(nullif(d.WBS04,''),i.WBS04),isnull(nullif(d.WBS05,''),i.WBS05)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS06,''),i.WBS06),isnull(nullif(d.WBS07,''),i.WBS07),isnull(nullif(d.WBS08,''),i.WBS08),isnull(nullif(d.WBS09,''),i.WBS09),isnull(nullif(d.WBS10,''),i.WBS10)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS11,''),i.WBS11),isnull(nullif(d.WBS12,''),i.WBS12),isnull(nullif(d.WBS13,''),i.WBS13),isnull(nullif(d.WBS14,''),i.WBS14),isnull(nullif(d.WBS15,''),i.WBS15)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS16,''),i.WBS16),isnull(nullif(d.WBS17,''),i.WBS17),isnull(nullif(d.WBS18,''),i.WBS18),isnull(nullif(d.WBS19,''),i.WBS19),isnull(nullif(d.WBS20,''),i.WBS20)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS21,''),i.WBS21),isnull(nullif(d.WBS22,''),i.WBS22),isnull(nullif(d.WBS23,''),i.WBS23),isnull(nullif(d.WBS24,''),i.WBS24),isnull(nullif(d.WBS25,''),i.WBS25)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS26,''),i.WBS26),isnull(nullif(d.WBS27,''),i.WBS27),isnull(nullif(d.WBS28,''),i.WBS28),isnull(nullif(d.WBS29,''),i.WBS29),isnull(nullif(d.WBS30,''),i.WBS30)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS31,''),i.WBS31),isnull(nullif(d.WBS32,''),i.WBS32),isnull(nullif(d.WBS33,''),i.WBS33),isnull(nullif(d.WBS34,''),i.WBS34),isnull(nullif(d.WBS35,''),i.WBS35)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS36,''),i.WBS36),isnull(nullif(d.WBS37,''),i.WBS37),isnull(nullif(d.WBS38,''),i.WBS38),isnull(nullif(d.WBS39,''),i.WBS39),isnull(nullif(d.WBS40,''),i.WBS40)" & vbCrLf
    s = s & "              FROM EstimateAssemblies e" & vbCrLf
    s = s & "              JOIN tblDBAssemblyMaster a on (a.DivisionID = @DivisionID and e.Assembly = a.Assembly  AND a.Community = dbo.Purch_GetAssemblyCommunity(@Assembly,CASE WHEN (a.AssemblyType=3 OR a.AssemblyType=4) THEN '' ELSE e.Model END,@optionid,@Community,@DivisionID)  AND (ISNULL(a.Model,'') = CASE WHEN (a.AssemblyType=3 OR a.AssemblyType=4) THEN '' ELSE e.Model END)  AND e.OptionID = a.OptionID)" & vbCrLf
    s = s & "              JOIN tblDBAssemblyDetails d on (a.DivisionID = d.DivisionID and a.Assembly = d.Assembly  AND a.Model = d.Model  AND a.OptionID = d.OptionID  AND a.Community = d.Community)" & vbCrLf
    s = s & "              LEFT OUTER JOIN CommunityStandards cs ON(cs.Community=@Community AND cs.CommunityPhase=dbo.Purch_GetCommunityStandardPhase(@Community,@CommunityPhase,d.phase,d.Item) AND cs.StdPhase=d.Phase AND cs.StdItem=d.Item)" & vbCrLf
    s = s & "              JOIN tblphaseitem i on(i.DivisionID = @DivisionID and i.phase=isnull(cs.phase,d.phase) and i.item=isnull(cs.item,d.item))" & vbCrLf
