    s = s & "   SELECT i.DivisionID,i.PONumber,i.RequestDetailID,i.Description,i.Description,i.Comments,i.POQty,i.takeoffqty,i.PORate,i.POPretax,i.POTaxGroup,i.PONJCTaxRate,i.POJCTaxRate,i.PONJCTax,i.POJCTax,i.job,i.jcextra,i.JCCostCode,i.JCCategory,'',i.EstItemID,i.OrderUOM,i.takeoffuom" & vbCrLf
    s = s & "   from estimateitems i " & vbCrLf
