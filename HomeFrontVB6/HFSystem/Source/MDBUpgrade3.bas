    s = s & "            INSERT INTO EstimateItems(DivisionID,EstAssemblyID, POIndex, Phase, Item, Job, JCExtra, JCCostCode, JCCategory, SortOrder, Description, Comments, TakeoffQty, TakeoffUOM, ConversionFactor, OrderUOM, BudgetVendor, BudgetQty, BudgetRate, ExcludeFromPO,Assembly" & vbCrLf
