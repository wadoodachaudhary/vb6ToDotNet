    s = s & "        )" & vbCrLf
    s = s & "        GROUP BY dd.invoiceid" & vbCrLf
    s = s & "        HAVING COUNT(DISTINCT dd.commitment)>1" & vbCrLf
    s = s & "    )" & vbCrLf
    s = s & "END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "IF UPDATE(PayPoint1ApprovedDate) BEGIN" & vbCrLf
