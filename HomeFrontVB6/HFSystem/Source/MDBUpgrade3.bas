    s = s & "                               WHEN 'Item2' THEN d.IncludedInSpec2" & vbCrLf
    s = s & "                               WHEN 'Item3' THEN d.IncludedInSpec3" & vbCrLf
    s = s & "                               WHEN 'Item4' THEN d.IncludedInSpec4" & vbCrLf
    s = s & "                               WHEN 'Item5' THEN d.IncludedInSpec5" & vbCrLf
    s = s & "                               WHEN 'Item6' THEN d.IncludedInSpec6" & vbCrLf
    s = s & "                               WHEN 'Item7' THEN d.IncludedInSpec7" & vbCrLf
    s = s & "                               WHEN 'Item8' THEN d.IncludedInSpec8" & vbCrLf
