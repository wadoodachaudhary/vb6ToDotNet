    s = s & "                  ,d.sequence" & vbCrLf
    s = s & "                  ,e.Job" & vbCrLf
    s = s & "                  ,e.JCExtra" & vbCrLf
    s = s & "                  ,isnull(nullif(case when e.assemblytype=0 or o.OptionName<>'true' then i.jccostcode else isnull(nullif(i.altjccostcode,''),i.jccostcode) end ,''),p.jccostcode)" & vbCrLf
