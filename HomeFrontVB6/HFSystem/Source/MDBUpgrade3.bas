    s = s & "-- load xml into staging --------------" & vbCrLf
    s = s & "insert ImportedBIMItemDB(SessionID,DivisionID,UserID,Phase,PhaseName,ProductID,Accuracy,Description,Name,Notes,UOM,RoundingRule,Waste)" & vbCrLf
    s = s & "select " & vbCrLf
