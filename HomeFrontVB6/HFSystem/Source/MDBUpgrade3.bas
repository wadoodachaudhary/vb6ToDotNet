    s = s & "" & vbCrLf
    s = s & "    fetch next from c into @EPOid, @JobNo, @POIndex" & vbCrLf
    s = s & "end" & vbCrLf
    s = s & "close c" & vbCrLf
    s = s & "deallocate c" & vbCrLf
    sql c, s
    
