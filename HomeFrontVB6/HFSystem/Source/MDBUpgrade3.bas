    s = ""
    s = s & "ALTER FUNCTION dbo.BuildProSOAP_HFJob(@DivisionID int, @BPJob varchar(23)) RETURNS varchar(12)" & vbCrLf
    s = s & "Begin " & vbCrLf
    s = s & "  --- optionally extract job number from a concatenated BuildPro job number " & vbCrLf
    s = s & "  RETURN(" & vbCrLf
    s = s & "    select case when multifamily=1 and buildpromultifamily=1 " & vbCrLf
