    s = s & "        SELECT  @InboxBatchID,@DivisionID,Customer_No, @EstIndex, 0, Model,'', ModelDesc, 0, 1, ElevationAssembly, Job, 1, ElevationPrice, ElevSalesWorkSheet,JCExtra" & vbCrLf
