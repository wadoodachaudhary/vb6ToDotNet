    s = s & "ALTER TRIGGER [dbo].[POMaster_CreateInvoice] ON [dbo].[POMaster] AFTER UPDATE AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "declare @InvoiceID as int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- weird performance tweak. cache DivID and using it in joins makes things faster." & vbCrLf
    s = s & "declare @DivID as int" & vbCrLf
    s = s & "select top 1 @DivID=divisionid from inserted" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "IF UPDATE(ApprovedDate) BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    -- move to approved, any held invoices that reference ONLY this po" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "    SET status='Approved',Approver='AutoApproved',DateApproved=getdate()" & vbCrLf
    s = s & "    FROM invoices i" & vbCrLf
    s = s & "    JOIN AppOptions ao1 ON(ao1.OptionName='AutoReleaseHeldPOInvoices' and ao1.OptionValue='True' AND ao1.DivisionID = @DivID)     " & vbCrLf
    s = s & "    JOIN AppOptions ao2 ON(ao2.OptionName='SchedulingUsage' and ao2.OptionValue='3' AND ao2.DivisionID = @DivID)     " & vbCrLf
    s = s & "    WHERE i.status='Hold'" & vbCrLf
    s = s & "    AND invoiceid in(" & vbCrLf
    s = s & "        SELECT dd.invoiceid" & vbCrLf
    s = s & "        FROM invoiceitems dd" & vbCrLf
    s = s & "        WHERE invoiceid in(" & vbCrLf
    s = s & "            SELECT distinct d.invoiceid " & vbCrLf
    s = s & "            FROM InvoiceItems d" & vbCrLf
    s = s & "            JOIN INSERTED p on d.DivisionID=p.DivisionID and d.Vendor=p.Vendor and d.commitment=p.PONumber" & vbCrLf
    s = s & "        )" & vbCrLf
    s = s & "        GROUP BY dd.invoiceid" & vbCrLf
    s = s & "        HAVING COUNT(DISTINCT dd.commitment)=1" & vbCrLf
    s = s & "    )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    -- move to pending, any held invoices that reference something other than just this po" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "    SET status='Pending'" & vbCrLf
    s = s & "    FROM invoices i" & vbCrLf
    s = s & "    JOIN AppOptions ao1 ON(ao1.OptionName='AutoReleaseHeldPOInvoices' and ao1.OptionValue='True' AND ao1.DivisionID = @DivID)     " & vbCrLf
    s = s & "    JOIN AppOptions ao2 ON(ao2.OptionName='SchedulingUsage' and ao2.OptionValue='3' AND ao2.DivisionID = @DivID)     " & vbCrLf
    s = s & "    WHERE i.status='Hold' and i.Approver<>''" & vbCrLf
    s = s & "    AND invoiceid in(" & vbCrLf
    s = s & "        SELECT dd.invoiceid" & vbCrLf
