    s = s & "SET @SessionID = NEWID() " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "--  insert data to temp table " & vbCrLf
    s = s & "------------------------------------------------------------------------" & vbCrLf
    s = s & "insert ImportedBIMJobBOM(SessionID,DivisionID,job,ismodel,estassemblyid,optionid,optiondesc,poindex,partnumber,itemdesc,qty,uom,notes)" & vbCrLf
    s = s & "SELECT" & vbCrLf
    s = s & "/* case " & vbCrLf
    s = s & "   when optionid=1 then 'base' " & vbCrLf
    s = s & "   when customoptionid<>0 then 'custom option'" & vbCrLf
    s = s & "   when optionid=0 and customoptionid=0 then 'custom materials' " & vbCrLf
    s = s & "   else 'standard option'" & vbCrLf
    s = s & "   end RecordType, */" & vbCrLf
    s = s & "" & vbCrLf
    s = s & " @SessionID,@DivisionID" & vbCrLf
    s = s & ",Job" & vbCrLf
    s = s & ",case when optionid=1 then 1 else 0 end IsModel" & vbCrLf
    s = s & ",case when CustomOptionID<>'0' then replace(CustomOptionNumber,'CUSTOM','') else null end EstAssemblyID" & vbCrLf
    s = s & ",case when CustomOptionID<>'0' then 'CUSTOM' else OptionNumber end OptionID" & vbCrLf
    s = s & ",case " & vbCrLf
    s = s & "   when optionid=1 then OptionDesc" & vbCrLf
    s = s & "   when customoptionid<>0 then CustomOptionDesc" & vbCrLf
    s = s & "   when optionid=0 and customoptionid=0 then 'Custom Materials' " & vbCrLf
    s = s & "   else OptionDesc" & vbCrLf
    s = s & "   end OptionDesc" & vbCrLf
    s = s & ",POIndex" & vbCrLf
    s = s & ",case when stylename='BID'" & vbCrLf
    s = s & "   then replace(reverse(left(reverse(productname),charindex('',reverse(productname),charindex('',reverse(productname))+1))),'','')+'-'+itemcode" & vbCrLf
    s = s & "   else phasecode+'-'+itemcode end PartNumber" & vbCrLf
