    s = ""
    s = s & "ALTER PROCEDURE [dbo].[BuildProSOAP] @XmlString xml as" & vbCrLf
    s = s & "BEGIN TRY" & vbCrLf
    s = s & "    DECLARE @idoc int" & vbCrLf
    s = s & "    EXEC sp_xml_preparedocument @idoc OUTPUT, @XmlString, '<root xmlns:SOAP-ENV=""http://schemas.xmlsoap.org/soap/envelope/"" xmlns:SOAP-ENC=""http://schemas.xmlsoap.org/soap/encoding/"" xmlns:xsd=""http://www.w3.org/1999/XMLSchema"" xmlns:xsi=""http://www.w3.org/1999/XMLSchema-instance"" SOAP-ENV:encodingStyle=""http://schemas.xmlsoap.org/soap/encoding/""  />'" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @uid varchar(10) = 'BuildPro'" & vbCrLf
    s = s & "    DECLARE @DivisionID int" & vbCrLf
    s = s & "    DECLARE @FileName varchar(1000) -- third segment is divisioncode IE 0001" & vbCrLf
    s = s & "                                    --  eg: JDEOW_LineItem_0001_2019052909500444.xml" & vbCrLf
    s = s & "    DECLARE @DoPOComplete bit" & vbCrLf
    s = s & "    DECLARE @DoEPO bit" & vbCrLf
    s = s & "    DECLARE @DoMilestone bit" & vbCrLf
    s = s & "    DECLARE @DoTbdVendor bit" & vbCrLf
    s = s & "    DECLARE @DoMPO bit" & vbCrLf
    s = s & "    DECLARE @DoBackCharge bit" & vbCrLf
    s = s & "    DECLARE @DoLienRelease bit" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- parse xml ----------------------------" & vbCrLf
    s = s & "    SELECT @FileName      = x.FileName" & vbCrLf
    s = s & "    FROM OPENXML (@idoc, 'SOAP-ENV:Envelope',2) " & vbCrLf
    s = s & "    WITH (FileName    varchar(1000) 'SOAP-ENV:Header/MH2SoapHeader/Properties/FileName'" & vbCrLf
    s = s & "         ) x" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    SELECT @DivisionID    = d.DivisionID" & vbCrLf
    s = s & "          ,@DoPOComplete  = case when nullif(x.POComplete,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoEPO         = case when nullif(x.EPO,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoMilestone   = case when nullif(x.Milestone,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoTbdVendor   = case when nullif(x.TbdVendor,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoMPO         = case when nullif(x.MPO,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoBackCharge  = case when nullif(x.BackCharge,'') is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@DoLienRelease = case when nullif(x.LienRelease,'') is null then 0 else 1 end" & vbCrLf
    s = s & "    FROM OPENXML (@idoc, 'SOAP-ENV:Envelope',2) " & vbCrLf
    s = s & "    WITH (FileName    varchar(1000) 'SOAP-ENV:Header/MH2SoapHeader/Properties/FileName'" & vbCrLf
    s = s & "         ,POComplete  varchar(100)  'SOAP-ENV:Body/JDEOW_LineItemCompletion'" & vbCrLf
    s = s & "         ,EPO         varchar(100)  'SOAP-ENV:Body/JDEOW_EPO'" & vbCrLf
    s = s & "         ,Milestone   varchar(100)  'SOAP-ENV:Body/JDEOW_MilestoneUpdate'" & vbCrLf
    s = s & "         ,TbdVendor   varchar(100)  'SOAP-ENV:Body/JDEOW_VendorOnTheFly'" & vbCrLf
    s = s & "         ,MPO         varchar(100)  'SOAP-ENV:Body/JDEOW_MPOExport'" & vbCrLf
    s = s & "         ,BackCharge  varchar(100)  'SOAP-ENV:Body/JDEOW_BackCharge'" & vbCrLf
    s = s & "         ,LienRelease varchar(100)  'SOAP-ENV:Body/JDEOW_LienExport'" & vbCrLf
    s = s & "         ) x" & vbCrLf
    s = s & "    JOIN Divisions d on d.DivisionCode = parsename(replace(replace(x.FileName,'.xml',''),'_','.'),2)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    if @DivisionID is null begin" & vbCrLf
    s = s & "        " & vbCrLf
    s = s & "        -- log request ----------------------------" & vbCrLf
    s = s & "        insert buildpro_requestlog(Status,DivisionID,UserID,FileName,Data)" & vbCrLf
    s = s & "        values('Error - Division not found',null,@uid,@FileName,cast(@XmlString as varchar(max)))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        select 300 Status, '** Division Not Found: **' + char(13) + char(10) + char(13) + char(10) + cast(@XmlString as varchar(max)) Response" & vbCrLf
    s = s & "        return" & vbCrLf
    s = s & "    end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- process request ----------------------------" & vbCrLf
    s = s & "    if @DoPOComplete=1  exec dbo.BuildProSOAP_DoPOComplete       @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    if @DoEPO=1         exec dbo.BuildProSOAP_DoEPO              @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    if @DoMilestone=1   exec dbo.BuildProSOAP_DoMilestoneUpdate  @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    if @DoTbdVendor=1   exec dbo.BuildProSOAP_DoTbdVendor        @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    if @DoMPO=1         exec dbo.BuildProSOAP_DoMPO              @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    if @DoBackCharge=1  exec dbo.BuildProSOAP_DoBackCharge       @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "    if @DoLienRelease=1 exec dbo.BuildProSOAP_DoLienRelease      @idoc, @DivisionID, @XmlString" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- log request ----------------------------" & vbCrLf
    s = s & "    insert buildpro_requestlog(Status,DivisionID,UserID,FileName,Data)" & vbCrLf
    s = s & "    values('Success',@DivisionID,@uid,@FileName,cast(@XmlString as varchar(max)))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- return status/response" & vbCrLf
    s = s & "    select 200 Status, 'OK' Response" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END TRY" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "BEGIN CATCH" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- log request--" & vbCrLf
    s = s & "    insert buildpro_requestlog(Status,DivisionID,UserID,FileName,Data)" & vbCrLf
    s = s & "    values(isnull(ERROR_PROCEDURE(),'') + ': line ' + cast(isnull(ERROR_LINE(),0) as varchar(max)) + ': ' + isnull(ERROR_MESSAGE(),'') " & vbCrLf
    s = s & "          ,@DivisionID,@uid,@FileName,cast(@XmlString as varchar(max)))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --return status" & vbCrLf
    s = s & "    select 500 Status, isnull(ERROR_PROCEDURE(),'') + ': line ' + cast(isnull(ERROR_LINE(),0) as varchar(max)) + ': ' + isnull(ERROR_MESSAGE(),'') Response" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END CATCH" & vbCrLf
    sql c, s


