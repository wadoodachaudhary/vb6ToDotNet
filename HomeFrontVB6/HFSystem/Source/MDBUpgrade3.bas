    s = s & "declare @JobNo    varchar(12)" & vbCrLf
    s = s & "declare @POIndex  varchar(20)" & vbCrLf
    s = s & "declare @PONumber varchar(12)" & vbCrLf
    s = s & "declare @t table (PONumber varchar(12))" & vbCrLf
    s = s & "declare c cursor for select PONumber,Job,POIndex from POMaster where PONumber like '~~%'" & vbCrLf
    s = s & "open c" & vbCrLf
    s = s & "fetch next from c into @EPOid, @JobNo, @POIndex" & vbCrLf
