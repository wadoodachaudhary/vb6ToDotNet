    s = s & ",Accuracy varchar(800) 'Product/Accuracy'" & vbCrLf
    s = s & ",Description varchar(800) 'Product/Description'" & vbCrLf
    s = s & ",ProductId varchar(800) 'Product/Id'" & vbCrLf
    s = s & ",Name varchar(800) 'Product/Name'" & vbCrLf
    s = s & ",Notes varchar(800) 'Product/Notes'" & vbCrLf
    s = s & ",UOM varchar(800) 'Product/ProductUnit/Abbreviation'" & vbCrLf
    s = s & ",UnitId varchar(800) 'Product/ProductUnit/Id'" & vbCrLf
    s = s & ",UnitName varchar(800) 'Product/ProductUnit/Name'" & vbCrLf
    s = s & ",ProjectedCost varchar(800) 'Product/ProjectedCost'" & vbCrLf
    s = s & ",RoundingRule varchar(800) 'Product/RoundingRule'" & vbCrLf
    s = s & ",SupplementalToBid varchar(800) 'Product/SupplementalToBid'" & vbCrLf
    s = s & ",Waste varchar(800) 'Product/Waste') x" & vbCrLf
    s = s & "where nullif(x.phase,'') is not null" & vbCrLf
    s = s & "" & vbCrLf
