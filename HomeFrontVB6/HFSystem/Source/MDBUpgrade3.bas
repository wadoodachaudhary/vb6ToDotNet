    s = ""
    s = s & "ALTER PROCEDURE [dbo].[Purch_PutEstimateAssemblyItems](@EstAssemblyID INTEGER,@JCCategory VARCHAR(40),@DivisionID INTEGER) AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @Community          VARCHAR(10)" & vbCrLf
    s = s & "    DECLARE @CommunityPhase     VARCHAR(10)" & vbCrLf
    s = s & "    DECLARE @Customer_No        VARCHAR(12)" & vbCrLf
    s = s & "    DECLARE @EstIndex           INTEGER" & vbCrLf
    s = s & "    DECLARE @Model              VARCHAR(20)" & vbCrLf
    s = s & "    DECLARE @OptionID           VARCHAR(20)" & vbCrLf
    s = s & "    DECLARE @SalesWorksheet     INTEGER" & vbCrLf
    s = s & "    DECLARE @Assembly           VARCHAR(20)" & vbCrLf
    s = s & "    DECLARE @AssemblyType       INTEGER" & vbCrLf
    s = s & "    DECLARE @TakeoffRequired    BIT" & vbCrLf
    s = s & "    DECLARE @UseSalesSheetCosts BIT" & vbCrLf
    s = s & "    DECLARE @Unit               VARCHAR(10)" & vbCrLf
    s = s & "    DECLARE @UnitsAsExtra       BIT" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE Assembly CURSOR FOR" & vbCrLf
    s = s & "    SELECT c.Community, c.Phase, c.Customer_No,isnull(c.Unit_No,''),isnull(s.MultiUnitsAsExtras,0), a.EstimateIndex, CASE WHEN a.AssemblyType = 0 OR a.AssemblyType = 2 THEN a.Model ELSE '' END Model,a.OptionID, a.SalesWorksheet, a.Assembly,a.AssemblyType,ISNULL(m.TakeoffRequired,0) TakeoffRequired,CASE WHEN ISNULL(o.optionvalue,'True')='True' then 1 else 0 end UseSalesSheetCosts" & vbCrLf
    s = s & "      FROM EstimateAssemblies a" & vbCrLf
    s = s & "           join system_setup s on s.id=a.DivisionID" & vbCrLf
    s = s & "           LEFT OUTER JOIN AppOptions o on(o.uid='' and o.optionname='RecordSalesSheetCosts' and o.DivisionID = a.DivisionID)" & vbCrLf
    s = s & "           JOIN tblCustomers c ON(a.Customer_No=c.Customer_No)" & vbCrLf
    s = s & "           LEFT JOIN tblDBAssemblyMaster m ON(m.DivisionID = a.DivisionID and m.Community=dbo.Purch_GetAssemblyCommunity(a.Assembly,CASE WHEN (a.AssemblyType=3 OR a.AssemblyType=4) THEN '' ELSE a.Model END,a.OptionID,c.Community,a.DivisionID)" & vbCrLf
    s = s & "                                              AND m.Assembly=a.Assembly" & vbCrLf
    s = s & "                                              AND m.OptionID=a.OptionID" & vbCrLf
    s = s & "                                              AND m.Model=CASE" & vbCrLf
    s = s & "                                                          WHEN a.AssemblyType = 0 OR a.AssemblyType = 2 THEN a.Model" & vbCrLf
    s = s & "                                                          ELSE '' END)" & vbCrLf
    s = s & "     WHERE EstAssemblyID = @EstAssemblyID" & vbCrLf
    s = s & "    OPEN Assembly" & vbCrLf
    s = s & "    FETCH FROM Assembly INTO @Community, @CommunityPhase, @Customer_No,@Unit,@UnitsAsExtra, @EstIndex, @Model,@OptionID, @SalesWorksheet, @Assembly, @AssemblyType, @TakeoffRequired, @UseSalesSheetCosts" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    CLOSE Assembly" & vbCrLf
