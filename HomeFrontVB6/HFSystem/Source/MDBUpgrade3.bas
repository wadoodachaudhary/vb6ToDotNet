    s = s & "   ,round(sum(case when isnull(ei.wbs01,'')=@sessionid then ei.takeoffqty else 0 end),2) bimAdjustedqty" & vbCrLf
    s = s & "   ,round(sum(case when isnull(ei.wbs01,'')=@sessionid then ei.takeoffqty else 0 end) - sum(case when isnull(ei.wbs01,'')='' then ei.takeoffqty else 0 end),2) bimCOQty" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   ,round(sum(case when isnull(ei.wbs01,'')=@sessionid then ei.takeoffqty else 0 end) - sum(case when isnull(ei.wbs01,'')='' then ei.takeoffqty else 0 end),2) takeoffqty" & vbCrLf
    s = s & "   ,round(sum(case when isnull(ei.wbs01,'')=@sessionid then ei.takeoffqty else 0 end) - sum(case when isnull(ei.wbs01,'')='' then ei.takeoffqty else 0 end),2) budgetqty" & vbCrLf
    s = s & "   ,round(sum(case when isnull(ei.wbs01,'')=@sessionid then ei.takeoffqty else 0 end) - sum(case when isnull(ei.wbs01,'')='' then ei.takeoffqty else 0 end),2) poqty" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "   ,max(ei.takeoffuom) takeoffuom,1 conversionfactor,max(ei.orderuom) orderuom" & vbCrLf
    s = s & "   ,max(ei.model) model,getdate(),@UserID,getdate(),@UserID,ei.DivisionID" & vbCrLf
    s = s & "   ,max(ei.BudgetVendor) BudgetVendor" & vbCrLf
    s = s & "   ,max(ei.BudgetRate) BudgetRate" & vbCrLf
    s = s & "    from estimateditems ei" & vbCrLf
    s = s & "    left join tblphaseitem i on ei.divisionid=i.divisionid and ei.estphase=i.phase and ei.estitem=i.item" & vbCrLf
