    s = ""
    s = s & "alter PROCEDURE [dbo].[Purch_PutEstimateAssembly]( " & vbCrLf
    s = s & "    @Customer_No    VARCHAR(12)" & vbCrLf
    s = s & "   ,@EstIndex       INTEGER " & vbCrLf
    s = s & "   ,@Location       INTEGER" & vbCrLf
    s = s & "   ,@ChangeOrderNo  VARCHAR(10) " & vbCrLf
    s = s & "   ,@Seq            INTEGER " & vbCrLf
    s = s & "   ,@JCCategory     VARCHAR(40) " & vbCrLf
    s = s & "   ,@UStmp          VARCHAR(15)" & vbCrLf
    s = s & "   ,@DivisionID     INTEGER" & vbCrLf
    s = s & "   ,@AddItems       BIT = 1)  AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "    SET ANSI_WARNINGS OFF" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @Lot_Cost FLOAT" & vbCrLf
    s = s & "    DECLARE @EstAssemblyID INTEGER" & vbCrLf
    s = s & "    DECLARE @Community VARCHAR(10)" & vbCrLf
    s = s & "    DECLARE @AssemblyType INTEGER" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- get community and lot_cost" & vbCrLf
    s = s & "    SET @Community = (SELECT Community FROM tblCustomers WHERE Customer_No = @Customer_No)" & vbCrLf
    s = s & "    SET @Lot_Cost = (SELECT Lot_Cost FROM tblCustomers WHERE Customer_No = @Customer_No)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- add lot premiums to lot_cost" & vbCrLf
    s = s & "    SET @Lot_Cost = @Lot_Cost + (select isnull(sum(p.cost),0) from tblcustomers c left outer join lotpremium p on(p.lot_no=c.lot_no) where c.customer_no=@customer_no)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    IF @Location = 0 BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   -- set scheduletemplate first while UnEstimatedCustomers still exists" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   UPDATE j" & vbCrLf
    s = s & "   SET ScheduleTemplate=a.ScheduleTemplate" & vbCrLf
    s = s & "      ,Model = isnull(nullif(j.model,''), a.Model)" & vbCrLf
    s = s & "   FROM UnEstimatedCustomers c" & vbCrLf
    s = s & "   JOIN tblJobs j on c.divisionid=j.divisionid and c.job=j.job_no  " & vbCrLf
    s = s & "   JOIN tblDBAssemblyMaster a on a.Community = dbo.Purch_GetAssemblyCommunity(c.ModelAssembly,c.Model,'',c.Community,c.DivisionID)  " & vbCrLf
    s = s & "                                  and a.DivisionID = c.DivisionID " & vbCrLf
    s = s & "                                  and a.Assembly = c.ModelAssembly  " & vbCrLf
    s = s & "                                  and a.Model = c.Model" & vbCrLf
    s = s & "                                  and a.OptionID = ''" & vbCrLf
    s = s & "   WHERE c.Customer_No = @Customer_No" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        -- add the model" & vbCrLf
    s = s & "        INSERT INTO EstimateAssemblies(DivisionID,Customer_No, EstimateIndex, HFLocation, Model, OptionID, HFDescription, OptionType, AssemblyType, Assembly, Job, SalesQty, SalesRate, SalesWorkSheet)" & vbCrLf
    s = s & "        SELECT c.DivisionID,c.Customer_No, @EstIndex, 0, c.Model,'', c.ModelDesc, 0, 0, c.ModelAssembly, c.Job, 1, c.ModelPrice, c.ModelSalesWorkSheet" & vbCrLf
    s = s & "        FROM UnEstimatedCustomers c" & vbCrLf
    s = s & "        WHERE c.Customer_No = @Customer_No" & vbCrLf
    s = s & "        SET @EstAssemblyID = @@IDENTITY" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        IF (@@ROWCOUNT>0 and @AddItems=1) EXEC Purch_PutEstimateAssemblyItems @@IDENTITY, @JCCategory, @DivisionID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        -- add the elevation" & vbCrLf
    s = s & "        INSERT INTO EstimateAssemblies(DivisionID,Customer_No, EstimateIndex, HFLocation, Model,OptionID, HFDescription, OptionType, AssemblyType, Assembly, Job, SalesQty, SalesRate, SalesWorkSheet)" & vbCrLf
    s = s & "        SELECT  @DivisionID,Customer_No, @EstIndex, 0, Model,'', ModelDesc, 0, 1, ElevationAssembly, Job, 1, ElevationPrice, ElevSalesWorkSheet" & vbCrLf
    s = s & "          FROM UnEstimatedCustomers" & vbCrLf
    s = s & "         WHERE Customer_No = @Customer_No" & vbCrLf
    s = s & "           AND ElevationAssembly<>''" & vbCrLf
    s = s & "        IF (@@ROWCOUNT>0 and @AddItems=1) EXEC Purch_PutEstimateAssemblyItems @@IDENTITY, @JCCategory, @DivisionID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        ------------------------------------------------------------------------" & vbCrLf
    s = s & "        -- now replace land cost with customers actual lot cost if there is one" & vbCrLf
    s = s & "        ------------------------------------------------------------------------" & vbCrLf
    s = s & "        IF @lot_cost <> 0 BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "            DELETE FROM EstimateItems " & vbCrLf
    s = s & "             WHERE EstAssemblyID=@EstAssemblyID and DivisionID = @DivisionID" & vbCrLf
    s = s & "               AND Phase=(SELECT OptionValue FROM AppOptions WHERE DivisionID = @DivisionID and OptionName='LandPhase')" & vbCrLf
    s = s & "               AND Item=(SELECT OptionValue FROM AppOptions WHERE DivisionID = @DivisionID and  OptionName='LandItem')" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "            INSERT INTO EstimateItems(Assembly,EstAssemblyID,POIndex,Phase,Item,Job,JCExtra,JCCostCode,JCCategory,Description,TakeoffQty,TakeoffUOM,ConversionFactor,OrderUOM,BudgetVendor,BudgetQty,BudgetRate,BudgetTaxGroup,BudgetJCTaxRate,BudgetNJCTaxRate)" & vbCrLf
    s = s & "            SELECT c.ModelAssembly,@EstAssemblyID,i.POIndex,i.Phase,i.Item,c.Job_No,ss.AdjustJCExtra,i.JCCostCode,i.JCCategory,i.description,1,i.TakeoffUOM,i.ConversionFactor,i.OrderUOM,dbo.Purch_GetCommunityVendor(c.Community,i.POIndex,@DivisionID),1,@lot_cost,t.TaxGroup,t.JCRate,t.NJCRate" & vbCrLf
    s = s & "              FROM system_setup ss" & vbCrLf
    s = s & "                  ,tblCustomers c" & vbCrLf
    s = s & "                   LEFT OUTER JOIN tblSalesSheetMaster s ON(c.ModelSalesWorksheet=s.Worksheet)" & vbCrLf
    s = s & "                   LEFT OUTER JOIN AppOptions phase ON(phase.OptionName='LandPhase' and phase.DivisionID = @DivisionID)" & vbCrLf
    s = s & "                   LEFT OUTER JOIN AppOptions item ON(item.OptionName='LandItem' and item.DivisionID = @DivisionID)" & vbCrLf
    s = s & "                   JOIN tblPhaseItem i ON(i.DivisionID = @DivisionID and i.Phase=phase.OptionValue AND i.Item=item.OptionValue)" & vbCrLf
    s = s & "                   LEFT OUTER JOIN TaxGroups t ON(t.DivisionID = @DivisionID and t.TaxGroup=dbo.Purch_GetDefaultTaxGroup(c.Job_No,c.Community,c.Phase,c.Model,c.ModelAssembly,i.Phase,i.Item,dbo.Purch_GetCommunityVendor(c.Community,i.POIndex,@DivisionID),i.JCCategory,@DivisionID))" & vbCrLf
    s = s & "             WHERE isnull(phase.optionvalue,'')<>''" & vbCrLf
    s = s & "               AND isnull(item.optionvalue,'')<>''" & vbCrLf
    s = s & "               AND Customer_No=@Customer_No and ss.ID = @DivisionID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "            IF @@ROWCOUNT <> 0 BEGIN" & vbCrLf
    s = s & "                UPDATE EstimateItems" & vbCrLf
    s = s & "                   SET BudgetPretax=BudgetQty*BudgetRate" & vbCrLf
    s = s & "                      ,BudgetJCTax=BudgetQty*BudgetRate*BudgetJCTaxRate/100" & vbCrLf
    s = s & "                      ,BudgetNJCTax=BudgetQty*BudgetRate*BudgetNJCTaxRate/100" & vbCrLf
    s = s & "                      ,POVendor=BudgetVendor" & vbCrLf
    s = s & "                      ,POQty=BudgetQty" & vbCrLf
    s = s & "                      ,PORate=BudgetRate" & vbCrLf
    s = s & "                      ,POPretax=BudgetQty*BudgetRate" & vbCrLf
    s = s & "                      ,POTaxGroup=BudgetTaxGroup" & vbCrLf
    s = s & "                      ,POJCTax=BudgetQty*BudgetRate*BudgetJCTaxRate/100" & vbCrLf
    s = s & "                      ,POJCTaxRate=BudgetJCTaxRate" & vbCrLf
    s = s & "                      ,PONJCTax=BudgetQty*BudgetRate*BudgetNJCTaxRate/100" & vbCrLf
    s = s & "                      ,PONJCTaxRate=BudgetNJCTaxRate" & vbCrLf
    s = s & "                      ,OriginalJCCategory=JCCategory" & vbCrLf
    s = s & "                 WHERE EstItemID=@@IDENTITY" & vbCrLf
    s = s & "            END" & vbCrLf
    s = s & "        END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        ------------------------------------------------------------------------" & vbCrLf
    s = s & "        -- now replace incentive with customers actual incentive" & vbCrLf
    s = s & "        ------------------------------------------------------------------------" & vbCrLf
    s = s & "        DELETE FROM EstimateItems " & vbCrLf
    s = s & "         WHERE EstAssemblyID=@EstAssemblyID and DivisionID = @DivisionID" & vbCrLf
    s = s & "           AND Phase=(SELECT OptionValue FROM AppOptions WHERE DivisionID = @DivisionID and OptionName='IncentivePhase')" & vbCrLf
    s = s & "           AND Item=(SELECT OptionValue FROM AppOptions WHERE DivisionID = @DivisionID and OptionName='IncentiveItem')" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        INSERT INTO EstimateItems(DivisionID,Assembly,EstAssemblyID,POIndex,Phase,Item,Job,JCExtra,JCCostCode,JCCategory,Description,TakeoffQty,TakeoffUOM,ConversionFactor,OrderUOM,BudgetVendor,BudgetQty,BudgetRate,BudgetTaxGroup,BudgetJCTaxRate,BudgetNJCTaxRate)" & vbCrLf
    s = s & "        SELECT @DivisionID,c.ModelAssembly,@EstAssemblyID,i.POIndex,i.Phase,i.Item,c.Job_No,ss.AdjustJCExtra,i.JCCostCode,i.JCCategory,i.description,1,i.TakeoffUOM,i.ConversionFactor,i.OrderUOM,dbo.Purch_GetCommunityVendor(c.Community,i.POIndex,@DivisionID) ,1" & vbCrLf
    s = s & "              ,c.TotalIncentives*ISNULL(s.IncentiveCostPercent,isnull(cast(incentivecost.OptionValue as float),0))/100" & vbCrLf
    s = s & "              ,t.TaxGroup,t.JCRate,t.NJCRate" & vbCrLf
    s = s & "          FROM system_setup ss" & vbCrLf
    s = s & "              ,tblCustomers c" & vbCrLf
    s = s & "               LEFT OUTER JOIN tblSalesSheetMaster s ON(c.ModelSalesWorksheet=s.Worksheet)" & vbCrLf
    s = s & "               LEFT OUTER JOIN AppOptions phase ON(phase.OptionName='IncentivePhase' and phase.DivisionID = @DivisionID)" & vbCrLf
    s = s & "               LEFT OUTER JOIN AppOptions item ON(item.OptionName='IncentiveItem' and item.DivisionID = @DivisionID)" & vbCrLf
    s = s & "               LEFT OUTER JOIN AppOptions incentivecost ON(incentivecost.OptionName='IncentiveCostPercent' and incentivecost.DivisionID = @DivisionID)" & vbCrLf
    s = s & "               JOIN tblPhaseItem i ON(i.DivisionID = @DivisionID and i.Phase=phase.OptionValue AND i.Item=item.OptionValue)" & vbCrLf
    s = s & "               LEFT OUTER JOIN TaxGroups t ON(t.DivisionID = @DivisionID and t.TaxGroup=dbo.Purch_GetDefaultTaxGroup(c.Job_No,c.Community,c.Phase,c.Model,c.ModelAssembly,i.Phase,i.Item,dbo.Purch_GetCommunityVendor(c.Community,i.POIndex,@DivisionID),i.JCCategory,@DivisionID))" & vbCrLf
    s = s & "         WHERE isnull(phase.optionvalue,'')<>''" & vbCrLf
    s = s & "           AND isnull(item.optionvalue,'')<>''" & vbCrLf
    s = s & "           AND Customer_No=@Customer_No and ss.ID = @DivisionID" & vbCrLf
    s = s & "           AND c.TotalIncentives*ISNULL(s.IncentiveCostPercent,isnull(cast(incentivecost.OptionValue as float),0) )/100<>0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        IF @@ROWCOUNT <> 0 BEGIN" & vbCrLf
    s = s & "            UPDATE EstimateItems" & vbCrLf
    s = s & "               SET BudgetPretax=BudgetQty*BudgetRate" & vbCrLf
    s = s & "                  ,BudgetJCTax=BudgetQty*BudgetRate*BudgetJCTaxRate/100" & vbCrLf
    s = s & "                  ,BudgetNJCTax=BudgetQty*BudgetRate*BudgetNJCTaxRate/100" & vbCrLf
    s = s & "                  ,POVendor=BudgetVendor" & vbCrLf
    s = s & "                  ,POQty=BudgetQty" & vbCrLf
    s = s & "                  ,PORate=BudgetRate" & vbCrLf
    s = s & "                  ,POPretax=BudgetQty*BudgetRate" & vbCrLf
    s = s & "                  ,POTaxGroup=BudgetTaxGroup" & vbCrLf
    s = s & "                  ,POJCTax=BudgetQty*BudgetRate*BudgetJCTaxRate/100" & vbCrLf
    s = s & "                  ,POJCTaxRate=BudgetJCTaxRate" & vbCrLf
    s = s & "                  ,PONJCTax=BudgetQty*BudgetRate*BudgetNJCTaxRate/100" & vbCrLf
    s = s & "                  ,PONJCTaxRate=BudgetNJCTaxRate" & vbCrLf
    s = s & "                  ,OriginalJCCategory=JCCategory" & vbCrLf
    s = s & "             WHERE EstItemID=@@IDENTITY" & vbCrLf
    s = s & "        END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    END ELSE BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        -- add the option" & vbCrLf
    s = s & "        INSERT INTO EstimateAssemblies(DivisionID,Customer_No, EstimateIndex, HFLocation, Model,OptionID, HFCategory,HFDescription, OptionType, AssemblyType, Assembly, Job, SalesQty, SalesRate, SalesWorksheet, ChangeOrder, Seq, HFComments,EstimatorNotes, JCExtra,AssemblyUOM,Color,Location,Style,Finish,Other)" & vbCrLf
    s = s & "        SELECT  @DivisionID,Customer_No, @EstIndex, Location,Model,Opt, Category,Description, OptionType, AssemblyType, Assembly, Job, Qty, Rate, SalesWorksheet, Change_Order_No, Seq, Comments,EstimatorNotes,JCExtra,AssemblyUOM,Color,RoomLocation,Style,Finish,Other" & vbCrLf
    s = s & "          FROM UnEstimatedOptions" & vbCrLf
    s = s & "         WHERE Customer_No = @Customer_No" & vbCrLf
    s = s & "           AND Location = @Location" & vbCrLf
    s = s & "           AND Change_Order_No = @ChangeOrderNo" & vbCrLf
    s = s & "           AND Seq = @Seq  " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        SET @EstAssemblyID = @@IDENTITY" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        -- if is custom option then do additems regardless of additems flag" & vbCrLf
    s = s & "        SELECT  @AssemblyType=AssemblyType" & vbCrLf
    s = s & "          FROM UnEstimatedOptions" & vbCrLf
    s = s & "         WHERE Customer_No = @Customer_No" & vbCrLf
    s = s & "           AND Location = @Location" & vbCrLf
    s = s & "           AND Change_Order_No = @ChangeOrderNo" & vbCrLf
    s = s & "           AND Seq = @Seq  " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        -- add the items" & vbCrLf
    s = s & "        IF (@@ROWCOUNT>0 and (@AddItems=1 or @AssemblyType=-1)) EXEC dbo.Purch_PutEstimateAssemblyItems @@IDENTITY, @JCCategory ,@DivisionID " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    END    " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    IF @Location = 0 UPDATE tblCustomers        SET EstimateIndex = @EstIndex WHERE Customer_No = @Customer_No" & vbCrLf
    s = s & "    IF @Location = 1 UPDATE tblScheduleB        SET EstimateIndex = @EstIndex WHERE Seq = @Seq" & vbCrLf
    s = s & "    IF @Location = 2 UPDATE ChangeOrderDetails  SET EstimateIndex = @EstIndex WHERE Seq = @Seq" & vbCrLf
    s = s & "    IF @Location = 3 UPDATE DesignCenterDetails SET EstimateIndex = @EstIndex WHERE Seq = @Seq" & vbCrLf
    s = s & "    IF @Location = 4 UPDATE tblDeletedItems     SET EstimateIndex = @EstIndex WHERE Sequence = @Seq" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    select @EstAssemblyID" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
 
