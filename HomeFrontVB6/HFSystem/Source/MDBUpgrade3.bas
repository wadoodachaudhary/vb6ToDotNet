    s = ""
    s = s & "CREATE FUNCTION dbo.RTF2Text" & vbCrLf
    s = s & "(@In VARCHAR(MAX))" & vbCrLf
    s = s & "RETURNS VARCHAR(MAX)" & vbCrLf
    s = s & "AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "   If isnull(@In,'') = '' return ''" & vbCrLf
    s = s & "   If @In not like '{\rtf%' return @In" & vbCrLf
    s = s & "   Declare @Len int" & vbCrLf
    s = s & "   Declare @Loc int = 1" & vbCrLf
    s = s & "   Declare @Char char(1) = ''" & vbCrLf
    s = s & "   Declare @PrevChar char(1) = ''" & vbCrLf
    s = s & "   Declare @NextChar char(1) = ''" & vbCrLf
    s = s & "   Declare @InMarkup int = 0" & vbCrLf
    s = s & "   Declare @InBrackets int = -1" & vbCrLf
    s = s & "   Declare @Out varchar(max) = ''" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "       Set @Len = len(@In)" & vbCrLf
    s = s & "       While @Loc < @Len begin" & vbCrLf
    s = s & "           Set @PrevChar = @Char" & vbCrLf
    s = s & "           Set @Char = SUBSTRING(@In, @Loc, 1)" & vbCrLf
    s = s & "           If @Loc < @Len set @NextChar = SUBSTRING(@In, @Loc + 1, 1) else set @NextChar = ''" & vbCrLf
    s = s & "           Set @Loc = @Loc + 1" & vbCrLf
    s = s & "           If @Char = '{' and @PrevChar != '\' begin" & vbCrLf
    s = s & "               Set @InBrackets = @InBrackets + 1" & vbCrLf
    s = s & "               Continue" & vbCrLf
    s = s & "           End" & vbCrLf
    s = s & "           If @Char = '}' and @PrevChar != '\' begin" & vbCrLf
    s = s & "               Set @InBrackets = @InBrackets - 1" & vbCrLf
    s = s & "               Continue" & vbCrLf
    s = s & "           End" & vbCrLf
    s = s & "           If @Char = '\' and @PrevChar != '\' and @NextChar not in ('\','{','}','~','-','_') begin" & vbCrLf
    s = s & "               Set @InMarkup = 1" & vbCrLf
    s = s & "               continue" & vbCrLf
    s = s & "           End" & vbCrLf
    s = s & "           If @Char = ' ' or @Char = char(13) begin" & vbCrLf
    s = s & "               Set @InMarkup = 0" & vbCrLf
    s = s & "           " & vbCrLf
    s = s & "           End" & vbCrLf
    s = s & "           If @InMarkup > 0 or @InBrackets > 0 continue" & vbCrLf
    s = s & "       " & vbCrLf
    s = s & "           Set @Out = @Out + @Char" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "       End" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   Set @Out = replace(@Out, '\\', '\')" & vbCrLf
    s = s & "   Set @Out = replace(@Out, '\{', '{')" & vbCrLf
    s = s & "   Set @Out = replace(@Out, '\}', '}')" & vbCrLf
    s = s & "   Set @Out = replace(@Out, '\~', ' ')" & vbCrLf
    s = s & "   Set @Out = replace(@Out, '\-', '-')" & vbCrLf
    s = s & "   Set @Out = replace(@Out, '\_', '-')" & vbCrLf
