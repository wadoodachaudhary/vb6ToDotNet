    s = s & "and i.phase is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- update items --------------" & vbCrLf
    s = s & "update i set" & vbCrLf
    s = s & " Description = x.Description" & vbCrLf
    s = s & ",Notes = x.Notes" & vbCrLf
    s = s & ",POIndex = x.phase" & vbCrLf
    s = s & ",TakeoffUOM = x.uom" & vbCrLf
    s = s & ",OrderUOM = x.uom" & vbCrLf
    s = s & ",ConversionFactor = 1" & vbCrLf
    s = s & ",RoundDir = case x.roundingrule   --> theirs  0,1,2   = closest,up,down" & vbCrLf
    s = s & "    when 0 then 2      --> ours    0,1,2,3 = none,up,closest,down" & vbCrLf
    s = s & "    when 1 then 1" & vbCrLf
    s = s & "    when 2 then 3" & vbCrLf
    s = s & "    end " & vbCrLf
    s = s & ",RoundTo = x.accuracy        " & vbCrLf
    s = s & ",WastePercent = isnull((nullif(x.waste,0)-1)*100,0) " & vbCrLf
    s = s & ",UStmp=x.UserID" & vbCrLf
    s = s & ",TStmp=getdate()" & vbCrLf
    s = s & "from tblphaseItem i" & vbCrLf
    s = s & "join ImportedBIMItemDB x on x.phase=i.phase and x.productid=i.itemnumber and i.divisionid=x.divisionid" & vbCrLf
    s = s & "where x.SessionID=@SessionID" & vbCrLf
    s = s & "and isnull(x.phase,'')<>''" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- create phases --------------" & vbCrLf
    s = s & "insert tblestphases(phase,description,groupphase,ustmp,divisionid,tstmp,sortorder)" & vbCrLf
    s = s & "select distinct x.phase,x.phasename,0,x.userid,x.divisionid,getdate() " & vbCrLf
    s = s & ",cast(left(x.phase, patindex('%[^0-9]%', x.phase+'.') - 1) as int) sortorder" & vbCrLf
    s = s & "from importedbimitemdb x" & vbCrLf
    s = s & "left outer join tblestphases p on x.phase=p.phase and x.divisionid=p.divisionid" & vbCrLf
    s = s & "where x.SessionID=@SessionID" & vbCrLf
    s = s & "and isnull(x.phase,'')<>''" & vbCrLf
    s = s & "and p.phase is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- update phases --------------" & vbCrLf
    s = s & "update p set" & vbCrLf
    s = s & " Description=x.PhaseName" & vbCrLf
    s = s & ",UStmp=x.UserID" & vbCrLf
    s = s & ",TStmp=getdate()" & vbCrLf
    s = s & "from tblestphases p" & vbCrLf
    s = s & "join importedbimitemdb x on x.phase=p.phase and x.divisionid=p.divisionid" & vbCrLf
    s = s & "where x.SessionID=@SessionID" & vbCrLf
    s = s & "and isnull(x.phase,'')<>''" & vbCrLf
    s = s & "and p.phase is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- now set parent group phase --------------" & vbCrLf
    s = s & "update tblestphases " & vbCrLf
    s = s & "set GroupPhaseValue=ltrim((" & vbCrLf
    s = s & "    --select max(space(20-len(phase)) + phase) " & vbCrLf
    s = s & "    select max(phase) " & vbCrLf
    s = s & "      from estgroups " & vbCrLf
    s = s & "     where DivisionID=@DivisionID" & vbCrLf
    s = s & "       --and (replace(space(20-len(phase)) + phase,' ','0')) < (replace(space(20-len(tblestphases.phase)),' ','0') + tblestphases.phase) " & vbCrLf
    s = s & "       and phase < tblestphases.phase)) " & vbCrLf
    s = s & "where GroupPhase=0" & vbCrLf
    s = s & "and DivisionID=@DivisionID " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "update tblestphases" & vbCrLf
    s = s & "set GroupPhaseValue=Phase" & vbCrLf
    s = s & "where GroupPhase=1" & vbCrLf
    s = s & "and DivisionID=@DivisionID " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- clean up --------------" & vbCrLf
    s = s & "delete ImportedBIMItemDB where SessionID=@SessionID" & vbCrLf
    sql c, s

    Call Revisions_2019_07
End Sub


