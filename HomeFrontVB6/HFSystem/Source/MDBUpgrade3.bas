    s = s & "    @ustmp, getdate(), 'File Import', i.InvoiceCode1, i.InvoiceCode2, getdate(), v.Addr1, v.Addr2, v.City, v.state, v.zip, i.DivisionID, d.DeptID, newid()" & vbCrLf
