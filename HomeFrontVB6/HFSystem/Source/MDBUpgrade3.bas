    s = s & "    DECLARE @DoPOComplete bit" & vbCrLf
    s = s & "    DECLARE @DoEPO bit" & vbCrLf
    s = s & "    DECLARE @DoMilestone bit" & vbCrLf
    s = s & "    DECLARE @DoTbdVendor bit" & vbCrLf
