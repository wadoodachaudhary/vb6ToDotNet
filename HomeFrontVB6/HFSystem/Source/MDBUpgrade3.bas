    s = ""
    s = s & "alter PROCEDURE [dbo].[Purch_PutEstimateAssemblyItems](@EstAssemblyID INTEGER,@JCCategory VARCHAR(40),@DivisionID INTEGER) AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
