    s = s & ",BudgetNJCTax = case when a.BudgetsLocked=1 then e.BudgetNJCTax else round(p.NJCTaxRate/100 * Round(x.QtyUsed * p.Rate,2),2) end" & vbCrLf
    s = s & "FROM OPENXML (@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_MPOExport/MPOLineItem',2) " & vbCrLf
