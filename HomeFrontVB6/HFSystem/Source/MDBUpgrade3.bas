    s = s & "                  ,i.Description" & vbCrLf
    s = s & "                  ,i.Comments" & vbCrLf
    s = s & "                  ,e.SalesQty * i.TakeoffQty" & vbCrLf
    s = s & "                  ,i.TakeoffUOM" & vbCrLf
    s = s & "                  ,i.ConversionFactor" & vbCrLf
    s = s & "                  ,i.OrderUOM" & vbCrLf
    s = s & "                  ,i.BudgetVendor" & vbCrLf
