    s = s & "    BEGIN" & vbCrLf
    s = s & "-- Get LastUpdate Dates" & vbCrLf
    s = s & "        DECLARE @tblLastUpdate TABLE" & vbCrLf
    s = s & "            (" & vbCrLf
