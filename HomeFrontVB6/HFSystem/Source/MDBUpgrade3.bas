    s = s & "                  ,i.Phase" & vbCrLf
    s = s & "                  ,i.Item" & vbCrLf
    s = s & "                  ,0 sequence" & vbCrLf
    s = s & "                  ,e.Job" & vbCrLf
    s = s & "                  ,i.JCExtra" & vbCrLf
    s = s & "                  ,i.JCCostCode" & vbCrLf
    s = s & "                  ,isnull(nullif(@JCCategory,''),i.JCCategory)" & vbCrLf
