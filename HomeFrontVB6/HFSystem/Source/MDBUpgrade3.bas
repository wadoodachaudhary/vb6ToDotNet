    s = s & "--- replace po numbers" & vbCrLf
    s = s & "declare @EPOid    varchar(40)" & vbCrLf
    s = s & "declare @JobNo    varchar(12)" & vbCrLf
    s = s & "declare @POIndex  varchar(20)" & vbCrLf
