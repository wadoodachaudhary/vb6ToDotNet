    s = s & "        SELECT @InboxBatchID,c.DivisionID,c.Customer_No, c.crmid, @EstIndex, 0, c.Model,'', c.ModelDesc, 0, 0, c.ModelAssembly, c.Job, 1, c.ModelPrice, c.ModelSalesWorkSheet,c.JCExtra" & vbCrLf
