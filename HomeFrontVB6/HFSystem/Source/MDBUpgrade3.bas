    s = ""
    s = s & "ALTER PROCEDURE [dbo].[BuildProSOAP_DoEPO] @idoc int, @DivisionID int, @XmlString text  AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "declare @EstAssemblyID int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- get assembly and PO" & vbCrLf
    s = s & "Select @EstAssemblyID = max(a.EstAssemblyID)" & vbCrLf
    s = s & "from openxml(@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_EPO/EPOItem',2) " & vbCrLf
    s = s & "with(JobNo    varchar(40)  'LotJob'" & vbCrLf
    s = s & ") x" & vbCrLf
    s = s & "join EstimateAssemblies a on a.Job= dbo.BuildProSOAP_HFJob(@DivisionID,x.jobNo)" & vbCrLf
    s = s & "and a.DivisionID=@DivisionID AND (a.AssemblyType=0 OR HFDescription = 'Manual Estimates' )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- create pomaster" & vbCrLf
    s = s & "INSERT INTO POMaster(PONumber,DivisionID,EPOid,EPODocType,EPODocSuffix,PODate,POIndex,Job,Vendor,Description,DeliveryMethod,DeliveryAddress,OrderedBy,ApprovedDate,ApprovedBy,tstmp,[Status])" & vbCrLf
    s = s & "SELECT DISTINCT" & vbCrLf
    s = s & " '~~'+x.EPOid PONumber" & vbCrLf
    s = s & ",v.DivisionID" & vbCrLf
    s = s & ",x.EPOid EPOid,x.DocType,x.DocSuffix" & vbCrLf
    s = s & ",x.DateChgd PODate" & vbCrLf
    s = s & ",x.POIndex" & vbCrLf
    s = s & ",dbo.BuildProSOAP_HFJob(@DivisionID,x.jobNo)" & vbCrLf
    s = s & ",x.Vendor" & vbCrLf
    s = s & ",x.poindex PODescription" & vbCrLf
    s = s & ",v.SchedDelMethod" & vbCrLf
    s = s & ",CASE v.SchedDelMethod WHEN 1 THEN v.SchedEmail WHEN 2 THEN v.SchedFax ELSE '' END DeliveryAddress" & vbCrLf
    s = s & ",x.UserName" & vbCrLf
    s = s & ",x.DateChgd" & vbCrLf
    s = s & ",x.UserName,getdate(),'Approved'" & vbCrLf
    s = s & "FROM OPENXML (@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_EPO/EPOItem',2) " & vbCrLf
    s = s & "WITH (JobNo     varchar(40)  'LotJob'" & vbCrLf
    s = s & "     ,POIndex   varchar(40)  'CostCode'" & vbCrLf
    s = s & "     ,EPOid     varchar(40)  'BuildProDocument/Document/DocNumber'" & vbCrLf
    s = s & "     ,DocSuffix varchar(40)  'BuildProDocument/Document/DocSuffix'" & vbCrLf
    s = s & "     ,DocType   varchar(40)  'BuildProDocument/Document/DocType'" & vbCrLf
    s = s & "     ,Vendor    varchar(40)  'Vendor/AddressBookEntry/AddressBookNumber'" & vbCrLf
    s = s & "     ,ItemNum   varchar(40)  'SequenceNumber'" & vbCrLf
    s = s & "     ,ItemDesc  varchar(500) 'ItemDescription'" & vbCrLf
    s = s & "     ,Quantity  float        'Quantity'" & vbCrLf
    s = s & "     ,UOM       varchar(500) 'UnitOfMeasure'" & vbCrLf
    s = s & "     ,UnitPrice float        'UnitPrice'" & vbCrLf
    s = s & "     ,Pretax    money        'ExtendedPrice'" & vbCrLf
    s = s & "     ,Tax       money        'Tax'" & vbCrLf
    s = s & "     ,UserName  varchar(40)  'UserName'" & vbCrLf
    s = s & "     ,DateChgd  date         'DateChanged'" & vbCrLf
    s = s & "     ,Notes     varchar(max) 'EPONote'" & vbCrLf
    s = s & "     ) x" & vbCrLf
    s = s & "JOIN tblVendors v ON(v.Vendor_ID=x.Vendor AND  v.DivisionID = @DivisionID)" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- create estimateitems" & vbCrLf
    s = s & "insert into EstimateItems(DivisionID,EstAssemblyID, PONumber, RequestDetailID , POGenBatch, BudgetDeleted, PODeleted, POIndex" & vbCrLf
    s = s & "                         ,Job, Unit, JCExtra ,JCCostCode ,JCCategory ,Description ,Comments" & vbCrLf
    s = s & "                         ,ConversionFactor, OrderUOM,takeoffuom, POVendor, POQty, TakeoffQty, PORate, POPretax" & vbCrLf
    s = s & "                         ,POTaxGroup, PONJCTaxRate, POJCTaxRate, PONJCTax, POJCTax )" & vbCrLf
    s = s & "select @DivisionID,@EstAssemblyID,'~~'+x.EPOid,x.ItemNum ,-1 POGenBatch,1 BudgetDeleted,0 PODeleted,x.POIndex" & vbCrLf
    s = s & "      ,dbo.BuildProSOAP_HFJob(@DivisionID,x.jobNo)" & vbCrLf
    s = s & "      ,dbo.BuildProSOAP_HFUnit(@DivisionID,x.jobNo)" & vbCrLf
    s = s & "      ,case when s.MultiUnitsAsExtras=1 then dbo.BuildProSOAP_HFUnit(@DivisionID,x.jobNo) else '' end JCExtra" & vbCrLf
    s = s & "      ,p.JCCostCode" & vbCrLf
    s = s & "      ,isnull(nullif(o.OptionValue,''),p.JCCategory)" & vbCrLf
    s = s & "      , x.ItemDesc, x.Notes" & vbCrLf
    s = s & "      ,1,x.UOM,x.UOM, x.Vendor, x.Quantity,x.quantity, x.UnitPrice, x.Pretax" & vbCrLf
    s = s & "      ,isnull(t.TaxGroup, '') TaxGroup" & vbCrLf
    s = s & "      ,isnull(t.njcrate,0)   NJCTaxRate        " & vbCrLf
    s = s & "      ,isnull(t.jcrate,0)    JCTaxRate" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      -- dont use buildpro taxes. they are not set..." & vbCrLf
    s = s & "      --,isnull(round(cast(x.tax*t.njcrate/nullif(t.grouprate,0) as money),2),0) njctax" & vbCrLf
    s = s & "      --,isnull(x.tax - round(x.tax*t.njcrate/nullif(t.grouprate,0),2),0) jctax" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      ,round(x.pretax*isnull(t.njcrate,0)/100,2) njctax" & vbCrLf
    s = s & "      ,round(x.pretax*isnull(t.jcrate,0)/100,2) jctax" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "FROM OPENXML (@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_EPO/EPOItem',2) " & vbCrLf
