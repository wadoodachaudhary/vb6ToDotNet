    s = ""
    s = s & "CREATE PROCEDURE dbo.BuildPro_SOAP @XmlString text as" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "BEGIN TRY" & vbCrLf
    s = s & "    DECLARE @idoc int" & vbCrLf
    s = s & "    EXEC sp_xml_preparedocument @idoc OUTPUT, @XmlString, '<root xmlns:SOAP-ENV=""http://schemas.xmlsoap.org/soap/envelope/"" xmlns:SOAP-ENC=""http://schemas.xmlsoap.org/soap/encoding/"" xmlns:xsd=""http://www.w3.org/1999/XMLSchema"" xmlns:xsi=""http://www.w3.org/1999/XMLSchema-instance"" SOAP-ENV:encodingStyle=""http://schemas.xmlsoap.org/soap/encoding/""  />'" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @uid varchar(10)" & vbCrLf
    s = s & "    DECLARE @DivisionID int" & vbCrLf
    s = s & "    DECLARE @FileName varchar(1000) -- third segment is divisioncode" & vbCrLf
    s = s & "                                    --  eg: JDEOW_LineItem_0001_2019052909500444.xml Division=0001" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --parse and validate user" & vbCrLf
    s = s & "    SELECT @uid = u.User_id" & vbCrLf
    s = s & "          ,@FileName = x.FileName" & vbCrLf
    s = s & "          ,@DivisionID = d.DivisionID" & vbCrLf
    s = s & "    FROM OPENXML (@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Header/MH2SoapHeader',2) " & vbCrLf
    s = s & "    WITH (UserName varchar(40) 'Authentication/UserName'" & vbCrLf
    s = s & "         ,Password varchar(40) 'Authentication/Password'" & vbCrLf
    s = s & "         ,FileName varchar(1000) 'Properties/FileName') x" & vbCrLf
    s = s & "    JOIN User_Manager u on x.UserName = u.User_Id" & vbCrLf
    s = s & "    JOIN Divisions d on d.DivisionCode = parsename(replace(replace(x.FileName,'.xml',''),'_','.'),2)" & vbCrLf
    s = s & "    JOIN DivisionUsers du on d.DivisionID=du.DivisionID and du.USERID=u.user_id" & vbCrLf
    s = s & "    WHERE isnull(u.BuildProIntegrations,0) = 1" & vbCrLf
    s = s & "    if (@uid is null) begin" & vbCrLf
    s = s & "        select 401 Status, 'access denied' Response" & vbCrLf
    s = s & "        insert buildpro_requestlog(Status,DivisionID,UserID,FileName,Data)" & vbCrLf
    s = s & "        values('access denied',@DivisionID,@uid,@FileName,@XmlString)" & vbCrLf
    s = s & "        return" & vbCrLf
    s = s & "    end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- update POs" & vbCrLf
    s = s & "    UPDATE p SET" & vbCrLf
    s = s & "     CompletedDate = x.DateChanged" & vbCrLf
    s = s & "    ,PayPoint1ApprovedDate = x.DateChanged" & vbCrLf
    s = s & "    ,PayPoint2ApprovedDate = x.DateChanged" & vbCrLf
    s = s & "    ,PayPoint3ApprovedDate = x.DateChanged" & vbCrLf
    s = s & "    ,PayPoint4ApprovedDate = x.DateChanged" & vbCrLf
    s = s & "    ,PayPoint5ApprovedDate = x.DateChanged" & vbCrLf
    s = s & "    FROM OPENXML (@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_LineItemCompletion/LineItem',2) " & vbCrLf
    s = s & "    WITH (PONumber varchar(40) 'PONum'" & vbCrLf
    s = s & "         ,DateChanged varchar(40) 'DateChanged') x" & vbCrLf
    s = s & "    JOIN POMaster p on p.DivisionID=@DivisionID and x.PONUmber=p.PONumber" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- log request" & vbCrLf
    s = s & "    insert buildpro_requestlog(Status,DivisionID,UserID,FileName,Data)" & vbCrLf
    s = s & "    values('OK',@DivisionID,@uid,@FileName,@XmlString)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- return status" & vbCrLf
    s = s & "    select 200 Status, 'OK' Response" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END TRY" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "BEGIN CATCH" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- log request" & vbCrLf
    s = s & "    insert buildpro_requestlog(Status,DivisionID,UserID,FileName,Data)" & vbCrLf
    s = s & "    values(isnull(ERROR_PROCEDURE(),'') + ': line ' + cast(isnull(ERROR_LINE(),0) as varchar(max)) + ': ' + isnull(ERROR_MESSAGE(),''),@DivisionID,@uid,@FileName,@XmlString)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --return status" & vbCrLf
    s = s & "    select 500 Status, " & vbCrLf
    s = s & "    isnull(ERROR_PROCEDURE(),'') + ': line ' + cast(isnull(ERROR_LINE(),0) as varchar(max)) + ': ' + isnull(ERROR_MESSAGE(),'') Response" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END CATCH" & vbCrLf
    sql c, s

