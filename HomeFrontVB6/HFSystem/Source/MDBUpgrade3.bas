    s = s & "                  ,isnull(nullif(d.WBS31,''),i.WBS31),isnull(nullif(d.WBS32,''),i.WBS32),isnull(nullif(d.WBS33,''),i.WBS33),isnull(nullif(d.WBS34,''),i.WBS34),isnull(nullif(d.WBS35,''),i.WBS35)" & vbCrLf
    s = s & "                  ,isnull(nullif(d.WBS36,''),i.WBS36),isnull(nullif(d.WBS37,''),i.WBS37),isnull(nullif(d.WBS38,''),i.WBS38),isnull(nullif(d.WBS39,''),i.WBS39),isnull(nullif(d.WBS40,''),i.WBS40)" & vbCrLf
