    s = s & "                  ,d.Sequence SortOrder" & vbCrLf
    s = s & "                  ,i.Description" & vbCrLf
    s = s & "                  ,isnull(nullif(d.notes,''),i.notes) Comments" & vbCrLf
    s = s & "                  ,CASE WHEN ISNULL(a.UseNormalSalesQtyFactors,0)=1 THEN (e.SalesQty * d.TakeoffQty) WHEN UPPER(e.AssemblyUOM)=UPPER(i.TakeoffUOM) THEN (e.SalesQty * d.TakeoffQty) WHEN UPPER(e.AssemblyUOM)=UPPER(i.OrderUOM) THEN (e.SalesQty * d.OrderQty / isnull(nullif(d.conversionfactor,0),i.ConversionFactor)) WHEN e.SalesQty < 0 THEN d.TakeoffQty * -1 ELSE d.TakeoffQty END TakeoffQty" & vbCrLf
    s = s & "                  ,i.TakeoffUOM" & vbCrLf
