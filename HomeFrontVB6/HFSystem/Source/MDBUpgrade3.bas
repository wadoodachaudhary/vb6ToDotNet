    s = s & "                  ,i.OrderUOM" & vbCrLf
    s = s & "                  ,dbo.Purch_GetCommunityVendor(@Community,p.POIndex,@DivisionID)  BudgetVendor" & vbCrLf
    s = s & "                  ,CASE WHEN ISNULL(a.UseNormalSalesQtyFactors,0)=1 THEN (e.SalesQty * d.OrderQty) WHEN UPPER(e.AssemblyUOM)=UPPER(i.OrderUOM) THEN (e.SalesQty * d.OrderQty) WHEN UPPER(e.AssemblyUOM)=UPPER(i.TakeoffUOM) THEN (e.SalesQty * d.TakeoffQty * isnull(nullif(d.conversionfactor,0),i.ConversionFactor)) WHEN e.SalesQty < 0 THEN d.OrderQty * -1 ELSE d.OrderQty END BudgetQty" & vbCrLf
    s = s & "                  ,ISNULL(dbo.Purch_GetItemRate(0,0,@Community,@CommunityPhase,d.Assembly,d.Model,d.OptionID,i.Phase,i.Item,d.sequence,dbo.Purch_GetCommunityVendor(@Community,p.POIndex,@DivisionID),GETDATE(),@DivisionID),0)" & vbCrLf
