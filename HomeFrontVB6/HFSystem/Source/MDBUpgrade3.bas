    s = s & "    WHERE i.paypoint5approveddate is not null" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    INSERT INTO InvoiceItems(DivisionID,InvoiceID,Vendor,Invoice,Commitment,CommitmentItem,CommitmentDesc,CommitmentVendor,Job,Extra,Phase,PhaseDesc,Category,CategoryDesc,InvoicedQuantity,TaxGroup,TaxGroupDesc,TaxRate,Description,RetainageRate,PreTax,Tax,Retainage,JCTaxRate,NJCTaxRate)" & vbCrLf
    s = s & "    SELECT d.DivisionID,e.InvoiceID,e.Vendor,e.Invoice,d.PO,d.Line,LEFT(d.poDesc,200),d.Vendor,d.lineJob,d.lineExtra,d.lineCostCode,d.linecostcodeDesc,d.lineCategory,d.linecategoryDesc,0,d.lineTaxGroup,d.lineTaxGroupdesc,d.lineTaxrate,left(d.LineDesc,100),d.Retainagerate" & vbCrLf
    s = s & "          ,d.lineRemainingPretax Pretax" & vbCrLf
