    s = s & "ALTER PROCEDURE [dbo].[Intacct_SetPOItemIDs] @DivisionID integer, @xmlString varchar(max) as" & vbCrLf
    s = s & "DECLARE @idoc int" & vbCrLf
    s = s & "EXEC sp_xml_preparedocument @idoc OUTPUT, @xmlString" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- get recordno from Intacct so we can post invoices to it." & vbCrLf
    s = s & "--- you MUST use the dbo.JCPOIntacct view as an intermediary. " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- reg poitems" & vbCrLf
    s = s & "UPDATE i" & vbCrLf
    s = s & "set ExternalID=x.ExternalID" & vbCrLf
    s = s & "FROM OPENXML (@idoc, '/response/operation/result/data/podocumententry',2)" & vbCrLf
    s = s & "WITH (IntacctPONumber   varchar(40)  'DOCHDRID'" & vbCrLf
    s = s & "     ,IntacctLineNumber varchar(40)  'LINE_NO'" & vbCrLf
    s = s & "     ,ExternalID        varchar(40)  'RECORDNO'" & vbCrLf
    s = s & ") x" & vbCrLf
    s = s & "JOIN JCPOIntacct j on j.divisionid=@divisionid and j.IntacctPONumber=x.IntacctPONumber and j.IntacctLineNo=x.intacctlinenumber" & vbCrLf
    s = s & "JOIN POItems     i on i.divisionid=@DivisionID and i.ponumber=j.ponumber and i.linenumber=j.line" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- var poitems" & vbCrLf
    s = s & "UPDATE i" & vbCrLf
    s = s & "set VarianceExternalID=x.ExternalID" & vbCrLf
    s = s & "   ,VarianceLineNumber=x.IntacctLineNumber" & vbCrLf
    s = s & "FROM OPENXML (@idoc, '/response/operation/result/data/podocumententry',2)" & vbCrLf
    s = s & "WITH (IntacctPONumber   varchar(40)  'DOCHDRID'" & vbCrLf
    s = s & "     ,IntacctLineNumber varchar(40)  'LINE_NO'" & vbCrLf
    s = s & "     ,ExternalID        varchar(40)  'RECORDNO'" & vbCrLf
    s = s & ") x" & vbCrLf
    s = s & "JOIN JCPOIntacct j on j.divisionid=@divisionid and j.IntacctPONumber=x.IntacctPONumber and j.IntacctLineNo=x.intacctlinenumber" & vbCrLf
    s = s & "JOIN JCPODetails_varlines v on v.divisionid=@DivisionID and v.ponumber=j.ponumber and v.LineNumber=j.line" & vbCrLf
    s = s & "JOIN POItems i on v.POItemSeq=i.ItemSeq" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--- njc tax lineids are on pomaster" & vbCrLf
    s = s & "UPDATE m" & vbCrLf
    s = s & "set IntacctNJCTaxLineID = x.ExternalID" & vbCrLf
    s = s & "FROM OPENXML (@idoc, '/response/operation/result/data/podocumententry',2)" & vbCrLf
    s = s & "WITH (IntacctPONumber   varchar(40)  'DOCHDRID'" & vbCrLf
    s = s & "     ,IntacctLineNumber varchar(40)  'LINE_NO'" & vbCrLf
    s = s & "     ,ExternalID        varchar(40)  'RECORDNO'" & vbCrLf
    s = s & ") x" & vbCrLf
    s = s & "JOIN JCPOIntacct j on j.divisionid=@divisionid and j.IntacctPONumber=x.IntacctPONumber and j.IntacctLineNo=0" & vbCrLf
    s = s & "JOIN POMaster m on m.divisionid=@DivisionID and m.ponumber=j.ponumber and x.intacctlinenumber+1=m.IntacctNJCTaxLineNumber" & vbCrLf
    sql c, s
    
    
