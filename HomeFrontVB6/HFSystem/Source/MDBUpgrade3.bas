    s = s & "CREATE PROCEDURE [dbo].[BIM_StageProducts] @UserID varchar(10), @DivisionID int, @XmlString text as" & vbCrLf
    s = s & "DECLARE @idoc int" & vbCrLf
    s = s & "EXEC sp_xml_preparedocument @idoc OUTPUT, @XmlString" & vbCrLf
