    s = s & "    left outer join tblvendors v on i.divisionid=v.divisionid and i.vendor=v.vendor_id" & vbCrLf
    s = s & "    WHERE i.paypoint5approveddate is not null AND isnull(p.paypoint5percent,0)<>0" & vbCrLf
