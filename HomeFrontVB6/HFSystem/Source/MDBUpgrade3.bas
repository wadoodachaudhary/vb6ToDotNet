    s = s & "" & vbCrLf
    s = s & "    IF @TakeoffRequired = 0 BEGIN" & vbCrLf
    s = s & "        IF @SalesWorksheet<>0 AND @UseSalesSheetCosts=1 BEGIN" & vbCrLf
    s = s & "            ------------------------------------------------------------------------" & vbCrLf
