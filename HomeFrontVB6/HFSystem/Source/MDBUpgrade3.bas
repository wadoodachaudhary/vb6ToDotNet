    s = s & ",ISNULL(dbo.Purch_GetItemRate(0,0,c.Community,c.Phase,'','','',i.Phase,i.Item,0,dbo.Purch_GetCommunityVendor(c.Community,p.POIndex,c.DivisionID),GETDATE(),c.DivisionID),0) BudgetRate" & vbCrLf
    s = s & "from ImportedBimJobBom x" & vbCrLf
