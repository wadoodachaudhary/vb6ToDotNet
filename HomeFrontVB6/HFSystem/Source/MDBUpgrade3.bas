    s = ""
    s = s & "alter PROCEDURE [dbo].[Purch_DeleteAssembly]( " & vbCrLf
    s = s & "    @Community   VARCHAR(10)" & vbCrLf
    s = s & "   ,@Assembly    VARCHAR(20)" & vbCrLf
    s = s & "   ,@Model       VARCHAR(20)" & vbCrLf
    s = s & "   ,@OptionID    VARCHAR(20)" & vbCrLf
    s = s & "   ,@Workstation VARCHAR(30)" & vbCrLf
    s = s & "   ,@UserID      VARCHAR(10)" & vbCrLf
    s = s & "   ,@DivisionID INT" & vbCrLf
    s = s & ") AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "  DECLARE @AssemblyType INTEGER" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  INSERT INTO UserLog(Workstation,UserID,LogDate,LogTime,Task,Description)" & vbCrLf
    s = s & "  VALUES(@Workstation,@UserID,GETDATE(),CONVERT(VARCHAR(20),GETDATE(),108),'Delete Assembly','Assembly ''' + @Assembly + ''' deleted')" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  SET @AssemblyType = (SELECT AssemblyType FROM tblDBAssemblyMaster WHERE Community=@Community AND Assembly=@Assembly AND Model=@Model AND OptionID=@OptionID and DivisionID = @DivisionID )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  IF @AssemblyType=0 UPDATE tblModels        SET Assembly='' WHERE Area=@Community AND Assembly=@Assembly AND Model=@Model and DivisionID = @DivisionID" & vbCrLf
    s = s & "  IF @AssemblyType=2 UPDATE tblOptions       SET Assembly='' WHERE Area=@Community AND Assembly=@Assembly AND Model=@Model AND OPT=@OptionID and DivisionID = @DivisionID" & vbCrLf
    s = s & "  IF @AssemblyType=3 UPDATE tblGlobalOptions SET Assembly='' WHERE Community=@Community AND Assembly=@Assembly AND OPT=@OptionID and DivisionID = @DivisionID" & vbCrLf
    s = s & "  IF @AssemblyType=4 BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    UPDATE tblDCOptions " & vbCrLf
    s = s & "       SET Assembly=''" & vbCrLf
    s = s & "     WHERE Community=@Community AND Assembly=@Assembly AND OPT=@OptionID and DivisionID = @DivisionID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    UPDATE DCShoppingCart" & vbCrLf
    s = s & "       SET Assembly=''" & vbCrLf
    s = s & "      FROM DCShoppingCart s " & vbCrLf
    s = s & "           JOIN tblCustomers c ON(s.Customer_No=s.Customer_No) " & vbCrLf
    s = s & "     WHERE c.Community=@Community" & vbCrLf
    s = s & "       AND s.Assembly=@Assembly" & vbCrLf
    s = s & "       AND c.Model=@Model" & vbCrLf
    s = s & "       AND s.OPT=@OptionID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  DELETE FROM tblDBAssemblyMaster   WHERE Community=@Community AND Assembly=@Assembly AND Model=@Model AND OptionID=@OptionID and DivisionID = @DivisionID" & vbCrLf
    s = s & "  DELETE FROM tblDBAssemblyDetails  WHERE Community=@Community AND Assembly=@Assembly AND Model=@Model AND OptionID=@OptionID and DivisionID = @DivisionID" & vbCrLf
    s = s & "  DELETE FROM tblDBAssemblyPrices   WHERE Community=@Community AND Assembly=@Assembly AND Model=@Model AND OptionID=@OptionID " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
    

