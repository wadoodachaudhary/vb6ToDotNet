    s = s & "" & vbCrLf
    s = s & "--- create poitems" & vbCrLf
    s = s & "INSERT INTO POItems(DivisionID,PONumber,LineNumber,LineDescription,Description,Comments,OrderQty,rate,pretax,taxgroup,njctaxrate,jctaxrate,njctax,jctax,job,jccostcode,jccategory,EstPhase,EstItemID)" & vbCrLf
    s = s & "SELECT i.DivisionID,i.PONumber,i.RequestDetailID,i.Description,i.Description,i.Comments,i.POQty,i.PORate,i.POPretax,i.POTaxGroup,i.PONJCTaxRate,i.POJCTaxRate,i.PONJCTax,i.POJCTax,i.job,i.JCCostCode,i.JCCategory,'',i.EstItemID" & vbCrLf
    s = s & "from estimateitems i " & vbCrLf
