    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  -- ROLLBACK NEXTPOSEQ for job based ponumbers            " & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  IF @NumberingStyle='Job' BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE Jobc CURSOR FOR " & vbCrLf
    s = s & "      SELECT distinct job from pomaster where divisionid=@divisionid and pogenbatch=@batch" & vbCrLf
    s = s & "    OPEN Jobc " & vbCrLf
    s = s & "    FETCH NEXT FROM Jobc INTO @Job" & vbCrLf
    s = s & "    WHILE @@FETCH_STATUS <> -1 BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        select @MaxSeq = cast(max(right(ponumber,@Segment3)) as int)" & vbCrLf
    s = s & "        from pomaster " & vbCrLf
    s = s & "        where pogenbatch<>@batch " & vbCrLf
    s = s & "       and divisionid=@Divisionid" & vbCrLf
    s = s & "        and job=@job" & vbCrLf
    s = s & "        and isnumeric(right(ponumber,@Segment3))=1" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        update tblJobs " & vbCrLf
    s = s & "        set LastPOSeq=@MaxSeq " & vbCrLf
    s = s & "        where DivisionID=@DivisionID " & vbCrLf
    s = s & "        and Job_No=@Job" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      FETCH NEXT FROM Jobc INTO @Job" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "    CLOSE Jobc " & vbCrLf
    s = s & "    DEALLOCATE Jobc  " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  -- ROLLBACK NEXTPOSEQ for job/poindex based ponumber" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  END ELSE BEGIN IF @NumberingStyle='JobPOIndex' BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE JPOc CURSOR FOR" & vbCrLf
    s = s & "      SELECT distinct job,poindex from pomaster where divisionid=@divisionid and pogenbatch=@batch" & vbCrLf
    s = s & "    OPEN JPOc " & vbCrLf
    s = s & "    FETCH NEXT FROM JPOc INTO @Job,@POIndex" & vbCrLf
    s = s & "    WHILE @@FETCH_STATUS <> -1 BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        select @MaxSeq = cast(max(right(ponumber,@Segment8)) as int)" & vbCrLf
    s = s & "        from pomaster     " & vbCrLf
    s = s & "        where pogenbatch<>@batch " & vbCrLf
    s = s & "        and divisionid=@Divisionid" & vbCrLf
    s = s & "        and job=@job" & vbCrLf
    s = s & "        and poindex=@poindex" & vbCrLf
    s = s & "        and isnumeric(right(ponumber,@Segment8))=1" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        update jobpoindex " & vbCrLf
    s = s & "        set LastPOSeq=@MaxSeq " & vbCrLf
    s = s & "        where DivisionID=@DivisionID " & vbCrLf
    s = s & "        and Job_No=@Job" & vbCrLf
    s = s & "        and poindex=@poindex" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      FETCH NEXT FROM JPOc INTO @Job,@POIndex" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "    CLOSE JPOc " & vbCrLf
    s = s & "    DEALLOCATE JPOc  " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  -- ROLLBACK NEXTPOSEQ for sequential ponumber" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  END ELSE BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- not implemented. do not reset" & vbCrLf
    s = s & "    select @MaxSeq=0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  END END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  -- finally delete batch" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  delete pomaster where divisionid= @Divisionid and ponumber in(select ponumber from poitems where genbatch=@batch)" & vbCrLf
    s = s & "  delete pomaster where divisionid= @Divisionid and ponumber in(select ponumber from estimateitems where pogenbatch=@batch)" & vbCrLf
    s = s & "  delete poitems where genbatch=@batch" & vbCrLf
    s = s & "  update estimateitems set ponumber='',pogenbatch=0 where pogenbatch=@batch" & vbCrLf
    s = s & "  delete batches where batch=@batch" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
    
