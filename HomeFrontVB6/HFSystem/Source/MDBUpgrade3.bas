    s = ""
    s = s & "ALTER FUNCTION [dbo].[CalcInvoicePayDate](@InvDate Datetime, @TermNetType varchar(50), @TermNetDays int)" & vbCrLf
    s = s & "RETURNS Datetime AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "    DECLARE @x Datetime" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    select @x = case" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when @TermNetDays<>0 and @TermNetType='InAGivenNumberOfDays' then" & vbCrLf
    s = s & "        dateadd(dd, @TermNetDays, @InvDate)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when @TermNetDays<>0 and @TermNetType='NumberOfDaysAfterEOM' then" & vbCrLf
    s = s & "        dateadd(dd, @TermNetDays, cast(cast(year(@InvDate) as varchar) +'-'+ cast(isnull(nullif(month(@InvDate)+1,13),1) as varchar) +'-1' as datetime))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when @TermNetDays<>0 and ((@TermNetType='DayOfMonthAfterEOM') OR (@TermNetType='OnADayOfTheMonth' and day(@InvDate)>=@TermNetDays)) then" & vbCrLf
    s = s & "        dateadd(dd, @TermNetDays, cast(cast(year(@InvDate) as varchar) +'-'+ cast(isnull(nullif(month(@InvDate)+1,13),1) as varchar) +'-1' as datetime)-1)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when @TermNetDays<>0 and @TermNetType='OnADayOfTheMonth' then" & vbCrLf
    s = s & "        dateadd(dd, @TermNetDays, cast(cast(year(@InvDate) as varchar) +'-'+ cast(isnull(nullif(month(@InvDate),13),1) as varchar) +'-1' as datetime)-1)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    else" & vbCrLf
    s = s & "        null" & vbCrLf
    s = s & "    end " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    RETURN( @x )" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s


