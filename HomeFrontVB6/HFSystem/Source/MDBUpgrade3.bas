    s = s & " " & vbCrLf
    s = s & ",cast(case when ((select count(*) from invoiceitems where invoiceid=i.invoiceid)<1) then 1 else 0 end as bit) NoLines" & vbCrLf
    s = s & ",cast(case when ((select round(sum(pretax),2) from invoiceitems where invoiceid=i.invoiceid)<>round(i.pretax,2)) then 1 else 0 end as bit) PretaxDoesntBalance" & vbCrLf
    s = s & ",cast(case when ((select round(sum(tax),2) from invoiceitems where invoiceid=i.invoiceid)<>round(i.tax,2)) then 1 else 0 end as bit) TaxDoesntBalance" & vbCrLf
    s = s & ",cast(case when (isnull(d.job,'')<>'' or isnull(d.debitaccount,'')<>'') then 0 else 1 end as bit) JobOrAcctNeeded" & vbCrLf
    s = s & ",cast(case when (ao.optionvalue='4' and isnull(d.debitaccount,'')='') then 1 else 0 end as bit) AcctNeeded" & vbCrLf
    s = s & ",cast(case when (isnull(d.job,'')<>'' and (isnull(d.phase,'')='' or isnull(d.category,'')='')) then 1 else 0 end as bit) CCAndCatNeeded" & vbCrLf
    s = s & ",cast(case when (isnull(d.commitment,'')<>'' and pi.ponumber is null) then 1 else 0 end as bit) BadPO" & vbCrLf
    s = s & ",cast(case when (isnull(d.job,'')<>'' and j.job_no is null) then 1 else 0 end as bit) BadJob" & vbCrLf
    s = s & ",cast(case when (isnull(d.phase,'')<>'' and cc.costcode is null) then 1 else 0 end as bit) BadCostCode" & vbCrLf
    s = s & ",cast(case when (isnull(d.category,'')<>'' and c.category is null) then 1 else 0 end as bit) BadCategory" & vbCrLf
    s = s & ",cast(case when ((isnull(d.tax,0)<>0 or isnull(d.taxgroup,'')<>'') and g.taxgroup is null and tgr.optionvalue<>'False') then 1 else 0 end as bit) BadTaxgroup" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "from invoices i" & vbCrLf
    s = s & "left outer join invoiceitems d on i.invoiceid=d.invoiceid" & vbCrLf
    s = s & "left outer join tbljobs j on d.divisionid=j.divisionid and d.job=j.job_no" & vbCrLf
    s = s & "left outer join standardcostcodes cc on d.divisionid=cc.divisionid and d.phase=cc.costcode" & vbCrLf
    s = s & "left outer join standardcategories c on d.divisionid=c.divisionid and d.category=c.category" & vbCrLf
    s = s & "left outer join TaxGroups g on d.divisionid=g.divisionid and d.taxgroup=g.taxgroup" & vbCrLf
    s = s & "left outer join poitems pi on d.divisionid=pi.divisionid and d.commitment=pi.ponumber and d.commitmentitem=pi.linenumber" & vbCrLf
    s = s & "left outer join appoptions ao on d.divisionid=ao.divisionid and ao.optionname='AccountingSystem'" & vbCrLf
    s = s & "left outer join appoptions tgr on d.divisionid=tgr.divisionid and tgr.optionname='TaxGroupRequired'" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "where" & vbCrLf
    s = s & "    case when ((select count(*) from invoiceitems where invoiceid=i.invoiceid)<1) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when ((select round(sum(pretax),2) from invoiceitems where invoiceid=i.invoiceid)<>round(i.pretax,2)) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when ((select round(sum(tax),2) from invoiceitems where invoiceid=i.invoiceid)<>round(i.tax,2)) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when (isnull(d.job,'')<>'' or isnull(d.debitaccount,'')<>'') then 0 else 1 end =1" & vbCrLf
    s = s & "or case when (ao.optionvalue='4' and isnull(d.debitaccount,'')='') then 1 else 0 end =1" & vbCrLf
    s = s & "or case when (isnull(d.job,'')<>'' and (isnull(d.phase,'')='' or isnull(d.category,'')='')) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when (isnull(d.commitment,'')<>'' and pi.ponumber is null) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when (isnull(d.job,'')<>'' and j.job_no is null) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when (isnull(d.phase,'')<>'' and cc.costcode is null) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when (isnull(d.category,'')<>'' and c.category is null) then 1 else 0 end =1" & vbCrLf
    s = s & "or case when ((isnull(d.tax,0)<>0 or isnull(d.taxgroup,'')<>'') and g.taxgroup is null) then 1 else 0 end =1" & vbCrLf
    sql c, s
    
        
