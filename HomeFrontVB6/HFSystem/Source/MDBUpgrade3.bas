    s = s & ",left(x.itemdesc,200)itemdesc, i.Notes, x.qty,left(x.uom,10)uom,1,left(x.uom,10)uom,x.qty,x.qty" & vbCrLf
    s = s & ",case when x.ismodel=1 then c.model else '' end model" & vbCrLf
