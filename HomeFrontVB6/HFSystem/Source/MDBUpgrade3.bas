    s = ""
    s = s & "CREATE PROCEDURE [dbo].[BIM_ImportItemDB] @UserID varchar(10), @DivisionID int, @XmlString text as" & vbCrLf
    s = s & "DECLARE @idoc int" & vbCrLf
    s = s & "EXEC sp_xml_preparedocument @idoc OUTPUT, @XmlString" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "DECLARE @SessionID varchar(40)" & vbCrLf
    s = s & "SET @SessionID = NEWID() " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- load xml into staging --------------" & vbCrLf
    s = s & "insert ImportedBIMItemDB(SessionID,DivisionID,UserID,Phase,PhaseName,ProductID,Accuracy,Description,Name,Notes,UOM,RoundingRule,Waste)" & vbCrLf
    s = s & "select " & vbCrLf
    s = s & " @SessionID,@DivisionID,@UserID" & vbCrLf
    s = s & ",Phase,PhaseName,ProductID,Accuracy,Description,Name,Notes,UOM,RoundingRule,Waste" & vbCrLf
    s = s & "FROM OPENXML (@idoc, '/ArrayOfProductAndBuildingPhase/ProductAndBuildingPhase',2)" & vbCrLf
    s = s & "WITH (" & vbCrLf
    s = s & " Phase varchar(800) 'BuildingPhase/Code'" & vbCrLf
    s = s & ",PhaseName varchar(800) 'BuildingPhase/AbbreviatedName'" & vbCrLf
    s = s & ",Accuracy varchar(800) 'Product/Accuracy'" & vbCrLf
    s = s & ",Description varchar(800) 'Product/Description'" & vbCrLf
    s = s & ",ProductId varchar(800) 'Product/Id'" & vbCrLf
    s = s & ",Name varchar(800) 'Product/Name'" & vbCrLf
    s = s & ",Notes varchar(800) 'Product/Notes'" & vbCrLf
    s = s & ",UOM varchar(800) 'Product/ProductUnit/Abbreviation'" & vbCrLf
    s = s & ",UnitId varchar(800) 'Product/ProductUnit/Id'" & vbCrLf
    s = s & ",UnitName varchar(800) 'Product/ProductUnit/Name'" & vbCrLf
    s = s & ",ProjectedCost varchar(800) 'Product/ProjectedCost'" & vbCrLf
    s = s & ",RoundingRule varchar(800) 'Product/RoundingRule'" & vbCrLf
    s = s & ",SupplementalToBid varchar(800) 'Product/SupplementalToBid'" & vbCrLf
    s = s & ",Waste varchar(800) 'Product/Waste') x" & vbCrLf
    s = s & "where nullif(x.phase,'') is not null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- create items --------------" & vbCrLf
    s = s & "insert tblphaseitem(DivisionID,UStmp,TStmp,Phase,Item,ItemNumber,PhaseSortOrder,ItemSortOrder,PartNumber" & vbCrLf
    s = s & "    ,Description,Notes,POIndex,TakeoffUOM,OrderUOM,ConversionFactor,RoundDir,RoundTo,WastePercent)" & vbCrLf
    s = s & "select " & vbCrLf
    s = s & " x.DivisionID,x.UserID,getdate()" & vbCrLf
    s = s & ",x.phase" & vbCrLf
    s = s & ",x.productid+'M' Item" & vbCrLf
    s = s & ",x.productid ItemNumber" & vbCrLf
    s = s & ",cast(left(x.phase, patindex('%[^0-9]%', x.phase+'.') - 1) as int) PhaseSortOrder" & vbCrLf
    s = s & ",cast(left(x.productid, patindex('%[^0-9]%', x.productid+'.') - 1) as int) ItemSortOrder" & vbCrLf
    s = s & ",x.phase+'-'+x.productid PartNumber" & vbCrLf
    s = s & ",x.Description" & vbCrLf
    s = s & ",x.Notes" & vbCrLf
    s = s & ",x.phase POIndex" & vbCrLf
    s = s & ",x.uom TakeoffUOM" & vbCrLf
    s = s & ",x.uom OrderUOM" & vbCrLf
    s = s & ",1 ConversionFactor" & vbCrLf
    s = s & ",case x.roundingrule   --> theirs  0,1,2   = closest,up,down" & vbCrLf
    s = s & "    when 0 then 2      --> ours    0,1,2,3 = none,up,closest,down" & vbCrLf
    s = s & "    when 1 then 1" & vbCrLf
    s = s & "    when 2 then 3" & vbCrLf
    s = s & "    end RoundDir" & vbCrLf
    s = s & ",x.accuracy RoundTo       " & vbCrLf
    s = s & ",isnull((nullif(x.waste,0)-1)*100,0) WastePercent" & vbCrLf
    s = s & "from ImportedBIMItemDB x" & vbCrLf
    s = s & "left outer join tblphaseItem i on x.phase=i.phase and x.productid=i.itemnumber and i.divisionid=x.divisionid" & vbCrLf
    s = s & "where x.SessionID=@SessionID" & vbCrLf
    s = s & "and isnull(x.phase,'')<>''" & vbCrLf
    s = s & "and i.phase is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- update items --------------" & vbCrLf
    s = s & "update i set" & vbCrLf
    s = s & " Description = x.Description" & vbCrLf
    s = s & ",Notes = x.Notes" & vbCrLf
    s = s & ",POIndex = x.phase" & vbCrLf
    s = s & ",TakeoffUOM = x.uom" & vbCrLf
    s = s & ",OrderUOM = x.uom" & vbCrLf
    s = s & ",ConversionFactor = 1" & vbCrLf
    s = s & ",RoundDir = case x.roundingrule   --> theirs  0,1,2   = closest,up,down" & vbCrLf
    s = s & "    when 0 then 2      --> ours    0,1,2,3 = none,up,closest,down" & vbCrLf
