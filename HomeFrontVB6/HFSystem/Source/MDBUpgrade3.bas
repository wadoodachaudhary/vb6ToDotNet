    s = s & "alter FUNCTION dbo.ZYB_CastToInteger(@string VARCHAR(8000))" & vbCrLf
    s = s & "RETURNS bigint" & vbCrLf
    s = s & "AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "  DECLARE @IncorrectCharLoc SMALLINT" & vbCrLf
    s = s & "  SET @IncorrectCharLoc = PATINDEX('%[^0-9]%', @string)" & vbCrLf
    s = s & "  WHILE @IncorrectCharLoc > 0" & vbCrLf
    s = s & "  BEGIN" & vbCrLf
    s = s & "    SET @string = STUFF(@string, @IncorrectCharLoc, 1, '')" & vbCrLf
    s = s & "    SET @IncorrectCharLoc = PATINDEX('%[^0-9]%', @string)" & vbCrLf
    s = s & "  END" & vbCrLf
    s = s & "  SET @string = @string" & vbCrLf
    s = s & "  RETURN cast(@string as bigint)" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
    
    
