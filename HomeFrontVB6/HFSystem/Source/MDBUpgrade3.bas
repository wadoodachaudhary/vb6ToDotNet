    s = ""
    s = s & "create function dbo.BuildPro_ConCatPONum(@JobNumber varchar(40),@DocNumber varchar(40),@DocSuffix varchar(40)) returns varchar(40) as" & vbCrLf
    s = s & "begin" & vbCrLf
    s = s & "  declare @PONumber varchar(40)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  /* MPO doesnt return full ponumber. it breaks it into docnumber and suffix at either a - or a /" & vbCrLf
    s = s & "  *   eg:  JobNumber   ab-cd-ef           abc-def           abcdef           abcdef" & vbCrLf
    s = s & "  *        PONumber    ab-cd-ef/167       abc-def/167       abcdef/167       abcdef167" & vbCrLf
    s = s & "  *        docnumber   ab                 abcdef            abcdef167" & vbCrLf
    s = s & "  *        docsuffix   cd-ef/167          def/167           167              nil" & vbCrLf
    s = s & "  */" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "  select @PONumber = case " & vbCrLf
    s = s & "  when charindex('-',@jobnumber)<>0 then @DocNumber + '-' + @DocSuffix" & vbCrLf
    s = s & "  else @DocNumber + isnull('/' + nullif(@DocSuffix,''),'')" & vbCrLf
    s = s & "  end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  return @PONumber" & vbCrLf
    s = s & "end" & vbCrLf
    sql c, s


    s = ""
    s = s & "alter PROCedure dbo.BuildProSOAP_DoMPO  @idoc int, @DivisionID int, @XmlString xml  AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "UPDATE m SET" & vbCrLf
    s = s & " isMPO = 1" & vbCrLf
    s = s & ",MPOReceived = 1" & vbCrLf
    s = s & ",DateSentToBuildPro = null" & vbCrLf
    s = s & "FROM OPENXML (@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_MPOExport/MPOLineItem',2) " & vbCrLf
    s = s & "WITH(JobNumber varchar(40)" & vbCrLf
    s = s & "    ,DocNumber varchar(40)" & vbCrLf
    s = s & "    ,DocSuffix varchar(40) ) x" & vbCrLf
    s = s & "JOIN POMaster m on m.DivisionID=@DivisionID and m.PONumber=dbo.BuildPro_ConCatPONum(x.JobNumber,x.DocNumber,x.DocSuffix)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "UPDATE p SET" & vbCrLf
    s = s & "OrderQty = x.QtyUsed" & vbCrLf
    s = s & ",Pretax = Round(x.QtyUsed * p.Rate,2)" & vbCrLf
    s = s & ",JCTax = p.JCTaxRate/100 * Round(x.QtyUsed * p.Rate,2)" & vbCrLf
    s = s & ",NJCTax = p.NJCTaxRate/100 * Round(x.QtyUsed * p.Rate,2)" & vbCrLf
    s = s & "FROM OPENXML (@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_MPOExport/MPOLineItem',2) " & vbCrLf
    s = s & "WITH(JobNumber varchar(40)" & vbCrLf
    s = s & "    ,DocNumber varchar(40)" & vbCrLf
    s = s & "    ,DocSuffix varchar(40)" & vbCrLf
    s = s & "    ,LineNumber  float       'DocLineNumber'" & vbCrLf
    s = s & "    ,QtyUsed     float       'QtyUsed') x" & vbCrLf
    s = s & "join BuildPro_POs_Items poi on poi.DivisionID=@DivisionID and poi.PONumber=dbo.BuildPro_ConCatPONum(x.JobNumber,x.DocNumber,x.DocSuffix) and poi.LineNumber=x.LineNumber" & vbCrLf
    s = s & "JOIN POItems p on p.ItemSeq=poi.itemseq" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "UPDATE e SET" & vbCrLf
    s = s & "POQty = x.QtyUsed" & vbCrLf
    s = s & ",POPretax = Round(x.QtyUsed * p.Rate,2)" & vbCrLf
    s = s & ",POJCTax = Round(p.JCTaxRate/100 * Round(x.QtyUsed * p.Rate,2),2)" & vbCrLf
    s = s & ",PONJCTax = Round(p.NJCTaxRate/100 * Round(x.QtyUsed * p.Rate,2),2)" & vbCrLf
    s = s & ",BudgetQty = case when a.BudgetsLocked=1 then e.BudgetQty else x.QtyUsed end" & vbCrLf
    s = s & ",BudgetPretax = case when a.BudgetsLocked=1 then e.BudgetPretax else Round(x.QtyUsed * p.Rate,2) end" & vbCrLf
    s = s & ",BudgetJCTax = case when a.BudgetsLocked=1 then e.BudgetJCTax else round(p.JCTaxRate/100 * Round(x.QtyUsed * p.Rate,2),2) end" & vbCrLf
    s = s & ",BudgetNJCTax = case when a.BudgetsLocked=1 then e.BudgetNJCTax else round(p.NJCTaxRate/100 * Round(x.QtyUsed * p.Rate,2),2) end" & vbCrLf
    s = s & "FROM OPENXML (@idoc, 'SOAP-ENV:Envelope/SOAP-ENV:Body/JDEOW_MPOExport/MPOLineItem',2) " & vbCrLf
    s = s & "WITH(JobNumber varchar(40)" & vbCrLf
    s = s & "    ,DocNumber varchar(40)" & vbCrLf
    s = s & "    ,DocSuffix varchar(40)" & vbCrLf
    s = s & "    ,LineNumber  float       'DocLineNumber'" & vbCrLf
    s = s & "    ,QtyUsed     float       'QtyUsed') x" & vbCrLf
    s = s & "join BuildPro_POs_Items poi on poi.DivisionID=@DivisionID and poi.PONumber=dbo.BuildPro_ConCatPONum(x.JobNumber,x.DocNumber,x.DocSuffix) and poi.LineNumber=x.LineNumber" & vbCrLf
    s = s & "JOIN POItems p on p.ItemSeq=poi.itemseq" & vbCrLf
    s = s & "JOIN EstimateItems e on p.EstItemID=e.EstItemID" & vbCrLf
    s = s & "JOIN EstimateAssemblies a on e.EstAssemblyID=e.EstAssemblyID" & vbCrLf
    sql c, s


