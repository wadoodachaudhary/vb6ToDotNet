c = "Add MYOB 2016.3 integration points"
    sql c, "alter table tblvendors add PayTermDiscType varchar(20)"
    sql c, "sp_RENAME 'tblVendors.PayTermDisc' , 'PayTermDiscPercent', 'COLUMN'"
    sql c, "sp_RENAME 'tblVendors.PayTermType' , 'PayTermNetType', 'COLUMN'"
    sql c, "alter table tblvendors drop column payterms"
    sql c, "update tblvendors set paytermnettype = 'InAGivenNumberofDays' where paytermnettype='Number of days'"
    sql c, "update tblvendors set paytermnettype = 'OnADayOfTheMonth' where paytermnettype='Day of month'"
    sql c, "update tblvendors set paytermnettype = 'DayOfMonthAfterEOM' where paytermnettype='Day of next month'"
    sql c, "update tblvendors set paytermdisctype = 'InAGivenNumberofDays' where paytermdiscdays<>0"

    s = ""
    s = s & "alter table tblvendors add PaymentTerms as" & vbCrLf
    s = s & "isnull(" & vbCrLf
    s = s & "case when isnull(paytermdiscpercent,0)=0 then null " & vbCrLf
    s = s & "     when PayTermDiscDays=1 and PayTermDiscType='OnADayOfTheMonth'     then cast(paytermdiscpercent as varchar) + '% ' + cast(PayTermDiscDays as varchar) + 'st'" & vbCrLf
    s = s & "     when PayTermDiscDays=1 and PayTermDiscType='DayOfMonthAfterEOM'   then cast(paytermdiscpercent as varchar) + '% ' + cast(PayTermDiscDays as varchar) + 'st after EOM'" & vbCrLf
    s = s & "     when PayTermDiscDays=2 and PayTermDiscType='OnADayOfTheMonth'     then cast(paytermdiscpercent as varchar) + '% ' + cast(PayTermDiscDays as varchar) + 'nd'" & vbCrLf
    s = s & "     when PayTermDiscDays=2 and PayTermDiscType='DayOfMonthAfterEOM'   then cast(paytermdiscpercent as varchar) + '% ' + cast(PayTermDiscDays as varchar) + 'nd after EOM'" & vbCrLf
    s = s & "     when PayTermDiscDays=3 and PayTermDiscType='OnADayOfTheMonth'     then cast(paytermdiscpercent as varchar) + '% ' + cast(PayTermDiscDays as varchar) + 'rd'" & vbCrLf
    s = s & "     when PayTermDiscDays=3 and PayTermDiscType='DayOfMonthAfterEOM'   then cast(paytermdiscpercent as varchar) + '% ' + cast(PayTermDiscDays as varchar) + 'rd after EOM'" & vbCrLf
    s = s & "     when PayTermDiscType='OnADayOfTheMonth'     then cast(paytermdiscpercent as varchar) + '% ' + cast(PayTermDiscDays as varchar) + 'th'" & vbCrLf
    s = s & "     when PayTermDiscType='DayOfMonthAfterEOM'   then cast(paytermdiscpercent as varchar) + '% ' + cast(PayTermDiscDays as varchar) + 'th after EOM'" & vbCrLf
    s = s & "     when PayTermDiscType='NumberOfDaysAfterEOM' then cast(paytermdiscpercent as varchar) + '% ' + cast(PayTermDiscDays as varchar) + ' after EOM'" & vbCrLf
    s = s & "     when PayTermDiscType='InAGivenNumberOfDays' then cast(paytermdiscpercent as varchar) + '% ' + cast(PayTermDiscDays as varchar) " & vbCrLf
    s = s & "     else null end" & vbCrLf
    s = s & "+ ', ','') +" & vbCrLf
    s = s & "case when PayTermNetDays=1 and PayTermNetType='OnADayOfTheMonth'     then 'Net ' + cast(PayTermNetDays as varchar) + 'st'" & vbCrLf
    s = s & "     when PayTermNetDays=1 and PayTermNetType='DayOfMonthAfterEOM'   then 'Net ' + cast(PayTermNetDays as varchar) + 'st after EOM'" & vbCrLf
