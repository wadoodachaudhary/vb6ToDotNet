    s = s & "   ,@Phase          VARCHAR(20)" & vbCrLf
    s = s & "   ,@Item           VARCHAR(16)" & vbCrLf
    s = s & "   ,@Sequence       INTEGER" & vbCrLf
    s = s & "   ,@Vendor         VARCHAR(40)" & vbCrLf
    s = s & "   ,@EffectiveDate  DATETIME" & vbCrLf
    s = s & "   ,@DivisionID     INTEGER)" & vbCrLf
    s = s & "RETURNS FLOAT AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "    DECLARE @POIndex VARCHAR(20)" & vbCrLf
    s = s & "    IF @Vendor='' BEGIN" & vbCrLf
    s = s & "       SET @POIndex=(SELECT POIndex FROM tbldbassemblydetails WHERE DivisionID = @DivisionID and sequence = @Sequence and Phase=@Phase AND Item=@Item)" & vbCrLf
    s = s & "       IF isnull(@POINDEX,'')='' BEGIN" & vbCrLf
    s = s & "   SET @POIndex=(SELECT POIndex FROM tblphaseitem WHERE DivisionID = @DivisionID and Phase=@Phase AND Item=@Item)" & vbCrLf
    s = s & "       END" & vbCrLf
    s = s & "        SET @Vendor=dbo.Purch_GetCommunityVendor(@Community,@POIndex,@DivisionID)" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "    DECLARE @datasource INTEGER" & vbCrLf
    s = s & "    DECLARE @rate FLOAT" & vbCrLf
    s = s & "    DECLARE rates CURSOR FOR" & vbCrLf
    s = s & "    SELECT 4 DataSource,'Rate' = CASE " & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate>=c.Next_Effective2 and c.Next_Effective2 is not null THEN c.Next_Cost2" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate>=c.Next_Effective1 and c.Next_Effective1 is not null THEN c.Next_Cost1" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate<c.Last3_Expiry and c.Last3_Expiry is not null THEN c.Last_Cost3" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate<c.Last2_Expiry and c.Last2_Expiry is not null THEN c.Last_Cost2" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate<c.Last1_Expiry and c.Last1_Expiry is not null THEN c.Last_Cost1" & vbCrLf
    s = s & "           WHEN @LookupType=0 THEN c.Current_Cost" & vbCrLf
    s = s & "           WHEN @LookupType=1 THEN c.Current_Cost" & vbCrLf
    s = s & "           WHEN @LookupType=2 THEN case when isnull(c.Next_Cost1,0) = 0 then c.Current_Cost else c.Next_Cost1 end" & vbCrLf
    s = s & "           WHEN @LookupType=3 THEN case when isnull(c.Next_Cost2,0) = 0 then c.Current_Cost else c.Next_Cost2 end" & vbCrLf
    s = s & "           WHEN @LookupType=4 THEN c.Last_Cost1" & vbCrLf
    s = s & "           WHEN @LookupType=5 THEN c.Last_Cost2" & vbCrLf
    s = s & "           WHEN @LookupType=6 THEN c.Last_Cost3" & vbCrLf
    s = s & "           WHEN @LookupType=7 THEN c.Forecast1" & vbCrLf
    s = s & "           WHEN @LookupType=8 THEN c.Forecast2" & vbCrLf
    s = s & "           WHEN @LookupType=9 THEN c.Forecast3" & vbCrLf
    s = s & "           WHEN @LookupType=10 THEN c.Forecast4" & vbCrLf
    s = s & "           WHEN @LookupType=11 THEN c.Forecast5" & vbCrLf
    s = s & "           WHEN @LookupType=12 THEN c.Forecast6" & vbCrLf
    s = s & "           WHEN @LookupType=13 THEN c.Forecast7" & vbCrLf
    s = s & "           WHEN @LookupType=14 THEN c.Forecast8" & vbCrLf
    s = s & "           WHEN @LookupType=15 THEN c.Forecast9" & vbCrLf
    s = s & "           WHEN @LookupType=16 THEN c.Forecast10" & vbCrLf
    s = s & "           WHEN @LookupType=17 THEN c.Forecast11" & vbCrLf
    s = s & "           ELSE c.Forecast12 END" & vbCrLf
    s = s & "      FROM tblVendorCost c      " & vbCrLf
    s = s & "     WHERE c.Community=@Community " & vbCrLf
    s = s & "       AND c.CommunityPhase=@CommunityPhase" & vbCrLf
    s = s & "       AND c.Assembly=@Assembly" & vbCrLf
    s = s & "       AND isnull(c.Model,'')=@Model" & vbCrLf
    s = s & "       AND c.Phase=@Phase" & vbCrLf
    s = s & "       AND c.Item=@Item" & vbCrLf
    s = s & "       AND c.Vendor=@Vendor" & vbCrLf
    s = s & "       AND c.DivisionID = @DivisionID" & vbCrLf
    s = s & "    UNION ALL" & vbCrLf
    s = s & "    SELECT 5 DataSource,'Rate' = CASE " & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate>=c.Next_Effective2 and c.Next_Effective2 is not null THEN c.Next_Cost2" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate>=c.Next_Effective1 and c.Next_Effective1 is not null THEN c.Next_Cost1" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate<c.Last3_Expiry and c.Last3_Expiry is not null THEN c.Last_Cost3" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate<c.Last2_Expiry and c.Last2_Expiry is not null THEN c.Last_Cost2" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate<c.Last1_Expiry and c.Last1_Expiry is not null THEN c.Last_Cost1" & vbCrLf
    s = s & "           WHEN @LookupType=0 THEN c.Current_Cost" & vbCrLf
    s = s & "           WHEN @LookupType=1 THEN c.Current_Cost" & vbCrLf
    s = s & "           WHEN @LookupType=2 THEN case when isnull(c.Next_Cost1,0) = 0 then c.Current_Cost else c.Next_Cost1 end" & vbCrLf
