    s = ""
    s = s & "alter PROCEDURE dbo.CalculateTime(" & vbCrLf
    s = s & "    @DivisionID  INT" & vbCrLf
    s = s & "   ,@WorkTicket  VARCHAR(15)" & vbCrLf
    s = s & "   ,@Sequence    INTEGER)   " & vbCrLf
    s = s & "AS BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @NoOTCalc    BIT" & vbCrLf
    s = s & "    DECLARE @IsStatDay   BIT" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- get stuff from item record" & vbCrLf
    s = s & "    SELECT @IsStatDay = case when h.StatDay is null then 0 else 1 end" & vbCrLf
    s = s & "          ,@NoOTCalc  = ISNULL(i.NoOTCalc,0)" & vbCrLf
    s = s & "      FROM labouritems i" & vbCrLf
    s = s & "      LEFT OUTER JOIN StatHolidays h ON(i.ItemDate=h.StatDay)" & vbCrLf
    s = s & "     WHERE i.DivisionID=@DivisionID" & vbCrLf
    s = s & "       AND i.workticket=@Workticket" & vbCrLf
    s = s & "       AND i.sequence=@Sequence" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- if marked no ot then skip it." & vbCrLf
    s = s & "    IF @NoOTCalc=1 BEGIN" & vbCrLf
    s = s & "        SELECT STQty,OTQty,DTQty,TravelQty,Misc1Qty,Misc2Qty,Misc3Qty" & vbCrLf
    s = s & "          FROM LabourItems" & vbCrLf
    s = s & "         WHERE DivisionID = @DivisionID" & vbCrLf
    s = s & "           AND WorkTicket = @WorkTicket" & vbCrLf
    s = s & "           AND Sequence = @Sequence" & vbCrLf
    s = s & "        RETURN" & vbCrLf
    s = s & "    END " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- if workday is a stat then call stat proc else call normal time proc" & vbCrLf
    s = s & "    IF @IsStatDay=1 " & vbCrLf
    s = s & "        EXEC CalculateStatTime @DivisionID, @Workticket, @Sequence" & vbCrLf
    s = s & "    ELSE" & vbCrLf
    s = s & "        EXEC CalculateOverTime @DivisionID, @Workticket, @Sequence" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s

