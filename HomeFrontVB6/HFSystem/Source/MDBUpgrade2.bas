    s = ""
    s = s & "create Function dbo.fn_Parsename(@Message Varchar(1000), @delimiter char(1), @index int )" & vbCrLf
    s = s & "Returns Varchar(1000)" & vbCrLf
    s = s & "As" & vbCrLf
    s = s & "Begin" & vbCrLf
    s = s & "    Declare" & vbCrLf
    s = s & "        @curIndex int = 0," & vbCrLf
    s = s & "        @pos int = 1," & vbCrLf
    s = s & "        @prevPos int = 0," & vbCrLf
    s = s & "        @result varchar(1000)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    while @pos > 0" & vbCrLf
    s = s & "    Begin" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        set @pos =  CHARINDEX(@delimiter, @Message, @prevPos);" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        if(@pos > 0)" & vbCrLf
    s = s & "        begin-- get the chars between the prev position to next delimiter pos" & vbCrLf
    s = s & "            set @result = SUBSTRING(@message, @prevPos, @pos-@prevPos)" & vbCrLf
    s = s & "        end" & vbCrLf
    s = s & "        else" & vbCrLf
    s = s & "        begin--get last delim message" & vbCrLf
    s = s & "            set @result = SUBSTRING(@message, @prevPos, LEN(@message))" & vbCrLf
    s = s & "        end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        if(@index = @curIndex)" & vbCrLf
    s = s & "        begin" & vbCrLf
    s = s & "            return @result" & vbCrLf
    s = s & "        end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        set @prevPos = @pos + 1" & vbCrLf
    s = s & "        set @curIndex = @curIndex + 1;" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    end" & vbCrLf
    s = s & "    return ''--not found" & vbCrLf
    s = s & "End" & vbCrLf
    sql c, s, True
    
