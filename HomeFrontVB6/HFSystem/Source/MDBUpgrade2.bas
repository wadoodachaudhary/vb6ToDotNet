    s = s & "            set cost = @totalcost" & vbCrLf
    s = s & "               ,landcost = @landcost" & vbCrLf
    s = s & "               ,incentivecost = @incentivecost" & vbCrLf
    s = s & "               ,constructioncost = @totalcost - @incentivecost - @landcost" & vbCrLf
    s = s & "            where worksheet = @SalesSheet " & vbCrLf
