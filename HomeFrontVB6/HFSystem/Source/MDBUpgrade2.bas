    s = ""
    s = s & "alter PROCEDURE [dbo].[QB_TaxGroups] @XmlString text as" & vbCrLf
    s = s & "DECLARE @idoc int" & vbCrLf
    s = s & "EXEC sp_xml_preparedocument @idoc OUTPUT, @XmlString " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "-- groups" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "SELECT 'grp' type ,TAXGRP.TaxGroup" & vbCrLf
    s = s & "      ,TAXGRP.ExternalID" & vbCrLf
    s = s & "      ,TAXGRP.Description" & vbCrLf
    s = s & "      ,SUM(TAXRATE.TaxRate) GroupRate" & vbCrLf
    s = s & "      ,0 JCRate" & vbCrLf
    s = s & "      ,SUM(TAXRATE.TaxRate) NJCRate" & vbCrLf
    s = s & "FROM OPENXML (@idoc, '/QBXML/QBXMLMsgsRs/ItemQueryRs/ItemSalesTaxGroupRet/ItemSalesTaxRef',2)" & vbCrLf
    s = s & "WITH (TaxGroup        varchar(40) '../ItemDesc'" & vbCrLf
    s = s & "     ,ExternalID      varchar(40) '../ListID'" & vbCrLf
    s = s & "     ,Description     varchar(40) '../ItemDesc'" & vbCrLf
    s = s & "     ,RateID          varchar(40) 'ListID') TAXGRP " & vbCrLf
    s = s & "JOIN OPENXML (@idoc, '/QBXML/QBXMLMsgsRs/ItemQueryRs/ItemSalesTaxRet',2)" & vbCrLf
    s = s & "WITH (RateID      varchar(40) 'ListID'" & vbCrLf
    s = s & "     ,TaxRate     float       'TaxRate') TAXRATE ON taxgrp.RateID=taxrate.RateID" & vbCrLf
    s = s & "GROUP BY TAXGRP.TaxGroup, TAXGRP.ExternalID, TAXGRP.Description" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "UNION -- items" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "SELECT 'item' type ,TaxGroup, ExternalID, Description, TaxRate GroupRate, 0 JCRate, TaxRate NJCRate" & vbCrLf
    s = s & "FROM OPENXML (@idoc, '/QBXML/QBXMLMsgsRs/ItemQueryRs/ItemSalesTaxRet',2)" & vbCrLf
    s = s & "WITH (TaxGroup        varchar(40) 'Name'" & vbCrLf
    s = s & "     ,ExternalID      varchar(40) 'ListID'" & vbCrLf
    s = s & "     ,Description     varchar(40) 'Name'" & vbCrLf
    s = s & "     ,TaxRate         float       'TaxRate') " & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "UNION -- codes with groups" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "SELECT 'code w grp' type ,taxcode.TaxGroup" & vbCrLf
    s = s & "      ,taxcode.ExternalID" & vbCrLf
    s = s & "      ,taxcode.Description" & vbCrLf
    s = s & "      ,SUM(taxrate.TaxRate) GroupRate" & vbCrLf
    s = s & "      ,0 JCRate" & vbCrLf
    s = s & "      ,SUM(taxrate.TaxRate) NJCRate" & vbCrLf
    s = s & "FROM OPENXML (@idoc, '/QBXML/QBXMLMsgsRs/SalesTaxCodeQueryRs/SalesTaxCodeRet',2)" & vbCrLf
    s = s & "WITH (TaxGroup    varchar(3)  'Name'" & vbCrLf
    s = s & "     ,ExternalID  varchar(40) 'ListID'" & vbCrLf
    s = s & "     ,Description varchar(30) 'Desc'" & vbCrLf
    s = s & "     ,GrpID       varchar(40) 'ItemPurchaseTaxRef/ListID') TAXCODE" & vbCrLf
    s = s & "JOIN OPENXML (@idoc, '/QBXML/QBXMLMsgsRs/ItemQueryRs/ItemSalesTaxGroupRet/ItemSalesTaxRef',2)" & vbCrLf
    s = s & "WITH (GrpID      varchar(40) '../ListID'" & vbCrLf
    s = s & "     ,RateID     varchar(40) 'ListID') TAXGRP ON taxcode.GrpID=taxgrp.GrpID" & vbCrLf
    s = s & "JOIN OPENXML (@idoc, '/QBXML/QBXMLMsgsRs/ItemQueryRs/ItemSalesTaxRet',2)" & vbCrLf
    s = s & "WITH (RateID      varchar(40) 'ListID'" & vbCrLf
    s = s & "     ,TaxRate     float       'TaxRate') TAXRATE ON taxgrp.RateID=taxrate.RateID" & vbCrLf
    s = s & "GROUP BY " & vbCrLf
    s = s & "       taxcode.TaxGroup" & vbCrLf
    s = s & "      ,taxcode.ExternalID" & vbCrLf
    s = s & "      ,taxcode.Description" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "UNION  -- codes with items" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "SELECT 'code w item' type ,taxcode.TaxGroup" & vbCrLf
    s = s & "      ,taxcode.ExternalID" & vbCrLf
    s = s & "      ,taxcode.Description" & vbCrLf
    s = s & "      ,SUM(taxrate.TaxRate) GroupRate" & vbCrLf
    s = s & "      ,0 JCRate" & vbCrLf
    s = s & "      ,SUM(taxrate.TaxRate) NJCRate" & vbCrLf
    s = s & "FROM OPENXML (@idoc, '/QBXML/QBXMLMsgsRs/SalesTaxCodeQueryRs/SalesTaxCodeRet',2)" & vbCrLf
    s = s & "WITH (TaxGroup    varchar(3)  'Name'" & vbCrLf
    s = s & "     ,ExternalID  varchar(40) 'ListID'" & vbCrLf
    s = s & "     ,Description varchar(30) 'Desc'" & vbCrLf
    s = s & "     ,GrpID       varchar(40) 'ItemPurchaseTaxRef/ListID') TAXCODE" & vbCrLf
    s = s & "JOIN OPENXML (@idoc, '/QBXML/QBXMLMsgsRs/ItemQueryRs/ItemSalesTaxRet',2)" & vbCrLf
    s = s & "WITH (RateID      varchar(40) 'ListID'" & vbCrLf
    s = s & "     ,TaxRate     float       'TaxRate') TAXRATE ON taxcode.GrpID=taxrate.RateID" & vbCrLf
    s = s & "GROUP BY " & vbCrLf
    s = s & "       taxcode.TaxGroup" & vbCrLf
    s = s & "      ,taxcode.ExternalID" & vbCrLf
    s = s & "      ,taxcode.Description" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "UNION  -- codes with neither" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "SELECT 'code w nil' type ,taxcode.TaxGroup" & vbCrLf
    s = s & "      ,taxcode.ExternalID" & vbCrLf
    s = s & "      ,taxcode.Description" & vbCrLf
    s = s & "      ,0 GroupRate" & vbCrLf
    s = s & "      ,0 JCRate" & vbCrLf
    s = s & "      ,0 NJCRate" & vbCrLf
    s = s & "FROM OPENXML (@idoc, '/QBXML/QBXMLMsgsRs/SalesTaxCodeQueryRs/SalesTaxCodeRet',2)" & vbCrLf
    s = s & "WITH (TaxGroup    varchar(3)  'Name'" & vbCrLf
    s = s & "     ,ExternalID  varchar(40) 'ListID'" & vbCrLf
    s = s & "     ,Description varchar(30) 'Desc'" & vbCrLf
    s = s & "     ,GrpID       varchar(40) 'ItemPurchaseTaxRef/ListID') TAXCODE" & vbCrLf
    s = s & "where isnull(GrpID,'')=''" & vbCrLf
    sql c, s

    Call Revisions_2018_01a
End Sub

Private Sub Revisions_2018_01a()
Dim c As String
Dim s As String

c = "Add assembly components to Precision Builder"
    s = ""
    s = s & "create table dbo.tblDBAssemblyComponents(" & vbCrLf
    s = s & " ParentAssemblyID int" & vbCrLf
    s = s & ",ComponentAssemblyID int" & vbCrLf
