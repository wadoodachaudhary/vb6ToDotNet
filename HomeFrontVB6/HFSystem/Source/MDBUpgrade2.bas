    s = s & "ALTER FUNCTION [dbo].[AutoReports_GetNextRun] (@FrequencyType varchar(50),@FrequencyValue int,@LastRun datetime)  " & vbCrLf
    s = s & "RETURNS DateTime " & vbCrLf
    s = s & "AS  " & vbCrLf
    s = s & "BEGIN " & vbCrLf
    s = s & "   DECLARE" & vbCrLf
    s = s & "        @NextRun DateTime" & vbCrLf
    s = s & "        if @LastRun<getdate() Set @LastRun = getdate()" & vbCrLf
    s = s & "        IF (@FrequencyType = 'Day of week')            " & vbCrLf
    s = s & "           SET @NextRun = (SELECT CASE(@FrequencyValue)" & vbCrLf
    s = s & "                                   WHEN 0 THEN DATEADD(dd,1,@LastRun)" & vbCrLf
    s = s & "                                   ELSE DATEADD(wk ,1,@LastRun)" & vbCrLf
    s = s & "                                 END)" & vbCrLf
    s = s & "        ELSE  IF (@FrequencyType = 'Day of month')       " & vbCrLf
    s = s & "   SET @NextRun = (SELECT " & vbCrLf
    s = s & "                     CASE(@FrequencyValue)" & vbCrLf
    s = s & "                       WHEN 0 THEN DATEADD(s,-1,DATEADD(mm, DATEDIFF(m,0,@LastRun)+2,0))" & vbCrLf
    s = s & "                       ELSE DATEADD(mm,1,@LastRun)" & vbCrLf
    s = s & "                      END)" & vbCrLf
    s = s & "        ELSE  IF (@FrequencyType = 'Every nth week')           " & vbCrLf
    s = s & "   SET @NextRun = DATEADD(week,@FrequencyValue,@LastRun)" & vbCrLf
    s = s & "        ELSE  IF (@FrequencyType = 'Every nth month')  " & vbCrLf
    s = s & "   SET @NextRun =  DATEADD(mm,@FrequencyValue,@LastRun) " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        RETURN @NextRun" & vbCrLf
    s = s & "END" & vbCrLf
