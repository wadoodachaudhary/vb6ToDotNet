    s = s & "join librarytasks l on s.librarytaskid=l.taskid" & vbCrLf
    s = s & "where s.scheduleid=@ScheduleID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--UPDATE THE PARENT ID TO TRANSLATE THE SCHEDULE TASK ID TO THE NEW TEMPLATE TASK ID" & vbCrLf
    s = s & "update t" & vbCrLf
    s = s & "set parentid = isnull(p.taskid,0)" & vbCrLf
    s = s & "from templatetasks t" & vbCrLf
    s = s & "left outer join templatetasks p on t.templateid=p.templateid and t.parentid=p.ttid" & vbCrLf
    s = s & "where t.templateid=@NewTemplateID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--INSERT CONSTRAINTS REMEMBERING TO TRANSLATE THE SCHEDULE TASK ID TO THE NEW TEMPLATE TASK ID" & vbCrLf
    s = s & "insert into templateconstraints(TemplateID, FromTaskID, ToTaskID, ConstraintType)" & vbCrLf
    s = s & "select @NewTemplateID,ft.taskid,tt.taskid,c.constrainttype" & vbCrLf
    s = s & "from scheduletasks t" & vbCrLf
    s = s & "join scheduleconstraints c on t.scheduletaskid=c.fromscheduletaskid" & vbCrLf
    s = s & "left outer join templatetasks ft on ft.templateid=@NewTemplateID and ft.ttID=c.fromscheduletaskid" & vbCrLf
    s = s & "left outer join templatetasks tt on tt.templateid=@NewTemplateID and tt.ttID=c.toscheduletaskid" & vbCrLf
    s = s & "where t.scheduleid=@ScheduleID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--REMOVE THE OLD SCHEDULE TASK ID FROM THE TEMPLATE TASKS" & vbCrLf
    s = s & "update templatetasks set ttID=null where templateid=@NewTemplateID" & vbCrLf
    sql c, s
    
    Call Revisions_2016_12
End Sub


