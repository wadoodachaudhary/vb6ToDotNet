    s = ""
    s = s & "ALTER PROCEDURE [dbo].[Purch_PutEstimateAssemblyItems](@EstAssemblyID INTEGER,@JCCategory VARCHAR(40),@DivisionID INTEGER) AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @Community          VARCHAR(10)" & vbCrLf
    s = s & "    DECLARE @CommunityPhase     VARCHAR(10)" & vbCrLf
    s = s & "    DECLARE @Customer_No        VARCHAR(12)" & vbCrLf
    s = s & "    DECLARE @EstIndex           INTEGER" & vbCrLf
    s = s & "    DECLARE @Model              VARCHAR(20)" & vbCrLf
    s = s & "    DECLARE @OptionID           VARCHAR(20)" & vbCrLf
    s = s & "    DECLARE @SalesWorksheet     INTEGER" & vbCrLf
    s = s & "    DECLARE @Assembly           VARCHAR(20)" & vbCrLf
    s = s & "    DECLARE @AssemblyType       INTEGER" & vbCrLf
    s = s & "    DECLARE @TakeoffRequired    BIT" & vbCrLf
    s = s & "    DECLARE @UseSalesSheetCosts BIT" & vbCrLf
    s = s & "    DECLARE @Unit               VARCHAR(10)" & vbCrLf
    s = s & "    DECLARE @UnitsAsExtra       BIT" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE Assembly CURSOR FOR" & vbCrLf
    s = s & "    SELECT c.Community, c.Phase, c.Customer_No,isnull(c.Unit_No,''),isnull(s.MultiUnitsAsExtras,0), a.EstimateIndex, CASE WHEN a.AssemblyType = 0 OR a.AssemblyType = 2 THEN a.Model ELSE '' END Model,a.OptionID, a.SalesWorksheet, a.Assembly,a.AssemblyType,ISNULL(m.TakeoffRequired,0) TakeoffRequired,CASE WHEN ISNULL(o.optionvalue,'True')='True' then 1 else 0 end UseSalesSheetCosts" & vbCrLf
    s = s & "      FROM EstimateAssemblies a" & vbCrLf
    s = s & "           join system_setup s on s.id=@DivisionID" & vbCrLf
    s = s & "           LEFT OUTER JOIN AppOptions o on(o.uid='' and o.optionname='RecordSalesSheetCosts')" & vbCrLf
    s = s & "           JOIN tblCustomers c ON(a.Customer_No=c.Customer_No)" & vbCrLf
    s = s & "           LEFT JOIN tblDBAssemblyMaster m ON(m.Community=dbo.Purch_GetAssemblyCommunity(a.Assembly,CASE WHEN (a.AssemblyType=3 OR a.AssemblyType=4) THEN '' ELSE a.Model END,a.OptionID,c.Community,@DivisionID)" & vbCrLf
    s = s & "                                              AND m.Assembly=a.Assembly" & vbCrLf
    s = s & "                                              AND m.OptionID=a.OptionID" & vbCrLf
    s = s & "                                              AND m.Model=CASE" & vbCrLf
    s = s & "                                                          WHEN a.AssemblyType = 0 OR a.AssemblyType = 2 THEN a.Model" & vbCrLf
    s = s & "                                                          ELSE '' END)" & vbCrLf
    s = s & "     WHERE EstAssemblyID = @EstAssemblyID" & vbCrLf
    s = s & "    OPEN Assembly" & vbCrLf
    s = s & "    FETCH FROM Assembly INTO @Community, @CommunityPhase, @Customer_No,@Unit,@UnitsAsExtra, @EstIndex, @Model,@OptionID, @SalesWorksheet, @Assembly, @AssemblyType, @TakeoffRequired, @UseSalesSheetCosts" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    CLOSE Assembly" & vbCrLf
    s = s & "    DEALLOCATE Assembly" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    IF @TakeoffRequired = 0 BEGIN" & vbCrLf
    s = s & "        IF @SalesWorksheet<>0 AND @UseSalesSheetCosts=1 BEGIN" & vbCrLf
    s = s & "            ------------------------------------------------------------------------" & vbCrLf
    s = s & "            -- get the inspec flag from the salesworksheet" & vbCrLf
    s = s & "            ------------------------------------------------------------------------" & vbCrLf
    s = s & "            UPDATE EstimateAssemblies " & vbCrLf
    s = s & "            SET IncludedInSpec=CASE s.reference_item" & vbCrLf
    s = s & "                               WHEN 'Item2' THEN d.IncludedInSpec2" & vbCrLf
    s = s & "                               WHEN 'Item3' THEN d.IncludedInSpec3" & vbCrLf
    s = s & "                               WHEN 'Item4' THEN d.IncludedInSpec4" & vbCrLf
    s = s & "                               WHEN 'Item5' THEN d.IncludedInSpec5" & vbCrLf
    s = s & "                               WHEN 'Item6' THEN d.IncludedInSpec6" & vbCrLf
    s = s & "                               WHEN 'Item7' THEN d.IncludedInSpec7" & vbCrLf
    s = s & "                               WHEN 'Item8' THEN d.IncludedInSpec8" & vbCrLf
    s = s & "                               WHEN 'Item9' THEN d.IncludedInSpec9" & vbCrLf
    s = s & "                               WHEN 'Item10' THEN d.IncludedInSpec10" & vbCrLf
    s = s & "                               ELSE d.IncludedInSpec END" & vbCrLf
    s = s & "            FROM EstimateAssemblies a" & vbCrLf
    s = s & "                ,tblCustomers c" & vbCrLf
    s = s & "                ,tblSeries s" & vbCrLf
    s = s & "                ,tblSalesSheetDetails d" & vbCrLf
    s = s & "            WHERE estassemblyid=@EstAssemblyID" & vbCrLf
    s = s & "              AND a.Customer_no=c.Customer_no" & vbCrLf
    s = s & "              AND c.series=s.series" & vbCrLf
    s = s & "              AND a.salesworksheet=d.worksheet" & vbCrLf
    s = s & "              AND c.Community=d.community" & vbCrLf
    s = s & "              AND c.Phase=d.communityPhase" & vbCrLf
    s = s & "              AND a.assembly=d.assembly" & vbCrLf
    s = s & "              AND a.model=d.model" & vbCrLf
    s = s & "              AND a.optionid=d.optionid" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "            ------------------------------------------------------------------------" & vbCrLf
    s = s & "            -- add the items that come from a SalesWorksheet" & vbCrLf
