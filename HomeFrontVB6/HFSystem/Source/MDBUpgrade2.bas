    s = s & "CREATE PROCEDURE dbo.Schedule_InsertTemplateConstraints @TemplateID int, @FromTaskID int, @ToTaskID int, @ConstraintType int AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "   IF NOT EXISTS(SELECT * " & vbCrLf
    s = s & "                 FROM TemplateConstraints " & vbCrLf
    s = s & "                 WHERE TemplateID = @TemplateID" & vbCrLf
    s = s & "                 AND FromTaskID = @FromTaskID" & vbCrLf
    s = s & "                 AND ToTaskID = @ToTaskID)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      INSERT INTO TemplateConstraints(TemplateID,FromTaskID,ToTaskID,ConstraintType)" & vbCrLf
    s = s & "      VALUES (@TemplateID,@FromTaskID,@ToTaskID,@ConstraintType)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   ELSE" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      UPDATE TemplateConstraints " & vbCrLf
    s = s & "      SET ConstraintType=@ConstraintType" & vbCrLf
    s = s & "      WHERE TemplateID = @TemplateID" & vbCrLf
    s = s & "      AND FromTaskID = @FromTaskID" & vbCrLf
    s = s & "      AND ToTaskID = @ToTaskID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END" & vbCrLf
