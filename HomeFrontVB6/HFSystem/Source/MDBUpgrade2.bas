c = "Update vendor portal triggers to ensure correct vendors have access"
    
    sql c, "drop trigger TI_JobPOIndex", True
    sql c, "drop trigger EstimateItemsInsert", True
    sql c, "drop trigger POMaster_CreateJobVendors", True
    sql c, "drop trigger EstimateItems_InsertJobPOIndex", True
    sql c, "drop trigger EstimateItems_UpdatetblJobVendors", True
    
    s = ""
    s = s & "CREATE TRIGGER [dbo].[EstimateItems_InsertJobPOIndex] ON [dbo].[EstimateItems] AFTER INSERT, UPDATE AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "INSERT INTO JobPOIndex(DivisionID,Job_No,POIndex,Community,CommunityPhase,Description,StandardText,HideQty,HidePrice,TotalOnly,Terms,POGroup,retainagepercent)" & vbCrLf
    s = s & "SELECT DISTINCT i.DivisionID,i.job, i.poindex, j.Community, j.CommunityPhase, isnull(nullif(p.[Description],''),p.poindex), p.StandardText, p.HideQty" & vbCrLf
    s = s & "     , p.HidePrice, p.TotalOnly, t.[Description] Terms, p.POGroup, p.retainagepercent" & vbCrLf
    s = s & "FROM" & vbCrLf
    s = s & "  inserted i " & vbCrLf
    s = s & "  JOIN tblPOIndex p ON(p.DivisionID = i.DivisionID and p.POIndex=i.POIndex)" & vbCrLf
    s = s & "  LEFT OUTER JOIN JobPOIndex x ON(i.DivisionID = x.DivisionID and i.Job=x.Job_No AND i.POIndex=x.POIndex)" & vbCrLf
    s = s & "  LEFT OUTER JOIN tblJobs j ON(i.Job=j.Job_No and i.DivisionID = j.DivisionID)" & vbCrLf
    s = s & "  LEFT OUTER JOIN PaymentTerms t ON (p.PaymentTerm=t.PaymentTerm)" & vbCrLf
    s = s & "WHERE" & vbCrLf
    s = s & "  x.Job_No IS NULL AND p.POIndex IS NOT NULL" & vbCrLf
    sql c, s
    
    s = ""
    s = s & "CREATE TRIGGER [dbo].[EstimateItems_UpdatetblJobVendors] ON [dbo].[EstimateItems] AFTER INSERT, UPDATE, DELETE AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- remove the replaced or deleted vendor if no other estimateitems exist for that vendor" & vbCrLf
    s = s & "DELETE tbljobvendors" & vbCrLf
    s = s & "FROM deleted d" & vbCrLf
    s = s & "JOIN tbljobvendors jv on d.divisionid=jv.divisionid and d.job=jv.job_no and d.povendor=jv.vendorid" & vbCrLf
    s = s & "LEFT OUTER JOIN EstimateItems e on d.estitemid<>e.estitemid and d.divisionid=e.divisionid and d.job=e.job and d.povendor=e.povendor" & vbCrLf
    s = s & "WHERE e.estitemid is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- add new vendors that dont already exist" & vbCrLf
    s = s & "INSERT INTO tblJobVendors(DivisionID, VendorID, Job_No, NotificationText, sendNotification)" & vbCrLf
    s = s & "SELECT DISTINCT i.divisionid, i.povendor, i.job, 'New Job Assigned', 1" & vbCrLf
    s = s & "FROM inserted i" & vbCrLf
    s = s & "LEFT OUTER JOIN tblJobVendors jv on i.divisionid=jv.divisionid and i.job=jv.job_no and i.povendor=jv.vendorid" & vbCrLf
    s = s & "WHERE isnull(i.povendor,'')<>''" & vbCrLf
    s = s & "AND jv.vendorid is null" & vbCrLf
    sql c, s

