    s = ""
    s = s & "create function dbo.GetServiceOverdue(@DivisionID as int, @Equipment as varchar(11), @ServiceDesc as varchar(2500)) returns bit as" & vbCrLf
    s = s & "begin" & vbCrLf
    s = s & "  return(" & vbCrLf
    s = s & "    select case" & vbCrLf
    s = s & "           when pi.uom='km'   and e.mileage >= max(h.mileage) + pi.frequency     then 1" & vbCrLf
    s = s & "           when pi.uom='M'    and e.mileage >= max(h.mileage) + pi.frequency     then 1" & vbCrLf
    s = s & "           when pi.uom='hr'   and e.hours   >= max(h.hours)   + pi.frequency     then 1" & vbCrLf
    s = s & "           when pi.uom='days' and getdate() >= max(h.servicedate) + pi.frequency then 1" & vbCrLf
    s = s & "           else 0 end " & vbCrLf
    s = s & "    from Equipment e" & vbCrLf
    s = s & "    join ServicePlanSchedules pi on e.DivisionID=pi.DivisionID and e.ServicePlanID=pi.PlanID" & vbCrLf
