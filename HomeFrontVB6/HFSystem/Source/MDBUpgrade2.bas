    s = s & "   select * into #tmp_materialitems" & vbCrLf
    s = s & "   from openxml (@idoc,'wt/materialitems',2)" & vbCrLf
    s = s & "   with (workticket varchar(25),sequence int,description varchar(50),material varchar(20),costcode varchar(40),category varchar(40),qty float,chargerate float,uom varchar(10),pretax float,referencedoc varchar(25),ustmp varchar(15),tstmp datetime,vendor varchar(40),handlingpercent float,debitaccount varchar(40),creditaccount varchar(40),taxgroup varchar(6),costrate float,invoicenumber varchar(15),ponumber varchar(12),podescription varchar(30),fieldreq bit,guid uniqueidentifier,surchargepercent float,job varchar(12),extra varchar(10),divisionid int)" & vbCrLf
