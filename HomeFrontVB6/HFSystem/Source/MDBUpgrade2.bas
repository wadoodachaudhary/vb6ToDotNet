    sql c, s, True


    s = ""
    s = s & "create proc [dbo].[Approvals_EscalateInvoice] " & vbCrLf
    s = s & "-----------------------------------------------------" & vbCrLf
    s = s & "-- Escalate an invoice to the next level approver. " & vbCrLf
    s = s & "-- Optionally, you may specify a new department and approver." & vbCrLf
    s = s & "--" & vbCrLf
    s = s & "-- IE: to assign to next approver in current dept" & vbCrLf
    s = s & "--   Approvals_EscalateInvoice 1,123,'MKnecht'" & vbCrLf
    s = s & "--" & vbCrLf
    s = s & "-- IE: to assign to lowest level approver in new dept" & vbCrLf
    s = s & "--   Approvals_EscalateInvoice 1,123,'MKnecht', 5" & vbCrLf
    s = s & "--" & vbCrLf
    s = s & "-- IE: to assign to a specific approver you must specify both dept and approver" & vbCrLf
    s = s & "--   Approvals_EscalateInvoice 1,123,'MKnecht', 5, 'CCordoba'" & vbCrLf
    s = s & "-----------------------------------------------------" & vbCrLf
    s = s & "  @DivisionID int" & vbCrLf
    s = s & ", @InvoiceID int" & vbCrLf
    s = s & ", @PM varchar(10)" & vbCrLf
    s = s & ", @NewDeptID int = NULL      --optional" & vbCrLf
    s = s & ", @NewPM varchar(20) = NULL  --optional" & vbCrLf
    s = s & "AS" & vbCrLf
    s = s & "begin" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "declare @lInvoiceID int" & vbCrLf
    s = s & "declare @lCurDeptID int" & vbCrLf
    s = s & "declare @lDeptID int" & vbCrLf
    s = s & "declare @lPM varchar(20)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  -- raise error if newpm specified but newdept is not" & vbCrLf
    s = s & "  if (@NewDeptID is null and @NewPM is not null) begin" & vbCrLf
    s = s & "    RAISERROR('Invalid parameters to Approvals_EscalateInvoice. When @NewPM is given @NewDeptID cannot be null', 16, 1)" & vbCrLf
    s = s & "    return" & vbCrLf
    s = s & "  end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  --get current department" & vbCrLf
    s = s & "  select @lInvoiceID=i.InvoiceID, @lCurDeptID=i.DeptID" & vbCrLf
    s = s & "  from invoices i" & vbCrLf
    s = s & "  where i.divisionid=@divisionid" & vbCrLf
    s = s & "  and i.invoiceid=@invoiceid" & vbCrLf
    s = s & "  if (@lInvoiceID is null) begin" & vbCrLf
    s = s & "    RAISERROR('Invalid invoice.', 16, 1)" & vbCrLf
    s = s & "    return" & vbCrLf
    s = s & "  end" & vbCrLf
    s = s & "  if (@NewDeptID=@lCurDeptID and @NewPM is null) begin" & vbCrLf
    s = s & "    -- if new dept is current dept and no new pm given, don't reset to lowest approver like you'd normally do with this set of parameters. instead just assign to next higher approver" & vbCrLf
    s = s & "    set @NewDeptID=null" & vbCrLf
    s = s & "  end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  if (@NewDeptID is null) begin" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- lookup next pm in curdept ------------------------------------" & vbCrLf
    s = s & "    select top 1" & vbCrLf
    s = s & "     @lDeptID=newpm.DeptID" & vbCrLf
    s = s & "    ,@lPM=newpm.PM" & vbCrLf
    s = s & "    from invoices i" & vbCrLf
    s = s & "    join departmentapprovers curPM on curpm.deptid=i.deptid and curpm.pm=i.approver" & vbCrLf
    s = s & "    join departmentapprovers newPM on newpm.deptid=i.deptid" & vbCrLf
    s = s & "    where i.divisionid=@divisionid" & vbCrLf
    s = s & "    and i.invoiceid=@invoiceid" & vbCrLf
    s = s & "    and newpm.Sortorder<curpm.sortorder" & vbCrLf
    s = s & "    order by newpm.sortorder desc" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    if (@lPM is null) begin" & vbCrLf
    s = s & "      RAISERROR('No higher approver is available.', 16, 1)" & vbCrLf
    s = s & "      return" & vbCrLf
    s = s & "    end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  end else begin " & vbCrLf
    s = s & "    if (@NewPM is null) begin" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      -- lookup lowest pm in newdept  ------------------------------------" & vbCrLf
    s = s & "      select top 1" & vbCrLf
    s = s & "       @lDeptID=newpm.DeptID" & vbCrLf
    s = s & "      ,@lPM=newpm.PM" & vbCrLf
    s = s & "      from invoices i" & vbCrLf
    s = s & "      join departmentapprovers newPM on newpm.deptid=@NewDeptID" & vbCrLf
    s = s & "      where i.divisionid=@divisionid" & vbCrLf
    s = s & "      and i.invoiceid=@invoiceid" & vbCrLf
    s = s & "      order by newpm.sortorder desc" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      if (@lPM is null) begin" & vbCrLf
    s = s & "        RAISERROR('No approver is available.', 16, 1)" & vbCrLf
    s = s & "        return" & vbCrLf
    s = s & "      end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    end else begin" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      -- use newdept and newpm ------------------------------------" & vbCrLf
    s = s & "      select top 1" & vbCrLf
    s = s & "       @lDeptID=newpm.DeptID" & vbCrLf
    s = s & "      ,@lPM=newpm.PM" & vbCrLf
    s = s & "      from invoices i" & vbCrLf
    s = s & "      join departmentapprovers newPM on newpm.deptid=@NewDeptID and newpm.pm=@NewPM" & vbCrLf
    s = s & "      where i.divisionid=@divisionid" & vbCrLf
    s = s & "      and i.invoiceid=@invoiceid" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      if (@lPM is null) begin" & vbCrLf
    s = s & "        RAISERROR('Invalid approver.', 16, 1)" & vbCrLf
    s = s & "        return" & vbCrLf
    s = s & "      end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  update invoices" & vbCrLf
    s = s & "  set approver=@lPM, deptid=@lDeptID" & vbCrLf
    s = s & "  where divisionid=@divisionid" & vbCrLf
    s = s & "  and invoiceid=@invoiceid " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  exec Approvals_WriteLog @DivisionID, @InvoiceID, @PM, 'Escalate'" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "end" & vbCrLf
    sql c, s


