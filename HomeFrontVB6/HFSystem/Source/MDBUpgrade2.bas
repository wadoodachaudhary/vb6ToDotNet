    s = s & "   update #tmp_worktickets" & vbCrLf
    s = s & "   set ticketdate=nullif(ticketdate,'1900-01-01'),periodenddate=nullif(periodenddate,'1900-01-01'),tstmp=nullif(tstmp,'1900-01-01'),quoteexpirydate=nullif(quoteexpirydate,'1900-01-01'),fieldapproveddate=nullif(fieldapproveddate,'1900-01-01'),customerapproveddate=nullif(customerapproveddate,'1900-01-01'),officeapproveddate=nullif(officeapproveddate,'1900-01-01')" & vbCrLf
    s = s & "   -- insert new data" & vbCrLf
    s = s & "   insert worktickets(workticket,ticketdate,job,extra,periodenddate,status_depreciated,description,enteredby,ustmp,tstmp,costcode,labourratesheet,equipmentratesheet,customer,tickettype,chargeable,invoice,isquote,quoteexpirydate,materialratesheet,submitted,notes,employeeautopay,fuelcostindex,billable,divisionid,fieldapprovedby,fieldapproveddate,customerapprovedby,customerapproveddate,officeapprovedby,officeapproveddate,billed,istemplate)" & vbCrLf
    s = s & "   select workticket,ticketdate,job,extra,periodenddate,status_depreciated,description,enteredby,ustmp,tstmp,costcode,labourratesheet,equipmentratesheet,customer,tickettype,chargeable,invoice,isquote,quoteexpirydate,materialratesheet,submitted,notes,employeeautopay,fuelcostindex,billable,divisionid,fieldapprovedby,fieldapproveddate,customerapprovedby,customerapproveddate,officeapprovedby,officeapproveddate,billed,istemplate" & vbCrLf
    s = s & "   from #tmp_worktickets" & vbCrLf
    s = s & "   ------------------------------" & vbCrLf
    s = s & "   --labouritems" & vbCrLf
    s = s & "   ------------------------------" & vbCrLf
    s = s & "   select * into #tmp_labouritems" & vbCrLf
    s = s & "   from openxml (@idoc,'wt/labouritems',2)" & vbCrLf
    s = s & "   with (workticket varchar(25),periodenddate datetime,itemdate datetime,description varchar(254),job varchar(12),extra varchar(10),costcode varchar(40),employee varchar(40),labourclass varchar(52),shift varchar(1),totalhours float,stqty float,stpayid varchar(40),strate float,otqty float,otpayid varchar(40),otrate float,dtqty float,dtpayid varchar(40),dtrate float,travelqty float,travelpayid varchar(40),travelrate float,misc1qty float,misc1payid varchar(40),misc1rate float,misc2qty float,misc2payid varchar(40),misc2rate float,misc3qty float,misc3payid varchar(40),misc3rate float,equipment varchar(11),eqhourlyqty float,eqhourlycostrate float,eqhourlychargerate float,eqdailyqty float,eqdailycostrate float,eqdailychargerate float,eqweeklyqty float,eqweeklycostrate float,eqweeklychargerate float,eqmonthlyqty float,eqmonthlycostrate float,eqmonthlychargerate float,eqreimburseqty float,eqreimbursepayid varchar(10)" & vbCrLf
    s = s & "        ,ustmp varchar(15),tstmp datetime,timebatchid int,equipmentbatchid int,equipmentcostcode varchar(40),labourdiscpercent float,equipmentdiscpercent float,nonbillable bit,stbillqty float,otbillqty float,dtbillqty float,travelbillqty float,misc1billqty float,misc2billqty float,misc3billqty float,eqhourlybillqty float,eqdailybillqty float,eqweeklybillqty float,eqmonthlybillqty float,debitaccount varchar(25),creditaccount varchar(25),taxgroup varchar(6),unionclass varchar(10),sortorder int,submitted bit,guid uniqueidentifier,nootcalc bit,other1qty float,other1chargerate float,other2qty float,other2chargerate float,eqsurchargepercent float,ref1 varchar(20),ref2 varchar(20),ref3 varchar(20),eqmisccode1 varchar(20),eqmisccode2 varchar(20),eqmisccode3 varchar(20),stpayrate float,otpayrate float,dtpayrate float,travelpayrate float,misc1payrate float,misc2payrate float" & vbCrLf
    s = s & "        ,misc3payrate float,burdenpcnt float,eqrevenuetype varchar(25),originalpedate datetime,labcategory varchar(3),eqcategory varchar(3),divisionid int,sequence int)" & vbCrLf
    s = s & "   -- fix null dates" & vbCrLf
    s = s & "   update #tmp_labouritems" & vbCrLf
    s = s & "   set periodenddate=nullif(periodenddate,'1900-01-01'),itemdate=nullif(itemdate,'1900-01-01'),tstmp=nullif(tstmp,'1900-01-01'),originalpedate=nullif(originalpedate,'1900-01-01')" & vbCrLf
