    s = ""
    s = s & "CREATE FUNCTION dbo.CalcInvoicePayDate(@InvDate Datetime, @TermNetType varchar(50), @TermNetDays int)" & vbCrLf
    s = s & "RETURNS Datetime AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "    DECLARE @x Datetime" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    select @x = case" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when @TermNetType='InAGivenNumberOfDays' then" & vbCrLf
    s = s & "        dateadd(dd, @TermNetDays, @InvDate)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when @TermNetType='NumberOfDaysAfterEOM' then" & vbCrLf
    s = s & "        dateadd(dd, @TermNetDays, cast(cast(year(@InvDate) as varchar) +'-'+ cast(month(@InvDate)+1 as varchar) +'-1' as datetime))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when (@TermNetType='DayOfMonthAfterEOM')  OR (@TermNetType='OnADayOfTheMonth' and day(@InvDate)>=@TermNetDays) then" & vbCrLf
    s = s & "        dateadd(dd, @TermNetDays, cast(cast(year(@InvDate) as varchar) +'-'+ cast(month(@InvDate)+1 as varchar) +'-1' as datetime)-1)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    when @TermNetType='OnADayOfTheMonth' then" & vbCrLf
    s = s & "        dateadd(dd, @TermNetDays, cast(cast(year(@InvDate) as varchar) +'-'+ cast(month(@InvDate) as varchar) +'-1' as datetime)-1)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    else" & vbCrLf
    s = s & "        null" & vbCrLf
    s = s & "    end " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    RETURN( @x )" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s

    s = ""
    s = s & "alter TRIGGER [dbo].[POMaster_CreateInvoice] ON dbo.POMaster AFTER UPDATE AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "declare @InvoiceID as int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "IF UPDATE(ApprovedDate) BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    -- move to approved, any held invoices that reference ONLY this po" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "    SET status='Approved',Approver='AutoApproved'" & vbCrLf
    s = s & "    FROM invoices i" & vbCrLf
    s = s & "    JOIN AppOptions ao1 ON(ao1.OptionName='AutoReleaseHeldPOInvoices' and ao1.OptionValue='True' AND ao1.DivisionID = i.DivisionID)     " & vbCrLf
    s = s & "    JOIN AppOptions ao2 ON(ao2.OptionName='SchedulingUsage' and ao2.OptionValue='3' AND ao2.DivisionID = i.DivisionID)     " & vbCrLf
    s = s & "    WHERE i.status='Hold'" & vbCrLf
    s = s & "    AND invoiceid in(" & vbCrLf
    s = s & "        SELECT dd.invoiceid" & vbCrLf
    s = s & "        FROM invoiceitems dd" & vbCrLf
    s = s & "        WHERE invoiceid in(" & vbCrLf
    s = s & "            SELECT distinct d.invoiceid " & vbCrLf
    s = s & "            FROM InvoiceItems d" & vbCrLf
    s = s & "            JOIN INSERTED p on d.DivisionID=p.DivisionID and d.Vendor=p.Vendor and d.commitment=p.PONumber" & vbCrLf
    s = s & "        )" & vbCrLf
    s = s & "        GROUP BY dd.invoiceid" & vbCrLf
    s = s & "        HAVING COUNT(DISTINCT dd.commitment)=1" & vbCrLf
    s = s & "    )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    -- move to pending, any held invoices that reference something other than just this po" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "    SET status='Pending'" & vbCrLf
    s = s & "    FROM invoices i" & vbCrLf
    s = s & "    JOIN AppOptions ao1 ON(ao1.OptionName='AutoReleaseHeldPOInvoices' and ao1.OptionValue='True' AND ao1.DivisionID = i.DivisionID)     " & vbCrLf
    s = s & "    JOIN AppOptions ao2 ON(ao2.OptionName='SchedulingUsage' and ao2.OptionValue='3' AND ao2.DivisionID = i.DivisionID)     " & vbCrLf
    s = s & "    WHERE i.status='Hold' and i.Approver<>''" & vbCrLf
    s = s & "    AND invoiceid in(" & vbCrLf
    s = s & "        SELECT dd.invoiceid" & vbCrLf
    s = s & "        FROM invoiceitems dd" & vbCrLf
    s = s & "        WHERE invoiceid in(" & vbCrLf
    s = s & "            SELECT distinct d.invoiceid " & vbCrLf
    s = s & "            FROM InvoiceItems d" & vbCrLf
    s = s & "            JOIN INSERTED p on d.DivisionID=p.DivisionID and d.Vendor=p.Vendor and d.commitment=p.PONumber" & vbCrLf
    s = s & "        )" & vbCrLf
    s = s & "        GROUP BY dd.invoiceid" & vbCrLf
    s = s & "        HAVING COUNT(DISTINCT dd.commitment)>1" & vbCrLf
    s = s & "    )" & vbCrLf
    s = s & "END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "IF UPDATE(PayPoint1ApprovedDate) BEGIN" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    -- CREATE INVOICE FOR PAYPOINT1" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    INSERT INTO Invoices(DivisionID,Vendor,Invoice,InvoiceDate,AccountingDate,Description,Status,VendorName,PreTax,Tax,Source,UStmp,TStmp, PaymentDate)" & vbCrLf
    s = s & "    SELECT d.DivisionID,d.Vendor" & vbCrLf
    s = s & "          ,d.po Invoice" & vbCrLf
    s = s & "          ,d.poApprovedDate,d.poApprovedDate,LEFT(d.podesc,100) Description,'SiteApproved' Status,d.VendorDesc" & vbCrLf
    s = s & "          -- if 1 is last then use remaining else use percent" & vbCrLf
    s = s & "          ,case when isnull(p.paypoint5percent,0)=0 and isnull(isnull(p.paypoint4percent,0),0)=0 and isnull(p.paypoint3percent,0)=0 and isnull(p.paypoint2percent,0)=0 " & vbCrLf
    s = s & "                then SUM(ISNULL(d.lineRemainingPretax,0)) " & vbCrLf
    s = s & "                else SUM(round(ISNULL(d.linePretax,0)*isnull(p.paypoint1percent,0)/100,2)) " & vbCrLf
    s = s & "                end Pretax" & vbCrLf
    s = s & "          ,case when isnull(p.paypoint5percent,0)=0 and isnull(isnull(p.paypoint4percent,0),0)=0 and isnull(p.paypoint3percent,0)=0 and isnull(p.paypoint2percent,0)=0 " & vbCrLf
    s = s & "                then SUM(ISNULL(d.lineRemainingTax,0)) " & vbCrLf
    s = s & "                else SUM(round(ISNULL(d.linetax,0)*isnull(p.paypoint1percent,0)/100,2)) " & vbCrLf
    s = s & "                end Tax" & vbCrLf
    s = s & "          ,'autoinserting..' Source,d.POApprovedBy UStmp,getdate() TStmp" & vbCrLf
    s = s & "         ,dbo.CalcInvoicePayDate(max(d.poapproveddate), max(v.paytermnettype), max(v.paytermnetdays))" & vbCrLf
    s = s & "    FROM inserted    i" & vbCrLf
    s = s & "    join tblpoindex  p on i.divisionid=p.divisionid and i.poindex=p.poindex " & vbCrLf
    s = s & "    join jcpodetails d on i.DivisionID=d.DivisionID and i.ponumber=d.po" & vbCrLf
    s = s & "    join AppOptions  o on i.DivisionID=o.DivisionID and o.OptionName='AutoPayApprovedPOs' and o.OptionValue='True'" & vbCrLf
    s = s & "    left outer join Invoices e on i.DivisionID=e.DivisionID and i.PONumber=e.Invoice and i.Vendor=e.Vendor and e.Source='AutoApproved'" & vbCrLf
    s = s & "    left outer join tblvendors v on i.divisionid=v.divisionid and  i.vendor=v.vendor_id " & vbCrLf
    s = s & "    WHERE i.paypoint1approveddate is not null AND isnull(p.paypoint1percent,0)<>0" & vbCrLf
    s = s & "    and e.invoiceid is null" & vbCrLf
    s = s & "    GROUP BY d.DivisionID,d.Vendor,d.PO,d.poApprovedDate,d.podesc,d.Vendordesc,d.poApprovedBy,isnull(p.paypoint5percent,0),isnull(p.paypoint4percent,0),isnull(p.paypoint3percent,0),isnull(p.paypoint2percent,0)" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    INSERT INTO InvoicePaymentPoints(InvoiceID,PONumber,PayPoint1)" & vbCrLf
    s = s & "    SELECT e.InvoiceID,i.ponumber,1" & vbCrLf
    s = s & "    FROM inserted    i" & vbCrLf
    s = s & "    join Invoices e ON e.DivisionID = i.DivisionID and i.PONumber=e.Invoice and i.Vendor=e. Vendor and e.Source='autoinserting..'" & vbCrLf
    s = s & "    WHERE i.paypoint1approveddate is not null" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    INSERT INTO InvoiceItems(DivisionID,InvoiceID,Vendor,Invoice,Commitment,CommitmentItem,CommitmentDesc,CommitmentVendor,Job,Extra,Phase,PhaseDesc,Category,CategoryDesc,InvoicedQuantity,TaxGroup,TaxGroupDesc,TaxRate,Description,RetainageRate,PreTax,Tax,Retainage,JCTaxRate,NJCTaxRate)" & vbCrLf
    s = s & "    SELECT d.DivisionID,e.InvoiceID,e.Vendor,e.Invoice,d.PO,d.Line,LEFT(d.poDesc,200),d.Vendor,d.lineJob,d.lineExtra,d.lineCostCode,d.linecostcodeDesc,d.lineCategory,d.linecategoryDesc,0,d.lineTaxGroup,d.lineTaxGroupdesc,d.lineTaxrate,left(d.LineDesc,100),d.Retainagerate" & vbCrLf
    s = s & "          -- if 1 is last then use remaining else use percent" & vbCrLf
    s = s & "          ,case when isnull(p.paypoint5percent,0)=0 and isnull(p.paypoint4percent,0)=0 and isnull(p.paypoint3percent,0)=0 and isnull(p.paypoint2percent,0)=0 " & vbCrLf
    s = s & "                then d.lineRemainingPretax " & vbCrLf
    s = s & "                else round(d.linepretax*isnull(p.paypoint1percent,0)/100,2)" & vbCrLf
    s = s & "                end Pretax" & vbCrLf
    s = s & "          ,case when isnull(p.paypoint5percent,0)=0 and isnull(p.paypoint4percent,0)=0 and isnull(p.paypoint3percent,0)=0 and isnull(p.paypoint2percent,0)=0 " & vbCrLf
    s = s & "                then d.lineRemainingTax " & vbCrLf
    s = s & "                else round(d.lineremainingtax*isnull(p.paypoint1percent,0)/100,2)" & vbCrLf
    s = s & "                end Pretax" & vbCrLf
    s = s & "          ,Round(case when isnull(p.paypoint5percent,0)=0 and isnull(p.paypoint4percent,0)=0 and isnull(p.paypoint3percent,0)=0 and isnull(p.paypoint2percent,0)=0 " & vbCrLf
    s = s & "                      then d.lineRemainingPretax " & vbCrLf
    s = s & "                      else round(d.linepretax*isnull(p.paypoint1percent,0)/100,2)" & vbCrLf
    s = s & "                      end" & vbCrLf
    s = s & "                   *d.Retainagerate/100,2) Retainage          " & vbCrLf
    s = s & "          ,d.LineJCTaxRate,d.LineNJCTaxRate" & vbCrLf
    s = s & "    FROM inserted    i" & vbCrLf
    s = s & "    join tblpoindex  p on i.divisionid=p.divisionid and i.poindex=p.poindex " & vbCrLf
    s = s & "    join jcpodetails d on i.DivisionID=d.DivisionID and i.ponumber=d.po" & vbCrLf
    s = s & "    join AppOptions  o on i.DivisionID=o.DivisionID and o.OptionName='AutoPayApprovedPOs' and o.OptionValue='True'" & vbCrLf
    s = s & "    join Invoices e ON e.DivisionID = i.DivisionID and i.PONumber=e.Invoice and i.Vendor=e. Vendor and e.Source='autoinserting..'" & vbCrLf
    s = s & "    WHERE i.paypoint1approveddate is not null" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "    SET Source='AutoApproved'" & vbCrLf
    s = s & "    FROM inserted i" & vbCrLf
    s = s & "    join Invoices e ON(i.DivisionID=e.DivisionID and i.PONumber=e.Invoice and i.Vendor=e.Vendor and e.Source='autoinserting..')" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    DECLARE c1 CURSOR FOR" & vbCrLf
