    s = s & ",m.DivisionID" & vbCrLf
    s = s & ",m.Community SourceCommunity" & vbCrLf
    s = s & ",m.Assembly" & vbCrLf
    s = s & ",m.Model" & vbCrLf
    s = s & ",m.OptionID" & vbCrLf
    s = s & ",m.Description AssemblyDesc" & vbCrLf
    s = s & ",d.Sequence" & vbCrLf
    s = s & ",i.GrpPhase" & vbCrLf
    s = s & ",i.GrpDesc" & vbCrLf
    s = s & ",i.Phase" & vbCrLf
    s = s & ",i.PhaseDesc" & vbCrLf
    s = s & ",i.Item" & vbCrLf
    s = s & ",i.ItemDesc" & vbCrLf
    s = s & ",i.JCCostCode" & vbCrLf
    s = s & ",i.JCCostCodeDesc" & vbCrLf
    s = s & ",i.JCCategory" & vbCrLf
    s = s & ",i.JCCategoryDesc" & vbCrLf
