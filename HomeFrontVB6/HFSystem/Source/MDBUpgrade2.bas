Private Sub Revisions_2017_05()
    Dim s As String
    Dim c As String

c = "Integrate billing claims process with scheduling"
    
    
    sql c, "alter table dbo.ClaimTemplateItems Add LibraryTaskID Int NULL", True

    s = ""
    s = s & "ALTER Procedure [dbo].[Schedule_CloseSchedule] @ScheduleID int, @LoadProject bit=0 AS" & vbCrLf
    s = s & "   " & vbCrLf
    s = s & "    declare @Job varchar(10)" & vbCrLf
    s = s & "    declare @DivisionID int" & vbCrLf
    s = s & "   " & vbCrLf
    s = s & "    Select @Job=Job_No" & vbCrLf
    s = s & "         , @DivisionID=DivisionID" & vbCrLf
    s = s & "    from Schedule" & vbCrLf
    s = s & "    where ScheduleID=@ScheduleID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --set the customers construction_status----------------------------" & vbCrLf
    s = s & "    declare @JobStatus INT" & vbCrLf
    s = s & "    set @JobStatus = 0" & vbCrLf
    s = s & "    Set @JobStatus = (select top 1 isnull(js.Job_Status,0)" & vbCrLf
    s = s & "                      from scheduletasks t" & vbCrLf
    s = s & "                      join schedule s on (s.scheduleid = t.scheduleid)" & vbCrLf
    s = s & "                      join librarytasks l on (t.LibraryTaskID = l.TaskID)" & vbCrLf
    s = s & "                      join tblJobStatus js on (js.Description = l.Description)" & vbCrLf
    s = s & "                      join tblJobs j on  (s.job_no= j.Job_no and s.DivisionID = j.DivisionID)" & vbCrLf
    s = s & "                      where  t.librarytaskid <> 0 and t.ActualEndDate is not null and s.job_no = @Job and s.DivisionID = @DivisionID" & vbCrLf
    s = s & "                      ORDER BY T.ActualEndDate DESC" & vbCrLf
    s = s & "                      )" & vbCrLf
    s = s & "    IF isnull(@JobStatus,0) <> 0 " & vbCrLf
    s = s & "        update tblCustomers " & vbCrLf
    s = s & "        set Construction_Status=@JobStatus" & vbCrLf
    s = s & "        where Job_no=@Job" & vbCrLf
    s = s & "        and DivisionID=@DivisionID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --close schedules with all tasks completed-------------------" & vbCrLf
    s = s & "    update schedule " & vbCrLf
    s = s & "    set closed=1 " & vbCrLf
    s = s & "    where scheduleid in(select scheduleid" & vbCrLf
    s = s & "                        from scheduletasks" & vbCrLf
    s = s & "                        where scheduleid in(select scheduleid" & vbCrLf
    s = s & "                                            from schedule" & vbCrLf
    s = s & "                                            where job_no=@Job" & vbCrLf
    s = s & "                                            and (ScheduleID=@ScheduleID OR @LoadProject=1)" & vbCrLf
    s = s & "                                            )" & vbCrLf
    s = s & "                        group by scheduleid" & vbCrLf
    s = s & "                        -- all tasks are completed..." & vbCrLf
    s = s & "                        having count(*) = sum(case iscompleted when 1 then 1 else 0 end)" & vbCrLf
    s = s & "                        )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- Update Claims percent complete for completed tasks linked to the claims templates" & vbCrLf
    s = s & "UPDATE b" & vbCrLf
    s = s & "SET PercentComplete = 100" & vbCrLf
    s = s & "FROM CustomerBillingItems b" & vbCrLf
    s = s & "join tblcustomers c on c.customer_no = b.Customer_No" & vbCrLf
    s = s & "join claimtemplateitems i on c.claimtemplateid=i.claimtemplateid and b.Description = i.Description" & vbCrLf
    s = s & "join LibraryTasks l on l.TaskID = i.LibraryTaskID" & vbCrLf
    s = s & "join schedule s on s.Job_No = c.job_no and s.divisionid = c.divisionid" & vbCrLf
    s = s & "join scheduletasks t on t.ScheduleID = s.ScheduleID and t.LibraryTaskID = i.LibraryTaskID" & vbCrLf
    s = s & "where t.ActualFinish is not null and c.Job_No= @Job"
    sql c, s

    s = ""
    s = s & "ALTER view [dbo].[WarrantyJobVendors] as" & vbCrLf
