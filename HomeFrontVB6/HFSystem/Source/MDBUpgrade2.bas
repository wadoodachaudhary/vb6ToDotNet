    s = s & "CREATE FUNCTION dbo.GetOption_Varchar (@DivisionID int, @OptionName varchar(35)) RETURNS varchar(2500) AS  " & vbCrLf
    s = s & "BEGIN " & vbCrLf
    s = s & "   DECLARE @s varchar(2500)" & vbCrLf
    s = s & "   SELECT @s = OptionValue FROM AppOptions WHERE DivisionID = @DivisionID AND OptionName = @OptionName" & vbCrLf
    s = s & "   RETURN @s" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
    
    s = ""
    s = s & "CREATE FUNCTION dbo.GetOption_Float (@DivisionID int, @OptionName varchar(35)) RETURNS float AS  " & vbCrLf
    s = s & "BEGIN " & vbCrLf
    s = s & "   DECLARE @s varchar(2500)" & vbCrLf
    s = s & "   DECLARE @f float" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   SELECT @s = dbo.GetOption_Varchar(@DivisionID,@OptionName)" & vbCrLf
    s = s & "   --these characters are treated as numeric and cause errors." & vbCrLf
    s = s & "   SELECT @s = replace(@s,'-','a')" & vbCrLf
    s = s & "   SELECT @s = replace(@s,'/','a')" & vbCrLf
    s = s & "   SELECT @s = replace(@s,'+','a')" & vbCrLf
    s = s & "   SELECT @f = case when isnumeric(@s)=1 then cast(@s as float) else 0 end" & vbCrLf
    s = s & "   RETURN @f" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
    
    s = ""
    s = s & "CREATE FUNCTION dbo.GetOption_Integer (@DivisionID int, @OptionName varchar(35)) RETURNS integer AS  " & vbCrLf
    s = s & "BEGIN " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   DECLARE @s varchar(2500)" & vbCrLf
    s = s & "   DECLARE @i int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   SELECT @s = dbo.GetOption_Float(@DivisionID,@OptionName)" & vbCrLf
    s = s & "   SELECT @i = case when isnumeric(@s)=1 then cast(cast(@s as float) as int) else 0 end" & vbCrLf
    s = s & "   RETURN @i" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s


