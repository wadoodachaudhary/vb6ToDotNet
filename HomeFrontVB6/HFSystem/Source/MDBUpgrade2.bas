    s = s & "  i.DivisionID" & vbCrLf
    s = s & ",d.Job" & vbCrLf
    s = s & ",d.phase CostCode" & vbCrLf
    s = s & ",d.Phasedesc CostCodeDesc" & vbCrLf
    s = s & ",i.Vendor" & vbCrLf
    s = s & ",i.VendorName" & vbCrLf
    s = s & "from invoices i" & vbCrLf
    s = s & "join invoiceitems d on i.invoiceid=d.InvoiceID" & vbCrLf
    s = s & "Group by i.DivisionID,d.Job,d.Phase,d.PhaseDesc,i.Vendor,i.VendorName" & vbCrLf
    s = s & "union" & vbCrLf
    s = s & "select d.divisionid,d.job,d.JCCostCode,c.Description,v.Vendor_ID,v.Vendor_Name" & vbCrLf
    s = s & "from poitems d " & vbCrLf
    s = s & "join standardcostcodes c on c.divisionid = d.DivisionID and c.CostCode = d.JCCostCode" & vbCrLf
    s = s & "join pomaster m on d.divisionid=m.divisionid and d.ponumber=m.ponumber" & vbCrLf
    s = s & "join tblVendors v on d.divisionid=v.divisionid and m.vendor=v.Vendor_ID" & vbCrLf
    s = s & "group by d.DivisionID,d.Job,d.JCCostCode,c.Description,v.Vendor_ID,v.Vendor_Name" & vbCrLf
    sql c, s

    Call Revisions_2017_07
End Sub

