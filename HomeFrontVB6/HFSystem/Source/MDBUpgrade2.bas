    s = ""
    s = s & "ALTER FUNCTION [dbo].[Purch_GetItemRate]( " & vbCrLf
    s = s & "    @LookupType     INTEGER" & vbCrLf
    s = s & "   ,@Worksheet      INTEGER" & vbCrLf
    s = s & "   ,@Community      VARCHAR(10)" & vbCrLf
    s = s & "   ,@CommunityPhase VARCHAR(10)" & vbCrLf
    s = s & "   ,@Assembly       VARCHAR(20)" & vbCrLf
    s = s & "   ,@Model          VARCHAR(20)" & vbCrLf
    s = s & "   ,@OptionID       VARCHAR(20)" & vbCrLf
    s = s & "   ,@Phase          VARCHAR(20)" & vbCrLf
    s = s & "   ,@Item           VARCHAR(16)" & vbCrLf
    s = s & "   ,@Sequence       INTEGER" & vbCrLf
    s = s & "   ,@Vendor         VARCHAR(40)" & vbCrLf
    s = s & "   ,@EffectiveDate  DATETIME" & vbCrLf
    s = s & "   ,@DivisionID     INTEGER)" & vbCrLf
    s = s & "RETURNS FLOAT AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @POIndex VARCHAR(20)" & vbCrLf
    s = s & "    DECLARE @UseModelCost BIT" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    IF @Vendor='' BEGIN" & vbCrLf
    s = s & "        IF @Sequence<>0 SELECT @POIndex=POIndex, @UseModelCost=UseModelCost FROM tbldbassemblydetails WHERE DivisionID=@DivisionID and sequence=@Sequence and Phase=@Phase AND Item=@Item" & vbCrLf
    s = s & "        IF isnull(@POINDEX,'')='' BEGIN" & vbCrLf
    s = s & "            SET @POIndex=(SELECT POIndex FROM tblphaseitem WHERE DivisionID = @DivisionID and Phase=@Phase AND Item=@Item)" & vbCrLf
    s = s & "        END" & vbCrLf
    s = s & "        SET @Vendor=dbo.Purch_GetCommunityVendor(@Community,@POIndex,@DivisionID)" & vbCrLf
    s = s & "    END ELSE BEGIN" & vbCrLf
    s = s & "        IF @Sequence<>0 BEGIN" & vbCrLf
    s = s & "           SET @UseModelCost =(SELECT ISNULL(UseModelCost,0) FROM tbldbassemblydetails WHERE DivisionID=@DivisionID and sequence = @Sequence and Phase=@Phase AND Item=@Item)" & vbCrLf
    s = s & "       END" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "    IF @UseModelCost=1 BEGIN" & vbCrLf
    s = s & "       SET @OptionID=''" & vbCrLf
    s = s & "       SET @Assembly = @Model" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @datasource INTEGER" & vbCrLf
    s = s & "    DECLARE @rate FLOAT" & vbCrLf
    s = s & "    DECLARE rates CURSOR FOR" & vbCrLf
    s = s & "    SELECT 4 DataSource,'Rate' = CASE " & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate>=c.Next_Effective2 and c.Next_Effective2 is not null THEN c.Next_Cost2" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate>=c.Next_Effective1 and c.Next_Effective1 is not null THEN c.Next_Cost1" & vbCrLf
