    s = s & "--Reset the ScheduleID to whatever the scheduleID of the Task is" & vbCrLf
    s = s & "SET @ScheduleID = (select ScheduleID from ScheduleTasks where ScheduleTaskID = @SrcToTaskID)" & vbCrLf
    s = s & "" & vbCrLf
