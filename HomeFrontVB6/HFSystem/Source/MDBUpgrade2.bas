    s = s & "          0 AS IsPending, " & vbCrLf
    s = s & "          @Color AS Color, " & vbCrLf
    s = s & "          '' CUStmp, NULL CTstmp,'' UStmp,NULL TStmp" & vbCrLf
    s = s & "   From schedule" & vbCrLf
    s = s & "   WHERE ScheduleID in (select ScheduleID " & vbCrLf
    s = s & "                         from Schedule " & vbCrLf
    s = s & "                         where Job_No=@Job" & vbCrLf
    s = s & "                         and (ScheduleID=@ScheduleID OR @LoadProject=1))" & vbCrLf
    s = s & "   UNION ALL" & vbCrLf
    s = s & "   SELECT CAST(ScheduleTaskID AS Varchar(50)) AS ID, " & vbCrLf
    s = s & "          RTRIM(Description) AS Name, " & vbCrLf
    s = s & "          CAST(case when ParentID = 0 then scheduleID else ParentID end  AS Varchar(50)) AS ParentID, " & vbCrLf
    s = s & "          CAST(CASE isnull(ActualDuration, 0) WHEN 0 THEN Duration ELSE ActualDuration END AS varchar(50)) AS Duration, " & vbCrLf
    s = s & "          IndexInParent, PercentComplete AS WorkComplete, BaselineStart, BaselineFinish AS BaselineEnd, " & vbCrLf
    s = s & "          CASE isnull(ActualStart, 0) WHEN 0 THEN " & vbCrLf
    s = s & "          CASE isnull(ScheduledStart, 0) WHEN 0 THEN ExpectedStart ELSE ScheduledStart END ELSE ActualStart END AS StartTime, " & vbCrLf
    s = s & "          CASE isnull(ActualFinish, 0) WHEN 0 THEN CASE isnull(ScheduledFinish, 0) WHEN 0 THEN ExpectedFinish ELSE ScheduledFinish END " & vbCrLf
    s = s & "          ELSE ActualFinish END AS EndTime, " & vbCrLf
    s = s & "          ActualStart AS ActualStartTime,   ActualFinish AS ActualEndTime, " & vbCrLf
    s = s & "          ScheduledStart, ScheduledFinish AS ScheduledEnd, " & vbCrLf
    s = s & "          ScheduleID, DrawID, LagTime, QCCheckListID, OriginalResource, JCCostCode, AssignedResource, LibraryTaskID, " & vbCrLf
    s = s & "          ISNULL(Comments, '') AS Comments, InternalResource, CompletedDate, SortOrder, " & vbCrLf
    s = s & "          [Level] AS TaskLevel, IsMilestone, IsScheduled, IsCompleted, CAST(ISNULL(ActualDuration, 0) AS varchar(50)) AS ActualDuration, " & vbCrLf
    s = s & "          ISNULL(ConstraintType, 'AsSoonAsPossible') AS ConstraintType, ActualEndDate, " & vbCrLf
    s = s & "          UserDate1, UserDate2, UserDate3, UserDate4, " & vbCrLf
    s = s & "          UserText1, UserText2, UserText3, UserText4, " & vbCrLf
    s = s & "          UserAmount1, UserAmount2, UserAmount3, UserAmount4, " & vbCrLf
    s = s & "          VarianceCode AS VarCodeID, dbo.Schedule_GetVarianceCodeDescription(VarianceCode) AS VarianceCode, " & vbCrLf
    s = s & "          dbo.Schedule_PlusMinusDays(@CalendarID, BaselineFinish, ISNULL(ActualFinish, ExpectedFinish)) AS PlusMinusDays, " & vbCrLf
    s = s & "          ISNULL(POPaymentApproved, 0) AS POPaymentApproved, " & vbCrLf
    s = s & "          ISNULL(VarianceNotes, '') AS VarianceNotes, " & vbCrLf
    s = s & "          ISNULL(NotificationNotes, '') AS NotificationNotes, " & vbCrLf
    s = s & "          ISNULL(IsSeasonal, 0) AS IsSeasonal, " & vbCrLf
    s = s & "          dbo.Schedule_IsNoticeSent(ScheduleTaskID) AS IsSent, " & vbCrLf
    s = s & "          dbo.Schedule_IsPending(ScheduleTaskID) AS IsPending, " & vbCrLf
    s = s & "          dbo.Schedule_GetActivityColor(ScheduleTaskID) AS Color, " & vbCrLf
    s = s & "          CUStmp, CTstmp, UStmp, TStmp" & vbCrLf
    s = s & "    FROM ScheduleTasks" & vbCrLf
    s = s & "    WHERE ScheduleID in (select ScheduleID " & vbCrLf
    s = s & "                         from Schedule " & vbCrLf
    s = s & "                         where Job_No=@Job" & vbCrLf
    s = s & "                         and (ScheduleID=@ScheduleID OR @LoadProject=1))" & vbCrLf
    s = s & "    ORDER BY ScheduleID,SortOrder" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
    
