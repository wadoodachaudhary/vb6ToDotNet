Private Sub sql(Description As String, SQLStatement As String, Optional IgnoreErrors As Boolean)
    FDbUpgrade.sql Description, SQLStatement, IgnoreErrors
End Sub
Private Function DropPKConstraint(TableName As String) As String
    Dim s As String
    s = ""
    s = s & "DECLARE @s NVARCHAR(MAX)" & vbCrLf
    'drop constraint first because it includes an index
    s = s & "select @s = 'ALTER TABLE " & TableName & " DROP CONSTRAINT ' + name FROM sys.key_constraints WHERE [type]='PK' AND parent_object_id=OBJECT_ID('" & TableName & "')" & vbCrLf
    s = s & "EXEC sp_executeSQL @s" & vbCrLf
    'for old pervasive tables where there is only an index, drop the PK_index
    s = s & "select @s = 'drop index pk_" & TableName & " on " & TableName & "' from sys.indexes where object_id=OBJECT_ID('" & TableName & "') and name='pk_" & TableName & "'" & vbCrLf
    s = s & "EXEC sp_executeSQL @s" & vbCrLf
    DropPKConstraint = s
End Function

Private Function DropDefConstraint(TableName As String, ColumnName As String) As String
    Dim s As String
    s = ""
    s = s & "DECLARE @s NVARCHAR(MAX)" & vbCrLf
    'drop constraint first because it includes an index
    s = s & "select @s = 'ALTER TABLE " & TableName & " DROP CONSTRAINT ' + name FROM sys.key_constraints WHERE [type]='PK' AND parent_object_id=OBJECT_ID('" & TableName & "')" & vbCrLf
    s = s & "EXEC sp_executeSQL @s" & vbCrLf
    DropDefConstraint = s
End Function

