    s = s & "   @IsScheduled bit," & vbCrLf
    s = s & "   @IsCompleted bit," & vbCrLf
    s = s & "   @ActualDuration varchar(50)," & vbCrLf
    s = s & "   @ConstraintType varchar(20)," & vbCrLf
    s = s & "   @ActualEndDate datetime," & vbCrLf
