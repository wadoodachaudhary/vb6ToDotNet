    s = ""
    s = s & "ALTER PROCEDURE  CalculateOverTime(" & vbCrLf
    s = s & "    @DivisionID  INT" & vbCrLf
    s = s & "   ,@WorkTicket  VARCHAR(15)" & vbCrLf
    s = s & "   ,@Sequence    INTEGER)   " & vbCrLf
    s = s & "AS BEGIN" & vbCrLf
    s = s & "    DECLARE @d             varchar(800) " & vbCrLf
    s = s & "    DECLARE @Billed        bit" & vbCrLf
    s = s & "    DECLARE @Employee      VARCHAR(40)" & vbCrLf
    s = s & "    DECLARE @PeriodEndDate datetime" & vbCrLf
    s = s & "    DECLARE @Today         datetime" & vbCrLf
    s = s & "    DECLARE @DayOne        datetime" & vbCrLf
    s = s & "    DECLARE @DaySeven      datetime" & vbCrLf
    s = s & "    DECLARE @HrsThisLine   float" & vbCrLf
    s = s & "    DECLARE @SumToday      float" & vbCrLf
    s = s & "    DECLARE @SumThisWeek   float" & vbCrLf
    s = s & "    DECLARE @STQty         float" & vbCrLf
    s = s & "    DECLARE @OTQty         float" & vbCrLf
    s = s & "    DECLARE @DTQty         float" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- get stuff -------------------------------------------------------" & vbCrLf
    s = s & "    SELECT @d             = ''" & vbCrLf
    s = s & "          ,@PeriodEndDate = PeriodEndDate" & vbCrLf
    s = s & "          ,@Today         = ItemDate" & vbCrLf
    s = s & "          ,@Employee      = Employee" & vbCrLf
    s = s & "          ,@HrsThisLine   = TotalHours" & vbCrLf
    s = s & "          ,@DayOne        = ItemDate - 6 + (CAST(PeriodEndDate - ItemDate AS INTEGER) % 7)" & vbCrLf
    s = s & "          ,@DaySeven      = ItemDate + (CAST(PeriodEndDate - ItemDate AS INTEGER) % 7)" & vbCrLf
    s = s & "      FROM LabourItems" & vbCrLf
    s = s & "     WHERE DivisionID = @DivisionID" & vbCrLf
    s = s & "       AND WorkTicket = @WorkTicket" & vbCrLf
    s = s & "       AND Sequence = @Sequence" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- get previous hours -------------------------------------------------------" & vbCrLf
    s = s & "    SELECT @SumToday=ISNULL(SUM(STQty),0)+ISNULL(SUM(OTQty),0)+ISNULL(SUM(DTQty),0)" & vbCrLf
    s = s & "      FROM LabourItems" & vbCrLf
    s = s & "     WHERE ItemDate = @Today" & vbCrLf
    s = s & "       AND DivisionID = @DivisionID" & vbCrLf
    s = s & "       AND Employee = @Employee" & vbCrLf
    s = s & "       and Sequence <> @Sequence" & vbCrLf
    s = s & "    set @d=@d + '@HrsThisLine='+cast(@HrsThisLine as varchar)+char(10)" & vbCrLf
    s = s & "    set @d=@d + '@SumToday='+cast(@SumToday as varchar)+char(10)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    SELECT @SumThisWeek=ISNULL(SUM(STQty),0)" & vbCrLf
    s = s & "      FROM LabourItems" & vbCrLf
    s = s & "     WHERE ItemDate >= @DayOne" & vbCrLf
    s = s & "       AND ItemDate <= @DaySeven" & vbCrLf
    s = s & "       AND DivisionID = @DivisionID" & vbCrLf
    s = s & "       AND Employee = @Employee" & vbCrLf
    s = s & "    set @d=@d + '@SumThisWeek='+cast(@SumThisWeek as varchar)+char(10)" & vbCrLf
    s = s & "    set @d=@d + '8RULE='+cast(@SumToday+@HrsThisLine-8 as varchar)+char(10)" & vbCrLf
    s = s & "    set @d=@d + '44RULE='+cast(@SumThisWeek+@HrsThisLine-44 as varchar)+char(10)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- do allocation -------------------------------------------------------" & vbCrLf
    s = s & "    SET @STQty = @HrsThisLine" & vbCrLf
    s = s & "    IF (@SumToday+@HrsThisLine)-8 > (@SumThisWeek+@HrsThisLine)-44 BEGIN" & vbCrLf
    s = s & "        IF (@SumToday+@HrsThisLine)-8 > 0 BEGIN" & vbCrLf
    s = s & "            set @d=@d + 'USING 8RULE'+char(10)" & vbCrLf
    s = s & "            IF (@SumToday+@HrsThisLine)-8 < @HrsThisLine BEGIN" & vbCrLf
    s = s & "                set @d=@d + 'a'+char(10)" & vbCrLf
    s = s & "                SET @STQty = 8-@SumToday            " & vbCrLf
    s = s & "            END ELSE BEGIN" & vbCrLf
    s = s & "                set @d=@d + 'b'+char(10)" & vbCrLf
    s = s & "                SET @STQty=0" & vbCrLf
    s = s & "            END " & vbCrLf
    s = s & "        END" & vbCrLf
    s = s & "    END ELSE BEGIN" & vbCrLf
    s = s & "        IF (@SumThisWeek+@HrsThisLine)-44 > 0 BEGIN" & vbCrLf
    s = s & "            set @d=@d + 'USING 44RULE'+char(10)" & vbCrLf
    s = s & "            IF (@SumThisWeek+@HrsThisLine)-44 < @HrsThisLine BEGIN" & vbCrLf
    s = s & "                set @d=@d + 'a'+char(10)" & vbCrLf
    s = s & "                SET @STQty = 44-@SumThisWeek" & vbCrLf
    s = s & "            END ELSE BEGIN" & vbCrLf
    s = s & "                set @d=@d + 'b'+char(10)" & vbCrLf
    s = s & "                SET @STQty=0" & vbCrLf
    s = s & "            END" & vbCrLf
    s = s & "        END" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "    SET @OTQty = @HrsThisLine - @STQty    " & vbCrLf
    s = s & "    SET @DTQty = 0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- update record -------------------------------------------------------" & vbCrLf
    s = s & "    UPDATE LabourItems" & vbCrLf
    s = s & "       SET STQty = @STQty" & vbCrLf
    s = s & "          ,OTQty = @OTQty" & vbCrLf
    s = s & "          ,DTQty = @DTQty" & vbCrLf
    s = s & "     WHERE DivisionID = @DivisionID" & vbCrLf
    s = s & "       AND WorkTicket = @WorkTicket" & vbCrLf
    s = s & "       AND Sequence = @Sequence" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- get ticket status -------------------------------------------------------" & vbCrLf
    s = s & "    SELECT @Billed=Billed" & vbCrLf
    s = s & "      FROM WorkTickets" & vbCrLf
    s = s & "     WHERE DivisionID = @DivisionID" & vbCrLf
    s = s & "       AND WorkTicket = @WorkTicket" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- if ticket is not invoiced then update billqtys also --------------------" & vbCrLf
    s = s & "    IF @Billed = 0 BEGIN" & vbCrLf
    s = s & "        UPDATE LabourItems" & vbCrLf
    s = s & "           SET STBillQty = @STQty" & vbCrLf
    s = s & "              ,OTBillQty = @OTQty" & vbCrLf
    s = s & "              ,DTBillQty = @DTQty" & vbCrLf
    s = s & "         WHERE DivisionID = @DivisionID" & vbCrLf
    s = s & "           AND WorkTicket = @WorkTicket" & vbCrLf
    s = s & "           AND Sequence = @Sequence" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    -- return values -------------------------------------------------------" & vbCrLf
    s = s & "    SELECT STQty,OTQty,DTQty,TravelQty,Misc1Qty,Misc2Qty,Misc3Qty,@d" & vbCrLf
    s = s & "      FROM LabourItems" & vbCrLf
    s = s & "     WHERE DivisionID = @DivisionID" & vbCrLf
    s = s & "       AND WorkTicket = @WorkTicket" & vbCrLf
    s = s & "       AND Sequence = @Sequence" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
    

