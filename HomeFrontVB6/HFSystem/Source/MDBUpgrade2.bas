    s = ""
    s = s & "CREATE PROCEDURE dbo.Schedule_CheckTemplateCyclicDependencies" & vbCrLf
    s = s & "   @TemplateID int" & vbCrLf
    s = s & "AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "WITH CTE (TemplateID,ToTaskID,ToTaskDesc,FromTaskID,IDPath,DescPath)" & vbCrLf
    s = s & "AS" & vbCrLf
    s = s & "(" & vbCrLf
    s = s & "    SELECT a.TemplateID, a.ToTaskID,t.description ToTaskDesc,null FromToskID, cast('' as varchar(max)) as IDPath, cast('' as varchar(max)) as DescPath" & vbCrLf
    s = s & "    FROM TemplateConstraints a" & vbCrLf
    s = s & "    join templatetasks t on a.templateid=t.templateid and a.totaskid=t.taskid" & vbCrLf
    s = s & "    where a.templateid=@TemplateID" & vbCrLf
    s = s & "    UNION ALL" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    SELECT b.TemplateID,b.ToTaskID,t.description ToTaskDesc,b.FromTaskID, IDPath +'-'+cast(b.FromTaskID as varchar(max)),  DescPath+' --> '+cast(f.description as varchar(max))" & vbCrLf
    s = s & "    FROM TemplateConstraints b" & vbCrLf
    s = s & "    join templatetasks t on b.templateid=t.templateid and b.totaskid=t.taskid" & vbCrLf
    s = s & "    join templatetasks f on b.templateid=f.templateid and b.fromtaskid=f.taskid" & vbCrLf
    s = s & "    join CTE ON b.TemplateID=CTE.TemplateID and CTE.ToTaskID=b.FromTaskID" & vbCrLf
    s = s & "    where b.templateid=@TemplateID" & vbCrLf
    s = s & ")" & vbCrLf
    s = s & "SELECT top 1 " & vbCrLf
    s = s & "   substring(IDPath+'-'+cast(ToTaskID as varchar),2,8000) TaskIDs" & vbCrLf
    s = s & "  ,substring(DescPath+' --> '+ToTaskDesc,6,8000) DependencyPath" & vbCrLf
    s = s & "FROM CTE " & vbCrLf
    s = s & "where charindex('-'+cast(ToTaskID as varchar)+'-','-'+idpath)<>0   " & vbCrLf
    s = s & "option (maxrecursion 500)" & vbCrLf
    sql c, s, True

