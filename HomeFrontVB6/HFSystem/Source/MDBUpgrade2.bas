    s = s & "/* Returns activity color depending on notification */ " & vbCrLf
    s = s & "ALTER FUNCTION [dbo].[Schedule_GetActivityColor] (@ScheduleTaskID int) RETURNS varchar(50) AS" & vbCrLf
    s = s & "BEGIN " & vbCrLf
    s = s & "   DECLARE" & vbCrLf
    s = s & "      @IsSent bit," & vbCrLf
    s = s & "      @IsPending bit," & vbCrLf
    s = s & "      @Color varchar(50)," & vbCrLf
    s = s & "      @DivisionID INT" & vbCrLf
    s = s & "       " & vbCrLf
    s = s & "   SET @IsSent = (SELECT dbo.Schedule_IsNoticeSent (@ScheduleTaskID) )" & vbCrLf
    s = s & "   SET @IsPending = (SELECT dbo.Schedule_IsPending (@ScheduleTaskID) )" & vbCrLf
    s = s & "   SET @DivisionID = (SELECT DivisionID from Schedule where ScheduleID = (select ScheduleID from scheduleTasks where ScheduleTaskID = @ScheduleTaskID))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   IF (@IsSent = 1)AND(@IsPending = 0)" & vbCrLf
    s = s & "      SET @Color = (SELECT dbo.Schedule_GetOption('SentNoticeColor',@DivisionID))" & vbCrLf
    s = s & "   ELSE IF  (@IsSent = 1)AND(@IsPending = 1)" & vbCrLf
    s = s & "      SET @Color = (SELECT dbo.Schedule_GetOption('PendingNoticeColor',@DivisionID))" & vbCrLf
    s = s & "   ELSE" & vbCrLf
    s = s & "      SET @Color = (SELECT dbo.Schedule_GetOption('UnsentNoticeColor',@DivisionID))" & vbCrLf
    s = s & "                 " & vbCrLf
    s = s & "   RETURN  @Color" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
    
