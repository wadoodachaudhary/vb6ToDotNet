    s = s & "OPEN SystemSettings" & vbCrLf
    s = s & "FETCH FROM SystemSettings INTO @DepositGL,@DrawGL,@SaleCredit,@AddendumGL,@CoGL,@MultiFamily,@DcGL,@GSTGL,@GSTREBATEGL,@LANDGL,@UseTimberline,@MaxBalSheetGL,@UseIncPrefix,@OffSetGL,@CostCodeSaleClosing,@UseAR,@GLDebitAcct,@WIP,@ExemptwithGST,@PSTGL,@PSTREBATEGL" & vbCrLf
    s = s & "CLOSE SystemSettings" & vbCrLf
    s = s & "DEALLOCATE SystemSettings" & vbCrLf
    s = s & "--Add these fields into a fetch statement from tblcustomers" & vbCrLf
    s = s & "DECLARE CustomerValues CURSOR FOR" & vbCrLf
    s = s & "SELECT isnull(Income_Prefix,''),isnull(Bal_Sheet_Prefix,''),isnull(ContractExemptDep,0) from tblcustomers where customer_no=@CustID" & vbCrLf
    s = s & "OPEN CustomerValues " & vbCrLf
