    s = s & "  (d.Bldr_Declined = 0) AND (d.EstimateIndex = 0) AND (c.Purchased = 1) AND (c.Cancelled = 0) AND (c.Inactive = 0) AND (ISNULL(c.Job_No, '') <> '') AND (s.accounting_approve = 1) AND (c.Approved = 1) OR" & vbCrLf
    s = s & "  (d.Bldr_Declined = 0) AND (d.EstimateIndex = 0) AND (c.Purchased = 1) AND (c.Cancelled = 0) AND (c.Inactive = 0) AND (ISNULL(c.Job_No, '') <> '') AND (s.accounting_approve = 0) AND (c.Contract_Assigned = 1) OR" & vbCrLf
    s = s & "  (d.Bldr_Declined = 0) AND (d.EstimateIndex = 0) AND (c.Purchased = 1) AND (c.Cancelled = 0) AND (c.Inactive = 0) AND (ISNULL(c.Job_No, '') <> '') AND (s.PurchasingRequiresSalesApproval = 0) OR" & vbCrLf
    s = s & "  (d.Bldr_Declined = 0) AND (d.EstimateIndex = 0) AND (c.Home_Selection <> 'PreSale') AND (ISNULL(c.Sold_To_Customer, '') = '')" & vbCrLf
