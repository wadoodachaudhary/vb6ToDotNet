    s = ""
    s = s & "ALTER TRIGGER [dbo].[TU_SpecCustomers] ON [dbo].[tblCustomers] " & vbCrLf
    s = s & "AFTER UPDATE" & vbCrLf
    s = s & "AS" & vbCrLf
    s = s & "DECLARE @CUSTID VARCHAR(12)" & vbCrLf
    s = s & "DECLARE @SPECHOME VARCHAR(12)" & vbCrLf
    s = s & "DECLARE @CURRENTJOB VARCHAR(12)" & vbCrLf
    s = s & "DECLARE @SPECHOMEJOB VARCHAR(12)" & vbCrLf
    s = s & "DECLARE @ISPURCHASED BIT" & vbCrLf
    s = s & "DECLARE @OLDPURCHASED BIT" & vbCrLf
    s = s & "DECLARE @CURRENTSELECTION VARCHAR(20)" & vbCrLf
    s = s & "DECLARE @OLDSELECTION VARCHAR(20)" & vbCrLf
    s = s & "DECLARE @HOMESELECTION VARCHAR(20)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "DECLARE @Message Varchar(4000)" & vbCrLf
    s = s & "DECLARE @CustomerName varchar(200)" & vbCrLf
    s = s & "DECLARE @Purchased bit" & vbCrLf
    s = s & "DECLARE @TypeofPurchase varchar(100)" & vbCrLf
    s = s & "DECLARE @SalesApprovalEmail varchar(200)" & vbCrLf
    s = s & "DECLARE @DivisionID INT" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "SET NOCOUNT ON" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "IF UPDATE(Purchased) or UPDATE(PreSale_Selection)  BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Declare @CustomerCount int;" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "SELECT @CustomerCount= count (customer_name+' '+ customer_lname)  from inserted group by (customer_name+' '+ customer_lname)" & vbCrLf
    s = s & "  " & vbCrLf
    s = s & "    --Can't seem to get this to work for multiple rows, so limit the trigger to fire if only updating a single row, which is how most people will be working with it anyway." & vbCrLf
    s = s & "    IF @@ROWCOUNT > 1 or @CustomerCount> 1 RETURN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   SELECT @DivisionID = DivisionID,@CUSTID =ISNULL( customer_no,''),@SPECHOME=ISNULL(inserted.sold_to_customer,''),@CURRENTJOB = isnull(job_no,''),@ISPURCHASED = isnull(purchased,0),@CURRENTSELECTION = isnull(Presale_selection,''),@HOMESELECTION = isnull(home_selection,'') from inserted" & vbCrLf
    s = s & "   IF Update(Purchased) BEGIN" & vbCrLf
    s = s & "      SET @Purchased = (select distinct purchased from inserted)" & vbCrLf
    s = s & "       SET @CustomerName = (select distinct customer_name+' '+customer_lname from inserted)" & vbCrLf
    s = s & "       SET @TypeofPurchase = (SELECT distinct PreSale_Selection from inserted)" & vbCrLf
    s = s & "       SET @SalesApprovalEmail = (SELECT distinct optionvalue from appoptions where DivisionID = @DivisionID and optionname = 'SalesApprovalEmail')" & vbCrLf
    s = s & "   END " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    IF @HOMESELECTION <> 'PreSale' RETURN" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "    SELECT @OLDPURCHASED = ISNULL(PURCHASED,0), @OLDSELECTION = isnull(presale_selection,'') FROM deleted " & vbCrLf
    s = s & " " & vbCrLf
    s = s & "    IF Update(PreSale_Selection) and @HOMESELECTION = 'PreSale' BEGIN" & vbCrLf
    s = s & "        IF @OLDSELECTION <>'PreSale' and @CURRENTSELECTION = 'PreSale'  BEGIN" & vbCrLf
    s = s & "            IF @CURRENTJOB <> '' BEGIN" & vbCrLf
    s = s & "                UPDATE TBLCUSTOMERS SET JOB_NO = @CURRENTJOB,sold_to_customer = '',InventoryStatus = 0,sold=0,webupdated=0,nodatachanged=0,Sale_posted=0,webdeleted=0 WHERE CUSTOMER_NO = @SPECHOME" & vbCrLf
    s = s & "      --UPDATE TBLCUSTOMERS SET JOB_NO = 'currentjob',sold_to_customer = '',InventoryStatus = 0,sold=0,webupdated=0,nodatachanged=0,Sale_posted=0,webdeleted=0 WHERE CUSTOMER_NO = @SPECHOME" & vbCrLf
    s = s & "                UPDATE TBLCUSTOMERS SET JOB_NO = '',sold_to_customer = '',InventoryStatus = 0,webupdated=0,nodatachanged=0,webdeleted=1 WHERE CUSTOMER_NO = @CUSTID" & vbCrLf
