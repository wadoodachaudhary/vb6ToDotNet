    s = s & "   @UserText3 varchar(50)," & vbCrLf
    s = s & "   @UserText4 varchar(50)," & vbCrLf
    s = s & "   @UserAmount1 float," & vbCrLf
    s = s & "   @UserAmount2 float," & vbCrLf
    s = s & "   @UserAmount3 float," & vbCrLf
    s = s & "   @UserAmount4 float," & vbCrLf
    s = s & "   @VarianceCode varchar(3)," & vbCrLf
    s = s & "   @ExistingScheduleTaskID int," & vbCrLf
    s = s & "   @POPaymentApproved bit," & vbCrLf
    s = s & "   @VarianceNotes varchar(1000)," & vbCrLf
    s = s & "   @NotificationNotes varchar(1000)," & vbCrLf
    s = s & "   @UserID varchar(10)," & vbCrLf
    s = s & "   @CTStmp DateTime," & vbCrLf
    s = s & "   @IsSeasonal bit" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "if @drawid=-99 return" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   DECLARE" & vbCrLf
    s = s & "   @NewParentID int," & vbCrLf
    s = s & "   @ScheduleTaskID int," & vbCrLf
    s = s & "   @TemplateID int," & vbCrLf
    s = s & "   @TaskParentID int," & vbCrLf
    s = s & "   @NewID int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   IF EXISTS(SELECT * FROM ScheduleTasks WHERE ScheduleTaskID = @ExistingScheduleTaskID)" & vbCrLf
    s = s & "   BEGIN" & vbCrLf
    s = s & "   EXEC Schedule_UpdateScheduleTasks @ExistingScheduleTaskID, @Description, @ParentID ," & vbCrLf
    s = s & "   @Duration , @IndexInParent , @PercentComplete , @BaselineStart ,@BaselineEnd ," & vbCrLf
    s = s & "   @ScheduledStart ,@ScheduledEnd ,@StartTime ,@EndTime ,@ActualStartTime ," & vbCrLf
    s = s & "   @ActualEndTime ,@ScheduleID ,@DrawID ,@LagTime ,@QCCheckListID ,@OriginalResource ," & vbCrLf
    s = s & "   @JCCostCode ,@AssignedResource ,@LibraryTaskID ,@Comments ,@InternalResource ," & vbCrLf
    s = s & "   @CompletedDate ,@SortOrder ,@Level ,@IsMilestone ,@IsScheduled ,@IsCompleted ," & vbCrLf
    s = s & "   @ActualDuration ,@ConstraintType ,@ActualEndDate ,@UserDate1 ,@UserDate2 ,@UserDate3 ," & vbCrLf
    s = s & "   @UserDate4 ,@UserText1 ,@UserText2 ,@UserText3 ,@UserText4 ,@UserAmount1 ,@UserAmount2 ," & vbCrLf
    s = s & "   @UserAmount3 ,@UserAmount4 ,@VarianceCode,@POPaymentApproved,@VarianceNotes,@NotificationNotes," & vbCrLf
    s = s & "   @UserID,@CTStmp,@IsSeasonal" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    INSERT INTO Reservations(ScheduleTaskID,ResourceID) " & vbCrLf
    s = s & "       SELECT  @ExistingScheduleTaskID, p.Vendor_ID" & vbCrLf
