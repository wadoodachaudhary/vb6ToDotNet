    s = s & "from  journalentrylines " & vbCrLf
    s = s & "group by DivisionID,Job,Extra,CostCode,Category" & vbCrLf
    s = s & "Union all" & vbCrLf
    s = s & "Select divisionid,Job,isnull(JCExtra,''),JCCostCode,JCCategory, SUM(0),Sum(BudgetPretax+isnull(BudgetJCTax,0)) TotalBudget,SUM(0)" & vbCrLf
    s = s & "from estimateitems where budgetgenerated = 1 and budgetdeleted = 0  Group by divisionid,Job,isnull(JCExtra,''),JCCostCode,JCCategory" & vbCrLf
