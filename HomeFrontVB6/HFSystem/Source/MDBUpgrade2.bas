    s = s & "" & vbCrLf
    s = s & "update CustomerPostingTotal Set Total = @HomeAmt,ThisPosting = isnull(Total,0)-isnull(PriorPosting,0),GLPrefix = @IncPrefix,GLDebitAcct = @GLDebitAcct,GLCreditAcct = isnull(GLCreditAcct,@SaleCredit)  where customer_no = @CustID and type =1 and ItemID = '01'" & vbCrLf
