    s = s & "    select DivisionID,IDENT_CURRENT('arinvoices'),billingitemid,description,contractamt,previouslybilled,amtthisperiod*-1,percentbilled,amtremaining,holdbackamount*-1,holdbacktotalheld,taxgroup,taxrate,tax" & vbCrLf
    s = s & "    from arinvoiceitems" & vbCrLf
