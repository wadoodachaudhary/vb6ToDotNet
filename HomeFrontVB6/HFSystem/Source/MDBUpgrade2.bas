    s = s & "declare @FirstofMonth datetime" & vbCrLf
    s = s & "declare @EndofMonth datetime" & vbCrLf
    s = s & "declare @30Days datetime" & vbCrLf
    s = s & "declare @60Days datetime" & vbCrLf
    s = s & "declare @90Days datetime" & vbCrLf
    s = s & "declare @120Days datetime" & vbCrLf
    s = s & "--set @FirstofMonth = (select dbo.FirstofMonth(@AgingCutoffDate))" & vbCrLf
    s = s & "set @EndofMonth = @AgingCutoffDate --(select dbo.EndofMonth(@AgingCutoffDate))" & vbCrLf
    s = s & "set @30days = @EndofMonth-30" & vbCrLf
    s = s & "set @60days = @EndofMonth-60" & vbCrLf
    s = s & "set @90days = @EndofMonth-90" & vbCrLf
    s = s & "set @120days = @EndofMonth-120" & vbCrLf
    s = s & "set nocount on" & vbCrLf
    s = s & "select Vendor, Invoice, Job, Commitment" & vbCrLf
    s = s & ", round(Sum(Amount),2) as Total" & vbCrLf
    s = s & ",round(Sum(case when TransDate<=@120Days  then Amount else 0 end),2)  [120Days]" & vbCrLf
    s = s & ",round(Sum(case when TransDate <=@90Days and TransDate >@120Days  then Amount else 0 end),2)  [90Days]" & vbCrLf
    s = s & ",round(Sum(case when TransDate <=@60Days and TransDate >@90Days then Amount else 0 end),2)  [60Days]" & vbCrLf
    s = s & ",round(Sum(case when TransDate <=@30Days and TransDate > @EndofMonth  then Amount else 0 end),2)  [30Days]" & vbCrLf
    s = s & ",round(Sum(case when TransDate <= @EndofMonth and Transdate > @30Days then Amount else 0 end),2)  [Current],TransDate,Status" & vbCrLf
    s = s & "from APTransactions" & vbCrLf
    s = s & "where transdate<=@AgingCutoffDate " & vbCrLf
    s = s & "group by Vendor,Invoice,Job,Commitment,TransDate,[Status]" & vbCrLf
    s = s & "order by Vendor,Invoice,Job,Commitment,TransDate" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "end" & vbCrLf
    s = s & "set nocount off" & vbCrLf
    sql c, s
    
