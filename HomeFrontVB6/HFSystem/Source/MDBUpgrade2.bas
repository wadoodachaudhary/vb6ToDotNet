    s = s & "ALTER PROCEDURE [dbo].[Approvals_getcostcodes](@DivisionID INT, " & vbCrLf
    s = s & "                                               @Job        VARCHAR(40) = NULL, " & vbCrLf
    s = s & "                                               @Term       VARCHAR(100) = '') " & vbCrLf
    s = s & "AS " & vbCrLf
    s = s & "  BEGIN " & vbCrLf
    s = s & "      --select costcode,description from standardcostcodes where DivisionID = @DivisionID " & vbCrLf
    s = s & "      SELECT s.costcode, " & vbCrLf
    s = s & "             s.description, " & vbCrLf
    s = s & "             CASE " & vbCrLf
    s = s & "               WHEN j.costcode IS NULL THEN 0 " & vbCrLf
    s = s & "               ELSE 1 " & vbCrLf
    s = s & "             END IsJobCostCode," & vbCrLf
    s = s & "             SUM(isnull(t.totalbudget,0)) Budget," & vbCrLf
    s = s & "             SUM(isnull(t.jtdcost,0)) CostToDate" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      FROM   standardcostcodes s " & vbCrLf
    s = s & "             LEFT OUTER JOIN jobcostcodes j ON j.divisionid = s.divisionid AND s.costcode = j.costcode AND j.job = @job " & vbCrLf
    s = s & "             LEFT OUTER JOIN hfjctotals t ON t.divisionid = s.divisionid AND s.costcode = t.costcode AND t.job = @job " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      WHERE  s.divisionid = @divisionid " & vbCrLf
    s = s & "             AND ( s.costcode LIKE '%' + @Term + '%' " & vbCrLf
    s = s & "                    OR s.description LIKE '%' + @Term + '%' ) " & vbCrLf
    s = s & "      GROUP BY s.costcode,s.description,j.costcode" & vbCrLf
    s = s & "      ORDER BY isjobcostcode DESC, " & vbCrLf
    s = s & "                costcode " & vbCrLf
    s = s & "  END" & vbCrLf
