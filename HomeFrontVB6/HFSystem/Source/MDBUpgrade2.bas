    s = ""
    s = s & "alter trigger tblVendors_Insert ON tblVendors FOR INSERT AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "-- make sure webuid is set" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "update tblvendors " & vbCrLf
    s = s & "set webuid=isnull(nullif(i.webuid,''),i.vendor_id)" & vbCrLf
    s = s & "from tblvendors v join inserted i on v.vendor_id=i.vendor_id" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "-- insert warranty vendor record" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "INSERT INTO Vendors(divisionid,VendorCode,CompanyName,Phone,Fax,CompanyAddr1,CompanyAddr2,CompanyCity,CompanyProv,CompanyPostal,active,contact)" & vbCrLf
    s = s & "SELECT i.divisionid,i.vendor_id,i.vendor_name,i.phone,i.fax,i.addr1,i.addr2,i.city,i.state,i.zip,case i.inactive when 1 then 0 else 1 end,i.contact" & vbCrLf
    s = s & "FROM inserted i LEFT OUTER JOIN vendors v ON(i.divisionid=v.divisionid and i.Vendor_ID=v.VendorCode)" & vbCrLf
    s = s & "WHERE v.VendorCode IS NULL" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "-- insert contacts" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "INSERT INTO Contacts(ContactTypeID,UserID,Role,ponotice,fponotice,servicenotice,schednotice,FirstName,DisplayName,WorkPhone,Fax,Email,cellphone,smsaddress,commmodeid,Active,VendorID,Vendorcode,CompanyName,CompanyAddr1,CompanyAddr2,CompanyCity,CompanyProv,CompanyPostal)" & vbCrLf
    s = s & "select 99,i.vendor_id+'_P','Purchasing',1,0,0,0,isnull(nullif(i.purchcontact,''),'Purchasing'),isnull(nullif(i.purchcontact,''),'Purchasing')" & vbCrLf
    s = s & ",i.purchphone,i.purchfax,i.purchemail,i.purchcell,i.purchsmsaddress,case purchdelmethod when 1 then 3 when 2 then 4 else 1 end" & vbCrLf
    s = s & ",1,v.vendorid,v.vendorcode,v.companyname,v.companyaddr1,v.companyaddr2,v.companycity,v.companyprov,v.companypostal" & vbCrLf
    s = s & "from inserted i" & vbCrLf
    s = s & "join vendors v on (i.divisionid=v.divisionid and i.vendor_id=v.vendorcode)" & vbCrLf
    s = s & "where purchcontactid=0 " & vbCrLf
    s = s & "union all" & vbCrLf
    s = s & "select 99,i.vendor_id+'_F','Field POs',0,1,0,0,isnull(nullif(i.fpocontact,''),'Field POs'),isnull(nullif(i.fpocontact,''),'Field POs')" & vbCrLf
    s = s & ",i.fpophone,i.fpofax,i.fpoemail,i.fpocell,i.fposmsaddress,case fpodelmethod when 1 then 3 when 2 then 4 else 1 end" & vbCrLf
    s = s & ",1,v.vendorid,v.vendorcode,v.companyname,v.companyaddr1,v.companyaddr2,v.companycity,v.companyprov,v.companypostal" & vbCrLf
    s = s & "from inserted i" & vbCrLf
    s = s & "join vendors v on (i.divisionid=v.divisionid and i.vendor_id=v.vendorcode)" & vbCrLf
    s = s & "where fpocontactid=0 " & vbCrLf
    s = s & "union all" & vbCrLf
    s = s & "select 99,i.vendor_id+'_W','Service',0,0,1,0,isnull(nullif(i.servicecontact,''),'Service'),isnull(nullif(i.Servicecontact,''),'Service')" & vbCrLf
    s = s & ",i.servicephone,i.servicefax,i.serviceemail,i.servicecell,i.servicesmsaddress,case servicedelmethod when 1 then 3 when 2 then 4 else 1 end" & vbCrLf
    s = s & ",1,v.vendorid,v.vendorcode,v.companyname,v.companyaddr1,v.companyaddr2,v.companycity,v.companyprov,v.companypostal" & vbCrLf
    s = s & "from inserted i" & vbCrLf
    s = s & "join vendors v on (i.divisionid=v.divisionid and i.vendor_id=v.vendorcode)" & vbCrLf
    s = s & "where servicecontactid=0 " & vbCrLf
    s = s & "union all" & vbCrLf
    s = s & "select 99,i.vendor_id+'_S','Scheduling',0,0,0,1,isnull(nullif(i.schedcontact,''),'Scheduling'),isnull(nullif(i.schedcontact,''),'Scheduling')" & vbCrLf
    s = s & ",i.schedphone,i.schedfax,i.schedemail,i.schedcell,i.schedsmsaddress,case scheddelmethod when 1 then 3 when 2 then 4 else 1 end" & vbCrLf
    s = s & ",1,v.vendorid,v.vendorcode,v.companyname,v.companyaddr1,v.companyaddr2,v.companycity,v.companyprov,v.companypostal" & vbCrLf
    s = s & "from inserted i" & vbCrLf
    s = s & "join vendors v on (i.divisionid=v.divisionid and i.vendor_id=v.vendorcode)" & vbCrLf
    s = s & "where schedcontactid=0 " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "--get service contactid and make warranty's default contactid" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
    s = s & "update vendors" & vbCrLf
    s = s & "set defaultcontactid=c.contactid" & vbCrLf
    s = s & "from inserted i" & vbCrLf
    s = s & "join tblvendors on(i.divisionid=tblvendors.divisionid and i.vendor_id=tblvendors.vendor_id)" & vbCrLf
    s = s & "join vendors v on(i.divisionid=v.divisionid and i.vendor_id=v.vendorcode)" & vbCrLf
    s = s & "join contacts c on(i.vendor_id=c.vendorcode and c.servicenotice=1)" & vbCrLf
    s = s & "where i.servicecontactid=0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "------------------------------------------------------------" & vbCrLf
