    s = s & "" & vbCrLf
    s = s & "           /* NEW - Time variables */" & vbCrLf
    s = s & "           @CurrTime       TIME," & vbCrLf
    s = s & "           @CurrTimePlus15 TIME" & vbCrLf
    s = s & "            " & vbCrLf
    s = s & "           /* NEW - Actual date no time only date */               " & vbCrLf
    s = s & "            SET @CurDate       =  DATEADD(dd, DATEDIFF(dd, 0, GETDATE()), 0)" & vbCrLf
    s = s & "" & vbCrLf
