    sql c, "DROP PROC Schedule_InsertScheduleConstraint", True
    s = ""
    s = s & "CREATE PROC [dbo].[Schedule_InsertScheduleConstraint]" & vbCrLf
    s = s & "       @ScheduleID int," & vbCrLf
    s = s & "       @FromTaskID varchar(50)," & vbCrLf
    s = s & "       @ToTaskID varchar(50)," & vbCrLf
    s = s & "       @LagTime float" & vbCrLf
    s = s & "AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "   DECLARE" & vbCrLf
    s = s & "       @FromScheduleTaskID int," & vbCrLf
    s = s & "       @ToScheduleTaskID int," & vbCrLf
    s = s & "       @FromLibraryTaskID int," & vbCrLf
    s = s & "       @ToLibraryTaskID int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "       /* Get LibraryTaskID for @FromTaskID */" & vbCrLf
    s = s & "       IF SUBSTRING(@FromTaskID,1,1)='L'" & vbCrLf
    s = s & "         BEGIN" & vbCrLf
    s = s & "           SET @FromLibraryTaskID = CAST(SUBSTRING(@FromTaskID,2,charindex('T',@FromTaskID)-2) AS int)" & vbCrLf
    s = s & "           /* Get ScheduleTaskID for the task and its predecessor*/" & vbCrLf
    s = s & "           SELECT @FromScheduleTaskID = ScheduleTaskID" & vbCrLf
    s = s & "           FROM dbo.ScheduleTasks" & vbCrLf
    s = s & "           WHERE LibraryTaskID = @FromLibraryTaskID " & vbCrLf
    s = s & "                       AND ScheduleID = @ScheduleID" & vbCrLf
    s = s & "         END" & vbCrLf
    s = s & "       ELSE" & vbCrLf
    s = s & "           SET @FromScheduleTaskID = CAST(@FromTaskID AS int)" & vbCrLf
    s = s & "           " & vbCrLf
    s = s & "       /* Get LibraryTaskID for @ToTaskID */" & vbCrLf
    s = s & "       IF SUBSTRING(@ToTaskID,1,1)='L'" & vbCrLf
    s = s & "         BEGIN" & vbCrLf
    s = s & "           SET @ToLibraryTaskID = CAST(SUBSTRING(@ToTaskID,2,charindex('T',@ToTaskID)-2) AS int)" & vbCrLf
    s = s & "           SELECT @ToScheduleTaskID = ScheduleTaskID" & vbCrLf
    s = s & "           FROM dbo.ScheduleTasks" & vbCrLf
    s = s & "           WHERE LibraryTaskID = @ToLibraryTaskID AND ScheduleID = @ScheduleID" & vbCrLf
    s = s & "         END" & vbCrLf
    s = s & "       ELSE" & vbCrLf
    s = s & "           SET @ToScheduleTaskID = CAST(@ToTaskID AS int)" & vbCrLf
    s = s & "       " & vbCrLf
    s = s & "       INSERT INTO dbo.ScheduleConstraints(FromScheduleTaskID, ToScheduleTaskID, ConstraintType,LagTime)" & vbCrLf
    s = s & "       VALUES(@FromScheduleTaskID,@ToScheduleTaskID,0,@LagTime)" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s



