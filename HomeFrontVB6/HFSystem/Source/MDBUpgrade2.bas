c = "Add password complexity enforcement"
    sql c, "insert appoptions(divisionid,uid,optionname,optionvalue) values(1,'','EnforcePasswordComplexity','False')", True
    sql c, "drop FUNCTION [dbo].[ZYB_IsPswdComplex]", True

    s = ""
    s = s & "CREATE FUNCTION [dbo].[ZYB_IsPswdComplex](@DivisionID INT, @UserID VARCHAR(500), @Pswd VARCHAR(500)) RETURNS varchar(500) AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "   -- Returns empty string if password is acceptable, otherwise returns rejection reason." & vbCrLf
    s = s & "   --" & vbCrLf
    s = s & "   -- Passwords are complex if they:" & vbCrLf
    s = s & "   --    have more than 8 characters and " & vbCrLf
    s = s & "   --    are different than the userid and" & vbCrLf
    s = s & "   --    have a complexity score greater than 15 points. " & vbCrLf
    s = s & "   -- complexity points are awarded as follows:" & vbCrLf
    s = s & "   --   contains uppercase          5 points" & vbCrLf
    s = s & "   --   contains lowercase          5 points" & vbCrLf
    s = s & "   --   contains numeric            5 points" & vbCrLf
    s = s & "   --   contains format characters  5 points" & vbCrLf
    s = s & "   --   longer than 12 characters   5 points" & vbCrLf
    s = s & "   --   longer than 18 characters  10 points" & vbCrLf
    s = s & "   --   longer than 30 characters  15 points" & vbCrLf
    s = s & "   --" & vbCrLf
    s = s & "   -- NOTE: len() function excludes trailing spaces so replace spaces with underscores." & vbCrLf
    s = s & " " & vbCrLf
    s = s & "   declare @errmsg varchar(500)" & vbCrLf
    s = s & "   declare @s varchar(10)   " & vbCrLf
    s = s & "   declare @score int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   --appoption to disable complexity checking" & vbCrLf
    s = s & "   select @s=dbo.GetOption_Varchar(@DivisionID,'EnforcePasswordComplexity')" & vbCrLf
    s = s & "   if @s<>'true'    " & vbCrLf
    s = s & "      return( '' )" & vbCrLf
    s = s & "      " & vbCrLf
