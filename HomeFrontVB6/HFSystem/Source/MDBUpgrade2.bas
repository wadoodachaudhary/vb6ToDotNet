    s = s & "       @SrcToScheduleTaskID int," & vbCrLf
    s = s & "       @FromLibraryTaskID int," & vbCrLf
    s = s & "       @ToLibraryTaskID int," & vbCrLf
    s = s & "       @SrcFromLibraryTaskID int," & vbCrLf
    s = s & "       @SrcToLibraryTaskID int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "       /* Get LibraryTaskID for @FromTaskID */" & vbCrLf
    s = s & "       IF SUBSTRING(@FromTaskID,1,1)='L'" & vbCrLf
    s = s & "         BEGIN" & vbCrLf
    s = s & "           SET @FromLibraryTaskID = CAST(SUBSTRING(@FromTaskID,2,charindex('T',@FromTaskID)-2) AS int)" & vbCrLf
    s = s & "           /* Get ScheduleTaskID for the task and its predecessor*/" & vbCrLf
    s = s & "           SELECT @FromScheduleTaskID = ScheduleTaskID" & vbCrLf
    s = s & "           FROM dbo.ScheduleTasks" & vbCrLf
    s = s & "           WHERE LibraryTaskID = @FromLibraryTaskID " & vbCrLf
    s = s & "                       AND ScheduleID = @ScheduleID" & vbCrLf
    s = s & "         END" & vbCrLf
    s = s & "       ELSE" & vbCrLf
    s = s & "           SET @FromScheduleTaskID = CAST(@FromTaskID AS int)" & vbCrLf
    s = s & "           " & vbCrLf
    s = s & "       /* Get LibraryTaskID for @ToTaskID */" & vbCrLf
    s = s & "       IF SUBSTRING(@ToTaskID,1,1)='L'" & vbCrLf
    s = s & "         BEGIN" & vbCrLf
    s = s & "           SET @ToLibraryTaskID = CAST(SUBSTRING(@ToTaskID,2,charindex('T',@ToTaskID)-2) AS int)" & vbCrLf
    s = s & "           SELECT @ToScheduleTaskID = ScheduleTaskID" & vbCrLf
    s = s & "           FROM dbo.ScheduleTasks" & vbCrLf
    s = s & "           WHERE LibraryTaskID = @ToLibraryTaskID AND ScheduleID = @ScheduleID" & vbCrLf
    s = s & "         END" & vbCrLf
    s = s & "       ELSE" & vbCrLf
    s = s & "           SET @ToScheduleTaskID = CAST(@ToTaskID AS int)" & vbCrLf
    s = s & "       " & vbCrLf
    s = s & "       /* Get LibraryTaskID for @SrcFromTaskID */" & vbCrLf
    s = s & "       IF SUBSTRING(@SrcFromTaskID,1,1)='L'" & vbCrLf
    s = s & "         BEGIN" & vbCrLf
    s = s & "           SET @SrcFromLibraryTaskID = CAST(SUBSTRING(@SrcFromTaskID,2,charindex('T',@SrcFromTaskID)-2) AS int)" & vbCrLf
    s = s & "           /* Get ScheduleTaskID for the task and its predecessor*/" & vbCrLf
    s = s & "           SELECT @SrcFromScheduleTaskID = ScheduleTaskID" & vbCrLf
    s = s & "           FROM dbo.ScheduleTasks" & vbCrLf
    s = s & "           WHERE LibraryTaskID = @SrcFromLibraryTaskID " & vbCrLf
    s = s & "                       AND ScheduleID = @ScheduleID" & vbCrLf
    s = s & "         END" & vbCrLf
    s = s & "       ELSE" & vbCrLf
    s = s & "           SET @SrcFromScheduleTaskID = CAST(@SrcFromTaskID AS int)" & vbCrLf
    s = s & "       " & vbCrLf
    s = s & "       /* Get LibraryTaskID for @SrcToTaskID */" & vbCrLf
    s = s & "       IF SUBSTRING(@SrcToTaskID,1,1)='L'" & vbCrLf
    s = s & "         BEGIN" & vbCrLf
    s = s & "           SET @SrcToLibraryTaskID = CAST(SUBSTRING(@SrcToTaskID,2,charindex('T',@SrcToTaskID)-2) AS int)" & vbCrLf
    s = s & "           /* Get ScheduleTaskID for the task and its predecessor*/" & vbCrLf
    s = s & "           SELECT @SrcToScheduleTaskID = ScheduleTaskID" & vbCrLf
    s = s & "           FROM dbo.ScheduleTasks" & vbCrLf
    s = s & "           WHERE LibraryTaskID = @SrcToLibraryTaskID " & vbCrLf
    s = s & "                       AND ScheduleID = @ScheduleID" & vbCrLf
    s = s & "         END" & vbCrLf
    s = s & "       ELSE" & vbCrLf
    s = s & "           SET @SrcToScheduleTaskID = CAST(@SrcToTaskID AS int)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   UPDATE    ScheduleConstraints" & vbCrLf
    s = s & "   SET              FromScheduleTaskID =@FromScheduleTaskID, ToScheduleTaskID = @ToScheduleTaskID, " & vbCrLf
    s = s & "              ConstraintType =0, LagTime = @LagTime" & vbCrLf
    s = s & "   WHERE     (FromScheduleTaskID = @SrcFromScheduleTaskID) AND (ToScheduleTaskID = @SrcToScheduleTaskID) AND(ConstraintType  = 0)" & vbCrLf
    s = s & "           " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   END" & vbCrLf
    sql c, s


