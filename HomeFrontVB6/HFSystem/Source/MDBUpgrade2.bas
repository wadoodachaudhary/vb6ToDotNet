    s = s & "   select workticket,sequence,description,material,costcode,category,qty,chargerate,uom,pretax,referencedoc,ustmp,tstmp,vendor,handlingpercent,debitaccount,creditaccount,taxgroup,costrate,invoicenumber,ponumber,podescription,fieldreq,guid,surchargepercent,job,extra,divisionid" & vbCrLf
