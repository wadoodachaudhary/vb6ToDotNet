    s = s & " SET @SQLSTMT = @SQLSTMT + '  when ''AccountingAdministrator'' then v.AccountingAdministratorEmail when ''SalesPerson'' then v.SalesPersonEmail when ''DCSalesPerson'' then v.DCSalesPersonEmail when ''Realtor'' then v.RealtorEmail'" & vbCrLf
    s = s & " SET @SQLSTMT = @SQLSTMT + '  when ''Broker'' then v.BrokerEmail when ''Lender'' then v.LenderEmail when ''TitleCompany'' then v.TitleCompanyEmail when ''SellingRealtor'' then v.SellingRealtorEmail else '''' end'" & vbCrLf
