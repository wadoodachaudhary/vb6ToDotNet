    s = s & "   left outer join taxGroups t on (t.TaxGroup=dbo.Purch_GetDefaultTaxGroup('' , c.area ,'' , sd.Model , sd.Assembly ,i.phase ,i.item , v.Vendor_ID , i.JCCategory,w.DivisionID ))  " & vbCrLf
