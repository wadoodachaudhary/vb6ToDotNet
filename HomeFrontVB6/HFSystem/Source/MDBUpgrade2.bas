    s = s & "-- ScheduleB ----------------------------------------" & vbCrLf
    s = s & "SELECT" & vbCrLf
    s = s & "  c.Community, l.Description AS CommunityDesc, c.Phase AS CommunityPhase, p.Description AS CommunityPhaseDesc, ISNULL(l.Description, '') + ISNULL(' ' + p.Description, '') AS FullCommunityDesc, " & vbCrLf
    s = s & "  j.Job_No AS Job, j.Description AS JobDesc, c.Customer_No, c.Description AS CustomerDesc, c.Municipal_Address, c.Elevation, c.Square_Footage, c.Model, c.Series, m.Description AS ModelDesc," & vbCrLf
    s = s & "  d.Major_Group, d.Category, d.OPT, d.Description, d.QTY, d.Rate, d.Override_Price, d.comments, d.EstimatorNotes, '' AS Change_Order_No, d.seq, 1 AS Location, d.[Assembly], d.UOM AS AssemblyUOM," & vbCrLf
    s = s & "  d.SalesWorksheet, d.Option_Type AS OptionType, CASE WHEN d .option_type = 0 THEN - 1 ELSE d .option_type + 1 END AS AssemblyType, isnull(d.TL_Extra,'') AS JCExtra, d.Color, d.Location AS RoomLocation," & vbCrLf
    s = s & "  d.Style,d.Finish,d.Other" & vbCrLf
    s = s & "FROM" & vbCrLf
    s = s & "  tblCustomers AS c INNER JOIN" & vbCrLf
