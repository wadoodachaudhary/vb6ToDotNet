    s = s & "            set @adj4 = 0" & vbCrLf
    s = s & "            set @adj5 = 0" & vbCrLf
    s = s & "            set @adj6 = 0" & vbCrLf
    s = s & "IF @RevenueAdjustment <> 0 BEGIN" & vbCrLf
    s = s & "            SET @TotalRevenue = @AddendumAmt+@DCAmt+@COAmt-@Incentive+@NHWFees" & vbCrLf
    s = s & "            SET @rowinc = 1" & vbCrLf
    s = s & "            WHILE @rowinc<=5 and @TotalRevenue <> 0" & vbCrLf
    s = s & "            BEGIN " & vbCrLf
