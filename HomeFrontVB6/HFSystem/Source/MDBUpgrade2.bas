    s = s & "       update tblsalessheetdetails set cost = @Total+isnull(LandCost,0)+isnull(IncentiveCost,0),ConstructionCost = @Total,Pretax=dbo.RndTo(round((@Total+isnull(LandCost,0)+isnull(IncentiveCost,0))*(1+(Markup/100)),2),1,case RoundTo when 0 then 1 else RoundTo end) where worksheet = @SalesSheet and Community =@CommunityID and CommunityPhase = @CommunityPhaseID and Assembly=@AssemblyID and Model = @ModelID and OptionID=@Option_ID and Series = @SeriesID      " & vbCrLf
    s = s & "    END ELSE BEGIN" & vbCrLf
