    s = s & "        ,@Segment3       = dbo.GetOption_Integer(@DivisionID,'POFormatSegment3')" & vbCrLf
    s = s & "        ,@Segment4       = dbo.GetOption_Integer(@DivisionID,'POFormatSegment4')" & vbCrLf
    s = s & "        ,@Segment5       = dbo.GetOption_Varchar(@DivisionID,'POFormatSegment5')" & vbCrLf
    s = s & "        ,@Segment6       = dbo.GetOption_Integer(@DivisionID,'POFormatSegment6')" & vbCrLf
    s = s & "        ,@Segment7       = dbo.GetOption_Varchar(@DivisionID,'POFormatSegment7')" & vbCrLf
    s = s & "        ,@Segment8       = dbo.GetOption_Integer(@DivisionID,'POFormatSegment8')" & vbCrLf
    s = s & "  " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  -- create job based ponumber                        --" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  IF @NumberingStyle='Job' BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- get sequential part of ponumber" & vbCrLf
    s = s & "    SELECT @PONumber = ISNULL(LastPOSeq,0)+1 FROM tblJobs WHERE DivisionID=@DivisionID and Job_No=@Job" & vbCrLf
    s = s & "    IF @PONumber IS NULL" & vbCrLf
    s = s & "      SELECT @PONumber = ISNULL(LastPOSeq,0)+1 FROM tblLocality WHERE Area=@Job" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- pad it with zeros and add separator" & vbCrLf
    s = s & "    SELECT @PONumber = RIGHT(@Job, @Segment1)" & vbCrLf
    s = s & "                     + @Segment2" & vbCrLf
    s = s & "                     + replace(space(cast(dbo.max(0,@Segment3-len(cast(@PONumber as varchar))) as int)),' ','0')" & vbCrLf
    s = s & "                     + cast(@PONumber as varchar)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  -- create job and poindex based ponumber            --" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  END ELSE BEGIN IF @NumberingStyle='JobPOIndex' BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- make sure jobpoindex record exists" & vbCrLf
    s = s & "    INSERT jobpoindex(divisionid,job_no,poindex)" & vbCrLf
    s = s & "    SELECT j.divisionid,j.job_no,'99 Manual PO'" & vbCrLf
    s = s & "    FROM tbljobs j" & vbCrLf
    s = s & "    LEFT OUTER JOIN jobpoindex p on j.divisionid=p.divisionid and j.job_no=p.job_no and p.poindex=@POIndex" & vbCrLf
    s = s & "    WHERE j.DivisionID=@DivisionID and j.Job_No=@Job and p.Job_no is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- get sequential part of ponumber" & vbCrLf
    s = s & "    SELECT @PONumber = ISNULL(LastPOSeq,0)+1 FROM jobpoindex WHERE DivisionID=@DivisionID and Job_No=@Job and poindex=@poindex" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- pad it with zeros and add separator" & vbCrLf
    s = s & "    SELECT @PONumber = RIGHT(@Job, @Segment4)" & vbCrLf
    s = s & "                     + @Segment5" & vbCrLf
    s = s & "                     + LEFT(@POIndex, @Segment6)" & vbCrLf
    s = s & "                     + @Segment7" & vbCrLf
    s = s & "                     + replace(space(cast(dbo.max(0,@Segment8-len(cast(@PONumber as varchar))) as int)),' ','0')" & vbCrLf
    s = s & "                     + cast(@PONumber as varchar)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  -- create sequential ponumber                       --" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  END ELSE BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    INSERT INTO PONumbers(TStmp) VALUES(GETDATE())" & vbCrLf
    s = s & "    SET @PONumber = @POPrefix + cast(IDENT_CURRENT('PONumbers') as varchar(12))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  END END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  -- return ponumber                                  --" & vbCrLf
    s = s & "  ------------------------------------------------------" & vbCrLf
    s = s & "  UPDATE tblLocality SET LastPOSeq=ISNULL(LastPOSeq,0)+1 WHERE Area=@Job" & vbCrLf
    s = s & "  UPDATE tblJobs SET LastPOSeq=ISNULL(LastPOSeq,0)+1 WHERE DivisionID=@DivisionID and Job_No=@Job" & vbCrLf
    s = s & "  UPDATE jobpoindex SET LastPOSeq=ISNULL(LastPOSeq,0)+1 WHERE DivisionID=@DivisionID and Job_No=@Job and poindex=@poindex" & vbCrLf
    s = s & "  SELECT REPLACE(@PONumber,' ','0')" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s

    s = ""
    s = s & "AlTER TRIGGER [POMaster_CreateInvoice] ON [dbo].[POMaster] FOR UPDATE AS" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "IF UPDATE(ApprovedDate) BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    INSERT INTO Invoices(DivisionID,Vendor,Invoice,InvoiceDate,AccountingDate,Description,Status,VendorName,PreTax,Tax,Source,UStmp,TStmp)" & vbCrLf
    s = s & "    SELECT m.DivisionID,m.Vendor" & vbCrLf
    s = s & "          ,m.PONumber" & vbCrLf
    s = s & "          ,m.ApprovedDate InvoiceDate" & vbCrLf
    s = s & "          ,m.ApprovedDate AccountingDate" & vbCrLf
    s = s & "          ,LEFT(m.description,100) Description" & vbCrLf
    s = s & "          ,'SiteApproved' Status" & vbCrLf
    s = s & "          ,v.Vendor_Name VendorName" & vbCrLf
    s = s & "          ,SUM(ISNULL(i.Pretax,0)) Pretax" & vbCrLf
    s = s & "          ,SUM(ISNULL(i.JCTax,0)+ISNULL(i.NJCTax,0)) Tax" & vbCrLf
    s = s & "          ,'autoinserting..' Source" & vbCrLf
    s = s & "          ,m.ApprovedBy UStmp" & vbCrLf
    s = s & "          ,getdate() TStmp" & vbCrLf
    s = s & "      FROM Inserted m" & vbCrLf
    s = s & "      LEFT OUTER JOIN Invoices e ON(m.DivisionID = e.DivisionID and m.PONumber=e.Invoice and m.Vendor=e.Vendor)" & vbCrLf
    s = s & "      JOIN POItems i ON(m.PONumber=i.PONumber and m.DivisionID = i.DivisionID)" & vbCrLf
    s = s & "      JOIN tblVendors v ON(v.Vendor_ID=m.Vendor and v.DivisionID = m.DivisionID)     " & vbCrLf
    s = s & "      JOIN AppOptions ao ON(ao.OptionName='AutoPayApprovedPOs' and ao.OptionValue='True' AND ao.DivisionID = m.DivisionID)     " & vbCrLf
    s = s & "     WHERE e.Invoice IS NULL" & vbCrLf
    s = s & "       AND m.ApprovedDate IS NOT NULL" & vbCrLf
    s = s & "       AND m.Cancelled<>1" & vbCrLf
    s = s & "     GROUP BY m.DivisionID,m.Vendor,m.PONumber,m.ApprovedDate,m.description,v.Vendor_Name,v.APType,m.ApprovedBy" & vbCrLf
    s = s & "         " & vbCrLf
    s = s & "     INSERT INTO InvoiceItems(DivisionID,InvoiceID,Vendor,Invoice,Commitment,CommitmentItem,CommitmentDesc,CommitmentVendor,Job,Extra,Phase,PhaseDesc,Category,CategoryDesc,InvoicedQuantity,TaxGroup,TaxGroupDesc,TaxRate,PreTax,Tax,Description,Retainage,RetainageRate)" & vbCrLf
    s = s & "     SELECT m.DivisionID,e.InvoiceID" & vbCrLf
    s = s & "           ,e.Vendor " & vbCrLf
    s = s & "           ,e.Invoice" & vbCrLf
    s = s & "           ,i.PONumber Commitment" & vbCrLf
    s = s & "           ,i.LineNumber CommitmentItem" & vbCrLf
    s = s & "           ,LEFT(m.Description,200) CommitmentDesc" & vbCrLf
    s = s & "           ,e.Vendor CommitmentVendor" & vbCrLf
    s = s & "           ,i.Job" & vbCrLf
    s = s & "           ,i.JCExtra" & vbCrLf
    s = s & "           ,i.JCCostCode Phase" & vbCrLf
    s = s & "           ,cc.Description" & vbCrLf
    s = s & "           ,i.JCCategory" & vbCrLf
    s = s & "           ,c.Description" & vbCrLf
    s = s & "           ,0" & vbCrLf
    s = s & "           ,ISNULL(i.TaxGroup,'') TaxGroup" & vbCrLf
    s = s & "           ,LEFT(t.Description,30) TaxGroupDescription" & vbCrLf
    s = s & "           ,ISNULL(t.GroupRate,0) TaxRate" & vbCrLf
    s = s & "           ,sum(ROUND(isnull(i.pretax,0)-isnull(x.pretax,0),2))  Pretax" & vbCrLf
    s = s & "           ,sum(round(isnull(i.jctax,0)+isnull(i.njctax,0)-isnull(x.Tax,0),2)) Tax" & vbCrLf
    s = s & "           ,Left(i.LineDescription,100) Description" & vbCrLf
    s = s & "           ,Round(sum(ROUND(isnull(i.pretax,0)-isnull(x.pretax,0),2))*m.RetainagePercent/100,2)" & vbCrLf
    s = s & "           ,isnull(m.RetainagePercent,0)" & vbCrLf
    s = s & "       FROM Inserted m" & vbCrLf
    s = s & "       JOIN Invoices e ON(e.DivisionID = m.DivisionID and m.PONumber=e.Invoice and m.Vendor=e.Vendor and e.Source='autoinserting..')" & vbCrLf
    s = s & "       join pototals pt on(m.DivisionID = pt.DivisionID and m.ponumber=pt.ponumber)" & vbCrLf
    s = s & "       left outer join pototalinvoiced pti on(m.DivisionID = pti.DivisionID and m.ponumber=pti.ponumber)" & vbCrLf
    s = s & "       join tblvendors v on(m.vendor=v.vendor_id and v.DivisionID = m.DivisionID)" & vbCrLf
    s = s & "       join tbljobs j on(m.job=j.job_no and j.DivisionID = m.DivisionID)" & vbCrLf
    s = s & "       join poitemsSummarized i on(i.DivisionID = m.DivisionID and m.ponumber=i.ponumber)" & vbCrLf
    s = s & "       left outer join poinvoicedamounts x on(i.ponumber=x.ponumber and i.linenumber=x.itemseq)" & vbCrLf
    s = s & "       join standardcostcodes cc on(cc.DivisionID = m.DivisionID and i.jccostcode=cc.costcode)" & vbCrLf
    s = s & "       join standardcategories c on(c.DivisionID = m.DivisionID and i.jccategory=c.category)" & vbCrLf
    s = s & "       LEFT OUTER JOIN TaxGroups t ON(t.DivisionID = m.DivisionID and t.TaxGroup=i.TaxGroup)" & vbCrLf
    s = s & "      where m.ApprovedDate IS NOT NULL" & vbCrLf
    s = s & "        and e.Invoice IS NOT NULL" & vbCrLf
    s = s & "        AND m.Cancelled<>1" & vbCrLf
    s = s & "      group by pti.pretax,pt.pretaxtotal,m.DivisionID,e.InvoiceID,e.Vendor,e.Invoice,i.PONumber,i.LineNumber,left(m.Description,200),e.Vendor,i.TaxGroup,t.Description,t.GroupRate,i.job,i.jcextra,i.jccostcode,cc.Description,i.jccategory,c.Description,left(i.Linedescription,100),m.RetainagePercent" & vbCrLf
    s = s & "      Having pt.pretaxtotal - isnull(pti.pretax,0) <> 0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "     SET Source='AutoApproved'" & vbCrLf
    s = s & "      FROM Inserted m" & vbCrLf
    s = s & "      JOIN Invoices e ON(m.DivisionID = e.DivisionID and m.PONumber=e.Invoice and m.Vendor=e.Vendor and e.Source='autoinserting..')" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s

    s = ""
    s = s & "alter view dbo.JobCostCodes as " & vbCrLf
    s = s & "select distinct e.DivisionID,e.Job,e.JCCostCode CostCode,c.Description" & vbCrLf
    s = s & "from estimateitems e left outer join standardcostcodes c on (e.JCCostCode=c.CostCode and e.DivisionID = c.DivisionID)" & vbCrLf
    s = s & "union" & vbCrLf
    s = s & "select distinct i.DivisionID,i.Job,i.phase CostCode,c.Description" & vbCrLf
    s = s & "from invoiceitems i left outer join standardcostcodes c on (i.phase=c.CostCode and i.DivisionID = c.DivisionID)" & vbCrLf
    s = s & "where i.job<>''" & vbCrLf
