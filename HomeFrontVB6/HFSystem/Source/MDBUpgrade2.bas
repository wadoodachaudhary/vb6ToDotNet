c = "Add divisionid to Quickbooks Job import settings"
    s = ""
    s = s & "alter PROCEDURE dbo.QB_Jobs @DivisionID int, @xmlString text as" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "DECLARE @jobstyle varchar(50)" & vbCrLf
    s = s & "select @jobstyle = dbo.GetOption_Varchar(@DivisionID, 'QuickbooksJobStyle')" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "DECLARE @idoc int" & vbCrLf
    s = s & "EXEC sp_xml_preparedocument @idoc OUTPUT, @xmlString" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "if @jobstyle = 'simple'" & vbCrLf
    s = s & "begin" & vbCrLf
    s = s & "    SELECT Customer    CustomerNumber" & vbCrLf
    s = s & "          ,Description Customer" & vbCrLf
    s = s & "          ,Customer    JobNumber" & vbCrLf
    s = s & "          ,Description Job" & vbCrLf
    s = s & "          ,Comments    JobComments" & vbCrLf
    s = s & "      FROM OPENXML (@idoc, '/QBXML/QBXMLMsgsRs/CustomerQueryRs/CustomerRet',2)" & vbCrLf
    s = s & "           WITH (Customer   varchar(40) 'ListID'" & vbCrLf
    s = s & "                ,Description  varchar(50) 'Name'" & vbCrLf
    s = s & "                ,Comments  varchar(4000)  'Notes'" & vbCrLf
    s = s & "                ,Parent  varchar(50) 'ParentRef/ListID')" & vbCrLf
    s = s & "     WHERE ISNULL(parent,'')=''" & vbCrLf
    s = s & "    ORDER BY 2,4" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "end else begin" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    SELECT c.Customer    CustomerNumber" & vbCrLf
    s = s & "          ,c.Description Customer" & vbCrLf
    s = s & "          ,j.Job         JobNumber" & vbCrLf
    s = s & "          ,j.Description Job" & vbCrLf
    s = s & "          ,j.Comments    JobComments" & vbCrLf
    s = s & "    FROM OPENXML (@idoc, '/QBXML/QBXMLMsgsRs/CustomerQueryRs/CustomerRet',2)" & vbCrLf
    s = s & "         WITH (Job          varchar(40) 'ListID'" & vbCrLf
    s = s & "              ,Description  varchar(50) 'Name'" & vbCrLf
    s = s & "              ,Comments  varchar(4000)  'Notes'" & vbCrLf
    s = s & "              ,Parent  varchar(50) 'ParentRef/ListID') j" & vbCrLf
    s = s & "    JOIN OPENXML (@idoc, '/QBXML/QBXMLMsgsRs/CustomerQueryRs/CustomerRet',2)" & vbCrLf
    s = s & "         WITH (Customer     varchar(40) 'ListID'" & vbCrLf
    s = s & "              ,Description  varchar(50) 'Name') c on (j.Parent=c.customer)" & vbCrLf
    s = s & "    ORDER BY 2,4" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "end" & vbCrLf
    sql c, s

