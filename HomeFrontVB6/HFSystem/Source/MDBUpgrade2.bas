    s = s & " SET @SQLSTMT = @SQLSTMT + ' left outer join AutoNotifications an on (an.TriggerName = ''AE_POVendorComplete'' and an.Param1=i.PONumber)'" & vbCrLf
    s = s & " SET @SQLSTMT = @SQLSTMT + ' where i.VendorCompleteDate is not null and an.Triggername is null and '" & vbCrLf
    s = s & " SET @SQLSTMT = @SQLSTMT + 'case ar.RecipientType when ''Buyer'' then v.BuyerEmail when ''CoBuyer'' then v.CoBuyerEmail when ''Estimator'' then v.EstimatorEmail when ''PM'' then v.PMEmail when ''Purchaser'' then v.PurchaserEmail when ''SalesManager'' then v.SalesManagerEmail'" & vbCrLf
    s = s & " SET @SQLSTMT = @SQLSTMT + '  when ''AccountingAdministrator'' then v.AccountingAdministratorEmail when ''SalesPerson'' then v.SalesPersonEmail when ''DCSalesPerson'' then v.DCSalesPersonEmail when ''Realtor'' then v.RealtorEmail'" & vbCrLf
    s = s & " SET @SQLSTMT = @SQLSTMT + '  when ''Broker'' then v.BrokerEmail when ''Lender'' then v.LenderEmail when ''TitleCompany'' then v.TitleCompanyEmail when ''SellingRealtor'' then v.SellingRealtorEmail else '''' end <> '''''" & vbCrLf
