    s = s & ", Isnull(DS_PD_Total,0) + Isnull(DS_AP_Total,0), Isnull(ContractIncentives,0),isnull(COPDExempt,0)+isnull(COAPExempt,0),isnull(ExemptIncentives,0) ,0- isnull(Sales_Deduction,0) - isnull(salesdeductiontax,0),0- isnull(Sales_Initiative,0) - isnull(salesincentivetax,0)" & vbCrLf
    s = s & ",isnull(override_price,0) + isnull(Elevation_Price,0) + Isnull(Parking1_Price,0)+ Isnull(Parking2_Price,0)+ Isnull(Parking3_Price,0)+ Isnull(Parking4_Price,0)+ Isnull(Parking5_Price,0)+ Isnull(Parking6_Price,0)+ Isnull(Parking7_Price,0)" & vbCrLf
