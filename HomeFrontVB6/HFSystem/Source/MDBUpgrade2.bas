    s = s & "        if exists(select * from deleted where optdeleted = 1) begin" & vbCrLf
    s = s & "            raiserror('Cannot modify items that have been deleted on a deleted items change order.',16,1)" & vbCrLf
    s = s & "            rollback transaction" & vbCrLf
    s = s & "        end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        if exists(select * from changeordermaster m  inner join deleted d on  m.customer_no = d.customer_no and m.change_order_no = d.change_order_no where m.bldr_approved = 1) begin" & vbCrLf
    s = s & "            raiserror('Cannot modify items for items related to an approved change order.',16,1)" & vbCrLf
    s = s & "            rollback transaction" & vbCrLf
    s = s & "        end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        insert into dbo.userauditlog (loginname,workstationname,logindate,auditdate,hfloginid,tablename,keyvalues,appname,typeofchange,comments)" & vbCrLf
    s = s & "        select system_user,host_name(),u.logindate,getdate(),u.hfloginid,'changeorderdetails',i.customer_no+' '+i.change_order_no,app_name(),'update','customer '+left(i.customer_no+'  co: '+i.change_order_no+'  option:'+i.opt+' ' +i.[description],255)" & vbCrLf
    s = s & "        from inserted i left outer join usersessions u on (u.host_id=host_id() and u.workstationname=host_name())" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    end" & vbCrLf
