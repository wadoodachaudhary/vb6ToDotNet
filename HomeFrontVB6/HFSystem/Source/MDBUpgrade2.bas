    s = ""
    s = s & "alter PROCEDURE [dbo].[Claims_CreateClaim](@DivisionID int, @BillingCustomer_No  VARCHAR(12), @ClaimNumber varchar(20)) AS" & vbCrLf
    s = s & "DECLARE @ClaimID int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   -- CREATE CLAIM --------------------" & vbCrLf
    s = s & "   update tblcustomers " & vbCrLf
    s = s & "   set LastClaimNumber=isnull(LastClaimNumber,0)+1" & vbCrLf
    s = s & "   where customer_No = @BillingCustomer_No" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   insert into Claims(DivisionID,Customer_No,ClaimNumber,ClaimDate,Status,TaxGroup,JCTaxRate,NJCTaxRate,CRAcct)" & vbCrLf
    s = s & "   select c.DivisionID,c.Customer_No,isnull(nullif(@ClaimNumber,''),cast(c.LastClaimNumber as varchar)),GetDate(),'Pending',t.taxgroup,t.jcrate,t.njcrate,s.sale_credit" & vbCrLf
    s = s & "   from tblCustomers c" & vbCrLf
    s = s & "   join system_setup s on c.divisionid=s.id" & vbCrLf
    s = s & "   left outer join appoptions o on o.divisionid=c.divisionid and o.optionname='DefaultARTaxGroup'" & vbCrLf
    s = s & "   left outer join taxgroups t on t.divisionid=c.divisionid and taxgroup=o.optionvalue" & vbCrLf
    s = s & "   where customer_No = @BillingCustomer_No" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   select @ClaimID=IDENT_CURRENT('Claims')" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   -- SAVE PRICE SNAPSHOT --------------------" & vbCrLf
    s = s & "   insert into ClaimContractAmounts(ClaimID,Customer_No,ContractAmount)" & vbCrLf
    s = s & "   select @ClaimID,Customer_no,Total_Sales_Price" & vbCrLf
    s = s & "   from tblcustomers where BillingParent = @BillingCustomer_No" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   -- CLAIM ITEMS --------------------" & vbCrLf
    s = s & "   insert into ClaimItems(ClaimID,BillingItemId,Description,ContractAmount,ContractPercent,AmountPreviouslyClaimed,PercentPreviouslyClaimed,AmountThisClaim,PercentComplete,SortOrder)" & vbCrLf
    s = s & "   select @ClaimID,d.BillingItemID,d.Description,d.ContractAmount" & vbCrLf
    s = s & "         ,d.ContractAmount/nullif(c.total_sales_price,0)*100" & vbCrLf
    s = s & "         ,isnull(t.TotalAmountClaimed,0)  AmountPreviouslyClaimed" & vbCrLf
    s = s & "         ,isnull(t.TotalAmountClaimed,0)/nullif(d.ContractAmount,0)*100 PercentPreviouslyClaimed" & vbCrLf
    s = s & "         ,round(isnull(d.PercentComplete,0)/100 * isnull(d.ContractAmount,0) - isnull(t.TotalAmountClaimed,0),2) AmountThisClaim" & vbCrLf
    s = s & "         ,isnull(d.PercentComplete,0) PercentComplete" & vbCrLf
    s = s & "         ,d.SortOrder" & vbCrLf
    s = s & "   from tblcustomers c" & vbCrLf
    s = s & "   join CustomerBillingItems d on c.customer_No=d.Customer_No" & vbCrLf
    s = s & "   left outer join ClaimItemTotals t on d.BillingItemID=t.BillingItemID" & vbCrLf
    s = s & "   where c.BillingParent = @BillingCustomer_No" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   -- CREATE CLAIM CO ITEMS --------------------" & vbCrLf
    s = s & "   insert into ClaimCOItems(ClaimID,Customer_No,ChangeOrderNumber,COAmount,AmountPreviouslyClaimed,PercentPreviouslyClaimed,AmountThisClaim,PercentComplete)" & vbCrLf
    s = s & "   select @ClaimID" & vbCrLf
    s = s & "         ,d.Customer_No" & vbCrLf
    s = s & "         ,d.Change_Order_No" & vbCrLf
    s = s & "         ,d.Total_Price" & vbCrLf
    s = s & "         ,isnull(t.TotalAmountClaimed,0) AmountPreviouslyClaimed" & vbCrLf
    s = s & "         ,isnull(t.TotalAmountClaimed,0)/nullif(d.Total_Price,0)*100 PercentPreviouslyClaimed" & vbCrLf
    s = s & "         ,round(isnull(d.PercentComplete,0)/100 * isnull(d.Total_Price,0) - isnull(t.TotalAmountClaimed,0),2) AmountThisClaim" & vbCrLf
    s = s & "         ,isnull(d.PercentComplete,0) PercentComplete" & vbCrLf
    s = s & "   from tblCustomers c" & vbCrLf
    s = s & "   join AllChangeOrders d on c.customer_no=d.customer_no" & vbCrLf
    s = s & "   left outer join ClaimCOTotals t on d.customer_no=t.customer_no and d.change_order_no=t.changeordernumber" & vbCrLf
    s = s & "   where c.BillingParent = @BillingCustomer_No" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   -- UPDATE CLAIM TOTAL --------------------" & vbCrLf
    s = s & "   exec Claims_RecalcClaimTotal @ClaimID" & vbCrLf
    sql c, s
    
