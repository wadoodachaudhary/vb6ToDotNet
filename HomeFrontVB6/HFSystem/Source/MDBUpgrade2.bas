    s = s & "   left outer join tblVendors v on(v.vendor_ID=dbo.Purch_GetCommunityVendor(sd.Community,isnull(nullif(d.POIndex,''),isnull(i.POIndex,''))))" & vbCrLf
    s = s & "   left outer join taxGroups t on (t.TaxGroup=dbo.Purch_GetDefaultTaxGroup('' , c.area ,'' , sd.Model , sd.Assembly ,i.phase ,i.item , v.Vendor_ID , i.JCCategory ))  " & vbCrLf
    s = s & "   where sd.Worksheet = @SalesSheet" & vbCrLf
    s = s & "   group by sd.Community,sd.CommunityPhase,sd.Assembly,sd.Model,sd.series,sd.OptionID,sd.Description,sd.AssemblyType" & vbCrLf
    s = s & "   " & vbCrLf
    s = s & "   open ListofAssemblies " & vbCrLf
