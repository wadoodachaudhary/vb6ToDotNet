    s = s & "   fetch next from ListofAssemblies into @CommunityID,@CommunityPhaseID,@AssemblyID,@ModelID,@SeriesID,@Option_ID,@Description,@AssemblyType,@IncentiveCost,@LandCost,@TotalCost" & vbCrLf
    s = s & "   while @@fetch_status <>-1 begin   " & vbCrLf
