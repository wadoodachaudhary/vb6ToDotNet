    s = ""
    s = s & "ALTER function dbo.GetNextService(@DivisionID as int, @Equipment as varchar(11), @ServiceDesc as varchar(2500)) returns varchar(75) as" & vbCrLf
    s = s & "begin" & vbCrLf
    s = s & "  return(" & vbCrLf
    s = s & "    select case pi.uom " & vbCrLf
    s = s & "           when 'km' then cast(max(h.mileage) + pi.frequency as varchar) + ' km'" & vbCrLf
    s = s & "           when 'M' then cast(max(h.mileage) + pi.frequency as varchar) + ' M'" & vbCrLf
    s = s & "           when 'hr' then cast(max(h.hours) + pi.frequency as varchar) + ' hrs'" & vbCrLf
    s = s & "           when 'days' then cast(max(h.servicedate) + pi.frequency as varchar)" & vbCrLf
    s = s & "           else '?' end NextService" & vbCrLf
    s = s & "    from Equipment e" & vbCrLf
    s = s & "    join ServicePlanSchedules pi on e.DivisionID=pi.DivisionID and e.ServicePlanID=pi.PlanID" & vbCrLf
    s = s & "    join ServicePlanTasks pt on pi.DivisionID=pt.DivisionID and pi.ScheduleID=pt.ScheduleID" & vbCrLf
    s = s & "    join EquipmentServiceHistory h on e.DivisionID=h.DivisionID and e.Equipment=h.Equipment and h.Description=pt.Name" & vbCrLf
    s = s & "    where e.DivisionID=@DivisionID and e.equipment=@Equipment" & vbCrLf
    s = s & "      and pt.name=@ServiceDesc" & vbCrLf
    s = s & "    group by pi.frequency,pi.uom" & vbCrLf
    s = s & "  )" & vbCrLf
    s = s & "end" & vbCrLf
    sql c, s
    
