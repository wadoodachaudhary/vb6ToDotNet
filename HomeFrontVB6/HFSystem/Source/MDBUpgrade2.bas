    s = s & "   while @@fetch_status <> -1" & vbCrLf
    s = s & "   begin" & vbCrLf
    s = s & "   IF @CalcSalesPrice = 'True' BEGIN" & vbCrLf
    s = s & "      update tblsalessheetdetails set cost = @Total+LandCost+IncentiveCost,ConstructionCost = @Total,Pretax=dbo.RndTo(round((@Total+isnull(LandCost,0)+isnull(IncentiveCost,0))*(1+(Markup/100)),2),1,case RoundTo when 0 then 1 else roundto end) where worksheet = @SalesSheet and Community =@CommunityID and CommunityPhase = @CommunityPhaseID and Assembly=@AssemblyID and Model = @ModelID and OptionID=@Option_ID and Series = @SeriesID   " & vbCrLf
