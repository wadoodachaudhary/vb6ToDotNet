    s = s & "            insert into customerpostingtotal (customer_no,Type,ItemID,ItemDesc,Total,PriorPosting,ThisPosting,CostCode,GLPrefix,GLDebitAcct,GLCreditAcct,Posted,UserID,DateTimeStamp,sortorder) values(@CustID,2,'14','Tarion NHW Fees',0,0,0,'',@BalPrefix,@OffsetGL,'',0,'',getdate(),9)" & vbCrLf
    s = s & "            insert into customerpostingtotal (customer_no,Type,ItemID,ItemDesc,Total,PriorPosting,ThisPosting,CostCode,GLPrefix,GLDebitAcct,GLCreditAcct,Posted,UserID,DateTimeStamp,sortorder) values(@CustID,3,'15','Contract Exempt Revenue',0,0,0,'',@IncPrefix,'',@CoGL,0,'',getdate(),15)" & vbCrLf
    s = s & "            insert into customerpostingtotal (customer_no,Type,ItemID,ItemDesc,Total,PriorPosting,ThisPosting,CostCode,GLPrefix,GLDebitAcct,GLCreditAcct,Posted,UserID,DateTimeStamp,sortorder) values(@CustID,3,'16','Contract Exempt Incentives',0,0,0,'',@IncPrefix,'',@COGL,0,'',getdate(),16)" & vbCrLf
    s = s & "            insert into customerpostingtotal (customer_no,Type,ItemID,ItemDesc,Total,PriorPosting,ThisPosting,CostCode,GLPrefix,GLDebitAcct,GLCreditAcct,Posted,UserID,DateTimeStamp,sortorder) values(@CustID,3,'17','GST on Contract Exempt',0,0,0,'',@BalPrefix,'',@GSTGL,0,'',getdate(),18)" & vbCrLf
