    s = ""
    s = s & "CREATE Function [dbo].[Sched_CalcStartDate](@CalendarID Int, @EndDate DateTime,@NumofWorkDays Int) RETURNS DateTime AS BEGIN" & vbCrLf
    s = s & "   declare @counter int" & vbCrLf
    s = s & "   declare @isWorkDay int" & vbCrLf
    s = s & "   declare @NumberofDaysDiff int" & vbCrLf
    s = s & "   declare @StartDate datetime" & vbCrLf
    s = s & "   set @counter = 0" & vbCrLf
    s = s & "   SET @NumofWorkDays = @NumofWorkDays" & vbCrLf
    s = s & "   set @NumberofDaysDiff = (@NumofWorkDays - (select dbo.Sched_WorkingDays(@CalendarID,@EndDate-@NumofWorkDays,@EndDate)))" & vbCrLf
    s = s & "   --print 'Number of days diff ' + @NumberofDaysDiff" & vbCrLf
    s = s & "   set @StartDate = @EndDate-@NumofWorkDays" & vbCrLf
    s = s & "   while @counter < @NumberofDaysDiff" & vbCrLf
    s = s & "   begin" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "     set @isWorkDay = (select dbo.Sched_WorkingDays(@CalendarID,@StartDate,@StartDate))" & vbCrLf
    s = s & "     if @isWorkDay = 1 begin" & vbCrLf
    s = s & "         set @counter = @counter + 1" & vbCrLf
    s = s & "     end" & vbCrLf
    s = s & "     set @StartDate = @StartDate -1" & vbCrLf
    s = s & "   end" & vbCrLf
    s = s & "   return @StartDate --+2" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s

    s = ""
    s = s & "CREATE Function [dbo].[Num_WorkingDays](@StartDate DateTime,@EndDate DateTime) RETURNS INT AS BEGIN DECLARE @Counter INT DECLARE @CalendarDay INT DECLARE @AdditionalDays INT DECLARE @Holiday INT DECLARE @CurDate Datetime" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   SET @CurDate = @StartDate" & vbCrLf
