    s = s & "insert into template(description,inactive,workingdays,calendardays)" & vbCrLf
    s = s & "values(@TemplateName,0,0,0)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--GET NEW TEMPLATE ID" & vbCrLf
    s = s & "select @NewTemplateID = SCOPE_IDENTITY()" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--INSERT TASKS" & vbCrLf
    s = s & "insert templatetasks(ttid,TemplateID, TaskID, Description, ParentID, IndexInParent, DrawID, Duration, LagTime, JCCostCode, QCListID, SortOrder, Level, IsMilestone, IsSeasonal)" & vbCrLf
    s = s & "select s.scheduleTaskID,@NewTemplateID ,l.taskid,s.description,s.parentid,s.indexinparent,s.drawid,s.duration,s.lagtime,s.jccostcode,s.qcchecklistid,s.sortorder,s.level,s.ismilestone,s.isseasonal" & vbCrLf
    s = s & "from scheduletasks s" & vbCrLf
    s = s & "join librarytasks l on s.librarytaskid=l.taskid" & vbCrLf
    s = s & "where s.scheduleid=@ScheduleID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--UPDATE THE PARENT ID TO TRANSLATE THE SCHEDULE TASK ID TO THE NEW TEMPLATE TASK ID" & vbCrLf
    s = s & "update t" & vbCrLf
    s = s & "set parentid = isnull(p.taskid,0)" & vbCrLf
    s = s & "from templatetasks t" & vbCrLf
    s = s & "left outer join templatetasks p on t.templateid=p.templateid and t.parentid=p.ttid" & vbCrLf
    s = s & "where t.templateid=@NewTemplateID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--INSERT CONSTRAINTS REMEMBERING TO TRANSLATE THE SCHEDULE TASK ID TO THE NEW TEMPLATE TASK ID" & vbCrLf
    s = s & "insert into templateconstraints(TemplateID, FromTaskID, ToTaskID, ConstraintType)" & vbCrLf
    s = s & "select @NewTemplateID ,ft.taskid,tt.taskid,c.constrainttype" & vbCrLf
    s = s & "from scheduleconstraints c" & vbCrLf
    s = s & "join templatetasks ft on ft.templateid=@NewTemplateID  and c.fromscheduletaskid=ft.ttID" & vbCrLf
    s = s & "join templatetasks tt on ft.templateid=@NewTemplateID  and c.toscheduletaskid=ft.ttID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--REMOVE THE OLD SCHEDULE TASK ID FROM THE TEMPLATE TASKS" & vbCrLf
    s = s & "update templatetasks set ttID=null where templateid=@NewTemplateID" & vbCrLf
