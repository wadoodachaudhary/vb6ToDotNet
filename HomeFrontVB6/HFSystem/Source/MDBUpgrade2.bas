    s = ""
    s = s & "create PROCEDURE [dbo].[AutoNotifications_GetReportsToSend]" & vbCrLf
    s = s & "AS" & vbCrLf
    s = s & "       BEGIN" & vbCrLf
    s = s & "            " & vbCrLf
    s = s & "            DECLARE" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   @CurDate    DATETIME," & vbCrLf
    s = s & "               @CurDatePlus15  DATETIME," & vbCrLf
    s = s & "               @CurDay INT," & vbCrLf
    s = s & "               @CurMonth   INT," & vbCrLf
    s = s & "               @CurYear    INT," & vbCrLf
    s = s & "               @CurHour    INT," & vbCrLf
    s = s & "               @CurMinute  INT," & vbCrLf
    s = s & "               @Seq        INT," & vbCrLf
    s = s & "               @FrequencyType  VARCHAR(50)," & vbCrLf
    s = s & "               @FrequencyValue INT," & vbCrLf
    s = s & "               @TimeofDay  DATETIME," & vbCrLf
    s = s & "               @NextRun    DATETIME," & vbCrLf
    s = s & "               @NewNextRun DATETIME," & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   /* NEW - Time variables */" & vbCrLf
    s = s & "   @CurrTime   TIME," & vbCrLf
    s = s & "   @CurrTimePlus15  TIME" & vbCrLf
    s = s & "            " & vbCrLf
    s = s & "   /* NEW - Actual date no time only date */               " & vbCrLf
    s = s & "            SET @CurDate =  DATEADD(dd, DATEDIFF(dd, 0, GETDATE()), 0)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "            SET @CurDatePlus15 =  DATEADD(minute, 15, @CurDate)" & vbCrLf
    s = s & "            SET @CurDay        =  DATEPART(day, GETDATE())" & vbCrLf
    s = s & "            SET @CurMonth      =  DATEPART(mm, GETDATE())" & vbCrLf
    s = s & "            SET @CurYear       =  DATEPART(yy, GETDATE())" & vbCrLf
    s = s & "            SET @CurHour       =  DATEPART(hh, GETDATE())" & vbCrLf
    s = s & "            SET @CurMinute     =  DATEPART(mi, GETDATE())" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   /* NEW - Actual date, but set only time of date */" & vbCrLf
    s = s & "            SET @CurrTime  =  CAST(CONVERT(char(8),DATEADD(mi, DATEDIFF(mi, 0, GETDATE()), 0),108) AS TIME)" & vbCrLf
    s = s & "           " & vbCrLf
    s = s & "   /* NEW - Actual date, but set only time of date and add 15 minutes */ " & vbCrLf
    s = s & "   SET @CurrTimePlus15 =  CAST(CONVERT(char(8),DATEADD(minute, 15, DATEADD(mi, DATEDIFF(mi, 0, GETDATE()), 0)),108) AS TIME)        " & vbCrLf
    s = s & "           " & vbCrLf
    s = s & "             DECLARE ListofQueries CURSOR FOR SELECT seq FROM AutoReports " & vbCrLf
    s = s & "                                          WHERE ISNULL(RecipientQuery,'')<>''  " & vbCrLf
    s = s & "           AND  @CurDay    >=  DATEPART(day, NextRun)" & vbCrLf
    s = s & "                                          AND  @CurMonth  >=  DATEPART(mm, NextRun)" & vbCrLf
    s = s & "                                          AND  @CurYear   >=  DATEPART(yy, NextRun)" & vbCrLf
    s = s & "                                          AND  @CurHour   >=  DATEPART(hh, TimeofDay)" & vbCrLf
    s = s & "                                          AND  @CurMinute >=  DATEPART(mi, TimeofDay)" & vbCrLf
    s = s & "            OPEN ListofQueries " & vbCrLf
    s = s & "            FETCH NEXT FROM ListofQueries INTO @seq" & vbCrLf
    s = s & "            WHILE @@FETCH_STATUS <> -1" & vbCrLf
    s = s & "            BEGIN" & vbCrLf
    s = s & "                   EXEC AutoReportSelectQuery @seq" & vbCrLf
    s = s & "                   FETCH NEXT FROM ListofQueries INTO @seq" & vbCrLf
    s = s & "            END" & vbCrLf
    s = s & "            CLOSE ListofQueries " & vbCrLf
    s = s & "            DEALLOCATE ListofQueries " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "            INSERT INTO AutoNotifications(TriggerName,StaticCCs,RecipientAddress,FromAddress,Subject,Message,MessageType, Attachment,Report,CreateDate,Param1,Param2,Param3,  Param4,Param5,Param6, Param7,Param8,Param9,Param10)" & vbCrLf
    s = s & "            SELECT ISNULL(Description,''),StaticCCs,RecipientAddress,FromAddress,Subject,Message,'html',Attachment,Report, GETDATE(), Param1,Param2,Param3,  Param4,Param5,Param6, Param7,Param8,Param9,Param10" & vbCrLf
    s = s & "            FROM AutoReports" & vbCrLf
    s = s & "            WHERE  DATEADD(dd, DATEDIFF(dd, 0, NextRun), 0) <= @CurDate " & vbCrLf
    s = s & "            AND case when DATEADD(dd, DATEDIFF(dd, 0, NextRun), 0) < @CurDate then @CurrTime else CAST(CONVERT(char(8),DATEADD(mi, DATEDIFF(mi, 0, TimeOfDay), 0),108) AS TIME)  end  <= @CurrTime " & vbCrLf
    s = s & "            AND case when DATEADD(dd, DATEDIFF(dd, 0, NextRun), 0) < @CurDate then @CurrTimePlus15 else CAST(CONVERT(char(8),DATEADD(mi, DATEDIFF(mi, 0, TimeOfDay), 0),108) AS TIME) end <=@CurrTimePlus15                " & vbCrLf
    s = s & "            AND isnull(RecipientAddress,'') <>''" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "                                    " & vbCrLf
    s = s & "            UPDATE AutoReports" & vbCrLf
    s = s & "            SET NextRun = dbo.AutoReports_GetNextRun(FrequencyType,FrequencyValue,NextRun, TimeofDay),PreviousRunDate=LastRunDate ,LastRunDate = getdate()" & vbCrLf
    s = s & "            FROM AutoReports" & vbCrLf
    s = s & "            WHERE  DATEADD(dd, DATEDIFF(dd, 0, NextRun), 0) <= @CurDate " & vbCrLf
    s = s & "            AND case when DATEADD(dd, DATEDIFF(dd, 0, NextRun), 0) < @CurDate then @CurrTime else CAST(CONVERT(char(8),DATEADD(mi, DATEDIFF(mi, 0, TimeOfDay), 0),108) AS TIME)  end  <= @CurrTime " & vbCrLf
    s = s & "            AND case when DATEADD(dd, DATEDIFF(dd, 0, NextRun), 0) < @CurDate then @CurrTimePlus15 else CAST(CONVERT(char(8),DATEADD(mi, DATEDIFF(mi, 0, TimeOfDay), 0),108) AS TIME) end <=@CurrTimePlus15                " & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s

