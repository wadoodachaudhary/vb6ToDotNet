    s = ""
    s = s & "ALTER TRIGGER [dbo].[POMaster_CreateInvoice] ON [dbo].[POMaster] AFTER UPDATE AS" & vbCrLf
    s = s & "DECLARE @InvoiceID AS INT" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "IF UPDATE(ApprovedDate) BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- move to approved, any held invoices that reference ONLY this po" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "    SET status='Approved',Approver='AutoApproved'" & vbCrLf
    s = s & "    FROM invoices i" & vbCrLf
    s = s & "    JOIN AppOptions ao1 ON(ao1.OptionName='AutoReleaseHeldPOInvoices' and ao1.OptionValue='True' AND ao1.DivisionID = i.DivisionID)     " & vbCrLf
    s = s & "    JOIN AppOptions ao2 ON(ao2.OptionName='SchedulingUsage' and ao2.OptionValue='3' AND ao2.DivisionID = i.DivisionID)     " & vbCrLf
    s = s & "    WHERE i.status='Hold'" & vbCrLf
    s = s & "    AND invoiceid in(" & vbCrLf
    s = s & "        SELECT dd.invoiceid" & vbCrLf
    s = s & "        FROM invoiceitems dd" & vbCrLf
    s = s & "        WHERE invoiceid in(" & vbCrLf
    s = s & "            SELECT distinct d.invoiceid " & vbCrLf
    s = s & "            FROM InvoiceItems d" & vbCrLf
    s = s & "            JOIN INSERTED p on d.DivisionID=p.DivisionID and d.Vendor=p.Vendor and d.commitment=p.PONumber" & vbCrLf
    s = s & "        )" & vbCrLf
    s = s & "        GROUP BY dd.invoiceid" & vbCrLf
    s = s & "        HAVING COUNT(DISTINCT dd.commitment)=1" & vbCrLf
    s = s & "    )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- move to pending, any held invoices that reference more something other than just this po" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "    SET status='Pending'" & vbCrLf
    s = s & "    FROM invoices i" & vbCrLf
    s = s & "    JOIN AppOptions ao1 ON(ao1.OptionName='AutoReleaseHeldPOInvoices' and ao1.OptionValue='True' AND ao1.DivisionID = i.DivisionID)     " & vbCrLf
    s = s & "    JOIN AppOptions ao2 ON(ao2.OptionName='SchedulingUsage' and ao2.OptionValue='3' AND ao2.DivisionID = i.DivisionID)     " & vbCrLf
    s = s & "    WHERE i.status='Hold' and i.Approver<>''" & vbCrLf
    s = s & "    AND invoiceid in(" & vbCrLf
    s = s & "        SELECT dd.invoiceid" & vbCrLf
    s = s & "        FROM invoiceitems dd" & vbCrLf
    s = s & "        WHERE invoiceid in(" & vbCrLf
    s = s & "            SELECT distinct d.invoiceid " & vbCrLf
    s = s & "            FROM InvoiceItems d" & vbCrLf
    s = s & "            JOIN INSERTED p on d.DivisionID=p.DivisionID and d.Vendor=p.Vendor and d.commitment=p.PONumber" & vbCrLf
    s = s & "        )" & vbCrLf
    s = s & "        GROUP BY dd.invoiceid" & vbCrLf
    s = s & "        HAVING COUNT(DISTINCT dd.commitment)>1" & vbCrLf
    s = s & "    )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    -- create invoice" & vbCrLf
    s = s & "    INSERT INTO Invoices(DivisionID,Vendor,Invoice,InvoiceDate,AccountingDate,Description,Status,VendorName,PreTax,Tax,Source,UStmp,TStmp)" & vbCrLf
    s = s & "    SELECT d.DivisionID" & vbCrLf
    s = s & "          ,d.Vendor" & vbCrLf
    s = s & "          ,d.po PONumber" & vbCrLf
    s = s & "          ,d.poApprovedDate InvoiceDate" & vbCrLf
    s = s & "          ,d.poApprovedDate AccountingDate" & vbCrLf
    s = s & "          ,LEFT(d.podesc,100) Description" & vbCrLf
    s = s & "          ,'SiteApproved' Status" & vbCrLf
    s = s & "          ,d.VendorDesc VendorName" & vbCrLf
    s = s & "          ,SUM(ISNULL(d.lineremainingPretax,0)) Pretax" & vbCrLf
    s = s & "          ,SUM(ISNULL(d.lineremainingtax,0)) Tax" & vbCrLf
    s = s & "          ,'autoinserting..' Source" & vbCrLf
    s = s & "          ,d.POApprovedBy UStmp" & vbCrLf
    s = s & "          ,getdate() TStmp" & vbCrLf
    s = s & "      FROM inserted i" & vbCrLf
    s = s & "      join jcpodetails d on i.DivisionID = d.DivisionID and i.ponumber=d.po " & vbCrLf
    s = s & "      JOIN AppOptions ao ON(ao.OptionName='AutoPayApprovedPOs' and ao.OptionValue='True' AND ao.DivisionID = d.DivisionID)     " & vbCrLf
    s = s & "     WHERE d.poApprovedDate IS NOT NULL" & vbCrLf
    s = s & "     GROUP BY d.DivisionID,d.Vendor,d.PO,d.poApprovedDate,d.podesc,d.Vendordesc,d.poApprovedBy" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    INSERT INTO InvoiceItems(DivisionID,InvoiceID,Vendor,Invoice,Commitment,CommitmentItem,CommitmentDesc,CommitmentVendor,Job,Extra,Phase,PhaseDesc,Category,CategoryDesc,InvoicedQuantity,TaxGroup,TaxGroupDesc,TaxRate,PreTax,Tax,Description,Retainage,RetainageRate)" & vbCrLf
    s = s & "    SELECT d.DivisionID" & vbCrLf
    s = s & "          ,e.InvoiceID" & vbCrLf
    s = s & "          ,e.Vendor " & vbCrLf
    s = s & "          ,e.Invoice" & vbCrLf
    s = s & "          ,d.PO Commitment" & vbCrLf
    s = s & "          ,d.Line " & vbCrLf
    s = s & "          ,LEFT(d.poDesc,200) " & vbCrLf
    s = s & "          ,d.Vendor " & vbCrLf
    s = s & "          ,d.lineJob" & vbCrLf
    s = s & "          ,d.lineExtra" & vbCrLf
    s = s & "          ,d.lineCostCode" & vbCrLf
    s = s & "          ,d.linecostcodeDesc" & vbCrLf
    s = s & "          ,d.lineCategory" & vbCrLf
    s = s & "          ,d.linecategoryDesc" & vbCrLf
    s = s & "          ,0" & vbCrLf
    s = s & "          ,d.lineTaxGroup" & vbCrLf
    s = s & "          ,d.lineTaxGroupdesc" & vbCrLf
    s = s & "          ,d.lineTaxrate" & vbCrLf
    s = s & "          ,d.lineremainingpretax" & vbCrLf
    s = s & "          ,d.lineremainingtax" & vbCrLf
    s = s & "          ,left(d.LineDesc,100) " & vbCrLf
    s = s & "          ,Round(d.lineremainingpretax*d.Retainagerate/100,2)" & vbCrLf
    s = s & "          ,d.Retainagerate" & vbCrLf
    s = s & "      FROM inserted i" & vbCrLf
    s = s & "      join jcpodetails d on i.DivisionID = d.DivisionID and i.ponumber=d.po " & vbCrLf
    s = s & "      JOIN Invoices e ON(e.DivisionID = i.DivisionID and i.PONumber=e.Invoice and i.Vendor=e. Vendor and e.Source='autoinserting..')" & vbCrLf
    s = s & "     where d.poApprovedDate IS NOT NULL" & vbCrLf
    s = s & "       and e.Invoice IS NOT NULL" & vbCrLf
    s = s & "       and d.lineremainingpretax<>0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "       SET Source='AutoApproved'" & vbCrLf
    s = s & "      FROM Inserted m" & vbCrLf
    s = s & "      JOIN Invoices e ON(m.DivisionID = e.DivisionID and m.PONumber=e.Invoice and m.Vendor=e.Vendor and e.Source='autoinserting..')" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
    
    s = ""
    s = s & "create view InvoiceValidationErrors as" & vbCrLf
    s = s & "select " & vbCrLf
    s = s & "   i.invoiceid" & vbCrLf
    s = s & "  ,d.itemid" & vbCrLf
    s = s & "" & vbCrLf
    s = s & ",cast(case when ((select count(*) from invoiceitems where invoiceid=i.invoiceid)<1) then 1 else 0 end as bit) NoLines" & vbCrLf
    s = s & ",cast(case when ((select sum(pretax) from invoiceitems where invoiceid=i.invoiceid)<1) then 1 else 0 end as bit) PretaxDoesntBalance" & vbCrLf
    s = s & ",cast(case when ((select sum(tax) from invoiceitems where invoiceid=i.invoiceid)<1) then 1 else 0 end as bit) TaxDoesntBalance" & vbCrLf
    s = s & ",cast(case when (isnull(d.job,'')<>'' or isnull(d.debitaccount,'')<>'') then 0 else 1 end as bit) JobOrAcctNeeded" & vbCrLf
    s = s & ",cast(case when (isnull(d.job,'')<>'' and (isnull(d.phase,'')='' or isnull(d.category,'')='')) then 1 else 0 end as bit) CCAndCatNeeded" & vbCrLf
    s = s & ",cast(case when (isnull(d.commitment,'')<>'' and pi.ponumber is null) then 1 else 0 end as bit) BadPO" & vbCrLf
    s = s & ",cast(case when (isnull(d.job,'')<>'' and j.job_no is null) then 1 else 0 end as bit) BadJob" & vbCrLf
    s = s & ",cast(case when (isnull(d.phase,'')<>'' and cc.costcode is null) then 1 else 0 end as bit) BadCostCode" & vbCrLf
    s = s & ",cast(case when (isnull(d.category,'')<>'' and c.category is null) then 1 else 0 end as bit) BadCategory" & vbCrLf
    s = s & ",cast(case when ((isnull(d.tax,0)<>0 or isnull(d.taxgroup,'')<>'') and g.taxgroup is null) then 1 else 0 end as bit) BadTaxgroup" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "from invoices i" & vbCrLf
    s = s & "left outer join invoiceitems d on i.invoiceid=d.invoiceid" & vbCrLf
    s = s & "left outer join tbljobs j on d.divisionid=j.divisionid and d.job=j.job_no" & vbCrLf
    s = s & "left outer join standardcostcodes cc on d.divisionid=cc.divisionid and d.phase=cc.costcode" & vbCrLf
    s = s & "left outer join standardcategories c on d.divisionid=c.divisionid and d.category=c.category" & vbCrLf
    s = s & "left outer join TaxGroups g on d.divisionid=g.divisionid and d.taxgroup=g.taxgroup" & vbCrLf
    s = s & "left outer join poitems pi on d.divisionid=pi.divisionid and d.commitment=pi.ponumber and d.commitmentitem=pi.linenumber" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "where" & vbCrLf
    s = s & "    case when ((select count(*) from invoiceitems where invoiceid=i.invoiceid)<1) then 1 else 0 end =1" & vbCrLf
    s = s & " or case when ((select sum(pretax) from invoiceitems where invoiceid=i.invoiceid)<1) then 1 else 0 end =1" & vbCrLf
    s = s & " or case when ((select sum(tax) from invoiceitems where invoiceid=i.invoiceid)<1) then 1 else 0 end =1" & vbCrLf
    s = s & " or case when (isnull(d.job,'')<>'' or isnull(d.debitaccount,'')<>'') then 0 else 1 end =1" & vbCrLf
    s = s & " or case when (isnull(d.job,'')<>'' and (isnull(d.phase,'')='' or isnull(d.category,'')='')) then 1 else 0 end =1" & vbCrLf
    s = s & " or case when (isnull(d.commitment,'')<>'' and pi.ponumber is null) then 1 else 0 end =1" & vbCrLf
    s = s & " or case when (isnull(d.job,'')<>'' and j.job_no is null) then 1 else 0 end =1" & vbCrLf
    s = s & " or case when (isnull(d.phase,'')<>'' and cc.costcode is null) then 1 else 0 end =1" & vbCrLf
    s = s & " or case when (isnull(d.category,'')<>'' and c.category is null) then 1 else 0 end =1" & vbCrLf
    s = s & " or case when ((isnull(d.tax,0)<>0 or isnull(d.taxgroup,'')<>'') and g.taxgroup is null) then 1 else 0 end =1" & vbCrLf
    sql c, s, True

