    s = s & "                        SET @NHWFees =@NHWFees +round((@RevenueAdjustment*(@NHWFees /@TotalRevenue)),2)" & vbCrLf
    s = s & "            end" & vbCrLf
    s = s & "            IF @rowinc = 2 and @AddendumAmt <> 0 begin" & vbCrLf
