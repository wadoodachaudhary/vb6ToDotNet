    s = s & "    WHERE i.paypoint1approveddate is not null AND p.PayPoint1Percent<>0" & vbCrLf
    s = s & "    and e.invoiceid is null" & vbCrLf
    s = s & "    GROUP BY d.DivisionID,d.Vendor,d.PO,d.poApprovedDate,d.podesc,d.Vendordesc,d.poApprovedBy,p.paypoint5percent,p.paypoint4percent,p.paypoint3percent,p.paypoint2percent" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    INSERT INTO InvoicePaymentPoints(InvoiceID,PONumber,PayPoint1)" & vbCrLf
    s = s & "    SELECT e.InvoiceID,i.ponumber,1" & vbCrLf
    s = s & "    FROM inserted    i" & vbCrLf
    s = s & "    join Invoices e ON e.DivisionID = i.DivisionID and i.PONumber=e.Invoice and i.Vendor=e. Vendor and e.Source='autoinserting..'" & vbCrLf
    s = s & "    WHERE i.paypoint1approveddate is not null" & vbCrLf
    s = s & "    -----------------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "    INSERT INTO InvoiceItems(DivisionID,InvoiceID,Vendor,Invoice,Commitment,CommitmentItem,CommitmentDesc,CommitmentVendor,Job,Extra,Phase,PhaseDesc,Category,CategoryDesc,InvoicedQuantity,TaxGroup,TaxGroupDesc,TaxRate,Description,RetainageRate,PreTax,Tax,Retainage)" & vbCrLf
    s = s & "    SELECT d.DivisionID,e.InvoiceID,e.Vendor,e.Invoice,d.PO,d.Line,LEFT(d.poDesc,200),d.Vendor,d.lineJob,d.lineExtra,d.lineCostCode,d.linecostcodeDesc,d.lineCategory,d.linecategoryDesc,0,d.lineTaxGroup,d.lineTaxGroupdesc,d.lineTaxrate,left(d.LineDesc,100),d.Retainagerate" & vbCrLf
    s = s & "          -- if 1 is last then use remaining else use percent" & vbCrLf
    s = s & "          ,case when p.paypoint5percent=0 and p.paypoint4percent=0 and p.paypoint3percent=0 and p.paypoint2percent=0 " & vbCrLf
    s = s & "                then d.lineRemainingPretax " & vbCrLf
    s = s & "                else round(d.linepretax*p.paypoint1percent/100,2)" & vbCrLf
    s = s & "                end Pretax" & vbCrLf
    s = s & "          ,case when p.paypoint5percent=0 and p.paypoint4percent=0 and p.paypoint3percent=0 and p.paypoint2percent=0 " & vbCrLf
    s = s & "                then d.lineRemainingTax " & vbCrLf
    s = s & "                else round(d.lineremainingtax*p.paypoint1percent/100,2)" & vbCrLf
    s = s & "                end Pretax" & vbCrLf
    s = s & "          ,Round(case when p.paypoint5percent=0 and p.paypoint4percent=0 and p.paypoint3percent=0 and p.paypoint2percent=0 " & vbCrLf
    s = s & "                      then d.lineRemainingPretax " & vbCrLf
    s = s & "                      else round(d.linepretax*p.paypoint1percent/100,2)" & vbCrLf
    s = s & "                      end" & vbCrLf
    s = s & "                   *d.Retainagerate/100,2) Retainage          " & vbCrLf
