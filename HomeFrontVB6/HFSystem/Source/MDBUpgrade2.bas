    s = s & "      ,ActualFinish= (select max(ActualFinish) from ScheduleTasks where ScheduleTasks.scheduleid=Schedule.scheduleid)" & vbCrLf
    s = s & "      ,ScheduledStart= (select min(ScheduledStart) from ScheduleTasks where ScheduleTasks.scheduleid=Schedule.scheduleid)" & vbCrLf
    s = s & "      ,ScheduledFinish= (select max(ScheduledFinish) from ScheduleTasks where ScheduleTasks.scheduleid=Schedule.scheduleid)" & vbCrLf
