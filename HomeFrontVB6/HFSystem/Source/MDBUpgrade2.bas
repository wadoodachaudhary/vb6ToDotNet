    s = s & "         ,other2chargerate,eqsurchargepercent,ref1,ref2,ref3,eqmisccode1,eqmisccode2,eqmisccode3,stpayrate,otpayrate,dtpayrate,travelpayrate,misc1payrate,misc2payrate,misc3payrate,burdenpcnt,eqrevenuetype,originalpedate,labcategory,eqcategory,divisionid,sequence)" & vbCrLf
    s = s & "   select workticket,periodenddate,itemdate,description,job,extra,costcode,employee,labourclass,shift,totalhours,stqty,stpayid,strate,otqty,otpayid,otrate,dtqty,dtpayid,dtrate,travelqty,travelpayid,travelrate,misc1qty,misc1payid,misc1rate,misc2qty,misc2payid,misc2rate,misc3qty,misc3payid,misc3rate,equipment,eqhourlyqty,eqhourlycostrate,eqhourlychargerate,eqdailyqty,eqdailycostrate,eqdailychargerate,eqweeklyqty,eqweeklycostrate,eqweeklychargerate,eqmonthlyqty,eqmonthlycostrate,eqmonthlychargerate,eqreimburseqty,eqreimbursepayid,ustmp,tstmp,timebatchid,equipmentbatchid,equipmentcostcode,labourdiscpercent,equipmentdiscpercent,nonbillable,stbillqty,otbillqty,dtbillqty,travelbillqty,misc1billqty,misc2billqty,misc3billqty,eqhourlybillqty,eqdailybillqty,eqweeklybillqty,eqmonthlybillqty,debitaccount,creditaccount,taxgroup,unionclass,sortorder,submitted,guid,nootcalc,other1qty,other1chargerate,other2qty" & vbCrLf
    s = s & "         ,other2chargerate,eqsurchargepercent,ref1,ref2,ref3,eqmisccode1,eqmisccode2,eqmisccode3,stpayrate,otpayrate,dtpayrate,travelpayrate,misc1payrate,misc2payrate,misc3payrate,burdenpcnt,eqrevenuetype,originalpedate,labcategory,eqcategory,divisionid,sequence" & vbCrLf
    s = s & "   from #tmp_labouritems" & vbCrLf
    s = s & "   set identity_insert labouritems off" & vbCrLf
