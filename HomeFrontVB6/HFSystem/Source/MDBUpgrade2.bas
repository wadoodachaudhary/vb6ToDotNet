    s = ""
    s = s & "CREATE PROCEDURE dbo.Payables_CreateHBInvoice(@InvoiceID as int) as" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "-- this proc moves retainage amounts from non-timberline invoices to their own holdback" & vbCrLf
    s = s & "-- invoice which can be individually pushed to accounting systems." & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "declare @RetainageID as int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "-- create a HB invoice if accounting sys is not timberline and invoice has amt retained" & vbCrLf
    s = s & "-------------------------------------------------------------------------------------" & vbCrLf
    s = s & "insert into invoices(Vendor,VendorType,VendorName,Invoice,Job,JobDesc" & vbCrLf
    s = s & ",Status,Discount,DiscountDate,ReceivedDate,InvoiceDate" & vbCrLf
    s = s & ",PaymentDate,AccountingDate,Description,UStmp,TStmp,Source" & vbCrLf
    s = s & ",InvoiceCode1,InvoiceCode2,VendorAddr1,VendorAddr2,VendorCity" & vbCrLf
    s = s & ",VendorProv,VendorPostal,RetainageInvoice,DivisionID,DeptID)" & vbCrLf
    s = s & "select distinct" & vbCrLf
    s = s & " i.Vendor,i.VendorType,i.VendorName,i.Invoice + 'HB' Invoice,i.Job,i.JobDesc" & vbCrLf
