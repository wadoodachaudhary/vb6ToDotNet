    s = s & "     when PayTermNetDays=2 and PayTermNetType='DayOfMonthAfterEOM'   then 'Net ' + cast(PayTermNetDays as varchar) + 'nd after EOM'" & vbCrLf
    s = s & "     when PayTermNetDays=3 and PayTermNetType='OnADayOfTheMonth'     then 'Net ' + cast(PayTermNetDays as varchar) + 'rd'" & vbCrLf
    s = s & "     when PayTermNetDays=3 and PayTermNetType='DayOfMonthAfterEOM'   then 'Net ' + cast(PayTermNetDays as varchar) + 'rd after EOM'" & vbCrLf
    s = s & "     when PayTermNetType='OnADayOfTheMonth'     then 'Net ' + cast(PayTermNetDays as varchar) + 'th'" & vbCrLf
    s = s & "     when PayTermNetType='DayOfMonthAfterEOM'   then 'Net ' + cast(PayTermNetDays as varchar) + 'th after EOM'" & vbCrLf
    s = s & "     when PayTermNetType='NumberOfDaysAfterEOM' then 'Net ' + cast(PayTermNetDays as varchar) + ' after EOM'" & vbCrLf
    s = s & "     when PayTermNetType='InAGivenNumberOfDays' then 'Net ' + cast(PayTermNetDays as varchar)" & vbCrLf
    s = s & "     when PayTermNetType='CashOnDelivery' then 'C.O.D.'" & vbCrLf
