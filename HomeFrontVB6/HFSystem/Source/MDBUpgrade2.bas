    sql c, "DROP PROC Schedule_CreateNewSchedule", True
    s = ""
    s = s & "CREATE PROC [dbo].[Schedule_CreateNewSchedule]" & vbCrLf
    s = s & "   @Job_No varchar(12)," & vbCrLf
    s = s & "   @Description varchar(200)," & vbCrLf
    s = s & "   @TemplateID int," & vbCrLf
    s = s & "   @OnHold bit," & vbCrLf
    s = s & "   @Closed bit," & vbCrLf
    s = s & "   @InActive bit," & vbCrLf
    s = s & "   @ProjectStartDate datetime," & vbCrLf
    s = s & "   @CalendarID int," & vbCrLf
    s = s & "   @PM varchar(10)," & vbCrLf
    s = s & "   @UserID varchar(10)," & vbCrLf
    s = s & "   @DivisionID INT," & vbCrLf
    s = s & "   @NewScheduleID int OUTPUT," & vbCrLf
    s = s & "   @Unit varchar(10) =''" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "AS" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   DECLARE" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "       @ScheduleID int," & vbCrLf
    s = s & "       @FromTaskID int," & vbCrLf
    s = s & "       @ToTaskID int," & vbCrLf
    s = s & "       @FromScheduleTaskID int," & vbCrLf
    s = s & "       @ToScheduleTaskID int," & vbCrLf
    s = s & "       @ConstarintType int," & vbCrLf
    s = s & "       @ScheduleTaskID int," & vbCrLf
    s = s & "       @LibraryTaskID int," & vbCrLf
    s = s & "       @parentID int," & vbCrLf
    s = s & "       @SchedTaskID int," & vbCrLf
    s = s & "       @LagTime float," & vbCrLf
    s = s & "       @QCCheckListID int" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   DECLARE curTempConstr CURSOR" & vbCrLf
    s = s & "   FOR" & vbCrLf
    s = s & "   SELECT FromTaskID,ToTaskID,ConstraintType" & vbCrLf
    s = s & "   FROM dbo.TemplateConstraints" & vbCrLf
    s = s & "   WHERE TemplateID = @TemplateID" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   BEGIN TRANSACTION" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "     /* insert new schedule */" & vbCrLf
    s = s & "    INSERT INTO dbo.Schedule(DivisionID,Job_No,Description,TemplateID,OnHold,Closed,InActive,BaselineStart," & vbCrLf
    s = s & "       BaselineFinish,ExpectedStart,ExpectedFinish,CalendarID,PM,Unit)" & vbCrLf
    s = s & "    VALUES(@DivisionID,@Job_No,@Description,@TemplateID,@OnHold,@Closed,@InActive,@ProjectStartDate," & vbCrLf
    s = s & "      @ProjectStartDate,@ProjectStartDate,@ProjectStartDate,@CalendarID,@PM,@Unit)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    SET @ScheduleID = @@IDENTITY" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    /* insert schedule tasks from template */" & vbCrLf
    s = s & "    INSERT INTO dbo.ScheduleTasks(ScheduleID,Description,DrawID,ParentID,IndexInParent,Duration,LagTime," & vbCrLf
    s = s & "       QCCheckListID,JCCostCode,LibraryTaskID,SortOrder,Level,IsMilestone,ConstraintType,CUStmp," & vbCrLf
    s = s & "       CTStmp,NotificationNotes,IsSeasonal)" & vbCrLf
    s = s & "    SELECT @ScheduleID,t.Description,t.DrawID,NULL,t.IndexInParent,t.Duration,t.LagTime,t.QCListID,t.JCCostCode,t.TaskID," & vbCrLf
    s = s & "      t.SortOrder,t.Level,t.IsMilestone,'AsSoonAsPossible',@UserID,GETDATE(),lib.NotificationNotes,t.IsSeasonal" & vbCrLf
    s = s & "    FROM dbo.TemplateTasks t" & vbCrLf
    s = s & "    INNER JOIN dbo.LibraryTasks lib" & vbCrLf
    s = s & "        ON  t.TaskID = lib.TaskID" & vbCrLf
    s = s & "    WHERE t.TemplateID = @TemplateID" & vbCrLf
    s = s & "    ORDER BY t.SortOrder" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   /* Update ParentID fields */" & vbCrLf
    s = s & "   DECLARE curParentIDs CURSOR" & vbCrLf
    s = s & "   FOR" & vbCrLf
    s = s & "   SELECT ScheduleTaskID,LibraryTaskID" & vbCrLf
    s = s & "   FROM dbo.ScheduleTasks" & vbCrLf
    s = s & "   WHERE ScheduleID = @ScheduleID AND ParentID IS NULL" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   OPEN curParentIDs" & vbCrLf
    s = s & "   FETCH NEXT FROM curParentIDs INTO @ScheduleTaskID, @LibraryTaskID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   WHILE @@FETCH_STATUS = 0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    BEGIN" & vbCrLf
    s = s & "      SELECT @parentID = (SELECT ParentID FROM dbo.TemplateTasks" & vbCrLf
    s = s & "                 WHERE TemplateID = @TemplateID AND TaskID = @LibraryTaskID)" & vbCrLf
    s = s & "      IF @parentID = 0" & vbCrLf
    s = s & "            SET @SchedTaskID = 0" & vbCrLf
    s = s & "      ELSE" & vbCrLf
    s = s & "         SELECT @SchedTaskID = (SELECT ScheduleTaskID FROM dbo.ScheduleTasks" & vbCrLf
    s = s & "                       WHERE LibraryTaskID = @parentID AND ScheduleID = @ScheduleID)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      UPDATE dbo.ScheduleTasks" & vbCrLf
    s = s & "      SET ParentID = @SchedTaskID" & vbCrLf
    s = s & "      WHERE ScheduleTaskID = @ScheduleTaskID AND ScheduleID = @ScheduleID " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      FETCH NEXT FROM curParentIDs INTO @ScheduleTaskID, @LibraryTaskID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   CLOSE curParentIDs" & vbCrLf
    s = s & "   DEALLOCATE curParentIDs" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   /* assign schedule task resources(vendors) */" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   DECLARE curVendors CURSOR" & vbCrLf
    s = s & "   FOR" & vbCrLf
    s = s & "   SELECT ScheduleTaskID" & vbCrLf
    s = s & "   FROM dbo.ScheduleTasks" & vbCrLf
    s = s & "   WHERE ScheduleID = @ScheduleID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   OPEN curVendors" & vbCrLf
    s = s & "   FETCH NEXT FROM curVendors INTO @ScheduleTaskID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   WHILE @@FETCH_STATUS = 0" & vbCrLf
    s = s & "     BEGIN" & vbCrLf
    s = s & "        /* set up OriginalResource and AssignedResource */" & vbCrLf
    s = s & "        UPDATE ScheduleTasks" & vbCrLf
    s = s & "        SET OriginalResource = dbo.Schedule_GetVendorID(@ScheduleID,@ScheduleTaskID)," & vbCrLf
    s = s & "                  AssignedResource = dbo.Schedule_GetVendorID(@ScheduleID,@ScheduleTaskID)" & vbCrLf
    s = s & "        WHERE ScheduleTaskID = @ScheduleTaskID AND ScheduleID = @ScheduleID " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "       /* Insert all vendors */" & vbCrLf
    s = s & "       INSERT INTO Reservations(ScheduleTaskID,ResourceID) " & vbCrLf
    s = s & "       SELECT @ScheduleTaskID, Vendor_ID" & vbCrLf
    s = s & "       FROM dbo.POIndexVendors" & vbCrLf
    s = s & "       WHERE ScheduleID = @ScheduleID AND ScheduleTaskID = @ScheduleTaskID AND Vendor_ID IS NOT NULL" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "     FETCH NEXT FROM curVendors INTO @ScheduleTaskID " & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   CLOSE curVendors" & vbCrLf
    s = s & "   DEALLOCATE curVendors " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   " & vbCrLf
    s = s & "   /* insert schedule constraints */" & vbCrLf
    s = s & "   OPEN curTempConstr" & vbCrLf
    s = s & "   FETCH NEXT FROM curTempConstr INTO @FromTaskID, @ToTaskID,@ConstarintType" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   WHILE @@FETCH_STATUS = 0" & vbCrLf
    s = s & "     BEGIN" & vbCrLf
    s = s & "       SET @FromScheduleTaskID = (SELECT ScheduleTaskID  " & vbCrLf
    s = s & "                             FROM dbo.ScheduleTasks " & vbCrLf
    s = s & "                             WHERE ScheduleTasks.ScheduleID = @ScheduleID   " & vbCrLf
    s = s & "                   AND ScheduleTasks.LibraryTaskID = @FromTaskID) " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "       SET @ToScheduleTaskID = (SELECT ScheduleTaskID " & vbCrLf
    s = s & "                           FROM dbo.ScheduleTasks " & vbCrLf
    s = s & "                           WHERE ScheduleTasks.ScheduleID = @ScheduleID  " & vbCrLf
    s = s & "                   AND ScheduleTasks.LibraryTaskID = @ToTaskID) " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "       SET @LagTime = (SELECT LagTime  " & vbCrLf
    s = s & "                       FROM dbo.ScheduleTasks " & vbCrLf
    s = s & "                       WHERE ScheduleTasks.ScheduleID = @ScheduleID  " & vbCrLf
    s = s & "                AND ScheduleTasks.LibraryTaskID =  @ToTaskID) " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "       INSERT INTO dbo.ScheduleConstraints(FromScheduleTaskID,ToScheduleTaskID,ConstraintType,LagTime)" & vbCrLf
    s = s & "       VALUES(@FromScheduleTaskID,@ToScheduleTaskID,@ConstarintType,@LagTime)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "       FETCH NEXT FROM curTempConstr INTO @FromTaskID, @ToTaskID,@ConstarintType" & vbCrLf
    s = s & "   END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   CLOSE curTempConstr" & vbCrLf
    s = s & "   DEALLOCATE curTempConstr " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    /* Set cotnsraint type to StartOn to the first task in the schedule  and Lag = 0 */" & vbCrLf
    s = s & "   UPDATE ScheduleTasks" & vbCrLf
    s = s & "   SET ConstraintType = 'StartOn', LagTime = 0" & vbCrLf
    s = s & "   WHERE ScheduleID = @ScheduleID" & vbCrLf
    s = s & "        AND SortOrder = (SELECT MIN(SortOrder)" & vbCrLf
    s = s & "                        FROM ScheduleTasks" & vbCrLf
    s = s & "                        WHERE ScheduleID = @ScheduleID   " & vbCrLf
    s = s & "                            AND ScheduleTaskID NOT IN (SELECT ParentID " & vbCrLf
    s = s & "                                                      FROM ScheduleTasks" & vbCrLf
    s = s & "                                                      WHERE ScheduleID = @ScheduleID) " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "                   )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   --WHERE SortOrder = 2 AND ScheduleID = @ScheduleID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   /* Set check lists */" & vbCrLf
    s = s & "   DECLARE curQCLists CURSOR" & vbCrLf
    s = s & "   FOR" & vbCrLf
    s = s & "   SELECT ScheduleTaskID,QCCheckListID" & vbCrLf
    s = s & "   FROM dbo.ScheduleTasks" & vbCrLf
    s = s & "   WHERE ScheduleID = @ScheduleID AND QCCheckListID IS NOT NULL AND QCCheckListID > 0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   OPEN curQCLists" & vbCrLf
    s = s & "   FETCH NEXT FROM curQCLists INTO @ScheduleTaskID, @QCCheckListID " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   WHILE @@FETCH_STATUS = 0" & vbCrLf
    s = s & "      BEGIN" & vbCrLf
    s = s & "        EXEC Schedule_AddCheckListToTask  @ScheduleTaskID, @QCCheckListID" & vbCrLf
    s = s & "        FETCH NEXT FROM curQCLists INTO @ScheduleTaskID, @QCCheckListID" & vbCrLf
    s = s & "      END" & vbCrLf
    s = s & "   CLOSE curQCLists" & vbCrLf
    s = s & "   DEALLOCATE curQCLists" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   COMMIT TRANSACTION " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   SET @NewScheduleID = @ScheduleID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s

    sql c, "DROP PROC Schedule_InsertScheduleTask", True
