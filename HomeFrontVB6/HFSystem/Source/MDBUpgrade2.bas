    s = s & "    WHEN 1 THEN 'Model Option'" & vbCrLf
    s = s & "    WHEN 3 THEN 'Global Option'" & vbCrLf
    s = s & "    ELSE 'Design Center' END" & vbCrLf
    s = s & " ,ISNULL(a.AssemblyType,0) AssemblyType" & vbCrLf
