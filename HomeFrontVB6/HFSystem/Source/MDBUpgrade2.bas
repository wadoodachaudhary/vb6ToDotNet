c = "Add scheduled and actual dates to the startup view in Project Builder"
    s = ""
    s = s & "ALTER VIEW [dbo].[Schedule_TodayTasks] AS" & vbCrLf
    s = s & "SELECT" & vbCrLf
    s = s & " j.Job_No" & vbCrLf
    s = s & ",isnull(nullif(s.Description,''),s.scheduleid) Schedule" & vbCrLf
    s = s & ",s.ScheduleID" & vbCrLf
    s = s & ",st.ScheduleTaskID" & vbCrLf
    s = s & ",ISNULL(st.Description, '') Task" & vbCrLf
    s = s & ",st.ExpectedStart" & vbCrLf
    s = s & ",st.ExpectedFinish" & vbCrLf
    s = s & ",st.ScheduledStart" & vbCrLf
    s = s & ",st.ScheduledFinish" & vbCrLf
    s = s & ",st.ActualStart" & vbCrLf
    s = s & ",st.ActualFinish" & vbCrLf
    s = s & ",s.CalendarID" & vbCrLf
    s = s & ",j.Description Job" & vbCrLf
    s = s & ",j.Municipal_Address" & vbCrLf
    s = s & ",s.ExpectedStart ProjectStartDate" & vbCrLf
    s = s & ",st.LEVEL" & vbCrLf
    s = s & ",st.IsMilestone" & vbCrLf
    s = s & ",s.InActive" & vbCrLf
    s = s & ",s.OnHold" & vbCrLf
    s = s & ",s.Closed" & vbCrLf
    s = s & ",j.PM" & vbCrLf
    s = s & ",st.SortOrder" & vbCrLf
    s = s & ",j.DivisionID" & vbCrLf
    s = s & "FROM ScheduleTasks st" & vbCrLf
    s = s & "INNER JOIN Schedule s ON s.ScheduleID = st.ScheduleID" & vbCrLf
    s = s & "INNER JOIN tblJobs j ON j.Job_No = s.Job_No AND (j.Inactive = 0)" & vbCrLf
    s = s & "WHERE GETDATE() BETWEEN st.ExpectedStart AND st.ExpectedFinish " & vbCrLf
    s = s & "AND st.IsCompleted = 0" & vbCrLf
    sql c, s

