    s = s & "      update tblsalessheetdetails set cost = @Total+case when @AssemblyType = 0 then isnull(LandCost,0) else 0 end+IncentiveCost,ConstructionCost = @Total,Pretax=dbo.RndTo(round((@Total+case when @AssemblyType = 0 then isnull(LandCost,0) else 0 end+isnull(IncentiveCost,0))*(1+(Markup/100)),2),1,case RoundTo when 0 then 1 else roundto end) where worksheet = @SalesSheet and Community =@CommunityID and CommunityPhase = @CommunityPhaseID and Assembly=@AssemblyID and Model = @ModelID and OptionID=@Option_ID and Series = @SeriesID   " & vbCrLf
