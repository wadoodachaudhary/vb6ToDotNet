    s = s & " ,ISNULL(c.Description,'~~ customer not found ~~') CustomerDesc" & vbCrLf
    s = s & " ,ISNULL(j.Community,'') Community" & vbCrLf
    s = s & " ,ISNULL(l.Description,'') CommunityDesc" & vbCrLf
    s = s & " ,ISNULL(c.Phase,'') CommunityPhase" & vbCrLf
    s = s & " ,ISNULL(j.Job_No,'') Job_No" & vbCrLf
    s = s & " ,ISNULL(j.Description,'') JobDesc" & vbCrLf
    s = s & " ,ISNULL(a.EstimateIndex,0) EstimateIndex" & vbCrLf
