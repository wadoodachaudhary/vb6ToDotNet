    s = s & "ContractSalePrice as round(isnull(override_Price,0)+isnull(Elevation_price,0) +Lot_Price+isnull(lotpremiumpretax,0)+ScheduleB_Total-Sales_Initiative-Sales_Deduction+isnull(Parking1_Price+Parking2_Price+ Parking3_Price+ Parking4_Price+Parking5_Price+Parking6_Price+Parking7_Price,0),2)" & vbCrLf
    sql c, s

    s = ""
    s = s & "ALTER PROCEDURE [dbo].[Claims_CreateCustomerBillingItems](@Customer_No  VARCHAR(12)) AS" & vbCrLf
    s = s & "   DECLARE @difference float" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "   --create customer billing items based on the template selected" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "   insert into CustomerBillingItems(Customer_No,Description,ContractAmount,ContractPercent,PercentComplete,SortOrder)" & vbCrLf
    s = s & "   select" & vbCrLf
    s = s & "    c.Customer_No" & vbCrLf
    s = s & "   ,i.Description" & vbCrLf
    s = s & "   ,ROUND(i.ContractPercent/100 * c.ContractSalePrice,2) ContractAmount" & vbCrLf
    s = s & "   ,i.ContractPercent" & vbCrLf
    s = s & "   ,0 PercentComplete" & vbCrLf
    s = s & "   ,i.SortOrder " & vbCrLf
    s = s & "   from tblcustomers c" & vbCrLf
    s = s & "   join claimtemplateitems i on c.claimtemplateid=i.claimtemplateid" & vbCrLf
    s = s & "   where c.customer_no=@Customer_no" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "   --that may have truncated enough fractional pennys so that the sum of all " & vbCrLf
    s = s & "   --billing items does not equal the contract total. calc difference " & vbCrLf
    s = s & " " & vbCrLf
    s = s & "   select @difference = c.ContractSalePrice - sum(i.ContractAmount)" & vbCrLf
    s = s & "   from tblcustomers c" & vbCrLf
    s = s & "   left outer join customerbillingitems i on c.customer_no=i.customer_no" & vbCrLf
    s = s & "   where c.DivisionID=1 and c.BillingParent=@Customer_No" & vbCrLf
    s = s & "   group by c.Customer_no,c.description,c.Job_No,c.ContractSalePrice" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "   --and difference to last billing item." & vbCrLf
    s = s & " " & vbCrLf
    s = s & "   update customerbillingitems" & vbCrLf
    s = s & "   set contractamount = contractamount + @difference" & vbCrLf
    s = s & "   where billingitemid = (select max(billingitemid) from customerbillingitems where customer_no=@Customer_no)" & vbCrLf
    sql c, s


    s = ""
    s = s & "alter proc [dbo].[Purch_GetAssemblySalesSheetCost](@SalesSheet int,@Assembly varchar(20), @Model varchar(20), @OptionID varchar(20),@Community varchar(10),@CommunityPhase Varchar(10)) as" & vbCrLf
    s = s & "   declare @CommunityID varchar(20)" & vbCrLf
    s = s & "   declare @CommunityPhaseID varchar(20)" & vbCrLf
    s = s & "   declare @AssemblyID varchar(20)" & vbCrLf
    s = s & "   declare @ModelID varchar(20)" & vbCrLf
    s = s & "   declare @SeriesID varchar(20)" & vbCrLf
    s = s & "   declare @Option_ID varchar(20)" & vbCrLf
    s = s & "   Declare @Description varchar(200)" & vbCrLf
    s = s & "   Declare @AssemblyType Int" & vbCrLf
    s = s & "   Declare @TotalCost float" & vbCrLf
    s = s & "   Declare @LandCost float" & vbCrLf
    s = s & "   Declare @IncentiveCost float" & vbCrLf
    s = s & "   Declare @CalcSalesPrice as varchar(10)" & vbCrLf
    s = s & "   Declare @DivisionID as Int " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   set @DivisionID = (select DivisionID from tblSalesSheetMaster where Worksheet =@SalesSheet)" & vbCrLf
    s = s & "   set @CalcSalesPrice = (select OptionValue from Appoptions where OptionName = 'AdjustSellPriceWithCosts' and isnull(uid,'') = '' and DivisionID = @DivisionID)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   if @Assembly='' BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      -- no assembly filter given so do entire worksheet" & vbCrLf
    s = s & "      declare ListofAssemblies cursor for " & vbCrLf
    s = s & "      select sd.Community" & vbCrLf
    s = s & "            ,sd.CommunityPhase" & vbCrLf
    s = s & "            ,sd.Assembly" & vbCrLf
    s = s & "            ,sd.Model" & vbCrLf
    s = s & "            ,sd.Series" & vbCrLf
    s = s & "            ,sd.OptionID" & vbCrLf
    s = s & "            ,sd.Description AssemblyDesc" & vbCrLf
    s = s & "            ,sd.AssemblyType" & vbCrLf
    s = s & "            ,round(sum(case when i.phase=dbo.GetOption_Varchar(w.DivisionID,'IncentivePhase') and i.item=dbo.GetOption_Varchar(w.DivisionID,'IncentiveItem') then " & vbCrLf
    s = s & "                      dbo.Purch_GetmaxItemRate(w.CostBasisType+1,0,sd.Community,isnull(sd.CommunityPhase,''),d.Assembly,d.Model,d.OptionID,i.Phase,i.Item,d.Sequence,v.Vendor_ID,getdate(),w.DivisionID)*d.OrderQty*(100+isnull(t.jcrate,0))/100" & vbCrLf
    s = s & "                  else 0 end),2) IncentiveCost" & vbCrLf
    s = s & "            ,round(sum(case when i.phase=dbo.GetOption_Varchar(w.DivisionID,'LandPhase') and i.item=dbo.GetOption_Varchar(w.DivisionID,'LandItem') then " & vbCrLf
    s = s & "                       dbo.Purch_GetmaxItemRate(w.CostBasisType+1,0,sd.Community,isnull(sd.CommunityPhase,''),d.Assembly,d.Model,d.OptionID,i.Phase,i.Item,d.Sequence,v.Vendor_ID,getdate(),w.DivisionID)*d.OrderQty*(100+isnull(t.jcrate,0))/100" & vbCrLf
    s = s & "                  else 0 end),2) LandCost" & vbCrLf
    s = s & "            ,round(sum(dbo.Purch_GetmaxItemRate(w.CostBasisType+1,0,sd.Community,isnull(sd.CommunityPhase,''),d.Assembly,d.Model,d.OptionID,i.Phase,i.Item,d.Sequence,v.Vendor_ID,getdate(),w.DivisionID)*d.OrderQty*(100+isnull(t.jcrate,0))/100),2) TotalCost" & vbCrLf
    s = s & "      from tblSalesSheetDetails sd" & vbCrLf
    s = s & "           join tblSalesSheetMaster w on w.Worksheet = sd.Worksheet" & vbCrLf
    s = s & "           left outer join tbllocality c on c.inactive = 0 and c.area = sd.Community" & vbCrLf
    s = s & "           join tbldbassemblydetails d on(d.DivisionID = w.DivisionID and sd.assembly=d.assembly and sd.model=d.model and sd.optionid=d.optionid and sd.Sourcecommunity=d.community) " & vbCrLf
    s = s & "           join tblphaseitem i on(i.DivisionID = w.DivisionID and i.phase=d.phase and i.item=d.item)" & vbCrLf
    s = s & "           left outer join tblVendors v on(v.DivisionID = w.DivisionID and v.vendor_ID=dbo.Purch_GetCommunityVendor(sd.Community,isnull(nullif(d.POIndex,''),isnull(i.POIndex,'')),w.DivisionID))" & vbCrLf
    s = s & "           left outer join taxGroups t on (t.DivisionID = w.DivisionID and t.TaxGroup=dbo.Purch_GetDefaultTaxGroup('' , c.area ,'' , sd.Model , sd.Assembly ,i.phase ,i.item , v.Vendor_ID , i.JCCategory,w.DivisionID ))  " & vbCrLf
    s = s & "      where sd.Worksheet = @SalesSheet" & vbCrLf
    s = s & "      group by sd.Community,sd.CommunityPhase,sd.Assembly,sd.Model,sd.series,sd.OptionID,sd.Description,sd.AssemblyType" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   end else begin" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "      -- limit changes to given filter " & vbCrLf
    s = s & "      declare ListofAssemblies cursor for " & vbCrLf
    s = s & "      select sd.Community" & vbCrLf
    s = s & "            ,sd.CommunityPhase" & vbCrLf
    s = s & "            ,sd.Assembly" & vbCrLf
    s = s & "            ,sd.Model" & vbCrLf
    s = s & "            ,sd.Series" & vbCrLf
    s = s & "            ,sd.OptionID" & vbCrLf
    s = s & "            ,sd.Description AssemblyDesc" & vbCrLf
    s = s & "            ,sd.AssemblyType" & vbCrLf
    s = s & "            ,round(sum(case when i.phase=dbo.GetOption_Varchar(w.DivisionID,'IncentivePhase') and i.item=dbo.GetOption_Varchar(w.DivisionID,'IncentiveItem') then " & vbCrLf
    s = s & "                      dbo.Purch_GetmaxItemRate(w.CostBasisType+1,0,sd.Community,isnull(sd.CommunityPhase,''),d.Assembly,d.Model,d.OptionID,i.Phase,i.Item,d.Sequence,v.Vendor_ID,getdate(),w.DivisionID)*d.OrderQty*(100+isnull(t.jcrate,0))/100" & vbCrLf
    s = s & "                  else 0 end),2) IncentiveCost" & vbCrLf
    s = s & "            ,round(sum(case when i.phase=dbo.GetOption_Varchar(w.DivisionID,'LandPhase') and i.item=dbo.GetOption_Varchar(w.DivisionID,'LandItem') then " & vbCrLf
    s = s & "                       dbo.Purch_GetmaxItemRate(w.CostBasisType+1,0,sd.Community,isnull(sd.CommunityPhase,''),d.Assembly,d.Model,d.OptionID,i.Phase,i.Item,d.Sequence,v.Vendor_ID,getdate(),w.DivisionID)*d.OrderQty*(100+isnull(t.jcrate,0))/100" & vbCrLf
    s = s & "                  else 0 end),2) LandCost" & vbCrLf
