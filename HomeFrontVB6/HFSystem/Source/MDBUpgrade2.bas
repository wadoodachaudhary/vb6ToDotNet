    s = s & "       WHERE p.ScheduleID = @ScheduleID AND p.ScheduleTaskID = @ExistingScheduleTaskID" & vbCrLf
    s = s & "       AND p.Vendor_ID IS NOT NULL and r.ResourceID is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   RETURN" & vbCrLf
