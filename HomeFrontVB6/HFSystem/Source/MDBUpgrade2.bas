Private Sub Revisions_2016_9()

    Dim c As String
    Dim s As String

c = "Add WC Code to workticket labour lines"

    sql c, "alter table labouritems add WCProvince varchar(10)"
    sql c, "update labouritems set wcprovince=province"
    sql c, "alter table labouritems drop column province"
    
    sql c, "alter table labouritems add WCCode varchar(10)"
    
    s = ""
    s = s & "ALTER procedure [dbo].[ReadXML] @xmlstring varchar(max) as" & vbCrLf
    s = s & "declare @idoc   int" & vbCrLf
    s = s & "declare @itype  varchar(50)" & vbCrLf
    s = s & "exec sp_xml_preparedocument @idoc output, @xmlstring" & vbCrLf
    s = s & "set @itype = (select max(filetype) from openxml (@idoc, '/wt',1) with (filetype  varchar(50)))" & vbCrLf
    s = s & "if 'jsticketsubmission' = @itype begin" & vbCrLf
    s = s & "   ------------------------------" & vbCrLf
    s = s & "   --worktickets" & vbCrLf
    s = s & "   ------------------------------" & vbCrLf
    s = s & "   select * into #tmp_worktickets" & vbCrLf
    s = s & "   from openxml (@idoc,'wt/worktickets',2)" & vbCrLf
    s = s & "   with (workticket varchar(25),ticketdate datetime,job varchar(12),extra varchar(10),periodenddate datetime,status_depreciated varchar(20),description varchar(8000),enteredby varchar(15),ustmp varchar(15),tstmp datetime,costcode varchar(40),labourratesheet varchar(15),equipmentratesheet varchar(15),customer varchar(40),tickettype varchar(20),chargeable bit,invoice varchar(25),isquote bit,quoteexpirydate datetime,materialratesheet varchar(15),submitted bit,notes varchar(max),employeeautopay varchar(40),fuelcostindex varchar(25),billable bit,divisionid int,fieldapprovedby varchar(15),fieldapproveddate datetime,customerapprovedby varchar(15),customerapproveddate datetime,officeapprovedby varchar(15),officeapproveddate datetime,billed bit,istemplate bit)" & vbCrLf
    s = s & "   -- fix null dates" & vbCrLf
    s = s & "   update #tmp_worktickets" & vbCrLf
    s = s & "   set ticketdate=nullif(ticketdate,'1900-01-01'),periodenddate=nullif(periodenddate,'1900-01-01'),tstmp=nullif(tstmp,'1900-01-01'),quoteexpirydate=nullif(quoteexpirydate,'1900-01-01'),fieldapproveddate=nullif(fieldapproveddate,'1900-01-01'),customerapproveddate=nullif(customerapproveddate,'1900-01-01'),officeapproveddate=nullif(officeapproveddate,'1900-01-01')" & vbCrLf
    s = s & "   -- insert new data" & vbCrLf
