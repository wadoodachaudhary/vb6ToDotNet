    s = s & "    WHEN 1 THEN 'Elevation'" & vbCrLf
    s = s & "    WHEN 2 THEN 'Model Option'" & vbCrLf
    s = s & "    WHEN 3 THEN 'Global Option'" & vbCrLf
    s = s & "    ELSE 'Design Center' END" & vbCrLf
    s = s & " ,ISNULL(HFLocation,0) HFLocation" & vbCrLf
