    s = s & "from labouritems i left outer join standardcostcodes c on (i.costcode=c.CostCode)" & vbCrLf
    s = s & "where i.job<>''" & vbCrLf
    s = s & "union" & vbCrLf
    s = s & "select distinct i.divisionid,i.Job,i.CostCode,c.Description" & vbCrLf
