    s = s & "     SELECT AuditDate,dbo.fn_Parsename(keyvalues,'~',0) Vendor,dbo.fn_Parsename(keyvalues,'~',1) Phase,dbo.fn_Parsename(keyvalues,'~',2) Item,dbo.fn_Parsename(keyvalues,'~',3) Model,dbo.fn_Parsename(keyvalues,'~',4) Assembly,dbo.fn_Parsename(keyvalues,'~',5) Community,dbo.fn_Parsename(keyvalues,'~',6) CommunityPhase,cast(rtrim(comments) as float) Price           " & vbCrLf
    s = s & "     FROM userauditlog  where tablename = 'tblvendorcost' and AuditDate > @DateValue and auditdate-1< @DateValue" & vbCrLf
