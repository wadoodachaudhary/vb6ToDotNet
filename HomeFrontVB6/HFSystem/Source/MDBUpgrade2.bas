    sql c, "DROP PROC Schedule_UpdateScheduleConstraints", True
    s = ""
    s = s & "CREATE PROC [dbo].[Schedule_UpdateScheduleConstraints]" & vbCrLf
    s = s & "   @ScheduleID int," & vbCrLf
    s = s & "   @FromTaskID varchar(50), " & vbCrLf
