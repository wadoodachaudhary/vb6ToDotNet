    s = s & "    from scheduletasks i" & vbCrLf
    s = s & "    inner join schedule s on i.ScheduleID = s.ScheduleID" & vbCrLf
    s = s & "    inner join tblPOIndex p on i.LibraryTaskid = p.PayPoint3SchedTask and p.DivisionID = s.DivisionID" & vbCrLf
    s = s & "    inner join pomaster m on(m.poindex=p.poindex and m.job=s.job_no and m.DivisionID = s.DivisionID)" & vbCrLf
    s = s & "    where m.PayPoint3approveddate is null" & vbCrLf
    s = s & "    and i.POPaymentApproved = 1" & vbCrLf
    s = s & "    and m.Cancelled <>1" & vbCrLf
    s = s & "    and s.job_no=@job" & vbCrLf
    s = s & "   " & vbCrLf
    s = s & "    -- SET PAYPOINT 4" & vbCrLf
    s = s & "    update pomaster" & vbCrLf
    s = s & "    set paypoint4approveddate=getdate(),UpdateinAcct = 1,ApprovedDate=case when p.paypoint5percent=0 then getdate() else m.approveddate end" & vbCrLf
    s = s & "    from scheduletasks i" & vbCrLf
    s = s & "    inner join schedule s on i.ScheduleID = s.ScheduleID" & vbCrLf
    s = s & "    inner join tblPOIndex p on i.LibraryTaskid = p.PayPoint4SchedTask and p.DivisionID = s.DivisionID" & vbCrLf
    s = s & "    inner join pomaster m on(m.poindex=p.poindex and m.job=s.job_no and m.DivisionID = s.DivisionID)" & vbCrLf
    s = s & "    where m.PayPoint4approveddate is null" & vbCrLf
    s = s & "    and i.POPaymentApproved = 1" & vbCrLf
    s = s & "    and m.Cancelled <>1  " & vbCrLf
    s = s & "    and s.job_no=@job" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- SET PAYPOINT 5" & vbCrLf
    s = s & "    update pomaster" & vbCrLf
    s = s & "    set paypoint5approveddate=getdate(),UpdateinAcct = 1,ApprovedDate=getdate()" & vbCrLf
    s = s & "    from scheduletasks i" & vbCrLf
    s = s & "    inner join schedule s on i.ScheduleID = s.ScheduleID" & vbCrLf
    s = s & "    inner join tblPOIndex p on i.LibraryTaskid = p.PayPoint5SchedTask and p.DivisionID = s.DivisionID" & vbCrLf
    s = s & "    inner join pomaster m on(m.poindex=p.poindex and m.job=s.job_no and m.DivisionID = s.DivisionID)" & vbCrLf
    s = s & "    where m.PayPoint5approveddate is null" & vbCrLf
    s = s & "    and i.POPaymentApproved = 1" & vbCrLf
    s = s & "    and m.Cancelled <>1" & vbCrLf
    s = s & "    and s.job_no=@job" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "end" & vbCrLf
    sql c, s

