c = "Add workticket send/receive"
    s = ""
    s = s & "alter procedure [dbo].[readxml] @xmlstring varchar(max) as" & vbCrLf
    s = s & "declare @idoc   int" & vbCrLf
    s = s & "declare @itype  varchar(50)" & vbCrLf
    s = s & "exec sp_xml_preparedocument @idoc output, @xmlstring" & vbCrLf
    s = s & "set @itype = (select max(filetype) from openxml (@idoc, '/wt',1) with (filetype  varchar(50)))" & vbCrLf
    s = s & "if 'jsticketsubmission' = @itype begin" & vbCrLf
    s = s & "   ------------------------------" & vbCrLf
    s = s & "   --worktickets" & vbCrLf
    s = s & "   ------------------------------" & vbCrLf
    s = s & "   select * into #tmp_worktickets" & vbCrLf
