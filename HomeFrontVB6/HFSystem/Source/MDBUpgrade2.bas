    sql c, s
    
    s = ""
    s = s & "ALTER FUNCTION [dbo].[Purch_GetItemRate]( " & vbCrLf
    s = s & "    @LookupType     INTEGER" & vbCrLf
    s = s & "   ,@Worksheet      INTEGER" & vbCrLf
    s = s & "   ,@Community      VARCHAR(10)" & vbCrLf
    s = s & "   ,@CommunityPhase VARCHAR(10)" & vbCrLf
    s = s & "   ,@Assembly       VARCHAR(20)" & vbCrLf
    s = s & "   ,@Model          VARCHAR(20)" & vbCrLf
