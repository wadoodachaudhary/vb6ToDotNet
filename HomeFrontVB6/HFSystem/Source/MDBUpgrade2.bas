    s = s & "ELSE " & vbCrLf
    s = s & "SET @Amt = @Homeamt + @Landamt + @AddendumAmt + @COAmt + @DCAmt + @SalesIncentive + @SalesDeduction - @Incentive +@GSTAmt-@GSTRebateAmt-@TotalAdjust+@PSTAmt-@PSTRebateAmt+@RevenueAdjustment+@NHWFees" & vbCrLf
    s = s & "if @CostCodeSaleClosing = 1 begin" & vbCrLf
    s = s & "            insert into customerpostingtotal (customer_no,Type,ItemID,ItemDesc,Total,PriorPosting,ThisPosting,CostCode,GLPrefix,GLDebitAcct,GLCreditAcct,Posted,UserID,DateTimeStamp,sortorder) select @CustID,case when id = 14 then 2 else case when id = 15 or id = 16 or id = 17 then 3 else 1 end end,case when id <10 then '0'+cast(id as varchar(2)) else cast(id as varchar(2)) end,s.[Name],0,0,0,s.JCCostCode,'','',s.GLAccount,0,'',getdate(),s.sortorder from salesclosingglaccounts s left join customerpostingtotal c on c.itemid = s.[id] and c.customer_no=@CustID and c.type = 1 where s.DivisionID = @DivisionID and  c.itemid is null" & vbCrLf
    s = s & "            insert into customerpostingtotal (customer_no,Type,ItemID,ItemDesc,Total,PriorPosting,ThisPosting,CostCode,GLPrefix,GLDebitAcct,GLCreditAcct,Posted,UserID,DateTimeStamp,sortorder) values(@CustID,1,'00','AR Amount',0,0,0,'','','','',0,'',getdate(),0)" & vbCrLf
    s = s & "end" & vbCrLf
