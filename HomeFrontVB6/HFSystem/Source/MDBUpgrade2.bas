    s = ""
    s = s & "create PROCEDURE dbo.GenerateAutoPayTickets (" & vbCrLf
    s = s & "    @DivisionID INT" & vbCrLf
    s = s & "  , @PeriodEndDate DATETIME" & vbCrLf
    s = s & "  , @Employee varchar(10)) as" & vbCrLf
    s = s & "begin " & vbCrLf
    s = s & "  declare @t varchar(25)" & vbCrLf
    s = s & "  declare @e varchar(10)" & vbCrLf
    s = s & "  declare @name varchar(35)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  declare c cursor for" & vbCrLf
    s = s & "    select distinct e.employee,e.name " & vbCrLf
    s = s & "      from newautopays a " & vbCrLf
    s = s & "      join employees e on(e.employee=a.employee and a.divisionid=e.divisionid)" & vbCrLf
    s = s & "     where a.divisionid=@divisionid" & vbCrLf
    s = s & "       and a.periodenddate=@periodenddate" & vbCrLf
    s = s & "       and (a.employee=@employee or " & vbCrLf
    s = s & "            ISNULL(@employee,'')='')" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  open c" & vbCrLf
    s = s & "  fetch next from c into @e,@name" & vbCrLf
