    s = s & "CLOSE CustomerValues " & vbCrLf
    s = s & "DEALLOCATE CustomerValues " & vbCrLf
    s = s & "SET @BaseGL = Replace(@SaleCredit,'-', '')" & vbCrLf
    s = s & "SET @IncentiveGL = Replace(@AddendumGL,'-', '')" & vbCrLf
    s = s & "SET @SalesIncentiveGL = Replace(@AddendumGL,'-', '')" & vbCrLf
    s = s & "SET @SalesDeductGL = Replace(@AddendumGL,'-', '')" & vbCrLf
