    s = ""
    s = s & "ALTER FUNCTION [dbo].[Purch_GetDefaultTaxGroup](" & vbCrLf
    s = s & "    @Job            VARCHAR(12)" & vbCrLf
    s = s & "   ,@Community      VARCHAR(10)" & vbCrLf
    s = s & "   ,@CommunityPhase VARCHAR(10)" & vbCrLf
    s = s & "   ,@Model          VARCHAR(20)" & vbCrLf
    s = s & "   ,@Assembly       VARCHAR(20)" & vbCrLf
    s = s & "   ,@Phase          VARCHAR(20)" & vbCrLf
    s = s & "   ,@Item           VARCHAR(16)" & vbCrLf
    s = s & "   ,@Vendor         VARCHAR(40)" & vbCrLf
    s = s & "   ,@JCCategory     VARCHAR(40)" & vbCrLf
    s = s & "   ,@DivisionID     INTEGER ) " & vbCrLf
    s = s & "RETURNS VARCHAR(6)  AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @CostType INTEGER" & vbCrLf
    s = s & "    DECLARE @TaxGroup VARCHAR(6)" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    IF isnull(@Community,'')<>'' and isnull(@DivisionID,0) = 0  BEGIN" & vbCrLf
    s = s & "       SET @DivisionID = (Select Top 1 DivisionID from DivisionCommunities where Community = @Community)" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    if isnull(@Job,'') <> '' and isnull(@DivisionID,0) = 0 BEGIN" & vbCrLf
    s = s & "       SET @DivisionID = (Select Top 1 DivisionID from tbljobs where job_no = @Job)" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- look in tblVendorCost " & vbCrLf
    s = s & "    IF @Phase<>'' AND @Item<>'' AND @vendor<>'' BEGIN" & vbCrLf
    s = s & "        SET @TaxGroup = (select TOP 1 taxgroup " & vbCrLf
    s = s & "                           from tblvendorcost" & vbCrLf
    s = s & "                          where (community=@community or community='')" & vbCrLf
    s = s & "                            and (community=@community and (communityphase=@communityphase or communityphase=''))" & vbCrLf
    s = s & "                            and (model=@model or model='')" & vbCrLf
    s = s & "                            and (assembly=@assembly or assembly='')" & vbCrLf
    s = s & "                            and (vendor=@vendor)" & vbCrLf
    s = s & "                            and (phase=@phase)" & vbCrLf
    s = s & "                            and (item=@item)" & vbCrLf
    s = s & "                           and (DivisionID = @DivisionID)" & vbCrLf
    s = s & "                          order by community desc,communityphase desc,model desc,assembly desc)" & vbCrLf
    s = s & "        IF (ISNULL(@TaxGroup,'')<>'') RETURN(@TaxGroup)" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- look in tblPhaseItem " & vbCrLf
    s = s & "    IF (@Phase<>'' AND @Item<>'') BEGIN" & vbCrLf
    s = s & "        SET @TaxGroup = (SELECT TaxGroup " & vbCrLf
    s = s & "                           FROM tblPhaseItem" & vbCrLf
    s = s & "                          WHERE Phase=@Phase AND Item=@Item AND DivisionID = @DivisionID) " & vbCrLf
    s = s & "        IF (ISNULL(@TaxGroup,'')<>'') RETURN(@TaxGroup)" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- If the use equipment system setting is turned off then jccategories of cost type 'equipment'" & vbCrLf
    s = s & "    -- are considered variances and we want to ignore them. Instead we will use the jccategory from" & vbCrLf
    s = s & "    -- the tblPhaseItem record, if available." & vbCrLf
    s = s & "    select @JCCategory=i.JCCategory" & vbCrLf
    s = s & "      from tblPhaseItem i" & vbCrLf
    s = s & "          ,StandardCategories c" & vbCrLf
    s = s & "          ,system_setup s" & vbCrLf
    s = s & "     where s.UseEquipmentCostType=0" & vbCrLf
    s = s & "       and c.Category=@JCCategory" & vbCrLf
    s = s & "       and c.CostType=4" & vbCrLf
    s = s & "       and i.Phase=@Phase" & vbCrLf
    s = s & "       and i.Item=@Item" & vbCrLf
    s = s & "       and i.DivisionID = @DivisionID" & vbCrLf
    s = s & "       and c.DivisionID = @DivisionID" & vbCrLf
    s = s & "       and isnull(i.JCCategory,'')<>''" & vbCrLf
    s = s & "       and s.ID = @DivisionID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- lookup costtype for category" & vbCrLf
    s = s & "    SET @CostType = (SELECT CostType " & vbCrLf
    s = s & "                       FROM StandardCategories " & vbCrLf
    s = s & "                      WHERE Category=@JCCategory and DivisionID = @DivisionID)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- look in VendorTaxGroups" & vbCrLf
    s = s & "    IF @vendor<>'' and @Community<>'' BEGIN" & vbCrLf
    s = s & "        SET @TaxGroup = (SELECT CASE @CostType WHEN 1 THEN LabourTaxGroup WHEN 2 THEN MaterialTaxGroup WHEN 3 THEN SubContractTaxGroup WHEN 4 THEN EquipmentTaxGroup WHEN 5 THEN OverheadTaxGroup WHEN 6 THEN OtherTaxGroup END " & vbCrLf
    s = s & "                           FROM VendorTaxGroups" & vbCrLf
    s = s & "                          WHERE Vendor=@vendor" & vbCrLf
    s = s & "                            AND Community=@Community)" & vbCrLf
    s = s & "        IF (ISNULL(@TaxGroup,'')<>'') RETURN(@TaxGroup)" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- look in tblVendors" & vbCrLf
    s = s & "    IF @vendor<>'' BEGIN" & vbCrLf
    s = s & "        SET @TaxGroup = (SELECT CASE @CostType WHEN 1 THEN LabourTaxGroup WHEN 2 THEN MaterialTaxGroup WHEN 3 THEN SubContractTaxGroup WHEN 4 THEN EquipmentTaxGroup WHEN 5 THEN OverheadTaxGroup WHEN 6 THEN OtherTaxGroup END " & vbCrLf
    s = s & "                           FROM tblVendors" & vbCrLf
    s = s & "                          WHERE Vendor_ID=@vendor and DivisionID = @DivisionID)" & vbCrLf
    s = s & "        IF (ISNULL(@TaxGroup,'')<>'') RETURN(@TaxGroup)" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- look in tblJobs" & vbCrLf
    s = s & "    IF @Job<>'' BEGIN" & vbCrLf
    s = s & "        SET @TaxGroup = (SELECT CASE @CostType WHEN 1 THEN LabourTaxGroup WHEN 2 THEN MaterialTaxGroup WHEN 3 THEN SubContractTaxGroup WHEN 4 THEN EquipmentTaxGroup WHEN 5 THEN OverheadTaxGroup WHEN 6 THEN OtherTaxGroup END " & vbCrLf
    s = s & "                           FROM tblJobs" & vbCrLf
    s = s & "                          WHERE Job_No=@Job and DivisionID = @DivisionID)" & vbCrLf
    s = s & "        IF (ISNULL(@TaxGroup,'')<>'') RETURN(@TaxGroup)" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- look in tblLocality" & vbCrLf
    s = s & "    IF @Community<>'' BEGIN" & vbCrLf
    s = s & "        SET @TaxGroup = (SELECT CASE @CostType WHEN 1 THEN LabourTaxGroup WHEN 2 THEN MaterialTaxGroup WHEN 3 THEN SubContractTaxGroup WHEN 4 THEN EquipmentTaxGroup WHEN 5 THEN OverheadTaxGroup WHEN 6 THEN OtherTaxGroup END " & vbCrLf
    s = s & "          FROM tblLocality WHERE Area=@Community)" & vbCrLf
    s = s & "        IF (ISNULL(@TaxGroup,'')<>'') RETURN(@TaxGroup)" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "    -- fail! return default from system_setup" & vbCrLf
    s = s & "    SET @TaxGroup = (SELECT OptionValue FROM AppOptions WHERE UID='' AND OptionName = 'TaxGroupMaterial')" & vbCrLf
    s = s & "    if @CostType=1 SET @TaxGroup = (SELECT OptionValue FROM AppOptions WHERE UID='' AND OptionName = 'TaxGroupLabour' and DivisionID = @DivisionID)" & vbCrLf
    s = s & "    if @CostType=3 SET @TaxGroup = (SELECT OptionValue FROM AppOptions WHERE UID='' AND OptionName = 'TaxGroupSubContract' and DivisionID = @DivisionID)" & vbCrLf
    s = s & "    if @CostType=4 SET @TaxGroup = (SELECT OptionValue FROM AppOptions WHERE UID='' AND OptionName = 'TaxGroupEquipment' and DivisionID = @DivisionID)" & vbCrLf
    s = s & "    if @CostType=5 SET @TaxGroup = (SELECT OptionValue FROM AppOptions WHERE UID='' AND OptionName = 'TaxGroupOverhead' and DivisionID = @DivisionID)" & vbCrLf
    s = s & "    if @CostType=6 SET @TaxGroup = (SELECT OptionValue FROM AppOptions WHERE UID='' AND OptionName = 'TaxGroupOther' and DivisionID = @DivisionID)" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    RETURN(@TaxGroup)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s

    s = ""
    s = s & "ALTER  proc [dbo].[Purch_GetAssemblySalesSheetCost]" & vbCrLf
    s = s & "(@SalesSheet int,@Assembly varchar(20), @Model varchar(20), @OptionID varchar(20),@Community varchar(10),@CommunityPhase Varchar(10))" & vbCrLf
    s = s & "as" & vbCrLf
    s = s & "declare @CommunityID varchar(20)" & vbCrLf
    s = s & "declare @CommunityPhaseID varchar(20)" & vbCrLf
    s = s & "declare @AssemblyID varchar(20)" & vbCrLf
    s = s & "declare @ModelID varchar(20)" & vbCrLf
    s = s & "declare @SeriesID varchar(20)" & vbCrLf
    s = s & "declare @Option_ID varchar(20)" & vbCrLf
    s = s & "Declare @Description varchar(200)" & vbCrLf
    s = s & "Declare @AssemblyType Int" & vbCrLf
    s = s & "Declare @Total float" & vbCrLf
    s = s & "Declare @CalcSalesPrice as varchar(10)" & vbCrLf
    s = s & "Declare @DivisionID as Int " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "set @DivisionID = (select DivisionID from tblSalesSheetMaster where Worksheet =@SalesSheet)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "set @CalcSalesPrice = (select OptionValue from Appoptions where OptionName = 'AdjustSellPriceWithCosts' and isnull(uid,'') = '' and DivisionID = @DivisionID)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "if @Assembly='' BEGIN" & vbCrLf
    s = s & "   declare ListofAssemblies cursor for " & vbCrLf
    s = s & "   select sd.Community" & vbCrLf
    s = s & "   ,sd.CommunityPhase" & vbCrLf
    s = s & "   ,sd.Assembly" & vbCrLf
    s = s & "   ,sd.Model" & vbCrLf
    s = s & "   ,sd.Series" & vbCrLf
    s = s & "   ,sd.OptionID" & vbCrLf
    s = s & "   ,sd.Description AssemblyDesc" & vbCrLf
    s = s & "   ,sd.AssemblyType" & vbCrLf
    s = s & "   ,ROUND(SUM(dbo.Purch_GetmaxItemRate(w.CostBasisType+1,0,sd.Community,isnull(sd.CommunityPhase,''),d.Assembly,d.Model,d.OptionID,i.Phase,i.Item,d.Sequence,v.Vendor_ID,getdate(),w.DivisionID) *d.OrderQty*(100+isnull(t.jcrate,0))/100),2) Total" & vbCrLf
    s = s & "   from tblSalesSheetDetails sd" & vbCrLf
    s = s & "   join tblSalesSheetMaster w on w.Worksheet = sd.Worksheet" & vbCrLf
    s = s & "   left outer join tbllocality c on c.inactive = 0 and c.area = sd.Community" & vbCrLf
    s = s & "   join tbldbassemblydetails d on(d.DivisionID = w.DivisionID and sd.assembly=d.assembly and sd.model=d.model and sd.optionid=d.optionid and sd.Sourcecommunity=d.community) " & vbCrLf
    s = s & "   left outer join CommunityStandards s" & vbCrLf
    s = s & "       ON(s.Community=sd.community  AND s.CommunityPhase=''" & vbCrLf
    s = s & "      AND s.StdPhase=d.Phase AND s.StdItem=d.Item)" & vbCrLf
    s = s & "   join tblphaseitem i on(i.DivisionID = w.DivisionID and i.phase=isnull(s.phase,d.phase) and i.item=isnull(s.item,d.item))" & vbCrLf
    s = s & "   left outer join tblVendors v on(v.DivisionID = w.DivisionID and v.vendor_ID=dbo.Purch_GetCommunityVendor(sd.Community,isnull(nullif(d.POIndex,''),isnull(i.POIndex,'')),w.DivisionID))" & vbCrLf
    s = s & "   left outer join taxGroups t on (t.DivisionID = w.DivisionID and t.TaxGroup=dbo.Purch_GetDefaultTaxGroup('' , c.area ,'' , sd.Model , sd.Assembly ,i.phase ,i.item , v.Vendor_ID , i.JCCategory,w.DivisionID ))  " & vbCrLf
    s = s & "   where sd.Worksheet = @SalesSheet" & vbCrLf
    s = s & "   group by sd.Community,sd.CommunityPhase,sd.Assembly,sd.Model,sd.series,sd.OptionID,sd.Description,sd.AssemblyType" & vbCrLf
    s = s & "   " & vbCrLf
    s = s & "   open ListofAssemblies " & vbCrLf
    s = s & "   fetch next from ListofAssemblies into @CommunityID,@CommunityPhaseID,@AssemblyID,@ModelID,@SeriesID,@Option_ID,@Description,@AssemblyType,@Total" & vbCrLf
    s = s & "   while @@fetch_status <>-1" & vbCrLf
    s = s & "   begin   " & vbCrLf
    s = s & "        IF isnull(@Total,0)<>0 BEGIN" & vbCrLf
    s = s & "           IF @CalcSalesPrice = 'True' BEGIN" & vbCrLf
    s = s & "              update tblsalessheetdetails set cost = @Total+case when @AssemblyType = 0 then isnull(LandCost,0) else 0 end+isnull(IncentiveCost,0),ConstructionCost = @Total,Pretax=dbo.RndTo(round((@Total+case when @AssemblyType = 0 then isnull(LandCost,0) else 0 end+isnull(IncentiveCost,0))*(1+(Markup/100)),2),1,case RoundTo when 0 then 1 else RoundTo end) where worksheet = @SalesSheet and Community =@CommunityID and CommunityPhase = @CommunityPhaseID and Assembly=@AssemblyID and Model = @ModelID and OptionID=@Option_ID and Series = @SeriesID      " & vbCrLf
