    s = ""
    s = s & "ALTER TRIGGER [POMaster_CreateInvoice] ON [dbo].[POMaster] FOR UPDATE AS" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "IF UPDATE(ApprovedDate) BEGIN" & vbCrLf
    s = s & "    INSERT INTO Invoices(Vendor,Invoice,InvoiceDate,AccountingDate,Description,Status,VendorName,PreTax,Tax,Source,UStmp,TStmp)" & vbCrLf
    s = s & "    SELECT m.Vendor" & vbCrLf
    s = s & "          ,m.PONumber" & vbCrLf
    s = s & "          ,m.ApprovedDate InvoiceDate" & vbCrLf
    s = s & "          ,m.ApprovedDate AccountingDate" & vbCrLf
    s = s & "          ,LEFT(j.Municipal_Address,100) Description" & vbCrLf
    s = s & "          ,'SiteApproved' Status" & vbCrLf
    s = s & "          ,v.Vendor_Name VendorName" & vbCrLf
    s = s & "          ,SUM(ISNULL(i.Pretax,0)) Pretax" & vbCrLf
    s = s & "          ,SUM(ISNULL(i.JCTax,0)+ISNULL(i.NJCTax,0)) Tax" & vbCrLf
    s = s & "          ,'autoinserting..' Source" & vbCrLf
    s = s & "          ,m.ApprovedBy UStmp" & vbCrLf
    s = s & "          ,getdate() TStmp" & vbCrLf
    s = s & "      FROM Inserted m" & vbCrLf
    s = s & "      LEFT OUTER JOIN Invoices e ON(m.PONumber=e.Invoice and m.Vendor=e.Vendor)" & vbCrLf
    s = s & "      JOIN POItems i ON(m.PONumber=i.PONumber)" & vbCrLf
    s = s & "      LEFT OUTER JOIN tbljobs j on (i.Job=j.Job_no)" & vbCrLf
    s = s & "      JOIN tblVendors v ON(v.Vendor_ID=m.Vendor)     " & vbCrLf
    s = s & "      JOIN AppOptions ao ON(ao.OptionName='AutoPayApprovedPOs' and ao.OptionValue='True')     " & vbCrLf
    s = s & "     WHERE e.Invoice IS NULL" & vbCrLf
    s = s & "       AND m.ApprovedDate IS NOT NULL" & vbCrLf
    s = s & "     GROUP BY m.Vendor,m.PONumber,m.ApprovedDate,j.Municipal_Address,v.Vendor_Name,v.APType,m.ApprovedBy" & vbCrLf
    s = s & "         " & vbCrLf
    s = s & "     INSERT INTO InvoiceItems(InvoiceID,Vendor,Invoice,Commitment,CommitmentItem,CommitmentDesc,CommitmentVendor,Job,Extra,Phase,PhaseDesc,Category,CategoryDesc,InvoicedQuantity,TaxGroup,TaxGroupDesc,TaxRate,PreTax,Tax,Description,Retainage,RetainageRate)" & vbCrLf
    s = s & "     SELECT e.InvoiceID" & vbCrLf
    s = s & "           ,e.Vendor " & vbCrLf
    s = s & "           ,e.Invoice" & vbCrLf
    s = s & "           ,i.PONumber Commitment" & vbCrLf
    s = s & "           ,i.LineNumber CommitmentItem" & vbCrLf
    s = s & "           ,LEFT(m.Description,200) CommitmentDesc" & vbCrLf
    s = s & "           ,e.Vendor CommitmentVendor" & vbCrLf
    s = s & "           ,i.Job" & vbCrLf
    s = s & "           ,i.JCExtra" & vbCrLf
    s = s & "           ,i.JCCostCode Phase" & vbCrLf
    s = s & "           ,cc.Description" & vbCrLf
    s = s & "           ,i.JCCategory" & vbCrLf
    s = s & "           ,c.Description" & vbCrLf
    s = s & "           ,0" & vbCrLf
    s = s & "           ,ISNULL(i.TaxGroup,'') TaxGroup" & vbCrLf
    s = s & "           ,LEFT(t.Description,30) TaxGroupDescription" & vbCrLf
    s = s & "           ,ISNULL(t.GroupRate,0) TaxRate" & vbCrLf
    s = s & "           ,sum(ROUND(isnull(i.pretax,0)-isnull(x.pretax,0),2))  Pretax" & vbCrLf
    s = s & "           ,sum(round(isnull(i.jctax,0)+isnull(i.njctax,0)-isnull(x.Tax,0),2)) Tax" & vbCrLf
    s = s & "           ,Left(i.LineDescription,100) Description" & vbCrLf
    s = s & "           ,Round(sum(ROUND(isnull(i.pretax,0)-isnull(x.pretax,0),2))*m.RetainagePercent/100,2)" & vbCrLf
    s = s & "           ,isnull(m.RetainagePercent,0)" & vbCrLf
    s = s & "      FROM Inserted m" & vbCrLf
    s = s & "      JOIN Invoices e ON(m.PONumber=e.Invoice and m.Vendor=e.Vendor and e.Source='autoinserting..')" & vbCrLf
    s = s & "       join pototal pt on(m.ponumber=pt.ponumber)" & vbCrLf
    s = s & "       left outer join pototalinvoiced pti on(m.ponumber=pti.ponumber)" & vbCrLf
    s = s & "       join tblvendors v on(m.vendor=v.vendor_id)" & vbCrLf
    s = s & "       join tbljobs j on(m.job=j.job_no)" & vbCrLf
    s = s & "       join poitemsSummarized i on(m.ponumber=i.ponumber)" & vbCrLf
    s = s & "       left outer join poinvoicedamounts x on(i.ponumber=x.ponumber and i.linenumber=x.itemseq)" & vbCrLf
    s = s & "       join standardcostcodes cc on(i.jccostcode=cc.costcode)" & vbCrLf
    s = s & "       join standardcategories c on(i.jccategory=c.category)" & vbCrLf
    s = s & "       LEFT OUTER JOIN TaxGroups t ON(t.TaxGroup=i.TaxGroup)" & vbCrLf
    s = s & "       where m.ApprovedDate IS NOT NULL and e.Invoice IS NOT NULL" & vbCrLf
    s = s & "       group by pti.pretax,pt.pretaxtotal,e.InvoiceID,e.Vendor,e.Invoice,i.PONumber,i.LineNumber,left(m.Description,200),e.Vendor,i.TaxGroup,t.Description,t.GroupRate,i.job,i.jcextra,i.jccostcode,cc.Description,i.jccategory,c.Description,left(i.Linedescription,100),m.RetainagePercent" & vbCrLf
    s = s & "       Having pt.pretaxtotal - isnull(pti.pretax,0) <> 0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    UPDATE Invoices" & vbCrLf
    s = s & "       SET Source='AutoApproved'" & vbCrLf
    s = s & "      FROM Inserted m" & vbCrLf
    s = s & "      JOIN Invoices e ON(m.PONumber=e.Invoice and m.Vendor=e.Vendor and e.Source='autoinserting..')" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s
    
    s = ""
    s = s & "ALTER FUNCTION [dbo].[Purch_GetItemRate]( " & vbCrLf
    s = s & "    @LookupType     INTEGER" & vbCrLf
    s = s & "   ,@Worksheet      INTEGER" & vbCrLf
    s = s & "   ,@Community      VARCHAR(10)" & vbCrLf
    s = s & "   ,@CommunityPhase VARCHAR(10)" & vbCrLf
    s = s & "   ,@Assembly       VARCHAR(20)" & vbCrLf
    s = s & "   ,@Model          VARCHAR(20)" & vbCrLf
    s = s & "   ,@OptionID       VARCHAR(20)" & vbCrLf
    s = s & "   ,@Phase          VARCHAR(20)" & vbCrLf
    s = s & "   ,@Item           VARCHAR(16)" & vbCrLf
    s = s & "   ,@Sequence       INTEGER" & vbCrLf
    s = s & "   ,@Vendor         VARCHAR(40)" & vbCrLf
    s = s & "   ,@EffectiveDate  DATETIME)" & vbCrLf
    s = s & "RETURNS FLOAT AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "    DECLARE @POIndex VARCHAR(20)" & vbCrLf
    s = s & "    IF @Vendor='' BEGIN" & vbCrLf
    s = s & "        SET @POIndex=(SELECT POIndex FROM tbldbassemblydetails WHERE sequence = @Sequence and Phase=@Phase AND Item=@Item)" & vbCrLf
    s = s & "       IF isnull(@POINDEX,'')='' BEGIN" & vbCrLf
    s = s & "   SET @POIndex=(SELECT POIndex FROM tblphaseitem WHERE Phase=@Phase AND Item=@Item)" & vbCrLf
    s = s & "       END" & vbCrLf
    s = s & "        SET @Vendor=dbo.Purch_GetCommunityVendor(@Community,@POIndex)" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "    DECLARE @datasource INTEGER" & vbCrLf
    s = s & "    DECLARE @rate FLOAT" & vbCrLf
    s = s & "    DECLARE rates CURSOR FOR" & vbCrLf
    s = s & "    SELECT 4 DataSource,'Rate' = CASE " & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate>=c.Next_Effective2 and c.Next_Effective2 is not null THEN c.Next_Cost2" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate>=c.Next_Effective1 and c.Next_Effective1 is not null THEN c.Next_Cost1" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate<c.Last3_Expiry and c.Last3_Expiry is not null THEN c.Last_Cost3" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate<c.Last2_Expiry and c.Last2_Expiry is not null THEN c.Last_Cost2" & vbCrLf
    s = s & "           WHEN @LookupType=0 AND @EffectiveDate<c.Last1_Expiry and c.Last1_Expiry is not null THEN c.Last_Cost1" & vbCrLf
    s = s & "           WHEN @LookupType=0 THEN c.Current_Cost" & vbCrLf
    s = s & "           WHEN @LookupType=1 THEN c.Current_Cost" & vbCrLf
    s = s & "           WHEN @LookupType=2 THEN case when isnull(c.Next_Cost1,0) = 0 then c.Current_Cost else c.Next_Cost1 end" & vbCrLf
    s = s & "           WHEN @LookupType=3 THEN case when isnull(c.Next_Cost2,0) = 0 then c.Current_Cost else c.Next_Cost2 end" & vbCrLf
    s = s & "           WHEN @LookupType=4 THEN c.Last_Cost1" & vbCrLf
    s = s & "           WHEN @LookupType=5 THEN c.Last_Cost2" & vbCrLf
    s = s & "           WHEN @LookupType=6 THEN c.Last_Cost3" & vbCrLf
    s = s & "           WHEN @LookupType=7 THEN c.Forecast1" & vbCrLf
    s = s & "           WHEN @LookupType=8 THEN c.Forecast2" & vbCrLf
    s = s & "           WHEN @LookupType=9 THEN c.Forecast3" & vbCrLf
    s = s & "           WHEN @LookupType=10 THEN c.Forecast4" & vbCrLf
    s = s & "           WHEN @LookupType=11 THEN c.Forecast5" & vbCrLf
    s = s & "           WHEN @LookupType=12 THEN c.Forecast6" & vbCrLf
    s = s & "           WHEN @LookupType=13 THEN c.Forecast7" & vbCrLf
