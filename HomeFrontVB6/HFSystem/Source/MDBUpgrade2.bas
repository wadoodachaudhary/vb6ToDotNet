    s = s & "" & vbCrLf
    s = s & "   " & vbCrLf
    s = s & "   IF SUBSTRING(@ParentID,1,1)<>'L'" & vbCrLf
    s = s & "   SET @NewParentID = CAST(@ParentID AS int)" & vbCrLf
    s = s & "   ELSE" & vbCrLf
    s = s & "   SET @NewParentID = NULL" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   INSERT INTO ScheduleTasks" & vbCrLf
    s = s & "   (ScheduleID, Description, ParentID, IndexInParent, Duration, " & vbCrLf
    s = s & "PercentComplete, BaselineStart, BaselineFinish, ScheduledStart," & vbCrLf
    s = s & "ScheduledFinish, ExpectedStart, ExpectedFinish, ActualStart, " & vbCrLf
    s = s & "ActualFinish, DrawID, lagtime, QCCheckListID, OriginalResource," & vbCrLf
    s = s & "JCCostCode, AssignedResource, LibraryTaskID, Comments, " & vbCrLf
    s = s & "InternalResource, CompletedDate, SortOrder, [Level], " & vbCrLf
    s = s & "IsMilestone,IsScheduled,IsCompleted,ActualDuration,ConstraintType,ActualEndDate," & vbCrLf
    s = s & "UserDate1,UserDate2,UserDate3,UserDate4,UserText1,UserText2,UserText3,UserText4," & vbCrLf
    s = s & "UserAmount1,UserAmount2,UserAmount3,UserAmount4,VarianceCode,POPaymentApproved,VarianceNotes,NotificationNotes," & vbCrLf
    s = s & "CUStmp,CTStmp,IsSeasonal)" & vbCrLf
    s = s & "   VALUES(@ScheduleID, RTRIM(@Description), @NewParentID," & vbCrLf
    s = s & "  @IndexInParent, CAST(@Duration AS Float)," & vbCrLf
    s = s & "  @PercentComplete, @BaselineStart, @BaselineEnd, " & vbCrLf
    s = s & "  @ScheduledStart, @ScheduledEnd, @StartTime, " & vbCrLf
    s = s & "  @EndTime, @ActualStartTime, @ActualEndTime, @DrawID, " & vbCrLf
    s = s & "  @lagtime, @QCCheckListID, @OriginalResource, @JCCostCode, " & vbCrLf
    s = s & "  @AssignedResource,@LibraryTaskID, @Comments, @InternalResource," & vbCrLf
    s = s & "  @CompletedDate, @SortOrder, @Level, @IsMilestone,@IsScheduled,@IsCompleted,CAST(@ActualDuration AS Float),@ConstraintType," & vbCrLf
    s = s & "  @ActualEndDate,@UserDate1,@UserDate2,@UserDate3,@UserDate4,@UserText1,@UserText2,@UserText3,@UserText4," & vbCrLf
    s = s & "  @UserAmount1,@UserAmount2,@UserAmount3,@UserAmount4,@VarianceCode,@POPaymentApproved,@VarianceNotes,@NotificationNotes," & vbCrLf
    s = s & "  @UserID,@CTStmp,@IsSeasonal)" & vbCrLf
    s = s & "   SET @ScheduleTaskID = @@IDENTITY" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   IF @NewParentID IS NULL" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "   /* Get template ID*/" & vbCrLf
    s = s & "   SET @TemplateID = CAST(SUBSTRING(@ParentID,charindex('T',@ParentID)+1,LEN(@ParentID)) AS int)" & vbCrLf
    s = s & "   " & vbCrLf
    s = s & "   IF @TemplateID=0" & vbCrLf
    s = s & "   /* Task came from the library */" & vbCrLf
    s = s & "   SELECT @TaskParentID = (SELECT ParentID FROM dbo.LibraryTasks" & vbCrLf
    s = s & "   WHERE TaskID = @LibraryTaskID)" & vbCrLf
    s = s & "   ELSE" & vbCrLf
    s = s & "   /* Task came from template */" & vbCrLf
    s = s & "   SELECT @TaskParentID = (SELECT ParentID FROM dbo.TemplateTasks" & vbCrLf
    s = s & "   WHERE TemplateID = @TemplateID" & vbCrLf
    s = s & "   AND TaskID = @LibraryTaskID)" & vbCrLf
    s = s & "   IF @TaskParentID = 0" & vbCrLf
    s = s & "   SET @NewID = 0" & vbCrLf
    s = s & "   ELSE" & vbCrLf
    s = s & "   SELECT @NewID = (SELECT ScheduleTaskID " & vbCrLf
    s = s & "  FROM dbo.ScheduleTasks" & vbCrLf
    s = s & "  WHERE LibraryTaskID = @TaskParentID" & vbCrLf
    s = s & "   AND ScheduleID = @ScheduleID)" & vbCrLf
    s = s & "   UPDATE dbo.ScheduleTasks" & vbCrLf
    s = s & "   SET ParentID = @NewID" & vbCrLf
    s = s & "   WHERE ScheduleTaskID = @ScheduleTaskID AND ScheduleID = @ScheduleID" & vbCrLf
    s = s & "END" & vbCrLf
    s = s & "   " & vbCrLf
    s = s & "   /* Set vendor for the task */" & vbCrLf
    s = s & "   UPDATE ScheduleTasks" & vbCrLf
    s = s & "   SET OriginalResource = dbo.Schedule_GetVendorID(@ScheduleID,@ScheduleTaskID)," & vbCrLf
    s = s & "   AssignedResource = dbo.Schedule_GetVendorID(@ScheduleID,@ScheduleTaskID)" & vbCrLf
    s = s & "   WHERE ScheduleTaskID = @ScheduleTaskID AND ScheduleID = @ScheduleID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "   /* Insert vendor into Reservations table */" & vbCrLf
    s = s & "  INSERT INTO Reservations(ScheduleTaskID,ResourceID) " & vbCrLf
    s = s & "  SELECT  @ScheduleTaskID, p.Vendor_ID" & vbCrLf
    s = s & "  FROM dbo.POIndexVendors p" & vbCrLf
    s = s & "  left outer join reservations r on r.ScheduleTaskID = @ScheduleTaskID and r.ResourceID = p.Vendor_ID" & vbCrLf
    s = s & "       WHERE p.ScheduleID = @ScheduleID AND p.ScheduleTaskID = @ScheduleTaskID" & vbCrLf
    s = s & "       AND p.Vendor_ID IS NOT NULL and r.ResourceID is null" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s

