    s = ""
    s = s & "ALTER PROCEDURE [dbo].[CustomerCalcTotals](@CustID Varchar(12)) AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "--Values for Calculation purposes" & vbCrLf
    s = s & "DECLARE @Exempt FLOAT" & vbCrLf
    s = s & "DECLARE @NotExempt FLOAT" & vbCrLf
    s = s & "DECLARE @Incentive FLOAT" & vbCrLf
    s = s & "DECLARE @ShowGST BIT" & vbCrLf
    s = s & "DECLARE @UsePST BIT" & vbCrLf
    s = s & "DECLARE @IncludeTax BIT" & vbCrLf
    s = s & "DECLARE @MultiFamily BIT" & vbCrLf
    s = s & "DECLARE @Pretaxtotal FLOAT" & vbCrLf
    s = s & "DECLARE @NetTaxTotal FLOAT" & vbCrLf
    s = s & "DECLARE @Option_Total FLOAT" & vbCrLf
    s = s & "DECLARE @OptionNetTaxTotal FLOAT" & vbCrLf
    s = s & "DECLARE @SysGSTRate FLOAT" & vbCrLf
    s = s & "DECLARE @SysPSTRate FLOAT" & vbCrLf
    s = s & "DECLARE @ParkingTax FLOAT" & vbCrLf
    s = s & "DECLARE @taxadjust_to_bldr BIT" & vbCrLf
    s = s & "DECLARE @UseTimberline  FLOAT" & vbCrLf
    s = s & "DECLARE @PST_Province VARCHAR(10)" & vbCrLf
    s = s & "DECLARE @Adjustment FLOAT" & vbCrLf
    s = s & "DECLARE @Adjust2 FLOAT" & vbCrLf
    s = s & "DECLARE @Back_Calc FLOAT" & vbCrLf
    s = s & "DECLARE @Back_Calc2 FLOAT" & vbCrLf
    s = s & "DECLARE @Deposits FLOAT" & vbCrLf
    s = s & "DECLARE @Mortgage_Advance FLOAT" & vbCrLf
    s = s & "DECLARE @Adjustment_Total FLOAT" & vbCrLf
    s = s & "DECLARE @total_value FLOAT" & vbCrLf
    s = s & "DECLARE @FValue1 FLOAT" & vbCrLf
    s = s & "DECLARE @FValue2 FLOAT" & vbCrLf
    s = s & "DECLARE @FValue3 FLOAT" & vbCrLf
    s = s & "DECLARE @FValue4 FLOAT" & vbCrLf
    s = s & "DECLARE @FValue5 FLOAT" & vbCrLf
    s = s & "DECLARE @PFValue1 FLOAT" & vbCrLf
    s = s & "DECLARE @PFValue2 FLOAT" & vbCrLf
    s = s & "DECLARE @PFValue3 FLOAT" & vbCrLf
    s = s & "DECLARE @PFValue4 FLOAT" & vbCrLf
    s = s & "DECLARE @PFValue5 FLOAT" & vbCrLf
    s = s & "DECLARE @PFValue6 FLOAT" & vbCrLf
    s = s & "DECLARE @UseSITax BIT" & vbCrLf
    s = s & "DECLARE @UseSDTax BIT" & vbCrLf
    s = s & "DECLARE @Sales_Initiative FLOAT" & vbCrLf
    s = s & "DECLARE @Sales_Deduction FLOAT" & vbCrLf
    s = s & "DECLARE @ELEVATIONNETTAX FLOAT" & vbCrLf
    s = s & "DECLARE @LOTNETTAX  FLOAT" & vbCrLf
    s = s & "DECLARE @SBNETTAX FLOAT" & vbCrLf
    s = s & "DECLARE @CONETTAX  FLOAT" & vbCrLf
    s = s & "DECLARE @DCNETTAX  FLOAT" & vbCrLf
    s = s & "DECLARE @DELNETTAX FLOAT" & vbCrLf
    s = s & "DECLARE @lotpremiumvalue FLOAT" & vbCrLf
    s = s & "DECLARE @LotPremiumPretax FLOAT" & vbCrLf
    s = s & "DECLARE @chkpst BIT" & vbCrLf
    s = s & "DECLARE @chkGST BIT" & vbCrLf
    s = s & "DECLARE @chkGSTRebate BIT" & vbCrLf
    s = s & "DECLARE @chkPSTRebate BIT" & vbCrLf
    s = s & "DECLARE @Contract_Assigned BIT" & vbCrLf
    s = s & "DECLARE @home_selection varchar(10)" & vbCrLf
    s = s & "DECLARE @SalesIncentiveTAX FLOAT" & vbCrLf
    s = s & "DECLARE @SalesDeductionTAX FLOAT" & vbCrLf
    s = s & "DECLARE @PSTRate FLOAT" & vbCrLf
    s = s & "DECLARE @PST_RATE FLOAT" & vbCrLf
    s = s & "DECLARE @GSTREBATEEXEMPT FLOAT" & vbCrLf
    s = s & "DECLARE @Sold BIT" & vbCrLf
    s = s & "DECLARE @ExemptWithGST BIT" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "-- Values to be written back to the Customer" & vbCrLf
    s = s & "DECLARE @TotalIncentives FLOAT" & vbCrLf
    s = s & "DECLARE @ContractIncentives FLOAT" & vbCrLf
    s = s & "DECLARE @ExemptIncentives FLOAT" & vbCrLf
    s = s & "DECLARE @Totalexempt FLOAT" & vbCrLf
    s = s & "DECLARE @gstonexempt FLOAT" & vbCrLf
    s = s & "DECLARE @pstonexempt FLOAT" & vbCrLf
    s = s & "DECLARE @Options FLOAT" & vbCrLf
    s = s & "DECLARE @GSTRate FLOAT" & vbCrLf
    s = s & "DECLARE @MODELNETTAX  FLOAT" & vbCrLf
    s = s & "DECLARE @RevenueAdjustment FLOAT" & vbCrLf
    s = s & "DECLARE @revenueadjust2 FLOAT" & vbCrLf
    s = s & "DECLARE @Total_Sales_price FLOAT" & vbCrLf
    s = s & "DECLARE @GST FLOAT" & vbCrLf
    s = s & "DECLARE @GST_Rebate FLOAT" & vbCrLf
    s = s & "DECLARE @PST FLOAT" & vbCrLf
    s = s & "DECLARE @PSTRebate  FLOAT" & vbCrLf
    s = s & "DECLARE @Cash_At_Close  FLOAT" & vbCrLf
    s = s & "DECLARE @tlupload BIT" & vbCrLf
    s = s & "DECLARE @CustomerTAX  FLOAT" & vbCrLf
    s = s & "DECLARE @NHWFees FLOAT" & vbCrLf
    s = s & "DECLARE @ExemptAmount FLOAT" & vbCrLf
    s = s & "DECLARE @DivisionID INT" & vbCrLf
    s = s & "--Add these fields into a fetch statement from tblcustomers" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "DECLARE CustomerValues CURSOR FOR" & vbCrLf
    s = s & "SELECT isnull(GST_Rate,0),isnull(PST_Rate,0),isnull(TotalIncentives,0),isnull(revenueadjust2,0),isnull(UseSITax,0),isnull(UseSDTax,0),isnull(Sales_Initiative,0),isnull(Sales_Deduction,0),isnull(MODELNETTAX,0) ,isnull(ELEVATIONNETTAX,0),isnull(LOTNETTAX,0) " & vbCrLf
    s = s & ",isnull(SBNETTAX,0),isnull(CONETTAX,0),isnull(DCNETTAX,0),isnull(DELNETTAX,0),isnull(lotpremiumvalue,0),isnull(LotPremiumPretax,0),isnull(ChkGSTRebate,0),isnull(RevenueAdjustment,0),isnull(chkpst,0),isnull(chkGST,0),isnull(chkGSTRebate,0),isnull(PSTRebate,0)" & vbCrLf
    s = s & ",isnull(GST_Rebate,0),isnull(GST,0),isnull(PST,0),chkPSTRebate,isnull(Cash_At_Close,0),Contract_Assigned,Deposits,Mortgage_Advance,Adjustment_Total ,home_selection,CustomerTAX,SalesIncentiveTAX" & vbCrLf
    s = s & ",isnull(SalesDeductionTAX,0),isnull(Sold,0),isnull(NHWFees,0),isnull(COPDEXEMPT,0) + isnull(COAPEXEMPT,0)- isnull(ExemptIncentives,0) from tblcustomers where customer_no=@CustID" & vbCrLf
    s = s & "OPEN CustomerValues " & vbCrLf
    s = s & "FETCH FROM CustomerValues INTO @GSTRate,@PSTRate,@TotalIncentives,@revenueadjust2,@UseSITax,@UseSDTax,@Sales_Initiative,@Sales_Deduction,@MODELNETTAX ,@ELEVATIONNETTAX,@LOTNETTAX ,@SBNETTAX,@CONETTAX ,@DCNETTAX ,@DELNETTAX,@lotpremiumvalue,@LotPremiumPretax,@ChkGSTRebate,@RevenueAdjustment,@chkpst,@chkGST,@chkGSTRebate,@PSTRebate,@GST_Rebate,@GST,@PST,@chkPSTRebate,@Cash_At_Close,@Contract_Assigned,@Deposits,@Mortgage_Advance,@Adjustment_Total ,@home_selection,@CustomerTAX,@SalesIncentiveTAX,@SalesDeductionTAX,@Sold,@NHWFees,@ExemptAmount " & vbCrLf
    s = s & "CLOSE CustomerValues " & vbCrLf
    s = s & "DEALLOCATE CustomerValues " & vbCrLf
    s = s & " " & vbCrLf
    s = s & " " & vbCrLf
    s = s & " " & vbCrLf
    s = s & "--Begin processing" & vbCrLf
    s = s & "DECLARE ExemptValues CURSOR FOR" & vbCrLf
    s = s & "SELECT isnull(sum(CASE WHEN isnull(ContractExempt,0) = 1 AND isnull( ApplyIncentive,0)=1 THEN isnull(Override_Price,0) else 0 end),0) as Exempt " & vbCrLf
    s = s & ",isnull(sum(case when isnull(ContractExempt,0)= 0 and isnull(ApplyIncentive,0) = 1 then isnull(Override_Price,0) else 0 end),0) as NotExempt" & vbCrLf
    s = s & ",isnull(sum(isnull(IncentiveValue,0)),0) as Incentive  " & vbCrLf
    s = s & "from calcapplyincentives where customer_no =@CustID" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "OPEN ExemptValues" & vbCrLf
    s = s & "FETCH FROM ExemptValues INTO @Exempt,@NotExempt,@Incentive" & vbCrLf
    s = s & "CLOSE ExemptValues" & vbCrLf
    s = s & "DEALLOCATE ExemptValues" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "SET @DivisionID = (select DivisionID from tblCustomers where Customer_no = @CustID )" & vbCrLf
    s = s & "--If there is a record returned from the above select statement then" & vbCrLf
    s = s & "SET @TotalIncentives = isnull((SELECT isnull(ModelIncentive,0) FROM tblCustomers WHERE Customer_No = @CustID),0)+isnull(@Incentive,0)" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "if (@TotalIncentives < @NotExempt) " & vbCrLf
    s = s & "   SET @ContractIncentives = @TotalIncentives " & vbCrLf
    s = s & "else " & vbCrLf
    s = s & "begin" & vbCrLf
    s = s & "   if (@NotExempt>0) --Check to see if the total of the options applied to incentives is a negative value" & vbCrLf
    s = s & "   set @ContractIncentives = @NotExempt" & vbCrLf
    s = s & "  else " & vbCrLf
    s = s & "    set @ContractIncentives = 0" & vbCrLf
    s = s & "end" & vbCrLf
    s = s & "if (@TotalIncentives < @Exempt) " & vbCrLf
    s = s & "   SET @ExemptIncentives = @TotalIncentives " & vbCrLf
    s = s & "else begin" & vbCrLf
    s = s & "   if (@Exempt>0)  --Check to see if the total of the contract exempt options applied to incentives is a negative value" & vbCrLf
    s = s & "      SET @ExemptIncentives= @Exempt" & vbCrLf
    s = s & "             else " & vbCrLf
    s = s & "      SET @ExemptIncentives= 0" & vbCrLf
    s = s & "end" & vbCrLf
    s = s & "SET @Totalexempt  = isnull((SELECT isnull(COAPEXEMPT,0) + isnull(COPDEXEMPT,0) from tblcustomers where customer_no = @CUSTID),0)" & vbCrLf
    s = s & "SET @TotalExempt = isnull(@TotalExempt,0)-@ExemptIncentives " & vbCrLf
    s = s & "--SET @ContractIncentives =Min(@TotalIncentives,@NotExempt)" & vbCrLf
    s = s & "--SET @ExemptIncentives = Min(@TotalIncentives,@Exempt)" & vbCrLf
    s = s & " " & vbCrLf
    s = s & " " & vbCrLf
    s = s & "DECLARE SystemSettings CURSOR FOR" & vbCrLf
    s = s & "SELECT isnull(show_cdn_gst,0),isnull(usepst,0),isnull(includetax,0),isnull(MultiFamily,0),isnull(GST_RATE,0),isnull(PST_Rate,0),isnull(taxadjust_to_bldr,0),isnull(PST_Province,''),isnull(Use_Timberline,0),isnull(ExemptWithGST,0)  FROM system_setup where ID = @DivisionID" & vbCrLf
    s = s & "OPEN SystemSettings" & vbCrLf
    s = s & "FETCH FROM SystemSettings INTO @ShowGST,@UsePST,@IncludeTax,@MultiFamily,@SysGSTRate,@SysPSTRate,@taxadjust_to_bldr,@PST_Province,@UseTimberline,@ExemptWithGST " & vbCrLf
    s = s & "CLOSE SystemSettings" & vbCrLf
    s = s & "DEALLOCATE SystemSettings" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "DECLARE GSTrateCalc CURSOR FOR" & vbCrLf
    s = s & "SELECT isnull(FVALUE1,0),isnull(FVALUE2,0),isnull(FVALUE3,0),isnull(FVALUE4,0),isnull(FVALUE5,0) from tblGSTPSTRebate where TAX_Type='GST' and TAX_Province='AB' and TaxRate= @GSTRate" & vbCrLf
    s = s & "OPEN GSTrateCalc" & vbCrLf
    s = s & "FETCH FROM GSTrateCalc INTO @FVALUE1,@FVALUE2,@FVALUE3,@FVALUE4,@FVALUE5 " & vbCrLf
    s = s & "CLOSE GSTrateCalc" & vbCrLf
    s = s & "DEALLOCATE GSTrateCalc" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "--DECLARE PSTrateCalc CURSOR FOR" & vbCrLf
    s = s & "--SELECT isnull(FVALUE1,0),isnull(FVALUE2,0),isnull(FVALUE3,0),isnull(FVALUE4,0),isnull(FVALUE5,0),isnull(FVALUE6,0) from tblGSTPSTRebate where TAX_Type='PST' and TAX_Province='PQ' and TaxRate= @GSTRate" & vbCrLf
    s = s & "--OPEN PSTrateCalc" & vbCrLf
    s = s & "--FETCH FROM PSTrateCalc INTO @PFVALUE1,@PFVALUE2,@PFVALUE3,@PFVALUE4,@PFVALUE5,@PFVALUE6" & vbCrLf
    s = s & "--CLOSE PSTrateCalc" & vbCrLf
    s = s & "--DEALLOCATE PSTrateCalc" & vbCrLf
    s = s & "set @GSTRebateExempt = isnull((SELECT Sum(ISNULL(override_price,0)) as TotalGSTRebateExempt from ChangeOrderDetails where Customer_No=@CUSTID and gstrebate_exempt =1),0)" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "If @ShowGST = 1" & vbCrLf
    s = s & "     SET  @gstonexempt = Round(@totalexempt * @GSTRate / 100, 2)" & vbCrLf
    s = s & "        If @UsePST = 1" & vbCrLf
    s = s & "        SET @pstonexempt = Round(@totalexempt * @pstrate / 100,2)" & vbCrLf
    s = s & " " & vbCrLf
    s = s & " " & vbCrLf
    s = s & "SET @Options =isnull((Select isnull(ScheduleB_Total,0) + isnull(CO_PD_Total,0) + isnull(CO_AP_Total,0) +isnull(DS_PD_Total,0)+isnull(DS_AP_Total,0)+isnull(Deletion_Total,0) + isnull(Deletion_Total_PD,0) from tblcustomers where customer_no = @CustID),0) - @ContractIncentives" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "SET @total_value =@Total_Sales_Price" & vbCrLf
    s = s & "SET @Pretaxtotal = isnull((SELECT isnull(Override_Price,0)+ isnull(Lot_Price,0)+ isnull(ScheduleB_Total,0)+ isnull(Elevation_Price,0)- isnull(Sales_Initiative,0) -isnull( Sales_Deduction,0)+ isnull(LotPremiumPretax,0)+isnull(NHWFees,0) from tblcustomers where customer_no = @CustID),0)" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "SET @Option_Total = isnull((SELECT isnull(CO_PD_Total,0) + isnull(CO_AP_Total,0) +isnull(DS_PD_Total,0)+isnull(DS_AP_Total,0)+isnull(Deletion_Total,0) + isnull(Deletion_Total_PD,0) from tblcustomers where customer_no = @CustID),0)- @ContractIncentives" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "SET @Total_Sales_price= isnull(@Pretaxtotal,0) + isnull(@Option_Total,0)" & vbCrLf
    s = s & " " & vbCrLf
    s = s & " If (@ShowGST = 1) " & vbCrLf
    s = s & "        If (@GSTRate = 0 )" & vbCrLf
    s = s & "            SET @GSTRate = @SysGSTRate" & vbCrLf
    s = s & "        If (@MultiFamily =1 )" & vbCrLf
    s = s & "         SET  @Pretaxtotal =isnull(@Pretaxtotal,0)  + isnull((SELECT isnull(Parking1_Price,0)+isnull(Parking2_Price,0)+isnull(Parking3_Price,0) +isnull(Parking4_Price,0) +isnull(Parking5_Price,0) +isnull(Parking6_Price,0) +isnull(Parking7_Price,0) FROM tblcustomers where customer_no = @CUSTID),0)" & vbCrLf
    s = s & "                 If (@includetax = 1) " & vbCrLf
    s = s & "                SET @ParkingTax = round(isnull((SELECT isnull(Parking1_Price,0) +isnull(Parking2_Price,0) + isnull(Parking3_Price,0) + isnull(Parking4_Price,0) + isnull(Parking5_Price,0) +isnull(Parking6_Price,0) +isnull(Parking7_Price,0) from tblcustomers where customer_no =@CUSTID),0)* isnull(@GSTRate,0) / 100, 2)" & vbCrLf
    s = s & " " & vbCrLf
    s = s & "        If (@includetax = 1)  BEGIN" & vbCrLf
    s = s & "               SET  @NetTaxTotal = @NetTaxTotal +Round(@NHWFees * @GSTRate / (100 + @GSTRate), 2)" & vbCrLf
    s = s & "               IF (@UseSITax = 1)  BEGIN" & vbCrLf
    s = s & "                  SET  @NetTaxTotal = @NetTaxTotal - Round(@Sales_Initiative * @GSTRate / (100 + @GSTRate), 2)" & vbCrLf
    s = s & "                         SET  @Pretaxtotal = @Pretaxtotal - @NetTaxTotal            " & vbCrLf
    s = s & "                END  Else  BEGIN" & vbCrLf
    s = s & "                 SET @NetTaxTotal = @NetTaxTotal - Round(@Sales_Initiative * @GSTRate / 100, 2)" & vbCrLf
    s = s & "                END" & vbCrLf
    s = s & "                IF (@UseSDTax= 1)  BEGIN" & vbCrLf
    s = s & "                     IF (@includetax = 1 ) BEGIN" & vbCrLf
    s = s & "                                 SET @NetTaxTotal = @NetTaxTotal - Round(@Sales_Deduction * @GSTRate / (100 + @GSTRate), 2)" & vbCrLf
    s = s & "                                 SET @Pretaxtotal = @Pretaxtotal + Round(@Sales_Deduction * @GSTRate / (100 + @GSTRate), 2) " & vbCrLf
    s = s & "                         END" & vbCrLf
    s = s & "             END Else BEGIN" & vbCrLf
    s = s & "                     IF (@IncludeTax = 1 )  BEGIN" & vbCrLf
    s = s & "                          SET @NetTaxTotal =@NetTaxTotal - Round(@Sales_Deduction * @GSTRate / 100, 2)    " & vbCrLf
    s = s & "                    END" & vbCrLf
    s = s & "               END              " & vbCrLf
    s = s & "                      SET @NetTaxTotal = isnull(@NetTaxTotal,0) + isnull(@ParkingTax,0) + isnull(@MODELNETTAX,0) + isnull(@ELEVATIONNETTAX,0)+ isnull(@LOTNETTAX,0) + isnull(@SBNETTAX,0)+ Round(isnull(@lotpremiumvalue,0)-isnull(@LotPremiumPretax,0), 2)" & vbCrLf
    s = s & "                If (@taxadjust_to_bldr = 1)  BEGIN" & vbCrLf
    s = s & "                        SET @NetTaxTotal =isnull(@NetTaxTotal,0) - Round(isnull(@ContractIncentives,0)* (@GSTRate / 100), 2)" & vbCrLf
    s = s & "              END" & vbCrLf
    s = s & "--Added the next 3 lines for Tribute as they consider Contract Exempt to still be part of the sale which also affects the GST and Rebate calculations." & vbCrLf
    s = s & "                 IF @ExemptWithGST = 1 BEGIN " & vbCrLf
    s = s & "                    SET @Pretaxtotal = isnull(@Pretaxtotal,0) +isnull(@ExemptAmount,0)" & vbCrLf
    s = s & "              END" & vbCrLf
    s = s & "                If (@PST_Province = 'AU' )  BEGIN" & vbCrLf
    s = s & "                    SET  @Back_Calc = @Pretaxtotal" & vbCrLf
    s = s & "              END Else BEGIN" & vbCrLf
    s = s & "                If (@ChkGSTRebate = 1) BEGIN" & vbCrLf
    s = s & "                        SET @MODELNETTAX = Round(@Pretaxtotal* @GSTRate / 100, 2)" & vbCrLf
