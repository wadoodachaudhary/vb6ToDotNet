    s = s & "   left outer join taxGroups t on (t.TaxGroup=dbo.Purch_GetDefaultTaxGroup('' , sd.Community ,'' , sd.Model , sd.Assembly ,i.phase ,i.item , v.Vendor_ID , i.JCCategory )) " & vbCrLf
    s = s & "   where sd.Worksheet = @SalesSheet and" & vbCrLf
    s = s & "   sd.Community=@Community and sd.CommunityPhase = @CommunityPhase and sd.Model = @Model and sd.Assembly = @Assembly and sd.Optionid = @OptionID   " & vbCrLf
    s = s & "   group by sd.Community,sd.CommunityPhase,sd.Assembly,sd.Model,sd.Series,sd.OptionID,sd.Description,sd.AssemblyType" & vbCrLf
    s = s & "   open ListofAssemblies " & vbCrLf
