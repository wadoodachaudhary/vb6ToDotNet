    s = s & "    -- End Inventory  " & vbCrLf
    s = s & "    --   -- Update Inventory Homes status when used in SC & Release Inventory Homes on Cancelled SC  " & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    DECLARE SalesContract_Cursor CURSOR" & vbCrLf
