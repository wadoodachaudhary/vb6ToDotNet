    s = s & "    insert MsgQ_CutOffDates(SysName,MsgType,DivisionID,DataSourceID,CutOffDate)" & vbCrLf
    s = s & "    select q.SysName,q.MsgType,isnull(q.DivisionID,0),q.DataSourceID,'2025-06-01'" & vbCrLf
    s = s & "    from MsgQ q" & vbCrLf
