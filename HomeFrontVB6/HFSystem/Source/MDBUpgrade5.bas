    s = s & "    select @xml = replace(cast(@xml as nvarchar(max)),'Preference_3>','Preference>')" & vbCrLf
    s = s & "    select @xml = replace(cast(@xml as nvarchar(max)),'Preference_2>','Preference>')" & vbCrLf
