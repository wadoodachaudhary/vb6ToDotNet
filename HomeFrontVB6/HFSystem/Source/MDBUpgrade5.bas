    s = s & "  from pomaster i" & vbCrLf
    s = s & "  join Invoices e ON(i.DivisionID=e.DivisionID and i.PONumber=e.Invoice and i.Vendor=e.Vendor and e.Source='autoinserting..')" & vbCrLf
    s = s & "  where i.divisionid=@DivisionID " & vbCrLf
    s = s & "  and i.ponumber=@PONumber" & vbCrLf
