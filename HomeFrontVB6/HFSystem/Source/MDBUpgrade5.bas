    s = s & "         ,ActEd          datetime    'ActualEndDate'" & vbCrLf
    s = s & "         ,BaseSt         datetime    'BaselineStartDate'" & vbCrLf
    s = s & "         ,BaseEd         datetime    'BaselineEndDate'" & vbCrLf
    s = s & "         ,AltSt          datetime    'AdjustedStartDate'" & vbCrLf
    s = s & "         ,AltEd          datetime    'AdjustedEndDate'" & vbCrLf
    s = s & "         ) x" & vbCrLf
    s = s & "    JOIN CustomerBillingItems c on c.DivisionID=@DivisionID and c.job_no=x.job and c.milestone=x.milestonecode" & vbCrLf
