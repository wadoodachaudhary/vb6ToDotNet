    s = s & "    , CASE WHEN @LockOptionsImmediately = 1 THEN isnull(src.EstimateIndex, isnull(srcc.EstimateIndex, 0)) ELSE ia.EstimateIndex END" & vbCrLf
    s = s & "    , ia.Other, ia.CRMType, ia.CRMID , CAST(nullif(ia.CRMSourceID,'') as uniqueidentifier), isnull(ia.IsRequireQuote, 0)" & vbCrLf
