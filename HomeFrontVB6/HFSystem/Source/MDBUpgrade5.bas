    s = s & " -- save xml results to the response column. put errors in the status field." & vbCrLf
    s = s & " -- use syntax like this to update the audit log if there is anything useful to be said." & vbCrLf
    s = s & " --   update MsgQ set Audit=isnull(Audit,'') + 'your log entry here' + char(13) + char(10) where ID=@ID" & vbCrLf
    s = s & "begin try" & vbCrLf
    s = s & "    declare @DivisionID int " & vbCrLf
    s = s & "    declare @MsgQSession uniqueidentifier" & vbCrLf
    s = s & "    select @DivisionID=divisionid, @MsgQSession=SessionID from MsgQ where id=@ID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --flag payments you are going to send" & vbCrLf
    s = s & "    update AccountingAPPayments " & vbCrLf
    s = s & "    set msgqsession=@MsgQSession" & vbCrLf
    s = s & "    where divisionid=@DivisionID" & vbCrLf
    s = s & "    and datesenttobuildpro is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    declare @xml xml =(" & vbCrLf
    s = s & "    select " & vbCrLf
    s = s & "      c.ActionCode   [ActionCode]" & vbCrLf
    s = s & "     ,c.ChequeDate   [IssueDate]" & vbCrLf
    s = s & "     ,c.ChequeNumber [RemittanceHeader/Remittance/Number]" & vbCrLf
    s = s & "     ,c.ChequeAmount [RemittanceHeader/Remittance/Amount]" & vbCrLf
    s = s & "     ,c.ChequeDate   [RemittanceHeader/Remittance/Date]" & vbCrLf
    s = s & "     ,c.ChequeType   [RemittanceHeader/Remittance/Type]" & vbCrLf
    s = s & "     ,c.ChequeDate   [RemittanceHeader/BatchDate]" & vbCrLf
    s = s & "     ,''             [RemittanceHeader/VoucherNumber]" & vbCrLf
    s = s & "     ,''             [RemittanceHeader/VoucherDate]" & vbCrLf
    s = s & "     ,c.Vendor       [RemittanceHeader/Vendor/AddressBookEntry/AddressBookNumber]" & vbCrLf
    s = s & "     ,(select" & vbCrLf
    s = s & "        isnull(nullif(d.BuildProJob,''),d.Job) [LotJob]" & vbCrLf
    s = s & "       ,d.PONumber [PurchaseOrder/Document/DocNumber]" & vbCrLf
    s = s & "       ,d.InvoiceNumber [Invoice/Number]" & vbCrLf
    s = s & "       ,'' [Invoice/AmountBilled]" & vbCrLf
    s = s & "       ,d.AmountPaid [Invoice/AmountPaid]" & vbCrLf
    s = s & "       ,d.InvoiceDate [Invoice/Date]" & vbCrLf
    s = s & "       ,'' [Reference]" & vbCrLf
    s = s & "       ,'' [CostType]" & vbCrLf
    s = s & "       ,d.POIndex [CostCode]" & vbCrLf
    s = s & "       ,'' [PayItem]" & vbCrLf
    s = s & "       ,d.status [Status]" & vbCrLf
    s = s & "       ,d.sequence [Sequence]" & vbCrLf
    s = s & "       from BuildPro_APPayments d" & vbCrLf
    s = s & "       where d.divisionid=c.divisionid and d.chequenumber=c.chequenumber" & vbCrLf
    s = s & "       order by d.ChequeNumber" & vbCrLf
    s = s & "       for xml path('RemittanceItem'), Type" & vbCrLf
    s = s & "      ) RemittanceDetail" & vbCrLf
    s = s & "     ,c.TotalAmountPaid [Trailer/Summary/Count]" & vbCrLf
    s = s & "     ,c.TotalItemCount [Trailer/Summary/Amount]" & vbCrLf
    s = s & "    from BuildPro_APPayments_Totals c" & vbCrLf
    s = s & "    where c.msgqsession=@MsgQSession" & vbCrLf
    s = s & "    for xml path('RemittanceAdvice'), root('JDEOW_RemittanceAdvice')" & vbCrLf
    s = s & "    )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --save results to request, set status complete when nothing to send" & vbCrLf
    s = s & "    update MsgQ set request=cast(@xml as nvarchar(max)),status=case when @xml is null then 'Completed' else status end where ID=@ID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --flag payments as sent" & vbCrLf
    s = s & "    update AccountingAPPayments " & vbCrLf
    s = s & "    set datesenttobuildpro=getdate()" & vbCrLf
    s = s & "    where msgqsession=@MsgQSession" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --expose request for debugging " & vbCrLf
    s = s & "    --select @xml Request" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "end try" & vbCrLf
    s = s & "begin catch" & vbCrLf
    s = s & "    update MsgQ set Status='(Error Source: MsgQ) '+ERROR_MESSAGE() where ID=@ID" & vbCrLf
    s = s & "end catch" & vbCrLf
    sql c, s
    
    s = ""
    s = s & "alter proc dbo.MsgQ_BuildPro_ReadErrors(@ID integer) as" & vbCrLf
    s = s & "begin" & vbCrLf
    s = s & "    -- parse error from result xml" & vbCrLf
    s = s & "    -- update msgq status" & vbCrLf
    s = s & "    -- return 1 on errors, 0 on success" & vbCrLf
    s = s & "    declare @xml xml" & vbCrLf
    s = s & "    declare @doc int" & vbCrLf
    s = s & "    declare @Result   varchar(50)" & vbCrLf
    s = s & "    declare @Status   varchar(2100) " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    select @xml=response from MsgQ where id=@ID" & vbCrLf
    s = s & "    exec sp_xml_preparedocument @doc OUTPUT, @xml" & vbCrLf
    s = s & "    select @Result=Result ,@Status=isnull(ErrDesc,'') " & vbCrLf
    s = s & "    from OPENXML (@doc, '/PostMessageResult')" & vbCrLf
    s = s & "    with (" & vbCrLf
    s = s & "     Result   varchar(50)  'Result'" & vbCrLf
    s = s & "    --,ErrID    varchar(500) 'Errors/Error/ErrorID'" & vbCrLf
    s = s & "    ,ErrDesc  varchar(2100) 'Errors/Error/ErrorDescription'" & vbCrLf
    s = s & "    --,ErrSrc   varchar(500) 'Errors/Error/ErrorSource'" & vbCrLf
    s = s & "    ) x          " & vbCrLf
    s = s & "    where x.ErrDesc not like '%no changes to editable fields for a SupplyPro supplier%'" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    if @Result='false' begin" & vbCrLf
    s = s & "        update MsgQ set Status= '(Error Source: BuildPro) '+@Status from MsgQ where ID=@ID" & vbCrLf
    s = s & "        return 1" & vbCrLf
    s = s & "    end else begin" & vbCrLf
    s = s & "        return 0" & vbCrLf
    s = s & "    end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "end" & vbCrLf
    sql c, s
    
    s = ""
    s = s & "alter view [dbo].[BuildPro_APPayments] as" & vbCrLf
    s = s & "-----------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "--  AccountingAPPayments.PONumber will be populated with '', 'Multiple POs', or an actual PO number." & vbCrLf
    s = s & "--  But PO is needed to get customer.unit which is required for BuildPro job number." & vbCrLf
    s = s & "--    If payment has an actual PO number use it." & vbCrLf
    s = s & "--    If not then look for a backcharge EPO." & vbCrLf
    s = s & "--    If all else fails then assume invoice number=po number, if the UseQuickbooksAssumedRemittance option is on." & vbCrLf
    s = s & "-----------------------------------------------------------------------------------------------------------" & vbCrLf
    s = s & "select " & vbCrLf
    s = s & " p.divisionid" & vbCrLf
    s = s & ",1 ActionCode" & vbCrLf
    s = s & ",ROW_NUMBER() OVER(PARTITION BY isnull(nullif(p.ChequeNumber,''),'EFT') order by isnull(nullif(p.Invoice,''),p.chequenumber)) Sequence" & vbCrLf
    s = s & ",p.MsgQSession" & vbCrLf
    s = s & ",convert(varchar,p.ChequeDate,101)  IssueDate" & vbCrLf
    s = s & ",isnull(nullif(p.ChequeNumber,''),'EFT') ChequeNumber" & vbCrLf
    s = s & ",convert(int,p.ChequeAmount *100) ChequeAmount" & vbCrLf
    s = s & ",convert(varchar,p.ChequeDate,101) ChequeDate" & vbCrLf
    s = s & ",'PK' ChequeType" & vbCrLf
    s = s & ",convert(varchar,i.AccountingDate,101) BatchDate" & vbCrLf
    s = s & ",dbo.BuildProSOAP_BPVendor(p.divisionid,v.vendor_id) Vendor" & vbCrLf
    s = s & ",dbo.BuildProSOAP_BPJob(p.DivisionID, isnull(isnull(x.job,y.job),z.job), c.unit_no, '') Job" & vbCrLf
    s = s & ",isnull(nullif(isnull(isnull(x.PONumber,y.PONumber),z.PONumber),''),'N/A') PONumber" & vbCrLf
    s = s & ",isnull(nullif(p.Invoice,''),p.chequenumber) InvoiceNumber" & vbCrLf
    s = s & ",convert(varchar,isnull(i.InvoiceDate,p.ChequeDate),101) InvoiceDate" & vbCrLf
    s = s & ",convert(int,round(SUM(p.InvoiceAmountPaid*100),2)) AmountPaid --ADDED ROUND AND CONVERT TO ENSURE THAT AMOUNT PAID IS AN INTEGER" & vbCrLf
    s = s & ",isnull(isnull(x.POIndex,y.POIndex),z.POIndex) POIndex" & vbCrLf
    s = s & ",case when isnull(p.voided,0)=1 then 'V' else 'P' end Status" & vbCrLf
    s = s & ",p.DateSentToBuildPro" & vbCrLf
    s = s & ",isnull(isnull(x.BuildProJob,y.BuildProJob),z.BuildProJob) BuildProJob" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "from AccountingAPPayments p" & vbCrLf
    s = s & "join tblVendors v on p.DivisionID=v.DivisionID and p.vendor=v.vendor_id and v.BuildProEnabled=1" & vbCrLf
    s = s & "left join invoices i on p.DivisionID=i.DivisionID and p.invoice=i.invoice and p.vendor=i.vendor" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- po from payment record in accounting" & vbCrLf
    s = s & "left join POMaster x on x.ponumber= p.ponumber" & vbCrLf
    s = s & "-- po from backcharge invoice" & vbCrLf
    s = s & "left join POMaster y on y.ponumber=i.BackChargeRefEPO" & vbCrLf
    s = s & "-- po from assumed invoice number" & vbCrLf
    s = s & "left join POMaster z on z.ponumber= p.invoice" & vbCrLf
    s = s & "-- get customer to build the job number with the unit number" & vbCrLf
    s = s & "left join tblcustomers c on c.customer_no=dbo.GetPOCustomer(p.DivisionID,isnull(isnull(x.PONumber,y.PONumber),z.PONumber))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- limit results to rolling 90 days" & vbCrLf
    s = s & "where p.ChequeDate > getdate()-90" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "group by" & vbCrLf
    s = s & " p.divisionid" & vbCrLf
    s = s & ",p.MsgQSession" & vbCrLf
    s = s & ",convert(varchar,p.ChequeDate,101)  " & vbCrLf
    s = s & ",isnull(nullif(p.ChequeNumber,''),'EFT') " & vbCrLf
    s = s & ",convert(int,p.ChequeAmount *100 )" & vbCrLf
    s = s & ",convert(varchar,p.ChequeDate,101) " & vbCrLf
    s = s & ",convert(varchar,i.AccountingDate,101) " & vbCrLf
    s = s & ",v.Vendor_id " & vbCrLf
    s = s & ",dbo.BuildProSOAP_BPJob(p.DivisionID, isnull(isnull(x.job,y.job),z.job), c.unit_no,'') " & vbCrLf
    s = s & ",isnull(nullif(isnull(isnull(x.PONumber,y.PONumber),z.PONumber),''),'N/A') " & vbCrLf
    s = s & ",isnull(nullif(p.Invoice,''),p.chequenumber) " & vbCrLf
    s = s & ",convert(varchar,isnull(i.InvoiceDate,p.ChequeDate),101) " & vbCrLf
    s = s & ",isnull(isnull(x.POIndex,y.POIndex),z.POIndex) " & vbCrLf
    s = s & ",case when isnull(p.voided,0)=1 then 'V' else 'P' end " & vbCrLf
    s = s & ",p.DateSentToBuildPro" & vbCrLf
    s = s & ",isnull(isnull(x.BuildProJob,y.BuildProJob),z.BuildProJob)" & vbCrLf
    sql c, s
    
