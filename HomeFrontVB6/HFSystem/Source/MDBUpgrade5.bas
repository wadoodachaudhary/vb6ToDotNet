    s = s & "        join BuildPro_POs_Items poi on( pi.itemseq=poi.itemseq)" & vbCrLf
    s = s & "        join tblpoindex x on( p.divisionid=x.divisionid and p.poindex=x.poindex and (x.BuildProEnabled=1 or p.epodocnumber<>'') )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        join tbljobs j on( p.divisionid=j.divisionid " & vbCrLf
    s = s & "                      and  p.job=j.job_no " & vbCrLf
    s = s & "                      and ( (isnull(x.PreConPO,0)=0 and j.start_date is not null and isnull(j.scheduletemplate,'')<>'') " & vbCrLf
    s = s & "                         or (isnull(x.PreConPO,0)=1 and j.preconstartdate is not null and isnull(j.preconscheduletemplate,'')<>'') " & vbCrLf
    s = s & "                         or p.epodocnumber<>'') )" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        join tblVendors v on( p.divisionid=v.divisionid and p.vendor=v.vendor_id and v.buildproenabled=1)" & vbCrLf
    s = s & "        left join estimateitems i on( pi.estitemid=i.estitemid)" & vbCrLf
    s = s & "        left join estimateitems co on( co.changeorderorigestitemid=i.estitemid)" & vbCrLf
    s = s & "        left join estimateassemblies a on( i.estassemblyid=a.estassemblyid)" & vbCrLf
    s = s & "        join divisioncommunities r on( r.divisionid=j.divisionid and r.community=j.community and (r.buildproenabled=1 or p.epodocnumber<>'' ))" & vbCrLf
