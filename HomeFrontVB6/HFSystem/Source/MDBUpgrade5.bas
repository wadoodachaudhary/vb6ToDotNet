    s = s & "    FROM OPENXML (@doc,'/HF/InventoryHomesAddendum',2)" & vbCrLf
    s = s & "    WITH (CustomerNo varchar(12),[Option] varchar(20),OptionType smallint,IsCustom bit,QTY float,UOM varchar(50),BasePrice float,Rate float" & vbCrLf
    s = s & "        ,Tax float,CostRate float,PreTaxTotal float,TaxInTotal float,GrandTotal float,Description varchar(2000),Comments varchar(4000)" & vbCrLf
    s = s & "        ,CategoryName varchar(50),SubCategoryName varchar(50),Assembly varchar(20),Color varchar(500),Style varchar(500),Finish varchar(500)" & vbCrLf
    s = s & "        ,SalesWorksheet int,IsApplyIncentive bit,IncentiveValue float,Location varchar(50),EstimateIndex int,Other varchar(500),OverridePrice float" & vbCrLf
    s = s & "        ,CRMID uniqueidentifier,CRMSourceID varchar(36),SalesPerson varchar(50),CRMType int,ClientSeq int,ModifiedDate datetime,IsOPTDeleted bit,IsRequireQuote bit" & vbCrLf
    s = s & "        )ia" & vbCrLf
    s = s & "    LEFT JOIN tblScheduleB sb ON ia.CRMID = sb.CRMID AND ia.CRMType = sb.CRMType" & vbCrLf
    s = s & "    LEFT JOIN tblScheduleB src ON CAST(nullif(ia.CRMSourceID,'') as uniqueidentifier) = src.CRMID --if inventory addendum item originated on a cancelled purchasers addendum then use its estimateindex. ie: dont re-takeoff" & vbCrLf
    s = s & "    LEFT JOIN ChangeOrderDetails srcc ON CAST(nullif(ia.CRMSourceID,'') as uniqueidentifier) = srcc.crmid" & vbCrLf
    s = s & "    WHERE sb.Customer_No IS NULL" & vbCrLf
    s = s & "    AND NULLIF(ia.ClientSeq, 0) IS NULL" & vbCrLf
    s = s & "    AND ia.IsOptDeleted = 0" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    DECLARE @CustomerNo varchar(12)" & vbCrLf
    s = s & "    DECLARE Customer_Cursor CURSOR FOR" & vbCrLf
    s = s & "    SELECT DISTINCT CustomerNo" & vbCrLf
    s = s & "    FROM OPENXML (@doc,'/HF/InventoryHomesAddendum',2)" & vbCrLf
    s = s & "    WITH (CustomerNo varchar(12)) xml" & vbCrLf
    s = s & "    OPEN Customer_Cursor" & vbCrLf
    s = s & "    FETCH NEXT FROM Customer_Cursor INTO @CustomerNo" & vbCrLf
    s = s & "    WHILE @@FETCH_STATUS = 0" & vbCrLf
    s = s & "    BEGIN" & vbCrLf
    s = s & "        -- Use a try/catch to always close and deallocate the cursor  " & vbCrLf
    s = s & "        BEGIN TRY" & vbCrLf
    s = s & "            EXEC CalcAddendumTotals @CustomerNo" & vbCrLf
    s = s & "            --EXEC CalcCOMasterTotals @CustomerNo" & vbCrLf
    s = s & "            EXEC CustomerCalcTotals @CustomerNo" & vbCrLf
    s = s & "        END TRY" & vbCrLf
    s = s & "        BEGIN CATCH" & vbCrLf
    s = s & "            -- Empty catch  " & vbCrLf
    s = s & "        END CATCH" & vbCrLf
    s = s & "        FETCH NEXT FROM Customer_Cursor INTO @CustomerNo" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "    CLOSE Customer_Cursor" & vbCrLf
    s = s & "    DEALLOCATE Customer_Cursor" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "alter table tblcustomers enable trigger tiu_tblcustomers " & vbCrLf
    s = s & "alter table tbljobs enable trigger u_tbljobs" & vbCrLf
    sql c, s
    
    
    Call Revisions_2025_4_k
    
End Sub

