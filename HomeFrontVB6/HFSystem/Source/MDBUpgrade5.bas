    s = ""
    s = s & "CREATE FUNCTION dbo.RoundQty" & vbCrLf
    s = s & "(" & vbCrLf
    s = s & "    @Number FLOAT," & vbCrLf
    s = s & "    @Significance FLOAT," & vbCrLf
    s = s & "    @Direction INT = 1   -- 0=None, 1=UpTo, 2=DownTo, 3=Closest" & vbCrLf
    s = s & ")" & vbCrLf
    s = s & "RETURNS FLOAT" & vbCrLf
    s = s & "AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "    DECLARE @Result FLOAT" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    IF @Significance = 0 OR @Number = @Significance" & vbCrLf
    s = s & "        RETURN @Number" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- already a multiple" & vbCrLf
    s = s & "    IF @Number / @Significance = FLOOR(@Number / @Significance)" & vbCrLf
    s = s & "        RETURN @Number" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    IF @Direction = 0   -- rdNone" & vbCrLf
    s = s & "        SET @Result = @Number" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ELSE IF @Direction = 2  -- rdDownTo" & vbCrLf
    s = s & "        SET @Result = FLOOR(@Number / @Significance) * @Significance" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ELSE IF @Direction = 1  -- rdUpTo" & vbCrLf
    s = s & "        SET @Result = CEILING(@Number / @Significance) * @Significance" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ELSE IF @Direction = 3  -- rdClosest" & vbCrLf
    s = s & "        SET @Result = ROUND(@Number / @Significance, 0) * @Significance" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    RETURN @Result" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s, True
    
