    s = s & "    " & vbCrLf
    s = s & "    --- Update customer billing items " & vbCrLf
    s = s & "    UPDATE c SET PercentComplete=100" & vbCrLf
    s = s & "    FROM OPENXML (@doc, 'BP/Envelope/Body/JDEOW_MilestoneUpdate/Milestone',2) " & vbCrLf
    s = s & "    WITH (Job            varchar(40) 'LotJob'" & vbCrLf
