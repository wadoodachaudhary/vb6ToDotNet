    s = s & "                    WHERE isnull(c.sold_to_customer, '') <> ''" & vbCrLf
    s = s & "                        AND c.Customer_No = @ClientInventoryHomeID" & vbCrLf
    s = s & "                        AND isnull(b.comments, '') <> ''" & vbCrLf
    s = s & "                        AND isnull(a.HFComments, '') <> isnull(b.comments, '')" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "                    --SET @sqlStatement = 'Update Color etc for spec home assemblies'" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "                    UPDATE a" & vbCrLf
    s = s & "                    SET Color = b.Color" & vbCrLf
    s = s & "                    FROM EstimateAssemblies a" & vbCrLf
    s = s & "                    INNER JOIN tblcustomers c ON c.customer_no = a.customer_no" & vbCrLf
    s = s & "                    INNER JOIN tblScheduleB b ON b.Customer_No = c.sold_to_Customer" & vbCrLf
    s = s & "                        AND a.OptionID = b.opt" & vbCrLf
    s = s & "                        AND a.HFDescription = b.Description" & vbCrLf
    s = s & "                    WHERE isnull(c.sold_to_customer, '') <> ''" & vbCrLf
    s = s & "                        AND c.Customer_No = @ClientInventoryHomeID" & vbCrLf
    s = s & "                        AND isnull(b.Color, '') <> ''" & vbCrLf
    s = s & "                        AND isnull(a.Color, '') <> isnull(b.Color, '')" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "                    --SET @sqlStatement = 'Update Other for spec home assemblies'" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "                    UPDATE a" & vbCrLf
    s = s & "                    SET Other = b.other" & vbCrLf
    s = s & "                    FROM EstimateAssemblies a" & vbCrLf
    s = s & "                    INNER JOIN tblcustomers c ON c.customer_no = a.customer_no" & vbCrLf
    s = s & "                    INNER JOIN tblScheduleB b ON b.Customer_No = c.sold_to_Customer" & vbCrLf
    s = s & "                        AND a.OptionID = b.opt" & vbCrLf
    s = s & "                        AND a.HFDescription = b.Description" & vbCrLf
    s = s & "                    WHERE isnull(c.sold_to_customer, '') <> ''" & vbCrLf
    s = s & "                        AND c.Customer_No = @ClientInventoryHomeID" & vbCrLf
    s = s & "                        AND isnull(b.Other, '') <> ''" & vbCrLf
    s = s & "                        AND isnull(a.Other, '') <> isnull(b.Other, '')" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "                    --SET @sqlStatement = 'Update Style for spec home assemblies'" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "                    UPDATE a" & vbCrLf
    s = s & "                    SET Style = b.Style" & vbCrLf
    s = s & "                    FROM EstimateAssemblies a" & vbCrLf
    s = s & "                    INNER JOIN tblcustomers c ON c.customer_no = a.customer_no" & vbCrLf
    s = s & "                    INNER JOIN tblScheduleB b ON b.Customer_No = c.sold_to_Customer" & vbCrLf
    s = s & "                        AND a.OptionID = b.opt" & vbCrLf
    s = s & "                        AND a.HFDescription = b.Description" & vbCrLf
    s = s & "                    WHERE isnull(c.sold_to_customer, '') <> ''" & vbCrLf
    s = s & "                        AND c.Customer_No = @ClientInventoryHomeID" & vbCrLf
    s = s & "                        AND isnull(b.Style, '') <> ''" & vbCrLf
    s = s & "                        AND isnull(a.Style, '') <> isnull(b.Style, '')" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "                    --SET @sqlStatement = 'Update Finish for spec home assemblies'" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "                    UPDATE a" & vbCrLf
    s = s & "                    SET Finish = b.Finish" & vbCrLf
    s = s & "                    FROM EstimateAssemblies a" & vbCrLf
    s = s & "                    INNER JOIN tblcustomers c ON c.customer_no = a.customer_no" & vbCrLf
    s = s & "                    INNER JOIN tblScheduleB b ON b.Customer_No = c.sold_to_Customer" & vbCrLf
    s = s & "                        AND a.OptionID = b.opt" & vbCrLf
    s = s & "                        AND a.HFDescription = b.Description" & vbCrLf
    s = s & "                    WHERE isnull(c.sold_to_customer, '') <> ''" & vbCrLf
    s = s & "                        AND c.Customer_No = @ClientInventoryHomeID" & vbCrLf
    s = s & "                        AND isnull(b.Finish, '') <> ''" & vbCrLf
    s = s & "                        AND isnull(a.Finish, '') <> isnull(b.Finish, '')" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "                    --SET @sqlStatement = 'Update Location for spec home assemblies'" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "                    UPDATE a" & vbCrLf
    s = s & "                    SET [Location] = b.[Location]" & vbCrLf
    s = s & "                    FROM EstimateAssemblies a" & vbCrLf
    s = s & "                    INNER JOIN tblcustomers c ON c.customer_no = a.customer_no" & vbCrLf
    s = s & "                    INNER JOIN tblScheduleB b ON b.Customer_No = c.sold_to_Customer" & vbCrLf
    s = s & "                        AND a.OptionID = b.opt" & vbCrLf
    s = s & "                        AND a.HFDescription = b.Description" & vbCrLf
    s = s & "                    WHERE isnull(c.sold_to_customer, '') <> ''" & vbCrLf
    s = s & "                        AND c.Customer_No = @ClientInventoryHomeID" & vbCrLf
    s = s & "                        AND isnull(b.[Location], '') <> ''" & vbCrLf
    s = s & "                        AND isnull(a.[Location], '') <> isnull(b.[Location], '')" & vbCrLf
    s = s & "                END" & vbCrLf
    s = s & "            END" & vbCrLf
    s = s & "        END TRY" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "        BEGIN CATCH" & vbCrLf
    s = s & "            -- Empty catch  " & vbCrLf
    s = s & "        END CATCH" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "        FETCH NEXT" & vbCrLf
    s = s & "        FROM SalesContract_Cursor" & vbCrLf
    s = s & "        INTO @IsCancelled" & vbCrLf
    s = s & "            , @ClientInventoryHomeID" & vbCrLf
    s = s & "            , @Customer_No" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    CLOSE SalesContract_Cursor" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    DEALLOCATE SalesContract_Cursor" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    -- Update Lot Status for Sold Lots  " & vbCrLf
    s = s & "    UPDATE crm" & vbCrLf
    s = s & "    SET crm.STATUS = 'Sold'" & vbCrLf
    s = s & "    FROM tblLotInventory crm" & vbCrLf
    s = s & "    INNER JOIN (" & vbCrLf
    s = s & "       SELECT LotNo, Lot, Closed, IsCancelled" & vbCrLf
    s = s & "       FROM OPENXML(@doc, '/HF/SalesContract',2)" & vbCrLf
    s = s & "               WITH (" & vbCrLf
    s = s & "                   LotNo nvarchar (50)  'LotNo',Lot nvarchar (50)  'Lot', Closed bit 'Closed', IsCancelled bit 'IsCancelled'" & vbCrLf
    s = s & "               )" & vbCrLf
    s = s & "       ) s ON crm.Lot = s.Lot AND crm.Lot_No = s.lotNo" & vbCrLf
    s = s & "    WHERE isnull(s.Closed, 0) = 0" & vbCrLf
    s = s & "        AND isnull(s.IsCancelled, 0) = 0" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    /*" & vbCrLf
    s = s & "       Below we are gathering all the customer numbers passed in Sales Contracts" & vbCrLf
    s = s & "       Then recalculating totals, updating customer numbers and reassigning customer numbers for Spec Homes" & vbCrLf
    s = s & "       This should probably be moved a separate Stored Procedure" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    */" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    DECLARE @tblCustomerNo AS TABLE (CustomerNo NVARCHAR(12))" & vbCrLf
    s = s & "    DECLARE @CustomerNo NVARCHAR(12)" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    INSERT @tblCustomerNo" & vbCrLf
    s = s & "    SELECT Customer_No" & vbCrLf
    s = s & "    FROM OPENXML(@doc, '/HF/SalesContract',2)" & vbCrLf
    s = s & "       WITH (" & vbCrLf
    s = s & "           Customer_No NVARCHAR(12) 'Customer_No'" & vbCrLf
    s = s & "       )" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    DECLARE Customer_Cursor CURSOR" & vbCrLf
    s = s & "    FOR" & vbCrLf
    s = s & "    SELECT CustomerNo" & vbCrLf
    s = s & "    FROM @tblCustomerNo" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    OPEN Customer_Cursor" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    FETCH NEXT" & vbCrLf
    s = s & "    FROM Customer_Cursor" & vbCrLf
    s = s & "    INTO @CustomerNo" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    DECLARE @JobStatus INT" & vbCrLf
    s = s & "        , @Job VARCHAR(12)" & vbCrLf
    s = s & "        , @DivisionID INT" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    WHILE @@FETCH_STATUS = 0" & vbCrLf
    s = s & "    BEGIN" & vbCrLf
    s = s & "        -- Use a try/catch to always close and deallocate the cursor  " & vbCrLf
    s = s & "        BEGIN TRY" & vbCrLf
    s = s & "            -- Execute the Client SPs to recalculate totals for the Customer No.  " & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "            EXEC CalcAddendumTotals @CustomerNo" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "            EXEC CalcCOMasterTotals @CustomerNo" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "            -- Added on 9-Aug-2016:  " & vbCrLf
    s = s & "            EXEC CustomerCalcTotals @CustomerNo" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "            ----set the customers construction_status----------------------------  " & vbCrLf
    s = s & "            SET @JobStatus = 0" & vbCrLf
    s = s & "            SET @Job = (" & vbCrLf
    s = s & "                    SELECT job_no" & vbCrLf
    s = s & "                    FROM tblCustomers" & vbCrLf
    s = s & "                    WHERE Customer_No = @CustomerNo" & vbCrLf
    s = s & "                    )" & vbCrLf
    s = s & "            SET @DivisionID = (" & vbCrLf
    s = s & "                    SELECT DivisionID" & vbCrLf
    s = s & "                    FROM tblCustomers" & vbCrLf
    s = s & "                    WHERE Customer_No = @CustomerNo" & vbCrLf
    s = s & "                    )" & vbCrLf
    s = s & "            SET @JobStatus = (" & vbCrLf
    s = s & "                    SELECT TOP 1 isnull(js.Job_Status, 0)" & vbCrLf
    s = s & "                    FROM scheduletasks t" & vbCrLf
    s = s & "                    INNER JOIN schedule s ON (s.scheduleid = t.scheduleid)" & vbCrLf
    s = s & "                    INNER JOIN librarytasks l ON (t.LibraryTaskID = l.TaskID)" & vbCrLf
    s = s & "                    INNER JOIN tblJobStatus js ON (js.Description = l.Description)" & vbCrLf
    s = s & "                    INNER JOIN tblJobs j ON (" & vbCrLf
    s = s & "                            s.job_no = j.Job_no" & vbCrLf
    s = s & "                            AND s.DivisionID = j.DivisionID" & vbCrLf
    s = s & "                            )" & vbCrLf
    s = s & "                    WHERE t.librarytaskid <> 0" & vbCrLf
    s = s & "                        AND t.ActualEndDate IS NOT NULL" & vbCrLf
    s = s & "                        AND s.job_no = @Job" & vbCrLf
    s = s & "                        AND s.DivisionID = @DivisionID" & vbCrLf
    s = s & "                    ORDER BY T.ActualEndDate DESC" & vbCrLf
    s = s & "                    )" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "            IF isnull(@JobStatus, 0) <> 0" & vbCrLf
    s = s & "                UPDATE tblCustomers" & vbCrLf
    s = s & "                SET Construction_Status = @JobStatus" & vbCrLf
    s = s & "                WHERE Job_no = @Job" & vbCrLf
    s = s & "                    AND DivisionID = @DivisionID" & vbCrLf
    s = s & "        END TRY" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "        BEGIN CATCH" & vbCrLf
    s = s & "            -- Empty catch  " & vbCrLf
    s = s & "        END CATCH" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "        FETCH NEXT" & vbCrLf
    s = s & "        FROM Customer_Cursor" & vbCrLf
