    s = s & "select q.SysName,q.MsgType,isnull(q.DivisionID,0),q.DataSourceID,'2025-06-01'" & vbCrLf
    s = s & "from MsgQ q" & vbCrLf
    s = s & "left join MsgQ_CutOffDates d on d.SysName=q.SysName and d.MsgType=q.MsgType and isnull(d.DivisionID,0)=isnull(q.DivisionID,0) and isnull(cast(d.datasourceid as varchar(40)),'')=isnull(cast(q.datasourceid as varchar(40)),'')" & vbCrLf
    s = s & "where q.ID=@ID" & vbCrLf
    s = s & "and d.MsgType is null" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- for paged data like Sales PutInventoryHomes the cutoffdate is already set on the msgq task so use it instead of the default from the dates table." & vbCrLf
    s = s & "select @CutOffDate= isnull(q.CutOffDate,d.CutOffDate)" & vbCrLf
    s = s & "from MsgQ q " & vbCrLf
    s = s & "join MsgQ_CutOffDates d on d.SysName=q.SysName and d.MsgType=q.MsgType and isnull(d.DivisionID,0)=isnull(q.DivisionID,0) and isnull(cast(d.datasourceid as varchar(40)),'')=isnull(cast(q.datasourceid as varchar(40)),'')" & vbCrLf
    s = s & "where q.ID=@ID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "update MsgQ set CutOffDate=@CutOffDate where ID=@ID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "--update cutoffdate" & vbCrLf
    s = s & "update d set CutOffDate=getdate() " & vbCrLf
    s = s & "from MsgQ q " & vbCrLf
    s = s & "join MsgQ_CutOffDates d on d.SysName=q.SysName and d.MsgType=q.MsgType and d.DivisionID=q.DivisionID and isnull(cast(d.datasourceid as varchar(40)),'')=isnull(cast(q.datasourceid as varchar(40)),'')" & vbCrLf
    s = s & "where q.ID=@ID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- run delegate proc to resolve request data" & vbCrLf
    s = s & "begin try" & vbCrLf
    s = s & "    declare @sql nvarchar(1000)='exec MsgQ_' + @SysName + '_' + @MsgType + '_Pre @i, @d'" & vbCrLf
    s = s & "    declare @parms nvarchar(500)='@i int, @d datetime'" & vbCrLf
    s = s & "    execute sp_executesql @sql, @parms, @i=@ID, @d=@CutOffDate" & vbCrLf
    s = s & "    -- update audit log" & vbCrLf
    s = s & "    select @seconds = cast(datediff(ms,@starttime,getdate()) as float)/1000" & vbCrLf
    s = s & "    update MsgQ set" & vbCrLf
    s = s & "     Audit=isnull(Audit,'') + 'Preprocessing: ' + str(@seconds,8,2) + char(13) + char(10)" & vbCrLf
    s = s & "    ,completeddate = case when status='Completed' then getdate() else completeddate end " & vbCrLf
    s = s & "    where ID=@ID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "end try" & vbCrLf
    s = s & "begin catch" & vbCrLf
    s = s & "    declare @errNum int" & vbCrLf
    s = s & "    select @errNum=ERROR_NUMBER() " & vbCrLf
    s = s & "    if @errNum=2812 begin" & vbCrLf
    s = s & "        -- delegate proc not found. must not be needed. do all the same stuff as above" & vbCrLf
    s = s & "        update MsgQ set Audit=isnull(Audit,'') + 'Preprocessing: ' + str(@seconds,8,2) + char(13) + char(10) where ID=@ID" & vbCrLf
    s = s & "    end else begin" & vbCrLf
    s = s & "        -- set task status for this and any grouped task that is related to it." & vbCrLf
    s = s & "        update MsgQ set Status=ERROR_MESSAGE() where ID=@ID" & vbCrLf
    s = s & "        update b" & vbCrLf
    s = s & "        set Status = 'Prerequisite task failed (id: ' + cast(@ID as varchar(15)) + ')', AgentID=@AgentID" & vbCrLf
    s = s & "        from msgq a" & vbCrLf
    s = s & "        join msgq b on isnull(b.status,'')='In-Progress' and b.groupid=a.groupid and a.divisionid=b.divisionid" & vbCrLf
    s = s & "        where a.id=@ID" & vbCrLf
    s = s & "    end" & vbCrLf
    s = s & "end catch" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- return updated task" & vbCrLf
    s = s & "select isnull(Status,'') Status,isnull(Request,'') Request from MsgQ where ID=@ID" & vbCrLf
    sql c, s




