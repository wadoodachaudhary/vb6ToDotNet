    s = s & "END TRY" & vbCrLf
    s = s & "BEGIN CATCH" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @errNum int" & vbCrLf
    s = s & "    SELECT @errNum=ERROR_NUMBER() " & vbCrLf
    s = s & "    IF @errNum=2812 begin" & vbCrLf
    s = s & "        -- delegate proc not found. must not be needed. do all the same stuff as above" & vbCrLf
    s = s & "        -- update audit log, status and completed date" & vbCrLf
    s = s & "        select @seconds = cast(datediff(ms,@starttime,getdate()) as float)/1000" & vbCrLf
