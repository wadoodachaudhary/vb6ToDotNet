    s = s & "alter function MsgQ_BuildPro_ReadErrors_ParsePOs(@ErrDesc varchar(2100)) returns varchar(500) AS" & vbCrLf
    s = s & "begin" & vbCrLf
    s = s & "-- PO numbers are embedded in the error message. These are the known forms:" & vbCrLf
    s = s & "--   ""Supplier not found.: Job: AND07028 PO #: AND07028/016 Supplier: 1_100""" & vbCrLf
    s = s & "--   ""Job not found.: Job: AND07028lotdoesntexist PO #: AND07028/016""" & vbCrLf
    s = s & "--   ""Account Code not found.: PO #: AND07028/016 Cost code: 050 Excavation""" & vbCrLf
    s = s & "    declare @s varchar(2100)" & vbCrLf
    s = s & "    if patindex('% PO #: %', @ErrDesc)=0" & vbCrLf
    s = s & "        return null" & vbCrLf
    s = s & "    -- disgusting hack to use the parsename function like this but it works for strings less than 265 char and 4 segments." & vbCrLf
    s = s & "    -- note that the second arg is not a sequential element number. It is the object type: 1,2,3,4 = objname,schemaname,dbname,servername" & vbCrLf
    s = s & "    -- @s = ""server.database.schema.object""" & vbCrLf
    s = s & "    select @s = replace(@ErrDesc, '.', '')               --remove periods" & vbCrLf
    s = s & "    select @s = parsename(replace(@s, ' PO #: ', '.'),1) --strip off leading text " & vbCrLf
    s = s & "    if patindex('% Supplier: %', @ErrDesc)<>0   select @s = parsename(replace(@s, ' Supplier: ', '.'),2) --strip off trailing text " & vbCrLf
    s = s & "    if patindex('% Cost code: %', @ErrDesc)<>0  select @s = parsename(replace(@s, ' Cost code: ', '.'),2) --strip off trailing text    " & vbCrLf
    s = s & "    return( @s )" & vbCrLf
    s = s & "end" & vbCrLf
    sql c, s

