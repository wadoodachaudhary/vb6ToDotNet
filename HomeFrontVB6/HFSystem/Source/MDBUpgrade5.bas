    s = s & "    --- Generate claims for customers with billable amounts if system setting is on" & vbCrLf
    s = s & "    DECLARE @Customer_No VARCHAR(12)" & vbCrLf
    s = s & "    DECLARE customer_cursor CURSOR FAST_FORWARD FOR" & vbCrLf
    s = s & "        select distinct d.customer_no" & vbCrLf
    s = s & "        from customerbillingitems d" & vbCrLf
    s = s & "        join ClaimItemTotals t on d.BillingItemID=t.BillingItemID" & vbCrLf
    s = s & "        join system_setup s on s.id=@DivisionID and isnull(AutoGenerateClaimsFromBPMilestones,0)=1" & vbCrLf
    s = s & "        where d.divisionid=@DivisionID" & vbCrLf
    s = s & "        and round(isnull(case when d.sortorder=1 then 100 else d.PercentComplete end,0)/100 * isnull(d.ContractAmount,0) - isnull(t.TotalAmountClaimed,0),2)<>0" & vbCrLf
