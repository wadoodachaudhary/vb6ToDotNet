    s = s & "alter proc dbo.MsgQ_BuildPro_ReadErrors(@ID integer) as" & vbCrLf
    s = s & "begin" & vbCrLf
    s = s & "    -- parse error from result xml" & vbCrLf
    s = s & "    -- update msgq status" & vbCrLf
    s = s & "    -- return 1 on errors, 0 on success" & vbCrLf
    s = s & "    declare @text varchar(max)" & vbCrLf
    s = s & "    declare @xml xml" & vbCrLf
    s = s & "    declare @doc int" & vbCrLf
    s = s & "    declare @Result   varchar(50)" & vbCrLf
    s = s & "    declare @Status   varchar(2100) " & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    select @text=response from MsgQ where id=@ID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- buildpro sends invalid xml. Eg" & vbCrLf
    s = s & "   --    <ErrorDescription>There are no changes to editable fields for a SupplyPro supplier.: G&S  </ErrorDescription>" & vbCrLf
    s = s & "    -- ""G&S"" is not technically illegal but SQL Server treats it as illegal so we have to do a dance to correct the xml" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- Protect valid entities" & vbCrLf
    s = s & "    SET @text = REPLACE(@text,'&amp;','~amp~')" & vbCrLf
    s = s & "    SET @text = REPLACE(@text,'&lt;','~lt~')" & vbCrLf
    s = s & "    SET @text = REPLACE(@text,'&gt;','~gt~')" & vbCrLf
    s = s & "    SET @text = REPLACE(@text,'&quot;','~quot~')" & vbCrLf
    s = s & "    SET @text = REPLACE(@text,'&apos;','~apos~')" & vbCrLf
    s = s & "    -- Escape remaining ampersands" & vbCrLf
    s = s & "    SET @text = REPLACE(@text,'&','&amp;')" & vbCrLf
    s = s & "    -- Restore valid entities" & vbCrLf
    s = s & "    SET @text = REPLACE(@text,'~amp~','&amp;')" & vbCrLf
    s = s & "    SET @text = REPLACE(@text,'~lt~','&lt;')" & vbCrLf
    s = s & "    SET @text = REPLACE(@text,'~gt~','&gt;')" & vbCrLf
    s = s & "    SET @text = REPLACE(@text,'~quot~','&quot;')" & vbCrLf
    s = s & "    SET @text = REPLACE(@text,'~apos~','&apos;')" & vbCrLf
    s = s & "    -- Convert to XML" & vbCrLf
    s = s & "    SET @xml = CAST(@text AS XML)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    exec sp_xml_preparedocument @doc OUTPUT, @xml" & vbCrLf
    s = s & "    select @Result=Result ,@Status=isnull(ErrDesc,'') " & vbCrLf
    s = s & "    from OPENXML (@doc, '/PostMessageResult')" & vbCrLf
    s = s & "    with (" & vbCrLf
    s = s & "     Result   varchar(50)  'Result'" & vbCrLf
    s = s & "    --,ErrID    varchar(500) 'Errors/Error/ErrorID'" & vbCrLf
    s = s & "    ,ErrDesc  varchar(2100) 'Errors/Error/ErrorDescription'" & vbCrLf
    s = s & "    --,ErrSrc   varchar(500) 'Errors/Error/ErrorSource'" & vbCrLf
    s = s & "    ) x          " & vbCrLf
    s = s & "    where x.ErrDesc not like '%no changes to editable fields for a SupplyPro supplier%'" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    if @Result='false' begin" & vbCrLf
    s = s & "        update MsgQ set Status= '(Error Source: BuildPro) '+@Status from MsgQ where ID=@ID" & vbCrLf
    s = s & "        return 1" & vbCrLf
    s = s & "    end else begin" & vbCrLf
    s = s & "        return 0" & vbCrLf
    s = s & "    end" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "end" & vbCrLf
    sql c, s
    
