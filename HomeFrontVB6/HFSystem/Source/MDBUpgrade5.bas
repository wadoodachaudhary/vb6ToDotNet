    s = ""
    s = s & "alter FUNCTION dbo.CleanEmail(@EmailList NVARCHAR(MAX),@IsRequired BIT = 0,@FirstOnly BIT = 0) RETURNS NVARCHAR(MAX) AS" & vbCrLf
    s = s & "BEGIN" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- Remove formatting from user entered or copy/pasted email list to leave a simple list that BuildPro will accept." & vbCrLf
    s = s & "-- Outlook allows both comma and semicolon separated lists." & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- EG: from this input" & vbCrLf
    s = s & "--    ""Knecht, Michael"" <MKnecht@ihyphen.com>; CHall@ihyphen.com, ""Damian Barletta"" <DBarletta@ihyphen.com>" & vbCrLf
    s = s & "-- return this " & vbCrLf
    s = s & "--    MKnecht@ihyphen.com; CHall@ihyphen.com; DBarletta@ihyphen.com" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    DECLARE @Result NVARCHAR(MAX) = ''" & vbCrLf
    s = s & "    DECLARE @Item NVARCHAR(MAX)" & vbCrLf
    s = s & "    DECLARE @Pos INT" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- Normalize line breaks/tabs" & vbCrLf
    s = s & "    SET @EmailList = REPLACE(REPLACE(REPLACE(ISNULL(@EmailList,''), CHAR(13), ''), CHAR(10), ''), CHAR(9), '')" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- Handle comma as separator. Replace commas with semicolons only when outside quotes" & vbCrLf
    s = s & "    DECLARE @Normalized NVARCHAR(MAX) = ''" & vbCrLf
    s = s & "    DECLARE @i INT = 1" & vbCrLf
    s = s & "    DECLARE @c NCHAR(1)" & vbCrLf
    s = s & "    DECLARE @InQuotes BIT = 0" & vbCrLf
    s = s & "    WHILE @i <= LEN(@EmailList)" & vbCrLf
    s = s & "    BEGIN" & vbCrLf
    s = s & "        SET @c = SUBSTRING(@EmailList, @i, 1)" & vbCrLf
    s = s & "        IF @c = '""'" & vbCrLf
    s = s & "            SET @InQuotes = CASE WHEN @InQuotes = 1 THEN 0 ELSE 1 END" & vbCrLf
    s = s & "        IF @c = ',' AND @InQuotes = 0" & vbCrLf
    s = s & "            SET @Normalized = @Normalized + ';'" & vbCrLf
    s = s & "        ELSE" & vbCrLf
    s = s & "            SET @Normalized = @Normalized + @c" & vbCrLf
    s = s & "        SET @i = @i + 1" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "    SET @EmailList = @Normalized" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- Extract emails" & vbCrLf
    s = s & "    WHILE LEN(@EmailList) > 0" & vbCrLf
    s = s & "    BEGIN" & vbCrLf
    s = s & "        -- Find next semicolon" & vbCrLf
    s = s & "        SET @Pos = CHARINDEX(';', @EmailList)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        IF @Pos > 0" & vbCrLf
    s = s & "        BEGIN" & vbCrLf
    s = s & "            SET @Item = LTRIM(RTRIM(LEFT(@EmailList, @Pos - 1)))" & vbCrLf
    s = s & "            SET @EmailList = LTRIM(RTRIM(SUBSTRING(@EmailList, @Pos + 1, LEN(@EmailList))))" & vbCrLf
    s = s & "        END" & vbCrLf
    s = s & "        ELSE" & vbCrLf
    s = s & "        BEGIN" & vbCrLf
    s = s & "            SET @Item = LTRIM(RTRIM(@EmailList))" & vbCrLf
    s = s & "            SET @EmailList = ''" & vbCrLf
    s = s & "        END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        -- Extract email from < >" & vbCrLf
    s = s & "        IF CHARINDEX('<', @Item) > 0" & vbCrLf
    s = s & "           AND CHARINDEX('>', @Item) > CHARINDEX('<', @Item)" & vbCrLf
    s = s & "        BEGIN" & vbCrLf
    s = s & "            SET @Item = SUBSTRING(" & vbCrLf
    s = s & "                @Item," & vbCrLf
    s = s & "                CHARINDEX('<', @Item) + 1," & vbCrLf
    s = s & "                CHARINDEX('>', @Item) - CHARINDEX('<', @Item) - 1" & vbCrLf
    s = s & "            )" & vbCrLf
    s = s & "        END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        SET @Item = LTRIM(RTRIM(@Item))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        -- Append non-empty items only" & vbCrLf
    s = s & "        IF @Item <> ''" & vbCrLf
    s = s & "        BEGIN" & vbCrLf
    s = s & "            IF @FirstOnly = 1" & vbCrLf
    s = s & "            BEGIN" & vbCrLf
    s = s & "                SET @Result = @Item" & vbCrLf
    s = s & "                BREAK" & vbCrLf
    s = s & "            END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "            IF LEN(@Result) > 0" & vbCrLf
    s = s & "                SET @Result = @Result + '; '" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "            SET @Result = @Result + @Item" & vbCrLf
    s = s & "        END" & vbCrLf
    s = s & "    END" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- Only force blackhole if required" & vbCrLf
    s = s & "    IF @IsRequired = 1" & vbCrLf
    s = s & "        SET @Result = ISNULL(NULLIF(@Result, ''), 'blackhole@hyphensolutions.net')" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    RETURN @Result" & vbCrLf
    s = s & "END" & vbCrLf
    sql c, s

