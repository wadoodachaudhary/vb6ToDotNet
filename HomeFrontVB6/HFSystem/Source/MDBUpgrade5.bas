    s = s & "    " & vbCrLf
    s = s & "    CLOSE Customer_Cursor" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    DEALLOCATE Customer_Cursor" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    UPDATE b" & vbCrLf
    s = s & "    SET Customer_No = c.Customer_No" & vbCrLf
    s = s & "    FROM tblcustomers c" & vbCrLf
    s = s & "    INNER JOIN EstimateAssemblies b ON b.Customer_No = '19' + substring(c.customer_no, 4, 10)" & vbCrLf
    s = s & "    WHERE c.CRMID IN (" & vbCrLf
    s = s & "            SELECT crmid" & vbCrLf
    s = s & "            FROM tblCustomers" & vbCrLf
    s = s & "            WHERE crmid IS NOT NULL" & vbCrLf
    s = s & "            GROUP BY crmid" & vbCrLf
    s = s & "            HAVING count(customer_no) > 1" & vbCrLf
    s = s & "            )" & vbCrLf
    s = s & "        AND len(c.customer_no) = 11" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    UPDATE b" & vbCrLf
    s = s & "    SET Customer_No = c.Customer_No" & vbCrLf
    s = s & "    FROM tblcustomers c" & vbCrLf
    s = s & "    INNER JOIN tblScheduleB b ON b.Customer_No = '19' + substring(c.customer_no, 4, 10)" & vbCrLf
    s = s & "    WHERE c.CRMID IN (" & vbCrLf
    s = s & "            SELECT crmid" & vbCrLf
    s = s & "            FROM tblCustomers" & vbCrLf
    s = s & "            WHERE crmid IS NOT NULL" & vbCrLf
    s = s & "            GROUP BY crmid" & vbCrLf
    s = s & "            HAVING count(customer_no) > 1" & vbCrLf
    s = s & "            )" & vbCrLf
    s = s & "        AND len(c.customer_no) = 11" & vbCrLf
    s = s & "        AND b.EstimateIndex <> 0" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    -- changed to allow for existing data 2021-02-09" & vbCrLf
    s = s & "    --update b" & vbCrLf
    s = s & "    --set Customer_No = c.Customer_No" & vbCrLf
    s = s & "    --from tblcustomers c" & vbCrLf
    s = s & "    --join ChangeOrderMaster b on b.Customer_No = '19'+substring(c.customer_no,4,10)" & vbCrLf
    s = s & "    --where c.CRMID in (select crmid from tblCustomers where crmid is not null group by crmid having count(customer_no)>1)" & vbCrLf
    s = s & "    --and len(c.customer_no)=11" & vbCrLf
    s = s & "    UPDATE b" & vbCrLf
    s = s & "    SET Customer_No = c.Customer_No" & vbCrLf
    s = s & "    FROM tblcustomers c" & vbCrLf
    s = s & "    INNER JOIN ChangeOrderMaster b ON b.Customer_No = '19' + substring(c.customer_no, 4, 10)" & vbCrLf
    s = s & "    LEFT JOIN ChangeOrderMaster d ON d.Customer_No = c.customer_no" & vbCrLf
    s = s & "        AND d.Change_Order_No = b.Change_Order_No" & vbCrLf
    s = s & "    WHERE c.CRMID IN (" & vbCrLf
    s = s & "            SELECT crmid" & vbCrLf
    s = s & "            FROM tblCustomers" & vbCrLf
    s = s & "            WHERE crmid IS NOT NULL" & vbCrLf
    s = s & "            GROUP BY crmid" & vbCrLf
    s = s & "            HAVING count(customer_no) > 1" & vbCrLf
    s = s & "            )" & vbCrLf
    s = s & "        AND len(c.customer_no) = 11" & vbCrLf
    s = s & "        AND d.Customer_No IS NULL" & vbCrLf
    s = s & "    " & vbCrLf
