    s = ""
    s = s & "alter proc MsgQ__PostProcess @SysName nvarchar(40), @MsgType nvarchar(40), @ID int as" & vbCrLf
    s = s & "begin try" & vbCrLf
    s = s & "    -- run delegate proc to process response data" & vbCrLf
    s = s & "    declare @starttime datetime" & vbCrLf
    s = s & "    declare @seconds float" & vbCrLf
    s = s & "    select @starttime = getdate()" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    update MsgQ set response=dbo.cleanascii(response) where ID=@ID" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    declare @sql nvarchar(1000)='exec MsgQ_' + @SysName + '_' + @MsgType + '_Post @i'" & vbCrLf
    s = s & "    declare @parms nvarchar(500)='@i int'" & vbCrLf
    s = s & "    execute sp_executesql @sql, @parms, @i=@ID" & vbCrLf
    s = s & "    -- update audit log, status and completed date" & vbCrLf
    s = s & "    select @seconds = cast(datediff(ms,@starttime,getdate()) as float)/1000" & vbCrLf
    s = s & "    update MsgQ set " & vbCrLf
    s = s & "      Status=case when status ='In-progress' then 'Completed' else status end" & vbCrLf
    s = s & "     ,CompletedDate=getdate()" & vbCrLf
    s = s & "     ,Audit=isnull(Audit,'') + 'Postprocessing: ' + str(@seconds,8,2) + char(13) + char(10)" & vbCrLf
    s = s & "    where ID=@ID" & vbCrLf
    s = s & "    --update cutoffdate" & vbCrLf
    s = s & "    update d set CutOffDate=getdate() " & vbCrLf
    s = s & "    from MsgQ q " & vbCrLf
    s = s & "    join MsgQ_CutOffDates d on d.SysName=q.SysName and d.MsgType=q.MsgType and d.DivisionID=q.DivisionID and isnull(cast(d.datasourceid as varchar(40)),'')=isnull(cast(q.datasourceid as varchar(40)),'')" & vbCrLf
    s = s & "    where q.ID=@ID" & vbCrLf
    s = s & "end try" & vbCrLf
    s = s & "begin catch" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    if error_number()=2812 begin" & vbCrLf
    s = s & "        " & vbCrLf
    s = s & "        -- delegate proc not found. must not be needed. update audit log as above" & vbCrLf
    s = s & "        select @seconds = cast(datediff(ms,@starttime,getdate()) as float)/1000" & vbCrLf
    s = s & "        update MsgQ with(rowlock) set " & vbCrLf
    s = s & "          Status=case when status ='In-progress' then 'Completed' else status end" & vbCrLf
    s = s & "         ,CompletedDate=getdate()" & vbCrLf
