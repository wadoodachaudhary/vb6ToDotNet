    s = s & "     CutOffDate=@CutOffDate " & vbCrLf
    s = s & "    ,request=dbo.cleanascii(request)" & vbCrLf
    s = s & "    where ID=@ID" & vbCrLf
    s = s & "    " & vbCrLf
    s = s & "    -- run delegate proc to resolve request data" & vbCrLf
    s = s & "    declare @sql nvarchar(1000)='exec MsgQ_' + @SysName + '_' + @MsgType + '_Pre @i, @d'" & vbCrLf
    s = s & "    declare @parms nvarchar(500)='@i int, @d datetime'" & vbCrLf
    s = s & "    execute sp_executesql @sql, @parms, @i=@ID, @d=@CutOffDate" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    -- update audit log" & vbCrLf
    s = s & "    select @seconds = cast(datediff(ms,@starttime,getdate()) as float)/1000" & vbCrLf
    s = s & "    update MsgQ set" & vbCrLf
    s = s & "     Audit=isnull(Audit,'') + 'Preprocessing: ' + str(@seconds,8,2) + char(13) + char(10)" & vbCrLf
    s = s & "    ,completeddate = case when status='Completed' then getdate() else completeddate end " & vbCrLf
