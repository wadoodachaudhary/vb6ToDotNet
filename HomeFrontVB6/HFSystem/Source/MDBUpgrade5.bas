    s = s & "    ,i.Comments [CurrentDocument/Document/SupplierNotes]" & vbCrLf
    s = s & "    --OriginalDocument" & vbCrLf
    s = s & "    ,case when nullif(p.epoid,'') is null or poi.LineNumber<>1 or p.datesenttobuildpro is not null then null else p.epoid end [OriginalDocument/Document/DocNumber]" & vbCrLf
    s = s & "    ,case when nullif(p.epoid,'') is null or poi.LineNumber<>1 or p.datesenttobuildpro is not null then null else p.epodoctype end [OriginalDocument/Document/DocType]" & vbCrLf
    s = s & "    ,case when nullif(p.epoid,'') is null or poi.LineNumber<>1 or p.datesenttobuildpro is not null then null else p.epodocsuffix end [OriginalDocument/Document/DocSuffix]" & vbCrLf
