    s = s & "alter proc [dbo].[MsgQ_Sales_GetInventoryHomesAddendum_Post] @ID integer as" & vbCrLf
    s = s & "    -- Select the responsedata from the MsgQ task." & vbCrLf
    s = s & "    -- xml requests will use xml attributes not elements because payload is 30-40% smaller. " & vbCrLf
    s = s & "    -- Make inserts/updates to the HF tables accordingly." & vbCrLf
    s = s & "    -- use syntax like this to update the audit log if there is anything useful to be said." & vbCrLf
    s = s & "    --   UPDATE MsgQ SET Audit=isnull(Audit,'') + 'your log entry here' + char(13) + char(10) WHERE ID=@ID " & vbCrLf
    s = s & "    -- put errors in the status field" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "alter table tblcustomers disable trigger tiu_tblcustomers " & vbCrLf
    s = s & "alter table tbljobs disable trigger u_tbljobs" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "     -- select response from queue" & vbCrLf
    s = s & "    DECLARE @xml xml" & vbCrLf
    s = s & "    DECLARE @doc int" & vbCrLf
    s = s & "    SELECT @xml=Response FROM MsgQ WHERE ID=@ID" & vbCrLf
    s = s & "    EXEC sp_xml_preparedocument @doc OUTPUT, @xml" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    --Are options locked on download? default is false meaning Options are not locked until processed thru " & vbCrLf
    s = s & "    --the inbox. Immediate lock was invented for clients with long DT run intervals which allows more " & vbCrLf
    s = s & "    --opportunity for data collision problems. To lock on download insert this appoption, to unlock remove the appoption:" & vbCrLf
    s = s & "    --     insert appoptions(UID,DivisionID,OptionName,OptionValue) values('',0,'LockOptionsImmediately','True')" & vbCrLf
    s = s & "    DECLARE @LockOptionsImmediately BIT = 0" & vbCrLf
    s = s & "    SELECT @LockOptionsImmediately = CASE WHEN OptionValue = 'True' THEN 1 ELSE 0 END" & vbCrLf
    s = s & "    FROM appoptions" & vbCrLf
    s = s & "    WHERE optionname = 'LockOptionsImmediately'" & vbCrLf
    s = s & "    AND divisionid = 0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    INSERT tblScheduleB (Customer_No, OPT, Option_Type, Custom, QTY, UOM, Base_Price, Rate, TAX, Cost_Amount" & vbCrLf
    s = s & "    , Override_Price, TotalAmount, GrandTotal, [Description], comments, Major_Group, Category, [Assembly]" & vbCrLf
    s = s & "    , Color, Style, Finish, SalesWorksheet, ApplyIncentive, IncentiveValue, Location, EstimateIndex" & vbCrLf
    s = s & "    , Other, CRMType, CRMID, CRMSourceID, Require_Quote, UserID, OPTDELETED )" & vbCrLf
