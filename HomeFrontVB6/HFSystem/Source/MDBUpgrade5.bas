    s = s & "                    SET Job_No = @SpecHomeJob" & vbCrLf
    s = s & "                        , webdeleted = 0" & vbCrLf
    s = s & "                        , Sold_To_Customer = @ClientInventoryHomeID" & vbCrLf
    s = s & "                    WHERE Customer_No = @Customer_No" & vbCrLf
