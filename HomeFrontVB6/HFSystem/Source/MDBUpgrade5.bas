    s = s & "    ,case when isnull(EPODocType,'')='' then a.salesqty else '' end [OptionList/Option/Quantity]" & vbCrLf
    s = s & "    ,case when isnull(EPODocType,'')='' then nullif(a.optionid,'') + '    ('+cast(a.estassemblyid as varchar(50))+')' else '' end [OptionList/Option/ID]" & vbCrLf
    s = s & "    ,0 [OptionList/Option/Cost]" & vbCrLf
