    s = s & "END CATCH" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "-- return updated task" & vbCrLf
    s = s & "SELECT isnull(Status,'') Status FROM MsgQ WHERE ID=@ID" & vbCrLf
