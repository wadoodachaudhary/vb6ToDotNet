    s = s & "from MsgQ q " & vbCrLf
    s = s & "join MsgQ_CutOffDates d on d.SysName=q.SysName and d.MsgType=q.MsgType and d.DivisionID=q.DivisionID and isnull(cast(d.datasourceid as varchar(40)),'')=isnull(cast(q.datasourceid as varchar(40)),'')" & vbCrLf
