    s = s & "join Invoices e ON(i.DivisionID=e.DivisionID and e.Invoice like i.ponumber+'%' and i.Vendor=e.Vendor and e.Source='autoinserting..')" & vbCrLf
    s = s & "where i.divisionid=@DivisionID " & vbCrLf
    s = s & "and i.ponumber=@PONumber" & vbCrLf
    sql c, s

    s = ""
